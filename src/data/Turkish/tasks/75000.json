				{
					"id": 750000608,
					"content": "Çantan nerede ki senin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000609
					]
				},
				{
					"id": 750000609,
					"content": "Hıh! Gizli ve güvenli bir yerde tabii ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000610,
					"content": "Neyse, atkıyı kullanmak istiyor musun, istemiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000611,
					"content": "Kullanalım. Teşekkürler Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000612
					]
				},
				{
					"id": 750000612,
					"content": "Arrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000613
					],
					"speakerTitle": "Ufaklık?"
				},
				{
					"id": 750000613,
					"content": "Pekala ufaklık, hareket etme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000614,
					"content": "#Hehe, bu ufaklık gerçekten çok akıllı, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000615,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000616
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000616,
					"content": "Bu işimizi görür.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000617
					]
				},
				{
					"id": 750000617,
					"content": "Pekala. Daha iyi hissediyor musun şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000618,
					"content": "Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000619
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000619,
					"content": "Hehe, şimdi daha iyi görünüyor. Paimon rahatladı... Peki o bariyerde ne işin vardı? Bir de şu Hiçlik Kurtları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000620,
					"content": "Arrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000621
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000621,
					"content": "Demek sen de bilmiyorsun. Ne dediğini tam olarak anlayamıyoruz ama... Artık seni kurtardığımıza göre evine dönebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000622,
					"content": "Arrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000623
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000623,
					"content": "Bir dakika, evinin nerede olduğunu bilmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000624
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000624,
					"content": "Akrabaların peki? ... Ah, bir saniye... Şu az önceki koca oğlan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000625,
					"content": "#Ne yapacağız {NICKNAME}? Onu öylece burada bırakamayız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000626,
					"content": "Rroo...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000627
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000627,
					"content": "Bir süreliğine bizim yanımızda olsan daha iyi olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000628
					]
				},
				{
					"id": 750000628,
					"content": "Evet, mantıklı. Belki Natlan'a vardığımızda ailesini buluruz... Ama daha önce hiç onun gibi birini görmedik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000629,
					"content": "Aa. \"Ejderhaların... Seçilmişi...\" Bu acaba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000630
					]
				},
				{
					"id": 750000630,
					"content": "Hım. Böyle bir şey mi duydun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000631,
					"content": "Paimon bir düşündü de sonuçta Natlan \"ejderhaların ülkesi\", yani bu aslında... Bir dakika, buralarda böyle ufaklıklara \"Sürüngen\" diyorlar, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000632,
					"content": "Rauuu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000633
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000633,
					"content": "Şöyle bir düşününce, Paimon'a toprak ejderini anımsattı. İki bacağı, bir kuyruğu falan var mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000634,
					"content": "Rraaa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000635
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000635,
					"content": "Bizimle gelmesinde bir sakınca yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000636
					]
				},
				{
					"id": 750000636,
					"content": "Ama önce onun da isteyip istemediğini sormalıyız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000637
					]
				},
				{
					"id": 750000637,
					"content": "Doğru, evet. Hey, ufaklık. Bizimle birlikte seyahat etmek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000638
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000638,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000639
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000639,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000640
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000640,
					"content": "#Hehe! Anlaştık galiba. Neyse, Paimon'un adı Paimon, bu da {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000641,
					"content": "Raa? Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000642
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000642,
					"content": "Ah, doğru, sana da bir isim lazım... Paimon bir düşünsün. Tamam! Kahverengi ve sarı renkte olduğuna göre sana \"Mücver\" diyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000643
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000643,
					"content": "Raaa... Rraaaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000644,
						750000646
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000644,
					"content": "Bu isim yalnızca Avcının Yeri'nde gider sanki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000645
					]
				},
				{
					"id": 750000645,
					"content": "Yani başka bir yerde insanlar beğenmez mi diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000647,
					"content": "Raaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000648
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000648,
					"content": "#{NICKNAME} sana bir isim versin istiyorsun galiba. Pekala... Ama Paimon isim koyma konusundaki becerileri için ona kefil olmaz haberin olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000649,
						750000650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000649,
					"content": "Benim şimdiye kadar bulduğum isimler son derece normaldi yalnız, hatırlatayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 750000650,
					"content": "Zavallı küçük şey... Böylesine talihsiz bir kader...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 750000646,
					"content": "Sanki bu ismi beğenmedi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000647
					]
				}
			]
		},
