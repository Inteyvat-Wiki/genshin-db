					"nextDialogs": [
						750000118
					]
				},
				{
					"id": 750000118,
					"content": "Güçlerini... Birleştir. Ve sonra... Her şeye tanık ol... Ve böylece, herkesi özgür kıl...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000119
					]
				},
				{
					"id": 750000119,
					"content": "#Neler oluyor {NICKNAME}? Dalıp gitmenin zamanı değil şimdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
