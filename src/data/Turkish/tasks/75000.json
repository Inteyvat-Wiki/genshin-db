						750000904
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000904,
					"content": "#Küçük dostumuz adını sevdi galiba! Paimon Natlan'a varınca seni sarmalayan gizemi çözebilmemizi umuyor... Hem belki {NICKNAME} nasıl bir anda Sürüngenin bedenine girdi, onunla ilgili bir şeyler de buluruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000905,
					"content": "#Sen iyi misin bu arada {NICKNAME}? Az önce bir anda Sürüngene dönüştün... Kendini kötü hissediyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000906,
						750000908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000906,
					"content": "Yok, sadece hafiften süründürüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000907
					]
				},
				{
					"id": 750000907,
					"content": "Ne demekti bu şimdi? Şakanın sırası mı yani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000910,
					"content": "#Yine de {NICKNAME}, Paimon daha önce Natlan'da birinin Sürüngene dönüşebildiğini hiç duymamıştı... Tuhaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000911,
					"content": "Cidden, buraya daha yeni geldik ama şimdiden bir sürü şey oldu bile... Neyse, buradan nasıl çıkacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000912,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000913
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750000913,
					"content": "Hım? Çıkışın nerede olduğunu biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000908,
					"content": "Bir süreliğine Sürüngene dönüşmek çok güzeldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000909
					]
				},
				{
					"id": 750000909,
					"content": "Sadece bir süreliğine olsa iyi olur zaten! Bir gün Sürüngene dönüşüp tekrar geri dönemezsen işte o zaman çok kötü olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000910
					],
					"speakerTitle": "Paimon"
				}
			]
