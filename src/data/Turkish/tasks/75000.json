			"dialogs": [
				{
					"id": 750000101,
					"content": "Hey, hey, koca oğlan... İyi misin? Kalkabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000102,
					"content": "Olamaz, gerçekten çok zayıf görünüyor! Ah, cidden! Şu uçan hayalet köpekler hep bir kötülük peşinde... Uçan bir şeyden ne beklenir ki zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000103,
					"content": "Sen de uçuyorsun ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000104
					]
				},
				{
					"id": 750000104,
					"content": "Paimon onlar gibi değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000105,
					"content": "Neyse, onu boş ver şimdi. Bu dostumuza yiyecek bir şeyler bulalım önce, sonra da... Bırakalım bir süre dinlensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000106,
					"content": "Paimon, yakında daha iyi hissedeceğine emin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000107,
						750000108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000107,
					"content": "Artık çok geç...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				},
				{
					"id": 750000109,
					"content": "Hayır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000110,
					"content": "... *derin nefes alır*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000111
					],
					"speakerTitle": "Koca Oğlan?"
				},
				{
					"id": 750000111,
					"content": "#Olamaz. Çok acı çekiyor olmalı {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000112,
						750000113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750000112,
					"content": "Düşmanlarını yendik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000114,
					"content": "... *derin nefes alır*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000115
					],
					"speakerTitle": "Koca Oğlan?"
				},
				{
					"id": 750000115,
					"content": "Aklına takılan bir şey mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000116
					]
				},
				{
					"id": 750000116,
					"content": "Bana... Söylemek istediğin bir şey mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000117
					]
				},
				{
					"id": 750000117,
					"content": "Uzat... Elini... Ejderhaların Seçilmişi... Bana ulaş...",
