			"dialogs": [
				{
					"id": 401251101,
					"content": "Kabuğu geri götürmeyi planlamıyorsun, değil mi Bayan Sangonomiya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 401251102,
					"content": "Hayır, burada Idyia ile kalsa daha iyi olur bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251103
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251103,
					"content": "Watatsumi Adası'nın artık yeni bir hazinesi var. İnsanlar yavaşça ama emin adımlarla hayallerini gerçekleştirecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251104
					],
					"speakerTitle": "Sangonomiya Kokomi"
				},
				{
					"id": 401251104,
					"content": "Yadigarın bu şişe zindanı ve buradan geçen herkesin hayalini koruyabileceği bu yerde kalması daha faydalı olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sangonomiya Kokomi"
				}
			]
		},
		{
