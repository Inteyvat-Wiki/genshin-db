				"points": []
			},
			"dialogs": [
				{
					"id": 401251201,
					"content": "Sumeru Şehri'ne gitmek için Aaru Köyü'nden başlayıp yolu biraz uzatırsak Ribat Kervanı'nı ve Pardis Dhyai'yi görebiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251202
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251202,
					"content": "Ah, çok güzel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251203
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251203,
					"content": "Yoldayken hediyelik eşya almayı planlıyor musun? Sen istediğin kadar hediye alabilirsin, çantaları ben taşırım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251204
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251204,
					"content": "Çantaların ağırlığını kafana takma, ben hallederim! Devasa bir şey olmadığı sürece çantama sığdırabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251205
					],
					"speakerTitle": "Lessig"
				},
				{
					"id": 401251205,
					"content": "Sakin ol, kaç kişiye hediye alacağımızı zannediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251206
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251206,
					"content": "Annem, Albedo, Kumandan Jean, Razor... Haa, bir de Diona ve Mona ve Fischl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251207
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251207,
					"content": "Hey, neden öyle bakıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251208
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251208,
					"content": "Yok bir şey, yok bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251209
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251209,
					"content": "İnsanlara ne almayı planlıyorsun Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251210
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 401251210,
					"content": "Şey... Güneriği aromalı şekerler! Ve büyük Mantar şapkaları! Ve, ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251211
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251211,
					"content": "Herkes için biiir sürü hikaye kitabı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251212
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251212,
					"content": "Gerçi anneme ne alacağıma henüz karar veremedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251213
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 401251213,
					"content": "Acele etmene gerek yok. Önce neler satıyorlarmış bir bakalım, sonra karar veremezsen biz sana yardımcı oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401251214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401251214,
					"content": "Yaşasın! Teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				}
			]
		}
	]
