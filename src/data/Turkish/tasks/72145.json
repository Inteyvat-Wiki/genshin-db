			"dialogs": [
				{
					"id": 721450101,
					"content": "\"Rivayete göre Omikami elçisinin üç gözü vardır: Biri 'ruh' için, biri 'ayna' için, sonuncusu da 'hakikat' için...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450102
					],
					"speakerTitle": "Kadim Taş Tablet"
				},
				{
					"id": 721450102,
					"content": "\"Derinlerden yükseldi gözler, <color=#00E1FFFF>güneyden</color>, <color=#00E1FFFF>kuzeyden</color> ve <color=#00E1FFFF>batı</color> höyüğünden...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450103
					],
					"speakerTitle": "Kadim Taş Tablet"
				},
				{
					"id": 721450103,
					"content": "\"Üç göz de ejderin varisini defetmek için güneş gibi parladı...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450104
					],
					"speakerTitle": "Kadim Taş Tablet"
				},
				{
					"id": 721450104,
					"content": "Paimon... Bu kelimeleri biliyor ama... Bir arada ne anlama geldiklerini bilmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721450105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721450105,
					"content": "Etrafta hiç ipucu yok galiba, <color=#00E1FFFF>Element Görüşünü</color> mü kullansak?",
