		},
		{
			"id": 7104602,
			"completionStepIds": [
				7104602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7104602",
							"2"
						],
						"stepId": 7104602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tie Hong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710460201,
					"content": "Durun! Kanyon kapalı. Yabancıysanız lütfen... Ah, siz miydiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460202
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460202,
					"content": "Eyvah, kaç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460203,
						710460204,
						710460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460203,
					"content": "Hadi ama Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460206,
					"content": "Hahaha! Sizi korkuttuğum için özür dilerim. Tabii ki sizi hatırlıyorum. Hayatımı kurtaranları nasıl unutabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460207
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460207,
					"content": "Ben de kısa bir süre önce buraya atandım... Burada sizinle karşılaşmayı beklemiyordum. Şanslıymışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460208
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460208,
					"content": "Seni mi kurtardık? Biz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460209,
					"content": "Ah, hadi ama! O deniz canavarıyla birlikte savaşırken, ben de Yeşim Konak'taydım. O zaman biraz yaralanmıştım. Bu yüzden görevime yalnızca kısa bir süre önce dönebildim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460210
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460210,
					"content": "Beni hatırlamıyor olabilirsiniz ama ben sizi asla unutmayacağım. O gün savaşan tüm yoldaşlarımız, sizin Liyue için yaptıklarınıza tanık oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460211
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460211,
					"content": "Bana biraz Kanyon'dan bahsedebilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460212
					]
				},
				{
					"id": 710460212,
					"content": "İki yıl önce, mağaraların derinliklerinde ne olduğu belirsiz bir kaza yaşandı. Bunun üzerine Yedi Yıldız, Kanyon'un kapatılmasını emretti. Madencilerin büyük çoğunluğu güvenli bir yere tahliye edildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460213
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460213,
					"content": "Böyle devasa bir madenin aniden kapatılması üzücü oldu. İşçiler tazminatlarını alıp kendi yollarına gitti... Bu kadar çok insan bir kez dağılınca, onları yeniden bir araya toplamak zor olur diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460214
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460214,
					"content": "Şey, pardon, konudan uzaklaştım. Buraya önemli bir iş için gelmişsinizdir. O yüzden sizi daha fazla tutmayayım. Sorunuz varsa, doğrudan Muning'e sorabilirsiniz. Madenin girişindeki kampta olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460215
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460215,
					"content": "Ayrıca yasalara aykırı bir şey yapmayın! Bunu size güvenmediğimden değil de işim gereği söylüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710460216
					],
					"speakerTitle": "Tie Hong"
				},
				{
					"id": 710460216,
					"content": "Merak etme, bize güvenebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710460204,
					"content": "Beni tanıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				},
				{
					"id": 710460205,
					"content": "Bizi tanıdı! Kaçalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710460206
					]
				}
			]
		}
	]
}