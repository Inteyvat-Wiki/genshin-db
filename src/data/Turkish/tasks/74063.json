			},
			"dialogs": [
				{
					"id": 740630201,
					"content": "Hı? Kameranın burada ne işi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630202,
					"content": "\"Nerede haber, orada Kamera.\" sözünü daha önce hiç duymadınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630203,
						740630206
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630203,
					"content": "Sanırım daha önce duymuştum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630204
					]
				},
				{
					"id": 740630204,
					"content": "Ama bu sözü şimdi uydurdum, nerede duymuş olabilirsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630205
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630205,
					"content": "Demek gerçekten güneşin altında yeni bir şey yok. Ne söylersem söyleyeyim, ne yazarsam yazayım, birileri hep benden önce davranıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630208,
					"content": "Kamera burada ama haber nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630209
					]
				},
				{
					"id": 740630209,
					"content": "Şey... Haber, balık tutmak gibidir. Sabırlı olmalı ve doğru zamanda doğru muhakemeyi yapmanız gerekir. Ancak bu şekilde büyük balığı yakalayabilirsiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630210
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630210,
					"content": "Ah! Yani... Büyük haberler de böyle yakalanır işte. Hımm. Bir dakika, tam olmadı sanırım! Of! Neyse boş verin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630211,
						740630213
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630211,
					"content": "Biraz amatörce konuştun. Gazeteci değilsin sanırım, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630212
					]
				},
				{
					"id": 740630212,
					"content": "Doğru muhakeme bu yüzden önemli işte, heh. Ben amatör bir gazeteciyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630222,
					"content": "Neyse, senin gibi amatör bir gazetecinin burada ne işi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630223,
					"content": "Buraya bana verilen projeyi tamamlamak üzere geldim. Meropide Kalesi'ndeki muhafızların çalışırken en canlı olduğu anları Kameramla fotoğraflamam lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630224
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630224,
					"content": "Ama uygunluk belgesini doldururken çok zaman harcadım... Siz de bir bakın isterseniz, ne demek istediğimi anlayacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630225
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630225,
					"content": "Nelly, çeşitli sözleşmeler ve imzalarla dolu bir yığın belge çıkarır. Bu belgelere bakmak bile başının dönmesine neden olur...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740630226
					]
				},
				{
					"id": 740630226,
					"content": "Belgeleri nihayet tamamladığımda muhafızların vardiyası çoktan bitmişti! Ya da balıkçıların tabiriyle suda tutacak balık kalmamıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630227
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630227,
					"content": "Hı? Ama şimdi burada başka muhafızlar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630228,
					"content": "Ama ben Platin Koleksiyondan birini tutmak istiyorum. İlk Ayarlamanın veya Su Temizlikçisinin aynı etkiyi vereceğini sanmıyorum... O yüzden projemi tamamlasam bile diğer fotoğrafçılar işimi takdir etmeyebilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630229,
						740630230
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630229,
					"content": "Elin boş dönmek istemiyorsan bu kadar seçici olmamalısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630233
					]
				},
				{
					"id": 740630233,
					"content": "Haklısınız. Yeteneklerimin sınırlı olduğunu kabul edip beni aşan balıkların peşini bırakmalıyım... *ağlar* İşe yaramaz bir balıkçının tekiyim... Of, yanlış oldu. Amatör gazeteciyim demek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630234
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630234,
					"content": "Tamam, bu kadar hayıflanmak yeter, kendime gelme vakti! Sizin için de sorun olmazsa... Bana küçük bir iyilik yapabilir misiniz? Lütfen! İyiliğinizin karşılığını vereceğime yemin ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630235
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630235,
					"content": "Vay be! Hemen değişiverdin... Bu iyiliğin ne olacağına bağlı. Önce bizden nasıl bir iyilik istediğini söylemeye ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630236,
					"content": "Oradaki muhafız Grainville. Bence onun haber değeri, Teknisyen Mekalar arasındaki bir Durum Kontrolcüsüne eş değer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630237
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630237,
					"content": "Onu konu alarak güzel bir rapor yazabilirim... Şey, en azından bu şekilde eleştirilerin hedefinde de olmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630238
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630238,
					"content": "Ama bir türlü buraya gelmedi! Onu fotoğrafını çekebileceğim uygun bir yere getirebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630239,
						740630241
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630239,
					"content": "Neden bunu ona kendin söyleyip de onu buraya getirmiyorsun ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630240
					]
				},
				{
					"id": 740630240,
					"content": "Kameraları bildiği için hemen Kameraya odaklanır ve gergin pozlar verir, bu da fotoğrafı hiç doğal yapmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630243,
					"content": "Bir düşüneyim. Hoparlörü kapatıp bunu Grainville'e arıza yaptı diye bildirebilir ve ondan bir göz atmasını isteyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630244
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630244,
					"content": "Bu şekilde bir Meropide Kalesi muhafızını çalışırken fotoğraflayabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630245
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630245,
					"content": "Projemin tamamlanıp tamamlanmaması buna bağlı! Size güveniyorum! Lütfen bana yardım edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630246
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630246,
					"content": "#Oldukça kolay görünüyor {NICKNAME}. Belki ona yardım edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630241,
					"content": "Kameranla onun yakınına gidemez misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630242
					]
				},
				{
					"id": 740630242,
					"content": "Şey... Manzara burada daha güzel. Ayrıca kamerayı görürse sürekli ona odaklanır ve bana gergin pozlar verir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630243
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630230,
					"content": "Pekala, sen beklemeye devam et. Görüşürüz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630231
					]
				},
				{
					"id": 740630231,
					"content": "Gerçekten mi? Öylece çekip gidiyor musunuz? Bana yardım etmeyecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630232
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630232,
					"content": "Şey... İstediğin Platin Koleksiyonu parmağımızı şıklatarak ortaya çıkaracak halimiz yok ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630213,
					"content": "Haber konuşmamıza gerek yok, ben de balık tutmayı severim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630214
					]
				},
				{
					"id": 740630214,
					"content": "Gerçekten mi? Bu harika! Ben de balık tutmaya yeni başladım ve bu konuda kendimi geliştirmek için soru sorabileceğim birini arıyordum. Mesela bir Teknisyen Meka oltana takılırsa ve yemi ısırırsa... Ne yaparsın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630215,
						740630216,
						740630217
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630215,
					"content": "Onu suya geri salarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630219,
					"content": "Anladım, anladım. Demek öyle yapardın. Hımm, cevabın için teşekkür ederim. Aklımdan hiç çıkarmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630220
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630220,
					"content": "Hı? Konu balık tutmaya nasıl geldi ya? Konuyu nasıl da değiştirdin öyle! Anlaşılan amatör bir gazeteci olarak daha öğrenecek çok şeyim var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630221
					],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630221,
					"content": "Balık tutmaktan ilk sen bahsettin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630216,
					"content": "Ağzını burnunu kırarak ona patronun kim olduğunu gösteririm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630219
					]
				},
				{
					"id": 740630217,
					"content": "Pişirip Paimon'a veririm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630218
					]
				},
				{
					"id": 740630218,
					"content": "#Ay! Paimon senin yemek yapmakta ne kadar iyi olduğunu biliyor {NICKNAME} ama neresinden bakarsan bak onların yenilecek hiçbir yanı yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740630206,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740630207
					]
				},
				{
					"id": 740630207,
					"content": "Aa! Şimdi duymuş oldunuz işte! Bu sözü başka bir yerde kullanırsanız söyleyen kişiyi kaynak göstermeyi unutmayın! Yani beni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740630208
					],
					"speakerTitle": "Nelly"
				}
			]
		},
