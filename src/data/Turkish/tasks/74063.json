					"nextDialogs": [],
					"speakerTitle": "Nelly"
				},
				{
					"id": 740630506,
					"content": "Fotoğraf o kadar canlı ki sanki içindekiler bir anda hareket etmeye başlayacakmış gibi görünüyor.",
