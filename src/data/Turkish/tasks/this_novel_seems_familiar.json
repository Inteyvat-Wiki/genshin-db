							"2201706",
							"2"
						],
						"stepId": 2201706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170401,
					"content": "Bunu hatırlıyorum. Bu gerilim romanı uzun bir süre popülerdi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170402
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170402,
					"content": "Başarısı, zekice oluşturulmuş gizemler içermesinden ve olay örgüsü yapısından kaynaklanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170403
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170403,
					"content": "Pek çok okuyucu olay örgüsünün bir kısmının takip edilmesinin imkansız olduğunu söylese de yazar yine de kendi ilkelerine bağlı kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170404
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170404,
					"content": "Bu nedenle bu roman, diğer gerilim romanlarının arasında öne çıkıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170405
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170405,
					"content": "Bu romanın da sağlam bir kurgusu yok mu? Kolayca değiştirilemeyen sağlam bir kurgu, bu tür bir gerilim romanının olay örgüsünü desteklemenin anahtarıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170406
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170406,
					"content": "Şey... Gezgin, burada başka bir kitap var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201705,
			"completionStepIds": [
				2201705
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201705",
							"2"
						],
						"stepId": 2201705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shigeru",
					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170501,
					"content": "Peki buna ne dersin? Mükemmel bir şekilde yazıldığını ve olay örgüsünün iyi tasarlanmış olduğunu hatırlıyorum. Editörler tarafından çok beğenildi. Ayrıca satışları da mükemmeldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170502
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170502,
					"content": "... Öyle miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170503
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170503,
					"content": "Katı olay örgüsüne ve kurguya o kadar kapılmıştı ki, hikayede genişlemeye yer yoktu. Sonunda sadece kendini tekrarlar oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170504
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170504,
					"content": "Yeni hikayeler sunmadığı için zaman içinde okuyucularını kaybetti. Sonunda okuyan kimse kalmadı ve rezil bir şekilde tarihe karıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170505
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170505,
					"content": "İster kurgu ister olay örgüsü olsun, kendini katı sınırlar içine hapsedersen tüm hikayeler birbirinin aynısı gibi görünecektir. Bu da aynı yerde dönüp durmana sebep olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170506
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170506,
					"content": "Romanımın böyle olmasını istemiyorum! Bir hikayenin sahip olması gereken en önemli şey canlılıktır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170507
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170507,
					"content": "Yazar kendi hikayesini okurken heyecan duymuyorsa okuyucuya aynı tutkuyu nasıl hissettirebilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170508
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170508,
					"content": "Shigeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170509
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170509,
					"content": "... Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170510
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170510,
					"content": "Bunları bu kadar düşündüğünü bilmiyordum. \"Dövüş Sanatları\" gibi bir roman yazmana şaşmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170511
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170511,
					"content": "Yaratıcılığını sınırlamak istemem ama çok fazla yazarın hayal güçlerinin peşine haddinden fazla kapılıp eserlerini mahvettiğini gördüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170512
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170512,
					"content": "Junkichi, bir yazar olarak yaratıcılık hakkında ne düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170513
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170513,
					"content": "Bunun yaratma arzusu olduğuna inanıyorum. Yaratma arzusu olmayan bir yazar, okuyucuları cezbeden kelimeler yazamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170514
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170514,
					"content": "Bana göre bir yazarın bu yaratıcı arzuyu ifade ederken kendini kısıtlaması daha da önemlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170515,
						220170516
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170515,
					"content": "Siz ikiniz hâlâ bir fikir birliğine varamıyorsunuz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170517
					]
				},
				{
					"id": 220170517,
					"content": "Shigeru, ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170518
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170518,
					"content": "Fakat bu romanın yazarı ben değilim, sensin. Ben sadece bitirmene yardım etmekle görevlendirilmiş bir editörüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170519
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170519,
					"content": "Fikirlerinde ısrarcıysan istediğin gibi bir yol izleyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170520
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170520,
					"content": "Sana katıldığımı söyleyemem. Ama seni anlamaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170521
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170521,
					"content": "Ah... Teşekkür ederim, Shigeru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170522
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170522,
					"content": "Rica ederim. Aklından geçeni anlıyorum. Fakat sen de benim konumumu anlamalısın. Örneğin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170523
					],
