			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Junkichi",
					"Shigeru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220170101,
					"content": "Benden bu kadar! İstediğin kadar yalvar, umurumda değil! Yazarlığı bırakıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170102
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170102,
					"content": "Hükümdarlar aşkına... Bu beni yedinci kez işi bırakmakla tehdit edişin... Ve birinde bile ciddi değildin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170103
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170103,
					"content": "Bu sefer niye kavga ediyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170104
					]
				},
				{
					"id": 220170104,
					"content": "Gezgin! Sonunda geldin! Bana yardım etmelisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170105
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170105,
					"content": "En son onun tarafını tuttuğundan beri istekleri bir türlü bitmedi. Bana düzinelerce kural koyuyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170106
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170106,
					"content": "İsimlendirmeden olay örgüsü tasarımına kadar. Bir dizi... yazı standardı oluşturmak istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170107
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170107,
					"content": "Böyle nasıl yazayım? Kendisi yazsın daha iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170108
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170108,
					"content": "Başarılı romanlardan bir dizi yazı ilkesi derledim. Denenmiş ve başarıya ulaşmış kılavuzlardan başka bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170109
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170109,
					"content": "Diğer romanların formülünü benimkine uygulamak istiyorsun. Kendi romanımı mı yazıyorum yoksa başka birinin romanını mı kopyalıyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170110
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170110,
					"content": "Kurallara bu kadar bağlı bir eseri kesinlikle yazmam... Böyle bir şey istiyorsan kendin yaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170111,
					"content": "Ayrıca Yae Yayınevinde zaten bunun gibi çürümeye yüz tutmuş bir sürü roman yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170112
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170112,
					"content": "Pazarlaması başarısız oldu; yoksa roman kötü değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170113
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220170113,
					"content": "Satış stratejisiyle hiçbir alakası yok. Bu tamamen o yazarların romanlarını yazma yönteminden kaynaklanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170114,
					"content": "Bütün bu kitapları bilmiyor olabilirsin ama ben bir yazar olarak Yae Yayınevinin yayınladığı her kitabı okudum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170115,
					"content": "Gezgin, benim için birkaç roman getirir misin? Shigeru ile önemli bir tartışmaya girmemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220170116,
						220170117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220170116,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220170117,
					"content": "Hangi romanları getireyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220170118
					]
				},
				{
					"id": 220170118,
					"content": "Ortalıkta bıraktığım romanları getir. Bunları genellikle, yazmamam gerekenleri kendime hatırlatmak için kullanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
