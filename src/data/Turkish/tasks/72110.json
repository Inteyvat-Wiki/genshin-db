			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "Neden Lord Kujou'nun eğitmeni olmak için dojodan ayrıldım ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100102,
					"content": "Yanagiha, Okazaki, Mifune... Neden beni bırakıp gittiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iwakura Mitsunari"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Okazaki Toraemon",
					"Yanagiha Arashi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "... Şimdi tek eksiğimiz Iwakura Kouin'in kılıcı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100202,
					"content": "Iwakura Klanının kadim \"Hakuen Michimitsu Amenoma\"sı demek... Hatırlıyor musun, Kunihiko ve sen daha yeni gelmiştiniz, Usta Eiin ise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100203,
					"content": "Kovulduk biz. Artık ona \"Usta\" demene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100204,
					"content": "Ama Okazaki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100205,
					"content": "\"Sevgi hakikatle boy ölçüşemez. Gerçek bir kılıç ustası her daim hakikat yolunda yürümelidir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100206,
					"content": "Bu sözleri bize bizzat Ustamız söylemişti. Bizi kovmak istemiyordu ama başka seçeneği yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100207,
					"content": "İstemiyordu tabii. Ama nihayetinde o Şogun'un kılıcı olup Önsezi Avı Fermanını dayatmayı seçti. Bizim de artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100208,
					"content": "Bizim de artık kendi hakikat yolumuzu bulmamız gerek. Ne demişler? \"Gerçek bir kılıç ustası her daim hakikat yolunda yürümelidir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100209,
					"content": "Hakikat deyip duruyorsun ama bizim Ustamız kendi hakikatlerini bizzat yerle bir etmiş bir adam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100210,
					"content": "Haklısın. Hepsinin intikamını alacağız. Kunihiko, diğerleri, hatta Iwakura Kouin'in bile intikamını alacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100211,
					"content": "Kovulmamıza neden olan hakikatlerden şaşmayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100212,
					"content": "Baksana, Ustamız her şeye rağmen bize yardım etmeye devam ediyor. İntikam yolumuzun ilk hedefi ayağımıza gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "Yanagiha Arashi"
				},
				{
					"id": 721100213,
					"content": "#Haklısın. Sen {NICKNAME} olmalısın. Hikayeni işittim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "Okazaki Toraemon"
				},
				{
					"id": 721100214,
					"content": "Bizim gibi kılıç ustalarının dünyasında kanı yalnızca kan temizler. Eski Iwakura Sanatı Dövüşçüsü Menkyo Kaiden ile yüzleşmeye hazır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Okazaki Toraemon"
				}
			]
		},
		{
			"id": 7211003,
			"completionStepIds": [
				7211014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
