			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Iwakura Mitsunari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "Neden Lord Kujou'nun eğitmeni olmak için dojodan ayrıldım ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100302,
					"content": "Yanagiha, Okazaki, Mifune... Neden beni bırakıp gittiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100303,
					"content": "Iwakura Sanatı öğrencileriyle karşılaştım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100305,
					"content": "Beceriksizliğiyle nam salmış Ustalarına rağmen hâlâ Iwakura'nın öğrencisi olduğunu söyleyenler varmış demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100306,
					"content": "Ben Iwakura Mitsunari. Buralarda kılıç eğitmeni olarak bilinirim. Sen kimsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100307,
					"content": "#Ben {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "Mifune, Tanba... Onlarla karşılaştın mı? Ya da Okazaki kardeşlerle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100309,
					"content": "Ah, bir de Katayama vardı. Girdiği her düelloya isim vermeye bayılırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100310,
					"content": "\"İleride büyük bir kılıç ustası olacağım sonuçta. Girdiğim düellolara hikaye yazmaları kolay olsun.\" derdi. Hahaha, çocuk işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100311,
					"content": "Shimada'yı da unutmamak gerek tabii. \"Eiin\" ve \"Kouin\" dönemlerinde durmadan çalışmasına rağmen Shoden rütbesinin üzerine çıkamamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100312,
					"content": "Yüce Şogun'un Önsezi Avı Fermanının gücüyle baş edemedikleri için kaçıp haydut oldular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100313,
					"content": "Onlara kılıç savurmayı öğrettiğim eski günleri çok özlüyorum. Neden dojoyu kapatıp orduya katıldım ki ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100314,
					"content": "#Becerileri nasıldı {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100315,
					"content": "Üzgünüm ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "Demek öyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100318,
					"content": "#Peki senin ustan kim {NICKNAME}? Domon mu? Shousen mi? Yoksa bizzat Narukami'den mi eğitim aldın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100319,
					"content": "Kendi kendimi eğittim diyebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100321,
					"content": "Demek ki Iwakura Sanatı benim Ustalığım döneminde zayıflamış. Öğrencilerimin hiçbiri kendi kendini yetiştiren bir kılıç ustasını yenememiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100322,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "Öyle demek? Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100324,
					"content": "Hangi kılıç tekniği okulunun öğrencisi olduğun mühim değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100325,
					"content": "Demek ki Iwakura Sanatı benim Ustalığım döneminde zayıflamış. Öğrencilerimin hiçbiri, okulunun adını bile vermek istemeyen birini yenememiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100326
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100326,
					"content": "Gerçekten de beceriksiz bir Iwakura Sanatı Ustasıyım. Bana kılıç ustası Iwakura Kouin derler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100327
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100327,
					"content": "Gizli kılıç tekniğimizin en önemli unsurunu unutmuş olsam da, Önsezimi Yüce Şogun'a kurban etmiş olsam da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100328
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100328,
					"content": "... Çöküşümü görmeyi kaldıramayıp lanetlenmiş ruhların izini takip eden öğrencilerimin intikamını almak istiyorum hâlâ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100329
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
				{
					"id": 721100329,
					"content": "... Öğrencilerim sana yenilmiş olabilir ama benim içimdeki ateş zayıf da olsa yanmaya devam ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100330
					],
					"speakerTitle": "Iwakura Mitsunari"
				},
