			"dialogs": [
				{
					"id": 751480201,
					"content": "Hı? Gukuzor muydu o? Demek Gukuzorlar gerçekten de heykelleri buraya getiriyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480202,
					"content": "Bir saniye. Az önce heykeli alıp... Kraterin içine mi atladı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480203,
					"content": "Burası yanardağın ağzı, değil mi? Manzaraya bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480204,
					"content": "Hımm... Yanardağın ağzında çok fazla Gaz Filojiston olduğunu duymuştuk, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480205,
					"content": "Aa, doğru ya! Şu Gukuzorun yaptığı gibi <color=#00E1FFFF>Gaz Filojistondan geçmenin bir yolunu bulabiliriz</color>!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480206,
					"content": "Ama şey... Biraz... *yutkunur* Yüksekte değil miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480207,
						751480210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480207,
					"content": "Merak etme Paimon. Ben seni taşırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480208
					]
				},
				{
					"id": 751480208,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480209,
					"content": "Sen de atlamaya hazır mısın yani? Şey... Peki. M-Madem öyle Paimon da artık korkmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480214,
					"content": "Sırf yükseklikten değil bu arada, bir de Gaz Filojiston var, unutmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480215,
					"content": "H-Her neyse, hazır olunca atlayalım hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480210,
					"content": "Tam inerken beni tutman lazım ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480211
					]
				},
				{
					"id": 751480211,
					"content": "Olmaz! Güç sorunu bir yana, zamanlamayı nasıl tutturabiliriz ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480212,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480213,
					"content": "Sus sen de! Bu deliliğe \"raaarr\"layıp durma! *iç çeker*... İşin tüm heyecanını öldürdünüz!",
