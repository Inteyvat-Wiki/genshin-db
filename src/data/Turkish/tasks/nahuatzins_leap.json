			"dialogs": [
				{
					"id": 751480101,
					"content": "Ejderhaların Seçilmişi, Ejderhaların Seçilmişi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480102,
					"content": "Tacın en yüksek noktasına ulaş ve Kutsal Dağ'ın alevlerine atla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480103,
					"content": "Git ve onu bul. Altın mührü kır ve baki alevlerin parlaklığını ortaya çıkar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480104,
					"content": "Rraarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480105,
					"content": "Ne oldu? Yine garip sözcükler mi gördün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480106,
						751480107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480106,
					"content": "Sözcükler artık... Daha net...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				},
				{
					"id": 751480108,
					"content": "Yanardağa yaklaştığımız için mi oldu diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480109,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480110,
					"content": "... Bunca zamandır sizinle konuşan kişi dağda gibi sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480111,
					"content": "Neyse, sözcükler yanardağa yaklaştıkça göründüğüne göre demek ki doğru yoldayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751480112,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480107,
					"content": "Yaklaşıyoruz sanki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				}
			]
		},
