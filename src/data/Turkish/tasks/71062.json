			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Anton",
					"Danila",
					"Temur",
					"Radomir"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "Çok zayıflar. Birkaç tekme attın mı yere yıkılırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620702,
					"content": "Dur bir dakika! Lütfen bekle! Bize biraz yiyecek verirsen istediğini yaparız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620703,
					"content": "Hıh... Gerçekten yiyeceğe muhtaçlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620704,
					"content": "Bana amacınızı söyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "Şöyle söyleyeyim: Her ne kadar bizden şüphe duysan da buradaki tek amacımız Kanyon'da yaşanan felaketin kaynağını soruşturmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620707,
					"content": "Ne felaketi? Paimon Kanyon'da felaketle ilgili bir işaret görmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620708,
					"content": "Beş yüzyıl önce meydana gelen felaket yalnızca başlangıç. Karanlığa karşı savaş hiç sonra ermedi ve savaş alanlarından biri de hemen ayaklarımızın altında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620709,
					"content": "*iç çeker* Serjant Komutanımız o kadar aç ki çılgınca konulardan bahsetmeye başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620710,
					"content": "Abartmayı hep sevmiştir ama daha önce hiç böyle saçmalamamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620711,
					"content": "Boş ver. Antoha doğru söylüyor, Liyue halkı bizim düşmanımız değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620712,
					"content": "En azından bizim düşmanımız değil. Kaybolan yoldaşlarımıza gelince, onlar sizi gördüğünde ne düşünür bilemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620713,
					"content": "Tamam, bu seferlik size yardım edeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "Size nasıl güvenebilirim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
