				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "*öf* Acelen varsa seni durdurduğumuz için kusura bakma. Ben Serjant Anton Melnikov, Dokuzuncu Bölüğün Komutan Vekiliyim. Bana Anton diyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620102,
					"content": "Bunlar Danila, Temur, Radomir ve... ah, Romanski. O burada değil. Tıbbi kampta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620103,
					"content": "Ne Romanski'den ne de tıbbi kamptan bir eser kaldı Antoha. Romanski sabahı atlatamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620104,
					"content": "Danila, sana kaç kere söyleyeceğim? Artık bölükten ben sorumluyum. Bana Serjant Anton diye hitap et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620105,
					"content": "Ha! Serjant olarak bölükten sorumluymuş. Sen kim olduğunu sanıyorsun? Kapitan kaybolduğundan bu yana önemli bir komutan gibi davranıyorsun. Hah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620106,
					"content": "Yeter Temur. Karnındaki guruldama aklını bozmuş olmalı. Sakin ol ve enerjini sakla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620107,
					"content": "\"Komutan Vekili\" Antoha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620149,
					"content": "Komutan Vekiliymiş, hadi canım sende. Bu sahte Komutandan emir almayı daha ne kadar sürdüreceğiz? Ne yaptığını bile bilmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620150,
					"content": "Hey Temur, beynin açlıktan karman çorman olmuş. Aklının başına gelmesi için birkaç yumruk yemeni öneririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620151,
					"content": "Bana uyar. Buyur! Hadi gel de ben de senin aklını başına getireyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620152,
					"content": "Harika! Yiyeceklerimizden sonra şimdi akıl sağlımızı ve sabrımızı da kaybediyoruz. Mükemmel! Sahip olduğumuz enerjiyi sonuna kadar tüketelim. Ne kadar akıllıca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620108,
					"content": "Öhöm! Sessizlik! Dövüşmeye can atıyorsan gidip siyah çamurdan gelen canavarlarla dövüş. Onlarla guruldayan karnınla dövüşmeyi de sakın unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620109,
					"content": "Yaşamımızı sürdürmek ve buradan canlı çıkmak istiyorsak birbirimizden ayrılmamalıyız. Bana tekrar ettirme, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620110,
					"content": "Pekala, üç deyince, \"Biz değilsek kim?\" diye bağırın. Bir, iki, üç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620111,
					"content": "Biz değilsek kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620112,
					"content": "Biz değilsek kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620113,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620114,
					"content": "Şimdi, dostum, şu anda... *öksürür* mücadele kabiliyetimizin düşük olduğunu fark etmişsindir. Ufak bir... Sorunumuz var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620115,
					"content": "Hıh, \"ufak bir sorun\" demek. Tıpkı Kapitan gibi konuşuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620116,
					"content": "O burada olmadığı için komutan vekili benim. Şu çok bilmiş çeneni kapatacak mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620117,
					"content": "Üzgünüm dostum. Yardımına çok ihtiyacımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
