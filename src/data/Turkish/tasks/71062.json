			"dialogs": [
				{
					"id": 710621001,
					"content": "En azından bize yiyecek verdiğin için teşekkür ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621002
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621002,
					"content": "Buradan çıkmanın bir yolunu bulacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
		{
			"id": 7106211,
			"completionStepIds": [
				7106207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106207",
							"2"
						],
						"stepId": 7106207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Radomir",
					"Danila",
					"Temur"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "Dönmüşsün. Durum nasıl? Tedarik noktasından bir haber var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621102,
					"content": "Tedarik noktası terk edilmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "Öyle mi? Peki, bir şey buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621104,
					"content": "Korkarım artık Liyue Limanı'nda istenmiyorsunuz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621106,
					"content": "Bunun dışında başka haberlerin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621107,
					"content": "Ah... Bir mektup bulduk. Sanırım senin için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710621108,
					"content": "İşte bak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "Fatui askerleri mektubu okur...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "Ah, Yanbo göndermiş. Anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621111,
					"content": "Ne olmuş? Taşordu da mı gitmiş? Bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621112,
					"content": "*iç çeker* Onların derdi ne? Biz onlar için mücadele veriyoruz. Müttefik değil miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621113,
					"content": "Artık müttefik diye bir şey yok. İş birliği sona erdi. Açık konuşmak gerekirse Fatui, artık Liyue ile iş birliği yapmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621131,
					"content": "Bu bir ihanet! Liyue halkı bize ihanet etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621132,
					"content": "Belki de onların gözünde bunun tersi doğrudur? Belki de bizim yani Fatui'nin onlara ihanet ettiğini düşünüyorlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621114,
					"content": "Bu doğru olamaz! Biz buraya Liyue halkını korumak için geldik. Kapitanın yola çıkmadan önce ne söylediğini hatırlamıyor musunuz? \"Bu keşif seferinin komplo planlarıyla veya entrikalarla hiçbir ilgisi yok.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710621115,
					"content": "Bu, bize karşı komplo planları veya entrikaların düzenlenmesine engel değil. Bunu kontrol edemeyiz Danila.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710621116,
					"content": "Anlıyorum. *Derin nefes alır* Kararımı verdim... Geri çekilmeliyiz, ne kadar çabuk olursa o kadar iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621117,
					"content": "Sorun değil. Tüm sorumluluğu ben alıyorum. Aramızda bir firari varsa... Dokuzuncu Bölüğün şerefini lekeleyecek herhangi bir firarinin sorumluluğu sadece bana ait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621118,
					"content": "Danila haklı. Biz buraya Liyue halkını Karanlığın Felaketinden korumak için geldik. Burayı böyle terk edemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621119,
					"content": "Kişisel onurun konusunda endişelenmek için sence doğru zaman mı Mirka? Anlamıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621120,
					"content": "Liyue halkı bizim korumamıza ihtiyaç duymuyor ve bizi burada istemiyor! Kendilerini kahraman sanan yoldaşlarımızı bile alt etmişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621121,
					"content": "Evet, Liyue halkının güvenine ihanet ettiniz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "Tercihen sessiz bir şekilde geri çekilmeliyiz. Çevredeki Taşordu askerlerine yakalanmamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621124,
					"content": "Kapitan burada hayatımızı feda etmeye hazır olmamız gerektiğini söyledi. Biz de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621125,
					"content": "Ayrıca kimsenin boş yere ölmemesi gerektiğini de söyledi. Bütün bölüğün burada gömülmesini istemezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621126,
					"content": "En azından hâlâ hayattayız. En azından Dokuzuncu Bölüğün tamamı yok olmadı. Anlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621127,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621128,
					"content": "Evet efendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710621129,
					"content": "Tamam, başka sorusu olan var mı? İtiraz duymak istemiyorum. Dağılabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621130,
					"content": "#{NICKNAME}, en azından bize yardım ettiğin için teşekkür ederiz. Bu Morayı ve bu erzakı alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				},
				{
					"id": 710621122,
					"content": "Sonraki hamlenizi iyi düşünün.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				}
			]
		},
