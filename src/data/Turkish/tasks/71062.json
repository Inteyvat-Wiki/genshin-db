						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton",
					"Danila",
					"Temur",
					"Radomir",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "*iç çeker* Üzgünüm ama komuta zincirimizde ufak bir sorun var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620902,
					"content": "\"Ufak bir sorun\" mu? Başkası adamlarımızı kovalarken biz burada bomboş durup olanları izlemekle yetindik. Onlara ihanet ettik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620903,
					"content": "Ya ne yapsaydık? Bizi de dövüp yiyeceklerimizi almalarına izin mi verseydik? Kapa şu çeneni ve yemene bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620904,
					"content": "Antoha, bunu önemsiz göstermeyi bırak. Komuta zincirimiz yok oldu. Bitip gitti! Yüzbaşılarımız ve diğer yüksek rütbeli komutanlar ya ortadan kayboldu ya da öldürüldü... Bu da bize geri çekilmekten başka seçenek bırakmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620905,
					"content": "Ama adamlarımızın birçoğu bunu reddediyor. Komutanlarımızın geride bıraktıklarına dayanıp tek bir adam kalana kadar mücadele vermeyi tercih ediyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620906,
					"content": "Tek bir adam kalana kadar \"açlıktan ölmeyi\" tercih ediyorlar demek daha doğru olur. İş birliği anlaşmamız doğrultusunda yukarıdakilerin emirleri iletip bize yiyecek göndermesi gerekiyordu ama uzun süredir onlardan haber almadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620907,
					"content": "Fatui'ye ve Haberci Efendilerimize daima sadığız. Bizden beklenen de bu ama aptal da değiliz. Aklı başında biri bu şartlar altında geri çekilmemizi uzun zaman önce söylerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620908,
					"content": "O halde planınız ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "Hımm... Bu senin sorunun değil, biliyorum. Gitmek istersen seni durdurmaya kalkmam ancak gerçekten zor durumdayız ve yardımına muhtacız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620910,
					"content": "Düşünmem lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "Tamam. Dikkatli ol. Etraftaki diğer yoldaşlarımız bizim kadar dost canlısı olmayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620913,
					"content": "Sana bunu söylememem gerekiyor ama zemin seviyesinin yakınlarında bir tedarik noktası var. Tüm erzakımız oraya gider. Bazen oradan emirler de alırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620914,
					"content": "Yiyecek getirmeleri için birkaç adam gönderdik ama henüz dönmediler... Başka adam göndermeyi de göze alamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620915,
					"content": "Ayrıca uzun zamandır tedarik noktasından kimse gelmedi. Umarım benim için oradaki durumu kontrol edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620916,
					"content": "Biraz düşüneyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "Seni zahmete soktuğum için üzgünüm fakat yüzeyde ne olduğunu bilmek zorundayım. Aksi halde aldığımız kararlar çok riskli olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620919,
					"content": "Tamam, tamam, gereksiz lafların Paimon'un kafasını karıştırmaya başlıyor. Yolumuz düştüğünde bakarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620917,
					"content": "Yardım edeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "Ne yapmam gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
		{
			"id": 7106210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
