			"dialogs": [
				{
					"id": 710620137,
					"content": "Önce bana amacınızı söyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "Pekala, şunu söyleyeyim: Her ne kadar bizden şüphe duysan da buradaki tek amacımız Kanyon'da yaşanan felaketin kaynağını araştırmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620141,
					"content": "Ne felaketi? Paimon Kanyon'da felaketle ilgili bir işaret görmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620142,
					"content": "Beş yüzyıl önce meydana gelen felaket yalnızca başlangıç. Karanlığa karşı savaş asla sonra ermedi ve savaş alanlarından biri de hemen ayaklarımızın altında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620143,
					"content": "*iç çeker* Serjant Komutanımız o kadar aç ki çılgınca konulardan bahsetmeye başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620144,
					"content": "Abartmayı hep sevmiştir ama daha önce hiç böyle saçmalamamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620145,
					"content": "Boş ver. Antoha'nın demek istediği, Liyue halkının bizim düşmanımız olmadığı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620146,
					"content": "En azından bu operasyonda, Dokuzuncu Bölük olarak bizim düşmanımız değiller. Ancak kaybolan yoldaşlarımızın bu konuda ne düşüneceğinden pek emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620147,
					"content": "Bu seferlik insanlık adına size yardım edeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "T-Teşekkürler! Sana sonsuza dek minnettar kalacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
