				"points": []
			},
			"dialogs": [
				{
					"id": 710620128,
					"content": "Sonra?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620131
					]
				},
				{
					"id": 710620131,
					"content": "Burayı terk edip bir daha dönmeyeceğiz. Sana Dokuzuncu Bölük ve Snezhnaya topraklarını savunan atalarımız adına söz veriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620132
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620132,
					"content": "*iç çeker* Vah zavallı, ne kadar acıkmışsın, ne kadar acınası hale gelmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620133
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620133,
					"content": "Bu kadarı yeter. Senin de durumunun daha iyi olduğu söylenemez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620134
					],
					"speakerTitle": "Radomir"
				},
				{
					"id": 710620134,
					"content": "Neyse, geldiğimizde 64 kişiydik, toplam 64 kişi! Şimdi yalnızca açlıktan ölmek üzere olan dördümüz kaldık. Başka hangi amacı gerçekleştirebiliriz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620135
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620135,
					"content": "Vay be! Nasıl oldu da bu hale düştünüz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620136,
					"content": "Şimdi konumuz bu değil. Yiyecek bulamazsak Dokuzuncu Bölüğün kalan son dört üyesi de her an yok olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
