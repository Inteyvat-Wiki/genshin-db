			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Anton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620118,
					"content": "Biz ne zaman \"dost\" olduk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620121
					]
				},
				{
					"id": 710620121,
					"content": "Ne istiyorsun? Erzak, silah, istihbarat, Mora... Bizde bolca var. İstersen tümünü al, yeter ki bize yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620122
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620122,
					"content": "Şuna bak, dilenci Komutanımız en utanç verici işi yapıyor. Kalan son bir parça itibarımızı da kaybetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620123
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620123,
					"content": "Şunu kes artık! Alay ederek karnını doyurmayı mı bekliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620124
					],
					"speakerTitle": "Danila"
				},
				{
					"id": 710620124,
					"content": "\"Saflarımıza katıl! Adımlarımız dünyayı yıldırım gibi sarssın. Kutup yıldızına doğru bizimle yürüyecek olan sen, bize katıl! Seni asla terk etmeyeceğiz...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620125
					],
					"speakerTitle": "Temur"
				},
				{
					"id": 710620125,
					"content": "Biri şunun sesini kessin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620126
					],
					"speakerTitle": "Anton"
				},
				{
					"id": 710620126,
					"content": "Ah... Hepsi kötü adamlar olsa da onların aç olduğunu görünce Paimon yine de üzülüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710620127,
					"content": "Bunu söylemekten utanıyorum ama... Gördüğün gibi artık hiç mücadele edecek halimiz yok. Tek istediğimiz biraz yemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anton"
				}
			]
		},
