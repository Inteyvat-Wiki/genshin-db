							"2"
						],
						"stepId": 7351101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Shriya",
					"Fodil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110101,
					"content": "Şu aptal... Tek başına öylece çöle doğru koşturdu gitti! Fodil, bir şey yap lütfen! Git ona yardım et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110102
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110102,
					"content": "Kusura bakma. Köyün güvenlik güçleri sınırlı, herhangi bir sorun çıkarmasınlar diye \"onlarla\" uğraştığımız için şu anda buna yeterli güç ayıramayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110103
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110103,
					"content": "Ama o aptal onlarla baş etmek için çok uğraştı! En azından ortak çıkarlarımız için...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110104
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110104,
					"content": "Yardım etmek istemediğimizden değil ama muhafızlar şu anda onları aramak için çölün dört bir yanına dağılmış haldeler. Ekibi bir araya toplamak biraz vakit alacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110105
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110105,
					"content": "Nasıl olur? Yardım istemek için Ribat Kervanı'na dönersek de çok geç olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110106,
						735110107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110106,
					"content": "Birisi mi tehlikede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				},
				{
					"id": 735110108,
					"content": "Ha? Siz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110109
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110109,
					"content": "Ben yoldan geçen bir maceracıyım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110110
					]
				},
				{
					"id": 735110110,
					"content": "Paimon da onun en iyi arkadaşı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110111,
					"content": "Maceracılar mı? Gerçekten mi? Şükürler olsun! Sonunda Vinayak için yardım geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110112
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110112,
					"content": "#Maceracı {M#Bey}{F#Hanım}! Lütfen kurtarın Vinayak'ı. Sizi cömert bir şekilde ödüllendireceğiz, içiniz rahat olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110113
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110113,
					"content": "Önce neler oluyor bir anlatın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110114
					]
				},
				{
					"id": 735110114,
					"content": "Etrafta dolaşan şu sefil haşerat yüzünden çöl iyice tehlikeli bir hale geldi. Bir plan yapmadan önce olup biteni anlatsam daha iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110115
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110115,
					"content": "Şey... Haklısınız. Kusura bakmayın, biraz gerildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110116
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110116,
					"content": "Paimon başından beri dinliyor da... \"Onlar\" dediğiniz ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110117,
					"content": "Bir Solucan sürüsü. Nedense son zamanlarda normalden daha saldırgan hale geldiler. Kum fırtınalarına saklanıp habersizce gelip geçen avlarına saldırıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110118,
						735110119
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110118,
					"content": "Onlar sadece böcek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110120,
					"content": "Böyle söyleyince evet, öyleler ama bu defa onlardan bir sürü var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110121
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110121,
					"content": "Kum fırtınasının içinde onlarla baş etmek zor. Ayrıca ufacık bir tehlike sezerlerse hemen kaçıyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110122
					],
					"speakerTitle": "Fodil"
				},
				{
					"id": 735110122,
					"content": "Vay canına, bu gerçekten zor bir durum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110123,
					"content": "Sadece Aaru Köyü de değil, buradan geçen bazı tüccarlar da bu durumdan etkilendi. Akademi de bu zapt edilemeyen Solucanların üstesinden gelmemiz için Vinayak'la beni yolladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110124
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110124,
					"content": "Ancak ulaştırması için bazı parçalar verdiğimiz kervan, yolda Solucanların saldırısına uğradı ve parçalar kum fırtınalarında dağılıp gitti... Korkarım şimdiye kadar çoktan canavarların elinde oyuncak olmuşlardır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110125
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110125,
					"content": "Ribat Kervanı'na dönüp yardım etmek istedim ama Vinayak'ın... Bunca yıldan sonra hâlâ bir makina gibi sağlam olabileceğini kim bilebilirdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110126
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110126,
					"content": "Değerli parçalarını geri almayla ilgili bir şeyler söyleyip tek başına çöle doğru koştu gitti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110127
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110127,
					"content": "Off! En iyisi canavarların eline bırakayım gitsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110128
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110128,
					"content": "#Vay canına... Ne yapacağız {NICKNAME}? Eğer bu işi böylece bırakırsak hem o araştırmacının hayatı tehlikeye girer hem de Solucan sorunu olduğu gibi kalır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110129,
						735110130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110129,
					"content": "Çöldeki bu sorunu görmezden gelemeyiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110131,
					"content": "Teşekkürler! Çok teşekkür ederim! Bir an öfkeme yenik düştüğüm için kusura bakmayın... Saldırının olduğu yeri haritada işaretleyeceğim. Lütfen onu bir an önce bulun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110132
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110132,
					"content": "Umarım parçalarını geri almak için canavarların arasına dalmak gibi saçma bir fikre kapılmamıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735110130,
					"content": "Kurtarma işini bana bırakın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110131
					]
				},
				{
					"id": 735110119,
					"content": "Çok daha büyük canavarların icabına bakmıştım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110120
					]
				},
				{
					"id": 735110107,
					"content": "Yardıma mı ihtiyacınız var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110108
					]
				}
			]
		},
		{
			"id": 7351103,
			"completionStepIds": [
				7351103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
