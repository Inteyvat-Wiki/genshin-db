			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vinayak"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735110301,
					"content": "Bu açıdan girip araziyi siper olarak kullanırsak... Güneş ışığının açısı en fazla şu kadar olsa... Hızım da en az şu kadar olsa... Hımm, yine de olmuyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110302
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110302,
					"content": "Neyi çözmeye çalışıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110303
					]
				},
				{
					"id": 735110303,
					"content": "Canavarlara denk gelmeden parçaları geri almaya uygun bir yol... Solucanlar yüzünden tüm değerli parçalarımı o canavarlar alıp götürdü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110304
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110304,
					"content": "Aaa! Siz de kimsiniz? Ne zaman geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110305
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110305,
					"content": "Bir süredir kendi kendine konuşmanı dinliyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110306
					]
				},
				{
					"id": 735110306,
					"content": "Sakin ol. Biz kötü değiliz. Arkadaşın bizi buraya gönderdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110307,
					"content": "Arkadaş mı? Shriya mı? Hayır, eğer canavarlara yakalanırsam umurunda bile olmayacağını söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110308
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110308,
					"content": "Ah, tabii ya. Sizi parçaları almanız için gönderdi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110309
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110309,
					"content": "Canavarlara yakalanıp yakalanmamış olmam önemli değil ama parçaların geri alınması önemli bir mesele... Evet, bu tam da onun söyleyeceği bir şey gibi geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110310
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110310,
					"content": "... Öyle de diyebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735110311
					]
				},
				{
					"id": 735110311,
					"content": "Yine de teşekkürler. Nasıl yapacağımı bulmak için kendimi zorluyorum, neredeyse dışarı çıkıp her seferinde bir adımımı hesaplayarak ilerleyecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110312
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110312,
					"content": "... Tek yanlış adımımda anında canavarlara yakalanırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110313
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110313,
					"content": "Ah... Shriya'nın ne kadar sakar olduğu belli, ben de olmasaydım... O makinalarla kim ilgilenirdi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110314
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735110314,
					"content": "Shriya'nın o kadar endişeli olmasına şaşırmamalı... Bu adamın mekanik parçalardan başka bir şey düşündüğü yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735110315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735110315,
					"content": "#{NICKNAME}, hadi o yine başını belaya sokmadan gidip şu parçaları alalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
