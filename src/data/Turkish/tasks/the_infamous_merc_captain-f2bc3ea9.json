			"dialogs": [
				{
					"id": 402250101,
					"content": "Bir dakika, yoksa bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250102,
					"content": "Alcor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250103
					]
				},
				{
					"id": 402250103,
					"content": "Aslında bu filomuzdaki ikinci gemimiz. Alcor, Guyun Taş Ormanı'nda devriye gezmek üzere geri döndü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250104
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250104,
					"content": "Beidou! Engin denizlere nam salmış paralı asker kaptanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250105,
					"content": "Evet, haha. Tanışmıştık, unuttun mu yoksa? Bu resmiyet de nereden çıktı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250106
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250106,
					"content": "Uzun hikaye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250107,
					"content": "Pekala, öyle dikilip durmayalım. Geçip oturun da anlatın bakalım. Ben de çocuklara söyleyeyim, sizi güzelce ağırlasınlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250108
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250108,
					"content": "Ha, anladım. Demek Arşiv'in başındaki o kodamanı tanıyorsunuz... Bağlantılarınız gerçekten inanılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250109
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250109,
					"content": "Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250110,
					"content": "Kayıt hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250111
					]
				},
				{
					"id": 402250111,
					"content": "Doğru! Fuara katılanların ve neleri satışa sunmayı planladığının bir kaydı gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250112,
					"content": "Tamam, beni ve birkaç mürettebat üyesini katılımcı olarak not edin. Diğerleri gemide kalacak. Ne satacağımıza gelince... Şuna bir bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250113
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250113,
					"content": "Bu nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250114,
					"content": "Ningguang geçenlerde Guizhong Balistasını yeniledi. Burada gördüğün güzellik de onun yeni ve geliştirilmiş modellerinden biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250115
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250115,
					"content": "İnanılmaz bir ateş gücüne sahip ve uzaktan yönlendirme özelliğiyle uzun mesafelerden bile isabetli vuruşlar yapabiliyor. İnsanların bunu almak için birbirine gireceğinden adım gibi eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250116
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250116,
					"content": "Böyle şeyleri satmana izin var mı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250117,
					"content": "Haha, merak etme. Taşordu'nun kullandığı modelin yanında bu antika sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250118
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250118,
					"content": "... Nefer \"kısıtlama yok\" derken şaka yapmıyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250119,
					"content": "Ama kim böyle bir şeyi satın alır ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250120
					]
				},
				{
					"id": 402250120,
					"content": "Elbet birilerinin ilgisini çeker. Ne de olsa Teyvat'ın dört bir yanından alıcılar katılacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250121
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250121,
					"content": "... Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250122,
					"content": "Ah, kusura bakmayın. Kargo işlerine o kadar dalmışım ki Yelan'ın gemide olduğunu söylemeyi unuttum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250123
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250123,
					"content": "Sorun değil. Sen de mi fuar için geldin Yelan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250124,
					"content": "Hayır, sadece iş için buradayım. Kaptan Beidou sağ olsun beni buraya kadar getirdi. Beni fuara kaydetmenize gerek yok yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250125
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250125,
					"content": "#Neyse, görüşmeyeli uzun zaman oldu {NICKNAME}. Fırsatın olursa Arşiv'in patronuna selamlarımı ilet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250126
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250126,
					"content": "Ne tür bir iş?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250127
					]
				},
				{
					"id": 402250127,
					"content": "... Hassas türden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250128
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250128,
					"content": "Galiba bu, soru sormayı bırakmamız için bir işaret...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402250129,
					"content": "Aynen öyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402250130
					]
				},
				{
					"id": 402250130,
					"content": "Ben kaçtım o zaman. Bu işi halledersem içkiler benden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250131
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402250131,
					"content": "Hadi bakalım! Nod-Krai'ı bir de kafam iyiyken görmek için can atıyorum, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250132
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250132,
					"content": "Pekala, kayıt işlemleri bu kadar. Bizi takip edin, sizi etkinlik alanına götüreceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
