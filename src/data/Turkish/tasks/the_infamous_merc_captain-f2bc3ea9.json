			"dialogs": [
				{
					"id": 402250201,
					"content": "Beidou mürettebatına yükü boşaltmalarını söyledikten sonra sizinle birlikte fuar alanına doğru yola koyulur.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402250202
					]
				},
				{
					"id": 402250202,
					"content": "Demek mekan burası ha? Hiç fena değilmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402250203
					],
					"speakerTitle": "Beidou"
				},
				{
					"id": 402250203,
					"content": "Vaktin olduğunda gel de şunun uzaktan kumanda sistemini test edelim. Acayip heyecanlı, bayılacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Beidou"
