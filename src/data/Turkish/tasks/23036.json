			"dialogs": [
				{
					"id": 230360101,
					"content": "Lütfen yeni yemi tekrar deneyin Bay Kayvan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360102,
					"content": "Kaç kere denedim. Sonuç hep aynı, hep aynı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360103,
					"content": "Aa... Siz neden yine birlikte balığa çıktınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230360104,
					"content": "Selam Gezgin, yine karşılaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360105,
					"content": "Merhabalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360106,
						230360107
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360106,
					"content": "Balıkların yemleri yememe sebebini öğrenebildiniz mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				},
				{
					"id": 230360108,
					"content": "Hahaha! Hayır. Araştırmacıyla oltada, yemde değişiklikler yaptık ve balıkçılık tekniğimizi geliştirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360109
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360109,
					"content": "Farklı bir sürü su kütlesi ve açı denedik... İçi balıkla dolu bir süs havuzunda balık tutmayı bile denedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360110
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360110,
					"content": "Ne yaparsam yapayım sadece balık olmayan şeyler tutabildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360111
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360111,
					"content": "Merak etmeyin Bay Kayvan. Araştırmacı araştırmaya devam etme sözü vermedi mi? Eminim bunun ardındaki sebebi çözecektir bizim için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360112
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360112,
					"content": "Sizin için yeni bir yem bile tasarladı. Burada sizinle kalmamı ve balık tutma sürecinizle ilgili tüm detayları kayıt altına almamı istedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360113,
					"content": "Umarım başarılı olur... O zamana kadar kendi yöntemimle balık tutacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360114
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360114,
					"content": "Gezgin, sorun olmayacaksa bana daha fazla yemlik malzeme getirebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360107,
					"content": "Araştırmacılardan herhangi bir şey öğrendiniz mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360108
					]
				}
			]
		},
