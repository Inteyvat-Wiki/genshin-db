			"dialogs": [
				{
					"id": 230360601,
					"content": "Fena değil. Şimdi balık tutma vakti. Bu sefer kocaman bir balık yakalayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360602
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360602,
					"content": "Kayvan yemi hazırlar ve balık tutmaya başlar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360603
					]
				},
				{
					"id": 230360603,
					"content": "Kayvan bir süre sonra sırılsıklam bir paket yakalıyor.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230360604
					]
				},
				{
					"id": 230360604,
					"content": "Hımm... Bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360605
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360605,
					"content": "Ha? Bu paketteki şeyler... Yine kayıp eşya çıktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360606,
						230360607
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360606,
					"content": "Tam da senden beklediğim gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				},
				{
					"id": 230360608,
					"content": "Şey... Yemlerimizi değiştirmesi için araştırmacıya gittiğimizden beri Bay Kayvan'la balık tutuyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360609
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360609,
					"content": "Ama Bay Kayvan hâlâ her olta atışında tuhaf şeyler yakalıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360610
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360610,
					"content": "Kayıp eşyalar, nehir yatağındaki cevherler, gemilerden düşen paketler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360611
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360611,
					"content": "Hatta bir keresinde denize düşen bir maceracı bile sudan çıkabilmek için Bay Kayvan'ın olta misinasını tuttu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360612
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360612,
					"content": "Bir tek balık yakalayamıyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360613
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360613,
					"content": "Balıkçılık kariyerim böylece sona erdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360614
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360614,
					"content": "Bay Kayvan! Üzülmeyin! Bu eşyanın sahibi şimdi kara kara düşünüyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360615
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360615,
					"content": "Bunu çıkarmış olmanız onu kesinlikle çok mutlu edecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360616
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360616,
					"content": "Bu kayıp eşyaları Maceracılar Loncasına götürerek ödül bile alabilirsiniz belki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360617
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 230360617,
					"content": "Ama... Ben sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230360618
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360618,
					"content": "Ben sadece balık tutmak istiyorum ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 230360607,
					"content": "\"Yine\" derken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230360608
					]
				}
