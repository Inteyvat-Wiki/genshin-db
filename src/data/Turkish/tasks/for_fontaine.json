			"dialogs": [
				{
					"id": 742490101,
					"content": "Tüm işi yine size bıraktığım için çok üzgünüm Bayan Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490102,
					"content": "Hiç dert değil. Fontinalia Film Festivalindeki desteğinizden sonra bu kadarı boynumun borcu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490103
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742490103,
					"content": "Yok canım! Gösterinin asıl yıldızları oyunculardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490104,
					"content": "Peki sizin sahnelere geri dönmek gibi bir niyetiniz yok mu Bayan Furina?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490105
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742490105,
					"content": "Şey... Büyük konuşmamak lazım tabii... Ama şimdilik sahne arkasında çalışmayı tercih ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490106,
					"content": "Ne yalan söyleyeyim, henüz Fontaine'de yaşarken sizin kim olduğunuzu ben bile biliyordum; herkesin sevgilisi, süperstar Furina.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490107
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742490107,
					"content": "Of, lütfen durun! Ne yaparsanız yapın, sakın bana \"gösterilerini izleyerek büyüdüm\" demeyin... Kendimi çok tuhaf hissediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490108,
					"content": "Ah, o konuda içiniz rahat olsun. Ben sadece Fontaine'den ayrılırken sizi o zamanki halinizle görme şerefine eriştiğimi söylemek istemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490109
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742490109,
					"content": "Ama bunca zaman sonra sizi yeniden görünce, sanırım şimdiki duruşunuzu daha çok beğeniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490110
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742490110,
					"content": "Ha? Şu anki duruşumu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490111,
					"content": "Evet. Eskiden sahnede epey gergin görünüyordunuz, bugünlerde ise çok daha rahat duruyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490112
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742490112,
					"content": "Hehe... Bunu duymak ne güzel, teşekkür ederim. Aslına bakarsanız son zamanlarda hayattan çok daha fazla keyif almaya başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490113,
					"content": "Peki ya siz Bayan Guillotin? Şu anki yaşamınızdan memnun musunuz? Fontaine'den ayrıldığınız zamana kıyasla yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490114,
					"content": "Her şey yolunda gidiyor, gerçi sanırım bu büyük oranda bakış açımı değiştirmemden kaynaklanıyor. Doğrusu Fontaine'i hep sevmişimdir ve burası bana hep evim gibi hissettirmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490115
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742490115,
					"content": "Diğer uluslardan daha iyi demiyorum ama burada çok fazla anı biriktirdim... Hayat burada kimi zaman durgun bir su kadar sakin akarken kimi zaman da yepyeni değişimlerle dolup taşabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490116
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742490116,
					"content": "Son zamanlarda hayata güzel tarafından bakmayı öğrendim. Muhtemelen başka diyarlardaki insanlar da kendi memleketlerine aynı gözle bakıyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490117
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742490117,
					"content": "Vay canına... Ne kadar güzel söylediniz Bayan Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490118
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490118,
					"content": "Bu, çay saati adabına biraz aykırı olabilir ama... Kadeh kaldırmayı teklif ediyorum. Fontaine şerefine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490119
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490119,
					"content": "Haha... Vatanımıza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		},
