			"dialogs": [
				{
					"id": 742490201,
					"content": "Ahhh! Bu sakin ikindi çaylarından asla bıkmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490202,
						742490203
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490202,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742490204,
					"content": "Vay be... Neşeli anlar gerçekten de su gibi akıp gidiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 742490203,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742490204
					],
					"speakerTitle": "Kukla"
				}
			]
		}
	]
