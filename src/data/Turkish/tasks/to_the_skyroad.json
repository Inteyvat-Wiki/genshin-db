			"dialogs": [
				{
					"id": 751350101,
					"content": "Sunak şu mu? Ulaşması zor olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350102,
					"content": "#Biz uçarak gidebiliriz belki ama {REALNAME[ID(2)|SHOWHOST(true)]} ve Bona ne olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350103,
					"content": "Pardon da benim Çiçek Tüyü Klanından gelen bir maceracı olduğumu unuttunuz galiba... Uçma konusunda tecrübeliyimdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350104
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350104,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} sırtıma çıksa bile kolayca uçabilirim oraya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350105
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350105,
					"content": "Benim de uçuş sertifikam var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350106
					]
				},
				{
					"id": 751350106,
					"content": "Peki o zaman. Paimon önden gidecek, siz de takip edersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350107
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350107,
					"content": "Yarış mı yapacağız yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350108
					]
				},
				{
					"id": 751350108,
					"content": "Yarışın sırası mı şimdi canım? Sakin biraz! Ben önden giderim, siz de peşimden gelin işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350109
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350109,
					"content": "#Hımm... Bu çok tehlikeli olabilir, neler olacağı da belli değil... O yüzden sıkı tutun {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350110,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
