			"dialogs": [
				{
					"id": 751350201,
					"content": "Vay canına, Bona, ne hızlı uçtun öyle! Neredeyse yetişemiyorduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350202,
					"content": "Haha, özür dilerim. Kadim Ateş Sunağını ileride görünce kendimi tutamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350203
					],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350203,
					"content": "Şimdi bu Sunağı kullanırsak Tonatiuh'ya gidebiliriz, değil mi? E peki dev bir rüzgar akımı bizi havalandırsa bile oraya ulaşmak için ne kadar uzun süre uçmamız gerekir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350204,
					"content": "Of, Paimon bunları düşündükçe gerildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350205,
						751350207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350205,
					"content": "Korkma Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350206
					]
				},
				{
					"id": 751350206,
					"content": "İyi peki, madem öyle diyorsun. Ama Paimon'dan fazla uzaklaşma, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751350209,
					"content": "Neyse, Sunakta Ateş Fosforiti adayacağız, değil mi? Ama şey, elimizde iki tane kaya var... İkisini de koyalım, ne olur ne olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bona"
				},
				{
					"id": 751350207,
					"content": "Çok heyecanlı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350208
					]
				},
				{
					"id": 751350208,
					"content": "Değil mi? Paimon da çok heyecanlandı. Hiçbir maceracı böyle bir mücadeleyi kaçırmak istemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "Bona"
				}
			]
		}
