			"dialogs": [
				{
					"id": 790580101,
					"content": "Bu, \"Büyük Kaçış\" gösterisinden bir sahne.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580102
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790580102,
					"content": "Asıl hikaye, gizemli bir mağarada kapana kısılan ve özgürlüğe ulaşmak için yalnızca bir kitaba gizlenmiş aletleri kullanabilen bir Su Tayfıyla ilgiliydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580103
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790580103,
					"content": "Ancak Idyia bu fikri açıkça reddetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580104
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790580104,
					"content": "Gerçi haklıydı, çünkü Su Tayflarının mağaradan kaçmak için alet kullanmalarına gerek yoktu, istedikleri an oradan çıkabilirlerdi. Ayrıca kitabın içine alet saklanmış olması pek de gerçekçi değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580105
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790580105,
					"content": "Fakat... Bu gerçekten çok etkileyici bir fikir! Keşke Idyia da ne kadar parlak bir fikir olduğunu görebilseydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580106
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790580106,
					"content": "Ama ne yazık ki ilk olarak <color=#00E1FFFF>dağ yabanilerinin çaldığı, içinde aletlerin olduğu kitabı</color> geri almalıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790580107
					],
					"speakerTitle": "Sahne Notları"
				},
				{
					"id": 790580107,
					"content": "- Rejisör",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sahne Notları"
				}
			]
		},
