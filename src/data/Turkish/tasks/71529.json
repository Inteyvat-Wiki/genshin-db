			"dialogs": [
				{
					"id": 716665101,
					"content": "Tebrikler. Beni yendin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "Şekilden Öte Nitelik Önemli"
				},
				{
					"id": 716665102,
					"content": "#{NICKNAME} karşısında mağlup olmak bile bir onurdur diyebilirim hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "Şekilden Öte Nitelik Önemli"
				},
				{
					"id": 716665103,
					"content": "Haaaa, demek öyle yapılıyormuş! Bugüne kadar hiç aklıma gelmemişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665104,
					"content": "Aynen! Kurnaz bir düşmanla karşı karşıyaysan yaratıcı düşünmen gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665105,
					"content": "Stratejin başarısız olduğunda bakış açını değiştirmelisin. Yolculuklarımızda öyle anlar oluyor ki hızlı düşünmemiz gerekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665106,
					"content": "Ne kadar denersen dene, eski yöntemlere bağlı kalmak sorunu çözmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665107,
					"content": "Shinobu da benzer bir şey demişti sanki. Demek haklıymış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665108,
					"content": "Neyse, başka zaman düşünürüm. Şu an tamamen elimdeki işe odaklanmış durumdayım. Böcek dövüşüne devam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
