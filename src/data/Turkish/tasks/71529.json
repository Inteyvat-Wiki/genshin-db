			},
			"dialogs": [
				{
					"id": 716665001,
					"content": "Çok mantıksız... Nasıl yaptın onu? Resmen... Tüm itibarım yerle bir oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665002
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665002,
					"content": "Sizinle dövüş yapmak benim için bir onurdu efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665003
					],
					"speakerTitle": "Şekilden Öte Nitelik Önemli"
				},
				{
					"id": 716665003,
					"content": "Ne... Ne kadar kibarsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665004,
					"content": "Haha! Biz yokken kaybetmekle mi meşguldün Boşb{RUBY#[S]\"Hakiki Böcek Dövüşü Kralı\"}oğaz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665005,
					"content": "Ben öyle düşünmüyorum. Hakiki Böcek Dövüşü Kralı şu an pes etmeyecekse henüz bana kaybetmiş sayılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665006
					],
					"speakerTitle": "Şekilden Öte Nitelik Önemli"
				},
				{
					"id": 716665006,
					"content": "Gerek dövüşte gerek hayatta zaman zaman engellerle karşılaşmak kadar doğal bir şey yoktur. Ancak ve ancak denemeyi bırakırsan o engel bir başarısızlığa dönüşür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665007
					],
					"speakerTitle": "Şekilden Öte Nitelik Önemli"
				},
				{
					"id": 716665007,
					"content": "Aynen! İşte budur! Henüz pes etmiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665008,
					"content": "Öte yandan sürekli bahane uydurmanın da kişiye bir faydası yoktur. Tüm enerjini laf atmaya harcamamalısın, birazını daha sert dövüşmeye verebilirsin mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665009
					],
					"speakerTitle": "Şekilden Öte Nitelik Önemli"
				},
				{
					"id": 716665009,
					"content": "Of, fena...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665010
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665010,
					"content": "Oni Kral, bu tür bir rakibin senin uzmanlık alanında olmadığını düşünüyorum. Bence generallerinden birini yollamalı ve düelloyu dikkatle izlemelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665011
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 716665011,
					"content": "Bir savaşçının eğitimindeki en önemli noktalardan biri de başkalarının dövüşlerini izlemektir. Bazı beceriler pratik yaparak öğrenilir. Bazılarıysa izleyerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665012
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 716665012,
					"content": "İyi dedin Büyük Usta! Sen de tam zamanında geldin yoldaş! Oni Kralın Sağ Kolu, bu dövüşü sana veriyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665013
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716665013,
					"content": "#Hehe, nihayet sıra sende! Hadi bakalım {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665014,
						716665015
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716665014,
					"content": "Hehe! Çantada keklik!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				},
				{
					"id": 716665016,
					"content": "#Demek meşhur {NICKNAME} ile karşı karşıya geleceğim, öyle mi? Dikkatli olayım en iyisi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Şekilden Öte Nitelik Önemli"
				},
				{
					"id": 716665015,
					"content": "Eyvah, korktum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716665016
					]
				}
			]
		},
