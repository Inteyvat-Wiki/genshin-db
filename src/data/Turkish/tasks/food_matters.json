			"dialogs": [
				{
					"id": 766670301,
					"content": "Gidip senin için toplayabilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670302
					]
				},
				{
					"id": 766670302,
					"content": "Yardım mı etmek istiyorsunuz? Çok sağ olun! Gerçekten çok teşekkürler! Beş tane <color=#00E1FFFF>Lakka Böğürtleni</color> getirmeniz yeterli olacaktır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670303
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670303,
					"content": "Getirirseniz size bugüne dek yediğiniz en lezzetli Ay Şölenini yapacağıma söz veriyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
		},
		{
