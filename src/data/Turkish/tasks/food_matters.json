			"dialogs": [
				{
					"id": 766670401,
					"content": "Bu yeterli olur. Sağ olun, çok sağ olun! Biraz bekleyin. Bugüne dek yediğiniz en lezzetli Ay Şölenini yapacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670402
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670402,
					"content": "Lyylikki mutfağa koşar ve Ay Şöleni hazırlamaya girişir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766670403
					]
				},
				{
					"id": 766670403,
					"content": "İşte, hazır. Lütfen tadına bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670404
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670404,
					"content": "Yardımınız için tekrardan sağ olun. Acıkırsanız lütfen yanıma gelin. Size özel bir porsiyon hazırlayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				}
			]
