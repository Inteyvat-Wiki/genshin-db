			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Lyylikki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766670101,
					"content": "Of... Keşke daha fazla Lakka Böğürtleni getirseymişim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670102,
						766670103
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670102,
					"content": "(Geçen sefer Lauma buradayken...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				},
				{
					"id": 766670104,
					"content": "#Merhaba {NICKNAME}, buraya Ay Şöleni için mi geldiniz? Üzgünüm ama... Biraz beklemeniz gerekebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670105
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670105,
					"content": "Ay Şöleni ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670106
					]
				},
				{
					"id": 766670106,
					"content": "Geçen sefer bir tane almamış mıydınız? Doğru, onu Leydi Lauma düzenlemişti... Yemeğin asıl adını söylememiş herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670107
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670107,
					"content": "Ay Şöleni, Donuk Ayın Çocuklarının ihtiyaç sahiplerine ücretsiz dağıttığı bir yemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670108
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670108,
					"content": "Böyle insanlara yardım etmek geleneklerimizden biridir. Önceden Hiisi Adası çevresinde sınırlı kalmış olsa da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670109
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670109,
					"content": "Leydi Lauma'nın liderliği ve herkesin yardımı sayesinde yavaş yavaş daha geniş kitlelere ulaşmayı başardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670110
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670110,
					"content": "Leydi Lauma bunun Ay Tanrıçası'nın Lütfunu herkese yaymanın bir parçası olduğunu söylüyor. Bir söz vardı hatta... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670111
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670111,
					"content": "\"Hasadın ilk meyvesi adak olarak değil, şeye kıvılcım olsun diye Ay Işığı Mihrabına sunulmalıdır...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670112
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670112,
					"content": "Neye kıvılcım olsun diyeydi ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670113
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670113,
					"content": "Öhöm, neyse! Bu dükkan ana yemek dağıtım noktalarından biri. Hehe, burada neredeyse her şeyi ben çekip çeviriyorum! Harika, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670114
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670114,
					"content": "Nasha Kasabası'nda yemek dağıtırken çok fazla sorun yaşadık ama Leydi Lauma bu şekilde daha fazla insana yardım edebileceğimizi söylüyor. Ona inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670115
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670115,
					"content": "Ama... Dün malzemeleri hazırlarken kutunun kapağını tam kapatamamışım. Bu sabah uyandığımda bir sürü meyveyi kuşlar didiklemişti, tamamen kullanılamaz haldeydiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766670116
					],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670116,
					"content": "Kalan Lakka Böğürtlenleri, Ay Şöleni yapmaya hayatta yetmez... *iç çeker*... Ne yapacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lyylikki"
				},
				{
					"id": 766670103,
					"content": "(Yemek dağıtıyorlarmış...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766670104
					]
				}
			]
		},
