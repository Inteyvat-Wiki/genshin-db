			"dialogs": [
				{
					"id": 30170101,
					"content": "Durun bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170102
					],
					"speakerTitle": "Tashfin"
				},
				{
					"id": 30170102,
					"content": "Sarışın bir Gezgin ve uçan bir peri... Yakalandınız. Etrafınıza baksanıza, tuzağımızın tam ortasına düştünüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170103
					],
					"speakerTitle": "Tashfin"
				},
				{
					"id": 30170103,
					"content": "Ne! Siz Otuzlu Teşkilatın paralı askerleri misiniz? Bizi tutuklamaya mı geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170104,
					"content": "Otuzlu Teşkilat mı? Biz devletin sömürdüğü o köpeklere benzemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170105
					],
					"speakerTitle": "Tashfin"
				},
				{
					"id": 30170105,
					"content": "Biz Sumeru'daki en pahalı ve seçkin ekibiz. Biz sadece \"Sürülmüş\" ismiyle bilinen müşterimizin emirlerini yerine getiriyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170106
					],
					"speakerTitle": "Tashfin"
				},
				{
					"id": 30170106,
					"content": "\"Sürülmüş\"... Akademiden mi sürülmüş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170107,
					"content": "Doktor'dan bahsediyorlar galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170108
					]
				},
				{
					"id": 30170108,
					"content": "Ama Doktor neden peşimizden Fatui'yi göndermedi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170109,
						30170110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170109,
					"content": "Yerel paralı askerler bu konuda Fatui'den daha güçlü.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170111
					]
				},
				{
					"id": 30170111,
					"content": "Öf, gevezeliğiniz de bir bitmedi. Biz şimdi çenenizi kapatırız. Yakalayın şunları!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170112
					],
					"speakerTitle": "Tashfin"
				},
				{
					"id": 30170112,
					"content": "#Sıra sende {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170110,
					"content": "Belki de Akademinin kaynaklarını kendi lehine kullanıyordur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170111
					]
				}
			]
		},
		{
			"id": 301703,
