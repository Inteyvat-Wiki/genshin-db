					"Tashfin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170301,
					"content": "Fenaydı... Seçkin paralı askerler böyle mi oluyormuş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170302,
					"content": "Kısa süre içinde daha fazlası gelecek muhtemelen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170303
					]
				},
				{
					"id": 30170303,
					"content": "Evet, her daim hazır olmamız gerekecek belli ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170304,
					"content": "Bu Doktor gerçekten güçlü bir rakibe benziyor. Nerede pusu kuracağını da çok iyi biliyordu. Tighnari'yi bulmaya çalışacağımızı mı tahmin etti acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170305,
					"content": "Of, zeki insanlara karşı iş çevirmek zor. Neyse, aynen devam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 301704,
			"completionStepIds": [
				301704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301704",
							"2"
						],
						"stepId": 301704,
						"stateName": "QUEST_STATE_UNFINISHED"
