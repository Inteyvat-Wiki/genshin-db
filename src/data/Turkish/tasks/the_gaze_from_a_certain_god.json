			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170501,
					"content": "Bir dakika, bak kim gelmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170502,
						30170503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170502,
					"content": "Nahida!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170504
					]
				},
				{
					"id": 30170504,
					"content": "Şükürler olsun iyisin! Senin için çok endişelenmiştik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170505,
						30170506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170505,
					"content": "Sen gerçekten Nahida'sın değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170507
					]
				},
				{
					"id": 30170507,
					"content": "#{NICKNAME}! Bunun duygusal bir buluşma olması gerekirdi! Bak, mahvettin şimdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170508,
					"content": "Aslında Gezginin şu anda benden şüphelenmesi çok mantıklı. Nihayetinde Doktor, insan zihinlerini kontrol altına alabilecek teknolojiye sahip olduğunu gösterdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170509
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170509,
					"content": "Ayrıca sizinle yollarımız ayrıldıktan sonra Doktor'la ben karşı karşıya kaldığımda neler olduğunu bilmenizin imkanı yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170510
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170510,
					"content": "Durgun su bile şiddetli bir fırtınadan sonra arada sırada gökyüzünde yağmur olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170511
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170511,
					"content": "Hımm... Paimon sadece gerçek Nahida'nın böyle anlaşılmaz bir benzetme yapacağını düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170512,
						30170513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170512,
					"content": "Bence de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170514
					]
				},
				{
					"id": 30170514,
					"content": "Ama ben güveninizi kazanmaya falan çalışmıyordum ki. Sadece mantığımı açıklamaya çalışıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170515
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170515,
					"content": "Mantığını anladık! Lütfen Nahida, olanları biraz daha anlat. Zavallı insanlar iyi mi bari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170516,
					"content": "Siz gittiğinizde ben hâlâ insanların zihinlerini eski haline getirmeye çalışıyordum. Neyse ki Doktor \"bilgiyi bilinçaltına yüklemek\" derken insanların zihnine bilgi kazımaktan bahsetmiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170517
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170517,
					"content": "Onun yerine... Sanrı yaratmaya yakın bir şey yapmış. Neyse ki gücüm bunu düzeltmeye yetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170518
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170518,
					"content": "O tam beni ele geçirmek üzereyken zihinleri eski haline getirip ondan uzaktaki bir zihne sıçramayı başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170519
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170519,
					"content": "Of, çok rahatladım. Doktor kesinlikle hepimizi şaşırttı ama neyse ki Nahida bizimleydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170520,
					"content": "Ben olsam hemen rahatlamazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170521
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170521,
					"content": "Herkesin zihnini eski haline getirdiğimde kimliğimi de ele vermiş oldum. Yani joker kartlarımızdan birini daha kaybettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170522
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170522,
					"content": "Ayrıca... Doktor zaten Akaşa Terminalleri üzerinde değişiklik yapmak konusunda uzman. Belki de bilincimi Akaşa'ya hapsetmesi an meselesidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170523
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170523,
					"content": "Artık zihinler arasında sıçrayamayacağını mı söylüyorsun? O zaman onu nasıl durduracağız? Hâlâ Akademide olduğuna göre Akaşa'yı kurcalamaya başlamış olması muhtemel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170524,
						30170525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170524,
					"content": "Acele etmemiz lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170526
					]
				},
				{
					"id": 30170526,
					"content": "Öf, bizimle oyun oynuyor sanki! Tam bir pislik işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170527,
					"content": "Ayrıca Doktor'un savaş yetenekleri bile onu başlı başına Fatui'nin ikinci adamı yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170528,
					"content": "Umudumuzu hemen kaybetmeyelim. Bu sorunla savaşmak için başka bir yol bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170529
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170529,
					"content": "Nahida, sen bizim Pardis Dhyai'ye gitmeye çalıştığımızı nereden biliyordun? Bizi mi bekliyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170530,
					"content": "Evet. Gezginin yaydığı Element Enerjisini görebildiğim için nereye doğru ilerlediğinize baktım ve gittiğiniz yeri buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170531
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170531,
					"content": "Buraya turistik gezi için gelmediniz sonuçta. Herhangi bir iz bulabildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170532
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170532,
					"content": "Tanıdığımız bir alimi arıyoruz! Adı Tighnari. Bilgeler bir ara ona ulaşmaya çalışmıştı. Neden bizimle içeriye gelmiyorsun? Elimizde neler var bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170533,
					"content": "Olur. Umarım onun başını belaya sokmayız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170525,
					"content": "Zamanla daha da kötü bir pozisyona düşeceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170526
					]
				},
				{
					"id": 30170513,
					"content": "Sana inanıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170514
					]
				},
				{
					"id": 30170506,
					"content": "Doktor tarafından yeniden programlanmadın değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170507
					]
				},
				{
					"id": 30170503,
					"content": "Katheryne!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170504
					]
				}
			]
		},
		{
			"id": 301706,
			"completionStepIds": [
				301706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301706",
							"2"
						],
						"stepId": 301706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Haypasia",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170601,
					"content": "Gezgin? Bu sensin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170602
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170602,
					"content": "Aa! Haypasia!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170603,
						30170604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170603,
					"content": "Uzun zaman olmuştu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170605
					]
				},
				{
					"id": 30170605,
					"content": "Ne güzel bir sürpriz! İkinizi tekrar görmek ne güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170606
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170606,
					"content": "Bu kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170607
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170607,
					"content": "Avidya Ormanı'nda tanıştığımız bir alim! Son görüştüğümüzde hâlâ şeyde... Neydi... \"Satyavada Yaşamı\"nda eğitim görüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170608,
					"content": "Ah... Anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170609
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170609,
					"content": "Aynen öyle, biz eski dostlarız! Tam zamanında geldiniz. Buraya geldiğimden beri neredeyse kimse benimle konuşmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170610
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170610,
					"content": "Haypasia sen bu konuda aşırı heyecanlıydın! Bir dakika, Avidya Ormanı'ndan çıktığına göre... Artık eğitime devam etmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170611,
					"content": "Bir dakika... Sen eğitimini tamamlayıp Paripurna Yaşamına mı ulaştın yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170612,
					"content": "Hehehe, sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170613
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170613,
					"content": "Bilincim... Çoktan ilahi olanlarla iletişime geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170614
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170614,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170615
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170615,
					"content": "Başardın yani? Tebrik ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170616,
						30170617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170616,
					"content": "Senin adına çok mutlu oldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170618
					]
				},
				{
					"id": 30170618,
					"content": "Haha, bu müthiş sevinci en sonunda birileriyle paylaşmak çok iyi geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170619
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170619,
					"content": "Bilincim tanrılarla temasa geçtiğinde muazzam hissettim... Eşi benzeri olmayan bir deneyimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170620
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170620,
					"content": "İnanılmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170651,
						30170652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170651,
					"content": "Aslında biz buraya Tighnari'yi görmek için gelmiştik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170621
					]
				},
				{
					"id": 30170621,
					"content": "Ay, bir dakika. Lütfen biraz bekleyin. Size verdiğim sözü unutmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170622
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170622,
					"content": "Hatırladınız mı? Sezgilerim güçlenince Irminsul'da gördüğünüz şeyi anlamanıza yardımcı olma sözü vermiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170623
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170623,
					"content": "Gerçek anlamda sezgi kazanmakla kalmadım, seni ilahi olanların bilinciyle doğrudan iletişime de geçirebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170624
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170624,
					"content": "Böyle bir şey yapabiliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170625,
					"content": "Ona inanıyor musun Nahida?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170626
					]
				},
				{
					"id": 30170626,
					"content": "Daha önce hiç böyle bir şey duymamıştım ama... Denemek istersen o süreçte bilincini korumak için elimden geleni yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170627
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170627,
					"content": "Bir dakika, yanımda Ruhani Borneol getirmiştim. O hâlâ seremoninin önemli bir parçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170628
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170628,
					"content": "Yine mi o tütsüyü kullanacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170629,
					"content": "Pekala, şimdi... Elimi tut. Ben sana bilincini bağlayacağın bir yol açmakta yardımcı olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170630
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170630,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170631
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170631,
					"content": "Hazır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170632
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170632,
					"content": "O-O neydi öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170633,
						30170634
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170633,
					"content": "Bu, ne Mahadevi'nin bilinciydi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170635
					]
				},
				{
					"id": 30170635,
					"content": "Biz az önce gerçekten de Kasideci'nin anılarını mı gördük? Gördüğümüz şeyler onunla ilgili bildiğimiz şeylerle uyuşuyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170636,
					"content": "Ama o Haypasia'nın bahsettiği ilahi bilince nasıl bağlanmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170637,
					"content": "Sen de gördün değil mi? Sen de hissettin! Ne görkemli bir tanrı, ne asil bir irade ve olağanüstü bir duygu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170638
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170638,
					"content": "Ah, ne utanç verici... Keşke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170639
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170639,
					"content": "Keşke göğsümde atan bu fani kalp bu kadar kirli olmasaydı... Ey ulu ve bağışlayıcı tanrı, lütfen beni affet ve bana hidayet ver...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170640
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170640,
					"content": "Şimdi anlıyor musunuz? Maalesef bu Paripurna Yaşamı değil. Aslında bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170641
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170641,
					"content": "Uyan Haypasia!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170642
					]
				},
				{
					"id": 30170642,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170643
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170643,
					"content": "Siz... Bana karşı neden bu kadar kabasınız? Neden herkes benden saklanıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170644
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170644,
					"content": "Ben kutsal bilgeliği buldum! Bunun için övgüyü ve şanı hak etmiyor muyum? Karanlıkta ışığı açığa çıkarmadım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170645
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170645,
					"content": "Haypasia...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170646,
					"content": "Ben hep öyle olması gerektiğini düşünmüştüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170647
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170647,
					"content": "Bir dakika...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170648
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170648,
					"content": "Ben aklımı... Çoktan kaybetmiş olabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170649
					],
					"speakerTitle": "Haypasia"
				},
				{
					"id": 30170649,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170650
					]
				},
				{
					"id": 30170650,
					"content": "Bir dakika, bir terslik var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 30170634,
					"content": "Ne de Kral Deshret'in bilinciydi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170635
					]
				},
				{
					"id": 30170652,
					"content": "Acelemiz var, başka zaman konuşalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170621
					]
				},
				{
					"id": 30170617,
					"content": "Gerçekten harikasın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170618
					]
				},
				{
					"id": 30170604,
					"content": "Seninle burada karşılaşmayı beklemiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170605
					]
				}
			]
		},
		{
			"id": 301707,
			"completionStepIds": [
				301707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301707",
							"2"
						],
						"stepId": 301707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tighnari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170701,
					"content": "... Tamam, sonunda onları atlattık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170702,
						30170703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170702,
					"content": "!!!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170704
					]
				},
				{
					"id": 30170704,
					"content": "#İyi misin Nahida? Hayır, bir saniye! Garip olan bir şeyler var... Dönmüşsün {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170705,
					"content": "#Ah, {NICKNAME} döndü mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170706,
						30170707
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170706,
					"content": "Benim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170708
					]
				},
				{
					"id": 30170708,
					"content": "Nahida bir süredir senin bedenini kontrol ediyordu. Anlaşılan Katheryne'in kuklası yok olmadan hemen önce, can havliyle sana doğru sıçramış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170709,
					"content": "Ondan sonra da... Tighnari sesleri duyunca yanımıza geldi. Paralı askerleri alt etmemize yardımcı oldu ve sonra bizimle buraya koştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170710,
						30170711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170710,
					"content": "Bu sefer bedenime sadece zihnini de aktarmadı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170712
					]
				},
				{
					"id": 30170712,
					"content": "Ne? Yer mi değiştirdiniz? Yani senin bilincin de Nahida'nın bedenine mi geçti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170713,
					"content": "Bir saniye, o zaman Nahida'nın bilinci nerede? Şimdi Nahida nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170714,
					"content": "İnsan bilincinin bu şekilde oradan oraya aktarılabileceğini hiç düşünmemiştim. Kendi gözlerimle görmeseydim hayatta inanmazdım. Bunun mevcut insan teknolojisiyle mümkün olduğunu düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170715
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170715,
					"content": "#Ayrıca biz koşarken bedenindeki bilinç sana bir mesaj iletmemi istedi {NICKNAME}. Dedi ki:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170716
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170716,
					"content": "\"Doktor bilincimi kapana kıstırmanın bir yolunu buldu. Bu yüzden artık sizinle yola devam edemem.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170717
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170717,
					"content": "\"Fakat aysız bir gecede bile yıldızların ışığı yanılsamaları ve yalanları boğabilir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170718
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170718,
					"content": "Ah, hayır, olamaz... Nahida bu sefer sonsuza dek Surasthana Mabedinde kapalı kaldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170719,
					"content": "Bize sadece bu mesajı mı bırakmış? Epey muğlak bir mesaj...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170720,
						30170721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170720,
					"content": "Sadece bizim anlayacağımız şekilde şifrelenmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170722
					]
				},
				{
					"id": 30170722,
					"content": "Çok mantıklı! Doktor Nahida'yı ele geçirdiğine göre Nahida onun haberi olmadan hiçbir şey söyleyemez. O yüzden daha dikkatli davranıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170723
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170723,
					"content": "\"Aysız bir gecede bile yıldızların ışığı yanılsamaları ve yalanları boğabilir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170724,
					"content": "Paimon ayın, yanılsamaların ve yalanların Sabzeruz Festivalindeki şu simya falından geldiğini biliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170725,
					"content": "Nahida \"yıldız ışığı\" benzetmesini daha önce de kullanmamış mıydı? Setaria'yla ilgili bir şeydi sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170726,
						30170727,
						30170728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170726,
					"content": "\"Ay\" Nahida'nın kendisine gönderme yapıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170729
					]
				},
				{
					"id": 30170729,
					"content": "Ah! Gerçekten çok mantıklı! Sence Nahida bizden çöle gidip yardım bulmamızı istemiş olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170730,
					"content": "Ama artık bizimle değil... Sence iyi olacak mıyız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170731
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170731,
					"content": "Paimon... Surasthana Mabedi dedin, değil mi? Bu bahsettiğin \"Nahida\"... Gezginin bedenini ele geçiren bilinç... Doğa Hükümdarı mıydı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170732
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170732,
					"content": "Eh... Tahminin doğru ama durum biraz karışık ve şu an bunu açıklamak çok zor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170733,
					"content": "Pekala. Bir alimin merakı hemen giderilmese de olur. Durumun karmaşıklığına gelirsek... Buna bizzat şahit olduğumu söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170734
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170734,
					"content": "Sizinle biraz vakit geçirdim ve Doğa Hükümdarı da sizin yanınızda gibi görünüyor. O yüzden size güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170735
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170735,
					"content": "Teşekkürler Tighnari! Eh, aslında buraya bir soru sormak için gelmiştik. Bilgelerin üzerinde çalıştığı projeyle ilgili herhangi bir şey biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170736
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170736,
					"content": "O konuda... Projeye katılmak için davet almış olsam da bilgeler amaçları ve planları konusunda çok ketumdur. Bu yüzden daveti reddettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170737
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170737,
					"content": "Tek bildiğim şey o projenin bir şekilde Irminsul'un yenilenmesiyle ilgili olduğu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170738,
						30170739
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170738,
					"content": "Sanırım ben projenin neyle ilgili olduğunu biliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170740
					]
				},
				{
					"id": 30170740,
					"content": "Öyle mi? Nahida'nın bedenindeyken bir şey görebildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170741
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170741,
					"content": "Akademi... Kasideci'yi tanrıya dönüştürüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170742
					]
				},
				{
					"id": 30170742,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170743
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170743,
					"content": "... Bununla ilgili kanıtın var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170744,
						30170745
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170744,
					"content": "Yapım aşamasında olan \"doğum aşamasında bir tanrı\" gördüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170746
					]
				},
				{
					"id": 30170746,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170747
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170747,
					"content": "Nahida'yla bilinçleriniz yer değiştirdiğinde gördüklerini tarif ediyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						30170748
					]
				},
				{
					"id": 30170748,
					"content": "Hım, demek öyle oldu... Demek bu yüzden Haypasia'nın belirtileri aklını yitiren diğer alimlerinkinden bu kadar farklıymış. Meğer henüz doğum aşamasındaki bir tanrının bilinciyle iletişime geçmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170749
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170749,
					"content": "Tighnari, sen Avidya Ormanı'nı Haypasia yüzünden mi terk ettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170750
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170750,
					"content": "Evet. Haypasia'nın zihinsel tuhaflıklarını fark ettim. Gösterdiği belirtiler olağan dışı olduğu için onu gizlice Pardis Dhyai'ye götürdüm ve onu normal haline döndürmenin yollarını araştırmaya koyuldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170751
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170751,
					"content": "Ben harekete geçmeseydim Haypasia muhtemelen çoktan Matra tarafından çöle götürülmüş ve hayatının sonuna dek Aaru Köyü'nde sürgün hayatı yaşıyor olacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170752
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170752,
					"content": "Hazır lafı açılmışken, Akademinin Devi Kusanali'den çok da hazzetmediğini biliyordum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170753
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170753,
					"content": "Yine de yeni bir tanrı yaratmak kadar küstahça bir şey yapacaklarını düşünmemiştim. Davetlerini kabul etmeyerek doğru kararı vermişim belli ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170754,
						30170755
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170754,
					"content": "Bu işlerin bir kısmının arkasında Fatui de var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170756
					]
				},
				{
					"id": 30170756,
					"content": "Doktor ve Kasideci... Sumeru'da iki Fatui Habercisi var. Ortalık hepten karışacak gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170757
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170757,
					"content": "Senin anlattıklarına göre bence projeyi henüz tamamlamadılar. Müdahale etmek için hâlâ vaktimiz olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170758
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170758,
					"content": "İyi de, o zaman yeni bir tanrı yaratmakla Irminsul'u hayata döndürmek arasında nasıl bir bağlantı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170759
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170759,
					"content": "Evet, bilgelerin amaçlarını anlama konusunda doğru dürüst bir yere varamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170760,
						30170761
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170760,
					"content": "Şimdilik çöle gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170762
					]
				},
				{
					"id": 30170762,
					"content": "Aynen öyle. Bilmemiz gereken her şeyin üstünden geçtik. Bu yüzden, artık gitsek iyi olacak... Peki sen Tighnari? Ne yapmayı düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170763
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170763,
					"content": "Şimdilik burada kalacağım. Haypasia'ya yardımcı olmak için hâlâ denemek istediğim şeyler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170764
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170764,
					"content": "Çöle gitmeyi planlıyorsanız Ribat Kervanı'na doğru gitmekle başlayın. En hızlı yol odur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170765
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170765,
					"content": "Yardımcı olabileceğim herhangi bir şey olursa gelip beni bulun. Bilgelik ruhu yoldaşınız olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170766
					],
					"speakerTitle": "Tighnari"
				},
				{
					"id": 30170766,
					"content": "Teşekkürler Tighnari! Umarım Haypasia yakında toparlar! O zaman biz kaçtık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170761,
					"content": "Ne olursa olsun onları durdurmalıyız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170762
					]
				},
				{
					"id": 30170755,
					"content": "Fatui de yangını körüklemiş olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170756
					]
				},
				{
					"id": 30170745,
					"content": "Haypasia aynı zamanda bize sözde kutsal bilinç denen bir şey gösterdi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170746
					]
				},
				{
					"id": 30170739,
					"content": "Bazı yeni bilgiler edindim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170740
					]
				},
				{
					"id": 30170727,
					"content": "\"Yıldız ışığı\" çöldeki insanlara gönderme yapıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170729
					]
				},
				{
					"id": 30170728,
					"content": "\"Yanılsamalar ve yalanlar\" Akademinin planlarına gönderme yapıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170729
					]
				},
				{
					"id": 30170721,
					"content": "Doktor'un planımızı fark etmesine izin veremeyiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170722
					]
				},
				{
					"id": 30170711,
					"content": "Zihinlerimiz yer değiştirdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170712
					]
				},
				{
					"id": 30170707,
					"content": "Az önce ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170708
					]
				},
				{
					"id": 30170703,
					"content": "*nefesi kesilir*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170704
					]
				}
			]
		},
		{
			"id": 301708,
