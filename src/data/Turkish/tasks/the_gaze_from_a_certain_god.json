			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Collei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30170401,
					"content": "Aa, Gezgin ve Paimon gelmiş! Sizi buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170402
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30170402,
					"content": "Collei, seni gördüğüme çok sevindim! Nasılsın, iyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170403,
					"content": "Ben... Açıkçası çok da iyiyim diyemem. Eleazar hastalığım son zamanlarda çok hızlı ilerliyor. Karmaşık işleri tamamlamakta giderek zorlanmaya başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170404
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30170404,
					"content": "Bu yüzden de Usta Tighnari beni devriye programından çıkardı. Sadece burada kalıp diğer insanların görevlerini koordine etmeme izin verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170405
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30170405,
					"content": "Ah, Collei...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170406,
					"content": "Tek şansımız Irminsul'u iyileştirmek gibi görünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170407
					]
				},
				{
					"id": 30170407,
					"content": "Tighnari demişken, kendisi devriyeye falan mı çıktı? Onunla konuşmaya gelmiştik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170408,
					"content": "Usta Tighnari mi? Kısa süre önce Avidya Ormanı'ndan dönmüştü. Sonra Pardis Dhyai'ye doğru yola çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170409
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30170409,
					"content": "Aa, gitti mi? Ama Tighnari hep Avidya Ormanı'nı bırakmak istemediğini söylemiyor muydu? Bilgelerin davetini bile reddetmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170410,
					"content": "O bana da tuhaf gelmişti. Usta Tighnari, Orman Gözcülüğü işini her şeyden daha çok önemser. Buradan da neredeyse hiçbir zaman ayrılmaz. Ama bu sefer biraz alelacele çıktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170411
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30170411,
					"content": "Herhangi bir sebep söylemedi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170412,
					"content": "Hayır, gittiğini de bıraktığı mesajdan öğrendim zaten. Ayrıca bir program hazırlayıp kendi görevlerinin hepsini dağıtmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170413
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30170413,
					"content": "O kadar aceleyle çıkması... Herhalde halletmesi gereken acil bir işi vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170414
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30170414,
					"content": "Pardis Dhyai'ye gittiğini söyledin. Orası nasıl bir yer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170415,
					"content": "Usta Tighnari esasen Akademinin Amurta Darşanında öğrenim görmüş. Pardis Dhyai de Amurta'nın araştırma merkezi gibi bir yer. Araştırmalar için oraya bir sürü nadir çalı ve çimen türü ekili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170416
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30170416,
					"content": "Usta Tighnari'nin Orman Gözcüsü olmadan önce Pardis Dhyai'de çok uzun zamandır bir araştırma yürüttüğünü biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170417
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30170417,
					"content": "Araştırma merkezi demek... Tighnari'nin bir anda nasıl bir araştırma üzerinde çalışmaya karar verdiğini merak ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170418,
					"content": "#Çok zamanımız yok {NICKNAME}, hadi onu bulmak için Pardis Dhyai'ye gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170419,
						30170420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170419,
					"content": "Lütfen kendine dikkat et Collei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170421
					]
				},
				{
					"id": 30170421,
					"content": "Ah... Merak etmeyin ben iyiyim. Eleazar'la yaşamaya alıştım artık. Usta Tighnari'ye denk gelirseniz lütfen selamlarımı iletin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30170422
					],
					"speakerTitle": "Collei"
				},
				{
					"id": 30170422,
					"content": "Oldu bil! Sonra görüşürüz Collei!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 30170420,
					"content": "Kendini çok zorlama Collei.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30170421
					]
				}
			]
		},
		{
			"id": 301705,
