			"dialogs": [
				{
					"id": 733550101,
					"content": "Hey, az önce havada süzülerek bir Mantar geçti. Normal mi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550102,
					"content": "Normalde Mantarların şehirde dolaşması tehlikeli değil mi? Tabii eğitimden geçmiş, iyi huylu olan özel Mantarlar hariç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550103,
					"content": "Şimdi Paimon düşününce... Bu durum neden bu kadar tanıdık geldi? Daha önce tam da buna benzer bir şey yaşamamış mıydık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550104,
						733550107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550104,
					"content": "Bir dakika, şu Davul Kafa mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550105
					]
				},
				{
					"id": 733550105,
					"content": "Doğru ya, bu Davul Kafa! Sumeru'dayken tanıştığımız Mantar dostumuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550106,
					"content": "Oooo! Onu görmeyeli çok uzun zaman oldu! Hadi, gidip bir merhaba diyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550107,
					"content": "Yine ne \"özel durum\" varmış?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550108
					]
				},
				{
					"id": 733550108,
					"content": "Paimon doğru anladıysa... Davul Kafa bu! Sumeru'da tanıştığımız Mantar dostumuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550109
					],
					"speakerTitle": "Paimon"
				},
				{
