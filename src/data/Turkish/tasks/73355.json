			"dialogs": [
				{
					"id": 733550201,
					"content": "Hımm. Görünüşe göre Maceracılar Loncasına mesaj bırakmama gerek kalmadı. Kader bizi her zaman tekrar bir araya getiriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550202
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550202,
					"content": "Yeniden karşılaştık Altın Yıldız ve Gümüş Yardımcı. Uzun zaman olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550203
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550203,
					"content": "İkiniz de ışıl ışıl ve hayat dolusunuz. Sanki aradan hiç zaman geçmemiş gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550204,
						733550208
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550204,
					"content": "Görüşmeyeli uzun zaman oldu Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550205
					]
				},
				{
					"id": 733550205,
					"content": "Gerçekten sizmişsiniz, Haniyyah ile Davul Kafa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550206,
					"content": "O mesajın neden bu kadar tanıdık geldiği belli oldu... Demek ki Paimon ve Davul Kafa arasındaki bağ hâlâ eskisi gibi kuvvetli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550207,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Davul Kafa"
				},
				{
					"id": 733550212,
					"content": "Sizinle birçok farklı şekilde yeniden karşılaşmayı hayal ettim. Büyük bir ziyafet ya da yaratıcı bir hoş geldin partisi. Sizi gerçekten şaşırtacak bir şey yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550213
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550213,
					"content": "Ancak nihayetinde hepsi biraz fazla resmi geldi. Yoğun olduğunuzdan çok vaktinizi alıp size zahmet vermek istemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550214
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550214,
					"content": "Üstelik Mantar dostlarımız şu sıralar sessiz ve sakin ortamlardan hoşlanıyor. O yüzden biz de rahat ve doğal bir şekilde bir araya gelelim istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550215
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550215,
					"content": "Doğru! Haniyyah'nın okuduğu metinler sonunda meyvesini verdi. İnsanın kafası rahat olunca hayat kalitesi de artıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550216
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550216,
					"content": "En keyiflisi de kaygısızca sohbet edebilmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550217
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550217,
					"content": "♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550218
					],
					"speakerTitle": "Ateş Saçan"
				},
				{
					"id": 733550218,
					"content": "Souka da burada! Üstelik Ateş Saçan da... Peki bu kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550219,
					"content": "Bu benim Mantar dostum, Kasırga Dansçısı. Sen ve Davul Kafa 32'nci turda bizi elemiştiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550220
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550220,
					"content": "Ehehe, bayağı net hatırlıyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550221,
						733550222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550221,
					"content": "Yavaş yavaş hatırlamaya başladım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550223,
					"content": "Her neyse, gördüğünüz gibi değerli dostlar, bir sonraki buluşmamız için zaman veya mekan ayarlamamıza gerek yok artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550224
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550224,
					"content": "Haniyyah ve ben bu ticaret bölgesini satın aldık ve burayı Küçük Mantar Oyun Alanına dönüştürdük!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550225
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550225,
					"content": "Dur biraz, yani buradaki ekipmanlar yeni masa oyunu için kiralanmadı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550226,
					"content": "Aynen öyle. Artık Bayda Limanı'nda yaşayacak, Mantarlarla ilgili masa oyununu tanıtacak ve hayvanlarla iletişim kurma teorimizi paylaşacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550227
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550227,
					"content": "Ne zaman vaktiniz olursa uğrayıp Mantar dostlarla oynayabilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550228
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550228,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550229,
						733550230
					],
					"speakerTitle": "Davul Kafa"
				},
				{
					"id": 733550229,
					"content": "Yaşasın! Mantar dostlar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550231,
					"content": "Ayy! Bu gerçekten Paimon'un bugün duyduğu en güzel şeylerden biri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550232,
					"content": "İlk Mantar Turnuvası bittikten sonra Paimon, Davul Kafa ile beraber oynamak için bir sürü fikir bulmuştu. Artık sonunda hepsini gerçekleştirebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550233,
					"content": "Mantar dostlarımıza bir ödül hazırlamamış olmamız çok kötü... Onlarla birlikte bir ziyafet çekmek ne güzel olurdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550234,
					"content": "Merak etme. Mantar Toplulukları Üzerine adlı çalışmamı gözden geçirirken, mantarların hoşlandığı yiyecekler konusunun temellerini araştırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550235
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550235,
					"content": "Amacım hem Mantarların hem de insanların yiyebileceği yemek malzemelerini tanımlamak, böylece dostlarımız yıl boyunca Muhteşem Jöle çeşitleri ile beslenmek zorunda kalmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550236
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550236,
					"content": "Bir gün hem insanların hem de Mantarların damak tadına hitap eden yemek malzemeleri bulacağım ve hep birlikte tadını çıkarabileceğimiz lezzetli yemekler tasarlayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550237
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550237,
					"content": "Sıra teoriyi pratiğe dökmeye geldiğinde de ben ustalığımı konuşturacağım! Haniyyah'nın on birinci tenceremizi de mahvetmesini istemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550238
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550238,
					"content": "Mantar dostlarımızla bir çember oluşturup birlikte yemek yiyeceğimiz günler çok da uzak değil sanki, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550239,
						733550240
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550239,
					"content": "İyi haberlerini bekliyor olacağız Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550241,
					"content": "Öyleyse fırsat bulduğunuzda lütfen Küçük Mantar Oyun Alanını tekrar ziyaret edin. Tüm Mantar dostlarımızla birlikte her zaman buradayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550242
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 733550242,
					"content": "Kim bilir? Sürpriz belki de beklediğinizden çok daha erken gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550243
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 733550243,
					"content": "♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Davul Kafa"
				},
				{
					"id": 733550240,
					"content": "Souka'nın ziyafetini dört gözle bekliyoruz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550241
					]
				},
				{
					"id": 733550230,
					"content": "Artık birbirimizi her zaman görebiliriz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550231
					]
				},
				{
					"id": 733550222,
					"content": "Sıcak ve samimi hava rahatlamama yardımcı oluyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550223
					]
				},
				{
					"id": 733550208,
					"content": "Pek hatırlayamadım ama... İkinize de merhaba!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550209
					]
				},
				{
					"id": 733550209,
					"content": "Gerçekten de Haniyyah ve Davul Kafa! Nilotpala Kupası Canavar Terbiyecileri Turnuvasında tanışmıştık. Onlar bizim eski dostlarımız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550210,
					"content": "Paimon onları Ormos Limanı yakınlarında ve daha sonra Fontaine Şehri'nde gördüğümüzü de hatırlıyor. Ne kadar çok zaman geçmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733550211,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550212
					],
					"speakerTitle": "Davul Kafa"
				}
			]
		}
	]
