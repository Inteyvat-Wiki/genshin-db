			"dialogs": [
				{
					"id": 742540501,
					"content": "Seymour! Görüşmeyeli uzun zaman oldu! Mamere de buradaymış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540502
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540502,
					"content": "Hehe, Seymour bana seni ne kadar özlediğini anlatıp durdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540503
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540503,
					"content": "Olumlu. Bayan Mary-Ann hiç aklımdan çıkmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540504
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540504,
					"content": "Ayrıca bu çay saatine ev sahipliği yaptığınız için teşekkür ederim Bayan Sandrone. Bir araya gelip seyahatlerimiz hakkında sohbet etmek çok güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540505
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540505,
					"content": "Rica ederim. Bir bakıma hepimizin uzun ve ortak bir geçmişe sahip bir aile gibi olduğunu hissediyorum. Iıı, en azından ben böyle görüyorum. Bu yüzden herkes müsait olduğunda bir araya gelmenin hiçbir zararı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540506
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742540506,
					"content": "Aile mi? Nedenini bilmiyorum ama bunu söylediğini duymak beni çok mutlu ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540507
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540507,
					"content": "Öyleyse Bayan Sandrone bizim... Küçük kız kardeşimiz mi oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540508
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540508,
					"content": "Şey... Belki şimdilik şu büyük, küçük meselesini es geçebiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540509
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742540509,
					"content": "Olumlu. Bay Alain'in ürettiği ilk prototip olduğum için, Bayan Sandrone'nin bana usulünce \"abi\" diye hitap etmesi gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540510
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540510,
					"content": "Hıh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540511
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742540511,
					"content": "Yaa, bu çok hoş. Ben de bu ailenin bir üyesi olabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540512
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540512,
					"content": "Tabii ki! Zaten başından beri pek de geleneksel bir \"aile\" sayılmayız. Aramıza bir Melusina katılmasının ne zararı olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540513
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742540513,
					"content": "Olumlu. Ayrıca Bayan Mamere zaten benim ailem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540514
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 742540514,
					"content": "Hehe. Bu beni çok mutlu etti! Hepimizin olduğu bir aile portresi çizmemi ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540515
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540515,
					"content": "Bir aile portresi mi? Böyle bir şey için poz vermeyeli uzun zaman oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540516
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540516,
					"content": "Beni etkileyici gösterdiğinden emin ol! Ailenin ablası olduğum belli olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540517
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 742540517,
					"content": "Hay hay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540518
					],
					"speakerTitle": "Mamere"
				},
				{
					"id": 742540518,
					"content": "Heh... Neden olmasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		},
