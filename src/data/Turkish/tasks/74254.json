						742540602,
						742540603
					],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540602,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742540604
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742540604,
					"content": "Tamam, davetin için teşekkürler Sandrone... Yoksa sana \"kardeşim\" mi demeliyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mary-Ann"
				},
				{
					"id": 742540603,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
