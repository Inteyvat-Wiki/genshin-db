			"dialogs": [
				{
					"id": 3572301,
					"content": "Fırtına Dehşeti... Doğrudan Mondstadt'a saldırıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572302,
					"content": "#Kaeya, {NICKNAME}, doğru zamanda geldiniz. Mutlaka şey yapmalıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572303
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572303,
					"content": "Dur bir dakika Amber. Acaba bizi tanıştırmayı unutuyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572304
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572304,
					"content": "Ah... Doğru. Bu Kaeya, bizim Süvari Yüzbaşımız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572305
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572305,
					"content": "#Bu ikisi uzaklardan gelen gezginler, {NICKNAME} ve Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572306
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572306,
					"content": "(Uzaklardan mı? Onlar hakkında bütün bildiğimiz bu mu?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572307
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572307,
					"content": "Uzun lafın kısası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572308
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 3572308,
					"content": "Anlıyorum. Mondstadt'a hoş geldiniz ama korkarım iyi bir zamanda gelmediniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572309
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572309,
					"content": "Ailenden ayrılmış olmanın ızdırabını anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572310
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572310,
					"content": "Rüzgar Tanrısı'nı neden aradığından gerçekten emin değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572311
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572311,
					"content": "Ama herkesin sırları vardır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572312
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572312,
					"content": "Haha, rahat ol! Daha fazla üzerine gelmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572313
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572313,
					"content": "Her şeyden önce, Favonius Şövalyeleri adına, az önceki yardımın için sana teşekkürlerimizi sunmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572314,
						3572315
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572314,
					"content": "Eh, durumun daha da kötüleşeceğini bilerek kendi haline bırakamazdık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				},
				{
					"id": 3572318,
					"content": "Az önce şehri ejdere karşı savunmak için yaptığın savaşa tanık olan şehir sakinlerinin sayısı hiç de az değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572319
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572319,
					"content": "Favonius Şövalyelerinin Büyük Kumandan Vekili de seninle tanışmayı çok istiyor ve her ikinizi <color=#00E1FFFF>karargahımıza</color> resmi olarak davet ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572315,
					"content": "Rica ederim! Peki... Ah... Ödül nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572316
					]
				},
				{
					"id": 3572316,
					"content": "Ahh... Geleneksel bir Mondstadt lezzeti olan Karamelize Soslu Rostoya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3572317
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3572317,
					"content": "Az önce ondan söz edildiğini duydum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3572318
					]
				}
			]
		}
	]
