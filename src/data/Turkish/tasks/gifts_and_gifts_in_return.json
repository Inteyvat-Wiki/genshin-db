					"nextDialogs": [
						750351207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351207,
					"content": "Raarr! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351208,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, biraz heyecanlı mısın yoksa? Bize söylemek istediğin bir şey mi var bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351209,
					"content": "Raarr... Rraarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351210
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351210,
					"content": "Raarr! Raarr!",
