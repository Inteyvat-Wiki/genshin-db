			"dialogs": [
				{
					"id": 750351201,
					"content": "Paimon dışarıdaki sütunları görünce bir şeylerden kuşkulanmıştı ama buraya ulaşacağı aklından bile geçmezdi...",
					"roleType": "TALK_ROLE_NPC",
