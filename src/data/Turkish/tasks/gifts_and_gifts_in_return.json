			"dialogs": [
				{
					"id": 750350801,
					"content": "Bu gerçek olabilir mi? Aletlerim geri geldi! İnanamıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350802
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350802,
					"content": "Geçen sefer çok dikkatli bakamamıştım ama oldukça güzel bir değerli taşmış! Kuşun pençesi gibi çarpıcı bir sarı... Of! Bu benzetmede o pis kuşlara yer vermemeliydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350803
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350803,
					"content": "Şafakla aydınlanan gökyüzü gibi, güneşin ilk ışıkları ya da sabahın ilk renkleri gibi... Evet, güzel bir tasvir oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350804,
						750350806
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350804,
					"content": "Çok ustalıklı benzetmeler olmadı bunlar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350805
					]
				},
				{
					"id": 750350805,
					"content": "Hey, ben hikaye anlatıcısı mıyım yahu! Benim tek yapmam gereken doğada gördüğüm o muhteşem renkleri aklımda tutmak... O renklere methiyeler düzmek değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350808,
					"content": "Neyse, değerli taşınız bana emanet. Söylediğim gibi, bu işlem için ücret almayacağım. Aletlerimi geri getirdiğiniz için bir hediye gibi düşünün. Ne kadar sürer derseniz... İki gün sonra Mücevher Dükkanına gelin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350806,
					"content": "Yani \"ilham bulmak\" böyle bir şey mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350807
					]
				},
				{
					"id": 750350807,
					"content": "Aa, demek ilham meselesini siz de biliyorsunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350808
