			"dialogs": [
				{
					"id": 750350101,
					"content": "Affedersiniz... Acaba Kulahaw Usta siz misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350102,
					"content": "Evet, bana öyle derler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350103
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350103,
					"content": "Harika, şu ilham arayan Mücevher Ustası siz olmalısınız! Imix'in tavsiyesi üzerine geldik buraya. Uzun uzun şu ağaca baktığınızı fark ettik az önce. Yaratıcılığınızı ortaya çıkarmanın yollarından biri mi bu yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350104,
					"content": "Şey, aslında... Aman, neyse. Artık bir önemi yok... *iç çeker* Size nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350105
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350105,
					"content": "#Elimizde muhteşem bir değerli taş var, acaba bu taşı {REALNAME[ID(2)|SHOWHOST(true)]} için işleyebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350106,
					"content": "#Hehe, hadi {REALNAME[ID(2)|SHOWHOST(true)]}, göstersene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350107,
					"content": "Rarr! Rarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350108,
					"content": "Aaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350109,
					"content": "#Bir kanat çırpma sesi duyuyorsun...\\nKendine geldiğinde {REALNAME[ID(2)|SHOWHOST(true)]} ile göz göze geliyor, pençesinde duran değerli taşın kayboluverdiğini görüyorsun.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750350110
					]
				},
				{
					"id": 750350110,
					"content": "Raaaaar! Roaaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350111,
					"content": "Bi-Bir dakika... Değerli taş nerede? Koskoca taş nereye kaybolmuş olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350112,
					"content": "Sanırım kuş kaptı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350113
					]
				},
				{
					"id": 750350113,
					"content": "Nasıl yani? Buradaki kuşlar hırsızlık mı yapıyor yoksa? Ne kadar ayıp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350114,
					"content": "Roaar! Rooaaar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350115,
					"content": "Ben de tam o konuda bir şey söyleyecektim. O değerli taş çalınmasaydı bile size yardım edemezdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350116
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350116,
					"content": "... O lanet kuşlar tüm aletlerimi çaldı! Ben de aslında dikkatle o kuşları izliyordum. Hepsini tek tek inceleyerek hangisinin pis pençeleriyle aletlerimi çaldığını anlamaya çalışıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350117
					],
					"speakerTitle": "Kulahaw"
				},
				{
					"id": 750350117,
					"content": "#Yani... Böyle bir şey mümkün mü ki? Bak sen şu kuşlara! Hadi {NICKNAME}, gidip taşımızı geri alalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350118,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350119,
					"content": "Benim aletleri de unutmayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulahaw"
				}
			]
		},
