			"dialogs": [
				{
					"id": 750350401,
					"content": "Dükkanımıza hoş geldiniz! Değerli taşınıza şekil verilmesini istiyorsanız tam yerine geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350402
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350402,
					"content": "Merhaba! Elimizde bir değerli taş var ama bu küçük Tepetlizor yoldaşımız için özel bir tasarım istiyoruz. Ta da! İşte taşımız burada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350403,
					"content": "Muhteşem! Gerçekten son derece kaliteli bir taşmış! Şunun boyutuna bir baksanıza, üstelik nasıl da berrak... Ama özel tasarım işleri biraz zordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350404
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350404,
					"content": "Bu laflar bana tanıdık geldi. Sırada ne var, ek ücret mi talep edeceksiniz yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350405,
					"content": "Hayır! Olur mu öyle şey? Siz beni ne sandınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350406
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350406,
					"content": "Dükkanımız değerli taş kesimi ve parlatılması konusunda uzmanlaşmıştır. Elimize güzel bir taş geçtiğinde parlatma işlemi için ücret almayız. Böylece o değerli taş güzelliğiyle göz kamaştırırken bir yandan da bizi dünyaya tanıtmış olur. Asla boş yere yüksek ücret talep etmeyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350407
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350407,
					"content": "Nasıl ki iyi bir zanaatkarın iyi malzemelerle çalışması gerekiyorsa, özel değerli taşların da iyi bir zanaatkara emanet edilmesi gerekir. Ben tam da böyle bir \"Mücevher Ustası\" tanıyorum, bu değerli taşın tüm güzelliğini ortaya çıkarabileceğine hiç şüphe yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350408
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350408,
					"content": "İşte bu harika! Hemen o Mücevher Ustasını çağırabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350409,
					"content": "Ne yazık ki onunla görüşmek için önceden randevu almanız gerekiyor. Kendisi randevusu olmadığı zamanlarda ilham bulmak için yürüyüşe çıkar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350410
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350410,
					"content": "İlham bulmak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350411
					]
				},
				{
					"id": 750350411,
					"content": "Tabii! Tüm ustalar biraz farklıdır ama Kulahaw Usta oldukça sıra dışı bir zanaatkardır. Zanaatkarın eline aldığı değerli taşı basmakalıp bilgilere göre değil, doğadaki güzellikleri gözlemleyip kavrayarak işlemesi gerektiğini düşünür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350412
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350412,
					"content": "Mesela parlatma tekniklerini gölün yüzeyindeki ufak dalgalanmalardan öğrenir ve gökyüzünde şekilden şekile giren o bulutlardan oyma desenleri çıkarır... İşte Kulahaw Usta ilhamını bunlardan alır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350413
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350413,
					"content": "Şey... Biraz karışıkmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350414,
					"content": "Çok aceleniz varsa onu ilham bulmak için gittiği yerlerden birinde bulabilirsiniz! Bana bugün nereye gideceğini söylemişti, konumunu haritanda işaretleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
