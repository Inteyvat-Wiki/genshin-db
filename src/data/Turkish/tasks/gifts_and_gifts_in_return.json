					"nextDialogs": [
						750351203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351203,
					"content": "Burayı sevdin demek! Çok doğal, bizimle tanışmadan önce burada çok vakit geçirmişsindir kesin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351204,
					"content": "Paimon bu sefer de biz gittikten sonra o parlayan sütunlar birden yok olacak mı acaba diye merak ediyor... Neyse, buraları toparlayalım ve biraz dinlenelim en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351205,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} ve Paimon ile birlikte ortalığı toparlıyorsunuz.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750351206
					]
				},
				{
					"id": 750351206,
					"content": "Hehe, çok güzel oldu!",
