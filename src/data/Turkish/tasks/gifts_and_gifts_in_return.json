			"dialogs": [
				{
					"id": 750350301,
					"content": "Aa, geldiniz demek. Kulahaw Usta değerli taşınızı işledikten sonra dükkanda bıraktı, onu size bizzat teslim etmem gerekiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350302
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350302,
					"content": "Nasıl yani? Kulahaw Usta bugün de mi yok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350303,
					"content": "Evet, yine ilham aramaya gitti. Ayrıca yanında birkaç tane de kilit götürdü, o kilitler sayesinde aletleri artık çalınmayacakmış... Çok tuhaf... Bizim aletlerimizi kim ne yapsın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350304
					],
					"speakerTitle": "Imix"
				},
				{
					"id": 750350304,
					"content": "Doğru söylüyorsun! Sanırım aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350305,
					"content": "(... Galiba Imix aletleri kuşların çaldığını hâlâ bilmiyor... Kulahaw'ı zor durumda bırakmayalım en iyisi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350306,
					"content": "Aslında... Aletleri çalan kişi aynı zamanda onun hünerlerini de çalabileceğini sandı belki de, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350307,
					"content": "Aman, neyse artık... Biz değerli taşımızı alalım! Şekli çok güzel olmuş. \"Şaheser\" diye buna denir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350308,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750350309,
					"content": "#Belli ki {REALNAME[ID(2)|SHOWHOST(true)]} çok beğendi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750350310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750350310,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} adına teşekkür ederiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750350311
					]
				},
				{
					"id": 750350311,
					"content": "Sürüngeniniz sevdiyse ne mutlu! Bu güzel sözlerinizi Kulahaw Usta'ya ileteceğim. Ne zaman isterseniz bekleriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Imix"
				}
			]
		},
