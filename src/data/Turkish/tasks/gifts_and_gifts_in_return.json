					"nextDialogs": [
						750351211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351211,
					"content": "Ne? Arkamızı dönmemizi mi istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351212,
					"content": "Yoksa bize bir sürpriz mi hazırladın bakalım? Hehe, seni anlamak o kadar kolay ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351213,
					"content": "Pekala, dönelim o halde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351214,
					"content": "#Paimon ile birlikte arkanızı dönüyorsunuz ve bitmek bilmeyen bir tıngırtı sesi başlıyor.\\nGaliba {REALNAME[ID(2)|SHOWHOST(true)]} bir şeylerle uğraşıyor...\\nKısa bir süre sonra {REALNAME[ID(2)|SHOWHOST(true)]} \"Raar! Raar!\" diye kükreyince artık dönebileceğinizi anlıyorsunuz...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750351215
					]
				},
				{
					"id": 750351215,
					"content": "Vay canına, ne kadar çok şey var burada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351216,
					"content": "Paimon bir baksın bakalım! Hımm, dümdüz bir dal, yusyuvarlak bir taş... Tuhaf kokan ve tuhaf renklere sahip bir yemek. Kim bilir kaç gün beklemiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351217,
					"content": "Tüm bunları özenle seçtin, değil mi? Yoksa bunları bize mi hediye ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351218,
					"content": "Raarr! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351219,
					"content": "Ama bu kadar uzun süre beklemiş bir yemeği yiyemeyiz ki! Sen de dahil olmak üzere bunu kim yerse yesin midesini bozar, orası kesin! Önce şunu bir halledelim en iyisi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351220,
					"content": "Aruuuu... Raaaarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351221,
						750351223
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351221,
					"content": "Ay bu dal da pek güzelmiş!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351222
					]
				},
				{
					"id": 750351222,
					"content": "Aynen! Şöyle elinde tutup bir sallayınca son derece güçlü bir kılıç gibi oluyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351225,
					"content": "Raarr! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351226
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351226,
					"content": "Tüm bu hediyeleri seve seve kabul ederiz! Hehe, en iyisi bunları Paimon'un gizli zulasındaki sırt çantasına koyalım! Belli mi olur, belki bir noktada işimize yarar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351227,
					"content": "#Hımm, {REALNAME[ID(2)|SHOWHOST(true)]} bize bir hediye verdi. Bizim de ona bir hediyeyle karşılık vermemiz gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351228,
					"content": "Bakalım Paimon'un gizli zulasından neler çıkacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351229,
						750351231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351229,
					"content": "Hayırdır, senin bu cömert tarafını pek sık görmeyiz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351230
					]
				},
				{
					"id": 750351230,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} bize değer verdiğini göstermek için bunca zahmete katlanmış, bu çabalarını karşılıksız bırakamayız! Ayrıca bu kadar eşya Paimon'un uçmasına engel olabilir. Bir kısmını elden çıkarsak iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351233,
					"content": "#İşte, pasparlak bir değerli taş! Beğendin mi {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351234,
					"content": "Raarr! Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351235
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750351235,
					"content": "Hehe, Paimon doğru bir tercih yaptı demek! Aman, dikkat et! Sakın düşürme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351236,
					"content": "... Eyvah. O değerli taşı o kadar sevdi ki, umalım da kaybetmesin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750351237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351237,
					"content": "Hadi Yankıların Çocuklarına gidelim. Kesin orada bu değerli taşa şekil verebilecek bir cevher ustası buluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750351231,
					"content": "Bakalım neler saklamışsın Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750351232
					]
				},
