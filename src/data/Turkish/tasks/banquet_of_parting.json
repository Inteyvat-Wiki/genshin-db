			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310101,
					"content": "Ah, merhaba küçük yardımcılarım. Bana katılmanıza çok sevindim. Tam da zamanında geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310102
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310102,
					"content": "Hıh, sanki başka seçeneğimiz vardı da... Paramızı istiyoruz diye geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310103,
					"content": "Ee Miko, bu Hyakkiyakou'yu düzenlemek için tam olarak ne yapmamız lazım şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310104,
					"content": "Hyakkiyakou ne demek bilmiyoruz gerçi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310105,
					"content": "Biraz ürkütücü gelebilir ama Hyakkiyakou'yu kısaca tanımlamam gerekirse bir tür youkai buluşması diyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310106
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310106,
					"content": "Eskiden düzenlenen youkai buluşmalarında herkes bol bol içtikten sonra youkai güçlerini kullanıp teker teker gökyüzünde süzülmeye başlardı. Havada o kadar çok youkai olurdu ki silüetleri ayın önünü kapatırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310107
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310107,
					"content": "Şimdiyse Ley Hatlarından sızan youkai anıları çok güçsüz. Artık uçabilecek halde değiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310108
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310108,
					"content": "O yüzden onlar için bir davet ayini düzenleyeceğim. Bu sayede etrafta gezen tüm anılar tek bir yerde toplanacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310109
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310109,
					"content": "Vakit geldiğinde Büyük Narukami Tapınağının üzerinde gökyüzünde toplanacaklar. Enerjilerini harcadıktan sonra mutlu olacak ve ait oldukları yere geri dönecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310110
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310110,
					"content": "Peki, anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310111
					]
				},
				{
					"id": 120310111,
					"content": "Aslında ayin için tüm hazırlıklar önceden yapıldı. Kitabımıza eklediğim büyüyü ve \"mehtapsız gece\"den bahsedildiğini hatırlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310112
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310112,
					"content": "Aa, evet. Mehtapsız bir gecede \"Leydi Kitsune'nin Gizli Büyüleri\"ni söylemekle ilgili bir şeyler yazıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310113,
					"content": "Aynen öyle. İşte o aslında dilekleri gerçekleştiren bir büyü değil. Ley Hattından çıkan anıları sakinleştirmeye yarıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310114
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310114,
					"content": "Vakti geldiğinde güçlerimizi birleştirip anıları geri yollayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310115
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310115,
					"content": "Bizden ne yapmamızı istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310116
					]
				},
				{
					"id": 120310116,
					"content": "Biraz sonra ayin hazırlıklarına başlayacağım. O sırada sizden iki şey yapmanızı istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310117
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310117,
					"content": "İlk olarak tapınak görevlilerine dağı terk etmelerini söyleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310118
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310118,
					"content": "Hyakkiyakou sırasında youkai anılarından oluşan bir küme Büyük Narukami Tapınağının tepesinde havada süzülmeye başlayacak. Tapınak görevlileri o sırada tapınaktan uzakta olursa kimse ele geçirilme riski yaşamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310119
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310119,
					"content": "Herkes uzaklaştıktan sonra ayini başlatacağım, anılar toplanmaya başlayacak. Tabii bu süreç biraz zaman alacak. O sırada sizin Yougou Dağı'nın eteğinde beklemenizi istiyorum, yakınlardaki canavarlarla ilgilenmeniz gerekebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310120
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310120,
					"content": "Anılar normalde dört bir yana dağılmış halde durduğu için bir tehdit oluşturmaz. Ancak enerjileri tek noktada yoğunlaştığında büyük ihtimalle canavarları kışkırtacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310121
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310121,
					"content": "Canavarlar bu durumu fırsat bilip dağa tırmanmaya çalışabilir. Öyle bir şey yaşanmaması için canavarları dağdan uzak tutmanıza ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310122
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310122,
					"content": "Tamam, anladım. Peki sonra ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310123,
					"content": "Hımm... Yani, isterseniz tapınağa gelip youkaileri yakından görebilirsiniz. Benim için hava hoş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310124
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310124,
					"content": "#Peki {NICKNAME}, hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
