					"Maki",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310201,
					"content": "Dağdan inin mi dediniz? Leydi Guuji'nin emri mi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310202,
					"content": "Evet, Miko dedi ki yakında bir ayin düzenleyecekmiş ve bu ayin sizin için tehlikeli olabilirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310203,
					"content": "Anladım... O halde herkesi hemen gönderiyorum. Siz ne yapacaksınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310204,
					"content": "Miko için halletmemiz gereken birkaç iş var. Ondan sonra da dönüp ayine katılacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310205,
						120310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310205,
					"content": "Miko'nun da güvende olduğundan emin olmak istiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				},
				{
					"id": 120310207,
					"content": "Leydi Guuji size bir hayli güveniyor belli ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310208
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310208,
					"content": "Geçmişte bu tarz ayinleri yaparken kimsenin yanında kalmasına izin vermezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310209
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310209,
					"content": "Ayine yardımcı olduğunuz için teşekkür ederim... Ve bol şans dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310210
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 120310210,
					"content": "Merak etme, göründüğümüzden çok daha güçlüyüz biz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310206,
					"content": "Youkaileri yakından görmek istiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				}
			]
		},
		{
			"id": 1203104,
			"completionStepIds": [
				1203106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203106",
							"2"
						],
						"stepId": 1203106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko",
					"Paimon",
					"Okazaki Rikuto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310401,
					"content": "Ah, küçük dostlarım. Sonunda geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310402
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310402,
					"content": "Miko... Bu ne şimdi? Yemeğe bizsiz mi başladın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310403,
					"content": "Evet, başladım tabii. Sonuçta parasını siz ödeyeceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310404
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310404,
					"content": "Hiç para ödemeden en pahalı yemekleri yiyip en kaliteli sakeyi içebileceğimi düşününce... Kendimi daha fazla tutamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310405
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310405,
					"content": "Bu yanımdaki iki kişinin yüzünü sakın unutma Patron. Hesabı onlar ödeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310406
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310406,
					"content": "Hayhay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310407
					],
					"speakerTitle": "Okazaki Rikuto"
				},
				{
					"id": 120310407,
					"content": "Iıı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310408,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310409
					]
				},
				{
					"id": 120310409,
					"content": "Ne oldu? Hadi oturun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310410
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310410,
					"content": "Bu balığı mutlaka denemelisiniz. Sadece Seirai Adası'nın etrafındaki sularda yetişen bir balık. Buraya dün gece göndermişler, ben sipariş edene kadar canlıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310411,
					"content": "Ya da belki bunu denemek istersiniz. Evet, evet, biliyorum. Benim de normalde bu kadar pahalı bir sake içmeye içim el vermiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310412
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310412,
					"content": "İçki içmiyorsanız da sorun değil tabii. Burada istediğiniz fiyatta, istediğiniz türde meyve suyunu bulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310413
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310413,
					"content": "Of Miko! Şaka gibisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310414,
					"content": "En son beraber roman üzerinde çalışırken bize ısmarladığın tek şey en sadesinden bir Kushikatsuydu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310415,
					"content": "Öyle mi? Çok garip, ben hiç öyle bir şey hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310416,
						120310417
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310416,
					"content": "Ben hatırlıyorum ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				},
				{
					"id": 120310418,
					"content": "Hım. Ee, ne olmuş yani? Yemek ısmarlayacağınıza söz vermediniz mi? Farkındaysanız ben önemli biriyim. Bana yemek ısmarlarken kesenin ağzını kapatmaktan utanmayacak mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310419,
					"content": "İyi de bu yemek çok pahalı olacak Miko. Ödeyemezsek diye korkmuyor musun hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310420,
					"content": "Hehe, hiç endişelenmeyin. Ödeyebileceğinize eminim... Resimli romanınızı basmaya devam ediyorlar sonuçta. O romandan çok güzel bir ödeme alacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310421,
					"content": "N-Ne!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310422,
					"content": "#Off, olamaz! Bizi kandırmış {NICKNAME}! En başından beri Moramızın peşindeymiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310423,
						120310424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310423,
					"content": "Gafil avlandık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310425,
					"content": "Hahaha, yüzünüzdeki şu ifadeye bakın. Harika, hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310426
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310426,
					"content": "Ha, aklıma gelmişken... Mehtapsız gecede kimsenin dileği gerçekleşmediği için artık içinde büyü geçen romanlar popülerliğini kaybetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310427,
					"content": "O yüzden \"Gezginin Mucizevi Maceraları\"nın bir sonraki bölümünde yazacak yeni bir şey bulmanız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310428
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310428,
					"content": "Teslim tarihinin eli kulağında... Yeni bölüm ellerinizden öper.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310424,
					"content": "Dolandırıldık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310417,
					"content": "Kushikatsu ve Kızarmış Tofu dışında hiçbir şey yoktu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				}
			]
		},
