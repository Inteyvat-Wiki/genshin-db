					"nextDialogs": [
						120310906
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310906,
					"content": "Ha... Siz ikiniz var ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310907
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120310907,
					"content": "Miko...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310908
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120310908,
					"content": "İyi. Madem benim için bir şey yapmakta ısrar ediyorsunuz, o halde bana yemek ısmarlayabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
