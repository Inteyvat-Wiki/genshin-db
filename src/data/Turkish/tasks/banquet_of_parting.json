					"nextDialogs": [
						120311903
					],
					"speakerTitle": "Oosuke"
				},
				{
					"id": 120311903,
					"content": "Evet, o gece Yougou Dağı'nın tepesinde devasa bir kara bulut vardı. Resmen bir anda ortaya çıkıverdi!",
