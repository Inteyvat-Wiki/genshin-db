			"dialogs": [
				{
					"id": 745270401,
					"content": "#Aa, sen miydin {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270402,
						745270403
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270402,
					"content": "Görüşmeyeli uzun zaman oldu Escoffier.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				},
				{
					"id": 745270404,
					"content": "Bugün mutfaktan sorumlu değilim. Sadece tadım yapmaya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270405
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270405,
					"content": "Savanna yeni bir tarif üzerinde çalışıyor, benden de kontrol etmemi istedi. Gerçi bu... Söz konusu tarifin beşinci denemesi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270406
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270406,
					"content": "Ya malzemelerin dokusu sıcaklık kontrolündeki birkaç saniyelik eşitsizlikten etkileniyor ya da aşırı miktarda kullanılan baharatların kokusu diğer tatlara ağır basıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270407
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270407,
					"content": "Bakıyorum da müşkülpesentliğin üzerinde yine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270408
					]
				},
				{
					"id": 745270408,
					"content": "Herhalde! Yemek yapmak bir bilimdir ve arkadaşlığımız bunu değiştirmeyecek. Hatta arkadaşlığımız ve müşterilerimize karşı olan sorumluluğumuz katı olmamı gerektiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270409,
						745270410
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270409,
					"content": "Aslında küçük bir ricam var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270411,
					"content": "... Böyle bir anda mı? Eğer fotoğraflar halka açık olacaksa başka bir zamanda çekmeni rica edebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270412
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270412,
					"content": "Seti özenle kurmamız ve mümkün olan en iyi sonuç için ışıklandırma ile açıyı dikkatlice ayarlamamız gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270413,
						745270414
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270413,
					"content": "Sadece anı fotoğrafı çekiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270415,
					"content": "... Pekala. Altıncı denemeye kadar biraz zaman var zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745270416
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270416,
					"content": "Madem öyle, lensinin mi yoksa o yeni yemeğin mi daha üstün geleceğini görelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 745270414,
					"content": "Ayrıca bu yeni lensi test etmek istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270415
					]
				},
				{
					"id": 745270410,
					"content": "Bir fotoğrafını çekebilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270411
					]
				},
				{
					"id": 745270403,
					"content": "Yeni bir tarif mi hazırlıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745270404
					]
				}
			]
		}
	]
