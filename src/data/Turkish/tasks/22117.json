					"Madam Ping"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221170101,
					"content": "Umarım onu dağın başında unutmamışımdır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170102
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170102,
					"content": "Selam nine, seni burada görmek ne güzel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170103
					]
				},
				{
					"id": 221170103,
					"content": "Benim de siz gençleri böyle bir yerde göreceğim hiç aklıma gelmezdi! Tesadüfe bak... Ama burada daha kalın giyinmelisin. Epey rüzgarlı buralar, soğuk alırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170104
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170104,
					"content": "Ben de Hulao Dağı'ndan şehre dönüyordum. Eski bir dostumu görmeye gitmiştim ve eski zamanları yad ettiğimiz keyifli bir sohbet oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170105
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170105,
					"content": "Ama dönüş yolunun yarısında bir şey unuttuğumu fark ettim. *iç çeker* Muhtemelen dağın tepesinde bıraktım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170106
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170106,
					"content": "Benim yaşımda biri aynı gün içinde ikinci kez oraya çıkamaz... Hem çok uzun bir mesafe, hem de yol boyunca insanı uğraştıran kehribarlar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170107
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170107,
					"content": "Gençler.. Onu benim için dağdan getirir misiniz? Gerçekten çok müteşekkir olurum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170108,
						221170111
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170108,
					"content": "Kim bu eski dost?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170109
					]
				},
				{
					"id": 221170109,
					"content": "Hulao Dağı'nda yaşayan biri. İllaki tanışmışsınızdır, onun kehribarı tam bir baş ağrısı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170110
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170110,
					"content": "İyice yaşlandım herhalde. Dönmeden önce kutuyu çaydanlığıma koymayı nasıl unuturum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170111,
					"content": "Orada unuttuğun şey ne ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170112
					]
				},
				{
					"id": 221170112,
					"content": "Sanırım bir kutu. Hafızam artık eskisi gibi iyi değil... Neden kutuyu alır almaz çaydanlığıma koymadım ki? Bunca eziyeti çekmemiş olurdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170113
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170113,
					"content": "En azından dağdaysa muhtemelen kehribarların arasına sıkışmıştır. Yani kutuyu bulmak çok zor olmayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170114
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170114,
					"content": "Gençler, lütfen bu yaşlı kadının gününü güzelleştirin. Kutuyu Hulao Dağı'ndan geri getirin olur mu? Kutu, kehribarların olduğu yerde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170115
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170115,
					"content": "Ama kendinize dikkat edin. Kim bilir bunca yıldır o kehribarların içine başka neler sıkışmıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				}
			]
		},
		{
			"id": 2211703,
