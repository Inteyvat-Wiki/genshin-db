			},
			"dialogs": [
				{
					"id": 221170301,
					"content": "Şapşal çocuk, niye dışarı çıkmadan önce kalın giyinmedin? Soğuk alırsan, kendimi çok kötü hissederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170302
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170302,
					"content": "Merhaba nine, kaybettiğin şey bu muydu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170303
					]
				},
				{
					"id": 221170303,
					"content": "Bir bakayım... Evet, buydu. Demek gerçekten de yukarıda unutmuşum. Son zamanlarda hafızam gerçekten çok kötü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170304
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170304,
					"content": "Şimdi kutuyu alayım, teşekkür ederim. Zaten içinde sadece eski ıvır zıvırlar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170305
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170305,
					"content": "Bu arada bunlar sizin için. Teşekkür ederim canlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170306
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170306,
					"content": "Şimdi unutmadan şu kutuyu çaydanlığıma koyayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				}
			]
		},
