				{
					"id": 221170401,
					"content": "Şapşal çocuk, niye dışarı çıkmadan önce kalın giyinmedin? Soğuk alırsan, kendimi çok kötü hissederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170402,
						221170406
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170402,
					"content": "Bana kehribardan bahset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170403
					]
				},
				{
					"id": 221170403,
					"content": "Onları eski dostum yapıyor. Böylece dağa çıkan canavarları ve haydutları yakaladığını söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170404
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170404,
					"content": "Uzun süredir dağın o bölgesinde kehribar var. Kehribar, yıllar boyunca birçok tuhaf şey yakalamıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170405
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170405,
					"content": "Cidden dehşet verici bir madde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170406,
					"content": "Bugünlerde çaydanlık ne durumda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221170407
					]
				},
				{
					"id": 221170407,
					"content": "Tekrardan gıcır gıcır, tabii hepsi senin sayende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170408
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170408,
					"content": "Aslında onca yol gidip kutuyu almamın nedeni de çaydanlığıma biraz daha çekidüzen vermekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221170409
					],
					"speakerTitle": "Madam Ping"
				},
				{
					"id": 221170409,
					"content": "Hem tertemiz hem de kusursuz hale geldiğinde, sonunda konuklarıma yeniden çay ikram edebileceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Madam Ping"
				}
			]
		}
