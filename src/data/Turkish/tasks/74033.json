					}
				]
			},
			"dialogs": [
				{
					"id": 740330401,
					"content": "Mitul, iyi misin? Umarım seni çok bekletmemişizdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330402
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740330402,
					"content": "Kurtarıcım benim! Nihayet geldin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330403
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330403,
					"content": "Koblenz nerede? Yanında değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330404
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330404,
					"content": "Seni burada mahsur bıraktığını söyleyip benden yardım istedi ama yanımıza muhafız gelince gitmek zorunda kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330405
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740330405,
					"content": "Ona güvenmemem gerektiğini biliyordum! Suçluluk duygusu yüzünden kaçıp gitmiştir kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330406
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330406,
					"content": "Risk almadan nasıl para kazanabilirsiniz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330407
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330407,
					"content": "Sakardı, gereğinden fazla dikkatli olması da cabası... Saf Su ayrı bir olay ama artık Fonta bulmak bile mümkün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330408
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330408,
					"content": "Burada Fonta varsa nasıl hayatta kalacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330409
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330409,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330410,
					"content": "Ne, siz de mi Fonta seviyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330411,
						740330413
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330411,
					"content": "Sen sevmiyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330412
					]
				},
				{
					"id": 740330412,
					"content": "Seviyorum! Güçlü bir rakip, hakkını vermek gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330415,
					"content": "Neyse, gidip Koblenz'e hesap sormam lazım. Bu arada, size ödeme yaptı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330416
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330416,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330417
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740330417,
					"content": "... Bazen onu kocaman bir bidona tıkmak istiyorum. Belki o zaman aklı başına gelir. Neyse, lütfen bu Kuponları kabul edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330418
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330418,
					"content": "İsterseniz alabilirsiniz onları.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330419
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740330419,
					"content": "Ne? Hepsini almamızı mı istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330420,
					"content": "Tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330421
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740330421,
					"content": "Teşekkürler o zaman. Daha sonra Eskiciye gidip yeni bir şeyler gelmiş mi diye bakabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330422,
					"content": "Bu arada, sizi bu işe karıştırdığım için özür dilerim. Elimde taze şifa içecekleri var, bir şişe istemez miydiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330423
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330423,
					"content": "Taze... Şifa içeceği mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330424,
					"content": "Evet! Saf Sudan daha sağlıklıdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330425,
						740330428
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330425,
					"content": "Ben bir tane alırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330426
					]
				},
				{
					"id": 740330426,
					"content": "(Baksana, hani Tırtıl içecek kabul etmememizi söylemişti?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330427,
					"content": "#Hayır, {NICKNAME} öyle demek istemedi! Buraya gelmeden önce bir sürü şey içmiştik zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330431,
					"content": "Ama Paimon içeceklerin muhteşem olduğundan adı gibi emin! Bir dahaki sefere mutlaka deneyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330432,
					"content": "Kötü zamanlama demek? Tamam, fırsatınız olunca yine gelin. Hepsi ikramım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330433
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330433,
					"content": "Neyse, artık Koblenz'le konuşmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330434
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330434,
					"content": "Başka bir işim olduğu için gitmek zorundayım. Kuponlar için endişelenmeyin. <color=#00E1FFFF>Karşıma çıkan ipuçlarını kara tahtaya yazacağım.</color> Sonra görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330435
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740330435,
					"content": "Görüşmek üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330428,
					"content": "Ben Fonta alayım lütfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330429
					]
				},
				{
					"id": 740330429,
					"content": "Tabii, elimde ondan da var. Bir dakika. Neden sağlıklı içeceklerimi kabul etmiyorsunuz siz? Şunu bilmelisiniz ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330430
					],
					"speakerTitle": "Mitul"
				},
				{
					"id": 740330430,
					"content": "#{NICKNAME} öyle demek istemedi. Buraya gelmeden önce... Bir sürü şey içtik de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330413,
					"content": "Aynen öyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740330414
					]
				},
				{
					"id": 740330414,
					"content": "Anlaşılan zevk sahibi müşterilersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330415
					],
					"speakerTitle": "Mitul"
				}
			]
		}
	]
}