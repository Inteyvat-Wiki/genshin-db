			"dialogs": [
				{
					"id": 740330101,
					"content": "Jeod Maden Kuyusu kapandığından beri kimse buraya gelmiyor. Buradaki cihazları öyle herkes kullanamaz zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330102
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740330102,
					"content": "Şimdi olan da bu. Birileri kontrol vanasıyla oynayıp arkadaşının içeride hapis kalmasına sebep olmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330103
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740330103,
					"content": "Neyse, <color=#00E1FFFF>1. Kaynak Deposuna</color> giden yolu açalım. Bu arada size içecek ikram etmeye kalkarlarsa kabul etmemenizi tavsiye ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330104
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740330104,
					"content": "Kim içecek ikram edecek? Neden kabul etmeyelim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740330105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740330105,
					"content": "Birazdan anlarsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tırtıl"
				}
			]
		},
		{
