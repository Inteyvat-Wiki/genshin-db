			"dialogs": [
				{
					"id": 716662101,
					"content": "Harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662102
					],
					"speakerTitle": "Maç Yorumcusu"
				},
				{
					"id": 716662102,
					"content": "Gördüğüm kadarıyla Arataki Çetesi, böcek dövüşünü son derece rekabetçi ve yüksek adrenalinli bir spora dönüştürmüş. Evet, iyi bir öykünün temelleri atılmış burada, tekrar ve tekrar anlatılabilecek bir öykü bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662103
					],
					"speakerTitle": "Maç Yorumcusu"
				},
				{
					"id": 716662103,
					"content": "Güzel düelloydu Tian Beyefendi! O zevk sana ait!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662104
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662104,
					"content": "Doğrusu \"O zevk bana ait.\" olacak Oni Kral.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662105
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 716662105,
					"content": "Aman, takılma detaylara! Sonuç olarak... Eğitim kampımıza gösterdiğin destek için sağ ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662106
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662106,
					"content": "Ben de sana minnettarlığımı sunuyorum Don Arataki. Hikayemi geliştirmek için bir süre daha burada durup dövüşleri izlemek istiyorum. Lütfen bana aldırmayın, burada yokmuşum gibi davranın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662107
					],
					"speakerTitle": "Maç Yorumcusu"
				},
				{
					"id": 716662107,
					"content": "Dostum ya, daha önce hiç bu kadar... Kültürlü biriyle kapışmamıştım! Kullandığı şekil kelimeler başımı döndürdü! Ne deniyordu bu hisse? Hah, öğrenmek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662108,
					"content": "Arataki Parlak Zırhlı Böcek Dövüşü Eğitim Kampı güzel bir açılış yaptı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
