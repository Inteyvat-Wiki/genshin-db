					}
				]
			},
			"dialogs": [
				{
					"id": 716662001,
					"content": "Merhabalar, ben Demir Dil Tian. Arataki Parlak Zırhlı Böcek Dövüşü Eğitim Kampı için resmi tabelanızı getirdim. Ayrıca etkinlik izni yerine de geçiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662002
					],
					"speakerTitle": "Maç Yorumcusu"
				},
				{
					"id": 716662002,
					"content": "Vay be! Bu tabeladaki... Boşboğaz ve Kızıl Asa mı? Çok gösterişli olmuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716662003,
					"content": "Süper! Benim çizimim değil ne yazık ki... Ama tasarımı müthiş! Çizgileri de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662004
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662004,
					"content": "Çok havalı! Efsanelerden fırlamış gibi! Savaşın ortasında profesyonel bir böcek dövüşçüsü gibi görünüyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662005
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662005,
					"content": "Dostum! Bir dakika, pardon. Bu ülkede yabancılara nasıl sesleniliyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662006
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662006,
					"content": "\"Beyefendi\" olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662007
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 716662007,
					"content": "Hah, evet! Tian Beyefendi, çiziminiz harika olmuş! Arataki Çetesi size gönülden minnettar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662008
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662008,
					"content": "\"Beyefendi\" demene gerek yok Don Arataki. Ayrıca ben sanatçı değilim, hikaye anlatıcısıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662009
					],
					"speakerTitle": "Maç Yorumcusu"
				},
				{
					"id": 716662009,
					"content": "Bu tanıtım çizimini Sivil İşler Bakanlığında genç bir hanım yaptı. Yanfei'den sık sık yardım alan bir hanım kendisi. Etkinliğinizi duyunca çizimiyle katkıda bulunmak istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662010
					],
					"speakerTitle": "Maç Yorumcusu"
				},
				{
					"id": 716662010,
					"content": "Haa, demek bu Yanfei'nin işi! Vay be, her şeyi düşünmüş... Tam ihtiyacımız olan şey bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662011
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662011,
					"content": "Genç Büyük Usta Hanakado bana eğitim kampınızın böcek dövüşünün geleceğini şekillendirebilecek kadar iddialı bir idman programı olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662012
					],
					"speakerTitle": "Maç Yorumcusu"
				},
				{
					"id": 716662012,
					"content": "Şahsen ben böcek dövüştürmüyorum ama çok duymuşluğum var. Hep denemek istemişimdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662013
					],
					"speakerTitle": "Maç Yorumcusu"
				},
				{
					"id": 716662013,
					"content": "Kim bilir, belki anlatabileceğim yeni ve muhteşem bir hikaye için bana ilham kaynağı olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662014
					],
					"speakerTitle": "Maç Yorumcusu"
				},
				{
					"id": 716662014,
					"content": "Böcek dövüşü doğuştan yetenek isteyen bir şey. Gök Yaran Beyaz Demir Eflatun Kavun misal. Kısa bir tanıtımdan sonraki ilk dövüşünde muhteşem bir yetenek sergiledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662015
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 716662015,
					"content": "Tian Beyefendi böcek dövüşünün temellerini ve cazibesini anladığında anlattığı hikayeler bizim için ücretsiz tanıtım olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662016
					],
					"speakerTitle": "Büyük Usta Hanakado"
				},
				{
					"id": 716662016,
					"content": "Dostum! Süper olur bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716662017
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 716662017,
					"content": "Pekala Feybendi! Peybendi! Peyfendi! BEYEFENDİ! Öhöm öhöm... En iyi olan kazansın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				}
			]
		},
		{
