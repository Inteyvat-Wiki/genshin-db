						760000802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760000802,
					"content": "#Hepsinden veri toplayıp buraya analiz için gönderiyorlar. {NICKNAME}, bu verileri onlardan çalsak nasıl olur?",
					"roleType": "TALK_ROLE_NPC",
