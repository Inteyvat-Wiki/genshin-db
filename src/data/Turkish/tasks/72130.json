			"dialogs": [
				{
					"id": 721300101,
					"content": "Bu garip şekilli taş fenerden uğursuz bir enerji yayılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300102
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721300102,
					"content": "Bu taş fener çok ürpertici... Tanıdık geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300103,
					"content": "Birisi fenerin üzerine bir şeyler yazmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721300104,
					"content": "\"Buraya gönderilen askerler, bu tılsımla alakalı herhangi bir sorunuz varsa lütfen Musoujin Geçidi'ne gidip Bay Kaji ile konuşun.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300105
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721300105,
					"content": "Yeni yazılmış sanki ama yağmur yüzünden silinmiş. Altında yazan ufak yazılar okunuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300106
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721300106,
					"content": "\"Lütfen bu tuhaf notlara aldırış etmeyin. Kaybedecek vaktimiz yok! Bu düşmanın bizi yavaşlatmak için yaptığı bir hamle olmalı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300107
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721300107,
					"content": "\"Ekipten izinsiz ayrılan herkes ağır bir şekilde cezalandırılacak!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300108
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721300108,
					"content": "Bu Bay Kaji bu taş fenerlere kafayı takmış galiba. Musoujin Geçidi'ne gidip soralım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
