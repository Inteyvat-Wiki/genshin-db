					"Sorgula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650401,
					"content": "Beni burada nasıl buldun? Seni Favonialı pislik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650402
					],
					"speakerTitle": "Sorgula"
				},
				{
					"id": 4650402,
					"content": "Ben bir Favonius Şövalyesi değilim. Şimdi konuşmaya başla! Planınızın ne olduğunu anlat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650403
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650403,
					"content": "Görüyorum ki mektubumuzu almışsın... Ama sana sırlarımızı açıklayacağımı düşünüyorsan korkarım çok yanılıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650404
					],
					"speakerTitle": "Sorgula"
				},
				{
					"id": 4650404,
					"content": "Hımm. İçinde bulunduğun durumu yanlış anlamışsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651001
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651001,
					"content": "Onu <color=#00E1FFFF>Dağlayan El</color> ile yak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651501
					]
				},
				{
					"id": 4651501,
					"content": "A-Az önce bir Ateş Önsezisi kullanarak ellerinden ateş mi attın sen? Aah! Yakıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650601
					],
					"speakerTitle": "Sorgula"
				},
				{
					"id": 4650601,
					"content": "Bakalım çözülmen ne kadar sürecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650405,
					"content": "Onu <color=#00E1FFFF>Dağlayan El</color> ile bir kez daha yak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651502
					]
				},
				{
					"id": 4651502,
					"content": "Dur! Dur! L-Lütfen, bu acı... Yalvarırım... Yapma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650406,
						4651201
					],
					"speakerTitle": "Sorgula"
				},
				{
					"id": 4650406,
					"content": "Onu <color=#00E1FFFF>Dağlayan El</color> ile bir kez daha yak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4651402
					]
				},
				{
					"id": 4651402,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651403
					],
					"speakerTitle": "Sorgula"
				},
				{
					"id": 4651403,
					"content": "Ölü numarası yapmanın bir faydası yok, bu daha... Ah... Sanırım <color=#00E1FFFF>bayılmış</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651404
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651404,
					"content": "Hey! Ben uyuyabilirsin diyene kadar uyumak yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4651405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651405,
					"content": "Aah! Yakıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650901
					],
					"speakerTitle": "Sorgula"
				},
				{
					"id": 4650901,
					"content": "Konuşacağım, konuşacağım! Uf, uf, uf... L-Lütfen dur! <color=#00E1FFFF>Her şeyi</color> anlatacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650902
					],
					"speakerTitle": "Sorgula"
				},
				{
					"id": 4650902,
					"content": "Hi-Hiçlik Tarikatı olarak Karagece Kahramanı'ndan bizim kadar nefret edenlerle büyük bir ordu oluşturduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650903
					],
					"speakerTitle": "Sorgula"
				},
				{
					"id": 4650903,
					"content": "Bu ordu... Yarın gece saat 22:00'da Mondstadt'ın <color=#00E1FFFF>şehir kapılarına</color> ilerleyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650904
					],
					"speakerTitle": "Sorgula"
				},
				{
					"id": 4650904,
					"content": "Tüm bildiklerim bu kadar... Lütfen... Lütfen artık beni alevlerinle yakma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650905
					],
					"speakerTitle": "Sorgula"
				},
				{
					"id": 4650905,
					"content": "Bu kadar mı? Hımm, başka bir şey saklayacak kadar aptal olduğundan şüpheliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4651201,
					"content": "<color=#00E1FFFF>Onu sorgula</color> ve saldırı planlarını öğren.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650901
					]
				}
			]
		},
		{
