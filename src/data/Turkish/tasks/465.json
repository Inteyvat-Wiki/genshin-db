					"Huffman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650501,
					"content": "Karagece Kahramanı'yla yakında iletişime geçmezsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650502
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650502,
					"content": "Hiçlik Tarikatının meydan okumasıyla ilgili ne yapacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650503
					]
				},
				{
					"id": 4650503,
					"content": "Ah, ikiniz. İtiraf etmem gerekiyor ki bu Karagece Kahramanı sorunu epey baş ağrıtmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650504
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650504,
					"content": "Az önce ne yapacağımız konusunda bir karar almak için bir toplantı yaptık. Neye karar verdiğimizi tahmin edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650505,
						4650508
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650505,
					"content": "Başımızı kuma mı gömeceğiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650506
					]
				},
				{
					"id": 4650506,
					"content": "Haha... İyi espri. Ama hayır, Mondstadt'a karşı en ufak dahi bir tehdit belirtisi olduğunda Şövalyeler öylece kenarda durup bekleyemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650507
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650507,
					"content": "Bunu yaparsak her geçen gün daha fazla kişi, Favonius Şövalyeleri yerine Karagece Kahramanı'na bel bağlamaya başlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650511
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650511,
					"content": "Ah. Pekala, o halde plan nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650512,
					"content": "Karagece Kahramanı'nın gerçek kimliğini öğrenmek ve ona koruma teklif etmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650513
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650513,
					"content": "\"Koruma\" mı? Şimdiye kadar sizin korumanız olmadan da başının çaresine bakabiliyor gibi görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650514,
					"content": "Peh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650515
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650515,
					"content": "Geçmişte Şövalyelere yardım ettiğin için sana söylememde sakınca yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650516
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650516,
					"content": "Koruma teklifi, Favonius Şövalyelerinin, bu meselenin tam ve yegane sorumluluğunu devralmasını sağlamak için ortaya atılan bir aldatmacadan ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650517
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650517,
					"content": "Karagece Kahramanı'nın kahramanca şeyler yapmasını engelleyecek misiniz? Neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650518,
					"content": "Birinci olarak Favonius Şövalyelerinin kudretini göstermek, insanlara Karagece Kahramanı olmadan da barışın ve uyumun sürdürülmesinde Şövalyelere güvenebileceklerini kanıtlamak için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650519
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650519,
					"content": "İkinci olarak Hiçlik Tarikatı merhametsizdir. Karagece Kahramanı'nın başına bir şey gelirse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650520
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650520,
					"content": "Bu sadece onların hain emellerini körüklemek olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650521
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650521,
					"content": "Tanrım... Paimon, bir şövalyenin hayatının böylesi tarifsiz ızdıraplar içerdiğini hiç bilmiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650522,
					"content": "Ama Karagece Kahramanı'nın gerçek kimliğini zamanında öğrenmezsek bunların hiçbiri işe yaramaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650523
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650523,
					"content": "Umutsuzluğa kapılmaya gerek yok Huffman. Sadece planıma uy, her şey yolunda gidecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650524
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650524,
					"content": "Ah, Yüzbaşı Kaeya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650525
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650525,
					"content": "Son zamanlarda Usta Diluc, her gece Meleklerin Payı'ndaki barın arkasında çalışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650526
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650526,
					"content": "Senden yapmanı istediğim tek şey, gözünü onun üzerinden ayırmaman. Benim için bunu yapabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650527
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 4650527,
					"content": "Evet Yüzbaşı Kaeya! Ama bu şey mi demek oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650528
					],
					"speakerTitle": "Huffman"
				},
				{
					"id": 4650528,
					"content": "Usta Diluc, Karagece Kahramanı mı?",
					"roleType": "TALK_ROLE_NPC",
