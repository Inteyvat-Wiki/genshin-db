					"content": "İşte burası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650302
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650302,
					"content": "Bu tarz terk edilmiş harabeler, tam olarak Hiçlik Tarikatının kamp yapacağı türden yerlerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650303
					],
