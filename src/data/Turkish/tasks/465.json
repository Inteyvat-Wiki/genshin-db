			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4650201,
					"content": "Usta Diluc! Az önce Favonius Şövalyeleriyle birlikteydik ve, ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650202,
					"content": "Sanırım Hiçlik Tarikatının savaş ilanını bana söyleyeceksiniz, doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650203,
					"content": "Bunu biliyorum. Ancak bu kadar yol katettiğiniz için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650204
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650204,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650205,
					"content": "Şafak Şaraphanesinin istihbarat ağı, ticari meselelerden daha fazlasıyla ilgilenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650206
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650206,
					"content": "Harika! O halde plan nedir Usta Diluc?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650207,
					"content": "Önerilere açığım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650208,
						4650213
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650208,
					"content": "Şövalyelerle güçlerini birleştirmelisin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650209
					]
				},
				{
					"id": 4650209,
					"content": "Hayır. Bu, doğrudan Hiçlik Tarikatının işine gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650210
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650210,
					"content": "Onlarla pek iyi anlaşamadığımı çok iyi biliyorlar. Bunu, beni açığa çıkmaya zorlamak için kullanıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650211
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650211,
					"content": "Kim olduğum açığa çıkarsa gelecekteki tüm faaliyetlerim Şövalyelerin müdahalelerine maruz kalır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650212
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650212,
					"content": "Neticede hiçbir güçlü kuruluş, dışarıdan birisinin gölgesinde kalmak istemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650217,
					"content": "Uf... Hiçlik Tarikatı bu sefer seni epey zor duruma düşürdü. Ne kadar sinsiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650218,
					"content": "Bir yol var. Ama bunun işe yaraması için biraz bilgiye ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650219,
					"content": "Kesin konuşmak gerekirse Hiçlik Tarikatının savaş ilanındaki şifrelenmiş kısımları çözmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650220,
					"content": "Şifrelenmiş kısımlar mı? Paimon'un okuyamadığı kısımları mı kastediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650221,
					"content": "Sadece Hiçlik Tarikatı üyelerinin anladığı ve kuruluş içinde mesajlaşmak için kullanılan bir şifre olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650222,
						4650223
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650222,
					"content": "Neden sana sadece onların anladığı bir yazılı mesaj göndersinler ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650224,
					"content": "O mesaj, sadece bir savaş ilanı değil, aynı zamanda kendi üyelerine gönderdikleri bir bildirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650225
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650225,
					"content": "Seni bir taraf için kahraman haline getiren bir duruş sergilediğinde, başka bir taraf için de kötü adam olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650226
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650226,
					"content": "Çok uzun zamandır Hiçlik Tarikatının düşmanı olduğumdan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650227
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650227,
					"content": "Beni, birliklerini toplayabilecekleri ve güçlerini birleştirebilecekleri bir hedef haline getirdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650228
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650228,
					"content": "Vay canına... Sanırım bir süper kahraman olmak için çok zeki olmak gerekiyor ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650229,
					"content": "Sadece düşmanımı çok iyi anlıyorum, hepsi bu. Ne derler bilirsiniz; kahramanlar ve kötüler, aynı madalyonun iki farklı yüzüdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650230
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650230,
					"content": "O zaman anlaşılmayacak şekilde yazılan istihbaratla ilgili olarak ne yapacağız? Onu nasıl... Anlaşılabilir hale getireceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4650231,
					"content": "Basit. Bir şeyi anlamadığında birisine sorarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650232
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650232,
					"content": "<color=#00E1FFFF>Kalelerinden</color> birinin yerini buldum bile... İlginizi çekiyorsa siz de gelebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650223,
					"content": "Okuyamayacağımızı biliyorlarsa o mesajı neden yazdılar ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650224
					]
				},
				{
					"id": 4650213,
					"content": "Bu olay durulana kadar şaraphanede kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4650214
					]
				},
				{
					"id": 4650214,
					"content": "O zaman da olayı tamamen Şövalyelere bırakmış olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650215
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650215,
					"content": "Bu görevi üstlenmeye layık olsalardı işler zaten bu noktaya gelmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650216
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 4650216,
					"content": "Her halükarda saklanmamı ve bu işin sonuçlarıyla ilgilenmeyi Şövalyelere bırakmamı gerektirecek kadar kötü durumda değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4650217
					],
					"speakerTitle": "Diluc"
				}
			]
		},
