				"points": []
			},
			"dialogs": [
				{
					"id": 728060401,
					"content": "Hımm. Burası gerçekten güzel yazılmış. Gelişme de çok orijinal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060402
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060402,
					"content": "Xingqiu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060403
					]
				},
				{
					"id": 728060403,
					"content": "Demek böyle oluyor. İlginç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060404
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060404,
					"content": "Xingqiu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060405
					]
				},
				{
					"id": 728060405,
					"content": "#Ha, sen miydin {NICKNAME}? Uzun zaman oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060406
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060406,
					"content": "Bana selam verişine bakılırsa iyi duruyorsun. Güzel. Bugün seni hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060407
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060407,
					"content": "Aslında bizim için birini bulabilir misiniz diye sormaya geldik. Çok kitap okumuşsunuzdur. Muhtemelen bilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060408,
					"content": "Birini mi? Yazar mı arıyorsunuz yoksa? Tabii, buyurun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060409
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060409,
					"content": "\"Zhenyu\" adında birini arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060410
					]
				},
				{
					"id": 728060410,
					"content": "Zhenyu mu? Adını nereden duydunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060411
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060411,
					"content": "Bu \"Bir Kılıç Efsanesi\" nüshasının üstünde yazıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060412
					]
				},
				{
					"id": 728060412,
					"content": "Inazuma'da Yae Yayınevinden biri kendisine mektup vermemizi istediği için Zhenyu'yu arıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060413,
					"content": "Zhenyu'yu tanıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060414,
					"content": "O Zhenyu var ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060415
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060415,
					"content": "Söylemeye utanıyorum ama o benim takma adım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060416
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060416,
					"content": "Ay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 728060417,
					"content": "Hiç beklemiyorduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060418
					]
				},
				{
					"id": 728060418,
					"content": "Zaten bahsetmeye de değmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060419
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060419,
					"content": "Başlarda Liyue'de bu kitapla ilgilenen editör bana temanın çok yabancı ve hikayenin şaşırtıcı şekilde klişelerle dolu olduğunu söyledi. \"Bunu kimse beğenmez,\" diyerek taslağımı reddetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060420
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060420,
					"content": "Öylece pes etmek istemedim. O yüzden beğenen olur mu diye bakmak için birkaç tane bastırıp el altından Wanwen Kitabevine teslim ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060421
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060421,
					"content": "Çok az kişi okuyordu. Öyle olunca işin peşini bıraktım. Inazuma'da bu kadar popüler olacağını hiç düşünmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060422
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060422,
					"content": "Yine de insanların yazdıklarımı okumak istemesinden gayet memnunum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060423
					],
					"speakerTitle": "Xingqiu"
				},
				{
					"id": 728060423,
					"content": "Bu mektubu dikkatlice okuyacağım Gezgin. Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xingqiu"
				}
			]
		},
