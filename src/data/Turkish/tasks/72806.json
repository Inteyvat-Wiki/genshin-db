			"dialogs": [
				{
					"id": 728060201,
					"content": "Seni bugün evime hangi rüzgar attı Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 728060202,
					"content": "Yae Yayınevinden mektup ve hediye getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "Yae Yayınevinden mektup mu getirdin? Yine takma adımı değiştirmemi istemiyorlar değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 728060204,
					"content": "Kaç kere söyledim. Gerçek adımla yazacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 728060205,
					"content": "*iç çeker* Neyse. Bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 728060206,
					"content": "Bir roman yazma yarışmasında jürilik yapmamı istiyorlar. Hımm. Müsait olamam muhtemelen, yine de teşekkür etsem iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 728060207,
					"content": "Ne? Bunlar ne? \"Yaratıcı öneriler\" mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "Dokuzuncu Chang"
				},
				{
					"id": 728060208,
					"content": "Bunları biraz daha dikkatli okumam lazım. Teşekkür ederim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dokuzuncu Chang"
				}
			]
		},
		{
			"id": 7280604,
			"completionStepIds": [
				7280604
			],
