				},
				{
					"id": 728060502,
					"content": "Evet. Mektupları verdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060503
					]
				},
				{
					"id": 728060503,
					"content": "Harika! Ne dediler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060504
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060504,
					"content": "İkisi de mektupları dikkatlice okuyacaklarını söyledi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060505
					]
				},
				{
					"id": 728060505,
					"content": "Güzel. *iç çeker* İkisinin de ta Liyue'de olması üzücü. Her şey normal olduğu zaman bile istediğimizde ziyaretlerine gidemedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060506
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060506,
					"content": "Özellikle de Bay Zhenyu'ya. \"Bir Kılıç Efsanesi\" kitabını bile kendisi vermedi. Bir tüccar getirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060507
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060507,
					"content": "Sonra editörlerimizden biri kitabı okudu ve ne kadar değerli olduğunu görünce bizzat Liyue'ye gidip daha fazla taslak yazılması için işe koyuldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060508
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060508,
					"content": "Durumumuz böyle olunca insanları Liyue'ye davet eden mektupların hiçbirinin gelmeyeceğini nereden bilebilirdik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060509
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060509,
					"content": "Elimizden gelen tek şey önce kitapları yayınlayıp Bay Zhenyu'ya verilecek payın hesabını tutmaktı. İletişime geçtikten sonra ücreti gönderecektik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060510
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060510,
					"content": "Çıkalı uzun zaman oldu ama \"Bir Kılıç Efsanesi\" hâlâ en çok satanlar arasında. Yazarın telif hakkı ücreti de birikti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060511
					],
					"speakerTitle": "Aratani"
				},
				{
					"id": 728060511,
					"content": "*iç çeker* Keşke Bay Zhenyu bu yarışmaya gelebilseydi. Bu telif hakkı ücretleri böyle birikmeye devam ederse iyi olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aratani"
				}
			]
		},
