				"points": []
			},
			"dialogs": [
				{
					"id": 20040101,
					"content": "Bakalım... Ayaka'nın bize söylediği kişi neredeymiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040102,
					"content": "Bunu neden yapıyorsun? Bunca yıldan sonra neden bir anda ayrılıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040103
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040103,
					"content": "Kesinlikle çok ani oldu. Hazırlanacak vaktimiz olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040104
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040104,
					"content": "Çocuklar, oyun oynamak için kendilerini dışarı çıkarmanı bekliyorlar. Lütfen, yeniden düşünmen için ısrar ediyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040105
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040105,
					"content": "Bu, Ayaka'nın bize bahsettiği kişi olmalı. Haydi gidip bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200402,
			"completionStepIds": [
				200402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200402",
							"2"
						],
						"stepId": 200402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040201,
					"content": "Tamam, bu Tejima'nın günlüğüne benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040202,
					"content": "Bakalım, burada neler varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040203,
					"content": "\"Bugün, köy halkı ve ben, Kızarmış Tuzlu Balık yapmak için toplandık. Benimki kötü oldu ve biraz da yandı, bu yüzden aslında Kara Yılanbaşı pişirdim diye yalan söyledim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040204,
					"content": "\"Bugün suya düşen bir çocuğun kurtarılmasına yardım ettim. Onu sudan çektikten sonra bana, en iyi arkadaşı Banbu'nun hâlâ suda olduğunu söyledi. Öğleden sonraki tüm vaktimi suda onun arkadaşını aramakla geçirdim. Meğerse Banbu, onun beslediği yengecin adıymış.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040205,
					"content": "\"Bugün uçurtma uçurmaya gittim. İp koptu, bu yüzden arkasından olabildiğince hızla koştum. Kısa sürede onu asla yakalayamayacağımı fark ettim, oturacak bir yer bulup ufukta kaybolmasını izledim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040206,
					"content": "Hımm... Gündelik köy hayatıyla ilgili sıradan bir günlüğe benziyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040207,
					"content": "Hı? Bekle, dahası var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040208,
					"content": "\"Bugün dua etmek için tekrar tapınağa gittim ve bir süre orada kaldım. Bana verdiğin omamori tılsımı biraz solmuş ama yine de en değerli eşyam o benim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040209,
					"content": "İşte, tam aradığımız türden bir bilgi! Tapınağı ziyaret etme zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200403,
			"completionStepIds": [
				200403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
