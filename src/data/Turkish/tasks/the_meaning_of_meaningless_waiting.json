			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mahiru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040601,
					"content": "Ah... Sen de Tejima'yı burada kalmaya ikna etmek için gelmiş olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040602
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040602,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040603
					]
				},
				{
					"id": 20040603,
					"content": "30 yıl önce buraya gelen Tejima, o zamandan beri burayı koruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040604
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040604,
					"content": "Hazine Avcılarını uzak tutmak, yaklaşan canavarları defetmek, köylüler arasındaki tartışmaları çözmek... Burasıyla ilgilenmek adına yoğun bir çaba sarf etti ve hepimiz ona hayranlık duyuyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040605
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040605,
					"content": "Ama şimdi ise birden bizi terk etmek istediğini söylüyor. Merak etmeden duramıyoruz, acaba yanlış bir şey mi yaptık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040606
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040606,
					"content": "Eğer yaptıysak hiç düşünmeden özür dileriz. Tek isteğimiz onun kalması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
		{
			"id": 200407,
			"completionStepIds": [
				200407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200407",
							"2"
						],
