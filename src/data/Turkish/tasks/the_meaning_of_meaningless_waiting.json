			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040301,
					"content": "Demek Tejima'nın yazdığı omamori tılsımı bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040302,
					"content": "İlginç. Rengine ve tasarımına bakınca Paimon, bunun bir çocuğa ait olduğunu düşünürdü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040303,
					"content": "Bunu her zaman yanında taşıdıysa, o zaman element enerjisinin bir kısmı tılsımda kalmış olabilir. Sence yararlı olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200404,
			"completionStepIds": [
				200404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200404",
							"2"
						],
						"stepId": 200404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040401,
					"content": "İşte geldik! Burası Tejima'nın çok fazla ziyaret ettiği bir yere benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040402,
					"content": "Toprakla oynanmış gibi duruyor... Belki Tejima, buraya değerli bir şey gömmüştür. Kendisini bunca yıl köyde tutan bir şey olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040403,
					"content": "30 yıl burada kalmasını sağladıysa, gerçekten harika bir şey olmalı. O zaman kazıp bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040404,
					"content": "Bir... Mektuba benziyor, değil mi? Kağıt sararmış, çok uzun zaman önce yazılmış olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040405,
					"content": "\"Konda Köyü\"... Adı tanıdık geliyor, nerede bu yer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040406,
					"content": "Tam da burası işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040407
					]
				},
				{
					"id": 20040407,
					"content": "Hı? O zaman Tejima'nın geri dönmesinin nedeni, birini beklemek için miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040408,
					"content": "Ama 30 yıldır burada... Ah, sanırım beklediği kişi gelmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040409,
					"content": "O halde, gidip Tejima'ya eşyalarını geri verelim ve gerçeği öğrenelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200405,
			"completionStepIds": [
				200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200405",
							"2"
						],
						"stepId": 200405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tejima",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040501,
					"content": "Açıkçası, bu... Bu kesinlikle benim el yazım ve sanırım, omamori tılsımı da mektup da bana ait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040502
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040502,
					"content": "Ama bu günlükte yazılan hiçbir şeyi hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040503
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040503,
					"content": "Ama yine de... Burada birini beklediğim ve 30 yıl boyunca beklemeyi seçtiğim gayet açık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040504
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040504,
					"content": "Yıllar boyunca bana ilginç gelen şeyleri not etmiş olmalıyım. Eninde sonunda yeniden bir araya gelebildiğimizde onunla paylaşabileceğim her bir şeyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040505
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040505,
					"content": "Yıllar içinde olan tüm bu şeylere bakın... Zaman ne kadar da hızlı geçiyor. 30 yıl, göz açıp kapayana kadar geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040506
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040506,
					"content": "Benim için bu kadar önemli olan bir şeyi nasıl unutabilirim? Hımm... Şimdi düşündüm de, Önsezilerim benden alındığında sanki bir anda... İçimde bir boşluk oluşmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040507
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040507,
					"content": "Aşk, pişmanlık... Ona karşı hissettiğim her şey yok oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040508
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040508,
					"content": "Bu seni üzüyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040509
					]
				},
				{
					"id": 20040509,
					"content": "Hayır... Üzmüyor aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040510
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040510,
					"content": "Ne de olsa onun kim olduğunu unuttum. Yüzü, sesi, birlikte yaşadığımız şeyler... Neredeyse hiçbirini hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040511
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040511,
					"content": "Sanki başından beri hayatımda hiç olmamış gibi... Sanki tüm bu yıllar bulanık bir rüyadan başka bir şey değilmiş gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040513
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040513,
					"content": "Yani hâlâ gitmeyi planlıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040514
					]
				},
				{
					"id": 20040514,
					"content": "Şey... Sanırım... Hayır! Bu, hayatımın büyük bir kısmında beklediğim bir şeyse, sanırım beklemeye devam edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040516
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040516,
					"content": "Ama yine de onunla karşılaşırsam, onun adını bile zar zor hatırladığımı görecek. Bu onun için üzücü olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040517
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040517,
					"content": "Böyle düşündüğümde... Yüreğimde bir parça hüzün hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040518
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040518,
					"content": "Merak ediyorum. Onun kim olduğunu bile hatırlamazken, acaba neden böyle düşünüyorum? Sanki bir boşluk hissi, birinin eksikliğinin getirdiği his...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040519
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040519,
					"content": "*iç çeker* Burada neden kalmam gerektiğini hatırlamama yardım ettiğiniz için ikinize de teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040520
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040520,
					"content": "Burada kalıp onu beklemeye devam edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040522
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040522,
					"content": "Tejima uğraşıyor gibi görünüyor. Tamam ama yine de... Paimon çok üzülüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040523,
						20040524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040523,
					"content": "Evet, beni de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				},
				{
					"id": 20040525,
					"content": "Sanırım tıpkı Ayaka'nın ve Thoma'nın dediği gibi Önsezini kaybedersen, tüm umutlarını ve hayallerini de kaybedersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040526,
					"content": "Bu da en başta Tejima'nın içinde bulunduğu durumu açıklıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040527,
					"content": "En azından ona yardım etmeyi başardık, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040528,
					"content": "*iç çeker* ... Şey, gidip bir sonraki kişiyi bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040524,
					"content": "Üzgün hissetme nedenini kaybetmek, belki de en üzücü şey olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040525
					]
				}
			]
		},
		{
			"id": 200406,
			"completionStepIds": [
				200406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
