						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kenjirou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040701,
					"content": "*iç çeker* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040702
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040702,
					"content": "Öyleyse bu değişimin sebebi ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040703
					]
				},
				{
					"id": 20040703,
					"content": "Fikrimi soracak olursan bunun, Önsezi Avı Fermanıyla bir ilgisi olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040704
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040704,
					"content": "Tejima'nın yanlış bir şey yapmadığı çok açık. Ve yine de Önsezisine el koydular. Sonrasında tamamen farklı biri oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040705
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040705,
					"content": "Bunu tam olarak anladığımı iddia edemem ama kendisi için çok önemli olan bir şeyi kaybettiğini söyleyebilirim. Birkaç kez tek başına yürüyüşe çıktı, kasabayı turladı ve sonra aniden, gideceğini ve bir gezgin olacağını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040706
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040706,
					"content": "Aslında onu burada tutmaya çalışmanın doğru olup olmadığından emin değiliz. Ama aynı şekilde... Bu durumdayken onun gitmesine izin vermek de doğru gelmiyor. Tam bir amaçsız gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040707
					],
					"speakerTitle": "Kenjirou"
				},
				{
					"id": 20040707,
					"content": "Buralarda saygı duyulan birine benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200408,
			"completionStepIds": [
				200408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
