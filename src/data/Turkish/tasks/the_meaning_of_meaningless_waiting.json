			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Tejima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20040801,
					"content": "Sen Tejima olmalısın. Peki, birdenbire kalkıp gitmek istemenin nedeni nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040802,
					"content": "Ben mi? Neden gitmek istediğim önemli değil... Önemli olan neden burada kalmam gerektiği...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040803
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040803,
					"content": "Çok uzun bir süredir burada yaşıyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040804
					]
				},
				{
					"id": 20040804,
					"content": "Herkes sana güveniyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20040805
					]
				},
				{
					"id": 20040805,
					"content": "Doğru... Ama burada kalmayı seçmemin sebebi bu değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040806
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040806,
					"content": "... Ve 30 sene önce buraya gelmek istememin sebebi neydi? Ve neden bunca süre hiç gitmek istemedim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040807
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040807,
					"content": "*iç çeker* Bu sorulara verecek cevabım yok çünkü cevaplarını hatırlayamıyorum. Önsezimi benden aldıklarından beri sanki... Hafızamdan bir parça gitmiş gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040808
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040808,
					"content": "Eskiden burada kalmak istediğimi biliyordum... Ama o günkü kararım her neyse artık yok. Ben de şöyle düşündüm, beni gezinmekten alıkoyan şey ne? İçimdeki boşluk her iki durumda da olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040809
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040809,
					"content": "Tamam... Öyleyse kalma nedenini yeniden bulmana yardım edersek artık gitmene gerek kalmayacak, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040810,
					"content": "Hım... Ama hiçbir şey hatırlayamazsan, bu pek de kolay olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040811,
					"content": "Ah! Hatırlamak için biraz çaba gösterebilirsen... Anıların belki de tekrar canlanabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040812,
					"content": "Aaa, bu bana şeyi hatırlattı... Tejima'ya en son meyve getirdiğimde sanırım onu günlük yazarken görmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040813
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040813,
					"content": "... Ben günlük mü tutuyormuşum? Gerçekten, hiç hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040814
					],
					"speakerTitle": "Tejima"
				},
				{
					"id": 20040814,
					"content": "Evet, evet, tutuyorsun! Üstelik daha sonraki bir tarihte daha fazla önem kazanacak olan birkaç ilginç şeyi not edeceğini söylediğini de hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040815
					],
					"speakerTitle": "Mahiru"
				},
				{
					"id": 20040815,
					"content": "Mükemmel! Tejima'nın gitmesini engellemek istiyorsak eğer, onun günlüğünü bulmalıyız. Burada bir yerlerde olmalı. Hadi bir bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20040816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20040816,
					"content": "Senin için sorun değilse, günlüğü arama işini sana bırakacağız. Bizim, Tejima'nın durumu hakkında diğerlerini de bilgilendirmek için kasabaya geri dönmemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mahiru"
				}
			]
		},
