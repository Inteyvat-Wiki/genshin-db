			"dialogs": [
				{
					"id": 223030301,
					"content": "Başta biraz deneme yanılma yapıp Karahindibaları, Liyue tarzı şarap yapımı sürecine dahil edebilir miyim diye bakacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030302
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030302,
					"content": "Ha bu arada, bu senin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030303
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030303,
					"content": "İlk seferde tutturabilmeyi beklemiyorum. Muhtemelen birden çok deneme yapmam gerekiyor. Karahindibalarım biterse, biraz daha getirmen için sana ihtiyacım olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				}
			]
		}
