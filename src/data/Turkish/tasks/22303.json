			},
			"dialogs": [
				{
					"id": 223030101,
					"content": "İşler neredeyse durma noktasına geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030102
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030103
					]
				},
				{
					"id": 223030103,
					"content": "Handaki işlerimin gitgide zorlaştığından bahsediyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030104
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030104,
					"content": "Yiyecek ve içecek işinde uzun süredir var olmak, bizim için hem iyi hem de kötü oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030105
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030105,
					"content": "İyi kısmı, uzun süredir işin içinde olduğun için itibarının artması; böylece daha fazla iş geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030106
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030106,
					"content": "Kötü kısmı ise insanlar sürekli aynı şeyleri yemekten bir noktada sıkılıyor. Ürün çeşidi fazla olan büyük restoranlarda bu bir sorun değil tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030107
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030107,
					"content": "Ancak benim işlettiğim han da küçük bir işletme sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030108
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030108,
					"content": "Uzun zamandır gelen düzenli müşterilerim artık içeceklerden sıkılmaya başladı. Birer birer kaçıyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030109
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030109,
					"content": "Mondstadt'ta büyük bir şarap piyasası olduğunu duydum. Karahindiba ile yapılan meşhur bir Karahindiba Şarabı varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030110
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030110,
					"content": "Ama ben Karahindiba ile şarap yapmanın mümkün olup olmadığını bile bilmiyorum... En azından denemek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030111
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030111,
					"content": "Mondstadt'a gidip bana biraz Karahindiba getirir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030112,
						223030114
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030112,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030113
					]
				},
				{
					"id": 223030113,
					"content": "Harika! Söz veriyorum emeklerin için ödeme yapacağım. Liyue'de söz senettir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030114,
					"content": "Karahindiba şarabı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223030115
					]
				},
				{
					"id": 223030115,
					"content": "Tadının tuhaf olduğunu mu düşünüyorsun? Olabilir ama Mondstadt'ta çok popüler olduğunu duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030116
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030116,
					"content": "Gerçi tarifi bire bir kopyalamak da olmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223030117
					],
					"speakerTitle": "Degui"
				},
				{
					"id": 223030117,
					"content": "Her neyse, sen önce bana <color=#00E1FFFF>Karahindiba</color> getir bakalım. Ben de o sırada, yapım aşamasında şaraba nasıl bir Liyue dokunuşu ekleyeceğimi düşüneyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Degui"
				}
			]
		},
