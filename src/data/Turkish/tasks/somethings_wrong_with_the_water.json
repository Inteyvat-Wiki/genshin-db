			},
			"dialogs": [
				{
					"id": 747130101,
					"content": "#{NICKNAME}, Paimon, uzun zamandır görüşemiyorduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130102
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130102,
					"content": "Freminet? Neden dalgıç kaskını takıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130103,
					"content": "Sudan yeni mi çıktın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130104
					]
				},
				{
					"id": 747130104,
					"content": "Hı hı... Son zamanlarda aşağıda işler biraz karışık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130105
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130105,
					"content": "Şu anda çok daha fazla dalgıç var, hepsi batık kargoları kurtarma telaşı içinde. Ben de elimden geldiğince yardımcı olmaya çalışıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130106
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130106,
					"content": "Ortalığı ne kadar çabuk toparlarsak etraftaki dalgıçlar da asıl işine gücüne o kadar çabuk döner. Deniz de her zamanki huzuruna ve sessizliğine bir an önce kavuşur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130107
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130107,
					"content": "Doğru diyorsun... Tüm bu telaşa ayak uydurmak senin için hiç kolay olmasa gerek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130108,
					"content": "Endişelendiğin için sağ ol Paimon. Durum o kadar da kötü değil aslında. Hatta fazladan birkaç sahipsiz mücevher ve antika buldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130109
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130109,
					"content": "\"Babam\" güzel veya değerli bir şeyler bulursam onları buraya getirmemi söyledi. Sizin işinize yarayabilirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130110
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130110,
					"content": "Aa. Arlecchino ne kadar düşünceli! Elinde artık kimsenin istemediği güzel görünümlü süs eşyaları varsa onları akvaryumu süslemek için kullanabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130111,
					"content": "Hatta daha da iyisi, biz de seninle keşfe gelsek ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130112,
					"content": "Emin misiniz? Değerli vaktinizi boşa harcamak istemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130113
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130113,
					"content": "Sen orasını hiç dert etme! Zaten bulduğun sahipsiz ganimetlerin bizde kalabileceğini söylemiştin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130114,
					"content": "Bütün işi tek başına yapmana izin veremeyiz. Biz burada boş boş otururken başkasının emeğinin meyvelerini yemek Paimon'un hiç içine sinmiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130115,
						747130116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130115,
					"content": "Hem eşyaları kendin bulmak işin asıl eğlencesi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				},
				{
					"id": 747130117,
					"content": "O zaman... Diğer dalgıçların bana anlattıklarını sizinle paylaşayım. Umarım aramanızı kolaylaştırır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130118
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130118,
					"content": "Hoşunuza giden bir şey bulursanız dilediğiniz gibi kullanabilirsiniz... Yalnız bazı eşyaları sahipleri geri istiyor, onlardan birini bulursanız sahibine iade etmeniz gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130119
					],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130119,
					"content": "Anlaşıldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747130120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747130120,
					"content": "Lütfen dikkatli olun ve bilmediğiniz sulara açılmayın. Olur da başınız derde girerse şartların elverdiği ilk fırsatta hemen yüzeye çıkın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Freminet"
				},
				{
					"id": 747130116,
					"content": "Biz de su altında hazine aramayı seviyoruz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747130117
					]
				}
			]
		}
	]
}