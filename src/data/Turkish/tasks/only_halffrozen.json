			"dialogs": [
				{
					"id": 205200401,
					"content": "Ah... Çok iyi geldi. Teşekkür ederim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200402
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200402,
					"content": "Seni buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200403
					]
				},
				{
					"id": 205200403,
					"content": "*iç çeker* Görev demek, başka ne olacaktı ki? Bunca zamandır ben de alengirli bir görev için kamptaydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200404
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200404,
					"content": "Ama orada çürümek de istemedim, bu sebeple yapacak başka bir şey aramaya başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200405
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200405,
					"content": "Şef Harris dağda Dondurulmuş Et arayacak birini istiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200406
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200406,
					"content": "Küçük, donmuş bir yaban domuzu bulmamı istedi. Dağa çok tırmanmama da gerek yokmuş, yani çok tehlikeli bir görev olmayacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200407
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200407,
					"content": "Dolambaçsız bir görev olduğunu düşünüp kabul ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200408
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200408,
					"content": "Kendimi de hazırlamaya başladım, hatta kendimi Ejdersırtı iklimine yavaş yavaş alıştırmaya bile başlamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200409
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200409,
					"content": "Hepsi de o simyager kadının verdiği görevi tamamlayabilmek içindi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200410
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200410,
					"content": "Ama dağa çıkmaya başladıktan hemen sonra yolumu kaybedeceğimi düşünmüyordum ben de. Neredeyse donuyordum, neyse ki sen çıkageldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200411
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200411,
					"content": "Tek pişmanlığım... Görevimi tamamlayamamış olmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200412
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200412,
					"content": "Gezgin... Bu dağa hakim birine benziyorsun. Senden bir iyilik isteyebilir miyim acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200413
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200413,
					"content": "Bir porsiyon Dondurulmuş Et bulmanı isteyeceğim sadece. Bir porsiyon yeterli, görevim için gereken o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200414
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200414,
					"content": "Bana güvenebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205200415
					]
				},
				{
					"id": 205200415,
					"content": "Sağ ol. Öyleyse Harris'in küçük, donmuş yaban domuzu bulabileceğimizi söylediği yerleri haritanda işaretleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200416
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200416,
					"content": "Dağın eteklerindeki kampa gidiyorum ben, haberlerini bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
		},
