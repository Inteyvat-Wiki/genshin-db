					"nextDialogs": [
						205200503
					]
				},
				{
					"id": 205200503,
					"content": "Harika! Demek Dondurulmuş Et böyle bir şey. Normal etten bir farkı yok. Dokununca soğuk olmasını saymazsak tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200504
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200504,
					"content": "Görevi tamamlayayım da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200505
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200505,
					"content": "Sağ ol Gezgin. Sen olmasan halim fenaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205200506
					],
					"speakerTitle": "Tommy"
				},
				{
					"id": 205200506,
					"content": "İşte, karşılığında bunu al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tommy"
				}
			]
