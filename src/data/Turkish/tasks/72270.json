			"dialogs": [
				{
					"id": 722700101,
					"content": "Ben Jibashirilerden Daimon. Sangonomiya'nın Kahramanı, bu mücadeleye girmeyi hak ettiğini kabul ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700102
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700102,
					"content": "Cesaret, hangi yöntemi kullanırsan kullan tüm düşmanlarını yenmeni sağlayan kuvvettir. Buradaki tüm düşmanları yendiğinde ve Yüksek Geçidin Alevlerini serbest bıraktığında geçmene izin verilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700103
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700103,
					"content": "Tüm bu düşmanların Güneş Alevi Tayflarından ve yüreğindeki büyük düşmanlardan doğan birer yanılsama olduğunu bilmelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700104
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700104,
					"content": "Yine de dikkatli olmazsan yenileceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700105
					],
					"speakerTitle": "Daimon"
				},
				{
					"id": 722700105,
					"content": "Mücadeleyi bitirmeni yukarıdaki Üç Diyarın Kulesinde bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daimon"
				}
			]
		},
