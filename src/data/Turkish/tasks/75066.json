			},
			"dialogs": [
				{
					"id": 750660301,
					"content": "Neden hâlâ buradasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660302
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660302,
					"content": "Macera takımımızın lideri, yani şahin maskesi takan kahraman... Çoktan... Onlara karşı daha fazla direnemeyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660303
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660303,
					"content": "Bir an önce gitmelisin. Burası lanetlendi cesur savaşçı. Artık insanların kalabileceği bir yer değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
		{
