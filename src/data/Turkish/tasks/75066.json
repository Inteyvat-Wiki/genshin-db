			},
			"dialogs": [
				{
					"id": 750660201,
					"content": "Of, burası gerçekten lanetli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660202
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660202,
					"content": "Burada fazla oyalanma. Bir an önce çıkıp git... Karanlık dalga gelmeden buradan ayrılmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660203
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660203,
					"content": "Evet, karanlık dalga. O devasa gölgesi çok yakında üstümüze çökecek. Herkesin... Herkesin güvenliğini sağlamalıyız. Herkes... Güvenli bir şekilde tahliye edilmeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		},
