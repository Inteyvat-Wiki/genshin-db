				]
			},
			"dialogs": [
				{
					"id": 750660501,
					"content": "Derhal gitmelisin. Daha fazla durursan çok geç olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660502
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660502,
					"content": "Neden çok geç olacak diye soruyor olabilirsin. Çünkü... Çünkü tüm macera takımımızın kökünü kuruttular. O devasa, karanlık canavar... Hepsini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660503
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660503,
					"content": "Tahliye edilecek insanları korumamı istediler, en azından şehirden ayrılmalarını sağlamalıydım. Şu anda Çiçek Tüyü Klanından bir kurtarma ekibi yola çıktı bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660504
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660504,
					"content": "Buradan kurtulanların karaya dönüp bir kez daha gün ışığını görebilmeleri için bu kötü canavarları ortadan kaldırmalıyım... Ha, ama... Niye buradayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660505
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660505,
					"content": "Kulaklarımdaki bu ses... Ah, giderek yükseliyor. Şelale... Şelaleye dönmeliyim. Evet... Şelaleye geri dönmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750660506
					],
					"speakerTitle": "Quenin"
				},
				{
					"id": 750660506,
					"content": "Cesur savaşçı, sen de... Bir an önce gitmelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Quenin"
				}
			]
		}
	]
