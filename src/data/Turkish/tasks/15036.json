					}
				]
			},
			"dialogs": [
				{
					"id": 150360201,
					"content": "Aa... Burası çıkmaz yol galiba. Saklandığı yere ulaşabildik mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360202,
					"content": "Off, bu sis yüzünden hiçbir şey göremiyoruz ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360203,
					"content": "#Burası saldırıya uğradığın yer olmalı {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360204
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360204,
					"content": "Ruhunun kayıp parçası buralarda bir yerde olmalı. Nerede olduğunu hissedebiliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360205
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360205,
					"content": "(Gözlerimi kapatıp yaramdan yayılan ışığa odaklandığımda... Bir şeyin varlığını ve yakında olduğunu sezebiliyorum. Ama yerini tam olarak kestiremiyorum.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360206,
						150360207
					]
				},
				{
					"id": 150360206,
					"content": "Tam olarak değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				},
				{
					"id": 150360208,
					"content": "Hımm. Düşmanımız işini sağlama alıp izlerini saklamış olmalı. Hissinin çok daha güçlü olması gerekirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360209
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360209,
					"content": "Hey, şuna bakın! Dikenler geri geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360210,
					"content": "Sakin olun. Kendimizi biraz geriye çekelim, düşmanımıza esneklik tanıyalım ki neyle karşı karşıya olduğumuzu bilelim. Çok pervasız davranırsak tuzağına düşebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360211
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360211,
					"content": "Senin ruhunun bir parçasını çalmasının bir sebebi olmalı. Onu bir şekilde saldırılarıyla bütünleştirmiş olma ihtimali çok yüksek. Yeterince dikkatli hareket edersek izini sürebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360207,
					"content": "Ama yakınlarda olduğunu hissediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360208
					]
				}
			]
		},
