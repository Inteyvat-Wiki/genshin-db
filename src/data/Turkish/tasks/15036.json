			"dialogs": [
				{
					"id": 150360301,
					"content": "#Aa, {NICKNAME}, Skirk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360302,
					"content": "Ne oldu öyle? Sanki Skirk bir anda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360304
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360304,
					"content": "Guili Ovası'ndayken bu düşmanın neden seni hedef almış olabileceğini sormuştun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360305
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360305,
					"content": "Cevabı belli oldu. Sebebi yalnızca güçlü olman değil. Aynı zamanda senin deyiminle Hiçlik gücünü \"arındırabilmen\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360306
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360306,
					"content": "Bu gücün gerçekte ne olduğunu bilmiyorum, tek bildiğim düşmanın imkansız bir şeyi gerçekleştirmesine olanak sağladığı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360307
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360307,
					"content": "Savunmamı aştı ve gücümü çaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360308,
						150360309
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360308,
					"content": "Yani asıl hedefi sen miydin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				},
				{
					"id": 150360310,
					"content": "Hayır, zindanına geleceğimi tahmin edemezdi. Gücünün değerini bildiği için ruhunu çaldı. Bu kadar çabuk işine yaramasını kendisi bile beklememiştir muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360311
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360311,
					"content": "Belki de \"kader\"dir. Sanırım bu dünyada böyle sebepsiz rastlantıları tanımlamak için bu terimi kullanıyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360312
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360312,
					"content": "Her halükarda işimize yaradı. Gücünü ne için kullandığını anladığım anda kaybettiğin şeyi geri alma şansımız doğdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360313
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360313,
					"content": "Peki ya sen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360314
					]
				},
				{
					"id": 150360314,
					"content": "Bana bir şey olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360315
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360315,
					"content": "Ee, bitti mi tıkınman? Güzel. Şimdi sorularıma cevap ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360316
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360316,
					"content": "Yıldız Yutan Narvalin gücünü nasıl elde ettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360317
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360317,
					"content": "Yıldız Yutan Narval mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360318,
					"content": "Aaa... Tabii ya! O sivri şey Paimon'a tanıdık gelmişti! Narvalin boynuzuna benziyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360319,
					"content": "Bu gücü kendi çabanla elde ettiğini sanmıyorum. Yanılıyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360320
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360320,
					"content": "Toprağın her bir karışını tanrı kalıntıları ve güç kırıntıları bulmak için talan edecek kadar acizsin. Bu bile başlı başına öyle bir yaratığı yenemeyeceğinin kanıtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360321
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360321,
					"content": "Geriye tek bir ihtimal kalıyor. Ustam \"Kötülük\" Surtalogi'yi tanıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360322
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360322,
					"content": "\"Kötülük\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360323
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360323,
					"content": "Ona \"kötülük\" demeye kim cüret edebilir? Surtalogi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360324
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360324,
					"content": "Surta... logi...!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360325
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360325,
					"content": "Ne oldu, toplamaya çalıştığın güç boyunu mu aştı? İki kelimeyi bir araya getirmekten bile acizsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360326
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360326,
					"content": "Birazcık daha. Ben hâlâ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360327
					],
					"speakerTitle": "Skofnungr"
				},
				{
					"id": 150360327,
					"content": "Bakın! Geri geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360328,
					"content": "Gücü saplantı haline getirenler, onun peşinden koşmayı bırakmaktansa kendilerini yiyip bitirmesine razı olurlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360329
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360329,
					"content": "Peki şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360330
					]
				},
				{
					"id": 150360330,
					"content": "Sakin kalıp mantığımızı kullanarak en iyi hamlede karar kılacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360331
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360331,
					"content": "(Skirk ruhumu geri almaya çalışırken dikenlerden biri ona isabet etti ve bundan ötürü gücünün bir kısmı çalındı.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360332
					]
				},
				{
					"id": 150360332,
					"content": "(Suçlu sisin ardında bir yerde saklanıyor. Az önceki savaşta saldırı tarzına gözüm alıştı. Hemen peşine düşersek kazanma şansımız çok yüksek.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360333
					]
				},
				{
					"id": 150360333,
					"content": "(Ama Skirk'ün nefes alışı normalden daha zayıf. Şimdi saldırırsak onun veya Paimon'un güvenliğini sağlayamayabilirim. Zor bir karar ama...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360334
					]
				},
				{
					"id": 150360334,
					"content": "Bence buradan çıksak iyi olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360335
					]
				},
				{
					"id": 150360335,
					"content": "Akıllıca bir seçim. Mutlak zafer, her zaman tek savaşta elde edilemeyebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360336
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360336,
					"content": "Ruhunun parçasını geri aldın, ikimiz de istediğimizi elde ettik. Bırakalım da düşmanımız biraz soluklansın, zaten bunlar son nefesleri olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360337
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360337,
					"content": "#Bizi buradan çıkar {NICKNAME}. Bu sefer önden senin gitmen gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360309,
					"content": "Başından beri seni mi hedefliyordu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360310
					]
				}
			]
		},
