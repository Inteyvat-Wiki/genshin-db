			"dialogs": [
				{
					"id": 150360101,
					"content": "Bir saniye... Şu an Kanyon'un yakınlarında mıyız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360102,
					"content": "Evet. Buradan girersek rüyandaki yere ulaşabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360103
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360103,
					"content": "Hiçlik zindanlarına biraz aşinasın ama burası başkasına ait bir bölge, o yüzden dikkatli olmanda fayda var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360104
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360104,
					"content": "İçin rahat olsun! Paimon birilerinin arkasına saklanmada uzmandır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360105,
					"content": "#Iıı, şey... O zaman asıl senin dikkatli olman gerekecek {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360106,
						150360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360106,
					"content": "İçin rahat olsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				},
				{
					"id": 150360108,
					"content": "Pekala. Eğitimini aklından çıkarma. Öğrendiklerini kullanmanın zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360107,
					"content": "Şu hırsıza haddini bildirelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360108
					]
				}
			]
		},
