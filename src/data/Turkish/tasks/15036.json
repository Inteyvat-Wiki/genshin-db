			"dialogs": [
				{
					"id": 150365101,
					"content": "#Çok daha iyi görünüyorsun {NICKNAME}. Sağlık sorunların çözüldü mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365102
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365102,
					"content": "Hım, durumun biraz karışıktı. Sevinmek için henüz erken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365103
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365103,
					"content": "Doğru diyorsun Changsheng. Durumunu biraz daha gözlemlemekte fayda var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365104
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365104,
					"content": "Son zamanlarda çok fazla hastamız olmadı, o yüzden boş odamız var. İstersen birkaç gün daha kalabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365105
					],
					"speakerTitle": "Baizhu"
				},
				{
					"id": 150365105,
					"content": "Süper olur! Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
