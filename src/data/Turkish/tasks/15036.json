			},
			"dialogs": [
				{
					"id": 150360501,
					"content": "Of... Burada güvendeyiz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360502,
					"content": "Şu an varlığını hissetmiyorum. Bizi Hiçlik zindanının dışına kadar takip etmiş olamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360503
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360503,
					"content": "Onun gibi zayıf bir mahluk er geç gücümün kolay kontrol edilmeyeceğini fark eder. Gücü tamamen sindirmeden oradan çıkmasının bir yolu yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360504,
						150360505
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360504,
					"content": "Yıldız Yutan Narval...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				},
				{
					"id": 150360506,
					"content": "Şaşırmış gibisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360507
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360507,
					"content": "Anlayabiliyorum gerçi... O balinanın yapabileceklerinin çeyreğini bile görmedin. Devasa ağzıyla bir gezegeni bile komple yutabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360508
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360508,
					"content": "Adının Yıldız Yutan Narval olmasının bir sebebi var. \"Yutmak\" onun en iyi yaptığı şey. İster ölü ister canlı olsun, fiziksel temas kurduğu her şeyin gücünü çalabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360509
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360509,
					"content": "Evet, onunla karşılaştığımızda Neuvillette bize onun dizginlenemeyen bir \"yutma içgüdüsü\"ne sahip olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360510,
					"content": "Ejderha dostunuz, Narvalin becerilerinin doğasını tanıdı ve sizi korumak için Su gücünü kullandı. Bu sadece karnı tok olduğu için işe yarayabildi, o an normalde olduğu kadar agresif değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360511
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360511,
					"content": "Kendisini besleyecek bir güç kalmadığında işler çok değişiyor. Gerçek, açgözlü doğası asıl o zaman açığa çıkıyor. O haldeyken dünya üzerindeki her şeyi yutabilir, bu yüzden onu o boşluğa gönderdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360512
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360512,
					"content": "Ama bu dünyada onun gücünü kullanabilecek biri kalacağını öngörememiştim. Balinayla çok önceden karşılaştığına delalet bu, yani ustamı tanıyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360513
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360513,
					"content": "Evet, \"Kötülük\" ismini duyduğunda çok sinirlendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360514
					]
				},
				{
					"id": 150360514,
					"content": "Aynen öyle. Bilmem gereken her şeyi öğrendim. Bu yüzden ikimiz de istediğimizi elde ettik dedim zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360515
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360515,
					"content": "Alışverişimiz burada sona eriyor sanırım. Ruhun tekrar tam olduğuna göre kendi yolculuğuna dönebilirsin. Durumun geri kalanını ben hallederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360516
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360516,
					"content": "Hayatta olmaz, şimdi gidemeyiz! Bizim yüzümüzden sana ait olan bir şey çalındı! Geri almana yardım etmek zorundayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360517,
					"content": "Bu benim ne ilk başarısızlığım ne de gücümü ilk kaybedişim. Düştüğünde ayağa kalkar ve güçlenirsin, bu işler böyledir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360518
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360518,
					"content": "Ama... Ya sen iyileşmeden canavar seni bulursa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360519,
					"content": "Hem eve nasıl döneceksin? Öyle şıp diye Hiçliğe açılan bir kapı yaratamazsın ki. Gücünün tamamına sahip değilsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360520,
					"content": "Yani şimdilik bizim yanımızda kalmak çok kötü bir fikir değil gibi, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360521,
						150360522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360521,
					"content": "Acıdığımız için demiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360523,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360524
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360524,
					"content": "Haklısın. O zaman bunu alın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360525
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360525,
					"content": "Nedir bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360526,
					"content": "Bir kese Mora. Bu dünyada her şeyin bir bedeli var, o kadarını biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360527
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360527,
					"content": "Planlama işini size bırakıyorum. Nereye gideceğimize çabuk karar verin. Oyalanmamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360522,
					"content": "Sana borçlu kalmak istemeyeceğimi söyledin. Ama gel gör ki borçluyum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360523
					]
				},
				{
					"id": 150360505,
					"content": "Onun gücünü kullanarak senden bile bir şeyler çalmayı başardı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360506
					]
				}
			]
		},
