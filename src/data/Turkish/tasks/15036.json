			"dialogs": [
				{
					"id": 150360601,
					"content": "Aa, Skirk'ün verdiği kesede bir ton Mora var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360602,
					"content": "Çalıştığı bir iş falan mı var acaba? Yok, olamaz. Wanmin Restoranında olanları düşünürsek bu pek mümkün değil. Nasıl olacağını hayal edebiliyor musun? Bak mesela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360603,
					"content": "\"Maaşımı almaya geldim patron.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360604,
					"content": "\"Tabii, buyur! Bir saniye, sen kimsin? Tanışıyor muyuz?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360605,
					"content": "Hım, herkese kendini unutturursan bir işte çalışamazsın ki. Bu kadar Morayı nereden buldu o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360606,
					"content": "Of... Gömülü birkaç hazine buldum, sıkıntı çıkaran birkaç canavarın icabına baktım... Bir bityeniği yok yani. Güvenle kullanabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360607
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360607,
					"content": "Aaaa! Duydun mu sen her şeyi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360608,
					"content": "Böylesine... Tantanalı bir sesi duymamak zor. Hatta dağın tepesinden bile duymuş olsalar şaşırmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360609
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360609,
					"content": "O zaman Paimon'un geçenlerde yaptığı... Şey... Şakayı da duymuş muydun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360610,
					"content": "Bana \"Donuk Eflatun Kavun\" demenden mi bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360611,
						150360612
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360611,
					"content": "Duymuşsun anlaşılan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				},
				{
					"id": 150360613,
					"content": "Yok yok. Paimon yanlış söyledi. Öyle bir şey demedi! Paimon'a... Paimon'a benzeyen biri dedi onu! Of sorma, tam bir baş belası. Sürekli Paimon'u taklit edip insanlara tuhaf tuhaf lakaplar takıyor! Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360614,
					"content": "#... İyi tamam. Doğruyu söylemek gerekirse Paimon başta seni pek sevmemişti, ama artık fikri değişti! {NICKNAME} için çok yardımın dokundu, o yüzden... Ne dersin? Arkadaş olalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360615,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360616
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360616,
					"content": "Burada sadece bir yatak varmış. Hadi biraz dinlenin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360617
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360617,
					"content": "E bir dakika, sen ne yapacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360618
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360618,
					"content": "Ben yorulmuyorum, dinlenmeye ihtiyacım yok. Kılıç antrenmanı yapacağım. Böylece biraz güç toplayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360619
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360619,
					"content": "E ama omzun! Hey! Gitmesene hemen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360620,
					"content": "Öf, neyse. İstediği gibi yorsun kendini. Eninde sonunda geri gelir zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360621
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360621,
					"content": "#Hadi biraz uyuyalım {NICKNAME}! Paimon şu yumuşacık yatağa karşı koyamıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360622,
					"content": "(Skirk inatçı biri. Kendine çok yüklenmemesini söylesem bile dinleyeceğini sanmıyorum.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360623
					]
				},
				{
					"id": 150360623,
					"content": "(Paimon haklı. Skirk yorulduğunda durup dinlenecektir... Umarım dinlenir yani. Şimdi biraz uyusam iyi olur.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360624
					]
				},
				{
					"id": 150360624,
					"content": "*nefes nefese kalır*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360625
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360625,
					"content": "(Skirk?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360626
					]
				},
				{
					"id": 150360626,
					"content": "(Omzundan yaralanmamış gibi davranıyor tabii ki... Hımm, sanki bir tuhaflık var...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360627
					]
				},
				{
					"id": 150360627,
					"content": "*nefes nefese kalır*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360628
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360628,
					"content": "... Sessiz ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360629
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360629,
					"content": "(Kiminle konuşuyor o? Kimse yok ki etrafta. Yoksa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360630
					]
				},
				{
					"id": 150360630,
					"content": "O yangında kaçımızın yok olup gittiğini hatırlıyor musun? Kavrulmuş toprakların üzerinde kaç beden çürümeye bırakıldı? Bir tek sen hayatta kaldın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360631
					],
					"speakerTitle": "Korkmuş Kişi"
				},
				{
					"id": 150360631,
					"content": "Gözünü kılıcından ayırma. Henüz dinlenmeyi hak etmedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360632
					],
					"speakerTitle": "Korkmuş Kişi"
				},
				{
					"id": 150360632,
					"content": "Kaç Skirk... Kaç! Ölüm ensemizde. Durma sakın, ardına da bakma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360633
					],
					"speakerTitle": "Neşeli Erkek Sesi"
				},
				{
					"id": 150360633,
					"content": "(Doğru ya! Şahit olduğum rüyada da Skirk tek başına antrenman yaparken gaipten gelen sesler ona bir şeyler söylüyordu.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360634
					]
				},
				{
					"id": 150360634,
					"content": "(Birisi yangından bahsetmişti... Tam olarak ne yaşandı acaba? Keşke bizimle konuşsa...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360635
					]
				},
				{
					"id": 150360635,
					"content": "Ayyy, erkenden uyumak gibisi yok! Yatak çok rahattı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360636
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360636,
					"content": "Bir dakika, Skirk? Gece boyu burada oturup bekledin mi? Yatağa geçebilirsin istersen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360637
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360637,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360638
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360638,
					"content": "Gücünü toplayabildin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360639
					]
				},
				{
					"id": 150360639,
					"content": "Yüzde altmış, yetmiş civarı topladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360640
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360640,
					"content": "Vay be, Paimon en az birkaç gün sürer diye düşünmüştü! Ne çabuk toparlanmışsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360641,
					"content": "Aksine... Yeterince çabuk olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360642
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360642,
					"content": "Geçen seferkine kıyasla yüzde yirmi daha az güç topladım. Aynı programı aynı yoğunlukta uyguladım. Farklı hissettirmedi ama nedense sonuç beklediğimden daha düşük çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360643
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360643,
					"content": "Seni yaralayan dikenle alakası olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360644
					]
				},
				{
					"id": 150360644,
					"content": "Hayır, sanırım sorun bende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360645
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360645,
					"content": "Önümüzdeki iki gün boyunca meditasyon yapmam lazım. Kendimi derinlemesine incelersem sorunun kaynağını bulabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360646
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360646,
					"content": "Of, kulağa zor geliyor! Biz de o sırada başında bekleriz o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150360647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150360647,
					"content": "Sağ olun. İki gün sonra görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150360612,
					"content": "Paimon'un fısıldama becerilerini geliştirmesi gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150360613
					]
				}
			]
		},
