			"dialogs": [
				{
					"id": 150365001,
					"content": "Usta hakkında bir şeyler bildiğinden eminim. Bir dahaki sefere hazırlıklı olmam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365002,
						150365005,
						150365008
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365002,
					"content": "Omzun nasıl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365003
					]
				},
				{
					"id": 150365003,
					"content": "İyi. Ufak bir sıyrık sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365004
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365004,
					"content": "Gücümü geri kazanmak zaman alacak ama ben bu tarz durumlara uyum sağlamaya alışığım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365005,
					"content": "Üstündekiler farklı görünüyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365006
					]
				},
				{
					"id": 150365006,
					"content": "Bunu mu diyorsun? Bu bir \"Yıldız Kristali Kıyafeti\". Teyvat'ta Hiçlik enerjisine nadir rastlanıyor, bunu giydiğimde enerjiye daha rahat erişim sağlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150365007
					],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365007,
					"content": "Yoğunlaştırılmış Hiçlik enerjisini kıyafetimde depolayıp istediğim zaman kullanabiliyorum. Enerjisi tükendiğinde eski haline geri dönüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				},
				{
					"id": 150365008,
					"content": "Hadi gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150365009
					]
				},
				{
					"id": 150365009,
					"content": "Dinlenecek bir yer mi buldun? Tamam, önden buyur o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Skirk"
				}
			]
		},
