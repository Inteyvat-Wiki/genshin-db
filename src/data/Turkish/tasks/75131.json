			},
			"dialogs": [
				{
					"id": 751310401,
					"content": "Adeta bir canlı gibi hareket eden alevler, ürpertici görüntüler ve kendi kendine fotoğraf çeken Kameralar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310402,
					"content": "Paimon tüm bunların ardında büyüleyici bir gizem olduğunu düşünüyor! Kim bilir, belki bir hazine bile olabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310403,
					"content": "Bu tahmininin özel bir sebebi var mı Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310404
					]
				},
				{
					"id": 751310404,
					"content": "Dürüst olmak gerekirse... Hayır! Ama sahibi Kamerayı sarsıntıları kaydetmek için buraya koymuş olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310405,
					"content": "Tek yapmamız gereken şey Kamerayı yerine koymak, sonra da sarsıntıların başlamasını beklemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310406,
					"content": "Hehe, zamanı geldiğinde... Hazineyle ilgili ipuçları da ortaya çıkacak, aynı görüntüler gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
