			"dialogs": [
				{
					"id": 751310301,
					"content": "Y-Yakıcı bir... Biyolojik... Yağmur mu? Başımıza alevler yağacağını mı söylüyorsun? Natlan'daki yanardağlar neden bu kadar korkunç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751310302,
					"content": "Paimon biraz meraklandı şimdi... Hehe, hadi gidip şu ilerideki bölgeyi keşfedelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
