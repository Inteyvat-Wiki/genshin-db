				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310201,
					"content": "Yani biyolojik ateş yağmuru aslında gökyüzünden yağan Akaralev Kuşları mı? Ah, normal bir volkanik patlamadan çok daha fazla yeri etkilemelerine şaşmamalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310202
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310202,
					"content": "Olamaz, içlerinden biri ya bir gün evime düşerse? Hayır, bunun için bir plan yapmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310203,
						751310206
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310203,
					"content": "Şey, belki de nadir görülen bir olaydır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310204
					]
				},
				{
					"id": 751310204,
					"content": "Evet, evet, o Akaralev Kuşları yalnızca yanardağ patlamaları yüzünden o kadar yükseğe çıkıyor. Evim yanardağdan uzakta olduğu için bana bir şey olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310205
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310205,
					"content": "Ama... Ya bir gün devasa, akıllara zarar bir patlama olursa? O zaman hiçbir yer güvenli olmaz mı? Off, olamaz, bir plan yapmalıyım... İşi şansa bırakamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310206,
					"content": "Rahatsız ettiğim için özür dilerim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310207
					]
				},
				{
					"id": 751310207,
					"content": "Hiç sorun değil, rahatsız etmiyorsun... Neyse, çatıyı güçlendirerek başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513103,
