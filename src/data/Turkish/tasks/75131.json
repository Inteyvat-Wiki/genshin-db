			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matzahtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310101,
					"content": "Yakıcı bir biyolojik yağmur... Bir dakika, gerçekten de efsanelerde anlatıldığı gibi olabilir mi? Canlı varlıklar gibi evrimleşip yayılan ve etraflarındaki her şeyi kendilerine dönüştüren yanardağlar mı var yani? Olamaz, olamaz, olamaz! Bu bir felaket olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310102,
						751310103
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310102,
					"content": "Yanardağların işleyişi pek öyle sayılmaz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310104
					]
				},
				{
					"id": 751310104,
					"content": "Doğru, haklısın. Magmasız yanardağ nerede görülmüş? Yanardağlar öyle aniden ortaya çıkan şeyler değil. Öyle olsa burası uzun zamandır tehlikeli bir bölge olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310105
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310105,
					"content": "Ama... Ya efsane doğruysa? Of, keşke kendi kendine kayıt yapan şu Kamera düzgün çalışsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310106
					],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310106,
					"content": "Bir dakika! Ya Kamerada bir sorun çıkarsa ve kayıt almayı başaramazsa? Bu tam bir felaket olur! Yok, emin olmak için kendi gözlerimle görmem lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				},
				{
					"id": 751310103,
					"content": "Rahatsız ettiğim için özür dilerim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310107
					]
				},
				{
					"id": 751310107,
					"content": "Tamam, görüşürüz... Ya da dur biraz, yoksa anlattıklarından fazlası mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matzahtli"
				}
			]
		},
		{
			"id": 7513102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513105",
							"3"
						],
						"stepId": 7513105,
						"stateName": "QUEST_STATE_FINISHED"
