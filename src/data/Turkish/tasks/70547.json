			},
			"dialogs": [
				{
					"id": 705470101,
					"content": "Kedi Kurtarıcısı ve Kedi Terbiyecisi Paimon! Siz de gelmişsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470102
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470102,
					"content": "Bize ne diye seslendin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470103,
						705470104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470103,
					"content": "Kulağa tanıdık geliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				},
				{
					"id": 705470105,
					"content": "Hımm... Daha önce tanışmış mıydık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470106,
					"content": "Haha! Kedi Terbiyecisi beni hâlâ hatırlıyor! İşte bu Valerina!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470107
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470107,
					"content": "Hasret gidermeyi sonraya bırakalım. Sponsorluğunu yaptığım yeni oyunu denemeye ne dersiniz? Haftalardır bunun sayesinde eğleniyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470108,
					"content": "Dodoko'nun Bombastik Patlama Şöleni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470109
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470109,
					"content": "Vay canına! Ne kadar çok Dodoko var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470110,
						705470111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470110,
					"content": "Hepsinin de simaları tanıdık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470112,
					"content": "Bak, Kedi Kurtarıcısı... Hehe, ya da belki yıldızımız, saygıdeğer Fahri Şövalyemiz demeliyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470113,
					"content": "Bu Dodoko oyuncağı sen model alınarak yapıldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470114
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470114,
					"content": "#Doğru! Vay canına, renkleri ve desenleri bile aynı... Tıpatıp sen {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470115,
					"content": "Bu oyunda Kıvılcım Dodoko, Hızlı Dodoko, Şövalye Dodoko ve Cadı Dodoko güçlerini birleştirip patlayıcılarını kullanarak daha önce görülmemiş düşmanları havaya uçurmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470116
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470116,
					"content": "Oyunun yalnızca işletme ve sponsorluğundan sorumlu olduğum için nasıl geliştirildiğini pek bilmiyorum. Düşmanları sen ne kadar biliyorsan ben de o kadar biliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470117
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470117,
					"content": "Ama gerçek hayatta karşılaşırsak bile eminim muhteşem Dodokolar onları havaya uçurup geldikleri yere geri gönderirdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470118
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470118,
					"content": "Elbette! Hiçbir canavar Klee ve en iyi arkadaşı Dodoko'nun karşısında duramaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705470119,
						705470120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705470119,
					"content": "Pekala, bir deneyelim bakalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470121,
					"content": "Eminim harika vakit geçireceksiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705470120,
					"content": "Yeni bir Dodoko oyunu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470121
					]
				},
				{
					"id": 705470111,
					"content": "Yani, prototipi tanımamak imkansız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470112
					]
				},
				{
					"id": 705470104,
					"content": "Bu ismimi daha önce hiç duymamıştım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705470105
					]
				}
			]
		}
	]
