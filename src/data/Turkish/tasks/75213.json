			"dialogs": [
				{
					"id": 752130601,
					"content": "Merhaba! İçeceğiniz geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130607
					]
				},
				{
					"id": 752130607,
					"content": "Aa! Siz kurye olmalısınız. Nerede kaldınız ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130608
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130608,
					"content": "Hepsi senin suçun! Siparişin \"sahildeki mavi pantolonlu adama\" teslim edilmesini istemişsin, sonra da gidip kendini kuma gömmüşsün! Seni ve aptal mavi pantolonunu bulana kadar canımız çıktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130609,
					"content": "Bize iki katı teslimat ücreti vermen gerekir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130610,
					"content": "Ah öyleyse kusura bakmayın, benim kabahatim. Eklediğim not tamamen aklımdan çıkmış. Beni kolay bulabilmeniz için pantolonumu dışarıda bırakmam gerekirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130611
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130611,
					"content": "Pekala... İyi ama kuma neden gömülüsün ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130612
					]
				},
				{
					"id": 752130612,
					"content": "Çünkü çok eğlenceli! Duydum ki insanlar tatilde böyle yapıyormuş, o yüzden ben de denemek istedim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130613
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130613,
					"content": "Hımm, yanlış yapıyorsun sanki. Daha çok yere saplanmış bir havuç gibi duruyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 752130614,
					"content": "Hı? Bunun... Nesi yanlış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130615
					],
					"speakerTitle": "Aqo"
				},
				{
					"id": 752130615,
					"content": "Birileri sana takılıp düşebilir ve ikiniz de incinebilirsiniz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130617
					]
				},
				{
					"id": 752130617,
					"content": "Hımm, anladım... Bunu düşüneceğim. Hah, ödemeniz de burada. İki katını verdim! Tekrar teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aqo"
				}
			]
		},
