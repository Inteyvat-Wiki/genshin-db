			"dialogs": [
				{
					"id": 752130201,
					"content": "Yardımcı olabilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752130202
					]
				},
				{
					"id": 752130202,
					"content": "Hı? Gerçekten mi? Peki, madem ısrar ediyorsun... Bekleyen acil bir sipariş var ama tüm elemanlarımızı dışarı gönderdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130203
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130203,
					"content": "Siparişin üzerinde <color=#00E1FFFF>sahildeki mavi pantolonlu misafire teslim edilecek</color> yazıyor. Zamanında ulaştığı sürece hiç sorun olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752130204
					],
					"speakerTitle": "Hayaq"
				},
				{
					"id": 752130204,
					"content": "Yardımın için çok teşekkürler. Teslimat ücretinin yanında sana bir de içecek tarifi vereceğim. Hadi göreyim seni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hayaq"
				}
			]
		},
