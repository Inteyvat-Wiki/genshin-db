				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361501,
					"content": "Oyalanacak zaman yok Gezgin. Umarım Heizou tehlikede değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361502
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361502,
					"content": "Shikanoin Heizou'dan biraz daha bahseder misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361503
					]
				},
				{
					"id": 190361503,
					"content": "Heizou epey neşeli biridir! Çok konuşkandır. Hareketlidir ve enerjiktir. Asla durmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361504
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361504,
					"content": "Sango onu hep uçan bir karasineğe benzetir. Bence bunun sebebi Heizou'nun nerede bir kötülük varsa büyük bir başarıyla ortaya çıkarabilmesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361505,
					"content": "Yani Heizou sıradan bir sinek değil. O, en yetenekli sinek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361506
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361506,
					"content": "Burnu kapalı, gözleri bağlı ve kulakları tıkalı bile olsa Heizou kötülüğün tam olarak nerede olduğunu bulabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361507
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361507,
					"content": "Yetenekleri inanılmaz ve sadece beş duyusunu kullanmıyor gibi... Sanki altıncı bir hissi var! Belki sadece içgüdüdür. Tanrılar onu kutsamış olabilir mi? Öyle bir şey olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361508,
						190361510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361508,
					"content": "Ne demek istediğini anladım ama bence şimdilik bu kadar sinek benzetmesi yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361509
					]
				},
				{
					"id": 190361509,
					"content": "*iç çeker* Sango konuştuğumda hep kendimi aptal yerine koyduğumu söyler. Sanırım haklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361510,
					"content": "Sinek benzetmesi çok kötü ama yine de daha fazla bilgi almak isterim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361511
					]
				},
				{
					"id": 190361511,
					"content": "Öhöm. Başka zaman konuşsak daha iyi olur belki. Sango bize bakmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 1903616,
