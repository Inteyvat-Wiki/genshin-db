				"points": []
			},
			"dialogs": [
				{
					"id": 190361601,
					"content": "Hâlâ gitmedin mi? Yoksa Heizou'yu arama konusunda fikrini mi değiştirdin? Öylesi daha iyi olur. Bana sorarsan ona bulaşmaktan asla iyilik gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361602,
					"content": "Merak ettim. Onunla ne derdin var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361603
					]
				},
				{
					"id": 190361603,
					"content": "Şöyle diyeyim, kaybolsa ve asla bulunmasa üzülmem. Benim derdim o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361604
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361604,
					"content": "(Hafifçe gülümseyip başıyla onaylar.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361605
					]
				},
				{
					"id": 190361605,
					"content": "Öyle bakma. Herkesin dayanamadığı birkaç kişi olabilir sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361606,
					"content": "*iç çeker* Neyse. Galiba o Shikanoin çok sorun çıkarmadan gitmen lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361607,
					"content": "Bu arada onun talihsizce can verdiğini görürsen bana haber ver. Çok mutlu olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
