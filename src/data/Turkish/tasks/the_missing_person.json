				"points": []
			},
			"dialogs": [
				{
					"id": 190361701,
					"content": "Bak sen, bu Kılıç Balığı II'nin yüzbaşısı değil mi? Adım Shibata. Nöbetten ben sorumluyum. Yüzbaşının ne ihtiyacı var acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361702
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361702,
					"content": "Biri hakkında bilgi almaya geldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361703
					]
				},
				{
					"id": 190361703,
					"content": "Shibata'ya Heizou'yu bulma görevini anlatıyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						190361704
					]
				},
				{
					"id": 190361704,
					"content": "Adı Shikanoin Heizou öyle mi? Evet, o dedektifi tanıyorum. Bu bölgede gezerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361705
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361705,
					"content": "Ekselansları zamanında onu çok yakından takip etmemi söylemişti. Bir kötülük yapmasından endişeleniyordu ama zamanla dedektifin daha çok gezmeye gelmiş gibi davrandığını fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361706
					],
					"speakerTitle": "Shibata"
				},
				{
					"id": 190361706,
					"content": "Düşünüyorum da... Sanırım yakın zamanlarda Sangonomiya Tapınağının doğu taraflarında görülmüştü. Oraya gidip bir bakabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shibata"
				}
			]
		},
