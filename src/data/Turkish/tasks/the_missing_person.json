				{
					"id": 190361901,
					"content": "Hımm. Shikanoin denen çocuğu aramaya gitmedin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361902
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361902,
					"content": "Araştırmak mı? Niye bu saçmalığı araştırmaya geleyim ki? Pöh! Kasabada durmaktan sıkılmıştım ve yürüyüşe çıkmaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361903
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361903,
					"content": "Yani beni rahat bırak ve kendi işine bak.",
