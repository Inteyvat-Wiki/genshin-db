				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190361401,
					"content": "Ya Gezgin de meşgulse? Ne yapacağım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361402,
					"content": "O senin sorunun. Bu kargaşanın içine girmeyi sen seçtin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361403,
					"content": "Neyse ki biri seni kurtarmaya geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361404
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361404,
					"content": "Hı? Gezgin! Harika. Gelmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361405
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361405,
					"content": "Endişelenme, işim yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361406
					]
				},
				{
					"id": 190361406,
					"content": "Zaten pek meşgul değildin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361407
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361407,
					"content": "Ah, Sango!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361408
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361408,
					"content": "Gezgine kıyasla hiç meşgul olmayan sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361409
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361409,
					"content": "Hayır. Ben çok meşgulüm. Burada durmakla meşgulüm. Bütün gün burada durmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361410
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361410,
					"content": "Özel görev almak istemiyorsan bile bahanen çok gülünç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361411
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361411,
					"content": "Almak istemediğin bir özel görev mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361412
					]
				},
				{
					"id": 190361412,
					"content": "Evet. Seni onun için çağırdım. Açıklamama izin ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361413
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361413,
					"content": "Tenryou Heyetinin önemli bir üyesi yakın zamanlarda kaybolmuş. Kimse onu görmemiş. Nerede olduğu şu an bilinmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361414
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361414,
					"content": "Tenryou Heyeti bizi onu gizlice bulmamız için görevlendirdi çünkü onların açıkça araması birçok sebepten zor olurmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361415
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361415,
					"content": "Adı da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361416
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361416,
					"content": "Kujou Sara. Evet. General kaybolmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361417,
					"content": "*iç çeker* General cidden kaybolduysa Tenryou Heyeti şimdiye kadar Inazuma'nın altını üstüne getirmiş olurdu. Böyle bir özel görevi sadece bize mi verirler sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361418
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361418,
					"content": "Lütfen Sango'nun saçmalıklarını görmezden gel Gezgin. Aslında kaybolanın adı Shikanoin Heizou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361419
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361419,
					"content": "Polis Karakolunda özel dedektiflik yapıyor. Rütbesi sadece Doushin ama epey yetenekli biri. Polis Karakolunda ona çok saygı duyuyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361420
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361420,
					"content": "Ah! Sence benden daha mı yetenekli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361421
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361421,
					"content": "*iç çeker* Anladık Sango, yardım etmek istemiyorsun ama en azından işimizi zorlaştırmasan olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361422
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361422,
					"content": "Kusura bakma Gezgin. Özel görevi kabul etsem de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361423
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361423,
					"content": "Gördüğün gibi Sango bu işe girmiş olmaktan hiç memnun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361424,
						190361425
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361424,
					"content": "Ücreti mi çok düşük?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				},
				{
					"id": 190361426,
					"content": "Hayır! Hiç ilgisi yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361427,
					"content": "Sebebini bilmek istiyorsan söyleyeyim. O şımarık çocuğun saçmalıklarıyla uğraşmayı hiç istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361428,
					"content": "Beni Shikanoin'in kaybolmasından daha mutlu edebilecek tek haber \"Shikanoin 100 yıldır kayıp.\" olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361429,
					"content": "Öhöm. Anlayacağın Sango ve Heizou'nun arası pek iyi değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361430
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361430,
					"content": "Anlıyorum. Rakipler yani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361431
					]
				},
				{
					"id": 190361431,
					"content": "Hımm... Durum ondan biraz daha ciddi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361432
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361432,
					"content": "Sango'ya göre Heizou, \"Gerçeklik Tapınağı\" yolunda ona engel oluyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361433
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361433,
					"content": "Sürekli başına dert olan, susmak bilmeyen bir köpek gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 190361434,
					"content": "*iç çeker* Heizou'nun kişiliği biraz... Tuhaf olsa da o aslında iyi biridir. Ondan çok şey öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361435
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361435,
					"content": "Yani Sango onaylamasa da bu özel görevi görmezden gelemem. En azından özel görevi becerikli ve güvenilir birine vermem gerekir. Yani senin gibi birine Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361436,
						190361437
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361436,
					"content": "Anladım. Demek özel görevi benim üzerime atıyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361438,
					"content": "Nasıl? Hayır öyle değil! Tenryou Heyetinin başta teklif ettiği ücretin tamamını sana vereceğim. Hatta ben de üzerine biraz ekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361439
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361439,
					"content": "Umarım bu özel görevi alırsın Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361440
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361440,
					"content": "Heizou gerçekten tehlikedeyse yanında sen olursan daha güvende olacağını biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361441,
						190361445
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361441,
					"content": "Onunla yakın mısınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361442
					]
				},
				{
					"id": 190361442,
					"content": "Aslında çok iyi anlaşırız ama Sango hep ondan uzak durmamı ve insan içinde onu tanımıyormuş gibi davranmamı ister.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361443
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361443,
					"content": "Bu yüzden insanlar sorunca genelde Shikanoin'le birkaç kez karşılaştığımı söylüyorum. Bugünkü olay olmasa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361444
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361444,
					"content": "Öhöm. Onu boş verelim. Neyse. Lütfen onu aramamıza yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361449,
					"content": "Tamamdır. Hemen oraya gideceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361450
					]
				},
				{
					"id": 190361450,
					"content": "Sana söyleyeceklerim bu kadar. Lütfen Polis Karakolunun verdiği bu özel görev mektubunu al. Heizou'yu bulursan oraya dönüp onlara rapor ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361445,
					"content": "Tabii ama bana biraz daha bilgi lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361446
					]
				},
				{
					"id": 190361446,
					"content": "Harika! Kaybolmadan önce Heizou'nun Watatsumi Adası'nı merak ettiğini söylediğini öğrendik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361447
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361447,
					"content": "Savaş sırasında Watatsumi Adası'nda bir görevde bulunmuş. Savaş bittikten sonra da adaya sık sık gitmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361448
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361448,
					"content": "Sangonomiya'yla aranın iyi olduğunu duydum. Araştırmana buradan başlasan iyi olur bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190361449
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 190361437,
					"content": "Anladım. Yani aracılık yapıyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361438
					]
				},
				{
					"id": 190361425,
					"content": "Çok az mı ipucu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190361426
					]
				}
			]
		},
		{
			"id": 1903615,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
