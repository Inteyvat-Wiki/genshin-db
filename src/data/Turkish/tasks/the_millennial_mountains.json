			"dialogs": [
				{
					"id": 710640502,
					"content": "Bana \"Öngörü Çiçeği\"nden bahset.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640501
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640501,
					"content": "Söylenene göre Öngörü Çiçeği, kendini sadece çoğu insana delice gelen büyük arzulara sahip insanlara gösterirmiş. Bu nedenle de sıradan insanların tanıklık edebileceği bir şey değilmiş. Hımm, acaba nasıl bir çiçek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				}
			]
		},
