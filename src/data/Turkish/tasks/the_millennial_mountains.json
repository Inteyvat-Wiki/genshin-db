			"dialogs": [
				{
					"id": 710640802,
					"content": "Bana Birlik Kadehinden bahset.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640801
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640801,
