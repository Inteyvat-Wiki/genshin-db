				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640201,
					"content": "(Bu küçük taş tablette şunlar yazıyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640202
					],
					"speakerTitle": "Taş Tablet"
				},
				{
					"id": 710640202,
					"content": "...\"Kanyon'daki savaşta dört uzvumu kaybettim ve bu sözleri başkasının buraya oyarak kaydetmesi için dikte etmek zorunda kaldım.\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640203
					],
					"speakerTitle": "Taş Tablet"
				},
				{
					"id": 710640203,
					"content": "...\"Bu zorlu savaşta hayatta kalmayı başardım ama hayatını kaybeden yoldaşlarımızı düşündüğüm gecelerde gözüme uyku girmedi. Bedenim bu haldeyken onlara katılma ayrıcalığına sahip olamadığım gerçeğinden nasıl da nefret ediyordum.\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640204
					],
					"speakerTitle": "Taş Tablet"
				},
				{
					"id": 710640204,
					"content": "...\"Onlara katılmayı denedim ama Rex Lapis bunu duyup beni azarladı ve saçmaladığımı anladım.\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640205
					],
					"speakerTitle": "Taş Tablet"
				},
				{
					"id": 710640205,
					"content": "...\"Ne yazık ki artık bana bahşettiği Taşordu zırhını ve ekipmanını kullanamıyorum. Bende kalırsa toz tutacak bu eşyaları kaderinde buraya gelmek olan birinin alması için bırakıyorum.\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640206
					],
					"speakerTitle": "Taş Tablet"
				},
				{
					"id": 710640206,
					"content": "...\"Millet, bu hayatta artık silah arkadaşı olamasak da sonrakinde olalım. Kardeşliğin şarabını tekrar içelim ve Liyue'yi düşmanlardan koruyalım!\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taş Tablet"
				}
			]
		},
		{
			"id": 7106403,
			"completionStepIds": [
				7106411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106411",
							"2"
						],
						"stepId": 7106411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710640301,
					"content": "Vay be, bulmuşsun cidden! \"Taşordu hazinesi\" bu mu yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640302
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640302,
					"content": "İçinde ne olduğu hakkında hiçbir fikrim yok ama eminim ki bu hazineyi bırakan asker onun bulunduğunu bilseydi mutlu olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640303
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640303,
					"content": "O felaketin üzerinden beş yüzyıl geçti... Burada sayısız atamızın kendini feda ettiği böylesine şiddetli bir savaşın gerçekleştiğini düşününce merak etmeden duramıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640304
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640304,
					"content": "Toprağın Efendisi ile savaşa giden bu insanlar acaba yüzyıllar boyu hatırlanacaklarını düşünmüş müdür?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640305
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640305,
					"content": "Acaba hiç umutsuzluğa kapılıp bocalamışlar mıdır? Önsezi sahibi olamayanlar, ölüme kadar onlara bir lütfu dokunmamış tanrıya nasıl sadık kalabildi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640306,
						710640307
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640306,
					"content": "Tanrı hep onların yanındaydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				},
				{
					"id": 710640308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640309
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640309,
					"content": "Evet, haklısın. Önsezi sahibi olanlar, olmayanlar... Hepimiz sonsuz potansiyele sahip bir gelecek için uğraşıyoruz. Motivasyon diye buna deniyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640310
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640310,
					"content": "Hepimiz aynıyız. Buraya geçmişteki güzel zamanlar için veya kendimizi bulmaya gelmedik... Yaşadığımız zamanlardan geriye kendimizden bir parça bırakmak için birbirimize destek olmak adına yapıyoruz bunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640311
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640311,
					"content": "Belki de gün gelir Kanyon bizim de anıtımız olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640314
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640314,
					"content": "Çukurlar ve vadiler, nesiller boyu madencilerin alın teri... Hepsi seçtiğimiz zor yolun şahidi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640312
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640312,
					"content": "Tıpkı bu anıt gibi, burası bundan yüzyıl hatta bin yıl sonrasında bile burada yapılan fedakarlıkların boşa yapılmadığını gösterircesine burada olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640313
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640313,
					"content": "Hehe, o günü ben göremeyeceğim elbette ama biz öldükten sonra birileri buraya gelip biz zavallı madencilerin şerefine birkaç kadeh devirirse yeter de artar bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640307,
					"content": "Kendi kararlarına da sadık kaldılar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710640308
					]
				}
			]
		},
