				{
					"id": 710640702,
					"content": "Bana Çağların Güneş Saatinden bahset.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710640701
					],
					"speakerTitle": "Wang"
				},
				{
					"id": 710640701,
					"content": "Çağların Güneş Saatinin herkes tarafından hatırlanacağını, zaman geçse de ihtişamından hiçbir şey kaybetmeyeceğini söylerler. Belki de hiç unutulmamış veya kaybolmamıştır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wang"
