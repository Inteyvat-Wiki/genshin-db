				"points": []
			},
			"dialogs": [
				{
					"id": 120140101,
					"content": "Sanırım ben burada biraz daha kalacağım. Kalbimdeki gösteri henüz tam olarak bitmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140102
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140102,
					"content": "Ah, olur da konuşmak istersen, ben hep buralardayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140103,
						120140108,
						120140115
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140103,
					"content": "Sorasında ne yapmayı planlıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140104
					]
				},
				{
					"id": 120140104,
					"content": "Matsuzaka ve diğerleri hâlâ beni bekliyor, gidip Büyük Mujina Youkai'nin peşine düşebiliriz. Ben, onların ablası gibiyimdir, sözümden geri dönemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140105
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140105,
					"content": "Ayrıca gidip herkese, havai fişekler hakkında ne düşündüklerini sormak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140106
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140106,
					"content": "Ve önümüzdeki birkaç gün boyunca herkese destekleri için teşekkür edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140107
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140107,
					"content": "Buna, tabii ki, sen ve Paimon da dahilsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140108,
					"content": "Havai fişekler pahalı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140109
					]
				},
				{
					"id": 120140109,
					"content": "Sizin için...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140110
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140110,
					"content": "Ücretsiz yaparım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140111
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140111,
					"content": "Ne de olsa sizi biraz zorladım gibi oldu. Sizi kendimle beraber birlikte sürüklediğimden ve yol boyunca başınıza açtığım dertlerden bahsetmiyorum bile. Hehe, tutup da senden birkaç Mora alırsam, kendimi daha da kötü hissederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140112
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140112,
					"content": "Emin misin? Ama sen bedava yapınca, ben biraz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140113
					]
				},
				{
					"id": 120140113,
					"content": "#Sorun değil. Bak, bir anlaşma yapmaya ne dersin? {F#Erkek}{M#Kız} kardeşini bulduktan sonra tüm havai fişek ihtiyaçları için ona Naganohara Havai Fişekleri'ne gelmesini söyle. Böylece bir müşteri daha kazanırım. Uyar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140114
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140114,
					"content": "Ayrıca onunla tanışmayı da isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140115,
					"content": "Ya Tenryou Heyeti senin başına daha çok bela açarsa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120140116
					]
				},
				{
					"id": 120140116,
					"content": "Tekrar kıçlarına tekmeyi basarım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140117
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140117,
					"content": "Hahaha, şaka yapıyorum. Sana ailemin Heyet ile sık sık anlaşma yaptığından bahsetmemiş miydim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140118
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140118,
					"content": "Hem de çok kere. Hataları kabul etmekten, inceden bir gülümsemekten ve bazı cezalar ödemekten başka yapacak bir şey yok. Dünyanın sonu değil ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120140119
					],
					"speakerTitle": "Yoimiya"
				},
				{
					"id": 120140119,
					"content": "Yine de ikiniz de dikkatli olmalısınız. Herhangi bir şeyle karşılaşırsanız, sakın benim kadar dikkatsiz olamayın, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yoimiya"
				}
			]
		}
	]
}