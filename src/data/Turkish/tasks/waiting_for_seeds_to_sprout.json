					"nextDialogs": [
						750360804
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360804,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360805
					]
				},
				{
					"id": 750360805,
					"content": "#Baksana {NICKNAME}! Filojistonun enerjisi tamamen bitmiş. Muhtemelen tohum tarafından soğuruldu, ancak... Hiçbir değişiklik görülmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360806
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360806,
					"content": "Err?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360807,
						750360811
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360807,
					"content": "Büyümek için biraz zamana ihtiyacı vardır belki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360808
					]
				},
				{
					"id": 750360808,
					"content": "Öyle mi dersin? Haklı olabilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360809,
					"content": "Karahindiba tohumlarına hafifçe üflediğinde küçük şemsiyeler gibi uçuşmaya başlıyor... Kurt Çengelleri de küçük kurtlara tutunarak onlarla uzak diyarlara gidiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360810,
					"content": "Bu tohumlar da ne azimliler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360815,
					"content": "En iyisi onu biraz yalnız bırakalım. Sonra geri gelip tekrar kontrol ederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360816,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360811,
					"content": "Belki bu tohumun seyirci korkusu vardır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750360812
					]
				},
				{
					"id": 750360812,
					"content": "Öyle mi dersin? Hımm, belki Paimon fazla sabırsız davranıyordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360813,
					"content": "#Düşünsene, {REALNAME[ID(2)|SHOWHOST(true)]} o tohumu kazıp çıkardı, sonra uçan böcekler tohumun besinlerini çaldı, üstüne bir de canavarlar musallat oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750360814,
					"content": "O dövüş seslerini duyduğunda kıyamet koptu sanmıştır kesin... Eh, bu durumda toprağın altına saklanması ve hiç hareket etmemesi çok normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750360815
					],
					"speakerTitle": "Paimon"
				}
			]
