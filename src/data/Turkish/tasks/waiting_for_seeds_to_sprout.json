					"nextDialogs": [
						750360403
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750360403,
					"content": "Paimon bir düşünsün bakalım... Natlan bitkilerini diğerlerinden ayıran en önemli özellik olsa olsa... Filojistondur mutlaka! Tohumun büyümesini hızlandırmak için kullanabilir miyiz dersin? Bir deneyelim bakalım!",
					"roleType": "TALK_ROLE_NPC",
