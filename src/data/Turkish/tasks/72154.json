			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540101,
					"content": "Bekle! Asker Bey, az önce okuduğunuz replikte ciddiyet duygusunu yeterince veremediniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540102,
					"content": "\"Dünyayı süpüren rüzgar gibidir Samuray.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540103,
					"content": "Sana oyunla ilgili ne söylediğimi hatırlıyor musun? Oyun, izleyicide özgürleştirici bir hissiyat yaratmalı ve hayatın değişkenliğini onlara hissettirmeli. Özgürleştirici dedim! Özgürleştirici, anlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540104,
					"content": "Bu replik oyunun temelini oluşturuyor. Duygularını gizlemeden, dolu dolu ve eksiksiz bir şekilde dışa vurmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540105,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540106
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540106,
					"content": "Ayrıca kılıcını öyle aceleyle sallama... Görüş alanından çıkma yoksa Film Kamerası yaptığın hareketleri yakalayamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540107,
					"content": "Poz ver ve bekle, tamam mı? Bir an için dur, sonra tüm gücünle aşağı doğru savur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540108,
					"content": "İnsanlarla savaşırken kılıcını öyle sallayamazsın ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540109
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540109,
					"content": "Haklısın ama oyunculuğunu prodüksiyonun gereklerine göre şekillendirmen gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540110,
					"content": "Tamam. Lütfen hazırlan ve bir kez daha deneyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540111,
						721540112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540111,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540114
					]
				},
				{
					"id": 721540114,
					"content": "Sen miydin? Ah canım, tatlı bir rüzgar seni buraya sürüklemiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540115,
					"content": "Gördüğün üzere burada kahraman askerimizle bir silahşorluk film çekiyoruz. Adını \"Yedinci Samuray\" koydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540116,
					"content": "Bu türdeki filmlere \"silahşorluk filmi\" diyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540117,
					"content": "İzleyici, filmdeki kılıç sahneleriyle kendini savaş alanındaki inanılmaz bir serüvenin içerisinde hissetmeli... En azından yapmak istediğimiz şey bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540118,
						721540121
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540118,
					"content": "Bay Toranosuke'nin vakti olsaydı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540119
					]
				},
				{
					"id": 721540119,
					"content": "Amirlerimiz bu etkinliğe onay verdi. Şogunluğun saygınlığını artıracağını düşünüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540120
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540120,
					"content": "Bu arada Bay Xavier'nin onları nasıl ikna ettiğine dair en ufak bir fikrim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540123,
					"content": "Dürüst olmak gerekirse Bay Mikoshi Genjirou epey... Ciddi biri. Neyse ki aynı zamanda oldukça anlayışlı bir insan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540124,
					"content": "Ona her şeyi içtenlikle anlattıktan sonra isteğimi memnuniyetle kabul etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540125,
					"content": "Ancak... Karşılığında Şogunluğu konu alan ve tercihen başkahramanın samuray olduğu bir film çekmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540126
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540126,
					"content": "Neyse ki her zaman bu türde filmlere ilgim olmuştur. Bu nedenle teklifini kabul ettim ve Lord Mikoshi Genjirou da bundan epey memnun kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540127
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540127,
					"content": "Bu kahraman askerimizi bana eşlik etmesi için görevlendirdi. Ayrıca bazı yetenekli birlikleri de bana atadı ve dedi ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540128
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540128,
					"content": "\"Kıran kırana kılıç çarpışma sahneleriyle samurayın ve Şogunluğun ihtişamını göster.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540129
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540129,
					"content": "Bay Genjirou gerçekten ileri görüşlü bir adam. Filmlerin bir pazarlama aracı olarak kullanılabileceğini hemen anladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540130
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540130,
					"content": "Bana gelince, filmlerimi çekmeme yardımcı olacaksa hiçbir teklifi geri çevirmem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540131,
						721540135
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540131,
					"content": "Çekim iyi gidiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540132
					]
				},
				{
					"id": 721540132,
					"content": "Aslına bakarsan, o kadar da iyi gittiğini söyleyemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540133
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540133,
					"content": "Bu askerler dövüş sanatının erbabı olsa da bu tarz kurgusal bir savaşı ortaya koymaya alışık değiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540134
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540134,
					"content": "Kılıç hareketleri Film Kamerasının yakalayabileceğinden çok daha hızlı olabiliyor ve hatta bazen görüş açısının dışına bile çıkıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540140,
					"content": "Gezgin, vaktin varsa senaryomu okuyup askerlerin görmesi için bir kez oynayabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540141
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540141,
					"content": "Kuvvetin ve bilginle Kamera önünde harika bir iş sergileyeceğine eminim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540142
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540142,
					"content": "Hikayeye bir de izleyici gözüyle bakarlarsa daha iyi kavrayacaklardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540143
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540143,
					"content": "Hadi, hadi! Senaryoyu ve replikleri oku. Bu bölüm genel olarak savaşla ilgili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540144,
						721540145,
						721540146,
						721540156
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540144,
					"content": "\"Savaş yenilgiyle sonuçlandı.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540147,
					"content": "Pardon, bu replikler farklı bir sahnenin... Savaşla ilgili olan bu, çok fazla repliği yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540148
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540148,
					"content": "Pekala, senaryoya bir bakayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540149
					]
				},
				{
					"id": 721540149,
					"content": "Bu arada, sen \"Juusaburou\" rolünü oynayacaksın. Köy halkı onu birkaç yoldaşıyla beraber köyü koruması için tutmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540150
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540150,
					"content": "Bu sahnede yoldaşlarından biri olan \"Kyuuzou\"nun birkaç repliği var... Onun bölümünü ben oynayacağım. Beraber bir okuma yapalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540151
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540151,
					"content": "Role girmelisin, rolü anlamalısın! Kendini Juusaburou'nun yerine koy. Beni anlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540152,
						721540153
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540152,
					"content": "Anlıyorum Yönetmenim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540154,
					"content": "Harika! İnanılmaz! Bravo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540155
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540155,
					"content": "Hazır olduğunda bana haber ver. Film Kamerasının açısını ayarlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540153,
					"content": "Ben, Juusaburou'yum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540154
					]
				},
				{
					"id": 721540145,
					"content": "\"Tehlikeyle çevrili olsa da samuray her zaman samuraydır.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540146,
					"content": "\"Hepiniz tescilli birer korkuluksunuz...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540156,
					"content": "\"Düşmanlarımız serçe değil...\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540147
					]
				},
				{
					"id": 721540135,
					"content": "Bana da bir rol verir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540136
					]
				},
				{
					"id": 721540136,
					"content": "Tabii ki! Tabii ki! Her şeyden önce sen benim gönlümün kahramanısın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540137
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540137,
					"content": "Beraber oynadığımız \"Tatara Öyküleri\" her daim hafızamda kalacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540138
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540138,
					"content": "Bu askerler dövüş sanatının erbabı olsa da bu tarz kurgusal bir savaşı ortaya koymaya alışık değiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540139
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540139,
					"content": "Kılıç hareketleri Film Kamerasının yakalayabileceğinden çok daha hızlı olabiliyor ve hatta bazen görüş açısının dışına bile çıkıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540140
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540121,
					"content": "Sana yardım etmesi için onu nasıl ikna ettin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540122
					]
				},
				{
					"id": 721540122,
					"content": "Sevgili askerimiz beni tam olarak anladı. Benim asıl işim, Inazuma'da film çekmeme izin vermesi için Bay Mikoshi Genjirou'yu ikna etmekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540112,
					"content": "\"Dünyayı süpüren rüzgar gibidir Samuray.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540113
					]
				},
				{
					"id": 721540113,
					"content": "Kelimeleri gereğinden fazla tutkulu söyledin. Olması gereken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540114
					],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
