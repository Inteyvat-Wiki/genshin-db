			"dialogs": [
				{
					"id": 721540401,
					"content": "\"Silahşorluk filmi\"... Bay Xavier'nin bulduğu isimler hep çok ilginç oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540402,
						721540407
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540402,
					"content": "Bu filmler hakkında ne düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540403
					]
				},
				{
					"id": 721540403,
					"content": "Amirlerimiz bu filmlerin Şogunluğun saygınlığını artıracağını düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540404
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540404,
					"content": "Belki de ben biraz yavaş algılıyorumdur ama bunun nasıl olacağını pek anlamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540405
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540405,
					"content": "Senaryo... Karamsar repliklerle dolu. Bunların hiçbiri samurayların asaletini yansıtmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540406
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540406,
					"content": "Bu fikri kabul ederken kim bilir akıllarında ne vardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540407,
					"content": "Mikage Ocağı'nda durum nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540408
					]
				},
				{
					"id": 721540408,
					"content": "Sör Hanbei \"terfi\" aldıktan sonra Yousuke başa geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540409
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540409,
					"content": "Zanaata ve ticarete doğuştan yetenekli, ayakları yere basan ve istikrarlı biridir. İşleri yoluna koymayı iyi bilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540410
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540410,
					"content": "Mikage Ocağı onun yönetimindeyken bir sorunla karşı karşıya kalınacağını düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Toranosuke"
				}
			]
		},
