			"dialogs": [
				{
					"id": 721540801,
					"content": "Filmlerinle ne anlatmak istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540802
					]
				},
				{
					"id": 721540802,
					"content": "Hımm! Bu güzel bir soru. Çok güzel bir soru. Dürüst olmak gerekirse henüz bu konu üzerine kapsamlı bir şekilde düşünmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540803
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540803,
					"content": "Bence filmler her şeyle ilgili olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540804
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540804,
					"content": "Aşk! Gerilim! Savaş! Asılsız efsaneler bile bir filmin konusu olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540805
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540805,
					"content": "Filmlerin tam olarak ortaya koyamadığım bir cazibesi olduğunu söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540806
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540806,
					"content": "Film çekmeye devam edersem bir gün bu sorunun da cevabını bulabileceğime inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
