			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xavier"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721540301,
					"content": "İşte bu! Tam da gönlümün kahramanından beklendiği gibi! Müthiş bir oyunculuk sergiledin! Sen gerçek bir yıldızsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540302,
						721540304
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540302,
					"content": "Bir... Ne dedin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540303
					]
				},
				{
					"id": 721540303,
					"content": "Bir yıldız! Yani filmin en önemli oyuncusu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540306,
					"content": "Şimdi, Asker Bey, nasıl oynandığını iyice gördünüz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540307
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540307,
					"content": "Bütünüyle, evet. Kılıcımı sallarken yalnızca \"hareketin\" kendisinde değil aynı zamanda \"duruşuma\" da odaklanmalıyım, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540308
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540308,
					"content": "\"Duruş\" önerisine ihtiyacın olursa bu konuda birkaç fikrim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540309
					],
					"speakerTitle": "Toranosuke"
				},
				{
					"id": 721540309,
					"content": "Gerçekten mi? Şahane! Lütfen bunu diğer asker arkadaşlarınla da paylaş. Biraz sonra bir çekim daha yapacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540310
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540310,
					"content": "Yardımın için müteşekkirim Gezgin. Al, bunlar senin için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540311
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540311,
					"content": "Bir sonraki filminin teması ne olacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540312
					]
				},
				{
					"id": 721540312,
					"content": "Sonraki film, hımm... Aslında, sonraki filmin konusuyla ilgili çok kararsızım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540313
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540313,
					"content": "Büyük Narukami Tapınağının çeşitli geleneklerini ya da Kitsune ve tanuki hikayelerini konu alan bir film yapabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540314
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540314,
					"content": "Inazuma'da çok fazla ada var. Anlatılacak çok fazla hikaye çıkar bu adalardan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540315
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540315,
					"content": "Her halükarda ilk önce \"Yedinci Samuray\" filmini tamamlamam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540316
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540316,
					"content": "Bu işle üst mevkidekileri memnun edebilirsem, gelecekteki projelerimi çok daha kolay yürütebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721540304,
					"content": "Belki sonraki sefere rolleri değişiriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721540305
					]
				},
				{
					"id": 721540305,
					"content": "Hiç sorun değil. Bu film biter bitmez yeni bir tane için hazırlıklara başlamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721540306
					],
					"speakerTitle": "Xavier"
				}
			]
		},
