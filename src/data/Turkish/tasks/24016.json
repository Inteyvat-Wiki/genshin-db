			"dialogs": [
				{
					"id": 240160301,
					"content": "Oh be! Yardımınız için teşekkür ederim. Siz olmasaydınız kim bilir kaç saatimi harcamıştım bu işe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160302
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160302,
					"content": "Fahri Kıdemli Araştırmacı unvanının hakkını sahiden de veriyorsunuz. Elinizden kötü bir iş çıktığını görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160303,
						240160304
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160303,
					"content": "Elim böyle işlere yatkındır benim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160306
					]
				},
				{
					"id": 240160306,
					"content": "Yardımlarınız için tekrar teşekkür ederim. Alın, bunlar sizin olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160304,
					"content": "Temizlik sektöründe tecrübem var diyelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160305
					]
				},
				{
					"id": 240160305,
					"content": "Hadi ya? O zaman gerçekten de on parmağınızda on marifet varmış! Unvanınıza da bu yaraşırdı zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160306
					],
					"speakerTitle": "Chalmet"
				}
			]
		},
