			"dialogs": [
				{
					"id": 240160401,
					"content": "Oh be! Yardımınız için teşekkür ederim. Siz olmasaydınız kim bilir kaç saatimi harcamıştım bu işe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160402
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160402,
					"content": "Tabii temizlik sırasında biraz daha nazik hareket etseniz daha iyi olurdu ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160403,
						240160404
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160403,
					"content": "Kusura bakma...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				},
				{
					"id": 240160405,
					"content": "Yanlış anlamayın sakın! Sizi suçlamıyorum tabii ki, bana gerçekten büyük bir iyilik yaptınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160406
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160406,
					"content": "Bunlar sizin için. Yardımlarınız için çok teşekkür ederim Fahri Kıdemli Araştırmacı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160404,
					"content": "Bir dahaki sefere daha dikkatli olurum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160405
					]
				}
			]
		}
	]
