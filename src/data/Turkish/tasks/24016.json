			"dialogs": [
				{
					"id": 240160101,
					"content": "Nihayet bitti... Umarım bu materyaller gerçekten işini görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160102
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160102,
					"content": "Hâlâ dosyaları mı düzenliyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160103
					]
				},
				{
					"id": 240160103,
					"content": "Oo! Sizi görmek ne güzel Fahri Kıdemli Araştırmacı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160104
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160104,
					"content": "Bu belgeleri ve dosyaları Bay Raimondo'nun talimatlarına göre derleyip toparlıyorum, evet... Bir dakika ya. Ben bunu daha önce söylememiş miydim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160105
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160105,
					"content": "İyi de burası kocaman! Bir kişi onca işi nasıl tek başına halletsin? Raimondo sana yardım etmesi için birini göndermedi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160106,
					"content": "Araştırma Enstitüsündekiler daha önemli mevzular varken bu fuzuli şeylerle nasıl ilgilensin canım? Şu an bana yardım edebilecek birinin olmaması normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160107
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160107,
					"content": "Evet de sen bir müdür değil misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160108
					]
				},
				{
					"id": 240160108,
					"content": "Fontaine Araştırma Enstitüsü Materyal Geri Kazanım Projesi Müdürü unvanımı mı kastediyorsunuz? *iç çeker* Lütfen benimle dalga geçmeyin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160109
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160109,
					"content": "Olmaz olsun öyle müdürlük. En başından beri dosyaları düzenlemekten sorumlu sıradan bir çalışanım ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160110
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160110,
					"content": "Bay Raimondo beni dosyaları düzenlemem için görevlendirdikten sonra bir de ne göreyim? Yeni bir unvan almışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160111
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160111,
					"content": "Duyduğum kadarıyla Bay Choiseul'un fikriymiş bu, yaptığımız iş oldukça meşakkatli olduğundan bize bu tür unvanlar vererek emeğimizin karşılığını vermek istiyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160112
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160112,
					"content": "Eyvah, neler diyorum ben! Dilimi eşek arısı soksaydı da demeseydim bir şey! Ne olur kimseye söylemeyin bunları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160113
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160113,
					"content": "Benden laf çıkmaz, merak etme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160114
					]
				},
				{
					"id": 240160114,
					"content": "Bu hiç de kötü değil! Tüm işleri sırtlanan kişi emeğinin karşılığını hakkıyla almış olacak işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160115,
					"content": "Peki ama bunu neden böyle dolaylı bir yoldan yapıyorlar acaba? Doğrudan herkese daha fazla Mora verseler ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160116,
						240160117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 240160116,
					"content": "Bu, Araştırma Enstitüsünde gayet normal bir durum gibi duruyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				},
				{
					"id": 240160118,
					"content": "*iç çeker* Onların işlerine asla aklım ermiyor benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160119
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160119,
					"content": "Neyse, ne olursa olsun çalışmaya devam etmem lazım! Dünya biter, buranın işleri bitmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160120
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160120,
					"content": "Fahri Kıdemli Araştırmacı, acaba siz de bana biraz yardım edebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160121,
						240160122
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160121,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160124
					]
				},
				{
					"id": 240160124,
					"content": "O zaman siz de bir el atıverip şuradaki pisliği temizlememe yardım edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160125
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160125,
					"content": "Temizlik yaparken <color=#00E1FFFF>yakındaki kitaplara ve dosyalara dokunma</color> lütfen. Temizlik esnasında zarar görürlerse çok üzülürüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160126
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160126,
					"content": "Bu işi sizin becerikli ellerinize bırakıyorum o halde! Ben de dosyaları düzenlemeye devam edeyim. *iç çeker* Enstitüde de ne çok dosya varmış yahu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160122,
					"content": "Bu \"fahri\" unvanının hakkını verdiğimi herkese söylemeyi unutma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160123
					]
				},
				{
					"id": 240160123,
					"content": "Hahaha, oldu bilin! Nezaketinizi ve yardımlarınızı duymayan kalmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240160124
					],
					"speakerTitle": "Chalmet"
				},
				{
					"id": 240160117,
					"content": "Fazladan Morayı alabildiğin müddetçe sıkıntı yok bence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240160118
					]
				}
			]
		},
