			"dialogs": [
				{
					"id": 401460101,
					"content": "Merhabalar! Ben Atefeh. Sumerulu gezgin bir tüccarım. Tanıştığımıza memnun oldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460102
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460102,
					"content": "Vay be, amma yol gelmişsin! Herhalde dükkanımızın namı tüm Teyvat'a yayılmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460103,
						401460105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460103,
					"content": "Hepsi senin sayende Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460104
					]
				},
				{
					"id": 401460104,
					"content": "Karşında satış uzmanı Paimon duruyor. Bir balığa su bile satabilir, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460106,
					"content": "Haha, katılıyorum! Dükkanınızın şöhreti epey yayılmış durumda. Haberleri takip eden pek çok tüccar da iksir satma girişiminizi duydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460107
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460107,
					"content": "Ancak çoğu insan hâlâ böyle nadir bir ürüne pek yanaşmak istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460108
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460108,
					"content": "Bana sorarsanız fırsat kapıyı çaldığında onu kaçırmamak lazım. Büyük Moralar böyle kazanılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460109
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460109,
					"content": "İnsanlar henüz simya iksirleriyle ilgili pek bilgiye sahip değil ancak biraz çaba ve pazarlama ile kendinize piyasada iyi bir yer edinebilirsiniz. Sonra da gelsin Moralar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460110
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460110,
					"content": "Yeteri kadar talep oluştuğunda fiyatları on katına bile çıkarabilirsiniz... Hehe, sonra kazandığınız Morayla yılın kalanında çalışmasanız bile olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460111
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460111,
					"content": "On kat mı? Ciddi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460112,
					"content": "Hehe, talep olduğu sürece insanlar ne fiyat verseniz razı gelir. Müşteri ve tedarikçi arasındaki bir tür anlaşma gibi düşünebilirsiniz bunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460113
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460113,
					"content": "Sen böyle konuşunca Paimon'un aklına Mora düşkünü başka bir tüccar geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460114,
					"content": "Bir dakika, Sumeruluyum mu demiştin sen? Belki onu tanıyorsundur. Adı Dori.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460115,
					"content": "Dur bir saniye, Lord Sangemah Bay'den mi bahsediyorsun? Sumeru'daki en meşhur tüccarlardan biri o. Dori'yi tanıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460116,
						401460117
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460116,
					"content": "Kendisi benim arkadaşım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460118,
					"content": "Vay be! Lord Sangemah Bay benim en büyük idollerimden biri. Onun iş anlayışı ve Mora tutkusu benim en büyük ilham kaynaklarımdan biri olmuştur her zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460119
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460119,
					"content": "Hatta bir keresinde Alkazar Sarayı'na gitme şansım olmuştu. Cidden ne müthiş bir yer öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460120
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460120,
					"content": "Bir gün ben de onun gibi Mora içinde yüzmek istiyorum, hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460121
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460121,
					"content": "Iıı... Resmen kendinden geçti... Paimon onu bir kendine getirse mi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460122,
						401460124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401460122,
					"content": "Her şey gönlünce olsun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460123
					]
				},
				{
					"id": 401460123,
					"content": "Teşekkür ederim, bu dileğin benim için çok kıymetli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460126,
					"content": "Konumuza dönelim o zaman. Sanırım size birlikte nasıl büyük Moralar kazanabileceğimizi anlatıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460127
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460127,
					"content": "Aslında fikir oldukça basit. Siz iksirleri üreteceksiniz, bana düzenli tedarik sağlayacaksınız, ben de onları tüm Teyvat'ta satmanıza yardımcı olacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460128
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460128,
					"content": "Aklınıza yattıysa ne tür iksirler satılacağının detaylarını konuşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460129,
						401460131
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460129,
					"content": "İksir koşullarını kontrol et...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460130
					]
				},
				{
					"id": 401460130,
					"content": "Piyasaya dair sezgilerime göre şu anda talep gören iksir türleri bunlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460131,
					"content": "Belki daha sonra...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460132
					]
				},
				{
					"id": 401460132,
					"content": "Hımm, tamam. Ama çok uzun sürmesin. Söz konusu Moraysa demiri tavında dövmek lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460124,
					"content": "Hadi işe dönelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460125
					]
				},
				{
					"id": 401460125,
					"content": "*öhöm* Haklısın. Konudan saptım biraz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401460126
					],
					"speakerTitle": "Atefeh"
				},
				{
					"id": 401460117,
					"content": "Birkaç defa görüşmüşlüğümüz var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460118
					]
				},
				{
					"id": 401460105,
					"content": "Emeklerimizin karşılığını alıyoruz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401460106
					]
				}
			]
