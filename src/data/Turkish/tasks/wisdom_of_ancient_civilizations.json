			"dialogs": [
				{
					"id": 205060101,
					"content": "Selamlar! Ben simya araştırmacısı Timaeus. Mondstadt'a hoş geldin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060102
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060102,
					"content": "Simya mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060103
					]
				},
				{
					"id": 205060103,
					"content": "Simya kadim zamanlardan beri nesilden nesile aktarılan bir zanaattır ama şimdilerde çok az biliniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060104
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060104,
					"content": "Teknikleri sihirli ve gizemlidir, fiziksel dünyayı şekillendiren ilkelerden tamamen farklıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060105
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060105,
					"content": "Anlamayı başarabilirsek harika şeyler üretebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060106
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060106,
					"content": "Bu senin simyager tezgahın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 205060107,
					"content": "Doğru. Neden sen de denemiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060108,
						205060109
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060108,
					"content": "Bilmiyorum, çok karmaşık geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				},
				{
					"id": 205060110,
					"content": "Bir şey olmaz, aslında işlem çok basittir. İlgilenirsen sana temellerini gösterebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205060111
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 205060111,
					"content": "Üret",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 205060109,
					"content": "Bir şeyleri patlatmaktan korkuyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205060110
					]
				}
			]
		},
		{
			"id": 2050602,
