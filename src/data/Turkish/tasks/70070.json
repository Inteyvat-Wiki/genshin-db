			"dialogs": [
				{
					"id": 706900301,
					"content": "Aa? Düzenlemeyi çoktan bitirdiniz mi? Beklediğimden çok daha hızlı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900302,
					"content": "Pekala tatlım, karşılığında ne istersin? Yardımınız sayesinde tüm öğleden sonram boşa çıktı. Bu vakti birlikte geçirelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900303,
						706900305
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900303,
					"content": "Ödeme almayı tercih ederim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900304
					]
				},
				{
					"id": 706900304,
					"content": "O kadar mı? Merak etme. Unutmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900306
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900306,
					"content": "Ah, sen de fark ettin demek. İsimleri çok garip, içerikleri daha da garip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900307
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900307,
					"content": "Üstelik burası kuzey Teyvat'taki en büyük kütüphane ve buna rağmen listedeki tek bir kitap bile tanıdık gelmedi. Bu nasıl mümkün olabilir anlayamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900308
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900308,
					"content": "Tabii eğer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900309
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900309,
					"content": "Aslında biz az önce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706900310,
					"content": "Bir sorun mu çıktı yoksa? Eğer sizin için mahzuru yoksa hiç bilmemeyi yeğlerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900311
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900311,
					"content": "Hem bu kütüphanede dünyadaki tüm kitaplar için yer vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900312
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900312,
					"content": "Burada kalmaları... Şüpheli birinin eline geçmelerinden daha iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900313
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900313,
					"content": "Her neyse, işte ödemen. Yardımın için tekrar teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 706900305,
					"content": "Bu kitaplar hakkında bilgi almak istiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900306
					]
				}
			]
		}
