			"dialogs": [
				{
					"id": 200700201,
					"content": "Çiçekler ne durumda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700202
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700202,
					"content": "Üzgünüm...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700203
					]
				},
				{
					"id": 200700203,
					"content": "Ha? Ne oldu ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700204
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700204,
					"content": "Kazara çiçekleri ve paketleri mahvettim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700205
					]
				},
				{
					"id": 200700205,
					"content": "Ka-Kazara mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700206
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700206,
					"content": "Hay aksi... O çiçekleri özenle seçmiştim. O kalitedeki çiçekleri başka hiçbir yerde bulamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700207
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700207,
					"content": "Ejdersırtı o kadar tehlikeli mi ki? Senin gibi bir maceracı paketleri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700208
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700208,
					"content": "Yine de benim için bu kadar yol gittin, teşekkür ederim. Bunları teşekkür niyetine kabul et. Şimdi izninle çiçeklerimle ilgilenmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700209
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200700209,
					"content": "*iç çeker* Belki de Sara'nın önerdiği yöntemi denemeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
