						200700403
					]
				},
				{
					"id": 200700403,
					"content": "Neyse ki deneylerimiz iyi sonuçlar verdi. Düşük sıcaklıklarda saklamak güvenilir bir çözüm gibi duruyor, hehe.",
					"roleType": "TALK_ROLE_NPC",
