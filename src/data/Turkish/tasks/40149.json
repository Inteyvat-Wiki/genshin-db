						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490201,
					"content": "... Mmm, çok lezzetli! Baharatı muhteşem, pilav bile tek başına aşırı lezzetli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490202
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490202,
					"content": "Hiçbir şey ocaktan yeni alınmış sıcacık bir yemeğin yerini tutmaz... Bunu gerçekten özlemişim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490203
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490203,
					"content": "#Hehe, en iyi Favonius erzakını bile gölgede bıraktın, bu büyük bir başarı... Pekala, söyle bakalım {NICKNAME}, bu yemeğin adı nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490204
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490204,
					"content": "Bu... Şey... Paimon, tutup da bunun adını \"Fark Etmez\" koyamayız diye düşünüyor, sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490205,
					"content": "... Yardım et, Paimon bu yemeği nasıl açıklayacağını bilemedi! Herhangi bir adı yok, sadece temel malzemeleri öylece pişirdik işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490206,
					"content": "Temel malzemeleri öylece pişirdiniz mi? Gerçekten mi? Bunun içine çok iyi bir şey koyduğunuza veya bir çeşit sihirli şef dokunuşu kattığınıza yemin edebilirim ama kanıtlayamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490207,
						401490208
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490207,
					"content": "Dünyadaki en iyi yemek sayılmaz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490208,
					"content": "Ama şu anda ihtiyacınız olan yemek bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490209,
					"content": "\"Dünyadaki en iyi yemek sayılmaz ama şu anda ihtiyaçları olan yemek\" mi? Pekala, Paimon'un kafası karıştı yine, ne demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490210,
						401490211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490210,
					"content": "Uzun zamandır yollardasınız...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490211,
					"content": "Ve bunca zamandır sadece size verilen erzakı yiyorsunuz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490212,
					"content": "Yani... Sırf karnımız çok aç diye mi lezzetli geldi bu bize? Hımm, bence bundan çok daha fazlası olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490213
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490213,
					"content": "... Belki de taze pişmiş sıcak yemeğin kokusu, yediğimiz o soğuk ve hazır erzaka göre hoş bir değişiklik olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490214
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490214,
					"content": "Ha, sabahleyin taze pişmiş ekmek kokusuna uyanmak gibi mi yani? Mantıklı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490215
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490215,
					"content": "Aynen... Sanki Avcının Yeri'ne gelmişiz gibi hissettim kendimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490216
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490216,
					"content": "Nasıl yani? İyi de Avcının Yeri Mondstadt'ta... Aralarındaki lezzet farkını bile bilmiyorsan ne diye Liyue mutfağını deniyorsun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490217,
					"content": "Lezzetlerini kastetmedim. İnsana verdiği o... Huzur hissini kastettim. Adeta kendi evine dönmüşsün gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490218
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490218,
					"content": "Huzur... Kendi evine dönmek... Hımm, Yanxiao demişti aslında, amacımız müşterilere kendilerini evlerinde gibi hissettirmek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490219,
					"content": "Yemeği neyin lezzetli yaptığı oldukça öznel bir konu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490220
					]
				},
				{
					"id": 401490220,
					"content": "Herkesin kendince tercihleri vardır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490221
					]
				},
				{
					"id": 401490221,
					"content": "Ama şef dediğin herkese hitap eder...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490222
					]
				},
				{
					"id": 401490222,
					"content": "Kendimizi müşterilerin yerine koymalıyız...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490229,
					"content": "... O da bir şefin müşterilerinin yüzünü güldürme tutkusudur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490223,
					"content": "Yani diğer bir deyişle... Gizli malzeme \"tutku\" mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490224
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490224,
					"content": "Her ne kadar aşırı klişe bir laf gibi gelse de, itiraf etmeliyim ki bu söz bu yemek için cidden geçerli. İyi iş çıkardınız, bu tarifi asla unutmayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490225
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490225,
					"content": "Pekala, ancak tarif dediğin isimsiz olmaz, değil mi? Bu yemeğe bir isim bulduk mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490226,
						401490227
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490226,
					"content": "O kadarını düşünmedim işte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490227,
					"content": "Herhangi bir fikriniz var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490228
					]
				},
				{
					"id": 401490228,
					"content": "Hımm... \"Gurbetteki Yuva\"ya ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
