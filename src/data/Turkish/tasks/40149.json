			},
			"dialogs": [
				{
					"id": 401490101,
					"content": "... Zaman nasıl da geçiyor. Yanıklarım neredeyse iyileşti, yarın mutfağımı geri alabilirim sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490102
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 401490102,
					"content": "#Geçtiğimiz birkaç günde gerçekten kendini aştın {NICKNAME}. Bugün son günün, umarım ki bugünü de kazasız belasız atlatırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490103
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 401490103,
					"content": "Off, nedense Paimon yine o şom ağzını açtığını düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490104,
					"content": "Gün sorunsuz bir şekilde sona erer...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401490105
					]
				},
				{
					"id": 401490105,
					"content": "Oh be, yine bir şekilde akşamı ettik! Oldukça sorunsuz geçen bir gün oldu. Tüm bunların üstesinden gelecek kadar deneyim kazandığımız için olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490106,
					"content": "İşteki ilk günümüzden bu yana epey yol katettik, değil mi? İlk zamanlar kimin ne sipariş ettiğini hatırlamakta zorlanıyorduk... Ama artık her şey çok kolay!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490107,
						401490108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490107,
					"content": "Sen yine de aceleci davranma istersen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				},
				{
					"id": 401490109,
					"content": "Evet, ama gecenin bu vaktinde daha kim gelir ki? Ha... Paimon'un şimdi aklına geldi. Lyney ve kardeşleri de ilk gün bu saatlerde gelmişti, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490110,
					"content": "#{NICKNAME}? Paimon? İkinizi burada görmek ne hoş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490111,
					"content": "Amber? Eula ve Mika da gelmiş! Akşam yemeğine mi geldiniz? Neden bu kadar geç kaldınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490112,
					"content": "Bir tüccar kervanını koruyorduk, işimiz yeni bitti. Asıl planımız bu akşamı yanımızdaki erzakla idare etmek ve yarın Taş Geçit'e doğru devam etmekti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490113
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490113,
					"content": "Ama Yüzbaşı Eula, çok uzun zamandır Liyue yemeği yemediğimizi söyledi. Biz de hana bir uğrayıp acaba yiyecek bir şeyler bulabilir miyiz diye bir bakalım dedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490114
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490114,
					"content": "Haa, demek Eula ısmarlıyor, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490115,
					"content": "... Öhöm! Yolculuğumuz boyunca hep aynı erzakı yiyip durduk, o yüzden karnımıza doğru düzgün bir yemek girsin diye düşündüm. Kötü mü etmişim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490116,
						401490117
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490116,
					"content": "Wangshu Hanına hoş geldiniz o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490118,
					"content": "Güzel soru, ne alsak? Hımm? Bir saniye, neden siparişlerimizi sen alıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490119
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490119,
					"content": "#{NICKNAME}, buradaki şefin yerine bakıyor! Tam zamanında geldiniz. Asıl şef işini devralmadan önce {NICKNAME} Şef'in yemeğinden yiyen son müşteriler siz olacaksınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490120,
					"content": "Vay canına, gerçekten mi? İyi ki Eula buraya gelmemizi önermiş! Bu fırsatı kaçırmak istemem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490121
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490121,
					"content": "Pekala, ne alalım? Hımm... Liyue mutfağını eskisi kadar iyi bilmiyorum. Mika, Eula, sizin canınız bugün ne çekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490122
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490122,
					"content": "Hiç fark etmez! Fahri Şövalyenin yemeklerini yiyeceğim için sabırsızlanıyorum. Benim için de harika bir öğrenme fırsatı olur hem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490123
					],
					"speakerTitle": "Mika"
				},
				{
					"id": 401490123,
					"content": "... Küçük bir şey yeterli bana. Yemeğimizi yedikten sonra tekrar yola düşmemiz lazım. Onun dışında bana fark etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490124
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 401490124,
					"content": "İyi de buraya gelmek senin fikrin değil miydi? Üff, işleri zorlaştırıyorsun... Pekala, görünüşe göre her şey sana bağlı Amber. Sen söyle biz pişirelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490125,
					"content": "Ne? O zaman... Eh, açıkçası benim için de fark etmez. Her şeyi yerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490126
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401490126,
					"content": "Off!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490117,
					"content": "Siparişlerinizi alabilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490108,
					"content": "Gün henüz sona ermedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				}
			]
		},
