			"dialogs": [
				{
					"id": 401490301,
					"content": "#Hah, {NICKNAME}! Geçtiğimiz birkaç gündeki yoğun çaban için çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490302,
					"content": "Ne demek... Ödeme de alacağım, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490303
					]
				},
				{
					"id": 401490303,
					"content": "Hahaha, hemen sadede gelelim diyorsun. İşte, al bakalım. Biraz da ekstra ekledim, bonus olarak kabul edebilirsin. Burada emeklerin karşılığı daima ödüllendirilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 401490304,
					"content": "Yaşasın! Tüm yorgunluğumuz ve stresimiz bir anda gitti sanki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401490305,
					"content": "Bu işte sadece birkaç günlüğüne çalıştığınız için çok şanslıyım. Bu hızda ilerleseydiniz birkaç haftaya sanırım bana hiç gerek kalmazdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490306
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 401490306,
					"content": "Açıkçası ben ileride senin yaptığın yemekleri yemeyi dört gözle bekliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490307
					]
				},
				{
					"id": 401490307,
					"content": "Haha, ne zaman istersen! Bir dahakine yanında arkadaşlarını da getir de Güleç Yanxiao iki elini de kullanabildiğinde neler yapabiliyormuş size göstereyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490308
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 401490308,
					"content": "Yaşasın! Ama... Temkinli olmak adına sen yine de yemeklerini dikkatli yap! Şom ağzını açmış olabilirsin belki yine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
