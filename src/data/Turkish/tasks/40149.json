					"nextDialogs": [
						401499403
					]
				},
				{
					"id": 401499403,
					"content": "... Pardon. Dalıp gitmişim, geldiğini görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499404
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499404,
					"content": "Aklına takılan bir şey mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499405
					]
				},
				{
					"id": 401499405,
					"content": "Evet... Az önce yaptığın yemek, büyükbabamın zamanında benim için yaptığı yemekleri hatırlattı. Tatlarını unuttuğumu sanıyordum ama senin yemeklerini yedikten sonra hemen hatırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499406
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499406,
					"content": "Bana sürekli Liyue yemekleri yapardı. Akşama kadar onunla Kaşif idmanları yapardım, sonra da yemek masasında sabırla onu beklerdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499407
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499407,
					"content": "... Mutfaktan gelen enfes yemek kokuları arasında orada öylece otururdum, elinde yemeklerle çıkıp gelmesini beklerdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499408
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499408,
					"content": "Bazen Eula da bize katılırdı, sürekli şikayet edecek bir şeyler bulsa da aslında yemekleri gayet beğendiğini söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401499409,
						401499410
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499409,
					"content": "Hım... Belki bunları o da hatırlıyordur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401499411
					]
				},
				{
					"id": 401499411,
					"content": "... Sen söyledin, ben bir şey demedim. Sakın sorma, bir dokunursun bin ah işitirsin ondan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 401499410,
					"content": "Akşam yemeği için buraya gelmenizi bu yüzden istemiş olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
