			"dialogs": [
				{
					"id": 50220701,
					"content": "(O ışık duvarından geçtiğimde sanki tüm bedenim donmuş gibi hissettim.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220702
					]
				},
				{
					"id": 50220702,
					"content": "(Sanırım Gece Lordu'nun koruması buralara ulaşamamış. Buradaki soğuk ve karanlık o kadar boğucu ki... Üstelik kulağıma yalnızca yorgunluk ve acı dolu feryatlar geliyor.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220703
					]
				},
				{
					"id": 50220703,
					"content": "(Bu ruhlar ne zamandır böyle acı içindeler? Ne zaman sona erecek bu?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220704
					]
				},
				{
					"id": 50220704,
					"content": "(Hı? Burada biri var...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220705
					]
				},
				{
					"id": 50220705,
					"content": "Memleketimiz artık geçmişten bir hatıra olsa da savaşın alevleri yanmaya devam ediyor. Kanımızın son damlasını da akıttık çoktan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220706
					],
					"speakerTitle": "\"Yüzbaşı\""
				},
				{
					"id": 50220706,
					"content": "Dik durun askerlerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50220707
					],
					"speakerTitle": "\"Yüzbaşı\""
				},
				{
					"id": 50220707,
					"content": "(Yüzbaşı'nın burada ne işi var? Ne diyor ayrıca?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50220708
					]
				},
				{
					"id": 50220708,
