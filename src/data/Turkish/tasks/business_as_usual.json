			"dialogs": [
				{
					"id": 191320401,
					"content": "Merhaba, nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320402
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320402,
					"content": "Ningguang'ın kıyafetlerini almaya geldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320403
					]
				},
				{
					"id": 191320403,
					"content": "Ah evet, tabii ki. Lütfen bekleyin, hemen getiriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320404
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320404,
					"content": "Uzun bir bekleyişin ardından Lanyang sonunda döner.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						191320405
					]
				},
				{
					"id": 191320405,
					"content": "İşte buradasınız. Lütfen bunları Leydi Ningguang'a götür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320406
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320406,
					"content": "Kıyafetleri getirmen biraz sürdü.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320407
					]
				},
				{
					"id": 191320407,
					"content": "Evet, bu odanın tümü Leydi Ningguang'ın kişisel eşyalarıyla dolu. Sadece kıyafetleri de değil. Her çeşit takı ve aksesuar var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320408
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320408,
					"content": "Leydi Ningguang yakın zamanda odasını yeniden düzenlememizi istedi. Şu anda tam o işin ortasındayız bu nedenle ortalık biraz dağınık. Kıyafeti bulmam da ondan uzun sürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320409,
						191320410
					],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320409,
					"content": "(Ningguang'ın devasa bir kişisel koleksiyonu var gibi duruyor...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				},
				{
					"id": 191320411,
					"content": "Her neyse, artık alabilirsiniz. Kıyafetleri almaya geldiğiniz için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lanyang"
				},
				{
					"id": 191320410,
					"content": "(Sanırım bu yalnızca zenginlere özgü bir sorun.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				}
			]
