			"dialogs": [
				{
					"id": 4870101,
					"content": "... Demek senin kedin kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870102
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870102,
					"content": "Venti! Bize yardım etmeye mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870103,
					"content": "Ben mi yardım edecekmişim? Kelin merhemi olsa kendi başına sürermiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870104
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870104,
					"content": "Ama Paimon az önce senin Margaret'la Prens hakkında konuştuğunu duydu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870105,
					"content": "Aha! Demek, yedek <color=#00E1FFFF>yıldız demiri tellerimi</color> çalan kedigil düşmanımın adı Prens!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870106
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870106,
					"content": "Mondstadt'ın özgür ruhunun büyüğünden küçüğüne tüm yaratıklarda canlı ve güçlü olduğunu görmek beni sevindirse de bunun biraz küstah bir davranış olduğunu düşünüyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870107
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870107,
					"content": "Haha, Prens işte öyle yaramaz bir afacandır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870108
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870108,
					"content": "O afacanı şımartmayı seven bir ebeveyn gibi konuştun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4870109
					]
				},
				{
					"id": 4870109,
					"content": "Öyle. Tıpkı Barbatos gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870110,
					"content": "Ahaha, evet, aynen öyle... Öhöm! Şimdi bakalım Mondstadt'ın Afacan Prensi'ni bulma şerefine nail olabilecek miyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870111
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870111,
					"content": "Bu gece bir gösterim var ve yedek tellerim olmadan izleyicilerimi hayal kırıklığına uğratmaktan endişeleniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870112
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870112,
					"content": "Küçük bir kedinin lir telleriyle ne işi olur tanrı aşkına?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870113,
					"content": "Herkes kedilerin küçük yumaklara deli olduğunu bilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870114
					],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870114,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870115,
					"content": "Bu lirin telleri yıldız demirinden ve yıldız demiri Rüzgar enerjisi barındırır. Bu sayede son derece dayanıklı olurlar, o yüzden genellikle daha kolay taşıyabilmek için telleri top haline getiririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870116
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870116,
					"content": "İşte gezgin bir ozandan bir meslek sırrı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870117
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 4870117,
					"content": "Tellerde Rüzgar enerjisi mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870118,
					"content": "#Bu işimize yarayabilir! {NICKNAME}, <color=#00E1FFFF>Element Görüşü</color> becerini tekrar kullanmanın zamanı geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870119,
					"content": "Paimon etrafta element izleri veya benzeri bir şey olduğundan emin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870122,
					"content": "Hepinize teşekkürler. Prens, pazar yerinin oralarda ya da yerleşim bölgesinde bir yerde olmalı. Siyah bir kedi arayacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				},
				{
					"id": 4870121,
					"content": "Bu <color=#00E1FFFF>balığı</color> da al, Prens'in en sevdiği yiyecek. Onu bulmana yardımcı olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Margaret"
				}
			]
		}
