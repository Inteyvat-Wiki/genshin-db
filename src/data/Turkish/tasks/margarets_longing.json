				{
					"id": 4870504,
					"content": "Prens'i bulamayacağından endişeleniyorsan belki onu bir parça <color=#00E1FFFF>Balıkla</color> kendine çekebilirsin. Küçük kediler balık yemeye bayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4870505,
					"content": "<color=#00E1FFFF>Balığın</color> bittiyse gölden yakalayabilirsin. Hadi, işe geri dönelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
