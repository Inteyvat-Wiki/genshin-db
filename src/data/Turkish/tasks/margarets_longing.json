				},
				{
					"id": 4870502,
					"content": "Bak bakalım ona <color=#00E1FFFF>arkadan</color> yaklaşabilecek misin. Bu sayede ayak seslerin pek duyulmaz.",
					"roleType": "TALK_ROLE_NPC",
