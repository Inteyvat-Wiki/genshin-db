			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708101601,
					"content": "(Flora'nın Kitap Ayracını ver.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101602
					]
				},
				{
					"id": 708101602,
					"content": "Bu ne? Kitap ayracı mı? Hımm. İş görür sanırım. Süs olarak kullanılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101603
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101603,
					"content": "İş için doğru insanı seçtiğimi biliyordum. Şimdi cevaplarını merakla beklediğin soruları sorma zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101604
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101604,
					"content": "Yakında gidecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101605
					]
				},
				{
					"id": 708101605,
					"content": "Ben mi? Yani... Gitmeyi çok isterim. Mondstadt aşırı sıkıcı ve zamanımı geçirmeme yardımcı olacak hiçbir görevim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101606
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101606,
					"content": "Bütün günümü burada oturarak geçiriyorum. Her iki saniyede bir rahibeler bana, sanki çok büyük bir günah işlemişim de kızıyorlarmış gibi bakıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101607
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101607,
					"content": "Bu sırada, Goth Grand Otelde kalan delegasyon da bir tür kısıtlama altında olduğundan oradan da ses çıkmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101608
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101608,
					"content": "Bana sorarsan Sinyora'nın buradaki işi bittiyse, bizi hemen geri çağırmaları gerekir. Mondstadtlılar bizden nefret ediyor, yani burada kalmamız bela aramaktan başka bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101609
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101609,
					"content": "Ancak üstlerimden bir haber gelmedi, ne düşünmem gerektiğini bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 7081019,
			"completionStepIds": [
				7081019,
				7081020
