			"dialogs": [
				{
					"id": 708100401,
					"content": "Mondstadt'a özgü ürünler satıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100402
					]
				},
				{
					"id": 708100402,
					"content": "Yöreye özgü ürün mü? Hediye mi bakıyorsun? Hımm. Ben yalnızca çiçek satıyorum. Onlar da çok uzun süre taze kalamaz, hemen solarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100403
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 708100403,
					"content": "Bunun dışında aklıma gelen tek şey, çiçekten bir kitap ayracı yapmak. Ayracı bazen arkadaşlarıma hediye olarak yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100404
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 708100404,
					"content": "Maddi olarak çok bir şey etmeseler de manevi değerleri vardır. İlgini çekerse, sanırım senin için bir tane yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100405
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 708100405,
					"content": "Ama ilk önce sorumu cevaplamalısın. Doğru cevaplarsan sana bir ayraç yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100406
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 708100406,
					"content": "Çok basit bir soru. Hazırsan soruyorum. Karahindiba bir çiçek midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
		},
