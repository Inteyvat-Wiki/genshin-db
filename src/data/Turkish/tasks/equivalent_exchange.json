			},
			"dialogs": [
				{
					"id": 708101701,
					"content": "(Yöresel İçeceği ver.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101702
					]
				},
				{
					"id": 708101702,
					"content": "Vay, şuna bak. Şişede çok güzel duruyor ama bakalım tadı nasılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101703
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101703,
					"content": "Ama önce onu soğutmalısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101704
					]
				},
				{
					"id": 708101704,
					"content": "Gerçekten mi? O zaman eve dönene kadar bekleyeceğim. Orada buz parçalarını direkt içine atarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101705
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101705,
					"content": "Bir kere söyledim, bir daha söylüyorum. Fatui verdiği sözü tutar. Bana yardım ettin, bunu karşılıksız bırakmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101706
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101706,
					"content": "Sor bakalım şu cevabını çok merak ettiğin sorunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101707
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101707,
					"content": "Diğer Haberciler hakkında ne biliyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101708
					]
				},
				{
					"id": 708101708,
					"content": "Haberciler mi? Onlar beni aşar. Söylenti bile duysam, kendimi şanslı sayarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101709
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101709,
					"content": "İstersen diğerlerinden duyduklarımı sana aktarabilirim. Ama sen yine de söyleyeceklerime hemen inanma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101710
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101710,
					"content": "Scaramuccia olarak da bilinen 6 Numaralı Habercinin geçimsiz biri olduğunu duydum. Birçok insan onu sevmiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101711
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101711,
					"content": "Bazıları onun uyumsuz biri olduğunu, diğerleri de çenesini ne zaman kapatması gerektiğini bilmediğini söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101712
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101712,
					"content": "Onunla yakın çalışan birini tanıyorum. Söylediğine göre Scaramuccia diğer Haberciler arasında da sevilmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101713
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101713,
					"content": "İster sev ister nefret et, bu onun bir Haberci olduğu gerçeğini değiştirmiyor. Benim gibi sıradan bir Fatui üyesinden çok daha iyi yaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
