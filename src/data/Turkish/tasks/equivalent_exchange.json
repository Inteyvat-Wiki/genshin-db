						708100602
					]
				},
				{
					"id": 708100602,
					"content": "Yanlış cevap! Karahindiba bir çiçektir. Çiçeklerden hiç mi anlamıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100603
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 708100603,
					"content": "Peh. O kadar kolay değil benden ayraç almak. Çiçekçilik konusunda kara cahil olan birine elbette öylece veremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100604
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 708100604,
					"content": "Seninle bir anlaşma yapalım. Bana Karahindiba Tohumu getirirsen, ben de sana ayracı veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100605
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 708100605,
					"content": "Ayrıca tohumları toplarken sürekli \"Karahindiba bir çiçektir, Karahindiba bir çiçektir\" diye kendi kendine tekrar edeceğine söz ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				}
			]
