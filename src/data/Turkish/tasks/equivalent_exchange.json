					"id": 708101811,
					"content": "Hepsi bu kadar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101812
					]
				},
				{
					"id": 708101812,
					"content": "Tamam. Aslında iyi bile oldu çünkü ikimizin de başını belaya sokmadan sana anlatabileceklerim bu kadardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101813
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101813,
					"content": "Başka bir işin yoksa, artık beni yalnız bıraksan iyi olur. Aniden ilgilenmem gereken bir durum olursa diye boş kalmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101814
					],
					"speakerTitle": "Viktor"
				},
				{
