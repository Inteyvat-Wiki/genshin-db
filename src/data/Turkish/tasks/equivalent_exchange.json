				},
				{
					"id": 708101502,
					"content": "Yemek mi? Daha kolay taşınsın diye kurutulmuş, fena değil ama tadı sanırım o kadar iyi değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101503
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101503,
					"content": "Yine de Mondstadt'a özgü bir ürün olarak görebiliriz! Haha, evet. Döndüğümde bunu kime vereceğimi biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101504
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101504,
					"content": "Aferin, bu işte fena değilsin. Şimdi cevaplarını merakla beklediğin soruları sorma zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101505
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101505,
					"content": "Bana Sinyora'dan bahset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708101506
					]
				},
				{
					"id": 708101506,
					"content": "Bunu merak ettiğini biliyordum ama korkarım ben de çok bir şey bilmiyorum, hatta benim de merak ettiğim noktalar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101507
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101507,
					"content": "Üstlerim beni Mondstadt'a, Sinyora için çalışmaya gönderdi ama geldiğimden beri ondan bir tane bile görev almadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101508
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101508,
					"content": "Söylentilere göre, buraya geldikten kısa bir süre sonra gitmiş. Ayrılırken de keyfi yerindeymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101509
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101509,
					"content": "Anlamadım, buradaki işi mi bitmiş? Bittiyse, o zaman ben de eve gidebilir miyim yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101510
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708101510,
					"content": "Burada dikilip rahibelerin ve şövalyelerin bana dik dik bakmasını izleyerek günlerimi geçiriyorum. Tüylerim ürperiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 7081018,
			"completionStepIds": [
				7081018,
				7081020
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
