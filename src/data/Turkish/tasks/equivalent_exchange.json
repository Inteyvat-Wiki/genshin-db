			"trigger": {
				"objectNames": [
					"Viktor"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100121,
					"content": "Seni rahatsız eden bir şey varsa, lafı ağzında gevelemek yerine gel de yüzüme söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100122,
						708100127
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708100122,
					"content": "Niye ben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100123
					]
				},
				{
					"id": 708100123,
					"content": "İşte, sonunda doğru düzgün bir soru. Çünkü... Çünkü çok geçmeden Mondstadt'taki herkes Fatui'nin peşine düşecek, sebebi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100124
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708100124,
					"content": "Eskiden yalnızca rahibeler bana ters ters bakardı. Şimdi şehirdeki herkes tırpanını alıp peşime düşecekmiş gibi bakıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100125
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708100125,
					"content": "Sen söyle o halde, senin gibi bir gezginden yardım almayacaksam, başkasına nasıl güvenebilirim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100126
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708100126,
					"content": "Herkesi bu kadar sinirlendirecek ne yapmış olabilirim, bir türlü anlayamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708100127,
					"content": "Şu an şehirde kaç Fatui var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100128
					]
				},
				{
					"id": 708100128,
					"content": "Tam sayılarını bilmiyorum ama Goth Grand Otelde kalan grubun bu sıralar hiç dışarı çıkmadığını biliyorum. Ne olduğu hakkında hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100129
					],
					"speakerTitle": "Viktor"
				},
				{
					"id": 708100129,
					"content": "Tahminimce üst düzey Fatui üyeleri tekrar bir hamle yapabilir. Ancak... Aman, sanki olacak herhangi bir şey, benim gibi düşük seviyedeki insanları etkileyecek de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Viktor"
				}
			]
		},
		{
			"id": 7081003,
			"completionStepIds": [
				7081002
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
