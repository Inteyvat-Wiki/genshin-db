			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708100201,
					"content": "Mondstadt'a özgü ürünler satıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100202
					]
				},
				{
					"id": 708100202,
					"content": "Mondstadt'a özgü ürünler mi? Yani... Yaptığımız her yemek Mondstadt'a özgüdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100203,
					"content": "Ancak ürünlerimizin çoğu hemen tüketilmelidir, bu sebeple uzun yolculuklar için hiç uygun değillerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100204,
					"content": "Elbette yolculuğa ve saklamaya uygun şekilde pişirebiliriz ama o zaman da kalitesinden ve lezzetinden ödün vermemiz gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100205
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100205,
					"content": "Benim için sorun değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100206
					]
				},
				{
					"id": 708100206,
					"content": "Peki, madem ısrar ediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100207
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100207,
					"content": "Ancak hediye etmeyi düşünüyorsan seçtiğin yemeği taze pişirmeni öneririm, buradakiler bir süredir bekliyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100208
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100208,
					"content": "Arkadaşının nereli olduğunu sorabilir miyim? Belki bir şeyler önerebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100209,
						708100211
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100209,
					"content": "Snezhnaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100210
					]
				},
				{
					"id": 708100210,
					"content": "Vay canına, çok uzak. Kullanacağım malzemeleri çok dikkatli seçmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100213,
					"content": "Hımm, Snezhnayalıların damak tadını pek bilmem ama her damak tadına uygun bir yemek biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100214
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100214,
					"content": "Bana bir porsiyon Doyurucu Salata yap, ben de senin için onun raf ömrünü uzatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100215
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100215,
					"content": "Biliyor musun, bu iş için gerekli araçları dolaptan en son ne zaman çıkardığımı hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				},
				{
					"id": 708100211,
					"content": "Fatui.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100212
					]
				},
				{
					"id": 708100212,
					"content": "Fa-Fatui mi? Snezhnayalılardan mı? Yani... Sosyal çevren genişmiş, öyle diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100213
					],
					"speakerTitle": "Sara"
				}
			]
		},
