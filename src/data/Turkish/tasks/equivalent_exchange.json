			"dialogs": [
				{
					"id": 708101101,
					"content": "Tamamdır. Şimdi ilk önce altına elma sirkesi, sonra biraz Karahindiba, Nane ve tatlandırması için Böğürtlenleri ekliyoruz. Biraz da soğutulur ve servis edilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101102
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708101102,
					"content": "Bundan bir bardak içtikten sonra, nefes alırken Mondstadt'ın rüzgarını anında yanaklarının içinde ve boğazında hissedersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101103
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708101103,
					"content": "Dur da şişeleyeyim, yoksa tadı hemen kaçar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708101104
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708101104,
					"content": "Unutma, soğukken içilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				}
			]
