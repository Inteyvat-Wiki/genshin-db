					"nextDialogs": [
						708100502
					]
				},
				{
					"id": 708100502,
					"content": "Vay be, çok hızlı cevapladın! Demek çiçeklerden anlıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100503
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 708100503,
					"content": "Al bakalım, ayracın. Kurutulmuş Rüzgargülü Çiçeğinden bizzat kendim yaptım. Bu, Mondstadt'a özgü bir ürün olarak sayılmıyorsa ne sayılır bilmiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
