					"id": 708100902,
					"content": "Mondstadt'a özgü ürünler satıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100903
					]
				},
				{
					"id": 708100903,
					"content": "Şarap mı almak istiyorsun? Hımm, yaşın yetiyor mu ki senin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100904
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100904,
					"content": "Bir arkadaşım için alacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100905
					]
				},
				{
					"id": 708100905,
					"content": "Zaten hep arkadaş için alınır bunlar. Bunu \"arkadaşına\" götüreceksin, bu \"arkadaşın\" da kibarca sana bir kadeh ikram edecek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100906
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100906,
					"content": "Benden alkol satın almayı unut ama gerçekten Mondstadt'a özgü bir ürün almak istiyorsan, bu kriterlerde başka bir içeceğimiz daha var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100907
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100907,
					"content": "Ama maalesef... Bu içeceği karıştırmak için kullandığım malzemelerin bazıları daha gelmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100908
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100908,
					"content": "Şimdiye kadar çoktan gelmeleri gerekiyordu. Umarım kötü bir şey olmamıştır. Belki de gidip teslimatın durumuna bakabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100909,
						708100911
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100909,
					"content": "Tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100910
					]
				},
				{
					"id": 708100910,
					"content": "Minnettar olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100913
					],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100913,
					"content": "Merak etme, ne olursa olsun, senin için Mondstadt'a özgü bir içecek yapmanın yolunu bulacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Charles"
				},
				{
					"id": 708100911,
					"content": "Ya bir şey olduysa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708100912
					]
				},
				{
					"id": 708100912,
					"content": "Sağlam olanları alıp buraya getirsen yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708100913
