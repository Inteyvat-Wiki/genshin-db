			"dialogs": [
				{
					"id": 730270301,
					"content": "Şurada bir şey parlıyor. Harabe Devinin Kaos Çekirdeği olsa gerek. Jazari bahsetmişti ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270302,
					"content": "Dallarla ve sarmaşıklarla mühürlenmiş ama sanki içinden bir şey sızıyor gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270303,
					"content": "Ah, kirlilik sızıyor. Ararycan hissedebiliyor. Ormanı hasta eden şeyin ta kendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270304
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270304,
					"content": "Hiçlik Büyücüleri şu büyük dalların etrafında bir işler karıştırıyor gibi. Bu hiç iyiye işaret değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270305,
					"content": "Paimon, Jazari'nin çekirdeğin mührüne zarar verildiğini söylediğini hatırlıyor. Belki bu Hiçlik Büyücülerinin onunla bir ilgisi vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270306,
					"content": "Neyse, gidip saklanacak bir yer bulmalısın Ararycan. Onları durduralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
