			"dialogs": [
				{
					"id": 730270401,
					"content": "Oh be. Sonunda bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270402,
					"content": "Uzun bir yolculuktu değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270403,
						730270406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270403,
					"content": "Hadi bu hikayeyi Jazari'ye anlatalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270404
					]
				},
				{
					"id": 730270404,
					"content": "Evet. Çekirdeği biliyorsa fon almak için başvuru yapmamıza yardımcı olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270405,
					"content": "#Yine de Paimon Akademiye falan katılmaz. Sen de katılmayı düşünmüyorsun, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270409,
					"content": "Neyse, Marananın Cisminin Hiçlik Tarikatıyla ne ilgisi olduğunu henüz bilmiyoruz ama ormandaki hastalığı tedavi etmemiz iyi oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270410,
					"content": "*ağlar* Ararycan'a yardım ettiğiniz için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270411
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270411,
					"content": "Önemli değil Ararycan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270412
					]
				},
				{
					"id": 730270412,
					"content": "Şimdi ne yapmayı planlıyorsun Ararycan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270413,
					"content": "Ararycan Utsava Festivalini kutlayacak ama ormanın hastalığından da endişeleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270414
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270414,
					"content": "Ormanı hasta eden kötü şeyler geri dönebilir. Ararycan'ın ormanı koruması gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270415
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270415,
					"content": "O yüzden Ararycan, Utsava Festivalinden sonra buraya dönecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270416
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270416,
					"content": "Vay be, Aranaraların işleri gerçekten çok zor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270417
					]
				},
				{
					"id": 730270417,
					"content": "Eğer yardıma ihtiyacın olursa Ararycan, mutlaka bizi bul!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270418,
					"content": "Tamam, Ararycan sizi bulur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270419
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270419,
					"content": "Hehe! Kendine dikkat et. Yakında görüşeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270406,
					"content": "Hadi bu hikayeyi Royinjan Dede'ye anlatalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270407
					]
				},
				{
					"id": 730270407,
					"content": "Evet. Royinjan Dede de \"Ne ilginç bir hikaye!\" desin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270408,
					"content": "Ormanı bizim kurtaracağımızı kim bilebilirdi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270409
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
