			"dialogs": [
				{
					"id": 730270201,
					"content": "Burada ne yapıyorsun Ararycan?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270202,
					"content": "Ararycan çiçekleri dikmeyi bitirdiğinden beri burada sizi bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270203
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270203,
					"content": "Daha demin Büyük Demir Dağı'ndan bir şey düştü. Az kalsın Ararycan'a çarpıyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270204
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270204,
					"content": "Ah, çok özür dileriz Ararycan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270205,
					"content": "Paimon neden özür diliyor ki? Ararycan'a bir şey olmadı. Ararycan çok hızlı koşar, o yüzden ezilmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270206
					],
					"speakerTitle": "Ararycan"
				},
				{
					"id": 730270206,
					"content": "Neyse ki bir yerine bir şey olmamış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730270207
					]
				},
				{
					"id": 730270207,
					"content": "Robotun kopan kolu yer altı harabelerinin girişini de açmış. Neyse, en azından bir işe yaramış oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270208,
					"content": "Hadi gidip bir bakalım. Kim bilir bizi ne tür nahoş şeyler bekliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730270209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730270209,
					"content": "Ararycan da sizinle gelecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ararycan"
				}
			]
		},
		{
			"id": 7302703,
			"completionStepIds": [
				7302705
