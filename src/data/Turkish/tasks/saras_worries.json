			"dialogs": [
				{
					"id": 4890301,
					"content": "Bir Çiçekli Tavuk, sipariş alındı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890302
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890302,
					"content": "Hımm, bu... Çok güzel kokuyor! Bu işe elin yatkınmış, tam da aradığım elemansın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890303
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890303,
					"content": "Bu kadar güzel pişirdiğine göre sıradaki <color=#00E1FFFF>Karamelize Soslu Rostoyu</color> da yapabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890304
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890304,
					"content": "<color=#00E1FFFF>Karamelize Soslu Rosto</color>! Bunu daha önce Amber'la denemiştik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890305,
					"content": "Doğru, Avcının Yeri menüsünün demirbaşlarından biri. Şefin spesiyali!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890306
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890306,
					"content": "Şövalyeler burada ne zaman toplansa hep bundan sipariş eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890307
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890307,
					"content": "Size <color=#00E1FFFF>Karamelize Soslu Rosto</color> tarifini öğreteyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890308
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890308,
					"content": "Ama şefin spesiyali dememiş miydin? Tarifini bize öylece verecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890309,
					"content": "Senin gibi becerikli bir aşçının bu yemeği pişirmesinin Avcının Yeri markasına zararı olacağını sanmıyorum. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890310
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890310,
					"content": "<color=#00E1FFFF>Karamelize Soslu Rosto</color> hazır olur olmaz buraya getir lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
