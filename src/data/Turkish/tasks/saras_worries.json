			"dialogs": [
				{
					"id": 4890201,
					"content": "Döndün demek, malzemeleri getirdin mi? Bir bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890202
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890202,
					"content": "... Evet. Hepsi bu kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890203
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890203,
					"content": "Şimdi, yedi numaralı sipariş için bir adet <color=#00E1FFFF>Çiçekli Tavuk</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890204
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890204,
					"content": "Böylece aşçı yamağı olma hikayemiz başlıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890205,
					"content": "Avcının Yeri'ne yardım edeceğini kendin söylemiştin. Yemeği sıcak servis etmeye dikkat et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sara"
				}
			]
		},
