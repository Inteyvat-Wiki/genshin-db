					"Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4890101,
					"content": "Tamamdır, hemen yola koyuluyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890102
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890102,
					"content": "Amber! Jean'in işlerine yardım etmeye mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890103,
					"content": "Selam. Evet, ben de tam ona hazırlanıyordum. Teslimat rotasındaki dağ yabanileriyle bir Kaşiften başka kim mücadele edebilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890104
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890104,
					"content": "*iç çeker*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890105
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890105,
					"content": "Sara... Neden hâlâ endişe ediyorsun? Bir Kaşif olarak seni hayal kırıklığına uğratmayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890106
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890106,
					"content": "Beni yanlış anladınız. Yeteneklerinden asla şüphem yok, yalnızca önümde biriken siparişlerden biraz gözüm korktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890107
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890107,
					"content": "Az önce de tuhaf bir sipariş aldım. Ziyafet gibi bir şey düzenliyorlarmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890108
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890108,
					"content": "*boğazını temizler*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890109
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890109,
					"content": "Yardım edebileceğimiz bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890110
					]
				},
				{
					"id": 4890110,
					"content": "Yemek yapmana yardımcı olabilirim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890111
					]
				},
				{
					"id": 4890111,
					"content": "Gerçekten mi! Yardımına çok minnettar olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890112
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890112,
					"content": "Bu harika! Sen gerçekten Avcının Yeri'nin koruyucu meleğisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890113
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890113,
					"content": "Tabii birtakım dağ yabanisi de eksik olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4890114,
					"content": "Bu siparişi sen alabilirsin. Önce malzemeleri toplamalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890115
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890115,
					"content": "#Sence {NICKNAME} bu iş için güvenilir biri mi? Yemeğin tadı biraz tuhaf gelebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890116,
					"content": "Mükemmelliği hedeflediğimiz noktayı çoktan aştık. Şu anda Avcının Yeri'ni kurtarmak için savaş veriyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890117
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890117,
					"content": "Savaş mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4890118,
					"content": "Bu yemek için bize... <color=#00E1FFFF>Üç Tatlı Çiçek ve üç parça Kuş Eti</color> lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890119
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890119,
					"content": "Tamam, hadi git de hazırlan. Sen de, Amber. Burada bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890120
					],
					"speakerTitle": "Sara"
				},
				{
					"id": 4890120,
					"content": "Ta-Tamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
		},
