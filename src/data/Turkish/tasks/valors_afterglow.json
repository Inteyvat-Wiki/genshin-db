					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360201,
					"content": "#Merhaba {NICKNAME}! İşler nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360202,
						710360204
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360202,
					"content": "Gayet iyi. Kendini daha iyi hissediyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360203
					]
				},
				{
					"id": 710360203,
					"content": "Sorduğun için teşekkürler. Şimdi çok daha iyiyim. Sana sorun çıkardığım için kusura bakma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360206,
					"content": "Hadi ama Zhiqiong, etrafta dolaşmayı bırak artık. Yoksa başına geçen seferki gibi bir şey gelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360207,
					"content": "Tamam, tamam. Yardımların için teşekkürler. Kanyon artık çok daha güvenli. Buradaki jeolojik tuhaflıklar da bir nebze normale döndü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360208
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360208,
					"content": "Jinwu ile Khedive o esrarengiz kristal üzerinde daha fazla inceleme yapacak. Bir de... Neydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360209
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360209,
					"content": "Khedive, dalga boyu diye bir şeyden bahsetmişti. Sanırım Sumeru'ya özgü garip bir jargon. Neyse, birkaç işaretçi yerleştirip birtakım verileri elde etmemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360210
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360210,
					"content": "Nihayet Jinwu bu işaretçileri birleştirmeye zaman buldu. İhtiyacımız olan verileri edinmek için bunları belirli noktalara yerleştirmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360211
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360211,
					"content": "Bir süre sonra gidip bunları toplayabiliriz. Ardından da Khedive elde edilen verileri inceleyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360212
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360212,
					"content": "Daha önce çok fazla tehlikeli alan vardı. O nedenle veri analizini kampımızdan yapmak zorundaydık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360213
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360213,
					"content": "Engelleri büyük ölçüde kaldırdığına göre artık işaretçileri kullanarak daha doğru veriler elde edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360214
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360214,
					"content": "*iç çeker* Elimizde yapılacak iş olması, hiç iş olmamasına yeğdir. Ha, aklıma gelmişken, zamanın varsa benimle gelir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360215,
						710360217
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360215,
					"content": "Önden buyur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360216
					]
				},
				{
					"id": 710360216,
					"content": "Peki, hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360217,
					"content": "Benim bundan çıkarım ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360218
					]
				},
				{
					"id": 710360218,
					"content": "Hadi ama, böyle de sorulmaz ki! Gerçi Paimon da bunu bilmek istiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360219,
					"content": "Haha, bu senin için kolay olacaktır ama döndüğünde Jinwu'nun sana bir şey bulacağından eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360204,
					"content": "Her şeye rağmen hayattayım. Sen nasılsın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360205
					]
				},
				{
					"id": 710360205,
					"content": "İyiyim ama çok iyi olduğumu söyleyemem. Keşfin tüm övgüsünü sen topladın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
			"id": 7103603,
			"completionStepIds": [
				7103610
			],
			"beginWay": "TALK_BEGIN_AUTO",
