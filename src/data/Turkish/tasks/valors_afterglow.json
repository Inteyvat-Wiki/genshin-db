						],
						"stepId": 7103713,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710411201,
					"content": "Bir şeye ihtiyacın var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411202,
						710411212,
						710411223,
						710411232
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411202,
					"content": "Haritaların hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411203
					]
				},
				{
					"id": 710411203,
					"content": "Ne? Haritalarım mı? Onlar hakkında söyleyebileceğim pek bir şey yok aslında. Maceracılar Loncasına katılmadan önce maden haritacısıydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411204
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411204,
					"content": "Tabii öylece masa başında oturan biri değildim... Hatta masa başında oturanlarla hiçbir alakam yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411234
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411234,
					"content": "Bir keresinde onlar tarafından Qiaoying Köyü'nün arazisini haritalandırmak için tutulmuştum... Ancak tüm çabalarımın ardından inşaat projesini tek bir kelimeyle iptal ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411205
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411205,
					"content": "Bu tip insanlar keşif ve bilgi toplama işlerini yaptırmak için kendilerine asistanlar bulur, zorlu işleri asistanlara yaptırır ve ondan sonra çizmeye başlar... Ancak benim gibiler bunu yapamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411206
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411206,
					"content": "Kendim de... Yarı madenci olduğum için tehlikeli yer altı geçitlerinden geçmeye uzun zaman önce alıştım. Bu iş böyle yürüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411207
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411207,
					"content": "Bir de o büyük değişimin ardından Kanyon'un alt kesimleri ciddi anlamda dengesizleşti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411208
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411208,
					"content": "Ne? Dengesizleşti mi? Çok mu tehlikeli yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411209,
					"content": "Hem de nasıl. Buradaki arazi yavaşça ancak durmaksızın değişiyor. Bugün açık olan bir yol önümüzdeki ay kayadan bir duvara dönüşebilir. Sanki... Nasıl desem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411210
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411210,
					"content": "Sanki Kanyon canı istediğinde şekil değiştiriyormuş gibi bir durum söz konusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411211
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411211,
					"content": "Şey... Gerçekler bu kadar korkutucu değil, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411212,
					"content": "Bana maceracılık hayatından bahset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411213
					]
				},
				{
					"id": 710411213,
					"content": "Haha, ne? Benim \"hayatım\" mı? Bu kadar nazik olmana gerek yok. Senin aksine ben bir acemiyim. Yolculuğuma yeni başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411214
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411214,
					"content": "Loncadan aldığım birtakım özel görevleri tamamladım tabii ancak henüz o kadar deneyimli değilim. Yani tek kişilik keşiflere pek çıkmadım. Yaptıklarımla ilgili hikayeler olduğunu da sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411215
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411215,
					"content": "Bu yüzden Kanyon'un iz bırakabileceğim ve gelecek nesillerin beni hatırlamasını sağlayabileceğim yer olabileceğini düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411216
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411216,
					"content": "Muhteşem maceracı Alice'in ifadesiyle, Kanyon benim \"Rubikon\"um olabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411217,
						710411220
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411217,
					"content": "Rubikon... Bu dağ yabanisi dilinden mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411218
					]
				},
				{
					"id": 710411218,
					"content": "Paimon da bu kelimeyi daha önce hiç duymadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411219,
					"content": "Yani, ben de tam olarak bilmiyorum ama Alice'in tüm dünyayı görmüş bir maceracı olduğunu göz önünde bulundurursak Rubikon gittiği yerlerden biri olabilir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411220,
					"content": "Senin Rubikon'un demek. Bu çok etkileyici.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411221
					]
				},
				{
					"id": 710411221,
					"content": "Bir dakika, ne olduğunu sen bile bilmiyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710411222,
					"content": "Haha, yine de desteğin için teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411223,
					"content": "Clitopho hakkında ne düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411224
					]
				},
				{
					"id": 710411224,
					"content": "Clitopho mu? Ona güvenmiyorum. Madenlerin üstünde kim bilir ne zamandır Hazine Avcılarıyla uğraşıyoruz. Bir haltlar karıştırıyorlar. Biliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411225
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411225,
					"content": "Söylediği tek kelimeye bile itimat etme. Hayatında yeni bir sayfa açıyormuş... Artık onlarla bir ilgisi yokmuş... Hepsi fasa fiso.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411226
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411226,
					"content": "Bu Hazine Avcıları tatlı dille konuşur ama pis ellerini senin arka cebine sokmaktan çekinmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411227
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411227,
					"content": "Rex Lapis bile cüzdanını onlardan uzak tutmakta zorlanır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411228
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411228,
					"content": "Ön yargılı falan değilim... Yalnızca dikkatli olmanı söylüyorum. Hazine Avcılarına asla güven olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411229
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411229,
					"content": "Bu bana ön yargı gibi geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411230
					]
				},
				{
					"id": 710411230,
					"content": "Belki de öyledir. Muhtemelen benim gördüğümden çok daha fazlasını görmüşsündür. Belki de bu yüzden onlara karşı daha hoşgörülü olabilirsin. Ancak ben onlara karşı gözümü daima dört açacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411231
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411231,
					"content": "Bunu da Clitopho o aşağılık \"eski\" yoldaşlarıyla hiçbir ilişkisi kalmadığını kanıtlayana dek sürdüreceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710411232,
					"content": "Hoşça kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411233
					]
				},
				{
					"id": 710411233,
					"content": "Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		}
	]
}