			"trigger": {
				"objectNames": [
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360301,
					"content": "Yardım ettiğin için sağ ol. Lütfen teşekkür olarak bu ufak hediyeyi kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360302
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360302,
					"content": "Çok naziksin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360303
					]
				},
				{
					"id": 710360303,
					"content": "Son zamanlarda jeolojik anomaliler durdu. O nedenle haritalarımda sadece ufak birkaç değişiklik yapmam gerekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360304
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360304,
					"content": "Maceraların sayesinde işimiz çok daha kolaylaştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360305
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360305,
					"content": "Seni daha fazla tutmayayım. Biraz dinlenmeye ihtiyacın varsa veya maceralarına devam etmek istiyorsan hiç durma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360306
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360306,
					"content": "İşaretçileri toplamaya gidene kadar bir süre beklememiz gerekecek. O zaman da bize yardım edebilirsen seviniriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
			"id": 7104116,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
