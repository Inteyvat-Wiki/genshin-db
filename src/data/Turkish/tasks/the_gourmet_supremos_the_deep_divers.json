					"nextDialogs": [
						721700303
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700303,
					"content": "Evet, işte bu kadar! İşte karşınızda Onigiri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700304
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700304,
					"content": "Ne kadar da... Sade. Ben bunu alacağım. Bitirebileceğimden emin değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700305
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700305,
					"content": "Bence tadı güzel oldukça hiçbir sıkıntı yok! Ben de bunu alacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700306
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700306,
					"content": "Bu porsiyon senin için Gezgin... İşte tarifi de burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700307
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700307,
					"content": "Onigiri yapmak dünyanın en kolay işi gibi görünse de yaparken kullanman gereken bazı teknikler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700308
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700308,
					"content": "O halde biraz da ben yiyeyim. Çalışırken acıktım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700309
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700309,
					"content": "Parvaneh, hani bitiremeyecektin? Bana da biraz ayır!",
