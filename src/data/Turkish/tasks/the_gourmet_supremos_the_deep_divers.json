					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700203
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700203,
					"content": "Şimdi şu Onigiri dedikleri yemeği yapmanın tam zamanı, değil mi? Duyduğuma göre yapması çok kolay bir yemekmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700204
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700204,
					"content": "Pekala, yemeği hazırlayana kadar bekle. Biraz vakit alacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
