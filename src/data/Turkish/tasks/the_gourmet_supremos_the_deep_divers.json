			"dialogs": [
				{
					"id": 721700101,
					"content": "Burayı bu şekilde geçemeyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700102
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700102,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700103
					]
				},
				{
					"id": 721700103,
					"content": "Gezgin, yine karşılaştık! Buradaki suya girmenin bir yolunu arıyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700104
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700104,
					"content": "Biraz taze yosun toplayıp \"Onigiri\" yapacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700105,
						721700107
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700105,
					"content": "Deniz kenarındakileri kullanamaz mısınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700106
					]
				},
				{
					"id": 721700106,
					"content": "Kullanabiliriz ama deniz kenarındaki Yosun genelde taze olmuyor. Oradakileri kullanarak yaptığımız yemeklerin tadı hep biraz eksik oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700109,
					"content": "Biraz sorup soruşturdum ve buranın yerlileri kaliteli Yosunu burada bulabileceğimizi söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700110
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700110,
					"content": "Fakat bugün geldiğimizde buranın bütünüyle deniz suyu altında kaldığını gördük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700111
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700111,
					"content": "Daha da kötüsü, hiçbirimiz dalışta iyi değiliz. Oturup izlemekten başka bir şey gelmiyor elimizden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700112
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700112,
					"content": "Yakınlarda işinize yarayabilecek bir mekanizma var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700113
					]
				},
				{
					"id": 721700113,
					"content": "Şurada bir tane var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700114
					],
					"speakerTitle": "Julie"
				},
				{
					"id": 721700114,
					"content": "Bariyerin içinde olduğu için gidip alamıyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700115
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700115,
					"content": "*iç çeker* Bir yolunu aramaya devam edeceğiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700116
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700116,
					"content": "Gezgin, bu sorunla ilgili bir fikrin varsa bizimle paylaş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700117
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700117,
					"content": "Elbette gidip Yosunu bize getirmen en güzeli olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700118
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700118,
					"content": "Bay Xudong?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700119
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700119,
					"content": "*öksürür* Demek istediğim, Yosunu doğruca bize getirirsen karşılığını fazlasıyla alırsın! Onigirinin yanında harika bir ziyafet seni bekliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700120
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700120,
					"content": "Onigiri, \"harika bir ziyafet\", seçimini yap...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700121
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700121,
					"content": "Hadi ama, tek yapmamız gereken daha fazla... *öksürür* Tamam, tamam. Bir yolunu aramaya devam edelim bari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700107,
					"content": "Dalmak zorunda mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700108
					]
				},
				{
					"id": 721700108,
					"content": "Deniz kenarındaki Yosun genelde taze olmuyor. Oradakileri kullanarak yaptığımız yemeklerin tadı hep biraz eksik oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "Xudong"
				}
			]
		},
