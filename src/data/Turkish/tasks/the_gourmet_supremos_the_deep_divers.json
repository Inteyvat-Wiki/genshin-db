						721700705
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 721700705,
					"content": "Her neyse. Hemen toplayabildiğimiz kadar Yosun toplayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700706
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700706,
					"content": "Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700707
					]
				},
				{
					"id": 721700707,
					"content": "Şu işe bak! Yine karşılaştık Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700708
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700708,
					"content": "Onigiri yapmak için biraz Taze Yosun toplamaya geldik. Buraya gelmek biraz zor oldu. Ayaklarım sırılsıklam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700709
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700709,
					"content": "Bunları boş verelim de Gezgin, bize biraz Yosun toplamamızda yardımcı olur musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700710
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700710,
					"content": "Burayı kısa bir süre önce su basmış gibi. Su çekilmiş ama bir anda geri gelip gelmeyeceğini bilemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700711
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700711,
					"content": "Bu yüzden hemen toplayabileceğimiz kadar Yosun toplarsak iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700712,
						721700715
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700712,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700713
					]
				},
				{
					"id": 721700713,
					"content": "Sana güveniyoruz Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700714
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700714,
					"content": "Lütfen topladığın Yosunları bana getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700715,
					"content": "Deniz kenarındakilerden de biraz toplamayacak mısınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700716
					]
				},
				{
					"id": 721700716,
					"content": "Toplayabiliriz ama deniz kenarındaki Yosun genelde taze olmuyor. Oradakileri kullanarak yaptığımız yemeklerin tadı hep biraz eksik oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700717
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700717,
					"content": "Buradaki Yosunun kalitesi çok daha iyi. İki türlü de yardımına ihtiyacımız var Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700718
					],
					"speakerTitle": "Xudong"
				},
				{
					"id": 721700718,
					"content": "Lütfen topladığın Yosunları bana getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xudong"
				}
			]
		}
	]
