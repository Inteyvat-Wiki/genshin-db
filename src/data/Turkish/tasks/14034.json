			"dialogs": [
				{
					"id": 140340201,
					"content": "Ve böylece canavarlar yok edildi, kötü büyücü yenildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340202
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Canlandıran: Clorinde"
				},
				{
					"id": 140340202,
					"content": "Başkente yeniden huzur hakim oldu. Büyücü tarafından yönlendirilen saray sakinleri de yaptıkları yanlışların farkına vardılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340203
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Canlandıran: Clorinde"
				},
				{
					"id": 140340203,
					"content": "Kimileri krallığı kurtaran kahramanların isimlerini anarken kimileri her şeyden bihaber hayatlarına devam ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340204
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Canlandıran: Clorinde"
				},
				{
					"id": 140340204,
					"content": "İşte Mareşose Avcılarının hikayesi bu. Karanlıkta hayaletlerin izini sürerler, tehdit oluşturan herkesi yok ederler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340205
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Canlandıran: Clorinde"
				},
				{
					"id": 140340205,
					"content": "Yaptıkları ve başardıkları, uğrunda savaştıkları insanlar tarafından unutulmuş bile olsa onlar her daim şehri ve insanlarını korumaya devam edecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340206
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Canlandıran: Clorinde"
				},
				{
					"id": 140340206,
					"content": "Off... Artık senaryoyu tamamladık herhalde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340207
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340207,
					"content": "Evet. İyi sonlardan birine ulaştınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340208
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340208,
					"content": "Gayet iyi bir hikayeydi. Başta sıradan bir macera olduğunu düşünmüştüm ama ilerledikçe hem hikayeyi hem de yapımı çok etkileyici buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340209
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340209,
					"content": "Özellikle de son savaş! Efektler çok gerçekçiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340210
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340210,
					"content": "Evet, kesinlikle, hehe... Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340211
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340211,
					"content": "Aa... İyi bir noktaya değindin. Oradan aldığımız kılıçların hiç öyle bir etki vermesini beklemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340212
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340212,
					"content": "Evet, benimki parladığında ödüm koptu resmen! Sonra dikkatlice inceledim ama bir daha hiç parlayacakmış gibi durmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340213
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340213,
					"content": "Bu dekorları geri vermemiz gerekiyordur, değil mi? Benimkini buraya bırakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340214
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340214,
					"content": "İyi vakit geçirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340215
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340215,
					"content": "Tabii ki! Bunun gibi güzel bir senaryo gelirse bana haber ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340216
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340216,
					"content": "Tabii, olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340217
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340217,
					"content": "O zaman ben gidiyorum şimdi. Tüm bu olup biteni sindirmek için biraz zamana ihtiyacım olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340218
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340218,
					"content": "Bay Florian uyandığında ona selamlarımı ilet lütfen. Böyle kendinden geçtiğine göre çok yorulmuş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340219
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340219,
					"content": "Evet. Çok fazla şeyle ilgilenmesi gerekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340220
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340220,
					"content": "Pekala, sonra görüşürüz millet! Hoşça kalın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340221
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340221,
					"content": "... Madem işimiz bitti, artık sorabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340222
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340222,
					"content": "Olur tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340223
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340223,
					"content": "Neler oluyordu orada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340224
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340224,
					"content": "... Ah, tüm olup biteni fark ettiniz mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340225
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340225,
					"content": "Ahahaha... Mağarada gözlerimizi kapatmamızı söylediğin zaman... Bir şey fark etmeseydik tuhaf olurdu asıl.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340226
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340226,
					"content": "Meraktan ölüyordum zaten! Her şey yolundaymış gibi davranıyordun ama hiç çaktırmadın. Furina her şeyin planlı olduğuna inanmış gibiydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340227
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340227,
					"content": "Hiçbirimiz o anki büyüyü bozmak istemedik sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340228
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340228,
					"content": "Hı? Neden bahsediyorsunuz siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340229,
						140340231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340229,
					"content": "Evet, ne demek oluyor bu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340230
					]
				},
				{
					"id": 140340230,
					"content": "Bir dakika, yoksa sen... Ah, bu tamamen benim hatam. Kulaklarını tıkamak için hâlâ geç değil! Dur hatta sana yardım edeyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340233,
					"content": "Bunun için biraz geç sanki, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340234
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340234,
					"content": "Iı... Yani... Orada olup bitenler senaryonun bir parçası değil miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340235,
					"content": "Aslında bunun başından beri gerçek senaryoya dayalı bir hikaye olmadığını söylemek daha doğru olur sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340236
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340236,
					"content": "Neee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340237,
					"content": "... Çok ses var... Başım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340238
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340238,
					"content": "Hey, hemen ayağa kalk ve neler olduğunu açıkla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340239,
					"content": "Aaaa! Sarsmayın lütfen! Başım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340240
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340240,
					"content": "Florian herkese gerçeği anlatır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140340241
					]
				},
				{
					"id": 140340241,
					"content": "P-Paimon'un duydukları doğru mu? Hikayenin son kısmını uydurdunuz mu yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340242,
					"content": "Yalan söylemek kötü bir şey tabii ama... Paimon'un itiraf etmeli ki hikaye gerçekten iyiydi Florian. Sen de iyi doğaçlama yapmışsın Clorinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340243,
					"content": "Evet! Önemli bir dekoru unutmasına rağmen doğaçlama bir şekilde ortaya etkileyici bir sihir numarası koyan bir sihirbazı izlemek gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340244
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340244,
					"content": "Paimon o kasada bir tuhaflık olduğunu bilseydi anında tam tersi yöne uçardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340245,
					"content": "Her şey kontrol altındaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340246
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340246,
					"content": "Sanki sen herhangi bir durumu \"kontrolden çıkmış\" olarak tanımlarsın da. Senin kolayca halledilir dediğin çoğu durumda aklı başında insanlar ölümüne korkar eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340247
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340247,
					"content": "Sanırım buna alıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340248
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340248,
					"content": "Beklenmedik durumlarla çok sık karşılaşıyor olmalısın o zaman... Bu da anında bir şeyler bulmakta nasıl bu kadar iyi olduğunu açıklıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340249,
					"content": "Sana gelince Florian...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340250
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340250,
					"content": "... Biliyorum, yaptıklarımın hiçbir bahanesi yok. Hemen Jandarmaya teslim olup işlediğim suçları itiraf edeceğim ve ne ceza verilirse razı olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340251
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340251,
					"content": "Bence cezanı yeterince çektin aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340252
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340252,
					"content": "... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340253
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340253,
					"content": "Başta şöhret ve servet hırsı gözünü bürümüştü ama son savaşta yaptıklarınla gerçek bir Mareşose Avcısı olduğunu kanıtladın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340254
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340254,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340255
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340255,
					"content": "Avcı olarak çalışmaya devam edersen bu şehre çok daha fazla faydan dokunur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340256
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340256,
					"content": "Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340257
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340257,
					"content": "Tabii yine de anahtarları alıp onları asıl sahibi olan Avcılara iade etmen gerekecek. Onlardan gelecek her türlü şarta da razı olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340258
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340258,
					"content": "... Evet, tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340259
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340259,
					"content": "Bana kalırsa... Düellodaki performansınla onurunu korumuş oldun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340260
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340260,
					"content": "O halde, dediğin gibi yapacağım. O... O iki anahtarı alıp geri götüreceğim hemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340261
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340261,
					"content": "Hepinize çok teşekkür ederim. Bana verdiğiniz ikinci şansa layık olduğumu kanıtlamak için elimden ne geliyorsa yapacağım. Bir Mareşose Avcısı olarak adım ve şerefim üstüne yemin ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340262
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340262,
					"content": "Görüşmek üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340231,
					"content": "Ayak uyduruyordum sadece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340232
					]
				},
				{
					"id": 140340232,
					"content": "Bir dakika, yoksa Paimon... Ah, bu tamamen benim hatam. Kulaklarını tıkamak için hâlâ geç değil! Dur hatta sana yardım edeyim Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340233
					],
					"speakerTitle": "Navia"
				}
			]
		},
		{
			"id": 1403403,
