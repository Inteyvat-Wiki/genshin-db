			"dialogs": [
				{
					"id": 140340101,
					"content": "Sonunda Florian'ın bahsettiği kili{RUBY#[D]Bodruma}seye varıyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340102
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Canlandıran: Clorinde"
				},
				{
					"id": 140340102,
					"content": "Yaklaştıkça etrafınızı hoş olmayan bir hava sarıyor. Düşmanınızın hemen yakınınızda olduğunu hissediyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340103
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Canlandıran: Clorinde"
				},
				{
					"id": 140340103,
					"content": "(Çok tuhaf... Bu huzursuzluk hissi tıpkı gerçek gibi. Nasıl yapabilmişler bunu?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 140340104,
					"content": "Şimdi... Sıra son savaşta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340105
					],
					"speakerTitle": "Clorinde",
					"speakerSubtitle": "Canlandıran: Clorinde"
				},
				{
					"id": 140340105,
					"content": "Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340106
					],
					"speakerTitle": "Lyney",
					"speakerSubtitle": "Mareşose Avcısı"
				},
				{
					"id": 140340106,
					"content": "Florian bekle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340107
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340107,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340108
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340108,
					"content": "Sen dışarıda beklesen daha iyi. Ruh Yiyen zaten zihnini bir kere ele geçirmişti. Bunu tekrar yapıp zihnini ve bedenini kolayca kontrol altına alabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340109
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340109,
					"content": "Ona bu kadar yakın olmanın iyi bir fikir olduğunu düşünmüyorum. Eğer zihnini yine yozlaştıracak olursa bu defa tamamen başka bir surete bürünmen olası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340110
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340110,
					"content": "İşte tam da bu yüzden gitmeliyim zaten... En önde yer almalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340111
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340111,
					"content": "Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340112
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340112,
					"content": "Evet, onu bedenime çekmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340113
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340113,
					"content": "Bu çok riskli. İşler kontrolden çıkarsa seni öldürmem gerekebilir. Ne kadar tehlikeli olduğunu anlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340114
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340114,
					"content": "Anlıyorum. Ancak bunu yaparsam karşınızda net ve sureti olan bir hedef olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340115
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340115,
					"content": "Ruh Yiyen, kolayca kontrol edebileceği bir bedene girme fırsatını kaçırmayacaktır. Böylece dostlarının ele geçirilmesinden endişe etmene de gerek kalmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340116
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340117
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340117,
					"content": "Sen benim gibi değilsin Bayan Clorinde. Sen, adil ve güçlü bir Mareşose Avcısısın. Bu canavar benim hatamdan dolayı özgür kaldı. Yarattığı yıkımın sorumluluğunu benim almam gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340118
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340118,
					"content": "Bunu... Yapmak zorundayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340119
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340119,
					"content": "Onurumu geri kazanmam için yapmam gereken bir düello gibi düşün bunu. Tek istediğim elinden ne geliyorsa yapman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340120
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340120,
					"content": "... Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340121
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340121,
					"content": "Öyleyse bir Düello Şampiyonu olarak düello isteğini kabul ediyor ve sana saygılarımı sunuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340122
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340122,
					"content": "... Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340123
					],
					"speakerTitle": "Florian"
				},
				{
					"id": 140340123,
					"content": "Savaş başlıyor. Mareşose Avcılarının kılıcı karşısında Ruh Yiyen yeniden korkudan titreyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		},
