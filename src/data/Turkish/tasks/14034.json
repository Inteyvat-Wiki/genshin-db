					}
				]
			},
			"dialogs": [
				{
					"id": 140340301,
					"content": "Mareşose Avcıları demişken... Mağaradaki \"hazineyi\" ne yapalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340302
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340302,
					"content": "Bırakalım öylece kalsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340303
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340303,
					"content": "Emin misin? Bunu insanlara gösterirsek Avcıları hatırlamalarını sağlayabiliriz... İstemez misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340304,
					"content": "Hayır. Tablette yazan her ismin kararı bu yöndeydi. Avcıların seçtiği yol buydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340305
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340305,
					"content": "Benim için de durum aynı... İnsanların bir Mareşose Avcısı olarak beni hatırlamalarına gerek yok. Beni Düello Şampiyonu olarak bilsinler yeter bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340306
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340306,
					"content": "Bu gerçekten bir sihirbazın yönteminden çok farklı. Yine de kararını takdir ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340307
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340307,
					"content": "Bir dakika, Paimon'un aklına şimdi geldi, eğer özel efekt falan yoksa savaş sırasında silahlarımız nasıl öyle parlamaya başladı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340308,
					"content": "Çünkü eskiden Mareşose Avcıları canavarların hakkından gelmek için silahlarına özel büyüler yapardı. Yakınlarda bir canavar olduğu zaman silahları parıldamaya başlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340309
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340309,
					"content": "Aa! Demek en son o yüzden onu durdurabildik. Ben de \"çağrı\" becerisi işe yaradı sanmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340310
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340310,
					"content": "Onun da etkisi olduğuna eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340311
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340311,
					"content": "Ne? Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340312
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340312,
					"content": "Bu Ruh Yiyen muhtemelen odada gördüğümüz Avcılarla aynı dönemden geliyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340313
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340313,
					"content": "Andığınız tüm o isimler en cesur Avcılardı. Sayısız canavarı kılıçlarından geçirdiler. Muhtemelen o yüzden isimlerini söylediğinizde Ruh Yiyen tepki verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340314
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340314,
					"content": "Demek güç aslında isimlerde saklıymış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340316
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340316,
					"content": "Navia, \"çağrı\" kullanırken söylediklerin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340317
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340317,
					"content": "Hı? Ahahaha! Duydun işte dediklerimi. Tam karakterime göreydi bence! Duymana da sevindim aslında ama lütfen tekrarlatma şimdi. Utanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340318
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340318,
					"content": "Sözlerin için teşekkürler, beni çok mutlu etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340319
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340319,
					"content": "Tamam, tamam. Duygusallaşmaya gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340320
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340320,
					"content": "Ah... Neyse, değiştirelim şu konuyu! Ben önden gidiyorum. Çok arkada kalmayın siz de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340321
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140340321,
					"content": "Aa kaçtı resmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 140340322,
					"content": "Ben de artık dönsem iyi olacak. Hikaye inanılmazdı. Dönünce kardeşlerime tüm gece bunu anlatabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340323
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340323,
					"content": "Görüşmek üzere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340324
					]
				},
				{
					"id": 140340324,
					"content": "Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340325
					],
					"speakerTitle": "Lyney"
				},
				{
					"id": 140340325,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340326
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340326,
					"content": "#{NICKNAME}... Eğer adın ve yaptıkların unutulursa o zaman yolculuğunun anlamı nedir sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340327
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340327,
					"content": "(...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340328
					]
				},
				{
					"id": 140340328,
					"content": "Sanırım anlamı yolculuğun ta kendisi ve o sırada yarattığımız dünya. Kimse hatırlamasa bile burada hep birlikte başardıklarımız ve paylaştıklarımız yine de çok kıymetli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340329
					]
				},
				{
					"id": 140340329,
					"content": "Güzel cevap oldu. Bunu unutmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340330
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340330,
					"content": "Senin cevabın ne olurdu Clorinde?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140340331
					]
				},
				{
					"id": 140340331,
					"content": "Benim mi? Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340332
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340332,
					"content": "\"Mareşose Avcısı bu soruyu yanıtsız bırakıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140340333
					],
					"speakerTitle": "Clorinde"
				},
				{
					"id": 140340333,
					"content": "\"Belki de cevap o sessizlikte, gecenin karanlığında yankılanan, söylenmemiş bir yeminde yatıyordur. Onun yürüdüğü yolun açıklanmasına gerek yok.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clorinde"
				}
			]
		}
	]
}