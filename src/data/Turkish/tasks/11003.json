				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Olaf"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110030401,
					"content": "Mmm... Daha iyi... Daha iyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030402
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030402,
					"content": "Teşekkür ederim. Çorba gerçekten işe yaradı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030403
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030403,
					"content": "Ne oldu, dondun mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030404
					]
				},
				{
					"id": 110030404,
					"content": "Evet. bir yaban domuzunu kovalıyordum ve tüm bu yol boyunca onu kovaladıktan sonra oradaki yer altı harabelerinin oraya düştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030405
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030405,
					"content": "Onu içeride takip ettim ama bir Yalancı Buz Ağacı ile karşılaştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030406
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030406,
					"content": "Beni anında dondurdu. Uyandığımda hemen dışarı koştum ama... Gücüm tükenmeden ancak bu kadar uzaklaşabildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030407
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030407,
					"content": "Yalancı Buz Ağacı mı? Ağaçlar... İnsanlara saldırıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030408
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030408,
					"content": "Artık saldırıyorlar! Daha önce başkalarından duymuştum ama bu kendi gözlerimle ilk görüşümdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030409
					],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030409,
					"content": "Ah, harabelerden kesinlikle uzak durmalıyız... Kulağa tehlikeli geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030410,
					"content": "Kulağa harika geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030411,
						110030412
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030411,
					"content": "... Ciddi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				},
				{
					"id": 110030413,
					"content": "İşte bu! Eksik malzeme! Bu da işin kaymağı oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030414
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030414,
					"content": "Sakin ol. Bu kadar saldırgan olan bir ağacı gerçekten yiyebilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030415,
					"content": "Öğrenmenin tek bir yolu var, hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030416
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110030416,
					"content": "*iç çeker* Yine gitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030417,
						110030418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110030417,
					"content": "Gitmemiz gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030419,
					"content": "Benim için endişelenmeyin, iyi olacağım. Ama onu durdurmalısınız, kendini büyük bir tehlikeye atıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Olaf"
				},
				{
					"id": 110030418,
					"content": "Pınarköy'e geri dönmelisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030412,
					"content": "Aklına yiyecek GETİRMEYEN herhangi bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				}
			]
		},
