				{
					"id": 20050502,
					"content": "Söylenti mi yoksa bana şantaj mı yapıyorlar bilmiyorum ama iki durumda da çok saçma. Erzak stokluyor olsaydım, sence hâlâ bu kadar fakir olur muydum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050503
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050503,
					"content": "Benim kendi ailem bile zar zor geçiniyor... Şimdi müsaade edersen ilgilenmem gereken başka işlerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050504
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050504,
					"content": "Kısa süre önce Önsezini kaybettiğini duyduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050505
					]
				},
				{
					"id": 20050505,
					"content": "Tüm gün boyunca duyduğum tek doğru şey bu. Şogun'un Ordusu bana Önsezimi hak etmediğimi söyledi... İşimde de tembellik ettiğimi söylediler. Belli ki Şogun Raiden'ı hayal kırıklığına uğratmışım. Bu yüzden Önsezimi elimden almışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050506
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050506,
					"content": "Çok tuhaf, sen Önsezi Avı Fermanını uygulamaya yardım ediyordun. Neden Önsezini hak etmeyecek biri olasın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050507,
					"content": "Dürüst olmak gerekirse... Ayrıntıları pek hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050508
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050508,
					"content": "Tek bildiğim, her ay yaptığım belirli şeyler vardı ama onların ne olduğunu da hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050509
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050509,
					"content": "Sadece bu da değil... İçimde can sıkıcı bir his var... Sanki birisinin bana borcu varmış gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050510
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050510,
					"content": "Kayıp acil durum erzaklarıyla bir ilgisi var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050511,
					"content": "Hiçbir şeyi zimmetime geçirmedim ben! Dediğim gibi, onları kendime almış olsaydım, şu anda bu kadar zor zamanlardan geçiyor olmazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050512
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050512,
					"content": "Üstüne üstlük evim Hazine Avcılarının saldırısına uğradı... Buraya gelme sebebim de zaten onlardı. Bu ikisi beni durdurmadan önce ben de onları kovalıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050513
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050513,
					"content": "Bana inanmıyorsan, git o Hazine Avcılarını bul! Evimde herhangi bir acil durum erzakı varsa, onları çoktan bulmuşlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050514
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050514,
					"content": "Hım... Pek yalan söylüyor gibi durmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050515,
					"content": "Ama teyit etsek iyi olur. Şu Hazine Avcılarına gidip ne söyleyeceklerini görelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050516,
					"content": "Onların izlerini takip edebiliriz. Fazla uzağa gitmiş olamazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
