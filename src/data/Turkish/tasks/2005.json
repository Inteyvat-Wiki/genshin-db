				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050201,
					"content": "Ah, tüm Moralar gitti... Onu çalmaya çok çaba harcamıştık yahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050202
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050202,
					"content": "Hadi ama patron, bir şeyler düşün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050203
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050203,
					"content": "Öhöm... Fena değil evlat. H-hazine Avcılarına katılmayı hiç düşündün mü? Senin gibi biri işimize yarar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050204,
						20050205
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050204,
					"content": "Unut bunu. Kurosawa hakkında tüm bildiklerini anlat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				},
				{
					"id": 20050206,
					"content": "Kurosawa mı? Ah... Hatırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050207
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050207,
					"content": "Yani sizi peşimize takan o muydu? Şansa bak be. Oraya girmememiz gerektiğini biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050208
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050208,
					"content": "İçeride ne gördün? Yiyecek erzaklarıyla dolu muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050209,
					"content": "Yiyecek erzakları mı? Dalga mı geçiyorsun? Her yer karman çormandı. Sadece içinde değerli eşyaların olmasını umduğumuz tuhaf görünümlü bir kutu bulduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050210
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050210,
					"content": "Başka kimsenin görmesini istemediğim için, geri döndüğümüzde kendim açmayı planlıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050211
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050211,
					"content": "Artık bizi yakaladığına göre bir anlaşma yapmaya ne dersin? Özgürlüğümüze karşılık şu küçük kutu... Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050212
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050212,
					"content": "Anlaştık. Şimdi bize kutunun içindekileri göster!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050213,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050214
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050214,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050215
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050215,
					"content": "B-burada borç senedinden başka bir şey yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050216
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050216,
					"content": "Evet, hem de oldukça çok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050217,
					"content": "Üstelik hepsi marketin sahibi Bayan Aoi için düzenlenmiş gibi görünüyor. Burada tonlarca Moradan bahsediyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050218,
					"content": "Bayan Aoi ile konuşup meselenin aslını öğrensek iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050219,
					"content": "Size gelecek olursak, gitmekte özgürsünüz. Sadece yollarımızın bir daha kesişmemesi için dua edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050220,
					"content": "Evet, elbette!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050221
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050221,
					"content": "Yani hayatımızı o senetlere borçluyuz... O zaman ne kar, ne de zarar mı ettik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050222
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050222,
					"content": "Kes sesini! Hemen gidelim buradan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050205,
					"content": "Hım, dediklerine göre Kurosawa'nın evini yağmalamışsın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050206
					]
				}
			]
		},
		{
			"id": 200503,
			"completionStepIds": [
				200504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200504",
							"2"
						],
						"stepId": 200504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aoi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050301,
					"content": "Tsukumomono Marketine hoş geldiniz, ihtiyacınız olan her şey burada! Aradığınız bir şey varsa, bulmanıza yardım edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050302
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050302,
					"content": "Ya da... Sormak istediğiniz bir şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050303
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050303,
					"content": "Şu borç senetleri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050304
					]
				},
				{
					"id": 20050304,
					"content": "Demek Kurosawa'nın arkadaşlarısınız, öyle mi? Haha, yoksa onun borçlarını kapatmaya mı geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050305
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050305,
					"content": "Yok artık, o kadar da değil. Sadece hepsinin nereden geldiğini öğrenmek için buradayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050306,
					"content": "Nasıl oldu da Kurosawa sana bu kadar borçlandı? Buradan çok pahalı şeyler mi aldı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050307,
					"content": "Bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050308
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050308,
					"content": "Kurosawa bol miktarda yiyecek almak için buraya sık sık gelirdi. Ödemeyi de hep kendi maaşıyla yapardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050309
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050309,
					"content": "Fakat son zamanlarda erzak fiyatları aniden yükselmeye başlamıştı ve maaşı, artık bu zamları karşılamaya yetmiyordu. O da ürünleri her zamanki fiyatından almak için parası yetmediğinden, borç senetleri yazmaya başlamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050310
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050310,
					"content": "Acil durum erzaklarını bu şekilde alıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050311,
					"content": "İyi de neden \"her zamanki\" miktardan satın alması gerekiyordu? Fiyatlar arttıysa daha az miktarda satın alamaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050312,
					"content": "Aslında şöyle bir durum var, acil durum erzaklarını alan vatandaşların, erzakların her seferinde kendilerine ne kadar yeteceğini çok dikkatlice hesaplamaları gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050313
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050313,
					"content": "Kurosawa, zaten kıt kanaat geçinen insanlar olur da yeterince erzak olmadığını fark ederse çok büyük hayal kırıklığına uğrayacaklarını düşünüyordu. Hem de bu kadar uzun ve dikkatli planlamaya rağmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050314
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050314,
					"content": "Dolayısıyla insanları hayal kırıklığına uğratmaktansa borç altına girmeyi tercih etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050315
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050315,
					"content": "Vay canına, Kurosawa tüm acil durum erzaklarını kendi parasıyla satın alıyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050316,
					"content": "... Ve hiç kimse yaptığı şey için ona teşekkür etmedi. Herkes sadece şikayet edip onu sorumlu tuttu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050317,
					"content": "İnsanların tutumları, daima içinde bulundukları durumu yansıtır. Zorluklar karşısında hiç kimse etraflıca düşünmeye yeltenmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050318
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050318,
					"content": "Bana soracak olursan, Kurosawa herkese erzaklar hakkında gerçeği söylemiş olsaydı, şu anda bu kadar sert bir tepki olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050319
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050319,
					"content": "Elbette, yine de belirli düzeyde bir kargaşa olurdu. Tek yaptığı şey, karşılık beklemeden iyilik yapmakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050320
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050320,
					"content": "Acil durum erzaklarını kendi parasıyla alıp, neden bundan kimseye bahsetmediğine gelecek olursak... Açıkçası nedenini ben de hâlâ bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050321
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050321,
					"content": "Merak ediyorsan neden gidip sormuyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050322
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050322,
					"content": "Ne yazık ki hatırlamıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050323
					]
				},
				{
					"id": 20050323,
					"content": "Anladım... Hatırlamak demişken... Görünüşe göre Önsezisine kısa süre önce el konulmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050324
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050324,
					"content": "Zavallı... Borcunu kapatmazsa, onun için kıymetli olan kılıcı satmaktan başka bir seçeneği olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050325
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050325,
					"content": "Kılıç mı? Ne kılıcı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050326,
					"content": "Sana söylemedi mi? Çok değerli bir kılıcı var... Onu yıllardır taşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050327
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050327,
					"content": "Kılıcın nereden geldiğini sordum. Onu babasının hediye ettiğini ve çok değerli olduğu için satamayacağını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050328
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050328,
					"content": "Onun kılıcına hiç teklif vermediğime pişman oldum bak şimdi... Her şeyin bir fiyatı vardır. En azından ben böyle düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050329
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050329,
					"content": "Kılıçla ilgili soruları neden ona kendin sormuyorsun? Belki de aradığın cevapları sana verebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050330
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050330,
					"content": "Ama gitmeden önce bugünkü faturayı ödersen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050331
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050331,
					"content": "Ne? İyi de bir şey satın almadık ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050332,
					"content": "Hehe, bilgi de bir çeşit ticari eşyadır, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050333
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050333,
					"content": "Merak etme, Kurosawa ile ilgili bilgiler için senden çok para almayacağım. Neyse ki konuştuklarımızın hiçbiri gizli bilgi değildi. Bir düşüneyim... 2.000 Mora yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050334
					],
					"speakerTitle": "Aoi"
				},
				{
					"id": 20050334,
					"content": "Gayet makul.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050335
					]
				},
				{
					"id": 20050335,
					"content": "En azından acil durum erzaklarının nereden geldiğini artık biliyoruz. Üstelik Kurosawa'nın elinde çok değerli bir kılıç olduğunu da öğrendik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050336,
					"content": "Kurosawa ile tekrar konuşalım ve bir şey hatırlayıp hatırlamadığını öğrenelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200504,
			"completionStepIds": [
				200505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200505",
							"2"
						],
						"stepId": 200505,
						"stateName": "QUEST_STATE_UNFINISHED"
