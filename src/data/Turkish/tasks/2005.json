				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050401,
					"content": "Burada tek başına ne yapıyorsun? Diğer ikisi nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050402,
					"content": "Onlara iki seçenek sundum. Ya çekip gideceklerdi ya da ben kılıcımı çekecektim. Ve onlar gitmeyi seçtiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050403
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050403,
					"content": "Bu, lafla onları ikna etmekten daha çok işe yaradı ve epey zaman kazandırdı. Belki de kılıcımı daha sık kullanmaya başlasam iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050404
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050404,
					"content": "Hazine Avcılarını takip edebildin mi? Söylediğim her şey doğruymuş, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050405
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050405,
					"content": "Aslında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050406
					]
				},
				{
					"id": 20050406,
					"content": "Aslında durum biraz farklı. Gerçekten de acil durum erzaklarını dağıttığın ama hepsinin parasını kendi cebinden verdiğin ortaya çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050407,
					"content": "Tuhaf... Ben gerçekten böyle biri miymişim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050408
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050408,
					"content": "Hiç böyle bir şey hatırlamıyorum. Bana anlattığın bunca şeye rağmen, hâlâ bir şey hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050409
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050409,
					"content": "Herkese neden acil durum erzakları alıyormuşum ki? Ve neden kendimi bu kadar zorlu bir durumun içine sokmuşum... *iç çeker* Hiç anlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050410
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050410,
					"content": "Ama o ikisini korkutmak için kılıcımı çektiğimde, bedenimin bunu yapmaya isteksiz olduğunu da inkar edemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050411,
						20050412
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050411,
					"content": "Kılıç...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				},
				{
					"id": 20050413,
					"content": "Bu kılıcı eskiden babam kullanıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050414
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050414,
					"content": "Küçükken, komşu çocuklarına hava atmak için evden kılıcı gizlice kaçırdığımı hatırlıyorum. Ama sonra babam beni suçüstü yakaladı ve bir güzel payladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050415
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050415,
					"content": "Ne demişti... Gerçi onu da hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050416
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050416,
					"content": "Sanırım Önsezim benden alındığında birçok önemli şeyi unuttum. Ne kadar hatırlamaya çalışsam da birçok hatıram sonsuza dek kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050417
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050417,
					"content": "Şu anda hatırladığım tek şey, babamın bu kılıcın kendisi için hayati derecede önemli olduğunu söylemesiydi. Ölmeden önce kılıcı elime tutuşturmuştu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050418
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050418,
					"content": "... Ve bana dedi ki, \"Bu kılıçla sen...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050419
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050419,
					"content": "Hey... Dikkatli bakarsan, kabzaya bazı kelimelerin kazınmış olduğunu görebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050420,
					"content": "Kelimeleri okuyabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050421,
					"content": "Şöyle yazıyor: \"Erdem ve Adalet.\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050422
					]
				},
				{
					"id": 20050422,
					"content": "\"Erdem ve Adalet\" mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050423
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050423,
					"content": "Görünüşe göre bu iki kelime her şeyi açıklıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050424
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050424,
					"content": "Başkalarını mutlu etmek için sonsuz borçların altına girmek. Sanırım bu, en büyük tutkum olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050425
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050425,
					"content": "İyi ama erdem ve adaletin ne faydası var? İhtiyacı olanlar için erzak satın aldım ama olayın nasıl sonuçlandığına bir bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050426
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050426,
					"content": "Tenryou Heyeti, Önsezimi elimden aldı ve benim deli gibi yardım etmeye çalıştığım insanlar beni anlamayı reddetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050427
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050427,
					"content": "En ironik olan şey ise onlara kılıcı çektiğimde yine de kendimi kötü hissettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050428
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050428,
					"content": "İyi bir insan olamıyorum... Ama aynı şekilde kötü de olamıyorum. Ne yapacağımı şaştım kaldım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050429
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050429,
					"content": "Dertli bir ruh daha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050430,
					"content": "Fırsat olduğunda Thoma ile Kurosawa'nın borcunu konuşalım. Yashiro Heyeti, onun masraflarının karşılanmasına yardımcı olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050431,
					"content": "Ne olursa olsun, o kılıcı satmasına asla izin vermemeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050432,
						20050433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050432,
					"content": "Bir Önseziyi kaybetmek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050434,
					"content": "Evet, insanın bütün tutkusunu kaybetmesi korkunç bir deneyim olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050435,
					"content": "Neyse ki senin bir Önsezin yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050436
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050436,
					"content": "Gidip bir sonraki zavallı ruhu bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050433,
					"content": "... Hiç de hafife alınacak bir konu değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050434
					]
				},
				{
					"id": 20050412,
					"content": "Ona bir bakmamızda sakınca var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050413
					]
				}
			]
		},
