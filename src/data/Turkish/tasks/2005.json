					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050802
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050802,
					"content": "Tüm bu samuray evleri, erzaklarla dolu, haha! Gerçekten turnayı gözünden vurduk. O evin dışında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050803
					],
					"speakerTitle": "Ken"
				},
				{
					"id": 20050803,
					"content": "Henüz daha bir şey görmedin, bunun geldiği yerde çok daha fazlası olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050804
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050804,
					"content": "Bugün sadece bir başlangıç. Hepinizi istifçi tarihine geçecek destansı bir yağmalama ve talan yolculuğuna çıkaracağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050805
					],
					"speakerTitle": "Tadao"
				},
				{
					"id": 20050805,
					"content": "Adamsın sen patron!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050806
					],
					"speakerTitle": "Gou"
				},
				{
					"id": 20050806,
					"content": "Sanırım bunlar peşinde olduğumuz Hazine Avcıları. Onlara günlerini gösterelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
