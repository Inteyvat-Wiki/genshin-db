			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Oomori",
					"Yuuya",
					"Kurosawa Kyounosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20050101,
					"content": "Tenryou Heyetinin direkt olarak şogun tarafından yönetildiğini söylüyorlar. Inazuma'da kanun ve düzeni sürdürmekten onlar sorumlular ve Önsezi Avı Fermanını uyguluyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050102,
					"content": "Ama birbirlerine karşı neden harekete geçsinler ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050103,
					"content": "Paimon anlamıyor. O da ne? Sanırım, orada bir kargaşa var. Gidip neler olduğuna bir bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050104,
					"content": "Bir kez daha soracağım. Amacın, bu ayki acil durum erzaklarını alıkoymak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050105
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050105,
					"content": "Bütün klanın tek güvencesi bu yiyecekler. Bir açıklama istiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050106
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050106,
					"content": "Daha kaç kez söylemem gerekiyor? Acil durum erzakları hakkında hiçbir şey bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050107
					],
					"speakerTitle": "Kurosawa Kyounosuke"
				},
				{
					"id": 20050107,
					"content": "Bizi kandırmaya çalışıyorsun! Bu erzaklar çok önemli, anlıyor musun? Bunlar, öyle açgözlü bir samurayın cebine indireceği türden şeyler değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050108
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050108,
					"content": "Siz samuraylar, ne isterseniz yapabileceğinizi mi sanıyorsunuz? Tenryou Heyeti bunu öğrenecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050109
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050109,
					"content": "Acil durum erzakları... Acil durum yiyecekleri gibi bir şey mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20050110
					]
				},
				{
					"id": 20050110,
					"content": "Hey! Sen de kimsin? Kurosawa'nın grubundan biri olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050111
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050111,
					"content": "Ne? Biz sadece buradan geçiyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050112,
					"content": "Kargaşayı duyduk ve olan bitenleri görmek için geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050113,
					"content": "Anladım, bence tam zamanında geldin. Belki de bu meseleyi çözmemize yardım edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050114
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050114,
					"content": "Bu Kurosawa, kendisi bir samuray ve Şogun'un Ordusunun bir üyesi. Ordu, bölgeye acil durum erzakları gönderiyor ve o da dağıtımdan sorumlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050115
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050115,
					"content": "Eskiden erzaka ihtiyacımız olduğunda ondan istememiz yeterliydi. Şimdi ise durduk yere bize hiçbir şey vermiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050116
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050116,
					"content": "Erzakları kendisine saklıyor, biliyorum! Erzaklar olmazsa açlıktan ölürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050117
					],
					"speakerTitle": "Oomori"
				},
				{
					"id": 20050117,
					"content": "Görünüşe göre kimse bizi umursamıyor... Kurosawa'nın iyi biri olduğunu sanırdık ama bize gerçek yüzünü gösterdi. O da diğer samuraylar gibiymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050118
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050118,
					"content": "Tüm Önsezilere el konulmasına şaşırmamak gerek. Şogun Raiden'ın, ülke yönetiminde onun gibi insanların yardımına ihtiyacı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050119
					],
					"speakerTitle": "Yuuya"
				},
				{
					"id": 20050119,
					"content": "Bu, Ayaka'nın yardım etmemizi istediği kişilerden biri olmalı. Ama neden onun gibi birine yardım etmemizi istesin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20050120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20050120,
					"content": "Belki de Kurosawa ile konuşup söyleyeceklerini dinlesek iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 200502,
			"completionStepIds": [
				200503
