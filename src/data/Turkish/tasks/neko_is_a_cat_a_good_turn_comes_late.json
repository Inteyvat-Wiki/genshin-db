				"points": []
			},
			"dialogs": [
				{
					"id": 722160101,
					"content": "Gelmişsiniz. Taş insan, işinin neredeyse bittiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160102,
					"content": "Gelin benimle. Taş insan hemen şu tarafta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7221602,
			"completionStepIds": [
				7221602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"2"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei",
					"Neko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160201,
					"content": "Neredeyse bitti işim. Yaptığım en büyük eserlerden biriydi bu galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160202
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160202,
					"content": "Ah, hoş geldiniz. Leydi Rahibe de gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160203
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160203,
					"content": "Nasıl gidiyor? Heykel tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160204
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160204,
					"content": "Bitti evet, gördüğünüz gibi, hehe! Aslında şuranın bir kısmını henüz yontmadım. Leydi Rahibe gelince son dokunuşu öyle yaparım dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160205
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160205,
					"content": "Çok düşünceli bir hareket.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160206
					]
				},
				{
					"id": 722160206,
					"content": "Tabii ki. Söz konusu tapınak heykelleri olunca saygıda kusur edilmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160207
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160207,
					"content": "Miyav miyav, taş dövmek ne zaman bu kadar önemli oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160208
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160208,
					"content": "Nasıl söylesem... Heykelini yaptığımız şeylerin hepsi önemlidir genelde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160209
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160209,
					"content": "Bu arada yemek heykeli yaptırmayı düşünebilirsin sen de Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160210
					]
				},
				{
					"id": 722160210,
					"content": "Hey! Çok ayıp!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722160211,
					"content": "Yani... İyi şeylerin heykellerini yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160212
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160212,
					"content": "Hahaha! Sadece \"iyi\" demek yetmez! Heykeller bir nevi \"ebedi anıtlardır\" sonuçta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160213
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160213,
					"content": "Hayır, hayır. Bu \"ebedi anıt\" değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160214
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160214,
					"content": "Hibiki dönmek isteyip de yolunu bulamazsa diye bu heykele bakabilsin istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160215
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160215,
					"content": "Böylece nereye gideceğini bilecek ve yolunu kaybetmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160216
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160216,
					"content": "Ah, anlıyorum. \"Hibiki\"yi bayağı önemsiyorsunuz demek Leydi Rahibe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160217
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160217,
					"content": "Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160218
					]
				},
				{
					"id": 722160218,
					"content": "Hibiki her an dönebilir sonuçta. Hibiki ve Domeki bu taş tamamlandığında iyi bir şeyin olacağını söylemişlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160219
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160219,
					"content": "Peki öyleyse taş insan. Benden başka bir arzun var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160220
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160220,
					"content": "Yok, hayır... Madem siz de buradasınız, artık son taş parçasını da keskimle yontabilirim Leydi Rahibe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160221
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160221,
					"content": "Üç... İki... Bir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160222
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160222,
					"content": "Bu bulut da ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160223,
						722160224
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160223,
					"content": "Kedi suretine dönüştü bir anda.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				},
				{
					"id": 722160225,
					"content": "Bu Hibiki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160226
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160226,
					"content": "Ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160227
					]
				},
				{
					"id": 722160227,
					"content": "Hibiki mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160228
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160228,
					"content": "Miyav miyav miyav! Kesin Hibiki'nin işiydi bu! İyi bir şey oldu, aynen söylediği gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160229
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160229,
					"content": "Aynen böyle demişti bana, böyle söylemişti! Taş tamamlanırsa iyi bir şey olacak demişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160230
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160230,
					"content": "Harika bu, muhteşem! Söylediği doğruymuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160231
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160231,
					"content": "Evet, kesinlikle dönecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160232
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160232,
					"content": "Ya... Yaşasın! Hahaha, ne olup bittiğini anlamadım ama Leydi Rahibe mutlu olduysa cidden iyi bir şeyler oluyor galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160233
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160233,
					"content": "Neko...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160234
					]
				},
				{
					"id": 722160234,
					"content": "Sayenizde tapınak eskisi kadar güzel oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160235
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160235,
					"content": "Bağış Kutusu onarıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160236
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160236,
					"content": "Dua Rafı onarıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160237
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160237,
					"content": "Taş da tamam! Artık Hibiki kesin döner, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160238
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160238,
					"content": "Domeki, Janome, hatta Hibiki'nin diğer bütün arkadaşları! Onlar da kesin Hibiki'yle dönerler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160239
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160239,
					"content": "Sen... İyi birisin! O yemekten de iyisin! Hibiki seni çok sevecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160240
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160240,
					"content": "Veletleri toplayıp Hibiki'nin dönüşü için planlar yapmam lazım. Bir de... Evet, tapınağı ziyarete gelecek bir sürü insan için de... Onlarla ilgili talimatlar da vermem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160241
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160241,
					"content": "Çözülmesi gereken başka mevzular da var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160242
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160242,
					"content": "Ah, Hibiki... miyav miyav, miyav! Harika bu, muhteşem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722160224,
					"content": "Neler oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				}
			]
		},
		{
			"id": 7221603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ooshima Junpei"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160301,
					"content": "Haha, Leydi Rahibe'nin ağzı kulaklarında. Bu \"Hibiki\" cidden çok önemli biri olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160302
					],
					"speakerTitle": "Ooshima Junpei"
				},
				{
					"id": 722160302,
					"content": "Sorun şu ki, nerede olduğunu bilmiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7221604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eiko",
					"Taisuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160401,
					"content": "Aynen öyle. \"Hibiki\", \"Asase Tapınağı\", \"Domeki\"... Aslında bu isimlerin hepsi oldukça endişe verici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160402,
						722160407
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160402,
					"content": "Siz ikiniz nereden çıktınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160403
					]
				},
				{
					"id": 722160403,
					"content": "Çıkardığınız curcunayı görünce tabii gelecektik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160404
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160404,
					"content": "Yine de bilmeniz gereken bir şey olduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160405
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160405,
					"content": "Taisuke, önden sen buyur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160406
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160406,
					"content": "Tabii, elbette Eiko Hanım. Seirai Adası ile ilgili konuşmak istiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160408,
					"content": "Buranın geçmişi biraz sıkıntılı. Loncanın burayla alakalı istihbarat çalışmaları sonucunda çok az bilgiye ulaşabildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160409
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160409,
					"content": "Elde ettiğimiz bilgilere göre yüzyıllar önce burası korsanların buluşma noktasıymış. Sonra Şogunluk burayı korsanlardan temizlemiş ve burada yaşayanları da başka yere götürmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160410,
					"content": "Yanlışım yoksa bu bahsettiğimiz \"Domeki\", Şogunlukla kafa kafaya çarpışan korsan lideri \"Ako Domeki\" olabilir. Adı kayıtlarda açık bir şekilde geçiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160411
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160411,
					"content": "Yine aynı bilgilere göre söz konusu Ako Domeki, Şogunlukla yaptığı deniz savaşında korsan filosuna liderlik etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160412
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160412,
					"content": "Hızlıca bastırılıp Seirai Adası'na kaçmak zorunda kalmışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160413
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160413,
					"content": "Şogunluk filosu bunları takip ederken Seirai Adası'nda bir anda fırtına çıkmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160414
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160414,
					"content": "Ako Domeki ve Şogunluğun filolarının hepsi bir anda ortaya çıkan fırtınaya yakalanmış. Sonunda hepsi kaybolmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160415,
					"content": "Bir fırtına...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160416
					]
				},
				{
					"id": 722160416,
					"content": "Buradan sonrasına ben devam ederim. Buradaki en büyük gizem, elbette bir anda ortaya çıkan fırtına.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160417
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160417,
					"content": "Ako Domeki'nin fırtınaya yakalanan filosu neredeyse tamamen yok olmuş. Şogunluğun yolladığı filonun fırtınaya yakalanan kısmından kimse sağ kalmamış, geride kalanlar da Narukami Adası'na çekilmek zorunda kalmış. Filonun tekrar toparlanması oldukça uzun sürmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160418
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160418,
					"content": "Anlayacağın fırtınanın zamanlaması tesadüf olamayacak kadar iyi. Sanki birileri fırtınayı kontrol ediyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160419
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160419,
					"content": "Bu adadaki Koruyucu Taşları hatırlarsın. Birisi bu taşların mühürlerini kaldırmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160420
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160420,
					"content": "Tekrar mühürlediğimizde ise adadaki fırtına dinmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160421
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160421,
					"content": "Hemen bir sonuca varmayacağım ama içimde bir his bu iki olayın kesinlikle bağlantılı olduğunu söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160422
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160422,
					"content": "Leydi Neko'ya sorabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160423
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160423,
					"content": "Aman, uğraştığına değmez. Kayıtlar Domeki'nin kaybolduğunu söylüyor. Kayıtlarda böyle tabii ama, o fırtınaya yakalandıysa muhtemelen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160424
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160424,
					"content": "Bir süre bu adayı keşfetmeye ve olaylar hakkında bilgi toplamaya devam edeceğiz. Sonrasında Loncaya rapor veririz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160425
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160425,
					"content": "Kim bilir? Belki de gelecekte yeniden birlikte çalışma zevkine erişiriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160426
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160426,
					"content": "Dört gözle bekliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160427
					]
				},
				{
					"id": 722160427,
					"content": "Duygularımız karşılıklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160428
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160428,
					"content": "Taisuke, hadi hazırlan. Keşfetmemiz gereken bir ada var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160429
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160429,
					"content": "Şey, Eiko Hanım... Leydi Neko hakkında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160430
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160430,
					"content": "O kediye daha önce nasıl davranıyorsan öyle davranmaya devam edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160431
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160431,
					"content": "Tabii söylememen gereken hiçbir şeyi ağzından kaçırma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160432
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160432,
					"content": "Şu anda halinden çok memnun. Onu üzmek istemezsin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160433
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160433,
					"content": "Anladım. Haha Eiko Hanım, siz gerçekten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160434
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722160434,
					"content": "Yalnızca görevlerimizi daha hızlı bitirmeye çalışıyorum. Hadi işe koyulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160435
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160435,
					"content": "Seirai Adası... Görünüşe göre bu ada hâlâ sırlarla dolu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722160407,
					"content": "Bir şey biliyor musunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160408
					]
				}
			]
		}
	]
}