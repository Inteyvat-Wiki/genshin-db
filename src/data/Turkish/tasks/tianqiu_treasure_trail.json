					"nextDialogs": [
						718120207
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718120207,
					"content": "Bu işi çözdüğün için teşekkür ederiz. Maceracı kuralları gereğince bulduğun nesne senindir. Ödül de senin tabii ki.",
