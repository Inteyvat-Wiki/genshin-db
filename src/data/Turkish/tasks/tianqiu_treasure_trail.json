					"nextDialogs": [
						718120208
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718120208,
					"content": "Dunyu Harabeleri'ni daha kapsamlı araması için birini görevlendireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120209
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 718120209,
					"content": "Ne kadar tuhaf... Dunyu Harabeleri'ni kaç kez baştan sona aradık... Bu nasıl gözümüzden kaçtı?",
					"roleType": "TALK_ROLE_NPC",
