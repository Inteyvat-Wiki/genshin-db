					"nextDialogs": [
						733430203
					]
				},
				{
					"id": 733430203,
					"content": "Elbette birçok Pari, Sunyata Çiçeklerini nasıl canlandıracaklarını biliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430204
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430204,
					"content": "Kısaca açıklamak gerekirse, Apaosha'nın Alameti ortadan kalkmış olsa da bu Sunyata Çiçeği henüz aşınmadan kurtulamadı ve hâlâ çok güçsüz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430205
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430205,
					"content": "Diğer çiçek göletleri de kurtulamamış. Bu Sefana'yı çok üzmüş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430206
					],
					"speakerTitle": "Sorush"
				},
				{
					"id": 733430206,
					"content": "Bu Sefana dediğin Pari, çiçeklere bakmak için çok çalışan iyi bir Pari olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430207,
					"content": "#Gidip ona yardım edelim mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733430208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733430208,
					"content": "Benim için zor bir iş değil. Hem Sefana'ya da yardımı olur. Yasnapatim, lütfen gözün bu Sunyata Çiçeklerinde olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
