			"dialogs": [
				{
					"id": 766580101,
					"content": "Ginette! Bulduğumuz bütün robotları aldın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580102,
					"content": "Evet! Çok iyi iş çıkardınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580103
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580103,
					"content": "Bu arada, bazı yeni şeyler keşfettik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580104,
					"content": "Öyle mi? Lütfen her şeyi anlatın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580105
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580105,
					"content": "Paimon ile birlikte Ginette'e kısa süre önce gördüklerinizden bahsediyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766580106
					]
				},
				{
					"id": 766580106,
					"content": "Anlattığın davranışlar... Robotların sizi çok sevdiğini ve bir mesaj ilettiklerini gösteriyor. Sizi birlikte \"oyun oynamaya\" davet etmişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580107
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580107,
					"content": "Gerçekten mi? Vay canına, bu çok güzel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580108,
					"content": "Hımm... Biliyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580109
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580109,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580110,
					"content": "Artık eminim ki hayalim ancak bu robotların arasındaki etkileşimler sayesinde gerçekleşebilir. Ne kadar fazla birim kurtarabilirsek, asıl planıma o kadar yaklaşabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580111
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580111,
					"content": "Başkalarıyla iletişim kurabiliyorlar demek. O zaman tek yapmamız gereken kalan robotları bulmak... Evet! Yaratıcılığımın meyvelerini toplayabileceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580112
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580112,
					"content": "Şuna bakın, birileri bayağı heyecanlandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 766580113,
					"content": "Ah, kusura bakmayın! Kendimi biraz kaptırdım... Kalanlar için hâlâ yardımınıza ihtiyacım var. İşte, sonraki bölgeyi haritada işaretledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766580114
					],
					"speakerTitle": "Ginette"
				},
				{
					"id": 766580114,
					"content": "Hadi gidelim! Paimon da bu işin nereye gideceğini merak ediyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
