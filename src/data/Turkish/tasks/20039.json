			"dialogs": [
				{
					"id": 200390401,
					"content": "Yıldırım Özütü yaparak başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390402
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390402,
					"content": "Temel bir simya ürünü. Başlamak için ideal.",
