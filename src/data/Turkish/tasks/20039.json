					"nextDialogs": [
						200390403
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 200390403,
					"content": "Yıldırım Özütü yapmak için önce biraz elektrik kristali ve bir kurbağa gerekiyor.",
