			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Augustus Lovelace"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500301,
					"content": "Hiç fena değil. Yeteneklisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500302
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500302,
					"content": "Seyahatlerim boyunca ilk kez kompozisyona ve renklere bu kadar hakim biriyle karşılaşıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500303
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500303,
					"content": "Nerelere seyahat ettin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500304
					]
				},
				{
					"id": 733500304,
					"content": "Ha, şey... Sumeru'ya doğrudan Fontaine'den gelebilirdim... Ne de olsa Sumeru'da doğrudan Bayda Limanı'na giden bir hat var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500312
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500312,
					"content": "Ama ne demişler, önemli olan hedef değil yolculuktur... Ben de o yüzden daha ilginç bir rota seçtim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500313
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500313,
					"content": "Önce Lumidouce Limanı'ndan Chenyu Vadisi'ne geçtim. Sonra Qingce Köyü'nden geçip Mondstadt ve Liyue arasında sınır olan Taş Geçit'e vardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500310
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500310,
					"content": "Şafak Şaraphanesine uğradıktan sonra güneye gidip Liyue Limanı'nı ziyaret edeyim dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500305
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500305,
					"content": "Liyue Limanı'ndan Ormos Limanı'na giden vapura bindim. Daha sonra nehir boyunca kuzeye doğru gittim ve şimdi de buradayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500306
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500306,
					"content": "Sonuçta amacım rahatlamaktı. Maceracı, cesur bir savaşçı olsaydım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500311
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500311,
					"content": "... Romaritime Limanı'ndan yola çıkıp seyyahların kadim yolunu takip edebilir, oradan da güneydeki çöle doğru gidebilirdim aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500307
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500307,
					"content": "Kim bilir? Belki dönüşte çölden geçerim. Hâlâ fazladan Moram var, çölün diğer yakasındaki Natlan'ı ziyaret etmek iyi bir fikir gibi geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500308
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500308,
					"content": "Seni daha fazla oyalamayayım. Fotoğraf konusunda yardımcı olduğun için sağ ol. Minnettarlığımın bir göstergesi olarak lütfen bunu kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500309
					],
					"speakerTitle": "Augustus Lovelace"
				},
				{
					"id": 733500309,
					"content": "Gidip Xavier'e yazayım. Eğer hâlâ Sumeru'ya gelmek istemiyorsa bari ben Fontaine'e döneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Augustus Lovelace"
				}
			]
		},
