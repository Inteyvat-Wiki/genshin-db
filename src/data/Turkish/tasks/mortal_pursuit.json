			"dialogs": [
				{
					"id": 150220301,
					"content": "Chasca, nihayet döndünüz! Kabilede işler kızışıyor iyice. Soruşturmanda ilerleme katedebildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220302
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220302,
					"content": "Bazı insanlar sırf Filojiston Kanatlarını toplatıp hava bölüğünü desteklemek için tüccarları tutukladığımızı düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220303,
						150220304
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220303,
					"content": "Tüccarları tutuklamamıza rağmen işler hâlâ kızışıyorsa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				},
				{
					"id": 150220305,
					"content": "Önemli ipuçları bulduk ama ihtiyacımız olan net kanıtla aramızda ciddi bir engel var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220306
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220306,
					"content": "Chasca, Tepal hakkında öğrendiklerinizi ve uçan atölyeye dair fikirlerinizi açıklar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220307
					]
				},
				{
					"id": 150220307,
					"content": "Kül Şehir'den bir yadigar mı? Of... Demek bunca yıldan sonra bile Och-Kan ihtilafa yol açıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220308
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220308,
					"content": "Uçan bir atölye demek... Ve imtihan arenasının üzerinde bir sıcak hava balonu diyorsunuz... Şu an o balona ulaşmanız mı gerek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220309
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220309,
					"content": "Oraya nasıl çıkabiliriz, bir fikrin var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220310
					]
				},
				{
					"id": 150220310,
					"content": "Filojiston Kanatları ya da Gukuzorlar sizi o kadar yükseğe çıkaramaz. Tepal sizce orada mı saklanıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220311
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220311,
					"content": "Hımm... Aslında... Bir fikir geldi aklıma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220312
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220312,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220313,
					"content": "Arenadaki olukları hatırlıyor musunuz? Onlar tıkanıkken Gaz Filojiston sıkışmıştı, akamıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220314
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220314,
					"content": "Ama şimdi serbestçe akıyor. Eğer olukları tekrar tıkarsak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220315
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220315,
					"content": "Yani... Arenanın en tepesindeki hariç, değil mi? Tüm basıncı oraya mı toplayalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220316
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220316,
					"content": "Aynen öyle. Tüm Gaz Filojiston tek bir oluğa akarsa yüksek basınçlı bir rüzgar akımı oluşturabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220317
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220317,
					"content": "Sonra da o akıma girip yükseliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220318,
					"content": "Evet. Riskli tabii ama Chasca yetenekleriyle üstesinden gelebilir bence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220319
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220319,
					"content": "Çok riskli bir fikir... Ama işe yaraması mümkün, evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220320
					],
					"speakerTitle": "Allpa"
				},
				{
					"id": 150220320,
					"content": "Denemek isterseniz imtihan alanında Inkanak ile konuşun. Olukları nasıl tıkayacağınızı anlatır o size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220321
					],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220321,
					"content": "Chasca... Bu kanıtı gökten bize getirebilecek biri varsa o da sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mutota"
				},
				{
					"id": 150220304,
					"content": "... İnsanları kışkırtan başkaları da olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220305
					]
				}
			]
		},
