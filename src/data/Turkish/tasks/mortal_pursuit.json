					"nextDialogs": [
						150220506
					]
				},
				{
					"id": 150220506,
					"content": "İnsanlara fazla yaklaşmak istememiştir... Ya da benim yüzümdendir belki. Ama şu an ona ihtiyacımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220507
					],
