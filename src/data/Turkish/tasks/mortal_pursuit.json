					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220510
					],
					"speakerTitle": "Coya"
				},
				{
					"id": 150220510,
					"content": "Evet, yukarıdaki şu yere... Chime muhtemelen orada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220511
					],
					"speakerTitle": "Chasca"
				},
