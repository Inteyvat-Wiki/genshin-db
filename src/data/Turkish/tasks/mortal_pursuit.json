			"dialogs": [
				{
					"id": 150221101,
					"content": "Aceleyle imtihan arenasına gidip durumu Inkanak'a anlatıyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150221102
					]
				},
				{
					"id": 150221102,
					"content": "Vay be... Çok cüretkar bir fikir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221103
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221103,
					"content": "Evet ama çabuk olmamız lazım. Olukları tıkamanın en hızlı yolu nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221104,
					"content": "Teknik açıdan bakarsak önce bazı ölçümler yapıp dikkatle planlamanız gerektiğini söylerdim... Ama sanıyorum duymak istediğiniz cevap bu değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221105
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221105,
					"content": "Anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221106
					]
				},
				{
					"id": 150221106,
					"content": "... O halde daha hızlı ve kaba bir yöntem kullanmamız gerekecek. Şuradaki Katı Filojistonu görüyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221107
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221107,
					"content": "İncelemelerimiz o Filojistonun içinde stabil bir yapı oluştuğunu ve hasara epey dayanıklı hale geldiğini gösterdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221108
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221108,
					"content": "Zayıf noktaları da var tabii fakat o noktalara aynı anda vurulmadığı sürece Katı Filojistonun yapısal bütünlüğü bozulamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221109
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221109,
					"content": "Peki... Hepsine aynı anda vurursak ne olacak yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221110,
					"content": "Çökecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221111
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221111,
					"content": "... Aklından geçeni anladım galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221112
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221112,
					"content": "Evet evet, anladın! Doğru açıdan tüm zayıf noktalara aynı anda vurursanız Katı Filojiston tam oluğun üzerine düşer ve onu tıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221113
					],
					"speakerTitle": "Inkanak"
				},
				{
					"id": 150221113,
					"content": "\"Hızlı ve kaba\" derken haklıymışsın... Tam benlik bir plan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				}
			]
