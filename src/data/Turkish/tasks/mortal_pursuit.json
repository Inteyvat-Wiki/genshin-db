			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Puma",
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1374.526,
							169.17,
							7678.847
						],
						"pointId": 350400214
					}
				]
			},
			"dialogs": [
				{
					"id": 150220201,
					"content": "Kısa bir süre sonra, Xilonen'in atölyesinde...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220202
					]
				},
				{
					"id": 150220202,
					"content": "Döndüm. Sizi Tepal'in annesi Puma ile tanıştırayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220203
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220203,
					"content": "Merhabalar! Biz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220204,
					"content": "Hoşbeşi geçelim. O çocukla ilgili gerekenden fazlasını konuşmaya vakit harcamak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220205
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220205,
					"content": "... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220206,
					"content": "Onu uzun zaman önce evlatlıktan reddettim... Oğlum değil artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220207
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220207,
					"content": "Gökyüzüne ulaşma hayalinden başka bir şey düşündüğü yoktu... Akıl mantık aşılamaya çalıştık kendisine ama nafile, takmıştı kafayı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220208
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220208,
					"content": "Hıh... Sonra bizi terk edip gökyüzünde atölye kuracağını, biz yeryüzü sakinlerinin eleştirilerinden uzakta çalışacağını falan söyleyip bir şeyler saçmaladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220209
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220209,
					"content": "Arkasında da defterini bıraktı. Artık ne sorunuz varsa cevabını defterde arayabilirsiniz. Ben artık konuşmak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220210
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220210,
					"content": "Oğlum falan değil o benim... Zaten bana bir kere \"anne\" demişliği de yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220211
					],
					"speakerTitle": "Puma"
				},
				{
					"id": 150220211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220212
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220212,
					"content": "Vay be, araları epey bozukmuş... Paimon hiç beklemiyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220213,
					"content": "Kocası, Tepal'in babası... Kısa bir süre önce vefat etti, Tepal cenazeye gelmeye tenezzül etmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220214
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220214,
					"content": "Bana kalırsa Puma için bardağı taşıran son damla bu olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220215
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220215,
					"content": "Ben gidip ona eşlik edeyim. Başka bir ihtiyacınız olursa istemekten çekinmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220216
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220216,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220217
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220217,
					"content": "Peki o zaman, şu an elimizdeki tek ipucu bu defter, değil mi? Ne var acaba içinde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220218,
					"content": "Hımm... Filojiston Kanatlarının ilk tasarımları... Ve bir uçan atölyeye dair teorik fikirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220219
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220219,
					"content": "Ochkanatlan, Kül Şehir... Teknolojik ilhamını oradan almış galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220220
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220220,
					"content": "Gökyüzündeki atölye konusunda ciddi miymiş yani? Ama tek bir kişi için fazla büyük bir proje bu... Sizce başarılı olmuş mudur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220221,
						150220222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220221,
					"content": "Şu balon çizimine baksanıza...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				},
				{
					"id": 150220223,
					"content": "... Aa! Evet! İmtihan arenasında şu çok yüksekteki balon bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220224,
					"content": "O balon bir süredir orada, herkes o kadar yükseğe nasıl çıktığını merak ediyor. Peki... Ya bu soru yanlışsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220225
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220225,
					"content": "Ya aslında çok daha yukarıda, bulutların üzerinde gözden uzak bir yerde başladıysa ve bir arıza yüzünden şu anki yüksekliğe alçaldıysa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220226
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220226,
					"content": "Yani diyorsun ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220227
					]
				},
				{
					"id": 150220227,
					"content": "... O balon Tepal'in atölyesinin bir parçası olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220228,
					"content": "Muhtemel. Tepal'in üssü bunca zamandır bulutların üzerinde saklıysa Isidore'un onu neden bulamadığı belli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220229
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220229,
					"content": "Paimon tahmin etmişti... Ama şey, oraya nasıl çıkacağız ki? Sen o kadar yükseğe uçabilir misin Chasca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220230,
					"content": "Kendi başıma... Muhtemelen evet. Ama bir yolcuyla çıkamam asla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220231
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220231,
					"content": "Filojiston Kanatlarının bile sizi o kadar yükseğe çıkarabileceğini sanmam... En azından Tepal'in defterde bahsettiği şu \"yadigar\" olmadan zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220232
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220232,
					"content": "Evet, o yadigar da ondadır muhtemelen... Başka bir yolunu bulmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220233,
					"content": "Sen oraya uçabilir misin Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220234
					]
				},
				{
					"id": 150220234,
					"content": "Yok, orası Paimon'u çoook aşar! Hem Paimon'un oraya tek başına çıkıp Tepal'i alt edebileceğini mi düşündün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220235
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220235,
					"content": "Merak etmeyin. Biz bir çözüm bulamadıysak başkaları bulur. Kabiledeki tek uçuş uzmanı ben değilim sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220236
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220236,
					"content": "Aa, mantıklı. Gidip Bilge Allpa'ya soralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220237,
					"content": "Mutota'ya da. Zamanında o da ünlü bir uçuş ustasıydı. Dönüp tavsiyelerini isteyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220222,
					"content": "Daha önce bir yerde görmedik mi biz bunu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220223
					]
				}
			]
		},
