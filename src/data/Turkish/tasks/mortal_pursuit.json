			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Xilonen"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1350.876,
							161.634,
							7851.647
						],
						"pointId": 350400213
					}
				]
			},
			"dialogs": [
				{
					"id": 150220101,
					"content": "Allpa'nın dediğine göre Tepal Yankıların Çocuklarındanmış. Peki nasıl bulacağız onu? Acaba... Denk gelene kadar insanlara mı sorsak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220102,
					"content": "Tanıdığımız birine soralım önce. Öyle daha hızlı olur. Şu an burada en kolay bulabileceğimiz kişi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220103
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220103,
					"content": "Uyan Xilonen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220104
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220104,
					"content": "*esner* Ha, siz miydiniz... Of, peki... Bekleyin, geliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220105
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220105,
					"content": "*esner*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220106
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220106,
					"content": "İkiniz de ağaçlara tırmanmayı seviyorsunuz galiba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220107
					]
				},
				{
					"id": 150220107,
					"content": "Ben ağaçlara daha uzun mesafe uçup daha uzağı görebilmek için tırmanıyorum. Genelde uyumak için kullanmıyorum yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220108
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220108,
					"content": "Hepimiz senin gibi tüm gün uçup hâlâ enerji dolu gezmiyoruz etrafta... Neyse. Bunca yol gelip mis gibi uykumu böldünüz. Nedenini sorabilir miyim acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220109
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220109,
					"content": "Kusura bakma Xilonen ama biraz acil. \"Tepal\" adı tanıdık geliyor mu sana? Zanaatkarmış sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220110
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220110,
					"content": "Tepal mi? Evet, tanıdık geldi... Sanırım Puma'nın oğlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220111
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220111,
					"content": "Şu an kabilede mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220112
					]
				},
				{
					"id": 150220112,
					"content": "Hayır, korkarım birkaç yıl geç kaldınız... Niye arıyorsunuz ki onu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220113
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220113,
					"content": "Uzun hikaye...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150220114
					]
				},
				{
					"id": 150220114,
					"content": "Yaşananları kısaca anlatmaya çalışıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150220115
					]
				},
				{
					"id": 150220115,
					"content": "\"Filojiston Kanatları\" mı? Vay be. Çocuk harbiden başardı demek... Peki o zaman, benim bugünlük dinlenme hakkım bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220116
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220116,
					"content": "Başardı mı? Daha önce de benzer bir şey yapmayı denedi mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150220117,
					"content": "Evet, Çiçek Tüyü Klanından döndükten sonra bir uçuş makinası üretmeye çalıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220118
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220118,
					"content": "Kanatsız olduktan hemen sonra yani... Bu uçuş makinası senin bana yaptığın silaha mı benziyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220119
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150220119,
					"content": "Ehlileştirmesi en mağrur Gukuzordan bile daha zor olan silahından mı bahsediyorsun? Hayır, doğuştan yetenekli olmayanların bile özgürce uçabileceği bir şey yapmak istedi o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220120
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220120,
					"content": "Ama... O zamanlar pek ilerleme katedemedi. Birkaç defa atölyesini havaya uçurdu, kendini de zar zor kurtardı. Ondan sonra ne yapıp ettiğiyle pek ilgilenmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220121
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220121,
					"content": "Ebeveynleri gençliklerinde çok seyahat etmiş, kabileye de o doğduktan sonra döndüler. Ama uzak bir bölgeye yerleştiler, başka insanlarla pek görüşmüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220122
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220122,
					"content": "Dolayısıyla kabiledekiler onları pek tanımıyor... Bence doğrudan ailesiyle konuşmayı deneyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150220123
					],
					"speakerTitle": "Xilonen"
				},
				{
					"id": 150220123,
					"content": "Ben gidip Puma'yı getireyim. Atölyenin önünde bekleyin, uzun sürmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xilonen"
				}
			]
		},
