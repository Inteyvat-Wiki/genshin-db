					"nextDialogs": [
						150221302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221302,
					"content": "En azından tek parça geldik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221303
					]
				},
				{
					"id": 150221303,
					"content": "Hah... Tam da tahmin ettiğim gibi. Dışarıdan bakınca sıradan bir sıcak hava balonuna benziyor ama epey bir değiştirildiği yakından belli oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221304
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221304,
					"content": "Ve gerçekten de sırf özel yapım makinaları arıza yaptığı için bulutların altına kadar alçalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221305
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221305,
					"content": "Arızanın ne olduğunu anladın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150221306
					]
				},
				{
					"id": 150221306,
					"content": "Tepal'in defterine başvurarak öğrenirim. Ben de kendi silahlarım arıza yaptığında onları tamir ede ede biraz pratik bilgi kazandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221307
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221307,
					"content": "Hımm... Oldu bence. Şimdi şöyle sağlam bir tekme lazım sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221308
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150221308,
					"content": "Iı... Tekme belki silahlarında işe yarıyor olabilir ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150221309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150221309,
					"content": "Hı? Hareket ediyoruz!",
					"roleType": "TALK_ROLE_NPC",
