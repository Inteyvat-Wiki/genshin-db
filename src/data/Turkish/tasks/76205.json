			"dialogs": [
				{
					"id": 762050101,
					"content": "Saate bak! Ne yapacağım ben şimdi... Her an gelebilirler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050102
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050102,
					"content": "Selam Nicole, biz geldiiiik! Hey, bizi neden dışarı itiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050103,
					"content": "Ay, pardon... Kusura bakmayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050104
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050104,
					"content": "Henüz hazır değil misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050105
					]
				},
				{
					"id": 762050105,
					"content": "Nasıl anlatsam... Hay aksi, korkarım bunu pek net açıklayamayacağım. Size her şeyi baştan anlatmam gerekecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050106
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050106,
					"content": "Her şey, büyücülerin Rüzgar Hükümdarı'na ilk kez meydan okumasıyla başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050107
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050107,
					"content": "Nicole, o... Çok ama çok uzun zaman önceydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050108,
					"content": "Of, bu hiç adil değil! Bunu benim ağzımdan duymak zorunda kalmanız çok utanç verici... Hayır! Yapacak bir şey yok, gerçekler ortada... Alice bunu duymadığı sürece kimsenin gülmesi için bir sebep yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050109
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050109,
					"content": "Eyvah, kendi kendine söyledikleri yine dışarı sızıyor... Ayrıca teknik olarak kendi \"ağzından\" da çıkmıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050110,
					"content": "Şşş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050111
					]
				},
				{
					"id": 762050111,
					"content": "Tüyleri çalışma odasının en tepesine saklamaya karar verdim. Eğer işleri zorlaştırırsam daha büyük bir başarı hissi olacağını düşündüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050112
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050112,
					"content": "Ama bu özgür rüzgarları kontrol etmekte pek iyi değilim. Ancak belli bir yüksekliğe uçabiliyorum, sonra görünmez bir tavana çarpıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050113
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050113,
					"content": "Tüyleri aşağı büyüyle indiremez misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050114,
					"content": "O zaman ne eğlencesi kalır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050115
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050115,
					"content": "Aa, Paimon ne demek istediğini anladı... Hımm, bu gerçekten zor bir durummuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050116,
					"content": "Nicole, bir şeyler söylemeyi deneyebilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050117
					]
				},
				{
					"id": 762050117,
					"content": "Ne söylememi istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050118,
						762050119
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050118,
					"content": "Simulanka'da kelimeler büyülüdür.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				},
				{
					"id": 762050120,
					"content": "Aa! Ne demek istediğini anladım! Pekala, bir deneyeyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050121
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050121,
					"content": "Of, bu hiç adil değil! Bunu benim ağzımdan duymak zorunda kalmanız çok utanç verici...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050122
					]
				},
				{
					"id": 762050122,
					"content": "Neyse! Yapacak bir şey yok, gerçekler ortada...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050123
					]
				},
				{
					"id": 762050123,
					"content": "Alice bunu duymadığı sürece kimsenin gülmesi için bir sebep yok...",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				},
				{
					"id": 762050119,
					"content": "Belki merdivene dönüşecek bir şeyler söyleyebilirsin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				}
			]
		},
