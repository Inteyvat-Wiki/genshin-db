			"dialogs": [
				{
					"id": 762050301,
					"content": "Hazine! Vuhuuu, çok eğlenceli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050302,
					"content": "Ama... Paimon'un başı fena zonkluyor. Nicole'un sırf şu merdiveni ortaya çıkarmak için o kadar yüksek sesle bağırması gerekiyor muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050303,
					"content": "Hayırdır? Şikayet mi ediyorsun? Benim gibi güçlü bir büyücünün parmaklarını şıklatıp o yeni hazinelerinizi turplara çevirmesinden endişelenmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050304,
						762050305
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050304,
					"content": "P-Paimon öyle demek istemedi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050306
					]
				},
				{
					"id": 762050306,
					"content": "Hehe, takılıyorum size. Her küçük kusurunuzun çetelesini tutan o sessiz, somurtkan meleklerden olmadığımı anlamışsınızdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050307
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050307,
					"content": "#... Ve böylece nihayet hesaplaşma günü geldiğinde {NICKNAME} ile Paimon yedi katlı merdivenden çıktılar ve tanıdık bir simayla karşılaştılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050308
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050308,
					"content": "Işıldayan alevler birleşerek sırtında kanatlar oluşturdu. Yüzü, ilk tanıştıkları günkü kadar asil ve güzeldi ama gözleri artık acımasız bir ışıkla parlıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050309
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050309,
					"content": "#\"Ama neden?\" diye sordu {NICKNAME} ve Paimon tek bir ağızdan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050310
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050310,
					"content": "\"Her şey Paimon'un çok yüksek sesle bağırdım diye şikayet ettiği gün başladı!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
