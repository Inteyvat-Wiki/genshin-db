			"dialogs": [
				{
					"id": 762050201,
					"content": "Vay be, ne kadar büyük bir boşluk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 762050202,
					"content": "Her şey olabilir bir rehber... İlahi isimlerle doludur... Kutsal metinler! Kelimeler ve bölümler... İç içe geçer... Ve uyum içinde çalışır melekler! Bu kutsal mekanda, bırak döşesin önündeki yolu kelimeler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050203
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050203,
					"content": "~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050204
					],
					"speakerTitle": "Kapıyı İncele"
				},
				{
					"id": 762050204,
					"content": "Gördünüz mü? Oldu işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050205
					],
					"speakerTitle": "Nicole"
				},
				{
					"id": 762050205,
					"content": "Her şey olabilir bir rehber... İlahi isimlerle doludur... Kutsal metinler!",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050206
					]
				},
				{
					"id": 762050206,
					"content": "Kelimeler ve bölümler... İç içe geçer... Ve uyum içinde çalışır melekler!",
					"roleType": "TALK_ROLE_NONE",
