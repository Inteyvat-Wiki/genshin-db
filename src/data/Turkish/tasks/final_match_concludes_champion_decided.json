			"dialogs": [
				{
					"id": 765120101,
					"content": "#Sanırım kararını çoktan verdin {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120102
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765120102,
					"content": "Öhöm. Repliklerimi bir hatırlayayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120103
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120103,
					"content": "Gerçekten heyecan dolu ve muhteşem bir yarışmaydı. Artık sonuçları açıklamanın zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120104
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120104,
					"content": "#Üç finalist arasından şampiyon olanı açıklamak için Son İmtihan Muhafızımız {NICKNAME} sahneye geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120105
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120105,
					"content": "#Ne? Yani kazananı {NICKNAME} seçecek, öyle mi? Vay canına... Bu bir ilk olmalı. Görünüşe göre bu mücadeledeki en önemli jüri {NICKNAME} oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120106,
						765120112,
						765120119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120106,
					"content": "Kazanan... Dünyanın en şirin köpüşü Gaumaru!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120107
					]
				},
				{
					"id": 765120107,
					"content": "Evet evet, Paimon da aralarındaki en güçlünün Gaumaru olduğuna katılıyor! Bu köpüşte kesinlikle Taroumaru havası var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120108,
					"content": "Auu! Auuuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120109
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120109,
					"content": "Harikasın Gaumaru! Sıkı çalışmanın karşılığını en güzel şekilde aldın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120110
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120110,
					"content": "Inazumalı dostlarımızı içtenlikle tebrik ederim. Sonuna kadar hak edilmiş bir zafer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120111
					],
					"speakerTitle": "Kara Akik"
				},
				{
					"id": 765120111,
					"content": "Katılıyorum. Enerji dolu küçük Ninken, sahiden de korkulması gereken bir güçtü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "Eksilmiş Yedili Akor"
				},
				{
					"id": 765120125,
					"content": "Büyük bir ödül töreni düzenlemedik ama bence hepiniz savaş pratiğine değer veriyorsunuz ve günlük hayatlarınızda dikkat çekmemeyi tercih ediyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120126
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120126,
					"content": "#{NICKNAME} tarafından bizzat onurlandırılmak, Nod-Krai'da alınabilecek en büyük nişanlardan biridir ve sıradan kupaların ya da madalyaların çok ötesindedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120127
					],
					"speakerTitle": "Sieciech"
				},
				{
					"id": 765120127,
					"content": "#Hehe... {NICKNAME} tüm Teyvat'ta bir tek size böyle bir ödül vermiştir herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120128,
					"content": "Törene veya gösterişe ihtiyacımız yok. Bu fazlasıyla yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120129
					],
					"speakerTitle": "Kara Akik"
				},
				{
					"id": 765120129,
					"content": "Öyle değil mi Budanova?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120130
					],
					"speakerTitle": "Kara Akik"
				},
				{
					"id": 765120130,
					"content": "Elbette! Belki bir dahaki sefere müsabakaya biz ev sahipliği yaparız ve daha da büyük bir etkinlik organize ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120131
					],
					"speakerTitle": "Eksilmiş Yedili Akor"
				},
				{
					"id": 765120131,
					"content": "Öncelikle elemelerde en az yüz yarışmacı olmalı. Bu sayede bilinmeyen veya bir gruba bağlı olmayan yetenekleri keşfedebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120132
					],
					"speakerTitle": "Eksilmiş Yedili Akor"
				},
				{
					"id": 765120132,
					"content": "Bak bu çok mantıklı. Bombardımancılar da böyle bir şey düzenlemekten memnuniyet duyacaktır. Binbaşı Valeriy için bir teklif hazırlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120133
					],
					"speakerTitle": "Kara Akik"
				},
				{
					"id": 765120133,
					"content": "Shuumatsuban da... Şey... Eğer bu organizasyonun maliyeti on milyonlarca Mora olacaksa kalsın. Ama Ninken birliği ne olursa olsun katılacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120134
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120134,
					"content": "Auu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120135
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120135,
					"content": "Nazik teklifleriniz için her birinize teşekkür ederim. Ancak bence böyle bir yarışma güçlü bir grup tarafından düzenlenip finanse edildiğinde işler biraz farklı olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120136
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765120136,
					"content": "Örneğin, iyi performans gösteren bağımsız bir yarışmacıyı ekibinize katma dürtüsüne karşı koyabilecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120137
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765120137,
					"content": "Kazuha, o zaman diyorsun ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120138,
					"content": "Evet. Böyle bir yarışmaya ev sahipliği yapmak için en uygun aday, nispeten daha tarafsız olan Maceracılar Loncası olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120139,
						765120140
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 765120139,
					"content": "Evet, yarışmayı diğer tüm çıkarlardan arındırmalıyız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120141
					]
				},
				{
					"id": 765120141,
					"content": "Evet... Paimon da meseleyi anladı galiba! O zaman Paimon da lafını esirgemeden konuşacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120142,
					"content": "Bu yarışmadaki iki Fatui yarışmacısı gerçekten çok kibar olsalar da bazıları aşırı kaba olabiliyor, hatta bize konuşma fırsatı bile vermeden doğrudan saldırıya geçiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120143,
					"content": "Eğer yarışmayı Fatui düzenlerse en iyi dereceyi yapanları kendi saflarına katmayacaklarını kim garanti edebilir? Bu da demek oluyor ki aslında... Bize karşı savaşacak yetenekleri bulmalarına yardım etmiş olacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120144,
					"content": "Haha, ona ne şüphe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120145
					],
					"speakerTitle": "Kara Akik"
				},
				{
					"id": 765120145,
					"content": "Sizi anlıyorum. Ama başkaları adına herhangi bir söz veremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120146
					],
					"speakerTitle": "Kara Akik"
				},
				{
					"id": 765120146,
					"content": "Farklı birimlerin farklı amaçları ve çalışma şekilleri vardır. Ayrıca kıdemsiz bir subayın sözlerinin pek bir ağırlığı olamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120147
					],
					"speakerTitle": "Kara Akik"
				},
				{
					"id": 765120147,
					"content": "#Bay Kaedehara'nın söyledikleri çok mantıklı. {NICKNAME} ve Paimon'un endişeleri de bir o kadar anlaşılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120148
					],
					"speakerTitle": "Eksilmiş Yedili Akor"
				},
				{
					"id": 765120148,
					"content": "Pekala, sinsi planlar yapmayı bırakın da Gaumaru gibi savaş heyecanının tadını çıkarmaya bakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120149
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120149,
					"content": "Hav! Havvv!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120150
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120150,
					"content": "Haklısın. Benim gibi bir piyade böyle meseleleri amirlerine bırakıp sadece savaşa odaklanmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120151
					],
					"speakerTitle": "Kara Akik"
				},
				{
					"id": 765120151,
					"content": "Tekrar karşılaştığımızda becerilerimin ne kadar geliştiğini göreceksiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120152
					],
					"speakerTitle": "Kara Akik"
				},
				{
					"id": 765120152,
					"content": "Ben de... Herkese yetecek kadar pasta getireceğimden emin olacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eksilmiş Yedili Akor"
				},
				{
					"id": 765120140,
					"content": "Haklı. Yarışma sadece yarışma uğruna yapılmalı, başka hiçbir amaç uğruna değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120141
					]
				},
				{
					"id": 765120112,
					"content": "Kara Akik, aralarında en sivrilen yarışmacı oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120113
					]
				},
				{
					"id": 765120113,
					"content": "Evet... Büyük kılıç kullanan bu iri kıyım Fatui üyesi ile başa çıkmak gerçekten zor olmuştur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120114,
					"content": "Kim? Ben mi? Bu onur için teşekkür ederim. Benim için gerçekten çok anlamlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120115
					],
					"speakerTitle": "Kara Akik"
				},
				{
					"id": 765120115,
					"content": "#Herkes çok iyi bir iş çıkardı. Sanırım sadece {NICKNAME} karşısında tempomu koruyabildiğim için başarılı oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120116
					],
					"speakerTitle": "Kara Akik"
				},
				{
					"id": 765120116,
					"content": "Hav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120117
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120117,
					"content": "Gördün mü Gaumaru? Kara Akik'i örnek almalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120118
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120118,
					"content": "Tebrikler Bombardımancı Poruçik Stepanyan. Eminim Binbaşı Valeriy de seninle gurur duyacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "Eksilmiş Yedili Akor"
				},
				{
					"id": 765120119,
					"content": "Bence kazanan Eksilmiş Yedili Akor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765120120
					]
				},
				{
					"id": 765120120,
					"content": "Hımm... Paimon şimdi hatırladı! Fontaine'de savaştığımız şu şapkalı Fatui'yi eğiten o değil miydi? Gerçekten etkileyici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765120121,
					"content": "#Ah, çok naziksiniz... Sanırım bundan sonra {NICKNAME} için daha özel tatlılar hazırlamam gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120122
					],
					"speakerTitle": "Eksilmiş Yedili Akor"
				},
				{
					"id": 765120122,
					"content": "Guk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120123
					],
					"speakerTitle": "Gaumaru"
				},
				{
					"id": 765120123,
					"content": "Sen de Bayan Budanova'nın keklerinden tatmak istiyorsan önce çok çalışıp güçlenmen gerekecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120124
					],
					"speakerTitle": "Sumire"
				},
				{
					"id": 765120124,
					"content": "Ha, karşımızda kıdemli bir Fatui eğitmeni vardı demek... Ona rakip olmak çok zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765120125
					],
					"speakerTitle": "Kara Akik"
				}
			]
		}
	]
}