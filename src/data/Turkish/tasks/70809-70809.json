			},
			"dialogs": [
				{
					"id": 708090301,
					"content": "(Yuvanın içinde etrafa saçılmış kâğıt parçaları bulunuyor, üzerlerinde hâlâ bölük pörçük el yazısına benzeyen izler var...)",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090302
					]
				},
				{
					"id": 708090302,
					"content": "Tüm bu kağıtları yuva malzemesi olarak kullanmak için mi parçalamışlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090303,
					"content": "Üzerlerinde yazılar da var. Parçaları birleştirip okumaya çalışalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090304,
					"content": "Sanırım bunu kendi başımıza yapmamız gerekecek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090305
					]
				},
				{
					"id": 708090305,
					"content": "Hadi ama, birazcık bile merak etmiyor musun? Ya bu bir hazine haritasıysa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090306,
					"content": "Paimon'un bitmeyen ısrarları sonucunda parçalar nihayet birleştirilir...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						708090307
					]
				},
				{
					"id": 708090307,
					"content": "Pekala, işte beklenen an... Bu bir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090308,
					"content": "Bir dakika... Olamaz... Bu bir tür suç planı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090309,
						708090311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090309,
					"content": "Hangi suç dehası planını bir kuşa kaptırır ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090310
					]
				},
				{
					"id": 708090310,
					"content": "H-Hey, bu tür şeyler romanlarda hep olur! Kusursuz bir plan vardır ve sonra kimsenin beklemediği tek bir şey yüzünden her şey dağılır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090313,
					"content": "Yakındaki hanı kontrol edelim ve son zamanlarda \"suç planlayan\" biri hakkında dedikodular duyan olmuş mu bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090311,
					"content": "İşini sağlama almak gerek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708090312
					]
				},
				{
					"id": 708090312,
					"content": "E-Evet! Aynen... Ya biri gerçekten bir şeyler planlıyorsa? Bunu görmezden gelirsek ve önemli bir şey yaşanırsa telafi etmek için çok geç kalmış oluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090313
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7080904,
