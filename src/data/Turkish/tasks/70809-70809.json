				"points": []
			},
			"dialogs": [
				{
					"id": 708090501,
					"content": "Öyle mi? Bir bakayım. Hımm... Konsept fena değil. Yaratıcılığına on üzerinden altı veririm. Uygulanabilirliğine ise... Belki dört.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090502
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090502,
					"content": "B-Bu bir suç planı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090503,
					"content": "Haha. İşin komik yanı, sırf bu civarda birinin tuhaf bir \"suç planı\" peşinde olduğuna dair söylentiler duyup üsten buralara kadar geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090504
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090504,
					"content": "... Ama bu notu okuyunca o söylentilerin nereden çıktığını anladım sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090505
					],
					"speakerTitle": "Lohen"
				},
				{
					"id": 708090505,
					"content": "Her ihtimale karşı bunu Şövalyelere teslim edeceğim. Daha sonra vaktin olursa üssüme uğra. Belki izlemeye değer bir şeye denk gelirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lohen"
				}
			]
		}
	]
