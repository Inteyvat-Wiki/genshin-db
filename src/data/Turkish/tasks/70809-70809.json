					"Uchida Kotaro"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708090401,
					"content": "B-Bu... Bu benim suç planım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090402
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090402,
					"content": "#{NICKNAME}! Gerçekten de kabul etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708090403,
					"content": "Hayır, hayır! Lütfen yanlış anlama! Bu sadece bir sonraki romanım için bir kurgu fikri. İçerken aklıma esmişti, ben de kağıda döktüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090404
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090404,
					"content": "Uyandığımda sayfa kaybolmuştu, ben de sadece sarhoşken rüya görmüşümdür diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708090405
					],
					"speakerTitle": "Uchida Kotaro"
				},
				{
					"id": 708090405,
					"content": "Neyse, onu bulmama yardım ettiğin için çok teşekkür ederim. Romanım nihayet ilerleyebilir. Çıktığı zaman sana imzalı bir kopyasını göndereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uchida Kotaro"
				}
			]
		},
		{
			"id": 7080905,
			"completionStepIds": [
				7080906
			],
