			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230501,
					"content": "Hah, altı üstü bir cetvel. Beş para etmez gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230502
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230502,
					"content": "Bu... Doğru hatırlıyorsam bir tür ölçme aleti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230503
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230503,
					"content": "Kesinlikle öyle fakat Tuz Tanrısı onu başka bir güçle daha donattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230504
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230504,
					"content": "Cetvel yere saplandığında aynı gelgit zamanı dalgaların toprağı kapladığı gibi etrafındaki alan da tuzla kaplanır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230505
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230505,
					"content": "Ne kadar derine saplanırsa o kadar çok tuz ortaya çıkar. Buna bir nevi tuzun \"bereket hasadı\" diyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230506
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230506,
					"content": "Ne... Nasıl... Bu tuz kadehinden bile daha iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230507
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230507,
					"content": "Pekala, sözleşmemize göre tuz cetvelini Bayan Wanyan alıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230508
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230508,
					"content": "Dur! Asla olmaz! Bu keşfi düzenleyen de parasını ödeyen de benim! Neden kısa çubuğu ben çekeyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230509
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230509,
					"content": "Hem bu kızın bir işe yaradığı da yok. Ne diye hazine alsın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230510
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230510,
					"content": "Öf be, başladık yine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230511,
						110230512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230511,
					"content": "*iç çeker*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				},
				{
					"id": 110230513,
					"content": "Sözleşmeyi bozmak istediğini mi söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230514
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230514,
					"content": "Bozarım yani ne olmuş? Harabedeki düzeneklerin nasıl çalıştığını gördüm sonuçta, sana ihtiyacım kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230515
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230515,
					"content": "Burada kimin kimi işe aldığını unutmayalım istersen. Kuralları SENİN koymana neden müsaade edeyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230516
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230516,
					"content": "Çünkü sözleşmeyi kabul ettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230517
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230517,
					"content": "Rex Lapis bir zamanlar demiş ki: \"Kim ki sözleşmesine sadık kalmaz, o zaman yüzleşir Kayanın Gazabıyla.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230518
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230518,
					"content": "Bu Liyue tanrılarından biri. Ben ise Snezhnaya'dan geliyorum, ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230519
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230519,
					"content": "\"Kayanın Gazabıyla yüzleşmek\"... Pek de hoşuna gitmeyecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230512,
					"content": "\"İşe yaramaz\" kişilerden bahsetmişken...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230513
					]
				}
			]
		},
		{
			"id": 1102307,
			"completionStepIds": [
				1102307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
