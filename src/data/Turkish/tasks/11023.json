			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wanyan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110231101,
					"content": "Burası suçun işlendiği yer. Havria'nın parçalanan bedeninden geriye kalanlar tuza dönüştü. Son nefesini verirken bıraktığı iz bugüne dek ulaştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231102
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231103
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231103,
					"content": "Buradaki öykü, halkındaki bazı kişilerin onun yardımsever, cömert fakat zayıf ve savaş zamanı kimseyi koruyamayacak bir tanrı olduğunu anlamalarıyla devam ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231104
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231104,
					"content": "Hükümdarlar Savaşı çok acımasız bir savaştı. Ona yaşadığı bozgunun ızdırabını çektirmek yerine acılarını dindirmek adına hızlı bir ölüm bahşetmek istemişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231105
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231105,
					"content": "Peki... Şu heykelcikler ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231106,
					"content": "Tanrı ne kadar güçsüz olursa olsun, öldüğü zaman etrafına saçtığı güç herhangi fani bir bedenin kaldırabileceğinden çok daha güçlü olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231107
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231107,
					"content": "Kaçamayanlar da bu yüzden dönüştüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231108
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231108,
					"content": "Bu faciadan kaçabilenler Liyue'ye gidip Rex Lapis'e sığınmaya çalıştılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231109
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231109,
					"content": "Onların soyundan gelenler Havria'nın kalıntılarından korkmaya başladı. Havria'nın soylarını ilelebet lanetlediğini düşündüler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231110
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231110,
					"content": "Böylece hayatlarını tehlikeye atıp buraya geldiler ve onun öfkesini dindirme umuduyla kılıcı kırarak saygılarını sundular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231111
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231111,
					"content": "Bana sorarsanız böyle bir şeye gerek yoktu. Son nefesini verirken bile düşmana göğüs gerememiş bir tanrı nasıl kendi halkına karşı nefret besleyebilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231112
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231112,
					"content": "Bu... Gerçek bile olsa... Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231113
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231113,
					"content": "Bu bir yalan olmalı... Bunların hepsi... Yalan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231114
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231114,
					"content": "Sakın ola ki... İnancımı sarsmaya çalışma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231115
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231115,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231116
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110231116,
					"content": "Öf ya, Zhongli yine çok acımasız davrandı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231117,
					"content": "Bu, onun ödemesi gereken bedeldi ki bence çok da ağır olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231118
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231118,
					"content": "Tepkisine bakılırsa korkarım ki bir süre bunun etkisinden çıkamayacak. Bu etkiden kısa sürede çıkmayacak olsa da nihayetinde bu gerçeği kabullenmesi onun yararına olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231119,
						110231121
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231119,
					"content": "Tuz Tanrısı'nın başına gelenleri çok iyi biliyor gibisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231120
					]
				},
				{
					"id": 110231120,
					"content": "Biliyorum. Havria'nın hikayesi bir zamanlar bana da öğütlenmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231123,
					"content": "Ölmüş gitmiş bir tanrıya inanmanın kimseye bir faydası yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231124
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231124,
					"content": "Bu sadece Havria için değil, Morax için de geçerli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231125
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231125,
					"content": "Zamanı geldiğinde bunu Liyue halkı da anlayacaktır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231126
					]
				},
				{
					"id": 110231126,
					"content": "Peki o zaman. Guyun Taş Ormanı'na yapacağım yolculukta bana eşlik etmek ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231127
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231127,
					"content": "Ha? Orada ne yapmayı planlıyorsun, Zhongli?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110231128,
					"content": "*iç çeker*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231129
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231129,
					"content": "Etrafı gezip eski öyküleri anlatacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231130
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231130,
					"content": "İnsanın eskileri hatırlamaktan başka çaresi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110231121,
					"content": "Mührü kırmayı dedikodulardan öğrenmedin aslında, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110231122
					]
				},
				{
					"id": 110231122,
					"content": "Hayır, değildi. Ne kadar zekisin. Ancak aslolan bilgelik değil, olgunluktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110231123
					],
					"speakerTitle": "Zhongli"
				}
			]
		}
	]
