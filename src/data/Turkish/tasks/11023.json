			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230301,
					"content": "Şuna bakın. Yarısı tuzla doldurulmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230302
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230302,
					"content": "Süslü bir tuzluğa benziyor. Görünüşe göre Tuz Tanrısı'nın öyle pek de değerli hazineleri yokmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230303
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230303,
					"content": "Bildiğim kadarıyla bu öyle sıradan bir kap değil. Yarısının dolu olduğuna bakmayın, dolu tarafı bitmek bilmez... Yani sonu yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230304,
					"content": "Ne? Yani tuzu dışarı döksek bile içindeki tuz miktarının değişmeyeceğini mi söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230305
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230305,
					"content": "Aynen öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230306
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230306,
					"content": "Sınırsız tuz üretebildiğine göre... Tuz Tanrısı kesinlikle güçlüymüş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230307
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230307,
					"content": "Onca gayretin üzerine sonunda değerli bir hazine bulabildim! Bunun üzerinde hak iddia ediyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230308
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230308,
					"content": "Tek yapmam gereken bu sonsuz tuzu on binlerce torbaya doldurmak... Daha sonrasında kabı satıp zengin olabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230309
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230309,
					"content": "Hey! Tuz Tanrısı'nın yadigarını böylesine alçak bir amaç için nasıl kullanabilirsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230310
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230310,
					"content": "Bay Kliment bu tuz kadehini istiyorsa o zaman sözleşmeye göre bulacağımız bir sonraki hazine Bayan Wanyan'ın olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230311,
					"content": "Aynen öyle, anlaştığımız gibi, haha. Bu nadir eşyadan daha değerli ne bulabiliriz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230312
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230312,
					"content": "Sözleşme gereği onunla tartışmamın bir anlamı yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230313
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230313,
					"content": "İsterseniz yolumuza devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				}
			]
		},
		{
			"id": 1102305,
			"completionStepIds": [
				1102305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
