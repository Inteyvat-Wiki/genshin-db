				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230701,
					"content": "Senin hazinene de el koyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230702
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230702,
					"content": "Bu harabeyi araştırmaya devam etmeyi hak etmiyorsun. Burayı terk et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230703
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230703,
					"content": "Lanet olsun sana... Göreceksin gününü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230704
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230704,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230705
					],
					"speakerTitle": "Kliment"
				},
				{
					"id": 110230705,
					"content": "\"Arkeolojik araştırmaymış\", külahıma anlat sen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230706,
						110230708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230706,
					"content": "En azından kendimizi ezdirmedik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230707
					]
				},
				{
					"id": 110230707,
					"content": "Aynen, neyse ki Paimon bir yalancının kokusunu kilometrelerce öteden alabiliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230710,
					"content": "Kliment'in hatası açgözlülüktü, evet. Ama daha başka türlü sebepten dolayı sözleşmeler bozulabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230711
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230711,
					"content": "İnsanların kaçı hayallerini süsleyen nesneyi gördüğünde kendine hakim olup sözleşmeye bağlı kalabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230712
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230712,
					"content": "Bence birbirimize karşı dürüst olmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230713
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230713,
					"content": "Ne? Ne konuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230714,
					"content": "Aramızdan kimsenin buraya \"arkeolojik araştırma\" yapmaya gelmediği konusunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230715
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230715,
					"content": "Ne-Neden öyle söyledin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230716
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230716,
					"content": "En basit arkeolojik bilgilerden bile haberin yok hanımefendi, basit birkaç yadigardan başka bir şey bilmiyorsun. Konu Tuz Tanrısı'na geldiğinde ise bir anda uzman kesiliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230717
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230717,
					"content": "Sen arkeoloji veya yadigarlarla ilgilenmiyorsun... Senin ilgilendiğin şey Tuz Tanrısı'nın kendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230718
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230718,
					"content": "İnci Kalyonu'nda Tuz Tanrısı hakkında anlattığın efsaneler görünüşe göre Yinyuan Salonunda nesilden nesile aktarılmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230719
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230719,
					"content": "Tamam, anladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230720
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230720,
					"content": "Efendim, siz kesinlikle bilge ve yetenekli birisiniz. Cesaretimi toplayıp size ulaşmakla en doğrusunu yapmışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230721
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230721,
					"content": "Haklısınız. Ben bir arkeoloji alimi değilim. Yinyuan Salonunun tuz sanayisini elinde tutan Yedi Yıldızın yetkisi altındaki Sekizler Loncasından geliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230722
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230722,
					"content": "Atalarımız, yıllar önce Hükümdarlar Savaşı bölgeyi kasıp kavururken Tuz Tanrısı'nın koruma altına aldıkları arasındaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230723,
						110230724
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230723,
					"content": "Şimdi düşününce hiç \"Rex Lapis\" dediğini duymadım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230725,
					"content": "Ah, doğru. Mademki dikkatini çekti belirteyim o zaman, Liyue halkı \"Morax\" ismini pek kullanmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230726
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230726,
					"content": "Morax savaş sırasında güçlerini kıskandığı için tanrımızı öldürdü! Bizi bu dünyada bir başımıza bıraktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230727
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230727,
					"content": "Biz... Ondan nefret ediyoruz! Liyue, Morax'ın öykülerini anlatıyor çünkü tarih kazananlar tarafından yazılır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230728
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230728,
					"content": "O yüzden Morax'ın suçlu olduğuna dair kanıta ihtiyacım var! Gözünü kan bürümüş onun ve kalbi kaskatı kesilmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230729
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230729,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230730
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230730,
					"content": "Gerçekle yüzleşeceğimize dair bir sözleşme yaptık, değil mi Bay Zhongli? Tarihi de dürüstçe yargılamalısınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230731
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230731,
					"content": "Kesinlikle. Dürüst olacağım fakat Liyue artık Morax'ın Liyue'si değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230732
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230732,
					"content": "Benimle gel. Aradığın tüm cevaplar birkaç adım uzağımızda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230724,
					"content": "Hım, hiç \"Toprağın Efendisi\" dediğini duymadım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230725
					]
				},
				{
					"id": 110230708,
					"content": "Umarım asla onun kadar açgözlü birine dönüşmezsin Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230709
					]
				},
				{
					"id": 110230709,
					"content": "Hey! Paimon Moraları seviyor olabilir ama Paimon kötülük yapmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230710
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1102309,
			"completionStepIds": [
				1102309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102309",
							"2"
						],
						"stepId": 1102309,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhongli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110230901,
					"content": "Bu bir... Kılıç mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230902
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230902,
					"content": "Aha! Bu kırık bir kılıç, bunu kanıt olarak gösterebiliriz! Bu kılıç Tuz Tanrısı'nın Morax karşısında savaşmak zorunda kaldığını kanıtlıyor! Ama ne yazık ki mağlup edildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230903
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230903,
					"content": "Bu kılıç kesinlikle tuz kadehinden ve tuz cetvelinden daha güçlü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230904
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230904,
					"content": "Bu kılıcı tamir edebilirsek tüm dünyaya Tuz Tanrısı'nın ne kadar güçlü olduğunu gösterebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230905
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230905,
					"content": "Hımm... Savaşı kaybettikten sonra ardında bırakmış gibi görünüyor gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230906,
					"content": "Kırık bir kılıcın iki parçası. Arkeolojik olarak bakarsak bunlar iki ayrı yadigar olarak sayılmalı. Yaptığımız sözleşmeye göre ancak bir tanesini alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230907
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230907,
					"content": "Ama... Neden? Hazineleri paylaşacaktık, doğru ama sonuçta Kliment artık yanımızda değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230908
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230908,
					"content": "Haklısın fakat \"her hak iddiası için tek nesne\" kuralı hâlâ geçerli. Aynı anda iki yadigarı birden alamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230909
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230909,
					"content": "Bu ne biçim bir mantık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230910
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230910,
					"content": "Şey... Zhongli, o iyi birine benziyor ve hazine üzerinde hak iddia eden başkası da yok. Bu seferlik görmezden gelsen olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230911
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230911,
					"content": "Sözleşme yaptığımız kurallara uymamak \"olmaz\". Sözleşmeye uymazsak onu bozmuş sayılırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230912
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230912,
					"content": "Durun! Sadece bir parçasını alırsam o zaman kılıcı asla onaramayız, daha da önemlisi Tuz Tanrısı'nın gücünü geri getiremeyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230913
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230913,
					"content": "Ne olursa olsun ona sadık kalmalıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230914
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230914,
					"content": "Sözleşmeyi bozacak olsa bile umurumda değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230915
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230915,
					"content": "Kararını verdin yani öyle mi? Hımm... Sözleşmeyi bozmanın bir bedeli olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230916
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230916,
					"content": "Zhongli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230917
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230917,
					"content": "Söyleyeceklerim bu kadar, \"Kayanın Gazabıyla yüzleşmeye\" hazır ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230918
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230918,
					"content": "Peki... Sorun değil. Tuz Tanrısı halkını korumak için canını verdi. Benim yapacağım fedakarlık onunkinin yanında hiçbir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230919
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230919,
					"content": "Beni istediğin gibi cezalandır ama yeter ki bunu inancımın bir kanıtı olarak almama izin ver!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230920
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230920,
					"content": "Dur, ona vuramazsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230921
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230921,
					"content": "Vursam belki onun için daha hafif bir ceza olurdu fakat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230922
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230922,
					"content": "Ceza olarak ona gerçeği söyleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230923
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230923,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230924
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230924,
					"content": "Gerçeği mi? Gerçeği söyleyerek mi cezalandıracaksın beni yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230925
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230925,
					"content": "Evet. Sana söyleyeceğim gerçek, sözleşmeyi bozmanın bedeli olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230926
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230926,
					"content": "Ne yazık ki Tuz Tanrısı Havria düşündüğün kadar güçlü bir tanrı değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230927
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230927,
					"content": "Tam tersine diğer tanrılara diz çökmüş güçsüz ve küçük bir tanrıydı. Savaş kapısını çaldığında ise kaybetti... Hiçbir zaman kendisine Yediler arasında bir yer edinemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230928
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230928,
					"content": "Ne, nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230929
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230929,
					"content": "Hükümdarlar Savaşı sırasında bu dünyanın tanrıları, tüm fiziksel ve zihinsel yeteneklerini Teyvat'ı kontrol altına almak için kullandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230930
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230930,
					"content": "Bu sırada Havria ise kaçmayı seçti. Savaş başlamadan kaçarsa kendini ve halkını savaştan koruyabileceğini sandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230931
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230931,
					"content": "Ne yazık ki böylesine uzun süren bir savaş sırasında düşmanların ilerleyişi durdurulamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230932
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230932,
					"content": "Havria verdiği yüzlerce imtiyazın ardından bu küçük sığınak haricindeki tüm topraklarını kaybetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230933
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230933,
					"content": "Hayır... Hayır... Böyle olmuş olamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230934
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230934,
					"content": "Son günlerinde halkını koruyabileceği tek bir kılıcı bile yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230935
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230935,
					"content": "\"Tek bir kılıcı bile yoktu\" derken? Bu kılıç ne o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230936
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230936,
					"content": "Bu kılıç Tuz Tanrısı'ndan kalma bir yadigar değil... Tam tersine onu öldürmek için kullanılmış olan bir cinayet silahı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230937
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230937,
					"content": "Cinayet silahı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230938
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230938,
					"content": "Hayır! Bu gerçek olamaz, buna inanmıyorum! Tuz Tanrısı'na olan inancımı sorgulamaya çalışıyor olmalısın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230939
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230939,
					"content": "Dediğim gibi, ben sadece gerçekleri söylerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230940
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230940,
					"content": "İnanılır gibi değil! Sen... Sen bir Morax müridisin, beni oyuna getirmeye çalışıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230941
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230941,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230942
					],
					"speakerTitle": "Wanyan"
				},
				{
					"id": 110230942,
					"content": "Hey, hey! Dur, gitme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230943,
						110230945
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110230943,
					"content": "Bunu kaldıramıyor olması normal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230944
					]
				},
				{
					"id": 110230944,
					"content": "Onun cezası buydu. Sözleşmeyi bozmasaydı ona bu acı gerçekleri verme niyetinde değildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230947,
					"content": "Onu harabenin derinlerine doğru takip edelim. Korkarım ki orada gerçekle yüzleşmekten başka bir şansının kalmayacağı bir şeyle karşılaşacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 110230945,
					"content": "Söylediklerin gerçekten de doğruydu, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110230946
					]
				},
				{
					"id": 110230946,
					"content": "Doğruydu. Öyle olmasaydı gerçeği bir ceza olarak kullanmazdım. Sözleşmeyi bozmasaydı ona bu acı gerçekleri verme niyetinde değildim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110230947
					],
					"speakerTitle": "Zhongli"
				}
			]
		},
