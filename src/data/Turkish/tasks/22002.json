				{
					"id": 220020301,
					"content": "Nilüfer Başlarını buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020302
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020302,
					"content": "Getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020303
					]
				},
				{
					"id": 220020303,
					"content": "Oley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020304
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020304,
					"content": "Meng! Fei! Gelin Nilüfer Başı yiyelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020305
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020305,
					"content": "Hey! Paimon seni soymamız gerektiğini düşünüyor, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020306,
					"content": "Ha, evet... O halde bu Moraları ve eşyaları alın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020307
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020307,
					"content": "Korsanı oynamakta çok iyisin. Küçük bir çocuktan bunca şeyi çalmayı herkes beceremez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020308
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020308,
					"content": "Paimon bu ufaklığın bizimle dalga geçtiğini düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220020309,
					"content": "Yardım ettiğin için teşekkürler. Seninle oynamak eğlenceliydi. Yakın zamanda tekrar oynayalım, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Lulu"
				}
			]
		},
