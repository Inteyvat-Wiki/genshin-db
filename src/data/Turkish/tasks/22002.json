			"dialogs": [
				{
					"id": 220020101,
					"content": "Lulu, nasıl oldu da yine ben kaptan oldum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020102
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220020102,
					"content": "Çünkü sen kaptan olunca oyun daha eğlenceli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020103
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020103,
					"content": "Şey, Lulu mutluysa... Öyle olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020104
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220020104,
					"content": "Ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020105
					]
				},
				{
					"id": 220020105,
					"content": "Oyun oynuyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020106
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020106,
					"content": "Meng kaptan, Fei onun yardımcısı, ben de zengin bir tüccarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020107
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020107,
					"content": "Bir tek korsanımız eksik. Korsanın gelip bizi soyması lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020108
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020108,
					"content": "Bizimle oynamak istersen korsan olabilirsin. Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020109,
						220020111
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020109,
					"content": "Ahoy, canlarım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020110
					]
				},
				{
					"id": 220020110,
					"content": "Oley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020113,
					"content": "Tamam, hazır olduğunda bize haber ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020111,
					"content": "İyilerden biri olmak istiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020112
					]
				},
				{
					"id": 220020112,
					"content": "Bu sadece bir oyun! Merak etme, gerçek hayatta senin iyi biri olduğunu biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020113
					],
					"speakerTitle": "Minik Lulu"
				}
			]
		},
		{
			"id": 2200202,
			"completionStepIds": [
				2200202
