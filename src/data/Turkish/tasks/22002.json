				"points": []
			},
			"dialogs": [
				{
					"id": 220020201,
					"content": "Hazırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220020202
					]
				},
				{
					"id": 220020202,
					"content": "Yaşasın! Başlıyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020203
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020203,
					"content": "Senin başlaman lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020204
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020204,
					"content": "Durun bakalım! Buraya sizi soymaya geldim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020205
					]
				},
				{
					"id": 220020205,
					"content": "Heh! Güpegündüz mü? Kolay gelsin sana, şuradaki Taşordu askerleri bizi gözetliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020206
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220020206,
					"content": "Lulu, çabuk gel! Kaçmamız lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020207
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220020207,
					"content": "Merhaba Korsan Bey. Tam olarak ne soymaya gelmiştin acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020208,
						220020209
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020208,
					"content": "Şey... Mora! Arr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					]
				},
				{
					"id": 220020212,
					"content": "Ama pek Moram yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020213
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020213,
					"content": "Babamın söylediğine göre bir gemideki en değerli şey tüccarın mallarıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020214
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020214,
					"content": "Bak ne diyeceğim. Oyunda kullanmak için değerli birkaç eşya bulmaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020215
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020215,
					"content": "Böylece çalabileceğin mallarımız olmuş olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020216
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020216,
					"content": "Hımm... Nilüfer Başları iş görür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020217
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020217,
					"content": "Biz Nilüfer Başı yemeye bayılırız. Yaramaz bir korsansan yapabileceğin en büyük yaramazlık en sevdiğimiz yiyeceği çalmaktır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020209,
					"content": "Seni, benim güzel minik kızım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020210
					]
				},
				{
					"id": 220020210,
					"content": "Şey, bunun sadece bir oyun olduğunu biliyoruz ama yine de dikkatli olsak iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020211
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220020211,
					"content": "Baksanıza. Taşordu askerleri bizi izliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220020212
					],
					"speakerTitle": "Minik Lulu"
				}
			]
		},
