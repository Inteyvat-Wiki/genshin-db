				"points": []
			},
			"dialogs": [
				{
					"id": 220100701,
					"content": "Tsukumomono Market, karakterimin macerası sırasında topladığı eşyalara benzer ürünler satıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100702
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100702,
					"content": "Aoi her zaman \"Birinin çöpü bir başkasının hazinesidir.\" der.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100703
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100703,
					"content": "Hımm... Sanırım ürünleri yüksek fiyata satmanın yolu müşterilerin neye değer verdiğini öğrenmekten geçiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100704
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100704,
					"content": "Ama böyle yazarsam müşteri psikolojisini anlatmak için zaman ayırmak zorunda kalacağım. Temaya uymaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100705
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100705,
					"content": "Ana karakteri müşterilerin ihtiyaçlarını sezebilen bir medyum yapsam ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100706,
						220100708
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100706,
					"content": "Karakterine öyle birden yeni özellikler ekleyemezsin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100707
					]
				},
				{
					"id": 220100707,
					"content": "Eklerim, karakter gelişimi deniyor buna. Sorun olmaz. Merak etme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100710,
					"content": "Peki, sorun çözüldü o zaman! Ne yazacağımı biliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100711
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100711,
					"content": "Hadi dönelim Gezgin. Shigeru'ya bu fikrimden bahsetmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100708,
					"content": "İyi de bunun olay örgüsündeki yeri nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100709
					]
				},
				{
					"id": 220100709,
					"content": "Olay örgüsündeki yeri... Hımm, bunu yazarken düşünürüm. Bir şey olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100710
					],
					"speakerTitle": "Junkichi"
				}
			]
		},
		{
			"id": 2201008,
			"completionStepIds": [
				2201004
			],
