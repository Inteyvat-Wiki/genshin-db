				"points": []
			},
			"dialogs": [
				{
					"id": 220100922,
					"content": "Aslında Shigeru'nun söylediği daha mantıklı gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100923
					]
				},
				{
					"id": 220100923,
					"content": "Mantıklı mı? İyi bir olay örgüsü sırf mantıkla olmaz ki. Hikaye ilgi çekici olmadıktan sonra olay örgüsü mantıklı olsa ne yazar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100924
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100924,
					"content": "Sen... İyi dinle beni bak. Hikayenin sonunu yazman gerektiğinde yarım kalan yerleri tamamlamaya çalışırken kafayı yiyeceksin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100925
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100925,
					"content": "Ben yazarken notlarımı alıyorum. Hikayenin sonunu yazarken sorun yaşamayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100926
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100926,
					"content": "Hikayedeki tüm ayrıntıları hatırlamak için not alman gerekiyor çünkü, değil mi? Okuyucuların da not almasını bekliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100927
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100927,
					"content": "Şey... Şöyle ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100928
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100928,
					"content": "Karaktere bu yeni özellikleri ekleyemezsin demiyorum bak. Sadece yeteneklerin sayısına ve hikayeye ne zaman eklediğine dikkat etmen gerek diyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100929
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100929,
					"content": "Roman yazmak maraton koşmaya benzer. Başlangıçta çok güç harcarsan ileride temponu kaybedersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100930
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100930,
					"content": "Başarılı bir romanın anahtarı adım adım, istikrarlı bir şekilde ilerlemektir. Güven bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100931
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100931,
					"content": "Tamam, tamam... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		}
