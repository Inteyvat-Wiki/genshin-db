					"Junkichi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220100801,
					"content": "Doushin Hanamizaka'da barışı koruyor. Hiçbir suçlu onların gözünden kaçamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100802
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100802,
					"content": "Hikayede düşmanın şövalyeleri, Doushin ile aynı görevlere sahip. Ama hikayeyi ilginç kılmak için düşman şövalyelerini on kat daha kuvvetli yapayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100803,
						220100805
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100803,
					"content": "Öyle keyfine göre bilmem kaç kat diyemezsin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100804
					]
				},
				{
					"id": 220100804,
					"content": "Katlar dünyadaki en net şeylerdir. Ana karakterin ne kadar güçlü olduğunu okuyuculara böyle göstereceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100806
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100806,
					"content": "Doğru... O zaman... Ana karakteri kılık değiştirme konusunda uzman yapayım. Görünüşünü ve sesini istediği gibi değiştirebilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100807
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100807,
					"content": "Bu yeni bir karakter özelliği mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100808
					]
				},
				{
					"id": 220100808,
					"content": "Evet, ana karakterin gizli yeteneği. Düşmanla karşılaşma anı karakterin gizli yeteneğini göstermek için en iyi zamandır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100809
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100809,
					"content": "Ya bunu şu an uydurdun, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100810
					]
				},
				{
					"id": 220100810,
					"content": "Y-Yoo... Başından beri planım buydu. Nereden çıkardın ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100811
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100811,
					"content": "Neyse, bu fikri sevdim. Gidip Shigeru'ya anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100805,
					"content": "Peki ana karakter bu çıkmazı nasıl çözecek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100806
					]
				}
			]
		},
