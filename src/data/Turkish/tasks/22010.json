			"dialogs": [
				{
					"id": 220100601,
					"content": "Örse inen her çekiç darbesiyle kıvılcımlar uçuşuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100602
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100602,
					"content": "Amenoma Demirci Dükkanı adeta tutkuyla dolu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100603
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100603,
					"content": "Demirciler basit araçlar kullanarak prototipleri ve cevherleri güçlü silahlara dönüştürüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100604
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100604,
					"content": "Silahları döverken simya kullanılsa yok edilemez silahlar yapmak mümkün olmaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100605,
						220100606
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100605,
					"content": "Simya öyle bir şey yapamaz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100608
					]
				},
				{
					"id": 220100608,
					"content": "Evet! Bu iyi bir fikir. Ana karakter en güçlü silaha sahip olacak! Simya ile dövülmüş olacak silahı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100609
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100609,
					"content": "Şimdi, bu silahın harika bir adı olmalı... Tabii harika bir de hikayesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100610
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100610,
					"content": "İşte bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100611
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100611,
					"content": "Hadi dönelim Gezgin. Shigeru'ya bu fikrimden bahsetmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100606,
					"content": "Simyadan anladığını sanmıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100607
					]
				},
				{
					"id": 220100607,
					"content": "Nasıl yani? Simya imkansızı mümkün kılan bir şey değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100608
					],
					"speakerTitle": "Junkichi"
				}
			]
