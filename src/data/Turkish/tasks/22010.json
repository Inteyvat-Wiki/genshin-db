			},
			"dialogs": [
				{
					"id": 220100901,
					"content": "Aradığım ilhamı Amenoma Demirci Dükkanında buldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100902
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100902,
					"content": "Hadi ya? Vay be, gerçekten işe yaradı demek. Harika. Anlat bakalım fikrini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100903
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100903,
					"content": "Bir gece ana karaktere bir aydınlanma gelir ve Kılıç Diriltme adında süper bir simya yeteneği keşfeder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100904
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100904,
					"content": "Paslı bir kılıcı yalnızca yeni adını söyleyerek güçlü bir silaha dönüştürebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100905
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100905,
					"content": "Böylece, istediği her... Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100906
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100906,
					"content": "Ya... Yine aynı şeyi yapıyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100907,
						220100908
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100907,
					"content": "\"Yine\" derken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100909
					]
				},
				{
					"id": 220100909,
					"content": "Dur tahmin edeyim. Hikayeye devam etmek için karaktere yeni yetenekler ekleyeceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100910
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100910,
					"content": "Yeni bölümü bitirene kadar da bu yeteneklerin üzerine karmaşık bir sürü özellik daha ekleyeceksin. Bildim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100911
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100911,
					"content": "Karakteri seviyorsun anladık ama ona sürekli yeni yetenek verip durma artık! Okurların kafası karışacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100912
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100912,
					"content": "Benim tarzım böyle. Şahsen ben ilgi çekici olduğunu düşünüyorum. Okurlar da bayılacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100913
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100913,
					"content": "Bırak ya. Uydurduğun şeyler okuyucuların kafasını karıştırmaya başladı, gayet farkındasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100914
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100914,
					"content": "Öf, bu konuşma benim için bitmiştir. Çok sıkıcısın. Gezginin düşüncelerini alalım bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100915
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100915,
					"content": "Gezgin, sence kim haklı? Ben mi Shigeru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100908,
					"content": "\"Aynı şey\" ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100909
					]
				}
			]
