			},
			"dialogs": [
				{
					"id": 220100101,
					"content": "Junkichi, taslağın teslim günü yarın. Artık geciktirme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100102
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100102,
					"content": "Zorlama beni! Hikayenin kritik bir noktasında tıkandım. Aklıma yazacak bir şey gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100103
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100103,
					"content": "Neden tartışıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100104
					]
				},
				{
					"id": 220100104,
					"content": "Gezgin! Tam da ihtiyacımız olan kişisin şu an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100105
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100105,
					"content": "Ben Shigeru, Yae Yayınevi editörüyüm. Bu da sorumlu olduğum yazar Junkichi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100106
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100106,
					"content": "Yeni romanı \"Dövüş Sanatları\" çok popüler. Ama Junkichi teslim tarihlerine asla uymuyor. Hatta bazen haftalarca erteliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100107
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100107,
					"content": "Aynısını yine yapıyor şu an. Taslağını yarına kadar teslim etmezse bu ayın sayısını basamayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100108
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100108,
					"content": "Sayıyı ertelesek ya? Sadık okuyucularımız para ödeyecek nasıl olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100109
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100109,
					"content": "Saçmalama. Düzenli basılmazsa romanın itibarı iki paralık olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100110
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100110,
					"content": "İlham gelmiyor şu anda, saçma sapan bir bölüm de yazmayacağım. İlginç bir hikaye olması lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100111
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100111,
					"content": "Diğer yazarlar bitirdi, bir tek sen kaldın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100112
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100112,
					"content": "Belki Junkichi'nin gerçekten biraz ilhama ihtiyacı vardır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100113
					]
				},
				{
					"id": 220100113,
					"content": "Evet! Arkadaş beni anlıyor. İlham lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100114
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100114,
					"content": "Etrafta dolaşıp ilham bulmaya çalışacağım... Aklıma illaki bir fikir gelir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100115
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100115,
					"content": "Hey! Geçen sayıda da teslimini geciktirmek için bu bahaneyi kullandın. Bu sefer olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100116
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100116,
					"content": "Bu defa yalan söylemiyorum. Hadi ya, bana bir güven artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100117
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100117,
					"content": "Hımm... İyi. Tamam. Ama bu son...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100118
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100118,
					"content": "Daha fazla gecikme istemiyorum! Anladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100119
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100119,
					"content": "Tamam tamam, anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100120
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100120,
					"content": "Of... Sanırım bu sefer erteleyemeyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100121,
						220100122
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100121,
					"content": "Gidip romanın için malzeme bulalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220100122,
					"content": "Haydi o zaman, sana aradığın ilhamı bulalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100123
					]
				},
				{
					"id": 220100123,
					"content": "O kadar kolay olsa keşke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100124
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100124,
					"content": "Ama bir şekilde bulmamız gerek yoksa Shigeru evimi başıma yıkacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
