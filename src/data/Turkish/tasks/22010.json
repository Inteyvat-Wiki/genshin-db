			"dialogs": [
				{
					"id": 220100916,
					"content": "Aslında Junkichi'nin fikri hiç de fena değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220100917
					]
				},
				{
					"id": 220100917,
					"content": "Fena değil mi? Böyle devam ederse yazdığı hikaye kendi kafasını bile karıştıracak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100918
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100918,
					"content": "Hahaha, gördün mü? Gezgin bana hak verdi. Fikrim ilgi çekici demek ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100919
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100919,
					"content": "Bir romanın en önemli özelliği heyecan verici ve sürükleyici bir olay örgüsüne sahip olmasıdır. Romanımı bunu göz önünde bulundurarak yazıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100920
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 220100920,
					"content": "*iç çeker* Sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220100921
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 220100921,
					"content": "Hadi hadi, sakin ol. Ben ne yaptığımı biliyorum. Okurlardan övgüler yağacak, göreceksin bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Junkichi"
				}
			]
		},
