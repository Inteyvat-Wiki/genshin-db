			"dialogs": [
				{
					"id": 760190301,
					"content": "... Eğer beni öldürmeye ya da parçalara ayırmaya geldiysen buyur. Karşı koymayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190302
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190302,
					"content": "#Hey, hey! {NICKNAME} ve Paimon asla böyle bir şey yapmaz! Sadece bir daha insanları kandırmayacağına söz ver, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190303,
					"content": "Vieri gibi bir mankafa bile... Bir dakika, o herif ne ara sıvıştı? Her neyse, aptal olsalar bile insanları kandırmamalısın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190304,
					"content": "Çoğu kişiden daha naziksiniz. Sumeru'da sizin gibi insanlarla karşılaşsaydım... Belki de bu hale gelmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190305
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190306
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190306,
					"content": "Başıma ne geldiğini merak etmiyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190307,
						760190308
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190307,
					"content": "İçimden bir ses bilmesem daha iyi olacağını söylüyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190309
					]
				},
				{
					"id": 760190309,
					"content": "Seni kurnaz seni... *iç çeker* Uzun zamandır düzgün bir anlaşma yapmadım. Belki de kariyerimi değiştirmenin zamanı gelmiştir artık. Voynich Loncasının peşime düşmesinden iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190310
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190310,
					"content": "Bunu daha önce anlamış olsaydın, az önce dayak yemezdin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190311,
					"content": "Bazen gerçek bir seçim yapmak için insanı sarsacak bir olay yaşamak gerekir. Öyle ya da böyle harekete geçmeni sağlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190312
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190312,
					"content": "Evlat, uçan ufaklık... Gün gelir de böyle bir motivasyona ihtiyaç duyarsanız beni bulun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190313
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190313,
					"content": "Şey... Teşekkürler ama Paimon buna gerek olmayacağını umuyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190314,
					"content": "Hidimbi arkasında kırmızı satenini bırakıp el sallayarak ayrılır...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
