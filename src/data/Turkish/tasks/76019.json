					}
				]
			},
			"dialogs": [
				{
					"id": 760190101,
					"content": "\"Bilginliğin İspatı\" mı? Dur... Paimon'un düşündüğü şey mi bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190102,
					"content": "N-Neden böyle başımıza dikildiniz ki? Çok gizli bir şey konuşuyoruz burada. Reed Miller'ın \"Büyük Hazine\"siyle ilgili ipucu bulduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190103,
						760190104
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190103,
					"content": "Harika! Ben de size katılayım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190105
					]
				},
				{
					"id": 760190105,
					"content": "Hımm... Haklısın. O halde birlikte çalışalım! Zaten başlangıç sermayesini toparlamakta zorlanıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190106
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190106,
					"content": "Bir pay bana, bir sana, bir de uçan ufaklığa. Toplam üç kişiyiz. Kişi başı yarım milyon Mora eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190107
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190107,
					"content": "Yarım milyon Mora mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190108,
					"content": "*iç çeker* Ama Vieri, hani bu konu ikimizin arasında kalacaktı? Sana güvendiğim için söyledim sırf bunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190109
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190109,
					"content": "Ama bir buçuk milyon Mora... Bu benim toplayabileceğim bir başlangıç sermayesi falan değil ki, servet. Taş çatlasa yarım milyon Mora toparlayabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190110
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190110,
					"content": "Bu ikisi tecrübeli maceracılar gibi görünüyor. Birlikte çalışırsak başarı şansımız artmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190111
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190111,
					"content": "Senden gerçekten umutluyum Vieri. Doğru kişileri bulduğunu düşünüyorsan ben de bir şans vermeye hazırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190112
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190112,
					"content": "Uçan arkadaşımıza gelince... Onun... Fiziksel yapısı göz önüne alındığında ona özel bir muamele göstermek icap eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190113
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190113,
					"content": "Vaaay! Bu Paimon'a bir hediye mi geliyor yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190114,
					"content": "Sayılır! Bu, Natlan'ın standart Güçlendirici Toniklerinin özel bir versiyonu. Daha fazla kişiye uyum sağlayacak şekilde ayarlamalar yaptık. Evet evet, uçan biri bile rahatlıkla kullanabilir. Tamamen güvenli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190115
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190115,
					"content": "Normal fiyatı iki milyon Mora ama Vieri ile birlikte olduğunuz için size tanıdık indirimi yaparım, yani sadece bir milyon. Ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190116
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190116,
					"content": "1.000.000 Mora mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190117,
						760190119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190117,
					"content": "Paimon, bu gerçekten özel bir sürpriz hediye!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190118
					]
				},
				{
					"id": 760190118,
					"content": "Tanıdık indirimi değil, tanıdık silkelemek denir buna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190121,
					"content": "Aynen öyle! Zaten uçan ufaklık pek işe yaramaz bence Bayan Hidimbi. Boşuna Güçlendirici Tonik verip ziyan etmeyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190122
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190122,
					"content": "Hey! Paimon'a ne demeye çalışıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190123,
					"content": "Hıh, hazineyle ilgili doğru düzgün bir ipucunuz var mı diye bir bakacaktık ama siz çok fena çıktınız... Biriniz tam bir çakal, diğeriniz ise düpedüz sersem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190124,
					"content": "#Ulu Maceracılar {NICKNAME} Paimon'un size kanacağını sandıysanız yanılıyorsunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190125,
					"content": "Çakal mı? Kandırmak mı? İpucu gerçek, mallar da gerçek. Fiyatına gelince... İş iştir. Ama dilin pabuç kadar oldu senin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190126
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190126,
					"content": "... Senin gibileri hiç çekemem. Kuru gürültüden ibaretsin, bir de üstüne başkalarının başarılarından pay çıkarmaya kalkıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190127
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190127,
					"content": "B-Bayan Hidimbi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190128
					],
					"speakerTitle": "Vieri"
				},
				{
					"id": 760190128,
					"content": "Sen de aynısın Vieri. Bu konunun aramızda kalacağına söz vermemiş miydik? Gizli bir şey konuşulacaksa eğilip sessizce söylersin, bağırarak etrafa duyurmazsın ki davetsiz misafirleri başımıza toplamayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190129
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190129,
					"content": "Tepemi attırdınız. Size biraz ders vermeden içim soğumayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190130
					],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190130,
					"content": "Al bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hidimbi"
				},
				{
					"id": 760190119,
					"content": "Yarım milyon Mora veririm, bir kuruş daha vermem. Kabul ettin, ettin. Etmezsen şansına küs.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190120
					]
				},
				{
					"id": 760190120,
					"content": "Neden pazarlık ediyorsun? Böyle bir şeye ihtiyacımız yok ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760190121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760190104,
					"content": "Birileri duyarsa sır olmaktan çıkar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760190105
					]
				}
			]
		},
