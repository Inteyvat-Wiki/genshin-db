					"content": "Galiba daha ileri gidemiyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200502,
					"content": "Gözünüzü dört açın. Yakınlarda Hiçliği hissediyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200503
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200503,
					"content": "Hiçlik Tarikatı! Gelmişler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
