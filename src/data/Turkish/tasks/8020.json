			"dialogs": [
				{
					"id": 80200101,
					"content": "Bir dakika... Şu adam... Dainsleif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200102,
					"content": "Aa, siz miydiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200103
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200103,
					"content": "Arkadaşınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200104
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80200104,
					"content": "Neyse, bana müsaade o zaman. Köye dönüp Amadhiah Reis'e ve diğerlerine baksam iyi olur. Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200105
					],
					"speakerTitle": "Atossa"
				},
				{
					"id": 80200105,
					"content": "Tamam! Görüşürüz Atossa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200106,
					"content": "Niye hep oradan buradan fırlıyorsun sen? Senin hayat gayen bizim ödümüzü koparmak falan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200107,
					"content": "Sizinle ilgili bir durum değil... Kasti de değil hatta. Hiçlik Tarikatının peşinde olduğumuz sürece yollarımız hep kesişecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200108
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200108,
					"content": "Ha, demek Hiçlik Tarikatını araştırmaya geldin buraya! Savaştığın canavarları açıklıyor bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200109,
					"content": "Tabii. Bir dakika... Siz de aynı nedenden ötürü gelmediniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200110,
						80200111
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200110,
					"content": "Biz de onların peşindeyiz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				},
				{
					"id": 80200112,
					"content": "Hım, önemli değil. Yetişmeniz biraz sürmüş olabilir fakat eminim fark etmişsinizdir... Burada tuhaf bir hava var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200113
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200113,
					"content": "Hiçlik Tarikatı bu civarda kesinlikle bir şeyler planlıyor... Hatta daha kötüsü, plan çoktan başlamış olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200114
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200114,
					"content": "Yani sence bölgedeki Dağ Yabanisi faaliyetinin arkasında Hiçlik Tarikatı mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200115,
					"content": "Mevcut duruma bakılırsa ana hedeflerinin o olduğunu sanmam. Dağ Yabanisi faaliyetindeki artış muhtemelen Tarikatın asıl hedefinin yan etkisidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200116
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200116,
					"content": "Ama yine de Dağ Yabanisi faaliyeti buradaki insanlar için sorun teşkil ediyor. Bir süre daha kalıp köyü korumalıyız. Öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200117,
					"content": "Köyü korumanın en iyi yolu Hiçlik Tarikatının asıl planını çözmek. İlerideki trajedilerin önüne ancak böyle geçebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200118,
						80200119
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200118,
					"content": "Köy sakinleriyle bir konuşalım bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200120,
					"content": "Cevaplarınızı alacaksınız. Sizden bir şey gizlemek gibi bir niyetim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200121
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200121,
					"content": "Merak etmeyin... Konuşacak bol bol vaktimiz olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200119,
					"content": "Ondan sonra... Bize bir sürü cevap borçlusun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200120
					]
				},
				{
					"id": 80200111,
					"content": "Ama itiraf edeyim, tesadüfen rast geldik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200112
					]
				}
			]
		},
