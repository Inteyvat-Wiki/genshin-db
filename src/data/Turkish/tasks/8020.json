			"dialogs": [
				{
					"id": 80200301,
					"content": "Demek ta buraya sakladın! Bulması kolay bir yer değilmiş kesinlikle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200302,
					"content": "Hadi güvende mi diye gidip bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200303,
					"content": "#{NICKNAME}, bir saniye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200304
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200304,
					"content": "Hım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200305
					]
				},
				{
					"id": 80200305,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200306
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200306,
					"content": "... Kaybedecek vaktimiz yok. İçeri girelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200307
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200307,
					"content": "(Dain bana ne diyecekti?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200308
					]
				},
				{
					"id": 80200308,
					"content": "Hey, bekleyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 802004,
