			},
			"dialogs": [
				{
					"id": 80200601,
					"content": "Tam da şüphelendiğim gibi... Sahte anılar tuzakmış. Hiçlik Tarikatı bizi buraya kadar takip etmek istemiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200602
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200602,
					"content": "Yakınımızda olduklarına göre şimdi görme fırsatımız var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200603
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200603,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200604
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200604,
					"content": "Dain? Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200605,
					"content": "Hissettiniz mi? Ley Hatlarında bir bozulma yaşandı. Kesin Hiçliğin işi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200606
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200606,
					"content": "Vay be, sen bu değişimlere karşı çok hassassın galiba. Paimon hiçbir şey hissetmedi çünkü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200607,
					"content": "Beni dinleyin... Şuradaki mekanizmayı kullanıp buradan çıkın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200608
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200608,
					"content": "Seni burada tek başına mı bırakalım? İyi olacak mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200609
					]
				},
				{
					"id": 80200609,
					"content": "Hiçlik Tarikatı bir şeyleri faaliyete geçiriyor. Vimara Köyü'ne dönerseniz kayıp köylüyü nihayet bulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200610
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200610,
					"content": "... Böl ve yönet taktiği uyguluyormuşuz gibi düşünün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200611
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200611,
					"content": "Peki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200612
					]
				},
				{
					"id": 80200612,
					"content": "(Dain haklı aslında...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200613
					]
				},
				{
					"id": 80200613,
					"content": "(Ama yine de bir gariplik var... Neyi kaçırıyorum acaba?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200614
					]
				},
				{
					"id": 80200614,
					"content": "Hah... Seninle yüz yüze görüşmek için bu tuzağa düşmem gerektiğini biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200615
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200615,
					"content": "Hem kendini hem gözün güvenliğini tehlikeye attın...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200616
					]
				},
				{
					"id": 80200616,
					"content": "Büyük bir risk aldın Dainsleif... Ama sanıyorum ki asıl ben Alacakaranlık Kılıcı'nın tuzağına düşüyorum.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200617
					]
				},
				{
					"id": 80200617,
					"content": "Buraya tek başına mı geldin? Müritlerin nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200618
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200618,
					"content": "Alacakaranlık Kılıcı savaşa hazırsa yollayacağım her orduyu ölüme gönderiyor olurdum... Seninle tek yüzleşmeyi tercih ettim.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200619
					]
				},
				{
					"id": 80200619,
					"content": "Söyleyecek çok şeyin var biliyorum...",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80200620
					]
				},
				{
					"id": 80200620,
					"content": "... Ama konuşmak istiyorsan önce beni yenmen gerekecek.",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": []
				}
			]
		},
