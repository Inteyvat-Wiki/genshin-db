				]
			},
			"dialogs": [
				{
					"id": 80200122,
					"content": "Öğrendikleriniz üzerinden bilgi toplamak için Vimara Köyü'ne dönüyorsunuz. Hava kararana kadar köylülerle konuşuyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80200123
					]
				},
				{
					"id": 80200123,
					"content": "Demek sizi Vimara Köyü'ne getiren görev oydu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200124
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200124,
					"content": "\"Yalnızca insanların anılarında var olan biri\"... Çok ilginç hakikaten. Elinizde sıradan bir kayıp vakası olmadığına katılıyorum. Fakat Hiçlik Tarikatı ile bir bağlantısı olup olmadığı henüz belli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200125
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200125,
					"content": "Elimizde yalnızca Dağ Yabanisi faaliyetindeki artış var, o da fazla yardımcı olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200126,
						80200127
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200126,
					"content": "O zaman...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				},
				{
					"id": 80200128,
					"content": "Doğru! Kardeşinin anısındayken duyduğu o gizemli ses... Kendine Günahkar demişti hani... Kimdi o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200129,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200130
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200130,
					"content": "#{NICKNAME}, sana şunu sorayım... Kardeşinin sana ihanet ettiğini düşünüyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200131,
						80200132
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200131,
					"content": "Ona inanmak istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200133,
					"content": "Hımm... Sesinde bir tereddüt duyuyorum. Sonuçta hâlâ ne yaşandığını tam anlamıyla çözebilmiş değilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200134
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200134,
					"content": "Hâlâ aranızı düzeltme şansınız var. Geri dönülemez bir yola girmiş değilsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200135
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200135,
					"content": "Sorduğunuz Günahkar... Onun durumu biraz farklı. O ve onun günahkar yoldaşları uzun zaman önce hem bana hem de uluslarına ihanet ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200136
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200136,
					"content": "Adı \"Kahin\" Vedrfolnir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200137
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200137,
					"content": "Bunu söylemeye utanıyorum fakat... Aynı zamanda kan bağımız var. Abim kendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200138
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200138,
					"content": "Abin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200139,
						80200140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200139,
					"content": "Ne yaşandı aranızda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200141,
					"content": "Beş kişilerdi... Khaenri'ah'nın Beş Günahkarı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200142
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200142,
					"content": "\"Bilge\" Hroptatyr, \"Kahin\" Vedrfolnir, \"Altın\" Rhinedottir, \"Kötülük\" Surtalogi ve \"Ay Avcısı\" Rerir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200143
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200143,
					"content": "Hafızam ne kadar aşınırsa aşınsın onların isimlerini asla unutmayacağım... Bir gün... İntikamımı alacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200144
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200144,
					"content": "Bir saniye! Saydığın isimlerin bazıları çok tanıdık geldi... Rhinedottir, Albedo'yu yaratan kişi. Surtalogi de Skirk'ün ustası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200145,
					"content": "Az önce öğrendiğimiz... Dain'in abisi Vedrfolnir... Günahkarın sesi oysa o zaman Chlothar'a Hiçlik Tarikatını kurduran da... Oydu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200146,
					"content": "Her şey birbiriyle bağlantılı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200147
					]
				},
				{
					"id": 80200147,
					"content": "(Eğer bu doğruysa o zaman Fontaine'deki harabede bulduğumuz şu taş levhalar... Fontaine'in kehanetinin anlatıldığı hani... Onları da Vedrfolnir yapmış olmalı.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200148
					]
				},
				{
					"id": 80200148,
					"content": "Zamanında Khaenri'ah'da büyük saygınlığa sahip kişilerdi, ulusun tüm umutlarını omuzlarında taşırlardı. Çalıştıkları alanlarda diğer meslektaşları arasında en iyileri onlardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200149
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200149,
					"content": "Altımız... Felaketi durduran biz olmalıydık. Uğursuz Kral'ın dünyanın temelini sarsmaya devam etmesini durduran bizler olmalıydık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200150
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200150,
					"content": "Fakat içten içe o beşi daha fazlasını istiyordu. Hiçliğin çağrısına karşı koyamadılar ve dünyayı yok edebilecek bir gücü kendi aralarında paylaştılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200151
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200151,
					"content": "Bu yüzden Günahkar oldular fakat aynı zamanda her biri dünyayı yıkma gücüne sahip üstün varlıklara dönüştüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200152
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200152,
					"content": "Felaket yaşandığında ise hiçbiri ulusunu savunmaya yeltenmedi. Hiçbiri o trajediyi önlemeye çalışmadı... Bu nedenle onları asla affetmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200153,
						80200154
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200153,
					"content": "Sonra da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200155,
					"content": "... Evet. Durdurulmazlarsa bir gün elbet tüm dünyaya ihanet edecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200156,
						80200157
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200156,
					"content": "Bu konuyu konuşmak senin için zor olsa gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200158,
					"content": "Ne demek. Demiştim, senden bir şey gizlemek gibi bir niyetim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200159
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200159,
					"content": "Peki bunca zamandır neyi araştırıyordun Dain?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200160,
					"content": "Kaderin Ağları hakkındaki bazı soruları araştırmaya devam ettim. Operasyon başlatılalı epey zaman geçmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200161
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200161,
					"content": "İlk Biçerdöverin gözünü alarak planlarının bir kısmının gerçekleşmesini önlemiş olduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200162
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200162,
					"content": "Aa, Paimon hatırladı! O gözü kullanarak Osial'ı yozlaştıracak ve tanrıya dönüştüreceklerdi sanki, öyle bir şeydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200163,
					"content": "Doğru... Fakat onun teknik bir deney olduğu aşikar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200164
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200164,
					"content": "Göz, planları için önemliydi fakat gözü ele geçirememiş olmalarına rağmen deney aşamasını atlayıp ilerlemenin başka bir yolunu bulmuşlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200165
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200165,
					"content": "Buna işaret eden pek çok delil var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200166
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200166,
					"content": "Ne yapacağız o zaman? Çok geç kalmadık değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200167
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200167,
					"content": "Şu an ilgilenmemiz gereken en önemli konu... Kaderin Ağları'nın amacını belirlemek. Ondan sonra Hiçlik Tarikatının asıl hedefini anlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200168
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200168,
					"content": "Şimdiye dek topladığım bilgilere bakılırsa Kaderin Ağları bir şekilde Ley Hatlarıyla ilgili duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200169
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200169,
					"content": "Ley Hatlarıyla mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200170
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200170,
					"content": "#{NICKNAME}, geçen sefer karşılaştığımızda kardeşinin anılarını izlemiştin, değil mi? Sanıyorum onun sebebi bölgedeki Ley Hatlarının dengesizliğiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200171
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200171,
					"content": "Son zamanlardaki araştırmalarım, Hiçlik Tarikatının faaliyette bulunduğu bölgelerde Ley Hatları sorunları yaşandığını gösteriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200172
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200172,
					"content": "Ley Hatlarından akan şeylerden biri de... Anılardır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200173
					]
				},
				{
					"id": 80200173,
					"content": "Bir dakika, o zaman Vimara Köyü'ndeki görevimiz... Yalnızca insanların anılarında var olan şu kişi... Bu olayla bağlantılı mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200174
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200174,
					"content": "(Anılar... Ley Hatları... Kaderin Ağları... Aslında var olmayan şu kayıp kişi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200175
					]
				},
				{
					"id": 80200175,
					"content": "(Aralarındaki bağlantı ne?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200176
					]
				},
				{
					"id": 80200176,
					"content": "Gayet mümkün. Yarın sizin araştırmanıza dahil olayım. Elimizdeki gizemleri çözmenin yolu bu kayıp vakasından geçiyor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200177
					],
					"speakerTitle": "Dainsleif"
				},
				{
					"id": 80200177,
					"content": "Dain'le beraber çalışacaksak enerjimizi saklamamız lazım! Yarın biraz daha uzakta bir yerleri araştırmayı deneyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200401
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200401,
					"content": "*esner*... Paimon dün beynini o kadar fazla kullandı ki şu an ölüyor yorgunluktan... Hep Dain'in suçu ama bu, karışık bir sürü şey anlattı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80200402,
						80200403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200402,
					"content": "Ben de pek iyi uyuyamadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200404,
					"content": "Gel gidip Dain'i bulalım. Bugün yapacak çok işimiz var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80200403,
					"content": "Başım ağrıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200404
					]
				},
				{
					"id": 80200157,
					"content": "Ama bana anlattığın için teşekkür ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200158
					]
				},
				{
					"id": 80200154,
					"content": "Kardeşim senin abinle karşılaştı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200155
					]
				},
				{
					"id": 80200140,
					"content": "O malum dönemde Khaenri'ah'da tam olarak ne yaşandı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200141
					]
				},
				{
					"id": 80200132,
					"content": "Evet, bir bakıma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200133
					]
				},
				{
					"id": 80200127,
					"content": "Bana sözünü verdiğin şu bilgiyi alalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80200128
					]
				}
			]
		},
