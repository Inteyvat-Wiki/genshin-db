			},
			"dialogs": [
				{
					"id": 101200301,
					"content": "Ah, Fahri Şövalye buradaymış! İstihbarat toplamaya gidiyordum ben de. Siz ikinizle karşılaşmayı beklemiyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200302
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200302,
					"content": "Ha? Yüz ifadene bakılırsa başın belaya girdi sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200303
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200303,
					"content": "Kumandan Jean bizi özel bir göreve gönderdi ama plan şimdilik suya düştü gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200304,
						101200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200304,
					"content": "Uzun hikaye...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				},
				{
					"id": 101200306,
					"content": "Üzülme, bazen işler planlandığı gibi gitmez. Ben bile göreve gittiğimde işe yarar bir istihbarat getireceğimin garantisini veremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200307
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200307,
					"content": "Yola devam edip asla pes etmemek gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200308,
						101200309
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200308,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200310,
					"content": "Hehe! Hey, size yardım etmemi ister misiniz? Mesele nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200311
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200311,
					"content": "Kumandan Jean, Schubert Lawrence diye biriyle bağlantıya geçmemizi istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200312,
					"content": "Ama çok tuhaf biri çıktı. Kimseye, hele Paimon'a hiç kulak asmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200313,
					"content": "Aha, Schubert'i biliyorum! Görgüsüz olduğunuzu söylemiştir kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200314,
						101200315
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200314,
					"content": "Demek duydun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200316,
					"content": "Hehehe, ben de zamanında onun görgü kuralı derslerinden payımı almıştım. Lawrence Klanı böyle şeylere fazla önem verebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200317
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200317,
					"content": "Ah... Lawrence Klanındaki herkes sürekli karın ağrısına mı yol açıyor yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200318,
					"content": "Aristokratlar, halka mesafeli davranmaları gerektiği kanısındalar. *iç çeker* Ne hissettiklerini anlıyorum ama işler artık böyle yürümüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200319
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200319,
					"content": "Ancak Lawrence Klanında o soylular gibi olmayan biri var. Dostum Eula!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200320
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200320,
					"content": "D-Dostun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200321,
					"content": "Evet! Hem Lawrence Klanının üyesi hem de Favonius Şövalyelerinde 4. Bölük'ün Yüzbaşısı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200322,
						101200323
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200322,
					"content": "Jean, Lawrence Klanının, Şövalyeleri düşman olarak gördüğünü söylemişti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200324,
					"content": "Eula özel biridir! Klanının diğer üyelerine pek benzemez. Kendi fikirleri var ve farklı olduğunu belli ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200325
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200325,
					"content": "Demek istediğim, ailesinin katı kurallarına ve geleneklerine pek bağlı biri değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200326
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200326,
					"content": "Lawrencelarla baş etmekle ilgili çok şey biliyor ama. Onunla tanıştığında ne demek istediğimi daha iyi anlayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200327
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200327,
					"content": "Hımm, garip. Eula, Lawrence Klanının bir üyesiyse Kumandan Jean neden görev için bizi seçti? Eula'ya soramaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200328,
					"content": "Ah, şey... Durumlar biraz karışık. Lawrence Klanı, Eula'nın Şövalyelere katılmasına karşı çıktı, ailesi ve akrabaları da ona pek değer vermiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200329
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200329,
					"content": "Onların gözünde Eula, ailesine ihanet eden biri sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200330,
						101200331
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200330,
					"content": "Sıradan birine benzemiyor cidden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200332,
					"content": "Anlaşması kolay birisidir. Durumu anlattığında Schubert'la geçinmenin bir yolunu bulmana yardım edecektir eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200333
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200333,
					"content": "Galiba bu sabah devriye görevi için ormana gitmişti. Fırtınakesen Dağları'nın orada onu bulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200334
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200334,
					"content": "Sağ ol Amber! Pekala, onu duydun, Eula'yı bulalım hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200335,
					"content": "Bol şans! Ben de kendi soruşturmama döneyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				},
				{
					"id": 101200331,
					"content": "Onların gözünden bakınca anlaşılır bir durum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200323,
					"content": "Lawrence Klanından bir üye nasıl olur da Şövalyelere katılır?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200315,
					"content": "Söylenmesine alışıksın sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200309,
					"content": "İşte bizim Amber.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200305,
					"content": "Bizim suçumuz değildi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				}
			]
		},
