					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"???",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200201,
					"content": "Ha? Siz de kimsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200202
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200202,
					"content": "Merhaba, biz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200203,
					"content": "Hımm. \"Merhaba\" mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200204,
						101200206
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200204,
					"content": "Ah, size de merhaba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200205
					]
				},
				{
					"id": 101200205,
					"content": "Yanlış duymadım değil mi? \"Merhaba\" mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200208,
					"content": "Hıh! Böyle elinizi kolunuzu sallayarak gelip rezil ve edepsiz hareketlerle beni selamlayabileceğinizi falan mı sandınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200209
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200209,
					"content": "Sizi buralarda hiç görmedim, gezgin olduğunuzu tahmin ediyorum. O zaman şunu bilesiniz ki yüce, soylu bir ailenin torunlarından olan Schubert Lawrence var karşınızda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200210
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200210,
					"content": "Bana hitap edecekseniz kelimelerinizi doğru seçmeye özen göstereceksiniz. Bu umursamaz tavırlarınız kabul edilemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200211
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200211,
					"content": "Şimdi, hani oldu da dediklerimi idrak edebildiyseniz diz çöküp savsak davranışlarınız için benden özür dileyin ve kendinizi düzgünce tanıtın. Görgü kurallarına uymak bunu gerektirir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200212
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200212,
					"content": "Bu görgü kuralı mı şimdi? Paimon hayatında bu kadar karmaşık bir şey duymadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200213,
					"content": "Hıh, insanların hadlerini bildiği ve geleneklere saygı duyduğu zamanlarda bir aristokratı selamlarken bu şekilde davranmak nezaket göstergesiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200214
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200214,
					"content": "Terbiyenizi takınmadığınızda da ayaküstü kırbaçlanırdınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200215
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200215,
					"content": "*iç çeker* Şimdiki dünyaya bakın bir de. Kurallar bir kenara atıldı, insanlarda edep, adap kalmadı. Öf, hiç bu kadar aşağılanmamıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200216,
						101200217
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200216,
					"content": "Bana biraz gereksiz tantana gibi geldi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200218,
					"content": "Ne dedin sen? Soyluların haysiyetini sorgulamaya mı cüret ediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200219
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200219,
					"content": "Lawrence Klanı gitgide güç kaybetse de ben ve diğer soylular hakkımız olanı geri almak için bir fırsat kolluyoruz, bunu bil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200220
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200220,
					"content": "Etrafına bir bak, bu insanlar zapt edilemiyorlar ve terbiyeden yoksunlar! Ben ise soyluların zarafetini ve görgü kurallarını geri getirmeye çalışıyorum. Sonuçta, hepimiz doğuştan ayrı dünyaların insanlarıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200221
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200221,
					"content": "Ağzımı bile açmadım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200222
					]
				},
				{
					"id": 101200222,
					"content": "Nefesini boşuna harcama, davranış şeklin midemi bulandırıyor. Senin gibilerle konuşacak bir şeyim yok benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200223
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200223,
					"content": "Hem, hiçbir şekilde sıradan insanlara nezaket öğretmek zorunda değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200224
					],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200224,
					"content": "Şimdi izninizle, yapmam gereken daha önemli işler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Schubert"
				},
				{
					"id": 101200217,
					"content": "Aristokrasinin neden güçten düştüğü anlaşıldı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200206,
					"content": "Evet, sıkıntı mı var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200207
					]
				},
				{
					"id": 101200207,
					"content": "\"Sıkıntı mı var\" derken? Ne dedin sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
