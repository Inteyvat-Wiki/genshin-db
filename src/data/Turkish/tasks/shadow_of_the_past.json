			},
			"dialogs": [
				{
					"id": 101200401,
					"content": "Hiç düşünmeden kılıcına davranıyorsun, değil mi? Öf, bu tipleri ne kadar süredir takip ediyordum, biliyor musun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200402
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200402,
					"content": "Şimdi üzerlerinde hak iddia edersin kesin. Hım, onları önce sen hakladın diye daha güçlü olduğunu mu sanıyorsun? Üf, intikamımı alacağım, şuraya yazıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200403
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200403,
					"content": "Ah... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200404,
					"content": "Anlamadım? İntikam mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200405
					]
				},
				{
					"id": 101200405,
					"content": "Aynen öyle. Gürültü patırtıyı duyar duymaz geldim ama bir de ne göreyim, Fatui'yle çatışmanız yetmiyormuş gibi bir de anında icaplarına bakmışsınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200406
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200406,
					"content": "Hamlemi yapmasaydım bütün payeyi sen alırdın kesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200407
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200407,
					"content": "Yine de yaralanmamanıza sevindim. Çok sayıda Fatui'yle mücadele etmek tehlikeli olabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200408,
						101200409
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200408,
					"content": "Aslında Fatui'yle dövüşmeye alışığım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200410
					]
				},
				{
					"id": 101200410,
					"content": "Ah... Üzgünüm, Paimon ne dediğini anlamadı ama... İlgin için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200411,
					"content": "İlgi mi? Baş düşmanlarımın güvende olmalarıyla neden ilgileneyim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200412
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200412,
					"content": "\"Baş düşmanlar\" mı? Bir saniye! Daha birkaç saniye önce \"yaralanmadığımıza\" sevinmemiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200413,
					"content": "Yaralansaydınız siz iki yabancıyı saldıracağım hedefleri benden çaldığınız için suçlu bulup Mondstadt'a kadar size eşlik etmem gerekecekti, bunu demek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200414
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200414,
					"content": "O zaman da başıma daha çok dert açardınız, ben de intikamımı hemen oracıkta alırdım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200415
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200415,
					"content": "Ha? Demek böyle düşünüyordun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200416,
					"content": "Sen Eula olmalısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200417
					]
				},
				{
					"id": 101200417,
					"content": "Evet, benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200418
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200418,
					"content": "Paimon, garip biri olduğunu düşünüyor... Ama en azından onunla konuşabiliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200419,
					"content": "Yeni tanıştığın birine nasıl \"garip\" dersin? Aristokrasiyi geçtim, normal şartlarda bile söylediğin çok kaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200420
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200420,
					"content": "Konusu açılmışken, adımı nereden biliyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200421
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200421,
					"content": "Tanıştırayım, Favonius Şövalyelerinin Fahri Şövalyesi. Kabalaşmak demişken, Schubert Lawrence adlı aristokrat hakkında bilgi bulmaya çalışıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200422,
					"content": "Görgü kurallarıyla kafayı o kadar bozmuş ki bizimle konuşmak bile istemiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200423,
					"content": "Hahaha! Şimdi anlıyorum. Kendisi amcam olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200424
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200424,
					"content": "Ama neden onun hakkında bilgi bulmak istiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200425
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200425,
					"content": "Fatui'yle gizlice görüştüğünden şüpheleniyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200426
					]
				},
				{
					"id": 101200426,
					"content": "Anladım. Haha, yüzüme karşı akrabalarımdan birine dil uzatacak kadar yüzsüzsünüz de. Bunun intikamını da alacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200427
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200427,
					"content": "Hayır, hayır. Kumandan Jean'in emri bu yönde! Bu sadece bir soruşturma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200428,
						101200429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200428,
					"content": "Amcanı merak etmiyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200430
					]
				},
				{
					"id": 101200430,
					"content": "Mondstadt halkı, Lawrence Klanındaki herkesin iğrenç insanlar olduklarını düşünüyor. Asılsız iddiaların ve dedikoduların şüphe uyandırması normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200431
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200431,
					"content": "Eski Mondstadt'ın namıdiğer acımasız yöneticileri olunca bu şekilde anılmamak zor tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200432,
					"content": "Demek öyle düşünüyorsun ha? İntikam alınacaklar listesine bu da eklendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200433
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200433,
					"content": "Bunu ilk sen dedin ama! Ayy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200434,
					"content": "Hahaha, ilginç... Henüz tanıştık ama şimdiden intikam almak için bana üç sebep verdiniz. Karşıma çıkanlar arasında sizin kadar ilgimi çeken başka kimse olmamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200435,
						101200436
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200435,
					"content": "İlginç bulduğun şey... İlginçmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200437
					]
				},
				{
					"id": 101200437,
					"content": "Lawrence Klanının görgü kurallarını öğretmemi istediğinizi varsayıyorum. O zaman amcamla diyaloğa girebileceksiniz, doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200438
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200438,
					"content": "Aynen öyle, Amber gelip seninle konuşmamızı söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200439
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200439,
					"content": "O halde hemen eğitiminize başlayalım. Mondstadt'a döndüğümüzde alıştırma yapmamız daha kolay olacak, başkalarından da yardım alacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200440,
						101200441
					],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200440,
					"content": "Bizden intikam alacaktın hani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200442,
					"content": "O konuyu şimdilik rafa kaldıralım. Mademki Büyük Kumandan Vekili sizi görevlendirmiş ve Amber da beni önermiş, size yardımcı olmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eula"
				},
				{
					"id": 101200441,
					"content": "Bunu intikam almak için bir fırsata çevirmeyeceksin, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200436,
					"content": "Neden yüzünde güller açıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200437
					]
				},
				{
					"id": 101200429,
					"content": "Amcan için endişelenmiyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200430
					]
				},
				{
					"id": 101200409,
					"content": "Dövüşmeyi iyi bilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200410
					]
				}
			]
		},
