			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jean",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200101,
					"content": "Böyle apar topar gelebildiğin için teşekkürler Fahri Şövalye. Meşgul olduğunu biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200102
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200102,
					"content": "Uzun lafın kısası, Şövalyelerin yardımına ihtiyacı var. İlgilenmeni istediğimiz özel bir durum var da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200103,
						101200105
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200103,
					"content": "Şövalyeler her zamanki gibi meşguller.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200104
					]
				},
				{
					"id": 101200104,
					"content": "*iç çeker* Evet, meselelerin ardı arkası kesilmedi bu aralar. Ben de Mondstadt garnizonları da rahat yüzü göremedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200107,
					"content": "Yakın zamanda Şövalyelerden, Lawrence Klanından birilerinin Fatui ile yakın ilişkileri olduğuna dair birçok rapor aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200108,
					"content": "Yine mi Fatui?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200109,
					"content": "Bu Lawrence Klanındakiler kim peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200110,
					"content": "Soyluların şehri yönettiği zamanlar Mondstadt tarihine kara bir leke olarak geçti. Decarabian'ın yenilmesi üzerine güçlükle kazanılan özgürlük tekrar elimizden alındı. Kölelik de tüm bölgede yaygınlaştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200111
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200111,
					"content": "İlk Karahindiba Şövalyesi olan Vennessa, eski aristokrat düzenini deviren ihtilalin öncüsü oldu. Favonius Şövalyelerini kurup bugünkü Mondstadt'ın temellerini attı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200112
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200112,
					"content": "Mondstadt halkına zulmeden aristokrat grubu ise Lawrence Klanından başkası değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200113
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200113,
					"content": "Ah, Paimon şimdi anladı. Klanın soyundan gelenler fesatlık yapmak için şu an kötülerle bir olup kötü planlar mı yapıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200114,
					"content": "Şüphemiz o yönde ama henüz somut bir kanıt elde edemedik. Sizi bugün buraya bu yüzden çağırdım. Konunun derinine inmemize yardım etmenizi istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200115,
						101200116
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200115,
					"content": "Peki neden biz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200117,
					"content": "*iç çeker* Ne yazık ki Favonius Şövalyeleri ve aristokratlar, kendimi bildim bileli birbirlerinden pek haz etmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200118,
					"content": "Farklılıklarımız konusunda uzlaşmak adına mümkün olan her yolu denedik ama aristokratların torunları Şövalyelere muhalif olmaya devam ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200119
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200119,
					"content": "Onlarla baş ederken izlediğimiz tutum ne olursa olsun sonuç hep aynı. Çabalarımız yangına körükle gitmekten başka bir işe yaramadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200120
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200120,
					"content": "Arama emri çıkartıp kapılarını çalabilirdik ama soruşturmadan bir şey çıkmazsa bu, aramızdaki gerginliği ve kutuplaşmayı had safhaya çıkarır maalesef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200121
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200121,
					"content": "Şu ana dek verdiğimiz onca emek boşa gider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200122
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200122,
					"content": "Fakat Fahri Şövalye olarak ben de Şövalyelerden biri sayılırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200123
					]
				},
				{
					"id": 101200123,
					"content": "Aslında Favonius Şövalyelerini temsil etmek için en iyi aday sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200124
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200124,
					"content": "Ama Fahri Şövalye rolünü özellikle belirtmene gerek yok. Uzak diyarlardan gelmiş bir gezginsin. Bu konumunu kullanarak soylularla görüşebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200125
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200125,
					"content": "Lawrence Klanıyla samimi oldun mu Fatui'yle olan olası ilişkileri hakkında daha fazla bilgi edinecek konuma gelmiş olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200126
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200126,
					"content": "Vay be, Kumandan Jean yine kusursuz bir plan yapmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101200127,
					"content": "Haha, o kadar çok diplomatik sorunla baş ettim ki böyle planlar yapmak alışkanlık haline gelmiş olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200128,
					"content": "Lawrence Klanının mevzubahis üyesinin ismi Schubert. Son günlerde sık sık şehrin kuzeyindeki surların yakınında takılıyormuş. Onu orada bulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200129,
					"content": "Kaprisli tavırlarından dolayı anlaşması zor birisiymiş ama onunla sakince konuşursanız bir aksilik çıkacağını sanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200130,
						101200131
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200130,
					"content": "Bana güvenebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200132,
					"content": "Yardım için tekrardan teşekkürler. Herhangi bir aksilikle karşılaşırsanız siz ikinize destek olmak için elimden geleni yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 101200131,
					"content": "Umarım işler yolunda gider.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200116,
					"content": "Favonius Şövalyelerinin işi değil mi bu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200105,
					"content": "Tipik bir Kumandan Jean konuşmasıydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200106
					]
				},
				{
					"id": 101200106,
					"content": "Fırsatını bulduğumda seninle konuşmak istiyordum ama bildiğin üzere Mondstadt'ın güvenliği öncelikli meselem olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "Jean"
				}
			]
		},
		{
			"id": 1012002,
			"completionStepIds": [
				1012003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012003",
