		},
		{
			"id": 2210710,
			"completionStepIds": [
				2210710
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210710",
							"2"
						],
						"stepId": 2210710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071001,
					"content": "Çatıda birkaç kuş var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071002
					]
				},
				{
					"id": 221071002,
					"content": "Anladım... Şahane! İşte bu iyiye işaret!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071003
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071003,
					"content": "Sırf birlikte olabilmek için sürülerini geride bırakan iki güvercin... Kanat kanada ufka doğru süzülürken sadece birbirilerini düşünüyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071004
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071004,
					"content": "Bu işaret tek bir anlama gelebilir, yakında beni, sadece beni sevecek gerçek aşkımla tanışacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071005
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071005,
					"content": "Sonra bu kişi tüm zorluklara karşı savaşacak, onu caydırmak isteyen tüm engelleri yıkacak ve sonunda birlikte olacağız. Birlikte tüm dünyaya kafa tutacağız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071006
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071006,
					"content": "Öhöm! Teşekkürler... Bunu Qiming'e de bir sorayım tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210711,
			"completionStepIds": [
				2210711
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210711",
							"2"
						],
						"stepId": 2210711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071101,
					"content": "Bugün bir tüccarın işleri iyi gidiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071102
					]
				},
				{
					"id": 221071102,
					"content": "İşleri açılmış ve geliri katlanmış mı? Hiç fena değil... Umut verici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071103
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071103,
					"content": "Herkes ektiğini biçer. Sabır ve adanmışlık eninde sonunda karşılığını verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071104
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071104,
					"content": "Aşk da aynıdır! Tanrım, şimdi her şey çok daha net! İnsanın, aşk hayatına sabır ve çabayla yaklaşması gerek. Ancak ve ancak bu şekilde bir aşk filizlenebilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071105
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071105,
					"content": "Öhöm! Teşekkür ederim. Tabii bunu önce iyice düşünüp tartmalıyım. Kim bilir tam olarak ne anlama geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071106
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071106,
					"content": "Ah Qiming! Elbet bir gün o gün gelecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
		{
			"id": 2210712,
			"completionStepIds": [
				2210712
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2210712",
							"2"
						],
						"stepId": 2210712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhihua"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221071201,
					"content": "Kuru yapraklar...?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071202
					]
				},
				{
					"id": 221071202,
					"content": "Cidden mi? Paimon bile kuru yapraklar ve aşk arasında hiçbir ortak yanın olmadığını biliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071203,
					"content": "Tam aksine, ikisi birbiriyle çok yakından alakalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071204
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071204,
					"content": "Şu kuru yapraklara bakıp solmuş ve kaybolmuş olduklarını düşünebilirsin... Ama ben potansiyel görüyorum. Hem de sınırsız bir potansiyel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071205
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071205,
					"content": "Tüm bu yaprakları harlı bir yangına dönüştürmek için tek gereken ufak bir kıvılcım. Aniden esen hafif bir rüzgar bile yaprakları görkemli bir şekilde göklere taşıyabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071206
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071206,
					"content": "Karşılıksız aşkıma yaraşır bir benzetme... Bu kadar zamandır hep kalbimde saklı... Tek bir şeyin, her bir şeyi değiştireceği anı bekliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071207
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071207,
					"content": "*iç çeker* Ne yazık ki böyle şeylerin kararı kadere kalmış. Dönüm noktasının ne zaman nasıl geleceğini kim bilebilir ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071208
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071208,
					"content": "İnancımı kaybetmemeliyim. Her işte bir hayır vardır, sabretmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071209
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071209,
					"content": "Ayrıca, teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
