			"dialogs": [
				{
					"id": 221071601,
					"content": "Çatıda birkaç kuş var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071602
					]
				},
				{
					"id": 221071602,
					"content": "Anladım... Şahane! İşte bu iyiye işaret!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071603
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071603,
					"content": "Sırf birlikte olabilmek için sürülerini geride bırakan iki güvercin... Kanat kanada ufka doğru süzülürken sadece birbirilerini düşünüyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071604
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071604,
					"content": "Bu işaret tek bir anlama gelebilir, yakında beni, sadece beni sevecek gerçek aşkımla tanışacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071605
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071605,
					"content": "Sonra bu kişi tüm zorluklara karşı savaşacak, onu caydırmak isteyen tüm engelleri yıkacak ve sonunda birlikte olacağız. Birlikte tüm dünyaya kafa tutacağız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071606
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071606,
					"content": "Öhöm! Teşekkürler, çok sağ olun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071607
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071607,
					"content": "Acaba kaderin ağları, tanışmalarına... birbirlerini anlayabilmelerine ve gerçek aşkı yaşayabilmelerine nasıl vesile oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071608
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071608,
					"content": "*iç çeker* Keşke güvercin olsaydım... Başka bir güvercinin tatlı aşkının, gagamda bırakacağı tadı hissetmenin nasıl bir şey olduğunu asla bilemeyeceğim... Ah acımasız kader!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071609
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071609,
					"content": "O zaman güvercinin kendi tadına bakmaya ne dersin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071610
					]
				},
				{
					"id": 221071610,
					"content": "Güvercinin tadı mı? Yok canım... Yapmamışsındır... Yok, mümkün değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071611
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071611,
					"content": "Ne yaptın sen? Metaforik konuşuyordum aptal! Metafordu o! Soyut aşk kavramını gerçekten yemek istediğimi düşünmüş olamazsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071612
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071612,
					"content": "Bazı insanların doğuştan romantik olamadığını biliyorum ama sen bunu bambaşka bir düzeye taşıdın! Tanrım, acaba bu kaderimi nasıl etkileyecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071613
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071613,
					"content": "Ben sadece... Boş ver, unut gitsin. Sakinleşmek için biraz yalnız kalmam gerekiyor. Sen bugün yapman gereken diğer işlere dön, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
