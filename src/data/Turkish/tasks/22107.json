				{
					"id": 221071401,
					"content": "Bir köpek sürüsü.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071402
					]
				},
				{
					"id": 221071402,
					"content": "Olamaz... Bu nasıl bir kıyamet alametidir? Aşk hayatım başlamadan bitecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071403
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071403,
					"content": "Dur, ne? O köpekçikler dost canlısıymış gibiydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071404,
					"content": "O köpek sürüsünü biliyorum. Birbirlerine karşı çok arkadaş canlısıdırlar ve hep birlikte geziyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071405
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071405,
					"content": "Bu iyi bir şey gibi geliyor aslında ama... Hiçbiri kendine eş bulamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071406
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071406,
					"content": "Eninde sonunda yaşlanacaklar ve her şey için çok geç olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071407
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071407,
					"content": "Bu işaret bana, hiçbir zaman eş bulamayacağım için zamanımı dostlarımla geçirmem gerektiğini mi söylüyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071408
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071408,
					"content": "Oturmam gerek... Oturup uzun uzun, etraflıca düşünmeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
