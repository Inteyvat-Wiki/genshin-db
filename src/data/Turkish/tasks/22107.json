				{
					"id": 221071807,
					"content": "Saygılarını sunma fırsatı bulmana sevindim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071808
					]
				},
				{
					"id": 221071808,
					"content": "Nasıl yani? Balık burada... Balığı yanında mı getirdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071809
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071809,
					"content": "Yani, çaresiz kedi dostu dehşet içinde izlerken, sen bu zavallı balığı kaçırdın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071810
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071810,
					"content": "Kaç kişinin türler arası arkadaşlığa şahitlik etme imkanı olur ki? Sen de gidip onları birbirinden mi ayırdın? Bu tarz şeyleri koruman gerekir aptal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071811
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071811,
					"content": "Hepsini bir kenara koyarsak, bu mükemmel bir işaretti ve sen onu berbat ettin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071812
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071812,
					"content": "Lütfen, yalvarırım beni yalnız bırak. Biraz yalnız kalmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
