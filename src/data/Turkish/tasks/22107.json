					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071302
					]
				},
				{
					"id": 221071302,
					"content": "Tanrım, ne harika bir işaret. Aradığın şeyin ne olduğunu biliyormuşsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071303
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071303,
					"content": "Mükemmel bir dostluk... Hem kedi hem de balık takdire şayan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071304
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071304,
					"content": "Aşkın anlamı da tam olarak bu değil mi? Aşkın gücü gerçekten tüm sınırları aşabiliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071305
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071305,
					"content": "İkisine de saygım gerçekten sonsuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071306
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071306,
					"content": "Bu işaret bana açıkça... Aşkın yolunda hiçbir engelden korkma diyor. Qiming ancak o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071307
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071307,
					"content": "... Her neyse, teşekkürler! Çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
		},
