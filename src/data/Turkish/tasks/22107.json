				{
					"id": 221071901,
					"content": "Bir köpek sürüsü.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071902
					]
				},
				{
					"id": 221071902,
					"content": "Olamaz... Bu nasıl bir kıyamet alametidir? Aşk hayatım başlamadan bitecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071903
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071903,
					"content": "Dur, ne? O köpekçikler dost canlısıymış gibiydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 221071904,
					"content": "O köpek sürüsünü biliyorum. Birbirlerine karşı çok arkadaş canlısıdırlar ve hep birlikte geziyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071905
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071905,
					"content": "Bu iyi bir şey gibi geliyor aslında ama... Hiçbiri kendine eş bulamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071906
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071906,
					"content": "Etrafında sürekli arkadaşları olduğu için, bu durum onları rahatsız etmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071907
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071907,
					"content": "Artık kendilerine partner bulmak için istekli olabilirler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221071908
					]
				},
				{
					"id": 221071908,
					"content": "İstekli mi? Bir saniye... Grubu kovalayıp birbirinden mi ayırdın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071909
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071909,
					"content": "Aslında... Bu gerçekten işe yarayabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071910
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071910,
					"content": "Bazen kendi ördüğün kader ağlarından kurtulmak için dışarıdan bir güç gerekir... Gerçek aşkı bulman adına seni özgür kılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071911
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071911,
					"content": "Şahane! Ne kadar teşekkür etsem az. Bu işaretin ne anlama geldiğini artık çok iyi biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221071912
					],
					"speakerTitle": "Zhihua"
				},
				{
					"id": 221071912,
					"content": "Qiming... Yemin ederim ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhihua"
				}
			]
