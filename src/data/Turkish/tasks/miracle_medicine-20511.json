				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "Bu reçete gerçekten işe yarayacak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110102,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "Gezgin! Harika zamanlama. Sıkıntılı bir durumdayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110104,
					"content": "Olay şu. Kız kardeşim Anna'yı hatırlıyorsun, değil mi? Hep hastaydı ve hiçbir şey onu iyileştiremedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110105,
					"content": "Ancak Liyue Limanı'nda şifasız hastalıklara şifa bulan harika bir doktor olduğunu duydum. Ben de ona reçete yazdırmak için birinden yardım istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110106,
					"content": "Malzemelerin hepsi çok garip ama deneyebiliriz sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110107,
					"content": "Bakayım... Bir adet Yarı Sindirilmiş Böğürtlen bulmama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110108,
					"content": "Öyle bir şey mi varmış?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "Hiçbir fikrim yok! Doğa Bodurlopları böğürtlen yiyor mu ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110110,
					"content": "Neyse, sana güveniyorum! Hem Bodurlop hem de böğürtlen bulabileceğin bir yer biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110111,
					"content": "Lütfen benim için gidip bir bak. Umarım bir şeyler bulursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110112,
					"content": "Bu doktor bir sahtekar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "Sen de böyle düşünüyorsun demek. Ancak başka bir seçeneğim kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110114,
					"content": "Hem bodurlop hem böğürtlen bulabileceğin bir yer biliyorum. Lütfen benim için gidip bir bak, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110115,
					"content": "Önce bizim yaptığımız ilacı deneyeceğim. Ne olursa olsun Anna'nın durumunun kötüye gitmesine izin veremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110116,
					"content": "Senin için bir Doğa Bodurlopu yakalayabilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "Şey... Ne? Doğa Bodurlopunun ağzına böğürtlen tıkmamı mı söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110118,
					"content": "Sağ ol kalsın! Anna'nın ilacı için bitki toplamaya gittiğimde bir grup Doğa Bodurlopu beni Pınarköy'e kadar kovaladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110119,
					"content": "Hem bodurlop hem böğürtlen bulabileceğin bir yer biliyorum. Lütfen benim için gidip bir bak, olur mu? Umarım bir şeyler bulursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 205110120,
					"content": "Ama... Hiçbir şey bulamazsan lütfen Anna için bir Doğa Bodurlopu yakala ve buraya getir. Yapabilirim... Yapacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anthony"
				}
			]
		},
