			"dialogs": [
				{
					"id": 250350801,
					"content": "İki... Üç... Hepsi tamam! Muhteşem iş çıkardın, tüm paketleri getirmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350802
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350802,
					"content": "... Bir dakika, bunu Tundama teslim etmeyecek miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350803
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350803,
					"content": "Neyse, al bakalım ödemeni. Yardımın için çok sağ ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350804
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350804,
					"content": "Of, Tundama'yla oturup ciddi bir konuşma yapmam gerekecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				}
