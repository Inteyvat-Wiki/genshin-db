				"objectNames": [
					"Michica"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250350101,
					"content": "Aptallar... Nasıl yine paket kaybettiler? Teslimat yaparken saçma sapan işlere bulaşmasınlar diye tembihledim kaç kere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350102
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350102,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350103
					]
				},
				{
					"id": 250350103,
					"content": "Birkaç Kuryemiz talimatları yine iplememiş ve bir sürü paketi kaybetmişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350104
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350104,
					"content": "*iç çeker* Bu dikkatsizlikleri yüzünden Gök Kubbenin Evlatlarının itibarını zedelediklerinin farkında değiller mi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350105
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350105,
					"content": "Mesaideysen paketlerini teslim etmeye odaklanacaksın! Yokuş aşağı iniyorsan her zamanki gibi ineceksin. Tatilde kaydıraktan kayarmış gibi yokuş aşağı kayılır mı hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350106
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350106,
					"content": "Kaç defa dedim onlara ama haylaz gençler dinlemiyor ki. Anca ucuz heyecanlar peşinde koşsunlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350107
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350107,
					"content": "*iç çeker* Şimdi kaybettikleri paketleri toplamak için birini göndermem gerek. Düşüneyim, kim müsait acaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350108,
						250350111
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350108,
					"content": "Ben el atarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350109
					]
				},
				{
					"id": 250350109,
					"content": "Y-Yardım eder misin bana gerçekten? Çok sağ ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350110
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350110,
					"content": "Yardımcı olacak birini bulmam çok uzun sürerdi. Kendim arayayım desem Kurye Evine göz kulak olacak kimse kalmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350117,
					"content": "Bu arada merak etme, samanlıkta iğne aramaya göndermem seni. Bu çocuklar genelde aynı rotadan gider, paketlerin nerede kaybolduğunu az çok tahmin edebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350118
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350118,
					"content": "Olası konumları işaretleyeceğim. Şimdiden teşekkürler, sana güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350111,
					"content": "Paketler büyük mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350112
					]
				},
				{
					"id": 250350112,
					"content": "Yok, değiller. O yüzden bulması zahmetli olacak zaten. *iç çeker* Ah şu dikkatsiz çocuklar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350113
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350113,
					"content": "... Vaktin varsa paketleri arayabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350114
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350114,
					"content": "Kurye Evinde insan gücü şu aralar biraz kısıtlı, kendim arayacak olsam buraya bakacak kimse kalmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350115
					],
					"speakerTitle": "Michica"
				},
				{
					"id": 250350115,
					"content": "Sıkıntı yok, ben hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250350116
					]
				},
				{
					"id": 250350116,
					"content": "Süper! Çok sağ ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250350117
					],
					"speakerTitle": "Michica"
				}
			]
		},
