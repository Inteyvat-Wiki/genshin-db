				{
					"id": 718110412,
					"content": "Kamera hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "Fotoğrafları teslim edebildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110402,
					"content": "Evet, ettim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "Sağ ol, çok sağ ol. Sana da zahmet oldu kusura bakma, ama işlere yetişmekte gerçekten zorlanıyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110404,
					"content": "Hah, evet. Lütfen bu Kamerayı yardımların için bir teşekkür olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110405,
					"content": "Bunu kabul edemem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "Lafı bile olmaz. Sonuçta bize o kadar yardım ettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110408,
					"content": "Aşırı pahalı bir şey de değil zaten. Fontaine'deki iş ortaklarımızın bize verdiği bir numune bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110409,
					"content": "Satışa çıkan model ile bunun arasında birtakım farklar var... Fakat temel işlevlerinde hiçbir sorun yok. Senin ihtiyacını kesinlikle karşılayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110410,
					"content": "Ayrıca olur da beğenirsen başka yerlerde reklamını yapıp bize yardımcı olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110411,
					"content": "Öhöm... Her neyse, yardımın için sağ ol. Lütfen bu Kamerayı al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xu"
				},
				{
					"id": 718110406,
					"content": "Bu çok pahalıdır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
