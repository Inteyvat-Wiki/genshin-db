					]
				},
				{
					"id": 718110603,
					"content": "Ah, doğru ya. Feiyun Ticaret Loncasına gidip burada bir resmimi çekmelerini istemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
