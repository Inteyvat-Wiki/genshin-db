					"nextDialogs": [
						718110503
					]
				},
				{
					"id": 718110503,
					"content": "Kamera... Ah, evet, birkaç gün önce Feiyun Ticaret Loncasına gitmiştim. Buraya gelip resmimi çekmelerini istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110504
					],
					"speakerTitle": "Shan Nine"
				},
				{
					"id": 718110504,
					"content": "Buraya resmi teslim etmek için mi geldin? Teşekkür ederim, çok naziksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shan Nine"
				}
			]
		},
