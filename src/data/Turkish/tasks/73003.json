			"dialogs": [
				{
					"id": 730030301,
					"content": "Oh be... Sonunda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030302,
					"content": "Rana... *ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030303,
					"content": "Iotham... Geçti ufaklık, ağlayacak bir şey yok. Hem bak... Akademi araştırmacılarına gidip... Solduran Bölgede hissettiklerimi anlatırsam... Solduranı kökünden çözmenin bir yolunu bulabilirler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030304,
					"content": "#Bak... Nasıl savaştım... Gördün mü? Yok, yok... Asıl {NICKNAME} nasıl savaştı gördün mü? Ona mutlaka teşekkür et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030305,
					"content": "Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030306,
					"content": "Lütfen, bu kadar yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "Artık dinlen Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030309,
					"content": "Ha... Haha... Ben iyiyim. Biraz başım dönüyor o kadar. Biraz da yorgunum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030310,
					"content": "Rana... Özür dilerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030311,
					"content": "Ne diyorsun... Böyle şeyler söyleme... Sen benim küçük kaplanımsın, kaplanlar ağlamaz! İyisin, değil mi? Bir yerin incindi mi Iotham? Başın dönüyor mu, yorgun hissediyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030312,
					"content": "Ben iyiyim Rana ama sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030313,
					"content": "Sorun değil... İyi olacağım. Yılların Orman Gözcüsünü yıkmak o kadar kolay değil! Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030308,
					"content": "Ben yardım çağıracağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
