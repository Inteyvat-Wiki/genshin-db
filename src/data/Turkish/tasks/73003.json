						730030704
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030704,
					"content": "Neler oluyor burada? Iotham ve Rana'nın bahsettiği Ara bilmem nesi bu mu acaba? Adı neydi bunun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030705,
						730030708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030705,
					"content": "\"Ararakalari\" mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030706
					]
				},
				{
					"id": 730030706,
					"content": "Evet, o! Paimon'un hatırladığı kadarıyla Marananın yarattığı aşınmaya karşı dayanabiliyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030707,
					"content": "Evet. Nara zeki. Ararakalari, Maranaya karşı dirençlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030711,
					"content": "Aah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030712,
					"content": "Aah!",
