					"speakerTitle": "Rana"
				},
				{
					"id": 730031106,
					"content": "Neyse artık, daha sonra konuşuruz bunları. Iotham mağaranın derinliklerinde bir yerde olmalı. Aramaya devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
