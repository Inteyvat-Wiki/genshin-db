			},
			"dialogs": [
				{
					"id": 730030801,
					"content": "#Üzgünüm... Dinlenmem gerek {NICKNAME}, Paimon... Beni bekle Iotham.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030802
