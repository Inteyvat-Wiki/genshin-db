					"speakerTitle": "Rana"
				},
				{
					"id": 730030802,
					"content": "İyi olduğuna emin misin Rana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030803,
					"content": "Biz yardım çağıralım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030804
					]
				},
				{
					"id": 730030804,
					"content": "Hayır, hayır, sorun yok... Sadece biraz... Dinlenmeye ihtiyacım var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030805
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030805,
					"content": "Özür dilerim Rana... Özür dilerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030806
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030806,
					"content": "Yapma şunu... Kaç kere söyleteceksin? İyiyim ben! Çok sinirliyim, o ayrı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030807
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030807,
					"content": "Söz vermiştin... Ormana gitmeyecektin. Dinlendikten sonra, sana sözünü tutmadığın için dersini vereyim de gör... Seni haylaz seni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030808
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030808,
					"content": "*ağlar* Alphonso buradaki mantarların çok büyük olduğunu söyledi! Ben de sana taze mantar getirmek istedim... Enerji versin diye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030809
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030809,
					"content": "Budala seni... Hiç gerek yoktu. Sizi düşünmek, enerjimi toplamama yetiyor da artıyor zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030810
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030810,
					"content": "Haklısın, hahaha... Buradaki mantarlar gerçekten de kocamanmış... Köriyle çok iyi gider bunlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030811
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030811,
					"content": "Buraya gelmene Alphonso mu izin verdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030812
					]
				},
				{
					"id": 730030812,
					"content": "Hayır... Alphonso bana ormana gitmememi öğütledi ama ben Rana'ya yemesi için lezzetli bir şeyler getirmek istedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030813
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030813,
					"content": "Alphonso öyle bir şey yapmaz. Iotham'ın abisi o...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030814
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030814,
					"content": "Paimon anlıyor... Peki Solduran Bölgede nasıl hapis kaldın Iotham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030815
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030815,
					"content": "Ormandayken birinin beni takip ettiğini zannettim... Çok korktum, Marananın Cismi peşime düştü sandım... Koşmaya başladım... *ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030816
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030816,
					"content": "Meğerse koştuğum yerde Marana varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030817
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030817,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030818,
						730030823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030818,
					"content": "\"Marana\" mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030819
					]
				},
				{
					"id": 730030819,
					"content": "Bu... Solduran...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030820
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030820,
					"content": "Ah... Evet, Solduran.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030821
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030821,
					"content": "\"Marananın Cismi\" mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030822
					]
				},
				{
					"id": 730030822,
					"content": "Evet. Marana adına dünyaya kötülükler yapar... Kocaman ve simsiyahtır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030828,
					"content": "Marana... Ne kadar da tuhaf bir isim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030829,
					"content": "Ah... Marananın Solduran demek olduğunu nereden biliyorum ben? Off... Başım dönüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030830
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030830,
					"content": "Şu yeşil şey neydi Iotham?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030831
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030832
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030832,
					"content": "Ararakalariydi... İnsanları Marananın yarattığı aşınmadan korur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030833
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030833,
					"content": "Kafam giderek daha fazla karışmaya başladı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030834
					]
				},
				{
					"id": 730030834,
					"content": "Bu... Bu bir çeşit orman büyüsüdür, aynı zamanda müziktir... Bir Aradır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030835,
						730030837
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030835,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030836
					]
				},
				{
					"id": 730030836,
					"content": "Şimdi onu boş ver Rana, sen dinlenmene bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030838,
					"content": "Dilimin ucunda ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030839
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030839,
					"content": "Özür dilerim Rana, çok özür dilerim... Bir daha asla kaçmayacağım, uslu olup evde oturacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030840
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030840,
					"content": "Biliyorum. Akıllanacak, sağlığına kavuşacak ve doğruyla yanlışı ayırt edebileceksin... Bu tıpkı, zamanla hangi mantarların yenilebilir hangilerinin zehirli olduğunu öğrenmek gibidir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030841
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030841,
					"content": "Evet, haklısın... Özür dilerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030842
					],
					"speakerTitle": "Iotham"
				},
				{
					"id": 730030842,
					"content": "#Marananın kötü, ormanın ise iyi olduğunu bil... İyice güçlen ve iyi biri olup yardıma ihtiyacı olanlara yardım et... Tıpkı {NICKNAME} ve Paimon gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030843
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030843,
					"content": "Ayrıca asla unutma... Orman hatırlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030844
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030844,
					"content": "Ah, durum vahim. Paimon, Rana'nın durumunun kötüleştiğini düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030845,
						730030846
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030845,
					"content": "Ben yardım çağıracağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030847,
					"content": "Ha? Ah... Bir şeyim yok, gerçekten... Biraz daha dinlenmem lazım sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030848
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030848,
					"content": "#{NICKNAME}, lütfen... Benim için Iotham'ı geri götür...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030849
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730030849,
					"content": "Tamamdır. Hadi gidelim Iotham. Bir yere kımıldama Rana! Hemen döneceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030846,
					"content": "Rana, bizi bekle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030837,
					"content": "Sen dinlenmeye odaklan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030838
					]
				},
				{
