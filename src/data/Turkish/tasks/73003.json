					"nextDialogs": [
						730031005
					]
				},
				{
					"id": 730031005,
					"content": "Nasıl yani? Alphonso'nun bahsettiği Fatui mi bunlar? Siz burada ne arıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031006
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031006,
					"content": "Alphonso mu? Neyse ne, buradan elinizi kolunuzu sallayarak geçebileceğinizi sanıyorsanız, yanılıyorsunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730031007
					],
					"speakerTitle": "Fatui Çavuşu"
				},
				{
					"id": 730031007,
					"content": "Anlaşıldı, konuşarak bir yere varamayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730031004,
					"content": "Bunlar Fatui. Dikkatli olun.",
