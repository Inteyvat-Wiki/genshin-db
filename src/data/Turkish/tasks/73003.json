						730030713,
						730030715
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030713,
					"content": "Bu daha önceden gördüğümüz şey değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030714
					]
				},
				{
					"id": 730030714,
					"content": "Off... Paimon'u korkuttun! Paimon, seni konuşan bir sebze sandı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030716,
					"content": "Sebze değil, Arana. Arana bir Aranaradır, Arana dosttur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030717,
						730030722
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030717,
					"content": "\"Aranaralar\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030718
					]
				},
				{
					"id": 730030718,
					"content": "Ne? Aranara mı dedin? Sahi ya, Paimon sana biraz daha dikkatli bakınca, seni daha önce de gördüğümüzü fark etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030719
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030719,
					"content": "\"Arana\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030720
					]
				},
				{
					"id": 730030720,
					"content": "Iotham'ın hikayesini dinlerken bu ismi duymuştuk sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030721,
					"content": "Evet. Nara Iotham, Arana'nın dostudur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030727,
					"content": "#Aranaralar ormanın çocuklarıdır, ağaçlara birlikte yaşarız. Senin gibi değiliz Nara {NICKNAME}. Sen bir karahindiba çocuğusun, sürekli seyahat ediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030728
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030728,
					"content": "#{NICKNAME} sana adını söylememişti, nereden biliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030729,
					"content": "Arana'nın nereden bildiği önemli değil. Arana Narana'ya yardım etmek istiyor, önemli olan bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030730,
						730030732
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030730,
					"content": "Narana... Tekerleme gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030731
					]
				},
				{
					"id": 730030731,
					"content": "Rana'ya yardım mı etmek istiyorsun? Ne yapmamız gerek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030733,
					"content": "Teşekkür ederim iyi kalpli Nara. Narana, Arana'nın çok sevdiği bir dostu. Arana onu koruyacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030734
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030734,
					"content": "#Yine de korumak yetmez. Narana'yı iyileştirmek için Bija bulmamız gerek. Nara {NICKNAME} Vanarana'ya gitmeli ve herkesten yardım isteyip Bija bulmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030735,
						730030736
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030735,
					"content": "Bija mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030737,
					"content": "Narana'ya Marana bulaşmış, durumu çok ciddi. Kötü böcekler ağaç köklerini ısırır. Ağaçlar kurur, meyveler de çürür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030738
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030738,
					"content": "Naraların hayatı ağaç, kötü böcekler ise Marana gibidir. Sadece Bija, Narana'yı iyileştirebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030739
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030739,
					"content": "Şey... O zaman \"Vanarana\" denen yere gidip bir şekilde Bija bulmamız gerekiyor, öyle mi? Bija bulursak Rana'yı iyileştirebilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030740
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030740,
					"content": "Hı hı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030741,
						730030744
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030741,
					"content": "Peki Rana'ya ne olacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030742
					]
				},
				{
					"id": 730030742,
					"content": "Endişelenme. Arana burada kalıp Maranayla savaşacak. Rana'nın durumu kötüleşmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030743
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030743,
					"content": "Bija olmazsa Rana da asla iyileşemeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030745
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030745,
					"content": "Orman yolunu takip et, suyun kaynağına doğru ilerle. Vanarana'yı karşında bulacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030746
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030746,
					"content": "Sonra da şarkı söylemeye başla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030747,
						730030748
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030747,
					"content": "Şarkı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030750
					]
				},
				{
					"id": 730030750,
					"content": "(Aklımda bir melodi beliriverdi...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030751
					]
				},
				{
					"id": 730030751,
					"content": "Bu Büyük Hayalin Melodisidir. Vanarana'ya girmek için onu söylemen gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030752
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030752,
					"content": "Rüyalarımıza gir, dünyamıza gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030748,
					"content": "Yalancı Çiçeklerin dikkatini çeker ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030749
					]
				},
				{
					"id": 730030749,
					"content": "#Nara {NICKNAME} çok komik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030750
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030744,
					"content": "Anladım. Dediğin yere nasıl gidebiliriz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030745
					]
				},
				{
					"id": 730030736,
					"content": "O da ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030732,
					"content": "Ne yapmam gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030733
					]
