				{
					"id": 730030722,
					"content": "\"Arana\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030723
					]
				},
				{
					"id": 730030723,
					"content": "Iotham'ın hikayesini dinlerken bu ismi duymuştuk sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030724
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030724,
					"content": "Evet. Nara Iotham, Arana'nın dostudur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030725
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730030725,
					"content": "\"Aranaralar\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030726
					]
				},
				{
					"id": 730030726,
					"content": "Ne? Aranara mı dedin? Sahi ya, Paimon sana biraz daha dikkatli bakınca, seni daha önce de gördüğümüzü fark etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030715,
					"content": "Sebze...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030716
					]
				},
				{
					"id": 730030708,
					"content": "O da neydi öyle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030709
					]
				},
				{
					"id": 730030709,
					"content": "Paimon'un hatırladığı kadarıyla Marananın yarattığı aşınmaya karşı dayanabiliyordu... Tuhaf bir ismi vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730030710,
					"content": "İsmi Ararakalari. Maranayla savaşabiliyor ve ismi tuhaf DEĞİL.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "Arana"
				}
			]
		},
