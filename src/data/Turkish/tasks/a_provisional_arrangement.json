			"dialogs": [
				{
					"id": 210230201,
					"content": "Şu merdivenleri acilen tamir etmemiz lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230202
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230202,
					"content": "Hancı sen misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210230203
					]
				},
				{
					"id": 210230203,
					"content": "Evet. Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230204
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230204,
					"content": "Aşağıdakilerden biri bu paketi sana vermemizi istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210230205,
					"content": "Bu, konuklardan birinin gönderdiği paket sanırım. Zhen Qiang niye kendi getirmemiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230206
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230206,
					"content": "Hâlâ teslim alması gereken mallar mı varmış? Eminim asansörle çıkıp inmeye üşenmiştir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230207
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230207,
					"content": "Çok özür dilerim. Konuğumuz olarak geldin ama tam da merdivenlerin kırık olduğu zamana rastladın. Tam da şu anda tamir ettirmeye çalışıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230208
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230208,
					"content": "Üstelik bir de benim için bu paketi buraya kadar getirmeni istemişiz. Zahmet olmuş. Bunu teşekkür olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230209
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230209,
					"content": "Aslında bunu Zhen Qiang'a verecektim ama madem paketi onun yerine sen getirdin, karşılığını da sen hak ediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210230210
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 210230210,
					"content": "Benim şimdi tamirat hazırlıklarıyla ilgilenmem lazım. Hana istediğin gibi göz at. Bir şeye ihtiyacın olursa her zaman bana buradayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
	]
