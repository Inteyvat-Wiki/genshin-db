			"dialogs": [
				{
					"id": 701280101,
					"content": "Hımm, bu şişe ağırmış. Sanki içinde bir şey var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280102
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701280102,
					"content": "\"Dün eski bir dostumuz kötü haberler getirdi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280103
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701280103,
					"content": "\"Uzun süredir senden yanıt almamıştım. Belki de haklıdır ve benim gerçeği kabul etmem gerekiyordur.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280104
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701280104,
					"content": "\"Yine de... Hâlâ dolaşıyorsan ve bu mektubu alacak olursan umarım bana bir yanıt gönderebilirsin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280105
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701280105,
					"content": "\"Mektuba nişanını ekle ki zamanı geldiğinde mektubun senden olduğunu anlayayım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280106
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701280106,
					"content": "\"Uyuu Restoranını hatırlıyor musun? Orada buluşalım. Mektupta şarap için para da gönderiyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280107
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701280107,
					"content": "\"Bu mektubu almasını umduğum kişi değilsen...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701280108
					],
					"speakerTitle": "Sürüklenen Şişe"
				},
				{
					"id": 701280108,
					"content": "\"O zaman lütfen yine de bu hatırayı al. Belki asıl sahibini bulabilirsin. Ayrıca Morayı da teşekkür olarak kabul et.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sürüklenen Şişe"
				}
			]
		}
	]
}