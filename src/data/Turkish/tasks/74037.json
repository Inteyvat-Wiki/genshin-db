			},
			"dialogs": [
				{
					"id": 740370801,
					"content": "İşte geldik. Çalışmaya koyulalım. Çeşme çok uzun süredir sessiz... Tekrar faaliyete alma zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370802
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370802,
					"content": "İkili hemen harıl harıl çalışmaya koyulur...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370803
					]
				},
				{
					"id": 740370803,
					"content": "Vana monte edildi. Ayrıntılı bir kontrol de yaptım, ciddi bir sorun yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370804
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370804,
					"content": "Tamam. Şimdi biraz geri çekilelim. Son olarak savak kapağını açmak kaldı geriye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370805
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370805,
					"content": "Bakayım... Ana savak şurada, ikinci savağın da açılması gerekecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370806
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370806,
					"content": "Beni burada bekleyin lütfen. Gidip savak kapaklarını açacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370807
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370807,
					"content": "Bu sistemi kim tasarlamış acaba? Savak kapaklarını niye o kadar uzağa koymuşlar ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370808
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370808,
					"content": "Edel aceleyle ana savak kapağına doğru gider ve bir süre sonra geri gelir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370809
					]
				},
				{
					"id": 740370809,
					"content": "Of, açmak çok zordu. Bittim tükendim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370810
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370810,
					"content": "Biraz bekleyelim. Su birazdan akmaya başlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370811
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370811,
					"content": "Birkaç zayıf gürleme sesinden sonra çeşme normal faaliyetine geri döner...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370812
					]
				},
				{
					"id": 740370812,
					"content": "Süper! Çeşme çalışıyor... Şimdi artık Keratry gece ne olduğunu anlatsa bile hiçbir fikrim yokmuş gibi davranabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370813,
						740370814
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370813,
					"content": "Artık sihir gösterilerinde dikkatli olman gerektiğini öğrenmişsindir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370815
					]
				},
				{
					"id": 740370815,
					"content": "İyi de bu soruna sihir yol açmadı ki... Sağ ol yine de. İşte, biriktirdiğim harçlığım. Lütfen al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370816
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370816,
					"content": "Benim söz verdiğim ödeme de içinde. Yardımın için sağ ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370817
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370817,
					"content": "Edel, Estelle Hanım, siz de sağ olun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370818
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370818,
					"content": "Lafı bile olmaz, olması gereken buydu. Bir dahakine kardeşini gecenin bir yarısı dışarı çıkarma... Iı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370819
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370819,
					"content": "Abi! Ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370820
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370820,
					"content": "Keratry? Ne işin var burada? Sen... Sen annemlerle dolaşmaya çıkmamış mıydın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370821
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370821,
					"content": "Hehe... Onlar bakmıyorken kaçtım. Bu çeşme ne yapıyor görmek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370822
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370822,
					"content": "Bu çeşmeyi sihirle durdurmamış mıydın? Akmaya henüz başlamamıştır sanıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370823
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370823,
					"content": "Haha... Şey... Hehe... Sihrin de bir sınırı vardır. Biliyorsun, değil mi? Yalnızca belirli bir süreliğine çalışır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370824
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370824,
					"content": "Aaa... O zaman daha fazla sihir görmek istiyorum! Çeşmeyi tekrar durdurur musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370825
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370825,
					"content": "Şey... *öksürür* Keratry'ciğim, etrafta bir sürü insan var ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370826
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370826,
					"content": "Çeşmeyi şimdi durdurursam suyu izlemek isteyen insanlar üzülür...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370827
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370827,
					"content": "Şey... Daha sonra geliriz! Annemleri de getiririz, onlar da senin sihrini izlemek ister kesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370828
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370828,
					"content": "Ne? Yok, hayır... Canım kardeşim, ben henüz... Çeşme sihrinde tam ustalaşamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370829
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370829,
					"content": "Annemlerin dandik, yarım yamalak bir sihir numarası izlemek isteyeceğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370830
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370830,
					"content": "O yüzden onlara benim \"çeşme sihrimi\" henüz anlatamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370831
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370831,
					"content": "Onları şaşırtmadan önce bu sihri tamamen anlamak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370832
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370832,
					"content": "Tamam! Eminim gösterdiğinde çok beğenecekler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370833
					],
					"speakerTitle": "Keratry"
				},
				{
					"id": 740370833,
					"content": "Evet, ben de eminim. Şimdi gel eve gidelim, tamam mı? Hem... Eve gidince sana yeni bir numara gösteririm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370814,
					"content": "Artık sihrin ve mucizelerin bir bedeli olduğunu öğrenmişsindir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370822
					]
				}
			]
		}
	]
}