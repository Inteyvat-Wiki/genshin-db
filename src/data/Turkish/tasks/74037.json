					}
				]
			},
			"dialogs": [
				{
					"id": 740370501,
					"content": "Merhaba, nasıl yardımcı... Aa, Edel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370502
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370502,
					"content": "Vana ve çeşme ağzını almaya geldim. Çeşme yakında tamir olmazsa şu Remaudiere denen çocuk saçını başını yolacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370503
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370503,
					"content": "V-Vana mı dedin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370504
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370504,
					"content": "Niye kekeliyorsun sen? Estelle... Yapmayı unutmadın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370505
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370505,
					"content": "Yok yok! Yaptım bir tane. Ama... Demin bir müşteri geldi, acil bir tamirat işi varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370506
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370506,
					"content": "B-Ben de öyle birkaç standart parça verdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370507
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370507,
					"content": "Ama merak etme! Yenisini yapıyorum şu an! Hemen hazır olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370508
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370508,
					"content": "Bayan Estelle... Ben o siparişi ta ne zaman verdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370509
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370509,
					"content": "Biliyorum! Ama bahsettiğim müşterinin çok acelesi vardı. Bir kanalizasyon vanasını tamir etmesi gerekiyormuş, yalvar yakar isteyince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370510
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370510,
					"content": "Merak etme ama! Şu... Şu sipariş ettiğim Demir Parçalar gelince senin vanayı yapabileceğim! Yakında gelir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370511
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370511,
					"content": "Ne zaman sipariş ettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370512
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370512,
					"content": "B-Bu sabah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370513,
						740370514
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370513,
					"content": "Demir Parçalarını ben hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				},
				{
					"id": 740370515,
					"content": "Gerçekten mi? E harika o zaman, harika! Senden haber bekleyeceğiz Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370516
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370516,
					"content": "Özür dilerim! Çok özür dilerim! Üç Demir Parçası yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370517
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370517,
					"content": "Pekala, sana güveniyoruz Gezgin. Ücret kısmını da merak etme, ben kimseyi bedavaya çalıştırmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370514,
					"content": "Ben sana Demir Parçası getiririm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				}
			]
		},
