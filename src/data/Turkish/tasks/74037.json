			"dialogs": [
				{
					"id": 740370101,
					"content": "*iç çeker* Edel bu çeşmeyi niye hâlâ tamir etmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370102
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370102,
					"content": "Bir an önce tamir edilmezse Keratry cümle aleme duyuracak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370103
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370103,
					"content": "Bu çeşme bozuk mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370104
					]
				},
				{
					"id": 740370104,
					"content": "*iç çeker* Birkaç gün önce gayet güzel çalışıyordu. Şimdi niyeyse birden durdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370105
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370105,
					"content": "Daha da kötüsü, tam ben Keratry için sihir numarası yaparken bozuldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370106
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370106,
					"content": "Babamlar operadaydı, evde kardeşimle oturmamı ve onunla oyun oynamamı, ona kitap okumamı falan istemişlerdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370107
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370107,
					"content": "Ama Keratry onu dışarı çıkarayım diye başımın etini yedi. Ben de ne yapayım, oyun oynarız diye mecburen dışarı çıkardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370108
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370108,
					"content": "Çeşmeye geldiğimizde Keratry birden annemlerin operadan çıkmasını bekleyeceğini, eve onlarla beraber yürümek istediğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370109
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370109,
					"content": "E ne güzel işte?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370110
					]
				},
				{
					"id": 740370110,
					"content": "Evet. Sonuçta o kadar yol yürümüşsünüz, anne babanızı bekleseydiniz belki size güzel bir yemek ısmarlarlardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370111,
					"content": "Saat çok geç olmuştu ama... Annemler kardeşimi gizli gizli dışarı çıkardığımı ve gece vakti etrafta dolaştığımızı öğrenirse beni öldürürlerdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370112
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370112,
					"content": "O yüzden Keratry'ye ufak bir yalan söyleyeyim dedim. Bir sihir numarası bildiğimi, çeşmenin su püskürtmesini durdurabileceğimi söyledim ona.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370113
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370113,
					"content": "Tabii aslında suyun ne kadar sürede bir durduğunu biliyordum. Keratry'yi eğlendirip eve gitmeye ikna edecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370114
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370114,
					"content": "Çeşmenin duracağı zamanı doğru hesapladım. Kardeşim de \"sihir\" numaramı bal gibi yuttu. Eve gidene kadar ona bu \"büyüyü\" öğretmem için başımın etini yedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370115
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370115,
					"content": "Ben de eve gidince merakı dinsin diye bir şeyler uydurdum. Sonra Keratry'yi uyutup odama döndüm. Annemler de çok geçmeden eve geldi, her şey normaldi yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370116
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370116,
					"content": "Ama ertesi gün babama gazete almaya çıktığımda bir baktım ki çeşme hâlâ çalışmıyordu... Bozulmuştu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370117,
						740370118
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370117,
					"content": "Sihrin güçlüymüş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370119
					]
				},
				{
					"id": 740370119,
					"content": "Dalga geçme ya! Keratry bundan annemlere bahsederse bittim demektir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370120
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370120,
					"content": "\"Ne? Meydandaki çeşme mi bozulmuş? Ne oldu acaba canım?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370121
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370121,
					"content": "\"Çok garip... Biz dün gece operaya giderken gayet düzgün çalışıyordu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370122
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370122,
					"content": "\"Ben sebebini biliyordum! Remaudiere durdurdu! Öyle değil mi?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370123,
						740370124
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370123,
					"content": "Çok iyi bir taklitti!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370125,
					"content": "Hem o gece kardeşimle dışarı çıktığımızı öğrenirlerse bana öyle bir fırça atarlar ki. En az iki ay ayvayı yedim demektir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370126
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370126,
					"content": "Hımm... Bu çeşmeden sorumlu biri olmalı, değil mi? Bozulduysa tamir edecek birini çağıramaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740370127,
					"content": "Çeşmenin sorumlusu Edel'e anlattım konuyu, o da en kısa sürede tamir edeceğine söz verdi. Ama şu an... Sorun hâlâ çözülmemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370128
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370128,
					"content": "Daha fazla saklayamam... Bittim ben, yandım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370129,
						740370130
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370129,
					"content": "Ben senin için gidip sorarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370131,
					"content": "Gerçekten mi? Yardım edecek misin? O zaman sana... Biriktirdiğim harçlığımın hepsini vereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370132
					],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370132,
					"content": "Edel şurada. Lütfen çabuk gidip ne oluyormuş sorar mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Remaudiere"
				},
				{
					"id": 740370130,
					"content": "Merak etme, bir şey olmaz. Ben yardım edeceğim sana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370131
					]
				},
				{
					"id": 740370124,
					"content": "Canlı ve hevesli performansın sayesinde şimdi olayı tamamen anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370125
					]
				},
				{
					"id": 740370118,
					"content": "Kudretli bir büyücüden de daha azı beklenmezdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370133
					]
				},
				{
					"id": 740370133,
					"content": "Sen çeşmeyi incelerken biri daha yanına gelir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
