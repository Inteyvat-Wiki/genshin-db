			"dialogs": [
				{
					"id": 740370701,
					"content": "Bunlar iş görür! Bir dakika bekle, çok sürmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370702
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370702,
					"content": "Estelle harıl harıl çalışmaya koyulur...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740370703
					]
				},
				{
					"id": 740370703,
					"content": "Tamamdır, halloldu! Vanayı ve püskürtücüyü yaptık, ihtiyacımız olan genel parçalar da var. Hepsi hazır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370704
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370704,
					"content": "Edel, Gezgin, hadi Erinnyes'e gidelim. Orada olursam çeşmenin onarılması uzun sürmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370705
					],
					"speakerTitle": "Estelle"
				},
				{
					"id": 740370705,
					"content": "Teşekkürler... Ben bunları alırım Gezgin. Haydi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
		{
