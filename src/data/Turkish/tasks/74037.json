				{
					"id": 740370401,
					"content": "Öte yandan çeşme yakında tamir olmazsa şu Remaudiere denen çocuk iyice kafayı yiyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
