			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "Buradaki boruların değişmesi lazım... Vanaların da... Tabii bir de temizliği var... *iç çeker* Sorunlar say say bitmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370302,
					"content": "Efendim? Bir şey mi lazımdı? Kılık kıyafetinize bakılırsa... Estelle'in tamir ekibi değilsiniz herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370303,
					"content": "Remaudiere hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "Ha, o mu? Heh, sihri fena güçlü çıktı cidden. Çeşmenin en alttaki borularındaki bir vanayı paslandırmış ve su püskürtücüyü paramparça etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370305,
					"content": "Hahaha, şaka yapıyorum canım. Hasarlı bir vana takılıp tüm su sistemini tıkamış. Güvenlik nedeniyle geçici olarak çeşmeyi kapattık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370306,
					"content": "Ağız niye kırılmış ki ama? Hiç anlamadım... Çok garip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370307,
					"content": "Remaudiere çeşme yakında tamir olmazsa ayvayı yiyeceğini söyleyip duruyor... Yapabileceğim pek fazla bir şey yoktu ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370308,
					"content": "Bugün nihayet vakit bulup Estelle'den yeni bir vana ve çeşme ağzı sipariş ettim. Şimdi şehre gidip onları alacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "Edel"
				},
				{
					"id": 740370309,
					"content": "İstersen bana eşlik edebilirsin. Alacağım çok şey var, hepsini tek başıma taşıyabilir miyim diye biraz endişelenmedim değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Edel"
				}
			]
		},
