					"nextDialogs": [
						110450538
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450538,
					"content": "Yani faydalı bir örnek mi oldum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450539
					]
				},
				{
					"id": 110450539,
					"content": "Dağlarda seninle gezmek benim için çok faydalı bir yolculuk oldu.",
