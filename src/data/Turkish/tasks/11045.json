			},
			"dialogs": [
				{
					"id": 110450501,
					"content": "Dönmüşsünüz! Tam zamanında. Tam da bir sonuca varmak üzereydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450502,
					"content": "Gelmeniz uzun sürdü. Yolda bir sorun mu çıktı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450503,
						110450504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450503,
					"content": "Pek sayılmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450506
					]
				},
				{
					"id": 110450506,
					"content": "Sonuçları görme zamanı. Bugün bolca veri topladık. Bütün araştırmayı tek seferde bitirmek çok zordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450507
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450507,
					"content": "Bununla birlikte sana söyleyebileceğim en önemli ana sonuç şu: Bu dünyadaki insanlara çok benziyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450508,
						110450509
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450508,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450510
					]
				},
				{
					"id": 110450510,
					"content": "Bakınca anlaşılmıyor muydu zaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450511,
					"content": "Bütün gün bunun için mi uğraştık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450512,
					"content": "Lütfen, bunun zaten bariz olduğunu düşündüğünüzü biliyorum ama aslında bu dünyada her şey sorgulanmalıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450513,
					"content": "Teyvat'ın yabancılara doğal olarak düşman olabileceğini düşündünüz mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450514,
						110450515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450514,
					"content": "Sadece tanrılar bilebilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450516
					]
				},
				{
					"id": 110450516,
					"content": "Bu dünyanın doğa kanunlarından bahsetmiştim. Burada hiçbir kötü sonucu olmadan benimle konuşabiliyorsun ve tuhaf gelen bir şey yok. Aslında bu küçük bir mucize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450517,
					"content": "Senin gibi uzaklardan gelen tek yaşam biçimi bahsettiğim bu tohum. Teyvat'ın doğa kanunlarının etkisi altında çiçek açmayı bırak filizlenemiyor bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450518,
					"content": "Ama seni gözlemledikten sonra aklıma farklı bir fikir geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450519
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450519,
					"content": "Seni taklit etmek simyama ilham kaynağı oldu ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450520
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450520,
					"content": "Vay be! Bir şey çıkıyor galiba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450521,
					"content": "Hiçlikten varlığa, filizden köke... Şimdi de meyve vermeye geçiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450522
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450522,
					"content": "Dünya dışından gelen hayatı beslemek aynı zamanda dünyayı beslemek değil midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450523
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450523,
					"content": "Ayy...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450524,
						110450525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450524,
					"content": "Çok güzeldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450526
					]
				},
				{
					"id": 110450526,
					"content": "*iç çeker* Bu kadar ileri gidebileceğiz gibi duruyor. Hayatın en büyük başarısı, eşsiz bir güzelliğin anlık çiçek açması...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450527
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450527,
					"content": "Paimon o kadar uğraştıktan sonra sanmıştı ki... Sonsuza kadar çiçek açacak. Ama meyve bile vermedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450528,
					"content": "Hayat özgür varlıklardan çok katmanlı bir örgüdür. Değeri bizimle ne kadar kaldığına göre ölçülmemeli. Bir an için açan bir çiçek bile kıymetlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450529
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450529,
					"content": "Kısa bir hayat güzel geçebilir. Yalnızlığın dert olmadığı bir hayat verimli ve mükemmel yaşanmış bir hayattır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450530
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450530,
					"content": "Burada konuşuyor olmamızın küçük bir mucize olduğunu söylerken ne demek istediğimi anladınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450531,
						110450532
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450531,
					"content": "Ben şimdilik solmadım ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110450533
					]
				},
				{
					"id": 110450533,
					"content": "Ortam biraz ağırlaştı sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450534,
					"content": "#Hehehe, üzülme {NICKNAME}. Paimon iyi bakar sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450535,
					"content": "Albedo, Paimon gerçekten arkadaşın olmak istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110450536,
					"content": "İkinize de teşekkür ederim. Yalnızlıktan kurtulmak yaşam için zorunlu olmasa da kesinlikle iyi geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110450537
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110450537,
					"content": "#Yardımınla bir bitkiye çiçek açtırmanın yolunu keşfettim {NICKNAME}.",
