						220500706
					]
				},
				{
					"id": 220500706,
					"content": "Onun hakkında fazla kayıt yok. Adeptus sanatını öğrenmek için denizi aşıp Liyue'ye gittikten sonra Inazuma'ya dönmüş.",
					"roleType": "TALK_ROLE_NPC",
