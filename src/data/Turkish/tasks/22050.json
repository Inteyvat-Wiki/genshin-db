					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500704,
					"content": "Soyu bugüne dek ulaşmış. Şehirde soyadı Mikoshi olan birçok kişi onun soyundan geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
