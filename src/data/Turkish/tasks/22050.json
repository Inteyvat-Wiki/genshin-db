						220500502
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500502,
					"content": "Hibiki'nin söyledikleri gerçekten de doğruymuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500503
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500503,
					"content": "Farklı adalar gerçekten birbirine hiç benzemiyormuş. Hem tapınakların yüksek dağlara kurulabileceğini bilmiyordum, insanlar yüksekten korkmuyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500504
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500504,
					"content": "Benim Asase Tapınağım hepsinden çok daha güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500505
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500505,
					"content": "Hibiki nerede acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500506
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500506,
					"content": "Onu aramaya devam etmek istiyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220500507
					]
				},
				{
					"id": 220500507,
					"content": "Yorgunum, bunu sonra konuşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500508
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500508,
					"content": "Bunun \"sonrası\" da mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220500509,
					"content": "Var tabii. Hibiki bana sayısız hikaye anlatmıştı. Sahiller, bir sürü ağacın bulunduğu yerler, \"Leydi Kitsune\"; hepsi hakkında bir sürü hikaye anlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500510
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500510,
					"content": "Anlattığı her hikayeyi gayet iyi hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500511
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500511,
					"content": "Fakat şu an için eve dönme vakti. Sonuçta Asase Tapınağının, Guujisine ihtiyacı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220500512
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220500512,
					"content": "Kısacası, benimle birlikte eve dönüyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
