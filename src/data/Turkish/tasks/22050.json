					"nextDialogs": [
						220500708
					],
					"speakerTitle": "Inagi Hotomi"
				},
				{
					"id": 220500708,
					"content": "Kayıtlara göre Inazuma'ya barış getirmek adına, her yerde ayrı bir sorun çıkaran Ioroi isimli bake-danuki'yi durdurmak için bu tekniği kullanmış.",
					"roleType": "TALK_ROLE_NPC",
