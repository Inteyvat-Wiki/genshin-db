			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Supada no Hiko",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722390301,
					"content": "Sen... Sen de kimsin? Sesin epey tanıdık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390302
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390302,
					"content": "Bizi hemen unuttun mu? Sen Paimon'dan da kötüsün...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390303,
					"content": "Teşekkür ederim. Birbirimizi cidden tanıyor muyuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390304,
						722390305
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390304,
					"content": "Aslında az önce tanıştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				},
				{
					"id": 722390306,
					"content": "Ah evet, hatırladım. Burada resmen insanın ruhu yıpranıyor. Sanırım benim anılarım paramparça oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390307
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390307,
					"content": "Üzgünüm... Ben *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390308
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390308,
					"content": "İşe yarar herhangi bir şey bulabildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390309,
						722390310
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390309,
					"content": "Adın Supada no Hiko mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390312
					]
				},
				{
					"id": 722390312,
					"content": "Supada no Hiko... Doğru... Evet bu doğru! Ben direnişin lideri Spartacus'üm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390313
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390313,
					"content": "Demek ikisi de senin adın. İki ada sahip olmak tam da gerçek bir lidere yakışan bir özellik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390314,
					"content": "Adımı bana geri verdiğin için teşekkür ederim. Başka şeyleri de hatırlıyorum sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390315
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390315,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390316
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390316,
					"content": "\"Güneşin ardından karanlık gelse de gerçek ışık kalplerimizde yer alır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390317
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390317,
					"content": "Bu ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390318
					]
				},
				{
					"id": 722390318,
					"content": "Bu bizim gizli şifremiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390319
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390319,
					"content": "Adımı geri aldığım için anılarım da geri dönüyor. Bu bizim şifremiz olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390320,
					"content": "Şimdi sana çocuklarımın nerede saklandığını söyleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390321,
						722390324,
						722390329
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390321,
					"content": "Aktarmamı istediğin bir mesaj var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390322
					]
				},
				{
					"id": 722390322,
					"content": "Bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390323
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390323,
					"content": "Hiç pes etmemelerini söyle. Byakuyakoku'nun umudu hep onlarla olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390320
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390324,
					"content": "Çocukları seni görmeleri için buraya getirmemi ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390325
					]
				},
				{
					"id": 722390325,
					"content": "Hayır. Asla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390326
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390326,
					"content": "Tek avantajımız düşman açıkta dururken gölgelerde gizlenmek. Byakuyakoku halkının kalbi bizimle, kendimizi bu kadar kolay açığa çıkaramayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390327
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390327,
					"content": "Dahası her birinin adını hatırlayamıyorum. Sonuçta kendi adımı bile unuttum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390328
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390328,
					"content": "Evet. Hiç pes etmemelerini söyle çünkü Byakuyakoku'nun umudu onlarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390329,
					"content": "Eğer artık orada değillerse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390330
					]
				},
				{
					"id": 722390330,
					"content": "Yok, öyle bir şey olmayacak. Güneşin Çocuğunu kontrol eden yozlaşmış liderler koltuklarından inmediği müddetçe hep orada olacaklar. Direniş devam edecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390331
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390331,
					"content": "Hiç pes etmemelerini tembihle; çünkü Byakuyakoku'nun umudu onlarla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390332
					],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390332,
					"content": "Bu kadarı yeterli olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Supada no Hiko"
				},
				{
					"id": 722390310,
					"content": "Adın Haydut Supada mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390311
					]
				},
				{
					"id": 722390311,
					"content": "Hadi ama! Supada no Hiko olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722390312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722390305,
					"content": "Sadece kimliğini arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722390306
					]
				}
			]
		},
