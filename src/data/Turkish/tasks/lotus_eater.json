						722391905
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391905,
					"content": "Supada no Hiko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722391906
					]
				},
				{
					"id": 722391906,
					"content": "Kumandan Spartacus mü? Seni Kumandan mı gönderdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391907
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391907,
					"content": "Kendisi nerede? En son Güneşin Çocuğu yandaşlarının ayaklanmasında yakalandığını hatırlıyorum. O olaydan sonra da bağlantımız koptu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391908
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391908,
					"content": "Yılan Kalbi'ndeki sunakta hapsedildi ve görünüşe göre oradan çıkamıyor. Bu yüzden bizden sizi bulmamızı istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391909
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722391909,
					"content": "Şu uğursuz Güneşin Çocuğu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722391910
					],
					"speakerTitle": "Adonis"
				},
				{
					"id": 722391910,
					"content": "Kumandan size ne talimat verdi?",
					"roleType": "TALK_ROLE_NPC",
