					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220801,
					"content": "Nasıl olur... Hiç şüphe yok. Bu, barbarların iğrenç mesajlarını alıp gönderdikleri sinyal direklerinden biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220802,
						742220803
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220802,
					"content": "Emin misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				},
				{
					"id": 742220804,
					"content": "*iç çeker* Casuslarının gerçekten aramıza sızdıklarına inanamıyorum. Tribunus Mettius'un korkuları boşuna değilmiş meğer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220805
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220805,
					"content": "Bu konuyu ona bildirdiğimde benim de görevim bitmiş olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220806
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220806,
					"content": "Teşekkür ederim yurttaş. Sen olmasaydın barbar sürüsü savunmamızı çoktan yerle bir edebilirdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220807
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220807,
					"content": "Üstlerime bildirirken senin katkılarından mutlaka bahsedeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220803,
					"content": "Az önce buna ahşap bir kılıç demiştin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220804
					]
				}
			]
		}
	]
}