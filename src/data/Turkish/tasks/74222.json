			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Moce"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220101,
					"content": "Dikkatli ol yurttaş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220102,
						742220106,
						742220109,
						742220116
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220102,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220103
					]
				},
				{
					"id": 742220103,
					"content": "Ben mi? Gördüğün gibi işte. Barbar tehdidine karşı uğraşıp duruyorum! Saldırılarını sürekli artırıyorlar, ajan bile göndermiş olabilirler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220104
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220104,
					"content": "Bu hiç de hafife alınacak bir mesele değil! Destek kuvvetler gelene kadar tedbiri elden bırakmamalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220105
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220105,
					"content": "Başka bir sorun varsa lütfen yardımcıma ilet, yurttaş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220106,
					"content": "Bir çocuk, hem de burada tek başına...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220107
					]
				},
				{
					"id": 742220107,
					"content": "Hımm? Çocuk mu? Nereden gelmiş? Yine acemilerden biri emirlere karşı gelip kampa ailesini mi getirmiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220108
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220108,
					"content": "*iç çeker* Dominus Cassiodor acemilere karşı çok yumuşak davranıyor. Bundan otuz kırk yıl önce böyle bir şey yaşansaydı bir Tribunus çoktan kamçısını çıkarmıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220109,
					"content": "Son zamanlarda şüpheli herhangi bir şey oldu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220110
					]
				},
				{
					"id": 742220110,
					"content": "Şu an için yok. Ancak barbarlar kurnaz canavarlar gibidir. Tedbiri elden bıraktığın anda sana saldırırlar. Beklenmedik anda sürpriz yapmak onların en büyük silahıdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220111
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220111,
					"content": "Şehirlerimize saldırmak ve sırlarımızı ele geçirmek için en kötü yöntemleri bile kullanıyorlar. Disiplin açısından azıcık dahi bir ihmalkarlık büyük bir felakete sebep olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220112
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220112,
					"content": "*iç çeker* Otuz yıl önce Dominus Boethius ile birlikte kuzeyi fethe gittiğimde onlar, bu tür kurnazlıkları bilmeyen ilkel bir sürüden başka bir şey değildi. Bu numaraları nereden öğrendiler acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220113
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220113,
					"content": "Otuz yıl önce... Annen baban bile daha dünyaya gelmemişti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220114
					]
				},
				{
					"id": 742220114,
					"content": "Hımm? Az önce ne dedin yurttaş? Yaşlandıkça kulaklarım ağır işitmeye başladı sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220115
					],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220115,
					"content": "*iç çeker* Zaman gerçekten de çok acımasız. Bituria'nın fethi sırasında barbarların içtima için çaldıkları çan sesini kilometrelerce öteden duyardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				},
				{
					"id": 742220116,
					"content": "Hoşça kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220117
					]
				},
				{
					"id": 742220117,
					"content": "Güle güle yurttaş! Şüpheli kişileri bana daima ihbar edebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Moce"
				}
			]
		},
		{
			"id": 7422202,
			"completionStepIds": [
				7422202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
