			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Giovanni"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 742220201,
					"content": "*iç çeker* Bu savaş ne zaman sona erecek acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220202
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220202,
					"content": "Çatıda ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220203
					]
				},
				{
					"id": 742220203,
					"content": "Hımm? Olası herhangi bir barbar hareketliliğine karşı bölgeyi gözetliyorum tabii ki! Geçenlerde... Bir dakika, sen bu gözetleme kulesine nasıl çıktın yurttaş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220204
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220204,
					"content": "Ben de tam aynısını soracaktım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220205
					]
				},
				{
					"id": 742220205,
					"content": "*iç çeker* Neyse, çok önemli değil. Tribunus Mettius, yabanilerin saldırılarının hızla yaklaştığını söyledi. Gelen son istihbarata göre aramıza ajanlarını da göndermiş olabilirler. Tedbiri elden bırakmamamız lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220206
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220206,
					"content": "Ama o vahşiler bizim uzaktaki bu küçük şehrimize ajan gönderme zahmetine girecek kadar bizimle ilgileniyorlar mıdır gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220207
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220207,
					"content": "Porsiyon ne kadar küçük olursa olsun et ettir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220208
					]
				},
				{
					"id": 742220208,
					"content": "Doğru diyorsun yurttaş! Sanırım kendimi toparlamam gerek. Hımm... Konuşma tarzına bakılırsa bu tür konularda tecrübeli gibisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220209
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220209,
					"content": "Bu durumda, bölgeyi inceleme işinde bana yardım eder misin? Etrafta dolaşan barbarlar varsa elbette arkalarında iz bırakmışlardır. Ahşap bir kılıç gibi mesela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220210
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220210,
					"content": "Ne bunlar? Oyun oynayan çocuklar falan mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						742220211
					]
				},
				{
					"id": 742220211,
					"content": "Sonuçta bunlar yabani değiller mi? Silah olarak sopa kullanmaları çok mu tuhaf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742220212
					],
					"speakerTitle": "Giovanni"
				},
				{
					"id": 742220212,
					"content": "Her neyse, sana güveniyorum. Herhangi bir şey tespit edersen hemen bana haber ver. Bir Remurialı olarak böyle bir görev aldığın için sevinmelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Giovanni"
				}
			]
		},
