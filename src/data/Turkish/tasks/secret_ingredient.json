					"nextDialogs": [
						110020203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020203,
					"content": "Elbette hayır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020204
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020204,
					"content": "O zaman nasıl kendinden bu kadar eminsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020205,
					"content": "Bu benim tarzım. Öncesinde bir şeyi tam olarak nasıl pişireceğime karar verirsem yemekte sürpriz bir unsur olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020206
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020206,
					"content": "Aynı şekilde, aramaya başlamadan önce neyi aradığımı bilirsem sürpriz olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020207
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020207,
					"content": "Ama bu çok riskli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020208,
					"content": "Sakin ol, Wanmin Restoranındaki tüm özel tariflerimi bu şekilde ortaya çıkardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020209
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020209,
					"content": "Hadi çevreye bir bakalım, hoşuma giden bir şey bulduğumda sana söyleyeceğim.",
