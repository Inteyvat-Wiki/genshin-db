					"content": "Ne demek istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020704
					]
				},
				{
					"id": 110020704,
					"content": "Biraz küt pat çat eksik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020705
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020705,
					"content": "Evet, şimdi sen söyleyince fark ettim ki biraz küt pat çat eksik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020706,
						110020707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020706,
					"content": "Küt pat çat?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020708,
					"content": "Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020709,
					"content": "Brook, geleneklere bağlı biri olabilir ama aynı zamanda yetenekli bir şef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020710
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020710,
					"content": "En yüksek kalitedeki malzemeleri arayacağına şüphe yok. Kazanmak için gerçekten insanın aklını başından alan bir yemek gerekecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020711
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020711,
					"content": "Deniz yılanı salatası, yüksek ateşte kızartılmış Qingxin çiçeği ya da yoğun bodurlop sosunda yabani mantar gibi yemekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020712
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020712,
					"content": "Iyy... Bodurlop sosu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110020713,
					"content": "Haha, biliyorum kulağa tuhaf geliyor ama garanti veririm ki tadı inanılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020714
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020714,
					"content": "Bir dahaki sefere sizin için yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020715,
						110020717
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020715,
					"content": "Denemek için sabırsızlanıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020716
					]
				},
				{
					"id": 110020716,
					"content": "Hahaha, birazcık kötü görünse de tadına baktığında hayal kırıklığına uğramayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020719,
					"content": "Bunu boş verin, geçen sefer hiç bakmadığım bir yer olduğunu hatırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020720
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020720,
					"content": "İçimden bir ses büyük vurgunu yapacağımız yerin burası olduğunu söylüyor. Hadi bir bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020717,
					"content": "Ah... Gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020718
					]
				},
				{
					"id": 110020718,
					"content": "Anlamıyorum, bunda sevmeyecek ne var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110020719
					],
					"speakerTitle": "Xiangling"
				},
				{
					"id": 110020707,
					"content": "Paimon, bunu anladın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110020708
					]
				},
				{
					"id": 110020703,
					"content": "Bunun yeterince etkileyici olmadığını mı kastediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
