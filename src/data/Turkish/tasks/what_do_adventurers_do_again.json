			"dialogs": [
				{
					"id": 708140701,
					"content": "Görevleri bitirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140702
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140702,
					"content": "Bitirdim tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140703
					]
				},
				{
					"id": 708140703,
					"content": "Vay be... İşte Maceracıların gücü bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140704
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140704,
					"content": "Sakıncası yoksa eğer, maceracılar ve görevler hakkında birkaç sorumu cevaplayabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140705
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140705,
					"content": "Maceracılar canavarlarla mücadele etmek dışında, başka ne görevler alır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140706,
						708140707,
						708140708
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140706,
					"content": "İnsanların arabalarını ve evlerini tamir ederiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140709,
					"content": "Vay be. Yani maceracılar her şeyi yapıyor mu? Hiç aklıma gelmezdi böyle olduğu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140710
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140710,
					"content": "Teşekkürler! Bunları bir yere not edeyim. Ha, doğru. Ödemen burada. Lütfen kabul et. Olabildiğince bonkör davrandık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140711
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140711,
					"content": "Bir dahaki sefere benden görev aldığında, sana en iyilerini vereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140707,
					"content": "İnsanlara çiçek toplarız ve balık tutarız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				},
				{
					"id": 708140708,
					"content": "Sipariş gönderir, çocuklarla oynarız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140709
					]
				}
			]
		}
	]
}