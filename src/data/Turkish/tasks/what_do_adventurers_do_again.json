			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Tiantian"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140301,
					"content": "S-sen... Maceracı mısın? Buraya görev almaya mı geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140302
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140302,
					"content": "Lütfen... Bir saniye, bakalım neler varmış... \"Hızlı Kanat\", \"Doğada Hayatta Kalma Kılavuzu\", \"Serbest Tırmanış Eğitmeni Aranıyor\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140303
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140303,
					"content": "Bunlar bana pek de Maceracılar Loncası görevleri gibi gelmedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140304
					]
				},
				{
					"id": 708140304,
					"content": "Biliyorum, Lahn da öyle dedi! Ama kitaplarda okuduğum bütün maceralar böyleydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140305
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140305,
					"content": "Bu görevleri vermezsem ne vereceğim peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140306
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140306,
					"content": "\"Canavarları döv\" gibi bir şey olur mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140307
					]
				},
				{
					"id": 708140307,
					"content": "T-tehlikeli olmaz mı? Yani... Lisha'da onlardan çok fazla var. Yoldan geçenler için tehlike oluşturuyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140308
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140308,
					"content": "Ama normal insanlar onlara karşı duramaz. Hatta yaralanabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140309,
						708140311
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140309,
					"content": "Tamam, o işi bana bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140310
					]
				},
				{
					"id": 708140310,
					"content": "Halledebilir misin? Tamam öyleyse, sana bırakıyorum. Dönüp senin için Lahn'la uygun bir ödeme ayarlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140311,
					"content": "Maceracılar sıradan insanlara benzemez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140312
					]
				},
				{
					"id": 708140312,
					"content": "Öyle mi? Peki, sana bırakıyorum o zaman. Lahn ile görüşüp sana uygun bir ödeme ayarlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				}
			]
		},
