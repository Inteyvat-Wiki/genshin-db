				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708140501,
					"content": "Erken döndün. Görevi tamamladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140502
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140502,
					"content": "Tamamladım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140503
					]
				},
				{
					"id": 708140503,
					"content": "Vay be... Etkilendim. Loncaya döndüm ve sana verdiğim göreve göre diğer görevlerimizi yeniden düzenledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140504
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140504,
					"content": "Canavarlarla savaşmakla ilgili bir sürü görev vardı. Maceracılar hep böyle işler için isteniyor demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140505
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140505,
					"content": "Ama canavarlar dışında... Yol kenarlarında Hazine Avcıları görüldüğüne dair raporlar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140506
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140506,
					"content": "Bu da Maceracılar Loncasının ilgilenmesi gereken bir şey mi? Bununla Taşordu'nun ilgilenmesi gerekiyormuş gibi geldi bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140507,
						708140509
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140507,
					"content": "Biz ilgileniriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140508
					]
				},
				{
					"id": 708140508,
					"content": "Hımm. Maceracılar her şeyin üstesinden gelebiliyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140511,
					"content": "Tamam, senin için uygun bir ödeme ayarlayacağım. Lütfen bu görevi de al!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140512
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140512,
					"content": "Bir görev daha mı? Ama daha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 708140513,
					"content": "Daha fazla ödeme yapacağız! O konuyu çoktan Lahn'la konuştum. Şimdiki görevi de bitirince daha fazla ödeme alacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140514
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140514,
					"content": "Bak bu iyi işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140515
					]
				},
				{
					"id": 708140515,
					"content": "O zaman işi sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140516
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140516,
					"content": "Bu durumda iki görev de sende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140517
					],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140517,
					"content": "Lahn'ın bana \"maceracılara istekli şekilde görevleri kabul ettirme\" için öğrettiği gizli yöntem gerçekten işe yarıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tiantian"
				},
				{
					"id": 708140509,
					"content": "Parası iyiyse...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140510
					]
				},
				{
					"id": 708140510,
					"content": "Maceracılar gerçekten etkileyici insanlar. Her şeyin üstesinden gelebiliyorsunuz sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140511
					],
					"speakerTitle": "Tiantian"
				}
			]
		},
