			},
			"dialogs": [
				{
					"id": 708140201,
					"content": "Başka bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140202
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 708140202,
					"content": "Şu kılıcını bulabildin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708140203
					]
				},
				{
					"id": 708140203,
					"content": "Unutmadınız demek. Hayır, ne yazık ki bulamadım. Nerede olabileceğine dair hâlâ hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140204
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 708140204,
					"content": "Bir yere varamadım yani. Bir şeyler olsun diye bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140205
					],
					"speakerTitle": "Lahn"
				},
				{
					"id": 708140205,
					"content": "O konuyla ilgili bir gelişme olursa, sizden yardım isteyebilirim. O zaman geldiğinde yardımcı olacağınıza inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140206
					],
					"speakerTitle": "Lahn"
				}
			]
		},
		{
			"id": 7081403,
			"completionStepIds": [
				7081401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
