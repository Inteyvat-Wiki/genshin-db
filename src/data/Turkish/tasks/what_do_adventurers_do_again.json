			"dialogs": [
				{
					"id": 708140401,
					"content": "Tüm maceracılar böyle tehlikeli şeyler mi yapar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708140402
					],
					"speakerTitle": "Tiantian"
				},
				{
