			},
			"dialogs": [
				{
					"id": 210300201,
					"content": "İşler nasıl gidiyor Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300202
					],
					"speakerTitle": "Zhang Usta"
				},
				{
					"id": 210300202,
					"content": "İşaretlediğin noktaları şu an için güvene aldım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300203
					]
				},
				{
					"id": 210300203,
					"content": "Vay canına, harikasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300204
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300204,
					"content": "Babam seyahatimiz için bize birkaç koruma tutacağını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300205
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300205,
					"content": "Umarım tutacağı insanlar senin kadar iyidir Gezgin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300206
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300206,
					"content": "Demirci Amca, şimdi cevher toplamaya ve demir eşyaları hazırlamaya devam edebilecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300207
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300207,
					"content": "Hahaha, tabii ki! Biraz bekle de hazırlanayım. Cevherleri toplayıp işimin başına döneceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300208
					],
					"speakerTitle": "Zhang Usta"
				},
				{
					"id": 210300208,
					"content": "Gerçi tek başıma taşıyabileceğim cevher miktarı sınırlı. O bölgede canavar olmazsa şanslıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhang Usta"
				}
			]
		},
