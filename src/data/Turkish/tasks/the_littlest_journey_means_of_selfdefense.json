				"points": []
			},
			"dialogs": [
				{
					"id": 210300101,
					"content": "Nasıl yani? Bu iki cevher de mi aynı değil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300102
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300102,
					"content": "Tabii ki değil. Bu iki cevher türünden yapılan herhangi bir şeyin kalitesi ve fiyatı birbirinden tamamen farklı olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300103
					],
					"speakerTitle": "Zhang Usta"
				},
				{
					"id": 210300103,
					"content": "Şey, ama... Bu iki türden elimizde bir tek bunlar kaldı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300104
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300104,
					"content": "*iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300105
					],
					"speakerTitle": "Zhang Usta"
				},
				{
					"id": 210300105,
					"content": "Siz ikiniz ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300106
					]
				},
				{
					"id": 210300106,
					"content": "Merhaba Gezgin! Babamın, sipariş ettiği demir eşyaları kontrol etmesine yardımcı oluyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300107
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300107,
					"content": "Demirci Amca'nın eline kimse su dökemez! Bana da küçük bir kılıç yapacağını söyledi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300108
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300108,
					"content": "Ama dükkanda yeterli ham madde yokmuş. O yüzden babamın demir eşya siparişleri gecikebilirmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300109
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300109,
					"content": "Kılıcım ne zamana hazır olur onu da bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300110
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300110,
					"content": "*iç çeker* Yapacak bir şey yok. Son zamanlarda çok yoğunuz, elimizdeki cevher bitti bitecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300111
					],
					"speakerTitle": "Zhang Usta"
				},
				{
					"id": 210300111,
					"content": "Cevherin bol olduğu yerler de canavardan geçilmiyor, o yüzden gidip toplamaya cesaret edemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300112
					],
					"speakerTitle": "Zhang Usta"
				},
				{
					"id": 210300112,
					"content": "Benimle maden toplamaya gelecek bir maceracı bulamazsam bu yoğunluğu bir şekilde atlatmam gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300113
					],
					"speakerTitle": "Zhang Usta"
				},
				{
					"id": 210300113,
					"content": "Maceracıyı da kim bilir ne zaman bulurum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300114
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300114,
					"content": "Ya aslında Gezgin, senin canavarlarla dövüşmede epey iyi olduğunu duydum. Doğru mu bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300115
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300115,
					"content": "Doğruysa lütfen bana yardım eder misin? Lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300116,
						210300117
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300116,
					"content": "Haha, tamam, ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				},
				{
					"id": 210300118,
					"content": "Gezgin, canavar durumunu kontrol etmeye mi gidiyorsun? Bekle, genelde cevher topladığım noktaları haritada işaretleyeyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300119
					],
					"speakerTitle": "Zhang Usta"
				},
				{
					"id": 210300119,
					"content": "Tamamdır, işaretledim. Dikkatli ol, bu noktalar canavar kaynıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210300120
					],
					"speakerTitle": "Zhang Usta"
				},
				{
					"id": 210300120,
					"content": "O zaman sana güveniyorum Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210300117,
					"content": "Ne yapabilirim bir bakayım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210300118
					]
				}
			]
		},
