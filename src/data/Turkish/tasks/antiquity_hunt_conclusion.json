			},
			"dialogs": [
				{
					"id": 736950201,
					"content": "Hım? Tüm kopyaları buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950202
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950202,
					"content": "Harika! Bu işe gerçekten yatkınmışsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950203
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950203,
					"content": "Tamam o zaman, bu hediye senin için. Darşanımızın düzenlediği etkinliğe katıldığın için teşekkür ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950204
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950204,
					"content": "Umarım bu arkeoloji etkinliğinden zevk almışsındır Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950205
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950205,
					"content": "Gerçek arkeoloji faaliyetleri daha yoğun ve sıkı bir çalışma gerektirir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950206
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950206,
					"content": "Ama aradığın o kalıntıya ulaştığın anda tüm uğraşlara değdiğini hissedersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950207,
						736950208
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950207,
					"content": "Peki ya hiçbir şey bulamadıysan?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				},
				{
					"id": 736950209,
					"content": "Hiçbir şey bulamazsak dedikleri gibi \"boşa kürek çekmiş\" oluyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950210
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950210,
					"content": "Ayrıca dürüst olmak gerekirse çoğu zaman bir şey bulunmaz. Önemli şeyler bulduğumuz kazılar daha nadir görülür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736950211
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950211,
					"content": "Tabii arkeoloji alanında çalışacaksan bu tür durumlara alışmak ve iyimser kalmak gerekiyor. Aksi takdirde Darşan çoktan dağılmış olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736950208,
					"content": "Eminim hiçbir şey bulamadığın kazılar da olmuştur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736950209
					]
				}
			]
		},
