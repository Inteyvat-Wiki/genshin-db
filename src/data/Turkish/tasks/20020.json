			"dialogs": [
				{
					"id": 200200101,
					"content": "Demek böyle oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200102
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200102,
					"content": "Bu bitkilerin yenilebilir olmasından başka ne işe yaradığını biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200103
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200103,
					"content": "Ben nereden bileyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200104
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200104,
					"content": "Yalnızca nerede bulunduklarını ve yenilebilir veya yenilemez olduklarını biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200105
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200105,
					"content": "O halde sanırım gidip kendim bakacağım. Endişelenme, yalnızca birkaç bitki toplayacağım. O canavarlara yaklaşmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200106,
					"content": "Dikkatli ol, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200107
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200200107,
					"content": "Tamam, olurum. Bugün biraz geç döneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200108,
						200200109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200108,
					"content": "Hâlâ eğitimde misin Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				},
				{
					"id": 200200110,
					"content": "Selam Gezgin! Harika zamanlama! Ben de tam çiçekleri incelemek için dışarı çıkmayı düşünüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200111
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200111,
					"content": "Cyrus, maceracıların sıklıkla kampa gittiğini ve kampta toplayıcılığın önemli bir beceri olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200112
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200112,
					"content": "Ben de şimdi bazı yabani bitkileri araştırıp özelliklerini inceleyeceğim. Sonra da bunları yavaş yavaş ezberleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200113,
					"content": "Böylece gelecekte neyi yiyip neyi yiyemeyeceğimi bilebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200114,
					"content": "Yine de bunları sadece kağıda geçirmenin yeterli olmayacağını düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200115,
					"content": "Gezgin, elinde Kamera olarak bilinen bir aygıt olduğunu duydum. Bu doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200116,
					"content": "Öyleyse birkaç bitkinin doğal yaşam ortamlarında fotoğraflarını çekmem için bana yardımcı olur musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200117,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200118
					]
				},
				{
					"id": 200200118,
					"content": "Güzel! Öyleyse benim için Gelin Çiçeği, Küçük Lamba Otu ve Sesilya fotoğrafları çekebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200119,
					"content": "Sonrasında lütfen bu üç bitki türünü toplamama yardım et. Elimde birer örnek bulunsun istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200120
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200120,
					"content": "Bu bitkilerin doğal yaşam ortamlarındaki fotoğrafları, canlı numuneleri ve ayrıntılı açıklamaları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200121
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200121,
					"content": "El kitabımın botanik kısmı çok güzel oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200122,
					"content": "Tamam o zaman, Gezgin. Sana güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200123
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200123,
					"content": "Bahar geldiğinde Pınarköy bolca Gelin Çiçeğine ev sahipliği yaparken Kurtlar Diyarı'nda da Küçük Lamba Otu biter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200124,
					"content": "Sesilyalara gelirsek... Onları da Yıldızkapan Uçurumu'nda bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200125,
					"content": "Bu sırada ben de bitki gözlemlerime başka yerde devam edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200200126
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200126,
					"content": "Fotoğraflar hazır olunca şehirde buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200200109,
					"content": "Eğitimin nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200200110
					]
				}
			]
		},
