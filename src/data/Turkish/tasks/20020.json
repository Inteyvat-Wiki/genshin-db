				"points": []
			},
			"dialogs": [
				{
					"id": 200201001,
					"content": "Geri dönmüşsün Gezgin! Nasıl gitti? Fotoğrafları çekebildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201002
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201002,
					"content": "Fotoğraflar da örnekler de burada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200201003
					]
				},
				{
					"id": 200201003,
					"content": "Vay canına! Çok hızlı oldu! Demek deneyimli maceracılar böyle oluyor. Harikasın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201004
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201004,
					"content": "Çok teşekkür ederim Gezgin! Sana teşekkür etmek için bir yemek yapayım mı? Emin ol lezzetli olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201005
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201005,
					"content": "Nasıl ama, güzel görünüyor değil mi? Umarım beğenirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201006
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201006,
					"content": "Ben de gidip şu notları yazayım. Bitkilere gelecek olursak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201007
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201007,
					"content": "Jack'e gidip bitki örneklerinin nasıl saklanacağını biliyor mu diye bir sorayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200201008
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200201008,
					"content": "Sesilyalara gelince... Onlar numune olmak yerine vazoda daha güzel duracak gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
		},
