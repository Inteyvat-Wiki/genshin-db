			"dialogs": [
				{
					"id": 701140101,
					"content": "Bayan Sandrone'nin vakit bulup da Mondstadt'ı ziyaret etmesi gerçekten de eşine az rastlanır bir durum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140102
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140102,
					"content": "Numerolojik dizilimi araştırırken bana çok büyük yardımın dokundu. Sana bizzat teşekkür etmek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140103
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 701140103,
					"content": "Çok naziksin ancak bu tür şeyler uzmanlık alanımın çok dışında. İşi tamamladığın için bütün övgüyü asıl sen hak ediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140104,
					"content": "Bu bir takım çalışmasıydı. Hımm... Sahi, Durin nerede? Onun bir nevi koruyucusu sayıldığın için dizinin dibinden pek ayrılmaz sanıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140105
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 701140105,
					"content": "Haksız sayılmazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140106
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140106,
					"content": "Ama son zamanlarda sosyal becerilerinde ilerleme kaydediyor, bu yüzden onu biraz daha bağımsız olması için cesaretlendirmeye çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140107,
					"content": "Onun için endişelenmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140108
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 701140108,
					"content": "Biraz. Eskiden tek başınayken... Nasıl desem... Kişiliği \"güçlü\" olan biriyle etkileşime girdiğinde genelde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140109
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140109,
					"content": "Tuhaf alışkanlıklar mı ediniyordu? Garip konuşma biçimlerini taklit mi ediyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140110
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 701140110,
					"content": "Aynen öyle. Sen de mi benzer bir şey yaşadın Bayan Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140111,
					"content": "Hıh, sormana bile gerek yok. Uzman sayılırım artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140112
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 701140112,
					"content": "Genelde Büyük Kumandan Varka ile görüştükten sonra Durin'i Sucrose'un yanına götürüyorum ve araştırmalarına yardım ediyoruz. Böylece o da kafasını toplama fırsatı buluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140113
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140113,
					"content": "Ama Büyük Kumandan Vekili Jean ile çok fazla vakit geçirdiyse rahatlamayı hatırlasın diye Klee'nin yanına uğruyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140114
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140114,
					"content": "Epey zahmetli bir iş o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140115
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 701140115,
					"content": "Sadece aileme kol kanat geriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140116,
					"content": "Sen böyle durumlarla nasıl başa çıkıyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 701140117,
					"content": "Ben mi? Hiç öyle hengamelerle uğraşacak enerjim yok benim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140118
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 701140118,
					"content": "Ama bana kalırsa bir insan özünde iyiyse, dışarıdan ne kadar etkilenirse etkilensin bir noktada gerçek benliğine geri dönüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701140119
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 701140119,
					"content": "Hımm... Ne güzel bir tespit. Belki ben de bu bakış açısını benimseyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				}
			]
		},
