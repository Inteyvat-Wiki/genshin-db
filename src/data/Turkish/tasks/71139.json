				{
					"id": 711390601,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390602
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390602,
					"content": "Sorun nedir Lingyuan? Bana bakıp duruyorsun. Yüzümde yemek falan mı kalmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390603
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390603,
					"content": "Öylesine düşünüyordum... Önemli bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390604
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390604,
					"content": "Sen ve yılan isteseniz bile insan formuna tekrar dönemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390605
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390605,
					"content": "Hehe. Daha önce hiç böyle bir şey istememiştim ki, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390606
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390606,
					"content": "... Neyse, önemli değil. Hadi gidelim. Çay bahçesini görmek için can atmıyor muydun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				}
			]
		},
		{
			"id": 7113907,
			"completionStepIds": [],
