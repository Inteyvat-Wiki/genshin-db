					"nextDialogs": [
						711390902
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390902,
					"content": "B-Ben... Saklanmıyorum... Bana gösterdiği nezakete minnettarım ama pek de yakın sayılmazdık. Şimdi de konuşacak pek bir şeyimiz yok...",
					"roleType": "TALK_ROLE_NPC",
