			"dialogs": [
				{
					"id": 711390801,
					"content": "Fujin Abla! Eski haline döndüğün için tebrik ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390802
					],
					"speakerTitle": "Küçük Mao"
				},
				{
					"id": 711390802,
					"content": "Maviş'ten duydum! Gerçi \"Asıl sureti en iyisi.\" ve \"Niye insan suretine dönmek istiyor anlamadım.\" falan deyip duruyor ama onun da sevindiğini görebiliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390803
					],
					"speakerTitle": "Küçük Mao"
				},
				{
					"id": 711390803,
					"content": "#Çayı çok sevdiğini biliyorum Fujin Abla, o yüzden Lu Dede'den bana çay çöreği yapmayı öğretmesini isteyeceğim! Tarifi kaptıktan sonra da senin ve {M#Bay}{F#Bayan} {NICKNAME} için lezzetli mi lezzetli çay çörekleri pişireceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390804
					],
					"speakerTitle": "Küçük Mao"
				},
				{
					"id": 711390804,
					"content": "Hehe, sağ ol Küçük Mao. Çay çöreklerinin karşılığında ben de... Evet, vakti geldiğinde sana Lingyuan'ın geçmişiyle ilgili hikayeler anlatacağım.",
					"roleType": "TALK_ROLE_NPC",
