			"dialogs": [
				{
					"id": 711390301,
					"content": "Ha? Lingyuan, sen misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390302,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390303
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390303,
					"content": "Ayy, affedersin. Avlanıyor muydun? Rahatsız mı ettik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390304,
					"content": "Avlanmıyordum. Rahatsız da etmediniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390305
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390305,
					"content": "Hımm... Dalıp gittin o halde? Lezzetli yemekleri falan mı düşünüyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390306,
					"content": "Seni de düşünmüyordum. Sadece öyle düşünüyordum işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390307
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390307,
					"content": "Düşünmek derken... Bir saniye! İlk cümlende ne demek istedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390308,
					"content": "#{NICKNAME} daha önce bir soru sormuştu, onu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390309
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390309,
					"content": "\"Eğer insan faaliyetleri de doğa kanunlarının bir parçası olsa insanlık hakkında ne düşünürdün?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390310
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390310,
					"content": "Yerleşimi oluşturan insanlarla en son iletişime geçtiğimden bu yana çok uzun zaman oldu. Fujin ve yılan ayrıldığından beri oraya gitmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390311
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390311,
					"content": "Hey, Küçük Mao'yu insandan saymıyor gibi konuşuyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390312,
					"content": "#Küçük Mao yerleşik insan grubuna ait bir insan ancak yerleşimi oluşturan insanlardan biri değil. Mesela {NICKNAME} ile birlikte bir seyahat yoldaşlığı ekibi \"oluşturuyorsunuz\" fakat sen ona \"ait\" değilsin. Aradaki fark bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390313,
						711390315
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390313,
					"content": "Küçük Mao'yu sosyal düzenin bir parçası olarak görmüyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390314
					]
				},
				{
					"id": 711390314,
					"content": "Tam olarak değil. Çoğu genç insan, tıpkı doğada olduğu gibi düzen tarafından tamamen sindirilene kadar böyledir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390317,
					"content": "Yerleşimi oluşturan insanlarla iletişime geçtiğimden bu yana çok uzun zaman oldu. Bunun nedeni nefret, korku hatta ikisi birden olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390318,
						711390319
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390318,
					"content": "Doğaya ait toprakları işgal ettikleri için mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390320,
					"content": "Bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390321
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390321,
					"content": "Belki de \"bizi\" \"onlardan\" ayıran belirgin bir fark yoktur ama yine de emin olamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390322
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390322,
					"content": "İnsanların genç olanları benimle yürür. Benim soyumdan bir genç de sırf meraktan bir insanla yürüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390323
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390323,
					"content": "Hı? Soyundan bir genç mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390324,
					"content": "O çocuk dağlarda bir ölümlüyle karşılaştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390325
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390325,
					"content": "Bu yüzden sorunu hâlâ yanıtlayamıyorum. İnsanlığı gözlemlemeye devam etmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390326
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390326,
					"content": "Anlamadığım çok şey var. Söz verdiğim gibi, sorunu yanıtlayana kadar bunları anlamaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711390319,
					"content": "Fujin kendisini onlara feda ettiği için mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390315,
					"content": "Ben o kadar da emin olmazdım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390316
					]
				},
				{
					"id": 711390316,
					"content": "Hey! Böyle tuhaf şeyler söylemeyi bırak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7113904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
