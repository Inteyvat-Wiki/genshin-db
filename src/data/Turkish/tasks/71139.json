			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Küçük Mao",
					"Hautemontagne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390401,
					"content": "Dağ'ın dediğine göre Fontaine'deki operalar bizimkilere epey benziyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390402
					],
					"speakerTitle": "Küçük Mao"
				},
				{
					"id": 711390402,
					"content": "Şövalyeler, sihirbazlar, cesur savaşçılar ve uğursuz ejderler, siz beni öldürürseniz ben de sizi öldürürüm, sonunda herkes ölmüş olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390403
					],
					"speakerTitle": "Küçük Mao"
				},
				{
					"id": 711390403,
					"content": "Önemli olan son değil, sürecin kendisidir yani oraya nasıl ulaştığındır! Her trajedi bir dizi dövüş sahnesinden ibaret değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390404
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711390404,
					"content": "Ayrıca Dağ'ın bahsettiği \"Reymoya Golemleri\" gerçekten çok havalı! Acaba Maviş'ten daha mı büyükler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390405
					],
					"speakerTitle": "Küçük Mao"
				},
				{
					"id": 711390405,
					"content": "Hı? Maviş mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390406
					],
					"speakerTitle": "Hautemontagne"
				},
				{
					"id": 711390406,
					"content": "Ah, evet! Sana Maviş'ten hiç bahsetmedim, değil mi? Şöyle yapalım o halde, sen bana \"Reymoya Golemlerini\" anlat, ben de sana Maviş'i anlatayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Mao"
				}
			]
		},
		{
			"id": 7113905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fujin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390501,
					"content": "Vay canına! Farkına bile varmadan bir sürü Adeptus enerjisi toplamışız bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390502,
						711390503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390502,
					"content": "Aferin bana!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390505
					]
				},
				{
					"id": 711390505,
					"content": "Fujin'in daha önce söylediğine göre tüm bu Adeptus enerjisi Kutsal Yağmur Yeşimi üzerinde kullanılmalı. Böylelikle Qiaoying Köyü önümüzdeki yıl çabalarının meyvesini alabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390506,
					"content": "O zaman geldiğinde de Paimon, Luo Amca'dan bir sürü harika yemek hazırlamasını isteyecek! Paimon bir düşünsün... Mmm, çay çörekleri, güvercin, köfte kavurma, ballı char siu ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390507,
					"content": "Ah, evet! Ve tabii ki Chenyu Çayı! Paimon'un tüm bunları yazması lazım... Hey, kim var orada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390508,
					"content": "F-Fujin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390509,
					"content": "Hehe, kusura bakmayın. Sizi korkutmadım umarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390510
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390510,
					"content": "Yeniden insan formuna dönmüşsün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390511,
					"content": "Evet! Şahsım aslında ciddi yaralanmadığını ve en sevdiği forma dönmek için biraz dinlenmesinin yeterli olduğunu söylememiş miydi size?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390512
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390512,
					"content": "Ben dinlenirken Yağmur Yeşiminin ihtiyaç duyduğu tüm Adeptus enerjisini topladığınız için ikinize de teşekkürler. Önümüzdeki senenin hasadı sizin sayenizde bereketli olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390513,
						711390514
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390513,
					"content": "#Hehe, bendeniz {M#Küçük Bey}{F#Küçük Hanım} için bu çok küçük bir iş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390515,
					"content": "Artık insan formuna geri döndüğüne ve kendini o aşırı karanlık yere kilitlemen gerekmediğine göre bir sonraki planın nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390516,
					"content": "Evet... Bunu pek düşünmedim aslında. Belki de biraz dolaşıp etrafa bakarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390517
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390517,
					"content": "Bugünün çayını iç, bugünün operalarını dinle, bugünün insanlarını gör... *öhöm* Affedersiniz. Sevimsiz bir ihtiyar gibi sürekli \"bugünü\" vurgulayıp duruyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390518
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390518,
					"content": "Yine de bu kelimeyi seviyorum. Geçmişte yapamadığım şeyleri \"bugün\" yapabiliyorum. Daha önce başarılamayan şeyler, tutulamayan tüm sözler \"bugün\" gerçek olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390519
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390519,
					"content": "Daha sonra Guili Uygarlığına gidip bir göz atmak, Liyue Limanı'na gidip oradaki insanları görmek, anlattıkları tüm o sevecen insanlarla tanışmak ve elbette Otacı Efendi'yi yeniden görmek istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390520
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390520,
					"content": "Seni götürmemi ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390521
					]
				},
				{
					"id": 711390521,
					"content": "Evet! Paimon \"berrak suları uzun süreliğine terk etmemek\" ve \"uzun mesafeler katetmek için çaydanlıklardaki Adeptus diyarlarını kullanmak gerektiği\" ile ilgili bir şeyler söylediğini hatırlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390522,
					"content": "Hehe... Bunu hatırladığın ve bana yardım etmek istediğin için teşekkürler. Ancak yine de Chenyu Vadisi'nde bir süre daha kalıp evimin manzarasının ve seslerinin tadını çıkarmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390523
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390523,
					"content": "Uzun mesafeli seyahatlere gelecek olursak, bir düşüneyim... Hımm, belki de Küçük Mao büyüyene kadar beklemeliyim, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390524
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390524,
					"content": "Bu çok uzun sürer ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711390525,
					"content": "Şaka şaka! Her neyse, bir süre daha burada kalmayı planlıyorum. Belki Lingyuan'ı benimle birlikte seyahate çıkmaya ikna ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390526
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390526,
					"content": "#Ah, doğru! {NICKNAME}, sen gitmeden bir şey daha söylemem lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390527
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390527,
					"content": "Hem benim yüzümden hem de Lingyuan yüzünden başınıza gelmeyen kalmadı. Hazır Adeptus enerjim de yavaş yavaş iyileşiyorken izin verin önünüzdeki yol için size içten bir koruma lütfu vereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390528
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390528,
					"content": "Hehe, pekala! Artık her şey hazır görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390529,
						711390530
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390529,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390532
					]
				},
				{
					"id": 711390532,
					"content": "#O halde, tekrardan... Teşekkürler {NICKNAME}, teşekkürler Paimon. Benim için ve Chenyu Vadisi için yaptığınız her şeye teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390530,
					"content": "Pek bir fark hissetmiyorum ben...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390531
					]
				},
				{
					"id": 711390531,
					"content": "Ee, lütuf dediğin şey öyle hemen anlaşılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390532
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711390514,
					"content": "Yardım edebildiğime sevindim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390503,
					"content": "#Bendeniz {M#Küçük Bey'den de}{F#Küçük Hanım'dan da} bu beklenirdi doğrusu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390504
					]
				},
				{
					"id": 711390504,
					"content": "Hey! Onlar artık geçmişte kaldı, böyle konuşmayı bırak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390505
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
