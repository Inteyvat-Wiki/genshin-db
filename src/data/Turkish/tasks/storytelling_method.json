			"dialogs": [
				{
					"id": 728120201,
					"content": "Tamam. Yeter bu kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120202
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120202,
					"content": "Hiç bu kadar yorulmamıştım. Bu hikaye hep bu kadar karmaşık mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120203
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120203,
					"content": "Önden planlamanı yapmazsan böyle olur. Seni sınırlayacak anlatı teknikleri olmadan birçok teknik birbiriyle çakışır, hikaye çıkmaza girer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120204
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120204,
					"content": "Öyle olduğunda hikayenin kontrolünü tamamen kaybedersin. Yazdıklarının bir önemi kalmaz, çok yorulursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120205
					],
					"speakerTitle": "Shigeru"
				},
				{
					"id": 728120205,
					"content": "*iç çeker* Peki, tamam. Seninle tartışacak gücüm kalmadı. Geri bildirimin için teşekkürler Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120206
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120206,
					"content": "Bence bu bana çok şey kattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120207
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120207,
					"content": "Lütfen teşekkür olarak bunu kabul et. Çok geçmeden yazmaya başlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728120208
					],
					"speakerTitle": "Junkichi"
				},
				{
					"id": 728120208,
					"content": "Hımm. Anlatı teknikleri mi daha önemli anlatım mı?",
					"roleType": "TALK_ROLE_NPC",
