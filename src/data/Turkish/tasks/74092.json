			"dialogs": [
				{
					"id": 740920101,
					"content": "Neden... Neden böyle olmak zorunda? Tam bir rezalet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920102,
						740920103
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920102,
					"content": "Bayan Chronie?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				},
				{
					"id": 740920104,
					"content": "#{NICKNAME}! Geldin demek! Çok güzel... Ah, bu sensin... En azından sen gerçekleri biliyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920105
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920105,
					"content": "Sakinleşmeye çalış Bayan Chronie. İyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920106,
					"content": "Makalem... Makalem yayınlanmasa bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920107
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920107,
					"content": "Makalenle ilgili bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920108
					]
				},
				{
					"id": 740920108,
					"content": "Evet! Biz de ne zaman okuyacağımızı merak ediyorduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920109,
					"content": "Okumadınız... Okuyamadınız... Tabii ya, nereden nasıl okuyacaksınız ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920110
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920110,
					"content": "Kafan biraz... Karışmış gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920111
					]
				},
				{
					"id": 740920111,
					"content": "Mesele şu ki... Fontaine Araştırma Enstitüsünden geldiğimden beri kendi makalem üzerinde çalışıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920112
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920112,
					"content": "Gördüğüm, duyduğum, hissettiğim her şeyi taslağa dökmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920113
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920113,
					"content": "Mesela Enstitünün Arkhiyumu tamamen kaldırmamasını, aksine Arkhiyumla ilişkili başka bir araştırma projesine başlamasını...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920114
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920114,
					"content": "Edwin'in adamlarından birinin Enstitü harabelerini incelemeye gönderildikten sonra bir patlamada hayatını kaybetmesini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920115
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920115,
					"content": "Kıdemli Teknisyen Raimondo'nun adamın ölümünü doğrulamamasını, patlamanın projenin planlı bir parçası olduğu konusunda ısrar etmesini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920116
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920116,
					"content": "Harabelerdeki kontrolden çıkmış dev makinayı, kirlenmiş suları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920117
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920117,
					"content": "Fontaine Araştırma Enstitüsünün hasır altı etmeye çalıştığı her şeyi... En ince detaylarıyla yazmıştım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920118
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920118,
					"content": "Ancak... Ben makaleyi teslim ettikten sonra Enstitü bana dava açtı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920119
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920119,
					"content": "Yayın yönergelerine göre Fontaine Araştırma Enstitüsü hakkında yazdığım her şey bir güvenilirlik incelemesinden geçmeliymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920120
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920120,
					"content": "Bir de üstüne Fontaine Araştırma Enstitüsü hakkındaki makalem reddedilmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920121,
						740920122
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920121,
					"content": "Güvenilirlik incelemesi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920123,
					"content": "Hayır, makalede yazdığım konu başlıkları değil, bizzat ben hedef alınmışım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920124
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920124,
					"content": "Kısaca özetlemek gerekirse Fontaine Araştırma Enstitüsü, beni Enstitü ile girdiğim çıkar çatışması nedeniyle şahsi görüşlerimden yola çıkarak haber yazmakla ve halka yanlış bilgi vermekle suçluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920125
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920125,
					"content": "Senin Enstitü ile çıkar çatışman var mı ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920126
					]
				},
				{
					"id": 740920126,
					"content": "Sadece birkaç aşınmış kayanın ve bozuk makinanın fotoğrafını çektin, o kadar... Nasıl bir çıkarın olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740920127,
					"content": "Etik dışı uygulamaları açığa çıkardığın için olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920128
					]
				},
				{
					"id": 740920128,
					"content": "Beni... Beni son Fonta serisinin tasarımını sızdırmakla suçladılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920129
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920129,
					"content": "Harabelerde çektiğim bazı fotoğrafların son Fonta tasarımının bazı parçalarını ifşa ettiğini iddia ettiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920130
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920130,
					"content": "Tüm fotoğrafları en ince detayına kadar analiz edecekler. Analiz tamamlana dek davayı geri çekmeyecekler. Bu süreçte benim de güvenilirlik incelemesi sonucuna uygun hareket etmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920131
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920131,
					"content": "Makalemin halka ulaşmaması için oyun oynuyorlar... Ama ben asla pes etmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920132
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920132,
					"content": "İşte, alın bunu! Gizlice bastığım bir gazete nüshası. Daha fazlasını basıp yayınlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920133
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920133,
					"content": "Herkese Fontaine Araştırma Enstitüsü hakkındaki gerçekleri anlatmalıyım ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920134
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920134,
					"content": "Bayan Chronie! Hâlâ ne yapıyorsunuz burada? Her yerde sizi arıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920135
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920135,
					"content": "Olamaz, biri geliyor. Burada duramam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920136
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920136,
					"content": "Nüsha burada, dikkatlice saklayın. Yazdıklarımın hepsi gerçek! Hem de hepsi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920137
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740920137,
					"content": "Kurallara göre rutin inceleme için Hukuk Dairesine gitmeniz gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920138
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920138,
					"content": "Durun, lütfen kaçmayın Bayan Chronie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920139
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920139,
					"content": "Alt tarafı Fonta, muhtemelen yanlış anlaşılmadır! Açıklarsanız mutlaka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740920140
					],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920140,
					"content": "Bekleyin! Lütfen durun Bayan Chronie!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muirne"
				},
				{
					"id": 740920122,
					"content": "Yani senin kendi gazeten, yazdığın makalenin güvenilir olduğuna inanmamış mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920123
					]
				},
				{
					"id": 740920103,
					"content": "Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740920104
					]
				}
			]
		}
	]
}