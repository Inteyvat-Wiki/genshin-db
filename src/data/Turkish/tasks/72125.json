			},
			"dialogs": [
				{
					"id": 721250501,
					"content": "Bu tohumlar işine yarar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250502
					]
				},
				{
					"id": 721250502,
					"content": "Ha? Evet, elbette yarar! Bu tohumlarla bir sürü çiçek yetiştirebilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250503
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250503,
					"content": "Şey... Pardon, bir saniye lütfen... Karşılığında bir şey vermem lazım sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250504
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250504,
					"content": "Bunlar senin için. Tohumlar için çok teşekkür ederim! Bir ara ziyaretime gel, açan güzel çiçek denizini görmüş olursun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
