			"dialogs": [
				{
					"id": 721250301,
					"content": "Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250302
					]
				},
				{
					"id": 721250302,
					"content": "Buraya çiçek ekebilmek için çiçek tohumları arıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250303
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250303,
					"content": "Bu adanın sakinleri Mikage Ocağı olayı sırasında başka yerlere gönderilmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250304
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250304,
					"content": "Her şeyin düzeldiğini öğrenince taşındım tekrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250305
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250305,
					"content": "Ama buraya ektiğim her çiçek solmuş ve hiçbir yerde tohum bulamıyorum. Çok yazık, burası çiçek ekmeye çok müsait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
