				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721250102,
					"content": "Keşke daha fazla çiçek dikebilsem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250103
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250103,
					"content": "Ah, merhaba! Tanıştığıma memnun oldum... Sen de geri dönen sakinlerden misin? Özür dilerim, seni daha önce gördüğümü sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250104,
						721250109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250104,
					"content": "Geri dönen sakin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250105
					]
				},
				{
					"id": 721250105,
					"content": "Evet, Mikage Ocağı olayı yüzünden Tatarasuna sakinleri başka yerlere gönderilmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250106,
					"content": "Bir süre önce Mikage Ocağı'nın düzeldiğini ve Tatarasuna'nın güvenli olduğunu duydum, o yüzden gittim ve dönebilir miyim diye sordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250107
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250107,
					"content": "Onaylanınca eşyalarımı toplayıp buraya taşındım tekrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250108
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250108,
					"content": "Ama... Benim haricimde buraya tekrar taşınmak isteyen çok insan yok gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250115
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250115,
					"content": "Ama yapacak bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250116
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250116,
					"content": "Mikage Ocağı olayı ciddi bir olaydı sonuçta. Herkes tekrarlanabileceğinden korkuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250117
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250117,
					"content": "Sen korkmuyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250118
					]
				},
				{
					"id": 721250118,
					"content": "Korkuyorum tabii ki... Ama ben evimden uzak kalamayan bir insanım. Çiçeklerimi düşünmeden edemedim. O yüzden her şeye rağmen dönmem gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250119
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250119,
					"content": "Ne yazık ki buraya önceden diktiğim tüm çiçekler solmuş. Çiçek tohumu bulamıyorum maalesef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250120
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250120,
					"content": "Burası çiçek dikmeye çok müsait. Ne ekersen ek hemencecik açıp bir çiçek denizine dönüşüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250121
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250121,
					"content": "Daha önce farklı ülkelerin çiçeklerini yetiştirmiştim. Mondstadt'ın Küçük Lamba Otunu, Rüzgargülü Çiçeğini ve Karahindibasını, ayrıca Liyue'nin İpek Çiçeğini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250122
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250122,
					"content": "Küçük Lamba Otu geceleri çok güzel görünür. Gölge bir yere ekip çokça sulamak ve ölü yaprakların uçlarını budamak gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250123
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250123,
					"content": "Duyduğuma göre Rüzgargülü Çiçeği rüzgarlı yerlerde daha iyi yetişirmiş. Inazuma'da da rüzgar var ama Mondstadt rüzgarı kadar kuvvetli olduğunu sanmam. O yüzden sık sık gidip yelpazeyle rüzgar yapmaya çalışırım ben de. İşe yaradığından emin değilim gerçi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250124
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250124,
					"content": "Karahindiba yetiştirmek çok kolaydır, kendi kendilerine büyürler... Bazen çok yayılırlar hatta. Kendi hallerine bırakırsan her yer Karahindiba olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250125
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250125,
					"content": "Çok doğru! Her neyse, ben...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250126
					]
				},
				{
					"id": 721250126,
					"content": "Liyue'nin İpek Çiçeği ise çok emek gerektirir. Hayalet Böcekler yapraklarının içine girmeyi pek sever ve onları tek tek ayıklaman gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250127
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250127,
					"content": "Qingxin yetiştirmeyi de denedim ama başarısız oldum. Önceden ektiklerim ya büyümedi ya da hemen soldu. Acaba bu dünyada her çeşit çiçeğin sorunsuz bir şekilde yetişebileceği büyülü bir yer var mıdır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250128
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250128,
					"content": "Kim bilir. Neyse, ben...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250129
					]
				},
				{
					"id": 721250129,
					"content": "Ayrıca Liyue'de \"Mor Ot\" adında bir çiçek türü olduğunu biliyor muydun? Bulması çok zor. Bir sürü insandan yardım istedim ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250130
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250130,
					"content": "Öhöm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250131
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250131,
					"content": "Ah, pardon! Ne zaman çiçeklerden bahsetsem kaptırıyorum kendimi böyle, çok özür dilerim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250132
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250132,
					"content": "Tam bir çiçek uzmanısın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250133
					]
				},
				{
					"id": 721250133,
					"content": "Aslında amatör bir çiçek severim, hehehe. Ama şu an hiç tohumum olmadığı için çiçek yetiştiremiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250109,
					"content": "Ben buranın sakini değilim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250110
					]
				},
				{
					"id": 721250110,
					"content": "Aa, öyle mi? Ben de benim gibi buraya tekrar taşınmak isteyen birini buldum sanmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250111,
					"content": "Tatarasuna sakinleri Mikage Ocağı olayı yüzünden başka yerlere gönderilmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250112,
					"content": "Bir süre önce Mikage Ocağı'nın düzeldiğini ve Tatarasuna'nın güvenli olduğunu duydum, o yüzden gittim ve dönebilir miyim diye sordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250113,
					"content": "Onaylanınca eşyalarımı toplayıp buraya taşındım tekrar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721250114,
					"content": "Benim haricimde buraya tekrar taşınmak isteyen çok insan yok gibi...",
					"roleType": "TALK_ROLE_NPC",
