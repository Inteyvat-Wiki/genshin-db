			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sitt",
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "Ah, yüce Doğa hükümdarı. Size nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150202,
					"content": "Kshahrewar aliminin kayıtlarına bakmak istiyorum. Şu anda bilinci yerinde değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150203,
					"content": "Tamam, bir dakika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150204,
					"content": "Bir süre sonra...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "Sizi beklettiğim için kusura bakmayın Doğa Hükümdarı. Şu anda bilinci yerinde olmayan Beynuni adında bir alim olduğunu doğruladık. Nedeni Akaşa'nın hatalı çalışması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150206,
					"content": "Henüz bilinci yerine gelmedi ve hâlâ Bimarstan'da tedavi görüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150207,
					"content": "Ha? Adı Moseis değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150208,
					"content": "Sanırım tanınmak ya da birileri tarafından rahatsız edilmek istemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150209,
					"content": "Lütfen burada depolanan bilgiyi Matraya verip Beynuni'nin beynine aktarmalarını iste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150210,
					"content": "Anlaşıldı, ama güvenlik sebebiyle neden olduğunu bilmem gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150211,
					"content": "Çok basit. Bu, onun bilincini içeriyor. Uzun zamandır bir rüyada kısılıp kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150212,
					"content": "Sumeru'nun güvenliğini etkileyen bir suç işledi. Uyanınca General Mahamatra'ya tüm detaylarıyla anlatacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150213,
					"content": "Anladım. Bununla hemen ilgileneceğim. Teşekkürler yüce Doğa Hükümdarı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "Sitt"
				},
				{
					"id": 130150214,
					"content": "Hı hı. Önemli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150215,
					"content": "Pekala, şimdi herkes \"Bir Rüya Anı\"nda toplanmıştır. Hadi geri dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301503",
							"2"
						],
						"stepId": 1301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "Sessiz olup dinleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150302,
					"content": "Ne söyleyecek merak ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150303,
					"content": "Yeni uyanan herkese merhaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150304,
					"content": "Güzel rüyalarınızı böldüğüm için üzgünüm. Rüyada bir şeylerle uğraşırken biraz soğuk davranmış olabilirim. Bunun için hepinizden içtenlikle özür diliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150305,
					"content": "Rüyaların harika bir gücü var. Zorluklar karşısında güçlü durmamız için bize ilham oluyorlar ve özlemi olanların isteklerini gerçekleştirmelerine yardımcı oluyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150306,
					"content": "Ancak rüyaların insanları kullanma, akıllarını karıştırma ve gerçeği çarpıtma gibi bir potansiyeli de var. Ne yazık ki, hepiniz özenle hazırlanmış bu planın bir parçası oldunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150307,
					"content": "Önceden de söylediğim gibi, hâlâ öğreniyorum ve yaşadığınız kayıp acılarıyla tam olarak empati kuramıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150308,
					"content": "Ancak etrafınıza iyi bakarsanız sizinle benzer şeyler yaşamış birçok kişi göreceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150309,
					"content": "Burada bir araya gelip geleceğe birlikte bakabildiğiniz için gurur duymalısınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150310,
					"content": "Hayat yolu çok uzun ve gideceğimiz yönü bulmak bizim için zor. Bu da bizi birçok zor soru sormaya itiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150311,
					"content": "Hayatın anlamı ne? Varoluş amacım ne? Neden sürekli acı ve kayıp yaşamaya devam ediyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150312,
					"content": "*iç çeker* Tabii ki yapılabilecek en rahat tercih, ilerlemeye devam etmeyip düşünmeyi bırakmak ve zaten bildiğin şeyleri yapmaya devam etmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150313,
					"content": "Ne zaman aklınızdan böyle bir düşünce geçerse etrafınızdaki şeylere ve insanlara bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150314,
					"content": "Bazı insanlar, akşam aileleri sıcak bir yemek yiyebilsin diye tüm gün hiç durmadan çalışır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150315,
					"content": "Bazı insanlar, Teyvat'ın her yerinde ses getirecek bir sanat eseri ortaya koymak için tüm dünyayı dolaşır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150316,
					"content": "Bazıları henüz bilinmeyen ancak hızla yaklaşan ve dünyayı sarsacak felaketleri önlemek için dünyanın sırlarını araştırmaya girişir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150317,
					"content": "Hayat sadece sizden ibaret değil. Yaptığınız her bir şey sizi ve etrafınızdaki dünyayı şekillendirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150318,
					"content": "*iç çeker* Bakın, arkadaşlarınız ve aileniz yaptıklarınızı hep hatırlayacak ve hatta sizi tanımayan bazı insanlar bile yaptıklarınızdan faydalanacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150319,
					"content": "Bu yüzden birçok insan, büyük acılara katlanmaları gerekse bile birçok yeni yol bulacaklardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150320,
					"content": "Bu zorlu ama ödüllendirici yolda yolculuğunuza başladığınızda artık sizin için eskisi kadar önemi olmayacak olan o büyük varoluşsal sorulara cevap bulacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150321,
					"content": "Ancak hayatın gelip geçici bir rüyadan başka bir şey olmadığına inanıyorsanız olacağı tek şey de bu olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150322,
					"content": "Hayatınızı nasıl yaşamak istediğinizi seçmekte özgürsünüz ancak sizin hükümdarınız olarak bu bilgiyi herkese duyurmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150323,
					"content": "Sonunda gerçek hayatınıza mal olsa da güzel bir rüyayı kucaklayıp kucaklamamak size kalmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Nahida"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "Harikasın Nahida! Rüyada, Paimon bile neredeyse o alime kanacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150402,
					"content": "İnsan doğasının zayıflıklarını manipüle etmekte çok iyi ama belki de uzun zaman önce kendisi onlara mahkum oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150403,
					"content": "Şu rüya inanılmaz derecede güzel ve cezbediciydi. Sıradan insanlar bunu göremedi ve kendilerini o rüyanın içinde kaybediverdiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150404,
					"content": "Ama uyanabildiğiniz sürece hâlâ hayatınıza devam edebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150405,
					"content": "Sen de çok şey öğrendin Nahida.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "Ne? Neden öyle dedin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150407,
					"content": "Şimdi diğerleriyle gerçekten empati yapabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "Evet! İnsanların hislerini anlayamadığını söylemiştin ama tüm bu insanlara karşı nasıl düşünceli olduğunu gördük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150409,
					"content": "Az önce yaptığın konuşmada herkesten bir şey vardı. İyi iş çıkardın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150410,
					"content": "Teşekkür ederim. Bu yolculuk boyunca birçok üzücü hikaye dinledim ve çoğu kalbime dokundu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150411,
					"content": "Rüyanın kurbanlarının, gerçekten yanlış bir şey yaptıklarını ve istedikleri şeyin mantıksız olduğunu söyleyemezsiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150412,
					"content": "Bu yüzden bize karşı direnip rüyalarını korumak istemelerini anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150413,
					"content": "Ancak anlayışım ve karışık hislerim muhtemelen yaşadıkları acının küçük bir kısmını bile açıklamaya yetmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150414,
					"content": "Bu \"küçük bir kısmın\" empati dediğiniz şeye de örnek olabileceğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150415,
					"content": "Kendine çok fazla yükleniyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150416,
					"content": "Hiç kimse tam anlamıyla empati yapamaz zaten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "Heheh, pekala. Sanırım dünyaya açılmak özgüvenimi artırmamda yardımcı olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150419,
					"content": "Duyguların bilgi gibi olmadığını öğrendim ve bu yüzden onları kelimelere dökmek bana zor geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150420,
					"content": "Beynuni ya da \"Moseis\" kişisel olarak hiçbir kayıp acısı çekmediğimi söyledi. Ama bunun doğru olmadığına dair garip bir his var içimde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150421,
					"content": "Rüyaya girdiğim an sanki sıcak duygulardan yapılmış bir battaniyeyle sarılmışım gibi hissettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150422,
					"content": "O kadar sıcaktı ki sanki hayatımın başına dönmüşüm gibi hissettirdi ve hiç uyanmak istemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150423,
					"content": "(Ne? O da mı rüyada bir şey gördü?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "Ancak gözlerimi açtığımda o his tamamen kaybolmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150425,
					"content": "Bir benzetmeyle anlatmam gerekirse, kağıttaki yazı silindiği için göremiyorum ancak yazının oluşturduğu o hafif izleri seçebiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150426,
					"content": "Ama bu rüyayı deneyimledikten sonra... Bu sıcaklığın anlamı üzerine çok durmayacağımı güvenle söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150427,
					"content": "Bir zamanlar bu sıcaklıktan destek aldığımı ve bugün olduğum yere gelmemi sağladığını söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150428,
					"content": "Anlamı üzerinde çok fazla durursam işleri tersinden yapmış olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150429,
					"content": "Halkıma ilham verecek bir konuşma yaptım, kendim bu konuşmaya göre yaşayamazsam o zaman çok utanç verici olur, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150430,
					"content": "(Mahadevi Rukkhadevata eylemleriyle Nahida'yı çoktan şekillendirdi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "(Eğer bir gün unutulsa bile Nahida'nın aklı ve iradesi onun bir zamanlar var olduğunun kanıtıdır.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "(Ona gerçeği söylemektense onların kararlarına saygı duymalıyım.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "Hey, bu ciddiyet ne böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 130150434,
					"content": "Söylemek istediğin bir şey var gibi duruyorsun. Bana anlatmak istediğin bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150435,
					"content": "Şey, ne diyeceğimi unuttum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "Hehe, tamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150438,
					"content": "Yeni uyandık, biraz esneyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150439,
					"content": "Yeni bir gün başlamak üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nahida"
				},
				{
					"id": 130150436,
					"content": "Önemli değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "Kendine biraz daha fazla güvenmen gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
