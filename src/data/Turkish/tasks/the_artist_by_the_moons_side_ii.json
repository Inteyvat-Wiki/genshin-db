			"dialogs": [
				{
					"id": 760510101,
					"content": "#{NICKNAME}, Paimon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510102
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510102,
					"content": "Sorun nedir Columbina? Canını sıkan bir şey var gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510103,
					"content": "Yanınızda boya var mı hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510104
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510104,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510105
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510105,
					"content": "Aa! Sen... Maalaus'sun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510106,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510107
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510107,
					"content": "Yine resim yapasın mı geldi? Ama boyanın çoğunu yüzüne bulaştırmışsın... Nasıl becerdin bunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510108,
					"content": "Maalaus bir süreliğine ayrılmıştı ve böyle geri döndü. Sanırım bu boyayı temizlemek biraz zaman alacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510109
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510109,
					"content": "Belki de Maalaus ilham ararken bir sıkıntı yaşamıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510110,
					"content": "Yine de hiç fena görünmüyor. Sanatçı havası katmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510111,
					"content": "??",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510112
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510112,
					"content": "Ha, boya konusunda... Sadece Maalaus'a renkli şeyler vermemiz gerekiyor, değil mi? Tıpkı bir önceki sefer gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510113,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510114
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510114,
					"content": "Hehe, Kuuhenki nasıl da mutlu oldu. Maalaus'un aklına harika fikirler gelmiş olmalı... Çok eğlenceli ve neşeli şeylerdir kesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510115,
					"content": "Hadi sıcak ve mutlu renkler bulalım bu kez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
