			"dialogs": [
				{
					"id": 760510301,
					"content": "Bu iş görür, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510302,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510303
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510303,
					"content": "İşte! Resim yapmaya başladı bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510304,
					"content": "Öhöm... Değerli jüri üyeleri, büyülenmeye hazırlanın! Bakalım yetenekli Kuuhenki sanatçımız bize nasıl bir şaheser yarataca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510305,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510306
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510306,
					"content": "Ha? Çizdin mi hemen? Paimon daha girizgah bile yapamadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510307,
					"content": "Pekala, bir bakalım. Aa! Columbina'nın bir çizimi daha. Hiç şaşırtmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510308,
						760510309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510308,
					"content": "Güzel olmuş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				},
				{
					"id": 760510310,
					"content": "Burası... Nod-Krai'da bir orman mı? Bir sürü küçük hayvan var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510311,
					"content": "Korkarım... Böyle bir şey görebilmek için Donuk Ayın Çocuklarından ayrılmamdan önceki zamana geri dönmen gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510312
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510312,
					"content": "Vay canına, Paimon çok kıskandı! Gerçekten de sevimli küçük hayvanlar etrafında böyle mi toplanıyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510313,
					"content": "Evet, çoğu etrafımdaki Kuuvahkiye çekiliyordu. Yanımda böyle kıvrılarak güvende hissediyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510314
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510314,
					"content": "Süpermiş! O halde onları istediğin kadar sevebilirsin, üstelik kaçacaklar diye korkmana gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510315,
					"content": "Evet... En keyiflisi de Şık Porsukları sevmekti. Büyük ve pofuduk kuyrukları vardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510316
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510316,
					"content": "Bir Buzboynuzlu Geyiğin boynundaki kürk de oldukça yumuşaktır. Çok rahat bir yastık oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510317
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510317,
					"content": "Siz hangisini tercih edersiniz peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510318
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510318,
					"content": "Şey, karşılaştırabileceğimiz bir deneyimimiz olmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510319,
					"content": "Ama Paimon muhtemelen bir Şık Porsuğun kuyruğunu okşamayı seçerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510320,
					"content": "Şık Porsuklar epey ürkek olabiliyor. Onları okşamak istiyorsan önce güvende hissetmeleri gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510321
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510321,
					"content": "Ah... Ama dikkatli olmalısın Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510322
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510322,
					"content": "Neden ki? Yoksa... Isırıyorlar mı? P-Paimon çok nazik olacağına söz veriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510323,
					"content": "Hayır. Yukarıdan gelen tehlikeden bahsediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510324
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510324,
					"content": "Yukarıdan gelen tehlike mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510325,
					"content": "Evet... Uzun tüylü leylekler genellikle bunlar gibi küçük hayvanları avlarlar. Kuuhenkilerin peşini bırakmaları için onları uyarmak zorunda kaldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510326
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510326,
					"content": "Bunu Paimon'a şimdi mi söylüyorsun? Henüz kaçırılmamış olması bir mucize!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510327,
					"content": "Ah... O zaman bir dahaki sefer uzun tüylü leylek gördüğümde sana da dokunmamalarını söyleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510328
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510328,
					"content": "Bir dahaki sefer mi? Hemen bir tane bulsan iyi olur, yoksa Paimon o kapıdan dışarı uçmaya bile korkacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510329,
					"content": "Ah, anlıyorum. Bu durumda, onlara Paimon'un...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510330,
						760510332,
						760510334
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510330,
					"content": "En iyi yoldaş olduğunu söyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510331
					]
				},
				{
					"id": 760510331,
					"content": "Kesinlikle! İnsanların seyahat yoldaşlarını kaçıramazlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510336,
					"content": "!!!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510337
					],
					"speakerTitle": "Maalaus"
				},
				{
					"id": 760510337,
					"content": "Paimon'un bir uzun tüylü leylek tarafından kaçırılması fikri... Garip bir şekilde bu ufaklığın ilgisini çekmiş görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510338
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760510338,
					"content": "Sakın böyle bir resim çizmeye kalkışma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510332,
					"content": "Teyvat'taki en iyi seyahat rehberi olduğunu söyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510333
					]
				},
				{
					"id": 760510333,
					"content": "Eee... Paimon bu şekilde düşünmene sevindi ama... Muhtemelen \"seyahat rehberi\"nin ne olduğunu bile bilmiyorlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510334,
					"content": "Midelerini ağrıtacak bir yiyecek olduğunu söyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510335
					]
				},
				{
					"id": 760510335,
					"content": "Hayır, sakın o düşünceyi akıllarına sokma! Ya şanslarını denemeye kalkarlarsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760510336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760510309,
					"content": "Resme bakınca mutlu oluyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760510310
					]
				}
			]
		},
