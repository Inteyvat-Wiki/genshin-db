			"dialogs": [
				{
					"id": 790710101,
					"content": "#Takımyıldız Metropolü'ne hoş geldiniz {NICKNAME} ve Bayan Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710102
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710102,
					"content": "Meslektaşlarım namınızdan ve yaptıklarınızdan övgüyle bahsettiler, ayrıca ne kadar cesur olduğunuzdan da söz ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710103
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710103,
					"content": "Muhafızların eğitiminden sorumlu olmasaydım sizinle idman dövüşü yapmak isterdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710104
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710104,
					"content": "Demek muhafızsın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710105
					]
				},
				{
					"id": 790710105,
					"content": "Evet, öyleyim. Efendimizin emirleri doğrultusunda, Takımyıldız Metropolü'nü koruyor ve huzuru sağlıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710106
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710106,
					"content": "Benim işim muhafızları eğitmek ve görevleri yerine getirmeleri için becerilerini kullanabilmelerini sağlamak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710107
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710107,
					"content": "Yani arkadaki kapı bizi eğitim alanına mı götürüyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710108
					]
				},
				{
					"id": 790710108,
					"content": "Gözünden de bir şey kaçmıyor! Tadilatını yeni bitirdiğimiz bir Zindana açılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710109
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710109,
					"content": "Bu alanlarda eğitim gören muhafızların kılıçlarını belirli bir tempoda savurabilmeleri gerekir. Arenanın aydınlatması da savaş sırasında sürekli değişir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710110
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710110,
					"content": "Oldukça sıkı bir eğitimden geçiyorlar galiba...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710111
					]
				},
				{
					"id": 790710111,
					"content": "Kulağa karmaşık geliyor... Savaşırken de o belirli tempoyu takip etmeniz gerekiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790710112,
					"content": "Eğitim programının bu kısmı \"Baykuş Müzisyen\" adlı bir hikayeden alındı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710113
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710113,
					"content": "Bu hikaye bir süre önce muhafızlar arasında oldukça popülerdi. Çoğu muhafız o kadar eğlenirdi ki eğitime katılmayı bile unuturlardı ve günlük devriyeleri gecikirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710114
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710114,
					"content": "Sonra aklıma bir fikir geldi. Herkes bu hikayeyi çok sevdiği için eğitimlere bu hikayeden bazı parçalar eklemenin eğitimleri daha eğlenceli hale getirebileceğini düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710115
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710115,
					"content": "Eğitimler üzerinde gözle görülür bir etkisi oldu... En azından artık devriyelerimizde kişisel nedenlerden ötürü gecikmeler yaşanmamaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710116
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710116,
					"content": "Hehe... Acaba siz bu eğitimle ilgilenir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710117
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710117,
					"content": "Sizin gibi cesur savaşçılar için bu mücadeleler çocuk oyuncağı olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790710118,
						790710120
					],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710118,
					"content": "Denemek isterim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710119
					]
				},
				{
					"id": 790710119,
					"content": "İşte cesaret diye buna derim! Harika. O zaman lütfen Zindana girin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alof"
				},
				{
					"id": 790710120,
					"content": "Şu anda halletmem gereken başka işler var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790710121
					]
				},
				{
					"id": 790710121,
					"content": "Anlıyorum. Vaktiniz olduğunda uğrayın o halde. Ben burada nöbet tutuyor olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alof"
				}
			]
		}
	]
}