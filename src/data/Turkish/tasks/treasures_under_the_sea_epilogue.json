			"dialogs": [
				{
					"id": 746740101,
					"content": "Kadim Demir Paracıklarım... Güzel, çok güzel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740102
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740102,
					"content": "#Bunca Kadim Demir Para sayesinde artık Moraya Mora demem herhalde! Çok sağ olun {NICKNAME}, Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740103
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740103,
					"content": "Şimdi ne yapacaksın peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746740104
					]
				},
				{
					"id": 746740104,
					"content": "Tabii ki ilk işim... Bu Kadim Demir Paraları satarak Mora kazanmak ya da işime yarayabilecek başka şeyler toplamak olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740105
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740105,
					"content": "Bir daha o aracıyla yüz göz olmak istemiyorum. Her seferinde komisyon bahanesiyle paranın büyük bir kısmını cebe indiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740106
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740106,
					"content": "Hatta onunla kalsa yine tamam diyeceğim. O bana paramı getirene kadar beklemesi var bir de... Ne biçim iş yapıyor çözemedim gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740107
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740107,
					"content": "Ama işte... Konu iş olunca ondan başka birine de bel bağlayamıyorum ki... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740108
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740108,
					"content": "Neyse, kapatalım şimdi bu mevzuları! Bunlar sizin olsun, uzun vadeli iş birliğimizin bir meyvesi olarak kabul edin artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746740109
					],
					"speakerTitle": "Ulman"
				},
				{
					"id": 746740109,
					"content": "Fontaine'de işim bittiğinde sonraki planımı enine boyuna düşüneceğim. Yolculuk yolculuk nereye kadar, insanda takat kalmıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ulman"
				}
			]
		}
