			"dialogs": [
				{
					"id": 718050401,
					"content": "Ne oldu genç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050402
					],
					"speakerTitle": "Soylu De'an"
				},
				{
					"id": 718050402,
					"content": "Jifang'a verdiğiniz siparişi getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "Görünmez Hükümdar'ın dördüncü cildi mi? Bu siparişi ne zaman verdiğimi bile unuttum. Neden bu kadar gecikti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "Soylu De'an"
				},
				{
					"id": 718050404,
					"content": "Bir bakayım. Oo, ilk baskı mı? Neden bu kadar uzun sürdüğü şimdi anlaşıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "Soylu De'an"
				},
				{
					"id": 718050405,
					"content": "Ben de diğer müşterilerle uğraşırken Jifang benim kitabımı unuttu diyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "Soylu De'an"
				},
				{
					"id": 718050406,
					"content": "Kitabı getirdiğin için teşekkür ederim genç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soylu De'an"
				}
			]
		},
