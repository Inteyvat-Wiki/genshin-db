			"dialogs": [
				{
					"id": 718050501,
					"content": "Buyur evladım, ne vardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050502
					],
					"speakerTitle": "Tian Amca"
				},
				{
					"id": 718050502,
					"content": "Jifang'a verdiğiniz siparişi getirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "Neyi getirdin? Ah, doğru, hatırladım. Wanwen Kitabevinden Denge Dizeleri'nin nüshasını sipariş etmiştim, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "Tian Amca"
				},
				{
					"id": 718050504,
					"content": "Evet, evet, bu kitabı istemiştim. Haha, diğer müşteriler nedeniyle Jifang'ın siparişimi unuttuğunu düşünmeye başlamıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "Tian Amca"
				},
				{
					"id": 718050505,
					"content": "Geldi demek, iyi oldu. Çok iyi ciltlenmiş. Jifang her zamanki gibi özenli çalışmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "Tian Amca"
				},
				{
					"id": 718050506,
					"content": "Teşekkür ederim genç. Kitabı eve götüreyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tian Amca"
				}
			]
		},
