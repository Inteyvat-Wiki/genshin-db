					}
				]
			},
			"dialogs": [
				{
					"id": 402000101,
					"content": "Ne hoş bir gece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000102
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000102,
					"content": "Taze Romaritime Çiçekleri, köşedeki dükkandan gelen parfüm kokuları ve kahve çekirdeklerinin yoğun aroması bir araya gelmiş ve gecenin esintisine karışmışlar... Çok rahatlatıcı bir atmosfer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000103
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000103,
					"content": "Keşke bir yerlerde bir çatı katının terasında olsaydık, birkaç kadeh köpüklü şarap içer ve hafiften sarhoş olurduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000104,
						402000105
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000104,
					"content": "Şu an tatildesin zaten! Neden olmasın ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000106
					]
				},
				{
					"id": 402000106,
					"content": "Pekala... O halde oturabileceğimiz bir yer bulalım. Bakalım bu şehrin hanlarında ne tür özel içkiler varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000107
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000107,
					"content": "Ama önce... Cabriere Cemiyetine gitmek istiyorum kapanmadan. Bu kıyafetime uygun bir parfüm seçmeme yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000108
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000108,
					"content": "Burada ayrıca karmaşık saatler, kurmalı dekorasyonlar ve kaliteli mücevherler olduğunu duydum. Göz atmaya değer çok sayıda hediyelik eşya olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000109,
						402000110
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000109,
					"content": "Ne kadar uzun çalışırsan o kadar fazla mı Mora harcamak istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000111
					]
				},
				{
					"id": 402000111,
					"content": "Hazır Teyvat'ın genel kültürü en yüksek gezgini de yanımdayken bu fırsatın tadını çıkarayım. Rehberim sensin, güvenimi boşa çıkarma bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000112
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000112,
					"content": "Çok memnun kaldım. Çok hoş bir seyahat oldu... Gerçekten harikaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000113
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000113,
					"content": "Keşke daha fazla kalabilseydim, belki birkaç gün daha. Tatildeyken acele etmek istemiyor insan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000114,
						402000115
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000114,
					"content": "Hani tatilin tadını çıkaracaktın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000116
					]
				},
				{
					"id": 402000116,
					"content": "Yapacak bir şey yok. Görev beni bekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000117
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000117,
					"content": "Vakayla ilgili resmi bir rapor hazırlamam ve daha gelişmiş bir kargo denetim sistemi oluşturulmasına yardım etmem gerekiyor. Ondan sonra da diğer görev yerime gideceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000118
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000118,
					"content": "Nod-Krai'a yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000119,
						402000120
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000119,
					"content": "Paimon ve ben de oraya gideceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000121
					]
				},
				{
					"id": 402000121,
					"content": "Yok, acil bir durum değil. İstihbarat sağlayan bir ortağımla görüşeceğim. İkimize de fayda sağlayacak bir yol haritası oluşturup bazı sınırlar belirleyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000122
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000122,
					"content": "Sonra detaylıca anlatırım. Ama şimdi, Fontaine seyahatimizi ölümsüzleştirmek için birlikte bir fotoğraf çekilelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000123,
						402000124
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000123,
					"content": "Bu vakada bana nasıl yol gösterdiğini...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000125
					]
				},
				{
					"id": 402000125,
					"content": "#Aynen öyle. Artık arkamı kollayabileceğine olan inancım tam {NICKNAME}. Gerçi Ajan {NICKNAME} demem daha doğru olur sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000126
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000126,
					"content": "Fotoğrafımızı çekmek için şu Adli Görüntüleme Cihazını son bir kez kullanalım diyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000127
					],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000127,
					"content": "Belki Nod-Krai'da yine kesişir yollarımız. O halde bu iş birliğimizi daha nicelerinin başlangıcı olarak kabul edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yelan"
				},
				{
					"id": 402000124,
					"content": "... Ve operasyonumuzun başarısını ölümsüzleştirmiş oluruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000125
					]
				},
				{
					"id": 402000120,
					"content": "Oradaki görevin acil mi? Bir olay mı yaşandı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000121
					]
				},
				{
					"id": 402000115,
					"content": "Neden işe geri dönecekmiş gibi konuşuyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000116
					]
				},
				{
					"id": 402000110,
					"content": "Alışveriş çılgınlığı başlasın o halde!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000111
					]
				},
				{
					"id": 402000105,
					"content": "Kutlamayı hak ediyorsun! Başarımıza kadeh kaldıralım hadi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000106
					]
				}
			]
		},
		{
			"id": 4020002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
