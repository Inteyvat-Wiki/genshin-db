				"points": []
			},
			"dialogs": [
				{
					"id": 402000201,
					"content": "Yani Memur Fonck'un bizi kötü adamların sorgulandığı yere götüreceğini mi söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402000202,
					"content": "Aynen öyle. Gizli üssümüzü görmüş olursun böylece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000203
					],
					"speakerTitle": "Edler",
					"speakerSubtitle": "Asayiş Dairesi Ajanı"
				},
				{
					"id": 402000203,
					"content": "Haha, şaka yapıyorum. İnsanların gündelik işlerini aksatmamak için ücra bir ev seçtik. Yola çıktığımız zaman yakınımda durun, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000204
					],
					"speakerTitle": "Edler",
					"speakerSubtitle": "Asayiş Dairesi Ajanı"
				},
				{
					"id": 402000204,
					"content": "#Merak etme! Paimon çok tecrübeli bir rehberdir. {NICKNAME} ile birlikte gitmedikleri çetrefilli yer kalmadı, Fontaine'de kaybolmasına imkan yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402000205,
					"content": "#Aa, {NICKNAME} gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402000206,
					"content": "Ne kadar çabuk sürdü! Yoksa Yelan \"gözlerini bir saniye kapat, tamam, bu kadar dinlenme yeter, hadi işe dönelim\" diyen tarzda bir insan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000207,
						402000208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402000207,
					"content": "Henüz tatilimize başlamadık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000209
					]
				},
				{
					"id": 402000209,
					"content": "Hehe, Paimon gayet iyi, merak edilecek bir şey yok. Büyüyüp gelişen tek sen değilsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402000210,
					"content": "Her şeyin icabına bakıldı. Yelan'la gönül rahatlığıyla tatile çıkabilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402000211,
					"content": "Tüm dertlerini bir kenara bırak ve eğlenmene bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402000212,
					"content": "Ben de Müfettiş Paimon'un rahatı için elimden geleni yapacağım. Ne öğrenmek, ne yemek istiyorsa tüm ihtiyaçlarını gidereceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402000213,
						402000214
					],
					"speakerTitle": "Edler",
					"speakerSubtitle": "Asayiş Dairesi Ajanı"
				},
				{
					"id": 402000213,
					"content": "Ben gideyim o halde!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000215
					]
				},
				{
					"id": 402000215,
					"content": "Paimon çok iyi bir müfettişlik öğrencisi olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402000214,
					"content": "İyi şanslar Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000215
					]
				},
				{
					"id": 402000208,
					"content": "Aklım sende kalmıştı, o yüzden kontrol etmeye geldim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402000209
					]
				}
			]
		}
	]
}