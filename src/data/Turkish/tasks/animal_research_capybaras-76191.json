			"dialogs": [
				{
					"id": 761910201,
					"content": "Seni kaç kere uyardım gözünü dört aç diye! Snezhnograd'daki müdavimlerimizin bizzat sipariş ettiği birinci sınıf mallardı bunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910202
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910202,
					"content": "Göz göre göre kaçmasına izin mi verdin yani? Ne oldu sana? Vicdan meleği falan mı kesildin bir anda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910203
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910203,
					"content": "Patron bir dinle lütfen, benim bir suçum yok. O Dağ Yabanileri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910204
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910204,
					"content": "Dağ Yabanileri ha? Bana bu masallarla mı geliyorsun? Böyle devam edersen Hazine Avcısı imajımız paramparça olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910205
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910205,
					"content": "Onlarla başa çıkamadım patron, elimden geleni yaptım ama olmadı. Mavili olan ve onun yeşil arkadaşı o tetikçilerden bile daha fena vuruyorlardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910206
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910206,
					"content": "(Bu ikisi... Kesinlikle birer kaçakçı.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910207
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910207,
					"content": "... Kim var orada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910208
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910208,
					"content": "Yavaş ol Lumi! Henüz değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910209,
					"content": "Bu da ne? Hımm... Nadir bir parça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910210
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910210,
					"content": "Hey, küçük bir kızın hakkından gelebilirsin, değil mi? Yeterince sağlam görünüyor. Yerine bunu alalım da işimiz görülsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910211
					],
					"speakerTitle": "Alhoma"
				},
				{
					"id": 761910211,
					"content": "Emredersin patron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910212
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910212,
					"content": "Bir de şimdi Lumi'nin peşine mi düşeceksiniz? Hazine Avcılarının itibarını iki paralık ettiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910213
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910213,
					"content": "\"İtibar\" mı? Hazine Avcılarının neyi dedin, pardon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910214
					],
					"speakerTitle": "Yelo"
				},
				{
					"id": 761910214,
					"content": "Çeneni yorduğuna değmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhoma"
				}
			]
		},
