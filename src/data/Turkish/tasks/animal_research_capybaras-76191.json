			"dialogs": [
				{
					"id": 761910301,
					"content": "Vay canına, gerçekten de gümüş bir Kapibara... Rengi boya değil, bir ışık oyunu da olamaz. Bu kadar ender görülen bir şey... İnanılır gibi değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910302
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910302,
					"content": "Natlan'ı köşe bucak aradım ama bir tanesine bile denk gelemedim. Meğer kaçakçılar kapmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910303
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910303,
					"content": "Ama canı yanmış gibi de durmuyor... Hehe, gümüş bir Kapibara! Kendi gözlerimle göreceğim hayatta aklıma gelmezdi! Dur bakayım... Bir dokunayım şuna, bakalım bu gümüş olan diğerlerinden farklı mıymış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910304
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910304,
					"content": "Ay! Ateş gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910305
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910305,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910306
					],
					"speakerTitle": "Kapibara"
				},
				{
					"id": 761910306,
					"content": "Aa, aklımdan çıkmış! Sen hâlâ tencerenin içindesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910307
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910307,
					"content": "Yoksa Natlan'ın Sıvı Filojistonuna alıştığın için mi bu sıcaklık sana hiç işlemiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910308
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910308,
					"content": "Neyse, şimdi benimle geri döneceksin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910309
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761910309,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kapibara"
				}
			]
