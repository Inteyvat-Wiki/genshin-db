			"dialogs": [
				{
					"id": 715380101,
					"content": "#Merhaba {NICKNAME}. Fener Şenliğin kutlu olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380102,
						715380103
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380102,
					"content": "Bir vaka için mi buradasın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				},
				{
					"id": 715380104,
					"content": "Zorla tatil yaptırıyorlar bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380105
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380105,
					"content": "Zorla... Tatil mi yaptırıyorlar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380106
					]
				},
				{
					"id": 715380106,
					"content": "Asayiş Dairesi tüm çalışanlarının yıl sonuna kadar tatil günlerini kullanmasını şart koştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380107
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380107,
					"content": "Yıl sonu hesaplamaları yapılırken, Devriye bir gün bile dinlenmediğimi fark etti ve bu yüzden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380108,
						715380109
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380108,
					"content": "Zor bir işin varmış...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380110,
					"content": "Hayır. Memurlarımız dönüşümlü vardiya sistemiyle çalışıyorlar ama ben ekibin yüzbaşısı olduğum için görevim hiç bitmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380111
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380111,
					"content": "Ayrıca pek çok acil vakayla da ilgileniyorum ve bunca koşuşturma arasında... Tatil yapmayı unutmuşum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380112
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380112,
					"content": "Hiç izin kullanmadan gayet iyi idare ediyordum aslında ama memurlarım huysuzlanmaya başladılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380113
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380113,
					"content": "\"Kuralların uyulmak için var olduğunu\" ve \"bir yüzbaşının örnek olması gerektiğini\" söyleyip bağrışmaya başladılar ve hiçbir mazereti kabul etmediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380114
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380114,
					"content": "Bizimle çalışan Savcılardan biri Fener Şenliği zamanı Liyue'nin müthiş bir tatil noktası olduğundan bahsediyordu. Tam o anda gemi biletini önüme koyunca... Kendimi burada buluverdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380115
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380115,
					"content": "Hakkını vermek lazım, Liyue yılın bu zamanında gerçekten görülmeye değer. Bu arada, Qiaoying Köyü'nden yeni geldim. Çayla yaptıkları dim sum harikaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380116
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380116,
					"content": "Biraz Özel Devriyeye götürmek için de aldım tabii. Ayrıca buranın geleneklerine uyup birkaç hediye zarfı da yapmayı planlıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380117
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380117,
					"content": "Sorun şu ki... Bu işlerde pek iyi değilim. Denemediğim yöntem kalmadı ama her seferinde tuhaf bir şey çıktı ortaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380118
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380118,
					"content": "#Sen nasıl yapacağını biliyor musun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380119
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380119,
					"content": "Birkaç öneride bulunabilirim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 715380109,
					"content": "Herkes senin gibi çok mu çalışıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380103,
					"content": "Burada olmanın sebebi... İş değil sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				}
			]
		},
