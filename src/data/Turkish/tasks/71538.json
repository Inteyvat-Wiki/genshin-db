			"dialogs": [
				{
					"id": 715380301,
					"content": "Vay canına, harika oldu! Hımm... Karşılığında ben de sana bir şey vermek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380302
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380302,
					"content": "Bu dim sum'ları teşekkür hediyesi olarak kabul et. Hazırladığın bu zarf sayesinde yolculuğum daha büyük bir anlam kazandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380303
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380303,
					"content": "... Ama Fontaine'den ayrılalı da epey oldu. Aklım memurlarda, idmanlarını aksatmıyorlardır umarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380304
					],
					"speakerTitle": "Chevreuse"
				},
				{
					"id": 715380304,
					"content": "Bir kondisyon testi planlasam fena olmayacak sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chevreuse"
				}
