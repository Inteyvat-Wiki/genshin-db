			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Changchang"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400010901,
					"content": "Benim adım Changchang. Az önce bez bebeğim olan Dolly'yi bağış olarak verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010902
					],
					"speakerTitle": "Changchang"
				},
				{
					"id": 400010902,
					"content": "Dolly dün gece rüyama girdi ve hayalinin gökyüzüne uçmak ve oradan manzarayı görmek olduğunu söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010903
					],
					"speakerTitle": "Changchang"
				},
				{
					"id": 400010903,
					"content": "Ben de onu şu büyük geyik fenerinin yanındaki kadına verdim. Şimdi Dolly'nin hayali gerçek olacak, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400010904
					],
					"speakerTitle": "Changchang"
				},
				{
					"id": 400010904,
					"content": "Doğru olanı yaptım, değil mi? Fener Şenliğinde hayallerin gerçekleşmesi gerek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Changchang"
				}
			]
		},
