			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720501,
					"content": "Wakamurasaki'yi bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720502
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720502,
					"content": "Üstün Ağ Topu konusu şöyle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720503
					]
				},
				{
					"id": 726720503,
					"content": "\"Üstün Ağ Topu\" ha? Aslında fena isim değil. Yine de, o teknik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720504,
					"content": "O teknik gerçekten insan özü çıkartabiliyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720505
					]
				},
				{
					"id": 726720505,
					"content": "Yok, hayır. İmkansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720506
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720506,
					"content": "Öyle bir Onmyoudou tekniğinin varlığının sadece kayıtları var. Uygulaması ise çoktan tarihin tozlu sayfalarında kaybolmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720507
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720507,
					"content": "Wakamurasaki'ye öğrettiğim teknik yalnızca küçük hayvanlarda işe yarıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720508
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720508,
					"content": "Nasıl yani? Neden bunu ona söylemedin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720509
					]
				},
				{
					"id": 726720509,
					"content": "Ah, neden mi? Sadece Wakamurasaki'nin belli bir şeyi insanlara yaymasını istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720510
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720510,
					"content": "\"Bantan Sango Dedektiflik Bürosunun başkanı Kamuna Onmyoudou tekniği kullanarak insanlara doğruyu söyleten bir ağ yapması için birini tuttu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720511
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720511,
					"content": "Tarihin tozlu sayfalarından çıkan Kamuna Onmyoudou, Bantan Sango Dedektiflik Bürosu, ve küçük hayvanların özünü gerçekten çıkartabilen bir ağ.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720512
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720512,
					"content": "Üçünü de toplarsan elinde hem etkileyici hem de içinde bir parça gerçeklik bulunduran bir şehir efsanesi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720513
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720513,
					"content": "Çoğu için şehir efsaneleri birer hikayedir. Ancak zaten içlerinde bir korku tohumu olan suçlular bu hikayeleri kolayca es geçemezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720514
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720514,
					"content": "Ha, şimdi anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720515
					]
				},
				{
					"id": 726720515,
					"content": "Öte yandan... Wakamurasaki bu \"bana tarihin en güçlü onmyoudou tekniğini bul!\" muhabbetiyle canımı sıkmaya başlamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720516
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720516,
					"content": "Ona böyle bir tekniğin olmadığını söylemekten dilimde tüy bitti ama bir türlü dinletemedim! Yakamdan düşmesi için ona *bir şeyler* vermekten başka şansım yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720517
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720517,
					"content": "Ya Wakamurasaki bundan kimseye bahsetmezse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720518
					]
				},
				{
					"id": 726720518,
					"content": "İmkansız. Ucunda kendi hayatı olsa bile sır tutamaz o. Onu aşırı iyi tanıyorum, güven bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720519
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720519,
					"content": "Benim yerime bu yolculuğu yaptığın için teşekkür ederim. Al bunu. Ayak işi yapmanın karşılığı olarak gör.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720520
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720520,
					"content": "Hükümdar aşkına! Umarım bir daha beni rahatsız etmez. Sonuçta ben bir dedektifim, onmyouji değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
