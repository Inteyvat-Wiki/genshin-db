			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Wakamurasaki"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726720201,
					"content": "Bu sefer kesin olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720202
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720202,
					"content": "Merhaba, Wakamurasaki sen misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720203
					]
				},
				{
					"id": 726720203,
					"content": "Evet, benim. Ne lazım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720204
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720204,
					"content": "Ağ Topu için gelmiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720205
					]
				},
				{
					"id": 726720205,
					"content": "Sen kimsin? Ah, şimdi hatırladım. Sen şu Gezgin olmalısın! Sango senden bahsetmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720206
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720206,
					"content": "Ağı kullanma şeklin gerçekten çok etkileyiciydi. Hatta ilham vericiydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720207
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720207,
					"content": "Üzerinde değişiklik yaptığını duydum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720208
					]
				},
				{
					"id": 726720208,
					"content": "Aynen öyle! Hehe... Sango benim için yeni bir Onmyou tekniği bile buldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720209
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720209,
					"content": "Ben de bu tekniği, ağı bir kere daha geliştirmek için kullandım ve yeni modelin adını \"Üstün Ağ Topu\" koydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720210
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720210,
					"content": "Sango'ya göre bu teknikle yaşayan canlıların şeklini yeniden oluşturmak için belli eşyaları araç olarak kullanmadan bu canlıların özünü yakalayabiliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720211
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720211,
					"content": "Bir insan özünü tekrar oluşturması bu tür bir Onmyouduo tekniğinin en büyük başarısıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720212
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720212,
					"content": "Bu insan özleri sorulara yanıt verebilir ve asla yalan söylemezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720213
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720213,
					"content": "Böyle bir tekniğin Sango gibi bir dedektifin ne kadar işine yarayabileceğini bir düşünsene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720214
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720214,
					"content": "Hatta biliyor musun? Tekniği bana söylemesinin ve ağa değişiklik yapmama izin vermesinin asıl sebebinin bu olduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720215
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720215,
					"content": "Ah, ah! Bunu sana Sango ile arkadaş olduğun için anlattım. O yüzden gidip başkalarına sakın söyleme, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720216,
						726720217
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720216,
					"content": "Ge-Gerçekten bu kadar etkili mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				},
				{
					"id": 726720218,
					"content": "Şey, daha değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720219
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720219,
					"content": "Ne kadar uğraşırsam uğraşayım, ağı sadece küçük hayvanların özünü oluşturmak için kullanabildim. İnsanlar üzerinde hiçbir etkisi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720220
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720220,
					"content": "Gezgin, bir fikrim var. Ağı yanına al. Belki de seni kullanırken gördüğümde tekrar ilham gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720221
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720221,
					"content": "İşte, bunu yanına al. Ayrıca unutma bu öylesine bir Ağ Topu değil. Bu, Üstün Ağ Topu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720222
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720222,
					"content": "Hadi bakalım. Denemek için git ve birkaç küçük hayvan yakala!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720217,
					"content": "Geliştirmelerin başarılı oldu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720218
					]
				}
			]
		},
		{
			"id": 7267204,
