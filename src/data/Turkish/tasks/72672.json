			},
			"dialogs": [
				{
					"id": 726720101,
					"content": "Ah şu Wakamurasaki... Ona Kageroumaru'dan bahsetmemeliydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720102
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720103
					]
				},
				{
					"id": 726720103,
					"content": "Gezgin, selamlar. Ağ Topunu hatırlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720104
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720104,
					"content": "Geçen seferki olayın ardından olanları arkadaşıma anlattım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720105
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720105,
					"content": "İsmi Wakamurasaki ve şey... \"Tasarımcı\" olduğunu iddia ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720106
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720106,
					"content": "Senin ağı kullanma şeklinden çok etkilenmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720107
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720107,
					"content": "Ağ Topunu geliştirmeye devam etmek için yeni tekniklere ihtiyacı vardı ve yeni teknik bulmasına yardım etmem için bana ısrar ediyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720108
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720108,
					"content": "Zırlamasına daha fazla dayanamayıp eski koleksiyonum arasından yeni bir şey buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720109
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 726720109,
					"content": "İlgini çektiyse yanına bir uğra istersen Gezgin. Yanılmıyorsam yapacağı geliştirmeleri çoktan bitirmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		},
		{
			"id": 7267202,
			"completionStepIds": [
				7267202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
