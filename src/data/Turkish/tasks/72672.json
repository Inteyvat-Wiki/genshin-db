			},
			"dialogs": [
				{
					"id": 726720401,
					"content": "Ee? Nasıl geçti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720402
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720402,
					"content": "Yalnızca bir kere kullanabildim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720403
					]
				},
				{
					"id": 726720403,
					"content": "Hımm... Galiba bu sonuç kaçınılmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720404
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720404,
					"content": "Daha önce de dediğim gibi, bu teknik yalnızca küçük hayvanların özünü yakalayabiliyor. Bu özü saklamak ve hayvanı yeniden oluşturmak için ayrı bir araca ihtiyacın var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720405
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720405,
					"content": "Hem öz saklama cihazı hem de yeniden oluşturma aracı olması için tekniklerin hepsini Ağa ekledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720406
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720406,
					"content": "Bu çok... Karmaşık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726720407
					]
				},
				{
					"id": 726720407,
					"content": "Özetle her ağ bir kez kullanılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720408
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720408,
					"content": "Bu da daha çözümünü bulamadığım bir sorun. Araç sürekli kullanıma dayanamazsa cihazı kullanma maliyeti çok yüksek olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720409
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720409,
					"content": "Ağı araştırmaya devam edeceğim ve en yakın zamanda sorunu çözmeye çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720410
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720410,
					"content": "Üstün Ağ Topuna ihtiyacın olursa istediğin zaman gelebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720411
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720411,
					"content": "Ayrıca... Bu ağlar yalnızca küçük hayvanları yakalıyor olsa da yapması biraz meşakkatli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720412
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720412,
					"content": "Bu nedenle bir dahakine bu ağlardan istersen karşılığında makul bir ücret ödemen gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726720413
					],
					"speakerTitle": "Wakamurasaki"
				},
				{
					"id": 726720413,
					"content": "Rahatla! Sango'nun arkadaşısın senden o kadar da para almam. İyi bir indirim yaparım, söz veriyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Wakamurasaki"
				}
			]
		},
		{
			"id": 7267205,
			"completionStepIds": [
				7267205
			],
