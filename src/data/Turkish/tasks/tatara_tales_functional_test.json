			"dialogs": [
				{
					"id": 721190101,
					"content": "Ah! Gezgin... Durum pek iç açıcı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190102,
					"content": "İçerideki Fatui, güçlerini çekirdeğin etrafında yoğunlaştırdı. Görünüşe bakılırsa bir şey keşfetmiş olmalılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190103,
					"content": "Çekirdeğin savunmasını kıracak halleri yok herhalde... Olmaz, daha fazla bekleyemeyiz. İşlevsellik testlerini başlatmalıyız hemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190104,
					"content": "İşlevsellik testleri mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "Bu makina dostumuzun arındırma yeteneklerini test etmeliyiz yani. Çalıştığına emin olmadan ocağa girmeye niyetim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190106,
					"content": "O yüzden lütfen 3 Hayalet Böcek bulmama yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190107,
					"content": "Onları Mikage Ocağı yakınlarına yerleştirmek istiyorum ki Tatarigami'den etkilensinler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190108,
					"content": "Daha sonra toplayıp arındırmak için bu arıtma cihazını kullanacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190109,
					"content": "Planladığım test bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190110,
					"content": "Bu Hayalet Böceklerini nerede bulabilirim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "Hımm... Normalde fazla Elektrik olan çevrelerde bulunurlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190112,
					"content": "Ayrıca Mikage Ocağı'nın yakınlarında hayatta kalabileceklerini de duydum. Oldukça dirençli canlılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190113,
					"content": "O zaman neden ocaktan birkaç tane almıyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "Yapabilirsin tabii ama test için Hayalet Böcekleri doğrudan Mikage Ocağı'ndan alırsan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190115,
					"content": "Dürüst olmak gerekirse küçük cihazımın güvenilirliği konusunda endişeleniyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190116,
					"content": "Deneylerde adım adım ilerlemek en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190117,
					"content": "Hadi o zaman... Lütfen 3 Hayalet Böcek bulmama yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190118,
					"content": "Bu iş bende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "Aynen öyle. 3 tane bulman yeterli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190120,
					"content": "Ocağın içine ben de bir girip çıkabilirim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "Yani... Evet, test için kendini de kullanabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190122,
					"content": "Daha önce de söylediğim gibi, bu cihazın güvenilirliği beklentileri karşılamayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190123,
					"content": "Arındırma sürecinde gerçekten beklenmeyen bir şey olursa bazı... Öngörülemeyen sorunlarla karşılaşabilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190124,
					"content": "Öhöm. Şimdilik Hayalet Böcek seçeneğiyle ilerleyelim, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721190125,
					"content": "3 tanesi yeterli! Yakaladığın zaman bana getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
