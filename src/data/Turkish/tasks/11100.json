					"Yıldızkapan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111001001,
					"content": "Öhöm! Selam. Kendimizi tanıtalım, bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001002,
					"content": "Lütfen... Niyetiniz teşekkür etmekse hiç gereği yok. Dünyayı kötülükten arındırmak Adeptusların görevi. Lafı bile olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001003
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111001003,
					"content": "Bir dakika, siz kimsiniz? Sizi müritlerimden sandım ama yakından bakınca anlaşılıyor ki hiç karşılaşmamışız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001004,
						111001007
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111001004,
					"content": "Sadece buradan geçen gezginleriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001005
					]
				},
				{
					"id": 111001005,
					"content": "#Bu {NICKNAME}, Paimon'un adı da Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001006,
					"content": "Anlıyorum. Ben de kendimi tanıtmalıyım zira nezaket kuralları bunu gerektirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111001010,
					"content": "Öhöm... Karşınızda duran bendeniz bir Adeptusum. Yıldızların Efendisi. Müritlerim beni daha çok \"Yıldızkapan\" olarak tanıyor tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001011
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111001011,
					"content": "Dağdaki ikamet yerimden dünyayı kötülükten arındırmak için indim ki kader de yollarımızın kesişmesi için burayı uygun görmüş. Şimdi... Ne diliyorsanız söyleyin bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001012
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111001012,
					"content": "Dileklerimiz mi? Paimon, Liyue'deki Adeptusların savaşta gerçekten iyi olduğunu düşünmüştü... İnsanların dileklerini de gerçekleştirebileceğini mi söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001013
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001013,
					"content": "Haha... Adeptusların farklı kademeleri vardır... Nihayetinde yıldızlar; dağlardan, bulutlardan ve aydan da yüce değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001014
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111001014,
					"content": "Yine de, güçleriyle övünmek Adeptuslara yakışmaz. Bana göre esas olan öncelikle müritlerimle konuşup kararınızı öyle vermeniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111001007,
					"content": "Adeptusların izinden ilerliyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111001008
					]
				},
				{
					"id": 111001008,
					"content": "#Bu {NICKNAME}, Paimon'un adı da Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111001009,
					"content": "O halde yollarımızın çakışması yerinde olmuş. Nezaket kuralları gereği ben de kendimi tanıtayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111001010
					],
					"speakerTitle": "Yıldızkapan"
				}
			]
		},
