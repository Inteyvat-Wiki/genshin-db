			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"İnançlı Kadın"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000501,
					"content": "Sonunda umut ve amaç dolu bir hayat...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000502
					],
					"speakerTitle": "İnançlı Kadın"
				},
				{
					"id": 111000502,
					"content": "Yıldızların Efendisi hakkında ne düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000503
					]
				},
				{
					"id": 111000503,
					"content": "Siz de destekçilerinden misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000504
					],
					"speakerTitle": "İnançlı Kadın"
				},
				{
					"id": 111000504,
					"content": "Nişanlım çekip gittikten sonra her gün ağladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000505
					],
					"speakerTitle": "İnançlı Kadın"
				},
				{
					"id": 111000505,
					"content": "Daha sonra, Yıldızların Efendisi'nden yardım istedim. Onun tavsiyesine uyarak nişanlımın resimlerini yakmaya başladım ve gün doğumunda küllerini okyanusa döktüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000506
					],
					"speakerTitle": "İnançlı Kadın"
				},
				{
					"id": 111000506,
					"content": "Bunu açıklayamam... Ama gerçekten de işe yaradı! Tüm kalbimle biliyorum, o bir gün geri dönecek. Pozitif düşünce taktiği falan değil bu, döneceğinden eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000507
					],
					"speakerTitle": "İnançlı Kadın"
				},
				{
					"id": 111000507,
					"content": "Düğün bütçemin bir kısmını Yıldızların Efendisi'ne sunduğum için çok memnunum. Sonuçta o olmasaydı nişanlıma geri kavuşamazdım, öyle bir durumda da parayı ne yapacağım zaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İnançlı Kadın"
				}
			]
		},
		{
			"id": 1110006,
			"completionStepIds": [
				1110006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
