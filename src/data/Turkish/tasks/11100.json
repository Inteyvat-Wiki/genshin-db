			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"İnançlı Adam"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000401,
					"content": "Yıldızların Efendisi'ni dövüşürken gördünüz mü? Gerçekten, gücünü ilahi olandan alıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000402
					],
					"speakerTitle": "İnançlı Adam"
				},
				{
					"id": 111000402,
					"content": "Hasta olan babam için nihayet bir umut olduğuna inanıyorum artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000403
					],
					"speakerTitle": "İnançlı Adam"
				},
				{
					"id": 111000403,
					"content": "Bana Yıldızların Efendisi'nden bahset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000404
					]
				},
				{
					"id": 111000404,
					"content": "Onu büyü yaparken görseniz yeter! Hiç şüphesiz, gerçek bir Adeptus.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000405
					],
					"speakerTitle": "İnançlı Adam"
				},
				{
					"id": 111000405,
					"content": "Çok geçmedi daha, hasta babam için ondan ilaç istemiştim. Sana şöyle diyeyim, Bubu Eczanesindeki ilaçlar ile dünya kadar fark vardı arada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000406
					],
					"speakerTitle": "İnançlı Adam"
				},
				{
					"id": 111000406,
					"content": "Kaynatılıp hazırlandığında uhrevi bir sis çıktı ortaya; çok Adeptusvariydi! Hımm... Tabii içinde Sis Çiçeği olduğu için de olabilir gerçi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000407
					],
					"speakerTitle": "İnançlı Adam"
				},
				{
					"id": 111000407,
					"content": "Adeptusların ilaçları gerçekten en güçlüleri. Babam yakında iyi olacak, adım gibi biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000408
					],
					"speakerTitle": "İnançlı Adam"
				},
				{
					"id": 111000408,
					"content": "Yıldızların Efendisi gibi bir Adeptustan yardım isterken bazı fedakarlıklar yapmak gerekiyor tabii. Ben karşılığında birkaç antikayı vermek zorunda kaldım; sonuçta babamın hayatı birkaç eski yadigardan çok daha değerli, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İnançlı Adam"
				}
			]
		},
		{
			"id": 1110005,
