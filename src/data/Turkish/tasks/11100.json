			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"İnançlı Tüccar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000601,
					"content": "Yıldızların Efendisi buralardayken Taşordu'nun gerçekten mesai yapması gerekmiyor değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000602
					],
					"speakerTitle": "İnançlı Tüccar"
				},
				{
					"id": 111000602,
					"content": "Yıldızların Efendisi hakkında neler biliyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000603
					]
				},
				{
					"id": 111000603,
					"content": "Ben bir tüccarım, son zamanlarda nakledilmesi gereken çok değerli mallarım vardı. Kulağa çok küstahça gelse de Yıldızların Efendisi'ne yol boyunca bana eşlik edip edemeyeceğini sordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000604
					],
					"speakerTitle": "İnançlı Tüccar"
				},
				{
					"id": 111000604,
					"content": "Niye mi? O tılsımını kullanır kullanmaz canavarlar kaçıp gidiyor da ondan. Yolculuk boyunca en ufak sıkıntı dahi yaşamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000605
					],
					"speakerTitle": "İnançlı Tüccar"
				},
				{
					"id": 111000605,
					"content": "Tabii biraz pahalıya patladı... Sonuçta bir Adeptusun hizmetlerinden yararlanmak da azımsanacak bir şey değil, yani Zuhur Ayinini düşünsene! Bu yüzden ben bunu kabul etsem de Liyue'nin dışından gelenlerin çoğunun kabul edeceğini sanmam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İnançlı Tüccar"
				}
			]
		},
		{
			"id": 1110008,
			"completionStepIds": [
				1110008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110008",
							"2"
						],
						"stepId": 1110008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yıldızkapan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111000801,
					"content": "Ne düşünüyorsunuz? Müritlerim durumu biraz abartsalar bile yine de içlerinden geçenleri söylüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000802
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000802,
					"content": "Bana kalırsa biraz uyduruyorlar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000803
					]
				},
				{
					"id": 111000803,
					"content": "Haha... Şaka yapıyorsun herhalde. Bir zamanlar, halkın \"Liangzi\" olarak bildiği Xue Wuliang adında kıdemli bir Adeptus vardı. Dedi ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000804
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000804,
					"content": "\"Her şey birbirine bağlıdır. Fanilerin 'hayal gücü' dediği şey, yalnızca ruhani olanla dünyevi olan arasındaki köprüdür.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000805
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000805,
					"content": "Başka bir deyişle, dilekleri şimdiden gerçekleşme yoluna girdi bile. Şimdi daha açıklayıcı oldu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000806
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000806,
					"content": "Şey... Hayır, aslında çok daha karmaşık bir hale geldi. Aslında demek istediğin dileklerinin gerçekleşebileceği, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000807,
					"content": "Pek tabii. Çok akıllısın minik dostum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000808
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000808,
					"content": "Peki. Şey, bir sorumuz daha var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000809,
					"content": "Öyle mi? Öyleyse sorun bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000810,
						111000811
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000810,
					"content": "Neden maske takıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000814
					]
				},
				{
					"id": 111000814,
					"content": "Fanilerin arasında dolanıyorum, iyilikler yapıp kötülüğü yok ediyorum. Yüce Olan bendeniz, bu diyarda gereğinden fazla soruna yol açmamak adına çehresini açık etmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000815
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000815,
					"content": "Oh, anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000816,
					"content": "Peki öyleyse, dilekleriniz neler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000817,
						111000819,
						111000821
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000817,
					"content": "Kardeşimin nerede olduğunu bilmek istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000818
					]
				},
				{
					"id": 111000818,
					"content": "Hımm... Bu dileğin arkasında trajik bir hikaye yatıyormuş gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000824,
					"content": "Öyle olsun. Bu dilek, benim gerçekleştirme kudretimin ötesinde değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000825
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000825,
					"content": "Ama önce bana olan inancını kanıtlamalısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000826
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000826,
					"content": "Bu da ne demek oluyor şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000827
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000827,
					"content": "Adeptusların yolu yalnızca kelimeler ile anlaşılamaz. Yüce Olan ben, kelimelerin ötesindeki derin gerçekleri aramalıyım... Şayet Yüce Olan'ın ardında yatan gizli anlamı kavrayamazsanız, o zaman ne yazık ki bendeniz size yardımcı olamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000828
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000828,
					"content": "Şimdi ne yapacağız? Paimon dediklerinden hiçbir şey anlamıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000829,
						111000830
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000829,
					"content": "Sanırım cazip bir teklifle gelmemizi istiyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000831,
					"content": "Ah, doğru ya! Şu destekçilerinden bazıları Adeptusa yardımları karşılığında yüksek miktarda ödeme yaptıklarından bahsetmişti değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000832,
					"content": "Paimon'dan tek bir Mora çalışmaz, elimizde yeterince değerli bir de şey yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000833,
					"content": "Önsezin bile yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000834,
						111000835
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000834,
					"content": "Bence önüne gelen herkes Önsezi sahibi olamaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000836,
					"content": "Hey! Neden ona lezzetli bir atıştırmalık hazırlamıyoruz? İyi yemeğin cazibesine kimse karşı koyamaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000837,
						111000838
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000837,
					"content": "Senin gibi düşünen hiç kimse, orası kesin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000839,
					"content": "Aynen, lezzetli bir atıştırmalık kesin işe yarayacak! Hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000840
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000840,
					"content": "Neden Wanwen Kitabevine gidip yeni tarifler olup olmadığına bakmıyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000838,
					"content": "Mmm... İyi fikir!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000839
					]
				},
				{
					"id": 111000835,
					"content": "Başıma kakmana gerek yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000836
					]
				},
				{
					"id": 111000830,
					"content": "Sanırım biraz Mora istiyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000831
					]
				},
				{
					"id": 111000819,
					"content": "Tanrılarınkiyle yarışacak bir güç istiyorum.",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						111000820
					]
				},
				{
					"id": 111000820,
					"content": "Doğrusu, orantılı bir güçle birçok engelin üstesinden gelinebilir. Ama insan merak etmeden duramıyor; tanrılara karşı ne garezin var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000821,
					"content": "Çabucak köşeyi dönmek istiyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000822
					]
				},
				{
					"id": 111000822,
					"content": "#Bekle bir saniye! Peki ya {M#kız kardeşin}{F#erkek kardeşin}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000823,
					"content": "Bu, faniler için sıradan bir duygu. Yani, Liyue'den gelmediğin ilk bakışta belli oluyor ama Yüce Olan ben, onların sizin üzerindeki dünyevi etkilerini sezebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000824
					],
					"speakerTitle": "Yıldızkapan"
				},
				{
					"id": 111000811,
					"content": "Hadi, çıkar şunu, bir bakayım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111000812
					]
				},
				{
					"id": 111000812,
					"content": "Hey! Bu biraz yersiz değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111000813,
					"content": "Hımm... Aslında maskemi çıkarmam yakışık almaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111000814
					],
					"speakerTitle": "Yıldızkapan"
				}
			]
		},
