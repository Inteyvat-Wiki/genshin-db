			"dialogs": [
				{
					"id": 740870201,
					"content": "Araştırmacılar burada mı dinleniyor? Bu insanlığa sığar mı? Fontaine Araştırma Enstitüsü burayı yenilemek için nasıl parmağını bile oynatmaz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870202
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870202,
					"content": "... Burada bir Tetkik Dayanağı olmalı. Bayan Chronie'nin de dediği gibi yenileme çalışması yapılması gerek, güç kaynağı da çok kısıtlı... Hatta hiç güç yok bile denebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870203
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870203,
					"content": "#Ben Bayan Chronie'nin sorularını cevaplayayım. Tetkik Dayanağını alma işi ise sende {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
				}
			]
		},
		{
			"id": 7408703,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
