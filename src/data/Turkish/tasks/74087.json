				"points": []
			},
			"dialogs": [
				{
					"id": 740870301,
					"content": "Koğuşlar diğer bölgelere kıyasla patlamadan daha az etkilendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870302
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870302,
					"content": "Koğuşlar mı? Burada tek bir yatak bile yok. Araştırmacılar nerede dinleniyor? Sandalyede uyumuyorlardır herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870303
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870303,
					"content": "Sizin \"dinlenme\" anlayışınız araştırmacılarınkinden çok daha farklı Bayan Chronie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870304
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870304,
					"content": "Bir Fontaine Araştırma Enstitüsü araştırmacısının dinlenmesi gerekiyorsa bu sadece kısa bir süreliğine zihnini boşaltmak istediği içindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870305
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870305,
					"content": "Buraya gelip piyano çalar, kitap okur ve bir şeyler içer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870306
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870306,
					"content": "Şey, zihni en iyi dinlendiren şey uyku değil mi ama?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870307
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870307,
					"content": "Bu doğru olabilir ama... Bizim araştırmacılarımız uykuya zaman kaybı gözüyle bakar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870308
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870308,
					"content": "Uyku zaman kaybı mı? Hayır, uyku zihnin en iyi ilacıdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870309
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870309,
					"content": "Uyku sırasında zihin çalışmayı bırakır ve araştırmalar bölünür, bu kesinlikle uygun bulduğumuz bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870310,
						740870311
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870310,
					"content": "(Dinlemeye devam et...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740870312
					]
				},
				{
					"id": 740870312,
					"content": "Ciddi misin? Ama uyumadan çalışırsanız araştırmalarınız değil, hayatınız bölünür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870313
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870313,
					"content": "Hayır. Enstitüde araştırmacılara en iyi şekilde sağlık hizmeti sağlayan muhteşem bir sağlık sistemi mevcut.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870314
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870314,
					"content": "Bu uyumamaya bahane olamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870315
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870315,
					"content": "Araştırmacılar zihinlerini söylediğiniz şekilde dinlendirirse araştırma sırasında ortaya çıkan düşünce süreçleri, tıpkı uykuda olduğu gibi bölünmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870316
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870316,
					"content": "Hayır. Ara verdiklerinde bilinçaltlarında araştırmalarını düşünmeye devam ediyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870317
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870317,
					"content": "Tıpkı bir okyanus gibi. Dışarıdan bakınca durgun olsalar da derinlerde güçlü akıntılar akmaya devam eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870318
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870318,
					"content": "Bazen derinlerdeki akıntılar, kule gibi dev dalgalardan daha kuvvetlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870319
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870319,
					"content": "Anlıyorum. Fontaine Araştırma Enstitüsü araştırmacıları bir proje üstünde çalıştıklarında araştırma bitene kadar dinlenmelerine izin vermiyorsunuz, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870320
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870320,
					"content": "Pek doğru bir tespit değil. Uykuya çok ihtiyaçları olduğunda evlerine dönüp uyuyabiliyorlar tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870321
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870321,
					"content": "Yani Fontaine Araştırma Enstitüsü araştırmacıları, Enstitünün içindeyken bir proje üstünde çalışıyorlarsa araştırma bitene kadar dinlenmelerine izin vermiyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740870322
					],
					"speakerTitle": "Chronie"
				},
				{
					"id": 740870322,
					"content": "İfade yeteneğinize hayran kaldım Bayan Chronie.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nacker"
				},
				{
					"id": 740870311,
					"content": "(Dinlemeyi bırak...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}