				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 750010801,
					"content": "Vay. Ben de buraya gelip duyduğum o korkunç sesler neymiş bir kontrol edeyim diyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010802
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010802,
					"content": "Kendi kendime \"Yapma Titu, muhtemelen bir şey değildir.\" dedim... Ama gerçekten bir şey varmış, hem de inanılmaz bir şey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010803
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010803,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010804
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010804,
					"content": "Küçük bir Tepetlizorumuz da varmış hatta... Bu yabancıları buraya getiren sen miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010805
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010805,
					"content": "Peki... Bu Gölge İğnesini düşüren siz miydiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010806,
						750010809
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010806,
					"content": "Yapmamamız mı gerekiyordu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010807
					]
				},
				{
					"id": 750010807,
					"content": "#Hı? Bir dakika, yanlış bir şey mi yaptık {NICKNAME}? Eğer hızlı davranırsak hazır sadece tek bir tanık varken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010808,
					"content": "#Haha, hadi ama yapma! Ciddi bir şey değil ve aslında bize bir iyilik yapmış oldunuz! Demek {NICKNAME} sensin. Arkadaşın kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010813
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010813,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010814
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010814,
					"content": "#Bu da {REALNAME[ID(2)|SHOWHOST(true)]}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010815
					]
				},
				{
					"id": 750010815,
					"content": "Benim adım da Titu. Kabilemizde hikayeleri {RUBY#[D]Hikayeci}ben anlatırım. Ayrıca bu vadideki taş sütunlardan da ben sorumluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010816
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010816,
					"content": "Ve bu yere çaktığınız Gölge İğnesi de benim sorumluluğumda olan üç küçük İğneden biriydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010817
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010817,
					"content": "S-Sorumluluk... Eyvah, taş sütunu yere düşürdüğümüz için yerlilere tazminat ödememiz gerekecek galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010818
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010818,
					"content": "Ah, Paimon bilseydi gerçek adımızı kullanmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010819,
					"content": "Tazminat... \"Titu'nun aklında bir şimşek çaktı. Belki de bu durumu kullanarak bu insanları sıkıştırabilir ve kendi hedeflerine ulaşması için ona yardımcı olmalarını sağlayabilirdi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010820
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010820,
					"content": "En azından olay örgüsüne böyle bir kısım eklerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010821
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010821,
					"content": "Hım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010822
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010822,
					"content": "Pardon, hikaye düşünürken dalıp gitmişim. Kabilemizde hikaye{RUBY#[D]Hikayeci} anlatmaktan sorumluyum ben. Bunca yılın ardından artık özgün yeni hikayeler bulmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010823
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010823,
					"content": "Ve tabii ki ben birkaç gündür bunları düşünürken Gölge İğnesiyle ilgili bir sorun çıkıverdi... Çünkü geldi mi her şey üst üste gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010824
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010824,
					"content": "Öhöm! Neyse, size şantaj yapacak değilim. Y-Yani durum böyle olsaydı düşüncelerimi dile getirmezdim, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010825
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010825,
					"content": "Tanıştık ettik ve bir kavgamız da olmadı. Yani arkadaş olduğumuzu söyleyebiliriz, ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010826
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010826,
					"content": "Öyleyse... Arkadaşınızın bir isteğini yerine getirebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010827
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010827,
					"content": "Tabii... Ödeme yapmamız gerekmediği sürece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010828
					]
				},
				{
					"id": 750010828,
					"content": "Yok, yok, kesinlikle yok! Hımm, nasıl desem? Vadiden geçerken üzerinde altın desenler olan devasa bir Katı Filojiston bloku gördünüz mü hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010829
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010829,
					"content": "Buranın tam ortasında yer alıyor aslında. Kaçırmış olmanızın imkanı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010830,
						750010831
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010830,
					"content": "Biraz tanıdık geldi ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010833
					]
				},
				{
					"id": 750010833,
					"content": "Bahsettiğim olay o büyük taş sütunla alakalı. Biz buna Gölge İğnesi diyoruz... Ve son zamanlarda bununla ilgili bazı sorunlar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010834
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010834,
					"content": "Açıkçası sizinle tanışmadan önce neredeyse pes etmiştim. \"Gölge İğneleri kurtarılamadı ve kabileyi korkunç bir felakete mahkum etti.\" diye cümlemi de hazırlamıştım... Çok da kötü değildi bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010835
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010835,
					"content": "Bir dakika, bu sadece taş bir sütun. Kabileyi nasıl yok edebilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010836
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010836,
					"content": "Ayrıca bu \"Gölge İğnelerinin\" nesi bu kadar özel? Düşürdüğümüz de... Küçük bir iğne miydi? Paimon'a epey büyük geldi aslında, neden öyle deniyor ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010837,
					"content": "Hım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010838
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010838,
					"content": "Hım... İkiniz de yabancı olduğunuz için biraz daha ayrıntılı açıklamak gerekir sanırım. Bu, bizim kabilemizde nesilden nesile aktarılan bir efsaneyle ilgili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010839
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010839,
					"content": "Hikayelere göre Wayob, İğneleri buraya, Yanardağ Lordu'nun gölgesini mühürlemek için asmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010840
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010840,
					"content": "Ancak mühürledikleri şey aslında Hiçlik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010841
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010841,
					"content": "Natlan'da çoğu hikaye böyledir. Genelde uyarı mahiyetinde mecazlarla ve benzetmelerle dolu olurlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010842
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010842,
					"content": "Bir dakika, yani Hiçlik gerçekten yerin altında mühürlü mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010843
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010843,
					"content": "Evet. Yakın zamanda üç küçük Gölge İğnesinden ikisi yukarıya doğru süzülüp gitti. Üçüncüsü de giderse yerin altındaki tüm kötülük coşkun dalgalar gibi yukarı çıkacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010844
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010844,
					"content": "Açıkçası İğnelerden birini tekrar yerine koyarak bize beklenmedik bir iyilik yaptınız. O yüzden herhangi bir ödemeye gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010845
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010845,
					"content": "Aslında diğerini de düzeltebilir misiniz diye rica edecektim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010846
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010846,
					"content": "#Hım... Ne düşünüyorsun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010847,
						750010848
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010847,
					"content": "... Hiçlik işin içindeyse öylece duramayız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010849,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010850
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750010850,
					"content": "#Sen de destekliyorsun sanki {REALNAME[ID(2)|SHOWHOST(true)]}. Pekala, tamam o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010851
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010851,
					"content": "Ah, karanlıkta parlayan bir alev gibi, büyük tehlike zamanlarında çıkar kahramanlar ortaya. İnsanlar neler yapabileceklerini de hep böyle anlarda gösterir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010852
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010852,
					"content": "#Biliyor musunuz? Bu harika bir hikaye olabilir. Aslında {NICKNAME}, sen hikayelerdeki kahramanların bile sahip olmadığı bazı özelliklere sahipsin. Buna tanık olmayı dört gözle bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010853
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010853,
					"content": "Hadi gidelim o halde sevgili kahramanlar. Gidip son süzülen İğneyi kontrol edelim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010848,
					"content": "Belki yardım edebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010849
					]
				},
				{
					"id": 750010831,
					"content": "Yok, hatırlayamadım öyle bir şey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010832
					]
				},
				{
					"id": 750010832,
					"content": "Hım. Yeterince barizdi bence ama neyse, sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010833
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010809,
					"content": "Paimon yaptı. Ben sadece buraya doğru yürüyordum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010810
					]
				},
				{
					"id": 750010810,
					"content": "Hey! Hep de böyle yapıyorsun! Şunu kesmezsen Paimon sinirlenecek bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750010811,
					"content": "Haha, sorun yok. Bunu görmek aslında beni rahatlattı. Demek senin adın Paimon. Peki arkadaşının adı ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750010812
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750010812,
					"content": "#Bana {NICKNAME} diyebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750010813
					]
				}
			]
		}
	]
}