			"dialogs": [
				{
					"id": 750013201,
					"content": "İşe yaradığına inanamıyorum. Bu cidden bir hikayeden ya da şarkıdan bir sahne gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013202
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013202,
					"content": "Tüm kargaşa sona erdi... İğne asıl haline geri döndü ve o kocaman gövdesi resmen yere çakıldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013203
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013203,
					"content": "Vay be... Birinin bunu gerçekten başarabilmiş olması... Rüyada falan değilim, değil mi? Hepiniz gerçeksiniz, değil mi? Hayal gücümün bir ürünü değil yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013204
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013204,
					"content": "Uyan, uyan... Bu sorunu kendin çözmelisin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013205
					]
				},
				{
					"id": 750013205,
					"content": "Hey, bu kadar kaba olmaya gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013206,
					"content": "#Paimon sana dememiş miydi {NICKNAME} çok güçlüdür diye?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013207,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013208
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013208,
					"content": "#Hehe sence de öyle, değil mi {REALNAME[ID(2)|SHOWHOST(true)]}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013209,
					"content": "#Hiçlikten etkilenmedin, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013210,
						750013211
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013210,
					"content": "Sorun yok, sadece Hiçlik işte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				},
				{
					"id": 750013212,
					"content": "#En güçlü savaşçılarımız bile Hiçlik karşısında hep temkinli olmalıdır. Sen kesinlikle sıradan biri değilsin {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013213
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013213,
					"content": "Haha, kim bilir, bir bakarsın bu konuyla ilgili yazacağım hikaye Sanhaj'ınkileri sollayıp geçmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013214
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013214,
					"content": "Arrr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013215
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013215,
					"content": "Kulağa etkileyici geliyor ama Sanhaj kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013216,
					"content": "Haha, \"kabilelerinde hikaye anlatanlar\" söz konusu olduğunda Gece Rüzgarının Ustalarından Sanhaj gerçekten saygıyı hak edenlerden biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013217
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013217,
					"content": "Ancak zamanımız kısıtlı ne yazık ki. Daha fazla vaktimiz olduğunda size Sanhaj'dan bahsederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013218
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013218,
					"content": "Tamam o zaman. Hadi sonraki Gölge İğnesine gidelim. Bu sorunu hemen halledip akşam yazmaya başlamak istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013219
					],
					"speakerTitle": "Titu"
				},
				{
					"id": 750013219,
					"content": "Yaşasın! Hadi gidelim, gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750013220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750013220,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750013211,
					"content": "Şu anda iyiyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750013212
					]
				}
			]
		},
		{
			"id": 7505704,
			"completionStepIds": [
				7505702
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
