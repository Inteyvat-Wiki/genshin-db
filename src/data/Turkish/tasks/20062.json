			"dialogs": [
				{
					"id": 200620601,
					"content": "Vay be, bu tahta hedef gayet güzel. Daha rahat idman yapabileceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620602
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620602,
					"content": "Babamın bu kadar sağlam bir talim hedefini nereden bulduğunu bir türlü aklım almıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620603
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620603,
					"content": "Satın almış olamaz, değil mi? Çok pahalıdır bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
