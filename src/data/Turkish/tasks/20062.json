					"Herman"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200620101,
					"content": "Ne yapmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620102
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620103
					]
				},
				{
					"id": 200620103,
					"content": "Sadece... Kızım Ellin, Favonius Şövalyelerine katılmayı kafasına koydu. Şimdi denemelere hazırlanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620104
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620104,
					"content": "*iç çeker* Ona yol göstermeyi çok isterdim ama eskiden bir maceracı olduğumu söylediğimde bana inanmıyor. Tek başına idman yapmak istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620105
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620105,
					"content": "Kanıtlamak için yapabileceğim bir şey de yok... Evlenip çocuk sahibi olunca düşüncesizce ve bencilce davranıp bu tehlikeli maceralara devam edemiyorsun işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620106
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620106,
					"content": "Aileme karşı sorumluluklarım, maceralarımda yaşayacağım özgüven patlamasından daha önemli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620107
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620107,
					"content": "Yine de maceracı ruhum henüz ölmedi, hâlâ birkaç şey bildiğime eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620108
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620108,
					"content": "Eskiden bir maceraya çıktığımda dağ yabanilerinin savaş eğitimlerinde kullandıkları tahta hedefleri görmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620109
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620109,
					"content": "Sağlam duruyorlardı, Ellin'in idmanı için mükemmel olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620110
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620110,
					"content": "Benim için gidip dağ yabanilerinin kullandığı talim hedeflerinden birkaç tane toplayabilir misin? Elbette maceracı kuralını unutmadım, yani karşılığını alacaksın. Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620111,
						200620112
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620111,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620113
					]
				},
				{
					"id": 200620113,
					"content": "İşte böyle! Loncaya ilk katıldığımda ben de aynı senin gibi her işi alırdım! Her işi derken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620114
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620114,
					"content": "Öhöm. Şaka yapıyorum tabii ki! Hadisene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620112,
					"content": "Dağ yabanisi onlar, halledersin sen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620115
					]
				},
				{
					"id": 200620115,
					"content": "Cidden yapamam. Maceracıların da sınırları vardır. Yani tek seferde üstesinden gelebileceğin macera sayısı bellidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620116
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620116,
					"content": "Kim olursan ol, evlilik hayatı başlı başına büyük bir macera olduğundan maceraya doymuş oluyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620117
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620117,
					"content": "Bu sebeple dağ yabanilerini sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
		{
			"id": 2006202,
			"completionStepIds": [
				2006204
