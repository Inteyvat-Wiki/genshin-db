			"dialogs": [
				{
					"id": 200620301,
					"content": "Talim hedeflerini bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620302
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620302,
					"content": "Evet de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620303
					]
				},
				{
					"id": 200620303,
					"content": "Vay be... Çok güç kullanmış gibisin. Bu kadar sağlam bir düzeneği kırmayı nasıl başardın bilemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620304
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620304,
					"content": "Sanırım savaşın ortasında kimse birkaç tahta çubuğa vurmaktan çekinmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620305
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620305,
					"content": "Bu haliyle Ellin'e veremem ama ağacın kalitesi iyi, biraz üzerinde çalışsam iş görür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620306
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620306,
					"content": "Kolay olmasa da tamir etmeyi başardım. İş görür, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620307
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620307,
					"content": "İyilikleri karşılıksız bırakmayı sevmem. Söz verdiğim gibi işte ödemen. Sonuçta sayende oldu tüm bunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620308
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620308,
					"content": "Maceracılığı bırakabilirsin ama maceracı kuralına her zaman sadık kalmalısın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
