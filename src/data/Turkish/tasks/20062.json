			"dialogs": [
				{
					"id": 200620401,
					"content": "Tahta hedefleri bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620402
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620402,
					"content": "Henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620403
					]
				},
				{
					"id": 200620403,
					"content": "Ellin uzakta idman yapmakla meşgul, onun için elimden bu kadarı gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620404
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620404,
					"content": "Hâlâ bir maceracı olsaydım bunu kendim yapardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620405
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620405,
					"content": "Mondstadt Maceracılar Loncasının mevcut durumuna bakarsak eski maceracı arkadaşlarımın çoğu da emekliliğe ayrıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620406
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620406,
					"content": "Yani yapacak bir şey yok. Tüm ilgi Favonius Şövalyelerinin üzerinde, bütün gençler şövalye olmak istiyor. Maceracı olarak doğanın zorlu yaşamına tek başına göğüs germen gerektiğini düşününce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620407
					],
					"speakerTitle": "Herman"
				},
				{
					"id": 200620407,
					"content": "Artık kimseye hitap etmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Herman"
				}
			]
		},
