			"dialogs": [
				{
					"id": 200620501,
					"content": "Hımm, antrenman için en iyi yöntem nedir acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620502
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620502,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200620503
					]
				},
				{
					"id": 200620503,
					"content": "Favonius Şövalyeleri denemeleri için hazırlanıyorum. Ancak bir türlü beceremiyorum ve bana öğretecek bir tanıdığım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620504
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620504,
					"content": "Babam eski bir maceracı olduğunu ve akıl hocam olmak istediğini söyleyip duruyor. Ben de yedim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620505
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620505,
					"content": "Babam gibi biri Favonius Şövalyeleri denemesini geçmeme yardım edemez, imkanı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200620506
					],
					"speakerTitle": "Ellin"
				},
				{
					"id": 200620506,
					"content": "Bir de bana eğitim ekipmanı tarzı bir şey getireceğini söyledi. Aklından ne geçiyor hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ellin"
				}
			]
		},
