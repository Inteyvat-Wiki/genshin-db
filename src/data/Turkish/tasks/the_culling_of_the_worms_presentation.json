			"dialogs": [
				{
					"id": 735180101,
					"content": "Yükleme ünitesi daha sorunsuz şekilde çalışıyor... Dediğin gibi bu bölgedeki element ortamı normale dönüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180102,
					"content": "... Biraz zaman geçsin, etkilenen Solucanların hareketliliği de azalacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180103,
					"content": "Evet... Kıymetli Solucanezen Topun sayesinde başarımızı rapor edip evimize dönebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180104
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180104,
					"content": "Bizim kıymetli Solucanezen Topumuz, Shriya. Bu görevin ortak çalışmamız olduğunu hiç aklımdan çıkarmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180105,
					"content": "Evet, anlaşmazlıklarımız oluyor ancak sen olmadan bunu asla başaramazdık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180106,
					"content": "Sana ne oldu? Raporumda senden iyi bahsetmem için mi böyle davranıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180107,
					"content": "Şey birden, az önce olanların geçen yılki yaşadıklarımıza ne kadar çok benzediğini fark ettim. Çok fazla zorluk vardı ama en sonunda başarmıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180108,
					"content": "Ve şunu da açıklığa kavuşturalım, en sonunda senin çözümünün daha işe yarar olduğu kanıtlanmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180109
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180109,
					"content": "Ben... Şey... Tek başıma tüm övgüyü üstlenemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180110
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180110,
					"content": "... Çünkü sen de bir şeylerle uğraşıyordun. Eğer Solucanezen Topunu test etmeseydin gerekli verilere ulaşamazdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180111
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180111,
					"content": "\"Bir makinayı tamir etmek için belki de tek gereken şey bir dişlinin yerini değiştirmektir ama asıl olay o dişliyi bulmaktır...\" Hocamın bu sözleri şimdi mantıklı gelmeye başlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180112,
					"content": "Burada olduğun için çok mutluyum Shriya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180113
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180113,
					"content": "Ah... Ben de senin burada olmandan mutluyum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180114
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180114,
					"content": "Ha? Bu ikisinin arası bir anda nasıl düzeldi böyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180115,
						735180116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735180115,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735180117
					]
				},
				{
					"id": 735180117,
					"content": "Öhöm! Mezuniyet projemize yeni başladığımız zamanlarda ilişkimiz oldukça zorluydu çünkü henüz yeterince olgun değildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180118
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180118,
					"content": "Evet. Geriye dönüp bakınca o kadar da ciddi bir şey yoktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180119
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735180119,
					"content": "Şey... Bir dahakine kafede buluşup bir şeyler içelim mi? Raporu nasıl yazacağımızı konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735180116,
					"content": "Boş ver şimdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735180117
					]
				}
			]
		}
	]
}