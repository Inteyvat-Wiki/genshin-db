			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Basima"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735280101,
					"content": "Ey Gezginler, Amurta araştırmacısı Basima olarak sizlerden böyle aceleyle gitmemenizi istirham ediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280102
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280102,
					"content": "Lütfen. Bedenlerinizi gevşetin, zihinlerinizi boşaltın, dikkatle dinleyin çünkü sizlere çok önemli bir şey söyleyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280103
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280103,
					"content": "Serçeler kadar sevimlisi yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280104
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280104,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280105,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280106
					]
				},
				{
					"id": 735280106,
					"content": "Serçeler gerçekten sevimli, evet... Ama Basima Hanım, siz bir araştırmacısınız, değil mi? Detay vermeden böyle şeyler söylemenin ciddi tartışmalara yol açacağını biliyorsunuzdur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280107,
					"content": "Paimon alimlerin daha dikkatli konuşması gerektiğini düşünüyor. Paimon bir araştırmacı olsaydı asla \"Altın Karides Köftesi en lezzetli yemektir!\" gibi bir cümle söylemezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280108,
					"content": "Paimon önermesini detaylandırırdı! \"Son zamanlarda Paimon'un Liyue mutfağından yediği yemekler arasında bu en sevdiği.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280109,
						735280110,
						735280111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280109,
					"content": "Ancak ne olursa olsun bunu söylemeye hazırım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280112,
					"content": "#Ne... {NICKNAME}, bu gerçekten beklenmedik bir şeydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280113,
					"content": "Şaka olmasa bile bu kadar yüksek sesle söylememelisin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280114,
					"content": "Hahaha, işte budur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280115
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280115,
					"content": "İşte tam da bir araştırmacı olduğum için tüm hayatımı böyle akademik tartışmalarla, ağzımdan çıkan her sözün doğruluğu konusunda sürekli endişelenerek geçirmek istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280116
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280116,
					"content": "Sonuçta ben sürekli gözetim altında falan değilim ki! Düşünmeden konuştuğum için cezalandırılacak halim yok ya! Neden sürekli bir korku içinde yaşayayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280117
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280117,
					"content": "Cesur olmalı ve kalplerimizdeki en baskın duyguları elimizden geldiğince tüm dünyaya haykırmalıyız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280118
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280118,
					"content": "Eminim \"Bam Güm Serçe Topu\" oyunumu oynadıktan sonra bir an bile düşünmeden \"Serçeler kadar sevimlisi yok\" diye haykıracaksınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280119
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280119,
					"content": "Bam Güm... Serçe Topu mu? Yani şu arkandaki masanın üstünde duranlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280120,
					"content": "Evet, bir kez oynadıktan sonra serçelerin ne kadar şirin olduğunu kendiniz de göreceksiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280121
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280121,
					"content": "Ayrıca burası Veluriyam Serabı'nın resmi bir eğlence merkezi olduğu için puanınıza göre ödüller kazanacaksınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280122
					],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280122,
					"content": "Ne kadar dramatik konuştu... Ama işe yaradı! Paimon çok merak ediyor. Hem oynadığımız için ödül de alacakmışız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280123,
					"content": "#Ne dersin {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280124,
						735280125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735280124,
					"content": "Deneyelim bakalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280126,
					"content": "Hahaha, işte bu! İyi eğlenceler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Basima"
				},
				{
					"id": 735280125,
					"content": "Bakalım şu serçeler ne kadar sevimliymiş!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280110,
					"content": "Paimon kadar sevimlisi yok!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280111,
					"content": "Nokta!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				}
			]
		}
	]
}