			"trigger": {
				"objectNames": [
					"Paimon",
					"Alphonso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800101,
					"content": "(Vimara Köyü'ndeki \"kötü insan\"ın kim olduğunu ortaya çıkaralım.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800102
					]
				},
				{
					"id": 730800102,
					"content": "Selam Alphonso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800103,
					"content": "#Siz miydiniz? {NICKNAME}, sana nasıl yardımcı olabilirim? Rana'yı arıyorsan o çoktan gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800104
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800104,
					"content": "Seninle bir konuda konuşmak istiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800105
					]
				},
				{
					"id": 730800105,
					"content": "Vimara Köyü'nde saklanan şu \"kötü insan\" hakkında.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800106
					]
				},
				{
					"id": 730800106,
					"content": "#Ne de olsa Rana, ancak {NICKNAME} ona şu kötü insanla ilgileneceğine dair söz verince gönül rahatlığıyla yolculuğa çıkabildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800107,
					"content": "Evet, şimdi anlıyorum. Hiçbir fikrim olmasa da istediğinizi sorabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800108
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800108,
					"content": "İlk olarak yaşananların üzerinden geçelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800109
					]
				},
				{
					"id": 730800109,
					"content": "Vimara Köyü'nde kaybolan ilk çocuk kimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800110,
						730800111,
						730800113,
						730800116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800110,
					"content": "Sudabeh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800119
					]
				},
				{
					"id": 730800119,
					"content": "Paimon şimdi hatırladı, Sudabeh! Amadhiah'ın gözlerine iyi gelebilecek bitkiler olduğunu duyup gizlice ormana gitmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800120,
					"content": "Doğru. Bu olay yaşandığında hepimiz endişelenip bir arama ekibi kurmuştuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800121
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800121,
					"content": "Paimon şimdi hatırladı! Rana, arama ekibini senin ayarladığını ve yanında da köri getirdiğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800122,
					"content": "Bitkiden Sudabeh'e bahseden kimdi peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800123
					]
				},
				{
					"id": 730800123,
					"content": "... Bendim. Sudabeh, Amadhiah'a değer veren iyi bir çocuk. Bir gün bundan bahsettiğimi hatırlıyorum ama ona...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800124
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800124,
					"content": "Evet, Paimon biliyor! Ona ormanda tek başına dolaşmamasını da söylemişsin. Fakat Sudabeh, Amadhiah'a gerçekten önem veriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800125,
					"content": "Başka sorunuz var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800126
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800126,
					"content": "Kaybolan ikinci çocuk kimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800127,
						730800128,
						730800130,
						730800132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800127,
					"content": "Kavus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800135
					]
				},
				{
					"id": 730800135,
					"content": "Kavus... O, kayıp kız kardeşi ile ilgili bir \"arkadaşı\"nı görmek için ormana gittiğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800136
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800136,
					"content": "Evet, öyle demişti! Kavus'un arkadaşı kimmiş, biliyor musun Alphonso?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800137,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800138
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800138,
					"content": "Nereden bileyim? Ormanda ne Kavus'u ne de arkadaşını bulabildim. Bildiğiniz gibi o da hiçbir şey hatırlamayarak geri döndü, aynı Sudabeh gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800139
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800139,
					"content": "Başka sorunuz var mı? Ondan sonra başka bir çocuk kaybolmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800140
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800140,
					"content": "Bu iş sende Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800141
					]
				},
				{
					"id": 730800141,
					"content": "Tamam. Öhöm... Şey, ondan sonra tam Iotham kaybolacakken Rana ve bizimle karşılaştı ve biz de onu geri getirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800142,
					"content": "Tam olarak nasıl oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800143
					]
				},
				{
					"id": 730800143,
					"content": "Dediğine göre Alphonso'nun bir mağaradaki kocaman mantarlardan bahsettiğini duymuş ve Rana için bunlardan biraz toplamak istemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800144,
					"content": "Sonrasında Fatui onu takip etmiş. O da korkuyla kaçmış ama Solduran Bölgeye yakalanmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800145,
					"content": "Ne, Solduran Bölgeye mi yakalanmış? Nasıl olur da bunu bana söylemez? İnanamıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800146
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800146,
					"content": "Bir saniye, eğer o Solduran Bölgeye yakalandıysa geri nasıl dönebilmiş? Önsezi olmadan elementlerde ustalaşabileceğini biliyorum, ama bu biraz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800147
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800147,
					"content": "(Alphonso'ya Arana'dan bahsetmeli miyiz?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800148,
						730800149
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800148,
					"content": "(Sorun olmaz.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800150,
					"content": "Alphonso, biliyorum buna inanması zor ama ormanda Aranara denen periler var. Iotham ve grup onlarla arkadaş, bu yüzden Aranaralar ona yardım etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800151,
					"content": "Aranara mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800152
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800152,
					"content": "Ama çocukların peşine düşmek... Şu Fatui çok alçak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800153,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800154
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800154,
					"content": "Vimara Köyü'nde saklanan şu kötü insanın kim olduğunu hâlâ bilmiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800155,
					"content": "Sanırım şuradan biri bizi izliyor Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800156
					]
				},
				{
					"id": 730800156,
					"content": "Nerede? Ya aradığımız kötü adam oysa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800157,
					"content": "Git de bir bak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800158
					]
				},
				{
					"id": 730800158,
					"content": "Paimon yalnız mı gitsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800159,
						730800160
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800159,
					"content": "Başın belaya girerse bağır, hemen gelirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800161,
					"content": "#Tamam. Her şeyi {NICKNAME} yapacak değil ya. Paimon'a güvenin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800162,
					"content": "Paimon heyecanlı bir şekilde ayrılır.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730800163
					]
				},
				{
					"id": 730800163,
					"content": "Neden uğraşıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800164,
						730800165
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800164,
					"content": "Öğrenirse üzülür.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800166,
					"content": "Hadi başka bir yerde konuşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800165,
					"content": "Bazı şeyleri söylemeye gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800166
					]
				},
				{
					"id": 730800160,
					"content": "Küçüksün ve uçabiliyorsun. Gizlice izlemek için harika özellikler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800161
					]
				},
				{
					"id": 730800149,
					"content": "(Bilmesi gerekiyor.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800150
					]
				},
				{
					"id": 730800128,
					"content": "Sudabeh.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800129
					]
				},
				{
					"id": 730800129,
					"content": "Hayır, hayır. Az önce Sudabeh'ten konuşmadık mı zaten? Paimon kaybolanın onun abisi olduğunu hatırlıyor... Kavus'tu, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800130,
					"content": "Iotham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800131
					]
				},
				{
					"id": 730800131,
					"content": "Paimon bunun doğru olduğunu düşünmüyor. Iotham'ı kaybolduğunda kurtaran bizdik. İkinci çocuk Sudabeh'in abisi Kavus olmalı. Yanılıyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800132,
					"content": "Changchang.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800133
					]
				},
				{
					"id": 730800133,
					"content": "Changchang ta Liyue'de! Bunun Changchang ile ne ilgisi var şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800134,
					"content": "#İyi misin {NICKNAME}? Paimon hatırladı. İkinci çocuk Sudabeh'in abisi Kavus değil miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800111,
					"content": "Kavus.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800112
					]
				},
				{
					"id": 730800112,
					"content": "Sudabeh olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800113,
					"content": "Iotham.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800114
					]
				},
				{
					"id": 730800114,
					"content": "Hayır, Iotham kaybolan son çocuktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800115,
					"content": "Sudabeh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800116,
					"content": "Timmie.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800117
					]
				},
				{
					"id": 730800117,
					"content": "Timmie mi? Hayır, bunun Timmie ile ne alakası var! O Mondstadt'ta değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730800118,
					"content": "Timmie kim? İlk kaybolan çocuk Sudabeh olmalı, yanılıyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800119
					],
					"speakerTitle": "Alphonso"
				}
			]
		},
		{
			"id": 7308002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7308002",
							"2"
						],
						"stepId": 7308002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Alphonso"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730800201,
					"content": "Benden şüphelenmeye ne zaman başladın? Hem Sudabeh, hem de Iotham benden bahsettiği için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800202
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800202,
					"content": "Adımı biliyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800203
					]
				},
				{
					"id": 730800203,
					"content": "Ama Rana sana adımı hiç söylememişti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800204
					]
				},
				{
					"id": 730800204,
					"content": "Belki de duyma hissim o kadar gelişmiş ki Rana seni Amadhiah'a tanıtırken işittim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800205
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800205,
					"content": "Amadhiah'a da adımı söylememişti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800206
					]
				},
				{
					"id": 730800206,
					"content": "Ne kadar dikkatsizim. Fatui dışında Maceracılar Loncasının da gelişmiş bir ağı var, neden bir maceracı olduğumu düşünmedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800207,
						730800210
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800207,
					"content": "Beni oldukça iyi tanıyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800208
					]
				},
				{
					"id": 730800208,
					"content": "Önsezim olmadan elementleri kontrol edebildiğimi biliyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800209
					]
				},
				{
					"id": 730800209,
					"content": "Maceraların oldukça ünlü. Bunu bilmek için bir Fatui olmama gerek yok. Söylemeye çalıştığım onlardan biri olduğumu kanıtlayacak sağlam bir kanıtın yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800212
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800212,
					"content": "Doğru ama bunun bir önemi yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800213
					]
				},
				{
					"id": 730800213,
					"content": "Haklısın. Yalnızca mahkeme kanıt ister, öte yandan hevesli bir tazının avını takip etmesi için hafif bir koku yeterlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800214
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800214,
					"content": "Elbette zeki bir tazı hangi kokunun peşinden gitmeyeceğini bilir. Takibin sonunda bir ejderhayla karşılaşmak istemez. Ama geçmişine bakılırsa sen pes edecek tarzda biri değilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800215
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800215,
					"content": "Rana'ya ormanda devriye gezmemesini söyledin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800216
					]
				},
				{
					"id": 730800216,
					"content": "Çünkü onun Fatui'ye bulaşmasını istemiyordun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800217
					]
				},
				{
					"id": 730800217,
					"content": "Bir kısmı doğru ama asıl amacım onun zarar görmemesiydi. Diğer Fatui üyeleri benim gibi değildir. Ona veya Vimara Köyü'ne karşı bir şey hissetmezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800218
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800218,
					"content": "Gerçekte kimsin sen \"Alphonso\"?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800219
					]
				},
				{
					"id": 730800219,
					"content": "Doğduğumda bana verilen ismi çoktan herkes unuttu. Taş Yuva'da bana Trofin Snezhevich denilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800220
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800220,
					"content": "Taş Yuva'dan Trofin Snezhevich...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800221
					]
				},
				{
					"id": 730800221,
					"content": "Tepkine bakılırsa \"erkek ve kız kardeşlerimle\" karşılaşmış olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800222
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800222,
					"content": "Sana kimliklerini açıkladılarsa, kiminle karşılaştığını veya onların statüsünü sakın bana söyleme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800223
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800223,
					"content": "Onların halen hayatta olduğunu düşünürsek, o zaman Majestelerine ihanet etmişler demektir. Fakat eğer öldülerse de... Devamını bilmek istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800224
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800224,
					"content": "Taş Yuva, \"Yaver\" tarafından kurulmuş bir yuva. Bu yuvada büyüyen çocuklar akraba değil ama aramızdaki bağ kan bağından çok daha güçlü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800225
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800225,
					"content": "Büyüdükten sonra potansiyeli olanlar tetikçi olur ve farklı konumlara sızıp emirleri beklerler. Ne yazık ki ben de \"potansiyeli olanlardan\" biriydim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800226
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800226,
					"content": "Sana verilen emir ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800227
					]
				},
				{
					"id": 730800227,
					"content": "Aranaraları yakalamak. \"Doktor\"un emri. Aranara, rüyalar ve Solduran arasındaki bağ üzerinde çalışmak istediği için bu emri verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800228
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800228,
					"content": "Rüyaları ve Solduranı bir silah haline getirmek projelerinden biri. Elbette ben ve yendiğin tüm Fatui üyeleri onun için yalnızca \"araştırma kaynağı\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800229
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800229,
					"content": "Biz Aranaraları göremiyoruz ancak Kavus, Sudabeh ve Iotham onlarla arkadaş olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800230
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800230,
					"content": "Yani Aranaraları ortaya çıkarmak için Fatui'nin, çocukları kaçırmasına izin verdin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800231
					]
				},
				{
					"id": 730800231,
					"content": "Doğru, Aranaralar da cidden geldi. O kadar güçlülerdi ki sıkı güvenliğimize rağmen çocukları kurtardılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800232
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800232,
					"content": "Doktor bu sefer cidden inanılmaz bir şeye göz dikti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800233
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800233,
					"content": "#Sana da bir sorum var {NICKNAME}. Aranaralar, neden Kavus ve Sudabeh'in hafızasından kaçırıldıklarına ve kurtarıldıklarına dair anıları sildi? Açığa çıkmamak için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800234
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800234,
					"content": "Aranaralar, çocukların böyle bir olayı hatırlamasını hiç istemediler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800235
					]
				},
				{
					"id": 730800235,
					"content": "Aranaralar çocuklar büyüdüklerinde şiddete yönelmelerini istemiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800236
					]
				},
				{
					"id": 730800236,
					"content": "Anlıyorum. Yani o Aranaranın adı Arana mı? İsmi Rana'ya çok benziyor, ne kadar da güzel bir isim. Fırsat bulursan ona benim yerime teşekkür et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800237
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800237,
					"content": "Ona neden teşekkür edesin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800238
					]
				},
				{
					"id": 730800238,
					"content": "Vimara Köyü'nde evimdeymiş gibi hissediyorum. Rana ve Iotham ise hiç sahip olamadığım akrabalarım. Kavus ve Sudabeh de değerli kardeşlerim gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800239
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800239,
					"content": "Umarım mutlu, sağlıklı, dürüst ve nazik birer yetişkin olurlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800240
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800240,
					"content": "Yani Arana \"iş\"imi zorlaştırmış olsa da yaptıklarına minnettarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800241
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800241,
					"content": "Şimdi anlıyorum. Tıpkı Paimon'un dikkatini dağıttığın gibi... Çocuklar da pis işlerin farkına varmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800242
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800242,
					"content": "\"Evlat, çocukluğunun tadını çıkarmalısın; dilediğini yap, görmek istediğini gör. Fakat karanlık günleri de unutma...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800243
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800243,
					"content": "Taş Yuva'nın öğretisi budur. Yetişkinler eninde sonunda hayatın karanlık tarafıyla yüzleşmek zorundadır, buna erken yaşta hazırlanırsan kendini ve sevdiklerini koruyup kollayabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800244
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800244,
					"content": "Belki senin yaptığın da mantıklıdır. Keşke Taş Yuva'da büyüyüp Vimara Köyü'nde bir casus olmasaydım... Keşke Vimara Köyü'nde doğmuş olsaydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800245
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800245,
					"content": "Bütün bu konuşma anlamsız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800246
					]
				},
				{
					"id": 730800246,
					"content": "Biliyorum. Yalnızca üzgünüm. Keşke hep \"Alphonso\" olsaydım, \"Trofin Snezhevich\" değil. Iotham'ın abisi olmayı çok isterdim gerçekten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800247
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800247,
					"content": "İyi bir insan olmak istiyorum ama bir örgüte üyeyim. Rana ile yuva kurup çocuk sahibi olmak istiyorum ama zaten sırt çeviremeyeceğim bir \"ailem\" var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800248
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800248,
					"content": "Akranlarımın çoğu Haberci Efendilerin gücüyle yarışacak güçlere sahip ve herhangi bir şehre ya da devlete tabi değiller. Bu, senin gibi özgür bir fahri şövalyenin bile anlayamayacağı bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800249,
						730800251
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800249,
					"content": "Anlıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800250
					]
				},
				{
					"id": 730800250,
					"content": "Ama yaptıklarının affedilmesi mümkün değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800253
					]
				},
				{
					"id": 730800253,
					"content": "Diyeceklerimin hepsi bu kadardı. Öyleyse, benimle ne yapacaksın şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800254,
						730800262
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800254,
					"content": "Bir daha Vimara Köyü'nün yakınından bile geçmeyecek, asla karşıma çıkmayacaksın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800255
					]
				},
				{
					"id": 730800255,
					"content": "Tamam, anladım. Bir daha beni görmeyeceksin. Fatui'ye de dönmeyeceğim çünkü bana verilen görevi elime yüzüme bulaştırıp \"kardeşlerimi\" utandırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800256
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800256,
					"content": "Iotham muhtemelen sonsuza dek \"Alphonso\"nun dönmesini bekleyecektir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800257,
						730800259
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800257,
					"content": "Git şimdi. Paimon her an gelebilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800258
					]
				},
				{
					"id": 730800258,
					"content": "Görüşürüz. Hayır, elveda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800259,
					"content": "(Savaş) Fikrimi değiştirdim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800260
					]
				},
				{
					"id": 730800260,
					"content": "#Zalimin sonunu gördüm ama dövüşmeden pes etmeyeceğim. Sen {NICKNAME} olabilirsin ve karşında hiç şansım olmayabilir ama yine de dövüşeceğim, çünkü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800261
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800261,
					"content": "Ben, iyilik içindeki kötülük, bitkiler arasındaki zehir, koyunlar arasındaki kurt ve altın kadehdeki cıvayım... Benim adım Snezhevich, elinden geleni yap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800262,
					"content": "(Savaş) Arana ve ben...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800263
					]
				},
				{
					"id": 730800263,
					"content": "Zalim olanların cezalandırılması gerektiği konusunda anlaştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800264
					]
				},
				{
					"id": 730800264,
					"content": "#Zalimin sonunu gördüm ama dövüşmeden pes etmeyeceğim. Sen {NICKNAME} olabilirsin ve karşında hiç şansım olmayabilir ama yine de dövüşeceğim, çünkü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800265
					],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800265,
					"content": "Ben, iyilik içindeki kötülük, bitkiler arasındaki zehir, koyunlar arasındaki kurt ve altın kadehdeki cıvayım... Benim adım Snezhevich, elinden geleni yap!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alphonso"
				},
				{
					"id": 730800251,
					"content": "Anlamıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800252
					]
				},
				{
					"id": 730800252,
					"content": "Denemeyeceğim bile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800253
					]
				},
				{
					"id": 730800210,
					"content": "Fatui hakkında oldukça bilgi sahibisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730800211
					]
				},
				{
					"id": 730800211,
					"content": "O kadar çok kötülük yaptılar ki onları tanımayan kalmadı. Söylemeye çalıştığım onlardan biri olduğumu kanıtlayacak sağlam bir kanıtın yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730800212
					],
					"speakerTitle": "Alphonso"
				}
			]
		},
		{
			"id": 7308003,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
