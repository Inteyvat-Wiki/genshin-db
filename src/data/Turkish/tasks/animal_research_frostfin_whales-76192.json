			"dialogs": [
				{
					"id": 761920101,
					"content": "Şans bugün bizden yana değil anlaşılan... Saatlerdir bekliyoruz ama sıradan bir Buz Yüzgeçli Balina bile görmedik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920102
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920102,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920103
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920103,
					"content": "Hımm... Belki de bugünlük burada bırakıp geri dönmeliyiz. Elbet başka fırsatımız da olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920104
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920104,
					"content": "Ama... Zaten şurada kısacık bir süre kalıp yine yollara düşeceksin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920105
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920105,
					"content": "Öyleyse biraz daha bekleyelim bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920106
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920106,
					"content": "Bir dakika... Helka, sen misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920107
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920107,
					"content": "Linnea! Benim, geri döndüm. Ama arşivim henüz hazır değil, o yüzden kozlarımızı paylaşacaksak biraz daha beklemen gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920108
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920108,
					"content": "Öyle mi? Anlaşılan gezin verimli geçmiş. Ben de armut toplamadım tabii, kendi kayıtlarıma epey bir ekleme yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920109
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920109,
					"content": "Sen de mi Buz Yüzgeçli Balinayı görmeye geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920110
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920110,
					"content": "Evet. Yakın zamanda keşfedilmiş diye duydum. Boyutuna bakılırsa, derisindeki renk değişiminin çevresel faktörlerden kaynaklandığından şüpheleniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920111
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920111,
					"content": "Bölgedeki Kuuvahki yoğunluğu gibi mesela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920112
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920112,
					"content": "Ne yazık ki bugün de bir şey göremeyeceğiz anlaşılan. O kadar da bekledik ama elimize hiçbir şey geçmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920113
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920113,
					"content": "Linnea... Bana arka çık! Hadi bugünlük yeter diyelim de geri dönelim artık Maisie...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920114
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920114,
					"content": "İyiyim ben. Bu sabah uyandığımdan beri kendimi her zamankinden daha iyi hissediyorum. Hadi biraz daha bekleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920115
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920115,
					"content": "Duyduğuma göre Buz Yüzgeçli Balinayı gören herkesin dileği gerçek olurmuş. O yüzden... İyi şans getirmesi gerekiyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920116
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920116,
					"content": "Umarım getirdiği şans, bir sonraki yolculuğunda senin yanında olur Helka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920117
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920117,
					"content": "Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920118
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920118,
					"content": "Öyleyse birlikte bekleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920119
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920119,
					"content": "... Linnea!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920120
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920120,
					"content": "Merak etme. İçimden bir ses bugün o Buz Yüzgeçli Balinayı göreceğimizi söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920121
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920121,
					"content": "Bilirsin huyumu Helka. İçimdeki ses asla yanılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920122
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920122,
					"content": "Peki... O halde biraz daha bekleyeceğiz. Ama sadece birazcık, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920123
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920123,
					"content": "Bir süre sonra...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761920124
					]
				},
				{
					"id": 761920124,
					"content": "Baksanıza! Vay canına, ne kadar da yükseğe sıçradı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920125
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920125,
					"content": "Keşke ben de o kadar hızlı yüzebilsem... Onlarla yüzmek çok eğlencelidir kesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920126
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920126,
					"content": "Hadi biz de atlayalım o hald...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920127
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920127,
					"content": "Hey! Bu çok tehlikeli! Of, ben yokken hiçbir şey değişmemiş. Hâlâ bıraktığım gibi gözü karasın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920128
					],
					"speakerTitle": "Helka"
				},
				{
					"id": 761920128,
					"content": "N-Ne? Sen de onlarla oynamak istemiyor musun? Çok eğleniyorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920129
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 761920129,
					"content": "Ama kıyafetlerin ıslanırsa üşütebilirsin. Kıyıda durup onların eğlenceli anlarını Kamerayla çekmeye ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761920130
					],
					"speakerTitle": "Maisie"
				},
				{
					"id": 761920130,
					"content": "Hımm... Mantıklı. O zaman Helka'nın Kamerasını bir süre ödünç alayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
