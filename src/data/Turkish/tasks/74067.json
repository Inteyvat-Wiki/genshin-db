			"dialogs": [
				{
					"id": 740670401,
					"content": "Yine karşılaştık. Bu gelenler siz misiniz diye kendi kendime iddiaya girmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670402,
						740670404
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670402,
					"content": "Peki kazandın mı, yoksa kayıp mı ettin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670403
					]
				},
				{
					"id": 740670403,
					"content": "Hem kazandım hem kaybettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670406
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670406,
					"content": "Neden bunun için hoparlör kullanıyorsun ki? Galvaryet seni yakalasa başın belaya girmez mi? Ondan hiç korkmuyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740670407,
					"content": "Ondan korkmak mı? Neden korkayım ki? Ama ona yakalanınca sinir bozucu olabiliyor, hepsi bu. Zamanının çoğunu İdari Bölgede geçiriyor zaten. İyi bir sebep olmadıkça Üretim Alanının işlerine karışmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670408
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670408,
					"content": "Ben de böyle şeyler için hoparlör kullanıyorum çünkü buralar çok sıkıcı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670409
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670409,
					"content": "Sanırım Teilhard'ı anlamaya başladım. Sıkıldığı için kendine yeni eğlenceler bulmaya çalışıyor o da. Bir bakıma onu taklit ettiğimi söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670410
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670410,
					"content": "Sizin de onun gibi bir arkadaşınız vardır mutlaka. Sürekli çılgın fikirler üretir, bazen ortalığı toza dumana bular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670411,
						740670412
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670411,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670413
					]
				},
				{
					"id": 740670413,
					"content": "Paimon seni hiç anlayamıyor! Buranın sıkıcı olduğunu düşünüyorsan ve onun gibi bir arkadaşın varsa neden Meropide Kalesi'ni terk etmiyorsun ki? Yoksa ciddi bir suç işlediğin için çıkamıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740670414,
					"content": "İstediğim zaman çıkabilirim buradan. Hür irademle burada kalmayı seçtim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670415
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670415,
					"content": "Buradaki hayat dışarıdaki hayattan çok daha iyi. Endişe yaratan durumlar yok. İşler tıkırında. Karmaşık sorunları düşünme zorunluluğu yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670416
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670416,
					"content": "Şu Lanoire denilen kızı çok kıskanıyorum. Onun yerinde olsam buradan asla çıkmazdım. Dış dünyayı umursamadan yaşardım hayatımı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670417,
						740670419
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670417,
					"content": "Çünkü sen zaten dış dünyayı gördün.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670418
					]
				},
				{
					"id": 740670418,
					"content": "Haklısın. Kendi gözlerimle görmemiş olsam böyle bir kanaate varamazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670421
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670421,
					"content": "Burada yaşamaya devam edersen arkadaşlarını göremezsin ki? Onların buraya gelmesi gerekir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740670422,
					"content": "İyi haber şu ki bunu düşünmeme hiç gerek yok. Kötü haber şu ki düşünmeme gerek yok çünkü tüm arkadaşlarım öldü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670423
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670423,
					"content": "*iç çeker* Böyle konuları konuşmakta pek iyi değilimdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670424
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670424,
					"content": "Araştırma sahamız pek sıcak değildi, bütçe onayı almaksa imkansıza yakındı ama bunlara rağmen onlarla birlikteyken hayat o kadar da kötü değildi aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670425
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670425,
					"content": "Ancak kazalar ve bahtsızlık yakamıza yapıştı bir kere. Butor hastalanıp vefat etti, Merkez Laboratuvar patladı ve Teilhard patlamada hayatını kaybetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670426
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670426,
					"content": "Biri de kovuldu... Boş verin, ondan bahsetmek istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670427
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670427,
					"content": "Neyse, elimden hiçbir şey gelmiyordu. Ancak Kaledeki hayat gayet basit, ortaya çıkan sorunlar da hemen çözülebilecek türden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670428
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670428,
					"content": "Burada büyük bir sorun çıksa da sorunu çözmesi gereken kişi ben değilim. Hayatımdan gayet memnunum. Arada eski günleri yad edecek birilerinin olması güzel oluyor tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670429,
						740670430
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670429,
					"content": "Anlıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670431
					]
				},
				{
					"id": 740670431,
					"content": "Sizinle sohbet etmek güzeldi, teşekkür ederim. Bu Kuponları kabul edin. Size bir dahakine Eskicide bir şeyler ısmarlamışım gibi düşünün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670432
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670432,
					"content": "#Sağlığınıza {M#beyefendi}{F#hanımefendi} ve küçük hanım. Yüzünüz hep gülsün, gününüz güzel geçsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670430,
					"content": "Kararına saygı duyuyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670431
					]
				},
				{
					"id": 740670419,
					"content": "Diğer insanların kararlarını yargılamamalısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670420
					]
				},
				{
					"id": 740670420,
					"content": "Haklısın. Hah, zaten onu çok iyi tanımıyorum açıkçası. Aklından neler geçiyordur kim bilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670421
					],
					"speakerTitle": "Clynes"
				},
				{
					"id": 740670412,
					"content": "Yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670413
					]
				},
				{
					"id": 740670404,
					"content": "Neden kendinle iddiaya girdin ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740670405
					]
				},
				{
					"id": 740670405,
					"content": "Güzel ve cevaplaması kolay bir soru... Buradaki kimse benimle bu kadar sıkıcı bir iddiaya girmek istemediği için kendimle iddiaya girdim işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740670406
					],
					"speakerTitle": "Clynes"
				}
			]
		}
	]
}