					"Kusi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750470401,
					"content": "Kilomu kontrol edebilmeyi başardım ama... Hımm? Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470402,
						750470405,
						750470409
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470402,
					"content": "Sen kimdin acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470403
					]
				},
				{
					"id": 750470403,
					"content": "Doğru ya, kendimi tanıtmadım. Buradaki görevli nöbetçilerden biriyim ama şu anda tatil modundayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470404
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470404,
					"content": "Bir şey olursa yanımdaki dostum Yukom'a gelebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470405,
					"content": "Aklına takılan bir şey mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470406
					]
				},
				{
					"id": 750470406,
					"content": "Son zamanlarda biraz kilo aldım, o yüzden klasik Tahıl Meyvesi diyetime sağlıklı sebzelerden de bolca ekledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470407
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470407,
					"content": "Ancak son zamanlarda nedendir bilmiyorum, dostum Ur da beni taklit etmeye ve bir sürü ot yemeye başladı... Sürüngenler hem etçil hem otçul olduklarından bu çok sorun değil, ancak sadece ot yiyerek besin ihtiyacını karşılayamaz diye endişeleniyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470408
					],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470408,
					"content": "Onunla daha sonra bir konuşsam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				},
				{
					"id": 750470409,
					"content": "Önemli bir şey değil, gerçekten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470410
					]
				},
				{
					"id": 750470410,
					"content": "Tamam o zaman, sana iyi yolculuklar yabancı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kusi"
				}
			]
		}
	]
