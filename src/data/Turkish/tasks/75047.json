			"dialogs": [
				{
					"id": 750470301,
					"content": "Çok uykum var. Uyumak istiyorum... Ancak birlikte burada beklememiz lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470302
