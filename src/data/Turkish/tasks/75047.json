			"dialogs": [
				{
					"id": 750470201,
					"content": "Tahıl Meyvesi çok lezzetlidir... Ancak sürekli yersen birkaç gün sonra artık tadı kötü gelmeye başlar.",
					"roleType": "TALK_ROLE_NPC",
