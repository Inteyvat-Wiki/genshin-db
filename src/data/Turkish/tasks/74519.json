			"dialogs": [
				{
					"id": 745190401,
					"content": "Aa, selam Fahri Şövalye! Kumandan Jean'i görmeye mi geldin? Yoksa sana yardımcı olabileceğim başka bir konu mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190402,
						745190403
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190402,
					"content": "Sadece yürüyüş yapıyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				},
				{
					"id": 745190404,
					"content": "Şu anda Favonius Şövalyeleri ofislerinin çevresinde rutin bir temizlik yapıyorum. Toz alma işi bitti sayılır. Şimdi eski dosyalarımızı düzenleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190405
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190405,
					"content": "Bu belgeler bir süredir birikmiş durumda. Onları farklı kategorilere ayırırsam herkesin arama yapması daha kolay olur diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190406
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190406,
					"content": "Ayrıca benden öncekilerin kayıtlarından çok şey öğrenebilirim. Bu da bir çeşit idman sayılır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190407
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190407,
					"content": "Her zamanki gibi işinde çok ciddisin Noelle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190408
					]
				},
				{
					"id": 745190408,
					"content": "Sadece görevimi yapıyorum. Sen ve diğer Şövalyeler daima öndesiniz, bir an önce arayı kapatmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190409,
						745190410
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190409,
					"content": "Kararlılığın hatırlanmaya değer...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190411,
					"content": "Hı? Benim mi? Şey, memnuniyetle! Sadece... Temizliği yeni bitirdim de, üstüm başım toz içinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190412,
						745190413
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190412,
					"content": "Olay o zaten! En yoğun çalıştığın anda çekmek istiyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190414,
					"content": "Şey... B-Bana öyle demek için biraz erken değil mi? Ama fotoğrafımı çekmek istiyorsan... Üstüm başım toz içinde olsa da bu benim için bir onurdur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745190415
					],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190415,
					"content": "Mükemmel anı yakalayacağına eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Noelle"
				},
				{
					"id": 745190413,
					"content": "Hizmetçi Şövalyenin \"kararlı atılımını\" kameraya almak istiyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190414
					]
				},
				{
					"id": 745190410,
					"content": "... Bu yüzden izninle bir fotoğrafını çekeyim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190411
					]
				},
				{
					"id": 745190403,
					"content": "Neyle uğraşıyorsun Noelle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745190404
					]
				}
			]
		}
	]
