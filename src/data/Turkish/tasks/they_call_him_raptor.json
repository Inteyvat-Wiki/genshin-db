				"points": []
			},
			"dialogs": [
				{
					"id": 4843101,
					"content": "Şükürler olsun, Favonius Şövalyeleri geldi! Dağ yabanileri peşimden gelmeye cesaret edemez artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843102,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843103
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843103,
					"content": "Buna inanamıyorum ama... Dağ yabanileri arabalarımıza saldırdı. Neyse ki kaçmayı başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843104,
					"content": "Dağ Yabanileri mi? Ama Favonius Şövalyeleri bu civardaki dağ yabanisi kamplarının çoğunu temizledi sanıyordum, öyle değil miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843105
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843105,
					"content": "Köye çok yakın küçük bir kamp. Teslimatlarımda izlediğim rota kamptan uzak durmamı sağlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843106,
					"content": "Ama bugün... Deli adamın biri aniden gökten alçalıp kampın tam ortasına iniverdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843107,
					"content": "Hımm... Aklıma biri geliyor ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4843108,
					"content": "Bu onları çok kızdırdı. Tuhaf görünümlü adamın peşinden koşunca açığa çıktılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843109
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843109,
					"content": "Ben kaçmayı başardım ama meyve arabalarımı paramparça ettiler. Yarın tüccar kervanı geldiğinde ne yapacağım bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843110
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843110,
					"content": "... Tuhaf görünümlü derken? Nasıl tuhaf?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843111
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843111,
					"content": "Elinde bir şey vardı. Her neyse çok ağır olsa gerek çünkü canını kurtarmaya çalışırken düzgün uçamıyordu... Herhalde bu yüzden düştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843112
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843112,
					"content": "Bana sorarsanız böylelerinin gökyüzünde olmasına izin verilmemeli. Uçarken ağır eşyalar taşınmaması gerektiğini bilmek için dahi olmaya gerek yok! O aptalı şikayet edip ehliyetinin iptal edilmesini sağlayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843113
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843113,
					"content": "Ağır bir eşya... Yadigar mı yoksa? Bu aradığımız adam olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843114
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843114,
					"content": "Peki ne tarafa gittiğini gördünüz mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843115
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843115,
					"content": "Dağ yabanilerinden kaçarken göz ucuyla bakabildim. Sanırsam... Şu tarafa gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843116
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 4843116,
					"content": "#Sağlam bir ipucu bulduk gibi duruyor. {NICKNAME}, takibe devam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843117
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4843117,
					"content": "Merak etmeyin, geri döner dönmez Şövalyelere kalan dağ yabanilerini de en kısa sürede temizlemelerini söylerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amber"
				}
			]
