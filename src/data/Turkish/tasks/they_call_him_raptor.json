						4842202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 4842202,
					"content": "Element izleri burada bitiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "Yadigardaki element gücü tükenmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "Amber"
				},
				{
					"id": 4842204,
					"content": "Avcı işaretlerin konumunu açık ettiğini fark edip bizi yavaşlatmak için yardakçılarını göndermiş olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
