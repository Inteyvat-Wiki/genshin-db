			"dialogs": [
				{
					"id": 3071501,
					"content": "Bravo! Mükemmel bir performans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071502
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071502,
					"content": "Sen iyi eğitimli bir şövalyesin, çok şaşırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071503
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071503,
					"content": "Bu savaşta gösterdiğin hünere gerçekten saygı duymak gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071504,
						3071505
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071504,
					"content": "Teşekkür ederim, bunu söylemeniz çok güzel...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				},
				{
					"id": 3071506,
					"content": "Haha, şövalyelerin alçak gönüllülük erdemine zaten sahip olduğunu görüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071507
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071507,
					"content": "Mondstadt'ı yıkımdan kurtarmak için sergilediğin kahramanlığın hikayeleri, Özgürlük Şehri'nin her köşesinde bilinecek ve geleceğe de taşınacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071508
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071508,
					"content": "Lütfen, zamanın olduğunda beni karargahımızda mutlaka ziyaret et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071509
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071509,
					"content": "Ayrıca harika bir han da biliyorum, eğer bu daha çok senin tarzın ise.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071505,
					"content": "Gerçekten de, iltifat etmeye değmez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071506
					]
				}
