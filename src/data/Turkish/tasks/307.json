			"dialogs": [
				{
					"id": 3071101,
					"content": "Geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071102
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071102,
					"content": "Yaklaşsana. Kokusunu alabiliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071103,
						3071104
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071103,
					"content": "... Hiçbir şeyin kokusunu alamıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				},
				{
					"id": 3071105,
					"content": "<color=#00E1FFFF>Tapınakta</color> bir şeyler olmuş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071106
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071106,
					"content": "Sanırım orada bodurloplar, dağ yabanileri ve... Fırtına Dehşeti'ne daha fazla gücü her ne veriyorsa o olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071107
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071107,
					"content": "Ah evet, içerisi gerçekten de çok canlı olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071108,
						3071110
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071108,
					"content": "Tehlikeli olacak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071109
					]
				},
				{
					"id": 3071109,
					"content": "Hareketli olacağı kesin ama tehlikeli olacağını hiç sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071112,
					"content": "Kurt Tapınağının böyle bir vahşet tarafından rahatsız edilmiş olması çok üzücü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071113
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071113,
					"content": "#Hadi {NICKNAME}, içeri girelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071114
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071114,
					"content": "Artık hiç kimse Dört Rüzgara adak sunmuyor ama eski rüzgarlar da asla ortadan kaybolmuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071115
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071115,
					"content": "Tapınakları temizlememiz gerek, Dört Rüzgar için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071110,
					"content": "Kuşkusuz, yaratıklardan oluşan düzensiz bir kalabalıktan fazlası değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071111
					]
				},
				{
					"id": 3071111,
					"content": "Ah, haha! Oldukça cesursun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3071112
					],
					"speakerTitle": "Kaeya"
				},
				{
					"id": 3071104,
					"content": "Bu, yanık Ateş Bodurloplarının kokusu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3071105
					]
				}
			]
		},
