			},
			"dialogs": [
				{
					"id": 221130501,
					"content": "Bitti! Sonunda tamir oldu. El becerim hakkında ne düşünüyorsun? Fena olmadı sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130502
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130502,
					"content": "Ayrıca işe bile yarayabilir. Hahaha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130503
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130503,
					"content": "Her neyse. Uğraşlarına karşılık şunu vereyim. Tekrar çok sağ ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130504
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130504,
					"content": "Lütfen dilediğin zaman bir fincan çay içmeye, bir şeyler atıştırmaya gel. Şefimiz gerçekten çok iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		}
