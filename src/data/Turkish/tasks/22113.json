					"Huai'an"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221130101,
					"content": "Burada da iş üstüne iş çıkıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130102
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130102,
					"content": "Hâlâ merdiveni mi tamir ediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130103
					]
				},
				{
					"id": 221130103,
					"content": "Tam zamanında geldin. Geçen seferki yardımın için teşekkür ederim... Şimdi ikinci tur zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130104
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130104,
					"content": "Bu biraz daha büyük ve yeterince Tahta Kalasım yok. Taşıyıcılardan birini, yeni bir parti getirsin diye yolladım ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130105
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130105,
					"content": "Dönüşte canavarların saldırısına uğradı. Panikleyip kaçtı ve Tahta Kalasları da orada bıraktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130106
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130106,
					"content": "Gerçekten çok korkmuş. Tahta Kalasların nerede olduğunu öğrenmeyi başardım ama onları alıp getirmesi için kendisini ikna edemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130107
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130107,
					"content": "Çözüm bulmak için bolca kafa patlattım ama şu anda bana yardım edebilecek tek kişi sensin. Bana Tahta Kalasları getirir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130108,
						221130110
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130108,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130109
					]
				},
				{
					"id": 221130109,
					"content": "Harika. Seni burada bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130110,
					"content": "Bu gerçekten büyük bir çatlak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130111
					]
				},
				{
					"id": 221130111,
					"content": "Öyle korkuyla bakma... Bunu canavarların yaptığını düşünmüyorsun değil mi? Öyle olsa dev gibi bir canavar olması gerekirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130112
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130112,
					"content": "Bu defa şey oldu... İki konuğumuz geldi, aralarında bir husumet var gibiydi çünkü ilk gelen ikinci geleni kovalıyordu ve ikinci gelen de ilk gelenden saklanıyordu... Şansımıza ikisi birbirine denk gelmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130113
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130113,
					"content": "Ama sonrasında... Gece kalmaya karar verdiler ve yukarı çıkarken merdivende karşılaştılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130114
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130114,
					"content": "Birbirlerini gördükleri anda yumruklar havada uçuşmaya başladı... Kavga esnasında merdiveni kırdılar. Onları ayırmam çok uzun sürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130115
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130115,
					"content": "Çok sinirlendim... Hemen ikisinden de fazladan üç gece ücreti aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130116
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130116,
					"content": "Her neyse, bu kadar dedikodu yeter! Şimdi şunu tamir etmek için Tahta Kalas toplamama yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130117
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130117,
					"content": "Böyle bir şey yine yaşanırsa, hasarı karşılamalarını istemekle bile uğraşmayacağım... Hasarı doğrudan kendilerinin tamir etmelerini isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
