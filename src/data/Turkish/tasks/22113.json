					"nextDialogs": [
						221130203
					]
				},
				{
					"id": 221130203,
					"content": "Hadi ama, tüm gün bekleyemem... İşe koyulmak için seni bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
