						221130302
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130302,
					"content": "Al bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130303
					]
				},
				{
					"id": 221130303,
					"content": "Harika. Sonunda! Tanrım, bu canavarlar hep başımıza bela oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130304
					],
					"speakerTitle": "Huai'an"
				},
				{
					"id": 221130304,
					"content": "Bu fazlasıyla yeter. Çok teşekkürler! Hemen işe koyulayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Huai'an"
				}
			]
		},
