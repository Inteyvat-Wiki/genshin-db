			"dialogs": [
				{
					"id": 240051101,
					"content": "Abin her zaman bu kadar ciddi mi? Bir kere bile tebessüm ettiğini görmedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051102
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051102,
					"content": "Eskiden böyle biri değildi, babanla kitap okumaya başladıktan sonra değişti. Şimdi sürekli somurtup duruyor, aklından ne geçiyor hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051103
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240051103,
					"content": "Of, sanki babamı tasvir ettin. Annem hep onun sanki bir şeyle güreşiyormuş gibi olduğunu söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051104,
					"content": "Ama ne ile güreşiyor? Annenle kavga falan mı etti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240051105,
					"content": "Hayır, asla kavga etmezler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051106
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240051106,
					"content": "Yetişkinler çok garip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
