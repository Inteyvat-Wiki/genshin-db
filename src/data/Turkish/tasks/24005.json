			"dialogs": [
				{
					"id": 240050401,
					"content": "Bay Louis! Birkaç porsiyon Bulle Meyvesi aromalı patates kızartması istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050402,
					"content": "Aa, Lovi gelmiş! Maalesef bugün elimde hiç Bulle Meyvesi kalmadı. Liman gördüğün gibi çok kalabalık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050403
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050403,
					"content": "A-Ama bu patatesleri sattığını bana söyleyeli çok olmadı ki. Hatta yanımda arkadaşlarımı bile getirdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050404
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050404,
					"content": "*iç çeker* Özür dilerim. Bugün çok müşteri vardı, tamamen aklımdan çıkmış... Yine de normal patates kızartmalarım var. İstersen sana ikram edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050405
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050405,
					"content": "Peki o halde. Teşekkürler Bay Louis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050406,
						240050407
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050406,
					"content": "Sadece Bulle Meyvesi mi eksik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				},
				{
					"id": 240050408,
					"content": "Getirebilirsen ben de sosu hemen hazırlarım. Öncekilerden artmış baharatlarım da hazır....",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050409
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050409,
					"content": "Yaşasın! Harikasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050410
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050410,
					"content": "Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050411
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050411,
					"content": "Gerçekten çok özür dilerim. Sizinle ne zaman karşılaşsak başınıza hep bir iş çıkarıyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050412,
						240050413
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050412,
					"content": "Bu kadar resmi olmana gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050414,
					"content": "Peki tamam. Senden öğrenecek çok şeyim var. Bay Delerue, çok duygusuz olduğumu ve bunun ileride eleştirmen olmamı zorlaştıracağını söylüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050415
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050415,
					"content": "*iç çeker* Neyse, bunu boş ver. Ben ikisine göz kulak olacağım. Bulle Meyvelerini sana bırakıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050413,
					"content": "O kadar da büyütülecek bir şey değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050414
					]
				},
				{
					"id": 240050407,
					"content": "Sana biraz Bulle Meyvesi getirebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050408
					]
				}
			]
		},
