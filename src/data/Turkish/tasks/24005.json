			},
			"dialogs": [
				{
					"id": 240050201,
					"content": "Vay canına... Keşke çeşmeye atlayıp suyla oynayabilsem ya da banyo yapabilsem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050202,
					"content": "İşiteceğin azarı hiç düşünmüyorsun sanırım. Lütfen, gözlerin doysun yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050203,
					"content": "Çeşmeler, insanların oynaması için yapılmadıysa neden bu kadar büyükler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050204
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050204,
					"content": "Güzel görünebilirler ama bunu bir kenara koyup bakarsan yalnızca sıradan su birikintileri olduklarını görürsün. Hiçbir özel yanları yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050205,
					"content": "Bu sıradan bir çeşme değil ama... Bir saniye, babam o sıradan olanlardan bahsetmişti bana... Sahi ne demişti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050206
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050206,
					"content": "\"Fontaine Şehri'ndeki güzelleştirme projelerinin asıl amacı, vergi beyannamesi konusunda esneklik sağlamasıdır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050207
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050207,
					"content": "Bay Delerue bana bunu anlatmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050208
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050208,
					"content": "Hah, aynı babam gibi konuştun. Seni sevmesine şaşmamalı Aurele. Yani seninle her konuştuğunda o kitap yığınını da beraberinde getiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050209
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050209,
					"content": "Bundan hiçbir şey anlamadım ama abimin yine tat kaçıracak bir şey söylediğine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050210
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050210,
					"content": "Hadi oynayacak başka yer bulalım Lovi. Yani bugün ders çalışmana gerek yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050211
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050211,
					"content": "Tamam, hadi başka bir yere gidelim... Buğukuş hâlâ açık olmalı. Hadi oraya gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
			]
		},
