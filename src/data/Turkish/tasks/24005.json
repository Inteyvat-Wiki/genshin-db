				"points": []
			},
			"dialogs": [
				{
					"id": 240050101,
					"content": "Hadi abi, bu taraftan! Daha önce o büyük evi görmemiştik, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050102,
					"content": "Dikkat et Verut, yoksa tekrar düşeceksin. Sen de Lovi. Baban sağlığının çok iyi olmadığını söyledi, üşütebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050103
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050103,
					"content": "Of, abin aynı annem gibi, çok gıcık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050104
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050104,
					"content": "Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050105
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050105,
					"content": "Siz ikiniz var ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050106,
						240050107
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050106,
					"content": "Tekrar karşılaştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				},
				{
					"id": 240050108,
					"content": "Hey, sen mi geldin? Ama bu defa saklambaç oynamıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050109
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050109,
					"content": "Daha doğrusu, oynamayı bitirdik... Bayan Nour'dan da epey laf işittik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050110,
					"content": "İşteyken her zaman çok ciddi oluyor, sürekli insanlara nasihat verip duruyor. Halbuki ben ona önceden kurabiye bile vermiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050111,
					"content": "Neyse, zaten yorulmuştuk. Verut ve Aurele'yi leziz bir şeyler yemeye götürecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050112
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050112,
					"content": "Bizim... Şeyimize katılmak ister misin? Adı neydi onun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050113
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050113,
					"content": "Yürüyüşümüze?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050114
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050114,
					"content": "Evet, yürüyüşümüze! Hadi bize katıl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050115
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050115,
					"content": "Hadi oradaki meydana gidelim. Çeşmeyi görmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050116,
						240050117
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050116,
					"content": "Tamam, bayanlar önden o halde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050118,
					"content": "Tamam! O zaman... Önce meydana gidelim. Oradaki çeşmelerin hepsi çok güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050117,
					"content": "Tamam, önden buyur o halde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050118
					]
				},
				{
					"id": 240050107,
					"content": "Ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050108
					]
				}
			]
		},
