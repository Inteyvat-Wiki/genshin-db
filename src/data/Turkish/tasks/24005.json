			"dialogs": [
				{
					"id": 240050601,
					"content": "Bunlar yeterli olmalı. Hemen döneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050602
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050602,
					"content": "Louis, Bulle Meyvesi sosunu yapmaya başlar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240050603
					]
				},
				{
					"id": 240050603,
					"content": "Hazır! Bu taptaze patates kızartmaları müesseseden. Hemen yiyebilirsiniz ama dikkatli olun, çok sıcaklar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050604
					],
					"speakerTitle": "Louis"
				},
				{
					"id": 240050604,
					"content": "Harika! Hadi gömülün. Çok lezizler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050605
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050605,
					"content": "Aa, Aurele, lütfen bunu babama anlatma. Yoksa yine nasihatlarıyla başımı ütüleyecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050606
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050606,
					"content": "Heh. Merak etme. Zaten Bay Delerue'nun patates kızartmalarına takacağını zannetmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050607
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050607,
					"content": "Peki... Ya ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050608
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050608,
					"content": "Sana da afiyet olsun. Benim payımı da paylaşabilirsiniz. Patates kızartması yemeyi pek sevmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050609
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050609,
					"content": "Hehehe, o zaman ben başlayayım! Hadi ama, sen de denemelisin. Hepsi senin sayende sonuçta, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050610
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050610,
					"content": "Doğru ya, daha sonra gidip Bay Delerue'ya kahve almam lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050611
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050611,
					"content": "Bekle, olmaz! Annem, babamın kahve içmesine uzun bir süredir izin vermiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050612
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050612,
					"content": "Kahve içtiği zaman odasında sürekli öksürüyor, hatta sesi bile kısılmaya başlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050613
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050613,
					"content": "Babam tüm bunları işi için yaptığını söylüyor ama hangi iş bu kadar acı çekmene neden olur ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050614
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050614,
					"content": "Mükemmel yorumlar yazmanın \"bedelinden\" bahsederken bunu mu kastediyordu acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050615
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050615,
					"content": "Eleştirmen olmak zor bir şey olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
