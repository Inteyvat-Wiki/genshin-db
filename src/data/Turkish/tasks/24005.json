				},
				{
					"id": 240051202,
					"content": "Eğer Buğukuş'ta bir eleştirmen olarak işe başlayabilirsem bir gelirim olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051203
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240051203,
					"content": "Ama Bay Delerue, bir eleştirmen olmak istiyorsam Moraya çok değer vermemem gerektiğini söyledi. Yoksa yanlış yola sapabilirmişim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240051204
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240051204,
					"content": "Moraya çok ihtiyacım var... Ne yapmalıyım... *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
