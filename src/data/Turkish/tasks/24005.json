			},
			"dialogs": [
				{
					"id": 240050301,
					"content": "Burası Buğukuş mu? O kadar da... Özel görünmüyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050302,
						240050303
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050302,
					"content": "Oldukça sıradan bir yer, evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				},
				{
					"id": 240050304,
					"content": "Vay canına, gerçekten de bir makina kuşları var! Çok havalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050305
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050305,
					"content": "Değil mi? Babam sıklıkla beni buraya gazete almak için getirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050306
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050306,
					"content": "Buğukuş'u çok seviyor. Tüm gününü gazete okuyarak bile geçirebilir. Hatta bazen gazeteden bazı bölümleri kesip kitaplarına yapıştırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050307
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050307,
					"content": "Bunların \"yorumları\" olduğunu söyler ve bazen annem ve bana okur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050308
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050308,
					"content": "Gerçi biz bunları duymayı pek sevmeyiz. Sadece \"haklısın\", \"aa\" ve \"öyle mi?\" falan deriz ama bunları okumaktan o kadar çok keyif alır ki bizi fark etmez bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050309
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050309,
					"content": "\"Yorum\" derken neyi kastediyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050310
					]
				},
				{
					"id": 240050310,
					"content": "Kısaca söylemek gerekirse yorum, bir kişinin kendi bakış açısıyla ortaya koyduğu fikirlerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050311
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050311,
					"content": "Lovi'nin babası Delerue, Fontaine Araştırma Enstitüsünde bir bilim insanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050320
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050320,
					"content": "Aynı zamanda kendisi Buğukuş'ta \"eleştiriler\" yazan bir \"eleştirmen\"dir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050312
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050312,
					"content": "Evet, her şey hakkında uzun yorumlar yapmayı çok sever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050313
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050313,
					"content": "Bazen konuşurken aklına bir şey gelir ve hemen bir taslak oluşturmak için odasına koşar. Bunu yaparken yemek bile yemez, sadece çay içer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050314
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050314,
					"content": "Hah. Sadece yorum yaparak Mora kazanmak mümkün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050315
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050315,
					"content": "\"Eleştirmen\" olmak öyle basit bir şey değil. Başkalarının da tanıyacağı bir yorum yazmak istiyorsan bazı ilkelerden şaşmamalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050316
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050316,
					"content": "Hımm... Şey... Acıkan var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050317
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050317,
					"content": "Bay Louis, bana son zamanlarda Bulle Meyvesi aromalı patates kızartması sattığını söylemişti. Hadi gidip biraz yiyelim. Ben ısmarlayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050318
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240050318,
					"content": "Aa... Tamam, olur! Hadi abi, söylenmeyi bırak. Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240050319
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240050319,
					"content": "Siz ikiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240050303,
					"content": "Buranın hiçbir özel yanı yok, evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240050304
					]
				}
			]
		},
