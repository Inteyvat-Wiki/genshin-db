			"dialogs": [
				{
					"id": 790740101,
					"content": "Oo, iki cesur savaşçı daha gelmiş! \"Poyraz Esintisi\" oynamaya mı geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740102
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740102,
					"content": "Gelin, bu taraftan! Eşsiz uçuş gücünüze tanıklık etmek için sabırsızlanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740103,
						790740104
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740103,
					"content": "Biraz sakin ol!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				},
				{
					"id": 790740105,
					"content": "Uçmak için sakin olmaya gerek yok sevgili misafir, hem de hiç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740106
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740106,
					"content": "Sürekli sakin kalmak seni rüzgar hissinden mahrum bırakır. Ancak hazırlıksız bir şekilde güçlü rüzgarlarla yüzleştiğinde asıl potansiyelini keşfedebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740107
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740107,
					"content": "Uçan sincaplar bugünlerde çok çekingen! \"Cesur Kuzey Rüzgarı\"ndan öğrendikleri dersleri tamamen unutmuş görünüyorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740108
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740108,
					"content": "Güvenli yerlerde durup rüzgarda dans eden yaprakların cesaretinden söz edip duruyorlar ama rüzgara atlayıp bunu bizzat deneyimlemekten ölesiye korkuyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740109
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740109,
					"content": "Bu hep böyle devam ederse Majesteleriyle birlikte krallığı nasıl koruyabiliriz? Saçmalık! Saçmalığın daniskası!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740110
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740110,
					"content": "Hey, bu uçan sincap kesinlikle çok enerjik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 790740111,
					"content": "Uçmayı gerçekten seviyor galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740112
					]
				},
				{
					"id": 790740112,
					"content": "Bu yüzden kendime özellikle güçlü rüzgar akımları olan bir geçit buldum ve içine türlü türlü cihaz yerleştirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740113
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740113,
					"content": "Bu geçitten yalnızca en cesur ve en gelişmiş uçuş becerilerine sahip olanlar geçebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740114
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740114,
					"content": "Gereken cesarete sahip misiniz sevgili misafirler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740115,
						790740117
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740115,
					"content": "Bir deneyelim bakalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740116
					]
				},
				{
					"id": 790740116,
					"content": "Harika! Beni takip edin o halde. Geçit çok uzakta değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740117,
					"content": "Şey... Halletmem gereken başka işler var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740118
					]
				},
				{
					"id": 790740118,
					"content": "Öyle mi? Hazırlanmak için biraz zamana ihtiyacınız var demek. Sorun değil, ben beklerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790740119
					],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740119,
					"content": "Bu rüzgarlı geçitten geçmeyi denemek istediğinizde gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clanche"
				},
				{
					"id": 790740104,
					"content": "Daha ağzımı bile açmadım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790740105
					]
				}
			]
		}
	]
}