						],
						"stepId": 7107002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Clitopho"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "Merhaba! Yolculuğun nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701702,
					"content": "İyi, peki ya senin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "Orada bana o fırsatı verdiğin için teşekkür ederim. Top fitilini yapma girişimimiz başarıyla sonuçlanınca herkes kalmama izin verme fikrine ısındı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701704,
					"content": "Yüzeye çıkınca ne yapacağıma gelirsek... Henüz tam olarak düşünmedim ama muhtemelen Hazine Avcılarına tekrar katılmam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701705,
					"content": "Muhtemelen mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "Ah... Şey, Hazine Avcılarına kesinlikle tekrar katılmayacağım! Kesinlikle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701708,
					"content": "Görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "Dikkat et kendine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710701706,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Khedive"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "O... *iç çeker* Ha? Ah, merhaba. Üzgünüm, orada beni rahatsız ettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701802,
					"content": "Ödeştik mi yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "Tamam, şamataya gerek yok. Durumumuz iyi değil. Hatta hiç iyi değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701805,
					"content": "Parlak kristal parçasını gördün, değil mi? Yanılmıyorsam aşağılarda daha da büyüğü var. Gerçi sen bunu zaten biliyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701806,
					"content": "Teorik olarak, yukarıdaki parça asıl yerine \"döndüğünde\" verilerimizin normale dönmesi gerekirdi. Öyle de oldu zaten fakat dalga biçimi yanlış... Hepsi yanlış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701807,
					"content": "Neden bahsediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "İyi bir öğrenci değildin herhalde? Basitçe anlatayım o zaman. Şu anda taş değirmendeki çekirdekler gibi, iki büyük güç arasında bir çatışmanın eşiğindeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701810,
					"content": "Geniş bir zaman ölçeğinde olmak üzere biri yukarıdan biri de aşağıdan iki güç tarafından eziliyoruz ve yakında un ufak olacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701811,
					"content": "Bana inanmıyorsan bekle de gör. O Zhiqiong adındaki maceracı... Böyle şeylere çok yaklaşanların başına gelenleri gördüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701812,
					"content": "Öksürürken kan kusmakla başlar, derken bir gün iç organlarını kusarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701813
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701813,
					"content": "Benim yapabileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701814
					]
				},
				{
					"id": 710701814,
					"content": "Senin mi? Biraz düşüneyim... Bir yolu olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701815,
					"content": "Her halükarda şu anda acilen ihtiyacımız olan şey aşağıda neler olduğunu anlayana kadar keşfe devam etmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701816
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701816,
					"content": "Merak etme, ben de hiçbir şey yapmadan duracak değilim. Yatırımlarımın getiri sağladığından emin olmalıyım sonuçta, bu nedenle de keşif takımımın güvenliğini sağlamalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701817
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701817,
					"content": "Benim için de sorumluluk alacak mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701818
					]
				},
				{
					"id": 710701818,
					"content": "Hımm... Kabul etmeliyim ki yeteneklerin beklentilerimin çok üstünde çıktı. Bence sen kendi sorumluluğunu alabilecek düzeydesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701819
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701819,
					"content": "Boş ver, ne diyorum ben... Sana bir şey olursa tazminat öderim, anlaştık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 710701808,
					"content": "Anlayacağım dilde konuş lütfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				}
			]
