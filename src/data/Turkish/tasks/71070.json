					"nextDialogs": [
						710702902
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702902,
					"content": "Biz, yani ben Clitopho, seni selamlıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702903
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702903,
					"content": "Hadi çekinme, bir şeyler iç! Ben ısmarlıyorum. Benim için yaptığın onca şeyden sonra, bunun lafı bile olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702904,
						710702905
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702904,
					"content": "Bundan sonra ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				},
				{
					"id": 710702906,
					"content": "Artık keşif takımının resmi bir üyesiyim. Bu yüzden onlar burada kaldığı için, ben de kalacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702907
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702907,
					"content": "Khedive ve Jinwu bana biraz daha yardım bulabilse, her şey çok daha kolay olur tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702908
					],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702908,
					"content": "Gerçi yıkım takımına yeni biri katılırsa, kendimi takımın yegane üyesi ve takım lideri olarak tanıtamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Clitopho"
				},
				{
					"id": 710702905,
					"content": "Buralarda kalmaya devam edecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				}
