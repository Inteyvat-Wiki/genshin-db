	"talks": [
		{
			"id": 7107001,
			"completionStepIds": [
				7107001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107001",
							"2"
						],
						"stepId": 7107001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "Ah, gelmişsiniz. Yolu temizlememize yardım ettiğiniz için teşekkürler. Zhiqiong da bize yol göstererek çok yardımcı oldu, ikinize de teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700102,
					"content": "Bana kamptan bahset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "Güzel görünüyor, değil mi? Ben yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700104,
					"content": "Bunların hepsini on yaşında babamdan öğrenmeye başladım. Kamp alanları nasıl kurulur, kristal lambalar nasıl yapılır, madencilik ekipmanının bakımı nasıl yapılır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700105,
					"content": "Sürekli öğrendim ve ben öğrenirken babam yaşlandı... Gözleri iyice bozulunca madendeki güvenlik ekipmanlarının bakımını yapmak bana kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700106,
					"content": "İlerleyen zamanlarda bile... Görüyorsun işte, artık ben de genç sayılmam. Hikayemin devamında pek bir şey yok... Bir adamla tanıştım, bir adam kaybettim, okumak için Sumeru'ya giden bir kızım oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700107,
					"content": "Bazen madendeki adamlar aramızdan erken ayrılınca çocuklarına bakmak bana düşüyor... O nedenle yanımda hep şekerleme taşırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700108,
					"content": "Yine bu nedenle çocuk deyince aklıma hep şekerleme kokan, yerden bana bakan, şekerleme veya oyun için renkli taş bekleyen minikler gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700109,
					"content": "Vay be. Peki şu anda yanında şekerleme var mı Jinwu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700110,
					"content": "Şekerleme mi? Şehirdekiler gibi pahalı türden değil ama seçici olacak halin yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700111,
					"content": "Haa, o tür şekerlemeden bahsediyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710700112,
					"content": "İnsanlar gelip gider, bana sadece anıları kalır... Tabii senin gibi madene inen maceracılar da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700113,
					"content": "Bana biraz Zhiqiong'dan bahset...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "Zhiqiong en son madencilerimizdendir, Mingyun Köyü'nde doğmuş. Zaten Kanyon'daki tecrübeli madencilerin hepsi Mingyun Köyü'nden. Zhiqiong yanlış zamanda doğmuş sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700115,
					"content": "Yanlış anlama beni, zaman kötü demiyorum. Sadece Mingyun'daki cevher damarları çoktan kurudu, o yüzden oradaki işler duralı çok oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700116,
					"content": "Zhiqiong Kanyon'a geldikten kısa bir süre sonra bir olay oldu ve buradaki işler durdu. Madencilik ve Zhiqiong iyi bir ikili değil sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700117,
					"content": "Şey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "Ondan sonra herkes kendi yoluna gitti ama ben kaldım, ekipmanın kendi bakımını yapacak hali yok sonuçta. Zhiqiong da bir maceracı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700119,
					"content": "Ama hiç büyümemiş ve hâlâ hayatını hiç önemsemiyor... Belki de madende yeterince vakit geçirmemiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700120,
					"content": "Madenci hayatına alışsa ve birkaç insanı tehlikeli durumdan kurtarsa hayatı bu kadar hiçe saymazdı eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700121,
					"content": "Bunu isteyebilir miyim bilmiyorum ama ona göz kulak olur musun? Ölmesini istemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710700122,
					"content": "Görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "Tamam o zaman. Dikkat et kendine!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				}
			]
		},
		{
			"id": 7107017,
			"completionStepIds": [
				7107002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
