					"nextDialogs": [
						710702804
					]
				},
				{
					"id": 710702804,
					"content": "Hahahaha! Lafını da esirgemiyorsun hiç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702805
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702805,
					"content": "Yardımların sayesinde kamptaki ortam çok daha sakinleşti. Daha önce aşırı ciddi biri olduğum izlenimi verdiysem çok üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702806
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702806,
					"content": "En önemli işi hallettik. Şimdi uzun vadede yapılacak çalışma kapsamında beklenmedik değişiklikleri gözlemlemek amacıyla yer altında daimi bir nöbet yeri oluşturmamız gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702807
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702807,
					"content": "Bu dönemde birçok madenin kısmen açılmasına izin verilebilir. Yine de yer altında bu kadar derine inmek hâlâ yasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702808
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702808,
					"content": "Bu bölgeyi mühürleyip madencilerin... Hatta hiç kimsenin buraya girmesine izin vermemeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710702803,
					"content": "Tünel sakini mi oldum şimdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				}
