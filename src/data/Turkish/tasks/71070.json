			},
			"dialogs": [
				{
					"id": 710702701,
					"content": "Çok üzgünüm... İnatçılığım yüzünden çok sorun yaşadın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702702
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702702,
					"content": "Yaptığım haritaların düzeltmelerini yapmaya devam edeceğim ve Jinwu'ya o karanlık maddenin hareketlerini gözlemlemesi için işaretçi yerleştirmesine yardım edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702703
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702703,
					"content": "Onlar... Onlar bu maddenin beş yüzyıl önce gerçekleşen karanlık felaketle alakalı olabileceğini söylüyor. Sadece bir artçı mı yoksa geleceğin habercisi mi bilinmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702704
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702704,
					"content": "Ne olursa olsun bana normal bir insanın sınırlarını ve bu sınırlar içinde hayallerimin peşinden nasıl gidebileceğimi gösterdiğin için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702705
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702705,
					"content": "Hah. Şimdi kim filozof gibi konuşuyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702706
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710702706,
					"content": "Hiç bu kadar derin düşünmemiştim sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702707
					]
				},
				{
					"id": 710702707,
					"content": "Sadece... Bana çok yardımın oldu ve sadece harita çizmek gibi basit konularda yardımına ihtiyacım olmasına rağmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702708
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702708,
					"content": "Tehlikeli durumlarda seni hep aşağı çekiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702709,
						710702710
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702709,
					"content": "Güvende olmanı istiyorum işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				},
				{
					"id": 710702711,
					"content": "Evet. Asla pes etmeyeceğim. Dinlenip tekrar yola çıkacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710702710,
					"content": "Sorun değil. Umarım haritalarını bitirebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				}
			]
