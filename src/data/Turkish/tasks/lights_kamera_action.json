			"dialogs": [
				{
					"id": 750230301,
					"content": "Ne oldu? En baştan anlatmamı ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230302,
						750230305
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230302,
					"content": "Ne yapmam gerektiğini bir daha anlatabilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230303
					]
				},
				{
					"id": 750230303,
					"content": "Önce gösteri dekorlarını kurun. Ahşap Fıçıyı; <color=#00E1FFFF>ana karakteri veya seti engellemeyecek şekilde sahnenin ortasına yerleştirin</color> ve Element Yemini <color=#00E1FFFF>düşmanın gireceği yerin</color> yakınına koyun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230304
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230304,
					"content": "Zamanı geldiğinde <color=#00E1FFFF>düşmanı Ahşap Fıçıya yönlendirin</color>, daha sonra güvenli bir yere geçin ve <color=#00E1FFFF>Ahşap Fıçıyı parçalayın</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230305,
					"content": "Gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230306
					]
				},
				{
					"id": 750230306,
					"content": "İyi şanslar, sana güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akatanga"
				}
			]
		},
