			"dialogs": [
				{
					"id": 750230701,
					"content": "Raarr! Raaaarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230702
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230702,
					"content": "Sakin ol, aceleye gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230703,
					"content": "Doğruyu söylemek gerekirse ufaklık için biraz endişelendim az önce. Efektlerin olabildiğince gerçekçi olmasını istiyordum, bu yüzden patlayıcılar konusunu biraz abartmış olabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230704,
						750230706
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230704,
					"content": "Neredeyse tüm yerleşim yeri havaya uçuyordu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230705
					]
				},
				{
					"id": 750230705,
					"content": "Raarraarraarraarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230708,
					"content": "Neyse, bu deneyim sayesinde bir dahaki sefere neleri iyileştirmem gerektiğini biliyorum artık. Yardımlarınız için hepinize teşekkür ederim. Ortaya nasıl bir şey çıktığına bakmak ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230709
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230709,
					"content": "İlginç bir şekilde, ne kuyruğunda kırmızı atkısı olan kurtarıcı ne çatırdama seslerinin geldiği kötü düşman ne de heyecan verici patlamalar çekimlere dahil edilmişti, yalnızca Akatanga'nın devamlı değişen yüz ifadelerinin yakın çekim görüntüleri mevcuttu...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230710
					]
				},
				{
					"id": 750230710,
					"content": "Gösterinin... Yıldızı ben miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230711,
						750230713
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230711,
					"content": "Tebrikler!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230712
					]
				},
				{
					"id": 750230712,
					"content": "Hayır, bu doğru değil! Acaba Kamera yüzünden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230714,
					"content": "Yani, ilk defa bu filmde Kamera kullandım ama... Kamerayı... Ters tutmuş olamam, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230715
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230715,
					"content": "Sana göre hava hoş tabii. Bizim ortaya koyduğumuz onca çabaya ne olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230716,
					"content": "Vuuu... Rrrooo... Rraarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230717
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230717,
					"content": "#Ayrıca {REALNAME[ID(2)|SHOWHOST(true)]} bunu görmek için sabırsızlanıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230718,
					"content": "Üzgünüm, hepsi benim hatam! Pekala, şöyle yapalım... Önceki çekimleri birer prova olarak düşünün. Bir kez daha çekeceğiz ve bu seferki gerçek çekim olacak. Mümkün olan en iyi filmi çekmek için elimden gelen her şeyi yapacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230719
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230719,
					"content": "Rrrooo... Raarrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230720
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230720,
					"content": "#Demek bir şans daha vermek istiyorsun, öyle mi {REALNAME[ID(2)|SHOWHOST(true)]}? Yapalım o halde. Umarım bu kez her şey yolunda gider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230721
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230721,
					"content": "Önceki süreci aynen tekrar ediyor ve bu kez istediğiniz sonucu alıyorsunuz...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230722
					]
				},
				{
					"id": 750230722,
					"content": "Muhteşem! Gerçekten mükemmel! Beklentilerimin tamamen ötesinde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230723,
						750230724
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230723,
					"content": "Çok kolay oldu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230725,
					"content": "Söz verdiğim ödeme dışında, hatıra olarak bu resmi de vereceğim. *iç çeker* Söylemeden geçemeyeceğim, bu gerçekten benim başyapıtım oldu. Tabii siz olmasaydınız başaramazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230726
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230726,
					"content": "#Vay, müthiş çıkmışsın {REALNAME[ID(2)|SHOWHOST(true)]}! Hiç fena değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230727,
					"content": "Raarr! Raaaarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230728
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230728,
					"content": "#Hehe, {REALNAME[ID(2)|SHOWHOST(true)]} son halini sevdi sanki. Sonu iyi bitsin yeter diye boşuna dememişler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230724,
					"content": "Yönetmen, ödememiz ne durumda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230725
					]
				},
				{
					"id": 750230713,
					"content": "Daha önce... Kamera kullandın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230714
					]
				},
				{
					"id": 750230706,
					"content": "Bana bile tehlikeli geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230707
					]
				},
				{
					"id": 750230707,
					"content": "Evet! Ya biri yaralansaydı ya da yangın falan çıksaydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230708
					],
					"speakerTitle": "Paimon"
				}
			]
		},
