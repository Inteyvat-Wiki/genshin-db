			"dialogs": [
				{
					"id": 750231201,
					"content": "Hey! Neden bir figüran düşman karakter oldu? Kimse bize bilgi vermedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750231202,
					"content": "Şşş! Sessiz ol, çekim başlamak üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231203
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231203,
					"content": "\"Hayır, böyle bir kötülük affedilemez... Huzur içinde uyuyun dostlarım. Ah, çok acı... Kabilenin rahmetli kardeşlerini görüp de gözyaşlarına boğulmamak mümkün mü?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231204
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231204,
					"content": "\"Ancak şu an ağlama zamanı değil. Bugün, her şeyi y{RUBY#[D]Xolotl}akan elçiyle yüzleşeceğim ve ne olursa olsun intikamımı alacağım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231205
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231205,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231206
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231206,
					"content": "Denizin çok ötesinden gelen efsanevi meyve Eflatun Kavun kadar soğukkanlı ve sakin, ancak acımasız ve dişsiz bir yaratık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231207
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231207,
					"content": "Nasıl bir yüzü vardı acaba diye merak ediyor olabilirsin. Öyle acımasız bir görüntüsü var ki yanardağ kadar yakıcı Nattakoları mideye indirse bile bana mısın demez. Dehşet verici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231208
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231208,
					"content": "\"Bu defa, bu defa pişmanlığın çok büyük olacak!\" Bunun üzerine, kuyruğunda kırmızı atkısı bulunan dev yaratık saatlerce pratik yaparak geliştirdiği Büyük Etli Alev Topunu fırlattı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231209
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231209,
					"content": "Pekala, zamanı geldi! Elektrik Bodurlopunu Ahşap Fıçıya doğru çekin, daha sonra da Ahşap Fıçıyı parçalayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231210
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750231210,
					"content": "Ne? Yalnızca fıçıyı mı parçalayacağız? \"Büyük Etli Alev Topu\" ne alaka peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750231211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750231211,
					"content": "Kulağa tuhaf geliyor ama... Öyle diyorsan bir deneyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
