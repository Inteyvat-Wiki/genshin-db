			"dialogs": [
				{
					"id": 750230201,
					"content": "#{NICKNAME}, bak! Şurada bir Kamera ve birkaç dekor var. Burası bir film seti mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230202,
					"content": "Ama bu evler... Çok küçük. Yanlarında dev gibi kalıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230203,
					"content": "Raarr... Raarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230204,
						750230207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230204,
					"content": "Küçük insanlar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230205
					]
				},
				{
					"id": 750230207,
					"content": "Bu ev tam senlik Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230208
					]
				},
				{
					"id": 750230205,
					"content": "Raarrr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230206,
					"content": "Hehe, sanırım artık \"büyük\" insanlarız, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230208,
					"content": "Neden bahsediyorsun? Paimon'un öyle küçük bir evde yaşamasına imkan yok. Kollarını ve bacaklarını bile esnetemezdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230239
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230239,
					"content": "Birdenbire ancak tamamen doğal bir şekilde bir Natlan yerlisi sohbete dahil olur...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230209
					]
				},
				{
					"id": 750230209,
					"content": "Selam! Film çekimiyle ilgileniyor musunuz? İlgileniyorsanız sizden ricam, benimle yani Akatanga'yla güçlerinizi birleştirin ve ortalığı kasıp kavuracak, gelişmekte olan bu yeni trendi Natlan topraklarına getirelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230210
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230210,
					"content": "Raarr! Raaaarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230211,
					"content": "#Nasıl oldu da birden gaza geldin {REALNAME[ID(2)|SHOWHOST(true)]}? Bu halini gören de seni film uzmanı zanneder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230212,
					"content": "Raaaarrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230213,
					"content": "Gözlerin epey keskinmiş ufaklık. Aslında burada gördüğünüz her şeyin tek bir amacı var, o da küçük bir Tepetlizorun geleceğin büyük yıldızı olmasını sağlamak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230214
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230214,
					"content": "Ne yazık ki arkadaşım küçük dostumu alıp götürdü. Yaratılıştan kaynaklanan farklılıklarımız nedeniyle aramızda büyük bir tartışma çıktı ve en önemli aktörümle birlikte çekip gittiler... Sonuç olarak artık yoklar. *iç çeker*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230215
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230215,
					"content": "İşle arkadaşlığı hiç karıştırmamam gerekirdi. Hem proje başarısız oldu hem de arkadaşımı kaybettim... Yani çifte hezimet yaşadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230216
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230216,
					"content": "Ama tüm bunlar geçmişte kaldı. Şimdi yine karşıma gözlerinde yıldız ışığı olan, hevesli küçük bir Tepetlizor çıktı! Böyle bir coşkuya sahip olduktan sonra yanlış giden ne olabilir ki? Geleceğin yıldızı önümde duruyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230217
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230217,
					"content": "E, ne diyorsunuz? Zamanın ötesinde, çığır açan bu işi tamamlamama yardım ederseniz karşılığını mutlaka fazlasıyla alacaksınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230218,
						750230219
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230218,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} bu fikri beğenmişe benziyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230221
					]
				},
				{
					"id": 750230219,
					"content": "Tam bir dolandırıcılık girişimine benziyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230220
					]
				},
				{
					"id": 750230220,
					"content": "Bir gecede başarılabilecek bir şey değil tabii ama çekimler için ödemenizi yapacağım. İki taraf için de kazançlı bir durum, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230221
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230221,
					"content": "Yardım edebiliriz, ancak... Senin ne hakkında film çektiğini bile bilmiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230222,
					"content": "Şimdiye kadar yazdıklarım şöyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230223
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230223,
					"content": "*vızz* *patlama* Aniden parlayan göz kamaştırıcı beyaz ışık, kabile yerleşimine davetsiz bir misafirin gelişini haber eder. Tek bir dikeni hariç yusyuvarlaktır bedeni. *çatırdama* *vızz* Çimenlerde bir an durduktan sonra havaya bir yanık kokusu karışır. \"Eyvah! Xibalba'nın elçilerinden biri!\" Kabile üyeleri onu görünce korkarlar. *patlama* *çatırdama* *vızz* \"Dişleri olmayan iğrenç bir yaratık... Bize doğru geliyor! Hepimizi yutacak!\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230224
					]
				},
				{
					"id": 750230224,
					"content": "#Kötü yaratık tam kabilenin savunmasını geçecekken... *BUM* *BUM* Kuyruğunda kırmızı bir atkı bulunan kurtarıcımız birden ortaya çıkar. \"O nereden geldi?\" diye sorar kabile halkı. Obsidiyenden bile daha güçlü ve her türlü kayayı oyabilen sağlam pençelerine hayranlıkla bakarlar. \"Fakat böylesine kaypak ve utanmaz bir düşmanla karşı karşıya kalan yoldaş {REALNAME[ID(2)|SHOWHOST(true)]} bile olsa... Bu, kazanılması mümkün olmayan bir savaş...\"",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230225
					]
				},
				{
					"id": 750230225,
					"content": "\"Raarr!\" diye haykırır kurtarıcımız. Bu haykırış öfkeli bir kükremeden çok kulakları tırmalayan bir çığlık gibidir ve dişsiz canavar titremeye başlar. Öfkeli alevler gökyüzünü aydınlatır, ardından gök gürülder... Daha sonra, ısı dalgaları ileriye doğru akmaya başlar, Sıvı Filojistondan bile daha sıcaktır. Böyle bir sıcağa maruz kalan dişsiz canavar hüsrana uğrar. Artçı ısı dalgaları hızla yükselirken faciadan son anda kurtulan kabile halkı \"Sıcak, sıcak, sıcak!\" diye bağırır.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750230226
					]
				},
				{
					"id": 750230226,
					"content": "Ama yukarı baktıklarında, kuyruğunda kırmızı atkısı olan kurtarıcılarının, tıpkı gelirken olduğu gibi hiçbir iz bırakmadan ortadan kaybolduğunu fark ederler.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750230227,
					"content": "Nasıl? Beğendiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230228
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230228,
					"content": "Rarr! Raarr, rarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230229,
						750230231
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750230229,
					"content": "Harika! Tam da izlemek isteyeceğim bir senaryo.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230230
					]
				},
				{
					"id": 750230231,
					"content": "Eşi benzeri yok sanırım bu tarzın. Sindirmek için biraz zamana ihtiyacım olacak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750230232
					]
				},
				{
					"id": 750230230,
					"content": "Biliyordum! Birilerinin bu tarzı beğeneceğini biliyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230233
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230232,
					"content": "Şey... Bir zamanlar bir yabancının bana söylediği gibi, kalabalığın dikkatini çekerse zaten zafer yoluna girmişsin demektir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230233
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230233,
					"content": "#Şey, Paimon pek anlamadı ama {REALNAME[ID(2)|SHOWHOST(true)]} beğendiyse mesele yok, öyle değil mi? Pekala... Şimdi tam olarak ne yapmamız gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750230234,
					"content": "Çok basit. Öncelikle gösteri dekorlarını kurmanız gerekiyor. <color=#00E1FFFF>Ahşap Fıçıyı ve Element Yemini uygun bir yere yerleştirin</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230235
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230235,
					"content": "Ahşap Fıçı sizin gizli silahınız, bu yüzden onu <color=#00E1FFFF>resmin ortasına yerleştirin</color>, ancak ana karakteri ya da set yapılarını engellemesin. Element Yemi <color=#00E1FFFF>düşmanın girdiği yere</color>, yani kenara yakın olursa daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230236
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230236,
					"content": "#Tüm aktörler buradaysa harekete geçebiliriz. Kuyruğunda kırmızı atkı bulunan kurtarıcımız {REALNAME[ID(2)|SHOWHOST(true)]}, sahneye gir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230237
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230237,
					"content": "Sahnenin ilgili bölümüne gelindiğinde ikiniz <color=#00E1FFFF>düşmanı Ahşap Fıçıya yönlendirin</color> ve oradan hemen ayrılın. Güvenli bir yere geldiğinizde ise <color=#00E1FFFF>Ahşap Fıçıyı parçalayın</color> ve bu iş tamamdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750230238
					],
					"speakerTitle": "Akatanga"
				},
				{
					"id": 750230238,
					"content": "Filmin tamamlandığını görmek için sabırsızlanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Akatanga"
				}
			]
		},
		{
			"id": 7502303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
