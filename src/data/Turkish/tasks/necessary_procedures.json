			"dialogs": [
				{
					"id": 718040401,
					"content": "Bu işlemler için verilen evraklar yine eksik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040402
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 718040402,
					"content": "Ivanovich yeni bir işletme ruhsatı almak istiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040403
					]
				},
				{
					"id": 718040403,
					"content": "Ivanovich mi? Ah, evet, hatırladım. Birkaç kez buraya gelmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040404
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 718040404,
					"content": "Yeni bir işletme ruhsatı için başvuruyor, değil mi? Haha... Şu an oldukça meşgul olmalıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040405
					],
					"speakerTitle": "Asabi Ann"
				},
				{
					"id": 718040405,
					"content": "Ona yardım etmek için geldin herhalde. <color=#00E1FFFF>Çıkış iznini</color> getirdin mi? Daha önce Ivanovich'e evraklarında eksik olduğunu ve başka bir yerde doldurması gerektiğini söylediğimi hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asabi Ann"
				}
			]
		},
