			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ivanovich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718040301,
					"content": "Ee, ruhsatla ilgili ilanı buldunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040302
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040302,
					"content": "Evet, yazanları not aldım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040303
					]
				},
				{
					"id": 718040303,
					"content": "Süper! Bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040304
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040304,
					"content": "Çıkış izni, işletme ve güvenlik sertifikası, bir de eski işletme ruhsatı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040305
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040305,
					"content": "Güzel, güzel. Bu belgeleri daha birkaç gün önce yine uzun bir koşuşturma sonrasında imzalatmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040306
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040306,
					"content": "Gezgin, bu belgeleri gerekli kişilere iletmeme de yardım edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040307
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040307,
					"content": "Tabii düşününce... *öksürür* Belge vermek isteyen birçok insan olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040308
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040308,
					"content": "İlk olarak <color=#00E1FFFF>çıkış izni</color> Asabi Ann'a gidecek. Ardından <color=#00E1FFFF>işletme ve güvenlik sertifikasının</color> Jiayi adında bir Taşordu askerine teslim edilmesi gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040309
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040309,
					"content": "Son olarak <color=#00E1FFFF>eski işletme ruhsatı</color> da Katip Zhao'ya verilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040310
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040310,
					"content": "Belgeleri teslim etmeme yardım edebilir misin Gezgin? Karşılığında uygun bir ücret ödeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040311
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040311,
					"content": "Tabii, olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040312
					]
				},
				{
					"id": 718040312,
					"content": "Umarım bunlardan başka işlem yoktur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040313
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040313,
					"content": "Umarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040314
					]
				},
				{
					"id": 718040314,
					"content": "Tabii senin bu işlemleri bir daha yapman gerekmeyecek ama ben... Liyue'de iş yapmaya devam etmek istiyorsam bir gün bunlarla tekrar uğraşacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040315
					],
					"speakerTitle": "Ivanovich"
				},
				{
					"id": 718040315,
					"content": "*iç çeker* Bu yöntemler sana güven duygusu veriyor, evet ama keşke daha basit olsalardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ivanovich"
				}
			]
		},
