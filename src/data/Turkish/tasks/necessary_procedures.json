			},
			"dialogs": [
				{
					"id": 718040201,
					"content": "Bu pano Feiyun Yamacı İlan Panosudur. Burada topluluk haberlerini ve dükkan duyurularını bulabilirsiniz. Lütfen önemsiz mesajlar asmayınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040202,
						718040205,
						718040208
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 718040202,
					"content": "Bakanlığın personel atamalarıyla ilgili bir şeyler var mı bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040203
					]
				},
				{
					"id": 718040203,
					"content": "\"Sivil İşler Bakanlığının personel atamaları aşağıdaki gibidir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040204
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 718040204,
					"content": "Bir dakika. Bunun işletme ruhsatıyla bir ilgisi yok ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040205,
					"content": "Feiyun Yamacı'ndaki su kaynaklarının kirlilik durumuna bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040206
					]
				},
				{
					"id": 718040206,
					"content": "\"Feiyun Yamacı'ndaki su kaynaklarının son zamanlardaki kirliliğiyle ilgili olarak...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040207
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 718040207,
					"content": "Hadi, Ivanovich'in yapacak işleri var. Şu anda buna bakacak vaktimiz yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040201
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718040208,
					"content": "Yeni işletme ruhsatı başvuruları ile ilgili haberlere bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040209
					]
				},
				{
					"id": 718040209,
					"content": "\"Yeni işletme ruhsatı başvurusu için aşağıdaki işlemleri gerçekleştirmeniz gerekmektedir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040210
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 718040210,
					"content": "Ivanovich'in başvurmak istediği yeni işletme ruhsatı bu olmalı. İşlemleri not alalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7180403,
			"completionStepIds": [
				7180403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
