					"content": "Ivanovich yeni bir işletme ruhsatı almak istiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040603
					]
				},
				{
					"id": 718040603,
					"content": "Onun temsilcisi misin? Peki. <color=#00E1FFFF>Eski işletme ruhsatını</color> alayım lütfen.",
