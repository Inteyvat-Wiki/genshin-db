			"dialogs": [
				{
					"id": 718040501,
					"content": "Düzgün sıra oluşturalım lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040502,
						718040504
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040502,
					"content": "Ivanovich yeni bir işletme ruhsatı almak istiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040503
					]
				},
				{
					"id": 718040503,
					"content": "Öyle mi? Onun temsilcisi olarak mı buradasın? Anladım. İşletme ve... Neydi diğerinin adı? Hah, iş güvenliği sertifikası gerekiyor. İkisi de yanında mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040504,
					"content": "Bu sertifikalardan sen mi sorumlusun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718040505
					]
				},
				{
					"id": 718040505,
					"content": "Hayır, ben de senin gibi geçici süreliğine yardım ediyorum. Katip Zhao'nun şu anda eli dolu olduğundan bu sertifikaları toplayıp dosyalamak için beni çağırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718040506
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718040506,
					"content": "*iç çeker* Gerçekten yorucu bir iş... Şimdi, işletme ve iş güvenliği sertifikasını getirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
				}
			]
		},
