			"dialogs": [
				{
					"id": 736920101,
					"content": "Aa, selam Gezgin. Demek sen de Bilgelik Şenliğine katılmak için geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920102
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920102,
					"content": "Eğer ilgini çekerse Amurta olarak tasarladığımız oyunu denemek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920103
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920103,
					"content": "Ne tür bir oyun bu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920104
					]
				},
				{
					"id": 736920104,
					"content": "Darşanımız \"Hayvan Taklidi\" isimli küçük bir oyun hazırladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920105
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920105,
					"content": "Bu oyunda bazı hayvanların davranış alışkanlıklarını tanıtacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920106
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920106,
					"content": "Tabii ki bu davranışlar kolay anlaşılması için genelleştirilmiş ve basitleştirilmiş olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920107
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920107,
					"content": "Tek yapman gereken hazırladığımız modeli kullanarak ilgili hayvanın hareketlerini taklit etmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920108,
						736920109
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920108,
					"content": "Oldukça basit duruyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				},
				{
					"id": 736920110,
					"content": "Kesinlikle. \"Hayvanların düzenli davranış alışkanlıkları vardır.\" Hem anlaşılması kolay hem de kabul edilebilir bir ifade.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920111
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920111,
					"content": "Ancak böyle basit bir ifadenin ardında aslında çok derin gizemler yatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920112
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920112,
					"content": "Ama şimdilik akademik gözlem işini bir kenara bırakıp hayvanların alışkanlıklarını taklit etmenin tadını çıkaralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736920113,
						736920115
					],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920113,
					"content": "Bir deneyeyim bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920114
					]
				},
				{
					"id": 736920114,
					"content": "Tamam o zaman, şöyle gel lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920115,
					"content": "Şu anda biraz meşgulüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920116
					]
				},
				{
					"id": 736920116,
					"content": "Sorun değil. Standım Şenlik boyunca açık olacak. İstediğin zaman gelip oyunu deneyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paz"
				},
				{
					"id": 736920109,
					"content": "Çok da zor değil gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736920110
					]
				}
			]
		}
	]
