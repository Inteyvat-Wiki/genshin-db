			"dialogs": [
				{
					"id": 765070101,
					"content": "#Vay canına {NICKNAME}, şuna bak! Albüme daha dün başlamış gibiyiz ama ne çabuk tamamladık! Fotoğraflar da çok güzel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070102,
						765070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070102,
					"content": "Eğlenirken zaman akıp gidiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				},
				{
					"id": 765070104,
					"content": "Hehe, Paimon bu kadar güzel yerler bulacağımızı ve eski arkadaşlarımızın fotoğraflarını çekebileceğimizi hiç düşünmemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070105,
					"content": "Ooo, şuna baksana! Bu açıyı yakalayabilmek için çok uğraştık ama son hali çok güzel oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070106,
						765070107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070106,
					"content": "Hepsi senin yönlendirmenle oldu Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070108,
					"content": "Hehe, tabii ki! Rehberlikte Paimon'dan iyisi yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070109,
					"content": "Hem karşılığında harika anılarımız oldu, bu yeter de artar bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070110,
					"content": "#{NICKNAME}, bu Kamerayla fotoğraf çekmek nasıldı? Becerilerinin geliştiğini düşünüyor musun? Efsanevi Pierre Leblanc'ı alt edebilmeye biraz daha yaklaştık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070111,
						765070112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070111,
					"content": "Becerilerim mi? Daha çok yolum var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070113,
					"content": "Hehe, haklısın! Tadını çıkarmak en önemlisi! Ayrıca Paimon'a göre senin çektiğin fotoğraflar ustalarınkinden farksız, hatta daha bile güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070114,
					"content": "Ayrıca her biri birlikte yaşadığımız hikayeleri içeriyor. Paimon için bu paha biçilemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070115,
					"content": "İleride... Şey, başka yerlere maceralara gittiğimizde bu güzel anıları hatırlayacağız... İnanılmaz eğlenceli olacak, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765070116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070116,
					"content": "Gelecekte birlikte daha fazla fotoğraf çekelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070117
					]
				},
				{
					"id": 765070117,
					"content": "Tamam, sana söz! Bir sonraki fotoğraf albümümüz daha büyük, daha iyi ve daha özel anılarla dolu olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765070112,
					"content": "Süreçten keyif almak gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070113
					]
				},
				{
					"id": 765070107,
					"content": "Acil durum fonun sayesinde oldu Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070108
					]
				},
				{
					"id": 765070103,
					"content": "Her fotoğrafın ardında bir hatıra var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765070104
					]
				}
			]
		}
	]
