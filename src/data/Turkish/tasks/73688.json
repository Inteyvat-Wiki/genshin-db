				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Hirotatsu",
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880201,
					"content": "Ah, sonunda geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880202
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880202,
					"content": "Of, Hirotatsu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880203,
					"content": "Gezgin zaten seni birkaç gün önce şampiyonada yenmişti. Daha ne diyeceksin, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880204,
					"content": "Endişelenme, buraya sıkıntı çıkarmak için gelmedim. Özür dilemek için geldim. Gezgin, birkaç gün önce beni hakkınla yendin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880205
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880205,
					"content": "Kılıç ustalığın fevkalade. Her bir savuruşun oldukça isabetliydi ama agresif değildi, bu da senin karakterini gösteriyor zaten. Seni yanlış tanıdığım için, sözlerim ve hareketlerimle gücendirdiğim için özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880206,
						736880207
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880206,
					"content": "Sorun değil, alınmamıştım zaten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				},
				{
					"id": 736880208,
					"content": "Buraya Bayan Kamisato'yu almak için gelmiş olmalısınız. Şu anda giyinme odasında olmalı, yakında gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880209
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880209,
					"content": "Gezgin, genç leydi gelmeden önce senden bir isteğim olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880210
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880210,
					"content": "Tabii, nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880211
					]
				},
				{
					"id": 736880211,
					"content": "Genç leydi, henüz biz hizmetkarlarına bu gösteri düellosundan bahsetmemiş olsa da genelde meşgul olmasına karşın her gece kılıç talimi yaptı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880212
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880212,
					"content": "Genç leydi her zaman çalışkan ve özenli biridir. Bunun bir gösteri düellosu olmasına ve kaybetmesinin bir önemi olmamasına rağmen, kazanmak için yine de elinden geleni yapacağına inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880213
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880213,
					"content": "Bir hizmetkar olarak ona güveniyorum tabii ama... Yine de umarım genç leydiyi arenada sen korur ve ona destek olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880214
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880214,
					"content": "Merak etme, elimden geleni yapacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880215
					]
				},
				{
					"id": 736880215,
					"content": "Gezgin, genç leydiyi sana emanet ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880217
					],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880217,
					"content": "Bu Ayaka olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880218,
					"content": "Vay canına...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880219,
					"content": "Ne? Ne oldu? Neden hiç sesiniz çıkmıyor? Giysimde mi bir sorun var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880220
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880220,
					"content": "Hayır, hayır! Ayaka, çok güzel görünüyorsun... Adeta ışık saçıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880221,
						736880225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880221,
					"content": "Giysi gerçekten de sana çok yakışmış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880222
					]
				},
				{
					"id": 736880222,
					"content": "Evet, evet. Fontaine'den gelen bir gemiden inmiş genç bir leydi gibi görünüyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880223,
					"content": "Öyle mi? Biraz fazla abartılı olacak diye endişe ediyordum... Bu işi gerçekten kıvırabilir miyim bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880224
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880224,
					"content": "Sözleriniz yine de beni bir nebze rahatlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880229,
					"content": "Paimon, herkesin Ayaka'yı gördüğü andaki yüz ifadesini çok merak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880230,
					"content": "İltifatların için teşekkürler Paimon. Gezgin, ikimiz de hazır olduğumuza göre artık arenaya gidebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880231
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880231,
					"content": "Leydim ve Gezgin, gösteri düellosu için size bol şans diliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hirotatsu"
				},
				{
					"id": 736880225,
					"content": "Çok güzel bir giysi, tam sana göreymiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880226
					]
				},
				{
					"id": 736880226,
					"content": "Şuna baksana! Üzerine Kamisato Klanının arması bile dikilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880227,
					"content": "Evet, Onodera geçenlerde aileden birine yaptırdı. Seyircilerin oy pusulalarına yazdıkları önerilerden yola çıkmış sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880228
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880228,
					"content": "Giysinin kalıbı çok iyi, tahmin ettiğimden çok daha fazla hareket olanağı sağlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880229
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880207,
					"content": "Savaşımız oldukça keyifliydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880208
					]
				}
			]
		},
		{
			"id": 7368803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
