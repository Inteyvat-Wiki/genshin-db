			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880101,
					"content": "Oldukça yeteneklisin. Adil bir şekilde yenildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880102
					],
					"speakerTitle": "Akatsuki Saemon Juuzou"
				},
				{
					"id": 736880102,
					"content": "Sana karşı savaşmak benim için bir onurdu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880103
					]
				},
				{
					"id": 736880103,
					"content": "Bayanlar ve baylar, bu heyecanlı düellodan sonra Savaşçının Ruhu Kılıç Ustalığı Yarışmasının şampiyonu belli oldu! Alkışlarınızla... Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880104
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880104,
					"content": "Yarın son gösteri düellosu yapılacak... Gezgin ve Bayan Kamisato'ya karşı Yüce Şogun'un seçtiği elçi, kendi kendini idare eden insansı bir kılıç ustası olan \"Maguu Kengou\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880105
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880105,
					"content": "Görüşürüz o halde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880106
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880106,
					"content": "Bu gördüğüm en heyecanlı düelloydu Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880107
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880107,
					"content": "Tebrikler Gezgin. Şampiyon unvanını hakkınla kazandın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880108
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880108,
					"content": "Paimon yarınki rakibimizin Maguu Kengou olduğunu bilmiyordu... Adı, Yashiori Adası'nda karşılaştığımız kişiye çok benziyor. Paimon bunun kolay bir savaş olacağını düşünmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880109,
					"content": "Endişelenme Paimon. Şogun'un seçtiği elçi güçlü olabilir ama yarınki düelloda Önsezi kullanımı serbest olacak. İyi bir takım olacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880110
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880110,
					"content": "Bir de hareketlerini takip edebilirsek mutlaka bir açığını buluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880111
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880111,
					"content": "Peki, senin kendine olan güvenin Paimon'un daha iyi hissetmesini sağladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880112,
					"content": "Kazanacağımızı garanti edemem ama elimizden gelenin en iyisini yapmalıyız. En azından seyircilere unutamayacakları bir gösteri sunmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880113,
						736880114
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880113,
					"content": "Kazanabiliriz Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				},
				{
					"id": 736880115,
					"content": "İkinizin de heyecanı gözler önünde ama bu gece biraz dinlenip kendinizi toplamanız lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880116
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880116,
					"content": "Yarın uyandığımızda Ayaka'nın da yeni giysisini görebileceğiz. Ayaka'nın Fontaine elbisesi giydiğini düşünmek... Ay, Paimon çok sabırsızlanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880117,
					"content": "Evet. Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880118,
						736880120
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880118,
					"content": "Ben de sabırsızlanıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880119
					]
				},
				{
					"id": 736880119,
					"content": "Ne? Sen de mi Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880121
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880121,
					"content": "Hehe, görünüşe bakılırsa kaçışınız yok Bayan Ayaka. Yarın meşgul olmasam ben de gelmeyi çok isterdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880122
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880122,
					"content": "O halde netleştirdik. Yarın sabah seni Kamisato Malikanesinde bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880120,
					"content": "Sabah seni almamı ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880121
					]
				},
				{
					"id": 736880114,
					"content": "Kesinlikle heyecanlı bir düello olacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880115
					]
				}
			]
		},
		{
			"id": 7368802,
			"completionStepIds": [
				7368803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
