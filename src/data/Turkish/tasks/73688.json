			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880301,
					"content": "Hey bakın, Bayan Kamisato ve Gezgin geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880302
					],
					"speakerTitle": "Yuu"
				},
				{
					"id": 736880302,
					"content": "Daha önce bu giysinin çizimlerini görmüş olsam da Bayan Kamisato'yu onu giyerken görmek gerçekten de onun eşsiz zarafetini görmemi sağladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880303
					],
					"speakerTitle": "Sae"
				},
				{
					"id": 736880303,
					"content": "Ön sıralardan yer kapmak için erkenden sıraya girmeme değdi. Bugünün düellosunu iple çekiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880304
					],
					"speakerTitle": "Matsumae"
				},
				{
					"id": 736880304,
					"content": "Vay canına, Ayaka ortaya çıktığı anda herkesin ilgi odağı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880305,
					"content": "Baylar ve Bayanlar, lütfen dikkatinizi buraya verin. Savaşçı Ruhu gösteri düellosu başlamak üzere. Lütfen sıra halinde arenaya girin ve yerlerinize geçin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880306
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880306,
					"content": "Bayan Kamisato ve Gezgin, lütfen benimle gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880307
					],
					"speakerTitle": "Reina"
				},
				{
					"id": 736880307,
					"content": "Hazır mısın Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880308,
						736880310
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880308,
					"content": "Hazırım, hadi gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880309
					]
				},
				{
					"id": 736880309,
					"content": "Tamam, hadi elimizden geleni yapalım. Seninle birlikte savaşmayı iple çekiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880310,
					"content": "Hâlâ biraz zamana ihtiyacım var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880311
					]
				},
				{
					"id": 736880311,
					"content": "Tamam, sorun değil. Hâlâ biraz vaktimiz var. Sen hazır olduğunda birlikte arenaya girebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				}
			]
		},
		{
			"id": 7368804,
			"completionStepIds": [
				7368806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7368806",
							"2"
						],
						"stepId": 7368806,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736880401,
					"content": "Gezgin, Ayaka buradayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880402,
					"content": "Harika bir düelloydu. Kılıç ustalığını pek bilmem ama arenadaki gergin ve heyecanlı hava beni kapıp götürdü adeta. Az daha yüreğim yerinden çıkacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880403
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880403,
					"content": "Rakibinin hamleleri Paimon'u sürekli afallattı ama görünüşe göre ikiniz de buna hazırlıklıymışsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880404,
					"content": "Gezgin ve Bayan Kamisato, gösteri düellosunu kazandığınız için sizi tebrik ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880405,
					"content": "Hey Sara. Sen de mi yarışmayı izlemeye geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880406,
					"content": "Yüce Şogun tarafından bu yarışmayı izlemekle görevlendirildim. İkiniz oldukça iyi kılıç ustalığı ve iş birliği sergilediniz. Sadece izleyicilere kılıç sanatlarının güzelliğini sergilemekle kalmadınız aynı zaman da bana da birkaç şey öğrettiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880407,
					"content": "Göğsüm kabardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880408
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880408,
					"content": "Hepiniz yarışmayla ilgili çeşitli hazırlıklarla meşguldünüz. Bugün Savaşçı Ruhu için mükemmel bir son oldu. Verdiğiniz çabalar, Yüce Şogun'un takdirini kazandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880409,
					"content": "Tenshukaku'ya geri dönüp gösteri düellosunda olanları Yüce Şogun'a iletmem lazım. İzninizle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880411
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 736880411,
					"content": "Bu arada bir planınız var mı? Yoksa hadi Uyuu Restoranına gidip bir zafer yemeği yiyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880412
					],
					"speakerTitle": "Hiiragi Chisato"
				},
				{
					"id": 736880412,
					"content": "Harika bir fikir! Son zamanlarda yarışmaya o kadar çok odaklandık ki iyi bir yemeği en son ne zaman yedim hatırlamıyorum bile! Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880413,
					"content": "Oh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880414
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880414,
					"content": "Bir sorun mu var Ayaka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880415
					]
				},
				{
					"id": 736880415,
					"content": "Bir şey yok. Kazanmanın verdiği hissi daha yeni yaşamaya başladım. Kujou Sara, savaşımızdan çok şey öğrendiğini söyledi, sanırım ben de birçok şey öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880416
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880416,
					"content": "Seyirciler fark etmemiş olsa da yanımda durup rakibin saldırılarını kendine çekmeseydin tehlikede olabileceğim birçok an vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880417
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880417,
					"content": "Sen olmasaydın bunu tek başıma başaramazdım. Tahmin ettiğim gibi kılıç ustalığın benimkinden çok daha ileride.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880418,
						736880419
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880418,
					"content": "Sen de bana birçok defa yardım ettin Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				},
				{
					"id": 736880420,
					"content": "Gerçekten mi? Bunu duyunca birden seninle tekrar kılıç çarpıştırasım geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880421
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880421,
					"content": "Aslında seninle ilk tanıştığımızdan bu yana bir kılıç çarpıştırma fırsatını iple çekiyordum. Bu dileğim, bugün gösteri düellosunda gerçekleşti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880422
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880422,
					"content": "Bir dahakine birkaç tur daha atarız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880423
					]
				},
				{
					"id": 736880423,
					"content": "Tabii ki. Ama... O zamana kadar kılıcına iyi sahip çık. Olur da bir gün onu çalarsam, sadece kılıcın değil hayatın da benim ellerimde olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880424
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880424,
					"content": "Hehe... Her zaman böyle bir şey demek istemişimdir. Kulağa tuhaf geldi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880425,
						736880426
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880425,
					"content": "Aynı Bayan Orith gibiydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880427,
					"content": "Hey, ne diye burada bekliyorsunuz? Ne konuşuyorsunuz bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880428,
					"content": "Hangimizin daha iyi bir kılıç ustası olduğunu öğrenmek için düello yapsak mı diye konuşuyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880429
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880429,
					"content": "Vay canına, konu kılıç ustalığı olduğunda oldukça ciddi oluyorsun. İyi de sen zaten Gezginle arkadaş değil misin? Neden düello yapmanız gerekiyor ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880430,
					"content": "İşte tam da arkadaş olduğumuz için daha fazla kılıç çarpıştırmalı ve birbirimizin hamlelerinden ders çıkarmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880431
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880431,
					"content": "Yani aslında mantıklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880432,
					"content": "Gezgin, dediklerimi bir sır olarak tut, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880433
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880433,
					"content": "Ne? Ayaka ne dedi şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736880434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 736880434,
					"content": "Bir şey demedim, hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 736880426,
					"content": "Şirindi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880427
					]
				},
				{
					"id": 736880419,
					"content": "Çok alçak gönüllüsün Ayaka.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736880420
					]
				}
			]
		},
