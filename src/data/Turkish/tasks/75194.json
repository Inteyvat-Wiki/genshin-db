							9785.573
						],
						"pointId": 11326
					}
				]
			},
			"dialogs": [
				{
					"id": 751940101,
					"content": "Hoop, hoop, hoop! Bunlar satılık. Almayacaksan elleme... Hımm... Hey, sen! Evet, sarışın olan. Dur bakalım, bir yere kaybolma. Sana şöyle yakından bir bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940102
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940102,
					"content": "Hımm, tam tahmin ettiğim gibi. Güneş gibi ışıldayan saçlar, Gece Krallığı kadar derin gözler... Anlaşılıyor ki, daha doğrusu eminim ki ileride çok büyük işler başaracaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940103
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940103,
					"content": "Bak burada her biri birbirinden güzel melodiler barındıran, müthiş yeşim taşından yapılmış süs eşyalarım var. Senin gibi gerçek bir kahramana ancak bunlar yaraşır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940104
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940104,
					"content": "Ama baştan söyleyeyim, bunlar paha biçilmez hazinelerdir. Başka biri almak istese en az 10 milyon Mora isterdim. Ama görüyorum ki bunlar senin kısmetin, bu yüzden onda biri fiyatına senin olabilir. Ne diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940105
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940105,
					"content": "Oha, onda biri mi? Bu çok iyi bir fiyat! Ama bir dakika... Yine de bir milyondan fazla Mora ediyor, değil mi? Sence de biraz fazla değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940106,
					"content": "Yani... Bana gelişi bu fiyata zaten. Benim gibi küçük esnaflar çok Mora kazanamaz, bilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940107,
						751940108
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940107,
					"content": "İyi de öyle para kazanamazsın ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				},
				{
					"id": 751940109,
					"content": "Demek her şeyi duydun, ha? Haha, ne yaparsın, benim de kendi kendime konuşma huyum var işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940110
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940110,
					"content": "*iç çeker* Peki, madem foyamı ortaya çıkardın, dürüst olacağım. Bu yeşim süsü elime tesadüfen geçti. O kadar para etmez aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940111
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940111,
					"content": "Ama duyduğun gibi beş parasız kaldık. Öyle ki şamandıra verilerini toplaması için bile kimseyi tutamıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940112
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940112,
					"content": "O zaman boş ver şamandıra toplamayı! Milleti dolandırmaktan iyidir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940113,
					"content": "Olmaz öyle şey... Diğer kuruluşlar paraları yoksa faaliyetlerini durdurabilirler ama bizim gönüllü çalışmalarımız aynı zamanda yanardağ gözlemlemeyi de içeriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940114
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940114,
					"content": "O şamandıraları, su sıcaklığı ve benzeri verileri toplayarak volkanik faaliyetleri ölçmek için yerleştirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940115
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940115,
					"content": "Yanardağ daha aktif hale geldiği için o şamandıraları hızlıca toplamamız gerekiyor, yoksa ciddi sonuçları olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940116
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940116,
					"content": "Bu sakat halimle ne şamandıraları kırabilirim ne de içindeki verileri alabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940117
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940117,
					"content": "#Ne dersin {NICKNAME}? Ona yardım edelim mi? Bu yanardağ meselesi herkesi etkiliyor, kayıtsız kalamayız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940118,
					"content": "S-Sahiden mi? Yardım etmeye razıysanız bu yeşim taşlı süslerin hepsi sizin, hem de bedavaya! Ödül olarak düşünün. Uygun mudur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940119,
						751940120
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940119,
					"content": "Bir milyon Mora demiştin sanki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940121,
					"content": "Merak etme. Belki pek bir şeyimiz yok ama sana kesinlikle bu yeşim süslerden daha fazlasını verebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940122
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940122,
					"content": "Hehe, onlar bize yeter de artar bile! Sonuçta bunu yanardağın yakınındaki insanların güvenliği için yapıyoruz. O yüzden endişelenmeyin, biz hallederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940123,
						751940124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751940123,
					"content": "Tamam, işe koyulalım o halde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751940124,
					"content": "Bana biraz zaman ver, hazırlanmam gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940125
					]
				},
				{
					"id": 751940125,
					"content": "Ben hazırım, ne zaman istersen başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940120,
					"content": "Ödül olarak sadece bunu mu alacağım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940108,
					"content": "Yardımcı tutmanın bir milyon Moraya mal olacağını söylememiş miydin sen?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				}
			]
		},
		{
			"id": 7519404,
			"completionStepIds": [
				7519404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
