			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940401,
					"content": "Oh be, içim rahatladı. Anlaşılan yanardağın durumu sandığımız kadar vahim değilmiş. Bu gece rahat bir uyku çekebiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940402
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940402,
					"content": "Tabii ki her şey sizin sayenizde oldu. Eğer siz araya girip bize kin gütmeden yardım etmeseydiniz işler bu kadar kolay hallolmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940403
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940403,
					"content": "Lütfen bunu minnettarlığımın ve özrümün bir karşılığı olarak kabul edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940404
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940404,
					"content": "Hehe, madem ısrar ediyorsun... Seve seve kabul ederiz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940405
					]
				},
				{
					"id": 751940405,
					"content": "Şimdi ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940406
					]
				},
				{
					"id": 751940406,
					"content": "Elimde hâlâ biraz ürün var. Normal işleyişe döndüğümüzde mali durumumuz düzelecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940407
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940407,
					"content": "Tabii bu defa acil bir durum söz konusu değil, bu nedenle dürüst ticaret yapacağım, hiç merak etmeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
		{
			"id": 7519405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
