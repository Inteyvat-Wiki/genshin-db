			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kulemana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "On, yirmi... Bayağı ürün sattım, yani şimdilik mali sıkıntımız kalmadı gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940502,
					"content": "Daha fazla kazanmaya çalışmayacak mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "Haha, hayır! Şimdilik bu kadar yeter! Eğer sen bu kadar anlayışlı olup bana yardım etmeseydin o birkaç yeşim parçası yüzünden başımı belaya sokacaktım kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940504,
					"content": "Ayrıca sürekli paranın peşinde koşmak sıkıcı. Bu benim için sadece bir hobi. Asıl önemli olan yanardağı gözlemlemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940505,
					"content": "Mora bir şekilde kazanılır ama bizim ihmalimiz yüzünden bir patlama uyarısı yapılamazsa... Bu çok büyük bir kayıp olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940506,
					"content": "Ateş Konseyinden fon almıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "Hiç başvurmadık ki. Zaten her gün işleri başından aşkın, bir de bizimle uğraşmalarına gerek yok diye düşündük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940508,
					"content": "Ben ve ekibim farklıyız. Biz yol boyunca ufak tefek işler yaparak kendi seyahatlerimizi finanse etmeye alışmışız. Bu bizim yaşam tarzımız oldu artık, anlarsınız ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940509,
					"content": "Bu yüzden seyahat ederken yanardağı gözlemlemek bize zor gelmiyor, tıpkı sizin ihtiyacı olanlara yardım etmeniz gibi. İçimizden geliyor anlayacağınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				},
				{
					"id": 751940510,
					"content": "Tamam o zaman, görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "Kendinize iyi bakın, hehe. Tekrar görüşmek üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kulemana"
				}
			]
		},
