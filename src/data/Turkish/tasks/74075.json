			"dialogs": [
				{
					"id": 740750101,
					"content": "\"Burası Ruhlar Bölgesi, Ruhlar Tapınağı ve Ruhlar Odasıdır...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750102
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750102,
					"content": "\"Sana ebedi istirahatinde eşlik eder\"... \"Bir anda doğar, çelişkili de olsa hiç ayrılmaz\"... \"Hayatın en önemli hazinesidir\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750103
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750103,
					"content": "Oh be... Bu sefer korkunç bir şey çıkmadı. Cevabı cep saati mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750104,
					"content": "Bu arada senin de bir cep saatin yok mu Ann?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750105,
					"content": "Saatler biraz pahalı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750106
					]
				},
				{
					"id": 740750106,
					"content": "O zaman cevap kesinlikle Mora olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750107,
					"content": "Cebinde para varken vefat etmek bu hayatta yaşanabilecek en büyük ikinci trajedi olmalı. İlkini sormayın lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750108
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740750108,
					"content": "Hayatta yaşanabilecek en büyük trajedi ne peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750109
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750109,
					"content": "Bunun cevabını biliyorum. \"Hiç Moran yokken mezara girmek.\" olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750110
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750110,
					"content": "Bilemedim. Hayatta Moradan daha önemli şeyler yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750111
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750111,
					"content": "İşte o yüzden sormayın dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750112
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740750112,
					"content": "Özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750113
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750113,
					"content": "Neyse, bu nedenlerden ötürü cevabın şık bir cep saati veya Mora olmadığını düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750114
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740750114,
					"content": "O zaman ne olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750115,
					"content": "Cevap oldukça basit. Bu bilmeceye %70 benzerlikte birçok bilmece bulabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750116
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750116,
					"content": "Bu bilmece, yüzyıllar önce yazılmış olan klasik bir romandan geliyor. \"Gözler kesiştiğinde dünya durur ya, o an doğdum işte ben. Koşuyorum kovaladığımın peşinden, sırtım ona dönük olsa bile hepten.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750117
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750117,
					"content": "\"Bedeninden tüm eti ve kemiği alsalar da beni çıkaramazlar iliğinden.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750118
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750118,
					"content": "Bunun cevabı \"aşk\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750119
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750119,
					"content": "Şimdi anladım. Bu cep saati de benimkilere benziyor. Aşkla ilgili hatıralarla dolu olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750120
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750120,
					"content": "Keşke açabilseydik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750121
					]
				},
				{
					"id": 740750121,
					"content": "Bir gün açılacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750122
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750122,
					"content": "Aferin şapşal köpek! Kimmiş dünyanın en şirin mekanik köpeği?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750123
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750123,
					"content": "Benim için bir zevkti. Ancak \"şirinlik\" özneldir. Bana daha çok \"güvenilir can dostu Prototip 4ACV07\" demenizi tercih ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750124
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740750124,
					"content": "İşte tam da bu yüzden çok şirinsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750125
					],
					"speakerTitle": "Ann"
				},
				{
					"id": 740750125,
					"content": "Aranızda daha önce geçen bir konuşmayı mı tekrar ediyorsunuz? Sanki bu sözleri daha önce duymuş gibiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750126
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740750126,
					"content": "Neyse, bu bilmeceyi birisi çoktan çözmüş. Hadi ilerlemeye devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tırtıl"
				}
			]
		},
