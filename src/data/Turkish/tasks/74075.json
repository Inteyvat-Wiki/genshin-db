						740751803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751803,
					"content": "Öyle görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751804
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740751804,
					"content": "Bu kim olabilir ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740751805
					]
				},
				{
					"id": 740751805,
					"content": "Jakob.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751806
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740751806,
					"content": "Onunla bir kere Elynas'ta savaşmıştık. Düzeltme: \"Bir kere\" değil, \"daha önce\" olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751807
					],
					"speakerTitle": "Seymour"
				},
				{
					"id": 740751807,
					"content": "Kapıdaki talihsiz kurbanları görünce bunun onun işi olduğunu anlamıştım. Demek hâlâ iş başında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751808
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740751808,
					"content": "Peki burada topladığı şeylerle ne yapmayı planlıyor olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740751809,
					"content": "Oldukça basit. O da Nergis Haçı'nın Kutsal Kılıcını yeniden dövmek istiyor. Derneğin hayali hâlâ gerçekleşmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751810
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 740751810,
					"content": "Neyse, şimdi son bölgeye gitmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tırtıl"
				}
			]
		},
