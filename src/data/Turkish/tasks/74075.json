			"dialogs": [
				{
					"id": 740750201,
					"content": "Bizden önce başkası gelmiş! Paimon arkeolojik keşifte bizden daha iyi birisi olduğuna inanamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750202,
					"content": "Yerdeki şey... Bir cep saati mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750203,
					"content": "Normalde maceralarda yaptığımız gibi bu taş tablete de bir göz atmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750204,
					"content": "\"Burası Ruhlar Bölgesi, Ruhlar Tapınağı ve Ruhlar Odasıdır...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750205,
					"content": "\"Sana ebedi istirahatinde eşlik eder\"... \"Bir anda doğar, çelişkili de olsa hiç ayrılmaz\"... \"Hayatın en önemli hazinesidir\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750206,
						740750207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750206,
					"content": "Dostlarım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				},
				{
					"id": 740750208,
					"content": "Hımm... Değerli bir cep saati ve hayatın hazinelerinden biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750209,
					"content": "Aa Paimon buldu! Mora olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750210,
					"content": "Sanmıyorum ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750211
					]
				},
				{
					"id": 740750211,
					"content": "Haklısın, bir bilmecenin cevabı bu kadar kolay olamaz. O zaman şey olmalı... Adı neydi ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750212,
					"content": "Hah, \"zenginlik\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750213,
					"content": "Harika, bir yanlış cevabı daha elemiş olduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750214
					]
				},
				{
					"id": 740750214,
					"content": "Aşk olsun! Paimon'a neden güvenmiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750215,
					"content": "Madem çok zekisin, cevabı sen söyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750216,
						740750218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750216,
					"content": "Hava ne güzel ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750217
					]
				},
				{
					"id": 740750217,
					"content": "Of! Konuyu değiştirme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740750218,
					"content": "Neyse. Hadi ilerleyip etrafa bir göz atalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750219
					]
				},
				{
					"id": 740750219,
					"content": "Of! Cevabı bilmediğini kabul et işte! Utandığın için kaçmaya çalışma. Ay beklesene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
