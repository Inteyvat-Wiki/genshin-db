			"dialogs": [
				{
					"id": 710370601,
					"content": "Hepsi senin sayende oldu. Lütfen bunu al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370602
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370602,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370603
					]
				},
				{
					"id": 710370603,
					"content": "Ah, hadi ama. Bu kadar nazik olmaya gerek yok. Sonuçta Mora, Khedive'ın cebinden çıkıyor! Dur dur, şşş... En iyisi o cimri Sumerulu alim bizi duymasın diye sessiz olalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370604
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370604,
					"content": "*öksürür* Öhöm. Gidip Jinwu'yu bulalım mı? Muhtemelen yolda kafamıza takılan sorular hakkında onun deneyimlerine başvurabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370607
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370607,
					"content": "Tamamdır, seni daha fazla tutmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
