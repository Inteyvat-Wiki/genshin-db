			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370101,
					"content": "Of, bu kokuyu biliyorum! Bu madenlere inmeyeli çok oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370102,
					"content": "Tedbiri elden bırakma Qiong. Benim burnuma yabancı bir koku geliyor mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370103
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370103,
					"content": "Yani dosdoğru aşağı atlayamadık. Belki de vinç sallandığı için dikkatimiz dağılmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370104,
					"content": "Sen var ya... Yer üstünde çok zaman geçirdin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370105
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370105,
					"content": "Paimon herhangi bir koku almıyor... Tüm madencilerin burnu bu kadar hassas mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370106,
					"content": "Haha! Hassas bir burnun yoksa aşağıda uzun yaşayamazsın! Yine de sorun yaşayacağımızı sanmıyorum. Serçeler hâlâ capcanlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370107,
					"content": "Bakın, Lümen Kristali buraya kadar büyümüş. Son geldiğimizde durum böyle değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370108
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370108,
					"content": "Vay be, gerçekten de öyle! Hadi gidip bir bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370109
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370109,
					"content": "Yani... Paimon pabucu dama atılmış gibi hissediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7103702,
			"completionStepIds": [
				7103704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103704",
							"2"
						],
						"stepId": 7103704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370201,
					"content": "Lümen Kristali yüzeye çok yakın bir yerde ortaya çıkmış. Bunların yapısal bakımdan zarar görebilecekleri konumlarda ortaya çıkamayacaklarını düşünmüştüm hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370202,
					"content": "Bunlar yer altındaki o \"şeyin\" parçaları. Kayaların arasındaki boşluklarda ilerleyerek buraya kadar çıkıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370203
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370203,
					"content": "Hey! Saçmalamayı kes. Onlar aslında yakınlarda bulunan kayalardı. O yüzden bu hale geldiler. Bir çeşit dönüşüm geçirip kristale dönüştüler. Hepsi bundan ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370204,
					"content": "Yedi Yıldızın yapmamızı istediği analizlerde bunların genel olarak yakınlarda bulunan cevherlerden meydana geldiği ortaya çıktı. Bir çeşit dış güçten etkilenmişler ve bu tuhaf kristallere dönüşmüşler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370205
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370205,
					"content": "#Hey, şuraya bakın! Şu kristal tıpkı yanında taşıdığın Katalizöre benziyor {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370231,
					"content": "#{NICKNAME}, neden Lümentaşı Katalizörünü yanına alıp etrafa bir göz atmıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370232,
					"content": "İyi dedin. Katalizör de bu kristallerle aynı malzemeden yapılma. Birbirlerine benzer oldukları için doğal olarak birbirlerine tepki verirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370206,
						710370207
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370206,
					"content": "Çok ilginç...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				},
				{
					"id": 710370208,
					"content": "Hey, başka bir şey söylemeyecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370209,
					"content": "Şey, atışmayın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370210
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370210,
					"content": "Atışmıyoruz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370211
					]
				},
				{
					"id": 710370211,
					"content": "Evet, atışmıyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370212,
					"content": "Demek istiyorum ki atışıp atışmadığınız önemli değil. Zhiqiong ile birlikte az ileride geçici bir kamp kurmamız gerekiyor. Biz bununla meşgulken ortalıktan kaybolmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370213
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370213,
					"content": "Keşfettiğimiz kristaller bir sonraki keşfimizde çok kullanışlı olacak. Bunlardan başka bulursanız lütfen bana söylemeyi unutmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370214
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370214,
					"content": "Becerilerim henüz paslanmadı. Yani ham cevherin bir kısmını işlemenize yardım edebilirim. Maceralarınızda çok işe yarayacağından eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370215
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370215,
					"content": "Bir de, şey... Atışmayın, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370216
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370216,
					"content": "Tamam, tamam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370217,
					"content": "Anlaşıldı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370218
					]
				},
				{
					"id": 710370218,
					"content": "Aferin, işte böyle uslu durun. Size bir ara şeker getireceğim. Neyse, yakınlarda tuhaf bir şey bulursanız kısa süre içinde bildirin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370219
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370219,
					"content": "Bu arada, geçen sefer Jinwu'nun He Amca hakkında ne söylediğini hatırlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370220
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370220,
					"content": "#Hatırlıyorum. {NICKNAME}, hazır buradayken bana bir kez daha yardımcı olabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370221
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370221,
					"content": "He Amca madenlerdeki ihtiyar madencilerdendir. Kanyon madencileri birkaç yıl önce dağıtıldığında kaybolanlardan biri de oydu. İşitme güçlüğü yaşadığı için alarmları duymamış olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370222
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370222,
					"content": "Huishan Salonu ile Shenglu Salonunun verdiği ölüm aylıkları oldukça yüksektir. Üstelik ailesi onun cenaze törenini uzun zaman önce düzenledi... Her ne kadar gerçeküstü şeylere pek inanmasam da onun hâlâ buralarda bir yerde hayatta olduğunu hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370223
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370223,
					"content": "Oldukça tecrübeli bir madenciydi. Maden kazalarından kaçınmaktan tutun kaçmaya ve kurtarılmayı beklemeye kadar her konuda bilgi sahibiydi. Bana da çok şey öğretti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370224
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370224,
					"content": "Bu yüzden onun şu an bile buralarda bir yerde hayatta olduğunu düşünüyorum... Onu aramaktan vazgeçmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370225
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370225,
					"content": "Size madenciler dağıtılmadan önce onun son kez görüldüğü birkaç yeri göstereceğim... Kim bilir, belki de oralarda hâlâ birkaç ipucu bulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370226
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370226,
					"content": "Ben de kazı yapılan mağaraların derinliklerini keşfe çıkacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370233
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370233,
					"content": "Ah evet, şekerinizi almayı da unutmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370227,
						710370229
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370227,
					"content": "Bizimle gelmiyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370228
					]
				},
				{
					"id": 710370228,
					"content": "Haritalandırma konusunda hâlâ bize yardım etmesi gerekiyor. Kanyon'un yer altı madenlerinin yolları oldukça karmaşıktır. O haritalar olmadan pek yol katedemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370229,
					"content": "Dikkatli ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370230
					]
				},
				{
					"id": 710370230,
					"content": "Merak etmeyin. Sonuçta bu işte yeni değilim. Benim için endişelenmenize gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370207,
					"content": "Bu muhteşem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370208
					]
				}
			]
		},
		{
			"id": 7103703,
