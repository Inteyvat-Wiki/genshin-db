			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710370501,
					"content": "#Ah, {NICKNAME}! Gelmişsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370502,
						710370510
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370502,
					"content": "Jinwu'nun sana söylemek istediği birkaç şey var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370503
					]
				},
				{
					"id": 710370510,
					"content": "Burada yine ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370511
					]
				},
				{
					"id": 710370503,
					"content": "Yine güvenlik hakkında konuştu durdu, değil mi? Bunu duymaktan bıktım artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370504
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370504,
					"content": "Ben de madenlerde büyüdüm. Buradaki tehlikeler hakkında bilmediğim bir şey var mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370505
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370505,
					"content": "Bilinmeyen tehlikelere gelince... Eh, ihtiyarlarımız bir şeyin tehlikeli olup olmadığını deneyimlerine dayanarak anlarmış. Nihayetinde elde ettikleri sonuçları da deneyimlerini akla uygun hale getirmek için kullanırlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370506
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370506,
					"content": "Kibri artık burama kadar geldi. Eminim kıdemli bir maceracı olarak sen de benzer şekilde hissediyorsundur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370507
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370508,
					"content": "Tamam, beni ikna etmeye çalışmaktan vazgeç. Böyle saçma bir şey için seninle tartışmak istemiyorum. Konuyu değiştirebilir miyiz artık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370509
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370509,
					"content": "Yani, şuraya bir bak. Daha iyi haritalar çizmek için şu anda buradaki arazi üzerinde çalışıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370511,
					"content": "Dedim ya, arazi üzerinde çalışıyorum ve bir harita çiziyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370512
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370512,
					"content": "Sadece... Yolun ileri kısmının tuhaf bir... Madde yüzünden kapandığını keşfettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370513
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370513,
					"content": "Birkaç numune alsan veya fotoğraf çeksen eminim hem Sivil İşler Bakanlığı hem de Maceracılar Loncası çok memnun olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370514
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370514,
					"content": "Kendim yapardım ancak... Madenlere inerken Kameramı geride bıraktım. Yani şu an yalnızca sana güvenebilirim, hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370515
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370515,
					"content": "Birkaç farklı konum daha var... Aynen, şurası ve şurası. Bu bölgelerde Hazine Avcılarının izine rastladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370516
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370516,
					"content": "Üzgünüm ama neresi neresiymiş? Paimon dediklerinden hiçbir şey anlamadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710370517,
					"content": "Yalnızca birkaç çizgi çizdin ve X işareti yaptın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370518
					]
				},
				{
					"id": 710370518,
					"content": "Hahaha, özür dilerim... Alışkanlık işte. Herkesin haritacılığa doğuştan yatkınlığı olmadığını hep unutuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370519
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370519,
					"content": "Ancak sorun değil, sizi takip edip yolu göstereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370520
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370520,
					"content": "İlk olarak bu konumlardan herhangi birine gidebiliriz. Yani dilediğini seçebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370521,
						710370522
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710370521,
					"content": "Öyleyse gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710370522,
					"content": "Yoldayken dikkatli ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710370523
					]
				},
				{
					"id": 710370523,
					"content": "Çok düşüncelisin! Dikkatli olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
