			"dialogs": [
				{
					"id": 710371101,
					"content": "Hepsi senin sayende oldu. Lütfen bunu al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371102
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371102,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710371103
					]
				},
				{
					"id": 710371103,
					"content": "Ah, hadi ama. Bu kadar nazik olmaya gerek yok. Sonuçta Mora, Khedive'ın cebinden çıkıyor! Dur dur, şşş... En iyisi o cimri Sumerulu alim bizi duymasın diye sessiz olalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371104
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371104,
					"content": "*öksürür* Öhöm. Gidip Jinwu'yu bulalım mı? Muhtemelen yolda kafamıza takılan sorular hakkında onun deneyimlerine başvurabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371105
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371105,
					"content": "Biliyor musun? Jinwu bu konuda konuşmayı pek sevmez ama sen nasıl Ejdersırtı'ndaki kahramanlıklarınla ünlüysen o da madenlerde bayağı ünlüydü... *öksürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371106
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371106,
					"content": "Kendisinin Taşordu'nun arama ekiplerine rehberlik ettiğini ve birlikte birçok kişiyi kurtardıklarını duydum. Ancak bunlar geçmişte kaldı. Onu yeniden öfkelendirmek istemiyorum. O yüzden bunlardan pek bahsetmeyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710371107
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710371107,
					"content": "Tamamdır, seni daha fazla tutmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				}
			]
		}
	]
