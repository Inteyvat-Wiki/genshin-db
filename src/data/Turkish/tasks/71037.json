			"dialogs": [
				{
					"id": 710370901,
					"content": "Zhiqiong siz dönene dek haritayı bitirmiş olur diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710370902
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710370902,
					"content": "Yine de yer üstü nakil ekibinin buradaki aletleri değiştirmesini beklemem gerekiyor. Bu sırada etrafı dilediğiniz gibi keşfedebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
