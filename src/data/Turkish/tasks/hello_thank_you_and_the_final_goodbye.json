			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arana",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380101,
					"content": "Bir Ashvattha Ağacı... Tuhaf. Ashvattha Ağacının burada olmaması lazım. Altın Nara ve Uçuşkan Beyazlı... Arana kim olduğunuzu bilmiyor ama tanıdık geliyorsunuz. Kimsiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380102
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380102,
					"content": "Arana gerçekten her şeyi unutmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380103,
					"content": "#Paimon'un adı da Paimon. Bu da {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380104,
					"content": "Biz senin arkadaşlarınız Arana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380105
					]
				},
				{
					"id": 730380105,
					"content": "Hımm. Arana size inanıyor. Nezaket kokusu alıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380106
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380106,
					"content": "Arana şimdi anladı. Kalbimde önemli hatıraların akıp gittiği bir delik vardı ama sizi ve Ashvattha Ağacını görünce Arana şimdi çok daha iyi anladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380107
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380107,
					"content": "Arana yanlış görmediyse Bijayı aldınız, değil mi? Arana o meyveyi verebilmesi için Ashvattha Ağacına birçok hatırasını sundu ki arkadaşına yardım edebilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380108
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380108,
					"content": "Zekice, Arana. Peki o arkadaşı hatırlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380109,
					"content": "Hayır ama sorun değil. Bija sizde olduğuna göre Arana'nın güvendiği dostları ve Ashvattha Ağacının tanıdığı Naralar olmalısınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380110
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380110,
					"content": "Lütfen Bijayı Arana'nın zor durumdaki arkadaşına götürün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380111,
						730380113
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380111,
					"content": "Götüreceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380112
					]
				},
				{
					"id": 730380112,
					"content": "Bizimle gel Arana! Arkadaşın seni tekrar görmek istiyordur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380115
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380115,
					"content": "Arana gitmek istemiyor. Arana unuttu. Arkadaşım unutulduğunu görürse üzülür ve Arana'nın onu sevmediğini düşünür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380116
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380116,
					"content": "Yardım etmek istediğin arkadaşın harika bir insan... Yani Nara. Onu unutsan bile seninle arkadaş olmak isteyecektir, Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380117,
					"content": "O zaman birlikte gidelim olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380118,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380119
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380119,
					"content": "Arana'nın arkadaşları olduğunuz için Arana size inanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380113,
					"content": "Hadi birlikte gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380114
					]
				}
			]
		},
