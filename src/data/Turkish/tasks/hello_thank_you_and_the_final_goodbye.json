				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380201,
					"content": "Bu Arana'nın Ararakalarisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380202
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380202,
					"content": "O... Arana'nın Nara arkadaşı o mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380203
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380203,
					"content": "#Evet. Şimdi, {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380204,
					"content": "(Bijayı kullan.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7303803,
			"completionStepIds": [
				7303803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7303803",
							"2"
						],
						"stepId": 7303803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rana",
					"Paimon",
					"Arana"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380301,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380302,
					"content": "Kendinde misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380303,
						730380304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380303,
					"content": "Beni duyabiliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380305
					]
				},
				{
					"id": 730380305,
					"content": "#Yine mi uyuyakalmışım? Neredeyim? Merhaba {NICKNAME} ve Paimon. İyi olduğunuza çok sevindim! Soldurandan etkilenmenizden endişeleniyordum. Bir de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380306
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380306,
					"content": "Arana? Sen misin Arana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380307
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380307,
					"content": "Selam Nara dost.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380308
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380308,
					"content": "Hep seni bekledim. Biliyor musun, çok uzun bir rüya gördüm. Rüyada seninle ilk kez tanışıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380309
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380309,
					"content": "Rüyamda ormanda kayboldum. Ailemi de eve dönüş yolunu da bulamadım. Ağladım. Sen bunu duyup beni buldun ve bana şarkı söyledin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380310
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380310,
					"content": "Sonra birbirimizin en iyi arkadaşı olduk. Sık sık ormanda seninle takılmaya geldim. Bana bir çiçek hediye ettin ve bana çok şey öğrettin. Ormanın birçok sırrını gösterdin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380311
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380311,
					"content": "Mesela Yıldız Mantarlarının gökteki yıldızların yansıması olduğunu öğrendim. Nilotpala Nilüferinin çiçek açışını izleyebildim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380312
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380312,
					"content": "Nilotpala Nilüferinin çiçek açışını görmek ay tekrar doğana kadar şans getirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380313
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380313,
					"content": "Evet! Aynen öyle! Sonra da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380314
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380314,
					"content": "Rüyamda çabucak büyüyüp Vimara Köyü'ndeki herkesi koruyabilecek güvenilir bir Orman Gözcüsü oluyordum. Güvenilir yetişkinler ormanın peri masallarına inanmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380315
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380315,
					"content": "Seni tamamen unuttuğumu gördüm. Aranaralar hakkındaki hikayelerin çocuk masalları olduğunu, ormanın sadece çok ağaçlı bir toprak parçası olduğunu ve büyü diye bir şey olmadığını düşünmeye başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380316
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380316,
					"content": "Uyandığımda o kadar korktum ki. Senin hakkında her şeyi unutmaktan korktum. Öyle olsa ne yapardım bilmiyorum. Neyse ki sadece rüyaymış! Seni tekrar görünce çok rahatladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380317
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380317,
					"content": "Nerelerdeydin Arana? Beni ormana götürmeni bekliyordum. Hani şu sadece senin yanındayken ortaya çıkan gizemli ormana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380318
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380318,
					"content": "Özür dilerim. Arana artık hatırlamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380319
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380319,
					"content": "Nasıl olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380320
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380320,
					"content": "Evet. Arana'nın suçu değil Rana. Anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380321,
					"content": "\"Seni ararken Arana'yla karşılaştık. Dedi ki...\"",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730380322
					]
				},
				{
					"id": 730380322,
					"content": "Mawtiyima Ormanı'ndaki Mantarlar, Yağmurun Sonunda yaptığınız savaş, Harabe Devinin içi, güllerin arasında söylenen şarkı, Aranaraların kardeş gibi davranması, Utsava Festivalindeki güzel anlar...\\nRana ve Arana'ya Aranaralarlayken yaşadığınız her şeyi anlatıyorsunuz.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730380323
					]
				},
				{
					"id": 730380323,
					"content": "Demek her şeyi unutan bendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380324
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380324,
					"content": "Bija hatıralarla büyür. Paimon, Arana'nın seninle olan hatıralarına çok değer verdiğini ve meyvenin seni iyileştirirken bu sayede bazı hatıraları geri getirebildiğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380325,
					"content": "#Teşekkürler {NICKNAME} ve Paimon. Bana yardım etmek için çok uğraşmışsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380326,
						730380328
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380326,
					"content": "Önemli değil. Bizim için de çok faydalı bir macera oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380327
					]
				},
				{
					"id": 730380327,
					"content": "Evet! Ayrıca teşekkür etmen gerekenler Arana ve Arama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380329,
					"content": "Teşekkürler Arana. Ayrıca özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380330
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380330,
					"content": "*ağlar* Seni nasıl unuttum ben? Benden nefret ediyorsun değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380331
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380331,
					"content": "Arana bilmiyor. Arana unuttu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380332
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380332,
					"content": "Ama sorun değil. Eski Arana, Rana'nın iyiliği için hatıralarından vazgeçtiyse bugünkü Arana senin en kıymetli Nara olduğunu, hatıralardan bile değerli olduğunu biliyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380333
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380333,
					"content": "Şey, Paimon şimdi söyleyeceği şey Arana'ya haksızlık olur mu emin değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380334,
					"content": "#Fakat Araja, Aranaraların uzun yaşadıklarını söylemişti! Paimon ikinizin hâlâ tıpkı Paimon ve {NICKNAME} gibi değerli hatıralar biriktirebileceğini düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380335,
					"content": "Haklısın. Hâlâ birlikte geçireceğimiz bolca zaman var. Uçsuz bucaksız ormanı, dünyayı ve geleceği birlikte keşfedebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380336
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380336,
					"content": "Evet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380337
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380337,
					"content": "#Marana... Demek Solduran sorunu ben uyurken çözülmüş. {NICKNAME}, Paimon ve tüm Aranaralar, size nasıl teşekkür ederim bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380338
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380338,
					"content": "Ani olacak biliyorum ama Arana'yla bir yolculuğa çıkmak istiyorum. Vimara Köyü'ndeki çocukların yine tehlikeye girmesinden endişeleniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380339
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380339,
					"content": "Ah! Paimon kötü adam sorunumuzu hâlâ çözmediğimizi neredeyse unutuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380340,
					"content": "Elimde kiminle karşı karşıya olduğumuza dair birkaç ipucu var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380341
					]
				},
				{
					"id": 730380341,
					"content": "Ne? Kimmiş? Paimon'un niye bundan haberi yok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380342,
					"content": "Öyle mi? Kimmiş? Hadi söyle, kimse onları güzelce bir pataklamam lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380343,
						730380344
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380343,
					"content": "Ben hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380345
					]
				},
				{
					"id": 730380345,
					"content": "Hımm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380346
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380346,
					"content": "#Sana inanıyorum {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380347
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380347,
					"content": "Tuhaf gelebilir ama kötü adamın başımıza beladan fazlasını açtığını düşünüyorum. Yani çocuklar kaybolmasaydı daha sık devriyeye çıkmazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380348
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380348,
					"content": "Öyle yapmasaydım o Mantarlara denk gelmez ve zor durumda olanı asla yüzüstü bırakmayacak iki kibar insanla karşılaşmazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380349
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380349,
					"content": "#Tüm bunlar sizinle tanışmam için oldu. {NICKNAME}, Paimon, ikiniz de çok yardımcı oldunuz. Beni kurtardınız ve en iyi arkadaşımla tekrar bir araya gelmeme yardım ettiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380350
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380350,
					"content": "#Size ne kadar teşekkür etsem az {NICKNAME} ve Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380351
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380351,
					"content": "Önemli değil Rana! Bu arada, gidersen Iotham, Kavus ve Sudabeh seni özleyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380352
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380352,
					"content": "#Onlar sandığından daha güçlü. {NICKNAME} ile de tanışıyorlar. Ayrıca hiç dönmeyecek değilim ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380353
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380353,
					"content": "#Bir gün döneceğim ve onlara bir sürü harika hikaye anlatacağım. {NICKNAME} ile olduğu gibi Arana'yı da onlarla tanıştıracağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380354
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380354,
					"content": "Bu iyi işte. Paimon dönmeyeceksin diye endişeleniyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380355
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380355,
					"content": "O zaman benimle seyahate çıkar mısın Arana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380356
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380356,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380357
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380357,
					"content": "Benim yüzümden çok hatıra kaybettin ama Paimon'un dediği gibi birlikte yeni hatıralar biriktirebilir ve kalbindeki boşluğu doldurabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380358
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380358,
					"content": "Benim adım Rana. Arkadaşım olmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380359
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380359,
					"content": "Evet. Eskiden birbirimizin en iyi arkadaşıydık Narana. Yine öyle olacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380360
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380360,
					"content": "Hey, baksana! O...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380361
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380361,
					"content": "Rana'nın göğsünden kalp atışının sıcaklığıyla bir anda belli belirsiz ama parlak bir ışık çıkar.\\nRana elleriyle ışığı gizlemeye çalışır ama ışık kaynağı sanki bilerek yaparmış gibi Rana'nın ellerine geçer. \\nIşık söndüğünde Rana'nın elinde zarif bir takı belirir.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730380362
					]
				},
				{
					"id": 730380362,
					"content": "Bir Önsezi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380363
					]
				},
				{
					"id": 730380363,
					"content": "Paimon bunu daha önce hiç kendi gözleriyle görmemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380364,
					"content": "Demek tanrılar dileğimi kabul etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380365
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380365,
					"content": "#Harika! Buna sahip olduğuma göre artık endişelenmeden yolculuğa çıkabilirim! Hatta Soldurandan kalanlarla da kolayca başa çıkabilirim muhtemelen. Keşke savaşırken senin kadar iyi görünebilseydim {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380366
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380366,
					"content": "Yapmam gereken çok şey var. Önce herkese uyanık olduğumu söyleyeceğim. Tighnari'ye de yolculuğa çıkacağımı haber vermeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380367
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380367,
					"content": "#Tekrar teşekkürler Paimon ve Arana. Sana da {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380368
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380368,
					"content": "#Teşekkürler Altın Nara {NICKNAME} ve Paimon. Arana o hatıraları kaybetti ama sizin iyi Naralar olduğunuzu biliyor. Arana'nın Narana'yla buluşmasına yardım ettiniz. Arana çok mutlu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380369,
						730380372
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380369,
					"content": "Hepinizle tanıştığıma memnun oldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380370,
						730380371
					]
				},
				{
					"id": 730380370,
					"content": "Kendine iyi bak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380373,
					"content": "Rana ve Arana... Paimon yolculuğunuzun tadını çıkarmanızı diliyor. Umarım bizi unutmazsınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380374
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730380374,
					"content": "\"Ne rüzgara boyun eğ ne yağmura. Ne yaza boyun eğ ne ayaza...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380375
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380375,
					"content": "#Bu şiiri duymuştum. Bir gün tekrar karşılaşacağımıza eminim {NICKNAME} ve Paimon. O zaman daha güçlü olacağım tabii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380376
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730380376,
					"content": "Kesin yollarımız bir daha kesişecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730380371,
					"content": "Umarım ikiniz için de çok faydalı bir yolculuk olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380372,
					"content": "Hoşça kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380373
					]
				},
				{
					"id": 730380344,
					"content": "Henüz kesin bir kanıt yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380345
					]
				},
				{
					"id": 730380328,
					"content": "Bizim yerimize Arana ve Arama'ya teşekkür etmelisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380329
					]
				},
				{
					"id": 730380304,
					"content": "Bir şeyi yok gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380305
					]
				}
			]
		}
	]
}