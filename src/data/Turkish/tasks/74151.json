			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#Bayan Paimon, {M#Bay}{F#Bayan} {NICKNAME}! Kediyi besledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510302,
					"content": "Süper! Öyleyse gidip Bay Leroy'u görelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510303,
					"content": "... Ben bu konuda biraz endişeliyim açıkçası. Bizi görmeye çıkar mı bilemedim... Geçenlerde geldiğimde benimle konuşmadı bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510304,
					"content": "Siz gelmeden önce de kapıyı çaldım aslında ama tam dışarı çıkacakken o korkunç damadı araya girdi, sonra da onu tuttuğu gibi içeri götürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510305,
					"content": "Sonra da elime biraz şeker tutuşturup eve geri dönmemi söyledi. Kapıyı da suratıma kapattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510306,
					"content": "Bak sen şu işe... Benoit gayet güler yüzlü bir adam halbuki, ailesi neden bu kadar suratsız ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510307,
					"content": "Bay Leroy'un damadı dedi ki kayınpederi çok hastaymış, benimle konuşamazmış... Turp gibi görünüyordu aslında, neden konuşamıyormuş ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510308,
					"content": "Şu noktada makalemden çok Bay Leroy için endişeleniyorum doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510309,
					"content": "Hastaysa morali çok bozuktur şimdi adamcağızın. Annem hep hastaların bakıma ve ilgiye ihtiyacı olduğunu söyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510310,
					"content": "Benimle gelseniz olmaz mı? Şu damada Bay Leroy'un hastalığını sorarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510311,
					"content": "Acaba pastayı mı fazla kaçırdı, yoksa uyurken üstünü mü örtmedi? Öyleyse ne yapmamız gerektiğini annemle babama bir sorarım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510312,
					"content": "Neyse, bir kapıyı çalalım bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "Evet, şey... Ben onun damadından biraz korkuyorum da... Çok korkunç biri, biliyorsunuz siz de. Onunla konuşmama yardımcı olur musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510315,
					"content": "Sen canını sıkma Molli. İşin aslını öğreniriz şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510313,
					"content": "Onunla bir anlaşma yaptık sonuçta.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
