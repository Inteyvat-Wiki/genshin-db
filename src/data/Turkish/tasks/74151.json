					"nextDialogs": [
						741511102
					]
				},
				{
					"id": 741511102,
					"content": "Aynen öyle. İlk tanıştığımızda kibar kibar konuşuyorlardı ama sonra yüz seksen derece dönüverdiler...",
					"roleType": "TALK_ROLE_NPC",
