					"nextDialogs": [
						741511006
					]
				},
				{
					"id": 741511006,
					"content": "Paimon o kadar etraflıca düşünmedi ama o kadının konuşma tarzı Paimon'un da tüylerini diken diken etmişti doğrusu...",
					"roleType": "TALK_ROLE_NPC",
