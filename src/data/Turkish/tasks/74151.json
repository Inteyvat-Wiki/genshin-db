						741511005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511003,
					"content": "Benoit'yı böyle davranmaya damadı zorluyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511004
					]
				},
				{
					"id": 741511004,
					"content": "Daha iki kelime etmemişken damadı ona bakınca pısıp kaldığı için öyle diyorsun, değil mi? Adamı zorla içeri gönderdi resmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511007
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511007,
					"content": "Şimdi sen böyle deyince Paimon anladı nedenini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511005,
					"content": "Kızı ona baskı yapıyor olmalı.",
