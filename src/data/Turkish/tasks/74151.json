					{
						"sceneId": 3,
						"position": [
							3591.538,
							435.092,
							4530.267
						],
						"pointId": 7521
					}
				]
			},
			"dialogs": [
				{
					"id": 741510501,
					"content": "Daha önce gördüğünüz Athos kapıyı açar ve dışarı çıkar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510502
					]
				},
				{
					"id": 741510502,
					"content": "Yine gelip dikilmişler kapıya... Ne istiyorsunuz yahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510503
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510503,
					"content": "Benoit evde mi acaba? Hasta olduğunu duyduk da... Endişelendiğimiz için bir yoklamak istedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510504,
					"content": "Babam evde ama misafir ağırlayacak durumda değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510505
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510505,
					"content": "Nesi var acaba, öğrenebilir miyiz? Ailemden ona biraz ilaç bulmalarını isterim belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510506
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510506,
					"content": "Gerek yok. Ne ilaç gerekirse biz kendimiz alırız. Hoş, babamın ilaca ihtiyacı falan yok gerçi ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510507
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510507,
					"content": "İyi mi değil mi diye merak edip geldik işte. Bu kadar soğuk davranmana ne gerek var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510508,
					"content": "(Athos, Benoit'yı görmemizi istemiyor resmen!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510509,
						741510510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510509,
					"content": "(Evet, bir azar yemediğimiz kaldı...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				},
				{
					"id": 741510511,
					"content": "Sizi ilgilendirmeyen meselelerle fazla haşır neşir oluyorsunuz... Neyse, başka bir şey var mıydı? Yoksa ben gideyim artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510512
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510512,
					"content": "Dur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510513
					]
				},
				{
					"id": 741510513,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510514,
						741510516
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510514,
					"content": "Benoit gerçekten hasta mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510515
					]
				},
				{
					"id": 741510515,
					"content": "Tabii ki hasta. Üstelik durumu epey ciddi ama sorun yok, Morticia ve ben onu bir şekilde iyileştireceğiz... Siz bu mevzulara kafanızı yormayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510518,
					"content": "Athos? Bu ne gürültü patırtı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510519
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510519,
					"content": "Yok bir şey Morticia. Birkaç çocuk babamı görmek istiyormuş da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510520
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510520,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510521
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510521,
					"content": "Çocuklarla arandan su sızmıyormuş gerçekten baba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510522
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510522,
					"content": "Seni bu kadar görmek istiyorlarsa git de bir selam ver o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510523
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510523,
					"content": "Çok isterim... Gidebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510524
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510524,
					"content": "Tabii gidebilirsin baba. Karar senin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510525
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741510525,
					"content": "Kapı açılır ve Benoit yavaşça ortaya çıkar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741510526
					]
				},
				{
					"id": 741510526,
					"content": "Hah, demek sizdiniz ufaklıklar. Gelmişsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510527
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510527,
					"content": "Nasılsınız Bay Leroy?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510528
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510528,
					"content": "Ben mi? *öksürür* Şey, pek iyi değilim doğrusu ama merak etmeyin. Bol bol dinlenmeye çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510529
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510529,
					"content": "Kızım ve damadım bana çok iyi bakıyor, bir sıkıntım yok. Siz artık evinize gidin hadi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510530
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741510530,
					"content": "İyi olduğundan emin misin baba? Yorulduysan kendini zorlama, içeri gir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510531
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510531,
					"content": "Benoit, Athos'un o imalı bakışlarını görüp sessizce içeri girer.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510532
					]
				},
				{
					"id": 741510532,
					"content": "Buyurun, gördünüz kendisini. Babam gerçekten hasta diyorum size. Şimdi içiniz rahatladı mı? Başka bir şey yoksa artık ben de içeri gireceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510533
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510533,
					"content": "Biz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510534,
					"content": "Athos hepinizi görmezden gelir.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510535
					]
				},
				{
					"id": 741510535,
					"content": "Neyse, hiç değilse Bay Leroy'la biraz olsun konuşabildik. *iç çeker* Umarım çabucak iyileşir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510536
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510536,
					"content": "Onları rahatsız ettim galiba Bayan Paimon. Ben... Ben böyle olsun istememiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510537
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510537,
					"content": "Niye öyle diyorsun ama şimdi... Rahatsız falan etmedin! Paimon'a sorarsan buradaki asıl sorun Athos bir kere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510538,
					"content": "Bizimle konuşurken takındığı tavrı görmedin mi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510539,
						741510540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510539,
					"content": "Sen artık eve git hadi Molli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510541,
					"content": "#Öyle mi? {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510542,
					"content": "Doğru ya, eve dönmem lazım artık. Ailem buraya gelmemden hoşlanmıyor zaten. Bugün geldiğimi duysalar yine fırçayı yerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510543
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510543,
					"content": "Artık bir daha Bay Leroy'u görür müyüz bilmiyorum. Verdiği atıştırmalıkların çok lezzetli olduğunu söyleyecektim ona halbuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510544
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510544,
					"content": "Kendisini görürseniz siz iletirsiniz artık. Yani o iyileştikten sonra tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510545,
						741510546
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510545,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510547,
					"content": "Paimon da söz veriyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510548
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510548,
					"content": "#Tamam o zaman, {M#Bay}{F#Bayan} {NICKNAME}, Bayan Paimon... İkinize de çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510549
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510549,
					"content": "Artık eve gideyim ben. Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510550
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510550,
					"content": "#Ne düşünüyorsun öyle kara kara {NICKNAME}? Bir şey diyecek gibi bakıyorsun, ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510551,
						741510552
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510551,
					"content": "Şu tarafta konuşalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510553,
					"content": "Olur, gidip başka bir yerde konuşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510552,
					"content": "Böyle ulu orta konuşmayalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510546,
					"content": "Sana sözüm olsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510540,
					"content": "Paimon'la biz de eve döneceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510516,
					"content": "Neden Benoit'yı görmemize engel olmaya çalışıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510517
					]
				},
				{
					"id": 741510517,
					"content": "Bizimle ilgisi alakası olmayan insanların babamı görmesine neden izin vereyim ki? Misafir ağırlayacak halde değil diyorum size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741510510,
					"content": "(Bir anda böyle davranmaya başlaması da ilginç...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				}
			]
		},
