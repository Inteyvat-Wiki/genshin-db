						741511103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511103,
					"content": "Sırf babaları yanlarında diye yüzümüze gülmüşler demek ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511104
					]
				},
				{
					"id": 741511104,
					"content": "Hımm... Paimon bir düşünsün. Doğru diyorsun galiba. İlk tanıştığımızda da Benoit içeriye girdikten sonra damadı bir daha gelmeyin demişti bize.",
					"roleType": "TALK_ROLE_NPC",
