			},
			"dialogs": [
				{
					"id": 741500501,
					"content": "Son zamanlarda iyi uyuyabiliyor musun baba? Uykusuzluk sorunun ne durumda, düzeldi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741500502,
					"content": "Yok, şu sıralar çok daha iyiyim. İnanır mısın, bugünlerde kabus bile görmez oldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741500503,
					"content": "(Leroy ailesinin sesleri gitgide uzaklaşıyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vur"
				}
			]
		},
		{
			"id": 7415101,
			"completionStepIds": [
				7415101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415101",
							"2"
						],
						"stepId": 7415101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415104",
							"3"
						],
						"stepId": 7415104,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Molli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510101,
					"content": "Aa, dönmüşsünüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510102
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510102,
					"content": "#Paimon'un adı Paimon, bu da {NICKNAME}. Bundan sonra bize böyle hitap edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510103,
					"content": "Benoit'yı görmeye mi geldin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510104
					]
				},
				{
					"id": 741510104,
					"content": "Evet ama onunla konuşamadım ki bir türlü. *iç çeker* Böyle giderse makalemi tamamlayamayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510105
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510105,
					"content": "Makalen mi? Aa, Paimon hatırladı şimdi! Ödevin var diye iyilik yapıyordun, doğru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510106,
					"content": "Hiç de bile, ne kadar ayıp! Bay Benoit'ya gerçekten değer veriyorum ben bir kere. Kendisi çok... Düzgün konuşan biri. Evet evet, sohbeti çok düzgün biri o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510107
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510107,
					"content": "Haha, \"düzgün konuşan\" biri ne demek öyle? Cana yakın ve hoşsohbet falan mı demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510108,
					"content": "Her neyse işte. Bana yardımcı olur musunuz lütfen Bayan Paimon? Bu gidişle makalem biraz zor bitecek de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510109
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510109,
					"content": "Bay Leroy'un kedisini beslemesine yardım etmemle ilgili bir yazı yazmıştım aslında. Sonra öğretmenime gösterince bana yazımın \"marjinal ve baştan sona gerçek duygularla dolu\" olduğunu söyledi. Bir tane daha yazmam gerekiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510110
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510110,
					"content": "\"Marjinal\" ne demek oluyor ki? \"Orijinal\" falan olmasın o? Neyse, Paimon ne demek istediğini anladı. Demek o yüzden tekrar geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510111,
					"content": "Yani ödevim için geliyorum tabii, doğru ama Bay Leroy'la vakit geçirmeyi sevmiyor da değilim. Aileme ondan selam söylememi istedi, ben de selamını ilettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510112
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510112,
					"content": "Onun adını duyunca biraz suratları düşüyor gerçi, buraya gelmemi istemiyorlar. Nedenini anlamadım gitti doğrusu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510113
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510113,
					"content": "Eh, olay yazacağın makaleyse gayet kolay aslında. Tekrar kediyi nasıl beslediğinden bahset işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510114,
					"content": "İyi de hepi topu bir satır ediyor o! O kadarı da çok kısa, yetmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510115
					],
					"speakerTitle": "Molli"
				},
				{
					"id": 741510115,
					"content": "Biz de seninle gelelim o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510116
					]
				},
				{
					"id": 741510116,
					"content": "Evet, aynen öyle. Sen kediyi beslersin, biz de kapının orayı ve evin arkasını temizleriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510117,
					"content": "İşimiz bitince de kapıyı çalıp Benoit ile konuşuruz. Bu kadar içerik yeterli olur herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510118,
					"content": "Tabii ya, öyle yapabiliriz! Çok akıllısınız Bayan Paimon. Ben hemen gidip kediyi besleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Molli"
				}
			]
		},
		{
			"id": 7415103,
			"completionStepIds": [
				7415103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
