						741511206,
						741511207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511205,
					"content": "Elimizde hiç kanıt yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511208,
					"content": "Hımm, haklısın tabii ama... Nihayetinde ona yardım etmek için geldik buraya, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511209,
					"content": "Hem Molli, Benoit'ya atıştırmalıklarının çok lezzetli olduğunu söylememizi istedi, unutma. Boşuna mı söz verdik ona?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511210,
					"content": "Bizde söz senettir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511211
					]
				},
				{
					"id": 741511211,
					"content": "Hehe, Paimon bilmez mi! Hadi bakalım, saksıyı çalıştır da bir sonraki hamlemizi planlayalım o halde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511212,
					"content": "Biraz araştırma yapalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511213
					]
				},
				{
					"id": 741511213,
					"content": "Evet, hadi şu işin aslı astarı neymiş öğrenelim! Hımm... Önce neye odaklansak acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741511214,
						741511215,
						741511216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511214,
					"content": "Bu çiftin aslında kim olduğuna.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511217,
					"content": "#Doğru diyorsun! Herkes ayağını denk alsın... Uzman dedektifler Paimon ve {NICKNAME} şüphelilerin foyasını ortaya çıkarmaya geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741511215,
					"content": "Bu çiftin maksadına.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511216,
					"content": "Benoit'nın onlar hakkında ne düşündüğüne.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511217
					]
				},
				{
					"id": 741511206,
					"content": "Ortada fol yok yumurta yokken ne diyeceğiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741511208
					]
				},
				{
					"id": 741511207,
					"content": "Benoit bu olanlar hakkında ne düşünüyor bilmiyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
