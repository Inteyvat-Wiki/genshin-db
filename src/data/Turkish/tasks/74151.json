			"dialogs": [
				{
					"id": 741510901,
					"content": "Bu çiftte bir tuhaflık var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510902
					]
				},
				{
					"id": 741510902,
					"content": "Paimon da öyle düşünüyor. Birinin çenesi durmuyor, diğerinin gıkı bile çıkmıyor resmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510903,
					"content": "Geliş zamanları da son derece manidar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510904
					]
				},
				{
					"id": 741510904,
					"content": "Tam da Benoit saatlik çalışacak birilerini tutmaya çalışırken gelmelerinden mi bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510905
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510905,
					"content": "Euphrasie'nin dediğine göre altı ay önce hâlâ çalışacak birilerini arıyormuş. Tam da o sırada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510906
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741510906,
					"content": "Bu çift çıkageliyor ve onun evlatlık kızı ile damadı oluyorlar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510907
					]
				},
				{
