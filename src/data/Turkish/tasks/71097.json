			"dialogs": [
				{
					"id": 710970101,
					"content": "Arkaik Taşları bulabildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970102
					],
					"speakerTitle": "Muning"
				},
				{
