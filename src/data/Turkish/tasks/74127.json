			"dialogs": [
				{
					"id": 741270401,
					"content": "Tanrım... Çok yüksek, çok yüksek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270402
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270402,
					"content": "Enstitünün akademik seviyesini mi kastediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270403
					]
				},
				{
					"id": 741270403,
					"content": "Hayır, buranın ne kadar yüksek olduğundan bahsediyorum! Gerçi Enstitüdeki akademisyenlerin de bundan pek aşağı kalır yanları yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270404
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270404,
					"content": "Ama... *iç çeker* Enstitünün başına bunların geleceğini kim bilebilirdi ki? Yeni enstitü inşa edilirken nelerle karşılaşacağımız da meçhul zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270405
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270405,
					"content": "Son durak... Fontaine Araştırma Enstitüsü Yeterlilik Değerlendirme Temsil Bürosu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270406
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270406,
					"content": "Hepsini bir çırpıda söyledin, bravo!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270407
					]
				},
				{
					"id": 741270407,
					"content": "Teşekkür ederim ama nerede bu ofis? Enstitüde böyle bir ofis olduğunu bilmiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270408
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270408,
					"content": "Burası Desnos'un sorumluluğunda mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270409
					]
				},
				{
					"id": 741270409,
					"content": "Aynen öyle! Burayı da mı biliyorsunuz? Fahri Kıdemli Araştırmacıdan da bu beklenirdi zaten! Enstitü hakkında bilmediğiniz şey yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270410
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270410,
					"content": "Ah, Paimon şimdi hatırladı! Harabelerdeki ofisten mi bahsediyorsun? Oraya ofis demeye bin şahit lazım gerçi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270411,
					"content": "Belki de Bay Desnos kafanız karışmasın diye ofisin tam adını söylememiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270412
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270412,
					"content": "Önden buyurun lütfen. Benim de Bay Desnos'tan almam gereken bazı dosyalar vardı zaten. Onları aldıktan sonra tekrar Hukuk Dairesine geçeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270413
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270413,
					"content": "Bugün talihsizlikler bir türlü peşimi bırakmadı. Döneyim de biraz dinleneyim. Fontaine Araştırma Enstitüsünde işler biraz farklı yürüyor işte... Öhöm, benden bir şey duymadınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				}
			]
		},
