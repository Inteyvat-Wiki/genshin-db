			},
			"dialogs": [
				{
					"id": 741270201,
					"content": "Şey, Mary-Ann Hatıra Parkı burası mı? Beklediğim gibi görünmüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270202
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270202,
					"content": "Bay Roialte hayal kırıklığına uğrayacak. Burada birilerine konuşma yaptırmayı planlıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270203
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270203,
					"content": "Ancak etrafa bakınca burada konuşma yapılması pek mümkün değil. Grup fotoğrafı çekilecek meşhur bir yapı bile yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270204
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270204,
					"content": "Mekalardan bazılarını hatıra olarak yanında götürebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270205
					]
				},
				{
					"id": 741270205,
					"content": "Çok komiksiniz ama Hukuk Dairesine sığmaz onlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270206
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270206,
					"content": "Sığıyor olsaydı bile ben mekaları değerlendirmeye almayı, raporlamayı, kategorize etmeyi ve depoya kaldırmayı tercih ederdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270207
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270207,
					"content": "Hey! Alt tarafı şaka yapıyorduk. Aniden iş düşünmeye başlama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270208,
					"content": "Rapor demişken... Hâlâ belgeyi alamadım. Bay Roialte'ın canı yine sıkılacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270209,
						741270211
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270209,
					"content": "Choiseul işlerini zora mı sokuyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270210
					]
				},
				{
					"id": 741270210,
					"content": "Pek sayılmaz. Talebim tam olarak kurallara uygun değildi, reddedilmesine şaşırmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270212
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270212,
					"content": "Bildiğin üzere Enstitü yeniden yapılanma planları yapıyor. Bu nedenle Hukuk Dairesinde birtakım kaynak ve personel ayarlamaları yapılması gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270213
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270213,
					"content": "Hukuk Dairesi bu konuya büyük önem veriyor. Bay Roialte onların emriyle bölgede saha araştırması yapmak için bir ekip kurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270214
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270214,
					"content": "Bay Roialte sayımlarla ilgilenmek üzere Hukuk Dairesinde kaldı, ben de resepsiyonu organize etmek için Enstitü ziyaretine gideceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270215
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270215,
					"content": "Enstitü, Hukuk Dairesine bir mektup gönderecekmiş. Hazır ben zaten buradayken yanımda götüreyim dedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270216
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270216,
					"content": "Ancak Bay Choiseul, mektup gönderim sürecini ihlal edeceğini söyleyerek mektubu bana vermeyi reddetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270217
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270217,
					"content": "Süreç ihlali mi? Ne süreci?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270218,
					"content": "Belge teslimi için ayrıca bir süreç mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270219
					]
				},
				{
					"id": 741270219,
					"content": "Ah, sakın Paimon'a onay ve imza peşinde koşturacağımızı ve bürokratların çene çalmasını dinlemek zorunda olacağımızı söyleme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270220,
					"content": "Kısaca özetleyecek olursam Hukuk Dairesiyle yapılan resmi yazışmaların çoğu posta yoluyla gerçekleşir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270221
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270221,
					"content": "Ne? Yani... Aynı sokakta, karşı karşıya binalarda çalışan departmanlar bile posta ile mi haberleşmek zorunda yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270222,
					"content": "Evet, posta şart. Görüşmelerin \"takip edilebilir\" olması için bu sistem kullanılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270223
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270223,
					"content": "Daire çalışanları fazla çalışmaktan gocunmuyor belli ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270224
					]
				},
				{
					"id": 741270224,
					"content": "Herkes çoktan alışmış zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270225
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270225,
					"content": "Neyse, bir sonraki konuma gidelim. Bay Roialte'ın bıraktığı notu kontrol edeyim... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270226
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270226,
					"content": "Bu yerin adı... Enstitü Akademik Toplantı Salonu. Tuhaf... Geldiğimde bu tabelayı hiçbir binada gördüğümü hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270227
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270227,
					"content": "Ben yerini biliyorum, gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270228
					]
				},
				{
					"id": 741270228,
					"content": "Size güvenebileceğimi biliyordum! Olmasaydınız ne yapardım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270229
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270229,
					"content": "Çabuk olalım o zaman. Buralarda daha fazla kontrolden çıkmış meka olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270211,
					"content": "Choiseul ile orada neyi tartışıyordunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270212
					]
				}
			]
		},
