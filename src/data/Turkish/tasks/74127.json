			"dialogs": [
				{
					"id": 741270101,
					"content": "... Söylediğim gibi sayın Savcı, süreç bu şekilde ilerlemek durumunda ve yapabileceğim hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270102,
					"content": "Bay Roialte gereken belgelerin listesini gönderdi ve ben de hepsini hazırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270103,
					"content": "Ancak gelip bu belgeleri öylece alamazsın. Bu, mektup teslim yönetmeliğimize uygun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270104,
						741270105
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270104,
					"content": "Ne? Iaune!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270107
					]
				},
				{
					"id": 741270107,
					"content": "Selam Iaune. Çok iyi görünüyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270108,
					"content": "Siz de öyle. Hepsi Bay Roialte ve Bay Semaine'in yardımları sayesinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270109
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270109,
					"content": "#Sen de mi {NICKNAME} ile tanışıyorsun Iaune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270110
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270110,
					"content": "#Tabii ki. {NICKNAME} bana büyük bir iyilik yapmıştı. O olmasaydı şu an Hukuk Dairesinde çalışıyor olmazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270111
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270111,
					"content": "#Gerçekten mi? {NICKNAME} nasıl Fahri Kıdemli Araştırmacı olmuş belli oldu, hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270112,
						741270113
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270112,
					"content": "Moral düzeltmekte üstüme yoktur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270114,
					"content": "Ne olursa olsun, desteğiniz olmasaydı... Asla başaramazdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270115
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270115,
					"content": "Bay Choiseul size Fahri Kıdemli Araştırmacı mı dedi az önce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270116
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270116,
					"content": "Aynen öyle. Sertifikam bile var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270117
					]
				},
				{
					"id": 741270117,
					"content": "Fotoğrafı da var! Yanında Paimon da var ama Paimon'a sertifika vermediler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270118,
					"content": "#{NICKNAME}, imza attığı başarılarla dikkat çekince Enstitü ona Fahri Kıdemli Araştırmacı unvanı verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270119
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270119,
					"content": "Hangi \"başarılar\" diye soracak olursan... Sözü ona bırakayım da kendisi anlatsın. Önce iş konuşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270120,
					"content": "O belgeyi gerçekten sana şu anda veremem Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270121,
					"content": "Ancak daha önce de söylediğin gibi, Enstitünün yakınına gidip fotoğraf çekerken bir araştırmacının rehberliğine ihtiyacın olduğunu da biliyorum. Olsun, hiç sorun değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270122
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270122,
					"content": "#Bence {NICKNAME} tam bu iş için biçilmiş kaftan. Çevreyi de avucunun içi gibi biliyor zaten, bu görev tam ona göre.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270123,
					"content": "#Ne dersiniz {M#Bay}{F#Bayan} {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270124,
						741270125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270124,
					"content": "Tabii ki, hiç sorun değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270126,
					"content": "Çok naziksiniz. Siz bizimle olduğunuz sürece hiçbir sorun olmaz. Geldiğimde buralar kontrolden çıkmış mekalar ve canavarlarla doluydu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270127
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270127,
					"content": "Ama asıl amaç onların fotoğrafını çekmek değil. Doğrusunu söylemek gerekirse, Bay Choiseul...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270128
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270128,
					"content": "Sana yardım etmeyi ben de çok isterim Iaune, ancak süreçler bu şekilde işliyor ve elim kolum bağlı. Tek işi belge damgalamak olan düşük kademeli bir devlet memuruyum ben, lütfen üstüme gelme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270129
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270129,
					"content": "Pekala, geldikten sonra Bay Roialte'la konuşurum o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270130
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270130,
					"content": "Hoşça kalın Bay Choiseul. İyi günler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270131
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270131,
					"content": "Teşekkür ederim. Umarım Fontaine Araştırma Enstitüsünde keyifli zaman geçirirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270132
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741270132,
					"content": "#Rehberlik yapma sırası sizde {NICKNAME}. Önce Mary-Ann Hatıra Parkına gidelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270125,
					"content": "Iaune'a yardımcı olmak isterim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270126
					]
				},
				{
					"id": 741270113,
					"content": "Alt tarafı Damgamatik 3000'i tamir ettim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270114
					]
				},
				{
					"id": 741270105,
					"content": "Öyleyse daha sonra seninle tekrar buraya geleceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270106
					]
				},
				{
					"id": 741270106,
					"content": "#{NICKNAME}! Sizi görmek ne güzel. Çok şanslıyım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270107
					],
					"speakerTitle": "Iaune"
				}
			]
		},
