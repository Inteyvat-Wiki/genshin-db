			"dialogs": [
				{
					"id": 741270301,
					"content": "Akademik Toplantı Salonu burası mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270302
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270302,
					"content": "Binaya bakılırsa evet, bir salona benziyor. Ancak bunun neresi akademik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270303,
						741270304
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270303,
					"content": "Akademik kısmı, araştırmacıların kafasının içinde yer alıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				},
				{
					"id": 741270305,
					"content": "Neyse ki bugün buraya akademik işler için gelmedim. Bina nispeten... Sağlam görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270306
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270306,
					"content": "Sağlamlıktan başka bir özelliği yok zaten.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270307
					]
				},
				{
					"id": 741270307,
					"content": "Öhöm! Hadi etrafa bir bakalım. Bence burası toplu fotoğraf için gayet uygun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270308
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270308,
					"content": "İyi bir gözlem yeri bulayım da Bay Roialte beni haşlarsa elim boş dönmemiş olayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270309
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270309,
					"content": "#Lütfen benim için de birkaç fotoğraf çekin {NICKNAME}. Duyduğuma göre harika bir fotoğrafçıymışsınız, kesin benden çok daha iyisinizdir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270310
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270310,
					"content": "Hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 741270304,
					"content": "Bu kayaların pek akademik durmadığı kesin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270305
					]
				}
			]
		},
