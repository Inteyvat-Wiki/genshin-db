			"dialogs": [
				{
					"id": 741270501,
					"content": "Hükümdar hepimizi mekaların gazabından korusun... Burada ne arıyorsun Iaune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270502
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270502,
					"content": "Bay Roialte beni teftiş için gönderdi. Ben de gelmişken bir uğrayıp kahve getireyim dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270503
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270503,
					"content": "Ama iş yeriniz pek rahat görünmüyor... En azından \"ofiste\" bir odanız olur sanmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270504
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270504,
					"content": "Kahve için sağ ol sevgili Iaune. İş yerime gelirsek... O kadar da kötü değil. Baksana, en azından başımı sokacak bir çatım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270505
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270505,
					"content": "Yeterlilik değerlendirmelerini hâlâ sen mi yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270506
					]
				},
				{
					"id": 741270506,
					"content": "#{NICKNAME}! Yoksa... Fahri Kıdemli Araştırmacı mı demeliydim? Sizi gördüğüme çok sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270507
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270507,
					"content": "Peki senin suratın niye sirke satıyor Iaune?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270508
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270508,
					"content": "*iç çeker* Aslında şöyle oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270509
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270509,
					"content": "Mutsuzluğu yüzünden okunan Iaune olan biteni anlatır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270510
					]
				},
				{
					"id": 741270510,
					"content": "Hımm... Yazışmanın içeriği gizli olmasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270511
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270511,
					"content": "Sanmam. Cevap mektuplarında genelde \"Anlaşıldı\", \"Başka bir sorum yok\" ya da \"Bilmiyorum\" gibi şeyler yazar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270512
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270512,
					"content": "Yani en fazla mektubu çoğaltıp önemli bir mesele olduğunu anlatmak için başka bölümlere göndermişlerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270513
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270513,
					"content": "Ah, o yüzden bana da bir kopyasını yollamışlar demek... Bak bakalım, aradığın mektup bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270514
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270514,
					"content": "Bu nasıl olur? Bay Choiseul mektubu daha göndermediğini söylemişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270515
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270515,
					"content": "... Belki de diğer kurumlara daha göndermediği için öyle demiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270516
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270516,
					"content": "Yine bir şeyleri atlamış desene.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270517
					]
				},
				{
					"id": 741270517,
					"content": "Enstitüdekilerden korkulur, insanların sinirlerini zıplatmakta üstlerine yoktur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270518,
					"content": "Haline bakılırsa aradığın belgeyi bulduk galiba. Ben zaten birkaç kere okumuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270519
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270519,
					"content": "Bu, aradığın belgenin bire bir aynısı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270520
					]
				},
				{
					"id": 741270520,
					"content": "#Sizden de hiçbir şey kaçmıyor {NICKNAME}. Eminim Choiseul'un gönderdiği bütün mektuplar aynıdır Iaune.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270521
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270521,
					"content": "İstersen benimkini alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270522
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270522,
					"content": "İyi de Iaune onu alırsa sen ne yapacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270523,
					"content": "Hahahaha, hiç güleceğim yoktu! Benim gibi önemsiz bir çalışan o kıytırık mektubu kazara kaybetse ne olur sanki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270524,
						741270525
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270524,
					"content": "Fena fikir değil aslında.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				},
				{
					"id": 741270526,
					"content": "Gördün mü Iaune? Getirdiğin kahveler boşa gitmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270527
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270527,
					"content": "Olmaz. Bunu yapamam, yönetmeliklere aykırı bu. Ben dönüp resmi mektubun gelmesini bekleyeyim en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270528
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270528,
					"content": "Büyük resmi göremiyorsun sevgili Iaune. Aklını çalıştır biraz! Niye işleri bu kadar zorlaştırıyorsun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270529
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270529,
					"content": "Mektup eline kim bilir ne zaman geçecek... Mektubu ne kadar çabuk alırsan işleri de o kadar çabuk yoluna koyarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270530
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270530,
					"content": "Hayır beyefendi. Teklifiniz için teşekkür ederim ama yönetmeliklere karşı gelemem ben. Bir devlet memuru olarak görevlerimi yerine getirmekle yükümlüyüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270531
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270531,
					"content": "#Ben artık gideyim {NICKNAME}, Bay Desnos ve Paimon. Daha Bay Roialte'a rapor vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270532
					],
					"speakerTitle": "Iaune"
				},
				{
					"id": 741270532,
					"content": "Iaune ağır ve temkinli adımlarla uzaklaşır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741270533
					]
				},
				{
					"id": 741270533,
					"content": "*iç çeker* Iaune da aptallık etmese olmaz. Kafasını çalıştırmayı bilmiyor hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270534
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270534,
					"content": "Herkes işimi nasıl kolaylaştırırım diye bakıyor. O da en ufak meseleleri büyütüp formaliteleri yerine getireyim derken kırk takla atıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270535,
						741270536
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270535,
					"content": "Ne yapacaksın işte, onun da karakteri böyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270537,
					"content": "Kendisine saygım sonsuz ama bazen beni korkutuyor. Hukuk Dairesinde Roialte ve Semaine'den başka arkadaşının olmamasına şaşmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270538
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270538,
					"content": "Ben de onun arkadaşıyım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270539
					]
				},
				{
					"id": 741270539,
					"content": "Paimon da öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741270540,
					"content": "Bunu duyduğuma sevindim. Daha sık uğrayın da yalnız kalmasın. Her geçen gün sinirleri daha çok yıpranıyor sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270541
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270541,
					"content": "Mektup konusu için de bir şeyler düşüneceğim. Yakında Bay Choiseul'a uğrayacağım zaten. Mektupları postalamak için müsaade isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270542
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270542,
					"content": "Gönderirse birini hemen Iaune'a yollarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741270543
					],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270543,
					"content": "*iç çeker* İşte bu yüzden dostlarını iyi seçeceksin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Desnos"
				},
				{
					"id": 741270536,
					"content": "Iaune'u da böyle kabul edeceğiz artık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270537
					]
				},
				{
					"id": 741270525,
					"content": "Bu işini görür, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741270526
					]
				}
			]
		},
