			"dialogs": [
				{
					"id": 750530301,
					"content": "Başka ödül kalmadı. Ödül yoksa mücadele de bitmiş demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530302
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530302,
					"content": "Başka sorun var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530303,
						750530307,
						750530311
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530303,
					"content": "\"Gözler Tüylü Hedefin Üstünde\" hakkında daha fazla bilgi verir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530304
					]
				},
				{
					"id": 750530304,
					"content": "Uzun zaman önce kabile içinde nesilden nesile aktarılmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530305
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530305,
					"content": "Çiçek Tüyü Klanı için keskin gözlere sahip olmak önemlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530306
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530306,
					"content": "Bu nesil... Sorumlu benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530307,
					"content": "Bu kadar yavaş konuşmanın bir nedeni var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530308
					]
				},
				{
					"id": 750530308,
					"content": "Önceden kalma bir yara. Çok yüksek bir yerden düşmüştüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530309
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530309,
					"content": "Boğazım ve göğsüm... Artık eskisi gibi konuşamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750530310
					],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530310,
					"content": "Ancak ben bunun... Çok kötü olduğunu düşünmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				},
				{
					"id": 750530311,
					"content": "Merak etme, sorun yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750530312
					]
				},
				{
					"id": 750530312,
					"content": "Umarım iyi olursun. Görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Muepu"
				}
			]
		}
