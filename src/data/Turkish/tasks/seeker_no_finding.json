					"nextDialogs": [
						750110327,
						750110328
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110327,
					"content": "Evet, sadece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110329
					]
				},
				{
					"id": 750110329,
					"content": "Taş tabletten büyük bir gürültüyle ses yankılanmaya başlar.\\nSarsıntıyla birlikte yerdeki dev kayanın da gerçek şekli ortaya çıkar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
