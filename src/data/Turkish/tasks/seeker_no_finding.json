					"nextDialogs": [
						750110321,
						750110322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110321,
					"content": "Ses tonu da oldukça tanıdık geliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110323
					]
				},
				{
					"id": 750110323,
					"content": "Onu bırakan kişi Alev Çalan Bilge olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110324,
					"content": "Ne? Daha önce Alev Çalan Bilge'den bir işaret aldığınızı mı söylüyorsunuz yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110325
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110325,
					"content": "#{M#Evladım}{F#Kızım}, seni parlak bir geleceğin beklediği söylemiştim, değil mi? Bu kadar gelecek vaat etmeseydin sana bu kadar kanım ısınmazdı zaten! Hediyeyi nasıl alacağını anlayabildin mi peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110326
					],
					"speakerTitle": "Chikya"
				},
				{
