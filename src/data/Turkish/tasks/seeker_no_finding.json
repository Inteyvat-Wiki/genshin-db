					"nextDialogs": [
						750110319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110319,
					"content": "Rarr! Rarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110320,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}, Paimon'a yukarı bakmasını söylemenin bir faydası yok, baksa da göremez! Ama madem sen orada olduğunu söyledin...",
