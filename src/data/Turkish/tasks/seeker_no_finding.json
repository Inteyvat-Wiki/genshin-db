					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110313,
					"content": "Bir şey mi gördün? Demek bir şey gördün! Tanrım! Hediyeye layık olan sendin demek, ha?",
