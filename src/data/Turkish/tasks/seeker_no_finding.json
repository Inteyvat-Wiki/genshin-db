			"dialogs": [
				{
					"id": 750110201,
					"content": "Oh be, bu son mekanizma olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110202,
					"content": "Bunun da diğerlerinden bir farkı yok Chikya, herhangi bir tongaya düşmediğinden eminsin değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110203,
					"content": "Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110204,
					"content": "Tabii ki öyle bir şey olmadı! Kadim parşömenleri çözme konusunda yeteneklerime tamamen... Yani biraz... Ya da bir nebze güveniyorum işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110205
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110205,
					"content": "Kendine olan güvenin de her saniye azalıyor! İmdat, yardım edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750110206,
					"content": "Her neyse, bunun son mekanizma olmadığından adım gibi eminim. Yanlış hatırlamıyorsam çok daha büyük ve... Daha eksiksiz olması gerekmiyor muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110207
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110207,
					"content": "\"Uçan adalar\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110208
					]
				},
				{
					"id": 750110208,
					"content": "#Ümit vadettiğin doğru {M#evladım}{F#kızım} ama tam cümlelerle ve net bir şekilde konuşmazsan kimse seni anlamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110209
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110209,
					"content": "... Hazinenin gerçekliğine ve iksirin de var olup olmadığına gelince... Denemeden bilemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110210
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110210,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110211
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110211,
					"content": "Bu sefer olmazsa bir dahaki sefere, burada olmazsa başka yerde ama bir şekilde olacak! Denemeye devam ettiğin sürece mucize er ya da geç gerçekleşecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110212,
						750110214
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110212,
					"content": "İyimserliğin gerçekten de sınır tanımıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110213
					]
				},
				{
					"id": 750110213,
					"content": "Bunu bir iltifat olarak kabul ediyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110216
					],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110216,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110217
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750110217,
					"content": "#Hehe, bak, {REALNAME[ID(2)|SHOWHOST(true)]} bile heyecanlandı. Hadi o zaman {NICKNAME}, Filojistonu kullanarak mekanizmayı etkinleştir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chikya"
				},
				{
					"id": 750110214,
					"content": "Denemeye devam etmek için kendimizi motive edebilirsek en büyük mucize o olur işte...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750110215
					]
				},
				{
					"id": 750110215,
					"content": "Bizde öyle bir negatifliğe yer yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750110216
					],
					"speakerTitle": "Chikya"
				}
			]
