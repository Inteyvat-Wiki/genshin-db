			"trigger": {
				"objectNames": [
					"Kayvan",
					"Helbet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731040101,
					"content": "Lütfen, bana bir iyilik yapın! Yardımınıza gerçekten ihtiyacım var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040102
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040102,
					"content": "Yapamam. Lütfen git.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040103
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040103,
					"content": "Ay, o tartışma da neyin nesi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040104,
					"content": "Hey, yabancı. Buradaki hanımefendiyi ikna etmeme yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040105
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040105,
					"content": "Benden birkaç antikayı kurtarmamı istemeye geldi. Sabahtan beri başımın etini yiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040106
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040106,
					"content": "Hem balıklarımı korkutup kaçırdı ve hem de vaktimi almaya devam ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040107
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040107,
					"content": "Hanımefendi, ne bu telaş? Antikalarla para kazanmak mı istiyorsun yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040108
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040108,
					"content": "Hayır Bay Kayvan. Ben, Akademiden Helbet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040109
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040109,
					"content": "Bu antikaları Akademi buldu ve ben onları saklamakla yükümlüyüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040110
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040110,
					"content": "Ne yazık ki antikaları taşıyan gemide bir kaza olmuş. Bazı antikalar gemiden düşüp akıntıya kapılarak aşağıdaki nehre kadar gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040111
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040111,
					"content": "Öyleyse profesyonel bir kurtarma ekibi bul! Ne diye benim gibi bir balıkçıyı rahatsız ediyorsun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040112
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040112,
					"content": "Uygun bir kurtarma ekibi bulmak uzun sürer. İnsanların senin için \"Usta Oltacı\" dediğini duydum, neredeyse her gün nehirden kaybolan eşyalar bulup çıkarıyormuşsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040113
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040113,
					"content": "Ayrıca bu civarda da sık sık balık tutuyormuşsun. Ben de bu yüzden senden oltanı atıp antikaları bulmanı isteyebilirim diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040114,
						731040115
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040114,
					"content": "Çok çaresizmişsiniz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040117
					]
				},
				{
					"id": 731040117,
					"content": "Öhöm... Bayan Helbet, başınıza gelenlerden dolayı çok üzgünüm. Fakat ben sadece bir balıkçıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040118
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040118,
					"content": "Yalnızca balık tutmak için olta atarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040119
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040119,
					"content": "Bir tane balık bile tutamamışsın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 731040120,
					"content": "Öhöm! Ben yalnızca işime odaklanarak balık tutmak için eğitim aldım. Başka şeyler tutmayı hiç düşünmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040121
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040121,
					"content": "O yüzden başka birini bulmanız daha iyi olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040122
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040122,
					"content": "Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040123
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040123,
					"content": "Şöyle yapalım o zaman, senden antikaları tutmanı isteyecek değilim. Sadece başka bir yerde balık tutmanı istiyorum. Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040124
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040124,
					"content": "Balık tutman için sana para vereceğim! Lütfen, sana güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040125
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040125,
					"content": "Of... Ben bir balıkçıyım! Balıkçı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040126,
						731040127
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040126,
					"content": "Yeni bir yerde balık tutmak iyi olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040128,
					"content": "Hadi, yardım et bana lütfen. Ödemeni bile çoktan hazırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040129
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040129,
					"content": "Ne ısrarcıymışsınız siz de... Peki, değişiklik olsun diye gidebilirim sanırım. Nerede balık tutmamı istiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040130
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040130,
					"content": "Çok teşekkürler! Beni takip et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040131
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040131,
					"content": "Her zamanki gibi Gezgin. Lütfen, balık yemi olarak gereken malzemeleri bulmam için bana yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040132
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040132,
					"content": "Bir düşüneyim... Bu sefer Nane kullanacağım. Fakat hep gittiğim yerden toplanmış olmaları gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040133
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040133,
					"content": "Genel bölgeyi işaretledim ve gerisini sana bırakıyorum. Sen malzemeleri getirince ödemenin detaylarını konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040134
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040134,
					"content": "Bayan Helbet ve ben önce balık tutma yerine gideceğiz. Orada buluşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040127,
					"content": "Tamam, balıkçı biraz ondan biraz bundan yakalar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040128
					]
				},
				{
					"id": 731040115,
					"content": "Yani oltayı atan Kayvan ise...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731040116
					]
				},
				{
					"id": 731040116,
					"content": "Oltamı sadece balık tutmak için kullanıyorum, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040117
					],
					"speakerTitle": "Kayvan"
				}
			]
		},
