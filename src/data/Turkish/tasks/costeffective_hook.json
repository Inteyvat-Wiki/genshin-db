					"content": "Belki de ilgisini çekersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731041221
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731041221,
					"content": "Yani balık haricinde her şeyi tutmamdan dolayı mı?",
