						731040409
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040409,
					"content": "İşte bu! Kayıp antikalardan biri! Hasar görmemiş. İçine herhangi bir su canlısı falan da girmemiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040410
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040410,
					"content": "Gerçekten de bir antika yakaladın! Usta Oltacı isminin hakkını veriyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040411
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040411,
					"content": "Bu bir iltifat mıydı? Nedense pek mutlu etmedi beni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040412
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040412,
					"content": "İlk noktadaki antikayı kurtardık, bir sonraki... Balık tutma noktası da hemen batıda kalıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040413
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040413,
					"content": "Yola koyulalım. Ne kadar erken geri dönüp huzur içinde balık tutmaya başlayabilirsem o kadar iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040414
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040414,
					"content": "Tabii ki. Lütfen beni takip et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040415
					],
					"speakerTitle": "Helbet"
				},
				{
					"id": 731040415,
					"content": "Gezgin, bu sefer Harra Meyvesini yem olarak kullanacağız. İçimden bir ses bunun en uygun malzeme olduğunu söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040416
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040416,
					"content": "En iyi Harra Meyvelerinin yetiştiği yeri biliyorum. Ben sana yerlerini göstereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731040417
					],
					"speakerTitle": "Kayvan"
				},
				{
					"id": 731040417,
					"content": "İlk önce biz gideceğiz. Bir sonraki balık tutma yerinde görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kayvan"
				}
			]
