				"objectNames": [
					"Iris"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020102,
					"content": "Bu dişle ilgili bir fikrin var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020103
					]
				},
				{
					"id": 701020103,
					"content": "Diş mi? Bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020104
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020104,
					"content": "Hımm... Evet, hem şekli hem de boyutu biraz tuhaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020105
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020105,
					"content": "Karmaşık malzemeler konusunda uzman değilim... Orban konu hakkında bir şeyler biliyor olabilir, silah işlerken elinden her türden malzeme geçiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020106
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 701020106,
					"content": "Gidip bir ona sorsana. Hemen şurada, görmemen mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iris"
				}
			]
		},
		{
			"id": 7010202,
			"completionStepIds": [
				7010207
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
