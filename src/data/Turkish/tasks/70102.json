			"dialogs": [
				{
					"id": 701020301,
					"content": "Biraz daha Ejder Dişi buldum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020302
					]
				},
				{
					"id": 701020302,
					"content": "Uğrarsın diye umuyordum. Gidip Ejder Dişi toplamaya başlamadan önce... Ha, zaten toplayıp gelmişsin bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020303
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020303,
					"content": "Çok özür dilerim ama... Ufak bir sorunla karşılaştım. Bu malzemeye neyle vurursam vurayım ufacık bir parçasını bile yontamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020304
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020304,
					"content": "Sanki gerçekten Ejder Dişi... Eğer öyleyse okuduklarıma göre bu malzemeyi işlemenin çok spesifik birkaç yöntemi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020305
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020305,
					"content": "Yöntemlerden biri ejder dişinin bir çeşit... Ejderlerle ilgili \"enerjiyi\" emmesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020306
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020306,
					"content": "Sonra da diğer Ejder Dişlerini şekillendirmek için bu ejder enerjisiyle güçlendirilmiş diş kullanılıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020307
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020307,
					"content": "Ama bir şey nasıl ejder enerjisiyle güçlendirilir gram fikrim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020308
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020308,
					"content": "Herhangi bir fikrin var mı Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020309
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020309,
					"content": "Ne yapabileceğime bir bakayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020310
					]
				},
				{
					"id": 701020310,
					"content": "Harika! O zaman Ejder Dişini al bakalım, bu işlerin tümü sende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020311
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020311,
					"content": "Dişleri bile bu kadar sorun çıkarıyorsa ejderler gerçekten çok karmaşık yaratıklar olsa gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orban"
				}
			]
