				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Orban"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701020201,
					"content": "Sence bu diş nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020202
					]
				},
				{
					"id": 701020202,
					"content": "Diş mi? Sakın bana o dağda çöp arayıp durduğunu söyleme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020203
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020203,
					"content": "Hım, gerçi bir dişe göre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020204
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020204,
					"content": "Ne? Ne olmuş?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020205
					]
				},
				{
					"id": 701020205,
					"content": "Bu oldukça iyi bir örnek. Hem de çivi gibi sağlam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020206
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020206,
					"content": "Ayrıca bu hatlara bakınca... Ejder Dişine epey benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020207
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020207,
					"content": "\"Ejder Dişi\" derken ne demek istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020208
					]
				},
				{
					"id": 701020208,
					"content": "Bildiğimiz ejderin dişi. Ejder Dişinden yapılma silahlar inanılmaz kuvvetli ve keskin olur... Ayrıca tuhaf bir güç de barındırırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020209
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020209,
					"content": "Buna öyle her gün denk gelemezsin tabii... Duyacağın tüm hikayelerde yalnızca en meşhur kahramanlar Ejder Dişini alıp ondan silah üretebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020210
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020210,
					"content": "Dedikleri gibi, dişini almak için ejder öldürmeyi düşünüyorsan... Yanında ejder katili bir silah bulundur, yoksa o seni öldürebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020211
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020211,
					"content": "O zaman... Bu gerçekten ejder dişi mi yoksa değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701020212
					]
				},
				{
					"id": 701020212,
					"content": "Açıkçası ben hiç bizzat Ejder Dişi işlemedim, yani kesin bir yanıt veremeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020213
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020213,
					"content": "Bence bu devasa bir canavarın dişi filandır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020214
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020214,
					"content": "Her neyse, bunca çabanın ardından bunu hakiki bir Ejder Dişiymiş gibi düşünelim, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020215
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020215,
					"content": "Hımm, tabii ama bu silah yapmaya yetmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020216
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020216,
					"content": "Sen gidip üç Ejder Dişi daha bulurken ben de biraz araştırma yapıp bu malzemeyi nasıl işleyeceğimi öğreneyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020217
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020217,
					"content": "Ha, ayrıca <color=#00E1FFFF>Ejder Dişinin</color> yanı sıra bunu destekleyecek iyi de bir cevher gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020218
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020218,
					"content": "Bu yüzden dağdayken 50 parça <color=#00E1FFFF>Gümüş Yıldız</color> da topla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020220
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020220,
					"content": "Evet, bunların hepsinin yanında... Bir de <color=#00E1FFFF>Kuzey Diyarı Mızrak Prototipi</color> gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701020219
					],
					"speakerTitle": "Orban"
				},
				{
					"id": 701020219,
					"content": "Hepsini toplayınca tekrar yanıma gel.",
