			"dialogs": [
				{
					"id": 752380101,
					"content": "Çay hoşuna gitti mi? Yoksa biraz daha sert bir şeyler mi tercih edersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380102
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 752380102,
					"content": "Çay gayet güzel. Gündüz vakti içki içince kendimi suçlu hissediyorum. Çok sık yapmasam daha iyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380103
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380103,
					"content": "Neyse, sizi Natlan'a hangi rüzgar attı Bayan Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380104,
					"content": "Sadece etrafı gezip eski tanıdıkları ziyaret ediyorum. Ayrıca Fontinalia Festivalinde yardım etmeyi kabul ettiğin için sana teşekkür etmek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380105
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 752380105,
					"content": "Çok incesin. Gerçekten sırf bunun için mi onca yol teptin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380106,
					"content": "Şey... Geçen sefer nezaket gösterip lafını bile etmedin ama geçmişte başına dert olduğumun gayet farkındayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380107
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 752380107,
					"content": "Ha... Şu astınla olan meseleyi mi diyorsun? Robot Ineffa'nın da dahil olduğu olay hani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380108,
					"content": "Heh... Şu hayat ne garip, değil mi? Bir bakmışsın eski düşmanının patronuyla arkadaş olmuşsun... Hatta bir de bakmışsın senin patronun oluvermiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380109,
					"content": "Umarım bunu ufak bir özür hediyesi olarak kabul edersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380110
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 752380110,
					"content": "B-Bu... Sınırlı baskı... Yok artık, koleksiyon baskısı mı bu? Hem de en sevdiğim tür! N-Nereden bildin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380111,
					"content": "#{NICKNAME} önerdi. Kitap zevkine bayağı aşinaymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380112
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 752380112,
					"content": "#{NICKNAME} ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380113
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380113,
					"content": "(Of! İçimdeki bu karmaşa da neyin nesi? Sanki bir yandan mutlu oldum, bir yandan da utancımdan yerin dibine giriyorum.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380114
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380114,
					"content": "(Zevklerimi bilmesi gururumu okşadı ama bunu cümle aleme duyurmak zorunda mıydı? Keşke bunun yerine bana kendisi hediye etseydi!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380115
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380115,
					"content": "Hoşuna gitti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380116
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 752380116,
					"content": "Ah... T-Teşekkür ederim! Gerçekten çok incesiniz Bayan Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380117
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380117,
					"content": "#Eğer beğendiğin türdense, bir dahaki sefere yine getirebilirim. Tabii o zaman {NICKNAME} benimle birlikte seçmeye gelmek durumunda kalacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380118
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 752380118,
					"content": "... S-Seninle mi? Yani... Sırf bunu almak için kalkıp beraber kitapçıya mı gittiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380119
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380119,
					"content": "Evet. Olabildiğince güzel bir seçim yapmaya çok özen gösterdi. Belki bir dahaki sefere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380120
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 752380120,
					"content": "... Bir dahaki sefer olmasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380121
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380121,
					"content": "Şey... Ben... Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		},
