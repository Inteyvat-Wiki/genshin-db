			"dialogs": [
				{
					"id": 752380201,
					"content": "Hıh... Hele onu elime bir geçireyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380202,
						752380203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380202,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 752380204,
					"content": "Saat o kadar oldu mu? Pekala Bayan Guillotin, yolda dikkatli olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				},
				{
					"id": 752380203,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752380204
					],
					"speakerTitle": "Kukla"
				}
			]
		}
	]
