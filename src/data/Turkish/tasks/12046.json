			"dialogs": [
				{
					"id": 120460201,
					"content": "Mizuki, sonraki randevumuzu ayarlamaya geldik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460202,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460203
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120460203,
					"content": "Ah... Acıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460204
					],
					"speakerTitle": "Shiba Murasaki"
				},
				{
					"id": 120460204,
					"content": "Eyvah... Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460205,
					"content": "Uyandıklarından beri böyleler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460206
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 120460206,
					"content": "... Ağır bir sindirim problemi yaşıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460207
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460207,
					"content": "Hı? Nasıl? Dün gece çok mu fazla kabus yediler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460208,
					"content": "Sanmıyorum... Dün siz de dahil toplam dört müşterimiz oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460209
					],
					"speakerTitle": "Aikawa Susumu"
				},
				{
					"id": 120460209,
					"content": "O zaman diğer iki kişi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460210,
					"content": "Haklısın. Onların kabuslarında bir sorun vardı kesin... Rüyaları sindirme yeteneğimiz sayıyla bağlantılı değil yalnızca. Duygusal yoğunluğa da bağlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460211
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460211,
					"content": "Yani normal bir insanın bu derece kötü bir kabusu olmamalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460212
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460212,
					"content": "*öğürür*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460213
					],
					"speakerTitle": "Hyakujitsuhaku Shion"
				},
				{
					"id": 120460213,
					"content": "Durum kötü. Rüyaları bir an önce sindirmeleri için bir yol bulamazsam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460214
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460214,
					"content": "Biz ne yapabiliriz? Yardım edelim size!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460215,
					"content": "Dünkü o iki müşteriyi bulup kötü rüyalarının nedenini anlamamız lazım. Yoksa bir tedavi bulamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460216
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460216,
					"content": "#{NICKNAME}, Paimon, siz onlarla konuşmuştunuz. Nerede olduklarını bulabilir misiniz sizce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460217
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460217,
					"content": "Bir bakalım... Hımm, tekrar Emura Ichigensai'ye gideceklerini söylemişlerdi. Belki orada bulabiliriz onları!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460218,
					"content": "Önden buyurun. Ben de sizinle geliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yumemizuki Mizuki"
				}
			]
		},
