			"dialogs": [
				{
					"id": 120460301,
					"content": "Bugün erkenden denize açıldım ama dikkatim öyle dağınıktı ki ağımı kaybettim... Neyse, önemli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460302
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460302,
					"content": "Evet, bugün ben de bir aksilik yaşadım... Ama ne olacak ki? Birkaç haydut kaçtı diye dünyanın sonu değil ya, hahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460303
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460303,
					"content": "Hey, siz ikiniz! Murasaki ve Shion hastalandı, hem de sizin kötü rüyalarınız yüzünden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460304,
					"content": "Oo, birilerinin keyfi kaçık sanki? Çok komik, haha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460305
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460305,
					"content": "Değil mi? Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460306
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460306,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460307,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460308
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460308,
					"content": "Çok tuhaf davranıyorlar! Paimon çok agresif bir giriş yaptı ama hiç üzerlerine alınmadılar bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460309,
					"content": "... Müsaadenizle. Beyler, rüya düzenleme terapisi için dün akşam Aisa Hamamına gittiğinizi hatırlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460310
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460310,
					"content": "Öyle mi yapmışız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460311
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460311,
					"content": "Sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460312
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460312,
					"content": "Hım... Son zamanlarda kötü bir rüya gördünüz mü peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460313
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460313,
					"content": "Hayır, niye göreyim ki? Bu dünyada kabus görmeme neden olacak ne olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460314
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460314,
					"content": "Hım... Yok, aklıma bir şey gelmedi. Kötü rüyalar çok sık görülmez zaten, değil mi? Hem hayatın güzellikleri burnunun dibinde aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460315
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460315,
					"content": "Neler oluyor? Dün akşam neler yaptıklarını tamamen unutmuş gibiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460316,
					"content": "Yine de Paimon onların dediklerine inanıyor. Kabus görmüş gibi değiller hiç... Acaba Emura Ichigensai'nin rehberliği gerçekten işe yarıyor olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460317,
					"content": "#Hayır, belli ki şu anda normal düşünemiyorlar... {NICKNAME}, Paimon, iyice odaklanın. Pek alışılmadık bir şey deneyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460318
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460318,
					"content": "Vay be, ne yaptın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460319,
					"content": "Onların bilinçaltına girdim. Bilinçaltlarıyla bağlantıları kopmuş, ben de o yüzden erişebiliyorum. İnsanların rüyalarına girebilmem gibi tıpkı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460320
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460320,
					"content": "Hayır, hayıır! Bunu o haydutların yanına bırakmayacağım! Asla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460321
					],
					"speakerTitle": "Susukida",
					"speakerSubtitle": "Kızgın Susukida"
				},
				{
					"id": 120460321,
					"content": "Deniz bugün çok hırçın... Durulana kadar karada kalmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460322
					],
					"speakerTitle": "Umihiko",
					"speakerSubtitle": "Korkmuş Umihiko"
				},
				{
					"id": 120460322,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460323,
					"content": "Gördüğünüz üzere sorunları bir yere kaybolmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460324
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460324,
					"content": "Görünüşe göre Susukida'nın öfkesine hakim olamayan bir yapısı var, bu da haddini aşmasına neden oluyor. Eminim ki bu durum işinde çok fazla sıkıntı yaşamasına neden olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460325
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460325,
					"content": "Umihiko'ya gelince... Bir kez ölümün kıyısından döndükten sonra fırtınalı ve dalgalı denizlerden korkmaya başladığını düşünüyorum. Artık denize açılmak istemiyor, bu da geçimini çok kötü etkiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460326
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460326,
					"content": "Olumsuz duyguları bilinçlerinden alınıp bilinçaltında dolanmaya bırakılmış. Bu yüzden dışarıdan bakıldığında hissettikleri tek duygu mutluluk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460327
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460327,
					"content": "Ancak o bastırılmış duygular bilinçaltlarında gelişmeye devam edecek ve bir gün Murasaki ve Shion'a hazımsızlık yaşatan kabuslara neden olacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460328
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460328,
					"content": "Nasıl böyle olmuş peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460329
					]
				},
				{
					"id": 120460329,
					"content": "Bu eğer ki Emura Ichigensai'nin işiyse sanırım kendisi düşündüğümüz kadar açık sözlü bir dolandırıcı değil. Belki gerçekten insan duygularına etki etmenin yollarını biliyordur. Bu yüzden kimse aslında neler olduğunu görememiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460330
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460330,
					"content": "Dün buraya geldiğinizde tuhaf bir şey fark ettiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460331
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460331,
					"content": "Pek değil aslında. Bugünkünden çok daha ciddiydiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460332,
					"content": "Aslında, şimdi sen sorunca...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460333
					]
				},
				{
					"id": 120460333,
					"content": "Dün gördüğün o tuhaf rüya aklına geliyor ve Mizuki'ye anlatıyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120460334
					]
				},
				{
					"id": 120460334,
					"content": "Bunu hiç anlatmadın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460335,
					"content": "O an bunun üstüne düşünmemiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460336
					]
				},
				{
					"id": 120460336,
					"content": "Eyvahlar olsun... Bakın, hemen Emura Ichigensai'yi bulmamız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460337
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460337,
					"content": "Mizuki... Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460338,
					"content": "#Emura Ichigensai'de insanlık dışı bir şey var. Senin rüyan da bunu onaylıyor {NICKNAME}... Ondan sözde danışmanlık alan herkes onun kurbanı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460339
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460339,
					"content": "Bir an önce onu bulup durdurmazsak kurbanların psikolojileri geri dönüşü olmayacak şekilde zarar görebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460340
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460340,
					"content": "Eyvah... Bu adamlara biraz daha baskı yapsak iyi olacak galiba. Emura Ichigensai ne zaman burada olacak biliyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460341,
					"content": "Bu ne acele? Ne zaman geleceği neden önemli ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460342
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460342,
					"content": "Evet, hazır olduğunda gelecek zaten. Acele ettirmenin anlamı yok, heh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460343
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460343,
					"content": "Of, ne kadar sinir bozucu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460344,
					"content": "... Dün gece olanları hatırlıyorsunuz. İkiniz de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460345
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460345,
					"content": "Sadece bundan bahsetmek istemiyorsunuz. Çünkü bu kabusun varlığıyla şu an hissettiğiniz mutluluğu bağdaştıramıyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460346
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460346,
					"content": "Sadece bunu düşünmek bile içinizde ağır bir parçalanma hissi uyandırıyor. Bunu tam olarak kelimelere dökemiyorsunuz ancak tamamen çökmenin eşiğindesiniz... Doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460347
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460347,
					"content": "... Dur lütfen. Bunu düşünmediğimiz sürece her şey güzel olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460348
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460348,
					"content": "Emura Ichigensai'nin tedavisinin sizi yaralı ve savunmasız bıraktığı bariz. Ama merak etmeyin, sizi bu inkar durumundan vazgeçirmek için gelmedim buraya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460349
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460349,
					"content": "... Sorumuza cevap verdiğiniz sürece en azından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460350
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460350,
					"content": "Pekala... Ama gerçekten hiçbir fikrimiz yok. Biz zaten sorduk, tek bildiğimiz de bugün gelmeyeceği.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460351
					],
					"speakerTitle": "Susukida"
				},
				{
					"id": 120460351,
					"content": "Evet, ıı... Dünkü seans onu biraz yormuş gibiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460352
					],
					"speakerTitle": "Umihiko"
				},
				{
					"id": 120460352,
					"content": "Yine mi benden saklanmaya çalışıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460353
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460353,
					"content": "Gerçekten bir şey bilmiyorlar mı? Of. Çıkmazdayız galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460354,
					"content": "Nerede yaşadığını bilmiyorsunuzdur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460355
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460355,
					"content": "Hayır. Dün sorduk ama korumaları bile bilmiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460356,
					"content": "O halde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460357,
						120460358
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460357,
					"content": "Aradığını buldun mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				},
				{
					"id": 120460359,
					"content": "Sanırım evet... Artık kötü rüyalarının nedenini öğrendiğime göre doğru tedaviyi uygulayabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460360,
						120460361
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460360,
					"content": "Sen tedaviyi yap öyleyse.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460362,
					"content": "Aslında beni buraya getirerek üstünüze düşeni yaptınız zaten. Size daha fazla zahmet vermeyeyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460363
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460363,
					"content": "Bir sonraki terapi randevumuzu ayarlamak istediğimizi unutma! Emura Ichigensai hakkında endişelenmeyi ne kadar çabuk bırakırsan bizimle de o kadar çabuk ilgilenebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460364
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460364,
					"content": "O yüzden tüm bunlar çözülüp hamam eskisi gibi işlemeye devam edene kadar pes etmeyeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460365
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460365,
					"content": "Görünüşe göre tekrar yardımınızı kabul etmekten başka şansım yok. Murasaki ve Shion'un gereken tedaviyi aldıklarından emin olmam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460366
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460366,
					"content": "Tabii yardımınıza ihtiyacım var. Emura Ichigensai'yi bulursanız lütfen onunla iletişime geçmeyin. Önce bana haber yollayın ve ben gelene kadar gözünüzü üstünde tutun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460367
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460367,
					"content": "En son isteyeceğim şey kendinizi tehlikeye atmanız olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460368
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460368,
					"content": "Sen orasını düşünme! Biz zamanında kimleri kimleri yendik. Bu adam onların yanında devede kulak kalır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460369,
					"content": "Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460370
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460370,
					"content": "... İyi, tamam. Mesafemizi koruyup sana haber göndereceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460371
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460371,
					"content": "Güzel, hadi işe koyulalım o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460372
					],
					"speakerTitle": "Yumemizuki Mizuki"
				},
				{
					"id": 120460372,
					"content": "... Bu adamı bulacağını söylemen büyük cesaretti. Mizuki'nin daha fazla şey için endişelenmesini istememen çok güzel. Ancak... Şimdi ne yapacağız? Ya onu bulamazsak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460373
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460373,
					"content": "Çünkü fark ettiysen bu adamlardan bir şey çıkmayacak. Hiçbir şey bilmiyorlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460374,
						120460375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460374,
					"content": "Evet, hiçbir fikirleri yok cidden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460376,
					"content": "Bir dakika, haklısın. Dün bize bu yer hakkında bilgi veren oydu! Muhtemelen söylediğinden fazlasını da biliyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460377
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460377,
					"content": "Kaybedecek vakit yok! Büyük Narukami Tapınağına gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460375,
					"content": "Ama Miko bir şeyler biliyordur bence...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460376
					]
				},
				{
					"id": 120460361,
					"content": "Ben Emura Ichigensai'yi bulacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460362
					]
				},
				{
					"id": 120460358,
					"content": "Murasaki ve Shion'a yardım edebilecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460359
					]
				}
			]
		},
		{
			"id": 1204604,
			"completionStepIds": [
				1204604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204604",
							"2"
						],
						"stepId": 1204604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yae Miko"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2470.723,
							445.64,
							-4409.953
						],
						"pointId": 322100692
					}
				]
			},
			"dialogs": [
				{
					"id": 120460401,
					"content": "Genelde buralarda bir yerlerde olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460402,
					"content": "Fal kağıdı çekmeye mi geldiniz ufaklıklar? Yoksa bir arkadaşınızı görmeye mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460403
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460403,
					"content": "Ay! Sen de nereden çıktın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460404,
					"content": "Görüşmeyeli epey oldu Leydi Guuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460405
					]
				},
				{
					"id": 120460405,
					"content": "Beni gördüğünüze sevinmemiş gibisiniz. Sesin de aynı onun gibi sanki... Neyse, şaka bir yana, konu nedir? Epey keyifsiz duruyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460406,
						120460407
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460406,
					"content": "Birini bulmamız lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				},
				{
					"id": 120460408,
					"content": "Dün onun nerede olduğuna dair bariz bir ipucu vermiştim aslında. Hâlâ bulamadınız mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460409
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460409,
					"content": "Aa, demek dün özellikle ondan bahsettin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460410,
					"content": "... Konu dağılmasın şimdi. Benden yardım istemeye geldiniz sanırım, değil mi? Durumu bana açıklayabilir misiniz öyleyse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460411
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460411,
					"content": "Evet, haklısın... Bahsettiğin yere gittik ama kıl payı kaçtı resmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460412,
					"content": "Hemen sonra da bize artık daha fazla hasta görmeyeceği söylendi. Görünüşe göre huzurunu ve yalnız kalmayı seviyormuş. Yani onu nerede bulacağımıza dair hiçbir fikrimiz yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460413,
					"content": "*iç çeker* O yeri bulmak için o kadar uğraşmıştım oysa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460414
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460414,
					"content": "Paimon bu bilgi işe yarar mı bilmiyor ama dün onun hakkında bazı şeyler öğrendik. Mesela Emura Ichigensai'ye benzeyen biri daha önce Mizuki'ye terapi için gelmiş. Adı \"Emura Chuuya\" imiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460415,
					"content": "Bir dakika, ne? Emura Chuuya mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460416
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460416,
					"content": "Tanıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460417,
					"content": "Bir keresinde Yae Yayınevinden okur mektupları köşesine katkıda bulunanlar için bir etkinlik düzenlemesini istemiştim. Benim gibi düşünen insanlarla bir araya gelip sohbet etmenin güzel olacağını düşünmüştüm, ta ki... O çıkıp gelene kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460418
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460418,
					"content": "Yani baş belası Emura ile şifacı Emura aynı kişi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460419
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460419,
					"content": "Şu ana kadar öğrendiklerimize bakınca öyle duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460420,
					"content": "Pekala. O halde... Bu adrese gidip bir bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460421
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460421,
					"content": "Iı... Cidden mi? Kim böyle bir yerde yaşamayı seçer ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460422,
					"content": "Bir keresinde Yae Yayınevine bir düzine kitap siparişi vermişti, belirttiği adres buydu. Ödemeyi de teslimat sırasında yapmak istemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460423
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460423,
					"content": "Depo yöneticileri bunun bir şaka olduğunu düşündü ve sipariş reddedildi... Dolayısıyla şikayet mektubunda yer almaya hak kazandılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460424
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460424,
					"content": "Tabii dönüp bakınca neden orada yaşadığı çok açık. Onun gibi asosyal birinin hiçbir yerde hoş karşılanmayacağı belli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460425
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460425,
					"content": "Haklısın... Gelip seninle konuşmak çok doğru bir kararmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460426,
					"content": "Eski dostuma yardımcı olabildiysem ne mutlu bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460427
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460427,
					"content": "Mizuki'den mi bahsediyorsun? Ona yardım etmek mi istiyorsun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460428,
					"content": "Aisa Hamamına çok fazla yatırım yaptı. Bir arkadaşımın işinin sıkıntıda olduğunu görünce de endişelendim haliyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460429
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460429,
					"content": "Cidden mi? Çünkü dün kavga etmeye yer arıyor gibiydin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460430,
					"content": "Sanıyorum Mizuki rakip olduğumuzu söylemiştir size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460431
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460431,
					"content": "Sınıf arkadaşı olduğumuz zamanlardan beri böyle düşündü hep. Artık Büyük Narukami Tapınağının Guujisi olduğuma göre Aisa Hamamıyla elde ettiği başarılarla kendini kanıtlama ihtiyacı hissediyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460432
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460432,
					"content": "İsteyeceği son şey işler sarpa sardığı an gelip onu kurtarmam olacaktır... O yüzden yardım etmek istiyorsam onun hislerini gözetmeli ve dikkatli davranmalıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460433
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460433,
					"content": "Böyle düşünceli olman pek sık görülür bir şey değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460434
					]
				},
				{
					"id": 120460434,
					"content": "Bunu bir iltifat olarak kabul ediyorum... Mizuki başkalarına karşı hep çok düşüncelidir. Arada sırada birinin de onu düşünmesi güzel olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460435,
						120460436
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460435,
					"content": "Madem zor bir durumdasın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460437,
					"content": "Güzel, anladın hemen. Biraz daha sohbet etmek istersiniz eminim ama geldiğinizde aceleniz varmış gibiydi. Yola çıkmanız gerekmiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120460438
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 120460438,
					"content": "Aa, doğru! Hadi, Mizuki'ye haber verelim hemen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120460436,
					"content": "... Belki senin yerine ben yapabilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460437
					]
				},
				{
					"id": 120460407,
					"content": "Emura Ichigensai'yi nerede bulabileceğimizi biliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120460408
					]
				}
			]
		},
