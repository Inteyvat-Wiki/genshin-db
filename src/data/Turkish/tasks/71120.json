			"dialogs": [
				{
					"id": 711200101,
					"content": "Hey, uzak durun! Burası patronun bölgesi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200102
					],
					"speakerTitle": "Oturan Kaplan"
				},
				{
					"id": 711200102,
					"content": "Ne kadar da kabasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200103,
						711200106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200103,
					"content": "Siz de kimsiniz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200104
					]
				},
				{
					"id": 711200104,
					"content": "Kim olduğumuz sana bağlı. Uslu durursan arkadaş oluruz. Yok ben ille de burnumu sokacağım diyorsan ona göre davranırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200105
					],
					"speakerTitle": "Kıvrılmış Yılan"
				},
				{
					"id": 711200105,
					"content": "Şimdi aklını başına topla ve geldiğin yoldan geri dön!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Oturan Kaplan"
				},
				{
					"id": 711200109,
					"content": "Bu kadar şüpheci olmanıza gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711200110,
					"content": "Şüpheci mi? Orada dur bakalım... Biz yalnızca kapı görevlisiyiz. Şüpheli davranan birileri varsa onlar da her şeye burnunu sokan siz iki tuhaf tipsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200111
					],
					"speakerTitle": "Kıvrılmış Yılan"
				},
				{
					"id": 711200111,
					"content": "Her neyse, size söyleyecek bir şeyimiz yok. Bizi rahatsız etmeyi bırakın artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Oturan Kaplan"
				},
				{
					"id": 711200106,
					"content": "Şu \"patron\" dediğin adam da kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711200107
					]
				},
				{
					"id": 711200107,
					"content": "Şu \"patron\" dediğim adam da kimmiş... Ha! Kim olduğunu söylersem korkudan dudağın uçuklar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200108
					],
					"speakerTitle": "Oturan Kaplan"
				},
				{
					"id": 711200108,
					"content": "Bu senin iyiliğin için dostum! Sen en iyisi bazı şeyleri hiç kurcalama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711200109
					],
					"speakerTitle": "Kıvrılmış Yılan"
				}
			]
		},
		{
