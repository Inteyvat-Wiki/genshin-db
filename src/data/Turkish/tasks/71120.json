			"dialogs": [
				{
					"id": 711209101,
					"content": "Yine mi siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209102
					],
					"speakerTitle": "Oturan Kaplan"
				},
				{
					"id": 711209102,
					"content": "Burada dolanmayı bırakın arkadaşlar. Bizi görmemiş gibi davranın, biz de sizi görmemiş gibi davranalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209103,
						711209111
					],
					"speakerTitle": "Kıvrılmış Yılan"
				},
				{
					"id": 711209103,
					"content": "Burada neyi koruyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209104
					]
				},
				{
					"id": 711209104,
					"content": "Tahmin et bakalım, bize ne için para ödüyor olabilirler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209105
					],
					"speakerTitle": "Kıvrılmış Yılan"
				},
				{
					"id": 711209105,
					"content": "Ne? Neden ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209106,
					"content": "*öksürür* Öhöm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209107
					],
					"speakerTitle": "Kıvrılmış Yılan"
				},
				{
					"id": 711209107,
					"content": "(Yalnızca ikinize söyleyeceğim, başka birine söylemeyin sakın... İyice yaklaşın bakalım...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209108
					],
					"speakerTitle": "Kıvrılmış Yılan"
				},
				{
					"id": 711209108,
					"content": "(Tamam, Paimon seni dinliyor!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209109,
					"content": "Sizin gibi insanlardan kurtulmamız için!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209110
					],
					"speakerTitle": "Kıvrılmış Yılan"
				},
				{
					"id": 711209110,
					"content": "Aaaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711209111,
					"content": "Mağaranın içinden gelen tuhaf bir ses duydum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711209112
					]
				},
				{
					"id": 711209112,
					"content": "Gaz çıkardım ben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209113
					],
					"speakerTitle": "Oturan Kaplan"
				},
				{
					"id": 711209113,
					"content": "Şey... Evet. Gaz çıkardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711209114
					],
					"speakerTitle": "Kıvrılmış Yılan"
				},
				{
					"id": 711209114,
					"content": "Y-Yani her şey yolunda mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
