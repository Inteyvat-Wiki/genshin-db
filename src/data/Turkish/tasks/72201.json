			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Rero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010101,
					"content": "Kibar yolcular, lütfen bana acıyın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010102,
						722010103
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010102,
					"content": "Ne oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				},
				{
					"id": 722010104,
					"content": "Teşekkür ederim, bu ihtiyarın sıkıntılarını dinlediğin için teşekkür ederim... *iç çeker* Gel, gel. Az daha anlatayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010105
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010105,
					"content": "Hayatımda hiç güzel bir şey olmadı, asla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010106
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010106,
					"content": "Doğduğumda sorumlu rahip kazara lambanın birini devirip teyzemin uzun saçlarının tamamını yaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010107
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010107,
					"content": "Tanrım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010108
					]
				},
				{
					"id": 722010108,
					"content": "Sonrasında tuhaf bir hastalığa yakalandım ve o zamandan beri kronik hantallık yaşıyorum. Ondan sonra da beşikten düşüp altı kaburga kemiğimi kırmışım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010109
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010109,
					"content": "Biraz büyüdüğümde, babam mantardan boğularak ölmek üzere olan kuzenimi kurtarmak için savaş verirken kazara kafamın tepesine kürekle vurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010110
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010110,
					"content": "Sonra sevgili serçemi ailemin Wen Kamuy'u yedi ve sonrasında aynı Wen Kamuy uçurumun kenarından yaban domuzu tarafından itildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010111
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010111,
					"content": "Ardından beğendiğim kız kazara rahibi Büyük Yıldırım Kuşu'na kurban etti ve adadan sürüldü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010112
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010112,
					"content": "Büyüdüğümde büyük annem çirkinliğimin ve kederimin derdinden öldü ve peşinden büyük babam da aynı kaderi paylaştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010113
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010113,
					"content": "Ondan da sonra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010114
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010114,
					"content": "En azından avunacak bir ailen var değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010115
					]
				},
				{
					"id": 722010115,
					"content": "Aile konusunu açmışken... Yaşım geldiğinde büyücü hekimimiz çocuğum olamayacağını söyledi çünkü şey çıkarmışım... Dur göstereyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010116,
						722010117
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010116,
					"content": "Yok ben almayayım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010118,
					"content": "*iç çeker* Tamam. Son bir şey daha dinler misin? Sorun olmazsa benim için son bir şey yapmanı isteyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010119,
						722010120
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010119,
					"content": "Buyur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010121,
					"content": "Bir süre önce eşimi gömerken kazara alyansımı onun mezarına düşürdüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010122
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010122,
					"content": "Elimde kalan son şey o ama ruhunu kızdırırım diye korktuğum için kazıp çıkaramıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010123
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010123,
					"content": "Yani bu mezar hırsızlığı işi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010124
					]
				},
				{
					"id": 722010124,
					"content": "Şey, sen yabancısın... Bir sürü tuhaf iş yapmıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010125
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010125,
					"content": "Dur... Yani senin gibi bir yabancı, yerel ruhları korkutmaktan kaçınabilir demek istedim. Evet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010126
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010126,
					"content": "Chirai Tapınağına git. Mezarı hemen tapınağın yanında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010120,
					"content": "O tuhaf şeyi göstermediğin müddetçe...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010121
					]
				},
				{
					"id": 722010117,
					"content": "Çok fazla bilgi aldık, teşekkür ederim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010118
					]
				},
				{
					"id": 722010103,
					"content": "Yardım mı lazım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010104
					]
				}
			]
		},
