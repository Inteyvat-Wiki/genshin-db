					"Rero"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722010201,
					"content": "Ahahahaha! Tanrım, nefesim tükendi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010202
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010202,
					"content": "Ahaha... Çatlayacağım şimdi! Chikapu, keşke burada olsaydın da şunu görseydin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010203,
						722010204
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010203,
					"content": "Açıkçası beni sinirlendiriyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				},
				{
					"id": 722010205,
					"content": "Hahaha... Üzgünüm, üzgünüm. Lütfen kızma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010206
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010206,
					"content": "Ben ve eşim başkalarına şaka yapmayı çok severdik. Aynı şakayı bir daha yapmazdık ve herkes de bu şakalara bayılırdı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010207
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010207,
					"content": "Sonrasında ciddi bir hastalık geçirip bu dünyadan erken ayrıldı... Bana da mezarının önünde birisine şaka yapmam gerektiğini, aksi takdirde ruhunun öbür dünyaya gidemeyeceğini söyledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010208
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010208,
					"content": "Ben de öyle yaptım. Bu Chikapu'nun dileğiydi. Nasıldı? Oldukça iyiydi değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010209,
						722010210,
						722010211
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010209,
					"content": "Biraz dandikti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010212,
					"content": "Hadi ama! Siz yabancılar hiç eğlenceli değilsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010213
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010213,
					"content": "Neyse, görmek isterseniz hâlâ su fışkırtma şakam var... İstemez misiniz? Hadi ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722010214
					],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010214,
					"content": "Tamam, tamam, gidiyorum! Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rero"
				},
				{
					"id": 722010210,
					"content": "Neredeyse bizi öldürüyordun!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010211,
					"content": "Bundan sonra sana güvenmem zor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010212
					]
				},
				{
					"id": 722010204,
					"content": "Ne olup bittiğini anlatmak ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722010205
					]
				}
			]
		},
