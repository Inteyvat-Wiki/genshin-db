			"dialogs": [
				{
					"id": 200080101,
					"content": "Teşekkür ederim! Hayatımı kurtardınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080102,
					"content": "Bodurloplar bir anda geldiler. Buraya kadar gelmelerini beklemiyordum. Daha ne olduğunu anlayamadan etrafımı sardılar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080103,
					"content": "Lütfen bunu babama söylemeyin... Bodurlopların bu civarda gittikçe saldırganlaştığını söylüyor ve evde kalmam için ısrar ediyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080104,
					"content": "Bodurloplar şehrin yakınlarında görülmeye başlandığı için birkaç gündür evden çıkamıyordum. Bugün çaktırmadan kaçtım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080105,
					"content": "Acaba rica etsem sahil güvenli mi diye kontrol edebilir misiniz? Güvenli değilse de benim için onların üstesinden gelebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080106,
					"content": "Tabii, hemen hallederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "Harika! Babamın bunu öğrenmesine gerek kalmayacak sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				},
				{
					"id": 200080107,
					"content": "Üzgünüm, yapacak çok işim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "Her halükarda bu olay babamın kulağına gitmemeli... Lütfen, tek umudum sensin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arthur"
				}
			]
		}
