			"dialogs": [
				{
					"id": 710570133,
					"content": "Aniden arkandan gelen bir fısıltı sesi duydun:\\n\"Hehe... Mantar eti... Hehe...\"",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570101
					]
				},
				{
					"id": 710570101,
					"content": "Siz... Hehe, burada ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570102
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570102,
					"content": "Uf! Bu adam berbat görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570103,
					"content": "#Üstelik çıt bile çıkarmadan dibimizde bitti {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570104,
					"content": "Bu şey değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570105,
					"content": "Muhtemelen değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570106
					]
				},
				{
					"id": 710570106,
					"content": "Hehe, siz n-neden buradasınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570107
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570107,
					"content": "Sizin de mi yiyeceğiniz bitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570108
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570108,
					"content": "Sen He Amca mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570109
					]
				},
				{
					"id": 710570109,
					"content": "Ne... Ne diyorsun evladım? Seni duyamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570110
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570110,
					"content": "Diyorum ki sen He Amca mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570111,
					"content": "Aaah, evet. Hehe, o benim. Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570112
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570112,
					"content": "Siz de burada benim gibi mahsur mu kaldınız? Sizin de mi yiyeceğiniz bitti? *iç çeker* Ne talihsizlik bu böyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570113
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570113,
					"content": "Hehe, merak etmeyin ama. Burada biraz yiyeceğim var... Eminim şu anda açlıktan ölüyorsunuzdur... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570114
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570114,
					"content": "Paimon'un karnı guruldamaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570115,
						710570116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570115,
					"content": "Bu \"mantar eti\" bana çok şüpheli geldi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				},
				{
					"id": 710570117,
					"content": "Şey... Haklısın. Kafası uçuk gibi geldi bana biraz. Üstelik yüz ifadesi de bir garip. Paimon, bunların mantar etiyle bir ilgisi olduğuna bahse girebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570118,
					"content": "Mantar eti mi? Hehe. Evet, çok lezzetlidir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570119
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570119,
					"content": "Al, biraz ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570120
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570120,
					"content": "Hahaha, nasıl? Hımm... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570121
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570121,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570122,
					"content": "Mantar eti kalmamış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570123
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570123,
					"content": "Neyse, unut gitsin. Hadi şimdi kampa dönelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570124,
					"content": "Ben hiçbir yere gitmiyorum! Mantar etim bitmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570125
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570125,
					"content": "Mantar eti olmadan yürümeye bile takatim olmaz. Hiçbir yere gitmiyorum. Ne bir mantar eti var, ne de başka bir yerde yiyecek var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570126
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570126,
					"content": "Ama mantar eti olursa, ben her yere gidebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570127
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570127,
					"content": "O halde nerede mantar eti bulabiliriz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570128,
					"content": "Mantar eti... Hehe, onu nerede bulabileceğimizi biliyorum. Gidip size bulayım ben. Karnımızı doyuralım ki sonra çalışmaya gücümüz olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570129
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570129,
					"content": "Buralarda bir yerde olması gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570130
					],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570130,
					"content": "#Pekala {NICKNAME}. Paimon, onun dediğini yapmamız gerektiğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710570131,
					"content": "Bu şimdilik tek seçeneğimiz gibi görünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570132
					]
				},
				{
					"id": 710570132,
					"content": "Mantar eti... Hehe... Büyük mantar eti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "He Amca"
				},
				{
					"id": 710570116,
					"content": "Bulduğun her şüpheli şeye elinde tuzla koşma!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				}
			]
		},
