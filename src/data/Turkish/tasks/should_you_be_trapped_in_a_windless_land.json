			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Stanley"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130401,
					"content": "*iç çeker* Gidin. Sorularınızı kendinize saklayın, sadece... Beni rahat bırakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130402
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130402,
					"content": "Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130403,
					"content": "Gidin, şimdi! Bana tekrar söyletmeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130404
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130404,
					"content": "Fahri Şövalye! Venti! Ve Paimon! Burada olduğunuza sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130405
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130405,
					"content": "Her yerde sizi arıyordum! Kılıcı ve kalkanı bulmamda bana yardım ettiğiniz için tekrar teşekkür etmek istemiştim. Ailem sonunda beni destekliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130406
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130406,
					"content": "Aa... Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130407,
					"content": "Evet gerçekten! Hatta benim için Muhteşem Cesaret Kılıcını ve Görkemli Onur Kalkanını onarması için birini tutacaklar, böylece onları yola çıkarken yanıma alabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130408
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130408,
					"content": "Bu harika Jack! O zaman bu, Mondstadt'a veda edip Teyvat'ta cesur yolculuğuna başladığın anlamına mı geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130409
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130409,
					"content": "Hayır, henüz değil. Evden çok uzağa gidebilmek için gerekli özelliklere hâlâ sahip değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130410
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130410,
					"content": "Ayrıca Stanley'nin hâlâ anlatacak birkaç hikayesi kaldığına eminim. Haha... En başından beri bir maceracı olmam için ilham kaynağı oldular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130411
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130411,
					"content": "Stanley, Ben... Ah, yine sarhoşsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130412
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130412,
					"content": "Yarın görüşürüz o zaman. Ayıldığında belki bana hikayelerinden birkaçını daha anlatabilirsin, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130413
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 101130413,
					"content": "Stanley bu çocuğa gerçekten çok düşkün, sizce de öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130414,
					"content": "*hık* Jack? Jack!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130415
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130415,
					"content": "Jack gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130416,
					"content": "Ah, anlıyorum... Pekala, ona sırrımı söylemediğiniz için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130417
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130417,
					"content": "Birdenbire gerçeklerle mi yüzleşiyorsun? Bu pek senlik değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130418
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130418,
					"content": "Az önce... Ona bakmaya bile cesaret edemedim. Maceracı ruhu çok saf... Kusursuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130419
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130419,
					"content": "Yorgun, yaşlı, beceriksiz bir sahtekarım ama o çocuk, yepyeni parlayan bir yıldız, her şeyi yapabilir... Hayallerinin yıkılmasına izin veremem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130421
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130420,
					"content": "Tam olarak bir sahtekar değilsin... Stanley'nin macera hikayeleri ve deneyimleri... Hepsi gerçek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130421,
					"content": "Hikayeler... Deneyimler... Artık ne anlamı var ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130423
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130422,
					"content": "Dürüst olmak gerekirse maceralara ve Stanley'ye dair olan anılarım... Bugünlerde puslu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130424
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130423,
					"content": "Bu benim en büyük sırrım. Ve en büyük korkum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130425
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130424,
					"content": "Bunca yıldır hikayesini anlatmak için yaşıyorum. Ama onun kişiliğini ve hayatının detaylarını artık net bir şekilde hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130426,
					"content": "Hayatı boyunca suçluluk duygusu içinde boğulmuş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130427,
					"content": "Geriye kalan tek şey, bu hayali arkadaşı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130425,
					"content": "Ama asla unutamadığım bir şey var... Ruhuna asla ulaşılamayacak olan rüzgarsız bir yerde öldü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426,
						101130427
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130428,
					"content": "Aynen öyle... Gerçek Stanley, hatıralarında bile tanıdığı, yaşayan ve nefes alan arkadaşı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130429
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130429,
					"content": "Bunun yerine o yaralı savaşçı görüntüsüne takılıp kaldı... Ve bu görüntü, tüm yaşamı boyunca onu esir aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130430,
					"content": "Çok yaşlıyım... Asla bırakamıyorum ama yine de yitip giden çok şey var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130431
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130431,
					"content": "Tamamen işe yaramazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130432
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130432,
					"content": "Hiçbir maceracı, bu şekilde gitmek zorunda kalmamalı... Hiçbir maceracı asla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130433
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130433,
					"content": "Ben... Buna inanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130434
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130434,
					"content": "Hepinize teşekkür ederim! Ve teşekkür ederim Lord Barbatos...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130435
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130435,
					"content": "Üzgünüm, tekrar sakinleşmem biraz zaman alacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130436
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130436,
					"content": "Ama sanırım... İyi olacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130437
					],
					"speakerTitle": "Stanley"
				},
				{
					"id": 101130437,
					"content": "Ah, harika! Stanley, gerçek benliğiyle yeniden bağlantı kurdu ve Jack sonunda kendi yoluna gidebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130438
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130438,
					"content": "Bunu kutlamak gerekiyor! Ve kutlamayla kastettiğim tabii ki de kutsal şarap dökme merasimi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130439
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130439,
					"content": "Ve kutsal şarap dökme merasimiyle kastettiğin küfelik olana kadar bu handan çıkmayacağın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130440,
					"content": "Haha... Hayır. Buradaki şarap çok pahalı. Jack'in hâlâ bana bir şarap borcu var. Ona yardım etmemin karşılığında bana az bulunan yıllanmış bir şarap sözü vermişti, hatırlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130441
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130441,
					"content": "Gidip şarabı getireceğim. Birazdan görüşürüz! <color=#00E1FFFF>Her zamanki yerde</color> buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130442
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130443,
					"content": "Kim bilir neresi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130444,
					"content": "Sanırım nerede olduğunu biliyorum... Muhtemelen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130445,
					"content": "Tamam, orada görüşürüz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130442,
					"content": "Ha? Neresi o? Paimon, onu neden daha önce hiç duymadı? Hey, Detone Ozan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130443,
						101130444,
						101130445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130446,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 1011305,
			"completionStepIds": [
				1011305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011305",
							"2"
						],
						"stepId": 1011305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130501,
					"content": "Geldiniz... Sonunda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130502
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130502,
					"content": "Bir dahaki sefere bize tam olarak neresi olduğunu söyle, tamam mı? Her yere baktık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130503,
					"content": "Peki. En azından şarabını bulabildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130504,
					"content": "Evet! Yani, sayılır... Jack onu nadir, koleksiyonculara layık bir parça olarak sakladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130505
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130505,
					"content": "... İşin aslı, sadece yarım şişe normal bir elma şarabı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130506
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130506,
					"content": "Ah, bu beni geçmişe götürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130507
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130507,
					"content": "Bu manzarayı ilk gördüğümde henüz bu formda bile değildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130508
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130508,
					"content": "... Ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130509
					]
				},
				{
					"id": 101130509,
					"content": "Dünyanın Yedilerin hükümdarlığı altına girmesinden yaklaşık yirmi altı yüzyıl önceydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130510
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130510,
					"content": "O zamanlar Eski Mondstadt, şehrin çevresini şiddetli bir kasırgayla çevreleyen bir tiran tarafından yönetiliyordu. Kuşlar bile içeriye giremiyor ya da dışarıya çıkamıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130511
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130511,
					"content": "Eski Mondstadt mı? Ah, Paimon hatırlıyor. Günümüzde bu, Fırtına Dehşeti'nin İni olarak bilinir, değil mi? Daha önce bahsetmiştin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130512,
					"content": "Doğru. Bir zamanlar o kulede hüküm süren rüzgarların tiranı, Fırtına Tanrısı Decarabian'dı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130513
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130513,
					"content": "O zamanlar, binlerce rüzgar arasında küçücük bir şeydim. Hiçbir şeyin tanrısı değildim. Bir insan formunda bile değildim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130514
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130514,
					"content": "Rüzgarda yaşayan küçük bir varlıktım, umut yüklü hafif bir meltemden başka bir şey değildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130515
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130515,
					"content": "Küçük bir varlık mı? Bir insan formu almadan önce mi? Venti... Yani şu anda olduğundan farklı göründüğünü mü söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130516,
					"content": "Evet. Şu anki formum, sahte Stanley durumundan çok da farklı değil... Bir arkadaşımın formunu aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130517
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130517,
					"content": "Peki sonra ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130518,
					"content": "Arkadaşına ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130519,
					"content": "(Stanley'nin arkadaşıyla aynı durum...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130520
					]
				},
				{
					"id": 101130520,
					"content": "Söylesene Paimon, hikayenin diğer kısmını dinlemek istiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130521
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130521,
					"content": "Evet, elbette! Paimon meraktan ölüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130522,
						101130524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130522,
					"content": "Paimon, gidip bize birkaç elma topla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130523
					]
				},
				{
					"id": 101130523,
					"content": "Şimdi aniden elma istemenin zamanı mıydı? Ciddi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130526,
					"content": "Hahaha, biraz... Acıktım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130527
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130527,
					"content": "Ah, çok acıktım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130528
					]
				},
				{
					"id": 101130528,
					"content": "Paimon'un tahammül sınırlarını zorluyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 101130529,
					"content": "Ah... Biliyor musun, o kadar zekisin ki bu bazen beni sinir ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130530
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130530,
					"content": "Ama öte yandan belki de gerçek arkadaşlar birbirlerinin ne düşündüğünü anlayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130531
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130531,
					"content": "Ferahlatıcı bir içecek, hafif bir rüzgar... *iç çeker* Bunun gibi anlar her zaman beni geçmişe götürür...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130532
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130532,
					"content": "Ondan ilk kez duyduğum bir şarkıya götürür...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130533
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 101130533,
					"content": "Dinliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 101130524,
					"content": "Paimon, gidip bize biraz et ya da balık getirir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130525
					]
				},
				{
					"id": 101130525,
					"content": "Ama Venti hikayesini anlatıyor! Birden et ziyafeti mi çekesin geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}