					"content": "Stanley...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130212
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 101130212,
					"content": "Olaydan yıllar sonra artık onu tutacak arkadaşı bile yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130213
					],
