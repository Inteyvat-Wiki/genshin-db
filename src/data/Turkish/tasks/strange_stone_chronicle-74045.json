			"dialogs": [
				{
					"id": 740450201,
					"content": "Puca, biz geldik! Nişanını bulduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450202,
					"content": "Nişanı Puca'ya verirsiniz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450203
					]
				},
				{
					"id": 740450203,
					"content": "Aaa evet, işte bu! Çok teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450204
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450204,
					"content": "Nişanını ararken başka bir şey daha bulduk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450205,
					"content": "Daha önce hiç görmediğimiz bir cevher. Belki değerli olabilir diye onu da getirdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450206,
					"content": "Paimon yanlış hatırlamıyorsa eğer, bu bölgedeki güzel taşları topluyordun, değil mi? Daha önce bunun gibi bir taş görmüş müydün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450207,
					"content": "Bir bakayım... Gerçekten güzelmiş! Ama hiçbir değeri yok... Sıradan bir taş sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450208,
					"content": "Başka yerlerde bunun gibi bir taş bulamazsınız, doğru. Ancak bu, yakınlardaki cevher damarlarında sıklıkla bulunan bir taş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450209
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450209,
					"content": "Ay, demek sıradan bir taşmış! Paimon çok değerli bir şey sanmıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450210,
					"content": "Görünüşe göre onu başka bir şey için de kullanamayız. Bir yer bulup ondan kurtulalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450211,
						740450212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450211,
					"content": "Ama ya bu cevheri başka yerde bulamazsak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				},
				{
					"id": 740450213,
					"content": "Ah, bunu başka bir yerde çok iyi bir fiyata satabileceğimizi mi söylüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450214,
					"content": "#Mantıklı! İnsanlar genelde Melusina köyüne gelip de maden kazmazlar, yani büyük ihtimalle daha önce böyle bir şey görmemişlerdir... Çok iyi düşündün {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450215,
					"content": "Hadi, bu taşı Fontaine Şehri'ne götürelim ve tüccarlara gösterelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450216,
					"content": "Cevherler hakkında merak ettiğiniz bir şey olursa istediğiniz zaman yanıma gelebilirsiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450217
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450217,
					"content": "Ben, kız kardeşim gibi bir mücevher dükkanı işletmiyorum, dolayısıyla cevherlere değer biçme ve onları işleme konusunda pek bir bilgim yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450218
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450218,
					"content": "Değerli taşlara kıyasla, her türden benzersiz taşları toplamayı daha çok tercih ediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450219,
					"content": "Sanırım yerel cevher damarlarını çok iyi bildiğim söylenebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450220,
					"content": "Hehe, anlaşıldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450212,
					"content": "Ama ya bu bölgeye özel bir cevherse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450213
					]
				}
			]
		},
