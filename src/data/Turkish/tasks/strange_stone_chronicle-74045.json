			},
			"dialogs": [
				{
					"id": 740450401,
					"content": "Buyurun, hoş geldiniz! Mağazamızda tüm Fontaine Şehri'nin en geniş değerli taş seçenekleri sunulmaktadır. Ayrıca çok sayıda el yapımı ürünlerimiz de bulunmaktadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450402
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450402,
					"content": "Dikkatinizi çeken bir şey var mı? Ya da istediğiniz başka bir şey varsa hemen söyleyebilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450403
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450403,
					"content": "Elimizde birkaç tane gizemli cevher var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450404
					]
				},
				{
					"id": 740450404,
					"content": "Evet! Bu kadar geniş bir ürün yelpazesine sahip olduğunuza göre bu cevherin değerini de kesin bilirsiniz, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450405,
					"content": "Hı? Yani buraya cevher satmaya mı geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450406
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450406,
					"content": "O zaman doğru kişiye geldiniz! Fontaine'deki en iyi ve en adil teklifi biz veririz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450407
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450407,
					"content": "Elinizdeki cevhere bakalım öyleyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450408
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450408,
					"content": "Chesil'e daha önce bulmuş olduğunuz tuhaf cevheri gösteriyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740450409
					]
				},
				{
					"id": 740450409,
					"content": "Vay canına... Ben bile daha önce böyle bir şey görmemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450410
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450410,
					"content": "Eşsiz parlaklığı, pürüzsüz dokusu... Ah, kesinlikle çok nadir bir çeşit bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450411
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450411,
					"content": "Sorduğum için kusura bakmayın ama bu tam olarak nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450412,
						740450414,
						740450416
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450412,
					"content": "Hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450413
					]
				},
				{
					"id": 740450413,
					"content": "Bu yüzden mi buraya değerini öğrenmeye geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450419,
					"content": "Sadece bir parça getirmeniz yazık olmuş ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450420
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450420,
					"content": "Keşke düzenli bir tedarikimiz olsaydı... Fontaine'i kasıp kavuracak takılar yapardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450421
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450421,
					"content": "(Puca, bu taşların cevher damarlarının yakınlarındaki yerlerde bulunabileceğini söylemişti. Belki de ona sormalıyız...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450422,
						740450424,
						740450427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450422,
					"content": "Aslında elimizde bu cevherden çok var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450423
					]
				},
				{
					"id": 740450423,
					"content": "Gerçekten mi? Bu harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450430,
					"content": "Her neyse, getirdiğiniz cevherin dışında, yeni ürünler yapmak için sizden daha da fazlasını satın almaya hazırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450431
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450431,
					"content": "Samimiyetimi göstermek adına, bir sonraki gelişinizde daha fazla cevher getirmeniz kaydıyla size önden ödeme de yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450432
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450432,
					"content": "Ne diyorsunuz? Bence çok güzel bir anlaşma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450433
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450433,
					"content": "Hehe, Paimon da öyle düşünüyor! Anlaştık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450434
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450434,
					"content": "Harika! İşte ücretiniz burada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450435
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450435,
					"content": "Bu cevherden yapılacak olan takıların nasıl olacağını merak ediyorum... Haha, şimdiden sabırsızlanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450436
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450436,
					"content": "Güzel haberlerinizi bekliyor olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450424,
					"content": "Kaynağımız bir ticari sır olarak kalmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450425
					]
				},
				{
					"id": 740450425,
					"content": "Ah, doğal olarak elbette.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450426
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450426,
					"content": "Malları güvenli bir şekilde getirebildiğiniz sürece sorun yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450427,
					"content": "Elynas'ın yakınlarında çokça bulunabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450428
					]
				},
				{
					"id": 740450428,
					"content": "Hey! Ona niye söyledin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450429,
					"content": "Demek Elynas'tan aldınız ha? Evet, insanlar genelde oraya maden aramaya gitmezler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450430
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740450414,
					"content": "Şey, bu bir \"Paimon Taşı!\"",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450415
					]
				},
				{
					"id": 740450415,
					"content": "Hey, taşa tuhaf isimler vermesene!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450416,
					"content": "Bu bir Parlak Kristal Altın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450417
					]
				},
				{
					"id": 740450417,
					"content": "Vay! Bu isim de hemen burada mı aklına geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450418,
					"content": "Ne kadar etkileyici bir ismi varmış! Bu kadar eşsiz görünmesine şaşmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450419
					],
					"speakerTitle": "Chesil"
				}
			]
		},
