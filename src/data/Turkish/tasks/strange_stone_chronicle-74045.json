			"dialogs": [
				{
					"id": 740450601,
					"content": "Hey, yine mi siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450602
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450602,
					"content": "Cevherle ilgili öğrenmek istediğiniz bir şey mi var? Bana istediğini her şeyi sorabilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450603
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450603,
					"content": "Cevabı bilmesem bile sorabilirsiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450604,
						740450607,
						740450609
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450604,
					"content": "Değerli taşlar hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450605
					]
				},
				{
					"id": 740450605,
					"content": "Yakınlardaki cevher damarlarında çok güzel ve parlak taşlar var, ancak hiçbiri gerçek değerli taşlar kadar iyi değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450606
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450606,
					"content": "Gerçek değerli taşları bulmada da iyi olsaydım tıpkı Sluasi gibi ben de kendi mücevher atölyemi açardım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450607,
					"content": "Cevherin kullanım alanları hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450608
					]
				},
				{
					"id": 740450608,
					"content": "Ne? Bunu daha önce hiç düşünmemiştim... Sırf güzel oldukları için taşları topluyordum ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450609,
					"content": "Daha fazla sorum yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450610
					]
				},
				{
					"id": 740450610,
					"content": "Hehe, gelip benimle oynadığınız için teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				}
