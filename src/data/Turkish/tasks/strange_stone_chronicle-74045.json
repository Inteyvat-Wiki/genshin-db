			"dialogs": [
				{
					"id": 740450101,
					"content": "Puca, burada ne yapıyorsun yine?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450102,
					"content": "Yakınlarda başka canavar kalmamış olmalı ama kim bilir başka ne tehlikeler vardır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450103,
					"content": "Her neyse, kafana göre sağa sola gitme sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450104,
					"content": "#Paimon ve {NICKNAME}, ben kafama göre bir yere gitmiyorum, sadece kaybolan nişanımı arıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450105
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450105,
					"content": "Ne? Kaybolan nişanını mı arıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450106,
					"content": "Evet... Genelde taş topladığım o yerin yakınlarında bir yerde olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450107
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450107,
					"content": "Hımm... Mahsur kaldığın zaman düşürmüş olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450108,
					"content": "*burnunu çeker* Evet, haklı olabilirsin... O kadar korkmuştum ki başka şeyleri düşünecek halim yoktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450109
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450109,
					"content": "Düşününce hâlâ içimi bir korku alıyor, ancak nişanım çok önemli... Onu kesinlikle bulmam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450110
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450110,
					"content": "Hımm... Paimon, Puca'nın oraya tek başına gitmesinin çok tehlikeli olduğunu düşünüyor. Bu durumda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450111,
					"content": "#{NICKNAME}, oraya geri gidip Puca'nın nişanını aramaya ne dersin? Puca, sen bizi evde bekle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740450112,
						740450113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740450112,
					"content": "O iş bizde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				},
				{
					"id": 740450114,
					"content": "#Teşekkürler {NICKNAME} ve Paimon! Uslu bir şekilde evde sizi bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Puca"
				},
				{
					"id": 740450113,
					"content": "Orayı ben de keşfetmek istiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740450114
					]
				}
			]
		},
