			"dialogs": [
				{
					"id": 750791501,
					"content": "Tebrikler, mücadeleyi tamamladınız! Ödülünüzü Lamizana'dan alabilirsiniz. Yakında bir yerlerdedir, hemen görürsünüz zaten.",
					"roleType": "TALK_ROLE_NPC",
