			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paran"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791801,
					"content": "Üzgünüm Bayan Quilla. Bulut size zarar verdi mi? Genelde yabancılara böyle sırnaşmazdı aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791802
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750791802,
					"content": "Haha, sorun değil, bir şeyim yok. Hayvanlara bayılırım zaten. Böyle yakın davranması beni mutlu ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791803
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750791803,
					"content": "Ha, sahi ya. Hawka da seni çok özlemiş bu arada. Yakında buraya geleceğimi duyunca bana senin nasıl olduğunu sordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791804
					],
					"speakerTitle": "Quilla"
				},
				{
					"id": 750791804,
					"content": "... Hawka Amca mı? İyi de o beni niye özlesin ki? Şey... Kusura bakma, tartışma yaşadığımız bazı konular oldu da... Anlatmaya bile değmez hiç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paran"
				}
			]
		},
		{
