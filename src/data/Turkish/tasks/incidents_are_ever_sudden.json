			},
			"dialogs": [
				{
					"id": 750875101,
					"content": "Birkaç uçuş mücadelemiz daha var. Detayları panoda yazıyor. İlgini çekiyorsa bir dene... Tabii kazanılacak ödüller de var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875102,
						750875103,
						750875104
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875102,
					"content": "Pakpaka Uçuş Okulu hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875105
					]
				},
				{
					"id": 750875105,
					"content": "Adı nereden geliyor bilmiyorum... Ama Pakpaka demişken... Kuntur ile kötü büyücü Rumi'nin hikayesini duydun mu hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875106
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875106,
					"content": "O uğursuz büyücü, kabilenin savaşçılarını alt edip onları Pakpakalara dönüştürmüş... Hiç hoş gelmiyor kulağa. Belki Pakpakalar hızlı uçuyordur, bilemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875103,
					"content": "Lamizana hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875107
					]
				},
				{
					"id": 750875107,
					"content": "Haha... İyi bir savaşçı evet ama iyi bir öğretmen sayılmaz. Uçuş yarışmalarında bir rakip olaraksa... İdare eder sanırım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875108
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875108,
					"content": "Ama yani uçuşla ilgili bir sıkıntın varsa neden buraya gelirsin ki? Çok katı olmam gerekirse... *iç çeker* Neyse, geçmişte de benzer olaylar yaşanmadı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875109
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875109,
					"content": "O yüzden bugünlerde insanları cesaretlendirmeye çalışıyorum. Bu yaklaşım da iyi sonuçlar getirir elbet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750875104,
					"content": "Gitmem gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875110
					]
				},
				{
					"id": 750875110,
					"content": "Görüşürüz. Ne zaman istersen gelebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				}
			]
		},
