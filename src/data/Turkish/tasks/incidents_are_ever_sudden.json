			"dialogs": [
				{
					"id": 750791901,
					"content": "Üff, bir de bu çıktı başıma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791902,
						750791905
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791902,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791903
					]
				},
				{
					"id": 750791903,
					"content": "Şey, benden yaşça küçük bir erkek kardeşim var. Ergenlik çağında olduğundan mıdır nedir, kimseyle geçinemiyor bu çocuk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791904
					],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791904,
					"content": "Aman, gerçi boş ver şimdi bunları. İşin başından aşkındır zaten, hiç kafanı ütülemeyeyim. Büyüyünce geçer herhalde bu asilikleri!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				},
				{
					"id": 750791905,
					"content": "Rahatsız ettiysem kusura bakma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791906
					]
				},
				{
					"id": 750791906,
					"content": "Sorun değil. Güle güle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lliwa"
				}
			]
		},
