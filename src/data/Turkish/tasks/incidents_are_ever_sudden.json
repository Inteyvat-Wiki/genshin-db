			"dialogs": [
				{
					"id": 750790301,
					"content": "#Hoş geldiniz... Hımm, anlaşılan içinizden biri uçuş becerisinde uzmanlaşmış bile. Ee, uçmayı öğrenmek isteyen {M#genç adam}{F#genç hanım} bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790302,
						750790304
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790302,
					"content": "Benim zaten uçuş ehliyetim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790303
					]
				},
				{
					"id": 750790303,
					"content": "Uçuş ehliyeti mi? Bir yaşıma daha girdim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790305
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790305,
					"content": "Biz burada Sürüngenlerin ve binicilerin birlikte gelişmesini hedefliyoruz. Partnerin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790306
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790306,
					"content": "Rarr... Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790307
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790307,
					"content": "Hımm, kusura bakma ufaklık. Pakpaka Uçuş Okulunun yeteneklerini gösterebileceğin bir yer olduğunu sanmıyorum. Bu senin suçun değil tabii, kişisel algılama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790308
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790308,
					"content": "Raarr?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790309
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]} henüz genç ve hâlâ ortaya çıkarılmayı bekleyen büyük bir potansiyeli var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790310
					]
				},
				{
					"id": 750790310,
					"content": "Bir Tepetlizorun uçuş potansiyelinin bir Gukuzor ya da Iktomizorla aynı olması mümkün değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790311,
					"content": "#Her halükarda uçuş idmanımızla ilgileniyorsan idman parkurumuzu bir denemeni öneririm {M#genç adam}{F#genç hanım}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790313
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790313,
					"content": "Bir Gukuzoru sürebilmek için engellerden kaçınman ve sert dönüşler yapman gerekecek. Ne kadar iyi olduğunu görmek için idman parkurunu bir dene derim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790312
					],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790312,
					"content": "Açıkçası tanıtmak için epey uğraştık. Ödüller hazırladık, yarışlar düzenledik, çalışmalar yaptık. Başarılı olursan Lamizana'ya gidip ödülünü alırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Temach"
				},
				{
					"id": 750790304,
					"content": "Bana neler öğretebilirsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790305
					]
				}
			]
		},
