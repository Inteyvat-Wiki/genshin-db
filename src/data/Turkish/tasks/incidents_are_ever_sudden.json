			"dialogs": [
				{
					"id": 750790701,
					"content": "Müsaadenle bir büyüğün, hatta abin olarak ortama nasıl uyum sağlayıp popüler olacağını öğreteyim sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790702
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790702,
					"content": "Teşekkürler ama hiç gerek yok. Abim de değilsin ayrıca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790703
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790703,
					"content": "Bir de Oberon'a kraker verip durmasan diyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790704
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790704,
					"content": "Guuu... Guuuur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790705
					],
					"speakerTitle": "Oberon"
				},
				{
					"id": 750790705,
					"content": "Bana bak seni velet, kız kardeşin olmasa var ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790706
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790706,
					"content": "Pardon, ödülümü almaya gelmiştim ben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790707
					]
				},
				{
					"id": 750790707,
					"content": "Raarr! Raaaarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790708
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790708,
					"content": "Oo, şu misafire bak sen! Küçük Tepetlizorları öyle her gün görmeyiz burada... Bu arada senin de çevren genişmiş bakıyorum! Yanında değişik türden iki yoldaşla dolaşıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790709
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790709,
					"content": "#\"Değişik tür\" mü? {REALNAME[ID(2)|SHOWHOST(true)]} ve Paimon birbirlerinden çok farklı bir kere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790710,
					"content": "Raarr? Raaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790711
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790711,
					"content": "#Hı? Şey, {NICKNAME} ikimizi de yoldaşı gibi görüyor tabii ama tam olarak aynı sayılmayız. Paimon birimizin diğerinden iyi veya kötü olduğunu söylemiyor ama, lütfen üzülme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790712,
					"content": "Acı gerçekler böyle ağızdan kaçıveriyor işte bazen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790713
					]
				},
				{
					"id": 750790713,
					"content": "#Öff, Paimon'un öyle demek istemediğini biliyorsun, ortalığı karıştırma şimdi! {REALNAME[ID(2)|SHOWHOST(true)]} bizim biricik dostumuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790714,
					"content": "#Sen de harika bir yoldaşsın {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790715
					]
				},
				{
					"id": 750790715,
					"content": "Hruu? Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790716,
					"content": "#Hehe! Paimon anlayacağını biliyordu zaten {REALNAME[ID(2)|SHOWHOST(true)]}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750790717,
					"content": "Aranızdaki ilişkiye imrenmemek elde değil gerçekten. Kılık kıyafetinizden buralı olmadığınız belli ama bu Tepetlizor ile aranızda güçlü bir güven ve dostluk bağı var. Sırrınız nedir, söyleyin de bilelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790718
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790718,
					"content": "Gerçeği allayıp pullamaya gerek yok sonuçta, Taruka ve onun Gukuzoru da partnerler ama iyi geçinmeyi öğrenemediler gitti. Bir sırrınız varsa söyleyin de öğrensin bari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790719
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790719,
					"content": "Neyse, beni geçelim de esas konuya dönelim artık... Ödülleri nerede? Henüz hazır değil deme sakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790720
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750790720,
					"content": "Hazır canım, olmaz mı? Sen konuyu değiştirmeye ne kadar hazırsan ödüller de o kadar hazır hatta. Bu konuyu da daha sonra konuşacağız seninle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790721
					],
					"speakerTitle": "Lamizana"
				},
				{
					"id": 750790721,
					"content": "Yakında bir hava yarışı düzenleyeceğiz. İlgilenirseniz yarışı ve harika performansımı izleme şansını kaçırmayın derim! Şimdi ilgilenmem gereken başka konular var, müsaadenizle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lamizana"
				}
			]
		},
