			},
			"dialogs": [
				{
					"id": 750791601,
					"content": "Bu bir ödüldür, elinizi bile sürmeyin. Ödüllerimizle ilgileniyorsanız önce Temach'ın hazırladığı idman parkurunu tamamlamanız lazım.",
					"roleType": "TALK_ROLE_NPC",
