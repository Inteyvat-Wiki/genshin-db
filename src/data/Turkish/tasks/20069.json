			"dialogs": [
				{
					"id": 200690101,
					"content": "Bu çiçekler de çok iyi durmuyor. Yazık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690102
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690102,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690103
					]
				},
				{
					"id": 200690103,
					"content": "Şey, birçok insan hediye olarak tek dal çiçek almayı tercih ediyor, ben de bu sebeple bazılarını kesiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690104
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690104,
					"content": "Ama kestiğim çiçekler uzun süre taze kalmıyor. Hepsi satılmazsa solacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690105
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690105,
					"content": "Geçmişte bir sürü yöntem denedim ama hiçbir sonuç vermedi, çiçekler yine aynı şekilde soluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690106
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690106,
					"content": "Çiçekleri taze tutmanın bir yolu var mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690107,
						200690111
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690107,
					"content": "Taze tutmak mı demiştin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690108
					]
				},
				{
					"id": 200690108,
					"content": "Avcının Yeri'ndeki Sara'nın kullanılmamış malzemeleri soğuk bir yere koyarak veya buz blokları kullanarak sakladığını duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690109
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690109,
					"content": "Bu yöntemleri ben de denedim ama buz bloku kullanarak sakladığım çiçekler bir tuhaf oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690110
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690110,
					"content": "Solmuyor ama taze de kalmıyor. Hiçbir türlü onları müşteriye sunamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690114,
					"content": "Birçok kişiye sordum ve Bay Sayid... Kim olduğunu biliyorsun değil mi? Şu araştırmacı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690115
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690115,
					"content": "Bir gün çiçek almaya geldi. Bir kitapta çiçekleri kitap arasına koyup soğuk bir yerde sakladıkları yazıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690116
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690116,
					"content": "Hatta buz bloklarının yanına koymadan önce çiçekleri bir pakete koyup o şekilde saklamak gerekiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690117
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690117,
					"content": "Ayrıca deney yapmak istersem en uygun yer Ejdersırtı'nın düşük sıcaklığa sahip bölgesiymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690118
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690118,
					"content": "Ancak Ejdersırtı'nın çok tehlikeli bir yer olduğunu duydum ve bu kadar kısa sürede bana yardım edecek bir maceracı da bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690119
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690119,
					"content": "Gezgin, bu üç çiçek paketini Ejdersırtı'nda kara gömmeme yardım edebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690120,
						200690121
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690120,
					"content": "Oldu bil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690122,
					"content": "Yardımın için teşekkürler. Bakalım... Ejdersırtı'nın devasa bir yer olduğunu ve birçok bölgeden oluştuğunu duymuştum, bu da bizi farklı sonuçlara götürebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690123
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690123,
					"content": "Karşılaştırma yapmamız gerekebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690124
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690124,
					"content": "O halde lütfen bu çiçekleri <color=#00E1FFFF>Yedilerin Heykelinin yanına</color>, <color=#00E1FFFF>su kenarına</color> ve <color=#00E1FFFF>mağara girişine</color> yerleştirmeme yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690121,
					"content": "Nereye gömmeliyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690122
					]
				},
				{
					"id": 200690111,
					"content": "En iyisi hepsini aynı gün satmak o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690112
					]
				},
				{
					"id": 200690112,
					"content": "Bence de ama satılmayan bir iki tane kalıyor hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690113
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690113,
					"content": "Yalnızca bir iki tane olduklarını biliyorum ama solup gitsinler istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690114
					],
					"speakerTitle": "Flora"
				}
			]
		},
