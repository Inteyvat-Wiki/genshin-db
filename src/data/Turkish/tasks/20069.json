					"content": "Tamamdır, lütfen bu çiçekleri <color=#00E1FFFF>Yedilerin Heykelinin yanına</color> ve <color=#00E1FFFF>dağdaki mağaranın girişine</color> yerleştirmeme yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690325
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690325,
					"content": "Sonra senden <color=#00E1FFFF>dağda su olan</color> bir yer bulmanı isteyeceğim. Bir göl veya havuz iş görür. Suyun hemen kenarına göm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690326
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690326,
					"content": "Lütfen çok dikkatli ol. Çiçekler zarar görmesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690321,
					"content": "Nereye gömmeliyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690322
					]
				},
				{
					"id": 200690311,
					"content": "En iyisi hepsini aynı gün satmak o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200690312
					]
				},
				{
					"id": 200690312,
					"content": "Bence de ama satılmayan bir iki tane kalıyor hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690313
					],
					"speakerTitle": "Flora"
				},
				{
					"id": 200690313,
					"content": "Yalnızca bir iki tane olduklarını biliyorum ama solup gitsinler istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200690314
					],
					"speakerTitle": "Flora"
				}
			]
		},
