					"nextDialogs": [
						738050107
					],
					"speakerTitle": "Maryam"
				},
				{
					"id": 738050107,
					"content": "Sana vermem için beni sıkı sıkıya tembihledi. Hatta para bile ödemeyi teklif etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050108
					],
					"speakerTitle": "Maryam"
				},
				{
					"id": 738050108,
					"content": "Xudong geldi buraya... Hem de alelacele, hı? Başına bir şey gelmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						738050109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 738050109,
					"content": "O kötü adam yine mi sorun çıkardı?",
