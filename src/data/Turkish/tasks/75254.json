					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540201,
					"content": "Kıymetli dostum, madem karşılama içeceğimi içtin, sana bir tavsiye vereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540202
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540202,
					"content": "Eğer sadece tatil yapmaya gelmiş sıradan bir misafirsen Tete Adası'nın en kuzeydeki kısmından uzak dur. Orada rahatlamana yardımcı olacak hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525403,
			"completionStepIds": [
				7525401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
