			},
			"dialogs": [
				{
					"id": 752540101,
					"content": "Merhaba dostum! Hayallerin diyarı Paititi'ye ve Tete Adası'na hoş geldin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540102
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540102,
					"content": "İleride iki barımız var: Mey ve Ben ile Çiy Damlası. Benim adım Tecuhtli, buraya gelen misafirleri ben karşılarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
			"id": 7525402,
			"completionStepIds": [
				7525403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
