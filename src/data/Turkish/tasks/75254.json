			"dialogs": [
				{
					"id": 752540509,
					"content": "Bir yerden tanışıyoruz sanki, ha?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540501
					]
				},
				{
					"id": 752540501,
					"content": "Dostum, bu sıra dışı olana kaderin vurduğu bir damga. İlk karşılaşmamız, sanki uzun bir ayrılığın ardından gelen bir buluşma gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540502
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540502,
					"content": "Kurdu andıran bu göz bandımı görünce benim ne kadar sıra dışı olduğumu anladın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
		{
