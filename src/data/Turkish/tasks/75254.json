				"points": []
			},
			"dialogs": [
				{
					"id": 752540603,
					"content": "Hı? Gözlerimi mi merak ettin? Hehe, bir erkeğin hayatında kendini geliştirmesi gereken üç konu vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540604
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540604,
					"content": "Birincisi, görmüş geçirmiş bir bedende en az bir yara izi bulunmalıdır. Yoksa erkeğin hayatta verdiği sınavlar ve yüzleştiği sıkıntılar anlaşılmaz, dışarıdan boş biri gibi görünür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540605
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540605,
					"content": "İkincisi, bu yaralar kıyafet veya aksesuarlarla kapatılmalıdır. Fakat sadece bir kısmı... Yoksa kimse adamın ne kadar özel biri olduğunu anlayamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540606
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540606,
					"content": "Peki ya üçüncüsü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540607
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540607,
					"content": "Dur biraz. Gözlerinle ilgili bir şey sormadım ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540608
					]
				},
				{
					"id": 752540608,
					"content": "Kesinlikle! Eğer adamın ne kadar özel biri olduğu fark edilmezse o zaman kendisi konusunu açarak bunun fark edilmesini sağlamalıdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
