					"Tecuhtli"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752540309,
					"content": "Tavsiye için teşekkürler. Gözlerine ne oldu bu arada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752540310
					]
				},
				{
					"id": 752540310,
					"content": "Hehe... Uğursuz bir kel sebep oldu buna. Bu yara izini bıraktı bana, ama adada bir yerlerde olduğunu biliyorum... Ona olan \"teşekkür\" borcumu ödemezsem namert olayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540311
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540311,
					"content": "Hikayemi dinledikten sonra benim intikamımı almak istemişsindir muhakkak. Seni anlıyorum. İyi niyetin için sana teşekkür etmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540312
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540312,
					"content": "Sevgili dostum, bu kadar güzel bir yazda kimse üzgün hissetmemeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540313
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540313,
					"content": "Lütfen tüm misafirler için hazırladığım karşılama içeceğinden alın ve tatilinizin tadını çıkarın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752540314
					],
					"speakerTitle": "Tecuhtli"
				},
				{
					"id": 752540314,
					"content": "İçecekler oradaki rafta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tecuhtli"
				}
			]
		},
