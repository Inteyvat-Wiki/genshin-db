			},
			"dialogs": [
				{
					"id": 220190201,
					"content": "Onu buldum. Ganimetleri gömüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190202,
						220190204
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190202,
					"content": "Yakalayalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190203
					]
				},
				{
					"id": 220190203,
					"content": "Gezgin, bekle. Şimdi harekete geçmemeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190206,
					"content": "Biraz daha bekleyelim... Hım... Zamanı gelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190207
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190207,
					"content": "Hey sen! Ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190208
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190208,
					"content": "Elindekini bırak ve olduğun yerde kal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190209
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190209,
					"content": "Siz... Siz nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190210
					],
					"speakerTitle": "Ishikawa Hachirou"
				},
				{
					"id": 220190210,
					"content": "Ah... Hadi, öylece durma! Şunları haklayalım! Bu ikisinden kurtulursak evimize dönebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190211
					],
					"speakerTitle": "Ishikawa Hachirou"
				},
				{
					"id": 220190211,
					"content": "Haha! Bir avuç kendini beğenmiş Hazine Avcısından başka bir şey değilsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190212
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190212,
					"content": "Andou, Amano, bırakın onlarla biz ilgilenelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190213
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190213,
					"content": "Tamamdır! Hemen halledin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190214
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190214,
					"content": "Gezgin, zamanı geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190215
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190215,
					"content": "Of. Çok karmaşık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190216
					]
				},
				{
					"id": 220190216,
					"content": "Sango'nun planıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190217
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190217,
					"content": "İyi o zaman. İşe koyulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190204,
					"content": "Onu enselemeyecek miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190205
					]
				},
				{
					"id": 220190205,
					"content": "Birazdan. Henüz zamanı gelmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
