			"dialogs": [
				{
					"id": 220190601,
					"content": "Şimdi gidersen onu suçüstü yakalayabilirsin. Burada senden haber bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190602
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190602,
					"content": "Gezgin, söylemek istediğin başka bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190603,
						220190607
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190603,
					"content": "Pek heyecanlı görünmüyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190604
					]
				},
				{
					"id": 220190604,
					"content": "Bu vaka hiç ilgi çekici değil, sıkıcı bir faili var ve son derece basit yöntemler kullanılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190605
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190605,
					"content": "Bu vakayı düşünüyorum da... Resmen uykumu getirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190606
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190606,
					"content": "Fakat sonuçta bu da bir suç ve halledilmesi gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190607,
					"content": "Sen bizimle gelmiyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190608
					]
				},
				{
					"id": 220190608,
					"content": "Benim işim bitti. Bu yüzden size katılmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190609
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190609,
					"content": "Ayrıca dövüş yeteneklerimi ve fiziksel durumumu düşününce zanlının istediğini yaptırmak için beni rehin alması işten bile değil. Doğrusu bu hiç iyi olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190610
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190610,
					"content": "Nerede durmam gerektiğini biliyorum, bu yüzden onunla sen ilgileneceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				}
			]
		}
	]
