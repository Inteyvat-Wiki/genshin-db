					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190401,
					"content": "Sango, şu anda Andou ile Amano zanlıyı karakola götürüyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190402
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190402,
					"content": "Anlıyorum. Bu durumda olay çözüme kavuşmuş diyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190403
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190403,
					"content": "Yardımın için teşekkür ederim, Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190404,
						220190405
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190404,
					"content": "Hepsi bu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				},
				{
					"id": 220190406,
					"content": "Böyle hissetmen normal. Ne de olsa suçluyu götürenler Amano ve Andou'ydu. Neden paranı almıyorsun? Böylece bir davayı gerçekten çözdüğünü anlayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190407,
						220190409
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190407,
					"content": "Peki ya ücretin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190408
					]
				},
				{
					"id": 220190408,
					"content": "Ben mi? Polisin bir vakayı çözmesine, şehrin barış ve huzur içinde olmasına yardımcı olmak benim en büyük ödülümdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190412,
					"content": "Dürüst olmak gerekirse bu vaka bana pek bir şey katmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190413
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190413,
					"content": "Suç ile ilgili yeni tekniklere veya fikirlere rastlamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190414
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190414,
					"content": "Hiç ilginç bir vaka olmadı. Neyse ki çok uğraştırmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190415,
						220190417
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190415,
					"content": "Sango...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190416
					]
				},
				{
					"id": 220190416,
					"content": "Hımm? Suçu benim gibi ele alan biriyle ilk kez mi karşılaşıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190419,
					"content": "Bu ilgi nedeniyle dedektif olmaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190420
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190420,
					"content": "Sen de mi \"suç\" işlemek istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190421
					]
				},
				{
					"id": 220190421,
					"content": "Evet, bir bakıma öyle. Mükemmel, kusursuz bir suç işlemek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190422
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190422,
					"content": "Fakat bir suç işlendiğinde geride delil kalması kaçınılmaz; delil olduğu sürece suçun çözülmesi an meselesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190423,
						220190424,
						220190425
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190423,
					"content": "Suç bir kişi tarafından işlenmediyse?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190426,
					"content": "Gördün mü? Sen de suç işlemeyi düşünmeden edemiyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190427
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190427,
					"content": "Endişelenme. Sadece aklına geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190428
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190428,
					"content": "Kafamda sürekli suçların işlenme şekilleri ve işlenme nedenleri ile ilgili düşünceler dönüp duruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190429
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190429,
					"content": "Sence bunun nedeni ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190430
					]
				},
				{
					"id": 220190430,
					"content": "Vakaları daha iyi çözmek için elbette. Son zamanlarda üzerinde çalıştığım vakalar daha karmaşık hale geldiği için bunlara kafa yormam gerekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190431
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190431,
					"content": "Fakat bu vakaların mükemmel olduğunu söyleyemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190432
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190432,
					"content": "Hiç mükemmel suçla karşılaştın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190433
					]
				},
				{
					"id": 220190433,
					"content": "Evet karşılaştım. Bugüne kadar hâlâ çözemediğim mükemmel bir suç var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190434
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190434,
					"content": "Fakat suç bir kişi tarafından işlendiği sürece bir yerlerde bir delil olduğundan eminim. Sadece henüz bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190435
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190435,
					"content": "Her neyse, işte ücretin. Bana yardım ettiğin için teşekkür ederim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190436
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190436,
					"content": "Zaman buldukça buraya gelmekten çekinme lütfen. Fakat çok meşgul olursan... Neyse... Ona bir şey diyemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190437
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190437,
					"content": "Yine de içimden bir ses birlikte çalışma fırsatı bulacağımızı söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190424,
					"content": "Ya ortada suçlu yoksa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190425,
					"content": "İzlerini silmenin bir yolu var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190417,
					"content": "Bütün dedektifler böyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190418
					]
				},
				{
					"id": 220190418,
					"content": "Genel olarak öyle diyemem fakat \"suç\" ile yakından ilgileniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190409,
					"content": "Karşılığında hiçbir şey istemiyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190410
					]
				},
				{
					"id": 220190410,
					"content": "Adaletin yerine gelmesi beni çok mutlu ediyor. Başka bir şeye ihtiyacım yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190411
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190411,
					"content": "Haha... Böylesi daha iyi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 220190405,
					"content": "Öylece bitti mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				}
			]
		},
