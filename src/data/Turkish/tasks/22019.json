					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190301,
					"content": "Onu suçüstü yakaladık. Ryuuji ve Gezgin, yardımlarınız için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190302
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190302,
					"content": "Amano ve ben bu Hazine Avcılarını karakola götüreceğiz. Vakanın kalanını biz hallederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190303
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190303,
					"content": "Sango'nun vakanın ayrıntılarını bu kadar doğru bir şekilde kavrayabilmesini aklım almıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190304
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220190304,
					"content": "Sango öyle biri. Böyle bir vaka onun için çocuk oyuncağı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190305
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190305,
					"content": "Ryuuji, önce karakola döneceğiz. Bu adamla işimiz bittiğinde yanına geliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190306
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220190306,
					"content": "Memnuniyetle. Kendinize iyi bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190307
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220190307,
					"content": "Gezgin, hadi dönüp Sango'ya rapor verelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				}
			]
		},
		{
			"id": 2201904,
			"completionStepIds": [
				2201906
			],
