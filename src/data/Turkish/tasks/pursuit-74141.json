				]
			},
			"dialogs": [
				{
					"id": 741410101,
					"content": "(Sayfalar anlaşılmaz sembollerle, harflerle, geometrik şekillerle ve eski dillerde yazılmış yazılarla dolu. Ancak bir süre odaklandıktan sonra yazılanların anlamını yavaş yavaş çıkarabilmeye başlıyorsun.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410102
					],
					"speakerTitle": "Oku"
				},
				{
					"id": 741410102,
					"content": "Canotila burada değil galiba. Belki yine o esrarengiz yere gitmiştir! Meditasyon yapmaya başlayalım mı biz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410103,
					"content": "Onunla son konuşmamızı hatırladım da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410104
					]
				},
				{
					"id": 741410104,
					"content": "Biraz endişelendim şimdi. Gidip bir bakacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410105
					]
				},
				{
					"id": 741410105,
					"content": "Şey... Endişelenmekte haklısın tabii. Hadi beraber gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410106,
					"content": "Ben dönene kadar burada bekle sen Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410107
					]
				},
				{
					"id": 741410107,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410108,
					"content": "Esinleme Kitabındaki o dünya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410109,
						741410110
					]
				},
				{
					"id": 741410109,
					"content": "Tahmin ettiğimizden daha tehlikeli olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				},
				{
					"id": 741410111,
					"content": "Seni böyle bir tehlikenin içine atmak istemiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410112
					]
				},
				{
					"id": 741410112,
					"content": "İyi ama... Onca zamandır birlikte yolculuk ediyoruz. Birbirimize arka çıktığımız sürece üstesinden gelemeyeceğimiz zorluk, alt edemeyeceğimiz düşman mı var sanki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410113,
					"content": "İçerideki tehlikelerden sadece savaşarak kurtulamayabiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410114
					]
				},
				{
					"id": 741410114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410115,
					"content": "Pekala, madem ısrar ediyorsun. Sen Paimon'dan daha zekisin, o yüzden Paimon dediğini dinleyecek. Paimon'u terk edip gitme yeter ki! Sen dönene kadar Paimon burada bekleyecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741410110,
					"content": "Ya henüz farkına varamadığımız bir tarafı varsa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410111
					]
				}
			]
		},
