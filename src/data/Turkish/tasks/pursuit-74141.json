					"nextDialogs": [
						741411103
					]
				},
				{
					"id": 741411103,
					"content": "Yani göz açıp kapayıncaya kadar geldin açıkçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411104
					],
