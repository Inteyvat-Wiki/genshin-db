					}
				]
			},
			"dialogs": [
				{
					"id": 741411001,
					"content": "... Öyle mi? E iyi o zaman. Senin adın ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411002
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411002,
					"content": "Tırtıl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411003
					]
				},
				{
					"id": 741411003,
					"content": "#Seni daha önce buralarda gördüğümü hatırlamıyorum {NICKNAME}. Bakıyorum Paimon da ortalıkta yok, nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411004
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411004,
					"content": "Bir dakika... Beni kandırmak için tanıdığım birinin kılığına girmiş bir canavar mısın yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411005
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411005,
					"content": "Seninle daha yeni görüştük ya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411006
					]
				},
				{
					"id": 741411006,
					"content": "Öyle mi? Son görüşmemizin üzerinden uzun zaman geçmiş gibi geliyor bana. Yaşlandığım için mi acaba? Belki de yaş aldıkça hafızam gitgide bulanıyordur, kim bilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411007
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411007,
					"content": "... Canavar olmadığından eminsin yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411008
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411008,
					"content": "Hatırlıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411009,
						741411010
					]
				},
				{
					"id": 741411009,
					"content": "Devin bahçesinden konuşmuştuk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				},
				{
					"id": 741411011,
					"content": "Evet, hatırlıyorum. Hah... Gerçekten de senmişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411012
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411012,
					"content": "Kusura bakma, burada ne tuhaf şeyler gördüm bir bilsen... Kazanmanın mümkün olmadığı ne savaşlar geçti başımdan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411013
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411013,
					"content": "Tabii sonunda bir şeyler değişti. Güneş altın ışıklarını yeniden saçmaya başladı, ayçiçekleri yeniden serpilip çiçeklendi. Kadim uygarlıkların sözünü ettiği evren bile değişim denen bu olgudan kaçamıyor işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411014
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411014,
					"content": "Belki zamanla her şey daha güzel olur. Belki sonunda her şeyi anlarım ve oluruna bırakırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411015
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411015,
					"content": "Tırtıl...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411016
					]
				},
				{
					"id": 741411016,
					"content": "Benimle gel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411017
					]
				},
				{
					"id": 741411017,
					"content": "Haha, gerçekten de sensin demek. Şimdi hatırladım her şeyi... Seni tanıyorum ben. Hiç değişmemişsin. Hep başkalarının işine burnunu sokuyordun ama niyetin iyiydi, dürüst bir mizacın vardı zira.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411018
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411018,
					"content": "Benim için endişelenme sen. Yardıma ihtiyacım yok. Neler yapabileceğimi sen de gayet iyi biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411019
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411019,
					"content": "Hem buraları senden de iyi biliyorum bence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411020
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411020,
					"content": "Dağ Yabanisi, ona hemen gitmesini söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411021
					]
				},
				{
					"id": 741411021,
					"content": "Bir şey diyeceksin herhalde bana.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411022
					]
				},
				{
					"id": 741411022,
					"content": "Sen benim söylediklerimi anlayabiliyor musun? Demek öyle. Peki madem... Bana bakınca ne görüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411023
					]
				},
				{
					"id": 741411023,
					"content": "Bir köpek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411024
					]
				},
				{
					"id": 741411024,
					"content": "Hımm... Umutsuz bir vaka değilsin demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411025
					]
				},
				{
					"id": 741411025,
					"content": "Buradan gitmen lazım evlat. Senin iyiliğin için diyorum bunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411026
					]
				},
				{
					"id": 741411026,
					"content": "#Bence de {NICKNAME}. Sen buradan daha aydınlık bir dünyaya aitsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741411027
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741411027,
					"content": "Sormak istediğim bir şey var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411028
					]
				},
				{
					"id": 741411028,
					"content": "Sorma. Güle güle git, bir daha da gelme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": []
				},
				{
					"id": 741411010,
					"content": "Çırak ile küçük balıktan bahsetmiştik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741411011
					]
				}
			]
		},
