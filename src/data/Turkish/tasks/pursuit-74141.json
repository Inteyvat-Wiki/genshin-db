				},
				{
					"id": 741410802,
					"content": "Tırtıl.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410803
					]
				},
				{
					"id": 741410803,
					"content": "Kim var orada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410804
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410804,
					"content": "... Senmişsin demek. Seni hatırlıyorum ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410805
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410805,
					"content": "Nasıl oldu da buraya geldin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410806
					]
				},
				{
					"id": 741410806,
					"content": "Lafı ağzımdan aldın, ben de sana aynı şeyi soracaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410807
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410807,
					"content": "Hiç. Sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410808
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410808,
					"content": "#Sen {NICKNAME} değil misin? Peşinden bir an olsun ayrılmayan o beyaz ufaklığa ne oldu? Adı neydi ki onun... O neden yanında değil?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410809,
						741410811
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410809,
					"content": "Paimon beni dışarıda bekliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410810
					]
				},
				{
					"id": 741410810,
					"content": "Adı Paimon muydu? Neyse, önemli değil zaten. Sen çok iyi kalpli birisin, Paimon da öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410812
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410812,
					"content": "Buraya önemli bir şeyi bulmaya geldim. Ne aradığımı biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410813
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410813,
					"content": "Neyse, vazgeçtim. Hiç sormadım farz et. Sen neden buraya geldin peki? Burası çok tehlikelidir, ona göre... Hemen geri dön derim ben. Eskiden imtihan amacıyla buraya gelenler vardı. Sonunda hepsi hem yollarını hem de akıllarını kaybetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410814
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410814,
					"content": "Hah. Şimdi hatırladım. Sen ve ben... Beraber büyük bir başarıya imza atmıştık. Hayatta yapmakla övündüğüm tek şeydi o...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410815
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410815,
					"content": "Hatırladım dediğin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410816,
						741410818
					]
				},
				{
					"id": 741410816,
					"content": "Nergis Haçı'nı nasıl yendiğimizi mi hatırladın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410817
					]
				},
				{
					"id": 741410817,
					"content": "Ne oldu ona? Sen de Nergis Haçı Derneğinin bir üyesi misin yoksa? Yoksa... Guillotin'in adamlarından biri misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410820,
					"content": "Ah, altın kelebek... Güneş gibi parıl parıl...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410821
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410821,
					"content": "Etrafa öyle bir ışık saçtığın sürece her şey... Her şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410818,
					"content": "Lanoire'ı nasıl kurtardığımızı mı hatırladın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410819
					]
				},
				{
					"id": 741410819,
					"content": "Hatırlıyorum artık. Denizin altındaki hapishaneden onunla birlikte kaçmıştık. İyi de yapmışız, aferin bize. Orası çocuklara göre bir yer değildi. O güneşin altında, çiçeklerin arasında yaşamaya layık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741410820
					],
					"speakerTitle": "Tırtıl"
				},
				{
					"id": 741410811,
					"content": "Sen iyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741410812
					]
				}
			]
		},
