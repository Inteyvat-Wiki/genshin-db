			"dialogs": [
				{
					"id": 150400301,
					"content": "Vay be, muhteşem duruyor! Köpük Çiçeği Tarlaları adının hakkını veriyor artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400302
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400302,
					"content": "Emeğinize sağlık millet! Geriye sadece yaptıklarımızı görevliye anlatmak kaldı, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400303,
					"content": "Lütfen bekleyin... *nefes nefese kalır*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400304
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400304,
					"content": "Mükemmel zamanlama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400305,
					"content": "Sakin ol. Önce bir soluklan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400306
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400306,
					"content": "*derin nefes alır*... Pekala. Ben Gökkuşağı Kayalıkları'ndaki ana etkinlikten sorumlu personelim, Göklerdeki Asha mücadelesine bakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400307
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400307,
					"content": "Az önce yukarıdan aşağıyı izlerken çayırın bir anda çiçek denizine dönüştüğünü gördüm. Renkler o kadar çarpıcıydı ki az kalsın dürbünümü düşürüyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400308
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400308,
					"content": "Gökkuşağı Kayalıkları'nın imdadına yetiştiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400309
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400309,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400310
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400310,
					"content": "Hehe, pek bir şey yapmadık aslında. Zaten işin büyük kısmını şu ikisi halletti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400311,
					"content": "İyi kalpli maceracılar, mücadelemize katılmak ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400312
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400312,
					"content": "Ya da... Bizim bölgemizdeki önemli konumlara da biraz renk katabilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400313
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400313,
					"content": "Muhteşem bir teklif... Ama bunu yapma iznimiz olduğundan emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400314
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400314,
					"content": "Tabii ki, tabii ki! Çok isterim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400315
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400315,
					"content": "İş arkadaşıma büyük bir iyilik yaptınız, onun adına size teşekkür etmeliyim. Bu tecrübe para ödülünden bile daha özel olur diye düşündüm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400316
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400316,
					"content": "Şey, hayır. Biz parayı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400317,
					"content": "Arkadaşımız diyor ki yardımcı olmaktan büyük mutluluk duyarız! Haha... Oraya nasıl gideceğiz peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400318
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400318,
					"content": "Lütfen beni takip edin. Yukarıya sıcak hava balonuyla çıkacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				}
			]
		},
