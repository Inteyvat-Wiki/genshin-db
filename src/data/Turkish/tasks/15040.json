			"dialogs": [
				{
					"id": 150400601,
					"content": "#Haha, çok eğlenceliydi! Bu güzel rekabet için sağ ol {NICKNAME}! Asha ile harika vakit geçirdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400602,
						150400603,
						150400604
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400602,
					"content": "Bana denk bir rakip oldun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400606,
					"content": "İyi iş çıkardınız çocuklar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400607
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400607,
					"content": "#Tebrikler {NICKNAME}, sen kazandın! Ayrıca cömert yardımcımıza ve Ashaya da ortaya koydukları harika takım çalışması için çok teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400608
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400608,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400609
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400609,
					"content": "Ashanın söylediklerini tercüme ettiğinde sana inanmakta zorlanmıştım. Ama bu yarıştan sonra gerçekten çok etkilendiğimi belirtmeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400610
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400610,
					"content": "Ben de aynı şekilde! İkiniz adına da çok heyecanlıydım, sanki Kutsal Yolculuk finallerini izliyormuşum gibi hissettim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400611
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400611,
					"content": "Açıkçası ben de işler kızıştığında oraya uçup üç beş mermi atmamak için kendimi zor tuttum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400612
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400612,
					"content": "Yanında boya topu mu taşıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400613
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400613,
					"content": "Sayılır ama son rengin ne olacağı biraz muğlak. Bir de işim bittiğinde Ashanın göklerde kalabileceğinin garantisini veremezdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400614
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400614,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400615,
					"content": "Hehe! Neyse, Göklerdeki Asha'nın tamamlanmasına sadece bir adım kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400616
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400616,
					"content": "Kahramanlarımızın sadece Göklerdeki Asha'nın fırçalarını aydınlatması gerekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400617
					],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400617,
					"content": "(Asha bölgesi zaman çizgisini oynat)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400618
					]
				},
				{
					"id": 150400618,
					"content": "Harika görünüyor, değil mi? Grup fotoğrafı çekilmek için muhteşem bir seyir yeri önerebilirim size!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tikraq"
				},
				{
					"id": 150400603,
					"content": "Ashayla harika bir takım oldunuz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400606
					]
				},
				{
					"id": 150400604,
					"content": "Paimon'dan yardım isteseydim keşke.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400605
					]
				},
				{
					"id": 150400605,
					"content": "Paimon'u çağırmak yeni mi geldi aklına? Biraz geç kaldın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400606
					],
					"speakerTitle": "Paimon"
				}
			]
