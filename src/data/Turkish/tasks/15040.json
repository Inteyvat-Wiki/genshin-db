			"dialogs": [
				{
					"id": 150401001,
					"content": "Pekala! Göklerdeki Asha harika görünüyor ve herkes kadraja sığdı. Chasca, ortaya biraz daha yaklaş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401002
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150401002,
					"content": "Hehe, iyi iş çıkardık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401003
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150401003,
					"content": "Herkes hazır mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401004
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150401004,
					"content": "Fotoğrafa senin de girmen lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150401005,
					"content": "Evet, biliyorum. Hallediyorum şimdi. Tamamdır, her şey hazır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401006
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150401006,
					"content": "Üç, iki, bir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150401007
					],
					"speakerTitle": "Mualani"
