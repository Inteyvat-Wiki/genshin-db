			"dialogs": [
				{
					"id": 150400101,
					"content": "İşte geldik! Haritada işaretlenen Köpük Çiçeği Tarlaları burası olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400102
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400102,
					"content": "Neden bu kadar... Yeşil burası?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400103,
					"content": "Daha çok Köpük Otu Tarlaları gibi duruyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400104
					]
				},
				{
					"id": 150400104,
					"content": "Haha, benim de beklediğim gibi çıkmadı... Ama böyle şeyler hep olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400105
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400105,
					"content": "Hileli pazarlamadan mı bahsediyorsun? Durum bu kadar kötü olduğunda şikayette bulunurum genelde ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400106
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400106,
					"content": "Tur gruplarım beni şikayet eder yoksa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400107,
					"content": "Yok, hayır. Kusura bakma, daha açık konuşmam gerekirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400108
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400108,
					"content": "Daha çok... Gerçeklerin beklentilerini karşılamadığı durumları kastediyorum. Bu benim başıma çok sık geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400109
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400109,
					"content": "Şeyden dolayı mı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400110,
					"content": "Evet. Hani mesela... Manzarayı seyretmek için dağın tepesine kadar tırmandıktan sonra yoğun bir sisin havayı kaplayıp önünü bile görememene sebep olması gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400111
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400111,
					"content": "Ya da bir sürü yakacak odun topladıktan sonra bir Ateş Bodurlopunun çadırına girip hepsini ateşe verdiğini görmek gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400112
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400112,
					"content": "Of ya. Fenaymış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400113,
					"content": "Açıkçası alıştım ben artık. Hem sorunsuz macera olduğu nerede görülmüş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400114
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400114,
					"content": "Şu anda bu uçsuz bucaksız manzaranın ve temiz havanın keyfini çıkarabilmek, etrafta hiç canavar olmaması... Olağanüstü şans diye buna derim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400115
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400115,
					"content": "Bence asıl olağanüstü olan, ne olursa olsun bu iyimserliğini koruyabilmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400116
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400116,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400117
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400117,
					"content": "Aa, baksanıza, sanırım Asha bir şey buldu. Çıkardığı sesin o anlama geldiğinden eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400118
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400118,
					"content": "Vay be, şimdiden birbirinizi anlayabiliyor musunuz? Cidden aynı frekanstasınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400119,
					"content": "(Okumayı bitiriyorsun.)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150400120
					]
				},
				{
					"id": 150400120,
					"content": "Ezeli düşman diye buna denir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400121,
					"content": "İkisi de insan olsaydı sorunlarını oturup konuşarak çözebilirlerdi... Ama biri Asha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400122
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400122,
					"content": "Hadi yardım edelim! Hazır mısın Asha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400123
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400123,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400124
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400124,
					"content": "Bir dakika ya. Nasıl oldu da bir anda aksiyon moduna geçtik? Paimon planın ne olduğunu bile bilmiyor daha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400125,
					"content": "Ashaların en sevdiği etkinlik bir şeyleri farklı renklere boyamak, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400126
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400126,
					"content": "Evet... Yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400127,
					"content": "Basit ve saf kalpli varlıklar onlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400128
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400128,
					"content": "Ashanın buraya bilerek sorun çıkarmaya geldiğini sanmıyorum. Muhtemelen ufaklık çimlerin bu kadar boş ve sıkıcı görünmesine katlanamıyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400129
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400129,
					"content": "Evet, bunu bize anlatma şansı da yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400130
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400130,
					"content": "Doğru! Yani çayırı farklı farklı göz alıcı renklere boyamasına yardım edip gerçek bir çiçek tarlasına çevirirsek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400131
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400131,
					"content": "... Hem Ashayı mutlu edip hem de tesis görevlilerine yardım etmiş oluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400132
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400132,
					"content": "Lafı ağzımdan aldın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400133
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400133,
					"content": "Sorun çözme yaklaşımını sevdim... Ara bulucu olma potansiyelin var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400134
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400134,
					"content": "Ben varım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150400135
					]
				},
				{
					"id": 150400135,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400136
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400136,
					"content": "Haha, dur... Gıdıklanıyorum! Aa, bir yere mi gidiyoruz? Uzakta mı? Önce arkadaşlarıma haber vermem lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400137
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400137,
					"content": "Bekle, nereye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400138
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400138,
					"content": "Hey, tercüman! Bir şey anladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150400139,
					"content": "Bir şeyleri hareket ettirmemiz gerekiyordur belki. Ya da yakınlarda yardımımıza daha çok ihtiyacı olan başka biri olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400140
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400140,
					"content": "Bu ikisi birbiriyle tamamen alakasız! Ayrıca nasıl vardın bu sonuca?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400141
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400141,
					"content": "Açıkçası Ashaların hareketlerini izledikçe beden dillerini Sürüngenlere benzetiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400142
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400142,
					"content": "Hım... Umarım bana yalan söylemiyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400143
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400143,
					"content": "Hayır, ciddiyim. Sürüngen dilinde tek hareketin birden fazla anlamı olabiliyor. \"Annem\" kanatlarını açtığında bu ya \"akşam yemeği için erkenden eve gel\" ya da \"başın belada evlat\" demekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400144
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400144,
					"content": "Peki farkı nasıl anlıyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400145
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150400145,
					"content": "Küçükken ayırt edemiyordum. Bu yüzden kaç kere cezalandırıldım bir bilsen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400146
					],
					"speakerTitle": "Chasca"
				},
				{
					"id": 150400146,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400147
					],
					"speakerTitle": "Asha"
				},
				{
					"id": 150400147,
					"content": "Vay canına, hem çok sağlam hem de hızlı... Demek Natlan'ın sıcak hava balonları böyle oluyormuş. Harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150400148
					],
					"speakerTitle": "Bennett"
				},
				{
					"id": 150400148,
					"content": "Buradayız millet! Bakın! Biz geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bennett"
				}
			]
		},
