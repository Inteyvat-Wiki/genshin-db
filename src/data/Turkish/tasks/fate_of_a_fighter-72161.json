					"content": "Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611304
					]
				},
				{
					"id": 721611304,
					"content": "Nasıl yani, Şogunluktan mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611305
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
