			"dialogs": [
				{
					"id": 721610601,
					"content": "Nasılsın yabancı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610602
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610602,
					"content": "Kusura bakma, burası misafirlere uygun bir yer değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610603
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610603,
					"content": "Yine de... Gelmene sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610604
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610604,
					"content": "Seni çok daha iyi gördüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610605
					]
				},
				{
					"id": 721610605,
					"content": "Senin sayende. Sana ne kadar müteşekkir olduğumu tekrar belirtmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610606
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610606,
					"content": "Haha, hâlâ hayatta olmam çok acınası değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610607
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610607,
					"content": "Bu iyi bir şey değil mi? Neresi acınası?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610608,
						721610609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610608,
					"content": "Bundan sonra ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				},
				{
					"id": 721610610,
					"content": "Henüz ne yapacağıma karar vermedim ama geri döneceğimi sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610611
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610611,
					"content": "Kujou Masahito kötü biri değil ama babası asker kaçaklarının yakalanıp cezalandırılmasını istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610612
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610612,
					"content": "Onunla ters düşmek bana pahalıya mal olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610613
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610613,
					"content": "Belki de zırhımı çıkarmanın vakti gelmiştir. Burada tek başıma yaşamak güzeldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610614
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610614,
					"content": "Yine de barış gelene kadar kendimi kandırmanın anlamı yok. Hatıralarımda hâlâ o kan içindeki yaralı askerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610615
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610615,
					"content": "*iç çeker* Zamanın ne getireceğini bilemeyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610616,
						721610617
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610616,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610618,
					"content": "Daha önce de dediğim gibi, Ekselanslarının kararlarından asla şüphe etmedim. Bu yüzden ölsem de gözüm açık gitmem, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610619
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610619,
					"content": "Sohbet bir anda ciddileşti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610620,
					"content": "Ölüm demişken, adadaki eski silah arkadaşlarımı da ziyaret etmenin vakti geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610621
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610621,
					"content": "Inazuma geleneklerine göre hayatını kaybeden yoldaşlarımıza narin ve asil bir çiçek olan Kan Çiçeği götürürüz. Bu çiçek tüm samurayların kaderinin sembolüdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610622
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610622,
					"content": "Bu arada, yolculuğunuz sırasında eski silah arkadaşlarıma rastlarsanız lütfen durup onlarla tanışın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610617,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610618
					]
				},
				{
					"id": 721610609,
					"content": "Geri dönmeyi hiç düşündün mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610610
					]
				}
			]
		},
