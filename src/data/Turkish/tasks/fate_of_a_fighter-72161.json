					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610302,
					"content": "Hepsinin icabına baktım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				},
				{
					"id": 721610304,
					"content": "Ortam bir anda garipleşti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610305,
					"content": "Sana yani bir yabancıya kendi kirli işlerimi yaptırdığım için çok üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610306,
						721610307
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610306,
					"content": "İlk tanıştığımız halinden çok daha kibarsın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610308,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610309
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610309,
					"content": "Elimdeki tüm şifalı bitkileri kullandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610310
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610310,
					"content": "Yaram hâlâ oldukça iltihaplı ama onu sarmak için kullandığım bitkiler bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610311
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610311,
					"content": "Lütfen... Benim için endişelenmenize gerek yok. İdare edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610312
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610312,
					"content": "Gidin, kendi işinizle ilgilenin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610313
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610313,
					"content": "Çocuk gibisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610314
					]
				},
				{
					"id": 721610314,
					"content": "...?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610315
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610315,
					"content": "Ne dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610316
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610316,
					"content": "Senin hakkında konuşuyoruz. Adeta bir çocuk gibi davranıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610317,
					"content": "Durumunun ne kadar kötü olduğu ortada ve her an bana yardım edin diye ağlayacak gibi duruyorsun ama hâlâ güçlü görünmeye çalışıyorsun... Hiç dürüst değilsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610318,
					"content": "Bunu yalnızca çocuklar yapar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610319,
					"content": "Ayrıca şunu sakın unutmayın Bay Kyuuzou.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610320,
						721610321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610320,
					"content": "Bize borçlusunuz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610322,
					"content": "Siz ikiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610323
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610323,
					"content": "O zaman lütfen bana biraz Gözyaşı Otu getirin. Adanın her yerinde bulabilirsiniz. Yalnızca yapraklarını getirin. Yaprağın içindeki sıvıyı sıkıp yaraya sürmek iltihabı azaltır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610324
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610324,
					"content": "Hepsi bu kadar. Şimdi gidip biraz kestireceğim. Beni yalnız bırakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610321,
					"content": "Yardım etmeye geldik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610322
					]
				},
				{
					"id": 721610307,
					"content": "Yaran daha iyi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610308
					]
				},
				{
					"id": 721610303,
					"content": "Bir süre daha huzur ve sükunet içinde yaşayabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610304
					]
				}
			]
		},
