					"Inaba Kyuuzou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721611401,
					"content": "Yine mi siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611402
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611402,
					"content": "Sana demedim mi... Öf, neyse. Ne yaparsan yap.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611403
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611403,
					"content": "Eşyalarıma dokunmayın yeter. Bu gemide size yetecek kadar erzak var. İstediğinizi alıp gidin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611404
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611404,
					"content": "Yardım ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611405
					]
				},
				{
					"id": 721611405,
					"content": "Hayır. Gördüğün üzere gayet iyiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611406
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611406,
					"content": "Ama yaran...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611407
					]
				},
				{
					"id": 721611407,
					"content": "Benim yaram, senin değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611408
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611408,
					"content": "Hey, kibarlık olsun diye soruyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611409,
					"content": "Ben de kibarlık olsun diye cevap veriyorum. Beni uğraştırmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611410
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611410,
					"content": "Sana yardım edebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611411
					]
				},
				{
					"id": 721611411,
					"content": "Bana nasıl yardımcı olacaksın? Şogunluğa teslim ederek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611412
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611412,
					"content": "Haha, bunun hiç de merhametlice olmayacağını söylemeliyim... Beni asker kaçağı olarak görürler ve Lord Kujou asker kaçaklarına asla merhamet etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611413
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611413,
					"content": "Gerçekten yardımcı olmak istiyorsanız bana biraz rahat verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611414
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611414,
					"content": "Bu adam ne kadar da çok söyleniyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
