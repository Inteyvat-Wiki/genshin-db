					"content": "Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611306
					]
				},
				{
					"id": 721611306,
					"content": "O zaman işine bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611307
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611307,
					"content": "Bu adam çok kaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611308,
					"content": "Pekala, beni Şogunluk gönderdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611309
					]
				},
				{
					"id": 721611309,
					"content": "Neden yabancıları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611310
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611310,
					"content": "Heyet Başkanının önünde köpek olup havlamadığınız kalıyor ama biz Inazumalı Samuraylara gelince kibrinizden geçilmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611311
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611311,
					"content": "Gidip casusluk yapalım, sorun çıkaralım... Sonunda bu kırık dökük gemiye de kim bilir neden geldiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611312
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611312,
					"content": "Ne yazık ki ben yalnızca yaralı bir askerim ve sizin için yapabileceğim hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611313
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611313,
					"content": "Bu yüzden sakıncası yoksa lütfen burayı terk edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611314
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611314,
					"content": "Bu adamın görgü kurallarından haberi yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721611315,
					"content": "Her neyse, çok gürültü yapıyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611316
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611316,
					"content": "Gitmeden önce size bir tavsiye vereyim: Yashiori Adası'nda uzun süre kalmayın. Bu ada lanetlendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611317
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611317,
					"content": "Lanetlendi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721611318
					]
				},
				{
					"id": 721611318,
					"content": "Sağır mısın? Ada lanetlendi dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611319
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611319,
					"content": "Sürekli bir çıkmazın içindeyiz. Lordlarımızın hırsı, sıradan halkın çaresizliği, mazlumların içinde büyüyen kin, ölüm döşeğindeki yaşlıların mezarı andıran odaları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611320
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611320,
					"content": "Bunlar buranın laneti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611321
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611321,
					"content": "Bu yükün altında ezilmeden buradan gidin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721611322
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721611322,
					"content": "Paimon dediklerinden hiçbir şey anlamadı. Ne kadar garip bir adam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7216114,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
