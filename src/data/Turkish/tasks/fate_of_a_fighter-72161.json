			},
			"dialogs": [
				{
					"id": 721610101,
					"content": "Hıh, bu çok utanç verici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610102
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610102,
					"content": "Hey! Senin hayatını kurtardık! Bunun neresi \"utanç verici\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610103,
						721610104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610103,
					"content": "Kendinden bahsediyor Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				},
				{
					"id": 721610105,
					"content": "Yabancılar tarafından kurtarılıp üstüne bir de yargılandığımı düşününce...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610106
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610106,
					"content": "Ah... Samuray Bey, iyi misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721610107,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610108,
						721610109
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610108,
					"content": "En azından iyi görünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610110,
					"content": "Sana müteşekkirim yabancı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610111
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610111,
					"content": "Ayrıca, takdire şayan bir şekilde savaştın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610112
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610112,
					"content": "#Ben {NICKNAME}. Tanıştığıma memnun oldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610113
					]
				},
				{
					"id": 721610113,
					"content": "Beni hor görme yabancı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610114
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610114,
					"content": "Inaba Tousaburou Kyuuzou. Bana kısaca Kyuuzou diyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610115,
						721610116
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610115,
					"content": "Onlar kimdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610117,
					"content": "Onlar korsan. Nazuchi Sahili'nin çevresinde bir sürü kaleleri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610118
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610118,
					"content": "Eşkıyalar, işsiz madenciler ve balıkçılar, Önsezi Avı Fermanından kaçanlar, savaşın iki tarafından asker kaçakları... Bazen gruplaşıp haydutlara ve korsanlara dönüşürler. Ekselanslarının kontrolünden kaçmaya çalışıyorlar ama nafile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610119
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610119,
					"content": "Kimileri onlara Serseriler ya da Kairagi der ama sonuçta hepsi kanun tanımaz eşkıyalar... Asiler adadaki tılsımı yok etmeden önce onları bastırmayı başarabilmiştik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610120
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610120,
					"content": "Tatarasuna'dan gelen mülteciler ve madendekiler peş peşe kaçtı ama o sıçanlardan bazıları burada korsan çetelerine katılınca sayısı artan çetelerin gözü iyice karardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610121
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610121,
					"content": "Az önce güneydeki kamptan bir grup korsan geldi. Gözleri güvertedeki yük kasasındaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610122
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610122,
					"content": "Planlarını mahvettim, çok yazık... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610123
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610123,
					"content": "Yani bu senin gemin değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610124
					]
				},
				{
					"id": 721610124,
					"content": "Bu mu? Sangonomiya asilerinin gemisi olması gerek... Çok da emin değilim. Neyse ne, ben geldiğimde çoktan terk edilmişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610125
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610125,
					"content": "Durum böyle olunca ben de bir keşiş yengeci gibi burada yaşamaya başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610126
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610126,
					"content": "Bu kadar konuşmayalı uzun zaman olmuştu. Çok yorucuymuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610127
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610127,
					"content": "Sakıncası yoksa senden bir konuda yardım isteyecektim. Yaram iyileştiğinde iyiliğini karşılıksız bırakmayacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610128
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610128,
					"content": "Az önce bahsettiğim, yakınlardaki korsan kampını ortadan kaldırmama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610129
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610129,
					"content": "Başıboş bir sokak köpeği sürüsü gibi gelip beni rahatsız etmelerinin önüne geçmemin tek yolu bu. Belki bu sayede diğer korsan kampları da mesajı alır ve buraya gelmeyi denemezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610130
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610130,
					"content": "Ayrıca bana neler yapabileceğini de göstermiş olursun. Ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610131,
						721610132
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610131,
					"content": "Çocuk oyuncağı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610133,
					"content": "Hımm. Büyük konuşmayı seviyorsun sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610134
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610134,
					"content": "Bu arada, yabancı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610135
					],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610135,
					"content": "Bu kadar kibirli olma. Tek yanlışınla her şeyi batırabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Inaba Kyuuzou"
				},
				{
					"id": 721610132,
					"content": "Hemen döneceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610133
					]
				},
				{
					"id": 721610116,
					"content": "Sana neden saldırdılar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610117
					]
				},
				{
					"id": 721610109,
					"content": "Gururu incinmiş olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610110
					]
				},
				{
					"id": 721610104,
					"content": "Bu da samuraylara özgü bir şey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721610105
					]
				}
			]
		},
