			"dialogs": [
				{
					"id": 721610505,
					"content": "Bitkileri ezip püre haline getirmek çok vakit alacak. Sen gidebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721610506
