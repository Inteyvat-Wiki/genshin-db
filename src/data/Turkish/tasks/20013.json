			"dialogs": [
				{
					"id": 200130301,
					"content": "Çok teşekkür ederim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130302
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130302,
					"content": "Stanley'nin bir keresinde maceraya atıldığı bir yere bakmaya gidiyordum, yolumu keseceklerini tahmin edemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130303
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130303,
					"content": "Yeteri kadar güçlü değilim... Eminim benim yerimde Stanley olsaydı onları hiç zorluk çekmeden yenerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130304
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130304,
					"content": "Bana katılmak ister misin? Lütfen katıl! Ne diyorum ki ben... Maceramı bile başkasına yaptırmaya çalışıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130305
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130305,
					"content": "Ben artık gideyim. Bu senin için, bende daha çok var. Erzakıma katmak için yoldan bolca toplamıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200130306
					],
					"speakerTitle": "Jack"
				},
				{
					"id": 200130306,
					"content": "... Buna erzak denmez tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jack"
				}
			]
		}
