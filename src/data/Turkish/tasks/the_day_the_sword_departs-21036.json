				{
					"id": 210360901,
					"content": "Doğa koşusu idmanı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360902
					]
				},
				{
					"id": 210360902,
					"content": "Şahane! Daha önce idman yapmak için kullandığımız yol dışı rotaya devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360903
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360903,
					"content": "Maceracı, mümkün olduğu kadar çabuk hedefe ulaşmam gerektiğini söylemişti. Ama asla yeteri kadar hızlı olamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360904
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360904,
					"content": "Nasıl yapmam gerektiğini bana gösterebilir misin? Ayak uydurmak için elimden geleni yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360905,
						210360906
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360905,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360908
					]
				},
				{
					"id": 210360908,
					"content": "Tamam, sana güveniyorum o zaman. Başlangıç noktasına gidelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360906,
					"content": "Geride kalmamaya çalış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360907
					]
				},
				{
					"id": 210360907,
					"content": "K-Kesinlikle deneyeceğim. Ama dürüst olayım, koşucu olmak için doğmuşum diyemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360908
					],
					"speakerTitle": "Sun Yu"
				}
