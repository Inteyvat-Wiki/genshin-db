			"dialogs": [
				{
					"id": 210360401,
					"content": "*derin nefes alır* Bu çok zordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360402,
					"content": "Şuna bak, kendimi rezil ettim yine. Hiç ilerleme kaydedememişim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360403
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360403,
					"content": "Daha fazla idman yapmaya ihtiyacım olduğu açık. Teşekkürler Gezgin. Lütfen bunları ödülün olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360404,
					"content": "Liyue'den nasıl ayrılacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360405
					]
				},
				{
					"id": 210360405,
					"content": "Şöyle... Şu anda planım tüccar gemisi ile seyahat etmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360406
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360406,
					"content": "İlk durağım olarak... Fontaine'i düşünüyorum. Bir süre orada kalıp ilerisi için plan yapacağım sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360407
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360407,
					"content": "*iç çeker* Benimle seyahat etmesi için Que'er'i ikna edebilecek miyim acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
