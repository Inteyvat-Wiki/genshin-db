			"dialogs": [
				{
					"id": 210360201,
					"content": "Canavarlarla dövüş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360202
					]
				},
				{
					"id": 210360202,
					"content": "Harika! Uzun süredir yeni öğrendiğim kılıç hareketlerimi denemek istiyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360203
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360203,
					"content": "Hareketlerimi görememenden korkuyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360204
					]
				},
				{
					"id": 210360204,
					"content": "Demek o kadar yeteneklisin. Hahaha, öyleyse benim için biraz daha yavaşla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360205
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360205,
					"content": "Bir bakalım... Tam ileride canavarların toplandığı bir yer var. Oraya gidelim, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
