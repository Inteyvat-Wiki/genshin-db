			"dialogs": [
				{
					"id": 210360501,
					"content": "*derin nefes alır* Nasıl... Nasıl bu kadar hızlı koşabiliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360502,
						210360504
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360502,
					"content": "Sen yavaş koşuyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360503
					]
				},
				{
					"id": 210360503,
					"content": "P-Pes ediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360506,
					"content": "Gösterdiğin için teşekkürler Gezgin. Lütfen bunları ödül olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360507,
						210360510
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360507,
					"content": "Que'er hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360508
					]
				},
				{
					"id": 210360508,
					"content": "*iç çeker* Hâlâ benimle konuşmuyor. Ne yapmam gerek bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360509
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360509,
					"content": "Bu iş nasıl böyle bir ikileme dönüştü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360510,
					"content": "Maceracı hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360511
					]
				},
				{
					"id": 210360511,
					"content": "O maceracı mı? Onunla Maceracılar Loncasında karşılaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360512
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360512,
					"content": "Bana Kanyon'da çalışmak üzere Loncadan bir görev kabul ettiğini söyledi. Benim de gideceğimi duyduğunda hiç tereddüt etmeden beraber gitmeyi kabul etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360513
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360513,
					"content": "Buna karşılık ben de ona görevinde yardım edeceğim. Ama daha çok bir şeyler aramak için. Çok yorucu olmasa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360514
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360514,
					"content": "Tek sorun... Çok konuşkan biri olması. Onun gibi insanlarla nasıl baş edilir bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360504,
					"content": "Daha çok çalışman lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360505
					]
				},
				{
					"id": 210360505,
					"content": "Kesinlikle haklısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "Sun Yu"
				}
			]
