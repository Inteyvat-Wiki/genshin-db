			"dialogs": [
				{
					"id": 210360101,
					"content": "Yine karşılaştık Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360102,
						210360104
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360102,
					"content": "Hâlâ burada pratik mi yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360103
					]
				},
				{
					"id": 210360103,
					"content": "Aynen öyle. Bu... tahmin ettiğimden çok daha zor. Ben mi güçsüzüm yoksa uyguladığım metot mu yanlış bilemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360108,
					"content": "Neyse, ondan bahsettiğimiz yeter. Seninle beraber en son canavarlarla dövüştüğümüzde hareketlerinden çok ilham almıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360109,
					"content": "Gezgin, bana bir iyilik yap ve idman yapmam için bir tur daha bana eşlik et, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360110,
					"content": "Geçen seferki gibi canavarlarla dövüşebilir veya doğa koşusu idmanı yapabiliriz. Sana kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360104,
					"content": "Que'er seni hâlâ umursamıyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360105
					]
				},
				{
					"id": 210360105,
					"content": "Aslında... Şehirde yapacak işleri olduğunu söyledi ve geri gelmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360106
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360106,
					"content": "Onu birkaç kez ziyaret ettim ama geri dönmem için Zhiruo'yu gönderip beni savdı. Hâlâ benimle görüşmeyi reddediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360107,
					"content": "*iç çeker* Ona ne diyeceğimi gerçekten bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
