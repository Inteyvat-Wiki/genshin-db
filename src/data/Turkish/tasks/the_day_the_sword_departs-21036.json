			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360601,
					"content": "Yine karşılaştık Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360602,
						210360604
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360602,
					"content": "Hâlâ burada pratik mi yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360603
					]
				},
				{
					"id": 210360603,
					"content": "Aynen öyle. Bu... tahmin ettiğimden çok daha zor. Ben mi güçsüzüm yoksa uyguladığım metot mu yanlış bilemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360608
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360608,
					"content": "Neyse, ondan bahsettiğimiz yeter. Seninle beraber en son canavarlarla dövüştüğümüzde hareketlerinden çok ilham almıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360609
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360609,
					"content": "Gezgin, bana bir iyilik yap ve idman yapmam için bir tur daha bana eşlik et, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360610,
						210360611
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360610,
					"content": "Daha önce burada idman yaptın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360613
					]
				},
				{
					"id": 210360613,
					"content": "Neyse ki yardımsever bir maceracıya denk geldim. Bana yardım etti ve iş birliği adı altında beni de göreve dahil etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360614
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360614,
					"content": "Bana bir idman programı hazırlamamda bile yardımcı oldu ve bana birçok tavsiye verdi. Benim de ona Maceracılar Loncasının verdiği bazı görevleri hallederken yardımcı olmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360615,
					"content": "Öhöm... Tamam, hadi işimize dönelim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360616
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360616,
					"content": "Şu şekilde. Kendime içinde doğa koşusu ve canavar dövüşü olan bir idman programı hazırladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360617
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360617,
					"content": "Bugün hangisinde bana yardım etmek istediğin sana kalmış Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360611,
					"content": "Böyle bir yerde idman yapabileceğini bilmiyordum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360612
					]
				},
				{
					"id": 210360612,
					"content": "Bunu söylemeye biraz utanıyorum ama kabul etmem lazım ki buraya gelmemin asıl sebebi bu bölgenin karmaşık ve ortalıkta gezinen canavarlarla dolu olmasıydı. İdman yapmak için güzel bir yer olur diye düşünmüştüm ama buraya gelmenin böyle zor olacağını düşünememişim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360613
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360604,
					"content": "Que'er seni hâlâ umursamıyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360605
					]
				},
				{
					"id": 210360605,
					"content": "Aslında... Şehirde yapacak işleri olduğunu söyledi ve geri gelmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360606,
					"content": "Onu birkaç kez ziyaret ettim ama geri dönmem için Zhiruo'yu gönderip beni savdı. Hâlâ benimle görüşmeyi reddediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360607
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360607,
					"content": "*iç çeker* Ona ne diyeceğimi gerçekten bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
