					"nextDialogs": [
						210360702
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360702,
					"content": "Üzgünüm. Şuraya bak, kendimi rezil ettim. Gerçek canavarlarla karşılaştığımda bu kadar gergin olacağımı beklemiyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360703
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360703,
					"content": "Daha fazla idman yapmaya ihtiyacım olduğu açık. Neyse, teşekkürler Gezgin. Lütfen bunları ödülün olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360704
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360704,
					"content": "Gerçekten gidiyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360705
					]
				},
				{
					"id": 210360705,
					"content": "Henüz tam karar vermedim. Düşünmek için zamana ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
