			"dialogs": [
				{
					"id": 210360301,
					"content": "Doğa koşusu idmanı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360302
					]
				},
				{
					"id": 210360302,
					"content": "Şahane! Başka bir maceracıdan bana yol dışı bir rota çıkarmasını istemiştim. Onun yardımı sayesinde burada idman yapabildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360303
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360303,
					"content": "Mümkün olduğu kadar çabuk hedefe ulaşmam gerektiğini söylemişti. Ama asla o kadar hızlı olamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360304
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360304,
					"content": "Nasıl yapmam gerektiğini bana gösterebilir misin? Seni yakalamak için elimden geleni yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360305,
						210360306
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360305,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360308
					]
				},
				{
					"id": 210360308,
					"content": "Tamam, sana güveniyorum o zaman. Başlangıç noktasına gidelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210360306,
					"content": "Geride kalmamaya çalış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360307
					]
				},
				{
					"id": 210360307,
					"content": "K-Kesinlikle deneyeceğim. Ama dürüst olayım, koşucu olmak için doğmuşum diyemem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360308
					],
					"speakerTitle": "Sun Yu"
				}
			]
		},
