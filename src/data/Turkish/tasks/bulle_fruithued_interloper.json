			"dialogs": [
				{
					"id": 705400101,
					"content": "*tıslar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "Tırmık Efendi"
				},
				{
					"id": 705400102,
					"content": "*mırıldanır*... Kedi bana tıslıyor Bayan Rosaria. Korkuyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400103,
					"content": "Ona biraz alan tanımalısın. Çok yaklaşırsan yüzünü tırmalayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400104,
					"content": "Olamaz, görünüşe göre Valerina'nın başı kedilerle yine belada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400105,
					"content": "Barınakta yeni bir kedi var gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "Fahri Şövalye! Kedi Terbiyecisi! Bu büyük kedi, Kartopu'nun peşinden buraya geldi! Yürüyüşe çıktığında onu görüp buraya kadar takip etti herhalde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400108,
					"content": "Sakin ol. Sana zarar vermeyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400109,
					"content": "Tüm o kötü varlıklar, sana o kötülükleri yapan insanlar... Artık seni bulamazlar. Burada güvendesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400110,
					"content": "Artık yanında iyi insanlar var. Sürekli etrafında dolaşmaları biraz sinir bozucu olsa da hepsi senin iyiliğin için burada. Rahatla. Sakin geçen bir hayat kötü değildir. Sadece alışman gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400111,
					"content": "*tıslar*... *inler*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "Tırmık Efendi"
				},
				{
					"id": 705400112,
					"content": "S-Söylediklerini anladı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "Valerina"
				},
				{
					"id": 705400113,
					"content": "İşe yaradı sanki. Aferin sana akıllı kedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400114,
					"content": "Vay canına, bu kedi diğerlerinden çoook daha büyük. Renkleri de taze sıkılmış Bulle Meyvesi suyu gibi! Fuları bile var! Fuların üzerinde de bir desen... Aa, bu Favonius Şövalyelerinin sembolü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400115,
					"content": "Ona şövalyelere yaraşır bir isim bulmamız lazım! Oldukça cesur bir kedi. \"Tırmık Efendi\" diyelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400116,
					"content": "Miyav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "Tırmık Efendi"
				},
				{
					"id": 705400117,
					"content": "Kedilerle nasıl anlaşacağını iyi biliyorsun cidden. İyice sakinlemiş görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400118,
					"content": "Paimon bu kez senin konuşmalarının daha etkili olduğunu düşünüyor. Sen o şeyleri söyledikten sonra Tırmık Efendi sakinlemeye başlamıştı bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400119,
					"content": "Onlarla gitgide daha iyi anlaşıyorsun Rosaria!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "Benim için fark eden bir şey yok. Yine de... Sevimli olmaları fena bir özellik değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "Rosaria"
				},
				{
					"id": 705400122,
					"content": "Paimon şimdi sana Tırmık Efendi'yi nasıl sakinleştireceğini öğretecek! Paimon yine kedilerin anladığı dilden konuşup onun mutlu olmasını sağlayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705400120,
					"content": "Umarım bu işinden daha fazla keyif alıyorsundur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "Sanki... Ağırbaşlı bir yanı var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
}