					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000502
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000502,
					"content": "Ya-hoho!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000503
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000503,
					"content": "Kıstırılmış kedi kurtarıldı...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762000504
					]
				},
				{
					"id": 762000504,
					"content": "Demek aradıkları sensin ha? Hımm... Bir yaran yok gibi görünüyor. Ama seni biraz daha geç bulsaydık... Kim bilir başına neler gelirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000505
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000505,
					"content": "Neyse, önce seni arkadaşlarının yanına götürelim!",
					"roleType": "TALK_ROLE_NPC",
