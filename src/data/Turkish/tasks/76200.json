			"dialogs": [
				{
					"id": 762000201,
					"content": "Affedersin, bu civarda hiç kaplan desenli kedi gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000202
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000202,
					"content": "Kaplan desenli kedi mi? Hımm, sanmıyorum... Lumi, sen gördün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000203
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000203,
					"content": "Ya-ho?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000204
					],
					"speakerTitle": "Lumi"
				},
				{
					"id": 762000204,
					"content": "Anlaşılan Lumi de görmemiş. Kedin mi kayboldu? Aramana yardım edebilirim. Buraları avucumun içi gibi bilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000205
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000205,
					"content": "Hey, Jukka! Bir maceracı tutacak kadar paramız yok. Hem zaten alt tarafı aptal bir kedi. Nereye giderse gitsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000206
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000206,
					"content": "Öyle söyleme Marja. Bunu söylediğini duysa üzülürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000207
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000207,
					"content": "Sanki bizi duyabilecekmiş gibi! Eğer duyabilseydi şimdiye kadar yanımıza gelirdi, ne zamandır bağırıp duruyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000208
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000208,
					"content": "Bunun için bana komisyon ödemene gerek yok. Zaten bölgeyi kontrol edecektim, gelmişken bir göz atarım. Hadi gidelim Lumi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000209
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000209,
					"content": "(Daha düne kadar burada hiçbir şey yoktu, şimdiyse bir sürü İkiz Yapraklı Etobur Bitki yetişiyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000210
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000210,
					"content": "(Belki bir hayvan tohumları buraya getirmiştir. Fakat böyle yayılmalarına izin veremem...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Linnea"
				}
			]
		},
