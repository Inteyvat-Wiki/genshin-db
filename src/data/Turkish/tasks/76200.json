			"dialogs": [
				{
					"id": 762000801,
					"content": "Şapşal kedi... Nerelerdesin ya... Aa! Onu bulmuşsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000802
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000802,
					"content": "Şuradaki İkiz Yapraklı Etobur Bitkilerin arasında sıkışıp kalmış. Bitki olduklarına bakma, etoburlar ve Mehtap Böceklerini sadece birkaç günde sindiriveriyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000803
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000803,
					"content": "İyi ki onu zamanında bulduk. Şu an sadece biraz zayıflamış durumda ama az daha gecikseydik... Kim bilir neler olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000804
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000804,
					"content": "A-Aman... Bu çok tehlikeli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000805
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000805,
					"content": "Hıh, buraya tırmanmanın tek suçlusu sensin şapşal kedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000806
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000806,
					"content": "Aslında bu pek kedinin suçu değil. Bu İkiz Yapraklı Etobur Bitkiler özel bir koku yayar. İnsanlar etkilenmez ama böcekler ve diğer küçük yaratıklar bu kokuya kapılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000807
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000807,
					"content": "Bitkiler avlarını bu şekilde yakalar. Burada alışılmadık sayıda etobur bitki var, küçük hayvanlar da onların varlığından etkileniyor haliyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000808
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000808,
					"content": "Ha... Anlıyorum. Her neyse, bu bitkilerin burada bu kadar yoğun şekilde yetişmesi pek hayra alamet değil, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000809
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000809,
					"content": "Doğru. Onları kendi hallerine bırakırsak başımıza ciddi dertler açabilirler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000810
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000810,
					"content": "Pekala, o zaman bitkileri yolma işini biz hallederiz. Jukka, sen de yardıma gel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000811
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000811,
					"content": "Bu bitkiler şapşal kedimize çok çektirdi. Bunun acısını çıkarmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000812
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000812,
					"content": "İki hazine avcısının yardımıyla bölgedeki İkiz Yapraklı Etobur Bitkilerin olağan dışı büyümesi nihayet durduruldu...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						762000813
					]
				},
				{
					"id": 762000813,
					"content": "Oh be... Sonunda bitti. Nasha Kasabası'na dönme zamanı. Bu şapşal kediyi bulmamıza yardım ettiğin için çok teşekkürler hanımefendi. Sen yardım etmeseydin kim bilir daha ne kadar orada mahsur kalacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000814
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000814,
					"content": "Aslında düşününce Marja, eğer az önce o kadar yüksek sesle bağırmasaydın onu daha da erken bulabilirdik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000815
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000815,
					"content": "N-Ne diyorsun sen ya? Neyse, önemli olan artık güvende olması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000816
					],
					"speakerTitle": "Marja"
				},
				{
					"id": 762000816,
					"content": "(Ona sürekli \"şapşal kedi\" dese de yoldaşını gerçekten önemsiyor, hehe.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000817
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000817,
					"content": "Doğru. Önemli olan güvende olması. Vahşi doğada olmak tehlikeli, o yüzden sizler de dikkatli olmalısınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000818
					],
					"speakerTitle": "Linnea"
				},
				{
					"id": 762000818,
					"content": "Teşekkürler. Dikkatli oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762000819
					],
					"speakerTitle": "Jukka"
				},
				{
					"id": 762000819,
					"content": "Araştırmanda sana bol şans. Hoşça kal!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Marja"
				}
			]
		},
