			"dialogs": [
				{
					"id": 748000501,
					"content": "Ah, evet... Bu doğru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000502,
						748000503
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000502,
					"content": "Kahven soğuyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "Biz içmeyi bitirdik bile.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#Teşekkürler {NICKNAME}. Beni buraya getirdiğin için de teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000505,
					"content": "Seni getirdiğimiz için teşekkür ediyorsun ama tek yaptığımız seninle beraber buraya kadar yürümekti. Biz bir şey yapmadık ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000506,
						748000507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000506,
					"content": "Kötü bir şey olmadı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000507,
					"content": "Bir tehlikeyle de karşılaşmadın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000508,
					"content": "Evet. Anlaşılan gerçekten de biraz fazla düşünmüşüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000509
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000509,
					"content": "Bu kahve gerçekten de çok güzel, haha... Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000510
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000510,
					"content": "... Sence zehirli midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000511,
						748000512
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000511,
					"content": "... *pöff*.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000512,
					"content": "İki saniye şöyle şeyler söylemesen ölür müsün?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "Bırak bu saçmalıkları! Hepsini içtik ve bir şeyimiz yok işte, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000514,
					"content": "Hayır hayır. Belki de... Özel bir zehirleme yöntemidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000515
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000515,
					"content": "Zehirleyen kişi önce kahvemize bir çeşit ilaç karıştırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000516
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000516,
					"content": "Yalnızca ilacı içmenin kurban üzerinde hiçbir etkisi olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000517
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000517,
					"content": "Zehirli içkilerimizi bitirip eve giderken zehirleyen kişi de bizi takip eder...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000518
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000518,
					"content": "Biz uyurken odamıza girer ve su şişemize ikinci bir ilacı karıştırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000519
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000519,
					"content": "Ertesi gün dışarıdayken su şişenden bir yudum alırsın. Bu sırada iki ilaç vücudunda karışır ve tepkimeye girer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000520,
					"content": "Ondan sonra da biz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000521
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000599,
					"content": "Telaşlı ayak sesleri birden yakınlaşıyor...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "Değerli müşterimiz, tam olarak neden bahsediyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000522,
					"content": "Kahveye zehir koymak mı? Lütfen işletmemde böyle şakalar yapmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000523
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000523,
					"content": "Şakalarınız yüzünden diğer müşterilerim etkilenecek olursa gitmenizi istemek durumunda kalırım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000524,
						748000525
					],
					"speakerTitle": "Arouet"
				},
				{
					"id": 748000524,
					"content": "Bayım, açıklamama izin verin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000525,
					"content": "O benim arkadaşım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000526,
					"content": "Guijarro'nun durumunu Arouet'ye açıklıyorsun. Dinledikten sonra sinirli bir şekilde oradan ayrılır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000527
					]
				},
				{
					"id": 748000527,
					"content": "Özür dileme maksadıyla Guijarro üç fincan daha kahve alır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						748000528
					]
				},
				{
					"id": 748000528,
					"content": "Bu sefer onu kahve yaparken izledin! Bir sorun olması ihtimali yok.",
