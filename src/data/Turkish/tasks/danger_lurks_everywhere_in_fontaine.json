			"dialogs": [
				{
					"id": 748000401,
					"content": "Neden yine saklanıyorsun? Burada hiçbir şey yok ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000402,
					"content": "Meka Jandarmayı görmüyor musun? Tam önümüzde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000403,
						748000404
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000403,
					"content": "Nesi varmış?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				},
				{
					"id": 748000405,
					"content": "Şşş! Çabuk, çıkın oradan! Ya kontrolü kaybederse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000406
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000406,
					"content": "Veya belki de... Güç çekirdeği aniden havaya uçar! Ya da uzaktan onu kumanda eden birileri onunla bize saldırı düzenler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000407
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000407,
					"content": "Bana tamamen normal görünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000408
					]
				},
				{
					"id": 748000408,
					"content": "Tam da bu sebepten ötürü korkuyorum! Normal çalışan bir mekanın aniden kontrolü kaybetmesi ve bahtsız zavallı birinin aniden hayatından olması...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000409
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000409,
					"content": "Böyle bir şeyden kimse sorumlu da tutulamaz! Gerçek suçlu belki de asla bulunamaz... Hayır, bu fazla tehlikeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000410
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000410,
					"content": "Gitti bile, hadi artık çıkabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000411,
					"content": "Off... Kontrolden çıkmadı neyse ki. Hayatlarımız bir kez daha bağışlandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000412,
						748000413
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000412,
					"content": "Böyle bir kaza olması mümkün değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000414,
					"content": "Aklımdaki daha çok \"kasti kaza\" gibi bir şeydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000415
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000415,
					"content": "Bekle. Suçlusu olmayan bir suç... Sorumluluğunu hiç kimsenin almadığı bir vaka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000416
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000416,
					"content": "İşte bu! Aradığım ilham geldi! Çabuk, çabuk kafeye gidelim! Bunu yazmam gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000417
					],
					"speakerTitle": "Guijarro"
				},
				{
					"id": 748000417,
					"content": "Hey! Yavaşla, birileri taş atar da tökezleyip düşerim diye korkmuyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 748000413,
					"content": "Zaten en baştan kontrolü kaybetmesi imkansız, anladın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000404,
					"content": "Iı... Yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				}
			]
		},
