				"points": []
			},
			"dialogs": [
				{
					"id": 210261001,
					"content": "Ne oldu? Şişeyi gönderdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261002
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261002,
					"content": "Şişe Minik Meng'e gerçekten ulaşacak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261003
					]
				},
				{
					"id": 210261003,
					"content": "Heh. Pek ihtimal vermiyorum. Hatta imkansız bile diyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261004
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261004,
					"content": "E o zaman niye uğraştık bu kadar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210261005,
					"content": "Haha, merak etme. Sorumlu bir yetişkinin ona yardım edeceğini söylemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261006
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261006,
					"content": "Sumeru diye bir yer biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261007
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261007,
					"content": "İş adamı birkaç arkadaşım var. Mantar işine girmeyi planlıyorlar, piyasa araştırması yapmak için Sumeru'ya gidecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261008
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261008,
					"content": "Ancak senin de bildiğin üzere \"piyasa araştırması\" sırasında bir sürü boş vaktin de oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261009
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261009,
					"content": "Minik Meng de gezmek istediğine göre arkadaşlarıma yanlarında birini götürebilirler mi diye sorabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261010
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261010,
					"content": "Kafana takma. Her şeyi ben ayarlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261011
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261011,
					"content": "Başka bir sebepten dolayı mektubun bir kopyasını çıkarmıştım. Şişeye gelince... Bırak yoluna gitsin ama kimsenin alacağını sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261012,
						210261013
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261012,
					"content": "Yardım ettiğin için sağ ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				},
				{
					"id": 210261014,
					"content": "Çocukların hayallerini yerine getirmek yetişkinlerin yapması gereken bir şey değil mi? Merak etme, bu iş bende.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210261015
					],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261015,
					"content": "Ha, evet. Arkadaşlarıma biraz daha iyi giyinmelerini söyleyeyim. İnsanları korkutmak bir işe yaramaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yue Chuan"
				},
				{
					"id": 210261013,
					"content": "Neden Minik Meng'e bu kadar yardım etmek istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210261014
					]
				}
			]
		},
