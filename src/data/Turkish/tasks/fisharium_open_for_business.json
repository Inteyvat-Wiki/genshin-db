			"dialogs": [
				{
					"id": 747020101,
					"content": "Vay be, son zamanlarda ne kadar çok balık getirdiniz öyle. Akvaryum neredeyse gerçek bir okyanus gibi oldu artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020102
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747020102,
					"content": "Hehehe, balıkçık yakalama işinde usta sayılırız artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020103,
					"content": "İşinizle epey gurur duyuyor gibisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020104
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747020104,
					"content": "Hem de nasıl! Ama o başarı duygusunun arkasında yatan başka bir şey var... Nasıl denir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020105,
						747020106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020105,
					"content": "Pişmanlık mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				},
				{
					"id": 747020107,
					"content": "Evet, işte bu! Paimon içten içe bunları hissediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020108,
					"content": "Neden ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020109
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747020109,
					"content": "Paimon emin değil... Sadece bir şeyler eksikmiş gibi geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020110,
						747020112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020110,
					"content": "Restoran olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020111
					]
				},
				{
					"id": 747020111,
					"content": "Hey! Öyle şeyler söyleme! İnsan böyle güzel balıkçıkları yemeye nasıl kıyabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020114,
					"content": "Eksik olan tek şey, gelip bu muhteşem eserimizi hayran hayran seyredecek ziyaretçiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020115,
					"content": "Yani... Akvaryumu ziyarete açmak mı istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020116
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747020116,
					"content": "Olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020117,
						747020118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020117,
					"content": "Çok gürültülü olacağından mı endişeleniyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020119,
					"content": "Eğer öyleyse sen her şeyi bize bırak! Reklamıydı, günlük ıvır zıvır işleriydi hepsini biz hallederiz. Sen sadece kendi işine odaklan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020120,
					"content": "İstediğiniz buysa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020121
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747020121,
					"content": "Geliri 30'a 70 bölüşebiliriz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020122
					]
				},
				{
					"id": 747020122,
					"content": "Ha? Sadece %70 mi alacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020123,
					"content": "Hayır, %70'ini Sandrone alacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020124
					]
				},
				{
					"id": 747020124,
					"content": "Ah, doğru, tabii ya... Sonuçta bu tekneyi kiralayan Sandrone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020125,
					"content": "Off, duyan da zorba bir mülk sahibi falan sanacak beni. İşi siz yapıyorsunuz, büyük payı sizin almanız lazım. Ben Pantalone gibi cimri değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020126
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747020126,
					"content": "Yani... İzin veriyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020127,
					"content": "Evet, benden yana sıkıntı yok. Sadece araştırmama engel olmasın yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020128
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747020128,
					"content": "Vuhuuu! Wingalet Gluk-Gluk Eğlenceli Su Altı Balıkvaryumu resmen hizmete açıldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020129,
					"content": "*iç çeker* Tabii ya, ismi de hazırlamışsın çoktan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747020118,
					"content": "Çok fazla soruna yol açacağından mı endişeleniyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020119
					]
				},
				{
					"id": 747020112,
					"content": "Ziyaretçi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020113
					]
				},
				{
					"id": 747020113,
					"content": "Aa! Evet!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747020114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747020106,
					"content": "Yalnızlık mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747020107
					]
				}
			]
		}
	]
}