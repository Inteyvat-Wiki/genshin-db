			"dialogs": [
				{
					"id": 3730201,
					"content": "Burada ne arıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730202,
					"content": "Acaba beni takip ediyor olabilir misin diye düşünüyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730203,
					"content": "Rüzgar Tanrısı hakkında daha fazla bilgi edinmek istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730204
					]
				},
				{
					"id": 3730204,
					"content": "Hâlâ Rüzgar Tanrısı Barbatos diyorsun. Çok uzun zaman önce Mondstadt'tan gitti o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730205,
					"content": "Liyue ve Inazuma'nın Toprak ve Elektrik tanrıları hâlâ buradalar ama Mondstadt'ın kendi tanrısını son kez görmesinden bu yana çok uzun süre geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730206,
					"content": "Rüzgar Tanrısı hakkında bilgi edinmek istiyorsun demek. Bunun Dvalin'le bir ilgisi var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730207,
					"content": "Ah, evet... Çünkü tanrılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730208,
					"content": "Evet, biri bana Dvalin'in geçmişinden söz etti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730209
					]
				},
				{
					"id": 3730209,
					"content": "Nasıl oluyor da herkes Fırtına Dehşeti'ni görüyor? Cidden merak ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730210,
					"content": "Yine de acele etmeye hiç gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730211,
					"content": "Bir süredir buralarda değildim. Görünüşe göre, dönüşümden pek memnun olmayanlar var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
		{
			"id": 37304,
			"completionStepIds": [
				37304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
