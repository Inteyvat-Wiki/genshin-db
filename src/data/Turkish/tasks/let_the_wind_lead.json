				"points": []
			},
			"dialogs": [
				{
					"id": 3730401,
					"content": "Galiba rüzgardaki değişimden etkilenen yalnızca ejder değildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730402,
					"content": "Birilerinin sana ejder hakkında bir şeyler anlattığını söylüyordun, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730405,
					"content": "Öyle mi? Oldukça alim bir kişi olduğunu söylemem gerek, şu Lisa'yı diyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730406
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730406,
					"content": "Yanılmıyor. Çatışmanın bu noktaya gelmesinin tek nedeni, iki tarafın da güç kullanmaya başvurmuş olması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730407,
					"content": "Ama onun nefreti Dört Rüzgara hürmet etmeyen insanlardan kaynaklanmıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730408,
					"content": "Doğasından da kaynaklanmıyordu. Onun nefreti, aşağılanmasının bir sonucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730409
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730409,
					"content": "Aşağılanma mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730410,
					"content": "Damarlarında akan siyah kan ona yıllardır eziyet ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730412,
					"content": "Hiçlik Büyücüsü mü? Bu adı hiç duymadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730413
					]
				},
				{
					"id": 3730414,
					"content": "Galiba eskiden Mondstadt'ta onlardan söz edildiğini duymuştum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730415
					]
				},
				{
					"id": 3730411,
					"content": "Hiçlik Büyücüsünün yalanlarıyla baştan çıkmasının nedeni bu kan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730412,
						3730414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730413,
					"content": "Hiçlik Tarikatından geliyorlar. İnsan dışı varlıklardan oluşan bir düzen. İnsan türünden nefret ederler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730415,
					"content": "Doğru. Hiçlik Tarikatından geliyorlar. İnsan dışı varlıklardan oluşan bir düzen. İnsan türünden nefret ederler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730416,
					"content": "Nereden geldiklerini bilmiyorum. Tek bildiğim, insanların dünyasına karşı büyük bir nefret besliyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730417
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730417,
					"content": "Yabandaki birçok dağ yabanisi onlardan emir alır ve onların silahı görevini üstlenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730418
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730418,
					"content": "Buraya gelmeden önce ben de Dvalin gibiydim. Lanetlenmiş bir halde yok olmaya bırakılmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730419
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730419,
					"content": "Ama şimdi, önümüzde Mondstadt'ın temeli olan Mondstadt Kahramanının Sembolü duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730420,
					"content": "Çimenlerin arasından esen rüzgar harika, bıraktığı kokuyu çok seviyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730421
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730421,
					"content": "Bu muhteşem ağacın altında seninle beraber olmak, gözyaşının arınmış olduğu eski zamanları hatırlatıyor bana. Sanki zehir vücudumu terk ediyormuş gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730423,
					"content": "Mmm. Çok daha iyi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730424,
					"content": "Peki, tam olarak nasıl zehirlendin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730425,
					"content": "Dvalin'le önceden iletişime geçmeye çalıştım, ama bir şekilde... Kesintiye uğradı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730426
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730427,
					"content": "Of... Bu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730428,
					"content": "Bu... Benim yüzümden mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730426,
					"content": "Sonuç olarak, Dvalin'in lanetten kurtulmasına yardımcı olamadığım gibi bir de üstüne kendimi de zehirledim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730427,
						3730428
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730429,
					"content": "Evet, senin yüzünden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730431,
					"content": "#{NICKNAME}, bu durumu telafi etmek için benimle Katedrale geliyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730432
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3730432,
					"content": "Mondstadt Katedraline mi? Ama neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3730433,
					"content": "\"Göklerin Kutsal Liri\"ni almak için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		}
	]
}