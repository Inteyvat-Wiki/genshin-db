			"dialogs": [
				{
					"id": 750290101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290102,
						750290103
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290102,
					"content": "Merhaba. Bakar mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				},
				{
					"id": 750290104,
					"content": "Hahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290105
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290105,
					"content": "Ayy! Paimon'un ödünü kopardın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290106,
					"content": "Siz de mi özel eğitim için geldiniz yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290107
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290107,
					"content": "Biliyordum, biliyordum! İster insan olsun ister Sürüngen, cesur savaşçıların yazgısında birbirlerini bulmak vardır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290108
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290108,
					"content": "O halde lafı uzatmadan özel eğitime başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290109,
						750290110
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290109,
					"content": "Burada da varmış demek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290111,
					"content": "Daha ağzımızdan tek bir laf bile çıkmadı! Nereden biliyorsun ki senin o özel eğitimin için geldiğimizi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290112,
					"content": "Yoksa sen... Usta Eğitmen filan mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290113,
					"content": "Öyle önüne gelen Usta Eğitmen olamaz bir kere. Ne yazık ki ben o kadar yetenekli değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290114
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290114,
					"content": "Bir dakika... Onca yolu uçup buraya gelme sebebiniz bendeniz Matahga'dan özel savaşçı eğitimi almak değil mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290115,
						750290116
					],
					"speakerTitle": "Matahga",
					"speakerSubtitle": "Çiçek Tüyü Klanı Yedek Savaşçısı"
				},
				{
					"id": 750290115,
					"content": "Öylesine geçiyorduk sadece...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290117,
					"content": "Sürüngen tepelerinin üstünden uçup buraya kadar gelebilmiş olman, temel becerilere hakim olduğunu gösteriyor zaten ama hırs namına bir şey yok resmen kalbinde... Ne yazık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290118
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290118,
					"content": "Seni de benim gibi bir savaşçı sanmıştım... Vah vah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290119
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290119,
					"content": "Seni yanlış tartmışım belli ki... Nasıl yapabildim ben bunu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290120
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290120,
					"content": "Natlan da kahramanların ülkesi mi, yoksa fevri insanların ülkesi mi belli değil! Buranın çocukları bile coşkudan ele avuca sığmıyor, baksana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290121,
						750290122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290121,
					"content": "Çocuklar mı? Yok canım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290123,
					"content": "Hayır, yanılıyorsunuz! Bir kere savaşçı olmaya karar verdiysen tembellik etme hakkın yok demektir! Cesur, kararlı ve hırslı değilsen asla başarılı olamazsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290124
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290124,
					"content": "Hem ben on iki yaşındayım bir kere! Yaşım çift haneli sayılara ulaştı bile, çocuk değilim yani... Ama neyse, bu seferlik affediyorum sizi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290125
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290125,
					"content": "Bardak bardak süt içmeme rağmen boy atmamış olabilirim ama bendeki iradeyi hiç kimsede bulamazsınız! Önüme çıkan her engeli aşar geçerim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290126
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290126,
					"content": "Ayrıca siz de öyle çok uzun değilsiniz ki... Benimse boyum uzamaya devam ediyor hâlâ!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290127
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290127,
					"content": "Of, bu nasıl bir enerji böyle? Niye kendini bizimle kıyaslamaya başladın ki birden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290128,
					"content": "Hıh! Evet, fiziksel gücümüz bedenlerimize bağlı olabilir ama bu durum gerçek bir savaşçıya diz çöktürmemeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290129
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290129,
					"content": "Önemli olan güçlü bir zihne ve disipline sahip olmaktır. Kendine ve hayallerine inanman lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290130
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290130,
					"content": "Bunların önemini maceracılar bile bilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290131
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290131,
					"content": "Mantıklı konuşuyor aslında ama... Nedense bize kafa tutuyormuş gibi geldi Paimon'a.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290132,
						750290133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290132,
					"content": "Öyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290134,
					"content": "Sert davranmıyorum, sadece siz tembellere hırsın önemini açıklıyorum. Bu tasasızlıkla gerçek bir kahraman olmanız mümkün değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290135
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290135,
					"content": "İdman alanında hırsını ve emeklerini gösteremeyen savaşçılar... Daha doğrusu insanlar birer fiyaskodan ibarettir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290136
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290136,
					"content": "Bir kahraman olarak göklerde süzülemiyorsan, Usta Eğitmenden övgü alamıyorsan başarısız olmaya layıksındır zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290137
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290137,
					"content": "Çok çalışmanız lazım yani, çok! Anladınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290138
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290138,
					"content": "A-Anladık! Şey... Şimdi ne yapacağız peki? Hem bağıra bağıra konuşuyor hem de haklı... Paimon laf yetiştiremez buna!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290139,
					"content": "Güzel! Becerilerinizi göstermeye hazırsanız benimle özel eğitime başlayın! Hedefiniz, parkur boyunca Sürüngeninizle son hızda uçmak ve kazanabildiğiniz kadar puan kazanmak olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290140
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290140,
					"content": "İdman sırasında gözlem yapacak ve her kontrol noktasında performansınıza puan vereceğim. Sonuçlar da bu puanlara göre dört kademeye bölünecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290141
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290141,
					"content": "Uçabildiğiniz kadar hızlı uçun! En üst kademeye çıkamasanız bile en azından ikinci en yüksek skora ulaşmanız lazım, unutmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290142
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290142,
					"content": "Silkelenip kendinize gelmeye bakın, yoksa gözünüzün yaşına bakmadan tozu yuttururum size! Hadi, hadi, hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290143
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290143,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290144
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290144,
					"content": "Savaşçı! Cevabını bekliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290145,
						750290150
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290145,
					"content": "A-Anlaşıldı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290146
					]
				},
				{
					"id": 750290146,
					"content": "Seni duyamadım, DAHA YÜKSEK SESLE SÖYLE!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290147
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290147,
					"content": "ANLAŞILDI!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290148
					]
				},
				{
					"id": 750290148,
					"content": "Savaşçı adayları, kendilerini işte burada geliştirir. Hadi şimdi bana kararlılığını göster ve sınırlarını zorlamaya başla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290149
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290149,
					"content": "Hazır olduğunda eğitim için yanıma gel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290150,
					"content": "Anlaşıldı ama katılmamayı yeğlerim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290151
					]
				},
				{
					"id": 750290151,
					"content": "Ne? Tembelliğe devam mı diyorsun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290152
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290152,
					"content": "Kendine yazık ediyorsun, başka da bir şey değil... Neyse, önemi yok. Günün birinde senin de başarısızlığa tahammülün kalmayacak zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290153
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290153,
					"content": "Sorumluluktan kaçıp saklanarak bir yere varamazsın, elinde hiçbir şey kalmaz bu şekilde! Dimdik ayakta durmanın, dünyayı kahkahalarınla sarsmanın tek yolu kendini ilerlemeye zorlamak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290154
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290154,
					"content": "Matahga demişti dersin! Tabii o gün geldiğinde burada kendini sınamak için çok geç olacak, haberin olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290133,
					"content": "Neden bize karşı bu kadar sert davranıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290134
					]
				},
				{
					"id": 750290122,
					"content": "Abartma ufaklık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290123
					]
				},
				{
					"id": 750290116,
					"content": "Maceracıların merakını hafife alıyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290117
					]
				},
				{
					"id": 750290110,
					"content": "\"Özel eğitim\" ne oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290111
					]
				},
				{
					"id": 750290103,
					"content": "Merhaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290104
					]
				}
			]
		},
		{
			"id": 7502902,
			"completionStepIds": [
				7502904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502904",
							"2"
						],
						"stepId": 7502904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290201,
					"content": "Mükemmel, tek kelimeyle muazzam! Beni ezip geçtin resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290202
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290202,
					"content": "Sürekli özel eğitim parkurunda kendi kendime yarışıp rekorumu kırmaya çalışıyorum ben. Maalesef henüz başarılı olamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290203
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290203,
					"content": "Ancak sen başardın! Bu dünyanın, başarılarıyla beni gölgede bırakan savaşçılarla dolu olduğunu, buradan ayrılmam gerektiğini gösterdin bana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290204
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290204,
					"content": "O kişilerle fikir alışverişinde bulunup bire bir antrenman yaparsam kendimi daha çok geliştirebilirim bence. Günün birinde babam ve kız kardeşim başarılarımla övünüyor olacak, görürsün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290205
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290205,
					"content": "Acomitl'i saymıyorum tabii. Tembel tenekenin tekidir o, ne hırs bilir ne bir şey. Ona kardeşim demekten utanıyorum resmen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290206
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290206,
					"content": "Acomitl mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290207
					]
				},
				{
					"id": 750290207,
					"content": "Neyse, boş ver şimdi onu. Bu kadar sohbet yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290208
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290208,
					"content": "Bak savaşçı, bu sözlerim kulağına küpe olsun! Becerilerinin sınırlarını zorlamayı asla bırakma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290209
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290209,
					"content": "Efsane olmak istiyorsan her zaman tüm gücünle ilerlemelisin! İleri, hep daha ileri gitmelisin! Bu sözler sana veda hediyem olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502905,
			"completionStepIds": [
				7502904,
				7502906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7502906",
							"2"
						],
						"stepId": 7502906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Matahga"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750290501,
					"content": "Savaşçı! Eğitimin nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290502,
						750290504
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290502,
					"content": "İlerleme kaydediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290503
					]
				},
				{
					"id": 750290503,
					"content": "Zayıfsın, zayıf! Unutma, ilerlemeyen insan geri gitmiş demektir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290506,
					"content": "Bu Matahga da \"ileri\" diyor, başka da bir şey demiyor... Başka sözcük bilmiyor resmen çocuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290507,
					"content": "Öyle tabii! Ben diğerlerinden daha azimliyim! Çalışkanlıktan daha önemli bir şey yok bu hayatta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290508
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290508,
					"content": "İkimizin de eğitime ve idmana ihtiyacı var. Sadece Sürüngenlerle çalışmak için eğitim alarak savaşçı olunmuyor, bilesiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290509
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290509,
					"content": "Kendimi geliştirmek için yeni sulara yelken açmalıyım! O yüzden bir süre buralarda olmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290510
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290510,
					"content": "Merak etme! Barakayı söküp yanımda götüreceğim ama pisti burada bırakmayı planlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290511,
						750290513
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290511,
					"content": "Nereye gideceksin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290512
					]
				},
				{
					"id": 750290512,
					"content": "Şey... Babamı ve ablamı görmeye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290515,
					"content": "Matahga önceki kadar özgüvenli durmuyor sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290516,
					"content": "Nesi varmış canım özgüvenimin? Aileye değer vermek, ailene sevgi beslemek her savaşçının sahip olması gereken bir erdemdir! At gözlüklerini çıkarsan keşke artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290517
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290517,
					"content": "Babam Çiçek Tüyü Klanının en iyi Usta Eğitmeni, ablam da en iyi Sürüngen süvarisidir! İkisiyle de çok gurur duyuyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290518
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290518,
					"content": "Dur, dur! Hemen gaza gelme! Paimon kararını sorgulamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750290519,
					"content": "Anladım. O halde bol şans.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290520
					]
				},
				{
					"id": 750290520,
					"content": "Sana da bol şans savaşçı! Sana bir veda tavsiyesi de vereyim o halde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290521
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290521,
					"content": "Ne desem acaba, dur biraz düşüneyim... Heh. Asla pes etme! Ne olursa olsun kahraman ol!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290513,
					"content": "Ne tür bir eğitim alacaksın peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290514
					]
				},
				{
					"id": 750290514,
					"content": "Hımm... Karar vermeden önce onlardan fikir alacağım sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290515
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290504,
					"content": "Son zamanlarda idman yapma fırsatım olmadı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750290505
					]
				},
				{
					"id": 750290505,
					"content": "Bahanen batsın senin! Yoksa tüm hayatını sağda solda gezip aylaklık ederek mi harcıyorsun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290506
					],
					"speakerTitle": "Matahga"
				}
			]
		},
