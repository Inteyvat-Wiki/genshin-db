			"dialogs": [
				{
					"id": 750290801,
					"content": "Ben de bir savaşçı olacağım! En büyük savaşçı olacağım hem de! Bekle de gör.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
