				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750291301,
					"content": "Uçan Sürüngen tüm gün açıktır! Matahga'nın özel eğitimine katılmak istiyorsan gel de Uçan Sürüngen'den göklere havalan! Not: Unutmayın, nasıl ki çok çalışıp idman yapmak bir gurur kaynağıysa tembellik ve işten kaytarmak da o denli büyük bir utanç kaynağıdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291302,
					"content": "Bugün bir işe soyunmayan yarın kapının önüne koyulur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291303,
					"content": "Başını dimdik tutup cesaretle ilerle ki Sürüngen süvarileri gibi yüceliğin tadına varabilesin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7502914,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
