			"dialogs": [
				{
					"id": 750290601,
					"content": "Hiç fena değildin, çalışmaya devam et. Başarabileceğinden eminim ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290602
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290602,
					"content": "Hah, sana böyle kuru sözlerle veda edeceğimi mi sandın yoksa? Olmaz öyle! \"Fena olmamak\" elindekiyle \"idare etmek\" falan bir savaşçıya yakışmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290603
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290603,
					"content": "Hep en iyinin de iyisi olmak için çalışmalısın! Başarısızlık bir kahramanın cezası, nefreti ve belasıdır. Bu kadar net!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750290604
					],
					"speakerTitle": "Matahga"
				},
				{
					"id": 750290604,
					"content": "Cesaretini kaybetme ve çalışmaya devam et! Beni geçene kadar çalış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Matahga"
				}
			]
		},
		{
			"id": 7502907,
