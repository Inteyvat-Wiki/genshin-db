				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750291401,
					"content": "Emir aynen şöyledir: <color=#00E1FFFF>Önce sol, sonra sağ boruyu çal. Ardından tekrar sol boruyu çal</color>! Sırayı karıştırma sakın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291402,
					"content": "(Matahga adında birinin kendine bıraktığı bir not. Nota baktığında ne kadar yoğun duygularla yazıldığını hissedebiliyorsun adeta.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750291403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750291403,
					"content": "(Gerçi her hatırlatmanın sonuna ünlem işareti koyuyorsan ne anlamı var ki? Neyin önemli olup neyin olmadığı belli değil...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
