			"dialogs": [
				{
					"id": 730310101,
					"content": "Araja, Arama, döndük!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310102,
					"content": "#Nara {NICKNAME} ile Paimon'u tekrar gördüğüme çok sevindim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310103,
					"content": "#Dönmüşsünüz! Herkes {NICKNAME} adında çok uzun ve güçlü bir Naranın onlara çok yardımcı olduğunu söylüyordu. Hepsi çok mutluydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310104
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310104,
					"content": "#Birinin sana yardımcı olması her zaman güzeldir, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310105,
						730310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310105,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				},
				{
					"id": 730310107,
					"content": "Hayır, yeni arkadaşlar edindikleri için mutlular. Aranakin, Aranaga ve Aragaru artık hatırlamasa da orman hatırlayacak. Hikaye asla unutulmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310108
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310108,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310109,
					"content": "Utsava Festivali neredeyse hazır. Sadece biraz daha zaman lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310110
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310110,
					"content": "#Evet, başlamak üzere. Her şeyi Nara {NICKNAME} ve Paimon'un yardımına borçluyuz. Festivali gerçekten iple çekiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				},
				{
					"id": 730310106,
					"content": "Doğru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310107
					]
				}
			]
		},
