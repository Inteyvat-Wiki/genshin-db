					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310315
					]
				},
				{
					"id": 730310315,
					"content": "#Aslında gidip Rana'ya bir bakmalıyız {NICKNAME}. Belki şimdi daha iyidir! Öyleyse onu buraya getirebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310316,
						730310317,
						730310318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310316,
					"content": "Haklısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310320,
					"content": "Ben de birazdan gidip Arana'ya bakacağım. Siz beni beklemeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310321
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310321,
					"content": "#Görüşürüz Nara {NICKNAME} ve Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310317,
					"content": "Umarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310320
					]
				},
				{
					"id": 730310318,
					"content": "Pek umudum yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310319
					]
				},
				{
					"id": 730310319,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
