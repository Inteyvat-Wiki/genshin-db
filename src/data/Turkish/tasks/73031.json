						730310320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310311,
					"content": "Ben de sabırsızlanıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310312
					]
				},
				{
					"id": 730310312,
					"content": "Evet! Paimon bunun diğer festivallere kıyasla nasıl olduğunu merak ediyor. Neyse, Paimon arkadaşlarımızla zaman geçireceğimiz için çok heyecanlı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310313,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
