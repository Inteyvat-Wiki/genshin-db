			"dialogs": [
				{
					"id": 730310601,
					"content": "Rana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310602,
					"content": "Paimon onun güzel bir rüya gördüğünü söylemek istiyor ama öyle değil sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310603,
					"content": "(Rana'yı saran baloncukta bulanık bir görüntü belirir.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310604
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730310604,
					"content": "(Görüntü seni çok etkiler.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310605
					]
				},
				{
					"id": 730310605,
					"content": "Bir ormandasın. Her şey dev gibi ve sakin duruyor. Burada çok rahat hissediyorsun.\\nParıldayan, altın rengi yaprakların arasından güneş ışığı sızıyor. Her tarafta senin boyunda çimler savruluyor ve sen yürürken hafifçe elini okşuyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310606
					]
				},
				{
					"id": 730310606,
					"content": "Ağaçların arasından esen rüzgarla akan suyun müziğe benzeyen melodisinin arasında hüzünlü bir feryat duyuyorsun. Sesi takip edince küçük bir kız buluyorsun.\\nAğlamaktan bitkin düşmüş ve çimlerin üzerinde uyumuş. Ona yaklaşıp kısık sesle, tüm varlıkları sakinleştirebilen bir şarkıyı söylüyorsun...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730310607
					]
				},
				{
					"id": 730310607,
					"content": "#Hey, {NICKNAME}! Neler oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310608,
					"content": "Paimon iyi olduğuna çok sevindi... Paimon çok endişelenmişti... Bayılacak gibi duruyordun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310609,
					"content": "#Nara {NICKNAME}! Hepiniz gelmişsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310610
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310610,
					"content": "Ay! Paimon'un ödünü kopardın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310611,
					"content": "Aaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310612,
						730310613
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310612,
					"content": "Aaa!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				},
				{
					"id": 730310614,
					"content": "Aman, ne yapıyorsun Aranara? Neden insanları böyle korkutuyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310615,
					"content": "Önce sen \"Ay!\" dedin Uçuşkan Beyazlı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310616
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310616,
					"content": "O Paimon, Uçuşkan Beyazlı değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310617
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310617,
					"content": "Arana, Ararakalari'nin güçlerini korumak için yerdeydi. Böylece Narana solmaz ama tekrar güçlü olması için hâlâ Bija lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310618
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310618,
					"content": "#Tamam. Paimon anladı. Bu arada az önce {NICKNAME} ne yaşadı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310619
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310619,
					"content": "(Gördüklerini anlat.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310620
					]
				},
				{
					"id": 730310620,
					"content": "Bu Arana'nın hatırası olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310621
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310621,
					"content": "Hatıra mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310622,
					"content": "İzin verin de Arana açıklasın. Hatıraları ve rüyaları bir Aranaranın en kıymetli şeyleridir. Aranara, hatıralar ve rüyalar sayesinde Ararakalariyi kullanarak yardıma ihtiyacı olan Nara ve Aranaralara yardım edebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310623
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310623,
					"content": "#Bazı Naralar, Ararakalarideki hatıraları hissedebilir. Nara {NICKNAME} onlardan biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310624
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310624,
					"content": "Sanki Ararakalari çok önemliymiş gibi söyledin! O mağarada Iotham'ı korumak için Ararakalariyi kullanan da sendin değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310625,
					"content": "Evet, Arana'ydı. Nara Iotham, Nara Kavus ve Nara Sudabeh arkadaş. O nedenle Arana onları korudu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310626
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310626,
					"content": "Ormanda çok zaman geçirdiğimiz için Arana onlara ormanlar ve bitkilerin dili hakkında bir şeyler öğretti. Narana gibi onlar da çok iyi arkadaş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310627
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310627,
					"content": "Kaybolan çocuklar hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310628
					]
				},
				{
					"id": 730310628,
					"content": "Evet! Önceden Iotham, Kavus ve Sudabeh de kayboldu ama daha sonra köye geri getirildiler. O da mı senin sayendeydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310629
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310629,
					"content": "Evet. Arana kötü Naraların ve Nara Valukaların onları götürdüğünü fark edince kötü Naralar başka tarafa bakarken Nara Kavus ile Nara Sudabeh'in kaçmasına yardım etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310630,
						730310632
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310630,
					"content": "Anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310631
					]
				},
				{
					"id": 730310631,
					"content": "Peki niye hiçbir şey hatırlayamadılar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310633
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310633,
					"content": "Arana küçük Naraların uyuyup rüya görmesini sağladı ve rüyalarındaki kötülükleri yok etti. Böylece büyüdüklerinde kötü değil koca ağaçlara dönüşen fidanlar gibi olacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310634
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310634,
					"content": "Yoksa küçük Naralar korkar. Hep korkarlarsa korkunun gücüne inanırlar ve büyüyünce korkutucu, kötü Naralar olurlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310635
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310635,
					"content": "Onlar Arana'nın arkadaşı olduğu için Arana onların kötü Naralar olmasını istemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310636,
						730310638,
						730310640
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310636,
					"content": "Bu mantıklı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310637
					]
				},
				{
					"id": 730310637,
					"content": "Büyüyünce harika insanlar olacaklar! Bu arada elinde onları götürmeye çalışan kötü Naralar hakkında hiç ipucu var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310641,
					"content": "Arana onları asla affetmez. Kötü Naralar ormanın çocukları değiller. Yanlarında bir grup kötü Nara Valuka'yı getiriyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310642
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310642,
					"content": "Vimara Köyü'nde ormanın değil karın çocuğu olan tuhaf bir Nara var. İyi bir Naraya benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310643
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310643,
					"content": "Genelde küçük Naralarla zaman geçiriyor. Onlar da onun hakkında konuşuyor. Bu yüzden Arana onun iyi olduğunu düşünüyor ama Arana onun kötü Naralarla Aranara hakkında konuştuğunu da gördü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310644
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310644,
					"content": "Vimara Köyü'nde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310645,
						730310646
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310645,
					"content": "Fatui üyesi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310647,
					"content": "Nasıl olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310648
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310648,
					"content": "Paimon düşünemiyor bile. Vimara Köyü'ndekiler birbirlerine aile gibi davranmalılar. Rana'nın bu hale gelmesinin sebebi olan kişinin o olmasına değinmiyorum bile...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310649,
						730310650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310649,
					"content": "Gidip o kötü insanı yakalamamız lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310651,
					"content": "Evet. Ne olursa olsun bizden kaçamayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310652
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310652,
					"content": "#Söz verin Nara {NICKNAME} ve Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310653
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310653,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310654
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310654,
					"content": "O kötü Narayı cezalandıracağınıza söz verin ki Nara Iotham, Nara Kavus ve Nara Sudabeh korkmasın. Böylece ağacın filizleri gibi büyüyüp sağlıklı Naralar olabilsinler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310655,
						730310656
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310655,
					"content": "Pekala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310657,
					"content": "Narana artık büyüdüğü için Arana'yı göremiyor ama sorun değil. Onun iyi olduğunu bilmek Arana'yı mutlu ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310658
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310658,
					"content": "Uzun zamandır Narana'yla oynamadım. Güneş birçok kez doğup battı, ay defalarca gökyüzüne yükseldi. Ağaçlarda birçok meyve yetişti ve toprağa geri döndüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310659
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310659,
					"content": "Narana gittikçe uzadı. Önce Arana'nın boyuna geldi. Sonra da küçük bir ağaç kadar oldu. İşte o zaman Arana'yla oynamayı bıraktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310660
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310660,
					"content": "Arana ona orman hakkında birçok hikaye anlattı. Yıldız Mantarları, gökteki yıldızların yansımasıdır. Nilotpala Nilüferinin açtığını görürsen ayın bir dahaki yükselişine kadar şanslı olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310661
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310661,
					"content": "Arana, Nara Iotham ve arkadaşlarına da aynısını öğretecek. Arana onların Narana gibi sorunsuz büyümelerini istiyor. Tabii Rana'nın başına geldiği gibi Maranaya girme kısmı hariç!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310662
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310662,
					"content": "Büyüdüklerinde Rana gibi nelerle karşılaştıklarını unutacaklar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310663
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310663,
					"content": "Nara Iotham, Nara Kavus ve Nara Sudabeh büyüyecek. Unutmaları sorun değil çünkü orman her şeyi hatırlar. Hiçbir şey kaybolmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310664
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310664,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310665
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310665,
					"content": "Orman hatırlar. İyi olan hiçbir şey kaybolmaz. Tüm acılar güzel bir şeye dönüşür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310666
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310666,
					"content": "#Arana! Nara {NICKNAME}! Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310667
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310667,
					"content": "Arama! Arana seni epeydir görmedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310668,
						730310671
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310668,
					"content": "Paimon ne oldu da \"Ay!\" diye bağırmadı bu sefer?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310669
					]
				},
				{
					"id": 730310669,
					"content": "Hadi ama. Paimon o kadar kolay korkmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310670
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310670,
					"content": "Vanarana'da Utsava Festivalini kutlamak için bizi almaya mı geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310672
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310672,
					"content": "#Evet! Artık hazır. Herkes Nara {NICKNAME} ve Paimon'u bekliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310673
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310673,
					"content": "Yaşasın! Utsava Festivali! Arana, sen bizimle gelmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310674
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310674,
					"content": "Arana gelmiyor. Arana çok uzun süre uzak kalırsa Ararakalari dayanamaz ve Narana tehlikeye girer. O yüzden Arana'ya festival yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310675
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310675,
					"content": "Ahh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310676
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310676,
					"content": "#Sorun değil. Nara {NICKNAME} ve Paimon mutlu olduğu sürece Arana, Arama ve Vanarana'daki herkes de mutlu olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310677
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310677,
					"content": "Evet. Bijanın sana ihtiyacı var Arana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310678
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310678,
					"content": "Arana o zamana kadar hazır olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310679
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310679,
					"content": "#Bu senin için Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310680
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310680,
					"content": "Bir çiçek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310681
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310681,
					"content": "Evet. Lütfen ona iyi bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310682,
						730310683
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310682,
					"content": "İyi bakacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310684,
					"content": "#Teşekkür ederim Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310685
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730310685,
					"content": "#Hadi dönelim o zaman Nara {NICKNAME} ve Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730310683,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310684
					]
				},
				{
					"id": 730310671,
					"content": "Utsava Festivaline mi dönüyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310672
					]
				},
				{
					"id": 730310656,
					"content": "Elimden geleni yapacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310657
					]
				},
				{
					"id": 730310650,
					"content": "Onu yakalayacağız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310651
					]
				},
				{
					"id": 730310646,
					"content": "Birisi çocukları mı yakalamaya çalışıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310647
					]
				},
				{
					"id": 730310638,
					"content": "Umarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310639
					]
				},
				{
					"id": 730310639,
					"content": "Büyüyünce harika insanlar olacaklar! Bu arada elinde onları götürmeye çalışan kötü Naralar hakkında hiç ipucu var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730310641
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730310640,
					"content": "Kötü Naralar demişken...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310641
					]
				},
				{
					"id": 730310632,
					"content": "Çocukların kaybolan hatıraları hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310633
					]
				},
				{
					"id": 730310613,
					"content": "Bunu daha önce gördüğüme eminim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730310614
					]
				}
			]
		},
