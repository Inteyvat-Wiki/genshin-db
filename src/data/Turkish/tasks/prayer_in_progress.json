				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220110101,
					"content": "Of... Bu söylentiyi kim yayıyor ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110102
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110102,
					"content": "Ne söylentisi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110103
					]
				},
				{
					"id": 220110103,
					"content": "Tapınaktaki fal kağıtları hakkındaki söylenti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110104
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110104,
					"content": "Fal kağıtlarının ne olduğunu biliyorsun, değil mi? Kura çekerek yapılan bir astroloji çeşidi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110105
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110105,
					"content": "Çektiğin kağıdın üzerinde yazanlardan basit fallar çıkarabiliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110106
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110106,
					"content": "İyi bir işaret çıkarsa ne mutlu sana. Ancak insanlar genellikle kötü talihten kurtulmak için kötü işaretleri tapınakta bırakıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110107
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110107,
					"content": "Ama işte... Kötü işaret içeren kağıtları ağacın tepesine atarsan kötü şansın hükümdar tarafından bozulacağına dair bir söylenti yayıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110108
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110108,
					"content": "İşin daha da komik bir kısmı var. Bazı insanlar kağıdı ne kadar yükseğe atarsan iyi şansın o kadar hızlı geleceğini ve kötü şansın o kadar hızlı bozulacağını düşünüyor. Saçmalığa bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110109
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110109,
					"content": "Söylentiler giderek abartılınca insanlar ağaca Mora da atmaya başladılar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110110
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110110,
					"content": "Attığın Mora dallara takılırsa duan kabul oluyormuş. Hem dileğin gerçekleşecek hem de bir yıl boyunca iyi şansın olacakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110111,
						220110114
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110111,
					"content": "Bu doğru mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110112
					]
				},
				{
					"id": 220110112,
					"content": "Değil tabii ki! Ettiğimiz duaların duyulup duyulmadığını bir kenara bırakalım... Mora atmak kadar saçma bir şey olabilir mi? Ayrıca Moraların hepsi aynı görünmüyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110113
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110113,
					"content": "Hükümdar kimin attığını anlamak için her bir Morayı tek tek alıp bakacak mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110116,
					"content": "İnsanların iyi şans için dua etmek istediğini anlıyorum, ama... Ağaca bir şeyler fırlatmak şans getirmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110117
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110117,
					"content": "Ayrıca zaten rüzgar çıkınca her şey yere düşüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110118
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110118,
					"content": "Ağacı kendim temizlemeye çalıştım ama pek formda değilim. Hem temizlemeyi başaramadım hem de uzun bir süre ağaçta kaldım, aşağı inemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110119
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110119,
					"content": "Ama ağacı bu halde de bırakamam... Rica etsem çatıya çıkıp biraz temizlik yapabilir misin Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110120,
						220110122
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110120,
					"content": "Tabii ki, hiç sorun değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110121
					]
				},
				{
					"id": 220110121,
					"content": "O zaman sana güveniyorum Gezgin. Çatıya çıkıp etrafı temizle, fal kağıdı bulursan da lütfen bana getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110122,
					"content": "Kağıtları ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110123
					]
				},
				{
					"id": 220110123,
					"content": "Şey... Bayan Hotomi en nihayetinde onların rağbet gören fallar olduğunu söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110124
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110124,
					"content": "O nedenle çöpe atmak uygun olmaz. Bana getirdiğin kağıtları ait oldukları yere koyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110125
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110125,
					"content": "*iç çeker* Herkes en başından kurallara uysaydı bu kadar sıkıntı çekmezdik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110126
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110126,
					"content": "O zaman sana güveniyorum Gezgin. Çatıya çıkıp etrafı temizle, fal kağıdı bulursan da lütfen bana getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110114,
					"content": "Söylentilerin yanlış olduğunu açıklayıp sorunu çözemez miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110115
					]
				},
				{
					"id": 220110115,
					"content": "Bu söylentilere inanan çok fazla insan var. Herkesi ikna edebileceğimi sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110116
					],
					"speakerTitle": "Maki"
				}
			]
		},
