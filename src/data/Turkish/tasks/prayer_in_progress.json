			"dialogs": [
				{
					"id": 220110201,
					"content": "Bitirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110202
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110202,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220110203
					]
				},
				{
					"id": 220110203,
					"content": "Çok teşekkürler. Fal kağıtlarını bana bırakabilirsin, onları doğru yere asacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110204
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110204,
					"content": "Yardımının karşılığı olarak bunları kabul et lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110205
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110205,
					"content": "İnsanların kötü şanstan kurtulmak ve iyi şans kazanmak istediklerini anlıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110206
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110206,
					"content": "Ama sorunlarını gerçekten çözmek istiyorlarsa kendi eylemlerinin fal kağıtlarından daha etkili olacağını düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220110207
					],
					"speakerTitle": "Maki"
				},
				{
					"id": 220110207,
					"content": "Kendileri eyleme geçmezlerse tanrılardan nasıl yardım bekleyebilirler ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Maki"
				}
			]
		},
