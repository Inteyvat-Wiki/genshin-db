				"points": []
			},
			"dialogs": [
				{
					"id": 220200201,
					"content": "Gezgin, burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200202
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200202,
					"content": "Bunu sana Ryuuji gönderdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200203
					]
				},
				{
					"id": 220200203,
					"content": "Öyle mi? Bir bakalım... Vay, Kiraz Çiçekli Pirinç Keki... Ah şu Ryuuji... Bunu yapmasına hiç gerek yoktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200204
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200204,
					"content": "Selam Andou. Böyle ihtiyatlı davranmayı bırak. Gezgin bir yabancı olabilir ama bize yardım etti, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200205
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200205,
					"content": "Ryuuji'nin sevdiğimiz tatlıları hatırlamasına şaşırdım. Demek ki onunla iş arkadaşı olmanın faydaları varmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200206
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200206,
					"content": "Ryuuji ile birlikte mi çalıştınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200207
					]
				},
				{
					"id": 220200207,
					"content": "Hımm? Sana bahsetmedi mi? Kendisiyle kısa bir süre çalışmıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200208
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200208,
					"content": "Ancak sonrasında başına bir iş geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200209
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200209,
					"content": "Sango sayesinde gerçek suçlu yakalandı ve Ryuuji beraat etti. Sonrasında polis karakolundan ayrıldı ve Sango'nun yanında çalışmaya gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200210
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200210,
					"content": "Bu kadarını biliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200211
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200211,
					"content": "Anladım, aşağı yukarı öyle olmuştur zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200212
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220200212,
					"content": "Evet. Bizim yanımızda olmaktansa Sango ile olmak ona daha iyi geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200213
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200213,
					"content": "İmkanım olsaydı ben de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200214
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200214,
					"content": "Kendine gel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200215
					],
					"speakerTitle": "Andou"
				},
				{
					"id": 220200215,
					"content": "Neyse! Teşekkür ederim Gezgin. Şu tatlıları da alayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200216
					],
					"speakerTitle": "Amano"
				},
				{
					"id": 220200216,
					"content": "Ryuuji ve Sango'ya benden selam söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Amano"
				}
			]
		},
