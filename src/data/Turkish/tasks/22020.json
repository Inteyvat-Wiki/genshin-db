				"objectNames": [
					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200501,
					"content": "Başını ağrıttığım için de kusura bakma Gezgin. Hepsine hediye verdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200502,
						220200503
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200502,
					"content": "Yani tüm bunları Sango mu ayarladı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				},
				{
					"id": 220200504,
					"content": "Her şeyi öğrendin mi? Kusura bakma... Bunları sana teslim ettirmek Sango'nun fikriydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200505
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200505,
					"content": "Sango bu davayı çözmede ve gerçek suçluyu ortaya çıkarma aşamasında çok önemli bir rol oynayacağını söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200506,
						220200510
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200506,
					"content": "Dava hâlâ tam anlamıyla çözülmedi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200507
					]
				},
				{
					"id": 220200507,
					"content": "Çözülmedi. Sango tüm delillerin mükemmel bir şekilde \"suçluyu\" işaret ettiğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200508
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200508,
					"content": "Sango soruşturmaya başladığında \"suçluya\" doğrultulan tüm ipuçları ve deliller doğrudan onun eline geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200509
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200509,
					"content": "İşin sonunda o kişi polis tarafından suçlu olarak tutuluyordu fakat Sango gerçek suçlunun başka birisi olduğunu düşünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200514,
					"content": "Sanırım beni ofisine davayı çözme olasılığını değerlendirmek için almıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200515
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200515,
					"content": "Sanki bir işe yarayacakmışım gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200516
					]
				},
				{
					"id": 220200516,
					"content": "Sango'nun zihninden geçenleri okumak zor ama bir keresinde Inazuma'da çok uzun süre kaldığı için artık geniş bir bakış açısıyla bakamıyor olabileceğini söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200517
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200517,
					"content": "Bilgili ve gözü açık birini bulabilseydik belki de davayı çözebilecek önemli bir gelişme kaydedebilirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200518
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200518,
					"content": "Sanırım Sango ona yardım edebilecek tek kişinin sen olduğunu düşünüyor Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200519,
						220200521
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200519,
					"content": "Ben de artık bir dedektif mi oldum yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200520
					]
				},
				{
					"id": 220200520,
					"content": "Bize yardım etmek istiyorsan evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200523,
					"content": "Büromuza çok yardımcı oldun, bu nedenle sana bir ön ödeme yapmak istiyoruz, lütfen kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200524
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200524,
					"content": "Bunları söylemeni de mi Sango istedi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200525
					]
				},
				{
					"id": 220200525,
					"content": "Hayır, şu an tamamen kendi adıma konuşuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200526
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200526,
					"content": "Yardımın için tekrar çok teşekkür ederim. Buralara daha sık uğra lütfen. Sango'nun da hoşuna gideceğine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200521,
					"content": "Bu davadan iyi para gelecek sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200522
					]
				},
				{
					"id": 220200522,
					"content": "Sana tam bir rakam veremem ancak iyi bir ücret alacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200523
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200510,
					"content": "Sango'nun kusursuz suç dediği dava mı bu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200511
					]
				},
				{
					"id": 220200511,
					"content": "Aynen öyle. Sango tüm delillerin mükemmel bir şekilde, aslında gerçek olamayacak kadar mükemmel şekilde \"suçluyu\" işaret ettiğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200512
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200512,
					"content": "Sango soruşturmaya başladığında \"suçluya\" doğrultulan tüm ipuçları ve deliller doğrudan onun eline geçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200513
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200513,
					"content": "İşin sonunda o kişi polis tarafından suçlu olarak tutuluyordu fakat Sango gerçek suçlunun başka birisi olduğunu düşünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200514
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200503,
					"content": "Neler olduğunu bana anlatabilirdin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200504
					]
				}
			]
		},
