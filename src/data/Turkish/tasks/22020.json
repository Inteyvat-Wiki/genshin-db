			},
			"dialogs": [
				{
					"id": 220200404,
					"content": "Çok güzel bir yer, değil mi? Buraya sık sık gelirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200405
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200405,
					"content": "Manzarası, havası bir ayrı güzeldir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200406
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200406,
					"content": "Bana bir şey sormak istiyorsan şimdi tam sırası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200407,
						220200409
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200407,
					"content": "Sen de mi Ryuuji'nin eski meslektaşlarındansın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200408
					]
				},
				{
					"id": 220200408,
					"content": "Bunu sana Ryuuji mi söyledi? Öyleyim, bir keresinde onunla beraber çalışmıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200411,
					"content": "O zaman yaşanan şeyleri Ryuuji sana anlattı mı bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200412
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200412,
					"content": "O zamanlar Ryuuji çok fevri birisiydi. Bir tuzağa düştü ve günah keçisi ilan edildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200413
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200413,
					"content": "Ona arka çıkmama rağmen hakim ona hüküm giydirmekte ısrarcıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200414
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200414,
					"content": "Bu olayı soruşturmaya yardım etmesi için birçok kişiye danıştım fakat ya elleri boş döndüler ya da soruşturmaya devam etmememi söylediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200415
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200415,
					"content": "Eh, nasıl desem? O zamanlar ben de uyarıyı dikkate aldım ve soruşturmayı yarıda bıraktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200416
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200416,
					"content": "Aynı Ryuuji'nin haksız yere suçlanması gibi bu da herkesin bildiği bir \"sır\"; bu nedenle seninle paylaşmakta bir sakınca görmüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200417
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200417,
					"content": "Fakat herkes bildiği için...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200418
					]
				},
				{
					"id": 220200418,
					"content": "Aslında herkes bildiği için kimsenin müdahale etmeye cesareti yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200419
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200419,
					"content": "Neyse ki bu işin içinde olmayan bir dedektif bir iş için polis karakoluna geldi ve bu davayla ilgilendiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200420
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200420,
					"content": "O dedektif sayesinde dava çözüldü ve Ryuuji'nin adı temize çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200421
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200421,
					"content": "Sonrasında Ryuuji polislikten ayrıldı ve o dedektif adına çalışmaya başladı. Bütün hikaye bundan ibaret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200422
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200422,
					"content": "Bunu bana neden anlatıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200423
					]
				},
				{
					"id": 220200423,
					"content": "Bu hediyeyi bana vermeni kim istedi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200424
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200424,
					"content": "Ryuuji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200425
					]
				},
				{
					"id": 220200425,
					"content": "Bu hediye kesin Sango'nun başının altından çıkmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200426
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200426,
					"content": "Ryuuji'nin öyle bir karakteri var ki, Sango hediyeyi bizzat onun teslim etmesini isteseydi, iki eli kanda bile olsa o hediyeyi zarar görmemiş bir halde bana teslim ederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200427
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200427,
					"content": "Tabii Ryuuji bunu senin teslim etmeni istediğine göre bu iş Sango'nun başının altından çıkmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200428
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200428,
					"content": "Yani Sango tüm bunları öğrenmemi mi istiyordu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200429
					]
				},
				{
					"id": 220200429,
					"content": "Hahaha, gözünden de hiçbir şey kaçmıyor. Sen buradayken Sango'nun \"Artık yeni bir yardımcım var.\" dediğini duyar gibiyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200430
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200430,
					"content": "Yaşananları hâlâ atlatamamış olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200431
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200431,
					"content": "Öyle olması normal aslında. Sonuçta kimin tuzak kurduğunu bulamadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200432
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200432,
					"content": "Bildiğim her şeyi anlattığıma göre Sango'ya katılıp katılmayacağına karar vermek senin elinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200433
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200433,
					"content": "Bu arada Kiraz Çiçekli Pirinç Keki için Ryuuji'ye teşekkürlerimi ilet. En sevdiğim yiyeceklerden birisidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200409,
					"content": "Ryuuji polisliği neden bıraktı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200410
					]
				},
				{
					"id": 220200410,
					"content": "Tamamen kendi kararıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200411
					],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202005,
