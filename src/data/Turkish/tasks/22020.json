					"Ryuuji"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220200101,
					"content": "Heh. Dünya küçük, değil mi Gezgin? Sango yeniden karşılaşacağımızı söylediğinde yanılmıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200102
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200102,
					"content": "Seni buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200103
					]
				},
				{
					"id": 220200103,
					"content": "Sango bu son işi tamamlamamı istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200104
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200104,
					"content": "Bunun için yardımlarından dolayı Doushine teşekkür etmek üzere tatlı götürüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200105,
						220200106
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200105,
					"content": "Asıl onların bize teşekkür etmesi gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				},
				{
					"id": 220200107,
					"content": "Doğru. Bu da onlarla ilişkilerimizi geliştirmek için bir bahaneden öte bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200108
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200108,
					"content": "Ne de olsa bir gün dedektiflik büromuz için yardım gerekebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200109,
						220200110
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200109,
					"content": "Tıpkı Sango gibi düşünüyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200111,
					"content": "Haha, evet. Sezgilerin her zamanki gibi keskin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200112
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200112,
					"content": "Peki tüm bu olan biten hakkında kişisel fikrin ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200113
					]
				},
				{
					"id": 220200113,
					"content": "Ben mi? Amano ve Andou ile... Eskiden iş arkadaşıydık, bu nedenle nazik bir ziyaret yapıp tatlı götürmek oldukça normal bir davranış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200114
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200114,
					"content": "Fakat Sango bugün benden başka bir konuyu araştırmamı istedi. Bu nedenle zamanım biraz kısıtlı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200115
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200115,
					"content": "Gezgin, bu tatlıları üç kişiye ulaştırmama yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200116,
						220200118
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200116,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200117
					]
				},
				{
					"id": 220200117,
					"content": "Yardımın için teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200121,
					"content": "İşte; Amano, Andou ve Bay Owada için üç paket tatlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200122
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200122,
					"content": "Bay Owada mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200123
					]
				},
				{
					"id": 220200123,
					"content": "O aynı zamanda... Eski meslektaşım. Polis teşkilatından ayrılmadan önce aramız iyiydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200124
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200124,
					"content": "Ayrıca eski bir seri hırsızlık vakasında polisle bağlantılı konularda da yardımcı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200125
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200125,
					"content": "O zaman bu işi sana bırakıyorum, Gezgin. Tatlıyı teslim ettikten sonra burada buluşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200118,
					"content": "Onları senin teslim etmenin daha iyi olacağını düşünüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200119
					]
				},
				{
					"id": 220200119,
					"content": "Fakat Sango'nun isteği daha önemli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200120
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200120,
					"content": "Üçünü daha sonra ziyaret etmek için zamanım olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200121
					],
					"speakerTitle": "Ryuuji"
				},
				{
					"id": 220200110,
					"content": "Bunu sana Sango öğretmiş olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200111
					]
				},
				{
					"id": 220200106,
					"content": "Biz onlara yardım ettik öyle değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200107
					]
				}
			]
		},
		{
