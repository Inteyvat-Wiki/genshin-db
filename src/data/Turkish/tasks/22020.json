				"points": []
			},
			"dialogs": [
				{
					"id": 220200301,
					"content": "Şey... Sen Gezginsin, değil mi? Amano'nun senden bahsettiğini duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200302
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200302,
					"content": "Beni ne için görmek istemiştin acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200303
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200303,
					"content": "Bunu Ryuuji gönderdi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220200304
					]
				},
				{
					"id": 220200304,
					"content": "Vay, Kiraz Çiçekli Pirinç Keki göndermiş... Öyle sıradan bir yiyecek değil bu, tadını çıkarmak için güzel bir yer bulmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200305
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200305,
					"content": "Uesugi, lütfen bir süreliğine yerime bakar mısın? Beni görmeye gelen biri olursa biraz beklemesini söyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200306
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200306,
					"content": "Ama Bay Owada... Daha mesai bitmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200307
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200307,
					"content": "Haha, sorun değil. Biraz hava alıp geleceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200308
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200308,
					"content": "*iç çeker* Tamam ama çabuk gelin lütfen. Üstlerimizden biri gelecek olursa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200309
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 220200309,
					"content": "Merak etme. Daha yeni bir dava çözdük, bu saatten sonra bizi anca övmeye gelirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200310
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200310,
					"content": "Burası sana emanet Uesugi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220200311
					],
					"speakerTitle": "Owada"
				},
				{
					"id": 220200311,
					"content": "Bana eşlik etmeni rica ediyorum Gezgin. Kiraz Çiçekli Pirinç Kekinin tadını çıkarmak için muhteşem bir yer biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Owada"
				}
			]
		},
		{
			"id": 2202004,
			"completionStepIds": [
				2202005
			],
