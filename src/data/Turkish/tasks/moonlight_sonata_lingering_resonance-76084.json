			"dialogs": [
				{
					"id": 760840101,
					"content": "Aa, siz miydiniz? Kuuhenkiler yine lir çalıyorlar. Onlara geçen seferki gibi bir şarkı çalabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840102
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760840102,
					"content": "Ayrıca ben de farklı bir şeyler dinlemek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760840103,
					"content": "(Hımm, ne çalsam acaba...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
