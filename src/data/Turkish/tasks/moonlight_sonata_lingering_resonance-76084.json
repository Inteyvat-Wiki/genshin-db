			"dialogs": [
				{
					"id": 760840201,
					"content": "Columbina'nın hep söylediği şarkıyı deneyelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202
					]
				},
				{
					"id": 760490202,
					"content": "Columbina'nın hep söylediği şarkıyı deneyelim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "(Acaba nasıl bir tonda çalsam...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "Sakin ve nazik bir tonda çalmayı deneyeyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "Çok güzeldi. Gerçekten de şarkımı ezberlemişsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490605,
					"content": "Hehe, sadece çok güzel söylediğin için! Sesini duyduğumuzda, sadece dinlemek için durduğumuz oluyor bazen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490606,
					"content": "Kuuhenkiler de performansından oldukça etkilenmiş görünüyorlar. Belki birkaç şey öğrenmişlerdir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490607,
					"content": "Gelecekte onlara bir şeyler öğretmen için yine yardımına ihtiyacım olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490608,
					"content": "Al hadi, elini uzat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490609,
					"content": "Ha? Hayır hayır, bu ücretsiz bir performanstı. Eğitim ücreti gerekmiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490610,
					"content": "Hım? Eğitim ücreti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490611,
					"content": "Ben sadece... Ay ışığının nazik parıltısının böylesine güzel bir melodiye çok yakışacağını düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490701,
					"content": "Neşeli bir tonda çalalım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "Aa, bitti mi hemen? Sonsuza kadar dinleyebilirdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490703,
					"content": "Daha önce de söylediğim gibi, hatırladığım tek ninni bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490704,
					"content": "Anlamını henüz tam olarak anlamamış olsam da senin çalışını dinledikten sonra ayda beni bekleyen cevap her ne ise... En azından güzel bir şey olmalı gibi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490705,
					"content": "Bana elini ver.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 760490706,
					"content": "Sorun değil. Cidden, bize karşılığında bir şey vermene gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760490707,
					"content": "Ah, niyetim o değildi... Sadece melodini nazik bir ay ışığıyla süslemek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Hanım"
				}
			]
		},
