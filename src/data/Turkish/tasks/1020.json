			"dialogs": [
				{
					"id": 10200101,
					"content": "İşte bak, orada! Yeşim Konak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200102,
						10200103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200102,
					"content": "Oldukça yüksekteymiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				},
				{
					"id": 10200104,
					"content": "Hım... Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200105,
					"content": "Bu hiç iyi değil... Paimon sana kılavuzluk edecekti fakat Paimon Yeşim Konak'a giden yolu bilmiyor ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200106,
						10200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200106,
					"content": "Bunu şimdi mi fark ettin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200108,
					"content": "Off...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200109,
					"content": "Yeşim Konak'a gitmek istiyorsak mantıklı olanı yapıp haritada bulunduğu noktaya gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200110,
					"content": "Etrafa bakınalım. Buralarda bir yerde yukarı çıkabileceğimiz bir yol olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200107,
					"content": "Şu elçi Ganyu'ya sormalıydık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200108
					]
				},
				{
					"id": 10200103,
					"content": "Peki oraya nasıl çıkacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200104
					]
				}
			]
		},
		{
