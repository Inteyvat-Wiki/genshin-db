			"dialogs": [
				{
					"id": 10200601,
					"content": "Durun! Neler oluyor burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200602
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200602,
					"content": "Leydi Keqing, bu iki tuhaf yabancı bir anda ortaya çıktı. Görünüşe göre Guizhong Balistası ile ilgili bazı emelleri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200603
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200603,
					"content": "Sen kime \"tuhaf\" diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200604,
					"content": "Sadece Yeşim Konak'a giden yolu arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200605
					]
				},
				{
					"id": 10200605,
					"content": "Ne? Yeşim Konak'a mı gitmek istiyorsunuz? Kimsiniz siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200606
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200606,
					"content": "Davetli konuklarız. Liyue'nin Yedi Yıldızını aramak için geldik. Sen kimsin peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200608
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200608,
					"content": "Aslında ben Liyue'nin Yedi Yıldızından biriyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200609
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200609,
					"content": "???",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200610,
					"content": "Adım Keqing; Yedi Yıldızın Yuheng'iyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200611
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200611,
					"content": "Senden haberim var Gezgin. Siz Ningguang'ın konuklarısınız, değil mi? Sizi bu dağlarda görmeyi beklemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200612
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200612,
					"content": "Vay be... Paimon da bu kuş uçmaz kervan geçmez yerde süper zengin, nüfuzlu biriyle karşılaşacağımızı beklemiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200613,
					"content": "Tianheng Geçidi'ndeki Guizhong Balistası uzun zamandır harap durumda fakat bir gecede onarıldı. Ben de bu durumu incelemek üzere buraya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200614
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200614,
					"content": "Bu Taşordu ise sadece burada nöbet tutuyor; amaçları kimseyi tutuklamak değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200615
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200615,
					"content": "Yani bu bir yanlış anlaşılma mı? Paimon'un hiç aklına gelmezdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200616,
					"content": "Akıl etmek o kadar zor bir şey değil Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200617
					]
				},
				{
					"id": 10200617,
					"content": "Her neyse, bir faninin Adeptuslara ait bir mekanizmayı onarabilmesi Yedi Yıldız için bile oldukça gizemli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200618
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200618,
					"content": "He he, bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200619,
						10200620
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200619,
					"content": "(Şşş Paimon, olay dallanıp budaklanmasın!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				},
				{
					"id": 10200621,
					"content": "Ne? Ah, tabii. Pekala, Leydi Yuheng, Leydi Tianquan'ın bizi Yeşim Konak'a neden davet ettiğine dair bir fikriniz var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200622
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200622,
					"content": "Bana Keqing diyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200623
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200623,
					"content": "Ningguang'ın amacının Mondstadt'ın kurtarıcısından daha tarafsız bir duruş sergilemesini istemek olduğunu düşünüyorum... En azından Adeptuslara sonuna kadar arka çıkmamasını bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200624
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200624,
					"content": "Biz taraf seçmiyoruz. Adeptuslarla konuştuk. Onlar da Liyue'yi korumak istiyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200625,
					"content": "\"Korumak\" derken, kendini beğenmiş kibirli hallerinden söz ediyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200626
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200626,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200627
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200627,
					"content": "Sizler fanisiniz, bu nedenle onların koruması altındasınız. Sizi, bir tanrıyı katledecek yeteneğe sahip kişiler olarak görmeleri mümkün değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200628
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200628,
					"content": "Doğal olarak Ningguang'ın bölgeyi kapatmasının, vatandaşları sorgulamasının ve suikasti araştırmasının anlamsız olacağını düşündüler. Olayın hasıraltı edilip edilmediğini de merak etmiş olabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200629
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200629,
					"content": "Bence olay şu; bizi hafife alıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200630
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200630,
					"content": "Evet haklısın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200631
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200631,
					"content": "Yine de Paimon, Liyue'den olup da tanrılara veya Adeptuslara saygı duymayan birini ilk kez görüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200632
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200632,
					"content": "Hah. Biz Yedi Yıldıza karşı harekete geçme konusunda gecikmelerine yol açan sığ zaman algılarına ve fanileri küçük görmelerine mi saygı göstereyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200633
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200633,
					"content": "Unutun gitsin. Onlar hakkında bu şekilde konuşmamalıyım. Onlara karşı şüpheci yaklaşıyor olabilirim ancak Ningguang bu konuda benimle aynı fikirde değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200634
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200634,
					"content": "Ne olursa olsun bu sefer Adeptusların eylemlerinin oldukça kısıtlı olduğunu itiraf etmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200635
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200635,
					"content": "Rex Lapis'in ölümü gerçekten sıra dışı bir durum. Fakat doğrudan buraya gelmek yerine bir Adeptus konseyi toplamaları...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200636
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200636,
					"content": "Onlardan beklenmeyecek kadar uygarca bir davranış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200637,
						10200638
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200637,
					"content": "Onlarla konuşup bu sorunu çözmen mümkün mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200639,
					"content": "Şey, Ningguang... Mümkün olsa her şeyi konuşarak halletmek ister fakat bu sefer mümkün olduğunu sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200640
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200640,
					"content": "Adeptusların zamanı çoktan geçti. Liyue'nin Yedi Yıldızı bile bu gerçekle yüzleşmek istemiyorsa Liyue'yi nasıl bir gelecek bekliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200641
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200641,
					"content": "Of... Acayip cesur bir söylem daha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200642
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200642,
					"content": "*iç çeker* Daha fazla konuşmayacağım. Aslında bu kadar konuşacağımı öngörmemiştim. Fakat sen iyi bir dinleyicisin Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200643
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200643,
					"content": "Her ikiniz de Yeşim Konak'a doğru yola çıkmalısınız. Geç kalmayın. Ningguang'ın programı son derece sıkışık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200644
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200644,
					"content": "Liyue'nin en kodaman tüccarları \"Yeşim Konak'a yükselme\" eyleminin en büyük onur olduğunu düşünüyor. Her biri Ningguang'dan bir lütuf koparmak için ziyaretlerinde hediyeler getiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200645
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200645,
					"content": "Lütuf mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200646,
						10200647
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200646,
					"content": "Paimon, konu bu değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200648,
					"content": "Ama... Ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200649
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200649,
					"content": "Bir dakika, doğru ya! Ziyaret sırasında hediyeler vermek Liyue'nin kültüründe çok önemli. Biz de lütuf koparmak için değil de... Liyue kültürüne saygı göstermek için bir hediye vermeliyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200650
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200650,
					"content": "Ah, bu ne heves?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200651
					]
				},
				{
					"id": 10200651,
					"content": "Tamam tamam. Kendi tanışma hediyelerinizi kendiniz seçebilirsiniz. İlk olarak Yeşim Konak'a nasıl gideceğinizi anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200652
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200652,
					"content": "Aslında Tianheng Dağı'na gelmeniz gerekmiyordu. Liyue Limanı'na geri dönün, Yuehai Konağı'ndan bir kılavuz bulun ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200653
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200653,
					"content": "Pekala. Tekrar görüşmek üzere Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200654
					],
					"speakerTitle": "Keqing"
				},
				{
					"id": 10200654,
					"content": "Şey, o Yuheng tanrılara saygı duymuyor olabilir fakat Paimon onun çok havalı biri olduğunu düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200655,
						10200656
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200655,
					"content": "Bende de iyi bir izlenim bıraktı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200657,
					"content": "Pekala... Ningguang'ı gördüğümüzde ona ne hediye vereceğiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200658
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200658,
					"content": "Bambaşka bir şeye odaklanıyorsun değil mi Paimon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200659
					]
				},
				{
					"id": 10200659,
					"content": "Ah doğru! Paimon geçen gece rüyasında harika bir atıştırmalık gördü; <color=#00E1FFFF>Bodurlop Jölesi!</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200660
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200660,
					"content": "Paimon bunun Ningguang gibi süper zengin biri için mükemmel bir hediye olacağını düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200661
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200661,
					"content": "Neden hediye olarak böyle bir şey vermiyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200662,
						10200664
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200662,
					"content": "Peki elinde bir tarif var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200663
					]
				},
				{
					"id": 10200663,
					"content": "Yok! Fakat Paimon biraz küt pat çat ile yapabileceğimizden emin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200666,
					"content": "Gidip yemek malzemelerini toplayalım. Zaman kimseyi beklemez, ganimetlerimiz de bizi beklemeyecektir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200664,
					"content": "Peki bu rüyanda gördüğün şeyi nasıl yapacağız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200665
					]
				},
				{
					"id": 10200665,
					"content": "Tabii ki küt pat çat ile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200666
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200656,
					"content": "Bazı görüşlerine katılıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200657
					]
				},
				{
					"id": 10200647,
					"content": "Paimon, biraz ciddi ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200648
					]
				},
				{
					"id": 10200638,
					"content": "Ningguang müzakere etmeyi tercih edecektir, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200639
					]
				},
				{
					"id": 10200620,
					"content": "(Orada işin sadece minik bir kısmını biz yaptık...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200621
					]
				}
			]
		},
		{
			"id": 102007,
			"completionStepIds": [
				102007
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102007",
							"2"
						],
						"stepId": 102007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10200701,
					"content": "Ne? Bizi anca buraya kadar çıkardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200702,
					"content": "Yaa, o rüzgar biraz daha güçlü olsaydı tek seferde tepeye ulaşabilirdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200703,
					"content": "En iyisi Liyue'ye geri dönüp Taşordu'ya soralım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200704
					]
				},
				{
					"id": 10200704,
					"content": "Ha? Neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200705,
					"content": "Yukarıya giden yol gizli falan olmamalı; yoksa...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200706
					]
				},
				{
					"id": 10200706,
					"content": "Yoksa? Ah, Paimon anladı! Gizli olsaydı Ganyu kendi başımıza bulmaya çalışmamıza izin vermezdi, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200707
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200707,
					"content": "Peki, senin planına uyalım, böylece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200708,
					"content": "Ah! Bir saniye. Aşağı bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200709,
					"content": "Sanırım <color=#00E1FFFF>Guizhong Balistasına</color> yaklaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200710,
					"content": "Hım... Ah... Paimon'un yeni bir fikri var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200711,
					"content": "Neden Balistayı kullanarak seni Yeşim Konak'a fırlatmıyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200712,
						10200714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200712,
					"content": "Sağ ol almayayım. Canıma susamadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200713
					]
				},
				{
					"id": 10200713,
					"content": "Ah... Doğru. Bu yöntem pek güvenli olmayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200716,
					"content": "Yine de; Balistanın dürbünü olduğunu hatırlıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200717
					]
				},
				{
					"id": 10200717,
					"content": "Evet ya, doğru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200718,
					"content": "Hatırlattığın iyi oldu; Guizhong Balistasını kullanarak yukarıya giden bir yol olup olmadığına bakabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200714,
					"content": "Benden bu kadar mı nefret ediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200715
					]
				},
				{
					"id": 10200715,
					"content": "Ah... Hayır. Paimon bir an güvenlik önlemlerini gözden kaçırmış olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200716
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}