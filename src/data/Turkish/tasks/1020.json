			"dialogs": [
				{
					"id": 10200401,
					"content": "Durun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200402
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200402,
					"content": "Bu kutsal topraklara izinsiz ayak basanlar da kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200403,
						10200404
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200403,
					"content": "Sadece geçiyorduk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				},
				{
					"id": 10200405,
					"content": "Kesinlikle. Neden bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200406,
					"content": "Biz davet edildik! Bize böyle davranabileceğini de nereden çıkardın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200407,
					"content": "Hayır... Bir saniye... Ningguang'ın planı belki de başından beri buydu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200408,
					"content": "Bizi Yeşim Konak'a davet ediyormuş gibi yaptı fakat bizi tutuklamak için Taşordu'ya pusu kurdurdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200409,
						10200410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200409,
					"content": "Öyle olduğunu pek sanmıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200411,
					"content": "Hırr... Paimon şimdi sinirlendi! Sen! Oradaki! Bu bir numara, değil mi? Bu ne utanmazlıktır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200412,
					"content": "Ne? Sadece devriye nöbetindeyiz. \"Utanmazlık\" da ne demek oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200413
					],
					"speakerTitle": "Huaqing"
				},
				{
					"id": 10200413,
					"content": "Bu ne saçmalık! Bu şüphelileri derhal yakalayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200414
					],
					"speakerTitle": "Yang"
				},
				{
					"id": 10200414,
					"content": "İşte geliyorlar. Şunları bir güzel pataklayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200410,
					"content": "Onlara henüz davet olayını açıklamadık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200411
					]
				},
				{
					"id": 10200404,
					"content": "Kutsal ne dedin? Buralar Tianheng Dağı'nın çevresindeki yabani topraklar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200405
					]
				}
			]
		},
