				"points": []
			},
			"dialogs": [
				{
					"id": 10200201,
					"content": "Baksana! Burada bir mekanizma gibi bir şey var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200202,
					"content": "Doğru yerde olduğumuza göre bu da Yeşim Konak ile ilgili bir şey olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10200203,
						10200205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200203,
					"content": "Belki de Yeşim Konak'a giden yoldur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200204
					]
				},
				{
					"id": 10200204,
					"content": "Evet, yol bu olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10200205,
					"content": "Tuzağa benziyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10200206
					]
				},
				{
					"id": 10200206,
					"content": "Mümkün değil! Paimon'un içgüdülerine güvenmelisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
