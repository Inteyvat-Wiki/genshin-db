			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450101,
					"content": "İşler son zamanlarda gerçekten kötü... Biraz para biriktirip Nasha Kasabası'nda tezgah kiralamayı mı denesem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450113,
						761450102,
						761450115
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450113,
					"content": "Nelerin var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450114
					]
				},
				{
					"id": 761450114,
					"content": "Natlan'dan aldığım ufak tefek birkaç eşya var sadece, ilgini çeken bir şey varsa bakabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450102,
					"content": "Sen kimsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450103
					]
				},
				{
					"id": 761450103,
					"content": "Aa, bir müşteri! Merhaba! Ben Kuzmich, Snezhnayalı bir gezgin tüccarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450104
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450104,
					"content": "Şey, kendime böyle demeyi seviyorum ama aslında sadece yolculuk masraflarını karşılamak için seyahatlerimde küçük çaplı ticaret yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450105
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450105,
					"content": "Ama Natlan'dan geçerken oradakilerin gazına gelip bir sürü şey aldım ve... Şimdi bu malları satmazsam eve dönüş bileti için bile param kalmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450106,
						761450110
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450106,
					"content": "Snezhnaya'ya geri mi döneceksin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450107
					]
				},
				{
					"id": 761450107,
					"content": "Evet, elimdeki malları sattıktan sonra tren bileti alıp dönmeyi planlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450108
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450108,
					"content": "Yıl boyunca kar yağdığı ve her yer buzla kaplı olduğu için her gün şehirde kalmaktan başka çaremiz olmuyor orada...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450109
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450109,
					"content": "Ama uzun zamandır uzakta olunca evde bütün gün yatıp uyumayı özledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450110,
					"content": "Buraya pek gelen giden olmuyor herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450111
					]
				},
				{
					"id": 761450111,
					"content": "Evet... Ama şehirde düzgün bir tezgah kurmaya kalkarsam Kuzey Bankasından borç almam gerekecek. Duyduğuma göre Nasha Kasabası'ndaki şubesinin pek iyi bir itibarı yokmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450112
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450112,
					"content": "Neyse ya. En azından burada yaya trafiği iyi. İnsanlar buradan geçtiği sürece mallar da er ya da geç satılır, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450115,
					"content": "Üzgünüm, şimdi gitmem lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450116
					]
				},
				{
					"id": 761450116,
					"content": "Aa, neden hemen gidiyorsun? Bir baksaydın bari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614503,
			"completionStepIds": [
				7614503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
