				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450701,
					"content": "Aa, kaderin cilvesine bak, yine karşılaştık! Bu sefer gerçekten güzel ürünlerim var. Bir göz atmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450709,
						761450702,
						761450706,
						761450711
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450709,
					"content": "Nelerin var bir bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450710
					]
				},
				{
					"id": 761450710,
					"content": "Bunların hepsi Fatui'nin elden çıkardığı eski ekipmanlar. Başka hiçbir yerde bulamazsın, o yüzden beğendiğin olursa kaçırma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450702,
					"content": "Snezhnaya'ya dönmedin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450703
					]
				},
				{
					"id": 761450703,
					"content": "Açıkçası evim Novokitezhgrad'da ve tüm ailem madenlerde çalışıyor. Hepsi Domovoylardan bile daha inatçı, ben ticarete atılmak istediğimi söylediğimde buna şiddetle karşı çıktılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450704
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450704,
					"content": "Bu yüzden ayrılmadan önce büyük bir servet kazanacağıma dair söz verdim... Eve dönüş yolculuğu için bile zar zor para toplayabilecek duruma düşeceğimi kim bilebilirdi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450705
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450705,
					"content": "Artık büyük paralar kazanmak hayal oldu ama en azından geri döndüğümde gözlerine sokabileceğim kadar bir şey kazanayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450706,
					"content": "Neden Fatui bölgesindesin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450707
					]
				},
				{
					"id": 761450707,
					"content": "Aşk olsun! Ben kanunlara uyan bir Snezhnayalıyım ve burada Fatui'nin yanında kendimi evimde gibi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450708
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450708,
					"content": "Buradaki tüm mallarım Fatui'nin elden çıkardığı eski ekipmanlar, özellikle benim satmamı istediler. Başka hiçbir yerde bulamazsın, sadece burada var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450711,
					"content": "Hayır, sağ ol. Ben gidiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450712
					]
				},
				{
					"id": 761450712,
					"content": "Ah, yazık oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614509,
