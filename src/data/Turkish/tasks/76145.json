				"points": []
			},
			"dialogs": [
				{
					"id": 761450901,
					"content": "Gerçekten çok teşekkür ederim... Sayende eve perişan bir halde dönmek zorunda kalmayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450902
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450902,
					"content": "Bu sefer gerçekten vedalaşıyoruz. Benden çok şey aldın, artık arkadaş sayılırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450903
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450903,
					"content": "Eğer bir gün Snezhnaya'ya yolun düşerse Novokitezhgrad'da beni bul. Görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		}
	]
