				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kuzmich"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761450401,
					"content": "Ne tesadüf, yine karşılaştık! Bir şeyler almak ister misin? Yeni stoklarımı kimse almıyor... Lütfen bana yardım et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450407,
						761450402,
						761450409
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450407,
					"content": "Nelerin var bir bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450408
					]
				},
				{
					"id": 761450408,
					"content": "Bunlar hepsi yerel ürünler. Merak etme, sana ucuzdan vereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450402,
					"content": "Neden tekrar stok yaptın ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450403
					]
				},
				{
					"id": 761450403,
					"content": "Eh, bilirsin işte, iş hayatı böyledir. Demir tavında dövülür, değil mi? Piramida'da iyi bir fırsat yakaladım, birinin mallarını acilen satması gerekiyordu ve bana iyi bir fiyat verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450404
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450404,
					"content": "Biraz fazla heyecanlandım ve eve dönmem gerektiğini unuttum... Bu yüzden her şeyi satın aldım. Şimdi de buradayım işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761450405
					],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450405,
					"content": "Şimdi de mallarını acilen satmaya ihtiyacın var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450406
					]
				},
				{
					"id": 761450406,
					"content": "Of, ne olursun yüzüme vurma... Onun yerine ürünlerime bir göz atmaya ne dersin? Belki işine yarayacak bir şey bulursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				},
				{
					"id": 761450409,
					"content": "Üzgünüm, ben gidiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761450410
					]
				},
				{
					"id": 761450410,
					"content": "Hey... Dur, hemen gitme! İhtiyacın olan bir şey olduğuna eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuzmich"
				}
			]
		},
		{
			"id": 7614506,
			"completionStepIds": [
				7614506
			],
