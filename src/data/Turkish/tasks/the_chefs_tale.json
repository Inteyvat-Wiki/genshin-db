			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yemek Takıntılı Hayalet"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330201,
					"content": "Mmm, sosis çok güzel kızartılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330202
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330202,
					"content": "Dışarıda bir restoranda çalışıyor olsan senden fena bir şef yardımcısı olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330203
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330203,
					"content": "Ama biz bu adadaki her Ratnik için yemek yapıyoruz. Yani olay yemeğin havalı olması değil, bol olması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330204
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330204,
					"content": "Ekmek daha kalın olsun. Şu an çok sebze yok, ayrıca sosis dışında da et ekleyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330205
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330205,
					"content": "Daha fazla pratik yapman lazım! Yine gel, bir dahakine Böğürtlenli Et Kızartması yapacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				}
			]
		},
		{
			"id": 7603303,
			"completionStepIds": [
				7603306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
