				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760330301,
					"content": "Hımm. Et büyük parçalara ayrılmış, sonra da tam ayarında kızartılmış. Fena değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330302
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330302,
					"content": "Yalnız hatırlatayım. Et kızartması yapıyorsan garnitürlerini de düşüneceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330303
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330303,
					"content": "Fazla et yersen hemen şişersin. Böğürtlenler o yüzden var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330304
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330304,
					"content": "Bu adada herkesin beslenme sağlığından biz sorumluyuz, dolayısıyla sebze ve et arasında denge kurmak gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330305
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330305,
					"content": "Bu tabakta garnitür olarak yeterince sebze yok mesela. Burada böyle bir tabak kabul edemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330306
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330306,
					"content": "Daha fazla pratik yapman lazım. Yine gel, bir dahakine Lakka Böğürtlenli Tavuk hazırlayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				}
			]
		},
