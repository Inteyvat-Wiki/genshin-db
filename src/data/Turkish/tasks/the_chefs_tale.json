			"dialogs": [
				{
					"id": 760330401,
					"content": "Tavuk lezzetli olmuş, garnitürler de yeterli. Detaylara takılmamı giderek zorlaştırıyorsun demek ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330402
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330402,
					"content": "... Heh. Her neyse. Acemilerde kasten kusur aradığım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330403
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330403,
					"content": "Şefim ben. İşimi iyi yapmak istiyorum sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330404
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330404,
					"content": "Bu amaç doğrultusunda da Vahşi Avın gelişi için her türlü hazırlığı yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330405
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330405,
					"content": "Ama yazık oldu... Hazırlanan yemekleri zamanında ulaştıramadım onlara... O yüzden yemekler döküldü... Döküldü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				}
			]
		}
