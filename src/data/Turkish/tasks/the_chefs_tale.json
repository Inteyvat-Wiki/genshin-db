			},
			"dialogs": [
				{
					"id": 760330101,
					"content": "Hop, çömez. Öyle yemek yapılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330102
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330102,
					"content": "Adadaki Ratnikler için erzak hazırlıyoruz, o nedenle onların damak tadına göre pişirmemiz gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330103
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330103,
					"content": "Bu öğünler iş görmez. Öncelikle ısı kontrolün berbat, ayrıca beslenme tarzımıza uymuyor. Değişmesi gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760330104
					],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				},
				{
					"id": 760330104,
					"content": "Öğreneceğin daha çok şey var. En temel yemeklerimizle başlamanı öneririm, mesela Nod-Krai Usulü Sosisli Sandviç. Hazır olduğunda gel göster.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yemek Takıntılı Hayalet"
				}
			]
		},
		{
			"id": 7603302,
			"completionStepIds": [
				7603304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
