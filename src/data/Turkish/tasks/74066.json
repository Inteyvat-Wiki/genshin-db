			"dialogs": [
				{
					"id": 740660201,
					"content": "\"Müzakere Sanatı\" mı? Hıh! Başlığı bile aşırı sıkıcı! Paimon bunu hiç beğenmedi. O da ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660202,
					"content": "Buraya not yazmışlar? Hımm... \"Kupon Kantininin iç memnuniyet anketine katılmak ve Kupon ödülü kazanma şansı elde etmek için danışmadaki kayıt masasına gidin...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660203,
					"content": "Kupon mu? Vay canına! Gördün mü? Kupon kazanabiliriz! Paimon bunu hiç beklemiyordu! Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7406603,
