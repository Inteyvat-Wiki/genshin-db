			"dialogs": [
				{
					"id": 740660901,
					"content": "(Paimon hazır! Elinden geleni yap!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660902,
					"content": "İlk soru. Sizce Kupon Kantinindeki yemek fiyatlarının mevcut haliyle kalması mantıklı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660903
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660903,
					"content": "(Hımm... Buna nasıl cevap verilir ki? Paimon sayfaları karıştırıyor... Buldum! Evrensel çözümü deneyelim.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660904
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660904,
					"content": "(Kitaba göre \"Görüşlerinize katılıyorum ama...\" kalıbı her durumda kullanılabilir. Hiçlik Büyücüsü bile buna olumlu cevap verecektir. Müthiş bir fikir.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660905,
						740660909,
						740660914
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660905,
					"content": "Mantıklı. Paimon'un hoşuna gitti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660906
					]
				},
				{
					"id": 740660906,
					"content": "Ne? Paimon ücretsiz olsalar bile bunlara elini sürmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660907,
					"content": "Peki ya parasız kalırsak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660908
					]
				},
				{
					"id": 740660908,
					"content": "Hımm... Şimdi o şekilde ifade edince... HAYIR! Paimon açlıktan ölür daha iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660918,
					"content": "*öksürür* Kusura bakmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660919
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660919,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660920
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660920,
					"content": "Kurallara göre sorular hızlı cevaplanmalı. Sonraki soruya geçelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660921
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660921,
					"content": "Peki madem... Kural kuraldır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660922
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660922,
					"content": "İkinci soru. Yemek saatlerinde Kupon Kantininde hazırlanan yemek miktarı yeterli mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660923
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660923,
					"content": "Çok yemek var ama... Hepsinin tadı berbat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660924,
						740660929,
						740660932
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660924,
					"content": "Evet, Teyvat'ta yetişen tüm Naneleri bu yemeklere koymuşsunuz sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660925
					]
				},
				{
					"id": 740660925,
					"content": "Paimon Naneleri doğrudan çiğ çiğ yese bundan daha iyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660926,
					"content": "Öyle mi? O halde bugün Nane Salatası yiyebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660927
					]
				},
				{
					"id": 740660927,
					"content": "Hayır! Paimon kesinlikle yemez ondan! *iç çeker* Paimon Çiçekli Tavuk istiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660928
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660928,
					"content": "Neyse... Ankete devam edebilir miyiz? Bu sorunun cevabını evet olarak kabul edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660935,
					"content": "Of... Çok yorucu bu. Sonraki soruya geçelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660936
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660936,
					"content": "Üçüncü soruya geçmeden önce tekrardan hızlı cevap vermeniz gerektiğini hatırlatmak isterim. Şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660937
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660937,
					"content": "Sıra üçüncü soruda. Mevcut rastgele yemek sistemini beğeniyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660938
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660938,
					"content": "Lezzete daha çok önem verin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660939
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660939,
					"content": "Görüşlerinize katılıyorum ama... Rastgele yemek sisteminde yiyeceğiniz yemek belli olmadığı için hoş bir sürpriz hissiyatı oluşmuyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660940
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660940,
					"content": "Doğru... Bu açıdan bakınca gayet hoş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660941
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660941,
					"content": "Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660942
					]
				},
				{
					"id": 740660942,
					"content": "Ne? Bayan Monglane çok mantıklı söyledi. Üzerine daha ne denilebilirdi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660943
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660943,
					"content": "Öhöm, lütfen hızlı cevap verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660944,
						740660949,
						740660951
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660944,
					"content": "Beğeniyorum, özellikle de fal kağıtlarını.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660945
					]
				},
				{
					"id": 740660945,
					"content": "Evet! Tüm yemeklerin yanında fal kağıdı geliyor, bir sürü güzel şey çıkıyor. Çok güzel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660946
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660946,
					"content": "\"Çok çalışmak beraberinde başarıyı da getirir!\" Paimon bunun harika olduğunu düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660947
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660947,
					"content": "Başkalarına yol göstermek zor bir iş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660948
					]
				},
				{
					"id": 740660948,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660957,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660958
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660958,
					"content": "Dördüncü soru. Kupon Kantininde bağımlılık yapan yiyecekler satmak mantıklı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660959
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660959,
					"content": "(Ha? Ne? Neden aniden hızlı konuşmaya başladı?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660960
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660960,
					"content": "(Üstünlüğü mü sağlasak? Sohbeti mi yönlendirsek? Hayır! Hayır! Hiçbiri doğru gelmiyor. Belki de... Evrensel formüle geri dönmeliyiz...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660961,
						740660962
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660961,
					"content": "(Pek doğru gelmiyor... Bu sorular...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660963,
					"content": "Öhöm, lütfen soruları fazla düşünmeyin ve aranızda sohbet etmeyin. Söylediğim gibi lütfen hızlı bir şekilde ve fazla düşünmeden cevaplayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660964,
						740660965,
						740660966
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660964,
					"content": "Çok mantıklı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660967,
					"content": "Pekala, geri bildirimleriniz için teşekkür ederiz. Şimdi son soruya geçelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660968
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660968,
					"content": "Az önce bizi görmezden mi geldi? Yoksa cevaplarımızın bir önemi yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660969
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660969,
					"content": "Önceki sorulara verdiğiniz cevapları göz önünde bulundurarak yanıtlayın: Kupon Kantininin mevcut halinden memnun musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660970
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660970,
					"content": "Ne cevap vermiştik ki? Paimon hiçbirini hatırlayamıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660971
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660971,
					"content": "Sorun değil, öyleyse buraya memnun olduğunuzu yazacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660972
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660972,
					"content": "Peki... Ama bir yanlışlık var gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660973
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660973,
					"content": "\"Hayır\" derseniz Kupon almayacağınızı ayrıca belirtmek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660974
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660974,
					"content": "Bu kadarı da fazla ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660975
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660975,
					"content": "#Peki ya siz, {M#beyefendi}{F#hanımefendi}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660976
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660976,
					"content": "Sakın Paimon'u görmezden gelme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660977,
						740660978,
						740660981
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660977,
					"content": "Evet, çok memnunum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660982,
					"content": "Pekala. Katılımınız için teşekkür ederiz. Desteğiniz, kendimizi geliştirmemiz için en büyük motivasyon kaynağımızdır. Kuponlarınızı almak için lütfen burayı imzalayın. Yan taraftaki uçan zeki kurmalı cihaz da imzalayıp Kupon alabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660983
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660983,
					"content": "Ne? Paimon da mı kupon alacak? Ama Paimon ankete katılmadı ki! Paimon gerçekten de alabilir mi? Bir dakika! Paimon'un adı Paimon! Uçan zeki kurmalı cihaz değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660984
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660984,
					"content": "Pekala. Tüm müşterilerimize saygı duyuyoruz, bu yüzden herkes... İnsanlar da makinalar da Kupon alabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660985
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660985,
					"content": "Paimon'u dinlemiyor musun sen? Paimon uçan bir kurmalı cihaz değil! Paimon'un adı Paimon! Paimon'u sakın görmezden geleyim deme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660986
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660986,
					"content": "Anladım... Neyse, zaman kazandırmak için anketi sizin yerinize doldurabilirim. Merak etmeyin, alacağınız Kupon sayısı değişmeyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660987
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660987,
					"content": "Tüm sorulara \"olumlu\" cevaplar vereceksiniz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660988
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660988,
					"content": "Evet! Kupon istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660989
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660989,
					"content": "Öyleyse şurayı imzalayın, gerisini ben hallederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660990
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660990,
					"content": "Harika! Hem Kupon kazanacağız hem de anket yapma zahmetinden kurtulacağız. Teşekkürler Bayan Monglane!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660991
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660991,
					"content": "Desteğiniz için teşekkür ederiz. Kuponlarınızı alabilirsiniz, bir sonraki ankette de katılımlarınızı bekliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660992
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660992,
					"content": "Kuponları aldıktan sonra Paimon ile birlikte Bayan Monglane'e veda ediyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740660993
					]
				},
				{
					"id": 740660993,
					"content": "Şimdi düşünüyorum da Bayan Monglane cevaplarımızı pek umursamıyordu aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660994
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660994,
					"content": "Asıl problem soruların kendisiydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660995
					]
				},
				{
					"id": 740660995,
					"content": "Evet, haklısın. Çok zor bir anketti, Bayan Monglane de çok yorgun görünüyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660996
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660996,
					"content": "Müzakere Sanatı başarısız oldu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660997
					]
				},
				{
					"id": 740660997,
					"content": "Müzakere Sanatıymış, peh! Böyle kitaplar hiçbir işe yaramaz zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660998,
						740661000,
						740661002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660998,
					"content": "Haklısın, asıl problem kitaptaydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660999
					]
				},
				{
					"id": 740660999,
					"content": "Evet, kesinlikle! Sen de sıkıntının kitapta olduğunu düşünüyorsun, değil mi? Neyse, Kuponlarımızı aldığımız için Paimon bu konunun üzerinde çok durmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661000,
					"content": "Hayır, problem Paimon'du.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661001
					]
				},
				{
					"id": 740661001,
					"content": "Ne? Paimon, kitapta ne yazıyorsa harfiyen uygulamaya çalıştı! Baksana, \"Sesimi olabildiğince yükselttim...\" yazıyor... Hepsi kitabın suçu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740661002,
					"content": "Görüşlerinize katılıyorum ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740661003
					]
				},
				{
					"id": 740661003,
					"content": "Paimon'la dalga geçmesene! Hıh, \"Müzakere Sanatı\" tam bir fasa fisoymuş... Hiçbir işimize yaramadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660978,
					"content": "Hayır, hiç memnun değilim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660979
					]
				},
				{
					"id": 740660979,
					"content": "Bekle, bekle! Hayır! Memnun olduğumuzu yaz! Kupon alırız en azından...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660980
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660980,
					"content": "Memnunsunuz demek? Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660982
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660981,
					"content": "Genel olarak memnunum ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660982
					]
				},
				{
					"id": 740660965,
					"content": "Mantıklı değil çünkü...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660966,
					"content": "Görüşlerinize katılıyorum ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660967
					]
				},
				{
					"id": 740660962,
					"content": "(Bu... Sohbete yön vermek denen şey mi?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660963
					]
				},
				{
					"id": 740660949,
					"content": "Beğenmiyorum çünkü istediğim yemeği yiyemiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660950
					]
				},
				{
					"id": 740660950,
					"content": "Tatları hep tuhaf oluyor. Hiç hoş bir sürpriz değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660951,
					"content": "Görüşlerinize katılıyorum ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660952
					]
				},
				{
					"id": 740660952,
					"content": "Her on sekiz yemekte bir lezzetli yemek ikramınız olsa harika olurdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660953
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660953,
					"content": "Neden on sekiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660954
					]
				},
				{
					"id": 740660954,
					"content": "Paimon birilerinden duymuştu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660955
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660955,
					"content": "Şeyden dolayıymış... Şey... Her gün üç öğün var. Pazar gününden önce de altı gün var. Altı günde on sekiz öğün yemek oluyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660956
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660956,
					"content": "Böylece yedinci gün leziz yemekler yenebiliyor! Haftaya güzel başlamayı sağlıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660957
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660929,
					"content": "Yemekler yeterli değil! Wolsey'ye bile yemek kalmıyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660930
					]
				},
				{
					"id": 740660930,
					"content": "O zaten yemek istemiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660931
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660931,
					"content": "Anladım, yani yeterince yemek yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660932,
					"content": "Görüşlerinize katılıyorum ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660933
					]
				},
				{
					"id": 740660933,
					"content": "Biz yemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660934
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660934,
					"content": "*iç çeker* Kitabı okuduğunuzu biliyorum... Neyse... Bu sorunun cevabını evet olarak kabul edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660935
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660909,
					"content": "Mantıksız, fiyatlar artmalı!",
