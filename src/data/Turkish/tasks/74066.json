					"nextDialogs": [
						740660912
					]
				},
				{
					"id": 740660912,
					"content": "Böyle mantık mı olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660913,
					"content": "S-sen iyi misin? Tuhaf görünüyorsun. Bilmediğin bir şey mi yedin yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660918
