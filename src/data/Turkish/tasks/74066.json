				]
			},
			"dialogs": [
				{
					"id": 740660301,
					"content": "Danışmadaki kayıt masası... İşte bu! Şansımızı deneme vakti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660302,
					"content": "Merhaba Bayan Monglane!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660304,
					"content": "(Aman! Pek sıcakkanlı durmuyor!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660305,
					"content": "(Müzakere Sanatı işimize yarar mı dersin?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "(Olabilir, kitap yanımızda! Burada işimize yarayacağı kimin aklına gelirdi?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660307,
					"content": "Bir bakalım... Buldum! \"Gücünü gösterip işleri kendi lehine çevirebilir, düşmanını baskın bir tavırla alt edebilirsin...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660308,
					"content": "İşte bu! Düşmanını baskın bir tavırla alt et! Paimon anladı! Paimon'un sesinin daha gür çıkması gerekiyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660309,
					"content": "Selam! Bayan Monglane! Merhaba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660310,
					"content": "... Sağır değilim. Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660311,
					"content": "Ne? Cidden işe yaradı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660312,
					"content": "Hehe, memnuniyet anketi için gelmiştik Bayan Monglane! Şey, daha doğrusu Paimon ona eşlik etmeye geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660313,
					"content": "#(Hiç endişelenme {NICKNAME}. Kitap elimizin altında. Paimon çaktırmadan içinde yazanlara bakıp sana ne yapman gerektiğini söyleyecek! Bakalım... Hah! Paimon'u dinle yeter!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660314,
					"content": "Biri daha kitaptaki notları görmüş demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660315,
					"content": "Ne? Evet, öyle oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740660316,
					"content": "Kaç not vardı ki? Aslında... Of, neyse. Boş verin. Sıkıntı değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660317,
					"content": "Öhöm, lütfen bekleyin... Öncelikle kuralları açıklayacağım. Anketimiz beş sorudan oluşmakta. Lütfen soruları hızlı bir şekilde, fazla düşünmeden cevaplayın. Unutmayın, hızlı cevap vermeniz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "Monglane"
				},
				{
					"id": 740660318,
					"content": "Anladınız, değil mi? Hazır olduğunuzda başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Monglane"
				}
			]
		},
