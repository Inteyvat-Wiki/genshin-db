			"dialogs": [
				{
					"id": 220390101,
					"content": "Bu işi sürdürmenin imkanı yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390102,
					"content": "Bir şey mi oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390103
					]
				},
				{
					"id": 220390103,
					"content": "Ah, kusura bakma. Bir anlığına düşüncelere dalmışım. Kıyafet almaya mı geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390104,
					"content": "Ne yazık ki Liyue'den gelen üst düzey ipeklerimiz tükendi ancak hâlâ son moda kimonolarımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390105,
					"content": "Liyue'den malzeme mi ithal ediyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390106
					]
				},
				{
					"id": 220390106,
					"content": "Evet. Daha önce biz de Feiyun Ticaret Loncasının İpek Çiçeklerinden ürettiği gibi Liyue'den kaliteli ipek ithal edebiliyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390107,
					"content": "Ne yazık ki mevcut şartlar altında bir süredir o tarz ipekleri ithal edemiyoruz. İşe devam etmek için elimizdekilerle yetinmeye çalışıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390108,
					"content": "Burada kullandığımız her ipek bizim için çok değerli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390109,
					"content": "Aslında müşteri çekmek için kendim yeni kimono modelleri üzerinde çalışmayı ya da farklı boyalar kullanmayı planlıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390110,
					"content": "Fakat \"yeni\" olarak sayılabilecek bir boya bulmakta çok başarılı olamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390111,
					"content": "Gezgin, farklı diyarları gezmiş birisi olarak senin bu konuda ufkun açıktır diye düşünüyorum. \"Yeni\" sayılabilecek bir boya ile hiç karşılaştın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390112,
						220390116
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390112,
					"content": "Gördüm diyebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390113
					]
				},
				{
					"id": 220390113,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390114,
					"content": "O zaman lütfen ufkumu genişletmeme yardım et. Bana yeni boyalar üretebilmem için birkaç temel malzeme bul lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390115,
					"content": "Ücretini düşünme, halledeceğim. Tekrardan çok teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390116,
					"content": "Sadece boyaya mı ihtiyacın var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220390117
					]
				},
				{
					"id": 220390117,
					"content": "Bu şartlar altında şu an elimden sadece o geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220390118
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220390118,
					"content": "\"Yeni\" boya yapabilmem için bildiğin temel malzemeler varsa lütfen onları bana getir. Hak ettiğin ücreti karşılayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
