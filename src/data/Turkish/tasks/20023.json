			"dialogs": [
				{
					"id": 200230101,
					"content": "Bakalım bu defa gerçekten tövbe edecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230102
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230102,
					"content": "Ne için tövbe edecek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230103
					]
				},
				{
					"id": 200230103,
					"content": "Buraya her gün bir sürü insan gelip günahlarını itiraf ederek tanrılardan merhamet dilenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230104
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230104,
					"content": "Ama lafta bırakıp harekete geçmezsen zaman kaybı olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230105
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230105,
					"content": "Örneğin Nimrod'a bak. Alkol sorununu itiraf etmek için buraya sayısız kez geldi ama azıcık bile değişmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230106
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230106,
					"content": "Zamanın varsa gidip kendisini bir kontrol edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230107,
						200230110
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230107,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230108
					]
				},
				{
					"id": 200230108,
					"content": "Yine içiyorsa lütfen bana kanıt getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230109
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230109,
					"content": "Bazen hatasını tekrarlayanlar, yaptıkları yanlışın düzeltmek için yönlendirilmeli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230110,
					"content": "O zaman içmek günah mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230111
					]
				},
				{
					"id": 200230111,
					"content": "Başlı başına içmek günah değil ama başkalarına gereksiz sıkıntı verene kadar içmek öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230112
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230112,
					"content": "Herkes öyle ahlaksızca davransa tüm Mondstadt kendini sıkıntılı bir durumun içinde bulurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230113
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230113,
					"content": "Bir günah yüzünü gösterdiğinde, gerçekleşmeden durdurulmalıdır. Şimdi benim için gidip Nimrod'a bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Victoria"
				}
			]
		},
