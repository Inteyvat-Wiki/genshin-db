			"dialogs": [
				{
					"id": 200230201,
					"content": "Hahaha, her gün bunu iple çekiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230202
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230202,
					"content": "İçmeyi bıraktığını sanıyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230203
					]
				},
				{
					"id": 200230203,
					"content": "Ah! Korkuttun beni... Karım geldi sandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230204
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230204,
					"content": "Arada sırada birkaç duble atmaktan bir şey olmaz! Bugün işte zor bir gün geçirdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230205
					],
					"speakerTitle": "Nimrod"
				},
				{
					"id": 200230205,
					"content": "Tamam anladım! Bunu bitirip geri döneceğim. Zaten Eury de şimdiye alışverişini tamamlamıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nimrod"
				}
			]
		},
