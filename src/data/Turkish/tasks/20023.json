					"nextDialogs": [
						200230903
					]
				},
				{
					"id": 200230903,
					"content": "Gerçekten mi? Ayık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230904
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230904,
					"content": "Ne yazık ki buna dair hiç kanıt yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200230905
					]
				},
				{
					"id": 200230905,
					"content": "Sorun yok. İçtiğine dair bir kanıt yoksa artık değişmiş demektir. Buna inanmak beni mutlu etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230906
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230906,
					"content": "Aksi yönde bir kanıt görene kadar kişinin masum olduğuna inanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230907
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230907,
					"content": "Ama ortada kişinin kabahatlerini gösteren yığınla kanıt varsa... Durum komikleşiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200230908
					],
					"speakerTitle": "Victoria"
				},
				{
					"id": 200230908,
					"content": "Lütfen bunu uğraşlarına karşılık olarak kabul et. Umarım senin de tövbe etmen gereken şeyler olduğu günleri görmem.",
