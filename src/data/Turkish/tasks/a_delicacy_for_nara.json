			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130201,
					"content": "Naralarla konuşmak çok zor... Üstelik çok da uzunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130202
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130202,
					"content": "Merhaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130203
					]
				},
				{
					"id": 730130203,
					"content": "#Ay! Nara {NICKNAME} gelmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130204
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130204,
					"content": "Arapacati korkmuyor. Kardeşler çok cesurdur, o yüzden onlar da korkmuyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130205
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130205,
					"content": "<color=#00E1FFFF>Tüten dumanları</color> takip edersen onları bulabilirsin. Ayrıca saçma sapan hareketler yaparlarsa <color=#00E1FFFF>Doğanın gücünü</color> kullanarak onları biraz pataklayabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				}
			]
		},
		{
			"id": 7301303,
			"completionStepIds": [
				7301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"2"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130301,
					"content": "Arapacati çooook kızdı! Ahh! Hatta kızmaktan da öte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130302
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130302,
					"content": "Marana burada her tarafa yayılmış, o yüzden orman oldukça tehlikeli. Oradan çıktıktan sonra Arapacati, birlikte hareket etmeleri için kardeşleri uyardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130303
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130303,
					"content": "Fakat yola koyulduktan sonra tartışmaya başladınız. Hatta Arachatora, tuhaf bir şey bile yedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130304
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130304,
					"content": "*ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130305
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130305,
					"content": "Arapacati kararını verdi. Günerikleri on kez olgunlaşana kadar Arachatora'nın mantar toplaması yasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130306
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130306,
					"content": "Hayır, olamaz... *ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130307
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730130307,
					"content": "Aynen! Ya burada yetişen kötü sporları ve mantar canavarlarını getirseydi? O zaman ne yapardık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130308
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130308,
					"content": "Araphala, senin de aşağı kalır yanın yok hani! Meyve toplamak için Vanarana'dan çok uzaklaştın. O tarafta türlü türlü bela var, haberin yok mu! Araja bu konuyu özellikle vurgulamıştı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130309
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130309,
					"content": "*ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130310
					],
					"speakerTitle": "Araphala"
				},
				{
					"id": 730130310,
					"content": "Aynen öyle. Meyvelerin su içmesi gerekir ve tabii Aranaraların da öyle. O yüzden su gibisi yoktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130311
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130311,
					"content": "Arapas, onca yer varken bunun için gide gide Varuna Mekanizmasına mı gittin? Nara Varuna, en lezzetlisinin Vanarana suyu olduğunu söylemişti, hatırlamıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130312
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130312,
					"content": "*ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130313
					],
					"speakerTitle": "Arapas"
				},
				{
					"id": 730130313,
					"content": "G-Gördünüz mü? Yalnızca \"mutluluğun tadı\" küçük kız kardeşimize mutluluğu getirebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130314
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130314,
					"content": "#Arasaka, duyduğuma göre \"mutluluğun tadı\" uğruna Nara {NICKNAME} için büyük sıkıntılar yaratmışsın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130315
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130315,
					"content": "Y-Yaptığım her şey \"Üstün Lezzet\" içindi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130316
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130316,
					"content": "\"Üstün Lezzeti\" hazırlamanın amacı \"aşçılık eğitiminde\" öğrendiklerini göstermek içindi. Başkasının yardımıyla tamamlarsan, aldığın eğitimin ne anlamı var ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130317
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130317,
					"content": "Arapacati, Arasaka'nın her şeyden önce kendisine bir çekidüzen vermesi gerektiğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130318
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130318,
					"content": "*ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130319
					],
					"speakerTitle": "Arasaka"
				},
				{
					"id": 730130319,
					"content": "Arapacati! Biz geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130320,
					"content": "Aa, siz ikiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130321
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130321,
					"content": "#Nara {NICKNAME}, Arapacati'nin sorununu Paimon ile paylaştı ve bu sorunu kökten çözdü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130322
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130322,
					"content": "Arapacati, artık abileri Utsava Festivalini kaçırır ya da başları belaya girer diye korkmuyor. Hepsi sizin sayenizde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130323
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130323,
					"content": "Arapacati ve abileri size minnettar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130324
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130324,
					"content": "Bunu duyduğuma sevindim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130325,
					"content": "Ama bunca süredir Paimon'un merak ettiği bir şey var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130326,
					"content": "Bu Nara Varuna kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130327
					]
				},
				{
					"id": 730130327,
					"content": "Kendisi bizim dostumuzdur. Vanarana'nın dostudur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130328
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130328,
					"content": "#Çok, çok uzun zamandır Aranaraların dostudur. Tıpkı Nara {NICKNAME} gibi o da bir altın Naradır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130329
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130329,
					"content": "Demek öyle. Paimon bir soru daha soracak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130330,
					"content": "Abileriyle mi ilgili?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130331
					]
				},
				{
					"id": 730130331,
					"content": "Evet. Abilerinden hangisi en büyük ve hangisi en küçük Arapacati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130332,
					"content": "En büyük ve en küçük mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130333,
						730130334
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130333,
					"content": "Yaşları mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130336
					]
				},
				{
					"id": 730130336,
					"content": "Yaşları... Ah, Arapacati şimdi anladı. Ağaçların yıllık halkaları gibi bir şeyden bahsediyorsun. Hımm, ormanın çocukları yaşlarına göre ayrılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130337
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130337,
					"content": "Ne? O zaman niye onlar senin abin ve sen niye onların kız kardeşisin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130338,
					"content": "#Ah, şu mesele. Bir zamanlar bir Nara dostumuz vardı. Adı Nara Varuna'ydı. Bir \"{F#kız kardeşi}{M#erkek kardeşi}\" olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130339
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130339,
					"content": "#Arapacati ve kardeşleri onun \"{F#kız kardeşi}{M#erkek kardeşi}\" hakkında konuştuğunu duydu. Anlatırken hem mutlu hem de üzgün görünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130340
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130340,
					"content": "Biz de sonunda anladık. Bir \"abi\" için \"kız kardeş\" çok önemli bir Naraymış. Bir \"kız kardeş\" için de \"abi\" önemli bir Naraymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130341
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130341,
					"content": "Bu çok hoşumuza gitti. Böylece Arapacati ve kardeşler birbirleriyle abi ve kız kardeş olmaya karar verdi. Nara Varuna bunun güzel bir şey olduğunu söylemişti. Ailemize değer vermeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130342
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130342,
					"content": "Evet, haklısın. Ailemize değer vermemiz lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130343
					]
				},
				{
					"id": 730130343,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130344
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130344,
					"content": "Paimon'un merak ettiği bir şey daha var... Aranaraların yemek yemesi gerekiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130345,
					"content": "İnsanlar malzemeleri pişirerek yemek yaparlar, ormanın çocukları da yine malzemeleri kullanarak yiyecek hazırlayabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130346
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130346,
					"content": "Nara Varuna bize Naraların nasıl yemek yediğini öğretmişti. İşte o yüzden Arapacati ve kardeşleri aşçılık eğitimine başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130347
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130347,
					"content": "Bu gerçekten çok ilginçmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130348,
						730130349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130348,
					"content": "Sanki oyun oynuyormuşsunuz gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130350,
					"content": "Arapacati ve kardeşler oldukça ciddidir çünkü Nara Varuna, yemeğini paylaşabilmek çok güzel bir şeydir demişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130351
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130351,
					"content": "#Ayrıca Arapas'ın dediğine göre Nara {NICKNAME} yemek yapabiliyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130352
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130352,
					"content": "#Tabii ki! {NICKNAME} aşçılık konusunda oldukça hamarattır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130353,
					"content": "#Arapacati anladı... Nara {NICKNAME}, Utsava Festivaline gelip Arapacati'nin amatör kardeşleriyle birlikte yemek yapsın o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130354
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130354,
					"content": "Aranaraların hiçbir zaman anlayamayacağı ve yalnızca Naraların anlayabileceği aşçılık yeteneklerini ve yemeklerini gösterirsin. Hepsi hayran kalır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130355,
						730130356
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130355,
					"content": "O zaman kendinizi hazırlayın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130357,
					"content": "Arapacati o günü iple çekiyor. Bu seferki Utsava Festivali gerçekten de harika ve muhteşem olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130356,
					"content": "Size bütün hünerlerimi göstereceğim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130349,
					"content": "Sanki evcilik oynuyormuşsunuz gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130334,
					"content": "Boyları mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130335
					]
				},
				{
					"id": 730130335,
					"content": "Hayır! Paimon yaşlarını soruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130336
					],
					"speakerTitle": "Paimon"
				}
