	"talks": [
		{
			"id": 7301301,
			"completionStepIds": [
				7301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301301",
							"2"
						],
						"stepId": 7301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Arapacati",
					"Arama",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130101,
					"content": "Ah! Altın Nara olmasaydı! Düşünmek bile istemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130102
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130102,
					"content": "#Arapacati korkmadı. Nara {NICKNAME} iyi bir Nara, tıpkı hikayelerdeki Naralar gibi. Nara {NICKNAME} ve Paimon'un bize çok yardımı dokundu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130103
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130103,
					"content": "#Evet, Arapacati korkmuyor. Arapacati otlara, yapraklara ve tohumlara güvendiği gibi Arama'ya da güveniyor. Herkes senin iyi bir Nara olduğunu söylüyor. Selam olsun size Nara {NICKNAME} ve Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130104
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130104,
					"content": "Selam sana Arapacati!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130105,
						730130114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130105,
					"content": "Aslında ben... kötü biriyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130106
					]
				},
				{
					"id": 730130106,
					"content": "Hey! Öyle şaka mı olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130107,
					"content": "Sen iyi birisin. Arapacati biliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130108
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130108,
					"content": "#Büyük rüzgarlar, beraberinde birçok ufak tohum getirir. Sonra bu tohumlar Naralarla birlikte Vanarana'ya gelir. Söylediklerine göre Nara {NICKNAME} iyi biriymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130109
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130109,
					"content": "Arama da öyle bir şey demişti! Bu arada rüzgarların taşıdığı tohumlar mı dedin? Yani karahindiba tohumları gibi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130110,
						730130111,
						730130112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130110,
					"content": "Yoksa Rüzgargülü Çiçeği tohumu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130115,
					"content": "#Nara {NICKNAME} bir Bija üretmesi için Arana'ya yardım edecek. Böylece Utsava Festivalini hep beraber hazırlayacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130116
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130116,
					"content": "Ay, Utsava Festivali...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130117
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130117,
					"content": "Arapacati tuhaf görünüyor. Canını sıkan bir şey mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130118
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130118,
					"content": "Arapacati'nin abileri henüz Vanarana'ya dönmedi. Eğer gelmezlerse, biz kardeşler Utsava Festivalini birlikte kutlayamayacağız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130119
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130119,
					"content": "Arachatora, Arasaka, Arapas ve Araphala'yı da uzun zamandır Vanarana'da görmedim. Yaşanan o olaydan sonra bir daha hiç karşılaşmadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130120
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130120,
					"content": "Epey olmuş... Ne kadar zaman geçti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130121,
					"content": "Çok, çok uzun zaman oldu. Tohumlar daha yeni filizlenmişti. O filizler şimdi büyük birer ağaç haline geldi. O kadar büyüdüler ki Aranaraları yağmurdan koruyorlar! Yedi tane Arapacati'nin boyuna eriştiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130122
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130122,
					"content": "Tohumdan ağaca demek! Vay be! Çok uzun zaman geçmiş. Abilerin kayıp mı oldu Arapacati?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130123,
					"content": "Kayıp derken? Bir çeşit tohumdan mı bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130124
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130124,
					"content": "Haa! Nara tohumlarına Kayıp deniyor demek... Çok iyiymiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130125
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130125,
					"content": "#Naralar harika! Nara {NICKNAME} bir sürü Kayıp biriktirmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130126
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130126,
					"content": "Şey, öyle değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130127,
						730130130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130127,
					"content": "Nerede olduklarını bilmiyor musun anlamında demiştik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130128
					]
				},
				{
					"id": 730130128,
					"content": "Ah, yok yok. Arachatora, Arasaka, Arapas ve Araphala'nın nerede olduğunu Arapacati biliyor. Kaybolmadılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130129
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130129,
					"content": "Uzun süredir Vanarana'da eğitim görüyorlardı. Aşçılık eğitimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130136,
					"content": "Ah, aşçılık eğitimi demek. Paimon şimdi anladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130137,
					"content": "Paimon'un ilgisini çekecek bir şeye benziyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130138
					]
				},
				{
					"id": 730130138,
					"content": "#Hımm! {NICKNAME} gidip aşçılık eğitimi alsa, Paimon daha çok ilgilenir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130139,
					"content": "Bu aşçılık eğitimi tam olarak ne oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130140
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130140,
					"content": "Son Utsava Festivali sırasında, Aranaralar tadına baksın diye Naralar bir sürü yemek hazırlamıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130141
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130141,
					"content": "Karşılığında Arachatora ve diğerleri de bu Utsava Festivalinde Naralara yemek yapmak istedi. O yüzden aşçılık eğitimi almaya başladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130142
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130142,
					"content": "Paimon, bu Utsava Festivali için sabırsızlanıyor doğrusu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130143,
						730130145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130143,
					"content": "Ama o yemekler Aranaralar için...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130144
					]
				},
				{
					"id": 730130144,
					"content": "Lezzetli yemekler tüm canlıların ortak noktasıdır! Bir şeycik olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130146
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130146,
					"content": "Arapacati, madem onların nerede olduklarını biliyorsun, onları niye kendin aramıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130147,
					"content": "Muhteşem Utsava Festivali yakında başlıyor ve Arapacati'nin yapacak çok işi var. Gidip onları arayacak vakit yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130148
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130148,
					"content": "Utsava Festivaline hazırlanmak için aşçılık eğitimi almak üzere Vanarana'dan ayrıldılar ama Utsava Festivalinin yakında başlayacağını bilmiyorlar! Arachatora, Arasaka, Arapas ve Araphala çok aptallar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130149
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130149,
					"content": "#O zaman bu işi bize bırak! Arama'yla birlikte ormandaki Aranaraları bulmaya gideriz. Utsava Festivaline de hazırlanmış oluruz. Öyle değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130150,
						730130151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130150,
					"content": "Bu işi oldu bil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130152,
					"content": "Fakat onları nasıl bulacağız ki? Şeyleri... Arachatora, Ara... Diğerlerinin ismi neydi ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130153
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130153,
					"content": "Arachatora, Arasaka, Arapas ve Araphala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130154
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130154,
					"content": "Ah! Arana, Arama, Araja, Arapacati... Aranara isimlerini hatırlamak çok zor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130155,
					"content": "Paimon, Aranara isimleri hakkında öyle deme. Aranaraları üzeceksin şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130156
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130156,
					"content": "Peki... Ee, onları nasıl bulacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130157
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130157,
					"content": "Önceden aşçılık eğitimini Vanarana'da alıyorlardı ama çok duman çıkardıkları için Arapacati onları kovdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130158
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130158,
					"content": "Herkes o kadar korktu ki bazı Aranaralar derin uykuya geçti. Neyse ki Arama yeterince cesurdu ve tüm dumanı püskürttü. Arapacati çok kızdı ve onları kovdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130159
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130159,
					"content": "O yüzden ormanda <color=#00E1FFFF>tüten dumanları</color> takip edersen onları da bulabilirsin diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130160
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130160,
					"content": "Sen de onları kovdun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130161,
					"content": "Evet. Yanlış bir şey mi yapmışım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130162
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130162,
					"content": "#Yani, aslında hayır... Neyse, hadi gidelim {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130163,
					"content": "Şey, bir şey daha var. Kardeşlerim saçmalamaya başlarsa onları <color=#00E1FFFF>Doğa</color> gücüyle biraz pataklayabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130164
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130164,
					"content": "Geçmişte o kadar ama o kadar duman çıkardılar ki Vanarana'nın dört bir yanını sardı. Haliyle onlar da korkup etrafa kaçıştı. Bazen sanki tuhaf mantarlara dokunmuş gibi hareketler yaptılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130165
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130165,
					"content": "Yine de Aranaralar ormanın ruhudur. O yüzden <color=#00E1FFFF>Doğanın gücünü</color> emerek iyileşebilir ve duyularımızı yeniden kazanabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130166
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130166,
					"content": "#Paimon şimdi anladı. Aynı şekilde mantık yürütürsek... {NICKNAME} de Çiçekli Tavuk yiyince gücünü topluyor, demek ki {NICKNAME} bir Çiçekli Tavuk ruhu! Evet! Aşırı mantıklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130167,
						730130171
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130167,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130168
					]
				},
				{
					"id": 730130168,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130169
					],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130169,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130170
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130170,
					"content": "Her neyyssee, hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130172
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130172,
					"content": "#İyi şanslar Nara {NICKNAME}! İyi şanslar Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arama"
				},
				{
					"id": 730130171,
					"content": "Evet, evet, gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130172
					]
				},
				{
					"id": 730130151,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130145,
					"content": "Ben de sabırsızlandım şimdi!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130146
					]
				},
				{
					"id": 730130130,
					"content": "Nasıl bir his olduğunu biliyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130131
					]
				},
				{
					"id": 730130131,
					"content": "#Nara {NICKNAME} nasıl hissettiğimi anlıyor mu yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130132
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130132,
					"content": "#Tabii ki, {NICKNAME} de epeydir kayıp kardeşini arıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130133,
					"content": "#Ah. Senin kardeşin de mi aşçılık eğitimi alıyor Nara {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130134
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130134,
					"content": "Nasıl? Paimon bir yanlış anlaşılma olduğunu düşünüyor... Kayıp demek, bir şeyin nerede olduğunu bilmemek demek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130135,
					"content": "Ah, yok yok. Arapacati abilerinin kaybolmadığını biliyor. Çok uzun zamandır Vanarana'nın dışında eğitim görüyorlar. Aşçılık eğitimi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "Arapacati"
				},
				{
					"id": 730130111,
					"content": "Yoksa çam kozalakları mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130112,
					"content": "Bu hikayelerin tohumlarını rüzgar mı getirdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130113
					]
				},
				{
					"id": 730130113,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730130114,
					"content": "Merhaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				}
			]
		},
		{
			"id": 7301302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
