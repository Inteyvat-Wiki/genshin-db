			"dialogs": [
				{
					"id": 740320401,
					"content": "Geldik. Doktor sana bunu gönderdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320402,
					"content": "Lechlade, Saf Suyu alıp hemen içer.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320403
					]
				},
				{
					"id": 740320403,
					"content": "Ah, çok daha iyiyim! Dinçleştim resmen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320404,
						740320406
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320404,
					"content": "Bu kadar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320405
					]
				},
				{
					"id": 740320405,
					"content": "Biraz fazla hızlı oldu sanki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320408,
					"content": "Arderne harika bir doktor, üstelik diploması da var! Verdiği ilaçlar her zaman işe yarar. Benimkilerin aksine...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320409
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320409,
					"content": "Peki ya sarı ve yeşil renklerdeki taşlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320410,
					"content": "Hâlâ şüpheliler tabii!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320411
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320411,
					"content": "Of, sanrılarını tedavi etmek mümkün değil gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320412,
					"content": "Artık çalışmaya devam edebilirim! Yardımınız için çok teşekkürler. Lütfen bu kuponları alın, teşekkür niyetine.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320413
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320413,
					"content": "Sağlıcakla!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320406,
					"content": "Bence hasta değilsin sen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320407
					]
				},
				{
					"id": 740320407,
					"content": "Hayır, hayır. Hastaydım tabii ama siz bana şifa getirdiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320408
					],
					"speakerTitle": "Lechlade"
				}
			]
		},
