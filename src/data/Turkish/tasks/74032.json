					"Lechlade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320201,
					"content": "Bu sarı ve yeşil renklerdeki taşlar kesinlikle normal değil... Sanırım burada öleceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320202
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320202,
					"content": "Şey, sen iyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320203,
					"content": "Uzun vadede hepimiz \"iyi\" olacağız ama ben sizden daha önce \"iyi\" olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320204,
						740320206
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320204,
					"content": "Tamam o zaman. Görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320205
					]
				},
				{
					"id": 740320205,
					"content": "Bir dakika, bu adamın sesi hiç iyi gelmiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320208,
					"content": "Hayır, iyiyim. Gerçekten. Bir sorun varsa zaten çok geç kalmışım demektir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320209
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320209,
					"content": "İyi misin, değil misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320210
					]
				},
				{
					"id": 740320210,
					"content": "Paimon'un kafası çok karıştı. Daha açık konuşur musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320211,
					"content": "Açık konuşmak gerekirse Üretim Alanına ne zaman gelsem başıma ağrılar giriyor, kalbim tekliyor, ellerim ve ayaklarım buz kesiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320212
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320212,
					"content": "Bıktım artık! Anlatabiliyor muyum? Bıktım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320213
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320213,
					"content": "Sarı ve yeşil renklerdeki taşlar yüzünden hepsi! Kötü o taşlar! Hangi taşlardan bahsettiğimi anladınız değil mi? Fontaine Araştırma Enstitüsünün Merkez Laboratuvarı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320214
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320214,
					"content": "O sarı ve yeşil renklerdeki taşlar her şeyi mahvetti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320215,
						740320216
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320215,
					"content": "Lütfen bir doktora görün.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320217,
					"content": "Ben doktorum zaten! Biliyorum! Bir dakika, artık doktor değilim ki. Diplomamı kaybettim, resmi olarak teşhis koyamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320218
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320218,
					"content": "Lütfen diploması olan gerçek bir doktor bulup beni kurtarın! Lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320219
					],
					"speakerTitle": "Lechlade"
				},
				{
					"id": 740320219,
					"content": "#Durum ciddi görünüyor. Hemen gidip bir doktor bulalım {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320216,
					"content": "Neden revirde dinlenmiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320217
					]
				},
				{
					"id": 740320206,
					"content": "\"İyi\" kelimesine yepyeni bir soluk getirdin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320207
					]
				},
				{
					"id": 740320207,
					"content": "Sesin hiç iyi gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7403203,
			"completionStepIds": [
				7403203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
