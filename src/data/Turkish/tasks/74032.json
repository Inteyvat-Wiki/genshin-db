			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arderne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740320301,
					"content": "Şikayetiniz mi var? Yoksa bir başkasının mı şikayeti var? İkiniz de sağlıklı görünüyorsunuz, başkası adına gelmiş olmalısınız buraya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320302
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320302,
					"content": "Evet...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320303,
					"content": "Lechlade'in durumunu açıklıyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740320304
					]
				},
				{
					"id": 740320304,
					"content": "Demek yine o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320305
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320305,
					"content": "Onu tedavi edebilir misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320306
					]
				},
				{
					"id": 740320306,
					"content": "Baş ağrısını mı yoksa sanrılarını mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320307
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320307,
					"content": "Ne? Hasta değil mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320308,
					"content": "Tahlil sonuçlarına bakılırsa muhtemelen hasta değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320309
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320309,
					"content": "Duyduğum kadarıyla dışarıdayken bir hastasına yanlış teşhis koymuş, erken safhadaki önemli belirtileri göz ardı etmiş... O günden beri de bazı paranoyaları var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320310
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320310,
					"content": "Çevresine böyle davranıyor, kendisini yiyip bitiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320311
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320311,
					"content": "Peki sarı ve yeşil renklerdeki taşlar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320312
					]
				},
				{
					"id": 740320312,
					"content": "Başka kimsede benzer semptomlar yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320313
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320313,
					"content": "Ancak ona yardım etmeden de duramam. Bunu ona götürün lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320314
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320314,
					"content": "Bu, Saf Su değil mi? Emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320315,
					"content": "Ah, ne olduğunu biliyorsunuz demek. Vücuduna zarar vermeyecek ve biraz dinçleşmesini sağlayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320316,
						740320318
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320316,
					"content": "Ne olduğunu söylemeyelim mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320317
					]
				},
				{
					"id": 740320317,
					"content": "Bildiğim kadarıyla bu gibi içeceklerden uzak duruyor. Öncesinde bunun sağlık iksiri olduğunu söyleyerek içmesini sağlamıştım, sonrasında gerçekten semptomlarında azalma gözlemledik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320322,
					"content": "Tamam, bunu ona götüreceğiz. İşe yaramazsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320323,
					"content": "İşe yaramazsa gidip revire yatmasını söyleyin. \"Doktorun emri\" olduğunu söylerseniz itiraz etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320324
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320324,
					"content": "#Tamamdır. Hadi geri dönelim {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740320318,
					"content": "Neden Fonta vermiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740320319
					]
				},
				{
					"id": 740320319,
					"content": "Veremem çünkü buralarda yaşayan herkes Fonta'nın tadını hemen anlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320320
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320320,
					"content": "Bildiğim kadarıyla daha önce hiç Saf Su içmedi. Buralarda sık bulunan bir içecek değil sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320321
					],
					"speakerTitle": "Arderne"
				},
				{
					"id": 740320321,
					"content": "Öncesinde bunun sağlık iksiri olduğunu söyleyerek içmesini sağlamıştım, sonrasında gerçekten semptomlarında azalma gözlemledik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740320322
					],
					"speakerTitle": "Arderne"
				}
			]
		},
