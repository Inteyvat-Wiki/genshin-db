			},
			"dialogs": [
				{
					"id": 401480401,
					"content": "Açık konuşayım, arkadaşın cidden ilginç bir karakter... Aslında Sıcacık Aşım öyle yapması zor bir yemek değil, bu siparişle ilgili bir sorun yaşayacağımızı sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480402
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 401480402,
					"content": "Bu yemeğin adı neden \"Sıcacık Aşım\" ki? Bol etli bir yemek başlangıç için iyidir ama Paimon'un deneyimlerine göre tek bir sıcak yemek asla yetmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480403,
					"content": "Iı, bol olduğu doğru ama etli olduğunu söylemedim... Görünüşe aldanmayın... Aslında içinde tofu var, sadece tadı ve görünümü ete benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480404
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 401480404,
					"content": "Tofu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480405
					]
				},
				{
					"id": 401480405,
					"content": "Bir dakika! Tofu soya fasulyesinden yapılmıyor mu? Boşboğaz onu yiyemez! Onlara başka bir yemek seçmelerini söylememiz gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480406,
					"content": "... Sorun nedir? \"Tofu\" kelimesini duydum sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480407
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480407,
					"content": "Hey, ne yapıyorsun? Mutfağa sadece çalışanlar girebilir... *iç çeker* Neyse, boş ver. Hanımefendi, Patronunuzdan başka bir yemek sipariş etmesini isteyebilir misiniz acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480408
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 401480408,
					"content": "... Haha! Hiç kimse Ayato kardeşimi benim kadar iyi anlayamaz! Bu vesileyle ilan ediyorum, Sıcacık Aşım yemeği dostluğumuzun ebedi bir sembolü olacak. Yoksa bana da Arataki Itto demesinler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480409
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480409,
					"content": "... Hey! Yemeğimiz nerede kaldı? Acele edin, Kızıl Asa'nın muhteşem maceralarını anlatmayı bitirmek üzereyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480410
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480410,
					"content": "... Gördüğünüz üzere siparişi değiştirmek şu noktada biraz zor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480411
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480411,
					"content": "Eyvah eyvah, Itto'nun tüm egosu bu yemeğe bağlı... Ona söylesek bile tükürdüğünü yalayacağına tofu yer daha iyi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480412,
						401480413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480412,
					"content": "Resmen köşeye sıkıştık... O yemeği yapmamız lazım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				},
				{
					"id": 401480414,
					"content": "Mantıklı. Karnını onlarla doyurmasını sağlarım... Gerisini de doğaçlama yapacağız artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480413,
					"content": "Masaya atıştırmalık ikram yollasak nasıl olur?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480414
					]
				}
			]
		},
