						401489804
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401489804,
					"content": "... Ben açıklayayım. Patron geçenlerde denizci olarak bir iş buldu, böylece gemiyle buraya geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489805
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401489805,
					"content": "Gemi limana demir attıktan sonra Patronun istediği gibi gezebileceği boş vakti oldu. Bu boş vaktinde de Büyük Usta Hanakado ile takıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489806
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
