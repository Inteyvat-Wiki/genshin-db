							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401480201,
					"content": "Iı... Yemek geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480202,
					"content": "Ooo, demek Sıcacık Aşım buymuş! Gerçekten hiç şakanız yokmuş! Porsiyonun büyüklüğüne bayıldım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480203
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480203,
					"content": "Hadi bakalım yoldaş, çek bir sandalye. Hepimiz arkadaşız burada, çekinmeyin! Ben hemen başlıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480204
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480204,
					"content": "Öhöm! Patron, yerel geleneklere saygı göstermeliyiz. Liyue'de yemeğe ilk önce misafirlerin başlaması adettendir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480205
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480205,
					"content": "Adet mi? Iı... Shinobu, eski gelenekler seni pek açmıyor sanıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480206,
						401480207
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480206,
					"content": "Mutfaktaki işim bittiğine göre ben de bir misafir sayılırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				},
				{
					"id": 401480208,
					"content": "Ne? Şaka mı yapıyorsun yoldaş? Haa, bir dakika, şimdi anladım. Yemek o kadar güzel kokuyor ki herkes ilk önce yemek için can atıyor! Pekala, sanırım buradaki tek suçlu benim enfes damak zevkim. Siz önden buyurun. Ben en son yiyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480209
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480209,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480210
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480210,
					"content": "Sen, Paimon, Ayato ve Shinobu yemeği yiyorsunuz, geriye sadece azıcık bir \"et\" kalıyor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480211
					]
				},
				{
					"id": 401480211,
					"content": "... Şimdi anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480212
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480212,
					"content": "Nihayet sıra bana geldi! Haha, tamamen bana ait büyük bir lezzet parçası görüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480213
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480213,
					"content": "Dur, yapma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480214,
					"content": "Ne? Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480215,
						401480216
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480215,
					"content": "Bu iş sende Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480217,
					"content": "Iı... Tamam, hadi bakalım... Şimdi şöyle, Paimon size bu yemeğin kökenini anlatmayı unuttu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480218,
					"content": "Kökenini mi? Dostum, yemeğin nereden geldiğinden bize ne. Önemli olan nereye gittiği! Haksız mıyım? Doğruca mideye yani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480219
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480219,
					"content": "Şey, ııı... Yemeğin kökenini atlamak... Tur rehberi olmadan seyahate çıkmak gibidir ama! Paimon'a güvenin! Hikayeyi dinledikten sonra yemekten çok daha fazla keyif alacaksınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480220,
					"content": "Paimon zekice bir çıkarımda bulundu. Tıpkı her çayın kendine has bir şekilde değerlendirilmesi gerektiği gibi, bir yemeği de hikayesini bilmeden yemek şefin iyi niyetini heba etmektir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480221
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480221,
					"content": "Yoldaşımın iyi niyeti diyorsun ha? Onu boşa harcayamayız, doğru... Pekala o zaman, anlat bakalım hikayeyi! Seni dinliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480222
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480222,
					"content": "İşte bu! Önce malzemelerden başlayalım... Aslında hayır, Wangshu Hanının hikayesiyle başlamak lazım... O da Dihua Bataklığı'nın tarihiyle başlıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480223,
					"content": "#(İşte beklediğimiz fırsat {NICKNAME}!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480224
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480224,
					"content": "(Anladım!)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480225
					]
				},
				{
					"id": 401480225,
					"content": "Hazır Itto'nun dikkati dağılmışken Shinobu ile birlikte yemeği mideye indirmeye başlıyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480226
					]
				},
				{
					"id": 401480226,
					"content": "... Dostum, Dihua Bataklığı'nın hikayesi beni derinden etkiledi... Geçmişte insanlar ne zorluklar yaşamışlar. İnsan elindekilere şükrediyor resmen. \"Sıcacık Aşım\"... Hayata dair harika bir hikaye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480227
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480227,
					"content": "(Tüh, buradan tofuya bağlayamayız... Konudan nasıl bu kadar uzaklaştık? Off, neyse ki çok az kaldı!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480228,
					"content": "(Ama artık... İyice doyduk...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480229
					]
				},
				{
					"id": 401480229,
					"content": "Aaaa! Yoldaş, Shinobu! Bunca zamandır yiyor muydunuz? Bana artıklarınızı bıraksaydınız bari ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480230
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480230,
					"content": "Bu kadar beklediğim yeter! Yeme sırası bende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480231
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480231,
					"content": "Dur! Patron, o yemek aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480232
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480232,
					"content": "Bir dakika Itto. Benim... Küçük bir ricam olacaktı, kabul edersen tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480233
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480233,
					"content": "Evden alelacele çıktım ve yanımda ailemden kimseyi getiremedim. Senin hakkında çok şey duydular, Arataki Çetesinin de çok büyük hayranları sayılırlar. Bu fırsatı kaçırdıklarını öğrenirlerse çok büyük hayal kırıklığına uğrarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480234
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480234,
					"content": "Gelgelelim... Senin de gönlün olursa kalan Sıcacık Aşım porsiyonunu onlara götürmek istiyorum. Bu yemeğin onların keyfini yerine getireceğine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480235
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480235,
					"content": "Iıı... Bilemedim ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480236
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480236,
					"content": "Patron, arkadaşlarına karşı iyilikte bulunmalısın. Liyue'de bu konuya çok önem verirler... Ayrıca biz ana yemeği beklerken sen ızgara balıklardan epey yedin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480237
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480237,
					"content": "... Benim ve Ayato'nun payını da yedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480238
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480238,
					"content": "Ne? Onlar sizin miydi? Hay aksi... O hikayeye kendimi iyi kaptırmışım demek ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480239
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480239,
					"content": "O halde... Ailene selamlarımı ilet kardeşim! Şefim, kalanları paket yapabilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480216,
					"content": "Ne yapman gerektiğini biliyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480217
					]
				},
				{
					"id": 401480207,
					"content": "Önce ben başlayabilirim belki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480208
					]
				}
			]
		},
