			"dialogs": [
				{
					"id": 401480101,
					"content": "#Günaydın {NICKNAME}. Bugün de müşteriler için ocağı yakma zamanı geldi. Tekrar teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480102
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 401480102,
					"content": "Günlerce süren deneyimlerinizden sonra işler artık otomatiğe bağlanmıştır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480103
					]
				},
				{
					"id": 401480103,
					"content": "Harika... Gün geçtikçe iyice bir şef gibi görünmeye başladın! Hehe, o kapıdan hangi çılgın karakter girerse girsin artık senin halledebileceğine eminim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480104
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 401480104,
					"content": "Bir saniye, hayır! Ne zaman böyle bir şey desen başımıza bir musibet geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480105,
					"content": "Hey, hiç de bile! Her neyse, zaten öyle demek istemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480106
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 401480106,
					"content": "Hahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480107
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480107,
					"content": "Vay, dostum! Naber kardeşim? Senin de Liyue'de olduğunu bilmiyordum! Ah, eski Inazumalı bir dostuma rastlamak çok güzel... Bir saniye, doğru mu söyledim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480108
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480108,
					"content": "Hemen hemen. Sanırım \"Inazumalı eski bir dostum\" demek istedin Patron.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480109
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480109,
					"content": "Evet, evet, ondan işte! Memleketten uzaktayken birbirimizi kollamalıyız! Öyle değil mi Ayato?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480110
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480110,
					"content": "Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480111
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480111,
					"content": "... Boşboğaz! Senin burada ne işin var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480112,
					"content": "Ne? Selam Uçan Eflatun Kavun... \"Gök Yaran Beyaz Demir\" kavun çeşidi yani! Oo, yoldaşım da buradaymış! Tüm dostlarım bir arada, bugün şanslı günüm olsa gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480113
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480113,
					"content": "Memlekete döndüğünde sıkıca çalışıp Mora kazanacağını söylememiş miydin? Ne oldu da Liyue'ye bu kadar erken dönüverdin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480114,
					"content": "Haha, o işin acelesi yok. Arataki Itto'nun iş alabileceğini söylediğim anda zaten herkes üzerime Mora atacak... Şu anda halletmem gereken çok daha acil bir işim var. Şöyle iyi ve acılı bir yemek yeme modumdayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480115
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480115,
					"content": "... Hem hazır buradayken gidip Büyük Usta Hanakado'yu da bir ziyaret edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480116
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480116,
					"content": "(Shinobu'nun suratındaki ifade sanki... \"Sorma.\" der gibi.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480117
					]
				},
				{
					"id": 401480117,
					"content": "Peki ya sen Ayato?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480118
					]
				},
				{
					"id": 401480118,
					"content": "... Kısa süre önce birilerinin Liyue'de Hayalet Böcek dövüşü yarışması organize edeceğini duydum. Ben de tabii hemen geldim... Ama ne yazık ki çok geç kalmışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480119
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480119,
					"content": "Ne? Kaçırdın mı yarışmayı? Ah be, gerçekten yazık olmuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480120
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480120,
					"content": "Yazık oldu hakikaten ama henüz her şey bitmiş sayılmaz. Sen de burada olduğuna göre olan biten her şeyi bana anlatabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480121
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480121,
					"content": "Haha, tabii ki! Ama önce yiyecek bir şeyler alalım... Şef nerede? Hey, şefi çağırın bana. Karnını doyurmam gereken yoldaşlarım var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480122
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480122,
					"content": "Şef benim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480123
					]
				},
				{
					"id": 401480123,
					"content": "Tabii, ben de... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480124
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480124,
					"content": "Vay canına, Boşboğaz bu işlerden anlıyor. Hakkını vermek lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401480125,
					"content": "... Ama asıl şef başka biri.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401480126
					]
				},
				{
					"id": 401480126,
					"content": "Iı... Haha, bak bu iyiydi işte yoldaş, neredeyse beni kandıracaktın. Pekala, o şef gelsin o zaman buraya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480127
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480127,
					"content": "Paimon ile birlikte mutfağa gidip Güleç Yanxiao'yu çağırıyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401480128
					]
				},
				{
					"id": 401480128,
					"content": "Şey, ııı... Siparişinizi alabilir miyim? Konuklarınızı ağırlamak için size Saray Mücevherlerini ve Çalsın Sazlar Üflensin Kavalları önerebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480129
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 401480129,
					"content": "... Patron, bütçemizi unutma sakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480130
					],
					"speakerTitle": "Kuki Shinobu"
				},
				{
					"id": 401480130,
					"content": "Evet, tamam, ııı... Şöyle biraz daha... Ölçülü bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480131
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480131,
					"content": "Ölçülü mü? Hım... \"Sıcacık Aşım\" diye bir yemeğimiz var. Birçok lezzeti içinde barındıran bir yemektir, porsiyon büyüklüğü konusunda da içiniz rahat olsun. Tam bir Mora performans yemeğidir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480132
					],
					"speakerTitle": "Güleç Yanxiao"
				},
				{
					"id": 401480132,
					"content": "\"Sıcacık Aşım\" ha? İsmine bakılırsa tam bana göre bir yemek! Ondan alalım biz. Süslü püslü bir şeye gerek yok, hepimiz arkadaşız burada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480133
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480133,
					"content": "Harika bir seçim Itto. Mutfakta aşırı gösterişten ben de hoşlanmam. Heh... Kardeş dediğin bazen neyin ne olduğunu iyi bilir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480134
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401480134,
					"content": "Kardeş dediğin neyin ne olduğunu iyi bilir... Evet, kardeş dediğin bilir! Kardeşler varsayımda bulunmaz çünkü kardeş dediğin neyin ne olduğunu iyi bilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480135
					],
					"speakerTitle": "Arataki Itto"
				},
				{
					"id": 401480135,
					"content": "Bu muhabbet gerçek mi şu an? Her neyse, Paimon sizi kendi halinize bırakacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
