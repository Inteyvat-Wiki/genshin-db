			"dialogs": [
				{
					"id": 401480301,
					"content": "Görünüşe göre her şey yoluna girdi, değil mi? Pekala, biraz toparlan bakalım. Kalabalık bir grup daha gelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401480302
