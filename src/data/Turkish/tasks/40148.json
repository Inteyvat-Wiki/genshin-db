						401489702
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401489702,
					"content": "Gerçekten de Hayalet Böcek dövüşü yarışması için gelmedin değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401489703
					]
				},
				{
					"id": 401489703,
					"content": "Heh, öyle olabileceğini düşünebiliyor musun? Bu bana hiç de yakışmayan türden bir geç kalma olurdu. Hayır, aslında bu geziye hem ziyaret hem ticaret için çıktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489704
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401489704,
					"content": "Fener Şenliğine niye gelmedin o zaman?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401489705
					]
				},
				{
					"id": 401489705,
					"content": "Her ziyaretçinin kendi planı vardır. Kimileri sırf kutlamalar için gezerken kimileri de kalabalıktan kaçmak için gezer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401489706
					],
					"speakerTitle": "Kamisato Ayato"
				},
				{
					"id": 401489706,
					"content": "Her halükarda, öyle veya böyle doğru zamanda doğru yere gelmişim sanırım. Artakalan tofuya gelince... Evet, Thoma'nın icabına bakacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamisato Ayato"
				}
			]
		},
