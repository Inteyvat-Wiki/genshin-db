			"dialogs": [
				{
					"id": 200170101,
					"content": "Hayır, lütfen beni incitme! Ha? Gezgin, dağ yabanileri nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170102
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170102,
					"content": "Harika! Çok teşekkür ederim! Cidden hepsi gitti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170103
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170103,
					"content": "Oh be... Sana borçlandım. Sanırım tüm bu olan bitenin ardından kervana yetişemeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170104
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170104,
					"content": "Ayrıca arabam da hasar aldı. Meyveler bozulmadan arabayı tamir ettirip şehre gitmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170105
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170105,
					"content": "Bunca meyve bozulursa... Kokuyu hayal bile edemezsin. Ne kadar yıkasam da çıkaramam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170106
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170106,
					"content": "Tekrar stok yapmam gerekir... Bazı meyveler çoktan bozulmuş, kokusunu alabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200170107
					],
					"speakerTitle": "Farrah"
				},
				{
					"id": 200170107,
					"content": "Arabamı tamir etmek için gerekli birkaç malzemeyi bulmama yardım eder misin? Bir adet <color=#00E1FFFF>Sağlam Kalas</color> yeterli olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farrah"
				}
			]
		},
