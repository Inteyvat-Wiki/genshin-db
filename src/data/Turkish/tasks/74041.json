			"dialogs": [
				{
					"id": 740410101,
					"content": "Selam Broglie, bahsettiğin iki gözlem istasyonundan verileri getirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410102,
					"content": "Gerçekten mi? Harika! Müsaadenizle bir göz atayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410103,
						740410104
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410103,
					"content": "İşte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410107
					]
				},
				{
					"id": 740410107,
					"content": "Topladığınız delikli şeritleri Broglie'ye veriyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410108
					]
				},
				{
					"id": 740410108,
					"content": "Ahhhh! Evet, bu o, işte bu o! Siz ikiniz tam bir meleksiniz! Beni bu aciz durumdan kurtarmak, mutlu ve tasasız hayatımı geri vermek için gönderilen meleklersiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410109
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410109,
					"content": "Öyle söylemesen olmaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410110,
					"content": "#Neyse! Kaybedecek vaktimiz yok saygıdeğer {M#beyefendi}{F#hanımefendi}! Müdürümü bulmaya gidip merkezi işleme istasyonunun anahtarını isteyeceğim! Lütfen bekleyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410111
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410111,
					"content": "*iç çeker* Sadece... Elini çabuk tut, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410112,
					"content": "Broglie kısa süre sonra heyecanla geri gelir.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410113
					]
				},
				{
					"id": 740410113,
					"content": "#{M#Beyefendi}{F#Hanımefendi}, anahtarı aldım! Artık geriye sadece merkezi işleme istasyonuna gidip verileri düzenlemek kaldı. Sonra tekrar hidrolojik gözleme devam edebileceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410114,
						740410115
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410114,
					"content": "Ah...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410116,
					"content": "Meyve Şekerlemesi ve Krep Süzet İstasyonlarındaki durum malum; Snezhnayalıların da merkezi işleme istasyonuna gitmiş olması gayet mümkün...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410117
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410117,
					"content": "O yüzden lütfen bana eşlik edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410118
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410118,
					"content": "Ödememizi unutma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410115,
					"content": "Seninle gelmemiz mi gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410116
					]
				},
				{
					"id": 740410104,
					"content": "Ödememiz ne olacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410105
					]
				},
				{
					"id": 740410105,
					"content": "O konu... Lütfen endişeniz olmasın. Müdürüm eski hidrolojik araştırmalarımıza tekrar başlamamız için onay verirse mutlaka ödemenizi yapacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410106
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410106,
					"content": "Hehe, rahatladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
