			"dialogs": [
				{
					"id": 740411301,
					"content": "Durun! Pes ediyorum! Durun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411302
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411302,
					"content": "Siz... Delikli şeritler için geldiniz, değil mi? Hepsi sizin olsun! Bana saldırmayı bırakın yeter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411303
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411303,
					"content": "Fatui komutanı tüm araştırma verilerini size verir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411304
					]
				},
				{
					"id": 740411304,
					"content": "Hepsi bu kadar mı Broglie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411305,
					"content": "Ah... Şey... Galiba? Hepsi bu kadar olsa gerek. Eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411306
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411306,
					"content": "Paimon hiç sormadı farz et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411307,
					"content": "Buraya gelme amacın ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411308
					]
				},
				{
					"id": 740411308,
					"content": "Evet, her şeyi anlat! Bu istasyonlarda bulunma sebebin nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411309,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411310
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411310,
					"content": "Kaytarmak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411311
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411311,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411312,
					"content": "Adım Malinovskyi, 34. Bağımsız Araştırma Ekibinin subayıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411313
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411313,
					"content": "Fontaine'e ilk geldiğimizde herkesin yüzünde güller açıyordu. Görevimiz de bu kadar zor değildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411315
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411315,
					"content": "Bunun istasyonlarda bulunmanla ne alakası var peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411316,
					"content": "Birkaç ay önce organizasyondaki birtakım değişiklikler yüzünden karargah, Shumilov diye birini yeni yardımcım olarak atadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411317
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411317,
					"content": "Shumilov mu? Krep Süzet İstasyonunda gördüğümüz birlik lideri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411318,
					"content": "Evet, aynen o! Ona sinir oluyorum ama bir türlü kurtulamıyorum da... Bu yüzden mazeret uyduruyorum ve sırf ondan uzaklaşayım diye görevlere gidiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411319
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411319,
					"content": "Bir dakika, Paimon'un kafası karıştı. Bahsettiğin adam senin yardımcın değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411320,
					"content": "Aynen öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411321
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411321,
					"content": "Onun amiri değil misin sen? Onun sözünü dinlemek zorunda değilsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411322,
					"content": "Şey, o biraz... Nasıl desem? Her zaman müthiş ciddi davranır ve işini başkalarına yaptırır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411323
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411323,
					"content": "Sözlerine karşı çıkmak zor işte. Ben de ona herkesin gözü önünde artık kimsenin çalışmak istemediğini söyleyemiyorum, anlarsınız ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411324
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411324,
					"content": "Yakınlarda tuhaf kuleler görünce ona araştırmaya gideceğimizi söyledim ve Hukuk Dairesinden gelmiş gibi görünen sahte mektuplar hazırladım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411325
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411325,
					"content": "Sahte mektuplar hazırladın demek! Paimon biliyordu! Hukuk Dairesi asla hidrolojik gözlem istasyonlarına el koymanıza izin vermezdi zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411326,
					"content": "Başka sorun var mı Broglie?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411327,
					"content": "Anladım. Sadece işten kaytarmaya çalışıyordun demek... Daha doğrusu, gözlem istasyonlarımızı ele geçirerek bu dünyanın kargaşasından kaçıp biraz sükunete ulaşmaya çalışıyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411328
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411328,
					"content": "Ee? Nasıldı? Rahat ettin mi bari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411329
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411329,
					"content": "?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411330,
					"content": "Şey, çok rahat ettim? Manzara da harikaydı. Kısa şekerlemeler yapmak çok iyi gelir bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411331
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411331,
					"content": "Değil mi ya? Özellikle uyandıktan sonra acil iş olmaması, sevmediğin birinin sürekli başında dikilmemesi... Öğlen güneşinin ve rüzgarın tadını gönlünce çıkarmak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411332
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411332,
					"content": "Bir rüyadan uyanıp hiçbir kaygının olmadığı bambaşka bir rüyaya geçmek gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411333
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411333,
					"content": "Hayatı işte böyle yaşamak gerek! Vasari Pasajı'ndaki özel üretim siyah çayı denememiş olman kötü olmuş. Fırsatın olursa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411334
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411334,
					"content": "Bir dakika, konudan biraz saptık sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411335,
					"content": "Neyse, lütfen bizimle gel! Fontaine Araştırma Enstitüsüne yaptıklarını anlatma vakti geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411336,
					"content": "Off...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411337
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411337,
					"content": "Be-Bekle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411338
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411338,
					"content": "Şey... Araştırmalarımıza herhangi bir zarar vermedi sonuçta, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411339
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411339,
					"content": "Hatta bizim için veri bile toplamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411340
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411340,
					"content": "O sadece işten kaytarıp rahat rahat yaşamak isteyen bir adam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411341
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411341,
					"content": "Doğru!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411342
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411342,
					"content": "Bir dakika, gurur duyulacak bir şey değil ki bu. Hele de böyle söyleyince.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411343,
					"content": "#Saygıdeğer {M#beyefendi}{F#hanımefendi}, lütfen bu adamı bilim adına serbest bırakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411344,
						740411345
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411344,
					"content": "Meselenin bilimle alakası var mı şimdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				},
				{
					"id": 740411346,
					"content": "Teşekkürler efendim, size de teşekkür ederim! Yemin ederim ki bir daha asla böyle bir şey yapmayacağım. Kaytaracaksam tek başıma kaytaracağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411347
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740411347,
					"content": "Kararlılığına bayıldım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411348
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411348,
					"content": "Buna bile heyecanlanıyor musun gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411349,
					"content": "Fatui komutanı, minnettar bir şekilde ayrılır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740411350
					]
				},
				{
					"id": 740411350,
					"content": "Bu meseleyi de çözdüğümüze göre ben verilerin üstünden geçmeye devam edeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411351
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411351,
					"content": "Yardımınız için teşekkür ederim! Lütfen bunları kabul edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411352
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740411352,
					"content": "Mesele gerçekten... Çözüldü mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740411353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411353,
					"content": "Neyse, en azından artık istasyonlar tekrar çalışmaya başladı ve Fatui birlikleri de bölgeyi terk etti. Paimon işin bittiğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740411345,
					"content": "Madem işverenimiz öyle istiyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740411346
					]
				}
			]
		},
