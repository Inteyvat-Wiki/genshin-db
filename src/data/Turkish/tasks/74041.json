			"dialogs": [
				{
					"id": 740410601,
					"content": "Bir bakayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410602
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410602,
					"content": "Bu verileri bir araya getirebilirsek müthiş sonuçlar elde edeceğimizden ve hidrolojik gözleme çok yakında başlayacağımızdan eminim! Heyecandan yerimde duramıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410603
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410603,
					"content": "Harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410604,
					"content": "Neden içimden bir ses verilerin bir kısmı eksik diyor? Paranoyaklık mı ediyorum yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410605
					],
					"speakerTitle": "Broglie"
				},
				{
					"id": 740410605,
					"content": "Neden emin olamadın? Verilerden sen sorumlu değil misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410606
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410606,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410607
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740410607,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410608,
					"content": "?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410609
					]
				},
				{
					"id": 740410609,
					"content": "... Şey, pardon. Yanlış oda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410610
					],
					"speakerTitle": "Malinovskyi"
				},
				{
					"id": 740410610,
					"content": "Fatui komutanı, dış görünüşünden beklenmeyecek bir hızla ortamdan ayrılır.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740410611
					]
				},
				{
					"id": 740410611,
					"content": "Yanımızdan biri mi geçti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410612,
						740410613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410612,
					"content": "Ejderden de hızlıydı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				},
				{
					"id": 740410614,
					"content": "Bir dakika, konumuz bu değil! Adam Fatui üyesi! Burada ne işi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740410615
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410615,
					"content": "#{NICKNAME}, peşine düşüp hemen meseleyi enine boyuna incelemeliyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740410613,
					"content": "Çok çevik...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740410614
					]
				}
