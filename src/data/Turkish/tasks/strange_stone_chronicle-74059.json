			"dialogs": [
				{
					"id": 740590101,
					"content": "Ah siz, bana o değerli taşları satanlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590102
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590102,
					"content": "Evet! Geçen sefer buluştuğumuzda taşlardan güzel takılar yapacağını falan söylemiştin... Yaptın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590103,
					"content": "Paimon onları görmek için sabırsızlanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590104,
					"content": "O konuda... Maalesef biraz hayal kırıklığı yaşayabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590105
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590105,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590106,
					"content": "Onları mücevherlere işleyerek değerli taşlara dönüştürmeyi çok istedim ama cevherler elle detaylı bir işleme yapılamayacak kadar sert çıktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590107
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590107,
					"content": "Daha da kötüsü ise kesilip parlatıldıktan sonra cevherin tüm orijinal parlaklığını yitireceği kimin aklına gelirdi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590108
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590108,
					"content": "Yani her halükarda, bu cevherler işleme için hiç uygun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590109
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590109,
					"content": "Aa... Paimon böyle bir şeyin olmasını beklemiyordu. Bu taşların gerçekten de bir şekilde işe yarayacağını düşünmüştük...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590110,
					"content": "O açıdan bakıldığında işe yarar... Evet, kesinlikle işe yaramayacağı söylenemez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590126
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590126,
					"content": "Chesil konuşurken bir yandan da tezgaha bir mekanik saat koyar.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590111
					]
				},
				{
					"id": 740590111,
					"content": "Şu yeni mekanik saate bakın. O cevher kullanılarak yapıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590112
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590112,
					"content": "Tam cevhere yanlış değer biçtim diye kendimi suçlayıp bu taşları atmak üzereydim ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590113
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590113,
					"content": "O anda birkaç saatçi geldi ve işlenemeyen cevher kalıntılarını gördü. Cevherler çok dayanıklı olduğu için birazını alıp götürdüler ve onları saat parçalarının yapımında kullandılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590114
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590114,
					"content": "Cevherin aşınmaya karşı olan yüksek direnci sayesinde, saatlerin hareketli parçalarında geleneksel olarak kullanılan malzemelerden daha üstün olduğunu duyduğumda çok şaşırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590115
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590115,
					"content": "Ama saat yapımında kullanılacağı için daha düzenli bir tedarik planı olması gerekir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590116,
						740590117
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590116,
					"content": "Sanırım hallederiz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				},
				{
					"id": 740590118,
					"content": "Chesil'e Puca'dan ve cevher damarlarından bahsedersiniz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590119
					]
				},
				{
					"id": 740590119,
					"content": "Anladım. O zaman bu çok büyük bir tesadüf oldu! Prototip saat, midye tarzında en yeni su geçirmez bir tasarımla üretildi. Diğer bir deyişle, en başından beri Melusinaların kullanımı için tasarlandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590120
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590120,
					"content": "Madem öyle, bu prototip saati Bayan Puca'ya götürüp onu durumdan haberdar edebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590121
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590121,
					"content": "Sonuçta daha önce Melusinalarla hiçbir ticari geçmişim yok... Eğer Bayan Puca bize düzenli mal tedariki sağlayabilirse tamamen yeni bir üretim hattı oluşturabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590122
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590122,
					"content": "İlerleyen zamanlarda onu bizzat ziyaret edeceğim! Hımm... Gelecekteki saat tasarımlarına Melusinaların tarzını eklemek harika bir fikir olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590123
					],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590123,
					"content": "Hehe, başarılı olursa bunun Puca'ya da faydası olur gibi görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590124,
					"content": "Bu, Puca'nın kendi değerli taş fabrikasını açması için harika bir fırsat olabilir! Hadi, hemen gidip onunla konuşalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590125,
					"content": "Size güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chesil"
				},
				{
					"id": 740590117,
					"content": "Puca ile doğrudan iletişime geçsen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				}
			]
		},
