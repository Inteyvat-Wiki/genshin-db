			"dialogs": [
				{
					"id": 740590201,
					"content": "#{NICKNAME}, Paimon, görüşmeyeli uzun zaman oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590202
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590202,
					"content": "Geçen seferki gibi o tuhaf taşlardan mı arıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590203
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590203,
					"content": "Evet ama farklı bir durum daha var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590204,
					"content": "Chesil'in prototip saatini Puca'ya verirsiniz ve ona Chesil'in tuhaf cevherlerden saat yapma planından bahsedersiniz.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590205
					]
				},
				{
					"id": 740590205,
					"content": "Ha-Harika! O taşlardan bu şeyleri mi yaptılar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590206
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590206,
					"content": "Ne? Sadece içindeki ufak parçalar o taştan yapıldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590207,
					"content": "Suyun altındayken bile tik tak sesi duyulabiliyor... Daha önce böyle bir saat görmemiştim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590208
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590208,
					"content": "Chesil, istiridye tarzında bir tasarımdan bahsetmişti... Midye miydi yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590209,
					"content": "Hehe, saatten ses gelmesi bile çok mutlu etti beni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590210
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590210,
					"content": "Bunun gibi sıradan taşların bile bir şeyde kullanılabileceği hiç aklıma gelmemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590211
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590211,
					"content": "Her zaman kız kardeşim gibi sadece en nadir taşların hazineye dönüştürülebileceğine inanırdım. Böyle sıradan taşlarla harika bir şey yapılabileceğini hiç düşünmemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590212
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590212,
					"content": "Her şeyin bir değeri ve amacı vardır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590213
					]
				},
				{
					"id": 740590213,
					"content": "Hı hı, kendimi birden çok iyi hissettim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590214
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590214,
					"content": "Puca, saati dikkatli bir şekilde güzel bir yere koyar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590215
					]
				},
				{
					"id": 740590215,
					"content": "Pekala, şu anda sadece cevheri hazırlaman ve gerektiğinde Chesil'e onları satman gerekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590216,
					"content": "Bu şekilde, tıpkı kardeşin gibi kendi değerli taş atölyeni bile açabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590217,
					"content": "Sonuçta farklı farklı bir sürü taşlar topluyorsun. Belki her biri için bir kullanım alanı bulabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740590218,
					"content": "Doğru! Kesinlikle onun için hazırlık yapacağım! Çok teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590219
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590219,
					"content": "Herhangi bir taş lazım olursa istediğiniz zaman yanıma gelebilirsiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590220
					],
					"speakerTitle": "Puca"
				},
				{
					"id": 740590220,
					"content": "Hehe, lafı bile olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
