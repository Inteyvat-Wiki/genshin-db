			"dialogs": [
				{
					"id": 761140301,
					"content": "(Ne? Bu... Tamamen yanmamış sanki...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140302
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140302,
					"content": "(Bay Derwent'in yaralı maceracıları evine aldığını duymuştum... Yakın zamanda olmuş gibi duruyor bu.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140303
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140303,
					"content": "(Bunları neden yakmaya çalışmış peki?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
