			"dialogs": [
				{
					"id": 761140201,
					"content": "Merhaba, kimse var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140202
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140202,
					"content": "Bay Derwent? Evde misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140203
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140203,
					"content": "... Kim var orada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140204
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140204,
					"content": "Ben Jahoda. Sırlar Arşivi'nden geliyorum. Size birkaç soru sormak istiyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140205
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140205,
					"content": "... Oradan sorabilirsin. Hastayım, yerimden kalkamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140206
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140206,
					"content": "(Ne kadar tuhaf... Deniz Kabuğu Çetesindeki çocuklar okuma yazmayı Bay Derwent'ten öğrendiklerini söylemişti. Ses tonunun çok yumuşak olduğundan bahsediyorlardı...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140207
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140207,
					"content": "(Konuşan kişinin sesi kalınlaşmış ama pek hasta değil gibi. Sesi doğuştan kalın sanki...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140208
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140208,
					"content": "İyi misiniz? Durumunuz ciddiyse doktor çağırabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140209
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140209,
					"content": "... Gerek yok. Biraz dinlenirsem geçer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140210
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140210,
					"content": "Pekala. İyileştiğinizde Nasha Kasabası'na uğrarsınız. Arkadaşlarınız sizin için çok endişelenmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140211
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140211,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140212
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140212,
					"content": "(... Neden cevap vermiyor? İçeriden ayak sesleri geliyor ama çok ağır birinin ayak seslerini andırıyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140213
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140213,
					"content": "Bugünlerde dışarı pek çıkmıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140214
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140214,
					"content": "... Ekinlerimi kendim yetiştiriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140215
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140215,
					"content": "Doğrudur. Yöre halkı son zamanlarda kendinizi adeta baştan yarattığınızdan bahsediyor... Hatta geçen gün konuştuğum bir arkadaşım ne kadar kaslı göründüğünüzü görünce çok şaşırmış. Eskiden cüppenin altında çok zayıf göründüğünüzü söylüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140216
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140216,
					"content": "Bir de Kuuvahkiyi engellemek için kullandığınız maske var... Yeni moda falan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140217
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140217,
					"content": "... Sesleri kesmek için kullanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140218
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140218,
					"content": "Ekinlerle ilgilenmek daha mı rahat oluyor öyle?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140219
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140220
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140220,
					"content": "Neyse. Geçenlerde bir tüccar sizi ziyaret etmeye gelmişti. Nereye gittiğini biliyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140221
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140221,
					"content": "Hiçbir fikrim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140222
					],
					"speakerTitle": "Derwent"
				},
				{
					"id": 761140222,
					"content": "Tamam o zaman... Rahatsızlık verdiysem kusura bakmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140223
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140223,
					"content": "(Niyeyse tüylerim diken diken oldu... Bu iş tehlikeli olmaya başlıyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140224
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140224,
					"content": "(Haklılarmış. Bambaşka biriyle konuştum sanki...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140225
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140225,
					"content": "(İstediğim kadar bilgi alamadım. Patron Nef'e dönemem şu an. Yakında kalıp bölgeyi araştırayım en iyisi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
