			"dialogs": [
				{
					"id": 761140101,
					"content": "Şimdi de... Şüpheli bir keşişi mi araştıracağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140102
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140102,
					"content": "Keşişlerin olayı zaten şüpheli olmak değil mi? Dağın başında, kuş uçmaz kervan geçmez yerlerde yaşamak normal bir durum değil yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140103
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140103,
					"content": "Hiçbir insan durduk yere değişmez. Bazen kendi iç dünyaları değiştirir onları, bazense dış dünya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140104
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140104,
					"content": "Üstelik şu kayıp tüccar meselesi hâlâ muamma...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140105
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140105,
					"content": "İyi de o bölgenin tehlikelerle dolu olduğunu herkes biliyor. Haydutlar, canavarlar falan... Gezgin bir tüccarın hayatını kaybetmesine yol açacak sayısız şey var orada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140106
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 761140106,
					"content": "Herkes bölgenin tehlikelerini biliyor tabii. Peki sence o bölgeden sık sık geçen bir tüccarın yola hazırlıksız çıkmış olması mantıklı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140107
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140107,
					"content": "Bölgeyi yakından tanıyan deneyimli bir tüccar kayboldu. Şüphe uyandırması doğal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140108
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140108,
					"content": "Jahoda, bu \"şüpheli keşişi\" ziyaret etme işini sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140109,
					"content": "Uzun bir seyahat olacak. Ana yoldan sapmamaya çalış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761140110
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 761140110,
					"content": "Ha... Emredersiniz Patron Nef! Bana güvenebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jahoda"
				}
			]
		},
