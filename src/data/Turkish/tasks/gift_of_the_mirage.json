			"dialogs": [
				{
					"id": 760100201,
					"content": "Yirmi beş, yirmi altı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100202
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100202,
					"content": "Hı? Ne sayıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100203,
					"content": "Şşş! Sessiz ol. Neyse ya, unut gitsin. Bir şey yakalayacağım yoktu zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100204
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100204,
					"content": "Hadi ama evlat, çok açık değil mi ne olduğu? Atışımı zamanlamaya çalışıyordum. Ne o, bu oltayı büyü yapmak için falan savurduğumu mu sandın yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100205,
						760100207
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100205,
					"content": "Yani... Donuk Ayın Çocuklarının bir üyesisin sonuçta, çok da garip sayılmaz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100206
					]
				},
				{
					"id": 760100206,
					"content": "#Haha, beni gözünde fazla büyütüyorsun {M#genç adam}{F#genç hanım}. Donuk Ayın Çocuklarından biri sayılmam tam olarak. Akolit bile değilim. Kuuvahki gücü olmayan, sıradan bir adamım işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100210,
					"content": "Neyse, Paimon hayatında ilk kez balık tutarken saniyesi saniyesine zaman tutan birini görüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100211,
					"content": "Önemli olan kıyıda ne kadar uzun süre durduğun değil, balık tutma tekniğindir. İhtiyar Ilmari bunu hiç anlamadı. Hiçbir şey yakalayamamasına şaşırmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100212
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100212,
					"content": "Siz ikiniz de hazine avcısısınız herhalde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100213
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100213,
					"content": "Hayır, maceracıyız biz. Ama iş kabul ediyoruz tabii. Bir şeye mi ihtiyacın vardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100214,
					"content": "Öyle sayılır. İşi yapabilecekseniz ve karşılığında ödeme almaya itirazınız yoksa benim için fark etmez. Yardımcı olabileceğiniz bir mesele var, zamanınız varsa tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100215
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100215,
					"content": "Bakın, ben Hiisi Adası'ndaki açık ara en iyi balıkçıyım. Nesillerdir Ay İlahicilerinden bile hiç kimse balık tutma konusunda beni geçemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100216
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100216,
					"content": "Gerçekten mi? Harikaymış. Dur biraz, bunun bir anlamı yok ki! Balık tutmak bir Ay İlahicisinin görevlerinden biri bile değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100217,
					"content": "Bu kadar yetenekli olmama rağmen son zamanlarda tek bir balık bile yakalayamadım. Bu çok mantıksız, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100218
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100218,
					"content": "E doğal olarak sorun bende değil, çevrede tabii. Tıpkı Kratti'nin Gözü gibi suyun altında da balıkları etkileyen bir şey olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100219
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100219,
					"content": "Nasıl bir mantık yürütmeyse bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100220,
					"content": "Neyse, yakınlardaki suları kontrol edip balıkları neyin korkuttuğuna bakmanızı isteyecektim. Merak etmeyin, çabalarınızın karşılığını alacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100221
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100221,
					"content": "İşin ucunda ödül varsa bakarız tabii. Herhangi bir tuhaflıkla karşılaşıp karşılaşmayacağımıza dair söz veremeyiz ama, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760100207,
					"content": "Belki de çok iyi bir seyahat arkadaşı yakalarsın, kim bilir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760100208
					]
				},
				{
					"id": 760100208,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100209
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100209,
					"content": "Hey! Sıradan bir savuruşla herkes çok iyi bir seyahat arkadaşı tutabilirmiş gibi konuşma! Dur biraz... Mesele bu değil ki zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100210
					],
					"speakerTitle": "Paimon"
				}
			]
		},
