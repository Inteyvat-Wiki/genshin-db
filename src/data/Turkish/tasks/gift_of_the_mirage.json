			},
			"dialogs": [
				{
					"id": 760100601,
					"content": "Hey, şunu gördünüz mu? Ne olduğunu bilmiyorum ama bir anlığına başka yere baktım ve şu büyük kaya uçup gidiverdi birden!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100602
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100602,
					"content": "Neler olduğunu anlatıyorsunuz...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760100603
					]
				},
				{
					"id": 760100603,
					"content": "Aman tanrım! Tüm bunların ne anlama geldiğini bilmiyorum ama bu kadar inanılmaz bir şeyi başardığınıza göre Ay Ha{RUBY#[D]Kuutar}nımı sizi kutsuyor olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100604
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100604,
					"content": "Ay Tanrıçası bizi korusun! Artık dilediğimce balık tutabilirim. O gıcık ozan evcil hayvanıyla geri gelmediği ya da şarkı söylemediği sürece tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100605
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100605,
					"content": "İşte, söz verdiğim gibi ödemeniz burada. Son zamanlarda hiç balık yakalayamadım ama başka bir sürü şey tuttum, bazıları mutlaka epey para ediyordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760100606
					],
					"speakerTitle": "Pekkani"
				},
				{
					"id": 760100606,
					"content": "Gerçi Hiisi Adası'nda Mora pek kullanılmıyor, bu yüzden hepsi sizin olsun. Yardımlarınız için teşekkürler, şimdi bırakın da huzur içinde balık tutayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Pekkani"
				}
			]
		}
	]
