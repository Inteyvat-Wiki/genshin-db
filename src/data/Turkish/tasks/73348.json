				]
			},
			"dialogs": [
				{
					"id": 733480201,
					"content": "Vay canına! Dur! Yapma şunu! Yapma dedim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480202
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480202,
					"content": "*nefes nefese kalır* Yapma, buna gerek yok. Kitapların olduğu bir kutu bu sadece, istiyorsan al senin olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480203,
						733480204
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480203,
					"content": "Bu kadar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				},
				{
					"id": 733480205,
					"content": "Yemin ederim! Bir tek bunu kazıp çıkardık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480206
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480206,
					"content": "Kitaplar haricinde şişelenmiş çamur ve taşlar bulduk... Birkaç güzel mücevher de vardı aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480207
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480207,
					"content": "Onları aldınız mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480208
					]
				},
				{
					"id": 733480208,
					"content": "Hey! O mücevherleri geri verseniz iyi olur! Onlar son derece değerli jeolojik numuneler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480209,
					"content": "Jeolojik... Numuneler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480210,
						733480211
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480210,
					"content": "Onları geri verin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480212,
					"content": "Tamam! Tabii! Sen ne dersen o! Hepsini! Çabuk, hepsini geri koyun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480213
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480213,
					"content": "Bak... Her şeyi tekrar kutuya koyduk. Biz de yola koyulalım en iyisi... Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480214
					],
					"speakerTitle": "Dara"
				},
				{
					"id": 733480214,
					"content": "Harika, Sadife'nin istediği her şey burada. Hadi kutuyu ona geri götürelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480215,
					"content": "Çölü tek başına ziyaret edip onca numune toplamış ve notlar almış! Paimon onun harika bir araştırmacı olduğunu düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480211,
					"content": "ÜÇE kadar sayacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480212
					]
				},
				{
					"id": 733480204,
					"content": "Başka bir şey olmadığına emin misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480205
					]
				}
			]
		},
