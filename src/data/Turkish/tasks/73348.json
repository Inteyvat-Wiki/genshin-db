			"dialogs": [
				{
					"id": 733480101,
					"content": "Fakat o numuneler olmadan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480102,
						733480103
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480102,
					"content": "Purbiruniler hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				},
				{
					"id": 733480104,
					"content": "Evet, şu anki Herbadım ayrıca. Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480105
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480105,
					"content": "Alimlikle ilgili soruların mı var? Gerçi bir Akademi araştırmacısı gibi durmuyorsun ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480106
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480106,
					"content": "Khedive'nin tavsiye mektubu hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480107
					]
				},
				{
					"id": 733480107,
					"content": "Bu mektup bizzat Khedive tarafından mı yazıldı? Bir dakika, şunu okuyayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480108
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480108,
					"content": "Hımm, demek Kanyon'daki araştırma güzel gidiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480109
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480109,
					"content": "Mantarlar üzerine araştırmalar... Su ortamı... Fosiller... Eşsiz jeolojik özellikler... Numuneler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480110
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480110,
					"content": "Güzel, muhteşem, büyüleyici! Khedive son derece zeki bir alim ve muhteşem bir araştırmacı sonuçta. Yine hayal kırıklığına uğratmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480111
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480111,
					"content": "Hıh... Bunu bir yabancının yanında itiraf etmek hoşuma gitmiyor fakat Pursina araştırmacıları gerçekten de çok yetenekli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480112
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480112,
					"content": "Dahası, Khedive mektubunda senin sürekli ve önemli katkılarından özellikle bahsetmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480113
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480113,
					"content": "Yardımların sayesinde araştırması adeta \"kanatlanıp uçmuş\", öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480114,
						733480115
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480114,
					"content": "Lütfen bir daha öyle deme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480116,
					"content": "Öyle mi? Öhöm, kusura bakma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480117
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480117,
					"content": "Akademiye geri döndüğünde kayıtlara Pursina'dan görkemli bir bölüm daha eklenecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480118
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480118,
					"content": "Purbiruni ile Pursina'nın bin yıllık dostluğu daha da güçlenecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480119
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480119,
					"content": "Lütfen Purbiruniler ve Pursinalar adına minnettarlığımı kabul et Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480120
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480120,
					"content": "Doğru ya! Senin için hediyeler olduğunu söylemişti... Sorun değil, bir dakika.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480121
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480121,
					"content": "Lütfen bir mektup daha olmasın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480122
					]
				},
				{
					"id": 733480122,
					"content": "Tabii ki hayır! Khedive'nin araştırmasına çok yardımcı olduğun için karşılığında Mora vermek daha uygun olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480123
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480123,
					"content": "Fakat lütfen kusuruma bakma. Bugün çok yoğun bir gündü, yanımda da fazla Mora yok. Biraz bekleyebilirsen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480124
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480124,
					"content": "Bir başka saygın araştırmacı daha, ha? Fakat Khedive'ye hiç benzemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480125,
					"content": "Biraz... Fakir duruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480126,
					"content": "N-Nasıl yani? Biz Purbiruniler doğuştan araştırmacıyızdır, öyle para gibi dünyevi şeyleri önemsemeyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480127
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480127,
					"content": "Paramızın çoğunu araştırmalarımıza harcarız. Diğer konularda ise... Tutumlu davranırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480128
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480128,
					"content": "Yine de bu, araştırmamıza asla engel olmaz. Hatta maddi şeylerden özgürleşmek bilgeliğe giden yolu daha net bir şekilde görmemizi sağlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480129
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480129,
					"content": "Birazdan gidip paranı getireceğim fakat önce çekinerek de olsa bir ricada bulunmam gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480130
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480130,
					"content": "Khedive senden benzerine az rastlanır, güçlü, deneyimli, muhteşem ve seçkin bir maceracı olarak bahsetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480131
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480131,
					"content": "Eğer senin için de uygunsa bana bir iyilik yapabilir misin? Kısa süre önce jeolojik bir araştırma için çölde keşif yapıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480132
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480132,
					"content": "Bir muhafız tutmadım, çünkü... Elim biraz sıkışıktı. Hızlıca gidip dönmenin daha güvenli olacağını düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480133
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480133,
					"content": "Ne var ki şansım yaver gitmedi ve dönüşte Hazine Avcılarına rastladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480134
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480134,
					"content": "Şehre sağ salim ulaşmayı başardım ama tüm numunelerimin ve notlarımın olduğu kutuyu kaybettim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480135
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480135,
					"content": "Kutunun tüccarlar ve Hazine Avcıları için hiçbir değeri yok fakat benim için dünyalara bedel. Paha biçilemez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480136
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480136,
					"content": "Bana yardımcı olabilecek kadar nazik bir maceracı da bulamadım. Gezgin, acaba sen bana yardım edebilir misin, lütfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480137,
						733480138
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480137,
					"content": "Yardım ederim ben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480139,
					"content": "Sana ne kadar teşekkür etsem az! Sen olmasan ne yapardım bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480140
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480140,
					"content": "Saldırıya uğradığım yeri haritada işaretledim. Bak burası. Kutu da yakınlarda olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480138,
					"content": "Oldu bil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480139
					]
				},
				{
					"id": 733480115,
					"content": "Ondan duymak yetti zaten...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480116
					]
				},
				{
					"id": 733480103,
					"content": "Affedersiniz, Purbiruni araştırmacısı mısınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480104
					]
				}
			]
		},
