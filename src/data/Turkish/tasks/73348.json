			"dialogs": [
				{
					"id": 733480401,
					"content": "Bak burada kim var? Bir Purbiruni mi buldun? Çok da zor değilmiş, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480402,
						733480403
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480402,
					"content": "Bulduk, ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				},
				{
					"id": 733480404,
					"content": "Hımm? Çok çekingen duruyorsun. Birisi bir şey mi yaptı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480405
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480405,
					"content": "Khedive'ye Sadife'yle olan her şeyi anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733480406
					]
				},
				{
					"id": 733480406,
					"content": "Ah, Sadife... İnatçılığıyla tanınır, öğretmenleri bile onunla her zaman başa çıkamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480407
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480407,
					"content": "Hatta en ufak bir finansman kaynağını bile reddeder ve \"araştırmasını saf tutmak\" için tek başına çalışmakta diretir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480408
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480408,
					"content": "Yani \"Bilgelik parayla satılmaz\" bu mu demek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480409,
					"content": "Purbiruni'nin kuralı budur... Haha, Pursina çok daha esnek biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480410
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480410,
					"content": "Yani... Dürüst olmak gerekirse finansal durumum iyi, o yüzden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480411,
						733480412
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480411,
					"content": "Paranı nasıl kazandın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480413,
					"content": "Neden öyle şüpheci baktın? Servetimi çok çalışarak elde ettim, tamam mı? Vadeli işlem ne kadar zor bir şey biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480414,
						733480415
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480414,
					"content": "Vadeli işlem mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480416,
					"content": "Diyorum bak... İşlem hacimlerini, piyasa eğilimlerini bilmek ve doğru yatırım kararları almak gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480417
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480417,
					"content": "Önce eğlence olsun diye yatırım yapmayı düşünmüştüm, bunun araştırmamı etkilemesini istememiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480418
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480418,
					"content": "Kim bilebilirdi ki... Of! Gitgide daha çok Mora kazandım ve borsadaki param büyüdükçe büyüdü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480419
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480419,
					"content": "Ben profesyonel bir araştırmacıyım! Araştırma ve akademik çalışmalarla ilgileniyorum! Mora değil, bilimsel sonuçların peşindeyim! Kendime böyle söylüyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480420
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480420,
					"content": "Fakat ne zaman Sumeru Şehri'ne gelsem borsaya çekiliyorum. Kendimi vadeli işlemler yaparken, ardı ardına alım satım yaparken buluyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480421
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480421,
					"content": "Bu yüzden banka hesap bakiyem sürekli büyürken araştırmamda... HİÇ ilerleme kaydedemedim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480422
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480422,
					"content": "O yüzden buradayım, Kanyon'u keşfetmek için koca bir ekibi işe aldım. Araştırma yapabilmek için alım satım yapılan her yerden uzak duruyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480423
					],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480423,
					"content": "Tatmin edici sonuçlar almadan... Kanyon'dan dışarı adım atmayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Khedive"
				},
				{
					"id": 733480415,
					"content": "Vadeli işlem yaparak mı para kazanıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480416
					]
				},
				{
					"id": 733480412,
					"content": "Neden bu kadar zenginsin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480413
					]
				},
				{
					"id": 733480403,
					"content": "Bir şey oldu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480404
					]
				}
			]
		},
