			"dialogs": [
				{
					"id": 733480901,
					"content": "*iç çeker* Bu kadar kısıtlı bir bütçe araştırmam için hiç yeterli değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480902,
						733480903
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480902,
					"content": "Şey, müsaadenle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480904
					]
				},
				{
					"id": 733480904,
					"content": "Purbiruni araştırmacısı mı? Sadife'yi arıyorsun sanırım. İlginç... Onun pek misafiri olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480905
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480905,
					"content": "Yakın zamanda Akademideki işleri halletmek için geri dönmüştü. Buralarda bir yerde olmalı... Konu nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480906
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480906,
					"content": "Khedive'nin tavsiye mektubu hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480907
					]
				},
				{
					"id": 733480907,
					"content": "Khedive mi? Araştırmasını tamamladı mı? Zengin olmak güzel bir şey olmalı, onu destekleyen büyük bir gözlem ekibi olması falan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480908
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480908,
					"content": "... Bense bir eğitim gezisi için bile ödenek alamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480909
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480909,
					"content": "Khedive'yi tanıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480910
					]
				},
				{
					"id": 733480910,
					"content": "Tabii ki! Biz ödenek için çırpınan ve asla Mora kazanamayan çulsuz araştırmacılarız, onun dillere destan servetiyle ilgili her şeyi biliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480911
					],
					"speakerTitle": "Iris"
				},
				{
					"id": 733480911,
					"content": "Vay be, yani bu Khedive denen kişi ve ailesindeki araştırmacıların hepsi zengin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480912,
					"content": "Bu büyük bir ödül alabileceğimiz anlamına mı geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480913
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733480913,
					"content": "Yok canım. Khedive istisnadır. Purbiruni ve Pursina araştırmacılarıyla ilgili gerçek dışı beklentilere kapılmayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480914
					],
					"speakerTitle": "Iris"
				},
				{
