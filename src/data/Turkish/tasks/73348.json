			"dialogs": [
				{
					"id": 733480301,
					"content": "Gezgin, dönmüşsün! Kutum hakkında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480302,
						733480303
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480302,
					"content": "Burada",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				},
				{
					"id": 733480304,
					"content": "Harika! Çok teşekkür ederim... Tavsiye mektubun olmasına rağmen seni bunca zahmete soktum... Lütfen, bu ödemeyi kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480305,
						733480311
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480305,
					"content": "Purbirunilerin hep söylediği gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480306,
					"content": "Ne? O sözü biliyor musun hakikaten? Evet, Purbiruni'nin böyle bir emri var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480307
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480307,
					"content": "Ancak bu uyarı maddi veya diğer harici sebeplerle araştırma ilkelerine ihanet edilmesini önlemek için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480308
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480308,
					"content": "Sonuçta kar amacı güderek araştırma yapan bir araştırmacı bu unvana layık değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480309
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480309,
					"content": "Sense bana yardım etmek için onca zahmete girdin, çabaların karşılığında bir ödülü hak ediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733480310
					],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480310,
					"content": "Yardım ettiğin için tekrar teşekkürler, bir şeye ihtiyacın olursa çekinmeden söyle lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sadife"
				},
				{
					"id": 733480311,
					"content": "\"Bilgelik parayla satılamaz\" mı oluyor bu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480306
					]
				},
				{
					"id": 733480303,
					"content": "Kutunu buldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733480304
					]
				}
			]
		},
