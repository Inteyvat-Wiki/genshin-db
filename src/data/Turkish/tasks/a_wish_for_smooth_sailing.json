					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970202
					]
				},
				{
					"id": 401970202,
					"content": "Kremalı demek... Biraz geleneksel ama... Çok lezzetli! Tamamdır, onay veriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970401
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970401,
					"content": "Tamam o zaman! Artık bu hatıra haritası senin olduğuna göre istediğin kadar farklı lezzette bıyık çizmekte özgürsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970402
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970402,
					"content": "Hehe, çok lezzetli bir harita oldu. Onu gözümüz gibi saklayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970403,
					"content": "Ne güzel! Sizi memnun edebildiysek ne mutlu bize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970404
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970404,
					"content": "Her şey yolunda gidiyor, biraz rahatlayalım artık. İşi düşünmeyin ve parkın keyfini çıkarın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
