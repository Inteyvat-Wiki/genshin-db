			"dialogs": [
				{
					"id": 401970101,
					"content": "Madem işler bu noktaya geldi, o halde bizim de bir tutam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970102
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970102,
					"content": "Tuz mu eklememiz lazım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970103
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970103,
					"content": "Karabiber diyecektim aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970104
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970104,
					"content": "Aa, harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970105
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970105,
					"content": "Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970106,
					"content": "Siz ikiniz yeni bir tatlı menüsünden mi bahsediyorsunuz yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970107,
					"content": "Karabiberle tatlı ne alaka?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970108
					]
				},
				{
					"id": 401970108,
					"content": "Tatlı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970109
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970109,
					"content": "Senaryodan bahsediyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970110
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970110,
					"content": "Ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970111
					]
				},
				{
					"id": 401970111,
					"content": "Sevgili ortağım, fotoğrafçım, çaylak yönetmenim... Yaratıcılığımız, hayranlarımızın giderek artan coşkusuna ayak uydurmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970112
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970112,
					"content": "Benim senaryomda sıkıcılığa yer yok! Olay örgüleri, izleyicilerde karabiber etkisi yaratarak onları hazırlıksız yakalamalı ve hapşırtmalı. HAPŞUU!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970113
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970113,
					"content": "Aynı mantık mutfakta da geçerli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970114
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970114,
					"content": "Bir keresinde Bayan Emilie'nin parfümlerin içinde karabiber kullanılabileceğinden bahsettiğini duymuştum. Belki bu yöntemi tatlılarda da deneyebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970115
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970115,
					"content": "Hımm... Kremanın o hafif tatlılığına biberin keskinliğini eklesek nasıl olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970116,
					"content": "Vay be, bu ikisi ne de güzel anlaşıyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970117,
					"content": "Gerçi Paimon karabiberli bir pasta hayal edemedi pek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970118,
					"content": "Hımm, burada ne varmış bakalım? Escoffier yeni bir pasta mı yapıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970119
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970119,
					"content": "Evet, yeni fikirler de geliştiriyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970120
					]
				},
				{
					"id": 401970120,
					"content": "Ne kadar heyecanlı! Hazır olduğunda bana da haber verin, denemek isterim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970121
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970121,
					"content": "Paimon'a mı öyle geliyor yoksa herkes işini bitirince daha mı bir keyiflendi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970122,
					"content": "E normal değil mi? Sıkı çalışmanın meyveleri toplanınca... Kutlama yapmayalım da ne yapalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970123
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970123,
					"content": "Tıpkı taze makaronlar gibi. Fazla tatlı olacak diye korkup istediğin malzemeyi koymaktan geri durmamalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970124
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970124,
					"content": "Sonuçta makaron yapıyorsan şekerden kısmak olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970125
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970125,
					"content": "Şekerden kısmak yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970126
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970126,
					"content": "Şekerden kısmak yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970127
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970127,
					"content": "... İyi de şekerden niye kısmıyoruz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970128
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970128,
					"content": "Lepine-Pauline, geldin demek! Hazır mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970129
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970129,
					"content": "Tabii ki! Plan tıkır tıkır işliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970130
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970130,
					"content": "Ha? Önemli bir göreve falan mı çıkmıştın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970131,
					"content": "Evet! Lütfen bunu kabul edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970132
					],
					"speakerTitle": "Lepine-Pauline"
				},
				{
					"id": 401970132,
					"content": "Bu ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401970133
					]
				},
				{
					"id": 401970133,
					"content": "Vay canına! Eğlence parkının panoramik bir manzarası, üzerinde de herkesin çizimleri var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401970134,
					"content": "Hehe, Fantastik Film Diyarı büyük başarı elde etti, biz de anı olsun diye eşsiz bir hatıra eşyası tasarlamaya karar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970135
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970135,
					"content": "Bu parkı hep birlikte inşa ettik. Dolayısıyla bu haritayı da birlikte çizmek istedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970136
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 401970136,
					"content": "Açıkçası büyük kısmını Bayan Lepine-Pauline halletti. Malum, kendisi çizim konusunda uzman. Ama biz de kendi imzamızı bıraktık bir şekilde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970137
					],
					"speakerTitle": "Escoffier"
				},
				{
					"id": 401970137,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970138
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970138,
					"content": "#Bu arada sana çok özel bir ayrıcalık tanıyacağım {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401970139
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 401970139,
					"content": "Portreme bıyık ekleyeceksin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				}
			]
		},
