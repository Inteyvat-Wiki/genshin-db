			"dialogs": [
				{
					"id": 741210701,
					"content": "... Ne? Amaçları beni öldürmek değil miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210702
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210702,
					"content": "*iç çeker* Siz gerçekten çok dikkatlisiniz. Doğru, makinayı bozan bendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210703
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210703,
					"content": "Tamam da makinayı niye bozdun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210704,
					"content": "Hıh, çünkü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210705
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210705,
					"content": "Uzun zaman önce çok fakir ve perişan bir hayat sürüyordum. Gerçek manada depresyondaydım. Sonra bir gün biriyle tanıştım ve bana keyfimi yerine getiren sağlıklı bir içecek verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210706
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210706,
					"content": "Bana karşı oldukça iyiydi. Ben de iyiliklerine karşılık bir şeyler yapmak istedim. Bir gün, beklediğim fırsat elime geçti. Beni çok zengin kişilerle tanıştırdı ve onlara yardımcı olmamı istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210707
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210707,
					"content": "Yaptığım tek şey, Fontaine Araştırma Enstitüsü için mekanik parçalar toplamak gibi ufak tefek işlerdi. Bu işlerin karşılığında zenginler bana çok güzel para ödüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210708
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210708,
					"content": "Vay canına, harika bir şeye benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210709,
					"content": "Değil mi? Bu sefer ise bu tuhaf makinayı bulmamı, çekirdeğini çıkarmamı ve kendilerine ulaştırmamı istediler. Bu şekilde hem kardeşime olan borcumu ödeyeceğim hem de elimde biraz para kalacak. Tüm dikkatimi bu işe vermeliyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210710
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210710,
					"content": "Ama o kötü insanlar... Hayatımı daha iyi yönde değiştirmek için o kadar çabaladığımı görmekten nefret ediyorlardı. İşime karıştılar ve şeyleri... Iıı, hassas parçaları patronlarıma götürmemem konusunda beni uyardılar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210711
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210711,
					"content": "Ama onların dediği olamazdı! İşi aldım ve onlara da karşı geldim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210712
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210712,
					"content": "Sonuç olarak ise sizin de dediğiniz gibi dersimi aldım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210713
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210713,
					"content": "Ah... Yazık sana... Bu işin gerçekten de çok kazandırıyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210714
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210714,
					"content": "Tabii. Onlara neden karşı geldiğimi daha önce size anlatmama sebeplerimden biri de bu zaten. Ama siz benim hayatımı kurtardınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210715
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210715,
					"content": "Hayatını kurtarmak gibi demeyelim de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210716
					]
				},
				{
					"id": 741210716,
					"content": "... Ayrıca gerçekten çok dikkatli olduğunuz için size doğruları anlatabileceğimi düşündüm. Bunu bir nevi iş birliği olarak da görebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210717
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210717,
					"content": "Bu tuhaf makinalardan suyun altında da yerde de var ve onları bulması çok kolay. Etraflarına garip bir ışık yayıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210718
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210718,
					"content": "Şunu halledin de içindeki o çekirdeği bana getirin. Toplamda <color=#00E1FFFF>yedi</color> tane olmalı. Getirdiklerini yarı yarıya paylaşırız, ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210719,
						741210721,
						741210722
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210719,
					"content": "Güzel plan.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210720
					]
				},
				{
					"id": 741210720,
					"content": "Hımm, iyi de bu makinalar ne işe yarıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210725,
					"content": "Çevreye zarar veriyorlar. Bu makinalar tam bir şeytan işi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210726
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210726,
					"content": "Nasıl zarar veriyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210727,
					"content": "Ben nereden bileyim? Fontaine Araştırma Enstitüsünden biri değilim ki. Daha şimdiden sorunlar çıkmaya başladı, yani çevreye zararlı olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210728
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210728,
					"content": "Şey... Mantıklı geldi. Maceramız boyunca ne zaman doğa üstü bir şeyle karşılaşsak başımıza hep türlü türlü sıkıntılar geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210729
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210729,
					"content": "#{NICKNAME}, neden Henri'ye yardım etmiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210730
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210730,
					"content": "Haha, harika! Anlaştık o zaman! <color=#00E1FFFF>Bana yedi çekirdeği getirin</color>, hep birlikte zengin olalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210721,
					"content": "Bu makinalar ne işe yarıyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210725
					]
				},
				{
					"id": 741210722,
					"content": "Kazancın %70'ini alırım ve %20'lik kısmını da önden peşin alırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210723
					]
				},
				{
					"id": 741210723,
					"content": "Of, tamam. Ancak gerçekten önden ödeme yapamam. Ben de ödeme alabilmek için her şeyin tamamlanmasını bekliyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210724
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210724,
					"content": "Hımm, iyi de bu makinalar ne işe yarıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210725
					],
					"speakerTitle": "Paimon"
				}
			]
		},
