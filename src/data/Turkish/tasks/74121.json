			"dialogs": [
				{
					"id": 741210601,
					"content": "Hıh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210602
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210602,
					"content": "*iç çeker* Ben hiçbir şey yapm... Bu en yeni güzellik modası...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210603
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210603,
					"content": "Aahh! Siz ne zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210604,
					"content": "Biz yürüyüş yapıyoruz. Yürüyüş yapmak... Bir çeşit egzersizdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210605
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210605,
					"content": "Egzersizde hareketler vardır. Buraya da hareketler sayesinde geldik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210606
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210606,
					"content": "Bunu siz mi yaptınız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210607
					]
				},
				{
					"id": 741210607,
					"content": "Peki ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210608
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210608,
					"content": "Ah Avcı, şimdi hatırladım. Ona dikkatlice bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210609
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210609,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210610
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210610,
					"content": "Asla bulaşmamamızı söylediği kişi oymuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210611
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210611,
					"content": "Doğru, doğru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210612
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210612,
					"content": "Ne fısıldaşıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210613
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210613,
					"content": "Hiçbir şey. Sadece yürüyüş yapıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210614
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210614,
					"content": "Doğru. Biz sadece yürüyüş yapıyoruz. Başka bir şey yoksa biz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210615
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210615,
					"content": "Yürümeye devam edelim ve başka yerlere gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210616
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210616,
					"content": "Bir saniye, bana korkunç herhangi bir şey yapmayacak mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210617
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210617,
					"content": "Dersini aldın zaten sen, tabii demek istediğimi anladıysan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210618
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210618,
					"content": "Ne dersi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210619
					]
				},
				{
					"id": 741210619,
					"content": "Hiçbir şey. Yani kızarmış tavuk tehlikelidir, beraberinde belaları da getirir. Bundan iyi bir ders alabilirsin. Hadi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210620
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210620,
					"content": "Ama kızarmış tavuk... Debord...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210621
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210621,
					"content": "Kızarmış tavuğu unut! Yolumuza devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210622
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210622,
					"content": "\"Sonny'den bir dahakine bize kızarmış tavuk yapmasını isteriz.\"\\nDedi Turner, Avcı ile birlikte yürürken.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741210623
					]
				},
				{
					"id": 741210623,
					"content": "Teşekkürler, çok sağ olun! Ne demek istediğimi anlayacağınızı biliyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210624
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210624,
					"content": "#Görünüşe göre {NICKNAME} haklı çıktı... Hadi Henri'ye yardım edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210625
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210625,
					"content": "Ama seni oradan kazıyarak çıkarmak epey yorucu olacak! Bu yüzden Paimon karşılığında kızarmış tavuk istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210626
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210626,
					"content": "Ne? Of... Tamam, olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210627
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210627,
					"content": "Kumun içinden Henri'yi ve varili çıkartmak biraz zaman alır.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741210628
					]
				},
				{
					"id": 741210628,
					"content": "Paimon'la birlikte lezzetli kızarmış tavuğun keyfini çıkarırsınız.\\nHenri'nin ağzı sulanacak gibi olur ama sözünü tutmak ve itibarını korumak için geri çekilir.\\nAncak, Henri'nin kendini çok kastığını fark eden Paimon, tavuğu onunla paylaşmayı teklif eder.\\nTavuğun dışı çıtır çıtır olmuştur ve etrafı karşı konulamayacak derecede bir yağlı lezzet kokusu sarmıştır... Mmm enfes!",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
