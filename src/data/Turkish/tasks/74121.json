			"dialogs": [
				{
					"id": 741210101,
					"content": "Teşekkürler! Teşekkürler! Çok sağ olun! Siz benim kurtarıcımsınız! Bu Henri yaptığınız iyiliği asla unutmayacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210102
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210102,
					"content": "Daha önemli bir konuya değinelim, Paimon buraya nasıl geldiğini merak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210103,
					"content": "*iç çeker* O yengeçler buraya kızarmış tavuk kokusu yüzünden gelmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210104
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210104,
					"content": "Paimon da buraya o yüzden geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210105,
					"content": "Hayır, ikisi farklı. O yengeçler, başlangıç yemeği olarak kızarmış tavukla ben arasında bir seçim yapacaklardı. \"Taze bir aperitif\" ile başlamayı seçseler ne olurdu düşünmek bile tüylerimi diken diken ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210106,
						741210109
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210106,
					"content": "Mantıklı ama. Ne kadar taze o kadar lezzetli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210107
					]
				},
				{
					"id": 741210107,
					"content": "Hey! Paimon Henri'yi sordu, yengeçleri değil! Ondan başka kim kuma gömülmüş olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210108,
					"content": "Yani, yardım mı lazım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210111,
					"content": "Elbette...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210112
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210112,
					"content": "Ah... Hayır, hayır! Bana yardım etmeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210113
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210113,
					"content": "#Aaah tamam, tamam! Seni gayet iyi duyduk! Hadi gidelim {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210114,
					"content": "Hayır durun, bekleyin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210115
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210115,
					"content": "Hah? Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210116,
					"content": "Ben... Şey... *öhöm* Aslında şöyle. Lütfen beni dikkatle dinleyin. Bu yepyeni bir güzellik modası!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210117
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210117,
					"content": "Bağırmana gerek yok! Paimon'un kulağı sağır olacaktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210118,
					"content": "Merak etme! Ben son derece aklı başında biriyim! Hem bilimsel hem de sağlıklı olan bir güzellik uygulaması yöntemi kullanıyorum! Bu yüzden kendi ellerimle kendimi bu nemli kumlara gömdüm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210119
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210119,
					"content": "Lütfen çekil! Güneşimi engelleme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210120
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210120,
					"content": "Ah... Gidelim mi o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210121,
					"content": "Ne kadar da meraklısınız! Bana bu cilt bakım sihrini anlatmaktan başka bir seçenek bırakmıyorsunuz! Iıı, kumdaki solucanlar şeyi temizlemede...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210122
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210122,
					"content": "#(Of, sesi ne kadar yüksek. {NICKNAME}, bu adamın nesi var böyle? Paimon onun dediği hiçbir şeyi anlayamıyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210123,
					"content": "(Bu cidden çok tuhaf.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210124
					]
				},
				{
					"id": 741210124,
					"content": "(Öyle mi? Sen ne düşünüyorsun?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210125,
					"content": "(İlk önce etrafı bir kontrol edelim.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210126
					]
				},
				{
					"id": 741210126,
					"content": "Ne? Gidiyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210127
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210127,
					"content": "Evet, bir etrafa bakacağız, sonra geri geleceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210128,
					"content": "Pekala! Gidin bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210109,
					"content": "Neden kuma gömülü olduğunu daha çok merak ediyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210110
					]
				},
				{
					"id": 741210110,
					"content": "Evet, yardım mı lazım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
