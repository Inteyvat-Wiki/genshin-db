				},
				{
					"id": 741210303,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210304
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210304,
					"content": "Hey! Paimon'u bu tuhaf sessizlik içerisinde tek başına bırakma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210305,
					"content": "... Merhaba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210306
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210306,
					"content": "Ne kadar da güzel bir gün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210307
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210307,
					"content": "Oradaki kişi hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210308
					]
				},
				{
					"id": 741210308,
					"content": "Hangi kişi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210309
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210309,
					"content": "Kimin hakkında konuştuğunu anlamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210310
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210310,
					"content": "Biz sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210311
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210311,
					"content": "Yürüyüşe çıkmıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210312
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210312,
					"content": "Evet, doğru. Sadece yürüyüşe çıkmıştık. Hani bildiğin yürüyüş, iki sıradan insanın yaptığı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210313
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210313,
					"content": "Ne kadar güzel bir gün ve yürümek de ne güzel bir şey! Sence de öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210314
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210314,
					"content": "Yürüyüş yapmak çok normal bir şey. Anlayacağınızı düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210315
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210315,
					"content": "Ah... Siz neden bahsediyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210316,
					"content": "Yardım isteyen birini duydunuz mu? Orada birisi kuma gömülmüş ve yengeçler neredeyse onu yemek üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210317,
					"content": "Ne? Yürüdüğümüz yerde falan mı olmuş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210318
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210318,
					"content": "Böyle güzel bir günde hem de?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210319
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210319,
					"content": "Hadi yengeçler onu yerse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210320
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210320,
					"content": "Gerçekten çok komik olur. Yani şey, yazık olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210321
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210321,
					"content": "Hayır, böyle bir şeye izin vermeyeceğiz. Yani, veremeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210322
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210322,
					"content": "Yürüyüş yaparken böyle bir şeyle karşılaşsaydık bu duruma asla seyirci kalmazdık. Yani olur da karşılaşırsak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210323
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210323,
					"content": "Burada ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210324
					]
				},
				{
					"id": 741210324,
					"content": "Yürüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210325
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210325,
					"content": "Yürüyoruz dedik ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210326
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210326,
					"content": "Hiç tuhaf bir şeyle karşılaşmadınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210327,
					"content": "Hayır, karşılaşmadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210328
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210328,
					"content": "Evet, sizin yürüyüşümüze karışmanız dışında tuhaf hiçbir şeyle karşılaşmadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210329
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210329,
					"content": "Yürümek... Gayet kişisel bir şey. Başkalarının bizi rahatsız etmesinden hoşlanmıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210330
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210330,
					"content": "Yürümek için iyi bir yer bulsanız daha iyi olur. Lucine Çeşmesi mesela, gayet iyi bir yerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210331
					],
					"speakerTitle": "Turner"
				},
				{
					"id": 741210331,
					"content": "Ancak burası bizim yürüyüş yaptığımız, yani doğayla iç içe olduğumuz yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210332
					],
					"speakerTitle": "Avcı"
				},
				{
					"id": 741210332,
					"content": "Bu yüzden rahatsız edilmek istemiyoruz. Güle güle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Turner"
				}
			]
		},
