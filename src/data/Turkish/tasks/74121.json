					}
				]
			},
			"dialogs": [
				{
					"id": 741210801,
					"content": "Özgürlük! Ahh, özgürlüğün o enfes tadı! Her ne kadar bir kızarmış tavuk kadar lezzeti olmasa da özgürlüğün tadı da gayet iyidir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210802
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210802,
					"content": "... Pekala, elindeki tabela ne işe yarıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210803,
					"content": "Hımm? Ah, bu mu? Protesto anlamına geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210804
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210804,
					"content": "Neye karşı protesto?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210805
					]
				},
				{
					"id": 741210805,
					"content": "Hımm... Nasıl anlatsam? O-Onları, yani beni gömen kişileri. Beni gömdüler çünkü benim çok çalışmamı istemediler. Ben de bu yüzden onları protesto etmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210806
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210806,
					"content": "İyi de senin neden çok çalışmanı istemesinler ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210807,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210808
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210808,
					"content": "Sır tutabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210809
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210809,
					"content": "Tabii ki! Paimon ser verir sır vermez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210810,
					"content": "Aynı şekilde benim de ağzım çok sıkıdır. O yüzden kusura bakma, sana anlatamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210811
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210811,
					"content": "Hey! Paimon'la kafa mı buluyorsun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210812,
					"content": "Başka şeylerden konuşalım o zaman...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210813
					]
				},
				{
					"id": 741210813,
					"content": "Tamam... O içine girdiğin varil de neyin nesiydi? Bir çeşit protesto falan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210814,
					"content": "Ne? Bilmiyorum... Beni oraya gömmeden önce varilin içine koydular. İyice kafayı yemişler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210815
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210815,
					"content": "Seni niye gömdüler ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741210816,
					"content": "Çünkü onlar kötü insanlar, bildiğiniz kötüler! Hiçbir sebep yokken beni tuttular ve kuma gömdüler! Amaçları beni öldürmekti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210817
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210817,
					"content": "Hiçbir sebep yokken mi? Gerçekten mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741210818
					]
				},
				{
					"id": 741210818,
					"content": "Ay-Aynen öyle! Görmedin mi? Beni bildiğin kuma gömdüler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210819
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210819,
					"content": "Amaçları beni öldürmek değilse neden öyle bir şey yapsınlar o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741210820
					],
					"speakerTitle": "Henri"
				},
				{
					"id": 741210820,
					"content": "#Hımm... Mantıklı gibi. {NICKNAME}, sen ne düşünüyorsun bu konuda?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
