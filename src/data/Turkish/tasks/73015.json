						730150904
					]
				},
				{
					"id": 730150904,
					"content": "Paimon da öyle düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150907,
					"content": "Hımm... Bu Taş Hatırası mı şimdi? Aranaraların yaptığı bir taş abideye benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150908
					],
					"speakerTitle": "Paimon"
