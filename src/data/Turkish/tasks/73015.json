			"dialogs": [
				{
					"id": 730152101,
					"content": "Aranaralar çok küçük olduğu için, kendilerinin birkaç katı büyüklüğündeki Mantarlardan korkmaları normal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730152102,
					"content": "Paimon korkmuyor mu yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152103
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730152103,
					"content": "Elbette hayır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730152104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730152104,
					"content": "*ağlar* Aranakula kesinlikle Paimon'dan güçlü ama onun kadar cesur değil. Aranakula, Mantarların saldırısına uğradığında hep <color=#00E1FFFF>güvenli bir yere</color> saklanır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		}
