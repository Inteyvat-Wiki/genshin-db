				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730150301,
					"content": "Sen Aranakula olmalısın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150302,
					"content": "Ahh! O Nara Aranakula'yı fark etti! Aranakula ne yapacak şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150303
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150303,
					"content": "Kaçmana gerek yok! Arapandu, senin burada olacağını söyledi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150304,
					"content": "Ah... A-Arapandu gönderdiyse sen iyi bir Nara olmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150305
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150305,
					"content": "#Hımm, bize hemencecik güvendin mi Aranakula? Ya {NICKNAME} kötü bir Naraysa ve Arapandu'nun ismini vererek seni kandırmaya çalışıyorsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150306,
					"content": "Ne? Y-Yani Altın Nara Aranakula'yı kandırıyor mu? Altın Nara kötü bir Nara mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150307
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150307,
					"content": "Hayır, değil... Üff, Paimon kendini kötü hissetti şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150308,
					"content": "Sen Paimon'a kulak asma. Ben iyi bir Narayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150309
					]
				},
				{
					"id": 730150309,
					"content": "#O zaman Altın Nara gerçekten de iyi bir Nara. Bu harika bir haber! Aramuhukunda'ya şükürler olsun! Nara {NICKNAME} Aranakula'dan çok daha uzun ama Aranakula ondan hiç korkmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150310
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150310,
					"content": "Paimon... Paimon küçük, o yüzden Aranakula ondan da korkmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150311
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150311,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150312,
						730150314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150312,
					"content": "Paimon gerçekten de epey küçük sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150313
					]
				},
				{
					"id": 730150313,
					"content": "Paimon'a tepeden bakarsan gününü görürsün ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150316,
					"content": "Neyse işimize dönelim, buraya Varuna Mekanizmasını tamir etmeye geldik. Vana'nın bu kısmında Varuna Mekanizmasının dallarıyla yapraklarının olması gerekmiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150317,
					"content": "Belki hesapta olmayan bir sorun yaşarsın diye, Arapandu bizden buraya gelmemizi istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150318,
					"content": "Ah! Vana'da çok fazla kötü adam var... Güvenli bir yol var ama yine de dikkatli olmalıyız. Ayrıca her yer kötü sporlarla dolu. Nara Varuna bile... *ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150319
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150319,
					"content": "#Nara {NICKNAME} uzun ve büyük, belki Arabalika kadar da güçlü... Kim bilir Nara {NICKNAME} bir yolunu bulup...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150320
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150320,
					"content": "#... Belki Nara {NICKNAME} yardım edebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150321
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150321,
					"content": "#Zaten biz de yardım etmeye geldik, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150322,
					"content": "Bu işi oldu bil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150323
					]
				},
				{
					"id": 730150323,
					"content": "Aranakula'nın bir ricası daha olacak. Varuna Mekanizmasını tamir etmeden önce, Taş Hatırasını bulması için lütfen Aranakula'ya yardım edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150324
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150324,
					"content": "Taş Hatırası derken?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150325
					]
				},
				{
					"id": 730150325,
					"content": "Vana asla unutmaz. Aranaralar da asla unutmaz. Aranaralar, diğerlerinin görebilmesi için arkalarında hatıralar bırakır. Kötü adamlar geldiğinden bu yana, her yerde kötü tohumlar var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150326
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150326,
					"content": "Aranaralar hep bilmece gibi konuşuyor... Paimon, bahsedilen şeyi görünce anlayacağımızı düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150327,
					"content": "Yine de oraya Aranakula ile birlikte gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150328
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150328,
					"content": "İyi Nara! İyi Paimon! Kötü adamların dikkatini çekmeyelim. Güvenli yoldan gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150329
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150329,
					"content": "Ne? Kötü adamlar mı? Mantarlardan mı bahsediyorsun? Öyleyse hiç dert etme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150330
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150330,
					"content": "#Hehe! Duy bunları Aranakula, Nara {NICKNAME} çok güçlüdür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150331,
					"content": "\"Çok güçlü\" değil, \"çok ama ÇOK güçlü\"!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150332
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150332,
					"content": "Arapandu'yla birlikte bir sürü Mantarı yendik zaten! Arapandu bile bizim gücümüzün farkında!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150333,
					"content": "#Aranakula anlıyor. Nara {NICKNAME}, Arabalika kadar güçlü olmalı. Peki ya Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150334
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150334,
					"content": "Paimon mu? Ne olmuş Paimon'a?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150335,
					"content": "Bir keresinde kötü adamlardan biri Aranakula'yı kovalamıştı. Aranakula toprağa saklanmıştı fakat sonra kötü adam onu topraktan çıkardı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150336
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150336,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150337,
					"content": "Kötü adamın ağzından bir şey aktı. Islak ve sıcaktı, üstelik çürük meyve gibi kokuyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150338
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150338,
					"content": "Vay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150339
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150339,
					"content": "Arabalika zamanında yetişmeseydi, Aranakula belki de çoktan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150340
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150340,
					"content": "Eyvah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150341
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150341,
					"content": "Arapandu uzun süre Aranakula'ya bu konuda söylendi. Güneş battı ve tekrar doğdu. Bahçedeki tohumlar bile filizlendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150342
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150342,
					"content": "Bu çok uzun bir süre ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150343
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150343,
					"content": "Bu konunun Paimon ile ne alakası var şimdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150344
					]
				},
				{
					"id": 730150344,
					"content": "Doğru ya, Paimon da anlamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150345,
					"content": "Aranakula, Paimon'dan daha güçlü ama kötü bir adam onu neredeyse yiyecekti. Paimon çok küçük... Etraf çok tehlikeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150346
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150346,
					"content": "#Mantıklı aslında... Bir saniye! Sen güçlüsün {NICKNAME}. Paimon'u koruyacaksın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150347,
						730150349
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150347,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150348
					]
				},
				{
					"id": 730150348,
					"content": "#Hehe, zaten {NICKNAME} ile Paimon çok yakın arkadaşlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150351,
					"content": "Fakat çok fazla kötü adam var. Aranakula hepsini yenemez... Hımm... Altın Nara güçlü ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150352
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150352,
					"content": "Aranakula güvenli bir yol biliyor. Güvenli yolu kullanalım, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150353
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150353,
					"content": "Hımm. Aranakula, sen Mantarlardan çok mu korkuyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150354
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150354,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150355
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150355,
					"content": "Hehe! Nasıl da bildim ama! Paimon'u bahane olarak kullanman hiç hoş değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150356
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150356,
					"content": "#O zaman Aranakula'yla birlikte güvenli yoldan gidelim {NICKNAME}. Mantarların dikkatini çekmemeye çalışırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150357
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150357,
					"content": "Bu işte oldukça iyiyimdir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150358
					]
				},
				{
					"id": 730150358,
					"content": "Evet, sanki bu konuda ustalaşmışız gibi hissettim ben de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150359
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150359,
					"content": "Yaşasın! O zaman Aranakula Narayı güvenli yoldan götürecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150349,
					"content": "En kötü ihtimalle bizi bırakıp kaçarsın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150350
					]
				},
				{
					"id": 730150350,
					"content": "#Paimon, asla kaçıp da sizi arkada bırakmaz {NICKNAME}! Paimon yapmaz... Paimon yapmaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730150314,
					"content": "Küçük Paimon, büyük enerji.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150315
					]
				},
				{
					"id": 730150315,
					"content": "Doğru bildin! Paimon çok güçlüdür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "Paimon"
				}
			]
		},
