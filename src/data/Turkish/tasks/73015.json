			"trigger": {
				"objectNames": [
					"Paimon",
					"Aranakula"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151601,
					"content": "Aranakula, biz geldik! Buradan sonrası artık sana kalmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151602,
					"content": "#Teşekkürler Paimon, teşekkürler Nara {NICKNAME}. Aranakula gerisini halleder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151603
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151603,
					"content": "Ah! Burada da her şey yoluna girecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151604,
					"content": "Umarım orman en yakın zamanda normale döner.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151605
					]
				},
				{
					"id": 730151605,
					"content": "Varuna Mekanizması tamir edilince normale dönecek ama Vana ve Sarva için Marananın yok edilmesi lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151606
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151606,
					"content": "Kötü tohumlar Nara Varuna için yapılan abidenin etrafını kaplamıştı ya hani... İşte Ashvattha'nın Salonları da Marana yüzünden kötü etkilendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151607
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151607,
					"content": "O zamanlar Nara Varuna Vanarana'ya gelmemişti daha. Naralarla Aranaralar hep birlikte bir fidelik yapmıştı. Fakat şimdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151608
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151608,
					"content": "Şimdi seni bir tek Vimara Köyü'nün çocukları görebiliyor. Yetişkinler için hikayelerden ibaretsin... Bahsettiğin fidelikler de Marana yüzünden mahvoldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151609,
					"content": "Aranakula o fideliği çiçeklerle donatmak istiyor. Naralar, Aranaraları unuttu ama sorun değil. Çünkü Naralar o çiçekleri görecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151610
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151610,
					"content": "Aranakula...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151611
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151611,
					"content": "#Nara {NICKNAME}, Paimon, sağ olun. Aranakula asla unutmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151612
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151612,
					"content": "Aranakula artık \"dinlenme noktasına\" dönecek. Arapandu, abidenin temizlendiğini duyunca sevinecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151613
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151613,
					"content": "#Nara {NICKNAME} ve Paimon da Aranakula ile birlikte \"dinlenme noktasına\" gelecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151614,
						730151616
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151614,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151615
					]
				},
				{
					"id": 730151615,
					"content": "Altın Narayla birlikte seyahat etmek çok güvende hissettiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151616,
					"content": "Yapacak başka bir işim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151617
					]
				},
				{
					"id": 730151617,
					"content": "#Aramuhukunda, Nara {NICKNAME} ve Paimon'u korusun. Kötü adamlara yem olmayın sakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				}
			]
		},
