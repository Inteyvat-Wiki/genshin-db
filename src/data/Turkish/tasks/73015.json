					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730151101,
					"content": "#Ah! Sağ ol Nara {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151102
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151102,
					"content": "Vana, Nara Varuna geldikten sonra yaşanan her şeyi hatırlıyor. Büyük ağaçlar hatırlıyor, tohumlar hatırlıyor ama Nara Varuna bunun anlayacak mı bilmiyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151103
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151103,
					"content": "O yüzden görünür hatıralar bıraktık. Böylece Nara Varuna döndüğü zaman Vana'nın da Aranaraların da yaşananları unutmadığını görecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151104,
					"content": "Paimon anladı... Taş Hatırası aslında bir anı levhası. Sonuçta insanlar da unutmamak için abide gibi şeyler dikiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151105,
					"content": "Naralar unutkan varlıklar da o yüzden.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151106
					]
				},
				{
					"id": 730151106,
					"content": "Orman yaşamıyla kıyaslayacak olursak Naralar asla kocaman ağaçlara dönüşmeyecek küçük fidelere benzer. Her şeyi hatırlayan yaş halkaları da asla olmayacaktır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151107,
					"content": "Aranaralar Vana'yı terk etmeyecek. Aranaralar her zaman Vana'da kalacak. Fakat Naralar geçicidir, tıpkı Nara Varuna gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151108
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151108,
					"content": "Bir sürü Aranara vardır, tıpkı Vana'da bir sürü büyük ağaç olduğu gibi. Aranaraların bir sürü ismi vardır, tıpkı büyük ağaçların bir sürü dalı olduğu gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151109
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151109,
					"content": "Altın Nara bir sürü Aranara ismi hatırlıyor, benim de Aranakula olduğumu unutmuyor. Sanki yerden rastgele bir yaprak alıp da hangi ağaçtan düştüğünü bilmek gibi bir şey bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151110
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151110,
					"content": "Nara Varuna da Aranaralar için özel bir Naraymış demek ki. O yüzden onun için abide dikmişler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151111,
					"content": "Aynı şey değil ama üzerine yüzlerin özenle kazındığı heykeller de gördük, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151112,
					"content": "Yedilerin Heykellerinden mi bahsediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151113
					]
				},
				{
					"id": 730151113,
					"content": "#Evet! Nara Varuna'nın hikayesini dinledikten sonra dış görünüşünü merak etmiyor musun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151114,
					"content": "Aranaralar müzik konusunda becerikli, belki başka konularda da yeteneklidirler! Belki oldukça gerçekçi heykeller falan da yapabiliyorlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151115,
						730151117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151115,
					"content": "Öyle bir şey varsa görmek isterim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151116
					]
				},
				{
					"id": 730151116,
					"content": "Ben de! Hehe, Nara Varuna, bir Altın Nara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151119,
					"content": "Ah, doğru ya! Artık Varuna Mekanizmasının dallarını ve yapraklarını iyileştirmeye gidebiliriz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730151120,
					"content": "#Evet. Aranakula Nara {NICKNAME} ile Paimon'u oraya götürecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730151117,
					"content": "Aranaraların sanatı oldukça basit. O yüzden akılda canlandırması biraz zor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151118
					]
				},
				{
					"id": 730151118,
					"content": "Hımm... Belki de onların sanatı senin için fazla gelişmiştir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151119
					],
					"speakerTitle": "Paimon"
				}
			]
