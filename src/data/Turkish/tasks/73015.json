					"content": "#Nara {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150909
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730150909,
					"content": "Kötü tohumları temizleyeyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150910
					]
				},
				{
					"id": 730150910,
					"content": "#Sorun değil Aranakula! Nara {NICKNAME} yapar o işi. Bir çırpıda hallediverir şimdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
