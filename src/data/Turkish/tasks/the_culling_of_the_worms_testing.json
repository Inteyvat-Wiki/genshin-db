			"dialogs": [
				{
					"id": 735140101,
					"content": "Ucuz yırttık... Solucanlar bile planımızı bozmaya çalışıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140102
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140102,
					"content": "Hey! Eğer ateşlemeyi devre dışı bırakmamış olsaydık onu öldürebilirdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140103,
					"content": "Solucan kaçtı gitti, şimdi onu gafil avlamak için en azından bir gün daha beklememiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140104
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140104,
					"content": "En ufak ayrıntısına kadar konuşup yarın yine boş verelim demeyeceksin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140105
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140105,
					"content": "Çevresel koşullar ne olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140106
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140106,
					"content": "Hepsini test ettim, yükleme hızı hesaplanan değerden biraz düşük olsa da kullanımı etkilemiyor, güvenlik riski de oluşturmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140107
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140107,
					"content": "Shriya, harekete geçmeden önce her şeyi düşünüp analiz etmek istediğini biliyorum, ancak işler her zaman plana göre ilerlemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140108,
					"content": "Minik ayrıntılarla uğraşmaya devam edersen harekete geçmek için olan fırsatı da kaçırırsın! Dönem ortası tez savunmalarının ertelendiğini hatırlıyor musun? Tereddüt etmek bize bir şey kazandırmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140109
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140109,
					"content": "*iç çeker* Tamam. İşte, ateşleme modülü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140110
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140110,
					"content": "Pekala! Yarın nihayet Solucanezen Topunun gücünü görebileceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140111
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140111,
					"content": "İyice bir incelemek için onları alıp Aaru Köyü'ne götürmek istiyorum. Solucanezen Topunun ilk resmi lansmanına hazır olduğumuzdan emin olmamız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735140112,
					"content": "Ama çevresel koşullarda neden sapma oldu? Solucanları bir anda harekete geçiren ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140113
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140113,
					"content": "#Bu olayı öyle olduğu gibi bırakamayız... Maceracı {M#Bey}{F#Hanım}, yarın tekrar gelebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735140114
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735140114,
					"content": "O zamana kadar doğrudan Solucanlarla yüzleşmemiz lazım ve umarım bazı ipuçları buluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				}
			]
		}
	]
}