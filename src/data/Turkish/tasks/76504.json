			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ineffa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765040101,
					"content": "#Merhaba {NICKNAME}, Paimon. Yemek yediniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040102
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040102,
					"content": "Ineffa? Çatıda ne işin var? Yağmur yağıp yağmayacağını anlamak için bulutları falan mı inceliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040103,
					"content": "Yerine getirdiğim görevle ilgili... Beklenmedik bir sapma yaşanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040104
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040104,
					"content": "Asıl planım, Aino'nun alışveriş listesine eklediği \"hassas dişli\" ile \"özel altıgen vidayı\" almaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040105
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040105,
					"content": "Ancak dönüş yolunda beklenmedik bir... Lojistik engelle karşılaştım. Yüksek hızla uçan bir şahin, elimdeki özel yapım vidayı kapıp kaçtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040106
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040106,
					"content": "O şahini bulmak için mi çatıya çıktın yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040107
					]
				},
				{
					"id": 765040107,
					"content": "Doğru. Bu türün alışkanlıkları arasında çatıları geçici birer durak olarak kullanmak var. Yanıt: Kapsamlı görsel ve işitsel tarama. Amaç: Hedefi tespit etmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040108
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040108,
					"content": "Fakat henüz hedefime dair hiçbir iz bulamadım. İlk varsayım: Hedef tespit menzilinden çıktı ya da \"ödülünü\" daha gizli bir yuvaya götürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040109
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040109,
					"content": "Yedek plan başlatılıyor: Tedarikçiye dön ve aynı modelde yeni bir vida satın al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040110
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040110,
					"content": "Her neyse. Siz de mi buraya küçük bir hayvan bulmaya geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040111,
						765040112
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040111,
					"content": "Yok, hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				},
				{
					"id": 765040113,
					"content": "Evet. Aslında güzel manzarası olan bir yer bulup Nasha Kasabası'nın hareketliliği gösteren panoramik çekimler yapmak istiyorduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040114,
					"content": "Seni bir \"hırsızın\" peşinde koşarken bulmayı beklemiyorduk. Sanırım buna da \"beklenmedik bir sapma\" diyebiliriz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040115,
						765040116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 765040115,
					"content": "Hazır fırsatını yakalamışken...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040117,
					"content": "Tabii. Lütfen tercih ettiğiniz duruş pozunu, bakış yönünü ve yüz ifadesini belirtin. Elimden geldiğince uymaya çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040118
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040118,
					"content": "Tahmin: Çatıya çıkıp sizinle karşılaşmam ve fotoğrafımı çekmenizin ihtimali, şahinin bana vidayı geri getirmesinden daha düşük.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040119
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040119,
					"content": "Bu yüzden lütfen bu nadir görülen \"hoş sürprizi\" fotoğrafta doğru bir şekilde yansıtın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040116,
					"content": "Senin fotoğrafını çekebilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040117
					]
				},
				{
					"id": 765040112,
					"content": "Fotoğraf çekmek için malzeme arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040113
					]
				}
			]
		},
