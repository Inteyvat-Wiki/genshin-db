			"dialogs": [
				{
					"id": 765040701,
					"content": "#Merhaba {NICKNAME}, Paimon. Yemek yediniz mi? Bugün için özel bir planınız var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040702,
						765040703
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040702,
					"content": "Öylesine etrafa bakınıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765040704
					]
				},
				{
					"id": 765040704,
					"content": "Anladım. Etrafta yürüyüp kadraja giren şeyleri çekmek, rahatlamak için iyi bir yöntem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765040705
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040705,
					"content": "Fakat üzerinde bir Kamera tespit edemedim. Evden çıkarken aceleyle unutmuş olabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 765040703,
					"content": "Bir yandan da fotoğraf çekmek için malzeme arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
