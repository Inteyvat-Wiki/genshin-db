			"dialogs": [
				{
					"id": 711149940,
					"content": "Hazine Avcılarını kovduktan sonra, alıkonulan kişileri dinlenmeleri için yakındaki bir konağa götürüyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 711140801,
					"content": "Nasıl teşekkür edeceğimi cidden bilemiyorum... Çok minnettarım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140802
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140802,
					"content": "Bayan Qiu... Sen misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140803
					]
				},
				{
					"id": 711140803,
					"content": "#Ah... {NICKNAME}! Ne hoş bir sürpriz oldu böyle! İkidir bana çok büyük bir iyilik yapıyorsunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140804
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140804,
					"content": "Siz Fontaine'de film çekimi eğitimi almıyor muydunuz? Ne oldu da geri Liyue'ye geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140805,
					"content": "Her şeyi öğrenmiş olamazsınız herhalde, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140806
					]
				},
				{
					"id": 711140806,
					"content": "Yani, aslında evet ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140807
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140807,
					"content": "Öyle demeyelim de, hızlı bir şekilde Mora kazanmamız gerekti diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140808
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140808,
					"content": "Siz ikiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140809
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140809,
					"content": "Bay Geisert gerçekten çok usta bir film yapımcısı, ondan çok yararlı şeyler öğrendik. Ancak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140810
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140810,
					"content": "Onun yardımıyla çektiğimiz filmlerin hepsi büyük fikirlere ve konulara değiniyordu. Asıl olay örgüsü, dünya ve yansıtılmak istenilen olaylar ise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140811
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140811,
					"content": "Bay Geisert'in deyimiyle \"sahnelerin arkasında kaldı\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140812
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140812,
					"content": "Bizim asıl amacımız, Chenyu Vadisi'nin muhteşem çayını ön plana çıkaran bir film çekmekti. Bay Geisert'le devam etseydik hiç yol katedemeyecektik. Biz de bu yüzden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140813
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140813,
					"content": "Biz de bu yüzden radikal bir karar alıp eğitimimize ara verdik ve bir belgesel çekmek için geri geldik. Bu fırsatı iyi değerlendirerek bilgilerimizi pratiğe dökeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140814
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140814,
					"content": "... Ha bir de paramız bitmek üzereydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140815
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140815,
					"content": "H-Hey, sana planımdan bahsetmedim mi ben? Bu belgesel büyük bir ses getirdiğinde yatırdığımız parayı kısa sürede geri alacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140816
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140816,
					"content": "#Derken köprüden geçerken etrafımızı Hazine Avcıları çevirdi. Neyse ki büyük {NICKNAME} bizi kurtardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140817,
						711140818
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140817,
					"content": "Burası... Qiaoying Köyü'nden biraz uzak değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140818,
					"content": "Qiaoying Köyü'nün fotoğrafını çekecekseniz burada ne işiniz var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140819
					]
				},
				{
					"id": 711140819,
					"content": "*iç çeker* Amacım mükemmel manzaralardan bol bol çekip filmi çok daha etkileyici hale getirmekti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140820
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140820,
					"content": "Çekimlere kendimizi biraz fazla kaptırdık ve o sırada Hazine Avcılarının dikkatini çektik. Buraya kadar kaçtık ama yine de onların eline düşmekten kurtulamadık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140821
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140821,
					"content": "Bir dakika, Woliu'nun bahsettiği \"profesyonel fotoğrafçılar\" yoksa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140822
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140822,
					"content": "Evet, Bayan Qiu ile asistanının ta kendileri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140823
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140823,
					"content": "S-Sen de nereden çıktın Bayan Woliu? Seni hiç görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140824
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140824,
					"content": "Çünkü çok iyi saklandım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140825
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140825,
					"content": "Demek tanışıyorsunuz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140826
					]
				},
				{
					"id": 711140826,
					"content": "Bayan Woliu uzman bir su bilimcisidir, hiç kimse bu toprakları ondan daha iyi bilemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140827
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140827,
					"content": "Çekim için en iyi manzaraları nerede buluruz diye ona daha önce birkaç defa danışmıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140828
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140828,
					"content": "Hatta bize katılsın diye çok ısrar ettik ama önce işlerini bitirmesi gerektiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140829
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140829,
					"content": "Patron, şey... Hazine Avcılarından kaçarken sanırım, şey... Filmlerle ve ekipmanlarla dolu kutumuzu orada unutmuşuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140830
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140830,
					"content": "O zaman... Şimdiye kadar çektiğimiz filmlerin hepsi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140831
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140831,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140832
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140832,
					"content": "#Bayan Woliu! {NICKNAME}! Paimon! Her şey için teşekkürler! V-Vaktiniz olduğunda Qiaoying Köyü'ne mutlaka beklerim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140833
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140833,
					"content": "Sonuçta... Bizim hayatımızı kurtardınız, bunun bir karşılığı olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140834
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140834,
					"content": "Şimdi gitmemiz lazım! Hem de hemen! O kutuyu nerede unuttuysak acilen bulmamız gerekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140835
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140835,
					"content": "Bayan Qiu ile asistanı alelacele ayrılır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						711140836
					]
				},
				{
					"id": 711140836,
					"content": "Filmlerin olduğu o kutu... Kim bilir ne badireler atlatmıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140837
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140837,
					"content": "Hani derler ya iyi şeylerin başına gelmedik kalmaz diye, tüm bu olaylardan sonra Bayan Qiu'nun filminin çok büyük ses getireceğine eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140838
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140838,
					"content": "Her neyse, ödülünüzü vereyim ben sizin. Sonuncu cihazı da birazdan yerleştireceğim, sonra... Muhtemelen gidip Bayan Qiu'yu kontrol ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140839
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140839,
					"content": "Yoksa kim bilir yine nereye film çekmeye gider.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140840
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140840,
					"content": "Hımm, gerçi az önce Qiaoying Köyü'nde olacağını söylemişti. Birazdan oraya gidip bir bakayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
