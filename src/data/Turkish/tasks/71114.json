			"dialogs": [
				{
					"id": 711140901,
					"content": "*iç çeker* Sanırım önce Qiaoying Köyü'nün çekimlerini yapmalıydık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140902,
						711140903
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140902,
					"content": "Her şey yolunda mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				},
				{
					"id": 711140904,
					"content": "#{NICKNAME}, Paimon! Sizin sayenizde hem filmlerimizi hem de ekipmanlarımızı kurtardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140905
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140905,
					"content": "Daha sonra o bölgeye tekrar gitmemiz gerekirse yanımıza birkaç maceracı alsak iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140906
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140906,
					"content": "Çay hakkındaki belgeselinizin çekimleri nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140907
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140907,
					"content": "Şey... Şu anda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140908
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140908,
					"content": "Güzel bir başlangıç çekimi yaptık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140909
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140909,
					"content": "Ayrıca çok güzel sanatsal bir vizyon da yakaladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140910
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140910,
					"content": "Yani... Daha en başındasınız, doğru mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140911
					]
				},
				{
					"id": 711140911,
					"content": "İşin gerçeği... Şu sıralar elimiz biraz sıkışık. Usta film yapımcısı Bay Geisert'in eğitim ücreti de hiç ucuz değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140912
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140912,
					"content": "Birkaç tane küçük çaplı film çektik ve oradan biraz Mora kazandık, ancak bu uzunlukta bir film yapmak bütçeyi epey bir sarsıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140913
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140913,
					"content": "Patron da bazı potansiyel sponsorları reddedince üzerine iyice tuz biber oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140914
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140914,
					"content": "Birçok iş birliği davetini de reddetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140915
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140915,
					"content": "Hey, siz ne anlarsınız ki bundan! Onların hepsi, standartlarımızı ve vizyonumuzu yansıtan mükemmel bir film çekmek içindi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140916
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140916,
					"content": "Ama Patron... Biz bu film şirketini para kazanmak için açmadık mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140917
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140917,
					"content": "Şimdi bunları düşünmenin sırası değil! Hemen gidip ekipmanları ayarlayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140918
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140918,
					"content": "#{NICKNAME}, işte ödülün. Desteklerini esirgemediğin için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140919
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140919,
					"content": "Hayallerimdeki filmi yaptığımda galaya seni de davet edeceğim, hatta o zaman sana çay bile ısmarlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140920
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140920,
					"content": "Yifeng, Xingye, çocuklar güneş gidiyor ya! Ne kadar anlayışsızsınız, güneş gidiyor ya güneş! Bu çekimi tek seferde halletmemiz lazım, duydunuz mu beni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140921
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140921,
					"content": "Ama Patron, oyuncularımız burada değil ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140922
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 711140922,
					"content": "Çekimi tek seferde bitirebilmemiz tamamen şansa bağlı değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140923
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 711140923,
					"content": "H-Hadi acele et de ekipmanları kur! Sonra burada bekle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 711140903,
					"content": "Ekipmanlarınıza bir şey olmamış herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				}
			]
		},
