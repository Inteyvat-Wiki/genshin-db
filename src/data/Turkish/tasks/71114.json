						],
						"pointId": 7469
					}
				]
			},
			"dialogs": [
				{
					"id": 711140401,
					"content": "... Böyle ayarlayınca işe yaraması lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140402
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140402,
					"content": "Ah, cihazları yerleştirdiniz mi? Çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140403
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140403,
					"content": "Bunu yerleştireyim de size ödülünüzü vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140404
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140404,
					"content": "Diğer cihazlarla birlikte verseydin ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140405
					]
				},
				{
					"id": 711140405,
					"content": "Nezaketiniz için teşekkürler ama bu cihaz biraz özel. Bazı ek ayarlamalar yapılması ve kalibre edilmesi gerekiyor. Size daha fazla zahmet vermek istemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140406
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140406,
					"content": "Hadi şu uçuruma gidip onu yerleştirelim. Sonra da ödülünüzü vereyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140407
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140407,
					"content": "Çok zor bir işe benziyor... Sen hep böyle mi çalışıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711140408,
					"content": "Haha, neyse ki bu sefer cihazları yere yerleştirmem gerekiyordu. Bir öncekinde, cihazları götürüp azgın bir nehrin ortasına yerleştirmem gerekmişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140409
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140409,
					"content": "Şuradaki teknelerden birini kullansaydın ya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140410
					]
				},
				{
					"id": 711140410,
					"content": "Yapmam gereken tek şey cihazı oraya bırakmak olsaydı, evet tekneye binip oraya gider ve nehrin ortasına cihazı bırakıp geri dönerdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140411
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140411,
					"content": "Ama su akış yoğunluğunu ölçmeye çalışıyordum, o yüzden nehrin tam da ortasında o özel cihazı sabit bir şekilde tutmam lazımdı, hem suyun yüzeyine çıkmaması hem de dibe batmaması gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140412
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140412,
					"content": "Neyse ki o nehrin üzerinde bir asma köprü vardı. Eğer o köprü olmasaydı oradakilerden iki dağın arasına halat germelerini istemek zorunda kalacaktım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140413
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140413,
					"content": "Ondan sonra cihazı halatlardan birine asıp diğer bir halatla onu nehrin ortasına doğru çekip suya bırakmam gerekecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140414
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140414,
					"content": "Neyse... Olmamış şeyi konuşmaya gerek yok. Sonuçta böyle bir şeyle uğraşmayacağız şu anda... Ayrıca, o asma köprüden tekrar geçmemiz gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140415
					],
					"speakerTitle": "Woliu"
				},
				{
					"id": 711140415,
					"content": "Bu taraftan gidelim. Pek uzakta sayılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Woliu"
				}
			]
		},
