				"points": []
			},
			"dialogs": [
				{
					"id": 705290201,
					"content": "Merhaba, Rüzgarçiçeği Festivaline hoş geldiniz. İyi bir zamanda geldiniz, şu anda \"Rüzgarın Şarkıları\" adında küçük bir oyun düzenliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290202
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290202,
					"content": "Bu oyuna katılırsanız tıpkı Mondstadtlı ozanlar gibi güzel şarkılar çalma fırsatınız olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290203,
						705290204
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290203,
					"content": "Ozanlarla nasıl boy ölçüşebilirim ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				},
				{
					"id": 705290205,
					"content": "Endişelenmenize gerek yok! Geçmişte deneyen birçok kişi oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290206
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290206,
					"content": "Hiç enstrüman çalmayı bilmeyen biri bile... Kulağa çok kötü gelmeyen bir şeyler çalabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290207
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290207,
					"content": "Lütfen bana inanın. Favonius Şövalyelerine inanın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290208
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290208,
					"content": "Ritim ve tempoya ayak uydurduğunuz sürece kolaylıkla havaya girebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290209
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290209,
					"content": "Sadece çevrenizdeki rüzgara ve çalmak istediğiniz güzel şarkıya odaklanın, böylece tüm endişeleriniz kaybolacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290210
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290210,
					"content": "O halde sanırım ozanlar oldukça kaygısız olmalılar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290211
					]
				},
				{
					"id": 705290211,
					"content": "Hahaha, ben öyle demezdim! Ne de olsa onlar da şarkılarının insanları Mora alacak kadar etkileyip etkilemeyeceği konusunda endişe ederler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290212
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290212,
					"content": "Size gelince... Siz istediğiniz gibi çalabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290213
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290213,
					"content": "Ş-Şey, az önce dediklerimi boş verin! Artık ne yapmanız gerektiğini anladığınızı sanıyorum, değil mi? İlginizi çektiyse istediğiniz zaman deneyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290214
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290214,
					"content": "Kendi enstrümanınızı kullanarak şarkıları çalabilirsiniz, yanınızda getirmediyseniz size ödünç verebiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290215
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290215,
					"content": "Hehe... Övünmek gibi olmasın ama bizde birkaç tane var. Hatta her biri de birbirinden özel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290216
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290216,
					"content": "Önce hangi enstrümanı kullanmak istersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290217,
						705290218,
						705290219
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290217,
					"content": "Meltem Liri",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290220,
					"content": "Ah, bu mu? Sorun değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290221
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290221,
					"content": "Ah, bahsetmeyi unuttuğum bir şey daha var. Bir dakika, notlarıma bakmam gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290222
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290222,
					"content": "Hımm, doğru ya... Herkesin mümkün olduğu kadar iyi çalabilmesi için bu oyuna bir \"akort\" aşaması eklemeye karar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290223
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290223,
					"content": "Yani enstrümanınızın en iyi durumda olması için onu akort etmenize yardım ediyoruz. Endişelenmeyin, oldukça kolay. İlk adım şöyle olacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290224
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290224,
					"content": "Tamamdır! Bu yeterli sanırım. Enstrümanınızın akordu yapıldı ve notalar da hazır olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290225
					],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290225,
					"content": "İstediğiniz zaman başlayabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lizzie"
				},
				{
					"id": 705290218,
					"content": "Çiçekli Zither",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290219,
					"content": "Şenlik Davulu",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290204,
					"content": "İyi çalabilecek miyim acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				}
			]
		}
	]
}