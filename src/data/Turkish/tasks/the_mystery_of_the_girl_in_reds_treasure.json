			"dialogs": [
				{
					"id": 102010301,
					"content": "Bir zindana açılan bir kapı! Hiçlik Büyücüsü buraya girmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010302,
						102010303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010302,
					"content": "Yani kaçabileceği bir yer yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				},
				{
					"id": 102010304,
					"content": "*nefes nefese kalır* ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010305
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010305,
					"content": "Yoruldun mu Klee?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010306,
					"content": "Biz hazineni senin için geri alırken burada beklemeye ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010307,
					"content": "Hayır! Sizinle geleceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010308
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010308,
					"content": "Pofuduk Bey benim hazinemi çaldı, geri almak da benim işim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010309,
						102010310
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010309,
					"content": "Cesaretini takdir ediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010311,
					"content": "Hi hi hi, merak etmeyin, Klee kocaman kız oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010312
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010312,
					"content": "Hadi gelin Sayın Fahri Şövalye, gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010310,
					"content": "Ama bu zindanlar tehlikeli olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010311
					]
				},
				{
					"id": 102010303,
					"content": "Takibe devam edelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010304
					]
				}
			]
		},
