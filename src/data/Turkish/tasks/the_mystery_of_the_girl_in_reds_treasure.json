			"dialogs": [
				{
					"id": 102010401,
					"content": "Beni takip ettiniz demek. Etkilendiğimi söylemeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010402
					],
					"speakerTitle": "Hiçlik Büyücüsü"
				},
				{
					"id": 102010402,
					"content": "Ama daha ileri gidemeyeceksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010403
					],
					"speakerTitle": "Hiçlik Büyücüsü"
				},
				{
					"id": 102010403,
					"content": "Öyle mi? Ne yapacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010404,
					"content": "Nihahahahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010405
					],
					"speakerTitle": "Hiçlik Büyücüsü"
				},
				{
					"id": 102010405,
					"content": "İnsanların dedikodu merakı sayesinde ihtiyacımız olan her şeyi biliyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010406
					],
					"speakerTitle": "Hiçlik Büyücüsü"
				},
				{
					"id": 102010406,
					"content": "Kırmızılar giyen küçük dostunuzun tüm Mondstadt'taki en güçlü hazineye sahip olduğunu öğrendik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010407
					],
					"speakerTitle": "Hiçlik Büyücüsü"
				},
				{
					"id": 102010407,
					"content": "O hazine de artık benim ellerimde ve yapabileceğiniz hiçbir şey yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010408
					],
					"speakerTitle": "Hiçlik Büyücüsü"
				},
				{
					"id": 102010408,
					"content": "Ve şimdi değerli hazineniz felaketiniz olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010409
					],
					"speakerTitle": "Hiçlik Büyücüsü"
				},
				{
					"id": 102010409,
					"content": "Dur, dur! Dokunma ona!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010410
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010410,
					"content": "Hahaha! Sonunda çaresizliğini anladığında nasıl da titriyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010411
					],
					"speakerTitle": "Hiçlik Büyücüsü"
				},
				{
					"id": 102010411,
					"content": "Bu da neymiş böyle? Alev sembolü mü? Nihahaha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010412
					],
					"speakerTitle": "Hiçlik Büyücüsü"
				},
				{
					"id": 102010412,
					"content": "*patlama*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010501
					],
					"speakerTitle": "Hiçlik Büyücüsü"
				},
				{
					"id": 102010501,
					"content": "HAYIR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010502
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010502,
					"content": "Hayatta kalma kurallarını ihlal ettim... \"Patlama dediğin mahveder insanı, Jean de ortaya salar gazabını...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010503
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010503,
					"content": "Bu kadarmış. Bu sefer mahvoldum... *ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010504
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010504,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010505,
					"content": "Klee'nin hazinesi bomba mıymış yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010506,
						102010507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010506,
					"content": "Harikaydı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010508
					]
				},
				{
					"id": 102010508,
					"content": "Klee'ye Mondstadt'taki en güçlü dövüşçü denmesi boşuna değilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010509,
					"content": "Paimon asla onunla dövüşmeye kalkmaz, asla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010510,
					"content": "Dur bir dakika... Gitti mi o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010511,
						102010512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010511,
					"content": "Hayatta kalma ilkeleriyle ilgili bir şey olsa gerek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010513
					]
				},
				{
					"id": 102010513,
					"content": "Öyle görünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010514,
					"content": "O zaman <color=#00E1FFFF>Şövalyelerin karargahına</color> gidip Jean'e olanları anlatalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
