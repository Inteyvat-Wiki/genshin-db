			"dialogs": [
				{
					"id": 102010101,
					"content": "Geldik! İşte burası!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010102,
					"content": "Burası büyüüük hazinemin gömülü olduğu yer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010103
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010103,
					"content": "Şurada, toprakta da kocaman bir yer kazılmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010104,
					"content": "Bir saniye... Kim var orada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102010105
					]
				},
				{
					"id": 102010105,
					"content": "Bir Hiçlik Büyücüsü mü? Belki de Jean'in bizi hakkında uyardığı büyücüdür bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010106,
					"content": "Elindeki şey de ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010107,
					"content": "Hazinem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010108
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 102010108,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010109,
					"content": "Küçük kız dostlarını getirmiş demek! Planda değişiklik yapma vakti o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010110
					],
					"speakerTitle": "Hiçlik Büyücüsü"
				},
				{
					"id": 102010110,
					"content": "Hey, sen! O kadar güçlü olduğunu düşünüyorsan geri gel ve dövüş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102010111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102010111,
					"content": "Peşinden gidelim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 1020103,
			"completionStepIds": [
				1020113
