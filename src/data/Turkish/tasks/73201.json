			},
			"dialogs": [
				{
					"id": 732010101,
					"content": "Bu pano, Puspa Kafenin mesaj panosudur. Bilinmeyen bir sebepten ötürü bir süreliğine Puspa Kafenin Vekil Müdürü ben olacağım. İstediğiniz bir şey varsa mesaj bırakabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7320102,
			"completionStepIds": [
				7320102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320102",
							"2"
						],
						"stepId": 7320102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010201,
					"content": "\"Antara'nın efsanevi hikayesi bu hafta da devam edecek!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010202
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010202,
					"content": "\"Puspa Kafenin özel misafiri olan hikaye anlatıcısı Maddah hizmetinizdedir! Takipte kalın!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010203
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010203,
					"content": "Maddah Bey... İlanlarınızı buraya asmayı bırakırsanız, size bir bardak kahve ikram ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7320103,
			"completionStepIds": [
				7320103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320103",
							"2"
						],
						"stepId": 7320103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010301,
					"content": "\"Hehe... Gata, hehe...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010302
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010302,
					"content": "Gata da sizi çok sevdi galiba Nilou Hanım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7320104,
			"completionStepIds": [
				7320104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320104",
							"2"
						],
						"stepId": 7320104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010401,
					"content": "\"Puspa Kart Kulübü, Dehanın Yakarışı oynayan yeni üyeler arıyor!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010402
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010402,
					"content": "\"Deste kurma ve teknikler hakkında sohbet etmek isterseniz beni kart masasında bulabilirsiniz!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010403
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010403,
					"content": "Nayab Bey... Burada kart oynayacaksanız, en azından bir bardak kahve sipariş edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7320105,
			"completionStepIds": [
				7320105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320105",
							"2"
						],
						"stepId": 7320105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010501,
					"content": "\"Son zamanlarda birkaç tane Konserve Bilgi kaçakçılığı vakası yaşandı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010502
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010502,
					"content": "\"Matradan özel bir hatırlatma: Aradığınız bilgi için başvuru yapmak ve bilgiyi elde etmek istiyorsanız, bunu resmi yollardan yapmanızı rica ederiz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010503
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010503,
					"content": "\"Yasa dışı yollardan elde edilen yasak bilgilere erişmeniz durumunda, Akademideki öğrencilik hakkınızı kaybedersiniz. Bilginize.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7320106,
			"completionStepIds": [
				7320106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320106",
							"2"
						],
						"stepId": 7320106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010601,
					"content": "\"Buradaki ortam, hanlara kıyasla çok daha samimi. Özellikle de benim gibi sınava hazırlanan bir öğrenci için.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010602
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010602,
					"content": "\"Buranın kahvesi beni ayakta tutuyor, üstelik etrafta danışabileceğim büyükler de var.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010603
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010603,
					"content": "\"Ayrıca buranın sahibi bu sene Akademiye gireceğimi bile söylüyor!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010604
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010604,
					"content": "Umarım dileğin gerçek olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7320107,
			"completionStepIds": [
				7320107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320107",
							"2"
						],
						"stepId": 7320107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010701,
					"content": "\"Herkes dikkatli olsun! Arkadaşım gecenin bir yarısı kuzeybatı ormanında Rishboland Raja ile karşılaştı! Sağ salim dönebildiği için bile çok şanslı! Güneş battıktan sonra asla dışarı çıkmayın!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7320108,
			"completionStepIds": [
				7320108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320108",
							"2"
						],
						"stepId": 7320108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010801,
					"content": "\"Büyük araştırmacı Pursina'nın son araştırmasına göre, kahve içmek bilişsel kabiliyeti artırıyormuş.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010802
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010802,
					"content": "\"Akademiye girmek istiyorsanız, bu kahve dükkanına sık sık uğrayın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010803
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010803,
					"content": "Dükkanımızın duyurusunu yaptığın için minnettarım ama kahve sana yalnızca biraz enerji verir... Mahamata olur da dayanağı olmayan bu beyana karşı işlem başlatırsa, biz ne yaparız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7320109,
			"completionStepIds": [
				7320109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320109",
							"2"
						],
						"stepId": 7320109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732010901,
					"content": "\"Buraya kart oynamaya geldiysen eğer, önce benden bir ders almalısın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010902
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010902,
					"content": "\"Dehanın Yakarışı oynarken, var olmayan bir kartı uydurarak diğer oyuncuları kandırmamam gerekirdi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010903
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010903,
					"content": "\"Çakal Efendi hatalarımı anlamamda bana yardımcı oldu. O yüzden buraya suçumu itiraf etmeye geldim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732010904
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732010904,
					"content": "\"Çoğu insan hatalarının farkına bile varmıyor doğrusu. Şey... Bahsettiğin Çakal Efendi kimdi bu arada?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7320110,
			"completionStepIds": [
				7320110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320110",
							"2"
						],
						"stepId": 7320110,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011001,
					"content": "\"Duyduğuma göre çöldeki haydutların sayısı artmış, pek çok tüccar da o güzergahta seyahat etmeyi reddediyormuş. Ajilenakh Yemişlerinin fiyatı yakında tavan yapabilir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011002
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011002,
					"content": "\"Harika! Hemen Ajilenakh Yemişi almak için tüm mantarlarımı satıyorum! Haha! Belki de bu, Alkindi Klanının cesareti ve vizyonudur!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011003
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011003,
					"content": "Servetinin katlandığını ben de görmek isterim fakat bu panodaki bilgilerden doğabilecek zararlardan dükkanımın sorumlu olmadığını da belirtmek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
