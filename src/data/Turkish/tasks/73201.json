			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011301,
					"content": "\"Onca yıl geçmesine rağmen bu mekan ne kadar canlı böyle! Ne zaman bu kahve dükkanına gelsem eski günleri yad ediyorum... Bir seferinde öğleden sonra onunla oturup tek bir kelimenin yorumlanması hakkında hararetle tartışmıştık, hey gidi günler hey.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011302
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011302,
					"content": "Siz olmasanız dükkanımız bu kadar canlı olmazdı. Lütfen sık sık uğrayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		}
	]
