						],
						"stepId": 7320111,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011101,
					"content": "\"Otuzlu Teşkilattan emekli olduktan sonra, kahvemi her gün burada içmeye başladım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011102
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011102,
					"content": "\"Vekil Müdür bana her gün aynı kahveyi yapıyor, hikaye anlatıcısı da aynı hikayeyi anlatıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011103
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011103,
					"content": "\"Sumeru'daki hayatın doğasında belki de böyle bir tekerrür vardır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7320112,
			"completionStepIds": [
				7320112
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320112",
							"2"
						],
						"stepId": 7320112,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732011201,
					"content": "\"Maddah Bey'in anlattığı hikayelerin modası geçmiş olabilir ama hikayelerin dozajını ayarlamada onun üzerine yoktur.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011202
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011202,
					"content": "\"Lakin herkes bilgiyi Akaşa'dan almaya o kadar alışmış ki farkında bile olmadan sanatsal olgunluk ve yılların getirdiği hüner gibi unsurları göz ardı ediyorlar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011203
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011203,
					"content": "\"Daha gerçekçi olmalısın. Sanatın hiçbir formu ebedi değildir. Sanatın tüm değerinin sömürüldüğü gün, varoluş sebebini de yitirdiği gündür.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011204
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011204,
					"content": "\"Tıpkı fazla olgunlaşmış meyvelerin toprağa düşüp de yeni bitkilere besin sağlaması gibi düşünebilirsiniz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011205
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011205,
					"content": "\"İşte tam da bu yüzden oldum olası senin gibi maddeci insanlardan hoşlanmam. Sanat, aylaklığın kıymetli bir meyvesidir. Bunu, üretimle ve ticari amaçların sömürüsüyle karşılaştıramazsın!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011206
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011206,
					"content": "\"Aylaklık yapan kimseler, küre şeklindeki bir dünyada yaşayan insanlara benzer. Yani ikisi de aslında yoktur. Azıcık beyninizi kullanın da bir düşünün. Ticari takas olmadan herhangi bir şeyin üretimi var olabilir mi?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011207
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011207,
					"content": "\"Ne keskin bir fikir çatışması bu... Ne yazık ki artık Bay Kaveh'in bu ayki faturasını kesme vakti geldi. Her zamanki gibi sizin hesabınıza mı yazalım, Bay Alhaitham?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011208
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011208,
					"content": "\"Hayır, bu şımarık adamın iş dünyasının zalimliğiyle yüzleşmesi gerek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732011209
					],
					"speakerTitle": "Mesaj Panosu"
				},
				{
					"id": 732011209,
					"content": "\"Lütfen hesabı Lord Sangemah Bay'in hesabına ekleyin Müdire Hanım. Sonuçta kahve olmadan sanat yapılamaz!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mesaj Panosu"
				}
			]
		},
		{
			"id": 7320113,
			"completionStepIds": [
				7320113
			],
