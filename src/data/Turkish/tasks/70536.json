			},
			"dialogs": [
				{
					"id": 705360101,
					"content": "Hehe, Dodoko Dikenli Balık Savaşçılarının çoğunu yendi! Dikenli Balık Kralı bile onunla boy ölçüşemedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360102
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360102,
					"content": "Dodoko, Zıpzıp Bodur ve Klee'nin Kıvılcımlar ve Patlaması cidden harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360103,
						705360104
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360103,
					"content": "Durdurmak imkansız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				},
				{
					"id": 705360105,
					"content": "Bu oyun Paimon'a Berrak Göl'de meydana gelen bir olayı hatırlatıyor... Lisa acaba oyunun temasını o olaya göre mi uyarladı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360106,
					"content": "Paimon'un aklına bir şey takıldı, Klee'den tüm şüpheli resifleri havaya uçurmasını istemek yerine acaba neden istilacı türleri bulma zahmetine giriyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360107,
					"content": "Bize bile birkaç bomba verseler bu işi hallederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360108,
						705360109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360108,
					"content": "Klee ile bir elmanın iki yarısı gibisiniz Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360110,
					"content": "Ne güzel, yüzünüzdeki ifadelere bakılırsa eğleniyor gibisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360111,
					"content": "Lisa geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360112
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360112,
					"content": "Geldin demek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360113,
					"content": "Dodoko'nun Bombastik Macerasını çok sevdik! Çok eğlenceli bir oyun tasarlamışsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360114,
					"content": "Oynadığınız için teşekkür ederim, beğenmenize sevindim. Hımm, belki de şöyle birkaç yeni güncelleme çıkarsam iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360115
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360115,
					"content": "Oley, yaşasın! Klee, Dodoko'nun başka yerlerde de maceraya atılmasını görmek istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360116
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360116,
					"content": "Hayır, bir saniye... Bu oyun için çoook emek harcamış ve çok yorulmuş olmalısın! Lisa'yı daha fazla yormamalıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360117
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360117,
					"content": "Ayy, çok düşüncelisin, teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360118
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360118,
					"content": "Ama şehirde kalırken bu oyun seni mutlu edecekse gerektiği kadar vakit ayırmaktan mutlu olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360119,
					"content": "İstediğin zaman kendin maceralara çıkmak isteyebileceğini de gayet iyi anlıyorum tabii. Bu oyun sadece zaman öldürmek için yeni bir alternatif.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360120,
					"content": "Her neyse, harika haberlerim var. Size bir de hediye getirdim canlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360121
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360121,
					"content": "Hediye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360122
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360122,
					"content": "Aslında benim de Sayın Fahri Şövalye ve Paimon için bir hediyem var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360123
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360123,
					"content": "Hediyelere birazdan geçeriz, önce haberi anlatayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360124,
						705360125
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360124,
					"content": "Berrak Göl'deki olay çözüme kavuştu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360126,
					"content": "Evet. Soruşturma Ekibinden iki Şövalye, istilacı türlerin yuvasını buldu ve hemen orayı yok etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360127,
					"content": "Ayrıca Şövalyeler bu istilanın sebebini de tespit etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360128
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360128,
					"content": "O balık türlerini bir tüccar kötü bir niyeti olmadan kazara bu göle getirmiş. Bu yüzden Şövalyeler de uyarıda bulunup ceza kestikten sonra onu serbest bırakmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360129
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360129,
					"content": "Oh... Neyse ki çok fazla bir sorun çıkmamış. Ancak Paimon bile tüccarın fazla ihmalkar olduğunu düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360130,
						705360131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360130,
					"content": "Berrak Göl'ün suları artık güvende!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360132,
					"content": "Hediye verme vakti geldi mi? İlk önce Klee başlasın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360133
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360133,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360134
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360134,
					"content": "Klee son zamanlarda her gün hiç kimsenin onu uyarmasına gerek kalmadan erkenden evine dönüyor. Neyin peşinde olduğunu merak ediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360135
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360135,
					"content": "Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360136
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360136,
					"content": "Akşam eve döndüğümde Albedo'nun zanaatkarlık kitaplarını okudum ve bunu yapmayı öğrendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360137
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360137,
					"content": "Ta da!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360138
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360138,
					"content": "Vay canına! Zıpzıp Bodur fırlatan Dodoko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360139,
					"content": "Evet! Dodoko'nun Bombastik Macerasındaki Dodoko'ya benzeyen bir figür yaptım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360140
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360140,
					"content": "Her ne kadar gerçek bomba fırlatanını yapamasam da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360141
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360141,
					"content": "Umarım bu size birlikte yaşadığımız eğlenceyi hatırlatır, sorunlarınızı ve can sıkıntınızı alıp götürür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360142
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360142,
					"content": "Kocaman bir Dodoko oyuncağı! Paimon bu tür sürprizlere bayılıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360143,
					"content": "Elimizde bu oyuncak varken nereye gidersek gidelim hep Klee ve Dodoko ile birlikte maceraya atılıyormuş gibi hissedeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360144,
						705360145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360144,
					"content": "Böyle yaratıcı ve düşünceli bir hediye için teşekkürler Klee!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360146,
					"content": "Hehe, hediyemi beğenmenize çok sevindim! Üzerinde çok çalıştım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360147
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360147,
					"content": "Senin hediyen nedir Lisa? Görmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360148
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360148,
					"content": "Şey, sanırım benim hediyem seninki kadar yaratıcı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360149
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360149,
					"content": "Dodoko'nun Bombastik Maceraları hakkında bir hikaye kitabı benimki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360150
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360150,
					"content": "Bir macera kitabı! Yaşasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360151
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360151,
					"content": "Vay canına, kocaman bir hikaye kitabı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360152,
					"content": "İki sevimli maceracı Mondstadt'a döner ve Dodoko ile olan macerasında Klee'ye katılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360153
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360153,
					"content": "Birlikte kötü Dikenli Balık Savaşçılarını yenerler ve ardından çay içerler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360154
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360154,
					"content": "Dodoko'nun Bombastik Macerasına en uygun son bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360155
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360155,
					"content": "Oyunu tasarlarken bir yandan da baştan sona bir hikaye mi yazdın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360156,
					"content": "Hayır. Hikayenin kahramanları olarak sen, sevimli maceracımız ve Klee bu hikayenin gerçeğe dönüşmesinde önemli rol oynadınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360157
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360157,
					"content": "Resimler için kitapta özel olarak boş bir yer bıraktım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360158
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360158,
					"content": "Ama daha sonra aklıma çok daha iyi bir fikir geldi. Madem hepimiz bu özel günde bir araya geldik, o zaman sizin beraber bir fotoğrafınızı çekeyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360159
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 705360159,
					"content": "Aynen! Arkadaşlarımızı gördük ve birlikte oyun oynadık. Bu an kesinlikle kutlanmaya değer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360160,
						705360161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 705360160,
					"content": "Hadi toplu bir fotoğraf çekilelim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360162,
					"content": "Hadi o zaman Sayın Fahri Şövalye ve Paimon! Lisa, hazır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705360163
					],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360163,
					"content": "Klee bugün çok eğlendi! Üç, iki, bir... Dodoko!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Klee"
				},
				{
					"id": 705360161,
					"content": "Hayattaki küçük mutlulukların kıymetini bilmek gerek!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360162
					]
				},
				{
					"id": 705360145,
					"content": "Bundan sonra çıkacağımız tüm maceralarda Dodoko da bizimle birlikte gelecek!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360146
					]
				},
				{
					"id": 705360131,
					"content": "Mondstadt'ın şarap endüstrisi artık güvende!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360132
					]
				},
				{
					"id": 705360125,
					"content": "Klee tekrar dışarıda oynayabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360126
					]
				},
				{
					"id": 705360109,
					"content": "Olmaz, Paimon'a bomba yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360110
					]
				},
				{
					"id": 705360104,
					"content": "Al bakalım, seni kötü balık!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705360105
					]
				}
			]
		}
	]
}