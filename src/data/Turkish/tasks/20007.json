			"dialogs": [
				{
					"id": 200070601,
					"content": "Bu, iş görür. Her an dağılacakmış gibi görünüyor ama beni Mondstadt'a kadar götürsün yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070602
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070602,
					"content": "Her şey için çok teşekkür ederim! Artık gidebilirim. Pınarköy'e yolun düşecek olursa bana haber ver, bir şeyler içeriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070603
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070603,
					"content": "... Yani Draff gibi içmediğin sürece tabii.",
					"roleType": "TALK_ROLE_NPC",
