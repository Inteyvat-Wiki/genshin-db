			"dialogs": [
				{
					"id": 200070401,
					"content": "Hayatımı kurtardın! Amma da inatçılar, değil mi? Acaba avcılar bu kadar cezbedici ne avladılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070402
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070402,
					"content": "Böylesine kaliteli türler avlamayı başardığı için Draff'a hayranım. *iç çeker* Keşke onun kadar iyi avlanabilseydim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070403
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070403,
					"content": "Neyse, her şeyin bir sırası var. Bu emektarı şehre götürsem iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070404
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070404,
					"content": "Of, buna inanmayacaksın ama... Tamiratı tam bitirmek üzereydim fakat tekrar saldırdıklarında biraz daha zarar vermişler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070405
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070405,
					"content": "Ben burada durdukça işler kötüleşiyor. Bu işi bir an önce halletmem lazım. Arka tarafta ip olacaktı, fakat dağ yabanileri cebe indirmiş herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070406
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070406,
					"content": "Gezgin, acaba rica etsem bana <color=#00E1FFFF>İp</color> bulmak için etrafa bakabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
