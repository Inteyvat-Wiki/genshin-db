			"dialogs": [
				{
					"id": 200070101,
					"content": "#Te-Teşekkür ederim {NICKNAME}... İşimin bittiğini sanmıştım, çok şanslıymışım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070102
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070102,
					"content": "Bu araba avcıların avlayabildikleri her şey ile dolu. Draff onları şehre götürmem için beni görevlendirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070103
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070103,
					"content": "Ben dünyadaki en iyi avcı olmayabilirim ama en azından basit bir teslimatın üstesinden gelirim sanıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070104
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070104,
					"content": "Neredeyse her şeyi mahvedecektim. Saldırı hiç beklemediğim bir anda oldu, sanırım malzemelerin peşindelerdi. Zamanında gelmen çok iyi oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070105
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070105,
					"content": "Sormaya biraz çekiniyorum ama... Arabam saldırı sırasında zarar gördü ve o olmadan buradan çıkamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070106
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070106,
					"content": "Ormanda tamir için gereken malzemeleri bulabileceğimize eminim fakat arabamı burada başıboş bırakıp gidemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200070107
					],
					"speakerTitle": "Allan"
				},
				{
					"id": 200070107,
					"content": "Acaba zahmet olmazsa etrafa bakınıp benim için <color=#00E1FFFF>Sağlam Kalas</color> bulabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Allan"
				}
			]
		},
