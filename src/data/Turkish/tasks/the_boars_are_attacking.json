			},
			"dialogs": [
				{
					"id": 4680201,
					"content": "Yardım edebileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "Sen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680203,
					"content": "Ah, şu gezginler. Ne kadar da naziksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680204,
					"content": "Şimdi üzümlerin olgunlaşma mevsimi. Ama birdenbire başıma bir yaban domuzu sürüsü dadandı ve gözlerini bağa diktiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680205,
					"content": "Domuzları tek başıma kovamıyorum, oğlum da şu an yanımda olmadığı için tek yapabildiğim topraklarımı mahvetmelerini izlemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680206,
					"content": "O domuzları kovmama yardım edebilirsen, karşılığını cömertçe öderim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
		{
			"id": 46803,
