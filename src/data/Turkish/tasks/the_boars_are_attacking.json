			"dialogs": [
				{
					"id": 4680401,
					"content": "Merhaba. Oğlumdan bir haber var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680601,
					"content": "Sen kimsin peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "Ben mi? Şaraphanedeki dostlarım bana İhtiyar Tunner derler. Şafak Şaraphanesinde çiftçilik yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680603,
					"content": "Ailem nesillerdir burada çiftçilik yapıyor. İçtiğin iyi şarapların çoğu muhtemelen buradaki üzümlerden yapılmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680604,
					"content": "Bugüne kadar şaraphaneyi devralan herkes ailemize çok cömert davrandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680605,
					"content": "Ama oğlumun bu toprakları miras almasının ve hayatını bir çiftçi olarak geçirmesinin iyi bir şey olduğunu düşünmüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680701,
					"content": "Oğlun mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "Guy! Biricik oğlumun adı Guy!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680703,
					"content": "Ne? Adını duymadın mı hiç? Hahaha, önemli değil. Eninde sonunda duyacaksın. Bütün Mondstadt duyacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680704,
					"content": "Oğlum Guy en güçlü Favonius Şövalyesi olacağını söyledi! Ona inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680705,
					"content": "Zar zor kazandığım tüm paramı ona daha iyi bir gelecek sunmak için harcadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680706,
					"content": "Guy hayalini gerçekleştirmeye kararlı! 16 yaşında yaver oldu, ev halkı da o zamandan beri ona bel bağladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "Tunner"
				},
				{
					"id": 4680801,
					"content": "Hoşça kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "Güle güle! Oğlumla tanışırsan lütfen ona arada bir eve gelmesini söyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tunner"
				}
			]
		},
