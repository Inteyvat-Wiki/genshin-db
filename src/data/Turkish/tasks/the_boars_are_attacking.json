						4680302
					]
				},
				{
					"id": 4680302,
					"content": "Pekala, sanırım o domuzları cezalandırmak için oğlumun dönmesini beklemekten başka çarem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
