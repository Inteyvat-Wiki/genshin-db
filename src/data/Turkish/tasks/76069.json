			"dialogs": [
				{
					"id": 760690401,
					"content": "Hım, Kurt Ruhunun bir tezahürü... Bilmediğim bir parça mı varmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690402
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690402,
					"content": "Seni buraya kim bıraktı? Ve neyi koruyorsun? Cevap ver bana... Anlat.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690403
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690403,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690404
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690404,
					"content": "... Bunu daha kaç kez söyleyeceğim? Bu kanlı yolda tek başıma yürümeliyim. Kimsenin izimden gelmesine lüzum yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690405
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690405,
					"content": "Hah, o zaman buna düpedüz \"kader\" diyelim. Mondstadt'tan Nod-Krai'a kadar tesadüfen aynı yoldan yürümüş olamaz mıyız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690406
					]
				},
				{
					"id": 760690406,
					"content": "Bizi sayısız kez kurtaran o yüce şövalyeye hürmet göstermek bizim \"kaderimizde\" var. Hal böyleyken aynı yoldan gittiğimiz için bizi kim suçlayabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690407
					]
				},
				{
					"id": 760690407,
					"content": "Anlamasak bile tanıklık etmek boynumuzun borcu... Sonunda geriye sadece birkaçımız kalsa dahi böyle bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690408
					]
				},
				{
					"id": 760690408,
					"content": "Auu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690409
					]
				},
				{
					"id": 760690409,
					"content": "Eğer gerçekten böyle görüyorsanız... Size karşı gelmek bana düşmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690410
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690410,
					"content": "...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760690411
					]
				},
				{
					"id": 760690411,
					"content": "O lanet olası canavarların... Hepsi öldü mü? Peki ya civardaki sakinler... Güvendeler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690412
					]
				},
				{
					"id": 760690412,
					"content": "*öksürür*... Güzel... Ne yazık ki senin zafere ulaştığını görecek gücümüz kalmadı... Keşke elimizden daha fazlası gelseydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690413
					]
				},
				{
					"id": 760690413,
					"content": "Buradan itibaren bu yolda tek başına yürümek zorundasın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690414
					]
				},
				{
					"id": 760690414,
					"content": "... Lakin günün sonunda kılıcım hepsini korumaya yetmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690415
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690415,
					"content": "... Nihayetinde o yolda yürüyecek tek bir kişi kaldı... Belki de başından beri olması gereken buydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690416
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690416,
					"content": "Hiç değilse bu kılıçlar ve buradaki Kurt Ruhu sana muhafızlık etsin... Etsin ki o karanlık sapkınlıklar ebedi istirahatini bölemesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690417
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690417,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690418
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690418,
					"content": "Demek işin aslı böyleymiş... Favonius Şövalyeleri kayıtlarına göre, Kanlı Şövalye yola koyulduğunda onun izinden giden şövalyeler de varmış. Ne var ki sonrasında adları bir daha hiç anılmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690419
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690419,
					"content": "Burada canavarlarla savaşırken ölmeleri... Gerçek Favonius Şövalyelerine yakışır bir son.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690420
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690420,
					"content": "Ama gerçekten diledikleri bu muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690421
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690421,
					"content": "Savaşın sönmeyen alevi, kılıçlarınızda barınan o hasret... Anlatın bana Şövalyeler, kararlılığınızdan bahsedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690422
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690422,
					"content": "Poyraz'ın buraya bıraktığı gücü kullanarak savaş alanını mühürleyeceğim... O küçük kurt ise sizin için dışarıda nöbet tutacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690423
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690423,
					"content": "Böylece asla rahatsız edilmeyecek, bu dünyanın adaletsizliğine şahit olmaktan sonsuza dek kurtulup ebedi huzura ereceksiniz... Eğer böyle bir korumayı hak eden birileri varsa o da sizsiniz dostlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690424
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690424,
					"content": "Yolun sonuna geldik... Elveda son yoldaşlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690425
					],
					"speakerTitle": "Roland"
				},
				{
					"id": 760690425,
					"content": "... Hayır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690426
					]
				},
				{
					"id": 760690426,
					"content": "... Hayır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690427
					]
				},
				{
					"id": 760690427,
					"content": "... Bırak bir kez daha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690428
					]
				},
				{
					"id": 760690428,
					"content": "... Savaşalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690429
					]
				},
				{
					"id": 760690429,
					"content": "İşte ruh budur! İstekleriniz ve tutkularınız herhalde böyle bir yerde solup gitsin diye var olmadılar, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690430
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690430,
					"content": "Bana katılın! Ve bir kez daha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690431
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 760690431,
					"content": "Savaşın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varka"
				}
			]
		}
	]
}