			"dialogs": [
				{
					"id": 747010101,
					"content": "Ha? Neden Paimon'a bir anda burada fazladan bir havuz varmış gibi geldi? Şu tabelada ne yazıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010102,
					"content": "\"Tehlike - Uzak Durun!\" Bu ne anlama geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010103,
					"content": "Orada ne yazıyorsa o anlama geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010104
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747010104,
					"content": "Ayy! Sandrone... Paimon'u yerinden sıçrattın! Bu tabelayı buraya sen mi koydun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010105,
					"content": "Evet. Meraklı insanları uzak tutmak için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010106
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747010106,
					"content": "Bu havuzun nesi bu kadar özel?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010107,
					"content": "Pirana kaynıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010108
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747010108,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010109,
					"content": "Haha, şaka yaptım. Buna gerçekten inandığını söyleme sakın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010110
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747010110,
					"content": "Akvaryumdaki balıklardan bazıları kendi alanlarını fena halde sahiplenip bayağı hırçınlaşabiliyormuş. Bu yüzden onları buraya taşıdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010111
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747010111,
					"content": "Paimon'u böyle korkutma! Yani burası saldırgan balıkçıklar için özel bir karantina bölgesi gibi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010112,
					"content": "Aynen öyle, bu havuzun suyu çok daha derin, üstelik alan da epey geniş. Bu da bölgesini sahiplenen balıkların yatışmalarını sağlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010113
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747010113,
					"content": "Ayrıca onları biraz sakinleştirmesi için Meropide Kalesi'ndeki Sigewinne'den biraz özel yem istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010114
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747010114,
					"content": "Vay be... Demek balıkçıkların iyiliğini gerçekten de önemsiyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010115,
					"content": "Akvaryumun kan gölüne dönmesini kimse istemez bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010116
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747010116,
					"content": "Orası kesin! Neyse, bu işi bize bırakmaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010117,
					"content": "Madem o kadar ısrar ediyorsun, peki. Havuzdaki balıklar yüzeye çıkacak kadar rahatladıklarında bilin ki iyileşme yolundalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010118
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747010118,
					"content": "Yani hepsi rahat ve mutlu olduklarında onları akvaryuma geri koyabilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010119,
					"content": "Onları nereye koyacağınız size kalmış. Benim tek sorumluluğum en başta yaramaz olanları toplayıp buraya taşımak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010120
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 747010120,
					"content": "Tamamdır! Yalnız o tabela insanın ödünü koparıyor. Onu... Daha az korkutucu bir şeyle mi değiştirsek acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747010121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747010121,
					"content": "Hımm... Nasıl isterseniz. Balıklar sizin, kararı size bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		}
	]
}