				"points": []
			},
			"dialogs": [
				{
					"id": 250212709,
					"content": "(Hora rahatlamış gibi görünmüyor. Kafası karışmış bir halde sana bakıyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212710
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212710,
					"content": "(Cazcal durum kötüleşmeden müdahale edip görevi devralıyor. Özenli bir şekilde bakımını yaparak Hora'nın tırnaklarını kesiyor.)",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212701
					]
				},
				{
					"id": 250212701,
					"content": "Sorun değil, ben de bazen Hora'nın tepkilerini yanlış anlıyorum. Önemli olan senin dostu olduğunu anlaması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212702
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212702,
					"content": "Raaa, raaah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212703
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212703,
					"content": "Hahaha! Bak, ne dedim ben sana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212704
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212704,
					"content": "Yardımın için çok sağ ol. Emeğinin karşılığı olarak bunu kabul et lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212705
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212705,
					"content": "Küçük Sürüngenler çok zor hayvanlar. Hora'yı iyice tanımak, aklından geçenleri anlayabilmek için çok zaman harcadım ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212706
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212706,
					"content": "Yine de bu noktaya gelebildim ya, o bana yeter. Daha uzun yıllar birlikte olacağız, çabalarımın karşılığını almak beni mutlu ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212707
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212707,
					"content": "Bir dakika... Hora nerede? Yoksa yine mi kaçtı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212708
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212708,
					"content": "Hora! Horaaaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
