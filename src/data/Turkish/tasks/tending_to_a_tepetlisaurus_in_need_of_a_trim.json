			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250210101,
					"content": "Yine kaçıp gitme, tamam mı Hora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210102
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210102,
					"content": "R-Raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210103
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210103,
					"content": "Hora bugün çok uslu durdu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210104
					]
				},
				{
					"id": 250210104,
					"content": "Değil mi ama? Şu Yüzertop sağ olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210105
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210105,
					"content": "Bu top sayesinde Hora'ya her şeyi yaptırabileceğim. Banyo, yemek, uyku, eğitim... İşim o kadar kolaylaştı ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210106
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210106,
					"content": "Hatta tırnaklarını bile kesebileceğim herhalde artık! Eskiden onu yakalayacağım diye ayaklarıma kara sular iniyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210107
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210107,
					"content": "Şimdi topu göstersem yetiyor, baksana. Ev köpeği gibi oturup komut beklemeye başlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210108
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210108,
					"content": "Rraaa, raaa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210109
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210109,
					"content": "#Bak bu {M#abiyi}{F#ablayı} tanıdın mı Hora? Oyuncağını yaparken bana yardım etmişti hani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210110
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210110,
					"content": "Aruuuu, aruuuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210111,
						250210112
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210111,
					"content": "Hanimiş akıllı Hora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				},
				{
					"id": 250210113,
					"content": "Yaa, görüyor musun? Hora seni unutmamış! Ne kadar sevindi baksana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210114
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210114,
					"content": "Tırnaklarını kesmeyi denemek ister misin? Hatta hazır başlamışken boynuzunu da silebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210115
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210115,
					"content": "Küçük Tepetlizorların bakımını düzenli olarak yapmak çok önemlidir. Kırılmış tırnaklarını kesmek, törpülemek, sonra da uçlarını sivriltmek gerekir ki kayaları ve toprağı daha rahat kazabilsinler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210116
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210116,
					"content": "Bu bakım sayesinde yetişkinlik çağına geldiklerinde mükemmel pençelere sahip olmalarını sağlarız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210117
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210117,
					"content": "İşte, al bakalım! Hazır kesim işine başlamışken Hora'ya şöyle eksiksiz bir bakım yapalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210118,
						250210119
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210118,
					"content": "Çok detaylı bir işmiş bu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210120,
					"content": "Raarr, raarr...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210121
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250210121,
					"content": "*öksürür* Eh, Hora nadiren bu kadar uslu durur. Tüm gün kabilede Tepetlizor kovalamak zorunda kalmayacağımı fark edince zevkten dört köşe oldum, ne yapayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210122
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210122,
					"content": "Senin işin de zormuş hakikaten...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210123
					]
				},
				{
					"id": 250210123,
					"content": "İdare ediyoruz işte! Neyse, hadi başlayalım. Sana neyi nasıl yapacağını anlatacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210124
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210124,
					"content": "Hora'yı rahatlatmak için büyük fırçayı alıp sırtını yavaşça temizleyerek başlaman lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210130
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210130,
					"content": "Sonra daha ince uçlu bir fırçaya geçip boynuzunu temizlemeye başla. Onu yaparken titiz ol tabii, yoksa çatlakların arasındaki kirleri alamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210125
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210125,
					"content": "Ardından havluyu alıp vücudunu temizlemeye geç. Sen temizledikçe yavaş yavaş gevşeyip tırnaklarını çıkarmaya başlayacak, böylece onları kesebileceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210126,
						250210127
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210126,
					"content": "Sistemi kurmuşsun bakıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210128,
					"content": "Tabii canım, ne sandın! Hora benim elimde büyüdü sonuçta. Kabilede, hatta Natlan sınırları içinde onu benden iyi tanıyan kimse yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250210129
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210129,
					"content": "Pekala, tarif ettiğim şekilde Hora'nın tırnaklarını kes. Ben de yanında olacağım. Anlayamadığın bir şey olursa çekinmeden sorabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250210127,
					"content": "Hora'nın ciğerini biliyorsun resmen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210128
					]
				},
				{
					"id": 250210119,
					"content": "Bir anda heyecanlandın sanki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210120
					]
				},
				{
					"id": 250210112,
					"content": "(Hora'yı sev.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250210113
					]
				}
			]
		},
