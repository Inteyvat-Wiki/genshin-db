			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cazcal"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250212609,
					"content": "(Hora yavaşça gevşemeye başlıyor. Tüm vücudunu esnetiyor ve tırnaklarını dışarı çıkarıyor. Hepsinin azıcık kesilme vakti gelmiş gibi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212610
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212610,
					"content": "Cazcal'ın yönlendirmesiyle dikkatli bir şekilde Hora'nın tırnaklarını kesiyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						250212601
					]
				},
				{
					"id": 250212601,
					"content": "Hahaha, sen de doğuştan yetenekli çıktın ha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212602
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212602,
					"content": "Raarrr, raarrr, raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212603
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250212603,
					"content": "Hora da sana teşekkür ediyor. Bakımını yaparken çok titiz davrandın. Toprağı eskisinden çok daha hızlı kazacak eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212604
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212604,
					"content": "Al, bunlar da sana teşekkür hediyem olsun. Bir de unutmadan uyarmış olayım... Olur da daha sonra başka küçük Sürüngenlerle ilgilenmen gerekirse sakın ama sakın sana bugün öğrettiğim yöntemi kullanma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212605
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212605,
					"content": "Tüm yavru Sürüngenlerin kişiliği birbirinden farklıdır. Bakım yaparken her biri için farklı yaklaşımlar benimsemek gerekir. Hora uzun süredir benimle ama bakımını nasıl yapacağımı yeni çözdüm mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212606
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212606,
					"content": "Yine de sonunda çözebildim ya, o bana yeter. Daha uzun yıllar birlikte olacağız, çabalarımın karşılığını almak beni mutlu ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212607
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212607,
					"content": "Bir dakika... Hora nerede? Yoksa yine mi kaçtı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250212608
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250212608,
					"content": "Hora! Horaaaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
			]
		},
