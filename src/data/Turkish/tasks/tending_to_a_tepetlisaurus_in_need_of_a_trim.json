				"points": []
			},
			"dialogs": [
				{
					"id": 250213701,
					"content": "(Hora kafasını eğer, karnını kaşır ve sana kafası karışık biçimde bakar.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213702
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250213702,
					"content": "Sürekli oyun olmaz bak. Biraz da iş yapmak gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213703
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213703,
					"content": "Öhöm. Müsaadenle. Ben nasıl yapacağını göstereyim sana bak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213704
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213704,
					"content": "(Cazcal durum kötüleşmeden müdahale edip görevi devralıyor. Özenli bir şekilde bakımını yaparak Hora'nın tırnaklarını kesiyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213705
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250213705,
					"content": "Hora'yla oyuna dalma. Yapman gereken bir iş var, unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213706
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213706,
					"content": "Hıır! Arrrr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213707
					],
					"speakerTitle": "Hora"
				},
				{
					"id": 250213707,
					"content": "Hahaha, galiba Hora seni sevmiş. Demek o yüzden bu kadar uslu durdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213708
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213708,
					"content": "Her neyse, yardımın için çok sağ ol. Emeğinin karşılığı olarak bunu kabul et lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213709
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213709,
					"content": "Hımm... Acaba ben de mi yıkamaya başlamadan önce Hora'yla uzun uzun oynasam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213710
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213710,
					"content": "Ee, ne diyorsun Hora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213711
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213711,
					"content": "Bir dakika... Hora nerede? Yoksa yine mi kaçtı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250213712
					],
					"speakerTitle": "Cazcal"
				},
				{
					"id": 250213712,
					"content": "Hora! Horaaaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Cazcal"
				}
