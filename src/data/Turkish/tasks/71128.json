			"dialogs": [
				{
					"id": 711280201,
					"content": "\"Biraz daha büyüdüğünde yapraklarını keseceğim ve hepinize çay yapacağım.\"",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280202
					]
				},
				{
					"id": 711280202,
					"content": "\"O zaman geldiğinde Bulutlar Hakimi ve Dağkesen'i çağıracağız...\"",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280203
					]
				},
				{
					"id": 711280203,
					"content": "\"Gerçekten mi? Toprağıma ağaçlarını istediğin gibi ekeceksin demek. Böyle sözler sarf edecek cesareti nereden buluyorsun?\"",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280204
					]
				},
				{
					"id": 711280204,
					"content": "... Mazideki sözlerin tutulduğu gün daha gelmedi ama sessiz yaşlı ağaç o sözün sesini hâlâ hatırlıyor...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						711280205
					]
				},
				{
					"id": 711280205,
					"content": "... Bugün çayın kokusu Chenyu Vadisi'ne çoktan yayıldı ve uzak diyarlara taşındı...",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
