				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420701,
					"content": "#Tadı nasıl? Yüzün komik oldu {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420702,
						110420703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420702,
					"content": "Biraz yakıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				},
				{
					"id": 110420704,
					"content": "Zaten denedim demiştin! Hazır olduğuna emin misin? Ona ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420705,
					"content": "Ne? Ha, evet beklediğim sonuç buydu. Gayet olumluydu hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420706
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420706,
					"content": "İksir vücuttaki element gücüne yön verir. Normal şartlarda ters bir tepki verilmesi beklenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420707
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420707,
					"content": "İç element akışının önünde bir engel yoksa sadece kısa süreli bir rahatsızlık hissedilir. Akış tamamlandığında başka bir etki olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420708
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420708,
					"content": "Yani kötü olacağını bilmene rağmen mi içtin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420709
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420709,
					"content": "Sonuçta benim karışımımdı. Deney faresi de ben olmalıydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420710,
						110420712
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420710,
					"content": "Deneğin iyiliğini düşündüğün için mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420711
					]
				},
				{
					"id": 110420711,
					"content": "Tabii! Asistanımsın sen. Seni böyle riske atmak ne akla ne mantığa uyar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420714,
					"content": "Sonuç olarak... Aradığımız sonucu bulduk diyebiliriz! Element enerjisi konusunda bu dünyadaki insanlardan farklı değilsin. Olağan dışı bir durum yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420715
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420715,
					"content": "Aaa... Paimon daha havalı bir şey olacağını umuyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420716,
					"content": "Yine de sıradan bir sonuç olağan dışı bir sonuçtan iyidir. Olağan dışı sonuçlar genelde... İstenmeyen şeyler olabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420717
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420717,
					"content": "Özellikle bir şey söylemek istiyormuşsun gibi hissediyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420718
					]
				},
				{
					"id": 110420718,
					"content": "\"Sıradan\" olmasının iyi yanı her şeyin referans alınabilmesi ve herkesin seni anlaması.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420719
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420719,
					"content": "İnsanlar aynıdır; birbirlerini destekler ve anlar, birbiriyle empati kurar ve birbirine cesaret verir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420720
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420720,
					"content": "Hastaysan doktor sana teşhis koyabilir çünkü aynısınızdır. Bir sorun çıktığında geçmişte aynı hatayı yapan insanlardan tavsiye alabilirsin; çünkü aynısınızdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420721
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420721,
					"content": "Ama olağan dışı bir insan... Bizim varsaydığımız şeyler onlara yaramaz. Hayatlarının özü temel olarak farklıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420722
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420722,
					"content": "Örneğin... Bir insan bir Yalancı Ateş Ağacının veya bir Fırtınanın Gözünün yaşamını anlayamaz. Yeterince açık anlatabildim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420723,
						110420724
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420723,
					"content": "Anlıyorum galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420725,
					"content": "Özet olarak bu sonuç olumluydu. Bundan sonra element gücünü korkmadan kullanabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420726
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420726,
					"content": "Timaeus, yeni deneyin sonuçları çıktı. Derleyebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420727
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420727,
					"content": "Bir dakika efendim! Halledeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420728
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420728,
					"content": "Düşünecek çok şey sundunuz bana. Gerçekten bakış açımı genişlettiniz. Artık çok daha net düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420729
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420729,
					"content": "Hayvan olduğunu varsaymam çok isabetli olmamış ama element tabanlı bir yaşam formu varsayımıyla başlamak... İşte o gerçekten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420730
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420730,
					"content": "Fena değildi. Bence güzel bir araştırma. İşin gerçeği ne olursa olsun benim tahminime karşı senin araştırmanı ön planda görmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420731
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420731,
					"content": "Bana güvenebilirsiniz efendim! Herkesi memnun edecek bir sonuç çıkaracağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420732
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420732,
					"content": "Şövalyelere mi katılmaya çalışıyor acaba? Yalakalık yapmaya başladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420733
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420733,
					"content": "Şey... Paimon şey demek istedi... İşte böyle! Bay Albedo bir şey söylese keşke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420734
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420734,
					"content": "Hımm... Araştırmamıza devam etmeden önce... Bir şeyler hazırlamam lazım. Bir dakika bekleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420735
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420735,
					"content": "İlginizi çekiyorsa neden etrafa bakınmıyorsunuz? Biraz oyalanırsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420724,
					"content": "Yine de... Sanki sözlerinin altında başka anlamlar gizli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420725
					]
				},
				{
					"id": 110420712,
					"content": "Ya kendini riske atmak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420713
					]
				},
				{
					"id": 110420713,
					"content": "Belki de kendi ilmime güvenmemdendir. Ayrıca işleri hızlandırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420714
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420703,
					"content": "Bunu mu içtin!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420704
					]
				}
			]
		},
