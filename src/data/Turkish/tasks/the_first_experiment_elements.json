			},
			"dialogs": [
				{
					"id": 110420101,
					"content": "Paimon'un bir sorusu var. Tohum filizlendiğinde neye dönüşecek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420102,
					"content": "Bilmiyorum. Ama bana sorarsan önemli olan sonuç değil yöntem olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420103
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420103,
					"content": "Simyayı kullanarak Teyvat'ta başka bir dünyadan gelen bir şeyi canlandırmak hayatın özüne dair yepyeni bilgiler edinmemi sağlayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420104
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420104,
					"content": "Uyanıştan sonra belki bir şey yaratmak bile mümkün olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420105
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420105,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420106,
					"content": "Hâlâ anlamakta zorlanıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420107
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420107,
					"content": "H-Hayır! Paimon'un beyni var! Ama tohum ne olacak? Bahsettiğin şeyden daha ilginç değil mi o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420108,
						110420109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420108,
					"content": "Anlamamışsın galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				},
				{
					"id": 110420110,
					"content": "Eh. Eğer lezzetli bir meyve olursa akşam yemeğiniz benden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420111
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420111,
					"content": "Oley! Paimon unutmayacak bunu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420112,
						110420113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420112,
					"content": "Paimon'u nasıl ikna edeceğini biliyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420114,
					"content": "Aslında... Sık sık çocuk bakmam gerekiyor. Onu açıklaması da uzun sürecek. Simya dışında yetenekli olduğum birkaç konudan biri diyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420115
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420115,
					"content": "İlk araştırmamın konusu elementlerdi. Bu dünyadan elementleri kontrol etmek Önsezi gerektirir. Fakat sende ona benzeyen bir şey göremedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420116
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420116,
					"content": "Elementlerin gücünü nasıl öylece kontrol ettiğini anlamak istiyorum. Bu konuda birkaç sorum olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420117
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420117,
					"content": "Öncelikle, fazladan bir organın var mı? İkinci bir kalp ya da dört mide gibi... O türden bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420118,
						110420119
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420118,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420120,
					"content": "İlginç. Peki bu uçan çocuk... Vücuduna bir şekilde bağlı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420121
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420121,
					"content": "Ne saçma bir soru! Aramızdaki boşluğu görmüyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420122,
					"content": "Ayrıca o PAIMON! \"Uçan çocuk\" değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420123,
					"content": "Senin bir dış uzuv olma ihtimalini düşünüyordum sadece. Belki sizi bağlayan görünmez bir güç vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420124,
						110420125
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420124,
					"content": "Paimon'a yolculuklarım sırasında rastladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420126,
					"content": "Ah, o durumda bu ihtimali göz ardı edebiliriz. Acaba... Elementlerin gücünü sana Paimon mu getirdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420127
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420127,
					"content": "Ama öyle olsa Paimon'un element gücünün en az on metre kalınlığında kayaları delmeye yetmesi gerekirdi. Ya da Pınarköy'ün güneyindeki şelalenin yukarı akmasına sebep olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420128
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420128,
					"content": "Hımm. Hayır, öyle olamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420129
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420129,
					"content": "Sen nereden bileceksin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420130,
					"content": "Öyleyse senin vücut yapın ile bu dünyadaki insanların vücut yapısı arasında belirgin bir fark yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420131
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420131,
					"content": "Araştırmada bir tutarsızlık olduğu açık. Bu yüzden, sanırım aradığımız cevaplara sadece deney yoluyla ulaşabileceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420132
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420132,
					"content": "Öncelikle şu gizemli element gücünü tam olarak nasıl dışarı yansıttığını incelemek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420133
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420133,
					"content": "Bekle, buraya birkaç bodurlop getireyim. Onlarla dövüşebilir misin? Sana en doğal gelen yöntemi kullan yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420134
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420134,
					"content": "Ne? Çok bilimsel gelmedi bana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420135,
					"content": "Direkt ve açık gözlem iyi bir deney için çok önemlidir. Bu sadece basit bir egzersiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420136
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420136,
					"content": "Tabii daha zor olsun istersen altı okeanid de çağırabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420137
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420137,
					"content": "Bodurlop olsun! Bodurlop yeter!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420138,
						110420139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420138,
					"content": "Anlayamadım. Uğraşmaya değmeyecek gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420140,
					"content": "Peki. Hazır ol, bodurloplar gelmek üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420139,
					"content": "Su taklitçileri beni oradan oraya fırlatmasın yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420140
					]
				},
				{
					"id": 110420125,
					"content": "Paimon oltama takıldı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420126
					]
				},
				{
					"id": 110420119,
					"content": "Varsa da fark etmedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420120
					]
				},
				{
					"id": 110420113,
					"content": "Paimon'un asıl amacını anlayabildin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420114
					]
				},
				{
					"id": 110420109,
					"content": "Ben de onu merak ediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420110
					]
				}
			]
		},
