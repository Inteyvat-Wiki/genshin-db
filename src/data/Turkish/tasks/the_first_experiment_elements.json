			"dialogs": [
				{
					"id": 110420301,
					"content": "Eline sağlık. Tuhaf bir şey hissettin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420302
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420302,
					"content": "Yaralandıysan acil durumlar için elimde birkaç iksir var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420303,
						110420304
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420303,
					"content": "Çizik bile almadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				},
				{
					"id": 110420305,
					"content": "Harika. Gözlemlerime göre dış element akışı beklendiği gibi. Element tepkileri normal. Sıra dışı hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420306
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420306,
					"content": "Dış akışın normal olduğunu öğrendiğimize göre haydi iç akışı test edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420307,
					"content": "İç akış mı? Onu nasıl test edeceksin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420308,
					"content": "Çok basit. Simyayı kullanarak element gücünü çıkaracak bir iksir yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420309
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420309,
					"content": "Element gücü vücudunda depolanıyor veya fiziksel olarak birikiyorsa bu iksir bir element tepkimesine sebep olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420310,
						110420311
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420310,
					"content": "Midemde Girdap yapacak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420312,
					"content": "Ben biraz korktum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420313,
					"content": "Merak etme. Her şey yolunda giderse geçici bir bulantı hissedeceksin. Fiziksel bir sakatlık yaşamayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420314
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420314,
					"content": "Ya yolunda gitmezse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420315,
					"content": "Beklenmedik bir şey olursa diye gerekli hazırlıkları yaptım. Çok kafana takmamaya çalış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420316
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420316,
					"content": "Pek içimi rahatlatmadı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420317
					]
				},
				{
					"id": 110420317,
					"content": "Hiç risk yok diyemem. Ama iç akışını engelleyen bir şey varsa bu deney sayesinde nerede olduğunu bulabileceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420318
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420318,
					"content": "Küçük bir uyarı... Başka bir sebepten içinde bir element tepkimesi yaşarsan bu durum kötüye işarettir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420319
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420319,
					"content": "Yani bu sağlık kontrolü gibi bir şey.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420320
					]
				},
				{
					"id": 110420320,
					"content": "Evet! Öyle düşünmek çok daha iyi. Başlamadan önce... Deney için kullanacağımız iksirin bir katalizörü eksik. Bulmamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420321
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420321,
					"content": "Gümüş Yıldız olarak bilinen bir tür cevher. Ama ne yazık ki her Gümüş Yıldız bizim için uygun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420322
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420322,
					"content": "Sizi kampıma götüreceğim. Yolda biraz Gümüş Yıldız toplayabiliriz. Kullanabileceklerimizi size gösteririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420323
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420323,
					"content": "Her şey yolunda giderse kampa vardığımızda iksiri yapmaya başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420324
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420324,
					"content": "Paimon hâlâ güvenli olup olmadığına emin değil ama iyi de bir yanı var gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420325,
					"content": "Dikkatli olalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420311,
					"content": "Midemde Kristalleşecek mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420312
					]
				},
				{
					"id": 110420304,
					"content": "Sadece biraz üşüdüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420305
					]
				}
			]
		},
		{
			"id": 1104205,
			"completionStepIds": [
				1104205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104205",
							"2"
						],
						"stepId": 1104205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Albedo"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110420501,
					"content": "Kampım burası. Topladığımız malzemeleri karışıma ekledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420502
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420502,
					"content": "Beklerken size göstermek istediğim bir şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420503
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420503,
					"content": "Asistanım Timaeus araştırmama yardım ediyor. Mondstadt'ta tanışmışsınızdır diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420504
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420504,
					"content": "Merhaba, az önce deneyinizin verilerini toparladım. Raporu tabloya astım bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420505
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420505,
					"content": "Vay be! Şu verilere bak! Bütün bu sonuçları bir bodurlop dövüşünden mi çıkardın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110420506,
					"content": "Haha, bunlar pek sonuç sayılmaz. Bazı çıkarımlar ve birkaç cüretkar tahmin denilebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420507
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420507,
					"content": "Bence en rasyonel olan Gezgin ve bodurloplar arasındaki filogenetik ilişkiyi açıklamaya yönelmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420508,
						110420509
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420508,
					"content": "Rasyonel mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				},
				{
					"id": 110420510,
					"content": "Şöyle düşün; Önsezin yok ama elementlerin enerjisini kontrol edebiliyorsun. Bodurlopların da Önsezisi yok ama onlar da elementleri kontrol edebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420511
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420511,
					"content": "Bu fikir üzerinden ilerleyerek gerçeğe yönelik bir temel oluşturabileceğimize eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420512
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420512,
					"content": "Fena bir bakış açısı değil ama aslına bakarsak bodurloplar element tabanlı yaşam biçimleri. Yani tamamen elementlerden oluşan varlıklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420513
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420513,
					"content": "Yalancı Buz Ağacı, hatta Yalancı Çiçek daha iyi bir benzetme olabilir. Fakat bitkilerle hayvanlar arasındaki filogenetik ilişkilerin kökenini incelemek... Dünyanın oluşumuna kadar dönmen gerekebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420514
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420514,
					"content": "Öyle düşününce işler biraz zorlaşabilir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420515
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420515,
					"content": "Evet efendim. Haklısınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420516
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420516,
					"content": "Sonuçta en önemli veri elimizde. Bu Gezgin başka bir dünyadan gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420517
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420517,
					"content": "Eğer bu dünyayla filogenetik bir ilişkisi olduğu ortaya çıkarsa... Gerçekten büyük bir gelişme olurdu, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420518
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420518,
					"content": "Aaa evet öyle! Kusura bakmayın, veriyi bulmak için çok sabırsız davrandım. Bir dahakine daha yavaş olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420519
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420519,
					"content": "Veri demişken... Araştırmamızı bitirmek için biraz daha veriye ihtiyacımız var. Ben şimdilik burada analiz yapıyor olacağım. Gelişmeler hakkında bilgi edinmek isterseniz beni burada bulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420520
					],
					"speakerTitle": "Timaeus"
				},
				{
					"id": 110420520,
					"content": "Harika. Öyleyse seni tutmayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110420521
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420521,
					"content": "Hımm... Görünüşe göre iksir hazır. Önce ben biraz içeceğim. Sorun çıkmazsa size vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 110420509,
					"content": "Bana sorarsan Paimon'la aramda daha fazla benzerlik vardır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110420510
					]
				}
			]
		},
		{
			"id": 1104206,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
