			"dialogs": [
				{
					"id": 223060801,
					"content": "Az daha unutuyordum, bu Hazine Haritalarını nasıl okuyacağını biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060802
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060802,
					"content": "Açıkçası bunları ilk aldığımda ne yapacağıma dair hiçbir fikrim yoktu. Ben de birkaç kişiye sordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060803
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060803,
					"content": "Hazinenin nerede olduğunu aşağı yukarı çözdüler ama gidip hazineyi arayacak olursam, onlara da ödeme yapmam gerektiğini söylediler... Bu yüzden ben de hiç gidip aramadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060804
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060804,
					"content": "İşin kolaylaşacaksa konumlarını senin için işaretleyebilirim, söylemen yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060805
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060805,
					"content": "Ama bunun için ödeme yapman gerekir... <color=#00E1FFFF>100 Mora</color> diyelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060806
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223060806,
					"content": "Ne dersin? Hazine Haritalarının <color=#00E1FFFF>konumunu işaretleyeyim mi?</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bolai"
				}
