			},
			"dialogs": [
				{
					"id": 111200401,
					"content": "Dai Amca! Biz geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200402,
					"content": "Ah! Bahsettiğiniz arkadaşınız bu olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200403
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200403,
					"content": "Evet! Paimon taş uzmanının kim olduğunu bilmiyor ama arkadaşımızla boy ölçüşemeyeceğini biliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200404,
					"content": "Haha, bu kadar övgüye gerek yok ama alanda tecrübem olduğunu söyleyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200405
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200405,
					"content": "Demek öyle. Adamım geldiğinde göreceğiz o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200406
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200406,
					"content": "Ondan övgüyle bahsetmeme gerek yok, gelince kendiniz anlarsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200407
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200407,
					"content": "Ah... Doğru yerde miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200408
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200408,
					"content": "Aha! İyi insan lafının üstüne gelirmiş! Tanıştırayım, yardımcım Kun Jun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200409
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200409,
					"content": "Kun, bu iki maceracı loncadan geldi. Bu beyefendi ise...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200410
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200410,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200411
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200411,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200412
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200412,
					"content": "İsmi Zhongli, cenaze evinden bir danışman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200413
					]
				},
				{
					"id": 111200413,
					"content": "Wangsheng Cenaze Evinin danışmanı... Bay Zhongli! Bilgin ve marifetli biri olduğunuzu duymuştum. Sizinle bizzat tanışacağımı hiç düşünmüyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200414
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200414,
					"content": "Ben... Seni bir yerden hatırlıyorum. İş yerinde mi tanıştık? Yok, hiç iş yerine gitmedim ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200415
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200415,
					"content": "Dai Amca, onları denemeyecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200416,
					"content": "Demek planın buydu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200417
					]
				},
				{
					"id": 111200417,
					"content": "Ha? Ne... Nereden başlasam bilemedim şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200418
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200418,
					"content": "Onlar hünerlerini karşılaştıracak bir yol bulurlar! Zhongli kazanırsa yardımcımız o olur. Kaybederse de, ah... Neyse, Zhongli kaybetmeyecek nasılsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200419,
					"content": "Bir yarışma mı? Büyük bir zevkle katılırım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200420
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200420,
					"content": "Hevesinizi takdir ediyorum beyefendi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200421
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200421,
					"content": "Haha! Gerçekten bu alanda uzman birisine benziyorsun. Hangimizin kazanacağını görmek için sabırsızlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200422
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200422,
					"content": "Konuşmayı bırakın da başlayın artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200423,
					"content": "Sadece gördüğümü söylüyorum... Bahsetmeye değer tek yeteneğim de bu gerçi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200424
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200424,
					"content": "Siz eksper misiniz Bay Kun Jun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200425
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200425,
					"content": "Hayır... Aslında Liyue Limanı'na niye geldiğimi çoktan unuttum. Bir gün yolun kenarında dururken Dai Amca beni yanına çağırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200426
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200426,
					"content": "Elimdeki taşı görünce birkaç soru sordu. Oldukça heyecanlı görünüyordu, hatta bir süre yanımdan ayrılmadı. Sonra da burada buluşalım dedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200427
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200427,
					"content": "İlginç! Böyle bir şeyi nasıl unutursun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200428,
					"content": "Liyue Limanı'na giderken gördüm onu, taşları inceleyip kendi kendine mırıldanıyordu. Onlara aşina gibi duruyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200429
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200429,
					"content": "Ben de meraktan birkaç soru sordum. Madenlerde ustabaşıyım ama benden daha çok şey biliyordu! Çok acil bir işi olmadığından bana yardım etmeyi kabul etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200430
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200430,
					"content": "Peki... Hafızan zayıf mıdır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200431,
					"content": "Pek değil. Neyse, taşlarla ilgili yardım gerekirse mutlaka yardımcı olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200432
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200432,
					"content": "Bay Zhongli, bu taş nedir sizce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200433
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200433,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200434
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200434,
					"content": "Dış yüzeyi parlak. Sadece yanardağ patlaması sonucu oluşabilecek bir çatlağı var. Yanılmıyorsam başka bir bölgeden gelen, işlenmemiş bir mücevher bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200435
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200435,
					"content": "Ah... Gözünüz keskin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200436
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200436,
					"content": "Bu sıradan bir mücevher değil. Hassas yüzey, siyah damar örgüsü... İç kısmında yüksek kaliteli kristal cevher olduğunu tahmin ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200437
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200437,
					"content": "Olağanüstü. Bu taş gerçekten de bir yanardağ yakınlarında bulunmuş. Pazarda görür görmez aldım. Satıcı, atölye kalıntısı olduğunu düşünmüş ama içinde servet yattığından haberi yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200438,
						111200439
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200438,
					"content": "Kristal Cevher her yerde bulunmuyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				},
				{
					"id": 111200440,
					"content": "Sadece saflığına ve jeolojik nadirliğine bakarak servet değerinde olduğunu söyleyemeyiz. En değerli kristallerden bazıları su ve kum birikintileri içerir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200441
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200441,
					"content": "Bu taş kabuğun içindeki kristal oluşmadan önce içine bir miktar su girmiş. Suyun, kristalin derinlerine süzülerek dağın ardına gizlenmiş, üzerine düşen ışık hüzmelerini yansıtan bir ay gibi parlaması... Onu nadir bir hazine yapan şey işte bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200442
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200442,
					"content": "Ne kadar ayrıntılı anlattı öyle, kendi gözleriyle görmüş gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200443,
					"content": "Gözümüzü boyamaya çalışmıyorsun, değil mi? Daha içinde ne olduğunu görmedik sonuçta!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200444
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200444,
					"content": "Söyledikleri doğru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200445
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200445,
					"content": "Çoğu kristal, yüksek sıcaklık ortamında oluşur. Su ve ısı normal şartlarda pek iyi anlaşmazlar tabii. İşte bu yüzden su birikintili kristaller daha çok rağbet görür. Bu kristalin farkı ise içinde dağ gölü suyu olmasıdır. Gerçekten çok nadir bir örnek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200446
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200446,
					"content": "Zhongli öyle diyorsa doğrudur o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200447,
					"content": "Sizin kadar dirayetli biriyle hiç karşılaşmamıştım Bay Zhongli. İçinde ne olduğunu nasıl anladınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200448
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200448,
					"content": "Zamanında bunun gibi taşlardan çok gördüğüm için anında tanıdık geldi. Tecrübemi konuşturmamı sorun etmezsiniz umarım Bay Kun Jun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200449
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200449,
					"content": "Tabii ki etmem! Bugün anlaşabileceğim, saygıdeğer biriyle tanışmış oldum. Umarım arkadaşım olmayı kabul edersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200450
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200450,
					"content": "Dai Amca, Bay Zhongli aramıza katılmazsa cidden yazık olur! Bu konuda bana güven, piyasada onun uzmanlığıyla yarışabilecek kimse yok. Onun kadar kabiliyetli biri bir daha çıkmaz karşına.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200451
					],
					"speakerTitle": "Kun Jun"
				},
				{
					"id": 111200451,
					"content": "Pekala, ne kadar çok kişi olursak o kadar iyi! Kanyon'a kadar beni takip edin. Bulunmayı bekleyen kişiler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200439,
					"content": "Bu taşı özel yapan nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200440
					]
				}
			]
		},
