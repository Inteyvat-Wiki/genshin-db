			"dialogs": [
				{
					"id": 111200301,
					"content": "Son öykümüzde Rex Lapis...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200302
					],
					"speakerTitle": "Demir Dil Tian"
				},
				{
					"id": 111200302,
					"content": "Zhongli! Buradasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200303,
					"content": "Ah!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200304
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200304,
					"content": "Öykü dinlemeye mi geldiniz? Konuya merakınız olduğunu bilmiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200305
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200305,
					"content": "Ah, yok, senin için geldik! Vaktin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200306,
					"content": "Vakitten bol ne var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200307,
						111200308
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200307,
					"content": "Biz bir görev aldık da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				},
				{
					"id": 111200309,
					"content": "Jeolojiden ve cevherlerden anlayan biri lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200310,
					"content": "Hımm... Jeolojiden ve cevherlerden anlayan biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200311
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200311,
					"content": "Ah... Etrafına bir bak! Teyvat'ta bu işe uygun başka biri var mı sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200312,
					"content": "Görevi talep eden kişi Teyvat'ın en iyi taş uzmanını getirtmiş ama Paimon o adamın söylediklerine inanmıyor. Taşlar konusunda senden iyi kimse olamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200313,
					"content": "Dediklerini benim adıma fazla ciddiye almışsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200314
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200314,
					"content": "Ah, hayır... Sadece... Dai Amca ne dediğini bilmiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200315,
					"content": "Paimon sadece... Bilsin istedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200316,
					"content": "Hahaha. Anladım. O zaman size seve seve eşlik ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200317
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200317,
					"content": "Cidden mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200318,
					"content": "Ama şunu diyeyim, uzmanlık alanım olsa da... Alanımda en iyisi olduğumu iddia edemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200319
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200319,
					"content": "Uçsuz bucaksız bir irfan denizinde yüzeriz daima. Yeni bilgilere her zaman kucak açmalıyız. Yine de bu görevde size yardım edeceğim, bir uzmanla karşılaşırsak da onun deneyimlerinden faydalanmak isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200320
					],
					"speakerTitle": "Zhongli"
				},
				{
					"id": 111200320,
					"content": "Bu kadar alçak gönüllü olma Zhongli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200321,
					"content": "Onu ikna ettik! Dai Amca'ya geri dönelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200308,
					"content": "Özel bir iş var da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200309
					]
				}
			]
		},
