			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dai Amca"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111200201,
					"content": "Hey! Dai Amca sen misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200202,
					"content": "Evet, benim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200203
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200203,
					"content": "Ah, Loncanın gönderdiği maceracılar siz olmalısınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200204
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200204,
					"content": "Nereden anladın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200205,
					"content": "Giydiğiniz kıyafetlerden ve bakışlarınızdan. Deneyimli maceracılar olduğunuza bahse girerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200206
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200206,
					"content": "Yine bildin! Gözlerin keskin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200207,
					"content": "Bu işte gözlerin sadece taşlara değil, insanlara karşı da keskin olacak. Dai Amca'nız gerçekte kim olduğunuzu uzaktan gördüğü an anladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200208
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200208,
					"content": "Pekala, yardımcım birazdan burada olur, gelmesini bekleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200209
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200209,
					"content": "Bir saniye, biz iş için buradayız zaten! Görevi alan başkaları da mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200210,
					"content": "Açıkçası bu biraz karmaşık bir mesele. Maceracılar tek başlarına halledemezler maalesef.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200211
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200211,
					"content": "Başkasını getirdiniz demek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200212,
					"content": "Bu işi halledemeyeceğimizi mi düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200213,
						111200214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200213,
					"content": "Sakin ol Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				},
				{
					"id": 111200215,
					"content": "Olayın tamamını bilmiyorsunuz sanırım. Söz konusu kaza bir madende oldu ama sıra dışı bir şekilde gerçekleştiğini söyleyebilirim. Madenler tehlikeli yerlerdir, biliyorsunuz. Bu yüzden en kötü ihtimale karşı bu alanda uzman birini göreve çağırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200216
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200216,
					"content": "Maceracılar cevher tetkiki ve jeolojik analiz konularında uzman olmayabilir diye biliyorum. Yanınızda uzman biri varken işler yolunda gidecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200217
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200217,
					"content": "Üstelik bu adam işinin ehli. Ne tür bir taş olursa olsun bir bakışta değerini ve kaç Moraya satılabileceğini söyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200218
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200218,
					"content": "Teyvat'ta taşları onun kadar iyi bilen biri yok, o kadar kesin konuşuyorum. Onun kadar yetenekli birini çağırmamak aptallık olurdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200219
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200219,
					"content": "Teyvat'ın en iyi taş uzmanını bulduğunu düşünüyorsan yanılıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200220,
					"content": "Ah, Neden peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200221
					],
					"speakerTitle": "Dai Amca"
				},
				{
					"id": 111200221,
					"content": "Çünkü Teyvat'ın en iyi taş uzmanı bizim bir arkadaşımız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200222,
					"content": "Bahsettiğin kişi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200223
					]
				},
				{
					"id": 111200223,
					"content": "(Güzel, benim de ona soracaklarım vardı.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200224
					]
				},
				{
					"id": 111200224,
					"content": "Beklemiyordun, değil mi? Burada bekle, onu alıp geleceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200214,
					"content": "Paimon, gözünü hırs bürüdü yine.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111200215
					]
				}
			]
		},
