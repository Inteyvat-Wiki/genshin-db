			"dialogs": [
				{
					"id": 111200101,
					"content": "Hey Katheryne, biz geldik! Yeni görev var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200102,
					"content": "Aslında tam ikinize uygun bir görev var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200103,
					"content": "Liyue Limanı'ndaki Huishan Salonunun orada bir ustabaşı var, Dai Amca. Maceracılar Loncasının birilerini göndermesini istemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200104,
					"content": "Tam olarak ne yapmamız gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200105,
					"content": "Sanırım bazı işçileri bulmanız gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200106,
					"content": "Ah, birilerini bulmak... O konuda bizden iyisi yok! Mükemmel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 111200107,
					"content": "Kabiliyetlerinizden hiç şüphem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111200108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 111200108,
					"content": "Ayrıntıları onunla yüz yüze konuşursunuz zaten. Görevi kabul ediyorsanız limana gidip Dai Amca ile görüşün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 1112002,
			"completionStepIds": [
				1112002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
