			"dialogs": [
				{
					"id": 102030101,
					"content": "*iç çeker* Klee sıradan bir çocuk değildir, hatta aramızda Kıvılcım Şövalyesi olarak anılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030102
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030102,
					"content": "Mümkün değil! Klee bile bir Favonius Şövalyesi demek ha, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030103,
						102030104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030103,
					"content": "Paimon kıskanmış olmalı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102030105
					]
				},
				{
					"id": 102030105,
					"content": "Evet! Paimon haksızlığa uğradığını düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030106,
					"content": "Aslında Klee'nin hazinesini göz önünde bulundurursak çok da mantıksız gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 102030107,
					"content": "Evet. Favonius Şövalyelerinin yaşadığı sıkıntıların önemli bir kısmı onun başının altından çıkıyor olsa da o bizim için fazlasıyla değerli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030108
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030108,
					"content": "Geçmişine bakacak olursak da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030109
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030109,
					"content": "Özetle zamanla onu daha iyi tanıyacağınıza eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102030110
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030110,
					"content": "#Lütfen gözünü ondan ayırma, {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jean"
				},
				{
					"id": 102030104,
					"content": "\"Fahri Şövalye\"den daha etkileyici.",
