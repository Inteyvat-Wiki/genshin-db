			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "Hımm... Paimon'a mı öyle geliyor, yoksa Natlan'daki Yedilerin Heykelleri biraz tuhaf mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970102,
					"content": "İlk dokunduğun anda daha yoğun bir enerji hissetmen gerekmez miydi? Şöyle \"BIZZ\" diye bir ses çıkması falan gerekirdi mesela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970103,
					"content": "Bana normal geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "Paimon'un cidden tuhafına gitti ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970108,
					"content": "Paimon nasıl anlatsa bilemedi ama şunu demek istiyor... Eskiden heykellere dokunduğunda aranızda daha güçlü bir bağ olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970109,
					"content": "Bu sefer bir düğmeye basıyormuşsun gibi sanki. Heykele dokunduğunda sadece yanıveriyor, o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970110,
					"content": "Evet, evet... Eskiden Heykellere dokunduğunda element gücünü hissederdin. Nedense bu seferki bir değişik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970111,
					"content": "Ateş elementini hissedebiliyor musun mesela? Yoğun, canlı bir his var mı hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970112,
					"content": "(Ne hissettiğine odaklanmaya çalışıyorsun...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "Nasıl yani? Hiçbir şey yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970115,
					"content": "Bu işte bir tuhaflık var, orası belli oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970113,
					"content": "(O beklediğin yakıcı his yok...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "O sesi hep ben çıkarıyordum aslında.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "Aa! Bu sefer \"BIZZ\" demeyi unuttun demek. Bir dahakine dikkatli ol da böyle şeyleri unutma lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970107,
					"content": "... HADİ ORADAN! Paimon o kadar kolay affeder mi sandın? Bundan sonra Yedilerin Heykeline her dokunduğunda ses efekti çıkaracaksın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7509702,
			"completionStepIds": [
				7509706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
