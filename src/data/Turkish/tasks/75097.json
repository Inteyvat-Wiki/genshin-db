				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970201,
					"content": "... Evet, evet. Bir bityeniği olduğu ayan beyan ortada. Yedilerin Heykelinden element gücünü alamıyor musun hâlâ?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970202,
					"content": "Of ya! Nesi var bu Heykellerin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970203,
						750970206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970203,
					"content": "Eskimiştir belki, bakım zamanı falan gelmiştir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970204
					]
				},
				{
					"id": 750970204,
					"content": "İyi ama dokunduğunda parladı işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970205,
					"content": "Hişt! Sana diyoruz Yedilerin Heykeli! Orada dikilip durmayı bırak da çalış artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970208,
					"content": "Paimon'un kafası basmadı açıkçası bu işe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970206,
					"content": "Belki de Natlan'a özel bir durumdur bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970207
					]
				},
				{
					"id": 750970207,
					"content": "Şimdi sen böyle deyince Paimon da düşündü de... Natlan sürekli Hiçliğin etkisindeymiş galiba. Sebebi bu olabilir mi dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "Paimon"
				}
			]
		},
