				"points": []
			},
			"dialogs": [
				{
					"id": 750970301,
					"content": "Hehe, işte budur! Yedilerin Heykeli ile kurmak istediğimiz sağlam bağlantı işte bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970302,
					"content": "Demek önceden yaşadığımız sorun, Gece Krallığı'ndaki kötülük yüzündenmiş. Yedilerin Heykeli o zaman epey zor bir dönem geçiriyordu herhalde... Bravo sana Heykel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970303,
					"content": "Ama Ateş ile etkileşime girme gücünü istesen de veremezdin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970304,
					"content": "Evet, Ateş Hükümdarı'nın yanında savaşırken oldu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970305
					]
				},
				{
					"id": 750970305,
					"content": "Paimon acayip korkmuştu o an... Ama neyse ki çok güçlüymüşsün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750970306,
					"content": "Ne olursa olsun, tüm o Hiçlik yaratıklarını defedip Heykelleri kurtarmamız harika oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
