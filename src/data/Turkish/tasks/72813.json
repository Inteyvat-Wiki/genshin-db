					"Kaushik"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728130701,
					"content": "Bu totemin anlamı... Hımm. Gezgin, beni mi arıyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130702
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130702,
					"content": "Alrani hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130703
					]
				},
				{
					"id": 728130703,
					"content": "Alrani mi gelmiş? Watatsumi Adası'na mı? Tuhaf. Ne işi varmış burada? Liyue'de olması gerekmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130704
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130704,
					"content": "Askerler Alrani'yi tutukladı da.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130705
					]
				},
				{
					"id": 728130705,
					"content": "Ne? *iç çeker* Tabii ya. Bu zamanda Watatsumi Adası'na gelirse şüphelenirler tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130706
					],
					"speakerTitle": "Kaushik"
				},
				{
					"id": 728130706,
					"content": "Neyse. Hadi gidip şu dikkatsiz kıza yardım edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaushik"
				}
			]
		},
		{
			"id": 7281308,
			"completionStepIds": [
				7281309
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
