			"dialogs": [
				{
					"id": 728130501,
					"content": "Orada kal. Sakın hareket etme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130502
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130502,
					"content": "Etmiyorum! Açıklamamı istediniz, ben de Akademiden bir araştırmacı olduğumu söyledim işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130503
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130503,
					"content": "Gübre reklamı yaptığını söylememiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130504
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130504,
					"content": "Akademiden bir araştırmacı gübre reklamı yapamaz mı yani? Bir dinleseniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130505
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130505,
					"content": "Bu o mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130506
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130506,
					"content": "Evet komutanım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130507
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130507,
					"content": "Etrafta sinsice dolaşıp sürekli not alırken yakaladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130508
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130508,
					"content": "Şogunluk casusu olduğunu düşünüyorum komutanım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130509
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130509,
					"content": "Casus değilim! Dediğiniz gibi de olmadı! Dedim ya, araştırmacıyım! Tezim için kaynak topluyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130510
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130510,
					"content": "Kes! Tez yazmak için savaş alanına girildiği nerede görülmüş? Belli ki başka bir iş çeviriyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130511
					],
					"speakerTitle": "Hiroyuki"
				},
				{
					"id": 728130511,
					"content": "Tezim dışında ne gibi bir işim olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130512,
						728130513
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130512,
					"content": "Sen miydin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				},
				{
					"id": 728130514,
					"content": "Gezgin! Çok şükür! Lütfen şunlara kötü biri olmadığımı söyle! Sadece tezimi yazmaya geldim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130515
					],
					"speakerTitle": "Alrani"
				},
				{
					"id": 728130515,
					"content": "Tanıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130516
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130516,
					"content": "Öyle denebilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130517
					]
				},
				{
					"id": 728130517,
					"content": "\"Mezuniyet\" olayı Sumerulu araştırmacıları bu kadar delirtiyor mu gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130518
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130518,
					"content": "Söylediklerine bakılırsa pek arkadaş sayılmazsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130519
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130519,
					"content": "Sumerulu bir araştırmacı olduğunu da sana o söyledi değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130520
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130520,
					"content": "Doğru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130521
					]
				},
				{
					"id": 728130521,
					"content": "Ne yazık ki sunduğu kanıtlar pek inandırıcı gelmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130522
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130522,
					"content": "Ama sen kefil oluyorsan eminim kötü biri değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130523
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130523,
					"content": "Bir öneride bulunabilir miyim komutanım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130524
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130524,
					"content": "Kaushik'i hatırlıyor musunuz? Adamızın kültürünü ve tarihini inceleyen araştırmacı var ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130525
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130525,
					"content": "Bunca zamandır buradaydı ve hiç sorun çıkarmadı. Bu gübre satan kadının gerçek bir araştırmacı olup olmadığını ona sorsak olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130526
					],
					"speakerTitle": "Ookubo Daisuke"
				},
				{
					"id": 728130526,
					"content": "Mantıklı aslında. Zahmet olmazsa Kaushik'i buraya getirebilir misin Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130527
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130527,
					"content": "Bir sorun çıkarsa diye ben burada kalıp gübre satıcısının başında bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728130528
					],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130528,
					"content": "Peki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130529
					]
				},
				{
					"id": 728130529,
					"content": "O zaman o iş sende. Mümkün olduğunca çabuk gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gorou"
				},
				{
					"id": 728130513,
					"content": "Alrani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728130514
					]
				}
			]
		},
