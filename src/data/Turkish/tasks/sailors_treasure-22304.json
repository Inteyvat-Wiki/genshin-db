					"nextDialogs": [
						223040302
					]
				},
				{
					"id": 223040302,
					"content": "Tamamdır... Al bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040303
					],
					"speakerTitle": "Bolai"
				},
				{
					"id": 223040303,
					"content": "Kolay gelsin. Hazineyi bulduğunda buraya getirmeyi unutma... Anlaştığımız gibi üçe böleceğiz.",
					"roleType": "TALK_ROLE_NPC",
