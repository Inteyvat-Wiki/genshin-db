			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhang Shun"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223040101,
					"content": "Hımm, ne yapsam, ne yapsam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040102
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040103
					]
				},
				{
					"id": 223040103,
					"content": "Talihsiz bir kaza geçirmeden önce Güneyhaçı'nda gemiciydim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040104
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040104,
					"content": "Donanmayı bıraktıktan sonra paraya ihtiyacım oldu, ben de Hazine Haritalarını sattım. Hepsini buralı iş insanı Bolai'a verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040105
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040105,
					"content": "Anlaşmamız, bulunan her hazineden pay almam yönündeydi ama o zamandan beri ondan hiç haber almadım. Hazineleri aramaya tenezzül bile etmediğini düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040106
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040106,
					"content": "Böyle oturup beklemeye devam edemem. Benim için hazineyi bulmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040107,
						223040109,
						223040116
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040107,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040108
					]
				},
				{
					"id": 223040108,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040120
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040120,
					"content": "<color=#00E1FFFF>Bolai'ı</color> ziyaret edip <color=#00E1FFFF>Hazine Haritalarını</color> alarak başla. Sonra <color=#00E1FFFF>hazineyi</color> bulup <color=#00E1FFFF>ona götür</color>.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040121
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040121,
					"content": "Ben kendisiyle konuştum, benim payımı saklayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040109,
					"content": "Donanmadan neden ayrıldın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040110
					]
				},
				{
					"id": 223040110,
					"content": "Eski yaramın tekrar açılıp sorun oluşturabileceğini fark ettim. Bu durumun, tayfanın geri kalanını riske atmasına izin veremezdim, ben de ayrıldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040111
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040111,
					"content": "Geçimimi sağlamak için donanma zamanında topladıklarımı satmaya başladım ama işler pek iyi gitmedi. Zaten kısa süre sonra satacak bir şeyim de kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040112
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040112,
					"content": "Tayfa olduğum zamanlarda topladığım ganimetlerden birkaç Hazine Haritam vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040113
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040113,
					"content": "Ama şimdi bu halimle sokakta yürümek bile çok zor... Bu halde çıkıp etrafta hazine arayacak halim yok ya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040114
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040114,
					"content": "Ben de bu haritaları rehin verdim, sonra da Bolai'a bir miktar nakit karşılığı sattım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040115
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040115,
					"content": "Ama kendisi de çıkıp hazine arayacakmış gibi görünmüyor. Sonuçta o bir iş insanı... İşte bu yüzden yardımına ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040107,
						223040116
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040116,
					"content": "Ne kadarlık bir hazineden bahsediyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223040117
					]
				},
				{
					"id": 223040117,
					"content": "Çok büyük bir hazine olacağını sanmıyorum. Bunlar, ganimetin geri kalanıyla birlikte mürettebat üyeleri arasında bölünmüş düşük değerli hazine haritalarıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040118
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040118,
					"content": "Donanma tayfasında tecrübeli olanlar, ciddi bir hazine olduğunda tespit edip buluyor ve gemiye getiriyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040119
					],
					"speakerTitle": "Zhang Shun"
				},
				{
					"id": 223040119,
					"content": "Bulacağımız hazineler ufak tefek olacaktır ama yine de bir şeyler eder. En azından üç kişiye yetecek kadar bölünebileceğine eminim... Hazine arayışında bol şans!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223040120
					],
					"speakerTitle": "Zhang Shun"
				}
			]
		},
