			"dialogs": [
				{
					"id": 760940501,
					"content": "Aa, bu mağarada kaybolan yabancı tüccarın arkadaşı değil mi? Sonunda onu dışarı çıkarmayı başardın demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940502
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940502,
					"content": "Hepimiz Tembel Koyunun taşıdığı tohumları daha uzaklara saçmak için seni takip ettiğini biliyoruz ama ne kadar açıklasak da o beyefendi buna inanmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940503
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940503,
					"content": "Doğrusu tüm bunlarla nasıl başa çıkacağımı bilemedim. Senin gibi yardımsever bir Maceracıyla karşılaşmam ne iyi oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940504
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940504,
					"content": "Al, minnettarlığımı göstermek adına ufak bir hediye...",
					"roleType": "TALK_ROLE_NPC",
