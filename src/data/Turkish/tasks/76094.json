			"dialogs": [
				{
					"id": 760940201,
					"content": "Harika. Bir çözüm bulacağını biliyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940202
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940202,
					"content": "Tembel Koyunlar Kuuvahki olmadan hayatta kalamaz ama en azından Nod-Krai'da kaldığı süre boyunca bu adama biraz huzur verebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940203
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940203,
					"content": "Artık gideyim. Al, minnettarlığımızı göstermek için ufak bir hediye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
