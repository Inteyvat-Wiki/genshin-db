			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Vacarao"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760940101,
					"content": "O adamı nasıl kurtaracağım şimdi? Ya sabır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940102
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940102,
					"content": "Benim yapabileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760940103
					]
				},
				{
					"id": 760940103,
					"content": "Hım? Aa, nazik bir maceracı! Tam zamanında geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940104
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940104,
					"content": "Şöyle ki, burada kuzeye giden bir tünel vardı ama geçenlerde Kuuvahkiyle alakalı bir anomaliden dolayı çöktü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940105
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940105,
					"content": "Neyse ki kimse yaralanmadı. Ama yurt dışından gelen bir gezgin tüccar, \"yoldaşının\" içeride kaldığını iddia ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940106
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940106,
					"content": "Yoldaş dediği de buralarda tanışıp arkadaş olduğu bir Tembel Koyun. Bu bölgede yeterince uzun süre kalırsan, Tembel Koyunların genellikle taşıdıkları tohumları saçmak için insanları takip ettiğini fark edersin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940107
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940107,
					"content": "Ama ne kadar açıklasak da o beyefendi dinlemek istemedi. Kurtarmak için bir yol bulmamızda ısrar etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940108
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940108,
					"content": "Mağaranın derinliklerine giden yolu yeniden birleştirmek için bu Dolaşık Çiçekleri kullanmamız gerekecek. Sorun şu ki ben Donuk Ayın Çocuklarının büyüsünü kullanamıyorum ve bu iş için yeterince kuvvetli bir Kuuvahki cihazım yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940109
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940109,
					"content": "İyi ki geldin. O Tembel Koyunu oradan çıkarabilecek biri varsa o da senin gibi bir maceracıdır herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760940110
					],
					"speakerTitle": "Vacarao"
				},
				{
					"id": 760940110,
					"content": "O beyefendi adına teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vacarao"
				}
			]
		},
