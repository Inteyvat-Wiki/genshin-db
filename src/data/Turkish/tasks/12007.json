					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070101,
					"content": "Yani burada yüce bir varlık mı yaşıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070102,
					"content": "Bırr... Burada biri yaşıyorsa neden bu kadar soğuk?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070103,
					"content": "Hımm... Ben de kendime aynı soruyu soruyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070104
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070104,
					"content": "Ne tuhaf, burasının annemin yazılarında bahsettiği yer olduğuna oldukça eminim ama sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070105,
						120070106
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070105,
					"content": "Yanlış gelmiş olamaz mıyız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				},
				{
					"id": 120070107,
					"content": "Hımm... Tereddüt etmeye başlıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070108
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070108,
					"content": "Ama madem buraya kadar geldik, içeri gidip kapsamlı bir keşif yapsak iyi olur bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070109
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070109,
					"content": "Evet, mantıklı. Kim bilir, belki de içeride bizi bekleyen bir sürpriz vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070110,
					"content": "Peki, şey... Defterde tam olarak ne yazıyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070111,
					"content": "Bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070112
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070112,
					"content": "\"Bir turna saçımı süslemek için gagasında <color=#00E1FFFF>1</color> taze çiçek getirir. Beyaz bir tavşan ay ışığının <color=#00E1FFFF>4</color> demetinden bir etek ucu diker. Düzgünce giyinip yüzümü <color=#00E1FFFF>doğuya</color> dönerim ve <color=#00E1FFFF>7</color> defa Tsubaki diye haykırırım. Göz açıp kapayıncaya kadar, kendimi onun evine giden yolda bulurum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070113
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070113,
					"content": "Peri masalına benziyor... Yani annen bir ayin yapıyordu ve Tsubaki öylece onunla buluşmaya mı geliyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070114,
					"content": "Bence gerçekten Adeptuslara benziyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070115
					]
				},
				{
					"id": 120070115,
					"content": "İçimde bunun bir tür şifre olduğuna dair bir his var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070116
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070116,
					"content": "Herhangi bir sonuca varmadan önce biraz daha yaklaşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070117
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070117,
					"content": "İyi fikir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070106,
					"content": "Belki de Tsubaki gerçekten bir tilki elçisidir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070107
					]
				}
			]
		},
		{
			"id": 1200702,
			"completionStepIds": [
				1200705
