					"Kamisato Ayaka"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120070301,
					"content": "*iç çeker* Burası olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070302
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070302,
					"content": "Pekala, hadi defterde ne yazdığına bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070303,
					"content": "Ah, Paimon gizemli hazine hakkında olduğuna bahse giriyor! Çok heyecanlı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070304,
					"content": "Şşt. Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070305
					]
				},
				{
					"id": 120070305,
					"content": "Ne var? Neden birdenbire fısıldamaya başladın? Paimon'u geriyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070306,
					"content": "Benimle gel. Şu tarafa gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070307
					]
				},
				{
					"id": 120070307,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070308
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070308,
					"content": "Aaa, Ayaka'nın, defteri dikkati dağılmadan okumasını istiyorsun. Sonuçta orada her ne yazıyorsa önemli olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070309,
					"content": "Ama şey, yüz ifadesine bakarsak... Muhtemelen bir hazine haritası değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070310,
					"content": "Hımm, ne olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070311,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070312
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070312,
					"content": "*uzun bir soluk verir*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070313
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070313,
					"content": "Gezgin, Paimon, sizi bu kadar beklettiğim için üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070314
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070314,
					"content": "Sorun değil, çok beklemedik! Hızlı okuyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070315,
					"content": "Defteri okumayı bitirdin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070316
					]
				},
				{
					"id": 120070316,
					"content": "Evet, bitirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070317
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070317,
					"content": "Sanırım bu defter hakkındaki gerçeği ikinizle de paylaşmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070318
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070318,
					"content": "Her ne kadar içeriği beklediğimden tamamen farklı olsa da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070319
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070319,
					"content": "Nasıl farklı? Yani, bunu yazan bir tilki elçisi değil miymiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070320,
					"content": "Tilki elçisi değilmiş, hayır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070321
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070321,
					"content": "Görünüşe göre Tsubaki gerçekte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070322
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070322,
					"content": "... Annemin ta kendisiymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070323
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070323,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070324,
					"content": "Şaşırdın mı? Ben de öyle... Ama defterin en başında yazan şey bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070325
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070325,
					"content": "Öhöm... \"Tsubaki ve ben aynı kişiyiz ama aynı zamanda farklı kişileriz. Tsubaki olduğumda Kamisato Kayo olmayı bırakıp dünyanın en sıradan kadını oluveriyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070326
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070326,
					"content": "\"Bu sayfalarda yazanlar normal bir insanın sıradan, günlük hayatıdır. Ne bir eksik, ne bir fazla.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070327
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070327,
					"content": "Bu defter çoğunlukla, annemin hem özel hem de havadan sudan düşüncelerinin yer aldığı bir koleksiyon. Tsubaki hakkında düşündüğümüz tüm şeyleri aslında annem hakkında düşünmüşüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070328
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070328,
					"content": "Yani... Demek ki kimono tasarımı, uluslararası yemekler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070329,
					"content": "Annemin denemek istediği şeylermiş, evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070330
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070330,
					"content": "Size bunun son derece tuhaf geldiğinden eminim ama en azından bana göre annemin bu davranışları tamamen anlaşılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070331
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070331,
					"content": "Yani başka bir şekilde ifade edeyim, aslında... Benim de bambaşka bir tarafım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070332
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070332,
					"content": "Defterde yazanları okumaya başladığımda ne yapacağımı bilmez durumdaydım... Sanki neredeyse... Biri zihnimi okuyup düşüncelerimi görüyor ve sonra onları yazıya döküyor gibiydi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070333
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070333,
					"content": "Ayaka...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070334
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070334,
					"content": "Annem babamla evlendiği andan itibaren, Kamisato hanesinin de annesi oldu ve bununla birlikte üstüne pek çok vazife yüklendi. Aynı zamanda, Yashiro Heyetinin prestiji de ona birtakım sorumluluklar getirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070335
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070335,
					"content": "Bu da yetmezmiş gibi, annemin attığı her adım Kamisato Klanını temsil ediyordu. İnsanlar daima onu izliyordu. Bu koşullar altında, annemin gerçekten istediği şeyleri yapacak kadar zamanı hiç olmuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070336
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070336,
					"content": "Ailem vefat ettikten sonra, Ayato ve ben klan işlerinin sorumluluğunu üstlendik. O zamanlar başımıza her türlü zorluk geliyordu... Klan dışındaki insanların bunun nasıl bir şey olduğunu anlayabileceğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070337
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070337,
					"content": "Zor bir sorunla her karşılaştığımda kendime şunu sorardım, \"Annem de bunu yaşamış mıdır? O bu durumda olsa ne yapardı?\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070338
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070338,
					"content": "Belki de onu son gördüğümden bu yana çok zaman geçtiği içindir ama... Her nasılsa, aklımda ondan geriye sadece hayranlık ve saygı uyandıran yanı kaldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070339
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070339,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070340
					]
				},
				{
					"id": 120070340,
					"content": "Ama... Annem hakkında düşündüklerim doğru değilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070341
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070341,
					"content": "Bu defteri okuyunca fark ettim ki... O da tıpkı benim gibiymiş. Üstlenmiş olduğu rolün altında aslında sıradan bir insanmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070342
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070342,
					"content": "Güzel kimonolar beğenmiş, farklı yerlerin yemeklerini denemek istemiş ve daha önce hiç görmediği yerleri görmeyi arzulamış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070343
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070343,
					"content": "Belki bu size biraz çocukça gelecek ama... Ben de aynı şekilde hissediyorum. Kamisato Ayaka olarak değil, sıradan bir kadın olarak yaşamak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070344
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070344,
					"content": "Annem her zaman bir Inazuma festivaline katılmak istediğini yazmış. Gökyüzünün açık olduğu bazı gecelerde, evimizden dışarıya doğru baktığında uzaktaki ışıkları görebildiğini söylerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070345
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070345,
					"content": "O ışıkları ben de gördüm! Bir sürü insanla beraber hayat dolu görünüyor ve o kadar parlak ki gökyüzünü aydınlatıyor... Tabii ki, asayiş açısından zaman zaman beni biraz endişelendiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070346
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070346,
					"content": "Ama benim konumumdaki birinin önden haber vermeden bir festivalde öylece görülmesi görgü kuralları açısından uygun olmaz. Özellikle de ebeveynlerimin zamanında, Yashiro Heyetinin halkla yakın bir bağı yoktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070347
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070347,
					"content": "Kimse bizi durdurmasa bile, Yashiro Heyetinden birinin kalabalığa karışması fikri... Kesinlikle tuhaf bakışları üzerine çekerdi. İnsanlar muhtemelen bir sorun olduğunu düşünmeye başlarlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070348
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070348,
					"content": "Annem insanların canını sıkmak istemediğini, herkesin festivalin keyfini çıkarmasını ve özgürlüğünü tatmasını istediğini söylerdi... Onları rahatsız etmek istemiyordu, zaten pek de boş zamanı olmuyordu, bu yüzden de hiç festivale gitmedi. Bir kere bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070349
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070349,
					"content": "Ay... Yani o kimono tasarımı, bir gün festivale gidecek olursa annenin giymeyi planladığı kıyafetti, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070350
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070350,
					"content": "Aynen öyle. Bazı zamanlarda festivaller uluslararası yiyecekler satar. Onları da denemek istiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070351
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070351,
					"content": "Umarım bunu söylememi saygısızca bulmazsınız ama... Annemin içindeki çocukla bu kadar yakın olduğunu bilmiyordum, haha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070352
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070352,
					"content": "Hiç de saygısızca değil! Paimon, annenin özünde yufka yürekli, dışında ise büyük sorumluluk sahibi biri olarak bu iki rolü de çok iyi üstlendiğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070353
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070353,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070354
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070354,
					"content": "Farkında bile olmadan annemin dileklerinden bazılarını çoktan gerçekleştirdim. *iç çeker* Ama onun için yapamayacağım tek şey festivale gitmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070355
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070355,
					"content": "Belki de asla gerçekleşemeyecek olan tek şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070356,
						120070357
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070356,
					"content": "Sen zaten çok şey başardın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				},
				{
					"id": 120070358,
					"content": "Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070359
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070359,
					"content": "Teşekkür ederim. Sanırım bir şeyi şimdi fark ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070360
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070360,
					"content": "Annem ve ben birçok yönden birbirimize çok benziyoruz. Onun yüzleştiği şeyler aslında benim de yüzleşeceğim şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070361
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070361,
					"content": "O, yerine getiremediği dileklerini Tsubaki kimliğine aktarmayı tercih etmiş. Bana gelince... Ben de kararımı verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070362
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070362,
					"content": "Ah! Yoksa sen de mi bir alt kimlik oluşturacaksın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070363
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070363,
					"content": "Hayır, şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070364
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070364,
					"content": "Öyle bir şey yapmayı planlamıyorum. Sanırım... Kendime yeni bir hedef belirledim ve bu da her günü pişmanlık duymadan yaşamak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070365
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070365,
					"content": "Bu yüzden şey... Gezgin, ben... Öhö...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070366
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070366,
					"content": "Derin nefes al Ayaka, derin nefes al...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070367
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070367,
					"content": "*iç çeker* Inazuma festivaline göz atmaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070368
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070368,
					"content": "Paimon o afişi gördüğümüzden beri festivale gitmek için ölüp bitiyor! Paimon, Ayaka'yla gitmeyi çok ister!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070369
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070369,
					"content": "Yani, daha önce hiç festivale gitmedin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070370
					]
				},
				{
					"id": 120070370,
					"content": "Hey dalga geçmesene! O sadece annemle aynı endişeleri taşıdığım içindi... Ama artık o kadar endişelenmem gerektiğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070371
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070371,
					"content": "Kendime karşı dürüst olacağım ve annemle paylaştığımız bu dileği yerine getireceğim. Bu konuda kendi yolumu seçmemi o kadar insan içinde bir siz anlayabilirsiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070372
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070372,
					"content": "Yani... Hadi o zaman, beraber Festivale gidiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070373
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070373,
					"content": "Sana katılmayı çok isterim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070374
					]
				},
				{
					"id": 120070374,
					"content": "Paimon gelmek istiyor! Festivalde bir sürü leziz atıştırmalık da var, değil mi? Ah, eğlence ve oyunlar da var. Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070375
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070375,
					"content": "Harika! Teşekkürler çocuklar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070376
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070376,
					"content": "Şimdi gidersek hâlâ zamanında yetişebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120070377
					],
					"speakerTitle": "Kamisato Ayaka"
				},
				{
					"id": 120070377,
					"content": "Ah, doğru diyorsun. Bugün son gün, değil mi? O zaman ne bekliyoruz? Haydi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120070357,
					"content": "Bu senin hatan değil, sadece hayat böyle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120070358
					]
				}
			]
		}
	]
}