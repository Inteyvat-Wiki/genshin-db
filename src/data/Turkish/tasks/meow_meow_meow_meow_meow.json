			"dialogs": [
				{
					"id": 230120301,
					"content": "Ah, kediyi geri getirmişsiniz. Çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120302
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120302,
					"content": "Kedilerin dilini epey çözmüş gibisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120303
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120303,
					"content": "İşte, lütfen çabalarının karşılığı olarak bunu kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120304
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120304,
					"content": "Kedilerin dilini bu kadar hızlı öğrenen çok kişi yok. Belki ileride senden tekrar yardım isteyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120305
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120305,
					"content": "Miyav!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230120306
					]
				},
				{
					"id": 230120306,
					"content": "Hey, normal konuşabilirsin. Bayan Sareh kedi değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230120307,
					"content": "Yüzünden \"rica ederim\" dediğini anlayabiliyorum ama bence yine de telaffuzunu biraz daha geliştirmelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230120308
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230120308,
					"content": "Sorun değil gerçi. Sana kedilerin dilini öğretmeye devam edeceğim. Birlikte öğreneceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				}
			]
		},
