			"dialogs": [
				{
					"id": 230121101,
					"content": "Şey, ben daha önce de kedilerle konuştum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121102
					]
				},
				{
					"id": 230121102,
					"content": "Neko'dan mı bahsediyorsun? O bizim dilimizi konuşabiliyor. Yani o tam olarak \"kedilerle konuşmak\" sayılmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121103,
					"content": "Evet ama karşılığında bir kedi bulmama yardım edeceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121104,
						230121105
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121104,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121108
					]
				},
				{
					"id": 230121108,
					"content": "Yani kabul ediyor musunuz? Çok teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121109
					],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121109,
					"content": "Öhöm... Şimdi, beni iyi dinle. Bu, uzun zamandır üzerinde çalıştığım kedi dilinin genel taslağı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sareh"
				},
				{
					"id": 230121105,
					"content": "Görünüşe göre her şehrin kendine has bir kedi arama tarzı var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230121106
					]
				},
				{
					"id": 230121106,
					"content": "Hehe, doğru! Şimdi düşündüm de, gerçekten birçok şehirde bir sürü kişinin kedisini bulmasına yardımcı olduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230121107,
					"content": "Acaba herkes kedileri çok mu seviyor? Yoksa kedisi olan herkes bu sorunu mu yaşıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230121108
