			"dialogs": [
				{
					"id": 742510101,
					"content": "Davetiniz için çok teşekkür ederim Bayan Guillotin. Bu saf su benim için özel olarak mı hazırlandı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510102
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510102,
					"content": "Rica ederim Mösyö Neuvillette. Fontaine'in Iudex'inin yoğun programından vakit ayırıp bana... Su içerken eşlik etmesi benim için büyük bir şeref.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510103
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742510103,
					"content": "Görüşmek istediğiniz resmi bir Fatui meselesi mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510104
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510104,
					"content": "Hayır hayır, tamamen kişisel bir ziyaret bu. Bu kadar resmi olmanıza da gerek yok ayrıca, sadece eski bir tanıdık hakkında bir şeyler sormak istedim size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510105
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742510105,
					"content": "Eski bir tanıdık... Ah, saygıdeğer Usta Lord Bay Alain Guillotin'den bahsediyor olmalısınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510106
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510106,
					"content": "Evet. Nasıl biriydi? Gençliğinde sizin astınız olduğunu duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510107
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742510107,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510108
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510108,
					"content": "Bay Guillotin aklı başında ve samimi bir genç adamdı. Kendisine Beyaz Muhafız Süvari unvanı verildikten sonra bile bir kez olsun kibir göstermedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510109
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510109,
					"content": "Zamanının çoğunu makinaları inceleyerek geçirirdi. Kendi küçük fanusunun dışındaki dünya onun pek ilgisini çekmezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510110
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510110,
					"content": "Hımm... Demek gençken de öyleymiş. Acaba yaşının ötesinde bir bilgeliğe mi sahipti, yoksa sadece dünyanın işleyişinden mi bihaberdi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510111
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742510111,
					"content": "Ne var ki... Ailesini ve arkadaşlarını kaybettikten sonra büyük ölçüde değişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510112
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510112,
					"content": "Gestalt Kulesi mi? Ve Elynas...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510113
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742510113,
					"content": "Evet. Birlikte kuleyi arama emrini imzaladığımızda o... Çaresiz görünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510114
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510114,
					"content": "Tüm bunlar geçmişteki o kopukluk ve yabancılaşmadan kaynaklıydı. O da kendini suçlu hissetmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510115
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742510115,
					"content": "Hımm... Sonra da iyice kabuğuna çekildi ve eskisi kadar görüşmez olduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510116
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510116,
					"content": "Kendisine Usta Lord unvanı verildiği törende tek söylediği şuydu:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510117
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510117,
					"content": "\"Körü körüne sonsuz mükemmelliğin peşinde koşmaya kıyasla, sakin ve mütevazı bir hayat sürünce mutluluğu bulmak daha kolaydır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510118
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510118,
					"content": "Heh... Son yıllarında tam da öyle bir hayat sürdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510119
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742510119,
					"content": "Sanırım bunu sadece kalabalığa değil, kendi kendine söylüyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510120
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742510120,
					"content": "Peki siz tüm bunlar hakkında ne düşünüyorsunuz Bayan Guillotin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510121
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510121,
					"content": "Ben mi? Hıh. Onun aydınlanmasını ya da yaşam tarzını yargılayacak değilim. Tıpkı onun da bana kendi hayatımı nasıl yaşamam gerektiğini asla söylemediği gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510122
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742510122,
					"content": "Ama ne onun yolundan gitmeye ne de ideallerini taklit etmeye niyetim var. Ben bağımsız bir bireyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510123
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742510123,
					"content": "Heh... Teşekkür ederim. Onu daha iyi anlamama yardımcı oldunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510124
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742510124,
					"content": "Rica ederim. Ailesinden biriyle geçmişi yad etmek benim için bir zevk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				}
			]
		},
