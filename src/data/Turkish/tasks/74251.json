			"dialogs": [
				{
					"id": 742510201,
					"content": "Size geçmişe dair hikayeler anlatırken bu enfes suyu yudumlamak da ayrı bir zevkti tabii Bayan Guillotin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510202,
					"content": "(Biraz daha oturalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 742510204,
					"content": "Peki öyleyse. Bundan sonra yolunuz nereye düşerse düşsün, size rahat bir yolculuk dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neuvillette"
				},
				{
					"id": 742510203,
					"content": "Yavaş yavaş toparlansam iyi olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "Kukla"
				}
			]
		}
	]
