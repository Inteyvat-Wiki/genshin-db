			},
			"dialogs": [
				{
					"id": 732040701,
					"content": "Ah, henüz yemek yapacak vaktim olmadı. Korkarım ki size ikram edecek bir şeyim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040702,
						732040703
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040702,
					"content": "Hiç zahmet etme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				},
				{
					"id": 732040704,
					"content": "Bu diğer çocuk senin arkadaşın mı yani? Ne şirin bir çocukmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040705
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040705,
					"content": "Çiçekler açtığında görmeye gelmek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040706
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040706,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040707
					]
				},
				{
					"id": 732040707,
					"content": "Birkaç güne açarlar muhtemelen. Sonra tekrar gel ve tohumlarını ekmeme yardım ettiğin çiçeklerin nasıl da açtığını kendi gözlerinle gör.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040708
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040708,
					"content": "Olur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040709
					]
				},
				{
					"id": 732040709,
					"content": "Tamamdır o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040710
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040710,
					"content": "♪...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732040703,
					"content": "Merak etme, aç değilim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040704
					]
				}
			]
		},
		{
			"id": 7320501,
			"completionStepIds": [
				7320501
