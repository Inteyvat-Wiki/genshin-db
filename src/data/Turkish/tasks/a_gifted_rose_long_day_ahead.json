			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732050301,
					"content": "Aferin, aferin. Siz ikiniz işi biliyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050302
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050302,
					"content": "Uzmanların yardımını aldığıma göre, bu sefer güzelce büyüyeceklerine dair içimde bir his var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050303,
					"content": "Döner ve Tahçin güzel miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050304,
						732050306
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050304,
					"content": "Harikaydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050305
					]
				},
				{
					"id": 732050305,
					"content": "Harikaydı demek! O zaman biraz daha yapayım size.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050307
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050307,
					"content": "Rahmetli karım kadar iyi bir aşçı değilim, o yüzden kusuruma bakmayın. Lütfen böyle idare edin. Bu sefer porsiyonlar biraz küçük ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050308
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050308,
					"content": "Ne kadar lezzetli bir şey bu! Gerçekten çok naziksin, sık sık ziyaretine geliriz tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050309,
					"content": "Haha! Bunun hangi çiçek olduğunu sormayacak mısınız peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050310
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050310,
					"content": "Siz sormayacaksanız ben söyleyeyim. Gül ekiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050311
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050311,
					"content": "Sumeru Gülü mü yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050312
					]
				},
				{
					"id": 732050312,
					"content": "Bu çiçeğin adı Altın Gül. Sumeru Gülünden çok daha değerlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050313
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050313,
					"content": "Bu tohumların bana bir arkadaşımdan kaldığını söylemiştim, hatırladınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050314
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050314,
					"content": "İşte bu tohumlar ve içinde yaşadığım bu eski püskü ev bana o \"yaşlı hortlak\"tan kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050315
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050315,
					"content": "Ah, doğru ya. Aaru Köyü'nden değilsiniz siz, muhtemelen bu ismi de bilmiyorsunuzdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050316
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050316,
					"content": "Bilmeseniz de önemli değil. Birtakım çiçekler yetiştirmiş yaşlı bir adam olarak bilseniz yeter...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050317
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050317,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050318
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050318,
					"content": "Bir anda dalıp gittin Affan Dede. Affan Dede? Orada mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732050319,
					"content": "Ha... Düşüncelere dalıp gitmişim sahiden. Kusura bakmayın, ben de iyice ihtiyarladım artık. Arada bir böyle rezillikler oluyor işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050320
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050320,
					"content": "Bir kez daha teşekkür ederim çocuklar. Görmek istediğiniz başka bir şey varsa etrafa göz atabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050321
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050321,
					"content": "Artık kimseyi tarlamdan kovmayacağım. Tabii siz yine de fideliğin üzerinde gezmeyin, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050306,
					"content": "Daha denemedim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050307
					]
				}
			]
		},
