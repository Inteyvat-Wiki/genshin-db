			"dialogs": [
				{
					"id": 732050401,
					"content": "Siz önce şu üç tohumu sulayın, ben de gübre konusunda ne yapabilirim bir düşüneyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050402
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050402,
					"content": "Yıllardır bir sürü şey yetiştirdiğim için bazı basit gübreleri yapmasını bilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		}
