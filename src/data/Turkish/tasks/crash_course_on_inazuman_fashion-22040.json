			"dialogs": [
				{
					"id": 220400101,
					"content": "Bu işi sürdürmenin imkanı yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400102
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400102,
					"content": "Bir şey mi oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400103
					]
				},
				{
					"id": 220400103,
					"content": "Ah, kusura bakma. Bir anlığına düşüncelere dalmışım. Kıyafet almaya mı geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400104
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400104,
					"content": "Ne yazık ki Liyue'den gelen üst düzey ipeklerimiz tükendi ancak hâlâ son moda kimonolarımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400105
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400105,
					"content": "Liyue'den malzeme mi ithal ediyordun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400106
					]
				},
				{
					"id": 220400106,
					"content": "Evet. Daha önce biz de Feiyun Ticaret Loncasının İpek Çiçeklerinden ürettiği gibi Liyue'den kaliteli ipek ithal edebiliyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400107
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400107,
					"content": "Ne yazık ki mevcut şartlar altında bir süredir o tarz ipekleri ithal edemiyoruz. İşe devam etmek için elimizdekilerle yetinmeye çalışıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400108
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400108,
					"content": "Burada kullandığımız her ipek bizim için çok değerli...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400109
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400109,
					"content": "Aslında müşteri çekmek için kendim yeni kimono modelleri üzerinde çalışmayı ya da farklı boyalar kullanmayı planlıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400110
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400110,
					"content": "Fakat aklıma \"yeni\" sayılabilecek hiçbir tasarım fikri gelmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400111
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400111,
					"content": "Farklı diyarları gezmiş birisi olarak çok şey görmüşsündür Gezgin. Acaba hiç \"yeni\" sayılabilecek bir tasarım görmüş müydün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400112
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400112,
					"content": "Pek sayılmaz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400113
					]
				},
				{
					"id": 220400113,
					"content": "Anladım. Şey, haddimi aşıyor olabilirim ancak acaba kullanabileceğimiz tasarımlar hakkında buranın yabancılarından fikir alabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400114
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400114,
					"content": "Ogura Tekstil ve Kimono'ya şu an için benden başka bakabilecek kimse yok, o yüzden dükkandan ayrılamıyorum. Bilgi toplamak için başkalarından yardım istemekten başka çarem yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220400115
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 220400115,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220400116
					]
				},
				{
					"id": 220400116,
					"content": "Harika! O zaman bir düşüneyim... Tang Wen Hanım'a ve Bay Ramsay'e sorabilirsin. Belki onların birkaç fikri vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ogura Mio"
				}
			]
		},
