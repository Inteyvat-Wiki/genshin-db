			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010201,
					"content": "Ne istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010202
					]
				},
				{
					"id": 227010202,
					"content": "Hey! Onunla konuşurken daha saygılı davran! Anladın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010203
					],
					"speakerTitle": "Minik Que'er"
				},
				{
					"id": 227010203,
					"content": "Lütfen, hiç gerek yok... Konuşmayı başlatan bendim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010204
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010204,
					"content": "Pöh! İşe yaramaz olmadığı ve sadece yanlarına sığınmak için Adeptusları arayıp yerimizi çalmaya çalışan biri olmadığı sürece sorun yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010205
					],
					"speakerTitle": "Minik Que'er"
				},
				{
					"id": 227010205,
					"content": "Tamam tamam, ilgin için teşekkür ederim. Sorun çıkacağını zannetmiyorum. Şimdi ben yeni arkadaşımızla iki kelam ederken, sen neden dinlenmiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010206
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010206,
					"content": "Ama... Ama benim önümde ona söyleyemeyeceğin bir şey yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010207
					],
					"speakerTitle": "Minik Que'er"
				},
				{
					"id": 227010207,
					"content": "Senin ilgini çekecek bir şey yok, dinlesen bile sıkılırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010208
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010208,
					"content": "Pöh, tamam. Ben anladım anlayacağımı. Yine Guhua Klanı hakkında konuşmak istiyorsun. Peki. İstemiyorsan, ben de çekip giderim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010209
					],
					"speakerTitle": "Minik Que'er"
				},
				{
					"id": 227010209,
					"content": "Arkadaş, bana katılacaksan buraya gel. Geldiğinde daha ayrıntılı konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
