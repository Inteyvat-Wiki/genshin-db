			"dialogs": [
				{
					"id": 227010501,
					"content": "Döndün! Bana yardım edeceğin konu hakkında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010502
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010502,
					"content": "Çiçekleri topladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010503
					]
				},
				{
					"id": 227010503,
					"content": "Bunlar yeter de artar bile. Sana teşekkür ederim arkadaş, karşılığında lütfen bu hediyeyi kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010504
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010504,
					"content": "Bu Qingxin çiçekleri ne için? Ay olamaz, yine mi başın ağrımaya başladı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Que'er"
				}
			]
		},
		{
			"id": 2270106,
