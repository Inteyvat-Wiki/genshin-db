			},
			"dialogs": [
				{
					"id": 227010701,
					"content": "Aslında bunlar senin boğazın için.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010702
					]
				},
				{
					"id": 227010702,
					"content": "Öhöm! Arkadaşım, sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010703
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010703,
					"content": "Zayıf olduğumu mu ima ediyorsun? Hava azıcık esti diye boğaz ağrım olduğunu mu zannettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010704
					],
					"speakerTitle": "Minik Que'er"
				},
				{
					"id": 227010704,
					"content": "Neyse ki Qingxin çiçekleri boşa gitmeyecek, Sun Yu'nun baş ağrısına iyi gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010705
					],
					"speakerTitle": "Minik Que'er"
				},
				{
					"id": 227010705,
					"content": "Que'er, bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010706
