					"Sun Yu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010401,
					"content": "Tamamdır, burası güzel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010402
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010402,
					"content": "Ne oluyor burada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010403
					]
				},
				{
					"id": 227010403,
					"content": "*iç çeker* Konumuz Minik Que'er, benim astım. Dövüş sanatları eğitimimizde biz et ve tırnak gibiydik, hiç ayrılmadık. Onun yeteneklerinin benimkilerden aşağı kalır yanı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010404
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010404,
					"content": "Adeptusların bize yol göstermeleri için buraya geldik ancak yolculuğumuz çok zorlu geçti. Yoldaşım da asla susmayan bir geveze... Birkaç gün önce soğuk algınlığına yakalandı, şimdi de boğaz ağrısından muzdarip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010405
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010405,
					"content": "Senin çok güçlü biri olduğunu görebiliyorum ve sana tüm kalbimle yalvarıyorum, benim için bu uçurumun tepesine çıkıp üç adet Qingxin çiçeği getirir misin lütfen? Bu çiçekleri sıcak suda demler ve Que'er'e içirirsem, boğaz ağrısı biraz da olsa diner.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010406,
						227010408
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010406,
					"content": "Tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010407
					]
				},
				{
					"id": 227010407,
					"content": "Sana teşekkür ederim arkadaş. Que'er çok yaşam dolu bir insandır. Ben ilaç toplamaya gittiğimde, onu burada yalnız bırakmaya cesaret edemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010408,
					"content": "Bunu neden ondan habersiz yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010409
					]
				},
				{
					"id": 227010409,
					"content": "Bu sana biraz komik gelebilir. Que'er çok cesurdur ve durum ne olursa olsun, çevresindekilerden azıcık bile olsa daha dezavantajlı bir durumda olduğunu asla kabul etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010410
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010410,
					"content": "Çok uzaklaşmadan kendi iyiliği için bile ilaç toplamayı teklif etmeye kalksam, azıcık bile düşünmeden reddeder. Bu sebeple bu işi onun haberi olmadan halletmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010411
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010411,
					"content": "Dahası, ben ilaç toplamaya gittiğimde, onu burada yalnız bırakmaya cesaret edemiyorum. Bu sebeple yardımını istemek durumundayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				}
			]
		},
