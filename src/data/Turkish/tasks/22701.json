				],
				"points": []
			},
			"dialogs": [
				{
					"id": 227010601,
					"content": "Evet, bunları başının ağrısı için topladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						227010602
					]
				},
				{
					"id": 227010602,
					"content": "Ama ben seve seve gider senin için toplardım. Neden bunun için yoldan geçen birinden yardım aldın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010603
					],
					"speakerTitle": "Minik Que'er"
				},
				{
					"id": 227010603,
					"content": "Ayrıca kim olduğunu ve nereden geldiğini bile bilmediğimiz birinden, hadi bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010604
					],
					"speakerTitle": "Minik Que'er"
				},
				{
					"id": 227010604,
					"content": "Bu kadar yeter Que'er. Bize yardım etti sonuçta, değil mi? Onunla bir sorunumuz olmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010605
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010605,
					"content": "Tekrar teşekkür ederim. Lütfen bunları al.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010606
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 227010606,
					"content": "Evet, onları al ve sağ salim yoluna git. Başı ağrıyorken onu soğukta bekletemeyiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						227010607
					],
					"speakerTitle": "Minik Que'er"
				},
				{
					"id": 227010607,
					"content": "Haydi, çabucak esmeyen bir yere gidelim! Sana şekerli bir çay yapayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Que'er"
				}
			]
		},
		{
			"id": 2270107,
