				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Salsa",
					"Ubu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230101,
					"content": "#Oh be, çok daha güzel oldu. Salsa görse bizimle gurur duyardı, değil mi {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230102,
					"content": "Hırsızlar! Güpegündüz soygun var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230103
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230103,
					"content": "Ne? Hırsızlar mı? Nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230104,
					"content": "Siz ikinizi diyorum ben! Ustalık eserimi yok ettiniz, üstüne bir de sandığı bile aldınız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230105,
						740230107
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230105,
					"content": "Demek gerçekten bir Maceracılar Loncası üyesi yapmış...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230106
					]
				},
				{
					"id": 740230106,
					"content": "Ben ne yapmışım? Asıl size sormak lazım ne yaptığınızı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230109,
					"content": "Bu çirkin şeyler senin \"ustalık eserlerin\" mi yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230110,
					"content": "Bu ne cürettir! Ne demek \"çirkin şeyler\"? Enstalasyon sanatı diye bir şey duymadınız mı hiç?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230111
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230111,
					"content": "Fontaine'de sanat eğitimi geri kalmış herhalde... Gerçi siz ikiniz Fontaineli durmuyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230112
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230112,
					"content": "#Fontaineli değiliz de ondan. Paimon'un adı Paimon, bu da {NICKNAME}. Biz de Maceracılar Loncası üyeleriyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230113,
						740230115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230113,
					"content": "Şeytani bir örgütün üyeleriyiz... *ağlar*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230114
					]
				},
				{
					"id": 740230114,
					"content": "Evet ama üniforma giymemize gerek yok. Yani biz yeşilli kötüler sayılmayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230117,
					"content": "Adım Ubu. Maceracı ve enstalasyon sanatçısıyım. Ağzınızdan mantıklı tek laf çıkmadığına göre çılgın işler peşinde olduğunuzu varsayıyorum... Bu seferlik sizinle uğraşmayacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230118
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230118,
					"content": "Nasıl yani? E ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230119,
					"content": "Ne var? Eserimi onarmam gerekiyor. Teşekkür edecekseniz çabuk edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230120
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230120,
					"content": "Sana teşekkür etmem için bir sebep yok, ama sana kızmak için sürüyle sebebim var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230121
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230121,
					"content": "Salsa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230122,
					"content": "Yanında ben varken korkmana gerek yok Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230123
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230123,
					"content": "Yeşilli kötü adam, kurduğun tüm tuzakları yok ettik! Güzel Fontaine'imizi sinsi tuzaklarınla mahvetmeyi bırak artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230124
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230124,
					"content": "Mahvetmek mi? Bir dakika, \"yok ettik\" mi dedin sen? Tüm sanat eserlerimi yok mu ettiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230125
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230125,
					"content": "Şey, yok ettik denemez aslında... Manzarayla uyumlu olmaları için yeniden düzenledik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230126,
					"content": "Ne... Sizi şımarıklar, sizi köylüler! Sanattan nasibini alamamış cahiller sizi! Enstalasyon sanatımı, eserlerimi bu kadar vasat ve sıradan bir şeye nasıl dönüştürebildiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230127
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230127,
					"content": "Sanat denebilir mi ki? Paimon bu konuda pek bilgili değil ama etrafıyla bu kadar uyumsuz duran bir şey sanat sayılır mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230128,
					"content": "Tabii ki denir. Sanatın sınırlarını sanatçı belirler. Bir sanatçının yarattığı eser tabii ki sanat eseri sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230129
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230129,
					"content": "Sanatçı kim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230130
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230130,
					"content": "Benim. Olağanüstü enstalasyon sanatçısı Ubu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230131
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230131,
					"content": "O halde \"Şeytani Örgütü Alt Etmek ve Fontaine'in Geleceğini Korumak İsteyen Sanatçılar İttifakı\" kurucusu olarak bunu sanat kabul etmediğimi bildiriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230132
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230132,
					"content": "\"Şeytani Örgütü Alt\"... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230133,
						740230135
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230133,
					"content": "Şeytani Örgütü Alt Etmek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230134
					]
				},
				{
					"id": 740230134,
					"content": "Manzarayı... Şey... Enstalasyon sanatıyla mahveden Maceracılar Loncasını kastediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230136,
					"content": "Şaka herhalde. Daha önce böyle bir ittifak duymadım hiç. Eserlerimin sanat olmadığını iddia etme hakkını kendinde nereden buldun ufaklık?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230137
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230137,
					"content": "Ben ressamım, yani sanatçıyım da. Tabii ki hakkım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230138
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230138,
					"content": "Ne? Bak ufaklık, sanatçı olmak öyle çocuk oyunlarına benzemez. Sanatçı olmak istiyorsun diye kendine sanatçı diyemezsin. İnsanlar tarafından takdir edilen eserlerin olması gerekir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230139
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230139,
					"content": "Sen böyle konuşma hakkını nereden buldun peki? Bahsettiğin enstalasyonların, eserlerin... Bu şeytani tuzaklar yani. İnsanlar bunları görünce alkışlıyor mu seni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230140
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230140,
					"content": "Eserlerimin muhteşemliğini anlayamayan çok fazla cahil insan var etrafta. Zaten gerçek sanat hep en az anlanan sanattır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230141,
						740230143
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230141,
					"content": "İnsanların anlayabileceği sanat eserleri üretmelisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230142
					]
				},
				{
					"id": 740230142,
					"content": "Evet. Kimse anlamazsa çok avangart demektir. Yani diğer bir deyişle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230145,
					"content": "Hayır... Öyle şey olmaz! Benim eserlerim kusursuz bir kere! Hiçbir sorunu yok! Anlamıyorsunuz siz, kimse anlamıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230146
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230146,
					"content": "Pes etmeyeceğim işte! Bu burada bitmedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230147
					],
					"speakerTitle": "Ubu"
				},
				{
					"id": 740230147,
					"content": "Ubu çekip gider...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740230148
					]
				},
				{
					"id": 740230148,
					"content": "Ne inatçı bir düşman çıktı bu da! Ama ben de pes etmeyeceğim! Fontaine sanatının geleceği benim omuzlarımda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230149
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230149,
					"content": "Hepimizin kendimiz için belirlediğimiz hedeflerimiz var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230150
					]
				},
				{
					"id": 740230150,
					"content": "Bu iyi bir şey mi? Öyle galiba, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230143,
					"content": "Diğer bir deyişle kimse anlamıyordur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230144
					]
				},
				{
					"id": 740230144,
					"content": "Kulağa başarısızlık gibi geliyor o da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230135,
					"content": "Özetle seni yenmemiz lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230136
					]
				},
				{
					"id": 740230115,
					"content": "Merhaba dostum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230116
					]
				},
				{
					"id": 740230116,
					"content": "Paimon karşındakinin daha ismini bile öğrenmeden ona dostum diyebileceğini sanmıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230107,
					"content": "Aa, yeşilli kötü adam bu!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230108
					]
				},
				{
					"id": 740230108,
					"content": "Peh, saçma sapan konuşan bir hırsız. Bak sen şu işe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230109
					],
					"speakerTitle": "Ubu"
				}
			]
		},
		{
			"id": 7402302,
