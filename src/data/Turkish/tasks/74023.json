					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230201,
					"content": "Hımm... Paimon bu nesnelerin görüntüsüne katlanamıyor... Sanki Paimon'a şu geçen gördüğümüz çirkin şeyleri hatırlatıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230202,
					"content": "Burada neden <color=#00E1FFFF>toprağa gömülü bir Su Abidesi var</color>? Paimon anlayamadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740230203,
					"content": "#{NICKNAME}, yeniden düzenlesek mi? Salsa'nın öğrettiği gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7402303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7402303",
							"3"
						],
						"stepId": 7402303,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Salsa"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740230301,
					"content": "#{NICKNAME}, Paimon! Merhaba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740230302,
						740230304
					],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230302,
					"content": "İttifaka katılacak yeni üyeler bulabildin mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230303
					]
				},
				{
					"id": 740230303,
					"content": "Katılmayı isteyen bazı adaylar buldum ben ama doğru becerilere sahipler mi anlamak için sıkı testlerden geçmeleri lazım. Sonuçta Fontaine'in geleceğinden bahsediyoruz burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Salsa"
				},
				{
					"id": 740230304,
					"content": "Bugün eve gitmek için acelen yok mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740230305
					]
				},
				{
