				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181501,
					"content": "\"Bugünkü gençler her şeye çok fazla kafa yoruyor. Mahadevi Rukkhadevata olmasaydı, biz Aaru köylüleri çoktan şu tapınak kalıntılarının altında iskelet olmuştuk.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181502
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181502,
					"content": "\"Geçenlerde birinden Kral Deshret'in yeniden doğacağını duydum. Mahadevi Rukkhadevata bile bunca yıl geri gelmemişken, Kral Deshret nasıl gelsin?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181503
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181503,
					"content": "\"Biz en iyisi işimize dönelim. Her ay Aaru Köyü'ne gelen azıcık erzakla geçinmemiz mümkün değil.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
