			"dialogs": [
				{
					"id": 732181601,
					"content": "Samiel Duvarının bakımı için kalıcı işçi alımı yapılacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181602
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181602,
					"content": "Adil bir ücret, bedava yemek ve konaklama sağlıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181603
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181603,
					"content": "Öne çıkan işçiler görevli tarafından tavsiye edilecek ve Akademide eğitim görme fırsatı elde edecektir.",
					"roleType": "TALK_ROLE_NPC",
