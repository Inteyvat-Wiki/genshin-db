			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181101,
					"content": "\"Akademinin çölde Eleazar için bir hastane kurduğunu duydum. Ancak bilinmeyen sebeplerden ötürü hastane terk edilmiş...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181102
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181102,
					"content": "\"Aaru Köyü sakinlerinin dediğine göre iyileştikten sonra oradan kaçan Eleazar hastaları varmış.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181103
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181103,
					"content": "\"Hastanenin içinde herhangi bir bilgi kaldıysa belki hastalığın tedavisinin bulunmasını sağlayabilir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321812,
			"completionStepIds": [
				7321812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321812",
							"2"
						],
						"stepId": 7321812,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181201,
					"content": "\"Aaru Köyü sakinlerinden birinin Akademide yüksek bir mevkiye getirildiği söyleniyor. Belki de çöl halkı olarak gelecekte daha iyi bir hayat süreriz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181202
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181202,
					"content": "\"Bu taşları taşıyarak kazandığım parayla zar zor geçiniyorum. Tek seferliğine bile bunun yerine konserve bilgi taşısaydım memleketime dönüp evlenecek kadar param olurdu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181203
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181203,
					"content": "\"Bahsettiğin görevlinin kaçakçılıkla mücadele edenlerden biri olduğunu duymuştum. Bizim tarafımızda olacağını sanmıyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181204
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181204,
					"content": "\"Al işte, biz çöl halkı hep böyle böyle yalnız kalıyoruz. Güçlerimizi birleştiremiyoruz çünkü.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321813,
			"completionStepIds": [
				7321813
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
