			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181001,
					"content": "\"Çöl macerası paketlerimiz satışa çıkmıştır! Tüccar ve gezginlerin ihtiyaçlarını göz önünde bulundurarak hazırladığımız çöl macerası paketlerini bizden alabilirsiniz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181002
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181002,
					"content": "\"Paketi satın alanların çöl yolculuğundan sağ salim döneceğini garanti ediyoruz. Sahte ürün sattığımız takdirde on katı kadar ceza ödemekle yükümlüyüz. İndirimlerden faydalanmak için ön sipariş verebilirsiniz!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321811,
			"completionStepIds": [
				7321811
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
