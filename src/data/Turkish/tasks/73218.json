			"dialogs": [
				{
					"id": 732181701,
					"content": "\"Büyülü Şişenin Kralı adına tüm günahlarını bağışladım. Peki ya bizim günahlarımızı kim bağışlayacak?\"",
					"roleType": "TALK_ROLE_NPC",
