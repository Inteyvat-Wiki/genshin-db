			},
			"dialogs": [
				{
					"id": 732180801,
					"content": "Ribat Kervanı'nda uzun süreli kalan araştırmacılar bilgi sızıntısına veya diğer beklenmedik gelişmelere mahal vermemek için otele giriş yapmadan önce Mahamatalara giderek kayıt yaptırmalıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321809,
			"completionStepIds": [
				7321809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321809",
							"2"
						],
						"stepId": 7321809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180901,
					"content": "Tüccar ve gezginler sınırı geçmek için Mahamatalara kayıt yaptırarak onay almalıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180902
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732180902,
					"content": "İthalat ve ihracatı yasaklanmış kayıt dışı veya kaçak malların taşınması yasaktır. Bu kuralı ihlal eden her türlü ticari yüke el konulacak ve ihlal eden şahıslar yönetmeliğe uygun olarak çöle sürgün edilecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180903
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732180903,
					"content": "Buna ek olarak Aaru Köyü sakinleri Akademi tarafından verilecek geçiş izni ile sınırdan geçebilecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
