			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180601,
					"content": "Altın Yaldız için reklam yapmaya gerek yok diye düşünebilirsiniz, ne de olsa Ribat Kervanı'ndaki tek otel burası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180602
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732180602,
					"content": "Mangal lezzetlerimizin çölden gelen özgün tadını denedikten sonra parmaklarınızı yiyeceksiniz. Şehirdekinden çok daha özgün olduğuna emin olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180603
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732180603,
					"content": "Yorgun gezginler, siz de bu lezzeti tatmadan geçmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321807,
			"completionStepIds": [
				7321807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321807",
							"2"
						],
						"stepId": 7321807,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180701,
					"content": "\"Umarım Mahamatalar Ribat Kervanı'ndaki gümrük kontrollerini sıkılaştırır.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180702
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732180702,
					"content": "\"Artık Çöl halkından herhangi biri sınırdan elini kolunu sallayarak geçebiliyor. Bu, haydutlara ormana saklanıp Sumeru'daki insanların işlerini ellerinden alma şansı veriyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180703
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732180703,
					"content": "\"Çöl halkının Akaşa'ya erişimi yok fakat Regzar Kalesi tarafından verilen özel görev ilanları, paralı askerlikten çok daha fazlasını içeriyor. Böyle giderse Akademiye girenler bile işlerini kaybedecek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180704
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732180704,
					"content": "\"Bunlar ne biçim laflar böyle? Çöl halkı hem Mahadevi Rukkhadevata'nın bir tebaası ve hem de Sumeru halkının bir parçasıdır. Tabii ki şehre girmelerine izin verilecek.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180705
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732180705,
					"content": "\"Burada bunu söylerken dikkatli ol.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321808,
			"completionStepIds": [
				7321808
			],
