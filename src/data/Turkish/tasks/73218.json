			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180101,
					"content": "Sumeru'nun girişlerinden biri olan Ribat Kervanı çok önemli bir geçiş noktasıdır. Bu İlan Panosu tüccarları ve turistleri mühim konular hakkında bilgilendirmek için yerleştirilmiştir. Panodaki bildirileri sıklıkla kontrol etmenizi rica ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321802,
			"completionStepIds": [
				7321802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321802",
							"2"
						],
						"stepId": 7321802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732180201,
					"content": "\"Sevgilim... Benden çok uzakta olsan da kalbimde her daim sen olacaksın.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180202
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732180202,
					"content": "\"Biliyorum, ilgilenmen gereken daha önemli işler var. Sonuçta insan ne kadar yükselirse sorumlulukları da o kadar artıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180203
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732180203,
					"content": "\"Yine de ben kalbimin acısını herkesten saklamak zorundayım. Adını kimseye söyleyemiyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732180204
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732180204,
					"content": "\"Umarım bir gün herkese senin ne kadar kültürlü ve bilgili biri olduğunu anlatabilirim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321803,
			"completionStepIds": [
				7321803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
