			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181301,
					"content": "Çöle giden maceracıların dikkatine! Büyük Kızıl Çölde maceraya atılmak isteyen herkes Akademide kayıt yaptırmak zorundadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181302
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181302,
					"content": "Çölde bulunan Yadigarlar kurallar gereğince Akademiye aittir. Hiç kimse üzerlerinde hak iddia edemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181303
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181303,
					"content": "Güvenlik nedeniyle Akademi tarafından Büyük Kızıl Çöl dışındaki çöl bölgelerine giriş yasağı konulmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181304
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181304,
					"content": "Söz konusu bölgelerde gerçekleşecek kazalardan Akademi sorumlu değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
			"id": 7321814,
			"completionStepIds": [
				7321814
			],
