			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732181401,
					"content": "\"Şehirde kum pupası yağı satarak servet kazananlar varmış. Malikanelerde oturuyor, bir tür aile olduklarını iddia ediyorlarmış. Üstelik bir de Akademidekilerle çok yakın dostmuş gibi davranıyorlarmış.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181402
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181402,
					"content": "\"Bense hayatımın çoğunu burada taş taşıyarak geçirdim. Buna rağmen beş parasızım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181403
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181403,
					"content": "\"Bir şey bilmeden konuştuğun o kadar belli ki. Kum pupası yağı işine Akademi onay verdi zaten. Bizim o pastadan pay almamız mümkün değil.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732181404
					],
					"speakerTitle": "İlan Panosu"
				},
				{
					"id": 732181404,
					"content": "\"Zengin olmak istiyorsan gel benimle kitap kaçakçılığı yap. İşimiz tutarsa en azından burada taş taşımak zorunda kalmayız.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "İlan Panosu"
				}
			]
		},
		{
