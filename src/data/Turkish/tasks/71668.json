				"points": []
			},
			"dialogs": [
				{
					"id": 716680101,
					"content": "Herkesi \"Patili Dostlar\" hayvan kurtarma topluluğuna katılmaya davet ediyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680102
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680102,
					"content": "Selamlar!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680104
					]
				},
				{
					"id": 716680104,
					"content": "#{NICKNAME}, hoş geldin. Nasılsın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680105
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680105,
					"content": "Lonca üyelerimiz şu anda bir etkinlik düzenliyor. İlgilenir miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680106
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680106,
					"content": "Ne tür bir etkinlik?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680107
					]
				},
				{
					"id": 716680107,
					"content": "Kısaca bahsetmem gerekirse insanlardan Feiyun Ticaret Loncasının sponsor olduğu Patili Dostlar hayvan kurtarma topluluğuna katılmalarını ve terk edilmiş veya nesli tükenmekte olan hayvanları kurtarmamıza yardım etmelerini istiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680108
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680108,
					"content": "Lonca, çeşitli uluslardan gönüllülerle birlikte çalışarak toplu sahiplendirme ile yaygın sokak hayvanları sorununun çözülmesine yardımcı oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680109
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680109,
					"content": "Son yıllarda çok büyüdük, bu yüzden nesli tükenmekte olan hayvanları korunması adına Bayan Lamiya gibi araştırmacılarla çalışmayı düşünmeye başladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680110
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680110,
					"content": "Araştırmalarımın bu şekilde kullanılabilmesi beni mutlu ediyor doğrusu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680111
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680111,
					"content": "Haha! Aynı kafadayız desene.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680112
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680112,
					"content": "Gönüllülerimiz ve Bayan Lamiya gibi vizyoner araştırmacılar sayesinde artık çoğu sokak hayvanının bir yuvası var ve nesli tükenmekte olan hayvanlar da koruma altında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680113
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680113,
					"content": "Liyue'ye ek olarak, Patili Dostlar hayvan bakım tesisleri Mondstadt ve Sumeru gibi Feiyun Ticaret Loncasının aktif olduğu her yerde bulunabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680114
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680114,
					"content": "Durum böyle olunca biz de gönüllülerimize teşekkür etmek ve herkese kaç Patili Dost üyemizin olduğunu göstermek için bu etkinliği düzenledik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680115
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680115,
					"content": "Sahiplendirilen hayvanların kaldığı alana giderek yaşam koşullarına bakabilir ve küçük hediyeni alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680116
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680116,
					"content": "Hediye çalışanlarımız ve hayvan sahiplenenler tarafından hazırlandı. Tabii hediyeni almadan önce senin de hayvan sahiplenenler için bir şey hazırlaman gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680117
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680117,
					"content": "Zamanı geldiğinde tüm hediyeler görevliler tarafından toplanacak ve ilk sahiplenen kişiye götürülecek. Pahalı bir şey olmasına gerek yok, duygularını anlatsın yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680118
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680118,
					"content": "#Ne diyorsun {NICKNAME}? İster misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680119,
						716680120
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680119,
					"content": "Olur, bir bakayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				},
				{
					"id": 716680121,
					"content": "Süper! Senin gibi ünlü birinin bize katılması harika olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680122,
					"content": "Hazırsan hediyeni bana verebilirsin. Çalışanlar etkinlik sonunda hediyeyi hayvanı sahiplenen kişiye verecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680123
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680123,
					"content": "Bu arada gördüğüm kadarıyla hayvan sahiplenenlerden bazıları bölgenin kendine has ürünlerini, bazıları da lezzetli her türlü yiyeceği tercih ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680120,
					"content": "Evet, ben de katılacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716680121
					]
				}
			]
		},
