					"Lamiya",
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716680401,
					"content": "Tamam, bu yiyecekleri bir kutuya koyup gönderelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680402
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680402,
					"content": "Her hayvan farklıdır. Hayvanları kafeslere kapatmıyoruz. Bunun yerine, fiziksel durumlarını kontrol edebilmek için profesyonel bakıcıları işe alıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680403
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680403,
					"content": "Hayvanları bulmak kolay değil. Bayan Lamiya'nın geliştirdiği özel İşlemeli Takipçiye ihtiyacın olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680404
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680404,
					"content": "Bu konuda ben onun kadar bilgili değilim, o yüzden sana kendisi açıklarsa daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680405
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680405,
					"content": "Katılıyorum. Hemen açıklayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680406
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680406,
					"content": "İşlemeli Aynanın çalışmasını sağlayan teknoloji Akaşa ile ilişkili, çalışma şekli ise oldukça karışık. Merak etme, test edildi ve güvenli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680407
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680407,
					"content": "Tüm hayvanlara mikro vericiler taktık. Cihazın sinyalini okuduğumuzda ayna hayvanın gördüğü her şeyi görmemizi sağlayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680408
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680408,
					"content": "Cihazda birkaç geliştirme yapmamız gerekebilir ancak bu görüntü hareket halindeki hayvanların yerini bulmamız için yeterli olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680409
					],
					"speakerTitle": "Lamiya"
				},
				{
					"id": 716680409,
					"content": "İşte bu kadar. Hazırsan Patili Dostlara hoş geldin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716680410
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716680410,
					"content": "Hayvan dostlarımızı bulmak için İşlemeli Aynayı kullan. Hayvan sahiplenenlerin hazırladığı hediyeler ve hayvanlar seni bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				}
			]
		},
