			"dialogs": [
				{
					"id": 735340501,
					"content": "Tanıştığımıza memnun oldum. Adım Higuchi Tetsuya. Inazumalı bir youkai romanı yazarıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340502
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340502,
					"content": "Son zamanlarda üstümde çok büyük bir baskı var... Tekrar düzlüğe çıkabilmek için elimden ne gelirse yapmalıyım dedim o yüzden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340503
					],
					"speakerTitle": "Higuchi Tetsuya"
				},
				{
					"id": 735340503,
					"content": "Bu arada haberin olsun, düş sahnem... Nevi şahsına münhasır olabilir biraz. Benim yarattığım bir dünya sonuçta orası, haliyle beraberinde bazı sorunları da getirebilir. Orada tuhaf şeylerle karşılaşırsan şimdiden kusura bakma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Higuchi Tetsuya"
				}
			]
		},
