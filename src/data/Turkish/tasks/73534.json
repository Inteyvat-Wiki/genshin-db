			"dialogs": [
				{
					"id": 735340301,
					"content": "Tanıştığımıza memnun oldum. Birlikte bir düş sahnesine girmek üzereyiz sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340302
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340302,
					"content": "Ben Youguang, Liyue'den gelen bir muhafızım. Geçenlerde çalışırken... Elim kirli bir şeye değdi. O gün bugündür de gözüme uyku girmiyor. O yüzden gelip yardım almaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340303
					],
					"speakerTitle": "Youguang"
				},
				{
					"id": 735340303,
					"content": "Bu Düş Sahnesi Terapisi sayesinde kabuslarımdan kurtulabilirsem harika olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Youguang"
				}
			]
		},
