			"dialogs": [
				{
					"id": 735340901,
					"content": "Dharmakirti'nin bahsettiği o iyi dost sizsiniz demek? Adım Piyush, tanıştığımıza memnun oldum. Mimari alanında çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340902
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340902,
					"content": "Kaveh'nin daha önce sizden bahsettiğini duymuştum ama gelip bir merhaba deme fırsatım olmamıştı hiç. Çok güzel bir tesadüf oldu bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340903
					],
					"speakerTitle": "Piyush"
				},
				{
					"id": 735340903,
					"content": "Göreceğim düş, yeni teslim ettiğim bir proje hakkında olacak bence. Tam bir kabustu da... İlk karşılaşmamız bu kadar resmi bir ortamda olmasaydı keşke ama neyse, yapacak bir şey yok artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Piyush"
				}
			]
		},
