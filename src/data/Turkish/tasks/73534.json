			"dialogs": [
				{
					"id": 735340101,
					"content": "Selam! Düş Sahnesi Terapisinde bana yardımcı olacak kişi sen misin acaba? Öyleyse seninle açık konuşacağım... Göreceğim düşün ne hakkında olacağını inan hiç bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340102
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340102,
					"content": "Mondstadt'tan geliyorum ben. İlgi duyduğum bir hobi falan da yok doğrusu... Şey, yani içmek dışında işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340103
					],
					"speakerTitle": "Collingwood"
				},
				{
					"id": 735340103,
					"content": "Çakırkeyif olunca her şeyi elime yüzüme bulaştıran biriyimdir maalesef... İşler sana emanet anlayacağın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Collingwood"
				}
			]
		},
