			"dialogs": [
				{
					"id": 735340701,
					"content": "Düş Sahnesi deneyleri için gönüllü olan nitelikli eleman bu kadar genç biri miymiş? Bak sen şu işe, bu zamane gençlerinin de on parmağında on marifet yahu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340702
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340702,
					"content": "Bana Nitesh diyebilirsin. Gezgin bir Spantamad alimiyim. Şu anda da uzun vadeli olarak Fontaine'de çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735340703
					],
					"speakerTitle": "Nitesh"
				},
				{
					"id": 735340703,
					"content": "Biz ihtiyarların hali ortada işte... Bir bakmışsın, yeni bir bela daha açılmış başımıza. Sen meselenin özüne inebilmeme yardım edersin genç dostum, inanıyorum sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nitesh"
				}
			]
		},
