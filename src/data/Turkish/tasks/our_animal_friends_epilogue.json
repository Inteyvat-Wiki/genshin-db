			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhenchen"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716690101,
					"content": "#Çalışanlardan duyduğum kadarıyla verici takılan hayvanların hepsini bulmuşsun {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690102
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690102,
					"content": "Şaşırdım açıkçası... Bazıları doğaları gereği çok hassastır ve yabancı bir yaratığı fark ettikleri anda oradan kaçarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690103
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690103,
					"content": "Senin yaklaşmana izin vermişler gerçi. Çok tuhaf.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690104,
						716690105
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690104,
					"content": "Çünkü ben tüm hayvanlarla arkadaşım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				},
				{
					"id": 716690106,
					"content": "Haha! Kıskandım şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690107
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690107,
					"content": "Hayvanlar çalışanlarla birlikte onları beslemeye gittiğim son birkaç sefer ya bana kükredi ya da beni ısırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690112
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690112,
					"content": "İzleri hâlâ kolumda duruyor... Hem de çok acımıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690113
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690113,
					"content": "Bu sevimli yaratıklar her ne kadar beni pek sevmeseler de iyi bir hayat sürmeleri beni mutlu ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690114
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690114,
					"content": "Hayvan sahiplenenler de böyle düşünüyor. Herkes hayvanların doğasını korumak ve huzurlu bir yaşam sürmelerini istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690115
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690115,
					"content": "Çoğu maceracının yiyeceklerini vahşi hayvanları avlayarak elde ettiğini biliyorum. Patili Dostlar üyelerimize hiç avlanmayın demiyoruz zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690116
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690116,
					"content": "Ne var ki kontrolsüz yakalamaya ve katliama karşıyız. Herkes bunu başarabilirse çevremizdeki çeşitliliğin ve güzelliğin artacağı kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690117
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690117,
					"content": "Üyelerimizden biri olarak bu prensibi benimseyip kabul edersen çok mutlu oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690118,
						716690120
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690118,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690119
					]
				},
				{
					"id": 716690119,
					"content": "Senin gibi mantıklı birinin bu tutumumuzu onaylayacağını biliyordum zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690122,
					"content": "İnsanların aklına bu düşünceyi sokmak bile bizim için bir başarı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690123
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690123,
					"content": "Fırsatımız olursa seni bir sonraki Patili Dostlar etkinliğimizde görmeyi çok isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690124
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690124,
					"content": "Umarım o zaman geldiğinde kolumda yeni yaralar olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690120,
					"content": "O karar bana kalsın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690121
					]
				},
				{
					"id": 716690121,
					"content": "Sorun değil. Kimseyi bir şeye zorlamıyoruz ancak herkesin bir hayvanı öldürmeden önce iyice düşünmesini istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716690122
					],
					"speakerTitle": "Zhenchen"
				},
				{
					"id": 716690105,
					"content": "Bir maceracı olarak yeteneklerimden biri de bu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716690106
					]
				}
			]
		},
