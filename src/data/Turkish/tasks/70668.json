					"id": 706680201,
					"content": "Miyav! (Harika! Yükseltme Mücadelesini tamamladığın için tebrikler. Artık Usta bir oyuncusun!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
