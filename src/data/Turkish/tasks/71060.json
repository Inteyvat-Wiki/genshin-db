			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Katarina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591101,
					"content": "Ne? Buraya huzurumu bozmaya mı geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591102
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591102,
					"content": "Hayır, sadece seninle konuşmak istiyoruz. Burada yalnız oturduğunu görünce dayanamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591103,
						710591104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591103,
					"content": "Tek başına içki içmek sıkıcı olmalı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				},
				{
					"id": 710591105,
					"content": "Öyle mi? Teşekkür ederim. Bana Lyudochka'yı hatırlatıyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591106
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591106,
					"content": "O da senin gibi hayat dolu biridir. Hep yanımda olur, bana bir sürü farklı şeyden bahsederdi. Bazı sırlarını sadece bana anlatırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591107
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591107,
					"content": "*iç çeker* Keşke o da burada olsaydı. Çok eğlenceli birdir. Bahse varım, onu görsen sen de severdin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591108,
						710591113
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591108,
					"content": "Lyudochka mı? O da kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591109
					]
				},
				{
					"id": 710591109,
					"content": "Bir arkadaşım. Ciddi biri gibi görünse de aslında çok komik, çok tatlı biridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591110
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591110,
					"content": "Taş Yuva'da kardeş gibiydik. Hatta o, benim için gerçek bir kardeşten daha değerliydi. Benimle şakalaşmaya bayılırdı. Ayrıca bana göz kulak olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591111
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591111,
					"content": "Haha neyse, içimden bir ses onun iyi olduğunu söylüyor. Bunu düşündüğümde, bu lanet yerde aldığım yaraların hepsi önemsiz geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591112
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591112,
					"content": "Umarım işini iyi yapıyordur ve beni düşünmüyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591113,
					"content": "Lyudochka... Inazuma'dakinden mi bahsediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591114
					]
				},
				{
					"id": 710591114,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591115
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591115,
					"content": "Yani kimliği ortaya çıktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591116
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591116,
					"content": "Nereden bildin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591117,
						710591118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710591117,
					"content": "Kaçmayı başardı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591119,
					"content": "Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591120
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591120,
					"content": "Haha... Bunu öğrendiğime sevindim. Umarım işi hâlâ yolunda gidiyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591121
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591121,
					"content": "Fakat ölüm korkusuyla Çariçe'ye ihanet ederse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591122
					],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591122,
					"content": "Umarım beni düşünmüyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katarina"
				},
				{
					"id": 710591118,
					"content": "Hâlâ hayatta ve durumu gayet iyi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591104,
					"content": "Biz de gelip seninle sohbet edelim dedik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				}
			]
		},
