				"points": []
			},
			"dialogs": [
				{
					"id": 210280101,
					"content": "Tam zamanında geldin, Gezgin! Ben de sana bir şey sormak istiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280102,
						210280103
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280102,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280105
					]
				},
				{
					"id": 210280105,
					"content": "Yolculuk uzun süreceği için yanımızda ilaç götürmemiz gerektiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280106
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280106,
					"content": "Baş ağrısı, ishal, güneş çarpması, akşamdan kalma gibi durumlarda kullanılacak ilaçlar ve sindirime yardımcı olacak şeyler falan... Say say bitmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280107
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280107,
					"content": "Aslında, niye akşamdan kalma ilacı gerekiyor ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280108,
					"content": "İş görüşmeleri içindir herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280109
					]
				},
				{
					"id": 210280109,
					"content": "Akşamdan kalma ilaçlarının iş görüşmeleriyle ne alakası olsun? Ne kadar çok içersen işler o kadar iyi gider diye bir şey yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 210280110,
					"content": "Her neyse, babam Bubu Eczanesine gitmemi ve ilaçların hazır olup olmadığını sormamı istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280111
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280111,
					"content": "Benimle gelir misin? Yardımcı olmanı istediğim bir konu var da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280112,
						210280113
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280112,
					"content": "Tamam, gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280115
					]
				},
				{
					"id": 210280115,
					"content": "Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280113,
					"content": "Hangi konuda yardım lazım?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280114
					]
				},
				{
					"id": 210280114,
					"content": "Oraya gidince konuşuruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280115
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280103,
					"content": "Hazırlıklar nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280104
					]
				},
				{
					"id": 210280104,
					"content": "Yani, hazırlığın çoğunu babam ve arkadaşları yapıyor... Ama babam bana da bir görev verdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280105
					],
					"speakerTitle": "Minik Meng"
				}
			]
		},
