			"dialogs": [
				{
					"id": 210280401,
					"content": "Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280402
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280402,
					"content": "Tamamdır, bunlar bir miktar ilaç yapmam için yeterli olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280403
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280403,
					"content": "Güneş çarpması ilacını bir sonraki partiyle birlikte size yollarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280404
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280404,
					"content": "Teşekkürler Gui Abi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280405
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280405,
					"content": "Bunlar da sana Gezgin. Yardımın için teşekkürler. Artık geri dönelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280406
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280406,
					"content": "Hehe, babam bunu duyunca sevinecek kesin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280407
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280407,
					"content": "Bekle bakalım Minik Meng.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280408
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280408,
					"content": "Hı? Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280409
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280409,
					"content": "İlaçları kontrol etmen gerekmiyor muydu senin? Arka taraftaki listeyi hâlâ bitirmedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280410
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280410,
					"content": "Ne? Ama... Saatlerce kontrol ettim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280411
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280411,
					"content": "Daha devamı var Minik Meng. O zaman hadi, kontrol sürecine devam edelim istersen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280412
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280412,
					"content": "Of... Tamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Meng"
				}
			]
		},
