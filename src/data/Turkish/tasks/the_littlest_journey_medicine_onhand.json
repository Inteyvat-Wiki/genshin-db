				"points": []
			},
			"dialogs": [
				{
					"id": 210280201,
					"content": "Hoş geldiniz. Bitkisel ilaç almak için mi geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280202
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280202,
					"content": "Minik Meng? Seni buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280203
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280203,
					"content": "Ha, tamam. Şimdi hatırladım. Şu ilaçlar için geldin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280204
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280204,
					"content": "Merak etme, neredeyse hazırlar. İlaçları babana parti parti göndereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280205
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280205,
					"content": "Gerçi babanın siparişleri için elimizdeki bütün bitkileri kullanmak zorunda kaldık. O yüzden bazı ilaçları daha sonra hazırlayabileceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280206
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280206,
					"content": "Bir bakalım... En büyük eksiğimiz Nane. Nane olmadığı için güneş çarpması ilacının üretimi durdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280207
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280207,
					"content": "Yani, tek sipariş veren baban değil sonuçta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280208
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280208,
					"content": "O zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280209,
						210280211
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280209,
					"content": "O zaman işe koyulma vakti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280210
					]
				},
				{
					"id": 210280210,
					"content": "Hehe, teşekkürler Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280213,
					"content": "Bitkileri toplama konusunda sana güveniyorum! Babam ilaçları kontrol etmemi istediği için benim burada kalmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280214
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280214,
					"content": "Haha, ne kadar çalışkan bir çocuksun sen öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280215
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280215,
					"content": "Pekala, seni böyle alalım o zaman. Seninle bu ilaçları detaylı bir şekilde inceleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280216
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280216,
					"content": "Vay be, ne kadar... fazla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280217
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280217,
					"content": "Önce bunlara bir bak. Diğer ilaçları birazdan getiririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280218
					],
					"speakerTitle": "Otacı Gui"
				},
				{
					"id": 210280218,
					"content": "Nasıl yani? Dahası mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 210280211,
					"content": "Ücretimi ödemeyi unutma da.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210280212
					]
				},
				{
					"id": 210280212,
					"content": "Hehe, sorun olmaz! Teşekkürler Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210280213
					],
					"speakerTitle": "Minik Meng"
				}
			]
		},
