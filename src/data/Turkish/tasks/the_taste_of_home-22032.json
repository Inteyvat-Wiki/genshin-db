			"dialogs": [
				{
					"id": 220320301,
					"content": "İşte bu! Hayalini kurduğum, evimi hatırlatan o koku işte bu! *hıçkırır* Çok duygulandım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320302
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320302,
					"content": "Çok teşekkür ederim! Bu yemek tüm keyfimi yerine getirdi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320303
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320303,
					"content": "Bunlar senin için. Sana iyi yolculuklar dilerim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
