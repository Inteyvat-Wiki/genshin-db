			"dialogs": [
				{
					"id": 220320201,
					"content": "Ne çabuk döndün? Yoksa sen gizli bir şef misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320202
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320202,
					"content": "Hım... Artık dayanamayacağım. Lütfen, bir an önce tadına bakmak istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320203,
						220320204
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320203,
					"content": "Afiyet olsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220320204,
					"content": "Bir bakalım... Hangi yemeklerden bahsediyorduk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320205
					]
				},
				{
					"id": 220320205,
					"content": "Şey... Sincap Balığı, Kara Sırtlı Levrek Yahnisi ve Mondstadt Usulü Izgara Balık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220320206,
					"content": "Birini seçip Tang Wen Hanım'a verelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
