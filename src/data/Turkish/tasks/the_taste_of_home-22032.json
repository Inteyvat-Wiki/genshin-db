					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320602
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320602,
					"content": "Aradığım kelime ilginç değildi... Yani nasıl desem? Eşsiz gibi bir şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320603
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320603,
					"content": "Böyle bir yemeği yapmayı nasıl başardın? Üstün bir aşçılık yeteneğin olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320604
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320604,
					"content": "Emeğin için minnettarım! Lütfen bunları kabul et Gezgin. Şey, bu yemeğin tadını daha sonra çıkaracağım...",
