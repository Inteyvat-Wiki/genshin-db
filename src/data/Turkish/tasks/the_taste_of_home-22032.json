			},
			"dialogs": [
				{
					"id": 220320801,
					"content": "Ah, şimdi bir Liyue yemeği ne güzel giderdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320802
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320802,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320803
					]
				},
				{
					"id": 220320803,
					"content": "Giysine bakılırsa... Sen Gezgin olmalısın. Kusura bakma lütfen, evimi biraz özledim de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320804,
						220320805
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320804,
					"content": "Az önce Liyue mutfağından bir yemeği tatmak istediğini mi söyledin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				},
				{
					"id": 220320818,
					"content": "Bir dakika... Liyue yemeği yapmayı biliyor musun? Vay be!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320819
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320819,
					"content": "O zaman lütfen bana yardım et! Bana Liyue mutfağına özgü bir şeyler yap lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320820
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320820,
					"content": "Acaba şu an ne yemek isterdim bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320821
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320821,
					"content": "Hımm... Balık yemek istiyorum! Çocukken annemin bana yaptığı balığı özledim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320822
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320822,
					"content": "Önce balığı yıkar, iki tarafına da bir çizik atıp içini baharatlarla doldurur ve yıllanmış bir şarapla güzelce marine ederdi. Sonrasında altın sarısı olana dek tavada kızartırdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320823
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320823,
					"content": "Ardından yüksek ateşte baharatlamadan, sosu koyulaştırmadan ve tabağa koyup servis etmeden önce yavaşça pişmesi için sıcak su ve sos eklerdi... Ah, yemek diye buna derim işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320824
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320824,
					"content": "Erkek kardeşim çıkıp \"Hadi yemek hazır!\" diye neşeyle seslenirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320825
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320825,
					"content": "*hıçkırır* Annemin yaptığı balığı çok özledim, keşke şu an oraya gidip yiyebilsem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320805,
					"content": "Yardımcı olabileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320806
					]
				},
				{
					"id": 220320806,
					"content": "Ah, evet. Lütfen kendimi tanıtmama izin ver. Adım Tang Wen, Liyueli bir tarihçiyim. Inazuma'nın eşsiz gelenekleri ve halk bilimi üzerine saha araştırması yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320807
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320807,
					"content": "Açıkçası ihtiyacım olan tüm malzemeleri toplamıştım ve Liyue'ye dönmeye hazırlanıyordum fakat son zamanlarda Inazuma'da çok şey yaşandı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320808
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320808,
					"content": "Tarihe tanıklık ediyormuş gibi hissediyordum, anlatabiliyor muyum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320809
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320809,
					"content": "Şu sıralar yaşananların Teyvat tarihinde büyük bir iz bırakacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320810
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320810,
					"content": "Bir tarihçi, yaşananlara bizzat tanıklık etmeli ve gelecek nesiller için bunları dürüstçe, eksiksiz ve açık bir şekilde kayda almalıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320811
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320811,
					"content": "Tüm bunlar her ne kadar heyecanlı görünse de karın doyurmuyor maalesef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320812
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320812,
					"content": "Acıktın galiba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320813
					]
				},
				{
					"id": 220320813,
					"content": "Aslında çok da aç değilim... Dürüst olmak gerekirse Inazuma mutfağı oldukça lezzetli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320814
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320814,
					"content": "Burada gerçekten güzel tempura yapıyorlar. Şu her şeyi hamura bulayıp kızarttıkları yemek var ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320815
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320815,
					"content": "Ancak uzun bir süre Inazuma mutfağından yedikten sonra insan memleketinin yemeklerini özlemeye başlıyor. Ne yazık ki burada Liyue mutfağına özgü yemekler yapan bir restoran bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320816
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320816,
					"content": "En sonunda ben de birkaç gün önce Maceracılar Loncasına bir \"mutfak görevi\" ilanı verdim; fakat henüz dönen olmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320817
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320817,
					"content": "Bir de benim denememi ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				}
			]
		}
	]
