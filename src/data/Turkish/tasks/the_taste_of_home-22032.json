			},
			"dialogs": [
				{
					"id": 220320101,
					"content": "Ah, canım Liyue yemeklerinden çekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320102
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320102,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320103
					]
				},
				{
					"id": 220320103,
					"content": "Giysine bakılırsa... Sen Gezgin olmalısın. Kusura bakma lütfen, evimi biraz özledim de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320104,
						220320105
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320104,
					"content": "Az önce Liyue mutfağından bir yemeği tatmak istediğini mi söyledin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				},
				{
					"id": 220320118,
					"content": "Bir dakika... Liyue yemeği yapmayı biliyor musun? Vay be!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320119
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320119,
					"content": "O zaman lütfen bana yardım et! Bana Liyue mutfağına özgü bir şeyler yap lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320120
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320120,
					"content": "Acaba şu an ne yemek isterdim bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320121
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320121,
					"content": "Hımm... Balık yemek istiyorum! Çocukken annemin bana yaptığı balığı özledim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320122
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320122,
					"content": "Önce balığı yıka, iki tarafına da bir çizik atıp içini baharatlarla doldur ve yıllanmış bir şarapla güzelce marine et. Sonrasında altın sarısı olana dek tavada kızart...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320123
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320123,
					"content": "Ardından sıcak su ve sos ekle. Son olarak yüksek ateşte baharatla, sosu koyulaştır ve tabağa koyup servis et... Ah, yemek diye buna derim işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320124
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320124,
					"content": "Erkek kardeşim çıkıp \"Hadi yemek hazır!\" diye neşeyle seslenirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320125
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320125,
					"content": "*hıçkırır* Annemin yaptığı balığı çok özledim, keşke şu an oraya gidip yiyebilsem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320105,
					"content": "Yardımcı olabileceğim bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320106
					]
				},
				{
					"id": 220320106,
					"content": "Lütfen kendimi tanıtmama izin ver. Adım Tang Wen, Liyueli bir tarihçiyim. Inazuma'nın eşsiz gelenekleri ve halk bilimi üzerine saha araştırması yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320107
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320107,
					"content": "Tam gereken bilgileri toplamış bir şekilde Liyue'ye dönmeye hazırlanıyordum ki Inazuma'daki Sakoku Fermanı yüzünden burada sıkışıp kaldım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320108
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320108,
					"content": "Aslında benim için iyi oldu denebilir çünkü bunun Inazuma için tarihi bir önemi olacağını düşünüyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320109
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320109,
					"content": "Şu sıralar yaşananların Teyvat tarihinde büyük bir iz bırakacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320110
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320110,
					"content": "Bir tarihçi, yaşananlara bizzat tanıklık etmeli ve gelecek nesiller için bunları dürüstçe, eksiksiz ve açık bir şekilde kayda almalıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320111
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320111,
					"content": "Tüm bunlar her ne kadar heyecanlı görünse de karın doyurmuyor maalesef...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320112
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320112,
					"content": "Acıktın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320113
					]
				},
				{
					"id": 220320113,
					"content": "Şey... Acıktığım için tabii... Hahaha, sonuçta Inazuma yemekleri de oldukça lezzetli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320114
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320114,
					"content": "Her şeyi hamura bulayıp kızartıyorlarmış gibi hissettirse de burada yapılan tempurayı gerçekten seviyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320115
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320115,
					"content": "Ancak uzun bir süre Inazuma mutfağından yedikten sonra insan memleketinin yemeklerini özlemeye başlıyor. Ne yazık ki burada Liyue mutfağına özgü yemekler yapan bir restoran bulamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320116
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320116,
					"content": "Sonunda ben de birkaç gün önce Maceracılar Loncasına bir \"mutfak görevi\" ilanı vermeye karar verdim fakat henüz dönen olmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320117
					],
					"speakerTitle": "Tang Wen"
				},
				{
					"id": 220320117,
					"content": "Ben deneyebilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				}
			]
		},
