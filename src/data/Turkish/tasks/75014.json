			"dialogs": [
				{
					"id": 750141001,
					"content": "#{NICKNAME} {M#Abi}{F#Abla}! Neyse ki güvendeymişsin. O kadar endişelendim ki anlatamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141002
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141002,
					"content": "Gerçekten çok heyecan vericiydi! Neyse, sonra konuşsak daha iyi olur. Durumlar biraz karışık da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141003
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141003,
					"content": "Taruka'ya kampta gördüklerinizi ve duyduklarınızı anlatıyorsunuz...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141004
					]
				},
				{
					"id": 750141004,
					"content": "Gerçekten mi? Lamizana'yı değil, Bayan Quilla'yı gördünüz demek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141005
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141005,
					"content": "Bir hava yarışından ve alışverişten bahsediyorlardı. Paimon ayrıntılarını pek duyamadı ama yarış sırasında kullanılacak bir şeyden konuştular.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141006
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141006,
					"content": "Bayan Quilla gezgin bir tüccardır, buraya geleli çok olmadı. Paran'ın anlattığı kadarıyla bir sürü farklı ürün satıyormuş. Lamizana ondan birtakım tehlikeli malzemeler almış olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141007
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141007,
					"content": "Anlıyorum. Demek o tehlikeli planını hava yarışı sırasında uygulamaya koyacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141008,
						750141009
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141008,
					"content": "Ne tür bir tehlikeli plandan bahsediyoruz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141010
					]
				},
				{
					"id": 750141010,
					"content": "Hiçbir fikrim yok ama tehlikeli bir şeyler planladığından adım gibi eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141011
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141011,
					"content": "#Aa, demek buradaydın. Süper! Sen {NICKNAME} olmalısın. Lamizana parkurda biraz idman yaptığını ve iyi bir iş çıkardığını söyledi bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141012,
						750141013
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141012,
					"content": "Eh, normaldi işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141015
					]
				},
				{
					"id": 750141015,
					"content": "Neyse, sana durumu açıklayayım. Yarış başlamak üzere ama Lliwa'yla yarışacak olan kişi son dakikada yarışmadan çekilme kararı aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141016
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141016,
					"content": "Taruka'nın huyu da malum işte... Rekabet onun olmazsa olmazı. Kolay bir galibiyet durumu yaşanırsa morali çok bozulur kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141017
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141017,
					"content": "Lliwa da yarıştan çekilsin de şartlar eşitlensin o zaman. Ben hemen gidip onu da çekilmeye ikna edeyim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141018
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141018,
					"content": "Dur canım, olur mu öyle şey? Lliwa bu yarış için çok çalıştı. Onun da emeğine yazık yani, yarışabileceği uygun bir rakip bulalım diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141019
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141019,
					"content": "#Bu yüzden mi {NICKNAME} ile konuşmak istedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141020
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141020,
					"content": "Evet. Katılırsan yarışı hangi sırada bitirirsen bitir, ödül vereceğiz sana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141021,
						750141023
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141021,
					"content": "Hah, şimdi beni küçümsüyorsun işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141022
					]
				},
				{
					"id": 750141022,
					"content": "Ne? Şey, doğru diyorsun gerçi... Katılım ödülünün yanı sıra bitirdiğin sıralamanın ödülünü de kazanacaksın diyelim o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141025,
					"content": "Çok teşekkür ederim! Davet mektubunu en kısa sürede göndereceğim. Şu anda halletmem gereken birkaç hazırlık işi var, yarış gününe kadar görüşemeyiz muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141026
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141026,
					"content": "Paran, Bulut'u da alıp uzaklaşır...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750141027
					]
				},
				{
					"id": 750141027,
					"content": "#Daha rahat araştırma yapmak için kabul ettin {NICKNAME}, değil mi? Yarışta şüpheli bir şey olursa ilk öğrenen kişiler yarışmacılar olacak sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141028,
						750141029
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141028,
					"content": "İçimden bir ses durumun göründüğü kadar basit olmadığını söylüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141031
					]
				},
				{
					"id": 750141031,
					"content": "Ha, sahi ya... Paran'ın sesi Paimon'a bir yerden tanıdık geldi. Yakın zamanda bir yerde duymuş olabilir miyiz sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141032
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141032,
					"content": "Uçuş okulundaki her şeyden o sorumlu. Bulut'la birlikte tüm işlere de o koşturuyor. Bu civardaki herkes onun sesini bir kez olsun duymuştur herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141033
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141033,
					"content": "Çok mantıklı! Paimon buna çok benzer bir hikaye okumuştu aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141034
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141034,
					"content": "Genelde arka planda kalan ve göze batmayan bir karakter suç işlediğinde insanlar o kişinin hep etrafta olmasına alışık oldukları için ondan hiç şüphelenmiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141035
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141035,
					"content": "Hımm... Bunu onun yanında söyleme istersen. Yaptıkları korkunç şeyler yüzünden sürgün edilen bir aileden geliyor kendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141036
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141036,
					"content": "Ailevi durumunu onun işini zorlaştırmak için kullanmaya çalışan da çok oluyor... Mizacı sert olsa da etrafındakilere karşı çok şefkatli davranmasının sebebi budur belki de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141037
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141037,
					"content": "Lamizana'yla epey yakın olabilirler ama gerçekten çok iyi bir insan olduğunu itiraf etmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141038,
						750141040
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141038,
					"content": "Lamizana nasıl biri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141039
					]
				},
				{
					"id": 750141039,
					"content": "Haşereler onun yanında kelebek kalır, o kadar söyleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141041
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141041,
					"content": "Paimon'u uyardığın için teşekkürler! Yanlışlıkla ona zarar versek çok üzücü olurdu. Neyse, yarışa dönelim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141042
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141042,
					"content": "#Kardeşin için hiç endişelenme Taruka. {NICKNAME} ona göz kulak olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141043
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141043,
					"content": "Hımm... Ben de sizi bitiş çizgisinde bekliyor olacağım o halde. Malum, Lamizana'yı göz hapsinde tutmak için sizden önce gidip onunla birlikte bitirmem gerekecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141044
					],
					"speakerTitle": "Taruka"
				},
				{
					"id": 750141044,
					"content": "Ruuu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141045
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141045,
					"content": "#Burası senin becerilerini kullanman için pek uygun değil {REALNAME[ID(2)|SHOWHOST(true)]}. Bu seferlik Paimon'la beraber olanları dışarıdan seyret, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141046
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141046,
					"content": "Raar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141040,
					"content": "Zor bir hayat geçirmiş olsa gerek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141041
					]
				},
				{
					"id": 750141029,
					"content": "Hayır, sadece katılım ödülü almak istemiştim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141030
					]
				},
				{
					"id": 750141030,
					"content": "Hadi ama biraz havaya girsene, en azından biraz havalı görünmek için!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141031
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141023,
					"content": "Güzel! Ödülüm garanti yani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141024
					]
				},
				{
					"id": 750141024,
					"content": "Hey, biraz hırslı ol yahu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141025
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141013,
					"content": "Öyle mi? Beni küçümsemeye mi kalktı yoksa?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141014
					]
				},
				{
					"id": 750141014,
					"content": "Hayır canım, alakası yok! Şey, Temach burada olsa ne derdi acaba... Hah, buldum! Kötü yarıştığından değil, idman parkurunun azizliğine uğradın sadece!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141015
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750141009,
					"content": "İyi de amacı ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141010
					]
				}
			]
