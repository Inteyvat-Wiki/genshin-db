					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141325,
					"content": "Kimse gelip de Iktomizoru suçlamaz tabii ama... Sen yine de böyle korkunç şeyler söyleme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750141326,
					"content": "Neyse. Paimon uçup ayarlamaları yapıyordu, o kadar! Hem dışarıda gürültü yapmasaydı siz de kaçma fırsatı bulamazdınız.",
					"roleType": "TALK_ROLE_NPC",
