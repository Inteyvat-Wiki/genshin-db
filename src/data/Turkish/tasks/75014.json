			"dialogs": [
				{
					"id": 750140801,
					"content": "(Hımm... Paimon buradan net göremiyor ama yaklaşırsak fark edilme ihtimalimiz var. En iyisi şimdilik olduğumuz yerden dinlemeye çalışalım.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750140802,
					"content": "En son gelen ürünlerin kalitesinden çok memnun kaldık. Bu seferki teslimat için de sana güveniyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140803
					],
					"speakerTitle": "Cuyen"
				},
				{
					"id": 750140803,
					"content": "Ne demek. Her zamanki prosedürü mü izleyelim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140804
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750140804,
					"content": "Evet. Malzemelerin hava yarışından önce teslim edilmesi gerekiyor. Birilerinin bu malzemelere ihtiyacı olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140805
					],
					"speakerTitle": "Cuyen"
				},
				{
					"id": 750140805,
					"content": "Hallederiz. Onların konuşması da bitmek üzeredir. Hadi işimizi halledip gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750140806
					],
					"speakerTitle": "Paran"
				},
				{
					"id": 750140806,
					"content": "(Aa, hemen gidiyorlar mı? Paimon bu kadar kısa süreceğini düşünmemişti... Hadi biz de geri dönelim. Dikkat et de yakalanma!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
