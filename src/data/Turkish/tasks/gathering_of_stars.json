				"points": []
			},
			"dialogs": [
				{
					"id": 736910101,
					"content": "Umarım bu küçük oyuncak herkesin hoşuna gider...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910102
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910102,
					"content": "Burada oynanacak ne var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910103
					]
				},
				{
					"id": 736910103,
					"content": "Sen... Sen Gezginsin, değil mi? Ben Rtawahist'ten Farbal.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910104
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910104,
					"content": "Şey, ne üzerine çalıştığımızı bilmiyorsun sanırım, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910105
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910105,
					"content": "Hım. Sanırım şeydi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910106
					]
				},
				{
					"id": 736910106,
					"content": "Biz yıldızlar üzerine çalışıyoruz... Tabii tam olarak böyle söylemek de doğru değil. Darşanın ilgilendiği birçok uzmanlık alanı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910107
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910107,
					"content": "Ne yazık ki araştırmalarımızla ilgili pek çok şeyi olduğu gibi açıklasak bile yoldan geçen insanlara bir şey ifade etmez... Hatta ilgilerini çekeceğini bile sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910108
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910108,
					"content": "Bir astroloji standı açarsam görevli öğrencilerin kendilerini akademik tartışmaların içinde bulup standı idare edemeyeceklerinden endişeliydim açıkçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910109
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910109,
					"content": "Uzun tartışmalar sonucu bir orta yol bulduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910110
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910110,
					"content": "Bu özel usturlabı görüyor musun? Üzerinde bir sürü yıldız var. Bu yıldızları belli bir görüntü oluşturacak şekilde düzenlemen gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910111
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910111,
					"content": "Bu görüntüler çok karmaşık değil. Ayrıca henüz çözülmemiş akademik tartışmalar da içermiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910112
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910112,
					"content": "Öhöm... Yani, şey... Akademik tartışmalara yol açmayacak basit ve eğlenceli bir yapboz tasarladık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910113
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910113,
					"content": "Gerçekten gergin görünüyorsun.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910114
					]
				},
				{
					"id": 736910114,
					"content": "Sonuçta bu oyun yıldızlarla ilgili. Bazı öğrenciler bunu duyduğu an terlemeye başlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910115
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910115,
					"content": "Bunun sadece bir oyuncak olduğunu, akademik araştırmalarla herhangi bir ilgisinin olmadığını kaç kişiye anlatmak zorunda kalıyorum tahmin bile edemezsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910116
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910116,
					"content": "Neyse boş ver. İlgini çektiyse bir deneyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736910117,
						736910119
					],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910117,
					"content": "Denemek isterim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910118
					]
				},
				{
					"id": 736910118,
					"content": "Tabii. Usturlap burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farbal"
				},
				{
					"id": 736910119,
					"content": "Şu anda yapmam gereken başka şeyler var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736910120
					]
				},
				{
					"id": 736910120,
					"content": "Pekala, ben Şenlik boyunca stantta olacağım. Oynamak istersen beklerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Farbal"
				}
			]
		}
	]
}