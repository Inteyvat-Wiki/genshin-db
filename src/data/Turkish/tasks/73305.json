					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050401,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050402
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050402,
					"content": "Hımm... Liloupar, iyi misin? Neden bu kadar sessizsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050403,
						733050404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050403,
					"content": "Şşş!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				},
				{
					"id": 733050405,
					"content": "Bekle... Bak. O parlıyor. Bu hiç normal değil, neyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050406,
					"content": "Cinin şişesi parlıyor ve satranç taşı ile aynı tonda titriyor gibi görünüyor.\\nZamanın geçişini tıpkı bir hücrede damlayan suyun sesi gibi duyabiliyorsun... Bir ömür de geçmiş olabilir, yalnızca bir an da.\\nFakat Liloupar tek kelime bile etmedi.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050407
					]
				},
				{
					"id": 733050407,
					"content": "Daha sonra sislerin arasından muhteşem bir şehir belirdiğini görüyorsun. Büyük, kalabalık ve soğuk.\\nToprak yarılıyor ve Gurabad'daki her şeyi yutuyor...\\nVe tam orada, dağın sırtına yaslanmış kapısı var. Sanki kadim dünyanın tüm pisliğini içermesine rağmen herkesin gözünden kaçmış gibi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050408
					]
				},
				{
					"id": 733050408,
					"content": "İşte Gurabad orada. Şimdi hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050409
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050409,
					"content": "Başım çok ağrıyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050410
					]
				},
				{
					"id": 733050410,
					"content": "Hey, neler oluyor size? Bir dahaki sefere Paimon'a önceden haber verir misiniz? Bu sürprizler Paimon'un kalbine iyi gelmiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050411,
						733050413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050411,
					"content": "Affedersin Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050412
					]
				},
				{
					"id": 733050412,
					"content": "Hıh! İşte Paimon'u kızdırmanın bedeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050415,
					"content": "Heh... Çocuk gibisin. Endişelenme, onu geri vereceğim ufaklık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050416
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050416,
					"content": "Zamanı geldiğinde seni istediğin bir sürü yiyecekle ödüllendirecek... Ve sizin ödeme biriminiz \"Mura\"ydı değil mi? Ondan da verecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050417,
						733050418
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050417,
					"content": "\"Mora\" o... Bir dakika, neden seni düzeltiyorum ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050419,
					"content": "Hehe, işte şimdi oldu... Paimon hepsini not aldı! Lezzetli yiyecekler ve Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050420,
					"content": "Tamam, oyun vakti sona erdi. Gurabad'a gidebiliriz efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050421,
						733050424
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050421,
					"content": "Neden oraya gitmek zorundayız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050422
					]
				},
				{
					"id": 733050422,
					"content": "Neden mi? Doğrusu bilmiyorum... Belki de sebebinin bir önemi yoktur ama benim orada olmam gerek. Öyleyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050423
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050423,
					"content": "Eğer bir sebebi olması gerekiyorsa efendim, sizin geçmişime ve aldığım derslere tanık olmanızı istediğim içindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050428,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050429,
					"content": "Bu biraz saçma geliyor... Paimon gerçekten anlamıyor ama sözlerin sanki bir veda gibi. Bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050430,
					"content": "Ah, hayır. Sadece size bir şeyler göstermek istiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050431
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050431,
					"content": "Bu da ne demek? Bilmece gibi konuşuyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050432,
					"content": "Özetle, lütfen beni takip edin. Sizi Gurabad'a götüreceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050424,
					"content": "Gurabad... Orada ne var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050425
					]
				},
				{
					"id": 733050425,
					"content": "Hiçbir şey. Hiçbir şey yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050426
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050426,
					"content": "Geriye kalanlar hayaletlerin hatıraları, asla geri dönüşü olmayan kırık hayaller ve tatlı intikamın damakta bıraktığı tattan ibaret... Benim için en azından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050427
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050427,
					"content": "Farkındayım, bu büyük bir istek... Ama umarım geçmişime ve aldığım derslere tanık olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050428
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050418,
					"content": "Benim adıma karar verme...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050419
					]
				},
				{
					"id": 733050413,
					"content": "Ben iyiyim Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050414
					]
				},
				{
					"id": 733050414,
					"content": "Hep öyle diyorsun zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050404,
					"content": "Liloupar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050405
					]
				}
			]
		},
