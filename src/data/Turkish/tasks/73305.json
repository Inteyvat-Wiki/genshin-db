				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050601,
					"content": "Vay! Satranç taşının yanındaydık ve birden bir şeyler oldu ve \"hop\" kendimizi burada bulduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050602,
					"content": "Nasıl oldu bu? Gerçekten harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050603,
					"content": "Hehe, bir kez daha ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050604,
						733050606
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050604,
					"content": "Bir daha! Bir daha!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050605
					]
				},
				{
					"id": 733050605,
					"content": "Hey, kendini biraz kontrol et! Çocuk musun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050608,
					"content": "Bu normal, koordinatlar yanlış. Belki de cihazın çok eski olmasındandır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050609
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050609,
					"content": "Hey... Bu bizim ilk gittiğimiz vadi değil mi? Neden bizi buraya getiriyorsun? Burada görecek bir şey var mı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050610,
					"content": "Çok fazla soru soruyorsun ufaklık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050611
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050611,
					"content": "Garip... Burada olması gerekiyor... Hah, işte burada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050606,
					"content": "Hayır, biraz başım döndü...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050607
					]
				},
				{
					"id": 733050607,
					"content": "Şimdi sen öyle deyince... Paimon'un başı da biraz sızlıyor sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050608
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7330509,
			"completionStepIds": [
				7330509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330509",
							"2"
						],
						"stepId": 7330509,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7330510",
							"3"
						],
						"stepId": 7330510,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Liloupar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733050901,
					"content": "Işık parçası Liloupar'ın büyülü şişesiyle birleşirken gücünün bir kısmının çekildiğini hissediyorsun...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050902
					]
				},
				{
					"id": 733050902,
					"content": "\"Shiruyeh, Khorramdin'in ta kendisi.\"\\nDedi pirinç maskeli adam.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050903
					]
				},
				{
					"id": 733050903,
					"content": "\"Adının varisi olmayacak. Tapınaklarındaki tüm sembolleri yok edeceğim. Sen aşağılık birisin ve hak ettiğin gibi seni mezara gömeceğim.\"\\nDedi pirinç maskeli adam.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050904
					]
				},
				{
					"id": 733050904,
					"content": "Cinin dalgın gözlerinden Gurabad'ın karanlığa gömülüşüne tanık oluyorsun...\\nGurabad Şehri uzun süredir bir su havzasına sahip fakat şimdi onun sakinleri her yere dağılıyor.\\nCinler, askerlerin silah olarak kullandığı soğuk makinalardan dışarı fırlıyor... Kızıl şarap ve nar suyu fışkırıyor...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050905
					]
				},
				{
					"id": 733050905,
					"content": "Narların üstünden geçiliyor ve kırılıp ezilerek büyük bir çamur kütlesi haline geliyorlar... Etli veya kurumuş, dolgun veya zayıf... Kızıl meyveler Khorramdin'in gelişini, yaşamın ve intikamın hazzını renklerle ve çığlıklarla müjdeliyor.\\nŞehir boyunca akan ve havzayı dev bir kızıl denize dönüştüren meyve suyunun tadı, tatlı şarap gibi hoş ve yumuşak...\\nDenizde önce köleler boğuluyor, sonra gecenin hırçın dalgaları arasında efendilerinin inlemeleri duyuluyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050906
					]
				},
				{
					"id": 733050906,
					"content": "En sonunda pirinç maskeli kralı görüyorsun. Karanlığa kaçıp Shirin'in kollarına sığınıyor...\\nShirin'in yüzü yaşlı ve loş, yaşam ve aklın tüm izleri gece rüzgarına kapılan toz gibi üzerinden silinmiş.\\nKaranlık bir canavara dönüşen Kral Kisra da orada... Hepsi senin kanından canından ama sen sevinçlisin. İntikamın sevincini yaşıyorsun.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050907
					]
				},
				{
					"id": 733050907,
					"content": "Ey Gurabad, ölümcül bir yara aldın ve yüzündeki utancını herkes görebiliyor...\\nDuyanlar alkışlayıp sevinç çığlıkları atacak...\\nÇünkü senin bitmek bilmeyen zorbalığına katlanmayan bir kişi bile kalmamıştı.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050908
					]
				},
				{
					"id": 733050908,
					"content": "\"Ey Gurabad, ölümcül bir yara aldın ve yüzündeki utancını herkes görebiliyor...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050909,
						733050910
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050909,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				},
				{
					"id": 733050911,
					"content": "Ormazd bir zamanlar Liloupar'ın sevgilisiydi. Basit bir çoban iken ölümlülerin krallığına yükselmesi Cin sayesinde oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050912
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050912,
					"content": "Bir zamanlar onun sadece ölümlü bir yoldaştan daha fazlası olabileceğini düşünmüştüm. Ahmak gibi gözlerine kandım... Ama kralların o kibrine ve bencilliğine sonunda o da kapıldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050913
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050913,
					"content": "Yaşayan ve ölen ölümlü hükümdarlardan hiçbir farkı kalmadı... Sadece fetih ve zulüm hayalleri arasında yaşadı ve kum bataklıklarına saraylar inşa etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050914
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050914,
					"content": "Bu yüzden, sen de onu indirdin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050915
					]
				},
				{
					"id": 733050915,
					"content": "Söylediğim gibi, onu cezalandırdım. Babadan oğula, üç nesil boyunca.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050916
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050916,
					"content": "Kisra Parvezravan ile Shirin, onlar benim kanımdan... Onlara kan ile komplo kurdum ve bal ile infaz ettim. Öfkeli hırsımla hepsini cezalandırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050917
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050917,
					"content": "Ama sadece bu değildi... *iç çeker* Hepsi bu değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050918,
						733050919
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050918,
					"content": "\"Cezalandırma\" hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050920,
					"content": "Benim kibirli evladım Parvezravan... Sonsuz güç istedi, ben de ona verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050921
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050921,
					"content": "Onun için Cin ruhlarının kalıntılarıyla çalışan makinalar tasarladım ve zifiri karanlık bir rüyanın içinde, yapay nesneleri yutup geri tükürebilen devasa bir makina yapması için ona ilham verdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050922
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050922,
					"content": "Onlar sınırsız bir zenginlik getirdi ama işçileri işlerinden, çiftçileri de topraklarından ettiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050923
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050923,
					"content": "Soylular ve zenginler gözyaşlarına boğuldular. \"Bu gerçekten ölümlülerin zaferi ve köleliğin sonu!\" Ancak bunu bir tek ben biliyordum ve durumun bir tek ben farkındaydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050924
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050924,
					"content": "Köleliğin kaldırılması, sonsuz ve zalim bir esaretin başlangıcıydı. Köle sahipleri kölelere bakma sorumluluğundan kurtulmuş, köleler de açlıktan kurtulma nimetinden mahrum kalmış oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050925
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050925,
					"content": "Ah, Paimon'un kafası karıştı... Sen neden bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050926
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050926,
					"content": "Fakirlik nefreti getirir, nefret de hırsı... Zenginlik açgözlülüğe yol açar, açgözlülük de hırsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050927
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050927,
					"content": "Hırs onu, hem kraliçesi hem de biyolojik ablası olan Shirin'i bilinçsiz ve ucube bir Cin yaratması için zorlamasına sebep oldu... Onun acı çekmesi ise beni memnun etti ve güçlendirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050928
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050928,
					"content": "... Böylece onların canlarını ve kanlarını büyütebildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050929,
						733050932
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050929,
					"content": "Shiruyeh'ten bahsediyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050930
					]
				},
				{
					"id": 733050930,
					"content": "Evet, Shiruyeh, Khorramdin'in pirinç maske giymiş halidir. Halk ve köleler, onu hanımlarının elçisi ve sefaletin kurtarıcısı olarak görüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050931
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050931,
					"content": "Bu yüzden o da onlara adaleti ve bir nevi... Ölümü kucaklamaları için önderlik etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050935,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050936
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050936,
					"content": "Hımm? Demek hâlâ buradasın ufaklık... Neden bu kadar sessizsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050937
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050937,
					"content": "Hımm... Paimon anlayamıyor... Ayrıca anlattıkların çok korkunçtu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050938
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050938,
					"content": "Ah, merak etme... Sadece geçmişimden... Ve kaderimden bahsediyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050939
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050939,
					"content": "Şey... Paimon... Paimon ne dese bilemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050940
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050940,
					"content": "Sayenizde hanımımın bahçesine dönebildim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050941
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050941,
					"content": "Bir dakika, neden aniden böyle bir şey dedin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050942
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050942,
					"content": "Gurabad, benim kaderimin olduğu topraklar. Bu yüzden kaderimin beni beklediği bu şehre geri dönmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050943
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050943,
					"content": "Şey... Geçmişte yaptığın yanlışları telafi etmek için falan mı dönmen gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050944
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050944,
					"content": "Yanlış mı? Ha! Ben hiçbir yanlış yapmadım. Fakat evlatlarım hâlâ orada. O ve Shiruyeh... Çok yalnız olmalılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050945
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050945,
					"content": "Yani demek istediğin şey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050946
					]
				},
				{
					"id": 733050946,
					"content": "Karanlığın gücü gittikçe arttı... Sadece bir annenin gücü onunla yüzleşmeye yetebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050947
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050947,
					"content": "Nefret ettiklerimi cezalandırmak için karanlık hiçliği kullanabileceğimi sanmıştım ama... Ne ekersen, onu biçersin... Benim kaderim de Gurabad'a girip onun intikamı ile yüzleşmek olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050948
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050948,
					"content": "Efendim... Uzun zamandır yanınızda olamadığım ve sizi yakından tanımaya daha fazla vaktim olmadığı için üzgünüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050949
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050949,
					"content": "Fakat biliyorum ki kader bizi tekrar bir araya getirecek. Sizin asla bozulmayan nitelikleriniz var. İnanıyorum ki... Doğru seçimi yapacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050950,
						733050951
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050950,
					"content": "Doğru seçim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050952,
					"content": "Genel olarak konuşacak olursak efendiler Cinlerini seçemez. Cinler ancak efendilerini seçebilir. Burada yollarımız ayrılsa bile, bağımızın kolay kolay kopacağını sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050953
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050953,
					"content": "Bu yüzden... Bu son hediyemi kabul edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050954
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050954,
					"content": "Tekrar beni... Çok yakından dinleyin lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050955
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050955,
					"content": "Büyülü şişeyi kulağına tutuyorsun...\\nKıkır kıkır gülen bir ses ile birisi kulağına yumuşak ve narin bir dilde sesleniyor...\\nKadının anlattığı şey derin bir pınar kadar anlaşılmaz ama sen her bir kelimesini anlıyorsun.\\nEn sonunda kelimeler kayboluyor ve kulağında yalnızca bir uğultu kalıyor...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050956
					]
				},
				{
					"id": 733050956,
					"content": "Onun rehberliği ile kadim dizelere aşina oluyorsun...\\nFakat daha fazlasını söylemiyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						733050957
					]
				},
				{
					"id": 733050957,
					"content": "Hey, baksana! Şişedeki ışık karardı... Liloupar! İyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050958
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050958,
					"content": "Liloupar! Liloupar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050959
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050959,
					"content": "(Şişedeki ışık soluklaşır ve ardından hafifçe yanıp sönmeye devam eder. Ancak o artık bir şey söylemez.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050960,
						733050961
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050960,
					"content": "Gitti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050962,
					"content": "Demek öyle... Aslında gerçekten veda ediyormuş... Onu tekrar görecek miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050963
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050963,
					"content": "Şey, biz şimdi... Gidecek miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733050961,
					"content": "Gurabad... Onu bekliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050962
					]
				},
				{
					"id": 733050951,
					"content": "Gidiyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050952
					]
				},
				{
					"id": 733050932,
					"content": "\"Pirinç Maske\"...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050933
					]
				},
				{
					"id": 733050933,
					"content": "Ah, evet... Pirinç maskeli Kral Shiruyeh, Khorramdin'in ta kendisi. \"Hanımların Elçisi\", \"Köle ve Fakirlerin Kurtarıcısı\"! Haha, becerikli bir düzenbaz o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050934
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050934,
					"content": "Ve sonunda kendisini takip edenleri kıyamete sürükledi... Yer onları yuttu ve tüm şehir birlikte karanlık yarığa gömüldüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733050935
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733050919,
					"content": "Gurabad'ın düşüşü hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050920
					]
				},
				{
					"id": 733050910,
					"content": "Yani...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733050911
					]
				}
			]
		},
