			"dialogs": [
				{
					"id": 733052201,
					"content": "Lütfen beni o satranç taşına bağlayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052202
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052202,
					"content": "B-Bağlamak mı? Neyi kastediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052203,
					"content": "Yüzeyindeki çıkıntıyı bulun ve şişemdeki boşluğa takın. Bu kadar basit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052204
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052204,
					"content": "Ha... Şişende onu takacak bir yuva mı var? Şişen epey pürüzsüz görünüyor ama... Takacak bir yer yok ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052205,
					"content": "Orada ama sen göremiyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052206
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052206,
					"content": "Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 733052207,
					"content": "Çünkü uydurdum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052208
					],
					"speakerTitle": "Liloupar"
				},
				{
					"id": 733052208,
					"content": "Ah... Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733052209
