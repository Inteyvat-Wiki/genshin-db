				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180201,
					"content": "Leydi Guuji. İşte buradayım, söz verdiğim gibi. Buraya yalnız geldiğimden ve bu yolculuktan kimseye bahsetmediğimden emin olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180202
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180202,
					"content": "Sözünü tutacağını biliyordum... Eminim son birkaç gündür kafanı zar zor toplamışsındır. Uyuyabildin mi bari?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180203
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180203,
					"content": "Sen... Çok yanılıyorsun. Klanımın liderlerinden asla şüphe etmem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180204
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180204,
					"content": "Pekala. Kanıtın nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180205
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180205,
					"content": "Burada.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180206
					]
				},
				{
					"id": 20180206,
					"content": "Ah, harika. Bugün herkes sözünü tutuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180207
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180207,
					"content": "Bunu ele geçirmek için ne badireler atlattığımıza hayatta inanmazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180208,
					"content": "Onları Sara'ya ver. Kendisi incelesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180209
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180209,
					"content": "Nedir bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180210
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180210,
					"content": "Bakıyorum da, bu belge Kujou Klanının resmi mührünü taşıyor. Ve hiç de sahteye benzemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180211
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180211,
					"content": "Anlamıyorum... Direniş hakkında tek kelime yok, Sangonomiya veya ön cephedeki durum hakkında da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180212
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180212,
					"content": "Ön cephede hayatlarını yitiren askerlere, insanların çektiği zorluklara ne olacak? Onların da hakkı yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180213
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180213,
					"content": "İnsanların hayatı hiçe sayılıyor. Bunu neden saklamak istesinler ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180214
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180214,
					"content": "Tabii ki de Önsezi Avı Fermanı için. Az önce bahsettiklerinin hepsi bu raporda geçseydi, Şogun sence de kararlarını baştan sorgulamaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180215
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180215,
					"content": "Yani Tenryou Heyeti... Şogun'u bilerek mi kandırıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180216
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180216,
					"content": "Evet. Şimdi... Sence Önsezi Avı Fermanından nemalanan başka kimler olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180217
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180217,
					"content": "Elimde ayrıca gizli bir mektup daha var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180218
					]
				},
				{
					"id": 20180218,
					"content": "Bu, Tenryou Heyetinin, Fatui'ye gönderdiği bir mektup. Kujou Klanının lideri bunu da Şogun'dan saklamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180219,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180220
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180220,
					"content": "Ee? Görmek istediğin ama bir o kadar da görmekten korktuğun şeylerin hepsi gözlerinin önünde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180221
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180221,
					"content": "Herhalde... Bunları da görmezden gelmeyeceksindir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180222
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180222,
					"content": "Yani bağlı olduğum her şey... Hepsi... Nasıl olur... Ahhh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180223
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180223,
					"content": "Bu ihanet affedilemez... Takayuki, hesap vereceksin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180224
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180224,
					"content": "Kujou Sara çok kızdı. Tenryou isyanımız başarıyla ilerliyor gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180225,
						20180226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180225,
					"content": "Şogun'un Ordusu lidersiz kaldı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				},
				{
					"id": 20180227,
					"content": "Evet evet, ona yetişelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180228,
					"content": "Bekle Gezgin. Konuşmamız gereken bir mesele daha var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180229
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180229,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180230,
					"content": "En son Zihnin Dinlenme Yerine girdiğinde, Alemüstü Tanrı'nın Heykelinin önündeydin, doğru mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180231
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180231,
					"content": "Doğru.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180232
					]
				},
				{
					"id": 20180232,
					"content": "O gün içinde bulunduğun durumu yeniden yaratmanın bir yolunu bulmalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180233
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180233,
					"content": "Şogun Raiden'ın, Alemüstü Tanrı'nın Heykelinin önünde bir kere daha sana \"kalbini açmasını\" sağlayabilirsen, ihtiyaç duyduğun fırsatı yakalayabilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180234
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180234,
					"content": "Elimden geleni yapacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180235
					]
				},
				{
					"id": 20180235,
					"content": "Bunu bir veda hediyesi olarak yanında götür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180236
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180236,
					"content": "Nedir bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180237,
					"content": "Büyük Narukami Tapınağının omamori tılsımı gerçekten kuvvetli. Senin için bir tane ayırayım dedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180238,
						20180239
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180238,
					"content": "Teşekkür ederim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180240,
					"content": "Hehe, aklını yitirecek gibi olursan, onu çıkar ve neler olacağını gör. Tüm duaların kabul olabilir ve tüm sorunların göz açıp kapayana dek yok olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180241
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180241,
					"content": "Veya yolculuğun boyunca aklına gelirsem de çıkar, olur mu? Kim bilir, belki bir anda karşında beliriveririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180242
					],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180242,
					"content": "Bu kadar yeter Tilki Kadın. Gezginle alay etmenin ne yeri ne de zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180243,
					"content": "Hehehe... Özür dilerim. Tamamdır o zaman... Çaresiz arkadaşımı sana emanet ediyorum. Sana güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yae Miko"
				},
				{
					"id": 20180239,
					"content": "Ona gözüm gibi bakacağım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180226,
					"content": "Onun izinden gidersek, Şogun Raiden ile karşılaşabiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				}
			]
		},
		{
			"id": 201803,
			"completionStepIds": [
				201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
