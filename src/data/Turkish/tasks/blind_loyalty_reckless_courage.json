				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Sara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180301,
					"content": "Beni buraya kadar takip mi ettiniz? Yalan yok, oldukça cesursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180302
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180302,
					"content": "Siz şahit olduğunuz için, Takayuki'den olup bitenleri öğrenene kadar tutuklanmanızı önleyebileceğimi sanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180303
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180303,
					"content": "Ama... Bu meselede dürüst davranmadıysanız hem anında tutuklanırsınız, hem de daha fazla suçtan yargılanırsınız. Anladınız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180304,
						20180305
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180304,
					"content": "Kesinlikle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				},
				{
					"id": 20180306,
					"content": "Hıh. Güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180305,
					"content": "Önden buyur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				}
			]
		},
		{
			"id": 201804,
			"completionStepIds": [
				201804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201804",
							"2"
						],
						"stepId": 201804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kujou Takayuki",
					"Kujou Sara",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180403,
					"content": "Dur! Sara, çıldırdın mı? Emirlerime nasıl karşı gelirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180404
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180404,
					"content": "U-usta, ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180405
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180405,
					"content": "Hadi, sor ona! Seni yıldırmasına izin verme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180406,
					"content": "... Usta Takayuki, hükümdara gönderilen raporu ve Fatui'ye yazılan mektubu gördüm... Lütfen, bana nedenini söyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180407
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180407,
					"content": "Yani karargahtaki belgelerim bu yüzden mi kayboldu? Onları çalmışsın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180408
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180408,
					"content": "Yani söylediklerinden... Bu belgelerin sahte olmadığını mı anlamam gerekiyor? Onları kendi ellerinle mi yazdın gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180409
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180409,
					"content": "Lütfen söyle bana Usta, bilmem gerek... Tenryou Heyeti gerçekten... Şogunluğa ihanet mi etti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180410
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180410,
					"content": "Of... Evet, Fatui ile iş birliği yapıyorum. Ve evet, gördüğün raporu kendi ellerimle yazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180411
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180411,
					"content": "Heh, şak diye itiraf etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180412
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180412,
					"content": "Snezhnaya'dan gelen diplomatlar çok cömert ödüller teklif ettiler... Benden tek istedikleri şey ise Önsezi Avı Fermanının onaylanmasıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180413
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180413,
					"content": "Uzun süredir herkesin gözü Kujou Klanının yerindeydi. Ellerine fırsat geçer geçmez, bizi lime lime edecek bir sürü klan var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180414
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180414,
					"content": "Bu yüzden güçlü başka bir ülkenin desteğini kazanma ve aynı anda tüm düşmanlarımızın da işini bitirme fırsatı doğunca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180415
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180415,
					"content": "Bana mükemmel bir anlaşma gibi geldi ve sana bilgi vermek için hiçbir neden göremedim Sara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180416
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180416,
					"content": "Ama... Sen Şogun'a tapıyorsun. Bunca şeyden sonra, ona ihanet edip de nasıl hiçbir şey olmamış gibi davranabilirsin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180417
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180417,
					"content": "İhanet mi? Buna nasıl ihanet diyebiliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180418
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180418,
					"content": "Fatui beni kullandığını düşünebilir ama aslında tam tersi. Amaçları ne olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180419
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180419,
					"content": "Inazuma'da şimşek çakınca, onlar korku ve endişe ile titreyerek diz çökecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180420
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180420,
					"content": "Sonuçta...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180421
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180421,
					"content": "Kimse Şogun Raiden'ın ve Musou no Hitotachi'nin üstün gücüne meydan okuyamaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180422,
						20180423
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180422,
					"content": "Amacı Şogun Raiden'a ihanet etmek değilmiş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				},
				{
					"id": 20180424,
					"content": "Evet... Şogun Raiden'ın kendisine değil, özellikle Musou no Hitotachi olmak üzere savaşçılık güçlerine tapıyor. Hatta biraz abartıyor gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180425,
					"content": "Ama Usta... Peki ya sadakat?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180426
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180426,
					"content": "Kujou Klanı beni evlat edindiğinden beri, hizmetkarların üstlerine olan sadakatinin ne kadar önemli olduğunu öğrettin bana...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180427
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180427,
					"content": "Ama artık sadece Kujou Klanına sadık kalmamı istediğini çok iyi görüyorum. Bir gün sana ihanet edeceğimden mi korkuyordun yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180428
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180428,
					"content": "İkiyüzlüsün! Kendi acınası bencilliğini gizlemek için erdemden bahsediyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180429
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180429,
					"content": "Bencillik mi? Ben sadece Kujou Klanının sonsuza dek var olması için uğraşıyorum. Yüce Şogun'un ve klanımızın eski liderinin bunu anlayışla karşılayacağından çok eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180430
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180430,
					"content": "Üzülerek belirtmeliyim ki egosu onu engelliyor. Kujou Klanının Fatui ile boy ölçüşebileceğini sanıyorsa, Paimon onun çok kötü bir sürprizle karşılaşacağını düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180431,
						20180432
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180431,
					"content": "Onunla tartışmanın manası yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180433,
					"content": "Eskiden Önsezi Avı Fermanından şüphe duyardım. Kendi kendime acaba doğru bir şey mi yapıyorum diye sordum. Kalbimce doğru olduğunu bildiğim şeylere zıt olsa da, bu doğru muydu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180434
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180434,
					"content": "Ama Şogun'un emrine uymaya karar verdim. O yolumuza önderlik ettiği sürece, henüz yolun sonuna ulaşmamış olan bizlerin, neyin doğru veya yanlış olduğunu sorgulamaya hakkı var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180435
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180435,
					"content": "Ama fark ettim ki sonsuzluğa giden yolun sonu yok ve bu yol... Senin bencil davranışlarınla uzun süre önce saflığını yitirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180436
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180436,
					"content": "Bu yüzden bu meseleyle ilgili tüm gerçekleri Şogun'a anlatacağım. Hiç olmazsa vicdanım rahatlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180437
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180437,
					"content": "İnatçı ve faydasız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180438
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180438,
					"content": "Canın istiyorsa Şogun'a haber ver. Artık kimse Kujou Klanıyla boy ölçüşemez ve ne yaparsan yap bunu değiştiremezsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180439
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180439,
					"content": "Şogun, <color=#00E1FFFF>Tenshukaku'da</color> \"Sinyora\" isimli bir Haberci olan Snezhnayalı diplomatı ağırlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180440
					],
					"speakerTitle": "Kujou Takayuki"
				},
				{
					"id": 20180440,
					"content": "Sinyora!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180441
					]
				},
				{
					"id": 20180441,
					"content": "Tüm bunların arkasında Sinyora mı var? Of, yine mi o kadın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180442
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180442,
					"content": "Leydi Hiiragi, Ritou'dayken Kanjou Heyetinin Başkanının kibirli bir kadınla buluştuğundan bahsetmişti... O zamanlar anlamamız gerekirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180443,
					"content": "Snezhnayalı bir diplomat mı? Tamam! Inazuma'dan tek parça halinde çıkabileceğini zannediyorsa, hayatının en büyük yanılgısını yaşıyordur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180444
					],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180444,
					"content": "Sara aceleyle gitti... Sence doğrudan Tenshukaku'ya mı dalacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180445
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180445,
					"content": "Ne olursa olsun, Sinyora ile çözmemiz gereken bir mesele var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180446
					]
				},
				{
					"id": 20180446,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180447,
					"content": "Tamam o zaman! Hadi bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180448
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 20180448,
					"content": "<color=#00E1FFFF>Tenshukaku'ya</color> gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kujou Sara"
				},
				{
					"id": 20180432,
					"content": "Kujou Sara ne düşünüyor bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180423,
					"content": "Sadece onun gücüne çok güveniyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				}
			]
		},
