			},
			"dialogs": [
				{
					"id": 736940101,
					"content": "Of, niye herkes bu kadar yorgun görünüyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940102
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940102,
					"content": "Burada bir etkinlik mi düzenliyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940103
					]
				},
				{
					"id": 736940103,
					"content": "Aa, sen Gezginsin, değil mi? Hahaha! Seninle tanışmayı çok istiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940104
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940104,
					"content": "Evet. Vahumana, bu defa arkeoloji temalı bir oyun hazırladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940105
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940105,
					"content": "Bizim Darşanımızda tarih alanında çalışan birçok araştırmacı var. Bu yüzden arkeolojik çalışmalar, özellikle de bizzat yerinde yapılanlar kaçınılmaz oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940106
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940106,
					"content": "Dur, dur hemen gerilme. Kimseden bizzat gidip arkeolojik kazı yapmasını istemiyoruz. Bu etkinliği bir arkeolojik \"faaliyet\" simülasyonu gibi düşünebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940107
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940107,
					"content": "Sumeru Şehri'nin her yerine yadigar kopyaları yerleştirip gömdük. Bu yerleri şimdilik \"Kazı Bölgesi\" olarak adlandırıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940108
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940108,
					"content": "Katılımcıların özel tasarladığımız dedektörlerle alanlara giderek gömülü kopyaları kazıp çıkarmaları gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940109
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940109,
					"content": "Diğer Darşanların öğrencileri sayesinde bir miktar kap ve dedektör üretebildik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940110
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940110,
					"content": "Ne dersin Gezgin? Denemek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940111,
						736940112
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940111,
					"content": "Çok zor olmasa gerek...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940113
					]
				},
				{
					"id": 736940113,
					"content": "Hahaha, güzel! İşte dedektörün. Kazı Bölgelerini <color=#00E1FFFF>Arkeoloji Rehberinde</color> işaretleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940114
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940114,
					"content": "Tamam, hazır. Pekala Gezgin, gidip arkeolojinin tadını çıkar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940115
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940115,
					"content": "Bütün yadigar kopyalarını bulduğunda geri gelip ödüllerini almayı unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940116
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940116,
					"content": "Kopyaları bulmak için dedektörleri izlemen yeterli. Hatta kopya türlerini elementlere göre farklı bölgelere ayırdık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940117
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940117,
					"content": "Fakat şöyle ki... Bu dedektörler aslında element taramalarında kullanılıyordu ve son anda yaptığımız değişikliklere rağmen yine de bazı elementlerden etkilenmiş olabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736940118
					],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940118,
					"content": "Kısacası tüm kopyaları kazıp çıkarman gerek. Sonrasında seni harika ödüller bekliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Daneh"
				},
				{
					"id": 736940112,
					"content": "Denemekten zarar gelmez...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736940113
					]
				}
			]
		}
	]
}