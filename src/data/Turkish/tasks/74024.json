					"content": "Benim şüphelerim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240705
					]
				},
				{
					"id": 740240705,
					"content": "Ama Sluasi gerçekten mutlu görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240708,
					"content": "Neyse, ikinize de yardımınız için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240709
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240709,
					"content": "Lütfen teşekkürüm olarak bunları kabul edin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240710
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240710,
					"content": "P-Parlak değerli taşlar! Parçalar da var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240711,
					"content": "Hehe, beğenmenize sevindim. Eğer ileride süs eşyası tasarlatmak isterseniz beni nerede bulabileceğinizi biliyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240706,
					"content": "Tamamen imkansız değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240707
					]
				},
				{
					"id": 740240707,
					"content": "Haklısın, Mamere'in kullandığı renkler de çok garip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240708
					],
					"speakerTitle": "Paimon"
				}
