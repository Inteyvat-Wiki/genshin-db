					"content": "Sluasi malzemeleri dikkatlice inceleyip sana geri verir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240301
					]
				},
				{
					"id": 740240301,
					"content": "Her neyse, ikinize de yardımınız için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240302
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240302,
					"content": "#Ancak sana ait olan bir şeyi öylece alamam saygıdeğer {NICKNAME}. Bu yüzden sadece bana malzemeyi söylemeni rica edeceğim ve ben de gidip onu kendim bulacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240303
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240303,
					"content": "Peki ama sence de bu renk biraz fazla... Yoğun değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240304
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240304,
					"content": "\"Güneşin rengi\" biraz daha hafif olmalı bence...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240305
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240305,
					"content": "Biraz daha \"beyaza\" yakın olmalı mı diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240306,
					"content": "Hımm, bu doğru. \"Güneş\", \"altından\" daha çok \"beyaza\" yakın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240307,
					"content": "\"Beyaz\" mı? Ama daha açık bir ton yakalamak için hangi malzemeleri kullanmam gerek emin değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240308,
						740240311
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240308,
					"content": "Sadece biraz su eklesek olmaz mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240309
					]
				},
				{
					"id": 740240309,
					"content": "Eskiden bunu denemiştim... Ama sonuç pek iyi olmadı. Bu şekilde elde edilen renkler daha bulanık oluyor ve güneşin o çarpıcı parlaklığını yansıtmıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240310
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240310,
					"content": "Başka bir malzeme kullansak daha iyi olur yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240314,
					"content": "Her neyse, etrafta bulabileceğimiz bir sürü parlak ve beyaz renkli şey var değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240311,
					"content": "Belki Paimon'un saçı işe yarayabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240312
					]
				},
				{
					"id": 740240312,
					"content": "Saçtan boya mı olurmuş ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240313,
					"content": "Olsa bile Paimon'un saçı koparılmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240314
					],
					"speakerTitle": "Paimon"
				}
			]
		},
