			"dialogs": [
				{
					"id": 740240516,
					"content": "Sluasi malzemeleri dikkatlice inceleyip sana geri verir...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240501
					]
				},
				{
					"id": 740240501,
					"content": "Ha anladım, demek \"beyaz\" dediğiniz renk bu, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240502
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240502,
					"content": "Nereden baksan bence bu \"güneşin renginin\" tam zıttı. O halde bunun zıt rengi daha uygun olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240503
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240503,
					"content": "\"Zıt rengi\" mi? Siyah mı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240504,
					"content": "\"Siyah\"... Evet, işte bu. \"Siyah.\" Ne harika bir çözüm saygıdeğer Paimon. Güneşin rengi tam da bu olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240505,
						740240506
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240505,
					"content": "Bu işte bir yanlışlık var sanki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240508
					]
				},
				{
					"id": 740240508,
					"content": "Peki neden siyah?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240509,
						740240510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240509,
					"content": "Yani, güneş altın rengi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240512
					]
				},
				{
					"id": 740240512,
					"content": "Öyleyse sizden bir şey daha isteyebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240513
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240513,
					"content": "Lütfen bana \"siyah\" renk bir şey getirin. Bu şekilde \"güneş kadar parlak bir renk\" oluşturmak için hangi malzemeyi kullanmam gerek anlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240514
					],
					"speakerTitle": "Sluasi"
				},
				{
					"id": 740240514,
					"content": "Bunu gerçekten bulmak zorunda mıyız? Paimon gittikçe güneşle ilgili olan şeylerden uzaklaştığımızı hissediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240515
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240515,
					"content": "Ama o böyle istediğine göre... Hadi gidip onun için \"siyah\" bir şeyler bulalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240510,
					"content": "Demek ki gece olunca da güneş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240511
					]
				},
				{
					"id": 740240511,
					"content": "Güneş geceleri siyah olmaz ki! Unut bunu, gece güneş yok bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740240506,
					"content": "Harika, senden de tam bu beklenirdi saygıdeğer Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240507
					]
				},
				{
					"id": 740240507,
					"content": "Hey, kes şunu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
