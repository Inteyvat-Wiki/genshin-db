			"dialogs": [
				{
					"id": 706670201,
					"content": "Miyav! (Harika! Yükseltme Mücadelesini tamamladığın için tebrikler! Şimdi Uzman bir oyuncusun!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670202
					],
					"speakerTitle": "Prens"
				},
				{
					"id": 706670202,
					"content": "(Artık daha fazla oyuncuyla mücadele etmeye hazırsın. Bu arada, belki çoktan yapmışsındır ama davet panosunda mücadele daveti paylaşabileceğini hatırlatayım...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670203
					],
					"speakerTitle": "Prens"
				},
				{
					"id": 706670203,
					"content": "Miyav... (Böylece seninle mücadele etmek isteyen biri seninle düello yapabilir. Rakibin hakkında bir şey bilmeden düelloya girmek bazen ilginç olabilir, sence de öyle değil mi?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670204
					],
					"speakerTitle": "Prens"
				},
				{
					"id": 706670204,
					"content": "(Sonuçta bir düello için bir araya gelmek, vakit geçirmek için de bir fırsattır.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680204
					],
					"speakerTitle": "Prens"
				},
				{
					"id": 706680204,
					"content": "#Miyav! (Ay! Pardon, konudan saptım. Neyse, sevgili {NICKNAME}, bir Uzman oyuncu olarak artık harika görünümlü kartlar alma ayrıcalığına sahipsin...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670205
					],
					"speakerTitle": "Prens"
				},
				{
					"id": 706670205,
					"content": "#({NICKNAME}, ilk olarak neden oynamaya başladığını sakın unutma ve Dehanın Yakarışı Kart Oyunu dünyasında eğlence seninle olsun!)",
					"roleType": "TALK_ROLE_NPC",
