			"dialogs": [
				{
					"id": 3740401,
					"content": "Barbatos seni kutsasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740402,
						3740404
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740402,
					"content": "Merhaba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740403
					]
				},
				{
					"id": 3740403,
					"content": "Sensin, demek! Yeni Favonius Şövalyesisin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740406,
					"content": "Neden buradasın? Büyük Kumandan Vekilinin verdiği görevler için mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740411
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740411,
					"content": "Aslında evet. Favonius Şövalyeleri Kutsal Liri ödünç almak istiyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740412
					]
				},
				{
					"id": 3740412,
					"content": "Öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740413
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740413,
					"content": "Sana güvenmediğimden değil. Tekinsiz bir ozan da Kutsal Liri ödünç almaya geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740414
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740414,
					"content": "Saçma sapan laflar etti, kendisinin Barbatos olduğunu bile söyledi. Bir şeylerin peşinde olduğundan eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740415
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740415,
					"content": "Kutsal Lirin kullanımıyla ilgili kurallar çok açık. Şu anda yalnızca Harpastum Festivalinde kullanılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740416
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740416,
					"content": "Büyük Kumandan, Vekilharç ve Cemaat Temsilcisi tarafından imzalanan belgeler gerekli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740417
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740417,
					"content": "Favonius Şövalyelerinin belgesini görebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740418,
						3740419,
						3740420
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740418,
					"content": "Büyük Kumandan böyle bir şey söylememişti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740422,
					"content": "İmzalı belge gerekiyor. Bu belge olmadan yapabileceğim bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740423
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740423,
					"content": "Şimdi izninle. Bir sürü işim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740419,
					"content": "Üzgünüm, yanımda getirmeyi unuttum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740420,
					"content": "Paimon buraya gelirken belgeyi yedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740421
					]
				},
				{
					"id": 3740421,
					"content": "Hey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740404,
					"content": "#Ben Fahri Favonius Şövalyesi, {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740405
					]
				},
				{
					"id": 3740405,
					"content": "Seni tanıyorum. O gün Amber ile birlikte Mondstadt'ı kurtarmıştınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "Gotelinde"
				}
			]
