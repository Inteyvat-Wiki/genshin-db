			"dialogs": [
				{
					"id": 3740201,
					"content": "Bu işi bana bırak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740202
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740202,
					"content": "Merhaba, Rahibe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740203
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740203,
					"content": "Rüzgar Tanrısı seni kutsasın genç ozan. Sana nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740204
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740204,
					"content": "Mondstadt'ı içinde bulunduğu durumdan kurtarabilecek bir sır biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740205,
					"content": "Yüce Rüzgar Tanrısı'nın lütfu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740206
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740206,
					"content": "Ama bunu Favonius Şövalyelerine bildirmelisin. Bana neden geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740207
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740207,
					"content": "Hahaha, çünkü sevgili rahibe, bana sen yardım edebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740208,
					"content": "Ben... Kutsal Liri ödünç almak istiyorum. Onunla Fırtına Dehşeti'nin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740209,
					"content": "Hemen dışarı çıkın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740210
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740210,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740211
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740211,
					"content": "Gerçekten zalim bir ejder, ama Büyük Kumandan Vekili kararını verdiğinde Şövalyelerin önünde kimse duramaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740212
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740212,
					"content": "Kesinlikle olmaz. Bu Fırtına Dehşeti'nin ölümü anlamına gelmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740213,
					"content": "O aptal canavar rüzgarlara ihanet etti. Rüzgar Tanrısı bile bunu affetmez!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740214
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740214,
					"content": "Vay be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740215,
					"content": "Lütfen, sana yalvarıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740216
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740216,
					"content": "Korkarım olmaz, küçük ozan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740217
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740217,
					"content": "(Tuhaf... Bu sevimli çocuğu reddettiğim için kendimi kötü hissediyorum...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740218
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740218,
					"content": "O halde... Sanırım başka seçeneğim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740219
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740219,
					"content": "Daha fazla saklanamam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740220
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740220,
					"content": "Müritlerim, şenlik zamanıdır! <color=#00E1FFFF>Rüzgar Tanrısı Barbatos</color> zuhur etti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740221
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740221,
					"content": "Hayretler içindesiniz, değil mi? İnsanın mutluluktan çığlık atası gelmiyor mu? Kendinizi adadığınız tanrıyla nihayet tanışmak nasıl bir duygu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740222
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740222,
					"content": "Başka bir şey yoksa şimdi Katedralin evrak işlerini halletmek için geri dönüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740223
					],
					"speakerTitle": "Gotelinde"
				},
				{
					"id": 3740223,
					"content": "Bekle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
		},
