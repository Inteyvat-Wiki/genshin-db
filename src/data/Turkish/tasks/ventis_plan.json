			"dialogs": [
				{
					"id": 3740701,
					"content": "Yani bu... \"Göklerin Kutsal Liri\"...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740702
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740702,
					"content": "Mondstadt'ın en değerli objelerinden biridir. Barbatos'un çaldığı lirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740703
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740703,
					"content": "Belki bununla Dvalin'in saplanıp kaldığı kabustan kurtarıp tekrar o eski nazik benliğini bulmasına yardımcı olabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740704
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740704,
					"content": "Bu gerçekten de Fırtına Dehşeti'nin daha fazla zarar vermesine engel olacak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740705,
					"content": "Elbette. Ben bu dünyadaki en iyi ozanım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740706
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740706,
					"content": "Bilmediğim tek bir şarkı yoktur benim. İster geçmişe ister şimdiye veya geleceğe ait olsun, hepsini bilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740707
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740707,
					"content": "Gözlerime bak. Bana güveniyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740708,
						3740709,
						3740710
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740708,
					"content": "... Gözlerindeki o şey de neyin nesi öyle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740711,
					"content": "Hahaha, bu bir ozana sökmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740712
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740712,
					"content": "Peki, Kutsal Liri nasıl alacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740713
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3740713,
					"content": "Katedralin derinliklerinde, güvenli bir yerde saklandığı söyleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740714
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740714,
					"content": "Ben gidip bakacağım. İstersen benimle gelebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740709,
					"content": "Gözlerime bak. Ne saklıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740710,
					"content": "Gözlerinin rengi tıpkı doğduğum şehrin göğüne benziyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				}
			]
