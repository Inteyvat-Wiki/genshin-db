						3740302
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740302,
					"content": "Neyse, en azından ben istediğim bilgiyi aldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740303
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740303,
					"content": "Kutsal Lirin Katedralde saklı olduğunu inkar etmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740304
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740304,
					"content": "#{NICKNAME}, Favonius Şövalyelerinin en beceriklisi sen olduğuna göre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740305
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3740305,
					"content": "Belki bu becerini ortaya koyabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
