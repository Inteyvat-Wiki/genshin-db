			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aigouy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740911701,
					"content": "Yardım edecek başkaları varken neden bu can sıkıcı bakım işleriyle kendin uğraşasın ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911702,
						740911706
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911702,
					"content": "Bu rıhtım hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911703
					]
				},
				{
					"id": 740911703,
					"content": "Meropide Kalesi'nde birçok boru hattı var. Birinin bakımını üstlenmesi gerekiyor tabii. Bizim işimiz de bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911704
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911704,
					"content": "Sağı solu sıkılamak gibi çoğunluğu küçük bakımlar. Büyük bir sorun olursa benim gibi birinin ne yapmasını bekliyorlar ki zaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911705
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911705,
					"content": "Elimden geleni yapıyorum işte. Mesela izin günümde insanların mektuplarını şehre götürüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740911706,
					"content": "Zaman ayırdığın için sağ ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911707
					]
				},
				{
					"id": 740911707,
					"content": "Bende zaman bol. Sonuçta beni meşgul eden hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aigouy"
				}
			]
		}
	]
}