			"dialogs": [
				{
					"id": 740911001,
					"content": "Biz geldik! Ufak birkaç sorun çıktı ama endişelenecek bir şey yok! Bize verdiğin talimatları takip ederek hepsini hallettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911002
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740911002,
					"content": "Yardımlarınız için çok teşekkürler. Bu güvenlik sorunlarını zamanında halletmeseydiniz çok geç kalacaktık, bu da daha kötü felaketlere davetiye çıkarırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911003
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911003,
					"content": "... İşte bu yüzden her ne kadar bana kol kanat gerdiğini bilsem de Mösyö Aigouy ile anlaşamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911004
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911009,
					"content": "Neyse, hayatımı kurtardığınız ve kontrolde yardımcı olduğunuz için tekrar teşekkür ederim. Lütfen bunu kabul edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911010
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740911010,
					"content": "Sizi burada tuttuğum ve yolculuğunuzu aksattığım için de kusura bakmayın. Yolunuz açık olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Balent"
				}
			]
		},
