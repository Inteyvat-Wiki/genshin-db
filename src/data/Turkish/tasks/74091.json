			"dialogs": [
				{
					"id": 740911601,
					"content": "Siz iki genç ne kadar da yetenekliymişsiniz öyle! Bir de şu Balent'a bakın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911602
