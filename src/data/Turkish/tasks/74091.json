			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Aigouy"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740910101,
					"content": "Umarım Dağ Yabanileri o çocuğu yakalayıp yahnisini çıkarmamıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910102,
						740910103
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910102,
					"content": "Hangi çocuğu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910105
					]
				},
				{
					"id": 740910105,
					"content": "Şuraya bakın. Suyun yanındaki Dağ Yabanisi kampını görüyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910106
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910106,
					"content": "O kamp yoktan var oluvermiş gibi adeta. Gece gündüz hiç dinlenmeden çalışıyorlar. *iç çeker* Tıpkı Balent gibi. Ah, o deli çocuk var ya...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910107
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910107,
					"content": "Bana sorarsanız bahtı açık bir çocuk o, dolayısıyla şu anda bir tencerede pişmiyordur diye tahmin ediyorum. Hatta kim bilir, biz burada konuşurken Dağ Yabanileri ile neşeyle laklak ediyordur belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910108
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910108,
					"content": "Yani oradaki Dağ Yabanilerinin tanıdığın birini kaçırdığını mı söylüyorsun? E niye bu kadar rahatsın o zaman? Doğruyu söylüyorsan hemen gidip kurtaralım şu çocuğu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910109,
					"content": "Kurtaralım mı? Niye ki? Böyle tehlikeli bir iş için kendini o kadar zorlamaması gerektiğini söylemiştim ona. Kontrol zamanı geldiğinde Estienne'e bildirmek yeterliydi. Bu işle ilgilenecek birini bulurdu o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910110
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910110,
					"content": "Sırf kalbimin iyiliğinden ona tüm bildiklerimi öğrettim. O karşılığını nasıl verdi peki? Açtı ağzını yumdu gözünü; işimi ciddiye almıyormuşum, görevimi ihmal ediyormuşum falan filan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910111
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910111,
					"content": "Büyüklerinin bilgeliğini ve tecrübesini ciddiye almayarak bu yolu kendi seçti. Gençlerin böyle arada bir hayatın dayağını yemesi lazım işte. Her şey güllük gülistanlık olursa nasıl yol yordam öğrenecekler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910112,
						740910113
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910112,
					"content": "İki tarafı da dinlemeden kim haklı bilemeyiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910114,
					"content": "Aynen öyle, gidip onu kurtarmamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910115,
					"content": "Dışarısı tehlikeli diyorum size! Ya sizin de başınıza bir şey gelirse?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910116
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910116,
					"content": "#Sen kafana takma onu, {NICKNAME} çok güçlüdür! Burada bekle, hemen döneceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910113,
					"content": "Çocuk tehlikede olabilir. Ölürse nasıl büyüyüp olgunlaşacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910103,
					"content": "Ne yahnisi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910104
					]
				},
				{
					"id": 740910104,
					"content": "Konumuz bu mu gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910105
					],
					"speakerTitle": "Paimon"
				}
			]
		},
