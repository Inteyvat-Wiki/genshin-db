			"dialogs": [
				{
					"id": 740910401,
					"content": "Çok... Çok iyisiniz. Çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910402
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910402,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910403,
					"content": "İyi... İyiyim... Sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910404
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910404,
					"content": "Hiç iyi görünmüyorsun ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910405
					]
				},
				{
					"id": 740910405,
					"content": "Beni şuradaki rıhtıma götürebilir misiniz acaba? Ben... Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910406
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910406,
					"content": "Tamam, daha fazla yorma kendini. Seni geri götüreceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
