			"dialogs": [
				{
					"id": 740910501,
					"content": "Mösyö Aigouy... Ben geldim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910502
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910502,
					"content": "Balent'ı kurtardınız demek... Sağ olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910503
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910503,
					"content": "Deli çocuk seni, ne zaman akıllanacaksın sen? Böyle tehlikeli bir iş için kendini o kadar zorlama dedim ya sana! Kontrol zamanı geldiğinde Estienne'e bildirsen yeterdi. Bu işle ilgilenecek birini bulurdu o.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910504
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910504,
					"content": "Sırf içimden geldi diye tüm bildiklerimi öğrettim sana. Sen ne yaptın peki? Açtın ağzını yumdun gözünü. İşimi ciddiye almıyormuşum, görevimi ihmal ediyormuşum falan filan... Söylemediğin şey kalmadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910505
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910505,
					"content": "Aldın mı ağzının payını? Senin halledemeyeceğin kadar tehlikeli bir işmiş meğer. Bana o zaman inanmamıştın, umarım şimdi dersini almışsındır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910506
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910506,
					"content": "Ben... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910507
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910507,
					"content": "Ne var? Hatalı olduğunu hâlâ kabul etmiyor musun? Diyecek bir şeyin varsa söyle hadi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910508
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910508,
					"content": "Biraz su içmek istiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910509
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910509,
					"content": "Balent bir şişe su bulup büyük yudumlarla içer, sonra da kuru bir ekmeği eliyle bölüp çiğnemeye başlar.\\nYaşlı adam ne derse desin söylenen hiçbir şeyi duymuyormuş gibi yapıp sadece yiyip içmeye odaklanır.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740910510
					]
				},
				{
					"id": 740910510,
					"content": "Yani en azından hâlâ hayattayım... Yardım ettiğiniz için teşekkür ederim, siz ikiniz olmasaydınız muhtemelen çoktan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910511
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910511,
					"content": "... Ailene senden kalan tek şey sigorta parası olmuştu muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910512
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910512,
					"content": "Büyük bir güvenlik sorununa neden olduğum için veya işten kaytardığım için kovulmaktan iyidir en azından!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910513
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910513,
					"content": "Seni bücür seni... *iç çeker* Söylediğim hiçbir şeyi dinlemiyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910514
					],
					"speakerTitle": "Aigouy"
				},
				{
					"id": 740910514,
					"content": "Bu söylediklerim size biraz yüzsüzce gelebilir arkadaşlar ama söylemek zorundayım... Herkesin güvenliği söz konusu burada.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910515
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910515,
					"content": "İkiniz suya dalmayı biliyorsunuz herhalde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910516
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910516,
					"content": "Evet ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910517,
					"content": "Dağ Yabanileri beni yakaladığında dalgıç kıyafetimi kaybettim. Rutin kontrolde de yedek kıyafetlerin hatalı olduğunu gördük ve yenilerini istememize rağmen henüz gelmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910518
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910518,
					"content": "Ne var ki boru hattının bakımını erteleyemeyiz. Siz ikiniz dalmayı biliyorsanız lütfen benim için gidip Kalenin boru hattını denetler misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910519
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910519,
					"content": "Tabii emeğinizin karşılığını alacaksınız. O konuda içiniz rahat olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910520
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910520,
					"content": "Herkesin güvenliğiyle alakalı bir durum olduğu için hayır demek olmaz ama... Boru hattının bakımını işinin ehli biri yapsa daha iyi sanki. Bizim yapabileceğimizden emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910521,
					"content": "Rutin bir kontrol sadece ya. Ufak birkaç sorun olabilir diye düşünüyorum, zira en son yapılan denetleme sırasında sızdırma riski olan dört alan vardı. Tamir etmesi de zor olmaz muhtemelen. Nasıl yapacağınızı anlatırım ben!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910522
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910522,
					"content": "Boru hattında <color=#00E1FFFF>gaz kaçağı</color> olduğunu fark ederseniz buna muhtemelen suda yaşayan bir canlı... Ya da boruya çarpan bir nesne sebep olmuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910523
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910523,
					"content": "Acil durum önlemlerine göre <color=#00E1FFFF>ayar vanasını düzelterek akışı kontrol altına almalı ve gaz kaçağını geçici olarak durdurmalısınız</color>. Yapmanız gereken tek şey bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910527
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910527,
					"content": "Ayar vanasını düzeltmenin de özel bir tekniği var tabii. <color=#00E1FFFF>El çarkını çevirirken gazın akış hacmine dikkat etmelisiniz. Hacim azalıyorsa doğru yoldasınız demektir.</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910524
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910524,
					"content": "Ha... Paimon anladı galiba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 740910525,
					"content": "İşle alakalı herhangi bir sorunuz olursa rutin kontrolü yapmadan önce istediğiniz zaman sorabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910526
					],
					"speakerTitle": "Balent"
				},
				{
					"id": 740910526,
					"content": "Tamamdır! Deneyelim bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
