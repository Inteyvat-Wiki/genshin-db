			"dialogs": [
				{
					"id": 750210501,
					"content": "Hepsi bu kadar, değil mi? Bu görev Paimon'un düşündüğünden çok daha kolay çıktı! Ancak, öyle mucizevi güçler gerçekten var mı? Paimon önceden pek inanmıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210502,
					"content": "Sen de gizli güçleri uyandırmak istiyorsun, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210503
					]
				},
				{
					"id": 750210503,
					"content": "#Ne sandın! Sen de müthiş hazine arama becerilerine ya da herhangi bir canavarı tek yumrukta yere serme gücüne sahip olsaydın her şey çok daha kolay hallolmaz mıydı? Hadi ama {NICKNAME}, bunu sen de isterdin, kabul et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210504,
						750210506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210504,
					"content": "Daha fazla güç istiyoruuum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210505
					]
				},
				{
					"id": 750210505,
					"content": "Ooo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210508,
					"content": "Hadi acele et ve parçaları yıldızın arkasına yerleştir! Vay canına... Acaba hangi güç uyanacak? Belki de göğe yükselirim... Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210506,
					"content": "Ben yeterince güçlüyüm. İhtiyacım yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210507
					]
				},
				{
					"id": 750210507,
					"content": "Ha? Ama güç arayışının hiçbir zaman son bulmayacağı söylenmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210508
					],
					"speakerTitle": "Paimon"
				}
			]
		},
