			},
			"dialogs": [
				{
					"id": 750210701,
					"content": "Vay canına! Harika! Tüm yıldız parçalarını bulmuşsunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210702
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210702,
					"content": "Mama Coco'ya yardım ederek epey Mora biriktirdim. Parçaları bana verirseniz tüm birikimlerimi size vereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210703
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210703,
					"content": "Yıldız parçaları mı? Ne işe yarıyorlar ki? Bu arada... Çocuk halinle burada tek başına ne arıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210704
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210704,
					"content": "... Bana Orqo derler, siz de öyle diyebilirsiniz. Gerçi bu sadece kod adım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210705
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210705,
					"content": "Buraya yıldız parçalarını toplamaya geldim! Aşağıdaki büyük kayayı gördünüz, değil mi? İşte o gökten düşen büyük bir yıldız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210706
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210706,
					"content": "Etrafa dağılmış parçaları toplayıp yerine geri koyarsak kayıp gücü geri kazanabiliriz... Size yalvarıyorum, bu yıldız parçalarına çok ihtiyacım var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210707,
						750210709
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210707,
					"content": "Oldukça şüpheli bir durum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210708
					]
				},
				{
					"id": 750210708,
					"content": "Evet... Ama yine de bir ipucu olarak kabul edilebilir, değil mi? Deneyip ne olacağını görelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210711,
					"content": "Ancak yine de yıldız parçaları, kayıp güç falan... Bir romandan fırlamış gibi hissettiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210712,
					"content": "Qoyllor ve Ukuku'nun hikayesini de mi duymadınız? Babam bana o kadar çok anlattı ki baştan sona ezberledim. Sizinle de seve seve paylaşabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210713
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210713,
					"content": "Ama önce birlikte aşağı inelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210714
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210714,
					"content": "Orqo ile birlikte \"düşen yıldız\"ın yanına geliyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750210715
					]
				},
				{
					"id": 750210715,
					"content": "Hadi acele et ve parçaları yıldızın arkasına yerleştir! Vay canına... Acaba hangi güç uyanacak? Belki de göğe yükselirim... Hehe!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210709,
					"content": "Vay, bu kadar iyi miymiş? Bu durumda onları sana kesinlikle veremem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210710
					]
				},
				{
					"id": 750210710,
					"content": "Hey, o alt tarafı bir çocuk! Biraz sakin davran. Ayrıca dediklerinin doğru olup olmadığını bile bilmiyoruz, birlikte deneyip görelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210711
					],
					"speakerTitle": "Paimon"
				}
			]
		},
