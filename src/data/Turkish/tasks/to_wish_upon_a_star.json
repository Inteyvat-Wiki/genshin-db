			"dialogs": [
				{
					"id": 750210101,
					"content": "Hey, ne yapıyorsun orada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210102,
					"content": "... Ayy! Korkudan ödümü kopardın! Ya düşseydim? Nasıl öderdin bedelini? Gizli güçlerim henüz uyanmadı, biliyorsun ben yalnızca savunmasız küçük bir çocuğum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210103
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210103,
					"content": "Ayy! Affedersin, Paimon seni korkutmak istemedi... Ancak... Gizli güçler mi dedin? Yani süper ötesi tekniklerin mi var yoksa başka bir şey mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210104,
					"content": "\"Gizli\" denmesinin bir sebebi var herhalde. Gizli olan bir şeyi ben nasıl bilebilirim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210105,
						750210106
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210105,
					"content": "Haklı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				},
				{
					"id": 750210107,
					"content": "Bunları sonra konuşuruz. Yıldız parçalarını bulmama yardım eder misiniz? Mama Coco'ya yardım ederek bir miktar Mora biriktirmiştim, hepsini size verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210108
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210108,
					"content": "#Madem yardımımızı istiyorsun, o halde en azından adını söylemeye ne dersin? Bu arada Paimon'un adı Paimon, bu da {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210109,
					"content": "Şu an bir kod adı kullanıyorum sadece... Ama herkes bana Orqo der, siz de öyle diyebilirsiniz. Ee, yıldız parçalarını toplamama yardım edecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210110
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210110,
					"content": "İyi de... Yıldız parçası ne ki? Pek karşına çıkabilecek bir şey gibi durmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210111,
					"content": "Yani gökyüzündeki yıldızlardan düşen parçalar. Onları bulup orijinal yerlerine geri koyarsanız kaybolan gücü yeniden kazanabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210112
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210112,
					"content": "Bakın! Düşen yıldız aşağıda, yakınlarda da yıldız parçalarını bulabilmek için ipuçları olmalı. Lütfen bana yardım edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210113
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210113,
					"content": "Peki, peki, bu kez sana yardım edeceğiz! Ancak yine de yıldız parçaları, kayıp güç falan... Bir romandan fırlamış gibi hissettiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210114,
					"content": "Qoyllor ve Ukuku'nun hikayesini de mi duymadınız? Babam bana o kadar çok anlattı ki baştan sona ezberledim. Sizinle de seve seve paylaşabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210115
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210115,
					"content": "Ama önce aşağı inip birlikte bir göz atalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210106,
					"content": "Daha çok küçük, saçmalıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210107
					]
				}
			]
		},
