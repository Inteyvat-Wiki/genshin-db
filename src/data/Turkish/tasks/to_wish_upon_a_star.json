			"dialogs": [
				{
					"id": 750211301,
					"content": "#{NICKNAME}, inanılmaz bir güç hissediyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211302,
					"content": "Pek sayılmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211303
					]
				},
				{
					"id": 750211303,
					"content": "Büyük kaya biraz bile değişmedi! Gizemli bir parlaklık, ani bir titreşim ya da çatırdayarak açılma gibi bir durum söz konusu değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211304,
					"content": "Aa, acaba yanlış büyüyü mü kullandık? Paimon'a doğru gelmişti gerçi ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211305,
					"content": "Harabeleri keşfederken bazen böyle durumlarla karşılaşıyoruz. Şifreyi veya sinyali yanlış hatırlıyorsan mekanizma karşılık vermez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211306,
					"content": "Tuhaf... O sözleri söyleyince gizli gücün açığa çıkacağı söylenmişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211307
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211307,
					"content": "Ve bunu diyen kişi sözleri söyledikten sonra gözlerini kapatmış ve acıyla inlemeye başlamıştı! Üstelik daha sonra, taşların değerini görebilen bir \"sihirli göze\" sahip olmuştu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211308,
						750211310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211308,
					"content": "Vay, çok havalı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211309
					]
				},
				{
					"id": 750211309,
					"content": "Ha? Paimon'a biraz şüpheli geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211311,
					"content": "Aman tanrım, sonunda buldum seni küçük şapşal! Buraya nasıl geldin? Baban öldü meraktan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211312
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211312,
					"content": "Yemek saatinde geleceğimi söylemiştim ona. Sana ne diye haber verdiyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211313
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211313,
					"content": "Bir de laf mı yetiştiriyorsun? Siz ikiniz, hadi bakayım siz de oyalanmayın burada! Aşağıda bu kadar çok vakit geçirirseniz kim bilir başınıza neler gelir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211314
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211314,
					"content": "Orqo'yu geri getirip durumu açıklıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750211315
					]
				},
				{
					"id": 750211315,
					"content": "*iç çeker* Bahsettiği şeyler hep çocukça hayaller. Affedersiniz, bu haylaz sizi de kendi işlerine alet etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211316
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211316,
					"content": "Kimse onu disipline etmediği için iyice şımardı. Başında annesi yok, babasının da görme yetisi zayıf. Komşusu olarak yardım etmeye çalışıyorum ama benim de enerjim sınırlı sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211317
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211317,
					"content": "Ha, demek öyle! Paimon anlamıştı! Böyle bir şeyin gerçek olmasına imkan yok... Birkaç taş parçası toplayıp gizemli güçlere sahip olmak falan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211318,
					"content": "Ben şımarık değilim, babam için yapıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211319
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211319,
					"content": "Kuş beyinli gibi davranma! Büyüklerini dinlemediğin için böyle oluyor. Neyse ki bu sefer sağ salim buldum seni, ancak bir gün başın gerçekten belaya girerse neler olacağını hiç düşündün mü?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211320
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211320,
					"content": "Of, bu kadar yeter! Şimdi uslu davran ve benimle geri gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211321
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211321,
					"content": "Pekala... Ama önce... Alın bakalım. Anlaştığımız gibi, bu Mora sizin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211322
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211322,
					"content": "Alın. Sözünü tutmayan biri olmasını istemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211323
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211323,
					"content": "Madem öyle diyorsun... Alalım bari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211324
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211324,
					"content": "Evet, hem belki ileride yardımınıza ihtiyacım olur! Bu sefer başarısız olduk ama bir dahakine de aynı şey olacak diye bir kaide yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211325
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211325,
					"content": "... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750211326,
					"content": "Seni küçük serseri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750211327
					],
					"speakerTitle": "Mama Coco"
				},
				{
					"id": 750211327,
					"content": "Hadi Mama Coco. Gidelim, babam bekliyor. İkinize de teşekkürler, tekrar görüşmek üzere!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750211310,
					"content": "Bu semptomlar tanıdık geliyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750211311
					]
				}
			]
		},
