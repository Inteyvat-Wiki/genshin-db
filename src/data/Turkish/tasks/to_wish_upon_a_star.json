			},
			"dialogs": [
				{
					"id": 750210301,
					"content": "Siz olmasaydınız tek başıma asla başaramazdım, teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210302
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210302,
					"content": "Düşen yıldız bu mu? Yakından bakınca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210303,
						750210306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210303,
					"content": "Aaaa! Gizemli bir güç bedenime yayılıyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210304
					]
				},
				{
					"id": 750210304,
					"content": "Ha? Gerçekten mi? Hey, ama daha etrafa saçılmış parçaları bile bulmadık ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210305,
					"content": "Parçalar demişken, burada gerçekten ipuçları var mı? Paimon göremiyor da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210308,
					"content": "Şimdi ne yapıyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750210309,
					"content": "Fiziksel gücümüze güvenmeliyiz. <color=#00E1FFFF>Bir Tepetlizorun tüm gücüyle vurmasını sağlarsak</color> belki kayıp parçaları bulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210310
					],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210310,
					"content": "Kaba kuvvet birçok sorunu çözebilir! Babam hep öyle söyler. Ama henüz gücümü uyandırmadım ve Sürüngenim de yanımda değil... Elimde sadece siz varsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Orqo"
				},
				{
					"id": 750210306,
					"content": "Ne tuhaf bir kaya.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750210307
					]
				},
				{
					"id": 750210307,
					"content": "Eşsiz bir kayaya benziyor... Ama Paimon biraz yavaş mı kaldı nedir, gizemli gücü falan hissedemedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750210308
					],
					"speakerTitle": "Paimon"
				}
			]
		},
