			"dialogs": [
				{
					"id": 401060101,
					"content": "20 yıl önce Akademi, Sachin'in mal varlığını yeni almıştı. O yılki Akademi Cümbüşü, bu büyük yatırımı kutlamak için normalden daha büyüktü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060102
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060102,
					"content": "O zamanlar çok küçüktüm ama Darşanlar Şampiyonası afişlerinin şehrin her yerinde olduğunu hatırlıyorum. Dayanamayıp babama sormuştum. Hatta ona tacı çok beğendiğimi ve çok eşsiz olduğunu da söylemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060103
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060103,
					"content": "O da bana \"Birkaç gün oynaman için onu kazanabilirim.\" demişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060104
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060104,
					"content": "Bu beni çok mutlu etmişti ve ben de kafamı heyecanlı bir şekilde sallamıştım ama kazanamamıştı ve eve geldiğinde çok üzgün görünüyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060105
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060105,
					"content": "Daha sonra çölde bir şeyi araştırmak istediğini söyleyip evden çıkmıştı... Çok geçmeden de bataklığa yakalanmıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060106
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060106,
					"content": "... Yıllarca bununla yüzleşemedim. Eğer çenemi kapalı tutsaydım bunların hiçbiri olmayacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaveh"
				}
			]
		},
		{
			"id": 7352402,
			"completionStepIds": [
				7352403
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352403",
							"2"
						],
						"stepId": 7352403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaveh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060107,
					"content": "Baban o yıl Sachin'i görmüş olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401060108
					]
				},
				{
					"id": 401060108,
					"content": "Bir dakika... Yani araştırmamızda karşılaştığımız, çöle yirmi yıl önce gitmiş olan kişi... O...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401060109,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060110
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060110,
					"content": "... Haha... Sachin o yüzden mi tanıdık olduğumu düşündü? İnanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060111
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060111,
					"content": "... Babamın iyiliği kendisine zarardı. Sachin'in araştırması onu çok üzmüştür. Bu araştırmayı duyduktan sonra halen acı çeken insanlara yardım etmek için çöle gitmiş olmalı... Şimdi her şeyi anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060112
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060112,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060113
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060113,
					"content": "Yıllarca kendime sürekli bu üzüntüsünün nedeninin yarışmayı kazanamaması değil de benim bilmediğim başka bir şey olduğunu anlatmaya çalıştım ama... Yine de her şey ona yarışmadan bahsetmemle başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060114
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060114,
					"content": "Ay, Kaveh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401060115,
					"content": "Endişelenme. Tacı yok ettim. Bir daha asla bunun gibi bir trajedi yaşanmayacak. Asla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaveh"
				}
			]
		},
		{
			"id": 7352403,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352403",
							"2"
						],
						"stepId": 7352403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaveh"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060116,
					"content": "(Araştırmanın sonucundan bahsetme.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401060117
					]
				},
				{
					"id": 401060117,
					"content": "Özür dilerim... Hâlâ Şampiyonayı düşünüyordum. Biraz dalmışım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060118
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060118,
					"content": "Çok üzgün görünüyorsun... İyi olduğuna emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401060119,
					"content": "İyiyim. Geçmiş, geçmişte kaldı. Artık geleceğe bakma zamanın geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaveh"
				}
			]
		},
		{
			"id": 7352404,
			"completionStepIds": [
				7352406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352406",
							"2"
						],
						"stepId": 7352406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Kaveh",
					"Alhaitham"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 401060201,
					"content": "Biz yemek yerken sen ne yapıyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060202
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060202,
					"content": "Sana mazeret vermem gerektiğini hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060203
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060203,
					"content": "Kitap okumak için başka bir yer mi buldun? Kendini biraz değiştirmelisin. Sadece kitap okuyarak hayatta kalamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060204
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060204,
					"content": "Senin ısmarladığın yemeklerle de hayatta kalınmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060205
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060205,
					"content": "Sen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060206
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060206,
					"content": "Hıh, neyse. Ne yaptığını tahmin etmek için bir dahi olmaya gerek yok... Sachin'i araştırıyordun, değil mi? Notlarından belli zaten. Bununla birlikte yalnızca araştırmasının senin ilgini çekmeye yeteceğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060207
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060207,
					"content": "Onun işleri halletme şekli rahatsız ediciyken seninki... Yani senin felsefe anlayışın da beni rahatsız etmiyor değil ama sen ve Sachin birbirinize hiç benzemiyorsunuz. Görüşlerinizin birbirleriyle hiç alakası yok. Bencillik ve nihilizm aynı şey değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060208
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060208,
					"content": "Konuya olan şahsi ilgim bir kenara, Sachin'in araştırması tamamen anlamsız değildi. Deneylerini büyük ölçüde yaptı ve bulgularını kayıt altına aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060209
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060209,
					"content": "Ayrıca iltifatın için teşekkür ederim ama sadece buradan geçiyordum, sohbet için gelmedim. Özellikle de bu konuyu konuşmak için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060210
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060210,
					"content": "Derken? Alimler arasında farklı felsefeleri tartışmaktan daha kutsal bir sohbet olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060211
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060211,
					"content": "Öğrendiklerimden yola çıkarak ve senin de dediğin gibi Sachin'in \"işleri rahatsız edici bir şekilde halletmesini\" göz önünde bulundurursak yirmi yıl önce babanla tanışmış olması muhtemel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060212
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060212,
					"content": "... Ne dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060213
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060213,
					"content": "... Yani... Hayır, yoksa bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060214
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060214,
					"content": "Hah. Demek o yüzden tanıdık göründüğümü söyledi. Babam çöle onun yüzünden gitmiş olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060215
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060215,
					"content": "Ne yazık ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060216
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060216,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060217
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060217,
					"content": "Tacı iyi ki kırmışım. Bundan sonra... Böyle bir şey bir daha asla yaşanmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060218
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060218,
					"content": "Bilginin sınırı yok. Eninde sonunda birisi onun araştırmasını devralacak ve Vahumana da bunu mantıklı bir araştırma yönü olarak görüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060219
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060219,
					"content": "Of, yine buna başlama... Haklı olsan ve insanlar yine bu aynı fikirsel tuzaklara düşmeye mahkum olsalar bile tüm bunların sonucu aynı olacak diye bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060220
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060220,
					"content": "Bir insanın davranışının tüm bir grubu temsil etmediğini ve bunun tam tersinin de geçerli olduğunu kabul etmen lazım. Mesela Sachin'i örnek gösterebilirim. Kendisi tamamen aykırı birisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060221
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060221,
					"content": "Ve onu durduran kişi, yani sen de ondan pek farklı değilsin. Bu türden çelişkiler her ne kadar nadir olsalar da gelecekte tekrar yaşanacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060222
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060222,
					"content": "Sen, bir insanın davranışı tüm bir grubun davranışlarını temsil etmez dememiş miydin? Seninle aynı durumda olan kişilerin farklı kararlar verebileceğini biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060223
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060223,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060224
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060224,
					"content": "... Öyle olsa bile ben görüşlerimin arkasındayım. Beni ikna edemezsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060225
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060225,
					"content": "Benim için hava hoş. Zaten yıllardır tartışıyoruz, bir şey anlamanı beklemiyorum. Tartıştığımız konu kimin haklı, kimin haksız olduğunu çoktan aştı bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060226
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060226,
					"content": "... Tüm bunları bana anlattığın için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060227
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060227,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060228
					],
					"speakerTitle": "Alhaitham"
				},
				{
					"id": 401060228,
					"content": "Bana anlattığın için teşekkür ederim dedim. Hey! Duymuyormuş gibi davranma! Bilerek böyle yapıyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401060229
					],
					"speakerTitle": "Kaveh"
				},
				{
					"id": 401060229,
					"content": "Samimi bir teşekkürün üç kere söylenmesi gerekir derler... O yüzden, bir kere daha lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Alhaitham"
				}
			]
		}
	]
}