			"dialogs": [
				{
					"id": 200400401,
					"content": "Hımm... Bugün de deniz durgun ve rüzgar sakin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400402
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400402,
					"content": "Ailem nesiller boyu Mondstadt için burada nöbet tutarak yaklaşmakta olan fırtınaları gözlemledi. Bu görevi bize ilk veren Leydi Vennessa'ydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400403
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400403,
					"content": "Lord Barbatos Mondstadt'ı korumaya başladığından beri tek bir fırtına bile görmedik ve gözetleme kuleleri de iyice bakımsız hale geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400404
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400404,
					"content": "Yine de bu gözetleme kulesine gelmeden yapamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400405,
						200400408
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400405,
					"content": "Kendini bu işe gerçekten fazlasıyla adamışsın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400406
					]
				},
				{
					"id": 200400406,
					"content": "Teşekkür ederim. Ama görevime dönecek olursak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400407
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400407,
					"content": "Bu görevi hiç yerine getirmek zorunda olmamayı isterdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400410,
					"content": "Her neyse. Yardımın için teşekkürler. Bu Rüzgargülü Çiçekleri senin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400411
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400411,
					"content": "Geçmişte ailem bir yerde rüzgarın kuvvetini anlamak için orada yetişen Rüzgargülü Çiçeklerine bakardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400412
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400412,
					"content": "Rüzgargülü Çiçekleri rüzgar olmayan ya da kuvvetli fırtınaların uğramadığı yerlerde yetişemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400413
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400413,
					"content": "Yalnızca Mondstadt gibi rüzgarın hoş ve besleyici olduğu yerlerde çiçek açabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400414
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400414,
					"content": "Umalım da sonsuza kadar burada büyümeye devam etsinler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400408,
					"content": "Çok acıklı bir hikaye...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400409
					]
				},
				{
					"id": 200400409,
					"content": "Evet. Umarım tarihin bu kısmı tekerrür etmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400410
					],
					"speakerTitle": "Vind"
				}
			]
		},
