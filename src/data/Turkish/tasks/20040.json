			"dialogs": [
				{
					"id": 200400101,
					"content": "*iç çeker* Buradan nasıl geçeceğim ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400102
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400102,
					"content": "Merhaba... Bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400103
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400103,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400104
					]
				},
				{
					"id": 200400104,
					"content": "Fırtınakesen Burnu'ndaki gözetleme kulesine çıkmaya çalışıyorum. Denizde yaklaşmakta olan yeni bir fırtına var mı diye bakmak istiyorum da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400105
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400105,
					"content": "Ama ileride yolu tıkayan canavarlar var. Oradan nasıl geçeceğimi bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400106
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400106,
					"content": "Endişelenme, benim için gözetleme kulesine gitmeni istemeyeceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400107
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400107,
					"content": "Bu benim görevim ve ne olursa olsun benim halletmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400108
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400108,
					"content": "Senin de yapacak çok işin vardır. Devam et, benim için endişelenme. Bir yolunu bulurum ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
