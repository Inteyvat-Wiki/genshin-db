			},
			"dialogs": [
				{
					"id": 200400201,
					"content": "Bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400202
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400202,
					"content": "Canavarlar artık yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400203
					]
				},
				{
					"id": 200400203,
					"content": "Gerçekten mi? Rüzgar Hükümdarı'na şükürler olsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400204
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400204,
					"content": "Yani, üzgünüm. Söylediğimi geri alıyorum. Asıl sana teşekkür etmem gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400205
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400205,
					"content": "Sana borcumu nasıl ödeyebilirim? Ah, buldum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400206
					],
					"speakerTitle": "Vind"
				},
				{
					"id": 200400206,
					"content": "Gözetleme kulesinin en üst katında benimle buluş. Seni bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Vind"
				}
			]
		},
