			"dialogs": [
				{
					"id": 200400501,
					"content": "Bunu halledebilirmiş gibi konuşuyor ama gerçekten çok fazla canavar var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400502,
					"content": "Hadi yolu Bayan Vind için temizleyelim olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400503,
					"content": "Şuna bak... Kuleye varmak için ciddi ciddi koşmayı düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400504,
						200400505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400504,
					"content": "Tamamdır, hadi yapalım şunu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400506
					]
				},
				{
					"id": 200400506,
					"content": "Paimon'a sorarsan böyle iyi kalpli insanlar biraz yardımı hak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400505,
					"content": "Hayatımda böyle bir adanmışlık görmedim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200400507
					]
				},
				{
					"id": 200400507,
					"content": "Bu, olabilecek en kötü şey olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200400508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 200400508,
					"content": "Öyle olmasına izin vermeyelim, gidip şu canavarları ortadan kaldıralım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
