			"dialogs": [
				{
					"id": 401720101,
					"content": "Hey, ben geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720102
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720102,
					"content": "Aa, nine. Hoş geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720103
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720103,
					"content": "İyi haberleriniz var mı bana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720104
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720104,
					"content": "#Aklımı okudun nine. {NICKNAME} bir sürü ruh topladı, ben de tek tek hepsini kontrol ettim. Ancak hiçbiri Leyla'yla uyuşmuyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720105
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720105,
					"content": "Anlamıştım. Yüzünden belliydi zaten. Neyse zaten samanlıkta iğne arayarak bulacağımıza dair pek umudum yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720106
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720106,
					"content": "Leyla'nın durumu hâlâ stabil, ancak elimizden de bir şey gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720107
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720107,
					"content": "Neyse ki ben biraz ilerleme kaydettim. Leyla'nın anne babasının söylediğine göre yakın zamanda yeni bir arkadaş edinmiş kendine. Sık sık evden çıkıp uzun süre de dönmüyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720108
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720108,
					"content": "Bir keresinde gizlice peşinden gitmişler ve arkadaşıyla birlikte bir kamp yerinde bir şeyle uğraşırken görmüşler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720109
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720109,
					"content": "Arkadaşını görmüşler mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720110
					]
				},
				{
					"id": 401720110,
					"content": "Evet, \"Kokuchuu\" adında bir adammış. Inazuma tarzında kıyafetleri varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720111
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720111,
					"content": "Bay Kokuchuu, cidden ihtiyacım olan şey bu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720112
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720112,
					"content": "Kadim metinler üzerindeki araştırmalarıma göre aşırı duyarlılık genellikle duyarsızlaştırma terapisi ile tedavi ediliyor. Bu yüzden bence tam tersi şekilde de işe yarayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720113
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720113,
					"content": "Bakın, sizin gibi ruhlara karşı hiçbir duyarlılığı olmayan birinin istenen etkiyi alabilmesi için etrafının tamamen ruhsal açıdan zengin maddelerle çevrili olması gerekiyor. Ben bu yönteme \"aşırı duyarlılık terapisi\" diyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720114
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720114,
					"content": "Riskli mi peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720115
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720115,
					"content": "Sersem ruh olan sizsiniz, ben değil. Eminim zorla yapılan durugörünün sonuçlarını benden daha iyi biliyorsunuzdur. Sonuç olarak, karar sizin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720116
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720116,
					"content": "Pekala... Ama son bir sorum daha var... Sizin bundan kazancınız ne olacak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720117
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720117,
					"content": "Açıkçası benim gibi insanların kabilede pek nüfuzu yok, dolayısıyla karşılık olarak size çok fazla şey sunamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720118
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720118,
					"content": "Ödül peşinde olduğumu mu düşünüyorsunuz? Ah, olamaz! Bir yüzüme bakın lütfen. Bakın cevap yüzümde yazıyor, gün gibi ortada değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720119
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720119,
					"content": "Hı... Ne? Ne yazıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720120
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720120,
					"content": "\"Yardım etmekten mutluluk duyan arkadaş canlısı biri.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720121
					],
					"speakerTitle": "Enjou"
				},
				{
					"id": 401720121,
					"content": "Ne? Yani... Inazumalı biri Leyla'nın... Ruh sersemliğini iyileştirmek için yardım mı etmiş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720122,
					"content": "Aşırı duyarlılık terapisi, hıh... Ne yenilikçi bir fikir ama. İşe yarar mı ki gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720123
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720123,
					"content": "Görünüşe bakılırsa Leyla üzerinde pek bir işe yaramamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720124,
					"content": "Hım, hiç de yeni bir fikir değil aslında. Kabilemizde bir zamanlar tedavi için kullanılıyordu bu yöntem, ancak o kadar riskliydi ve başarısız sonuçları vardı ki en sonunda yasaklandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720125
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720125,
					"content": "Kokuchuu'ya gelince... Eminim kendince amaçları var. Leyla'nın başına gelenlerden sonra hemen ortadan kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720126
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720126,
					"content": "Leyla'nın ailesi bana kampın yerini söyledi, ben de gidip kontrol ettim. Çok bariz ruhsal enerji izleri vardı ve... Bakın ne buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720127
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720127,
					"content": "Bu ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720128
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720128,
					"content": "Kırık bir parça... Muhtemelen bir silahtan veya bir tür ritüel aletinden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720129
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720129,
					"content": "Sen de hissettin mi? Eski gibi görünebilir ancak çok yoğun ruhani enerji izleri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720130
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720130,
					"content": "Leyla, iletişim aracı olarak bunu kullanmış olmalı. Bu da bir sersem ruhun durugörü deneyimini tetikleyebilmesini açıklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720131
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720131,
					"content": "Bir dakika, başka bir şey daha var... Çok tanıdık geliyor... Sanırım benim kadim adımla bağlantılı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720132
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720132,
					"content": "Nasıl bağlantılı? Acaba bir kadim adın parçası mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720133,
					"content": "Hayır... Daha çok, sanki bu şey benim kadim adımın önceki taşıyıcısına ait gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720134
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720134,
					"content": "Sanhaj olabilir mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720135
					]
				},
				{
					"id": 401720135,
					"content": "Pekala, bu kadar yeter, ninenin durugörü zamanı geldi. Bu parçayı iletişim aracı olarak kullanmayı deneyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720136
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720136,
					"content": "#Tamam, geçen seferki gibi mi? {NICKNAME} ruh tezgahını kullanıp her şeyi bir dokuma parşömenine geçirebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720137,
					"content": "Yok, kayıt işini bu defa Ororon yapabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720138
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720138,
					"content": "Neden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720139
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720139,
					"content": "Güvenlik amaçlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720140
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720140,
					"content": "Ruhların diyarını sen daha iyi tanıyorsun. Eğer bu gerçekten Sanhaj'dan kalan bir parçaysa işler ters gittiğinde halletmen için sana güvenebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720141
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720141,
					"content": "Ah... Gördün mü Paimon? Ninemin ona zaafı var demiştim. Onu herhangi bir tehlikeye atmak istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720142
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720142,
					"content": "Tabii ben torunu olunca çok umursanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720143
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720143,
					"content": "Hey! Ne diyorsun sen orada bakayım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720144
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720144,
					"content": "Pardon nine. Hazırım ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720145
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720145,
					"content": "O zaman, hadi başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720149
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720146,
					"content": "Citlali, gizemli parçayı kullanır ve ikinci durugörü seansına başlar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401720147
					]
				},
				{
					"id": 401720149,
					"content": "Pekala! Bu defa ne var parşömende? Alevlerle sarılı kırık bir yaya benziyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720150
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720150,
					"content": "Hey, şu parçalardan biri sizce de elimizdeki parça gibi değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720151
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720151,
					"content": "Haklısın! Yayın bir parçası galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720152
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720152,
					"content": "Ninenin parşömenlerinden birinde buna benzer bir yay görmüştüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720153
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720153,
					"content": "Evet, Sanhaj'ın Mare Jivari Savaşında kullandığı silah. Sanırım bu da bu parçanın gerçekten Sanhaj'dan kaldığını kanıtlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720154
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720154,
					"content": "#Sanhaj işte... Parçadaki ruhsal enerji dalgalanması çok yoğun olsa da herhangi bir tehlike yaşamadım. Kayıtları {NICKNAME} tutsaydı da bir sorun olmazmış yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720155
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720155,
					"content": "Gerçek bir kahraman işte, değil mi? Sahip olduğu eşyalar nesiller sonra sersem ruhların tedavisi için kullanılabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720156
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720156,
					"content": "Yine de bunun arkasında başka bir iş olduğunu düşünüyorum hâlâ. Kokuchuu'nun Leyla'yı tedavi etmekten başka bir amacı olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720157
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720157,
					"content": "Hım, pekala... Az önce yayın tamamını gördük, değil mi? Belki diğer parçaları bulmak için o da görmek istemiştir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720158
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720158,
					"content": "Bunu yaparak ne elde edebilir bilmiyorum. Sanhaj'dan kalan parçalar bile olsalar, kırık bir yay pek işe yarar mı emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720159
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720159,
					"content": "Ayrıca bu durumda neden bir sersem ruh kullanasın ki? Kendi ayağına kurşun sıkmak gibi bir şey bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720160
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720160,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720161
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720161,
					"content": "Hı? Leyla'nın bedeni tepki veriyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720162
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720162,
					"content": "Bir bakayım. Bir ruhun bu parçaya çekildiğini hissedebiliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720163
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720163,
					"content": "Görünüşe bakılırsa ninemin planı işe yarıyor. Leyla'nın ruhu yeme çekiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720164
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720164,
					"content": "O zaman tekrar deneyeceğim. Bu defa iletişim aracı olarak hem Leyla'nın bedenini hem de parçayı kullanacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720165
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720165,
					"content": "Başarabilirsin nine. Ben de hazırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720166
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720166,
					"content": "Bu defa ruh tezgahını ben kullanabilir miyim acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720167
					]
				},
				{
					"id": 401720167,
					"content": "Sen de bir heveslendin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720168
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720168,
					"content": "Hem en son Ororon kullandı. Sırayla yapmak daha adil olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720169
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720169,
					"content": "Bana uyar. Artık güvenli olduğunu biliyoruz o yüzden bir sorun yaşamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720170
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720170,
					"content": "Hım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720171
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720171,
					"content": "Pekala, madem ısrar ediyorsun öyle olsun. Hazır olduğunda bana söyle yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		},
