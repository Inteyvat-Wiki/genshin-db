			"dialogs": [
				{
					"id": 401720401,
					"content": "Başka bir görüntü daha belirdi! Bu... Bir harita!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720402,
					"content": "Bir harita mı? Nerenin haritası?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720403
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720403,
					"content": "Mare Jivari'nin olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720404
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720404,
					"content": "Mare Jivari mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720405,
					"content": "Mare Jivari, o savaştan sonra çorak bir araziye dönüştü. Ya da daha doğrusu, orada yaşananlardan sonra adı Mare Jivari oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720406
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720406,
					"content": "Savaş alanı, orada savaşan canavarların ve savaşçıların külleriyle kaplandı. Bazen derinliklerden, insanın kanını donduran çığlıklar duyuluyordu. Diğer zamanlarda ise her yer bu çığlıkları bastıran alevlerle kaplı oluyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720407
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720407,
					"content": "Gizemlerle ve tehlikelerle dolu bir yer burası. Yüzyıllar boyunca en becerikli maceracılar Mare Jivari'ye giderek kendilerini kanıtlamaya çalıştılar ancak çoğu orada perişan olup gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720408
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720408,
					"content": "Bu durum yirmi, otuz yıl öncesine kadar böyle devam etti, ta ki garip şeyler yaşanmaya başlayana dek. İnsanlar, Mare Jivari'de dolaşan, bir dağ büyüklüğündeki devasa ve karanlık bir yaratıktan bahsetmeye başladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720409
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720409,
					"content": "Kısa bir süre sonra da tüm bölge yok oldu. Kimse ne olduğunu bilmiyor ancak o meşum yer yeryüzünden kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720410
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720410,
					"content": "Ne? Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720411,
					"content": "Tuhaf, değil mi? Neyse, yanılmıyorsam haritada işaretlenen yer Mare Jivari'nin kaybolmadan önceki yeri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720412
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720412,
					"content": "Neresi peki burası?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720413
					]
				},
				{
					"id": 401720413,
					"content": "Natlan'ın en batısında. Çok uzak bir yerde kalıyor, tüm kabilelerden uzakta. Orada hiçbir zaman bir yerleşim kurulmadı ancak Mare Jivari yok olduğundan beri daha fazla insan uğrar oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720414
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720414,
					"content": "Yani benim duyumlarım bu şekilde. Hiç kendim gitmedim oraya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720415
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720415,
					"content": "Yaşlanmak böyle işte, yıllar geçtikçe maceracı ruhunu kaybediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720416
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720416,
					"content": "Bu sadece bir bahane. Ninem o kadar uzaklara gidemeyecek kadar tembel...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720417
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720417,
					"content": "Dur bakayım bir! Parçaya ve dokuma parşömenine yaklaşan bir ruh var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720418
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720418,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720419
					],
					"speakerTitle": "Leyla"
				},
				{
					"id": 401720419,
					"content": "Aaa! Leyla'nın bedeni yine tepki veriyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720420,
					"content": "Bu defa daha güçlü bir tepki verdi. Acaba aradığı şey gerçekten Mare Jivari'nin yeri miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720421
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720421,
					"content": "Ben de hissettim... Yakınlarda bir ruh var... Neredeyse bütün halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720422
					],
					"speakerTitle": "Ororon"
				},
				{
					"id": 401720422,
					"content": "Ayy! Paimon ürperdi resmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720423,
					"content": "Görünüşe bakılırsa plan işe yarıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720424
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720424,
					"content": "Öyleyse, ıı... Onu uyandırabilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720425
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401720425,
					"content": "Bugün değil. Bir ruhu bedenine geri getirmenin suyu bir şişeden diğerine aktarmak gibi olduğunu düşünüyor olabilirsin ama durum ondan daha karmaşık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720426
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720426,
					"content": "Bir seremoni kılıcı ödünç almam ve başka hazırlıklar yapmam lazım. İki günümü alır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720427
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 401720427,
					"content": "Ama merak etmeyin, ruhu artık geri döndüğüne göre geriye yalnızca bir adım kaldı. İki gün sonra tekrar buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Citlali"
				}
			]
		}
	]
