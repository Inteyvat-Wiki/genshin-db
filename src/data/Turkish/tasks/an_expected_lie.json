			"dialogs": [
				{
					"id": 741360401,
					"content": "\"Beş\" diye tutturmuştu, demek bu yüzdenmiş. Bilmeceyi çözmemiz için ipucu veriyormuş bize...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360402,
					"content": "Peki niye direkt söylememiş ki? Lafı dolandırmasa olmaz mıydı yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360403,
					"content": "O adamın yaptıklarına akıl sır erdirmek ne mümkün... Yine de Nacker'ı bulmamıza yardım etmeye çalışıyormuş demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360404
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360404,
					"content": "Evin yanına dalış kıyafetleri bırakılmış... Bizim için özel hazırlanmış sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360405,
						741360406
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360405,
					"content": "Biz onu bulamadan o bizi bulmuş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				},
				{
					"id": 741360407,
					"content": "Araştırma değeri yok ne demek... İyi ama ben... Ben ona o kadar zamanımı harcadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360408
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360408,
					"content": "Fusilier... Kendi kendine söylenip duruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360409,
					"content": "#O değil de... Sen de izleniyormuşuz gibi hissediyor musun {NICKNAME}? Paimon'un tüyleri birden diken diken oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360410,
					"content": "Ben önden gidip içeriyi kontrol edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360406,
					"content": "Önce Nacker'ın icabına bakalım o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360407
					]
				}
			]
		},
