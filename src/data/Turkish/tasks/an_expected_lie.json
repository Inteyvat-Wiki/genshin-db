			"dialogs": [
				{
					"id": 741361101,
					"content": "#Bayan Fusilier! {NICKNAME}! Hoş geldiniz! İşleri hallettiniz galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361102
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361102,
					"content": "Olamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361103
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361103,
					"content": "Eyvah eyvah! Bay Choiseul gerçekten bayılacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361104,
					"content": "Enstitüye döneceğini tahmin etmemiştim doğrusu Choiseul. Sonsuza dek evrak işleriyle uğraşmak zorunda kalacağını düşünmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361105
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361105,
					"content": "Bu... İmkansız! Eyvahlar olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361106
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361106,
					"content": "Raimondo, işimi devralmak nasıl bir his? Anlatmaya değer bir şey yaşandı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361107
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361107,
					"content": "... Sizi görmek ne güzel Bay Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361108
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361108,
					"content": "Etrafına bir bak! Hademelik yakışmış sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361109
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361109,
					"content": "... Peh! Düzgünce temizlememiş bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361110
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361110,
					"content": "Seni temizlemediği içindir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361111
					]
				},
				{
					"id": 741361111,
					"content": "#Bu ikisini geri getirdiğiniz için teşekkürler Fahri Kıdemli Araştırmacı {NICKNAME} ve Bayan Fusilier.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361112
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361112,
					"content": "Umarım böylece Fontaine Araştırma Enstitüsünün başına gelen talihsiz serüvenler dizisi ve kargaşa sona erer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361113
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361113,
					"content": "Hahaha! Ne güzel. Fontaine Araştırma Enstitüsü artık ilhamın kuruyup öldüğü ölümcül bir sessizliğe gömülecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361114
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361114,
					"content": "Enstitüde yeterince ilham kaynağı oldun zaten. Artık sakinleşme zamanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361115
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361115,
					"content": "Raimondo Havenport, sen araştırmanın a'sını bile bilmiyorsun. Fontaine Kinetik Enerji Mühendisliği Araştırma Enstitüsünün başına geçecek vasfa sahip değilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361116
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361116,
					"content": "En azından Enstitü nasıl yönetilir onu gayet iyi biliyorum Edwin Eastinghouse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361117
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361117,
					"content": "Sen artık araştırmalardan ve Arkhiyumdan uzak dur. Böylesi hepimiz için daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361118
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361118,
					"content": "Bir süre sonra Asayiş Dairesi memurları gelir ve Nacker ile Edwin'i götürür... Enstitüden temelli gitmeleri herkes için daha iyi olur...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741361119
					]
				},
				{
					"id": 741361119,
					"content": "Şükürler olsun kabus artık bitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361120
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361120,
					"content": "Siz Bay Chaussivert ve Bay Lemarcq'sınız, değil mi? Enstitümüze yaptığınız yardımları duydum. Buyurun, ödemeniz hazırlanırken şöyle geçip dinlenebilirsiniz. Hak ettiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361121
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361121,
					"content": "Hahaha! Benim gibi birinin Enstitüye bir gün yardımının dokunacağını hiç düşünmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361122
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361122,
					"content": "Öyle demeyin efendim! Dürüst ve iyi kalplisiniz, belli ki iyi bir insansınız. Belki gelecekte tekrar yardımınızı isteriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361123
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361123,
					"content": "Sana gelince... Fahri Kıdemli Araştırmacı, bize yine büyük bir iyilik yaptın. Sana borcumuzu nasıl ödeyebiliriz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361124,
						741361125
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361124,
					"content": "Tekrar havaya uçmayın yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361128
					]
				},
				{
					"id": 741361128,
					"content": "Bu arada... Fusilier nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361129,
					"content": "Sakinleşmesi için ona biraz süre tanıyalım. Kafasında yarattığı Edwin Eastinghouse imajı paramparça oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361130
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361130,
					"content": "Edwin ve Nacker'ın da sakinleşmesi gerek... Umarım yaptıkları hatalar üzerinde düşünürler biraz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361131
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361131,
					"content": "Hayatları boyunca Meropide Kalesi'nde mi kalacaklar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361132
					]
				},
				{
					"id": 741361132,
					"content": "Ne kadar tehlikeli olduklarını düşünürsek umarım oradan hiç çıkamazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361133
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361133,
					"content": "Gerçi Enstitüde işlerin gidişatını düşününce... Umarım ileride uzmanlıklarını gerektirecek durumlarla karşılaşmam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361134
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361134,
					"content": "Sana Fontaine Araştırma Enstitüsü adına tekrar teşekkür ederim Fahri Kıdemli Araştırmacı. Başka sorun olursa ben buradayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361125,
					"content": "Bir terfiye hayır demem...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361126
					]
				},
				{
					"id": 741361126,
					"content": "Şöyle ki... Teknik olarak şu an zaten en yüksek unvana sahipsin... Yine de neler yapabileceğime bir bakarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361127
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361127,
					"content": "Bak aklıma ne geldi. Fahri Kıdemli Baş Araştırmacı olmaya ne dersin? Hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361128
					],
					"speakerTitle": "Choiseul"
				}
			]
		},
