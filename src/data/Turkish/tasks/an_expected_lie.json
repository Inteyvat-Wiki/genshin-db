			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Edwin Eastinghouse",
					"Lemarcq"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741363401,
					"content": "Siz niye... Geri dönmüşsünüz. Dediğime böyle gelirsiniz işte. Beş defa dolansanız bile onu bulamazsınız demiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363402
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363402,
					"content": "Çabalarınız nafile çıkmış belli ki, oturun da size biraz çay demleyeyim. Daha geçen beş tane fincan almıştım... Bir de birkaç kase tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363403
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363403,
					"content": "\"Beş\" uğurlu sayınız falan herhalde Bay Edwin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363404
					],
					"speakerTitle": "Lemarcq"
				},
				{
					"id": 741363404,
					"content": "Evet! Sihirli bir rakam desem yeridir! Doğru zamanda ve doğru şekilde kullanıldığında ebedi ilhamın kapılarını açabilecek güce sahip!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363405
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363405,
					"content": "Bana kulak verin şimdi. Ebedi ilhama giden beş kapı vardır ve her kapı kolunu beş defa çevirmeniz gerekir... Beş! Duydunuz mu beni? Beş defa diyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741363406
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741363406,
					"content": "Pardon ama şu an sizi beş defa yumruklamamak için kendimi zor tutuyorum. Çenenizi kapar mısınız rica etsem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lemarcq"
				}
			]
		}
	]
}