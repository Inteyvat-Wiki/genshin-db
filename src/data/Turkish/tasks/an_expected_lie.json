			"dialogs": [
				{
					"id": 741361001,
					"content": "Edwin... Tahmin etmiştim işte! Onları sen buraya getirdin... Beni hep kıskanırdın zaten! Araştırmalarım seninkinden daha iyi olacak diye ödün kopuyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361002
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361002,
					"content": "Haklısın. İhmalkarlığını ve cehaletini çok kıskanıyorum gerçekten. Enstitüde o kadar mutlu bir hayat sürmene şaşmamalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361003
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361003,
					"content": "Keşke Choiseul burada olsaydı da görseydi... Bayılıp kalırdı muhtemelen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361004,
						741361005
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361004,
					"content": "Hiç uyanmasa daha iyi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				},
				{
					"id": 741361006,
					"content": "Sen onlarla Enstitüye dön ve pişmanlığını yaşa... Benim araştırmama dönmem lazım... Bir şey kırmadın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361007,
						741361008
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361007,
					"content": "Araştırmana dönebileceğini kim söyledi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361009,
					"content": "Yoksa ne olur? Beni Enstitüye mi götürürsün? O zaman araştırmama nasıl devam edeceğim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361010
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361010,
					"content": "O aptal Raimondo kesinlikle Enstitüyü batıracak. Hele bir de o salak Choiseul ile... Öff! Düşüncesi bile başımı ağrıttı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361011
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361011,
					"content": "Enstitüyü batıran sensin! Suçu başkalarına atmayı bırak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361012,
					"content": "Ben miyim? Pekala. Merkez Laboratuvar patlaması için beni suçlamak istiyorsunuz demek! Bilmediğiniz bir şey var ama! Ben orada bile değildim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361013
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361013,
					"content": "Enstitü ahmaklarla dolu! Birinin bir fincan kahve dökmesi bile bir ekipmanda arıza çıkarabiliyor, patlamaya sebep olmalarına şaşmamalı yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361014
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361014,
					"content": "O zaman neden onlara açıklamaya çalışmadın bunu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361015
					]
				},
				{
					"id": 741361015,
					"content": "Açıklamak mı? Onların günah keçisi olmaya hiç niyetim yok. Tamamlamam gereken bir sürü araştırmam var ve onlara harcayacak zamanım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361016
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361016,
					"content": "Sen de gidip Concini gibilerle iş yapmaya karar verdin öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361017
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361017,
					"content": "Onun da onlardan bir farkı yok... Bir tane hassas ölçüm cihazı bulacaktı alt tarafı, başaramadı. Tüm işi benim yapmam gerekti. Yine de en azından araştırmayı finanse etmeye niyeti var, o yüzden her şey yolunda gitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361018
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361018,
					"content": "Gerçi çok sevgili Nacker'ın buraya o tamamlanmamış çekirdek prototipiyle çıkageleceğini tahmin edemedim tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361019
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361019,
					"content": "Onu ben modifiye ettim! Senin tek başına asla geliştiremeyeceğin kendi teknolojimle hem de!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361020
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361020,
					"content": "Haha! Bay Nacker, Concini burada olmadığına göre yalakalık yapmana gerek yok, o yüzden kendine yalan söylemeyi bırak. Bir araştırmacı olarak hiç mi gururun yok?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361021
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361021,
					"content": "Sen... Onun tamamlanmamış olmasının tek sebebi senin nasıl tamamlayacağını bilmiyor olman! Ama ben biliyorum ve tamamlayabilirim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361022
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361022,
					"content": "Öyledir tabii. Şimdi şu hurdayı Enstitüye geri götür ve sömürmeye devam et. Benim daha önemli işlerim var. Sen... Adın Fasulye miydi neydi, bunu sen halledersin artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361023
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361023,
					"content": "Bu ikisi bir gün tartışmayı bırakacak mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361024
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361024,
					"content": "Bu kadarı yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361025
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361025,
					"content": "Ne var? Vaktimi harcamayı bırakır mısınız? İşime dönmem gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361026
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361026,
					"content": "Bu kadarı yeter dedim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361027
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361027,
					"content": "Edwin Eastinghouse! Sen... Enstitüdeki patlamaya sebep olan sensin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361028
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361028,
					"content": "Hele sen Nacker! Sen de Enstitünün malzemelerini çaldın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361029
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361029,
					"content": "Enstitüyü de ikinci defa patlattın!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361030
					]
				},
				{
					"id": 741361030,
					"content": "İkiniz de Enstitüye zarar verdiniz... Fontaine Araştırma Enstitüsünün özel soruşturmacısı olarak ikinizi de gereken cezayı almanız için Enstitüye geri götürüyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361031
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361031,
					"content": "Hay...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361032
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741361032,
					"content": "Yok artık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361033
					],
					"speakerTitle": "Edwin Eastinghouse"
				},
				{
					"id": 741361033,
					"content": "Lemarcq ile ben bu ikisini geri götürürüz. Bak ne diyeceğim, uzun zamandır getir götür işlerinizi yapıyoruz ya hani, Enstitü bizi görür herhalde. Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361034
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361034,
					"content": "Yol boyunca sesiniz çıkmasın, adamı doğduğuna pişman ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361008,
					"content": "Kıpırdama! Uyarıyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361009
					]
				},
				{
					"id": 741361005,
					"content": "Ben de bayılmak üzereyim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361006
					]
				}
			]
		},
