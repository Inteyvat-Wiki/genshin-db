			"dialogs": [
				{
					"id": 741360901,
					"content": "Bakıyorum da Enstitü yardakçılarını göndermiş bile! Choiseul ve Raimondo size ne kadar ödedi, söyleyin çabuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360902,
						741360903
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360902,
					"content": "Para değil, unvan verdiler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				},
				{
					"id": 741360904,
					"content": "Siz... Siz... Ne olur bırakın beni gideyim. \"Alan Oluşturucu\" cihazım neredeyse tamamlanmak üzere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360905
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360905,
					"content": "Onu Arkhiyum Kinetik Çekirdeği ile senkronize etmeyi başardığımda... Dünyanın en iyi kinetik mühendisi olacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360906
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360906,
					"content": "... Başkasının icadına konup övgüleri toplayacaksın, sonra da dünyanın en iyi mühendisi olduğunu iddia edeceksin yani. Yazık, ar damarın çatlamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360907
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360907,
					"content": "Bay Ed... Edwin senin çekirdek araştırma projesinde yer almanı neden istememiş şimdi anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360908
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360908,
					"content": "Edwin'in bir şey bildiği yok, bununla ne yapacağından da bihaber! Hem sen de Enstitüde çalışıyorsun... Bunun gerçek değerini biliyor olman lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360909
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360909,
					"content": "Gel bana yardım et! Seninle... Seninle beraber geliştirelim bu cihazı! Başarırsak dehamızın ününü duymayan kalmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360910
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360910,
					"content": "Edwin, Raimondo, Choiseul... Hiçbiri bizimle aşık atamaz bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360911,
						741360912
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360911,
					"content": "Raimondo'nun söyledikleri doğru çıktı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360913,
					"content": "Edwin'in... Yani Bay Edwin'in başarıları Enstitüye ait. Ben sadece o başarıları geri almak için geldim buraya. Daha fazlasında gözüm yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360914
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360914,
					"content": "Fusilier, Edwin'e hitap şeklini birdenbire değiştirdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360915
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741360915,
					"content": "Aptal olma kızım! Concini'nin bize neler vadedebileceğini bir bilsen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360916
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360916,
					"content": "Ömrümüz boyunca Edwin'in ayak işlerini yapsak bile Concini'nin bize verebileceklerini elde edemeyiz! Edwin'in de Enstitünün de tek niyeti bizi kullanıp sömürmek... Kendi iyiliğimizi düşünmemiz lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360917
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360917,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360918
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741360918,
					"content": "Yetti artık senin saçmalıklarından. Kapa çeneni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360919
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360919,
					"content": "Sen kim oluyorsun yahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360920
					],
					"speakerTitle": "Nacker"
				},
				{
					"id": 741360920,
					"content": "Lumidouce Limanı benden sorulur. Tek kelime daha edersen yumruğumla da tanışırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741360921
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360921,
					"content": "#{NICKNAME}, yardım et de bağlayalım şunu. Sonra da çekirdek midir nedir, onu alalım. Geri dönme vakti geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741360912,
					"content": "Bunca zamandır içindeki bu garezi yine iyi bastırmışsın Nacker.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360913
					]
				},
				{
					"id": 741360903,
					"content": "Tek bir Mora almadım, gönüllü çalışıyorum ben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741360904
					]
				}
			]
		},
