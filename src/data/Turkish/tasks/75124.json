			"dialogs": [
				{
					"id": 751240301,
					"content": "Ah, ne güzel bir zamanlama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240302
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240302,
					"content": "Ne kadar uğraşırsam uğraşayım bir türlü halledemediğim fotoğraf çekme görevimin sizin yardımınızla bu kadar çabuk tamamlandığına inanmakta güçlük çekiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240303
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240303,
					"content": "Tüm bu Akarsu Kuşları ve onların yüzme simitlerinin içinde sallanan, yuvarlanan halleri... Bu öyle dokunaklı bir manzara ki neredeyse ağlayacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240304
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240304,
					"content": "O kadar dokunaklı mı gerçekten?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240305
					]
				},
				{
					"id": 751240305,
					"content": "Bazen başkalarının anlayamayacağı, hatta saçma bulacağı bir şeyi hayattaki amacımız haline getirebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240306
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240306,
					"content": "Bununla beraber, ben bu fotoğrafları çekmeye devam ettiğim sürece Akarsu Kuşlarını sevenlerin sayısının artacağına inanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240307
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240307,
					"content": "Paimon da bunun gerçekleşeceğine yüzde yüz inanıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240308,
					"content": "Yardımlarınız için çok teşekkür ederim! Lütfen minnettarlığımın bir göstergesi olarak bunları kabul edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				}
			]
		},
