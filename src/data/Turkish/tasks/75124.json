			"dialogs": [
				{
					"id": 751240101,
					"content": "*iç çeker* Yine kaçtı. Of, yüzme simidinin içinde yalnızca bir tane kaldı. Şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240102
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240102,
					"content": "Bu daha ne kadar sürecek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240103
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240103,
					"content": "Hım, birisi buradaki... Akarsu Kuşlarının fotoğraflarını çekiyor galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240104,
					"content": "Oldukça sevimliler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240105,
						751240107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240105,
					"content": "Bir o yana bir bu yana ne güzel de salınıyorlar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240106
					]
				},
				{
					"id": 751240106,
					"content": "Gerçekten çok şirinler, yürürken sallanıyorlar. Bir de kendilerini şişirip suyun üzerinde top gibi yüzdükleri zaman... Paimon çok mutlu oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240109,
					"content": "İşte budur, güzel parlak gümüş saçlara sahip sevimli genç hanım! Bu Akarsu Kuşlarını yaratan kişi gerçekten de tüm övgüleri hak ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240110
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240110,
					"content": "Harika gerçekten... Aa, bir saniye, henüz kendimi tanıtmadım. Ben Jonvelle, Akarsu Kuşu fotoğrafçılığıyla ilgileniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240111
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240111,
					"content": "#Ne güzel. Paimon'un adı Paimon, bu da {NICKNAME}... Peki niye üzgün üzgün iç çekiyorsun? Etrafında bu kadar çok Akarsu Kuşu varken üstelik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240112,
					"content": "Bu... Uzun hikaye ama kısaca özetleyeyim. Benim gibi bir sürü insan var ve her birimiz en ilginç fotoğrafları çekmek istiyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240113
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240113,
					"content": "Birkaç gün önce dahice bir fikir buldum... Şöyle ki, Kamera çerçevemin içindeki tüm Akarsu Kuşlarını yüzme simitlerinin içine yerleştirmeyi düşündüm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240114,
						751240117
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240114,
					"content": "Peki bunun tam olarak anlamı nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240115
					]
				},
				{
					"id": 751240115,
					"content": "Bunun anlamı elbette tamamen anlamsız olması. Akarsu Kuşları aslında yüzebildikleri halde onlara yine de yüzme simidi takılması...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240116
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240116,
					"content": "... Yani bir miktar Mora kazanmak için aynı miktarda Mora harcamak kadar anlamsız bir şey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240120,
					"content": "Onların omuzlarına fazla yük bindiriyorsun gibi geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240121,
					"content": "İşte buna \"gerçeküstü fotoğrafçılık\" denir. Çektiğin fotoğraflarda daha derin anlamlar araman gerekir... Ancak ne yazık ki bu konuda bazı sorunlarla karşılaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240122
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240122,
					"content": "Beklendiği üzere gerçek Akarsu Kuşları yüzme simidi takmaz, bu yüzden böyle fotoğraflar çekilemez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240123
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240123,
					"content": "Adı boşuna \"gerçeküstü\" değil demek ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240124
					]
				},
				{
					"id": 751240124,
					"content": "#Bir saniye. Tüm Akarsu Kuşlarına yüzme simidi takabiliriz, öyle değil mi? Hadi {NICKNAME}, Akarsu Kuşu hayranları olarak başka bir hayrana yardım edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240125,
						751240127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240125,
					"content": "Yaşasın Akarsu Kuşu tutkunları!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240126
					]
				},
				{
					"id": 751240126,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240129,
					"content": "Bir dakika, gerçekten mi? Bana yardım edecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240130
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240130,
					"content": "Hehe, bize birkaç iyi fotoğraf verebilirsen bu iş tamamdır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240131,
					"content": "S-Size çok minnettar olurum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240127,
					"content": "Uçan Sincapları tercih ederim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240128
					]
				},
				{
					"id": 751240128,
					"content": "Hey, böyle konuşmanın sırası değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751240117,
					"content": "Kesinlikle. Bu, normal bir insanın kolay kolay aklına gelmeyecek bir fikir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240118
					]
				},
				{
					"id": 751240118,
					"content": "Su yüzeyinde kendi başlarına yüzebilen Akarsu Kuşlarının buna rağmen yüzme simidi takmaları, fotoğrafın içinde çok katmanlı bir anlam seli yaratacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240119
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240119,
					"content": "Bu sayede hem \"aşırı tüketim\" hem de \"israf\" temalarını aynı anda bünyesinde barındıracak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240120
					],
					"speakerTitle": "Jonvelle"
				},
				{
					"id": 751240107,
					"content": "Açıkçası ben Uçan Sincapları tercih ederim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751240108
					]
				},
				{
					"id": 751240108,
					"content": "Onlar da sevimliler tabii ama bir Akarsu Kuşunun yüzüne bakıp \"Uçan Sincaplar sizden daha sevimli\" diyebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751240109
					],
					"speakerTitle": "Paimon"
				}
			]
		},
