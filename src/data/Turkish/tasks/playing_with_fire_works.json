					"Naganohara Ryuunosuke"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220490101,
					"content": "Ah, sen küçük kızımın yeni arkadaşı değil misin? Onunla vakit geçirmeye mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490102,
						220490105
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490102,
					"content": "Bugün işler nasıl?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490103
					]
				},
				{
					"id": 220490103,
					"content": "Harika ötesi! Hahaha, küçük kızım tamir işlerinden iyi anlıyor, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490104
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490104,
					"content": "Bugün ona bakmaya mı geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490107,
					"content": "Ne yazık! Yeni havai fişekler yapmak için malzeme toplamaya gideceğini söylemişti; o yüzden şu an burada değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490108
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490108,
					"content": "Anladım. Peki nereye gitti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490109
					]
				},
				{
					"id": 220490109,
					"content": "Ne? Ne dedin sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490110
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490110,
					"content": "Yoimiya! O nereye gitti?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490111
					]
				},
				{
					"id": 220490111,
					"content": "Ah, ben... Açıkçası tam olarak emin değilim. Muhtemelen nereye gittiğini söylemiştir ama kulaklarım eskisi gibi işitmediği için duymamış olabilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490112
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490112,
					"content": "Ondan bir şey mi isteyecektin? Yoksa havai fişek satın almaya mı geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490113,
						220490116
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490113,
					"content": "Yoimiya ile biraz vakit geçirmek istiyorduk...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490114
					]
				},
				{
					"id": 220490114,
					"content": "Anladım. Ne yazık ki şu an için bu pek mümkün değil. Havai fişeklerini kurcalamaya gittiğinde ne zaman döneceği hiç belli olmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490115
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490115,
					"content": "Gitmeden önce dükkanda birkaç yeni havai fişek yapmıştı. Neden onları alıp dışarıda oynamıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490118,
					"content": "Ah, nereye koymuştum? Burada mıydı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490119,
						220490120
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490119,
					"content": "Bir sorun olmaz, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490121,
					"content": "Bir şey olmaz merak etmeyin. Dükkanda istemeyeceğiniz kadar çok havai fişek var. Eğlenmenize bakın, gerisini düşünmeyin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490122
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490122,
					"content": "Hem kızım bu şeyleri birilerinin denemesini istiyordu. Madem buraya kadar geldiniz, siz deneyin. Ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490123
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490123,
					"content": "Gidip bir deneyin, işiniz bitince gelip olan biteni bana anlatırsınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490124
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490124,
					"content": "Yoimiya geri dönünce ona mesajınızı iletirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490125
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490125,
					"content": "Merak etmeyin. Onlarla oynamaya gittiğinizi duyunca çok mutlu olacaktır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490126
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490126,
					"content": "Haydi gidin artık. Onları şehrin dışında ateşlediğinizden emin olun. Şehrin içerisinde ateşleyecek olursanız dikkatleri üzerinize çekersiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490120,
					"content": "Yoimiya'ya sormadık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490121
					]
				},
				{
					"id": 220490116,
					"content": "Havai fişeklerle biraz eğlenmek istiyoruz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490117
					]
				},
				{
					"id": 220490117,
					"content": "Güzel, güzel. Yoimiya gitmeden önce dükkanda birkaç yeni havai fişek yapmıştı. Neden onları alıp dışarıda oynamıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490118
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				},
				{
					"id": 220490105,
					"content": "Yoimiya içeride mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220490106
					]
				},
				{
					"id": 220490106,
					"content": "Ah, onu görmeye mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220490107
					],
					"speakerTitle": "Naganohara Ryuunosuke"
				}
			]
		},
