				"points": []
			},
			"dialogs": [
				{
					"id": 230210101,
					"content": "Gezgin! Tam zamanında geldin. Gemiyi suya indirdim. Şimdilik tam yol ileri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210102
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210102,
					"content": "Hesaplarım tam olarak doğru çıktı, tam da beklediğim gibi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210103
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210103,
					"content": "Peki yük testine ne zaman başlayacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210104
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210104,
					"content": "Acele etmeyelim. Gezgin burada, bu yüzden yakında başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210105
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210105,
					"content": "Yük testi nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210106
					]
				},
				{
					"id": 230210106,
					"content": "Kısaca şöyle anlatayım, ağır nesneler yükleyerek gemilerin yük kapasitesini test ederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210107
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210107,
					"content": "Yani birinin yükleri benimle birlikte gemiye taşıması gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210108
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210108,
					"content": "Gezgin, gördüğüm kadarıyla sen gerçekten çok güçlüsün. Böyle bir iş senin için çocuk oyuncağı olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210109,
						230210110
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210109,
					"content": "Yani bu yüzden mi buraya gelmemi istedin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				},
				{
					"id": 230210111,
					"content": "Yani... Off, bunu tek başıma yapamam, sadece senden yardım isteyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210112
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210112,
					"content": "Karşılığında büyük bir ödül alacaksın, söz veriyorum! Daha birkaç gün önce büyük bir gemisi olan bir adamın gemisini tamir etmesine yardım ettim. Oradan da iyi bir ödeme aldım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210113
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210113,
					"content": "Demek iyi bir ödeme aldın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210114
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210114,
					"content": "Şey... Kazandığım Moranın neredeyse hepsini gemiye harcadım ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210115
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210115,
					"content": "Neredeyse hepsini mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210116
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210116,
					"content": "Gerçi hâlâ biraz var! Merak etme, hâlâ sana kahve ısmarlayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210117
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210117,
					"content": "Pekala Gezgin, işe koyulma vakti! Hadi gemiye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210110,
					"content": "Of, şimdi biraz sinir oldum işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				}
			]
		},
		{
			"id": 2302106,
			"completionStepIds": [
				2302106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
