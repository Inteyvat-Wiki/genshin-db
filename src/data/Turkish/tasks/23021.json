			"dialogs": [
				{
					"id": 230210801,
					"content": "Evet! İşe yaradı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210802,
					"content": "Dış gövdede yapısal herhangi bir sorun yok... Su hattı da sabit. Herhangi bir eğilme de yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210803,
					"content": "Bak Qishan, tasarımım ve tahminlerim doğruymuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210804,
					"content": "Kendini çok kaptırma. Daha yük testinin birinci aşamasındayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210805,
					"content": "Gemi hareket edince hava durumu ve taşıdığı yükün etkisiyle ağırlık merkezinin değişeceğini bile hesaba katmadın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210806,
					"content": "Off... Bu faktörleri de göz önünde bulunduracağım. Ama lütfen şimdi bırak da anın tadını çıkarayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210807,
					"content": "Gezgin, işte ödemen. Lütfen kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210808,
					"content": "Qishan, bir kere benim adıma mutlu olsan ne olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "Rafiq"
				},
				{
					"id": 230210809,
					"content": "Ama senin adına mutlu olmam gemiyi inşa etmene yardımcı olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "Qishan"
				},
				{
					"id": 230210810,
					"content": "Bence sen önce cebini mutlu et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qishan"
				}
			]
		},
