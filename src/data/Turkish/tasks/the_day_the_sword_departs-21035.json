			},
			"dialogs": [
				{
					"id": 210350101,
					"content": "*iç çeker* Que'er...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350102,
						210350103
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350102,
					"content": "Sun Yu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				},
				{
					"id": 210350104,
					"content": "Sen misin Gezgin? Bu ne tesadüf? Seni burada görmeyi beklemiyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350105
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350105,
					"content": "Ben... Burada idman yapıyorum. Seyahat için yakında Liyue'den ayrılacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350106,
						210350107
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350106,
					"content": "Birden bu seyahat de nereden çıktı şimdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350108,
					"content": "*iç çeker* Bu aslında biraz utanç verici... Uzun süredir Guhua Klanı'nı geri döndürmekten bahsediyorum ama bunca süredir ne yaptım? Benim yaptığım \"Adeptusların rehberliğini izlemek\" değil, sadece Jueyun Gölü'nde vakit harcamak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350109
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350109,
					"content": "Que'er'in arkadaşlığı için minnettarım fakat içimde bunun Guhua Klanı'nın geri dönüşü açısından anlamı olmadığının farkındayım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350110
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350110,
					"content": "Geçenlerde şehirde alışveriş yaparken Fontaineli bir tüccar ile sohbet etme şansım oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350111
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350111,
					"content": "Bana şöyle dedi: \"Sorunun çözümünü, onun meydana geldiği yerde bulamazsın\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350112
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350112,
					"content": "Bu sözler hakkında bir süre düşündüm. Belki de Fontaineli tüccar, Liyue dışında bir yerlere seyahat etmem gerektiğini ima ediyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350113,
						210350114
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350113,
					"content": "Seyahat etmek yeni bakış açıları kazandırabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350115,
					"content": "Ben de aynen böyle düşündüm! Ama... Que'er Liyue'den ayrılmak istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350116
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350116,
					"content": "Sinirlendiği anlarda genelde ciddi değildir, hatta şaka amaçlıdır. Onu kolaylıkla yatıştırabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350117
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350117,
					"content": "Ama bu sefer gerçekten kızmış gibi. Ne söylediysem dinlemedi ve tek başına şehre kaçtı *iç çeker*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350118
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350118,
					"content": "Neyse, seni bu önemsiz şeylerle daha fazla sıkmayacağım. Gezgin, senden bir şey rica edebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350119
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350119,
					"content": "Daha önce bazı savunma teknikleri öğrendim fakat hiç deneme şansım olmadı. Eğer uzaklara seyahat edeceksem, bir gün istemesem de kesinlikle bir kavgaya karışacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350120
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350120,
					"content": "Senin tüm dünyada atıldığın maceraların hikayelerini dinledim Gezgin. Eminim canavarların hakkından gelme konusunda birçok yöntem biliyorsundur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350121
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350121,
					"content": "Biraz canavar bulup onlarla dövüşmem için bana eşlik eder misin? Hani, belki biraz rehberlik de yaparsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350122,
						210350123
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350122,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350125
					]
				},
				{
					"id": 210350125,
					"content": "Bir bakalım... Tam ileride canavarların toplandığı bir yer var. Oraya gidelim, ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350123,
					"content": "Hareketlerimi görememenden korkuyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350124
					]
				},
				{
					"id": 210350124,
					"content": "Demek o kadar yeteneklisin. Hahaha, öyleyse benim için biraz daha yavaşla.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210350125
					],
					"speakerTitle": "Sun Yu"
				},
				{
					"id": 210350114,
					"content": "Kafan dağılsa dahi yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350115
					]
				},
				{
					"id": 210350107,
					"content": "Guhua Klanı'nı geri döndürmeyecek misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350108
					]
				},
				{
					"id": 210350103,
					"content": "Burada ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210350104
					]
				}
			]
		},
