			"dialogs": [
				{
					"id": 6070201,
					"content": "Korkmanıza gerek yok. Şeytani canavarların kökü kazındı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070202
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070202,
					"content": "Mein Fräulein, şu anda dışarı çıkmamanız gerektiğini söylemeye çalışıyor. Biz bu bölgeyi koruyacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070203
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070203,
					"content": "Teşekkürler! Çok teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070204
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070204,
					"content": "Şey... Hiç böyle... Konuşan bir kuş görmemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070205
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070205,
					"content": "Endişelenmenize gerek yok efendim. Sadece mein Fräulein'in hizmetkarıyım. Size zarar vermeyeceğimden emin olabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070206
					],
					"speakerTitle": "Oz"
				},
				{
					"id": 6070206,
					"content": "Onlara güvenebilirsiniz. Söz veriyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						6070207
					]
				},
				{
					"id": 6070207,
					"content": "Hayır, demek istediğim bu değildi. Sadece, şey... Yanlış bir şey söyledim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070208
					],
					"speakerTitle": "Parsley"
				},
				{
					"id": 6070208,
					"content": "Hıh, önemli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6070209
					],
					"speakerTitle": "Fischl"
				},
				{
					"id": 6070209,
					"content": "Hizmetkarlarımın hâlâ yapacak işleri var. Gidin ve bu alçak canavarları devirin. Prensesin lütfu yolunuzu aydınlatacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fischl"
				}
