			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fusilier",
					"Lemarcq",
					"Chaussivert",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741361401,
					"content": "Hiç değeri yok... Araştırmamın hiçbir değeri yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361402
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361402,
					"content": "Lütfen öyle düşünmeyin hanımefendi. İcadınız benim hayatımı kurtardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361403
					],
					"speakerTitle": "Lemarcq"
				},
				{
					"id": 741361403,
					"content": "Ama... Ama... Bay Edwin... *ağlayıp hıçkırır* Edwin bir işe yaramaz dedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361404
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361404,
					"content": "Edwin kör cahilmiş demek ki! Bu şey bir hazine! İşe yaramazmış öyle mi? O kadar işe yarıyor ki adamlarıma bir tane almak için canımı bile veririm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361405
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361405,
					"content": "Edwin kötü biri. Dediklerine inanma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361406
					]
				},
				{
					"id": 741361406,
					"content": "Bay Edwin kötü biri değil! O... O... Neyse... Adımı bile hatırlamadı! Ona kaç kez tasarımlarımı gösterdiğim halde üstelik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361407
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361407,
					"content": "Sen çok yeteneklisin Fusilier! Neden kendini o Edwin denen adamın söylediklerine göre yargılıyorsun ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361408,
					"content": "Benim sende gördüğümü o göremiyor!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361409
					]
				},
				{
					"id": 741361409,
					"content": "G-Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361410
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361410,
					"content": "Elbette. Hepimiz aynı şeyi düşünüyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361411
					],
					"speakerTitle": "Chaussivert"
				},
				{
					"id": 741361411,
					"content": "İyi de... Siz araştırma nedir ne değildir bilmiyorsunuz ki... *hıçkırarak ağlar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361412
					],
					"speakerTitle": "Fusilier"
				},
				{
					"id": 741361412,
					"content": "Fusilier... Pek sağlıklı düşünemiyor belli ki. Onu biraz yalnız bırakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361413,
					"content": "Tamam. Lemarcq ve ben buradayız. Bir şeye ihtiyacınız olursa çağırın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chaussivert"
				}
			]
		}
	]
}