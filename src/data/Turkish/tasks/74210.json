				"points": []
			},
			"dialogs": [
				{
					"id": 741361201,
					"content": "Sormak istediğin bir şey var mı Fahri Kıdemli Araştırmacı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361202,
						741361208,
						741361220
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361202,
					"content": "Nacker ve Edwin'e ne olacak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361203
					]
				},
				{
					"id": 741361203,
					"content": "Hatalarını anlayıp pişman olana kadar geçici bir süre Meropide Kalesi'nde kalacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361204
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361204,
					"content": "Tabii benim tanıdığım Edwin pek \"pişman olan\" biri değildir ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361205
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361205,
					"content": "Neyse, Edwin araştırma ekipmanlarından ve Arkhiyumdan uzak durduğu sürece sorun yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361206
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361206,
					"content": "Nacker'a gelecek olursak... Başımıza daha fazla dert açacağını sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361207
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361207,
					"content": "Umarım... İleride uzmanlıklarını gerektirecek bir durumla karşılaşmam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361208,
					"content": "Fusilier eskiden Edwin'e hayran mıydı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361209
					]
				},
				{
					"id": 741361209,
					"content": "... Edwin Eastinghouse bir deha. Onunla aynı alandaki kişiler ya pes etti ya da onun takipçisi oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361210
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361210,
					"content": "Bayan Fusilier genellikle çok az kaynakla muhteşem sonuçlar elde eden, fazlasıyla hevesli ve yaratıcı bir araştırmacı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361211
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361211,
					"content": "Fusilier, Arkhiyum Araştırma Projesinde 3. Teknoloji Ekibine katıldıktan sonra bastırıcının yapısal tasarımından sorumluydu. Dolayısıyla sık sık Edwin'e danışıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361212
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361212,
					"content": "Belki de Edwin'i idol olarak görmeye o zaman başlamıştır. Tıpkı diğer takipçileri gibi Bayan Fusilier'nin de tek hedefi Edwin'in onayını kazanmak oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361213
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361213,
					"content": "Patlamadan sonra olaya Edwin'in sebep olduğuna inanmayı reddetti ve Edwin'in adını temize çıkarmak için soruşturmaya katılmak istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361214
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361214,
					"content": "Siz de Edwin ile tanıştınız. Onun hakkında ne düşünüyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361215
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361215,
					"content": "Sırf araştırmasını düşünen ucubenin tekiymiş! Suçu sürekli başkalarının üzerine atmaya çalıştı ve Fusilier'nin ismini bile hatırlamadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741361216,
					"content": "Hah işte, hiç şaşırmadım. Yaptığı araştırma haricinde dikkatini vermeye değer gördüğü başka bir şey yok neredeyse.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361217
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361217,
					"content": "Araştırması sorunsuz ilerlediği sürece de hiçbir şey umurunda değil. Ekibinde çalışanlar Enstitü malzemelerini çalıp satmaya çalıştıklarında bile umursamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361218
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361218,
					"content": "Fusilier'nin soruşturmaya katılma talebini kabul etmemin tek sebebi var... Peşinden gittiği kişinin kafasında kendi yarattığı bir imaj olduğunu görmesini istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361219
					],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361219,
					"content": "Bu imaj artık paramparça olduğuna göre yakında kendini toparlar umarım. Fontaine Araştırma Enstitüsü daha fazla kayıp kaldıramaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				},
				{
					"id": 741361220,
					"content": "Görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361221
					]
				},
				{
					"id": 741361221,
					"content": "Kendine iyi bak Fahri Kıdemli Araştırmacı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Raimondo"
				}
			]
		},
		{
			"id": 7413613,
