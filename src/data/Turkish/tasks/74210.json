				"points": []
			},
			"dialogs": [
				{
					"id": 741361301,
					"content": "Oh be... Sorun yok, tamam. Kabus sona erdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361302,
						741361305,
						741361309
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361302,
					"content": "Edwin'in \"hayata dönmesi\" konusunda ne düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361303
					]
				},
				{
					"id": 741361303,
					"content": "Of! Korkuttun beni! Ne mi düşünüyorum? Dürüst olmak gerekirse hiçbir şey düşünmüyorum. O sorumsuz alçağın yaptıklarının bedelini ödemesini istiyorum sadece!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361304
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361304,
					"content": "Açıkçası imkanım olsa Arkhiyumu ele geçirmesin diye ellerini, ayaklarını ve gözlerini bağlardım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361305,
					"content": "Şimdi biraz rahatladın mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361306
					]
				},
				{
					"id": 741361306,
					"content": "Öncesine kıyasla evet, biraz rahatladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361307
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361307,
					"content": "Yine de dürüst olmak gerekirse Nacker ve Edwin'i aynı yere hapsetmek pek de iyi bir fikir değil. Bu ikilinin neler yapabileceğini hayal bile edemiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741361308
					],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361308,
					"content": "Hadi patlama oldu bitti. Sırada ne var? Ülkeyi Fonta'ya mı boğacaklar? Hayal bile edemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Choiseul"
				},
				{
					"id": 741361309,
					"content": "Kendine iyi bak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741361310
					]
				},
				{
					"id": 741361310,
					"content": "Sen de Fahri Kıdemli Araştırmacı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Choiseul"
				}
			]
		},
		{
			"id": 7413614,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
