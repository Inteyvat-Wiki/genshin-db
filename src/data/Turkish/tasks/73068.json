				{
					"id": 730680439,
					"content": "Vardı ama artık yok. Tekrar toplamam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680440
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680440,
					"content": "Rüyalar diyarı dışında Vasmrti oluşturan 12 fidelik var. Onlarla birlikte Vanarana fideliği Viparyaslarla dolacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680441
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680441,
					"content": "#Utsava Festivali için bir sürü Viparyas gerekiyor. Vanarana'da onlardan bolca var ama mutlu Viparyaslar daha fazla olursa Aranaralar mutlu olur. Nara {NICKNAME} ve Paimon da mutlu olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680442
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680442,
					"content": "O zaman Vasmrti toplamaya yardım edelim! Peki nasıl toplayacağız? Arakara bunların rüyalar diyarı dışındaki fidelikte olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680443
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680443,
					"content": "Altın Naranın fideliğin olduğu topraklardan geçmesi gerek. Bir kere geçerse sorun değil. Çok geçerse kötü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680444
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680444,
					"content": "Sadece bir kez geçmek gerek. Sonra fidelikteki toprakta, yağmurlu bir geceden sonra güneş doğunca yapraklarda toplanan çiy taneleri gibi bir sürü Vasmrti yetişecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680445
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680445,
					"content": "Off... Paimon hiç anlamadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680446
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680446,
					"content": "Ama Aranaralarla daha önce yaşadıklarımızı düşünürsek... Rüyalar diyarının dışındaki fideliği bulduğumuzda Aranakula'nın dediğini anlarız herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680447
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680447,
					"content": "O zaman bir fidelik bulursak etrafa bakınalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}