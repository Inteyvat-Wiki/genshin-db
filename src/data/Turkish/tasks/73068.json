			"dialogs": [
				{
					"id": 730680201,
					"content": "#Nara {NICKNAME} ve Paimon? Aranakula, Arapandu'nun peşinden Ashavan Diyarı'na gitti ama hâlâ dönmedi. Şimdi biraz mantar yemeye ne dersiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakara"
				}
			]
		},
		{
			"id": 7306803,
			"completionStepIds": [
				7306803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7306803",
							"2"
						],
						"stepId": 7306803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Aranakula",
					"Arakara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680301,
					"content": "Aranakula! Vanarana'ya dönmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680302,
					"content": "#Nara {NICKNAME} ve Paimon! Varuna Mekanizması iyileşti. Aranakula artık fidelikle ilgilenebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680303
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680303,
					"content": "Aranakula'nın sürekli bahsettiği fidelik bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680304,
					"content": "Evet. Aranakula ve Arakara'nın birlikte ilgilendiği fidelik. Buradaki toprak mutlu Viparyaslar yetiştirmeye uygundu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680305
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680305,
					"content": "Mutsuz Viparyaslar da mı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680306,
					"content": "Mutsuz değiller. Sadece o kadar mutlu değiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680307
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680307,
					"content": "... Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680308,
					"content": "Yetişmelerine uygun toprak, yeteri kadar yağmur ve güneş ışığı olması, büyümelerinin önünde hiçbir engel olmaması gibi... Üzülecek hiçbir şey yok ama çok sevinecek bir şey de yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680309
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680309,
					"content": "Hımm... Sıkıcı ve sıradan bir şeymiş. Peki burası başka yerlerden farklı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680310,
					"content": "Vanarana'daki tüm topraklar iyi ama burası daha güzel. Daha da önemlisi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680311
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680311,
					"content": "Bitkilere Arakara ve Aranakula bakacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680312
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680312,
					"content": "Bakmak mı? Nasıl bakacaklar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680313,
					"content": "Onlara şarkı çalacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680314
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680314,
					"content": "Ayrıca güzelliklerine iltifat edecekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680315
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680315,
					"content": "Yabani Viparyaslarla tarlada yetişmiş Viparyas arasındaki fark bu mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680316
					]
				},
				{
					"id": 730680316,
					"content": "Paimon anlayabiliyor. Her gün güzel müzikler dinleyip güzelliğine iltifat edilince mutlu olmamak elde değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680317,
					"content": "#Evet. Aynı Paimon gibiler. Paimon, {NICKNAME} tarafından sudan çıkarılmadan önce mutsuz değildi ama mutlu da değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680318,
					"content": "#Paimon {NICKNAME} ile gezmeye başladıktan sonra birçok zorlukla karşılaştık ama Paimon mutluyken bazen daha da mutlu oluyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680319,
					"content": "Paimon haklı. Arakara, Utsava Festivali için mutlu Viparyasları kullanıp güzel ışıklar yapacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680320
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680320,
					"content": "Hehe. Aranakula da döndüğüne göre acele edip işe koyulmalıyız! Viparyasların tohumları... Viparyasların da tohumları var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680321
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680321,
					"content": "Viparyas toprak için boş bir söz gibidir. Toprak rüyasında Viparyasları böyle hatırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680322
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680322,
					"content": "O tohum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680323,
					"content": "Viparyas çiçeğinin tohumu yoktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680324
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680324,
					"content": "Öyle mi? Peki tohumsuz fidelik nasıl oluyor? Hımm... Yoksa Aranakula'da hiçlikten Viparyas yaratabilen bir Ararakalari mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680325
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680325,
					"content": "Hayır, Paimon yanılıyor. Fidelikte Viparyas yetiştirmek için Vasmrti gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680326
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680326,
					"content": "Vas... ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680327,
					"content": "Vasmrti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680328
					]
				},
				{
					"id": 730680328,
					"content": "Vanarana her şeyi hatırlar. Vasmrti ile toprağın hatıraları da rüyasında geri gelecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680329
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680329,
					"content": "Fidelikte de mutlu Viparyaslar yetişecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680330
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680330,
					"content": "#Hımm... Vasmrti'yi sadece Aranaralar mı elde edebilir? Yani {NICKNAME} ve Paimon'un fidelikte Viparyas yetiştirmesi imkansız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680331
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680331,
					"content": "#Altın Nara, Aranakula'ya ve diğer Aranaralara yardım etti. Altın Nara, Aranaraların arkadaşı olduğu için Aranakula ve Nara {NICKNAME} birlikte Viparyas yetiştirecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680332
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680332,
					"content": "#Vasmrti toprağa gömülsün. Böylece Viparyas doğacak. Hadi dene Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680333
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680333,
					"content": "Aranakula'nın dediğini yapıp Vasmrti'nin toprağa gömülmesine izin veriyorsun.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730680334
					]
				},
				{
					"id": 730680334,
					"content": "Bu kadar mı? Başka bitkileri ekmekten pek farklı değil sanki! Tohumu toprağa koyuyorsun. Sonra tohumun filizlenmesini bekliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680335
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680335,
					"content": "Paimon uçan bir kedi değilse Vasmrti de tohum değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680336
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680336,
					"content": "Hımm... Peki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680337
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680337,
					"content": "Bu arada fidelikte hâlâ bolca yer var. Bir, iki, üç... Vay be. Viparyas yetiştirilebilecek on iki yer var! Elinde daha fazla Vasmrti var mı Aranakula?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680338
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680338,
					"content": "Vardı ama artık yok. Tekrar toplamam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680339
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680339,
					"content": "Rüyalar diyarı dışında Vasmrti oluşturan 12 fidelik var. Onlarla birlikte Vanarana fideliği Viparyaslarla dolacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680340
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680340,
					"content": "#Utsava Festivali için bir sürü Viparyas gerekiyor. Vanarana'da onlardan bolca var ama mutlu Viparyaslar daha fazla olursa Aranaralar mutlu olur. Nara {NICKNAME} ve Paimon da mutlu olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680341
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680341,
					"content": "O zaman Vasmrti toplamaya yardım edelim! Peki nasıl toplayacağız? Arakara bunların rüyalar diyarı dışındaki fidelikte olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680342,
					"content": "Altın Naranın fideliğin olduğu topraklardan geçmesi gerek. Bir kere geçerse sorun değil. Çok geçerse kötü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680343
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680343,
					"content": "Sadece bir kez geçmek gerek. Sonra fidelikteki toprakta, yağmurlu bir geceden sonra güneş doğunca yapraklarda toplanan çiy taneleri gibi bir sürü Vasmrti yetişecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680344
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730680344,
					"content": "Off... Paimon hiç anlamadı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680345
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680345,
					"content": "Ama Aranaralarla daha önce yaşadıklarımızı düşünürsek... Rüyalar diyarının dışındaki fideliği bulduğumuzda Aranakula'nın dediğini anlarız herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680346
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680346,
					"content": "O zaman bir fidelik bulursak etrafa bakınalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7306804,
