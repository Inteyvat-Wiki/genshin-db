			"trigger": {
				"objectNames": [
					"Arakara"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730680101,
					"content": "Merhaba! Buranın toprakları başka yerlere benzemiyor. Bunun özel bir amacı mı var acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680103
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680103,
					"content": "Niye cevap vermiyor? Paimon'u duymadı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680104,
						730680106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680104,
					"content": "Merhaba!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680105
					]
				},
				{
					"id": 730680105,
					"content": "Ah... Nara?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680108,
					"content": "Nasıl? Vanarana'da niye bir Nara var? Beni yakalayıp pişirmeye mi gelmiş? Arakara mantar kadar leziz değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680109
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680109,
					"content": "Biz öyle bir kötülük yapacak kişiler miyiz? Bize \"Aranaraların neşeli dostları\" derler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680110,
						730680112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680110,
					"content": "Kimse öyle demedi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680111
					]
				},
				{
					"id": 730680111,
					"content": "Kimse söylemese bile içten içe böyle düşünüyorlardır eminim. Söylemeye gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680114,
					"content": "#Neyse. Ben Paimon. Bu altın renkli arkadaş da {NICKNAME}. İyi bir Naradır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680115,
					"content": "Sen Arakara'sın değil mi? Burada tek başına ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680116,
					"content": "Paimon niye sordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680117
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680117,
					"content": "Şey... Paimon sadece merak etti! Kelebek görünce üstüne zıplamak veya bir kertenkeleyi yakalamak gibi bir içgüdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680118,
					"content": "Paimon uçabilen bir kedi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680119
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680119,
					"content": "HAYIR!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680120,
					"content": "Hımm... Aranara sırları gibi bize söylemek istemediğin bir şeyse boş ver. O kadar anlayışsız değiliz. Değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680121,
					"content": "Hâlâ merak ediyorum tabii.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680122
					]
				},
				{
					"id": 730680122,
					"content": "Paimon da öyle düşünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680123,
					"content": "Sır mı? Arakara'nın sırrı yok. Arakara hiçbir şey yapmıyor. Arakara bekliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680124
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680124,
					"content": "Bekliyor musun? Başka Aranaraları mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680125,
					"content": "Aranakula, Arapandu'yla Ashavan Diyarı'na gitti. Ne zaman dönecekler bilmiyorum. Varuna Mekanizması iyi değil. Fidelikle ilgilenme zamanı değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680126
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680126,
					"content": "#Nara {NICKNAME} bahçıvanlık yapmayı sever mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680127,
						730680129
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680127,
					"content": "Bahçıvanlık zor bir iş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680128
					]
				},
				{
					"id": 730680128,
					"content": "Sadece Valuka'da zor. Vana'da zor değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680131,
					"content": "Paimon'a niye sormuyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680132,
					"content": "Paimon kelebek ve kertenkele yakalıyor. Bahçıvanlık yapacak birine benzemiyor. Sormak boşuna.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680133
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680133,
					"content": "Paimon pek katılmıyor ama... Paimon süreçten çok sonuca bakıyor, tamam mı? Bu Fidelikte ne yetiştiriyorsunuz peki? Leziz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680134,
					"content": "Lezzetli ama aynı zamanda başka bir şey için kullanılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680135
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680135,
					"content": "Ama şimdi Paimon açsa yemek için fideliğe gelmesin. Gidip mantarları yesin. Vana'da çok mantar var. Bazıları yenebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680136
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680136,
					"content": "Neyse. Aranakula henüz dönmedi. Hiçbir şeye başlayamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680137
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680137,
					"content": "#Anlaşılan Aranakula'nın dönmesini beklememiz gerekecek. Hadi gidelim {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680129,
					"content": "Bahçıvanlığı çok severim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680130
					]
				},
				{
					"id": 730680130,
					"content": "Harika! Arakara da öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680131
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730680112,
					"content": "Paimon haklı!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680113
					]
				},
				{
					"id": 730680113,
					"content": "Hehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730680106,
					"content": "Hadi yiyelim!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730680107
					]
				},
				{
					"id": 730680107,
					"content": "Mantarlar leziz! Nara? Leziz mi? Hayır, Nara yiyemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730680108
					],
					"speakerTitle": "Arakara"
				}
			]
		},
