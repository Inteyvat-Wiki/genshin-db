					"nextDialogs": [
						718080203
					]
				},
				{
					"id": 718080203,
					"content": "O'nun dirilişine tanık olmak için mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080204
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080204,
					"content": "Biraz erkencisin... Ama çok geç de kalmadın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080205
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080205,
					"content": "Neden bahsediyor bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 718080206,
					"content": "Şey, ne anlatıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080207
					]
				},
				{
					"id": 718080207,
					"content": "Hımm... Hâlâ gerçeği göremiyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080208
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080208,
					"content": "Belki de böylesi daha iyidir. Senin için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080209
					],
					"speakerTitle": "Jiu"
				},
				{
					"id": 718080209,
					"content": "Şimdi dön ve O'nun uyanışını bekle... O zaman mutlaka anlayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiu"
				}
			]
