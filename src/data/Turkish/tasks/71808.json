				},
				{
					"id": 718080302,
					"content": "Şöyle, Nantianmen'e gittiğimizde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080303
					]
				},
				{
					"id": 718080303,
					"content": "Depremler, canavarlar ve küçük bir kız... Kayıp bir çocuk belki de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080304
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080304,
					"content": "Dedi ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718080305
					]
				},
				{
					"id": 718080305,
					"content": "Ne? \"O\" kim? \"Diriliş\" ne? Ne saçmalamış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080306
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080306,
					"content": "Tuhaf tuhaf kitaplar okumuş herhalde... Neyse, konumuzla bir alakası yok. Çocuğu hemen şehre geri getirmesi için birini göndereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080307
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080307,
					"content": "Önce depremler, şimdi canavarlar... O çocuğun zarar görmesine izin veremeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080308
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080308,
					"content": "Çok teşekkür ederim. Yardımın için bunları kabul et lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080309
					],
					"speakerTitle": "Jiayi"
				},
				{
					"id": 718080309,
					"content": "Şu işin bir gününü de rahat geçiremeyecek miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jiayi"
