						718080903
					]
				},
				{
					"id": 718080903,
					"content": "Normal mi? Yani... Deprem yok, canavar da yok, öyle mi? Ne kadar garip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718080904
