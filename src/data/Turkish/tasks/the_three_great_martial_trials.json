			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Eboshi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750101,
					"content": "Karşına çıktım. Bu, Kanlı Ağaç Mercanının Watatsumi'nin elinde olduğu anlamına geliyor. Bunu bilmek beni rahatlatıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750102
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750102,
					"content": "Adım Erebos. Inazuma dilinde Eboshi derler. Enkanomiya'nın tapınak görevlilerinden biri olan Sangonomiya'nın yardımcılarından biriyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750103
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750103,
					"content": "Mercanı bulan kahraman sanırım sensin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750104
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750104,
					"content": "Evet benim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750105
					]
				},
				{
					"id": 722750105,
					"content": "Özür dilerim. Az sonra çok karmaşık bir konudan bahsedeceğim. Açıkçası nereden başlayacağımı bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750106
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750106,
					"content": "Baştan başla işte! Biz dinleriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722750107,
					"content": "Size minnettarım. Öyleyse size konuyu anlatarak başlayayım. Anlatmaya Watatsumi Omikami'nin derinlere giden geçidi açmasından başlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750108
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750108,
					"content": "Enkanomiya'nın derinliklerinde Watatsumi Adası'na giden doğal bir mağara yer alır. Watatsumi Omikami'nin bize vadettiği cennet orasıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750109
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750109,
					"content": "Omikami bize Narukami kültürünü öğretti ve birçok yabancı milletle ilişkiler kurduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750110
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750110,
					"content": "Hatta Narukami Adası bizi, yedi tür cilt lekesini gizleyen yumuşak cildimizden ötürü \"Watatsumi'nin güzelleri\" olarak bilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750111
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750111,
					"content": "Bu tabii ki atalarımızın Enkanomiya'nın derinliklerinde güneş ışığından uzak kalmasından ötürüymüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750112,
						722750113
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750112,
					"content": "Konuya gelebilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750114
					]
				},
				{
					"id": 722750114,
					"content": "Kusura bakmayın. Başka milletlerle ilişki kurarken, Sangonomiya yardımcısı olarak ziyaretçileri gezdirip rehberlik yapardım. O yüzden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750115
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750115,
					"content": "Tamam. Konuya dönüyorum. Leydi Sangonomiya ile bir konuda anlaşamadık. Sonuç olarak Watatsumi Omikami'nin aracılığıyla şu anki anlaşmaya vardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750116
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750116,
					"content": "Günahkar Ruhlar olarak bilinen olgu sayesinde Enkanomiya'nın \"geçmişi\", \"tarihi\" ve \"gerçekleri\" kimse ilgilenmese bile kaybolmayacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750117
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750117,
					"content": "Bu sebeple, hatırlayalım diye değil; \"unutalım\" diye büyük uğraşlar verildi. Leydi Sangonomiya da bu görüşteydi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750118
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750118,
					"content": "(Bahsettiği Sangonomiya çok eskiden yaşamış galiba.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722750119,
					"content": "Dalı almak için geçilmesi gereken imtihan, peşimize düşen ve olayın aslını biliyor olabilecek insanların sayısını sınırlandırmak içindi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750120
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750120,
					"content": "Bana gelince... Ben gerçeğin kayıtlara geçirilmesi taraftarıydım. Bu nedenle Watatsumi Omikami, geçildiğinde sırlarımıza dair bilgi sunacak farklı bir imtihan ekleme izni verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750121
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750121,
					"content": "Lütfen bu mücadeleyi kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750122,
						722750123
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750122,
					"content": "Mücadeleyi kabul ediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750124
					]
				},
				{
					"id": 722750124,
					"content": "Güzel. Öyleyse izin ver yolu senin için açayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750123,
					"content": "Hım, sır mı? Sırları severim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750124
					]
				},
				{
					"id": 722750113,
					"content": "Bunları zaten biliyoruz. Konuya gelebilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750114
					]
				}
			]
		},
		{
			"id": 7227502,
			"completionStepIds": [
				7227506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7227506",
							"2"
						],
						"stepId": 7227506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Eboshi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722750201,
					"content": "Tüm Jibashiriler seni kabul etmiş. Watatsumi'nin iradesini temsil ediyorlar. Bu nedenle her şeyi öğrenme hakkına eriştin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750202
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750202,
					"content": "Watatsumi halkının kurtarıcısısın ve Watatsumi'nin onayını almışsın. Böylece soru sormaya ve cevabını almaya hak kazandın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750203
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750203,
					"content": "Yine de kurallara uymanı ve gerçeği bu okyanusun hiçliğinden dışarı çıkarmamanı isteyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750204,
					"content": "Başka neyi bilmek istersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750205,
						722750206,
						722750207,
						722750208,
						722750209
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750205,
					"content": "Bana Su Ejderinden bahset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750210
					]
				},
				{
					"id": 722750210,
					"content": "Onlar okyanusun derinliklerinde yaşadıkları için göklerden gelen kudrete boyun eğmeyen ilkel element varlıklarıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750211
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750211,
					"content": "Aslında çok zekilerdir. Evrim geçirmekte ustalardır. Hatta bizimle yaptıkları savaş boyunca farklı element biçimlerine de evrildiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750212
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750212,
					"content": "Konuşmayı öğrendilerse veya bir çeşit kertenkelemsi insan türüne dönüştülerse hiç şaşırmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750213
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750213,
					"content": "Kutsal Toprak olgusu aslında yaşam alanlarının genişlemesidir. Bu da üç diyarın elementinin güçlendiği anlamına geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750214
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750214,
					"content": "Sadece Watatsumi Omikami'nin yaşam enerjisini kullanıp onun ikinci hizmetkarını uyandırarak, bu saf ve kontrol edilemeyen element gücünü dönüştürebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750206,
					"content": "Bana Watatsumi Omikami'den bahset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750215
					]
				},
				{
					"id": 722750215,
					"content": "Watatsumi Omikami, bahtsızlığı yüzünden kutsal heyetin yetki alanında olmayan bu yere düştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750216
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750216,
					"content": "Şüphesiz bu bizim, yani Byakuyakoku halkı için büyük şanstı. Bizim açımızdan çok faydalı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750217
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750217,
					"content": "Ne yazık ki, bizimle iletişime geçerek, kendinden önce var olan bir gerçeği kavradı. Bu yüzden kutsal heyet tarafından kendini feda etmeye zorlandı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750218
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750218,
					"content": "Bu fedakarlığın ardındaki gerçeği kimse bilmemeliydi. Sadece bu şekilde Byakuyakoku halkının Yedilerin yönetiminde yaşamasına izin verilecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750207,
					"content": "Güneş ve ay yokken dünya nasıldı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750219
					]
				},
				{
					"id": 722750219,
					"content": "Byakuyakoku okyanusun derinliklerine batmadan önce tüm dünya tek bir kültüre sahipti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750220
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750220,
					"content": "Daha sonra büyük bir savaş çıktı. Bu savaşta gök ters döndü ve yer parçalara ayrıldı. Sonra da bu topraklar okyanusun karanlıklarına çöktü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750221
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750221,
					"content": "Fakat kutsal heyet tüm bu olanları hatırlayan insanların dünyaya dönmesini istemiyordu. Bir dönüş yolu aradık durduk... Ama bulamadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750222
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750222,
					"content": "Çok uzun bir süre sonra kutsal heyetin koyduğu yasak zamanla gücünü kaybetti. Böylece Watatsumi Omikami buraya düşebildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750208,
					"content": "Bana Dainichi Mikoshi'den bahset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750223
					]
				},
				{
					"id": 722750223,
					"content": "Dainichi Mikoshi, Bilge Abrax tarafından inşa edildi. Karanlığın derinliklerine ışık tutma gücüne sahip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750224
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750224,
					"content": "Ayrıca birkaç farklı işlevi daha var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750225
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750225,
					"content": "Yani epey güçlü bir alet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750204
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750209,
					"content": "Başka sorum yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722750226
					]
				},
				{
					"id": 722750226,
					"content": "Peki. Tekrar söylüyorum. Lütfen Enkanomiya'da gördüğün her şeyi sonsuza dek sır olarak saklamayı unutma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Eboshi"
				}
			]
		},
