					"nextDialogs": [
						722750408
					]
				},
				{
					"id": 722750408,
					"content": "Geceleri yukarıdaki kubbeden inen üç ışık hüzmesi görebilirsiniz. Bu ışık hüzmeleri Gök Havuzu'na doğru gider.",
					"roleType": "TALK_ROLE_NPC",
