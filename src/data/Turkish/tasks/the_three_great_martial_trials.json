					"nextDialogs": [
						722750411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722750411,
					"content": "Kusura bakmayın. Watatsumi Omikami'nin yazdığı metin böyle. Zaten belirsiz talimatlar bu tür imtihanlarda adet değil midir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750412
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750412,
					"content": "Her neyse. İmtihan yerindeki tüm Jibashiriler tuhaf insanlardır. Oraya giderken ışınlanma kapısından geçmezseniz size kibar davranmazlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750413
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750413,
					"content": "Elimden gelen tek şey burada beklemek ve karşılaşacağınız tüm engelleri aşıp itibar kazanmış bir halde dönmenizi ummak.",
					"roleType": "TALK_ROLE_NPC",
