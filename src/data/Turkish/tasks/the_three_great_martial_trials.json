					"content": "Ebedi Gecede Byakuyakoku'nun sınırlarına bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750404
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750404,
					"content": "\"Ebedi gecenin sakinliğinde, Stiks nehrinin ötesinde, göğün ışığının masum akışında.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722750405
					],
					"speakerTitle": "Eboshi"
				},
				{
					"id": 722750405,
					"content": "Gök Havuzu'nun mührünü kaldır. Böylece Göğün Kapısına yükselip imtihan yerine erişebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
