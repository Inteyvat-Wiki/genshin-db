			"dialogs": [
				{
					"id": 200340301,
					"content": "Bennett yine her zamanki gibi oldukça güvenilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340302
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340302,
					"content": "Ve Fischl'ın da... Sözleri her zamanki gibi etkileyici!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340303,
						200340308
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340303,
					"content": "Bennett'le ilgili şu ana kadarki izlenimin nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340304
					]
				},
				{
					"id": 200340304,
					"content": "Bennet'le ilgili izlenimim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340305
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340305,
					"content": "Loncaya ilk katıldığımda sorularımın çoğunu yanıtlayıp bana epey yardım etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340306
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340306,
					"content": "Ama çok şanssız olduğunu duymuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340307
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340307,
					"content": "Hiç adil değil. Halbuki çok iyi bir insan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340313,
					"content": "Sanırım öyle ya da böyle bu görevi bitirdik. Teşekkür ederim Gezgin. Şimdi Loncaya rapor vermeye gideceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340314
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340314,
					"content": "Acaba neden art arda birkaç gündür taşıma balonuna eşlik ediyorum? Loncanın vereceği başka görev yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340308,
					"content": "Fischl nasıldı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340309
					]
				},
				{
					"id": 200340309,
					"content": "Fischl mı? Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340310
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340310,
					"content": "O da harikaydı! O çok iyi bir okçu ve tamamladığı bir sürü görev var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340311
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340311,
					"content": "Söylediği şeyleri hiç anlamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340312
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340312,
					"content": "Ama yine de kendisi çok deneyimli bir maceracı. Yok dur, Fischl bir müfettiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340313
					],
					"speakerTitle": "Anna"
				}
			]
		},
