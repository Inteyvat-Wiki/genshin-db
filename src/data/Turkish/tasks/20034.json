			},
			"dialogs": [
				{
					"id": 200340101,
					"content": "Hadi bakalım, bugün de sıkı çalışalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340102,
						200340106
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340102,
					"content": "Haha, bayağı gaza gelmişsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340103
					]
				},
				{
					"id": 200340103,
					"content": "Tabii ki! Maceracı olmak hakikaten çok ilgimi çekiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340104,
					"content": "Ama... Görev yaparken hâlâ neler yapmam gerektiğini tam olarak bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340105
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340105,
					"content": "Gezgin, tekrar benimle gelmek ister misin? Hâlâ sana sormak istediğim şeyler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340108,
					"content": "O zaman yola koyulalım. Bugünün görevi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340109,
					"content": "Ha... Demek bir taşıma balonuna daha eşlik edeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200340106,
					"content": "Ben de mi geleyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200340107
					]
				},
				{
					"id": 200340107,
					"content": "Gelir misin? Hehe, olur! Hâlâ senden öğrenebileceğim çok şey var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200340108
					],
					"speakerTitle": "Anna"
				}
			]
		},
		{
			"id": 2003402,
			"completionStepIds": [
