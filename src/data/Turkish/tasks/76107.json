					"content": "Hocasıyım diyebiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071602
					]
				},
				{
					"id": 761071602,
					"content": "Aa! Ben de Fontaine Araştırma Enstitüsünden ona birkaç makale getirmiştim daha önce. Dr. Mosso'nun araştırma sonuçlarından övgüyle bahsediyordu... Yoksa siz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071603
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071603,
					"content": "*öksürür* *öksürür*... Hı hı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071604
					]
				},
				{
					"id": 761071604,
					"content": "E-Evet! Şanınız buraya kadar yürümüş demek ki Dr. Mosso!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071605,
					"content": "Hıh. Bildiğim kadarıyla otuz yıl önce ölmüştün. Neyse, geç olsun güç olmasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
