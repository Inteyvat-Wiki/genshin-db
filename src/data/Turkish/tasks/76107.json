					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071301,
					"content": "Bilimsel ilerlemenin temelinde iş birliği vardır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071302
					]
				},
				{
					"id": 761071302,
					"content": "Hımm... Makul. Fontaine Araştırma Enstitüsünden ona birkaç makale getirmişliğim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071303
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071303,
					"content": "İşin uzmanı olduğunuza göre, Kara Kruvazöründeki arızayı düzeltmek sizin için çok kolay olsa gerek, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610714,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
