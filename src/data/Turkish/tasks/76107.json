					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071401,
					"content": "Şey... Ben daha çok teorik araştırmalara odaklanıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071402
					]
				},
				{
					"id": 761071402,
					"content": "Anladım! Kuuvahki teorisi epey derin bir araştırma alanı. Çok etkileyici! Kara Kruvazörü tamir etmek için pratik uzmanlık gerekiyor. Tam da dediğin gibi, ikisi tamamen farklı alanlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071403
					],
					"speakerTitle": "Risto"
				},
				{
					"id": 761071403,
					"content": "Ama Leydi Kukla şu anda burada değil. Kumandan Azalea ile konuşabilirsiniz, o gerisini ayarlayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
