				{
					"id": 761071501,
					"content": "Tabii, öyle yapayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071502
					]
				},
				{
					"id": 761071502,
					"content": "Kara Kruvazörüne birkaç kez vuruyorsun. *tak, tak, tak*... Tamamen hareketsiz hale geliyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761071503
					]
				},
				{
					"id": 761071503,
					"content": "Tamamen bozuldu... Ne yapacağız şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071504,
					"content": "Hıh, en başından beri sende bir tuhaflık olduğunu biliyordum. Gerçek bir araştırmacı asla böyle bol keseden sallamaz. Sahtekarsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
