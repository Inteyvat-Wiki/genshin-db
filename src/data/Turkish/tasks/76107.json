					"Risto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761071201,
					"content": "Kukla'nın özel olarak atadığı bir araştırmacıyım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071202
					]
				},
				{
					"id": 761071202,
					"content": "\"Özel atanan araştırmacı\" mı? Leydi Kukla, hem mekanik hem de Kuuvahki araştırmalarında zirveye ulaşmış durumda. Neden başka araştırmacıları işe almaya ihtiyaç duysun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610713,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
