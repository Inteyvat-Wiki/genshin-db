			"dialogs": [
				{
					"id": 761071101,
					"content": "Bendeniz Haberciniz, Kukla!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761071102
					]
				},
				{
					"id": 761071102,
					"content": "Ha? Daha iyi bir şey bulamadın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761071103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 761071103,
					"content": "Hımm. Cesaretini takdir ediyorum. Fakat böyle saçma bir yalana inanacağımızı düşünüyorsan Fatui'yi hafife alıyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Risto"
				}
			]
		},
		{
			"id": 7610712,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
