			},
			"dialogs": [
				{
					"id": 3081401,
					"content": "Doğu'nun Ejderi, Güney'in Aslanı, Kuzey'in Kurdu, Batı'nın Şahini...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081402
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081402,
					"content": "Bunlar, Rüzgar Tanrısı Barbatos'a bağlı olan Mondstadt'ın Dört Rüzgarı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081403
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081403,
					"content": "Doğu'nun Ejderi, Fırtına Dehşeti... Gerçek adı Dvalin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081404
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081404,
					"content": "Ama Mondstadt'taki çoğu kişi, tüm bu \"Fırtına Dehşeti\" olaylarıyla bunu unutmuş gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081405
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081405,
					"content": "Yani artık, Dvalin'in neden Dört Rüzgardan yalnızca üçünü kullanabildiğini biliyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081406
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081406,
					"content": "Çünkü en başından beri kendini tüketiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081407,
						3081408
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081407,
					"content": "Neden?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				},
				{
					"id": 3081409,
					"content": "Nefret yüzünden, sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081410
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081410,
					"content": "Nefret mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081411,
					"content": "Mondstadt'a duyduğu nefret.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081412
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081412,
					"content": "Nefret onu, rüzgarın kendisinden daha güçlü bir şey olmaya itti, Fırtına Dehşeti olmaya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081413
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081413,
					"content": "Ama neden Dört Rüzgardan biri...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081414,
					"content": "Koruması gereken şehirden neden nefret etsin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3081415,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081416
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081416,
					"content": "Mondstadt'ın bir çocuğu olarak, bu gerçekten de yüksek sesle söylemesi zor bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081417
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081417,
					"content": "İşte, al bunu. Bu, yüz yıldan fazla geçmişe sahip eski, çok eski bir bir hikaye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081408,
					"content": "Neden bu kadar ileri gitsin ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3081409
					]
				}
			]
		}
	]
