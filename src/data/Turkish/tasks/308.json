			"dialogs": [
				{
					"id": 3081301,
					"content": "Burada dışarıda dururken bile, içerideki element akımının neden olduğu parazit beni rahatsız ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3081302
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 3081302,
					"content": "Hadi, bu tapınağı eski haline döndürelim, böylece ben de birazcık daha az... Gergin olabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				}
			]
		},
		{
			"id": 30814,
