				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730590201,
					"content": "Aranaga, o burada, buradalar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590202
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590202,
					"content": "Evet, burada. Buradalar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590203
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590203,
					"content": "#İşte buradasınız Nara {NICKNAME} ve Uçuşkan Beyazlı. Hoş geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590204
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590204,
					"content": "İşte ay göründü bile. Artık çiçekleri dikme zamanı. Hazır mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590205
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590205,
					"content": "Hazırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590206
					]
				},
				{
					"id": 730590206,
					"content": "Bunu Paimon da istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590207,
					"content": "Madem öyle... Aranakin, Aragaru. Hadi ayine başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590208
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590208,
					"content": "\"Eve dönün, eve dönün bahçenin rüyaları, ormanın hatıraları...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590209
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590209,
					"content": "\"Hadi sarılalım:\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590210
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590210,
					"content": "\"Daha derin rüyalar, sonsuz mutluluklar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590211
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590211,
					"content": "\"Hadi sevinelim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590212
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590212,
					"content": "\"Şarkı söyler narlar, alkış tutar elmalar!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590213
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590213,
					"content": "Aranaralar kuru çiçekleri diker. Rüzgarda yankılanan şarkının eşliğinde çiçekler büyülü bir şekilde canlanır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730590214
					]
				},
				{
					"id": 730590214,
					"content": "Vay be... Üç çiçek yeniden canlandı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590215,
					"content": "Evet, Mawtiyima iyilik yapmayı sever de o yüzden. Hatıralara yeniden canlanma fırsatı sunar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590216
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590216,
					"content": "Evet! Biz sizi unutsak bile hatıralarımız yaprakların damarlarına ve köklerine karışacak... Yapraklara, ağaçların yaş halkalarına dönüşecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590217
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590217,
					"content": "Ya da belki tombul solucanlara dönüşecek ve başka solucanlar tarafından yenilecek. Sonra da bitkiler için besin haline gelecek. Biz de bu sayede büyüyeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590218
					],
					"speakerTitle": "Aragaru"
				},
				{
					"id": 730590218,
					"content": "Yine de... Bizi hâlâ hatırlamıyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590219,
					"content": "Evet çünkü hatıralar artık size veya bana ait değil... Geçmişteki hatıralarımızı ormandaki tüm çimlerle ve ağaçlarla paylaştık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590220
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730590220,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590221
					]
				},
				{
					"id": 730590221,
					"content": "Bunun bir önemi yok tabii! Şimdi yeniden arkadaş olduk, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590222
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730590222,
					"content": "Evet! Yeni arkadaşlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aragaru"
				}
			]
		},
