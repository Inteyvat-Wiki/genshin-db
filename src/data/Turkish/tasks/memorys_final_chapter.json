			},
			"dialogs": [
				{
					"id": 730590101,
					"content": "\"Şarkı söyler narlar, alkış tutar elmalar...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590102
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590102,
					"content": "Merhaba Bay Khayyam! Sizi buraya hangi rüzgar attı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590103,
					"content": "Ah, merhaba beyazlı çocuk ve... *iç çeker* Kusura bakma evladım. Hafızam iyice kötüleşmeye başladı. İsimler bir süre sonra aklımdan uçup gidiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590104
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590104,
					"content": "#Adım {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590105
					]
				},
				{
					"id": 730590105,
					"content": "Haha... Doğru ya, siz şeydiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590106
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590106,
					"content": "Evet! Biz Javanlarız. Cesur gençleriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590107,
					"content": "Hımm. O zaman söyleyin bakalım, Aranaralar beni hâlâ hatırlıyor mu? Hepimizi hatırlıyorlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590108
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590108,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590109,
						730590112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590109,
					"content": "Evet, hatırlıyorlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590110
					]
				},
				{
					"id": 730590110,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730590111,
					"content": "Hımm... Bense artık onları göremiyorum. Beni ne kadar özlediklerini de duyamıyorum. Çok yazık, çok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590114,
					"content": "Hehe. Artık onları göremiyorum ki... Yüzlerini göremeyecek, seslerini duyamayacak kadar yaşlıyım. Bitti. Her şey bitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590115
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590115,
					"content": "*öksürür* Özür dilerim, artık gitmem lazım. Belki de bir mucize benim tek umudumdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590116
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590116,
					"content": "Mucizeleri anlamak veya mucize peşinde koşmak mümkün değildir. Beklemek dışında yapabileceğimiz bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590117
					],
					"speakerTitle": "Khayyam"
				},
				{
					"id": 730590117,
					"content": "Khayyam sendeleyerek uzaklaşıyor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730590112,
					"content": "Unutmuşlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590113
					]
				},
				{
					"id": 730590113,
					"content": "Hepsiyle yeniden arkadaş olabiliriz ama!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "Paimon"
				}
			]
		},
