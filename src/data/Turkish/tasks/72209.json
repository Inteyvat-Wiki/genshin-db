			},
			"dialogs": [
				{
					"id": 722090101,
					"content": "Bugün de pek sakin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090102,
					"content": "Ah, geldiniz demek. Sen tapınağı temizledikten sonra dün o kadar güzel uyudum ki... Miyav, miyav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090103
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090103,
					"content": "Yeşil giyen iki insan dün de buraya geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090104,
					"content": "Gerçi o ikisi dışında kimse gelip burada saygılarını sunmuyor. Çok tuhaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090105,
					"content": "O ikisi tapınağa geldiğinde şuradaki ahşap rafla pek bir ilgilendiler miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090106,
					"content": "Hibiki'nin rafa \"Dua Rafı\", şu ufak ahşap parçalara da \"Dua Levhaları\" dediğini hatırlıyorum. Gerçi birçok kişi sırf bu ahşap raf için tapınağı sık sık ziyaret ederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090107,
					"content": "Hımm... Yoksa insanlar odunlara özel bir ilgi mi duyuyor? Birçok ziyaretçi ahşap rafa gidip biraz Mora koyuyor, sonra ufak ahşap şeyler asıyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090108,
					"content": "O-Odunlara ilgi duyduklarından değil bence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090109
					]
				},
				{
					"id": 722090109,
					"content": "Öyle mi? O halde... Odun sevmedikleri için mi yaptılar? Odunu cezalandırmak içindir belki de.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090110,
						722090111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090110,
					"content": "Odun kısmına o kadar takılma bence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				},
				{
					"id": 722090112,
					"content": "Neyse artık, raf şu an çok kötü durumda, rafa daha çok ahşap blok gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090113,
					"content": "İnsanlar ve odunlar arasındaki ilişkiyi anlayamasam da tapınak dediğin yerde bu ikisinden de bulunmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090114,
					"content": "Raf harap olduğu ve tapınakta odun kalmadığı için kimse gelmiyor kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090115,
					"content": "Bu sebeple sizden bir şey daha istemem gerek. Ahşap rafı tamir eder misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090116,
						722090121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090116,
					"content": "Hallederiz, bize bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090117
					]
				},
				{
					"id": 722090117,
					"content": "Hazır sözü geçmişken şu Bağış Kutusunu onarmak için kullandığımız malzemelerden birazı duruyordu, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090118,
					"content": "Ondan emin değilim... Siz insanlar niye odunları bu kadar seviyorsunuz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090119,
					"content": "Neyse boş ver... Paimon bizde fazladan olduğunu hatırlıyor. Etrafa bakınalım biraz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090120,
					"content": "O zaman ahşap raf mevzusunu size bırakıyorum. Bu tapınak kendi kendini onarmayacak sonuçta miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090129,
					"content": "Hem kutuyu hem de rafı onardığınızda tapınak ziyaretçilerle dolup taşacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090121,
					"content": "Bu ahşap raf ne zamandır bakımsız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090122
					]
				},
				{
					"id": 722090122,
					"content": "Epeydir. Kutudan bile evvel harap oldu ki kutu harap olalı uzun yıllar oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090123
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090123,
					"content": "Yani bilmiyorsun, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090124,
					"content": "Hah. Güneşin kaç kere doğup battığını sayacak değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090125,
					"content": "Şu Bağış Kutusunu onarmak için kullandığımız malzemelerden birazı duruyordu, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090126,
					"content": "Ondan emin değilim... Siz insanlar niye odunları bu kadar seviyorsunuz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090127,
					"content": "Neyse boş ver... Paimon bizde fazladan olduğunu hatırlıyor. Etrafa bakınalım biraz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090128
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090128,
					"content": "O zaman ahşap raf mevzusunu size bırakıyorum. Bu tapınak kendi kendini onarmayacak sonuçta miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090129
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090111,
					"content": "Malzemenin kendisiyle alakası yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090112
					]
				}
			]
		},
