			"dialogs": [
				{
					"id": 722090201,
					"content": "Dua Rafı fazla eskimiş, uzun süredir böyle sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090202,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090203
					]
				},
				{
					"id": 722090203,
					"content": "Ah, merhaba Gezgin. Eiko Hanım'la bu tapınağın etrafındaki bölgeyi inceliyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090204,
					"content": "Birçok tapınak tesisi uzun süre önce harabeye döndü ama... Buna rağmen hepsi yerli yerinde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090205,
					"content": "Civar köylerden gelen insanlar ibadetlerini yapmak için buraya geliyordur. Buranın harap olması ile Koseki Köyü'nün terk edilmesi arasında bir bağlantı olduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				}
			]
		},
		{
			"id": 7220903,
			"completionStepIds": [
				7220904
			],
