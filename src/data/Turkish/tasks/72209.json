			"dialogs": [
				{
					"id": 722090601,
					"content": "Şu yeşil giyen iki insanın Dua Levhası astığı ilişti gözüme. Güvenilir insanlarmışsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090602,
					"content": "Levhalarını astıktan sonra eminim gidip başkalarına da anlatırlar, sonra onlar da ziyarete gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090603
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090603,
					"content": "Miyav, miyav, miyav... Demek tapınağın \"temizliği\" ve kutuyu onarmanın yanı sıra bu raf da çok önemliymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090604
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090604,
					"content": "İyi, çok iyi. Miyav miyav miyav! Bu sayede tapınak yine cıvıl cıvıl olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090605,
					"content": "Neden bu tapınağı yenilemek istiyorsun ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090606
					]
				},
				{
					"id": 722090606,
					"content": "Miyav... Neden acaba... Geçici başrahibeyim ne de olsa. Bu tapınakla ilgilenmek, birçok kişinin ziyarete gelmesini sağlamak ve burayı canlı tutmak benim görevim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090607
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090607,
					"content": "Ayrıca Hibiki dönüp bu tapınağı yıkık dökük görseydi pek kederlenirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090608
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090608,
					"content": "Miyav, miyav. Sizin de yardımınızla eminim burası en kısa zamanda eski ihtişamına kavuşacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090609
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090609,
					"content": "Ara sıra yardımınız gerekebilir miyav. Öyle olduğunda beni geri çevirmezsiniz herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
