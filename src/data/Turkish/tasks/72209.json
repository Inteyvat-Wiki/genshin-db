			},
			"dialogs": [
				{
					"id": 722090501,
					"content": "Bu Dua Rafını çok iyi onarmışsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090502,
						722090503
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722090502,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				},
				{
					"id": 722090504,
					"content": "Ama şu Dua Levhaları... Ne yazdığını okumak mümkün değil. Acaba ne zamandır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090505
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722090505,
					"content": "Eiko Hanım! Birkaç ahşap kalas buldum. Bulmuşken de birkaç Dua Levhası yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090506
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090506,
					"content": "Madem bu Dua Rafı onarıldı, o zaman birkaç tane Dua Levhası koysak fena olmaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090507
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090507,
					"content": "Yazmamı istediğin bir dilek var mı Eiko Hanım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090508
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090508,
					"content": "Tapınağa Dua Levhası asmak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090509
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722090509,
					"content": "Hehe, çok ilginç bir fikir. Şu levhalardan bir tane de bana ver, ben kendim çizerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090510
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722090510,
					"content": "Demek asmak için Dua Levhası hazırlıyorlar, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090511,
					"content": "Bunu Neko'ya söylememiz gerek. Eminim mutlu olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722090503,
					"content": "Bir iki bir şey biliyorum işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090504
					]
				}
			]
		},
