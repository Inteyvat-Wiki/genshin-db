			},
			"dialogs": [
				{
					"id": 722090401,
					"content": "Merhaba Gezgin. Senin için ne yapabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090402
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090402,
					"content": "Dua Rafını onardım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090403
					]
				},
				{
					"id": 722090403,
					"content": "Öyle mi? Sen mi tamir ettin? Çok kibarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090404
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090404,
					"content": "Geçici başrahibe tarafından görevlendirildim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090405
					]
				},
				{
					"id": 722090405,
					"content": "L-Leydi Neko mu istedi senden bunu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090406
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090406,
					"content": "Gidip geldiğimizi fark etti mi o halde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090407,
						722090408
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090407,
					"content": "Pek sanmam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				},
				{
					"id": 722090409,
					"content": "Eiko Hanım! Dua Rafının olduğu yere gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090410
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090410,
					"content": "Önce Bağış Kutusu, şimdi de Dua Rafı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090411
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722090411,
					"content": "Bu geçici başrahibe, tapınağı onarmak konusunda bayağı ciddi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090412
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722090412,
					"content": "Ama buranın sakinleri uzun süre önce buradan göçtüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090413
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722090413,
					"content": "Yani bu adada bizden başka bu tapınağa gelip ibadet edecek kimse yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090414
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722090414,
					"content": "Ne demeye çalışıyorsun Eiko Hanım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090415
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090415,
					"content": "Geçici başrahibe bunu henüz fark etmedi mi? Tapınağı hangi amaçla onartıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090416
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722090416,
					"content": "Neyse, sanırım şüpheme yenik düştüm. Dua Rafına gitmemizde bir sakınca yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090417
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722090417,
					"content": "Ancak tetikte olsak iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090418
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722090418,
					"content": "Leydi Neko sadece bir kedi Eiko Hanım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722090408,
					"content": "Öyle de denebilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090409
					]
				}
			]
		},
		{
