					"Neko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722090301,
					"content": "Miyav, miyav, miyav... Şu ahşap raf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090302,
					"content": "Tamir ettim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090303
					]
				},
				{
					"id": 722090303,
					"content": "Ah! Ettin mi gerçekten? Burası artık tapınağa daha çok benziyor! Miyav, miyav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090304,
					"content": "Öyleyse şu yeşil giyen iki insana gidip rafın onarıldığını ve ahşap bloklarını asabileceklerini söyle. Onlar da hazır oradayken belki yanlarında başkalarını da getirirler ve ibadet edip kutuyu Morayla doldururlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090305,
					"content": "Kendin niye söylemiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722090306
					]
				},
				{
					"id": 722090306,
					"content": "Olmaz! Şu uzun olan çok korkunç. Kedilerin kalplerini okuyabiliyor resmen. Şekilden şekle girsem de gözünden hiçbir şey kaçmıyor! Miyav, miyav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722090307
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722090307,
					"content": "Ayrıca benimle ne zaman konuşsa aşırı heyecanlanıyor. Miyav, miyav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
		{
			"id": 7220904,
			"completionStepIds": [
				7220905
			],
