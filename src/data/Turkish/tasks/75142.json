			},
			"dialogs": [
				{
					"id": 751420701,
					"content": "Kutsal Dağ'ın karnı ağrıyor galiba. Her gün bir şeyler kusuyor. Sen de gördün. Dışarı çıkıp oynayamayız, çok tehlikeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420702
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420702,
					"content": "Kimosi Amca'nın hikayelerinde yanardağın karnı ağrıyorsa birkaç defa karnı sevildiğinde hemen iyileşir... Keşke ellerim daha büyük olsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420703
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420703,
					"content": "Yetişkinler onu daha iyi sevebilir ama bizim kabile dışında oynamamızı istemiyorlar, o yüzden erteleyip duruyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420704
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420704,
					"content": "Haha, demek öyle düşünüyorsun! Bana kalırsa Kutsal Dağ o kadar büyük ki karın ağrısını geçirmek istiyorsak karnını tüm kabilenin sevmesi lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420705
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420705,
					"content": "Ama yetişkinlerin hepsi çok meşgul! Varesa'ya baksana, bütün gün meyve bahçesinde çalışıyor. Tüm yetişkinlerin boş vakti olmasını bekleyeceğiz mecbur, sonra gidip yanardağı hep beraber severiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420706
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420706,
					"content": "Hımm, güzel noktaya değindin bak. *iç çeker* O halde yetişkinleri bekleyeceğiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420707
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420707,
					"content": "O zamana kadar da onların kurallarına uyacağız ve Kutsal Dağ sakinleşene kadar kabileden dışarı çıkmayacağız, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420708
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420708,
					"content": "... Peki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420709
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420709,
					"content": "Siz ikiniz ne konuşuyorsunuz öyle? Paimon \"karın sevme\" falan duydu sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420710
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751420710,
					"content": "#Ne mi konuşuyorduk... Aa... Sarışın bir savaşçı ve gümüş bir peri... Siz büyük kahramanlar {NICKNAME} ve Paimon olmalısınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420711
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420711,
					"content": "Her neyse, biz kabilemizin son derece gizli sırlarından konuşuyorduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420712
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420712,
					"content": "Yanardağların karnını sevmek \"kabile sırrı\" mıymış?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420713
					]
				},
				{
					"id": 751420713,
					"content": "N-Ne? Her şeyi duydunuz mu siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420714
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420714,
					"content": "Çok yüksek sesle konuşuyordun! Bir dahaki sefere sırlardan konuşacak olursan kulağıma fısılda, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420715
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420715,
					"content": "Peki... *iç çeker* Ama öylesi biraz fazla yakın olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420716
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420716,
					"content": "Haha, iyi madem. Yabancı kahraman, benim adım Duniya. Bu bahtsız aptal da Dutse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420717
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420717,
					"content": "Bana aptal demeyi bırakır mısın lütfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420718
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420718,
					"content": "Bereket Kolektifine hoş geldiniz! Küçük Tepetlizorunuz da hoş geldi... İlginç, kabileye Sürüngenlerin girmesini engelleyen runlar vardı aslında... Bunun Kutsal Dağ'ın kötü olmasıyla bir ilgisi olabilir mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420719
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420719,
					"content": "Hıh, runların da güzelce sevilmeye ihtiyacı var demek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420720
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420720,
					"content": "Senin kafana geçireceğim bir tane şimdi, göreceksin sevilmeyi! Neyse, sizin gibi kahramanların Bereket Kolektifine gelmesini beklemiyordum hiç...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420721
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420721,
					"content": "Yardımcı olabileceğimiz bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420722
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420722,
					"content": "Duniya ve Dutse'ye Kutsal Dağ'a girmek istediğinizi söylüyorsunuz...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751420723
					]
				},
				{
					"id": 751420723,
					"content": "Kutsal Dağ'a mı girmek istiyorsunuz? Pek kolay olmayacak... Yetişkinler oranın çok tehlikeli olduğunu söylüyor, o yüzden bizim oraya gitmemiz yasak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420724
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420724,
					"content": "Ama sizin kendinizce sebepleriniz vardır eminim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420725
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420725,
					"content": "Hımm... İçeri girmenin bir yolunu bulan başka biri olmuştu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420726
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420726,
					"content": "B-Ben de! Ben de biliyorum birini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420727
					],
					"speakerTitle": "Dutse"
