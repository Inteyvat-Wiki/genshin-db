				"points": []
			},
			"dialogs": [
				{
					"id": 751420301,
					"content": "Volkanik Harabeler hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420302
					]
				},
				{
					"id": 751420302,
					"content": "Aa! Volkanik Harabeleri merak ediyorsun demek? Bak orayı bilirim işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420303
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420303,
					"content": "Uzun, çok uzun zaman önce... Natlan huzur dolu bir cennetken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420304
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420304,
					"content": "500 yıl önce yani. O zamanlar Natlan'daki Hiçlik aşındırmasının en kötü olduğu dönemmiş. Harabelerin bir bölümü yanardağ tarafından olduğu gibi tek parça püskürtülmüş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420305
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420305,
					"content": "Of Duniya, niye hikayemi bölüyorsun her seferinde?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420306
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420306,
					"content": "Çünkü başlarken hep \"uzun, çok uzun zaman önce\" diye başlıyorsun... Kimse duymak istemiyor ki orasını!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420307
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420307,
					"content": "... Kimosi Amca bana hikayeyi böyle anlattı. Üstelik kendisi Ateş Konseyi tarafından gönderilen keşif ekibinin üyelerindendi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420308
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420308,
					"content": "Duyduğuma göre yakın zaman önce Volkanik Harabelerin çevresinde Hiçliğin izleri görülmüş. Acaba Kimosi Amca'nın durumu nasıldır?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420309
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420309,
					"content": "Harabelere giderseniz benim için halini hatırını sorar mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dutse"
				}
			]
		},
