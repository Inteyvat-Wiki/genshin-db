			"dialogs": [
				{
					"id": 751420101,
					"content": "Bir şey mi oldu yabancı kahraman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420102
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420102,
					"content": "Kazı alanını ve Volkanik Harabeleri bulamadın mı? Öyleyse sanırım... Yetişkinlerin kuralını biraz \"esnetmemiz\" gerekecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420103
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420104
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420104,
					"content": "*iç çeker* İyi peki... Kabileden dışarı çıkmayacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420105
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420105,
					"content": "#Ne öğrenmek istiyorsun {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Duniya"
				}
			]
		},
		{
			"id": 7514202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
