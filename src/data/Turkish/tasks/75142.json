				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751420201,
					"content": "Kazı alanı hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420202
					]
				},
				{
					"id": 751420202,
					"content": "Adı Gizli Kaynağın Kalıntıları kazı alanı olmalı bence. Kutsal Dağ'ın güneyinde harabe dolu büyük bir alan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420203
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420203,
					"content": "Uzun zaman önce ejderhalar tarafından terk edildiği söyleniyor. Yağmacı Hazine Avcılarını oradan uzak tutmak için İhtiyar Mposo her gün bölgede devriye gezer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420204
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420204,
					"content": "Eskiden harabeler ve yadigarlarla ilgileniyormuş. Hatta Sürüngen Kalıntıları Derneğine bile katılmış. Bize geçmişten hikayeler anlatmayı çok sever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420205
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420205,
					"content": "Ama hikaye anlatmakta pek iyi değil, çoook sıkıcı anlatıyor. Taşlardaki desenlerde \"kaygı uyandıran\" totemlerin görülebildiği gibi sıkıcı detaylar veriyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420206
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420206,
					"content": "Kaygı değildir, saygıdır o... İhtiyar Mposo bir hikayeciden ziyade arkeolog...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420207
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420207,
					"content": "Bir zamanlar yanardağı keşfetmiş hatta. Belki size yardım edebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Duniya"
				}
			]
		},
		{
			"id": 7514203,
