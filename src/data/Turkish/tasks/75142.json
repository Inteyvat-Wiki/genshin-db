			"dialogs": [
				{
					"id": 751420501,
					"content": "Kutsal Dağ'ın karnı ağrıyor galiba. Her gün bir şeyler kusuyor. Sen de gördün. Dışarı çıkıp oynayamayız, çok tehlikeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420502
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420502,
					"content": "Kimosi Amca'nın hikayelerinde yanardağın karnı ağrıyorsa birkaç defa karnı sevildiğinde hemen iyileşir... Keşke ellerim daha büyük olsaydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420503
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420503,
					"content": "Yetişkinler onu daha iyi sevebilir ama bizim kabile dışında oynamamızı istemiyorlar, o yüzden erteleyip duruyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420504
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420504,
					"content": "Haha, demek öyle düşünüyorsun! Bana kalırsa Kutsal Dağ o kadar büyük ki karın ağrısını geçirmek istiyorsak karnını tüm kabilenin sevmesi lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420505
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420505,
					"content": "Ama yetişkinlerin hepsi çok meşgul! Varesa'ya baksana, bütün gün meyve bahçesinde çalışıyor. Tüm yetişkinlerin boş vakti olmasını bekleyeceğiz mecbur, sonra gidip yanardağı hep beraber severiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420506
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420506,
					"content": "Hımm, güzel noktaya değindin bak. *iç çeker* O halde yetişkinleri bekleyeceğiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420507
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420507,
					"content": "O zamana kadar da onların kurallarına uyacağız ve Kutsal Dağ sakinleşene kadar kabileden dışarı çıkmayacağız, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420508
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420508,
					"content": "... Peki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420509
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420509,
					"content": "Siz ikiniz ne konuşuyorsunuz öyle? Paimon \"karın sevme\" falan duydu sanki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751420510,
					"content": "Biz... Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420511
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420511,
					"content": "Kabile sırlarından bahsediyorduk. Yabancıların öğrenmesi yasak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420512
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420512,
					"content": "Yanardağların karnını sevmek \"kabile sırrı\" mıymış?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751420513
					]
				},
				{
					"id": 751420513,
					"content": "N-Ne? Her şeyi duydunuz mu siz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420514
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420514,
					"content": "Çok yüksek sesle konuşuyordun! Bir dahaki sefere sırlardan konuşacak olursan kulağıma fısılda, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420515
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420515,
					"content": "Peki... *iç çeker* Ama öylesi biraz fazla yakın olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420516
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420516,
					"content": "Haha, keyfin bilir. Yabancı misafirler, benim adım Duniya. Bu bahtsız aptal da Dutse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420517
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420517,
					"content": "Bana aptal demeyi bırakır mısın lütfen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420518
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420518,
					"content": "Bereket Kolektifine hoş geldiniz! Küçük Tepetlizorunuz da hoş geldi... İlginç, kabileye Sürüngenlerin girmesini engelleyen runlar vardı aslında... Bunun Kutsal Dağ'ın kötü olmasıyla bir ilgisi olabilir mi acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420519
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420519,
					"content": "Hıh, runların da güzelce sevilmeye ihtiyacı var demek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420520
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420520,
					"content": "Senin kafana geçireceğim bir tane şimdi, göreceksin sevilmeyi! *iç çeker* Neyse ki kötü birilerine benzemiyorsunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420521
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420521,
					"content": "Neyse, buraya neden geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420522
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420522,
					"content": "Duniya ve Dutse'ye kendinizi tanıtıyorsunuz...\\nKutsal Dağ'a girmek istediğinizi söylüyorsunuz...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751420523
					]
				},
				{
					"id": 751420523,
					"content": "Kutsal Dağ'a mı girmek istiyorsunuz? Pek kolay olmayacak... Yetişkinler oranın çok tehlikeli olduğunu söylüyor, o yüzden bizim oraya gitmemiz yasak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420524
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420524,
					"content": "Ama sizin kendinizce sebepleriniz vardır eminim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420525
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420525,
					"content": "Hımm... İçeri girmenin bir yolunu bulan başka biri olmuştu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420526
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420526,
					"content": "B-Ben de! Ben de biliyorum birini!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420527
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420527,
					"content": "Kutsal Dağ sizin kabileniz için... Kutsal değil mi? Bize böyle her şeyi anlatmanız sorun olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420528
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751420528,
					"content": "\"Kutsal Dağ\" adı çok eski bir zamanda yapılmış dokuma parşömenlerden geliyor... Bizim için Kutsal Alev Stadyumu kadar kutsal bir yer değil ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420529
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420529,
					"content": "Sırf tehlikeli olduğu için girmemize izin vermiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420530
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420530,
					"content": "Hem Ateş Konseyi keşif ekipleri kurup içeriyi araştırmaya gönderdi... Hehe, yaşım gelir gelmez ben de gideceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420531
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420531,
					"content": "Sana daha kaç defa söyleyeceğim? Oraya gitmek tehlikeli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420532
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420532,
					"content": "Hımm... Detaylarını bilmiyorum ama isterseniz <color=#00E1FFFF>İhtiyar Mposo</color> ile konuşmayı deneyebilirsiniz. O size yardım eder eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420533
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420533,
					"content": "\"İşsiz İhtiyar Mposo\" mu? <color=#00E1FFFF>Kimosi</color> ile konuşsanız daha iyi olur. Hehe, Kimosi benim amcam. Eskiden bir maceracıymış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420534
					],
					"speakerTitle": "Dutse"
				},
				{
					"id": 751420534,
					"content": "İhtiyar Mposo'ya işsiz deme! Hımm... Biri <color=#00E1FFFF>dağın güneyindeki kazı alanında</color>, diğeri de <color=#00E1FFFF>köyün batısındaki Volkanik Harabelerde</color>...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420535
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420535,
					"content": "Size yolu göstermek isterdik ama Kutsal Dağ şu an patlama döngüsünde, sizi götürmemiz güvenli olmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420536
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420536,
					"content": "Sorun değil! Buradan yolu kendimiz bulabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420537
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751420537,
					"content": "#Gel {REALNAME[ID(2)|SHOWHOST(true)]}! Gidiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 751420538,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420539
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751420539,
					"content": "Hehe, çok tatlı ya! Kuyruğuna sarılı atkısı da çok güzel. Kutsal Dağ iyileştiğinde onu oyun oynamaya götürürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751420540
					],
					"speakerTitle": "Duniya"
				},
				{
					"id": 751420540,
					"content": "Olur! Ama Paimon da gelmek istiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
