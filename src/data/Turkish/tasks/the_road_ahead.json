			},
			"dialogs": [
				{
					"id": 750080101,
					"content": "Manqu, geri döndük!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080102,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080103
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080103,
					"content": "Çok uzun bir bekleyiş oldu. İtiraf edeyim, bekledikçe endişelendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080104
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080104,
					"content": "Bunun en başta benim fikrim olduğu doğru ama harabelere gidip bir daha geri dönmeseydiniz kendimi asla affedemezdim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080105
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080105,
					"content": "Doğrudan sorduğum için kusura bakmayın ama öğrenmem gerek. Harabelerde Alev Çalan Bilge'nin nişanını buldunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080106,
						750080107
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080106,
					"content": "Epey zor oldu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				},
				{
					"id": 750080108,
					"content": "Haha, başaracağınızı biliyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080109
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080109,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080110,
					"content": "Bak, meğer böyle tuhaf bir zımbırtıymış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080111,
					"content": "Hayır, olamaz... Altın Ahit mi? Altın Ahitler gerçek miymiş? İnanılmaz! Bunu mutlaka araştırmama dahil etmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080112
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080112,
					"content": "Demek bu şeyin adı Altın Ahit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080113,
					"content": "D-Doğru. Kusura bakmayın, çok heyecanlandım. Bir zamanlar bunu bizzat Alev Çalan Bilge'nin kullandığı söylenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080114
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080114,
					"content": "Bir anlığına bunu bir aile yadigarı olarak saklasam mı diye düşündüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080115
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080115,
					"content": "#Olmaz! {REALNAME[ID(2)|SHOWHOST(true)]} bunun sayesinde kurtulacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080116,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080117,
					"content": "Biliyorum... Fakat nişanların nerede olduğuna dair hiçbir fikrim yok. Diğerinin nerede olduğuna dair en ufak bir ipucu yok elimde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080118
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080118,
					"content": "Ochkanatlan...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080119
					]
				},
				{
					"id": 750080119,
					"content": "#Hı? Pardon {NICKNAME}, fakat az önce \"Ochkanatlan\" mı dedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080120
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080120,
					"content": "(Taş tablete dokunduğunda gördüklerini anlat...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080121
					]
				},
				{
					"id": 750080121,
					"content": "Vay be, Ochkanatlan olacağını kim tahmin ederdi... Çiçek Tüyü Klanının kuzeyindeki bir su kıyısının yanında bulunan kadim şehrin harabeleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080122
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080122,
					"content": "Eğer oradaysa üzgünüm fakat size yardımcı olamam. Oraya gitmemi sadece kabilem değil Sürüngen Kalıntıları Derneği de yasaklıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080123
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080123,
					"content": "Söylenenlere göre bundan yaklaşık yıllar önce, bazı dernek üyeleri orayı araştırmak için bir görev almış. Yola çıktıktan sonra arkalarında hiçbir iz bırakmadan ortadan kaybolmuşlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080124
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080124,
					"content": "O günden beri dernek, Ochkanatlan ile ilgili her şeyden uzak durmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080125
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080125,
					"content": "Sorun değil, bize yeterince bilgi verdin zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080126,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080127,
					"content": "İkinize tekrar teşekkür ederim. Bir Altın Ahit görmenin benim için ne anlama geldiğini bilemezsiniz. Bu arada hemen gidip bunları kaydetsem iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080128
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080128,
					"content": "#Teşekkürler {NICKNAME}, Paimon. Size iyi yolculuklar diliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080129
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080129,
					"content": "#Ve sen {REALNAME[ID(2)|SHOWHOST(true)]}. Umarım Alevlerin Efendisi'nin Lütfundan başarıyla kurtulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080130
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080130,
					"content": "Hoşça kal!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080131
					]
				},
				{
					"id": 750080131,
					"content": "... Yolculuğun sonunda, tüm ruhların dinlenmeye geldiği yerde yeniden buluşacağız. Bundan eminim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080107,
					"content": "Tereyağından kıl çeker gibiydi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750080108
					]
				}
			]
		},
