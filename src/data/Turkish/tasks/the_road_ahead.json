				},
				{
					"id": 750080210,
					"content": "Bak, meğer böyle tuhaf zımbırtılarmış! İkisini de bulduk bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080211,
					"content": "Hayır, olamaz... İki tane Altın Ahit mi? Altın Ahitler gerçek miymiş? İnanılmaz! Bunu mutlaka araştırmama dahil etmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080212
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080212,
					"content": "Demek Altın Ahit diye bunlara deniyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080213,
					"content": "D-Doğru. Kusura bakmayın, çok heyecanlandım. Bir zamanlar bunları bizzat efsanevi Alev Çalan Bilge'nin, hatta ilk Ateş Hükümdarı'nın kullandığı söylenir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080214
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080214,
					"content": "Bir anlığına bunları bir aile yadigarı olarak saklasam mı diye düşündüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080215
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080215,
					"content": "#Olmaz! {REALNAME[ID(2)|SHOWHOST(true)]} bunlar sayesinde kurtulacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750080216,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080217
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750080217,
					"content": "Biliyorum... Pekala, sanırım artık Büyük Tollan Yanardağı'na doğru yola çıkmanız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080218
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080218,
					"content": "Efsaneye göre Xbalanque uzun zaman önce, Ateş Hükümdarı olmadan evvel, kör edici ışık ve yakıcı ateşi kuşanan Alevlerin Efendisi ile orada çarpışmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080219
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080219,
					"content": "Çarpışma sona erip etraf sakinleştiğinde muzaffer kahraman Xbalanque hayatta kalmış ve geri döndüğünde Ateş Hükümdarı olmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080220
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080220,
					"content": "Yanardağın içinde neler olduğuna dair kimsenin bir fikri yok. Bazıları kadim bir ejderhanın hâlâ orada uykuda olduğuna inanır. Bazılarıysa oranın bir kabuktan ibaret olduğunu, içindeki her şeyin Xbalanque'nin alevleriyle yok olduğunu söyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080221
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080221,
					"content": "Bana sorarsan bunlar hikayecilerin varsayımlarından ibaret...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080222
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080222,
					"content": "Sizinle gitmeyi çok isterdim ama sanırım bu, zavallı yaşlı bedenimden çok fazla şey istemek olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750080223
					],
					"speakerTitle": "Manqu"
				},
				{
					"id": 750080223,
