					]
				},
				{
					"id": 730091002,
					"content": "Enerji dolu bir meyvedir. Dünya üzerindeki hatıralarda ve rüyalarda yetişir. Meyve vermesi için Aranaraların ve Naraların yardımına ihtiyacı vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091003
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091003,
					"content": "Ashvattha Ağacına bir Vasoma Meyvesi vererek Bija elde edebiliriz. Ashvattha Ağacı, Mahadevi Rukkhadevata tarafından ekilen yüce bir ağaçtır. Tüm Aranaralar o ağaçtan gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
