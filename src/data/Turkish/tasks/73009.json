			"dialogs": [
				{
					"id": 730090801,
					"content": "Utsava Festivali için yapılacak başka bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090802
					]
				},
				{
					"id": 730090802,
					"content": "Utsava deyince aklıma geldi, Arakavi de Vanarana'nın merkezinde olmalı. Sanırım onun da Utsava Festivali hazırlıkları için yardıma ihtiyacı vardı.",
					"roleType": "TALK_ROLE_NPC",
