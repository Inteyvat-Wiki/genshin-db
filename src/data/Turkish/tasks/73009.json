			"dialogs": [
				{
					"id": 730090901,
					"content": "\"Marana\"ya gelince...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090902
					]
				},
				{
					"id": 730090902,
					"content": "Bu çok uzun zaman öncesinden bir hikaye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090903
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090903,
					"content": "Çok uzun zaman önce Aranaralar yeryüzünde dolaşır, tüm Naralarla ve canlılarla dostça yaşarmış. O zamanlar henüz Marana diye bir şey yokmuş, ta ki bir gün bir felaket yaşanana kadar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090904
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090904,
					"content": "Mahadevi Rukkhadevata, Sarva'ya dönmüş ve Marananın öfkesi dünyaya yayılmaya başlamış. Orman, nihayet sağlığına kavuşunca kendilerini korumak isteyen Aranaralar gerçek Vanarana'yı bir rüyanın içine saklamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090905
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090905,
					"content": "Orman ölüm nedir bilmezmiş fakat gün gelmiş, ağaçlar dünyanın solan çiçeklerle ve ölü hayvanlarla kaplandığını fark etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090906
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090906,
					"content": "Aynı gün dünya, yok ettiği ya da yok etmek üzere olduğu koyu, zehirli kanı hatırladı. Nehirler, güneşin alçalıp tüm suyu buharlaştırdığını ve geride kırmızı bir dünya bıraktığını düşündü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090907
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090907,
					"content": "Meğer her şeyin bir sonu varmış diye düşünmüşler. Böylece Marana doğmuş. İşte o yüzden Marana ölümün adıdır ve onunla tanışanlar ölmeye mahkumdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090908
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090908,
					"content": "Marana her şeyi ölümüyle buluşturur. O uzun, karanlık ve kötü varlıklar Marananın cisimleri ve ölümün habercisidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090909
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090909,
					"content": "Tabii hikayede Marananın Cismi farklı biçimlere bürünür. Bazen bir canavar olur, bazen bir kuş. Bazen bir Nara olur, bazense bir felaket...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090910
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730090910,
					"content": "Tabii nihayetinde bunlar sadece birer hikaye. Benim anılarım değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
		},
