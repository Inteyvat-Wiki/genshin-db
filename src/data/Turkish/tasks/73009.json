			"dialogs": [
				{
					"id": 730091401,
					"content": "Marana hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730091402
					]
				},
				{
					"id": 730091402,
					"content": "Bu çok uzun zaman öncesinden bir hikaye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091403
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091403,
					"content": "Çok uzun zaman önce Aranaralar yeryüzünde dolaşır, tüm Naralar ve canlılarla dostça yaşarmış. O zamanlar henüz Marana diye bir şey yokmuş, ta ki bir gün bir felaket yaşanana kadar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091404
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091404,
					"content": "Birçoğu Sarva'ya geri dönmüş ve Marananın öfkesi dünyaya yayılmaya başlamış. Orman nihayet sağlığına kavuşunca kendilerini korumak isteyen Aranaralar gerçek Vanarana'yı bir rüyanın içine saklamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091405
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091405,
					"content": "Orman ölüm nedir bilmezmiş fakat gün gelmiş ve ağaçlar, dünyanın solan çiçeklerle ve ölü hayvanlarla kaplandığını fark etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091406
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091406,
					"content": "Aynı gün toprak, bir zamanlar yuttuğu veya yutmak üzere olduğu o karanlık, zehirli kanı hatırlamış. Nehirler, tüm suyu buharlaştıran ve ardında kızıl bir dünya bırakan o güneşin doğuşunu hayal etmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091407
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091407,
					"content": "Meğer her şeyin bir sonu varmış diye düşünmüşler. Böylece Marana doğmuş. İşte o yüzden, Marana ölümün adıdır ve onunla tanışanlar ölmeye mahkumdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091408
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091408,
					"content": "Marana, her şeyi ölümle buluşturur. O uzun, karanlık ve kötü varlıklar, Marananın cisimleri ve ölümün habercisidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091409
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091409,
					"content": "Tabii hikayelerimde Marananın Cismi birçok biçime bürünür. Bazen bir canavar olur, bazen bir kuş. Bazen bir Nara olur, bazense bir felaket...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091410
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091410,
					"content": "Nihayetinde bunlar sadece hikaye. Benim anılarım değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Araja"
				}
			]
