			"dialogs": [
				{
					"id": 730090301,
					"content": "(Rana hâlâ uyuyor. Arana da ortalıkta yok.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090302
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090302,
					"content": "(Rana'yı saran baloncukta bulanık bir görüntü belirir.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090303,
						730090307
					],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090303,
					"content": "(O görüntüye dalıp gidersin...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090304
					]
				},
				{
					"id": 730090304,
					"content": "Bir ormandasın. Her şey alabildiğine devasa ve sakin duruyor. Burada çok rahat hissediyorsun.\\nParıldayan, altın rengi yaprakların arasından güneş ışığı sızıyor. Her tarafta senin boyunda çimler savruluyor ve sen yürürken hafifçe elini okşuyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090305
					]
				},
				{
					"id": 730090305,
					"content": "Ağaçların arasından esen rüzgarla akan suyun müziğe benzeyen melodisinin arasında hüzünlü bir feryat duyuyorsun. Sesi takip edince küçük bir kız buluyorsun.\\nAğlamaktan bitkin düşmüş ve çimlerin üzerinde uyumuş. Ona yaklaşıp kısık sesle, tüm varlıkları sakinleştirebilen bir şarkıyı söylüyorsun...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730090306
					]
				},
				{
					"id": 730090306,
					"content": "(Rana'nın durumu sanki kötüleşiyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rana"
				},
				{
					"id": 730090307,
					"content": "(Sessizce ayrıl.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
