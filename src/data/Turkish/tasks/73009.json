				"points": []
			},
			"dialogs": [
				{
					"id": 730090101,
					"content": "Arana onunla ilgilenir, onun çok sevdiği bir dostudur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090102
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090102,
					"content": "#Nara {NICKNAME}, lütfen Vanarana'ya gidip Büyük Hayalin Melodisini söyle. Sonra oradakilerden Bijayı hazırlamak için yardım iste.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090103,
						730090104
					],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090103,
					"content": "Nasıl yani? Tam anlayamadım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090106
					]
				},
				{
					"id": 730090106,
					"content": "Tıpkı yağmuru yağdıran bulutların, toprağa karışan yağmurun ve büyük birer ağaç olup bir sürü kocaman meyve veren tohumların bildiği gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arana"
				},
				{
					"id": 730090104,
					"content": "Ta-Tamam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730090105
					]
				},
				{
					"id": 730090105,
					"content": "#Nara {NICKNAME}, sanırım tam anlayamadın. Sorun değil. Doğru vakit geldiğinde Nara {NICKNAME} ne yapması gerektiğini bilecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730090106
					],
					"speakerTitle": "Arana"
				}
			]
		},
