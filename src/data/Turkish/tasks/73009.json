			},
			"dialogs": [
				{
					"id": 730091301,
					"content": "Sana Utsava Festivali hazırlıkları için ne kadar teşekkür etsem az!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091302
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091302,
					"content": "Ne yazık ki ne Arama ve diğerleri gibi maceralarına katılabildim ne de herhangi bir yardımım dokundu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730091303
					],
					"speakerTitle": "Araja"
				},
				{
					"id": 730091303,
					"content": "Ayrıca maceralarında yorgun düşersen Vanarana'ya gelebilirsin. Bu rüyada her zaman hoş karşılanırsın.",
					"roleType": "TALK_ROLE_NPC",
