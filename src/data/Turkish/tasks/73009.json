						730091102
					]
				},
				{
					"id": 730091102,
					"content": "Zamanında Nara Varuna'ya aitti. Kendisi bir altın Naraydı ve oldukça kibar, cesur ve dürüsttü... Tıpkı senin gibi.",
					"roleType": "TALK_ROLE_NPC",
