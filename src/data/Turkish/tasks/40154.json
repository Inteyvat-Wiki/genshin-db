			"dialogs": [
				{
					"id": 401540101,
					"content": "İksir dükkanını işletmeye devam ediyorsunuz. Sıkı çalışmanız sayesinde beklenenden çok daha fazlasını kazanıyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401540102
					]
				},
				{
					"id": 401540102,
					"content": "Hakkınızı vermeliyim canlarım. Böyle kısa sürede bu kadar çok Mora kazanabileceğinizi düşünmemiştim asla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540103
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540103,
					"content": "İş konusunda resmen bir dahisiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540104,
						401540107
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540104,
					"content": "Hepsi senin yardımların sayesinde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540105
					]
				},
				{
					"id": 401540105,
					"content": "Hehe, her daim de mütevazısın bakıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540106
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540106,
					"content": "Açıkçası böyle etkileyici sonuçlardan sonra daha fazla övgüyü hak ediyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540109,
					"content": "Siz bana hep böyle yardım edecek olsanız eminim hiçbir şey için endişelenmeme gerek kalmadan iki kat fazla tatil yapabilirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540110
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540110,
					"content": "Şu ana kadarki sıkı çalışmanız sayesinde araştırmamız için gerekli olan satış verisini çoktan topladık. İkinize de yardımlarınız için çok teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540111
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540111,
					"content": "Tabii dükkanı işletmeye devam etmek isterseniz de çok mutlu olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540112
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540112,
					"content": "Her halükarda Jean'e ileteceğim rapor için fazlasıyla bilgi var elimde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540113
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540113,
					"content": "#{NICKNAME}, Paimon, uzun zamandır görüşemiyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540114
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540114,
					"content": "Jean!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 401540115,
					"content": "Hah, geldin mi? Ben de canlarımla bazı işleri hallettim, şimdi sana raporu iletmek üzere karargaha gelecektim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540116
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540116,
					"content": "Gerek kalmadı. Diğer şövalyelerle konuştum ve durumu gayet iyi anladığımı düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540117
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540117,
					"content": "#Demek yine {NICKNAME} sana yardım etsin diye ricada bulundun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540118
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540118,
					"content": "Hehe, nasıl bulunmayayım ama? Söz konusu böyle önemli bir iş olunca hem akıllı hem yetenekli bir ortak olmazsa olmaz. Özellikle de iyi sonuçlar görmek istiyorsak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540119
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540119,
					"content": "Şu dükkanın başarısına baksana! Tek başıma asla böyle bir sonuç elde edemezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540120
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540120,
					"content": "Kabul etmeliyim ki başarınız gerçekten takdire şayan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540121
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540121,
					"content": "Aslında bir süredir gelip sizi görmeyi planlıyordum ama işler bitmek bilmeyince bir türlü vakit bulamadım... Ancak gelip size bizzat teşekkür etmesem olmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540122,
						401540123
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540122,
					"content": "Desteğin için biz de sana teşekkür etmeliyiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540124,
					"content": "Aramızda böyle seçkin şövalyeler olduğunu bilmek sahiden güven verici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540125
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540125,
					"content": "Hehe, şu işlerimiz bitince bana bir tatil yolu göründü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540126
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540126,
					"content": "Tüm bu stres yüzünden saçlarım dökülmeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540127
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540127,
					"content": "Tabii ki. Emeğine sağlık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540128
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540128,
					"content": "Tüm gün kütüphanede oturduğunu görünce sıkılmışsındır diye düşündüm. Yeteneklerini gerçekten kullanabileceğin bir fırsat vermek istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540129
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540129,
					"content": "Bir anda üzerinde çok fazla baskı yaratmış olabilirim tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540130
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540130,
					"content": "#O kadar da kötü değildi aslında. Sonuçta yalnız değildim bu işte. {NICKNAME} ve Şövalyelerin yardımları sayesinde yüküm epey hafifledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540131
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540131,
					"content": "Ayrıca araştırma yapmaya dönmek de çok eğlenceliydi. Arada bir o günleri tekrar yaşamak güzel oluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540132
					],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540132,
					"content": "Bunu duyduğuma sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540133
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540133,
					"content": "#{NICKNAME}, tüm yardımların için tekrar çok teşekkürler. Lütfen karşılık olarak bu ödemeyi kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540134
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 401540134,
					"content": "Ödeme demişken, ben de hatıra olsun diye küçük bir şey hazırlamıştım. Umarım beğenirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lisa"
				},
				{
					"id": 401540123,
					"content": "Ne yaptıysak birlikte yaptık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540107,
					"content": "İşi yaparken öğrendik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540108
					]
				},
				{
					"id": 401540108,
					"content": "Hım, öğrenme kabiliyetinizin bir kanıtıdır işte bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "Lisa"
				}
			]
		}
	]
}