			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awan",
					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280401,
					"content": "Yasmin? Burada ne yapıyorsun? Off... Yine o iksiri sıkmak için mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280402
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280402,
					"content": "Bu kökler gayet iyi görünüyor. Burada iksir kullanmaya gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280403
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280403,
					"content": "Yine de onlarla ilgilenmemiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280404
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280404,
					"content": "Bir sorunun çözümünü o sorunla karşılaşıncaya kadar düşünmemek Balık Dürüm yaparken balığı pişirmediğini fark etmeye benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280405
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280405,
					"content": "Bu noktada iki seçeneğin kalır, ya en baştan başlayacaksın ya da sardığın dürümlerin içini açacaksın. İkisi de birbirinden sinir bozucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280406
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280406,
					"content": "Tamam tamam, seni bir tartışmada yenebilmek mümkün değil. Ama iksirin kokusu hakkında seni uyarmıştım, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280407
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280407,
					"content": "Yakınlarda bir yerde yaşıyorum ve burnuma bu kötü koku gelirken uyumak istemiyorum, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280408
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280408,
					"content": "Merak etme, Ladep formül üzerinde yeniden çalışmaya başladı bile. Koku artık bu kadar rahatsız edici olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280409
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280409,
					"content": "Tamam o halde, ben gidiyorum. O sıktığın iksiri benim bahçeme sakın yaklaştırma. Buna dayanamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280410
					],
					"speakerTitle": "Awan"
				},
				{
					"id": 230280410,
					"content": "Tamam, anladım. Bana şuradaki iksirleri uzatabilir misin Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280411
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280411,
					"content": "Yasmin ile birlikte iksirleri uyguluyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230280412
					]
				},
				{
					"id": 230280412,
					"content": "İksirler gerçekten de çok kötü kokuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 230280413,
					"content": "Ama sen bundan hiç rahatsız olmuyor gibisin Yasmin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280414
					]
				},
				{
					"id": 230280414,
					"content": "Kokudan bahsediyorsan... Çok daha kötü şeyler kokladığım olmuştu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280415
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280415,
					"content": "Pekala, tüm yapmamız gereken buydu. Ayrıca bazı veriler de topladım. Eminim Pharez çok heyecanlanacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280416
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280416,
					"content": "İşte ödemen Gezgin, tüm yardımların için çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280417
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280417,
					"content": "Bakalım Ladep ve Pharez'in çalışmaları nasıl gidiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				}
			]
		},
