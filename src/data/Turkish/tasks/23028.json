					"Yasmin"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230280101,
					"content": "Gezgin! İyi ki geldin. Ben de bana yardım edecek birini arıyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280102
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280102,
					"content": "Kutsal Ağacın köklerinde bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280103
					]
				},
				{
					"id": 230280103,
					"content": "Hayır, Kutsal Ağaç gayet iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280104
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280104,
					"content": "Benim işim de onun iyi kalmasını sağlamak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280105
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280105,
					"content": "Daha fazla detay vermem gerekirse bu iksirleri ağacın köklerine sıkıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280106
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280106,
					"content": "Maalesef tüm bu iksirleri tek başıma taşıyamam, Ladep ve Pharez de kendi işleriyle meşguller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280107
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280107,
					"content": "Bu yüzden iksirleri taşımak için yardımına ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280108,
						230280112
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280108,
					"content": "Ladep ve Pharez mi? Onlar kimdi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280109
					]
				},
				{
					"id": 230280109,
					"content": "Onlar da benim gibi öğrenci. Ladep Spantamad'da, Pharez ise Kshahrewar'da okuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280110
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280110,
					"content": "Ortak bir konuyu araştırıyoruz, bu yüzden farklı görüşlerimize aldırmadan iş birliği yapıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280111
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280111,
					"content": "Mesela bu iksirler takım çalışmamızın ürünü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280113
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280113,
					"content": "Tamam, bunu ben taşıyacağım, kalanını da sana bırakıyorum. Teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280114
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280114,
					"content": "Dikkatli ol. Ladep bu iksirlerin kimse içmesin diye bilinçli olarak rahatsız edici bir kokuyla yapıldığını söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230280115
					],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280115,
					"content": "Giysine de bulaşmasın... Kokusu çok zor geçiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yasmin"
				},
				{
					"id": 230280112,
					"content": "Pekala, hadi gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230280113
					]
				}
			]
		},
		{
			"id": 2302804,
			"completionStepIds": [
				2302804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
