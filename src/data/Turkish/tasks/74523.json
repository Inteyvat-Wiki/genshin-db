			"dialogs": [
				{
					"id": 745230401,
					"content": "Buradaki rüzgar deniz tuzu ve uzaktaki tüccar gemilerinin ahşap kokusunu taşıyor... Ve eski dostlardan haberler getiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230402
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230402,
					"content": "#İyi misin {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230403,
						745230404
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230403,
					"content": "Uzun zaman oldu Kazuha.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				},
				{
					"id": 745230405,
					"content": "Güneyhaçı şu anda ikmal için Inazuma'da demirlemiş durumda. Bu nadir fırsatı değerlendirerek memleketimi ziyaret etmeye, manzaralarını ve seslerini içime çekmeye, esen rüzgarı dinlemeye karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230406
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230406,
					"content": "Ritou'da rüzgarlar daima başka yerlerdekilerden daha gürültülüdür. Ayrılıklar, kavuşmalar, umut ve kafa karışıklığı iç içe geçmiştir... Burası sayısız hikayenin duyulduğu bir yerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230407,
						745230408
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230407,
					"content": "Bir fotoğrafını çekebilir miyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230409,
					"content": "Hehe. Bu dünyadaki her şeyin bir biçimi vardır; tıpkı rüzgarın düşen yapraklarda, yükselen dalgalarda veya bir gezginin kıyafetlerinin dalgalandığı o anda kendini göstermesi gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230410
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230410,
					"content": "Umarım varlığım, bu geçici gücü şekillendirmene yardımcı olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745230411,
						745230412
					],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230411,
					"content": "Hadi başlayalım o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230413,
					"content": "Madem öyle, bu anı en iyi anlatan mısrayı sen yaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaedehara Kazuha"
				},
				{
					"id": 745230412,
					"content": "Az önce olduğun gibi kal ve rüzgarı hisset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230413
					]
				},
				{
					"id": 745230408,
					"content": "Şu anda esen rüzgarı da yakalamak istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230409
					]
				},
				{
					"id": 745230404,
					"content": "Seni hangi rüzgar attı buraya?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745230405
					]
				}
			]
		}
	]
