			},
			"dialogs": [
				{
					"id": 722490301,
					"content": "Adım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490302
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490302,
					"content": "Aberaku, Sahte Güneşin Mucidi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490303
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490303,
					"content": "Sahte Güneş mi, o ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490304,
					"content": "Etkilenmemiz mi gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490305,
					"content": "Hem de çok! Derinliklerin Ejdervarisi'ne karşı gelebilelim diye Sahte Güneşin inşasını düzenleyen kişi, arkasına bütün bir ulusun gücünü almış olan bendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490306
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490306,
					"content": "Byakuyakoku'da bu eşi benzeri görülmemiş işi yapacak kudrette kimse yoktu... Benden başka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490307
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490307,
					"content": "Vay. Cidden etkilenmemiz gerekiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490308,
					"content": "İyi de neden bu kadar büyük bir insan burada kapalı tutulsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490309,
					"content": "Ben... İhanete uğradım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490310
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490310,
					"content": "Gökyüzü krallığı sonsuz derinliklerle çarpıştığında insanlar ejderler tarafından cezalandırıldı. İnsanlığı bu kaderden kurtarması için Sahte Güneş inşasına başladım. Evet, ben başladım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490311
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490311,
					"content": "O doyumsuz hilekarlar yok mu! Hayatları kurtulduğu an, hemen yalan söylemeye ve insanları kandırmaya başladılar. Yetmezmiş gibi küçücük çocukların tahta geçmesini desteklediler. İnanılmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490312
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490312,
					"content": "Ben bile dalaverelerinin hedefi oldum, hapiste çürümeye bıraktılar beni!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490313
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490313,
					"content": "Nefret ediyorum onlardan! Lanet olasıcalar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490314
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490314,
					"content": "Doğru. Sen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490315,
						722490317
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490315,
					"content": "Ben mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490316
					]
				},
				{
					"id": 722490316,
					"content": "Evet, sen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490320,
					"content": "Yalnızca sen olabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490321
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490321,
					"content": "Kutsal cübbem bir zamanlar buradaydı. Tabii geçen bunca yıldan sonra çürüdü ve artık işimize yaramaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490322
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490322,
					"content": "Ama sen testi geçersen bütün hatıralarımı aktardığım adakları sana verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490323
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490323,
					"content": "Başarman için... Dua ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490324
					],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490324,
					"content": "Bu görev çok riskli. Ey Gezgin, hazır olduğunda haber ver bana ki başlayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aberaku"
				},
				{
					"id": 722490317,
					"content": "Paimon, bu ruh sanırım seninle konuşuyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722490318
					]
				},
				{
					"id": 722490318,
					"content": "Yok canım, besbelli sana bakıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722490319,
					"content": "(Hem de çok heyecanlı bir şekilde.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722490320
					],
					"speakerTitle": "Paimon"
				}
			]
		},
