			"dialogs": [
				{
					"id": 747060101,
					"content": "Hımm... Peki ya bu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060102
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747060102,
					"content": "Hımm, hâlâ bir şeyler eksikmiş gibi hissediyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060103
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060103,
					"content": "Columbina? Furina? Siz ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060104,
					"content": "Yönetmen Furina ve ben... \"Oyuncu seçmesi\" yapıyoruz galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060105
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747060105,
					"content": "Ne harika bir tabir! Ancak aradığımız \"oyuncular\"... Birer balık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060106
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060106,
					"content": "... Balıklar \"oyuncu\" olabiliyor muymuş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060107,
					"content": "Bugünlerde hayvan oyunculara sık rastlanıyor aslında. Biz de bazı ek görüntülerde şöyle aradığımız havada, karizmatik bir balığa rol vermek istiyoruz... İstediğimiz atmosferi yakalamak için olmazsa olmaz bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060108,
					"content": "Ama akvaryumdaki tüm balıkları gördük ve hiçbiri tam olarak aklımızdakiyle uyuşmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060109
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060109,
					"content": "#{NICKNAME} ve Paimon'dan yardım mı istesek? Karmaşık sorunları çözmekte üstlerine yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060110
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747060110,
					"content": "Bize bu kadar güvenmen Paimon'u çok mutlu etti... Ama balıkları oyuncu seçmelerine sokma konusu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060111,
						747060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060111,
					"content": "Birkaç \"aday\" daha toplamayı mı denesek?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				},
				{
					"id": 747060113,
					"content": "Harika bir fikir! Akvaryum yönetimi tecrübesi olanlar sizsiniz tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060114
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060114,
					"content": "Yani yüzmeye her gittiğimizde gözümüzü dört açıp yetenek avına çıkacağız, öyle mi? Paimon'a uyar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060115,
					"content": "O zaman anlaştık! Nasıl bir hava aradığımızı daha sonra anlatırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060116
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 747060116,
					"content": "Sanırım artık \"yetenek avcısı\" oldunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747060117
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 747060117,
					"content": "Furina ile takılmaya başladığından beri gösteri dünyası jargonunu iyice kapmışsın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747060112,
					"content": "Hatta seçmeleri direkt su altında mı yapsak?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747060113
					]
				}
			]
		}
	]
