			"dialogs": [
				{
					"id": 220470401,
					"content": "Her zamanki gibi çok beceriklisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470402
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470402,
					"content": "Umarım dikkatle izlemişsindir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470403
					]
				},
				{
					"id": 220470403,
					"content": "İzledim tabii! Tutuşundan çekişine kadar her bir anı dikkatle izledim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470404
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470404,
					"content": "Nasıl desem ki? Sanki seni izledikçe becerilerini daha iyi kavradığımı düşünüyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470405
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470405,
					"content": "Neyse, şimdilik bunları geçelim. Lütfen bunları emeğinin karşılığı olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470406
					],
					"speakerTitle": "Shouji"
				},
				{
					"id": 220470406,
					"content": "Şimdi sıra bende. En az on hedeften yedisini vurmaya çalışayım, olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shouji"
				}
