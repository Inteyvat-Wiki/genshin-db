				"points": []
			},
			"dialogs": [
				{
					"id": 721200101,
					"content": "Harika! Testler gayet iyi gitti. Hayalet Böcekler tamamen arındırıldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200102
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200102,
					"content": "O zaman...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200103
					]
				},
				{
					"id": 721200103,
					"content": "Şimdi yapmamız gereken tek şey içeri nasıl gireceğimizi planlamak. Sonrasında hemen başlayabiliriz. Fakat Fatui ile karşı karşıya gelmemeliyiz... Uzun yoldan gideceğiz gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200104
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200104,
					"content": "Bu oldukça ağır, o yüzden içeri taşırken gideceğimiz yolların düzgün olduğundan emin olsak iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200105
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200105,
					"content": "O yüzden araştırma yapmak için Mikage Ocağı'na tekrar girmeni istiyorum. Bozuk yollarla karşılaşırsan lütfen biraz düzeltmeye çalış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200106
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200106,
					"content": "Henüz rotamıza karar vermedim ama birden fazla yol açık olursa kesinlikle iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200107
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200107,
					"content": "Yol düzeltmekten ben pek anlamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200108
					]
				},
				{
					"id": 721200108,
					"content": "Tamamen düzelt demiyorum zaten. Sadece bu cihazı taşıyabilmemiz için üzerine birkaç kalas yerleştirmen yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200109
					],
					"speakerTitle": "Xavier"
				},
				{
					"id": 721200109,
					"content": "Kalasları yakınlarda bulabilirsin. Ben burada kalıp makinayı olabildiğince güvenilir hale getirmeye çalışacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212002,
