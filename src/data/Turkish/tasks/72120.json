			"dialogs": [
				{
					"id": 721200201,
					"content": "Umarım her şey sorunsuz gider. Bu sorunu ne kadar erken çözebilirsek o kadar iyi. Biraz daha gecikirsek neler olacak kim bilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Xavier"
				}
			]
		},
		{
			"id": 7212003,
			"completionStepIds": [
				7212009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
