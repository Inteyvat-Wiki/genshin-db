			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20322,
						"position": [
							335.674,
							288.735,
							245.957
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 60030901,
					"content": "Hepiniz hoş geldiniz. Ben de sizi bekliyordum. Umarım mütevazı araştırma tesisim hoşunuza gitmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030902
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030902,
					"content": "Sorma, canavar sürüsüyle savaşa savaşa içeri girmek çok hoşumuza gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030903
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030903,
					"content": "Bu ne cüret! Sabırla bizi beklediğine inanmamızı mı bekliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030904
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030904,
					"content": "Neden beklemeyeyim? Endişelenmem gereken bir şey mi var yoksa? Şu ana kadar her şey gayet yolunda gitti, siz de tam zamanında geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030905
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030905,
					"content": "Önce Sandrone ve Arlecchino, şimdi de siz... Ah, bugün misafirim hiç bitmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030906
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030906,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030907
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030907,
					"content": "Eğer onları arıyorsanız Arlecchino'nun tesise girer girmez ortadan kaybolduğunu söyleyeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030908
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030908,
					"content": "Sandrone'ye gelince, daha az önce tam buradaydı ve avazı çıktığı kadar bağırarak benden cevap istiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030909
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030909,
					"content": "Kişiliğine pek de aykırı sayılmaz, zaten hiçbir zaman nazik biri olmamıştı. Ama itiraf etmeliyim ki kendisinden başka birini önemsediğini görmek beni biraz şaşırttı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030910
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030910,
					"content": "Sizinle ilişki kuran herkesin mizacı böyle değişiyor mu? Bir araştırmacı olarak konuşuyorum, bu hiç de iyiye işaret değil. Kişinin tarafsız kalma kabiliyetini törpülüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030911
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030911,
					"content": "Sandrone nerede?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030912
					]
				},
				{
					"id": 60030912,
					"content": "Madem sordun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030913
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030913,
					"content": "Ay İliğini ele geçirdin, şimdi de tanrılık mı iddia ediyorsun? Sence de bu biraz abartı değil mi Dottore?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030914
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 60030914,
					"content": "\"Tanrılık iddia etmek\" ifadesine itiraz etmek durumundayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030915
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030915,
					"content": "Bir şey \"iddia ettiğim\" yok, gerçeği belirtiyorum. Sen bir araştırmacısın. İkisi arasındaki ayrımı anlayacağına eminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030916
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030916,
					"content": "Ne? Bir dakika, gerçekten bunu başarabileceğini mi düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030917
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 60030917,
					"content": "Kusura bakma, kibarlığı bir kenara bırakıyorum. Biz meslektaşız, ikimiz de senin nasıl biri olduğunu biliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030918
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 60030918,
					"content": "Aynı sebepten ötürü ben de senin böyle bir yanıt vereceğini biliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030919
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030919,
					"content": "Sen de ben de gerçeklerin sözlerden daha önemli olduğunu biliyoruz. Bu nedenle astlarımla sana küçük bir hediye yolladım. Mevcut konumumu anlamana bir nebze yardımcı olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030920
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030920,
					"content": "Ne hediyesi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030921
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 60030921,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030922
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 60030922,
					"content": "Tüm birliklerin nereye gitti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030923
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 60030923,
					"content": "Kim bilir? Belki de çoktan bilinmeyen bir tanrının izinden yeni bir dünyaya doğru yürüyorlardır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030924
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030924,
					"content": "Ne kadar bayağı ve küstah olursan ol sevgili Sandrone, hoşnutsuzluğumun acısını astlarından çıkarma niyetinde değilim. Onlar da benimkilerle eşit haklara sahip olacaklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030925
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030925,
					"content": "Adamlarını Deneysel Tasarım Bürosuna mı yolladın? Orası Çariçe'nin mülkü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030926
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 60030926,
					"content": "Evet, Majestelerinin talimatlarının gayet farkındayım. Ama sen de gayet iyi biliyorsun ki bu talimatlar benim şu anki hedeflerimle çelişmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030927
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030927,
					"content": "Şu anda yalnızca her zamanki deneylerimden birini yapıyorum. Bunda bir sorun mu var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030928
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030928,
					"content": "Pekala. Artık bir karar vermen gerek. Seni oyalamak için yalan mı söylüyorum, yoksa söylediğim her şey doğru olabilir mi? Ki bu durumda astların gerçekten de tehlikede demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030929
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030929,
					"content": "Demek şimdi de diğer Fatui askerlerine sırtını döndün ha? Sen tamamen kafayı yemişsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030930
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 60030930,
					"content": "Kendime yeni bir kural koydum: Herkesin tek bir şansı var. Doğal olarak buna sen de dahilsin Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030931
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030931,
					"content": "Gitmek istiyorsan seni durdurmam. Ne de olsa meslektaşız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030932
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030932,
					"content": "... Alçak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030933
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 60030933,
					"content": "Yalnız Sandrone'nin bu dünyadaki insanları umursayacağını hesaba katmamıştım. Yazık... Bencilliğini hep onun en iyi özelliklerinden biri olarak görmüşümdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030934
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030934,
					"content": "Küçücük tasarım bürosunu korumaya bu kadar takıntılıyken nasıl büyük bir başarıya ulaşsın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030935
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030935,
					"content": "İnsanları rehin alırken ne büyüklüğünden bahsediyorsun? Hiç onurun da mı kalmadı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030936
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030936,
					"content": "Onur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030937
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030937,
					"content": "İki ayın iliği elimde ve yakında üçüncüsünün inşasını tamamlayacağım. Yeni bir dünyanın tanrısı olacağım... Bana onurdan mı bahsediyorsun? Ne kadar safsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030938
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030938,
					"content": "Onlar kutsal yadigarlar! Onları hak etmiyorsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030939
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030939,
					"content": "Bana göre bu dünyadaki çoğu kişi yaşamayı hak etmiyor. Yine de merhametli davranıp yaşamalarına müsaade ediyorum, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030940
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60030940,
					"content": "Yaptıklarından pişman olacaksın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030941
					]
				},
				{
					"id": 60030941,
					"content": "Öyle mi dersin? Göreceğiz bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Doktor"
				}
			]
		},
