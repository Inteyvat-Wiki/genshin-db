			"dialogs": [
				{
					"id": 60030101,
					"content": "Tüm ekip toplanmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030102,
					"content": "Evet, biz tamamız. Siz ne durumdasınız? Hazır mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030103
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030103,
					"content": "Paimon hazır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030104,
						60030106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030104,
					"content": "Ben de hazırım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030105
					]
				},
				{
					"id": 60030105,
					"content": "Harika. Hadi başlayalım o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030113
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030113,
					"content": "Süper. Öncelikle şunu söyleyeyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030114
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030114,
					"content": "Iı... Durun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030115
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60030115,
					"content": "Burada biri var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030116
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030116,
					"content": "Ayak seslerini duyduk. Gerçi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030117
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030117,
					"content": "#Bir süredir buradasın. {NICKNAME} gelirken onu takip etmişsindir diye tahmin ediyorum. Ancak sende kötü bir niyet sezmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030118
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030118,
					"content": "Göster kendini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030119
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030119,
					"content": "Beni hemen fark edeceğinizi tahmin ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030120
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Yaver'in Astı"
				},
				{
					"id": 60030120,
					"content": "Leydim Yaver'den haber getirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030121
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Yaver'in Astı"
				},
				{
					"id": 60030121,
					"content": "Dottore, Snezhnaya'ya dönüyormuş gibi yaptı ama bunun bir aldatmaca olduğu belliydi. Ancak ne Kuuvahki Deneysel Tasarım Bürosuna döndü ne de Nasha Kasabası'nda görüldü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030122
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60030122,
					"content": "Öyleyse kuzeydeki laboratuvarında olmalı. Hah, neden kendine özel bir yer istediğini hep merak etmiştim... Meğer en başından beri bunu planlıyormuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030123
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 60030123,
					"content": "Onlara Sandrone ile benim önden gideceğimizi söyle. Eğer hâlâ bu meselenin peşine düşmek niyetindelerse Nod-Krai'ın kuzey ucundaki araştırma merkezinde bizimle buluşsunlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030124
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60030124,
					"content": "Columbina'nın en iyi iki arkadaşının bizi düşünmesi ne hoş... Önceden haber verdiğiniz için sağ olun. Yardımlarınız için Fatui'ye en içten teşekkürlerimizi sunuyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030125
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030125,
					"content": "Küçük Hanım örgütümüzden ayrılmış olabilir ancak bazı meslektaşları hâlâ onun iyiliği için gerçekten endişeleniyor... Üstelik Doktor'un giderek daha da gizemli bir hal alan davranışları bizi oldukça tedirgin ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030126
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Yaver'in Astı"
				},
				{
					"id": 60030126,
					"content": "Sizlerle daha önce birçok kez karşı karşıya kaldık ama kişisel bir derdimiz yoktu, yalnızca farklı taraflardaydık. İnsanlıktan yoksun değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030127
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Yaver'in Astı"
				},
				{
					"id": 60030127,
					"content": "Bu sebeple Küçük Hanım'ın dostları olarak sizin de bu konudan haberdar olmanız icap eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030128
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Yaver'in Astı"
				},
				{
					"id": 60030128,
					"content": "Arlecchino'nun farkındalığı bizi epey dertten kurtardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030129
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030129,
					"content": "Haritayı size bırakıyorum. Araştırma merkezine gitmeye karar verirseniz lütfen dikkatli olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030130
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Yaver'in Astı"
				},
				{
					"id": 60030130,
					"content": "Unutmayın, en azından Nod-Krai'da bulunduğunuz süre boyunca Leydi Arlecchino'nun astlarını kendi yoldaşlarınız olarak görebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030131
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Yaver'in Astı"
				},
				{
					"id": 60030131,
					"content": "Çok düşüncelisiniz. Size ne kadar teşekkür etsek az.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030132
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030132,
					"content": "Ben sadece görevimi yapıyorum. Şimdi gitmem lazım. Bize ihtiyacınız olursa Deneysel Tasarım Bürosunda olacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030133
					],
					"speakerTitle": "Gediminas",
					"speakerSubtitle": "Yaver'in Astı"
				},
				{
					"id": 60030133,
					"content": "Demek Doktor, Deneysel Tasarım Bürosundan ayrılıp kuzeydeki bir araştırma merkezine gitmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030134,
					"content": "Kukla'ya göre bunu uzun zamandır planlıyormuş... Ama acaba ne zaman başladı? Daha Nod-Krai'a bile gelmeden mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030135
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030135,
					"content": "Çariçe'ye olan sadakati tamamen lafta. El altından onun aleyhine işler çeviriyor olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030136
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030136,
					"content": "Niyeti ne olursa olsun, kararlı ve son derece acımasız olduğunu biliyoruz. Onunla hazırlıksız yüzleşmek tam bir felaket olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030137
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030137,
					"content": "Şu noktada bir sonraki adımını tahmin etmek zor. İki gruba ayrılmamızı öneriyorum. Birkaç kişinin geride kalıp Nasha Kasabası'nı koruması gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030138
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030138,
					"content": "Hımm... Her ne kadar yardım etmek istesem de araştırma laboratuvarlarına sızmak uzmanlık alanım sayılmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030152
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60030152,
					"content": "En azından Sakin Ol Şampiyon Ördeği yanınıza alın! Savaşta işinize yarayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030139
					],
					"speakerTitle": "Aino"
				},
				{
					"id": 60030139,
					"content": "Bayan Ineffa'ya gelince... Sanırım siz de Bayan Aino'yu korumak için burada kalacaksınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030140
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030140,
					"content": "Eylem mantığı tespit edildi: Aino'yu koru. Öncelik: Yüksek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030141
					],
					"speakerTitle": "Ineffa"
				},
				{
					"id": 60030141,
					"content": "Her ihtimale karşı siz de burada kalsanız iyi olur Bay Varka. Araştırma merkeziyle biz ilgileniriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030142
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030142,
					"content": "Bana kalırsa Poyraz Şövalyesinin ön saflarda olması daha mantıklı ama... Peki, öyle olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030143
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030143,
					"content": "Nasha Kasabası bende. Dikkatli olun, tamam mı? İşler çığırından çıkarsa derhal geri çekilin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030144
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030144,
					"content": "Jahoda da size destek olacak. Ben yokken her türlü istihbarat toplama işini o halledebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030145
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030145,
					"content": "Başüstüne patron. Sağ salim dönmeye çalışın, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030146
					],
					"speakerTitle": "Jahoda"
				},
				{
					"id": 60030146,
					"content": "Merak etme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030147
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030147,
					"content": "Olaylar çok hızlı ilerliyor. Ayak uydurmak istiyorsak bir an önce yola çıkmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030148,
						60030149
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60030148,
					"content": "Bu çok tehlikeli bir görev olacak...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030150,
					"content": "Demek ya gizli bir araştırma tesisine sızacağız ya da... Peki, tamam. Paimon kalıp yardım etmeyi yeğler. Bayağı çetin bir savaş olacak gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030151,
					"content": "Hepimiz varımızı yoğumuzu ortaya koymalıyız. Gitmeden önce halletmen gereken bir şey var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030401,
						60030601
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030401,
					"content": "Birkaç işim var aslında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030402
					]
				},
				{
					"id": 60030402,
					"content": "Tamamdır. Hazır olduğunda yola koyulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030601,
					"content": "Hayır, hazırım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030602
					]
				},
				{
					"id": 60030602,
					"content": "Öyleyse yola koyulun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 60030603,
					"content": "Pekala.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60030149,
					"content": "Sen burada kalıp diğerlerine yardım etsen daha iyi olur Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030106,
					"content": "Tamam. Planı tekrar gözden geçirebilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030107
					]
				},
				{
					"id": 60030107,
					"content": "Haha, gergin misin? Çok doğal. Bu iş hepimizin boyunu aşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030108
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030108,
					"content": "Şimdi şöyle... Bir süre önce Columbina, Doktor tarafından pusuya düşürüldü. Her şey çok ani gelişti ve en son Columbina'nın \"ayın yansıması\"na girip kaybolduğunu gördün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030109
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030109,
					"content": "Evet, gerçi o sırada biz sadece Doktor'un ortaya çıkıp bir tür güç kullandığını gördük. Sonra bir de baktık ki Columbina kaybolmuş, sen de denize düşüyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030110
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030110,
					"content": "Columbina'yı geri getirmeliyiz. Ayrıca Doktor'un üç ayın iktidarını ele geçirme amacı her ne ise, başarılı olmadan önce onu durdurmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030111
					],
					"speakerTitle": "Varka"
				},
				{
					"id": 60030111,
					"content": "Donuk Ayın Çocukları olarak Ay Tanrıçası'nı kurtarmak bizim görevimiz. Bu kadar çok kişinin yardıma gelmesini beklemiyordum... Bu yüzden size minnettar olduğumuzu belirtmek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030112
					],
					"speakerTitle": "Lauma"
				},
				{
					"id": 60030112,
					"content": "(Sil)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030113
					]
				}
			]
		},
