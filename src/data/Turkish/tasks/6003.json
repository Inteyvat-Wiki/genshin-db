			"dialogs": [
				{
					"id": 60031101,
					"content": "Dottore elinde yapay Ay İliği varken çok güçlü... Onunla savaşmak nafile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031102
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60031102,
					"content": "Çabuk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031103
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60031103,
					"content": "Gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031104
					],
					"speakerTitle": "Flins"
				},
				{
					"id": 60031104,
					"content": "Her zaman pes etmektense kaçmanın daha akıllıca olduğunu düşünmüşümdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031105
					],
					"speakerTitle": "Doktor"
				},
				{
					"id": 60031105,
					"content": "Ne oluyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60031106
					]
				},
				{
					"id": 60031106,
					"content": "Dikkat et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031107
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60031107,
					"content": "Beni düşünmenin sırası değil! Siz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60031108
					]
				},
				{
					"id": 60031108,
					"content": "#{NICKNAME} nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031109
					],
					"speakerTitle": "Nefer"
				},
				{
					"id": 60031109,
					"content": "Hıh...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031110
					],
					"speakerTitle": "Yaver"
				},
				{
					"id": 60031110,
					"content": "Karşı koyamayız... Geri çekilelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
