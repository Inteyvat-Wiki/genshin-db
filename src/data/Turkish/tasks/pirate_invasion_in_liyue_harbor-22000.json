			"dialogs": [
				{
					"id": 220000101,
					"content": "Evet. Bu sefer nasıl oynasak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000102,
					"content": "Peh. Kimse korsan olmazsa hiç oynayamayız ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220000103,
					"content": "E ama kimse korsan olmak istemiyor. Ne yapacağız o zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000104,
					"content": "Ne yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "Oyun oynayacaktık ama kimse korsan olmak istemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000106,
					"content": "Korsan olmazsa soygun yapacak kimse de olmaz... O yüzden oyuna başlayamıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000107,
					"content": "Aa bir dakika, buldum! Korsan sen olabilirsin! Korsan olmak ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000108,
					"content": "Tabii, olurum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "Oley! Hazırlanalım o zaman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000115,
					"content": "Hazır olduğunda yanımıza gel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000110,
					"content": "Korsanlık pek uzmanlık alanım değil...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "Zor bir şey değil! Bir korsan çok yaramaz olur ve başkalarının eşyalarını alır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000112,
					"content": "Hiç gerçek bir korsanla tanışmadım gerçi. Beidou'nun anlattığı kadar biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000113,
					"content": "Ama korsanı oynamak çok kolay olur diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000114,
					"content": "Hehehe, yapabileceğinden eminim. Hadi başlayalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "Minik Meng"
				}
			]
		},
