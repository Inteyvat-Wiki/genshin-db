			"dialogs": [
				{
					"id": 220000501,
					"content": "Temizlik bitti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000502,
					"content": "Henüz değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "Biraz hızlan. Davranışlarını değiştirmen ve iyi bir insan olabildiğini göstermen için bir fırsat verdik sana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000504,
					"content": "Bir şey diyeceğim, burayı bir kere temizlemenin iyi bir insan olmak için yeterli olduğunu mu söylüyoruz cidden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220000505,
					"content": "İyi bir insan olmak için tek gereken şey doğru olanı yapma isteğidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000506,
					"content": "Fazla basit oldu gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220000507,
					"content": "İyilik yaparsan iyi birisin. Kötülük yaparsan kötü birisin. Evet, gayet basit.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000508,
					"content": "Hım. Öyle diyorsun ama o zaman neden dünyada hâlâ bir sürü kötü insan var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220000509,
					"content": "Çünkü dünyada her şey dile kolay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000510,
					"content": "Ama kötülük yapmak iyilik yapmaktan daha kolay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000511,
					"content": "Bunu sana Beidou mu öğretti?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220000512,
					"content": "Hayır, bir kitapta okumuştum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Meng"
				}
