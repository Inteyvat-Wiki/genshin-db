			"dialogs": [
				{
					"id": 220000201,
					"content": "Hazırım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "O zaman oyun başlasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000203,
					"content": "Nasıl başlıyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000204,
					"content": "Şey... Sökülün bakalım paraları. Sizi soyuyorum!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "Eyvah! Korsanlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "Minik Lulu"
				},
				{
					"id": 220000206,
					"content": "Merak etme Lulu, seni kurtaracağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220000207,
					"content": "Sen bir korsan olmalısın. Söylesene, neden bizi soyuyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000208,
					"content": "Korsanım çünkü...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "Hepsi değil. Bir iyi korsanlar bir de kötü korsanlar vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000211,
					"content": "Beidou korsan olduğunu söylüyor ama o iyi olanlardan. Bize şeker veriyor! Herkes Beidou'yu çok sever.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000212,
					"content": "Neden kötü bir korsan olmak zorundasın? İyi korsan olamaz mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000213,
					"content": "Korsanların yaramaz olduğunu ve başkalarının eşyalarını aldığını sen söyledin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220000214,
					"content": "Hatamı kabul ediyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "Güzel! Hatalarını kabul etmek iyi bir insan olmanın ilk adımıdır. Beidou öyle diyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000217,
					"content": "Bir sonraki adım ise etrafı toplamaktır. Çünkü iyi şeyler yaptığın sürece iyi bir insan olabilirsin. Hatta iyi bir korsan bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000215,
					"content": "Lafımı geri alıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "Korsanlar insan soyar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
