			"dialogs": [
				{
					"id": 220000301,
					"content": "Temizliği bitirdin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000302,
					"content": "Bitti.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "Oley! Sağ ol. Bunlar sana. Seninle oynamak eğlenceliydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000304,
					"content": "Unutma, iyi bir insan olmayı hayatın boyunca alışkanlık haline getirmelisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000305,
					"content": "Hey, ben ne zaman kaptan olacağım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "Minik Fei"
				},
				{
					"id": 220000306,
					"content": "Bir dahaki sefere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "Minik Meng"
				},
				{
					"id": 220000307,
					"content": "Geçen sefer de böyle demiştin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Fei"
				}
