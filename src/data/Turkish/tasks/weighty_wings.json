			"dialogs": [
				{
					"id": 750280101,
					"content": "Of, sen... Göründüğünden daha güçlüymüşsün...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280102
					],
					"speakerTitle": "Fare"
				},
				{
					"id": 750280102,
					"content": "Hay aksi, kimin canını sıktıysak... Böyle bir günde bizi pataklaması için bunu kim göndermiş olabilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280103
					],
					"speakerTitle": "Gece Kuşu"
				},
				{
					"id": 750280103,
					"content": "#Lütfen {M#Abi}{F#Abla}. Canını sıkan bir şey mi yaptık? Öyleyse... Lütfen ne olduğunu söyle. Bir daha yapmayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280104
					],
					"speakerTitle": "Gece Kuşu"
				},
				{
					"id": 750280104,
					"content": "Hey, seni küçük serseri! Bu ucubeye yalvaracak mısın gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280105
					],
					"speakerTitle": "Fare"
				},
				{
					"id": 750280105,
					"content": "Sert konuşmanın bizi kurtaracağını mı sanıyorsun? Şu anda her şey çok net. Biz bildiğin hırsızlar ve haydutlar gibi yaşıyoruz. Sürüngen kaçakçılığının savunulacak bir tarafı yok sonuçta, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280106
					],
					"speakerTitle": "Gece Kuşu"
				},
				{
					"id": 750280106,
					"content": "Elimdeki tek seçenek benden daha güçlü bir haydut tarafından soyulmaksa neden onunla gitmeyeyim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280107
					],
					"speakerTitle": "Gece Kuşu"
				},
				{
					"id": 750280107,
					"content": "#Bu arada övünmek gibi olmasın {M#Abi}{F#Abla} ama bu ikisine olacağımdan çok daha faydalı olurum sana. Neye ihtiyacın olursa bana söylemen yeterli. Tertemiz hallederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280108
					],
					"speakerTitle": "Gece Kuşu"
				},
				{
					"id": 750280108,
					"content": "Hım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280109,
						750280111
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280109,
					"content": "Aslında bir yardımcıya ihtiyacım vardı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280110
					]
				},
				{
					"id": 750280110,
					"content": "Sen ciddi misin? İmkanı yok! Paimon bu kararı veto ediyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280112,
					"content": "Hem siz beş para etmez insanlarsınız! Bizim gibi iyi insanların sizin gibi Sürüngen kaçakçılarıyla iş birliği yapması olacak iş değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280113,
						750280114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280113,
					"content": "Evet, benden iyisi Natlan'da kayısı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280117
					]
				},
				{
					"id": 750280117,
					"content": "#Öhöm! Neyse, Sürüngenlerle ilgili ne planlıyorsanız vazgeçin, yoksa biz... Yani {NICKNAME} size gününüzü gösterir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280118,
					"content": "Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280119
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280119,
					"content": "İki Sürüngen kaçakçısı hışımla oradan ayrılırlar...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750280120
					]
				},
				{
					"id": 750280120,
					"content": "Paimon Gukuzorun nasıl olduğunu merak etti. Görmeye gidelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280114,
					"content": "Belli olmaz, uzlaşmalara her zaman açığım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280115
					]
				},
				{
					"id": 750280115,
					"content": "#Hey, {REALNAME[ID(2)|SHOWHOST(true)]} için kötü örnek olursun! Merak etme ufaklık, bu hırsızlarla takım kurmayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750280116,
					"content": "Raarr... Raarr!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750280117
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750280111,
					"content": "Düşündüğün için teşekkürler ama gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750280112
					]
				}
			]
