			"dialogs": [
				{
					"id": 710960101,
					"content": "Arkaik Taşları bulabildiniz mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710960102
					],
					"speakerTitle": "Muning"
				},
				{
