				},
				{
					"id": 730570502,
					"content": "Adı \"yatak\". Üstelik yeni görünüyor... Üzerinde daha önce biri yatmış mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570503,
					"content": "Hehe. Aranakin üzerini sürekli temizliyor... Burada yatmak isterseniz yatabilirsiniz!",
