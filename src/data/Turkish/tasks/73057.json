		{
			"id": 7305709,
			"completionStepIds": [
				7305705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305705",
							"2"
						],
						"stepId": 7305705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570901,
					"content": "\"Bakr Amca'nın düşürdüğü udu tamir ettim bile, lütfen artık ağlama... Kendini kötü hissediyorsan Khayyam'la ve benimle konuşabilirsin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570902
					],
					"speakerTitle": "Hırpalanmış Defter"
				},
				{
					"id": 730570902,
					"content": "\"... Akademiye kabul edildim! Haha, kendimi tebrik ederim! Bir savaşçının eşi falan olmak istemiyorum ben. Büyük Bilge Siman olacağım!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570903
					],
					"speakerTitle": "Hırpalanmış Defter"
				},
				{
					"id": 730570903,
					"content": "\"Hehe... Beni unutmayın 'Büyük Müzisyen' Irfan ve 'Bilge' Khayyam! Özellikle de sen Khayyam! Sakın beni unutayım deme!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570904
					],
					"speakerTitle": "Hırpalanmış Defter"
				},
				{
					"id": 730570904,
					"content": "\"Elveda defter! Elveda can dostlarım Irfan ve Siman! Umarım bu orman hikayemizi hiç unutmaz ve birbirimizi her daim hatırlarız...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570905
					],
					"speakerTitle": "Hırpalanmış Defter"
				},
				{
					"id": 730570905,
					"content": "(Yazının gerisi çok karışık, hem mutlu hem üzücü çocukluk anılarıyla dolu...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570906
					],
					"speakerTitle": "Hırpalanmış Defter"
				},
				{
					"id": 730570906,
					"content": "\"Aranakin gitti. Bir anda sırra kadem bastı. O yüzden artık bu uda veda etmenin zamanı da geldi. Babamın benden beklediğini yapıp bir zanaatkar olacağım...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570907
					],
					"speakerTitle": "Hırpalanmış Defter"
				},
				{
					"id": 730570907,
					"content": "(Yazı devam ediyor fakat üzeri mürekkeple karalanmış.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570908
					],
					"speakerTitle": "Hırpalanmış Defter"
				},
				{
					"id": 730570908,
					"content": "\"Bu defteri okuyan kişi... Eğer bir mucize olur da yıllar sonra Aranakin ve diğerleriyle tekrar buluşabilirsem lütfen bu çiçeği ona ver...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570909
					],
					"speakerTitle": "Hırpalanmış Defter"
				},
				{
					"id": 730570909,
					"content": "Hey, kitaptan bir şey düştü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570910
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570910,
					"content": "Çiçeğe benziyor sanki. Aynı bizimki gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
