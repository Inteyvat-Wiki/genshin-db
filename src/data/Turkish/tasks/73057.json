			},
			"dialogs": [
				{
					"id": 730570101,
					"content": "Gitti... Paimon'un anladığına göre beraber yaşadığımız maceraları belli ki unutmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570102,
						730570103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570102,
					"content": "Şimdiden umudunu yitirme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570104
					]
				},
				{
					"id": 730570104,
					"content": "Evet, haklısın... Paimon'un aklına bir fikir geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570105,
					"content": "Aranakin bize bir şarkı öğretmişti, değil mi? Hadi çalalım. Belki o zaman hatırlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570106,
						730570108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570106,
					"content": "İyi fikir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570107
					]
				},
				{
					"id": 730570107,
					"content": "Hehe, Paimon'un doğru konuşmadığı nerede görülmüş?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570108,
					"content": "Sonunda faydalı bir tavsiye verdin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570109
					]
				},
				{
					"id": 730570109,
					"content": "Hey! Paimon'u gıcık etmeyi bırak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730570103,
					"content": "Tekrar arkadaş olabiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570110
					]
				}
			]
		},
		{
			"id": 7305702,
			"completionStepIds": [
				7305707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
