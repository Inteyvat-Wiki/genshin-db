			},
			"dialogs": [
				{
					"id": 230145501,
					"content": "Ah... Lutong, yardıma ihtiyacım var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145502
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145502,
					"content": "Efendim, dönüp biraz uyusanız iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145503
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145503,
					"content": "Gezgin, mükemmel zamanlama! Buraya gel. Senden bir ricam olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145504
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145504,
					"content": "Onun nesi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145505
					]
				},
				{
					"id": 230145505,
					"content": "Kısaca söylemek gerekirse... Bay Garcia çok fazla kahve içti ve neredeyse hiç uyumadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145506
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145506,
					"content": "Neyse ki şarap değil de kahve içmekle yetindi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145507
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145507,
					"content": "Lutong, şey... Daha fazla nişan bulmamız lazım... Hazine Avcılarının yanlarında taşıdıkları türde nişanlardan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145508
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145508,
					"content": "Gezgin! Buradaymışsın. Kusura bakma, seni görmemişim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145509
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145509,
					"content": "Bana biraz o nişanlardan bulmaya ne dersin? Birkaç tane yeterli olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145510,
						230145512
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145510,
					"content": "Biraz ara vermelisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145511
					]
				},
				{
					"id": 230145511,
					"content": "Önemli değil. Ben iyiyim. Ne yaptığımı iyi biliyorum. Sadece ellerim biraz kontrolden çıktı, o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145514,
					"content": "Neyse, nişanları getirdiğinde ödemeni alacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145515
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145515,
					"content": "Mühürleri bulduğunda bana getir. Daha yakından bakmak istiyorum. Bu sefer her şey çok daha mükemmel yapılmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145512,
					"content": "Kahvenin bu kadar etkili olduğunu hiç düşünmemiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230145513
					]
				},
				{
					"id": 230145513,
					"content": "Sorun kahvede değil. Bay Garcia uyumak istemiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145514
					],
					"speakerTitle": "Lutong"
				}
			]
		},
