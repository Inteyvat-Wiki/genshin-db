			},
			"dialogs": [
				{
					"id": 230140101,
					"content": "Efendim, naçizane fikrime göre ödemenin bir yolunu bulmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140102
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140102,
					"content": "Tüccar değil haydutlardı resmen! Alt tarafı birkaç nişan için nasıl öyle yüksek bir ücret isteyebilirler?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140103
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140103,
					"content": "Belki nişanları gördüğümüzde gözlerimizin nasıl parladığını fark etmişlerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140104,
					"content": "Nişanları ne için istiyorsun ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140105
					]
				},
				{
					"id": 230140105,
					"content": "Gezgin! Zamanlaman her zamanki gibi mükemmel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140106
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140106,
					"content": "Geçen seferki yardımların sayesinde makul kalitede bir yağ üretebildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140107
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140107,
					"content": "Tabii daha sonra başka bir sorunla karşılaştım. Bazı parçaları üretirken fark ettim ki bunlar aşırı sert bir malzemeden yapıldıkları için diğer parçalara zarar veriyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140108
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140108,
					"content": "Dahası bu sert parçalar, bazı durumlarda ufak bir darbeyle bile çatlayabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140109,
					"content": "Bu yüzden ben de hem sert hem de esnek olan bir malzeme aramaya başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140110
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140110,
					"content": "Uzun araştırmalar sonucunda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140111
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140111,
					"content": "Ve Bay Ahangar'la uzun süren tartışmalar sonucunda...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140112
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140112,
					"content": "Aradığım malzemeyi Hazine Avcılarının yanlarında taşıdıkları nişanlarda bulabileceğimi düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140113
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140113,
					"content": "Ama o tüccarların da Hazine Avcılarından bir farkı yok, resmen beni soymaya çalıştılar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140114,
						230140115
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140114,
					"content": "Ben de tam bu noktada geldim, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				},
				{
					"id": 230140116,
					"content": "Numaralandırma Makinamın ana mil yatağına senin adını kazımalıyım! Ne kadar minnettarım bilemezsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140115,
					"content": "Peki, nişanları bulmana yardım edeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230140116
					]
				}
			]
		},
