			"dialogs": [
				{
					"id": 230140301,
					"content": "Çok teşekkür ederim Gezgin. Bunlar yeterli olacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140302
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140302,
					"content": "Önce çarkı yeniden üretmeliyim... Hayır, hayır, önce mil yatağındaki problemi çözmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230140303,
					"content": "Gezgin, işte ödemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140304
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140304,
					"content": "Şu an içinde bulunduğumuz duruma bakılacak olursa muhtemelen iş birliğimiz uzun sürecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230140305
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230140305,
					"content": "Of, Bay Garcia'nın hesapları... İşin içinden çıkmak gerçekten çok zor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
