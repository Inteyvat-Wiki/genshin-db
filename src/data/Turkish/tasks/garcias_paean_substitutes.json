			"dialogs": [
				{
					"id": 230145001,
					"content": "Biraz Mora kazanmamız gerektiğini düşünüyorum efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145002
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145002,
					"content": "Duyduğuma göre Sumeru Şehri'nde bir tiyatro varmış ve onlar için hesaplamaları yapacak birini arıyorlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145003
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145003,
					"content": "Ayrıca sahne ekibi de çok Mora kazanıyor ama bu Moraların takibini nasıl yapacaklarını bilemiyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145004
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145004,
					"content": "Ben bunu iyi bir fırsat olarak görüyorum efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145005
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230145005,
					"content": "Muhasebe ve işletme konularında büyük bir yeteneğin var sevgili Lutong'um...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230145006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230145006,
					"content": "Bir dakika bana müsaade et, bir düşüneyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
