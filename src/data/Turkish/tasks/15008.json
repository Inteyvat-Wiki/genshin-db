			"dialogs": [
				{
					"id": 150080101,
					"content": "#{NICKNAME}, Paimon! Buraya gelin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080102
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080102,
					"content": "Mualani, sen de gelmişsin. Aa, şu tuhaf alimler de buradaymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080103,
					"content": "Günaydın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080104
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080104,
					"content": "Günaydın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080105,
					"content": "Ne zaman gidiyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080106
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080106,
					"content": "Haha, yolculuğumuz için çocuklar gibi heyecanlısın bakıyorum da.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080107
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080107,
					"content": "Mümkün olan en kısa sürede işe koyulmak istiyorum da ondan... Sonuçta bu sıradan bir bahar gezisi değil, o yüzden hepimiz biraz daha profesyonel davransak iyi olur diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080108
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080108,
					"content": "Merak etme, profesyonel bir rehberimdir ben. Öhöm, gizemli adaya olan yolculuğumuz resmen başlamış bulunmaktadır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080109
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080109,
					"content": "Oley!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080110,
					"content": "Öncelikle, buradaki heykeli herkes görüyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080111
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080111,
					"content": "Hı hı. Önemli bir ipucu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080112,
					"content": "Aslında hayır. Bir ipucu bile değil hatta. Gizemli adadan gelip de bu yeri kuran Kaplıca Halkının ilk şefiydi o. Bir anıt yani kısacası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080113
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080113,
					"content": "Yola çıkmadan önce yapmamız gereken ilk şey heykele dokunup atalarımıza dua etmek. Böylece gizemli adaya yapacağımız yolculuğumuz çok daha sorunsuz geçecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080114
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080114,
					"content": "Bu iddianı destekleyen herhangi bir teorik dayanağın var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080115
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080115,
					"content": "Teorik dayanak mı? Hayır ama öğretmenim gizemli adaya gitmeden önce bunun yerine getirilmesi gereken önemli bir adım olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080116
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080116,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080117
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080117,
					"content": "Çok güzel! Hakkında bilgi sahibi olmadığın konular hakkında benimle hiç tartışmaya girmedin bile. Çok profesyonelce bir yaklaşım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080118
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080118,
					"content": "Ancak bu uygulamanın deneysel bir dayanağı olmadığı için tezimde buna yer veremem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080119
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080119,
					"content": "Hadi bakalım, hep beraber!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080120
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080120,
					"content": "Atalarıma selam olsun. Torununuz olarak sizin adımlarınızı takip edecek ve başarılarınıza tanıklık edeceğim. Sizin gözetiminizde buradan ayrılıp yine sizin himayenizde geri buraya döneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080121
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080121,
					"content": "Gerçekten de harika bir maceraya atılmak üzereymişiz gibi geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080122,
					"content": "Hazırlanın lütfen. İlk ipucumuzu aramaya gidiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
