			"dialogs": [
				{
					"id": 150080201,
					"content": "Vay canına, burada bir sürü Koholazor var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080202,
					"content": "Tam da beklediğimiz gibi, ilk ipucumuz Koholazorlar ile ilgili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080203
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080203,
					"content": "Haritanın bir kopyası kabile dışından insanların eline geçse çoğu ilk ipucunun Koholazorlarla ilgili olduğunu hemen anlayabilir. Ancak genelde hep ters istikamette aramaya koyulurlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080204
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080204,
					"content": "İlk kabile şefi haritayı hazırladığında bu kısım için özel bir işaret koymuş. Koholazor sürüsünü göstermek için kabile tarafından kullanılan bir kod bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080205
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080205,
					"content": "Bir veya iki tane başıboş Koholazor bularak ipucu elde etmek imkansız o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080206
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080206,
					"content": "Bu konuda gerçekten tam bir profesyonelsin Mualani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080207,
					"content": "Ancak edindiğim bilgilere göre, Koholazorlar kaplıcalar için yarışmadıkları sürece sürü halinde bir arada takılmayı pek sevmiyorlarmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080208
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080208,
					"content": "Gel sana sadece Kaplıca Halkından bir rehberin bilebileceği bir sır vereyim. Vahşi Koholazorlar belirli aralıklarla ilerideki vadide toplanırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080209
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080209,
					"content": "Kabilemizin festivallerde bir araya gelmesi gibi yani. Ancak mevsim değiştiğinde sürü hızla dağılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080210
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080210,
					"content": "Sürekli Natlan'da dolaşan bir rehber değilsen böyle bir şeyi kolay kolay göremezsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080211
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080211,
					"content": "Böyle bir şey mi varmış? Hemen bunu not almalıyım ve tezimin ilgili kısmında bir açıklama olarak buna değinmeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080212
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080212,
					"content": "Haritadan çıkarabildiğim kadarıyla, o vadinin derinliklerinde bir ipucu gizli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080213
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080213,
					"content": "Ama oraya gitmek için Koholazor sürüsünün arasından geçmemiz gerekmiyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080214,
					"content": "Hımm, onları ürkütmeden sessizce geçip gitmenin bir yolunu bulmamız lazım. Arkadaşlarıyla bir aradalar, eminim ki rahatsız edilmek istemezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080215
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080215,
					"content": "Koholazor sürüsünün yanından yürüyerek geçmemiz gerekeceğini mi söylüyorsun yani? Bu biraz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080216
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080216,
					"content": "Öhöm... Madem birlikte çalışmaya karar verdik, o zaman herkes kendi üzerine düşeni yapacak. Ancak, Karya daha önce Koholazorların saldırısına uğramıştı, o yüzden bu onun için çok iyi bir plan olmayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080217
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080217,
					"content": "Ama benim için sorun yok! Karya burada beklesin, ben onun yapması gereken tüm görevleri devralırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080218
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080218,
					"content": "Hehe, olur. Herkesin gitmesine gerek yok zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080219
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080219,
					"content": "#Aslında birilerinin burada kalıp eşyalara göz kulak olması gerekiyordu. O yüzden bu işi size bırakıyoruz. {NICKNAME}, Paimon, siz benimle gelin lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080220
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080220,
					"content": "Öyle mi? Çok iyi o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080221
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080221,
					"content": "Yardımcı alimi ne kadar önemsediğini şimdi anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
		{
