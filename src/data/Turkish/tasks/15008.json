			"dialogs": [
				{
					"id": 150080401,
					"content": "Buldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080402
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080402,
					"content": "Bu ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080403,
					"content": "Sürünün içinden geçiş anahtarımız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080404
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080404,
					"content": "Koholazorların keskin koku alma duyuları varsa gizlice geçmeye ve görünmemeye çalışsak bile yeterince yaklaştığımızda bizi kesin fark ederler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080405
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080405,
					"content": "Ama bu bitki o sorunu çözmemize yardımcı olabilir çünkü kokusu tıpkı Koholazorların kokusuna benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080406
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080406,
					"content": "Bitkinin özünü vücudumuza sürerek onların koku alma duyularını yanıltabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080407
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080407,
					"content": "Bitkinin suyunu... Vücudumuza mı süreceğiz yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080408,
					"content": "Merak etme. Cildine de iyi gelir hem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080409
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080409,
					"content": "Mualani bazı bitkilerin özünü toplar ve herkesin vücudunu bu özlerin kokusuyla kaplar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080410
					]
				},
				{
					"id": 150080410,
					"content": "Paimon kendisini çok ıslak ve yapış yapış hissediyor... Bu şey gerçekten de Koholazor gibi kokuyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080411,
					"content": "Harika! Hadi bakalım, tekrar geçmeye çalışalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
