			},
			"dialogs": [
				{
					"id": 150080501,
					"content": "Yaklaşmış olmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080502
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080502,
					"content": "Bakın, bir sürü Koholazor kayanın orada toplanıyor. Ne yapıyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080503,
					"content": "Hımm, işler sıkıcı bir hal almaya başladığında toplanıp eğlenceli şeylerden konuşuyor olabilirler mi? Maalesef ne konuştuklarını anlayamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080504
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080504,
					"content": "Ne? Paimon, Kaplıca Halkı rehberlerinin Koholazorların dilinden anladığını sanıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080505,
					"content": "Birileri seni kandırmış sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080506
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080506,
					"content": "Doğru, cidden öyle olmuş galiba... Hım? Kayanın üzerindeki o şeyi gördünüz mü? Bir çeşit... Resim mi o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080507,
					"content": "Duyduğuma göre, Koholazorlar tarafından salınan biyolojik sinyallerle tepkimeye girince renk değiştiren bir yosun türü varmış. Ancak böyle bir tepkimeyi tetiklemek için çok sayıda Koholazor gerekiyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080508
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080508,
					"content": "İpucu bu olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080509
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080509,
					"content": "Fotoğraf çekelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080510,
					"content": "Flaş onları rahatsız edebilir. Bir kopyasını çizmeye çalışayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080511
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080511,
					"content": "Mualani yosunlu resmin bir kopyasını çizer ve sessizce sizi geldiğiniz yoldan geri götürür. Daha sonra, gördüğünüz ve duyduğunuz her bir şeyi sizi sabırla bekleyen Viramdra ile Karya'ya anlatıyorsunuz.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150080512
					]
				},
				{
					"id": 150080512,
					"content": "Böylece yolculuğun ilk aşamasını geçmiş olduk, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080513,
					"content": "Anladım... Koholazorları kovma yolunu seçmiş olsaydık bu ipucunu asla bulamazdık... Görünüşe bakılırsa söylediğin her şeyin mantıklı bir dayanağı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080514
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080514,
					"content": "O her zaman böyle miydi Bayan Karya?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080515
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080515,
					"content": "Yaptığı araştırmaya iyice kafayı takmış, hepsi bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080516
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080516,
					"content": "Bu en azından benim çıkarımlarımın doğru olduğunu gösterdi ve ben de güvenilirliğimi kanıtladım. Böylece, bir dahaki sefere tartışmamıza gerek kalmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080517
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080517,
					"content": "Evet, anlıyorum... Böylece bir dahaki sefer zaman kaybetmeyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080518
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080518,
					"content": "Mualani grubumuza nasıl liderlik edeceğini cidden iyi biliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080519
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080519,
					"content": "Sonuçta profesyonel bir rehber o.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150080520
					]
				},
				{
					"id": 150080520,
					"content": "Sırada, bulduğumuz ipucunu kullanarak sonraki hedefimizi bulmak var. Pekala, bu şekil ne anlama geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080521
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080521,
					"content": "Anlaması oldukça güç... Ne olduğuna dair Paimon'un en ufak bir fikri dahi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080522
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080522,
					"content": "Aha! Buldum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080523
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080523,
					"content": "Çizgiler biraz kabaca olsa da bence Yeşim Tepesi'nin oradaki su ile karanın arasındaki sınırı belirtiyor. Bunu kullanarak haritadaki boşluğu doldurabiliriz ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080524
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080524,
					"content": "Sonraki hedefimizi bulabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080525
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080525,
					"content": "Gerçekten mi? Tüm bunları kabaca çizilmiş bir çizgiye bakarak mı anladın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080526
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080526,
					"content": "İçgüdü de önemli tabii. Belki de bir rehber olarak çok fazla harita gördüğüm için bu tür şekilleri kolayca anlayabiliyorumdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080527
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080527,
					"content": "Pekala, molamız bitti, hadi yola koyulalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
