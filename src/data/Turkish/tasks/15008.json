			},
			"dialogs": [
				{
					"id": 150080301,
					"content": "Bu Koholazorlar tetikte duruyorlar. Buradan geçmemiz imkansız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080302,
					"content": "Haritadaki bilgilerden yola çıkarak ipucunun o vadide olduğunu öğrendiğinize göre, neden onları buradan kovmuyorsunuz? Gücünüz gayet yerinde, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080303
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080303,
					"content": "Öncelikle, kabilenin büyükleri bizi hep Koholazorlara zarar vermememiz konusunda uyarırlar. Aksi takdirde, başımızdan talihsizlikler neredeyse hiç eksik olmazmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080304
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080304,
					"content": "Ayrıca, durup dururken ortaya çıkıp da başkalarının toplanmasına izinsiz bir şekilde müdahale edemez, hele onları oradan uzaklaştıramayız! Bu çok korkunç bir şey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080305
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080305,
					"content": "Fakat neye dayanarak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080306
					],
					"speakerTitle": "Viramdra"
				},
				{
					"id": 150080306,
					"content": "Madem öyle, vadiye girmenin başka bir yolunu bulabilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080307
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080307,
					"content": "Hımm, onları hiç ürkütmeden vadiye girmenin başka bir yolu olmalı. Tek başıma bir çözüm bulmam epey zaman alabilir, o yüzden herkesi bir beyin fırtınası yapmaya davet ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080308
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080308,
					"content": "Paimon bir düşünsün bakalım... Dolambaçlı ya da farklı başka bir yol var mı ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080309,
					"content": "Haritaya göre, ipucu Koholazor sürüsünün tam ortasında. Diğer taraftan yaklaşmaya çalışsak bile yine aynı sorunla karşılaşırız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080310
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080310,
					"content": "Hımm, epey zor bir durum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150080311,
					"content": "Karya, fark ettim de sen sadece Viramdra ve diğerleri arasındaki sorunları çözmeye yardımcı olurken konuşuyorsun. Eminim ki senin de bir fikrin vardır, bizimle paylaşmaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080312
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080312,
					"content": "Benim mi? Pekala... Viramdra Koholazorların oraya giderek ipucu aramaya karar verdiğinde onlara yardım etmek istedim, o yüzden Koholazorlar hakkında ben de bazı bilgiler araştırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080313
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080313,
					"content": "Çok ilginç bir şey öğrendim... Koholazorların avlarını takip etmek için işitme yeteneklerini kullandıklarını sanıyorduk, ancak onların aslında çok güçlü koku alma duyuları da varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080314
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080314,
					"content": "Gerçi bunun ne kadar yararlı bir bilgi olduğundan pek emin değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080315
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080315,
					"content": "Aa... Bu aslında çok yararlı bir bilgi Bayan Karya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080316
					],
					"speakerTitle": "Mualani"
				},
				{
					"id": 150080316,
					"content": "Bana Karya diyebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150080317
					],
					"speakerTitle": "Karya"
				},
				{
					"id": 150080317,
					"content": "#O halde, siz burada kalıp valize göz kulak olun. {NICKNAME}, Paimon, siz benimle gelin. Aklıma bir fikir geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mualani"
				}
			]
		},
