			"dialogs": [
				{
					"id": 150180101,
					"content": "Aa... Bu tahta rampanın ne işi var burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180107,
					"content": "Ha, bu bir idman ekipmanı. Sık sık kullanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180108
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180108,
					"content": "İdman ekipmanı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180109,
					"content": "Evet. Açıklaması biraz zor ama... Doğrudan göstereyim en iyisi. İyi izle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180103
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180103,
					"content": "Başarılı bir iniş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180104
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180104,
					"content": "Vay be, o koca boşluktan öylece atladın mı gerçekten? İnanılmazsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180105,
					"content": "Atla deve değil. Biraz pratikle herkes yapabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180110
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180110,
					"content": "Sen buraya kadar antrenmansız gelebildin. Bu benim yapabileceğim her şeyden çok daha etkileyici.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180112
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180112,
					"content": "E Paimon uçabiliyor da ondan... Ama haksız sayılmazsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
