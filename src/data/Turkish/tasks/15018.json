						150180404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180404,
					"content": "#Bir dakika, siz... {NICKNAME} ve Paimon'sunuz! Ben de sizi bekliyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180405,
					"content": "Vay canına! Bizi tanıyor musun? Hah, namımız almış yürümüş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180406,
					"content": "Ama bir saniye... Bereket Kolektifine gittiğimizi birine söylemiş miydik?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180407,
					"content": "Aa, haberiniz yok muydu? Koç Iansan sizi kabilemize davet ettiğini söyledi, dolayısıyla hem idmanımı yapmak hem de sizi beklemek için buraya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180408,
					"content": "Ve koçun dediği gibi de oldu... Hehe, inanamıyorum! Bu harika bir şey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180409,
					"content": "B-Bizi o kadar gözünde büyütme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180410,
					"content": "Siz Hiçliği defeden kahramanlarsınız! Dolayısıyla Natlan'daki herkes için çok değerlisiniz! \"Tum{RUBY#[S]Umut}aini\" hikayesini o kadar çok duydum ki ezberledim sayılır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180411,
					"content": "Koç Iansan gelebileceğinizi söylediğinden beri çok heyecanlıyım. Adım Varesa bu arada. Koç daha önce benden bahsetti mi bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180412
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180412,
					"content": "Bir yerden tanıdık geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180413,
					"content": "Hiçlik istilası sırasında Iansan'a Bereket Kolektifinin yardıma ihtiyacı olup olmadığını sormuştuk, o da Varesa'nın her şeyi hallettiğini söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180414,
						150180415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180414,
					"content": "Etkileyici bir savaşçısın demek ki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				},
				{
					"id": 150180416,
					"content": "Pek sayılmaz. Hepsi Acatl Amca sayesinde oldu! Benim tek yaptığım birkaç canavar öldürmekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180417
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180417,
					"content": "İstilayı düşünmek bile içimi ürpertiyor hâlâ...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180418,
					"content": "Ama hepsi geçmişte kaldı. Sonuç olarak Bereket Kolektifi gayet iyi bir iş çıkardı. Gerekli tamiratları da hallettik, artık diğer kabilelere yardım ediyoruz daha çok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180419
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180419,
					"content": "Hehe, hadi ama! Sizi kampımıza götüreceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180420
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180420,
					"content": "Pekala, hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180415,
					"content": "Üstelik bir kahramansın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180416
					]
				}
			]
		},
