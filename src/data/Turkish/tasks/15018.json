			},
			"dialogs": [
				{
					"id": 150180801,
					"content": "Oh, insanın evi gibisi yok! Sonunda varabildik. Bereket Kolektifine hoş geldiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180814
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180814,
					"content": "Vay, burası harika bir yer! Boğa kafasına benzeyen platform muhteşemmiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180802,
					"content": "Hehe, orası Yankı Arenası. Tüm yarışmalarımız burada düzenleniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180803
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180803,
					"content": "Bizi buraya getirdiğin için teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180804
					]
				},
				{
					"id": 150180804,
					"content": "Lafı bile olmaz! Hiç dert etmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180815
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180815,
					"content": "Size etrafı göstermek isterdim ama eve gitmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180816
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180816,
					"content": "Önemli bir şeyi mi hatırladın yoksa? Demin dağ yabanileriyle karşılaşınca telaşlandın birden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180817,
					"content": "Umarım seni tutmamışızdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180818
					]
				},
				{
					"id": 150180818,
					"content": "Ha, yok yok! Tam zamanında geldik. Yapmam gereken önemli bir şey var da... İdmandan sonra en önemli şey yemek yemektir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180805
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180805,
					"content": "Yoksa halsiz, sersemlemiş ve güçsüz hissederim. Mideyi boş bırakmak gerçekten çok zararlı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180806
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180806,
					"content": "Neyse, kusura bakmazsanız hemen bir şeyler yemem lazım... Siz de yiyin bence!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180807
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180807,
					"content": "Daha sonra arenada buluşuruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180808
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180808,
					"content": "Ve gitti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180809,
					"content": "Ne tuhaf biri... Bazen soğukkanlı ve sakin görünüyor, sonra bir bakıyorsun tehlikeye balıklama atlıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180810
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180810,
					"content": "Ee, gençlik böyle bir şey.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150180811
					]
				},
				{
					"id": 150180811,
					"content": "Gençlik böyle bir şey mi? Sen de iyice moruklamaya başladın... Paimon bizim hâlâ genç olduğumuzu düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180812,
					"content": "Neyse, bu sırada etrafa göz atalım mı? Sonra da arenaya gideriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180813,
					"content": "Yukarıdan bakınca manzara muhteşem olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
