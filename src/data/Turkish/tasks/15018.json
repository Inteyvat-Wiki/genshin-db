					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180202,
					"content": "#Bu {NICKNAME}, Paimon'un adı da Paimon. Gezginin biricik seyahat yoldaşıdır kendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150180203,
					"content": "#{NICKNAME} ve Paimon demek... Kulağa güzel geliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150180204
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150180204,
					"content": "Pekala! Hadi gidelim!",
