					"nextDialogs": [
						721260303
					]
				},
				{
					"id": 721260303,
					"content": "Teşekkür ederim, artık çiçek yetiştirmeye devam edebilirim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260304
					],
