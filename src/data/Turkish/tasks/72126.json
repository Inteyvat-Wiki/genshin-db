				},
				{
					"id": 721260304,
					"content": "Lütfen bunları da al, sana verecek güzel bir şeyim olmadığı için üzgünüm... Neyse, yardımların için teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
