			"trigger": {
				"objectNames": [
					"Hanayama Kaoru"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721260101,
					"content": "Hayır ya... Yine ne var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260102
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260102,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260103
					]
				},
				{
					"id": 721260103,
					"content": "Burada olmana çok sevindim. Şöyle ki sen bana çiçek tohumlarını verdikten sonra çiçekleri ekmeye başladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260104
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260104,
					"content": "Ama çoğunu ekemeden ortaya bir grup canavar çıktı ve çiçekleri ekeceğim yeri talan ettiler. Artık oraya gitmeye korkuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260105
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260105,
					"content": "Burada kalmaya devam ederlerse çiçeklerin ekildiği yeri mahvedebilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260106
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260106,
					"content": "Senin için sorun olmazsa gidip halledebilir misin o canavarları? Ben çiçek ekmek istiyorum sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260107,
						721260109
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260107,
					"content": "Ben halledeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260108
					]
				},
				{
					"id": 721260108,
					"content": "Halledecek misin? Çok teşekkür ederim! Sana güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260109,
					"content": "Neden çiçek yetiştirmeye taktın ki kafayı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721260110
					]
				},
				{
					"id": 721260110,
					"content": "Çünkü bence Mikage Ocağı olayından sonra insanların Tatarasuna'ya dönmek istememelerinin sebebi buranın artık yaşamaya uygun olmadığından endişelenmeleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260111
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260111,
					"content": "Herkesi tek tek ikna edemem tabii ama buraya bir sürü güzel çiçek ekebilirsem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260112
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260112,
					"content": "Belki de böylece insanları Tatarasuna'nın güvenli olduğuna ikna edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260113
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260113,
					"content": "Ve... Çiçek ekmek dışında insanları ikna edecek başka bir yolum yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721260114
					],
					"speakerTitle": "Hanayama Kaoru"
				},
				{
					"id": 721260114,
					"content": "O yüzden lütfen o canavarları kovmama yardım et!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Hanayama Kaoru"
				}
			]
		},
