			"dialogs": [
				{
					"id": 737100101,
					"content": "♪~ ♪♪~ ♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100102
					],
					"speakerTitle": "Davul Kafa"
				},
				{
					"id": 737100102,
					"content": "♫♫~ ♫~ ♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100103
					],
					"speakerTitle": "Ateş Saçan"
				},
				{
					"id": 737100103,
					"content": "Haniyyah, Souka, biz geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100104,
					"content": "Davul Kafa ve Ateş Saçan'ın neşeli ayak seslerini uzaktan bile duyabiliyordum. Bu kez çok eğlenmişsiniz anlaşılan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100105
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100105,
					"content": "Eğlendiklerini o kadar uzaktan anlayabiliyor musun? Ben hâlâ Mantar dostlarımızın ayak seslerinden duygularını anlayamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100106
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100106,
					"content": "Sanırım daha öğrenecek çok şeyim var... Öğrenmenin sonu yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100107
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100107,
					"content": "Hehe, bu gezi gerçekten de farklıydı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100108,
					"content": "Mantar dostlarımızla oradan oraya koşturduktan sonra Küçük Mantar Oyun Alanına geri dönmek, sanki bütün gün dışarıda oynadıktan sonra eve dönüp güzel bir ziyafet çekmek gibi hissettiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100109,
					"content": "Hemen şimdi birlikte bir fotoğraf çekilmeye ne dersin? Paimon, Buğukuş'ta okuduğu bir makalede, ünlü seyahat günlüklerinde gezi boyunca çekilen tüm fotoğrafları kronolojik olarak dizdiklerini görmüştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100110,
					"content": "Gümüş Yardımcı bahsedince fark ettim, onca yıldır bu Mantar dostların yanımda olmasına o kadar alışmışım ki... Birlikte hiç doğru düzgün bir fotoğraf çektirmemişiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100111
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100111,
					"content": "Hı hı! Bir macerayı nasıl güzelce noktalayacağınızı cidden biliyorsunuz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100112
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100112,
					"content": "♪♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100113
					],
					"speakerTitle": "Davul Kafa"
				},
				{
					"id": 737100113,
					"content": "♫♫~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100114
					],
					"speakerTitle": "Ateş Saçan"
				},
				{
					"id": 737100114,
					"content": "Pekala, Davul Kafa'nın Kamerasını tripoda yerleştirelim ve zamanlayıcıyı ayarlayıp grup fotoğrafı çekelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100115,
					"content": "Haniyyah ile Souka'nın işleri biraz hafifleyince yine böyle hep beraber dışarı çıkıp eğlenebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100147,
					"content": "Yaşasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100116,
					"content": "Bu arada Davul Kafa fotoğraf çekme konusunda gerçekten çok yetenekli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100117,
					"content": "Paimon birkaç güzel kare seçip bunları grup fotoğrafımızla bir araya getirdi. Haniyyah ve Souka da bunlara bakabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100118,
						737100119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100118,
					"content": "Vay canına... Gerçekten her şeyi düşünmüşsün...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				},
				{
					"id": 737100120,
					"content": "Ha, bir de... Paimon sizin için ufak birkaç hediye getirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100121,
					"content": "Al bakalım! Daha önce tatma fırsatı bulamadığın makaronlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100122,
					"content": "Ayy, sadece laf arasında bahsetmiştim, nasıl hatırladın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100123
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100123,
					"content": "Gümüş Yardımcı... O kadar duygulandım ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100124
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100124,
					"content": "Gelecekte sana böyle zahmet vermemek için kötü alışkanlıklarımı düzeltmem gerek. Gezileri önceden düzgünce planlayacağım... Sadece kağıt üzerinde de değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100125
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100125,
					"content": "Bilirsin, dostlarla takılıp sohbet ederken öylesine söylenmiş bir söz bile insanın gerçek niyetini ortaya koyabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100126,
						737100127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100126,
					"content": "Bunu ne ara aldın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100128,
					"content": "Hani Fontaine'de fotoğraf çektiğimiz zaman vardı ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100129,
					"content": "Sen Davul Kafa ile manzarayı izlerken Paimon oradaki bir gazete satıcısından yardım istedi ve karşılığında ona biraz bahşiş verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100130,
					"content": "Merak etme, Paimon senin payını da hazırladı! Paimon hiç unutur mu, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100131,
					"content": "Hatta Paimon gazeteciye içeri girer girmez senin en sevdiğin çeşitten almasını hatırlattı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100132,
					"content": "Gerçi Fontaine'deki neredeyse her tatlıyı denedik, o yüzden bu pek büyük bir sürpriz olmayabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100133,
						737100134
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100133,
					"content": "Paimon ne seçtiyse kesin lezzetlidir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100135,
					"content": "Gerçekten mi? Hehe... O zaman Paimon sana daha sık bir şeyler ısmarlasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100136
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100136,
					"content": "Mantar dostlarımıza özel tatlılar olmaması çok kötü... Onlarla birlikte bir ziyafet çekebilsek ne güzel olurdu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100137,
					"content": "Merak etme. Mantar Toplulukları Üzerine adlı çalışmamı gözden geçirirken, mantarların hoşlandığı yiyecekler konusunun temellerini araştırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100138
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100138,
					"content": "Amacım hem Mantarların hem de insanların yiyebileceği yemek malzemelerini tanımlamak, böylece dostlarımız yıl boyunca Muhteşem Jöle çeşitleri ile beslenmek zorunda kalmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100139
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100139,
					"content": "Bir gün hem insanların hem de Mantarların damak tadına hitap eden yemek malzemeleri bulacağım ve hep birlikte tadını çıkarabileceğimiz lezzetli yemekler tasarlayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100140
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100140,
					"content": "Sıra teoriyi pratiğe dökmeye geldiğinde de ben ustalığımı konuşturacağım! Haniyyah'nın on birinci tenceremizi de mahvetmesini istemeyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100141
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100141,
					"content": "Mantar dostlarımızla bir çember oluşturup birlikte yemek yiyeceğimiz günler çok da uzak değil sanki, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100142,
						737100143
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 737100142,
					"content": "İyi haberlerini bekliyor olacağız Haniyyah!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100144,
					"content": "Öyleyse fırsat bulduğunuzda lütfen Küçük Mantar Oyun Alanını tekrar ziyaret edin. Tüm Mantar dostlarımızla birlikte her zaman buradayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100145
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 737100145,
					"content": "Kim bilir? Sürpriz belki de beklediğinizden çok daha erken gelebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737100146
					],
					"speakerTitle": "Souka"
				},
				{
					"id": 737100146,
					"content": "♪!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Davul Kafa"
				},
				{
					"id": 737100143,
					"content": "Souka'nın ziyafetini dört gözle bekliyoruz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100144
					]
				},
				{
					"id": 737100134,
					"content": "Beni düşünüp aldın ya, yeri bambaşka!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100135
					]
				},
				{
					"id": 737100127,
					"content": "Fark etmedim bile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100128
					]
				},
				{
					"id": 737100119,
					"content": "Ne kadar düşüncelisin Paimon!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737100120
					]
				}
			]
		}
	]
