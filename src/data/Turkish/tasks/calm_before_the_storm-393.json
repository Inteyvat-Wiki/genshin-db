			"dialogs": [
				{
					"id": 3930101,
					"content": "İşimiz bittikten sonra bu maceraların şarkısını yazmayı düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3930102,
