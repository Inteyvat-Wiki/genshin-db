					"Anthony",
					"Anna"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200140101,
					"content": "Anna, lütfen bunu tekrar düşün. Bu işi uzun vadede değerlendirmeliyiz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140102
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140102,
					"content": "Hadi ama! Mızmızlanmayı bırak, bana bir şey olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140103,
						200140104
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140103,
					"content": "Her şey yolunda mı Anna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				},
				{
					"id": 200140105,
					"content": "Gezgin! Tam vaktinde geldin! Bana yardım eder misin lütfen? Anna maceracı olmak istiyormuş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140106
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140106,
					"content": "Neden bir maceracı olamayayım ki? Sağlığım gayet yerinde, hem de Cyrus bu iş için gereken kafa yapısına da sahip olduğumu söyledi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140107
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140107,
					"content": "Sağlığına kavuşalı daha kaç gün oldu sanki? Tekrar hastalanmak mı istiyorsun? Bunu ebeveynlerimiz de kabul etmez ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140108
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140108,
					"content": "Bunu zaten annem ve babamla konuştum bile. Maceracılar Loncasının elemelerini geçersem izin vereceklerini söylediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140109
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140109,
					"content": "Ne... Nasıl!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140110,
						200140111
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140110,
					"content": "Sakin ol evlat...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140112,
					"content": "Cyrus birkaç gün önce benim için bir çalışma planı hazırladı. O gün bugündür çalışıyorum işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140113
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140113,
					"content": "Yani altı üstü gözcülük, acil durumlarda erzak bulma, dışarıda hayatta kalma gibi şeyler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140114
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140114,
					"content": "Duyduğuma göre maceracılar vahşi doğada sıklıkla canavarlarla da savaşıyorlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140115
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140115,
					"content": "Onu da öğrenmek istiyorum ama henüz bunu bana öğretebilecek birini bulamadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140116
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140116,
					"content": "Gördüğünüz üzere, abim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140117
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140117,
					"content": "Olmaz dedim! O canavarların ne kadar tehlikeli olduğunu biliyor musun? Gitmeye kalksan bile sana en azından tecrübeli birinin eşlik etmesi gerekir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140118
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140118,
					"content": "Jack ile konuştum ve bana yardım etmeyi kabul etti zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140119
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140119,
					"content": "Biraz gerçekçi ol, sanki Jack'i tanımıyorsun. Seni bırak, o kendisine bile bakamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140120
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140120,
					"content": "Yani Loncada kolay kolay tecrübeli bir maceracı bulabileceğimizi sanmıyorum ve görev ilanı vermek için yeteri kadar param da yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140121,
						200140122
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140121,
					"content": "O zaman ben size eşlik edebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140123,
					"content": "Ha? Bana yardım mı edeceksin? Harika o halde!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140124
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140124,
					"content": "Şimdi oldu mu abi? Rahat edersin artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140125
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140125,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140126
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140126,
					"content": "*iç çeker* İyi be, tamam. Fahri Şövalyenin ne kadar güçlü olduğunu biliyorum. Yanında o varken sanırım içim biraz da olsa rahat eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140127
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140127,
					"content": "Yine de oralarda kendine dikkat et...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140128
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140128,
					"content": "Sana söylediklerimi hatırlıyorsun değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140129
					],
					"speakerTitle": "Anthony"
				},
				{
					"id": 200140129,
					"content": "Evet, hatırlıyorum. Bu konuda yeteri kadar kafamı şişirdin zaten!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140130
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140130,
					"content": "O zaman artık gidelim Gezgin! Gideceğimiz kamp yerini Jack'e kontrol ettirmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140122,
					"content": "Yetenekli biri olduğumu düşünüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140111,
					"content": "O zaman çalışmaların nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140104,
					"content": "Anthony, siz ikiniz neden bahsediyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				}
			]
		},
