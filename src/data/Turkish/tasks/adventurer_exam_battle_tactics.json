			"dialogs": [
				{
					"id": 200140201,
					"content": "Vay be, hepsinin canına okudun. Onları gözün kapalı yenebilir gibi görünüyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140202
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140202,
					"content": "Tıpkı el kitabında yazdığı gibiydi... Canavarları yenmek için her türlü yolu kullanmak mübahtır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140203
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140203,
					"content": "Yine de itiraf etmeliyim ki bana bu kadar yaklaştıkları zaman korkmuyor değilim. İyi ki yanımızda sen varsın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140204
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140204,
					"content": "Daha çok çalışman lazım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140205
					]
				},
				{
					"id": 200140205,
					"content": "Evet, biliyorum. Maceracı olmak göründüğü kadar kolay değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140206
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140206,
					"content": "Teşekkür ederim Gezgin! Ben artık şehre döneyim. Abim şimdiye meraktan çatlamıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140207
					],
					"speakerTitle": "Anna"
				},
				{
					"id": 200140207,
					"content": "Artık daha sıkı çalışmam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Anna"
				}
			]
