				"points": []
			},
			"dialogs": [
				{
					"id": 240060201,
					"content": "Yine beni buldun demek, ha? Sanırım bu oyunda gerçekten çok iyisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060202
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060202,
					"content": "Ben buluşma noktasına dönüyorum. Umarım abim daha iyi saklanmıştır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060203
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060203,
					"content": "Neden öyle umuyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060204
					]
				},
				{
					"id": 240060204,
					"content": "O da öyle söylemedi mi? Beyni saklambaç oynarken daha iyi çalışıyormuş işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060205
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060205,
					"content": "Ancak, zihninde birçok şey var ve hepsini gözden geçirmek için yerde oturup uzun bir süre düşünmesi gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060206
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060206,
					"content": "Lovi bana fikirlerinin çok önemli olduğunu ve onu rahatsız etmememiz gerektiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060207
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060207,
					"content": "O yüzden onunla saklambaç oynadığımız zaman sobelemeden önce düşünmeyi bitirmesini bekliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060208
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060208,
					"content": "Sobeleme sırası abime geçtiğinde bizi bulması çok ama çok uzun sürüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Verut"
				}
			]
		},
		{
			"id": 2400603,
