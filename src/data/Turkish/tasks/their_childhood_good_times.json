			"dialogs": [
				{
					"id": 240060401,
					"content": "Acaba Aurele düşüncelerini toplayabilecek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060402
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060402,
					"content": "Ha, ne? Burayı nasıl buldun? Cidden, daha önce kaç defa saklambaç oynadın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060403
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060403,
					"content": "Buluşma noktasına gidiyorum o halde. Bir dahaki sefere daha iyi saklanacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lovi"
				}
