			"dialogs": [
				{
					"id": 240060601,
					"content": "Hayır, hayır... Bu argüman yeterince mantıklı değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060602
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060602,
					"content": "Ah, anlaşılan Aurele yine kendi dünyasında. Neyse, tekrar bizimle oynadığın için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060603,
						240060604
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060603,
					"content": "İyi olacak mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060605
					]
				},
				{
					"id": 240060605,
					"content": "Babam gibi kahveyi su gibi içmediği sürece ona bir şey olacağını sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060606
					],
					"speakerTitle": "Lovi"
				},
