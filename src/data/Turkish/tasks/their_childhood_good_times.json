				"points": []
			},
			"dialogs": [
				{
					"id": 240060101,
					"content": "Sobeleme sırası bende, ha? Seni kesin bulacağım Lovi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060102
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060102,
					"content": "Yerinde olsam o kadar emin olmazdım! Senin bile tırmanamayacağın yerler var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060103
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060103,
					"content": "Şey, çünkü ayakkabılarım tırmanmak için elverişli değil. Ayakkabılarımı değiştirirsem benden saklanamazsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060104
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060104,
					"content": "O halde ikimiz de ayakkabılarımızı çıkaralım. Böylece eşit oluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060105
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060105,
					"content": "Durun! İkiniz de yalın ayak bir yere gidemezsiniz. Her yerde ufak tefek şeyler var. Ya ayağınıza batarlarsa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060106
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060106,
					"content": "Peki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060107
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060107,
					"content": "Tamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060108
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060108,
					"content": "Iıı, az önce beni sobelemeye çalışırken biraz dikkatin dağılmıştı, değil mi abi? Yanından geçtim ama hiç tepki vermedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060109
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060109,
					"content": "Ha? Öyle mi oldu? Fark etmedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060110
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060110,
					"content": "Aynen! Ben de az önce yanından geçtim ama beni de fark etmedin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060111
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060111,
					"content": "Ama... Ha? Sen mi geldin? Senin ne işin var burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060112,
						240060115
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060112,
					"content": "Lovi neden burada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060113
					]
				},
				{
					"id": 240060113,
					"content": "Babam dışarıda işi olduğunu söyledi. Annemin de işi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060114
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060114,
					"content": "Aurele bir kitabı geri vermek için gelmişti, babam da ondan bana bakmasını istedi ve ben de onlarla oynamaya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060118,
					"content": "Sen onu boş ver, hadi oynamaya devam edelim. Bu sefer kim sobeleyecek?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060119,
						240060120
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060119,
					"content": "Saklambacı sevmiyorsun sanmıştım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060121,
					"content": "Ben, şey... *öksürür* Son zamanlarda bir yorum yazmaya çalışıyorum ve hesaba katmam gereken çok soru var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060122
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060122,
					"content": "Hareket halindeyken zihnimin daha hızlı çalıştığını fark ettim, o yüzden...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060123
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060123,
					"content": "Ama çok kolay dikkati dağılıyor ve bazen durduğu yerde kendi kendine konuşuyor. Ne dersen de hiç tepki vermiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060124
					],
					"speakerTitle": "Lovi"
				},
				{
					"id": 240060124,
					"content": "Bize katılmak ister misin? Saklambaçta abimden çok daha iyisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060125,
						240060126
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060125,
					"content": "Tamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060127,
					"content": "Hehe, hadi bakalım. Lovi ve ben saklambaçta ustayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060128
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060128,
					"content": "O zaman başlayalım. Hadi Lovi! Saklanacak yer bulmamız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060129
					],
					"speakerTitle": "Verut"
				},
				{
					"id": 240060129,
					"content": "Lovi ve Verut bir hışımla koşarken Aurele, düşünceli bir halde yavaşça ayrılır...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240060126,
					"content": "Size acımayacağım ona göre.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060127
					]
				},
				{
					"id": 240060120,
					"content": "Neden bir anda saklambaçla bu kadar ilgilenmeye başladın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060121
					]
				},
				{
					"id": 240060115,
					"content": "Hâlâ saklambaç mı oynuyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240060116
					]
				},
				{
					"id": 240060116,
					"content": "Evet. Bay Delerue bir iş seyahatine çıktı, Dumay Teyze de kendi işiyle meşgul, o yüzden benden Lovi'ye bakmamı istediler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060117
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060117,
					"content": "Ben de bizimle oynaması için onu buraya getirdim... Umarım üstünü başını çok kirletmez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060118
					],
					"speakerTitle": "Aurele"
				}
			]
		},
		{
