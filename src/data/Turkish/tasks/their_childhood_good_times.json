			},
			"dialogs": [
				{
					"id": 240060301,
					"content": "Hayır... Böyle düşününce mantıklı olmuyor. Başka bir açıdan ele almalıyım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060302
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060302,
					"content": "Şöyle nasıl olur? Hayır, olmadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060303
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060303,
					"content": "Ha? Aa. Beni buldunuz. Ben de buluşma noktasına gidiyorum o halde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240060304
					],
					"speakerTitle": "Aurele"
				},
				{
					"id": 240060304,
					"content": "Bu bakış açısı gerçekten doğru mu? Hayır... Aslında, doğru mu yoksa değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aurele"
				}
			]
		},
		{
