				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580901,
					"content": "Ah Nora...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580902,
						200580907
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580902,
					"content": "Bakıcısı mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580903
					]
				},
				{
					"id": 200580903,
					"content": "Evet, birkaç nedenden ötürü annesi evden uzakta. Bu süre zarfında ona ben bakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580904
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580904,
					"content": "Bakıma muhtaç başka çocuklarla da ilgilenirim. Rahibe olarak vazifemin bir parçası bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580905
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580905,
					"content": "Yeni bir ailem olmuş gibi. Hepsi iyi çocuklar ve Glory'yle de iyi anlaşıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580906
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580906,
					"content": "Benimle en uzun süre kalan Timmie. Bana \"anne\" demeye bile başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580907,
					"content": "Bana Nora'nın babasından bahset.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580908
					]
				},
				{
					"id": 200580908,
					"content": "Babası Patton. Aralıksız içmesi, evde büyük sorunlara yol açtı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580909
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580909,
					"content": "Hem Kilise hem de Favonius Şövalyeleri onu birkaç defa uyardı ama bir türlü ıslah olmadı. Sonunda Usta Diluc araya girdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580910
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580910,
					"content": "Patton'un Nora'ya bakacak durumu olmadığını düşünen Rahibe Victoria, onu Kilisenin koruması altına aldı. Böylece Patton da kendine çekidüzen verebilecekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580911
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580911,
					"content": "Ama Nora büyüdüğünde, \"Baban işle meşgul, yalnız kalması gerek...\" bahanesi işe yaramamaya başlayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580912
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580912,
					"content": "Ayrıca Rüzgar Hükümdarı'nın karahindibalarının bile sınırları vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				}
			]
		},
