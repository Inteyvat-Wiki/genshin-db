					"Nora"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200580101,
					"content": "Ne yapmalı, ne yapmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580102
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580103
					]
				},
				{
					"id": 200580103,
					"content": "Rüzgar Hükümdarı heykelini görüyor musun? Yukarıya bak... Hükümdarın ellerinin olduğu yere doğru.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580104
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580104,
					"content": "Gidip orada oynamak istiyorum ama... Grace heykele tırmanmama izin vermiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580105
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580105,
					"content": "Lütfen bir süreliğine gidip Grace ile konuşur musun? Bu tarafa bakmasına izin verme. Ben oldukça hızlı tırmanırım, hemen yukarı çıkarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580106,
						200580108
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580106,
					"content": "Olur herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580107
					]
				},
				{
					"id": 200580107,
					"content": "Yaşasın, teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580110,
					"content": "Bir dakikalığına Grace Hala'nın dikkatini dağıt, ben hemen heykele çıkarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580111
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580111,
					"content": "Nora! Hayır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580112
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580112,
					"content": "Gözümü ondan ayırdığım anda gelip seni sıkıştırıyor. Özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580113
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580113,
					"content": "Neden ya? Sadece biraz orada oynamak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580114
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580114,
					"content": "Hayır dediysem hayır! Baban da izin vermiyor zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580115
					],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580115,
					"content": "Sen de ona izin verme! Böyle tehlikeli bir şey yapsan insanlar senin için de böyle endişelenirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Grace"
				},
				{
					"id": 200580108,
					"content": "Çok tehlikeli.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580109
					]
				},
				{
					"id": 200580109,
					"content": "Sorun yok, ben çok iyi tırmanırım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580110
					],
					"speakerTitle": "Nora"
				}
			]
		},
		{
			"id": 2005802,
