				"points": []
			},
			"dialogs": [
				{
					"id": 200580201,
					"content": "Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580202
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580202,
					"content": "Orada ne yapmak istiyorsun ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580203
					]
				},
				{
					"id": 200580203,
					"content": "Birine sırrını anlatmak istiyorsan karahindiba tohumu bulup onu rüzgara atman gerekiyormuş. Rüzgar Hükümdarı karahindiba tohumunu ve kişinin sırrını istediğin kişiye taşıyormuş. Grace Hala öyle dedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580204
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580204,
					"content": "Ayrıca tohumları ne kadar yüksekten rüzgara bırakırsan mesajın o kadar hızlı gidiyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580205
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580205,
					"content": "Bir seferinde Glory bir maceracıdan heykele tırmanıp onun için rüzgara karahindiba tohumu atmasını istemiş. Birkaç gün içinde Godwin ona bir mektup yazmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580206
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580206,
					"content": "Babama söylemek istediğim bir sır var, karahindiba da buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580207
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580207,
					"content": "Ama Grace Hala yapmama izin vermiyor. Büyüdüğümde geri dönüp babamla yaşayabileceğimi söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580208
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580208,
					"content": "Keşke daha hızlı büyümenin yolu olsa... Elimden geldiğince deniyorum ama bir türlü uzayamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580209
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580209,
					"content": "Seni hep şehrin içinde kanat kullanırken görüyorum. Nasıl yaptığını bana da öğretir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200580210,
						200580212
					],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580210,
					"content": "Tabii ki, gösteririm de.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580211
					]
				},
				{
					"id": 200580211,
					"content": "Yaşasın! Ben kenarda durup izlerim, herhalde ona izin vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				},
				{
					"id": 200580212,
					"content": "Benimle uçmak ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200580213
					]
				},
				{
					"id": 200580213,
					"content": "Mümkün değil! Grace Hala beni öyle bir şey yaparken görse çok kızar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Nora"
				}
			]
		},
