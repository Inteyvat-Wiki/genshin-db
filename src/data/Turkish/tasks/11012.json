					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120408,
					"content": "Abim eve gönderdiği bir mektupta sizden bahsetmişti. Bana da Tonia ablam okudu mektubu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120409
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120409,
					"content": "Sizi görür görmez tanıdım. Sadece adınızı hatırlayamadım.",
