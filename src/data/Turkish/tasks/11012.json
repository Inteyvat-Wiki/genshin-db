					"nextDialogs": [
						110120418
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120418,
					"content": "Sizi evde bekleyeceğim. Kesinlikle bir ara Snezhnaya'ya ziyarete gelin!",
