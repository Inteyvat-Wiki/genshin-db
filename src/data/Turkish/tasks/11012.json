					"nextDialogs": [
						110120227
					]
				},
				{
					"id": 110120227,
					"content": "Hahaha... \"Dostlar sözünü tutar, tutmayan buzda donar. Yine yalan söyleme diye, buz dilini dondurur.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120228
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120228,
					"content": "Bu tekerleme eski güzel anılarımı aklıma getirdi. Demek sana bunu Teucer öğretti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120229
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120229,
					"content": "Güle güle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120230
					]
				},
				{
					"id": 110120230,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
