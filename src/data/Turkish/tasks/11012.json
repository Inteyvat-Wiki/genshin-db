			"dialogs": [
				{
					"id": 110120401,
					"content": "Efendim, küçük bey Teucer, sizi bekliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120402
					],
					"speakerTitle": "Andrei"
				},
				{
