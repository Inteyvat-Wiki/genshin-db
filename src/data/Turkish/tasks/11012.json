			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110121001,
					"content": "Sonunda seni bulduk. İyisin değil mi Teucer?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121002
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121002,
					"content": "İyiyim tabii. Çok eğlenceliydi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121003
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121003,
					"content": "Belki senin için eğlenceliydi ama biz çok korktuk...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121004,
					"content": "Şuradaki şey ne öyle? Vay canına, bu oda kocamanmış! Bay Tepegöz arkadaşları gelince onları burada mı ağırlıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121005
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121005,
					"content": "Evet. Büyük değil mi? Şimdi biraz saklambaç oynamaya ne dersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121006
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121006,
					"content": "Şimdi mi? Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121007
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121007,
					"content": "Sonunda sana bir sürprizim olacak çünkü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121008
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121008,
					"content": "Sürpriz mi? Nasıl bir sürpriz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121009
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110121009,
					"content": "Merak etme, daha sonra bakacak fırsatın olacak ama önce gözlerini kapatıp arkanı dön ve 60'tan geri say.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121010
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121010,
					"content": "Tamam... 60'tan geriye saymak çok uzun sürer ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				}
			]
		},
