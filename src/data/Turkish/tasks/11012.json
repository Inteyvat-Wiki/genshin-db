					"nextDialogs": [
						110120426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120421,
					"content": "Söz vermemizi ister misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120422
					]
				},
				{
					"id": 110120422,
					"content": "Evet! Söz verin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120423
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120413,
					"content": "Abin mektupta benim hakkımda kötü bir şey söylememiş, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120414
					]
				},
				{
					"id": 110120414,
					"content": "Hayır. Hatta demiş ki, fırsatı olsa işini bırakıp maceralarınızda size katılırmış!",
