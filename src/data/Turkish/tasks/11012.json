			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asilzade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "İşte geldik. Liyue'nin Oyuncak Araştırma Enstitüsüne hoş geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120102,
					"content": "Sonunda! İçerideki makinaların sesini duyabiliyorum. Harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120103,
					"content": "Burası neresi ve burayı nereden biliyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120104,
					"content": "Anladığım kadarıyla bu Dottore'nin araştırma tesislerinden biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120105,
					"content": "Dottore, Fatui'nin Habercilerinden biridir. Eski şeyleri kurcalamayı sever, bu onun hobisidir. Bu yüzden bu harabeleri bir Harabe Muhafızı araştırma laboratuvarına dönüştürmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120106,
					"content": "Ne? Yani Harabe Muhafızlarını Fatui mi yapmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120107,
					"content": "Hayır, onların Hiçlikle bağları çok daha güçlüdür ve bu yüzden başkalarına olduğu kadar bize de düşmanlardır... Biz sadece araştırma yapıyoruz, o kadar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120108,
					"content": "Harabe Muhafızlarının neden son zamanlarda bu bölgeden çıktığına gelirsek... Tahminimce onlarla oynamaktan sıkılmıştır ve burayla eskisi kadar ilgilenmiyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120109,
					"content": "Vay be! İşine saygısı olmayan bir Haberci daha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120110,
					"content": "En azından Teucer'ı buraya getirmekle ilgili neden sorunun olmadığı belli oldu. Anlaşılan dersine çalışmışsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120111,
					"content": "Şey... Tam olarak öyle değil. Aslında içerisi nasıl hiç bilmiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120112,
					"content": "Bekle bir dakika! Kardeşinin güvenliğini düşünüyor musun, düşünmüyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120113,
					"content": "Tabii ki düşünüyorum ama tehlike ne olursa olsun ben onu korurum. Bütün abiler öyle yapmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120114,
					"content": "Bunu Teucer bile anlıyor ve artık ne uğruna savaştığını biliyor... Bu yıllardır benim de kalbimi saran ateşle aynı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120115,
					"content": "Ne konuşuyorsunuz siz? Hadi içeri girelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120116,
					"content": "Haha, peki. Beni izleyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asilzade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "Beni onlardan önce sizin bulduğunuza sevindim... Görünüşe göre yaralarım iyileşmeden Kötülüğün Mirasını kullanmak beni beklediğimden fazla zorladı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120202,
					"content": "Teucer beni böyle görse ne yapardım bilmiyorum... Patlamış balon gibiyim, baksanıza...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120203,
					"content": "Burada işini bitirmemden korkmuyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "Haha! Hatırladığıma göre senin de kardeşlerin var, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120205,
					"content": "Muhtemelen beni küçük kardeşimin gözü önünde öldürmezsin diye düşündüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120206,
					"content": "Bu durumdan faydalanmayı sürdüreceksin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120208,
					"content": "Sana söylemiştim... Sınırlarımı zorlama fırsatını asla geri tepmem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120209,
					"content": "Bu yüzden ben, Tartaglia, sürekli güçleniyorum. *kıkırdar*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120210,
					"content": "Çocukların hayalleri çabuk yok olur. Kendi haline bıraksan bile kendi başlarına parçalanır hayalleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120211,
					"content": "Bu yüzden birinin onları koruması gerekiyor değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120212,
					"content": "Bir söz verdiysen tutarsın, hata yaptıysan özür dilersin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120213,
					"content": "Ve birine bir hayal verirsen sonuna kadar korursun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120214,
					"content": "Aile de bu demek değil mi zaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120215,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "Sana bir şeyi hatırlattım galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120217,
					"content": "*öksürür* Ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120218,
					"content": "Güçlü görünmeye çalışma! Hemen bir doktora görünmen lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120219,
					"content": "İyi bir öneri ama önce Teucer'a vereceğim küçük bir şey var. Lütfen benim yerime ona siz verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120220
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120220,
					"content": "Bu... Bir Bay Tepegöz oyuncağı mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120221
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120221,
					"content": "Evet. Bir süre önce bir demirciye özel olarak yaptırdım. Bunu ona Snezhnaya'ya döndüğümde verecektim ama görünüşe göre şimdi daha iyi bir hediye olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120222
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120222,
					"content": "Vay canına... Paimon, Asilzade'nin ailesinin çok şanslı olduğunu düşünüyor. Sence de öyle değiller mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120223,
					"content": "Ayrıca Teucer'a niye bir anda gittiğimi de açıklamanız gerekecek.",
