			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asilzade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110121101,
					"content": "Selam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121102
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121102,
					"content": "Asilzade? Bunca zamandır burada mıydın? Neden saklanıyorsun? Neden kardeşine veda etmedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121103,
					"content": "Ayrılıklar özel anlardır. Liyue'deki son dakikalarında beni yorgun ve zayıf görmesini istemedim... Aklında böyle bir hatıra kalsın istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121104
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121104,
					"content": "Yine de bizzat veda edememem kötü oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121105
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121105,
					"content": "*iç çeker* Onu geri götüren ben olmalıydım. Ona eşlik edecek birilerini gönderdim ama içim yine de çok rahat değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121106
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121106,
					"content": "Sence de onu zaten yeteri kadar şımartmadın mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121107,
					"content": "Haha. Tam açıklayamıyorum ama onu size bırakırken çok daha rahattım. İlk karşılaşmamızın çok iyi olmadığını düşününce bu tuhaf...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121108
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121108,
					"content": "Neredeyse unutuyordum. Hizmetlerinizin karşılığı. Bu kez siz olmasanız gerçekten bunu yapamazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121109
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121109,
					"content": "Gerçekten bir kalbin varmış demek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121110,
					"content": "Bir şey daha var. Sözümüzü unutmayın. Fırsatımız olduğunda rövanş yapalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121111
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121111,
					"content": "Bu kez Haberci olarak onurumu öne koyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121112,
						110121113
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121112,
					"content": "Heyecanla bekliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				},
				{
					"id": 110121114,
					"content": "Önce biraz dinlensen iyi olur! Yine kaybedip ağlayarak kapımıza gelme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121115,
					"content": "Hahaha... Bir dahaki dövüşümüzü kim kazanırsa kazansın sizi evime davet etmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121116
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121116,
					"content": "Sizi diğer kardeşlerim Tonia ve Anthon'la da tanıştırırım. İyi çocuklardır. İkisiyle de gurur duyuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121117
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121117,
					"content": "Teklifini unutmayacağız! Zaten Teucer'a söz verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110121118,
					"content": "Eminim o da sizi gördüğüne çok sevinecektir. Anlaştık o zaman. Şimdiden sabırsızlanıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121119
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121119,
					"content": "Hoşça kalın dostlarım... Bir dahaki sefere Snezhnaya'da görüşürüz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110121113,
					"content": "Sana karşı kaybetmeyeceğim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				}
			]
		}
	]
}