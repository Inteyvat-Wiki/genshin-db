					"Teucer"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120901,
					"content": "Kapı açıldı! Sen mi yaptın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120902
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120902,
					"content": "Evet ama bir dakika bekle Teucer. Her şeyin güvenli olduğundan emin olmam lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120903
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120903,
					"content": "*iç çeker* Belki de onu bu kadar şımartmamalıydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				}
			]
		},
		{
			"id": 1101210,
			"completionStepIds": [
				1101203,
