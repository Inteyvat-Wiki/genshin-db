					"nextDialogs": [
						110120303
					]
				},
				{
					"id": 110120303,
					"content": "Öyle mi? Nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120306
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120306,
					"content": "Bir anda bir sürü insan Bay Tepegöz satın almak istemiş!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120307
					]
				},
				{
					"id": 110120307,
					"content": "Şey, evet... O yüzden hemen gitmesi gerekti. Yani bilerek geride bırakmadı seni.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120308,
					"content": "Öyle mi? Bu... Çok iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120309
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120309,
					"content": "Yine de burada onunla biraz daha oynamak istiyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120310,
						110120311
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120310,
					"content": "Abin sana bunu verdi.",
