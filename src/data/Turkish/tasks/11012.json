					"nextDialogs": [
						110120312
					]
				},
				{
					"id": 110120312,
					"content": "Vay be! Şuna bak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120313
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120313,
					"content": "Bu boyda Bay Tepegöz yaptıklarını bilmiyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120314
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120314,
					"content": "Üstünde adım bile var! Bana ait bir Bay Tepegöz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120315
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120315,
					"content": "Çok sevdin bakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120316,
					"content": "Hem de nasıl! Abim dünyanın en iyi abisi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120317
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120317,
					"content": "Liyue'yi gezdin, abinle buluştun, Oyuncak Araştırma Enstitüsünü gezdin ve hediye aldın... Tur rehberi olarak buna mükemmel bir tur derim ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120318,
					"content": "Artık Snezhnaya'ya dönmeye hazır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120319
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120319,
					"content": "Hehe... Merak etmeyin, sürekli benim istediğim olacak değil. Yoksa diğer herkes rahatsız olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120320
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120320,
					"content": "Hadi gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120311,
					"content": "Onun yokluğunda yanında Bay Tepegöz olacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120312
					]
				},
				{
					"id": 110120304,
					"content": "Çoktan döndü bile.",
