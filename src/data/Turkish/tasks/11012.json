					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120224,
					"content": "Bana yardım edeceksiniz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120225,
						110120226
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120225,
					"content": "\"Bak söz verdin sen bana, hep tutacaksın ama...\"",
