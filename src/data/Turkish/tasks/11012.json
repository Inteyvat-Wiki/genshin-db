						110120423
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120423,
					"content": "Bak söz verdin sen bana, hep tutacaksın ama. Dönersen bu sözünden, Paimon atar seni buza! Dostlar sözünü tutar, tutmayan buzda donar. Yine yalan söyleme diye, buz dilini dondurur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120424,
					"content": "Tamam! Artık söz verdiniz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120425
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120425,
					"content": "Görüşürüz Teucer! İyi yolculuklar!",
