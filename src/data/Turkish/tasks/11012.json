			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Asilzade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120801,
					"content": "Abi... Birisi Bay Tepegözün ölümcül bir makina olduğunu söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120802
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120802,
					"content": "Öyle mi? Çok saçmaymış... Sakın sen de bunu başkalarına söyleme Teucer. Böyle şiddetle ilgili konuları konuşmak için hâlâ çok küçüksün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120803
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120803,
					"content": "Tamam. Zaten yalan söylediğini biliyordum. Bay Tepegözün görevi kötüleri yenip dünyayı korumak. O benim en sevdiğim oyuncağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120804
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120804,
					"content": "Evet. Bay Tepegöz varken kötüler seni asla yakalayamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120805
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120805,
					"content": "Doğru! Şimdi Bay Tepegözle oynamaya gidiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120806
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120806,
					"content": "Bekle Teucer...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120807
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 110120807,
					"content": "Kapı kapandı! Teucer iyi olacak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120808
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120808,
					"content": "Şurada bir yol daha var... Gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				}
			]
		},
		{
			"id": 1101209,
			"completionStepIds": [
