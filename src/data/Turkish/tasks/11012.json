					"nextDialogs": [
						110120403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120403,
					"content": "Evet. Sayın Asilzade, küçük bey Teucer'ın dönüş yolculuğunu ayarlamamı istedi. Bu taraftan lütfen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120404
					],
					"speakerTitle": "Andrei"
				},
				{
					"id": 110120404,
					"content": "Sen de kimsin? Abim bana asla yabancılarla bir yere gitme demişti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120405
					],
					"speakerTitle": "Teucer"
				},
				{
					"id": 110120405,
					"content": "Ama bunca zamandır bizi takip ediyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 110120406,
					"content": "#Evet çünkü sizi zaten tanıyordum. Siz {M#Kibar Beyefendi}{F#Kibar Hanımefendi} ve arkadaşısınız.",
