			},
			"dialogs": [
				{
					"id": 50300801,
					"content": "Aa, siz! Harika! Destek olduğunuz için çok teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300802
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300802,
					"content": "Natlan'da çoğu kişi Hiçliğe karşı savaşmanın bir onur olduğunu düşünüyor. Ancak daha sonra kendilerini heyecana fazla kaptırıp tehlikeye atıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300803
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300803,
					"content": "Haklıydınız, savaşmak önemli ancak hayatta kalmak da önemli. Sevdiğimiz insanlar için savaşıyoruz ancak aynı zamanda onları tekrar görebilmek için de savaşıyoruz aslında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300804
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300804,
					"content": "Düşüncelerinizi silah arkadaşlarımla paylaştım, onlar da çok etkilendiler. Şimdi herkes daha kararlı bir şekilde savaşıyor, gidişat da değişmeye başladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300805
					],
					"speakerTitle": "Uturunku"
				},
				{
					"id": 50300805,
					"content": "O yüzden bir kez daha söylüyorum... Size ne kadar teşekkür etsem az!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Uturunku"
				}
			]
		},
