					"nextDialogs": [
						50301502
					],
					"speakerTitle": "Achiyaku"
				},
				{
					"id": 50301502,
					"content": "Sağ salim varabildin demek ha? Yolculuk nasıldı, sorunsuz geçti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301503,
					"content": "Iı... Pek sayılmaz. Bir grup Hiçlik canavarına denk geldik ve onlarla ölümüne savaşmamız gerekti. Ama bu insanların hakkını vermek lazım, gerekeni yaptılar. Sanki eğitimli savaşçılar gibi savaştılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301504
					],
					"speakerTitle": "Achiyaku"
				},
				{
					"id": 50301504,
					"content": "Hehe, kas hafızası görevini yapıyor o zaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301505
					],
					"speakerTitle": "Libiac"
				},
				{
					"id": 50301505,
					"content": "Hayatta olduğum için çok şanslı hissediyorum kendimi. Kaybettiklerimizi geri almak için hayatta kalmaya devam etmeliyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50301506
					],
					"speakerTitle": "Kunak"
				},
				{
					"id": 50301506,
					"content": "Siz de kendinize çok dikkat edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kunak"
				}
