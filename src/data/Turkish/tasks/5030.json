			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Awhina"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300201,
					"content": "Chuychu'yu getirdiğinizi gördüm... Çok yazık. Kendisi şimdiye kadar tanışma şerefine nail olduğum en umut verici doktordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300202
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300202,
					"content": "Biz çok yakın iş ortaklarıydık. Söz konusu tıbbi malzemelerse hep çok yüksek standartları olmuştur. Sık sık hastalarının tedavisi için kendi cebinden para harcardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300203
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300203,
					"content": "Bana her zaman tecrübenin paradan daha önemli olduğunu söylerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300204
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300204,
					"content": "Daha çok insanı, özellikle de en kıymet verdiği kişiyi kurtarabilmek için becerilerini geliştirmesi gerektiğini söylemişti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300205
					],
					"speakerTitle": "Awhina"
				},
				{
					"id": 50300205,
					"content": "Ne yazık ki sonunda kurtaramadığı kişi kendisi oldu. Natlan da bir neslin en yetenekli gençlerinden birini kaybetti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Awhina"
				}
			]
		},
