					"nextDialogs": [
						50301403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 50301403,
					"content": "Heh... Hayatımda ilk defa bir Hiçlik canavarını yendim ve fark ettim ki... O kadar da güçlü değiller aslında.",
