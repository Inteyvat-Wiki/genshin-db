					"Qhispe"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 50300101,
					"content": "Hükümdar aşkına, hiçbir şeye yetemiyorum... İnsan gücümüz eksik, yeterli malzememiz yok ve muayene ettiğim hastaların yarısını bile tedavi edemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300102
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300102,
					"content": "Keşke danışabileceğim daha bilgili biri olsa... Of, hayır, böyle düşünmemeliyim. Güçlü olmam lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qhispe"
				}
			]
		},
		{
			"id": 503002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
