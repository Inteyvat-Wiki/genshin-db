				},
				{
					"id": 50300302,
					"content": "Neredeyse her şey tükendi. Acil durum stokları duruyor ama onlar da doktorlar ve askerler için. Onlara dokunamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300303
					],
					"speakerTitle": "Qhispe"
				},
				{
					"id": 50300303,
					"content": "Biliyorum, biliyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300304
					],
					"speakerTitle": "Mayahuel"
				},
				{
