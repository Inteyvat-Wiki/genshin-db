				},
				{
					"id": 50301601,
					"content": "Hah, siz mi geldiniz? İyi olduğunuzu görmek ne güzel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300506,
					"content": "Oğlundan bir haber var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						50300507
					]
				},
				{
					"id": 50300507,
					"content": "Yok. İletişim kesildi tamamen, hem ilgilenmem gereken bir sürü yaralı var. Şu an onlara odaklanmam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50300508
					],
					"speakerTitle": "Mayahuel"
				},
				{
					"id": 50300508,
					"content": "Ama oğluma güveniyorum. İşler kötüye gittiğinde bile en doğru kararı vereceğine eminim. O benim oğlum, onunla her zaman gurur duyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mayahuel"
				}
