			"dialogs": [
				{
					"id": 220420101,
					"content": "Bunları eğitmek mümkün değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420103
					]
				},
				{
					"id": 220420103,
					"content": "Merhaba. Ufaklıklar yine kaçtı. Büyüdükçe asileşiyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420104,
						220420105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420104,
					"content": "Yardıma ihtiyacın var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				},
				{
					"id": 220420106,
					"content": "Şu metal topları tapınağın etrafına astığına göre bence artık kendi başlarına dönüş yolunu bulabilirler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420107,
					"content": "İnsanların önünde tapınağın adını kirleterek kendilerini küçük düşürmeleri dışında ortalığı karıştırmaları çok da kötü bir şey olmayabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420108,
					"content": "Fakat abartıp gece olana kadar geri dönmezler ve aç kalırlarsa... Bu da iyi olmayacaktır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420109,
					"content": "Neyse, lütfen bu balıkları o küçük veletlere götür ki aç kalmasınlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420110,
						220420113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420110,
					"content": "Tamam o zaman.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420111
					]
				},
				{
					"id": 220420111,
					"content": "Yerlerini işaretlemesi için haritamızı Neko'ya verelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 220420112,
					"content": "Hımm, anlaşılan kafan çalışıyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420115,
					"content": "Neyse, derhal git. Daha tapınakta halletmem gereken işlerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420113,
					"content": "İşte haritamız...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420114
					]
				},
				{
					"id": 220420114,
					"content": "Hımm, anlaşılan kafan çalışıyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420105,
					"content": "Gidip onları bulalım mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420106
					]
				}
			]
