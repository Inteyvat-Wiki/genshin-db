			"dialogs": [
				{
					"id": 220420301,
					"content": "Dönmüşsün. Veletleri besledin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420302
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420302,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420303
					]
				},
				{
					"id": 220420303,
					"content": "Güzel. Teşekkür ederim. Yardımın olmasaydı o ufaklıklar akşama kadar oyun oynayıp açlıktan güçsüz düşerlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420304,
					"content": "*iç çeker* Hiç laftan anlamıyorlar, tapınağa gelen insanların karşısına bu halde nasıl çıkacaklar hiç bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
