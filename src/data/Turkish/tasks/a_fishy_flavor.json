			"dialogs": [
				{
					"id": 220420401,
					"content": "Dönmüşsün. Gariptir ki ufaklıklar aniden geri döndüler, biraz da korkmuş görünüyorlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420402,
					"content": "Şu ellerinde sopa olan tehlikeli yabanilerle mi karşılaştılar yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420403
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420403,
					"content": "Neyse, sonuçta döndüler... Bir dakika, neyin var senin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420404,
					"content": "Ah, şey, ben...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220420405
					]
				},
				{
					"id": 220420405,
					"content": "Seni ahlaksız! Böyle bir şeye nasıl cüret edersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420406
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420406,
					"content": "Ufaklıklarla düzgün bir şekilde oynayabilirdin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420407
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420407,
					"content": "Miyav! Neden bu kadar korktuklarına şaşmamak gerek. Git ve onlardan özür dile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220420408
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220420408,
					"content": "Gerçekten mi? İnsanlardan Hibiki gibi olmalarını beklememek gerek demek ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
