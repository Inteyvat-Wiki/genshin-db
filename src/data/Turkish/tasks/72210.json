			},
			"dialogs": [
				{
					"id": 722100401,
					"content": "Buldun mu yavruları?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100402
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100402,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100403
					]
				},
				{
					"id": 722100403,
					"content": "Bana bakın! Niye hiç beni dinlemiyorsunuz? Neden Meshi gibi uslu durmuyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100404
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100404,
					"content": "Meshi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100405
					]
				},
				{
					"id": 722100405,
					"content": "Hahaha, adlarını cidden iyi şeylerden almışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100406,
					"content": "Miyav, miyav miyav miyav... miyav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100407
					],
					"speakerTitle": "\"Hachihou\""
				},
				{
					"id": 722100407,
					"content": "Miyav! Miyav miyav!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100408
					],
					"speakerTitle": "\"Konbumaru\""
				},
				{
					"id": 722100408,
					"content": "Cevap istemiyorum! Yoksa ne haliniz varsa görürsünüz ve... güneş doğup batana, sonra tekrar doğana kadar aç kalırsınız, evinizin yolunu da kendiniz bulursunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100409
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100409,
					"content": "Miyav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100410
					],
					"speakerTitle": "\"Konbumaru\""
				},
				{
					"id": 722100410,
					"content": "Hah şöyle. Tamam, tamam. Dönmenize sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100411
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100411,
					"content": "Size borçlandım. Yardımınız olmasa bu veletler dışarıda aç susuz kalacaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100412
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100412,
					"content": "Kendileri dönerlerdi buraya bence.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100413
					]
				},
				{
					"id": 722100413,
					"content": "Ne olursa olsun size minnettarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100414
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100414,
					"content": "Vaktiniz olursa arada uğrayın. Yardımınızı gerektiren başka mevzular da olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
