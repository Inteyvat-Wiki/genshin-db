			},
			"dialogs": [
				{
					"id": 722100101,
					"content": "Ah, miyav, miyav... Nereye gitti bunlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100102,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100103
					]
				},
				{
					"id": 722100103,
					"content": "Ah, sizsiniz. Veletlerin bir kısmı kaçtı gitti, nereye gittiklerini bilmiyorum. Çok endişeleniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100104,
					"content": "Dışarısı çok tehlikeli. Onları defalarca kez eğittim ama çubuk taşıyan kıllı yabaniler, ateş ile su topları hâlâ büyük tehlike arz ediyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100105,
					"content": "Hele şu can yakıcı, enerji yüklü yere giderlerse vücutlarındaki bütün tüyler korkudan diken diken olur. Bu veletlerin başlarına böyle bir şey gelmesini hiç istemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100106,
					"content": "Aralarında laf dinlemeyip gezip tozanları mutlaka oluyor ama. Onları eve getirebilmek için dişimi tırnağıma takıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100107
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100107,
					"content": "Yine bugün birkaçı kaçtı. Onlar için çok endişeleniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100108,
					"content": "Konbumaru ve Hachihou'yu bulmak için yardımın lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100109,
					"content": "Konbumaru da kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100110
					]
				},
				{
					"id": 722100110,
					"content": "İyi çocuktur. Bu neslin Konbumaru'su bayağı akıllı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100111,
					"content": "\"Bu neslin\" mi dedin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100112
					]
				},
				{
					"id": 722100112,
					"content": "Hibiki arada bundan bahsederdi. Pek anlayamasam da ne zaman Konbumaru'dan bahsetse yüzünün aldığı şekilden ötürü bunun iyi bir şey olduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100113,
					"content": "Ben de bu ufaklıklara iyi şeylerin isimlerini verdim. Sonra bu ufaklıklar büyüyüp buralardan gidince aynı isimleri ufak kediler için tekrar kullanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100114,
					"content": "Konbumaru yüksek yerlerde uyumaya bayılır, oralardan başlasan iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100115,
					"content": "O zaman Hachihou da...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100116
					]
				},
				{
					"id": 722100116,
					"content": "Pek atik bir ufaklık. Balık yemeye de bayılır. Bazen karaya vuran balıkları bulmak için deniz kıyısına gidiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100117,
					"content": "Bu ama çok tehlikeli. Su korkunç bir şey. Çok ama çok uzun zaman önce... Tanukiydi galiba... Neyse işte, bu arkadaş bir keresinde suya düştü, neredeyse kurtulamıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100118
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100118,
					"content": "Hachihou'yu tuzlu su kaynağı yakınlarında balık veya yengeç ararken bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100119,
					"content": "Bulması epey vakit alacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100120
					]
				},
				{
					"id": 722100120,
					"content": "Cidden mi? Tuzlu su kaynağı olan yüksek bir yer işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100121
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100121,
					"content": "Neko'ya haritamızı göstersek mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722100122,
					"content": "Siz... Cidden kavrama yetiniz hiç yok. İşte burası yüksek yer, burası da tuzlu su kaynağı. Buralarda bir yerde olmalılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100123,
						722100125
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100123,
					"content": "Bize bırak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100124
					]
				},
				{
					"id": 722100124,
					"content": "O zaman size bıraktım gitti miyav. Ah çocuklar ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100125,
					"content": "Kedi yakalamaktan pek anlamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722100126
					]
				},
				{
					"id": 722100126,
					"content": "Miyav, miyav. Hiç dert etme. Bu ufaklıklar insanlardan korkmuyorlar zaten. Hatta onlarla oynayan insan olmadığı için durup durup evden kaçıyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100127
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722100127,
					"content": "O zaman size bıraktım gitti miyav. Ah çocuklar ah...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		},
