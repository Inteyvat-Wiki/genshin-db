					"nextDialogs": [
						722100304
					]
				},
				{
					"id": 722100304,
					"content": "Miyav miyav? Miyav...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722100307
					],
					"speakerTitle": "\"Konbumaru\""
				},
				{
					"id": 722100307,
					"content": "Hehe, çok vahşi göründü ama kucağına almana izin veriyor, ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
