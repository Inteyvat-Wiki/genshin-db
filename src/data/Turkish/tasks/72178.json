			"dialogs": [
				{
					"id": 721780101,
					"content": "(Burası sıradan bir tapınağa benziyor. Etrafta sıra dışı bir element izi yok gibi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780102
					],
					"speakerTitle": "Tapınak"
				},
				{
					"id": 721780102,
					"content": "Araştır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780103
					]
				},
				{
					"id": 721780103,
					"content": "(Tapınak gayet iyi durumda ve yakın zamanda özenle bakımı yapılmış. Bunu kim yaptıysa oldukça özenliymiş.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780104
					],
					"speakerTitle": "Tapınak"
				},
				{
					"id": 721780104,
					"content": "(Ondan başka kimsenin buraya geldiğine dair bir iz yok.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780105
					],
					"speakerTitle": "Tapınak"
				},
				{
					"id": 721780105,
					"content": "Çok tuhaf... Sanki birisi daha önce buraya gelmiş gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7217802,
