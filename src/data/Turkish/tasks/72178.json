					"nextDialogs": [
						721780304
					]
				},
				{
					"id": 721780304,
					"content": "(Bu tapınağın ahşabı oldukça eski ama iyi bakılmış. Bu sayede yaşına göre döküntü gibi durmanın aksine oldukça çekici görünüyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780305
					],
					"speakerTitle": "Tapınak"
				},
				{
					"id": 721780305,
					"content": "Görünüşe göre birileri sık sık tapınağa gelip tapınakla ilgileniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
