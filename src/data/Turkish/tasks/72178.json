					"nextDialogs": [
						721780504
					]
				},
				{
					"id": 721780504,
					"content": "(Bu tapınak oldukça bakımsız duruyor. Ahşap yüzde oyuklar var ve rengi solmuş. Altında da tehlikeli koyu kırmızı çizgiler beliriyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
