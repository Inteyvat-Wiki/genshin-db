			"dialogs": [
				{
					"id": 721780401,
					"content": "Burası Chouji'nin bahsettiği tapınak herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780402,
					"content": "(Burası sıradan bir tapınağa benziyor. Etrafta sıra dışı bir element izi yok gibi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780403
					],
					"speakerTitle": "Tapınak"
				},
				{
					"id": 721780403,
					"content": "Araştır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780404
					]
				},
				{
					"id": 721780404,
					"content": "(Tapınak oldukça basit ancak bir o kadar da zarif. Ağaçları, misafirleri ve onların adaklarını kutsal bir sessizlik içerisinde karşılarcasına parıldıyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780405
					],
					"speakerTitle": "Tapınak"
				},
				{
					"id": 721780405,
					"content": "(Kutsal Kiraz Ağacı yaprakları tapınağın dört bir yanına yayılmış ancak bu kendi kendine olmuş gibi görünmüyor, tam tersine birisi Kiraz Çiçeklerini kasıtlı olarak etrafa koymuş olmalı.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780406
					],
					"speakerTitle": "Tapınak"
				},
				{
					"id": 721780406,
					"content": "Burada da pek bir ize rastlamadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780407,
						721780408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780407,
					"content": "Bak, Kiraz Çiçekleri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				},
				{
					"id": 721780409,
					"content": "Tabii ya. Chouji, annesinin bu tapınağa adak adayacağını söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780410,
					"content": "Burada da çok fazla yaprak var, bu bir tesadüf olamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780411,
					"content": "Hadi geri dönüp ona haber verelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780408,
					"content": "Bu Chouji'nin annesinin adağı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780409
					]
				}
			]
