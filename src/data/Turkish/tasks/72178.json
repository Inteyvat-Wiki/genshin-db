			"dialogs": [
				{
					"id": 721780201,
					"content": "Şurada bir tapınak daha var. Ona da bakalım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780202,
					"content": "(Burası sıradan bir tapınağa benziyor. Etrafta sıra dışı bir element izi yok gibi.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780203
					],
					"speakerTitle": "Tapınak"
				},
				{
					"id": 721780203,
					"content": "Araştır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721780204
					]
				},
				{
					"id": 721780204,
					"content": "(Tapınak tertemiz yapılmış ve hafif bir Kutsal Kiraz Ağacı kokusu yayıyor. Yakın zamanda birileri burada dua etmiş.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780205
					],
					"speakerTitle": "Tapınak"
				},
				{
					"id": 721780205,
					"content": "(Bundan başka yeni bir iz yok.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780206
					],
					"speakerTitle": "Tapınak"
				},
				{
					"id": 721780206,
					"content": "Bu koku... Kutsal Kiraz Ağacı! Chouji'nin annesi buraya uğramış olabilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721780207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721780207,
					"content": "Hem de oldukça yakın bir zamanda!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
