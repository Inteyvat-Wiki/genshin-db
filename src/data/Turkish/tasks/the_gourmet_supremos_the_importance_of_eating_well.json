			"dialogs": [
				{
					"id": 220160701,
					"content": "Bu ikisine inanamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160702,
						220160705,
						220160713
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160702,
					"content": "Hâlâ ona pek güvenemiyor gibisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160703
					]
				},
				{
					"id": 220160703,
					"content": "Kamei Munehisa'ya mı? Tabii ki de güvenmiyorum... Yalnızca birkaç defa karşılaştık, nasıl öyle kolay güvenebilirim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160704
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160704,
					"content": "Ama Kamei Munehisa'ya güvenmesem de Xudong'un muhakemesine güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160705,
					"content": "Akademiden misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160706
					]
				},
				{
					"id": 220160706,
					"content": "Sayılır. Xudong'la Liyue'de tanıştığımda Akademide saha araştırması yapıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160707
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160707,
					"content": "Seyahat edip tarifler üstüne çalışmak istiyordu ve benim çalışma konum da yiyeceklerle ilgiliydi. Birkaç defa konuştuktan sonra birlikte seyahat etmeye karar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160708
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160708,
					"content": "İlk olarak, etrafımızın bir avuç canavarla çevrildiği Mondstadt'a gittik. Julie de orada geldi ve canavarları kovmamıza yardım etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160709
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160709,
					"content": "Seyahat edip farklı yemekleri araştırdığımızı öğrenince bize katıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160710
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160710,
					"content": "Maceraya çıkmayı düşündüğünü söylemişti ama sırf canı iyi yiyecek istedi diye geldiğini de düşünmüyor değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160711
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160711,
					"content": "Buradan sonra Sumeru'ya geçeceğiz. Araştırmam neredeyse bitti, yani Akademiye geri dönmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160712
					],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160712,
					"content": "Sumeru'ya vardığımızda hepsine yerel yemeklerimizden yedireceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Parvaneh"
				},
				{
					"id": 220160713,
					"content": "Hoşça kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160714
					]
				},
