					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160803
					]
				},
				{
					"id": 220160803,
					"content": "Xudong'un dediği gibi, yeterince yemeğim olsun istiyorsam... Onun için çalışmak şu anda elimdeki en iyi seçenek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160804
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160804,
					"content": "Ayrıca Julie ve Xudong'un çok sağlam bir ahlak anlayışı var, ikisiyle de seyahat etmek bir onurdur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160805
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160805,
					"content": "Parvaneh... Düşünceli bir insan. Bana karşı temkinli olmasını anlayabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160806
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160806,
					"content": "Ayrıca beni hemen reddetmektense yalnızca biraz şüphelendi ve bu... Benim için yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160807,
					"content": "Cidden öyle etrafta geziniyor muydun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160808
					]
				},
				{
					"id": 220160808,
					"content": "Aynen öyle. Ben asla yalan söylemem. Şogunluktan ayrıldığımdan beri öyle gezinip duruyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160809
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160809,
					"content": "Genelde karnımı yabani meyvelerle doyuruyorum, çok şanslıysam da taze av yiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160810
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160810,
					"content": "Ayrıca zaman zaman insanların canavarlarla ya da Kairagiyle savaşmasına yardım ediyorum ve böylece biraz para kazanabiliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160811
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160811,
					"content": "Hehe... Benim gibi kılıç tutmaktan başka becerisi olmayan biri için pek iş fırsatı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160812
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160812,
					"content": "Ayrıca Şogunluktan ayrılma geçmişimden bahsetmiyorum bile. İnsanlar beni hep Kairagiyle ilişkilendiriyor ve bu da iş bulmayı iyice zorlaştırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160813
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160813,
					"content": "Inazuma'da gidebileceğim bir evim ya da ailem yok. Gidecek hiçbir yerim olmayınca ben de öylece gezindim işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160814,
					"content": "Şogunluktan neden ayrıldın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160815
					]
				},
				{
					"id": 220160815,
					"content": "Şogunluğun Inazuma'da yaptığı şeyi kabullenemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160816
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160816,
					"content": "Ben sadece bir dövüş ustasıyım. Neyin ülkenin iyiliğine olup olmadığını bilemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160817
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160817,
					"content": "Yalnızca olanların vicdanıma uymadığını biliyordum ve bu nedenle ayrılmayı tercih ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220160818
					],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160818,
					"content": "Hehe. Belki de çok eski kafalı davranmışımdır... Lütfen gülmemeye çalışın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kamei Munehisa"
				},
				{
					"id": 220160819,
					"content": "Görüşmek üzere.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220160820
					]
				},
