			"trigger": {
				"objectNames": [
					"Adan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780401,
					"content": "Merhaba, nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780402,
						190780403
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780402,
					"content": "Alkami adında birini tanıyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				},
				{
					"id": 190780404,
					"content": "Ah, Alkami mi? Son zamanlarda iyice adından söz ettiren zengin adamdan mı bahsediyorsun? Evet, geçenlerde benden bir mobilya takımı yapmamı istedi ve karşılığında epey yüklü bir Mora verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780405
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780405,
					"content": "Ünlü bir mimar olduğunu ve bu sayede bu kadar kazandığını duymuştum. Şimdi de başkalarına yol gösterebilmek için kendi eğitim merkezini açmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780406
					],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780406,
					"content": "Öğrenim ücreti çok yüksek olmasaydı ben de çocuğumu hemen kaydettirmek isterdim. Mimarlık, kazancı epey iyi olan bir meslek gibi duruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Adan"
				},
				{
					"id": 190780403,
					"content": "Alkami hakkında bir şey biliyor musun acaba?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190780404
					]
				}
			]
		},
