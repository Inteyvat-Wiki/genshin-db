			"trigger": {
				"objectNames": [
					"Aabid",
					"Adil"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190780801,
					"content": "Duydun mu? Kaveh, Alkami'nin orada öğretmenlik yapacakmış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780802
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780802,
					"content": "Heh, kesin daha çok kişi gidip kaydolur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780803
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780803,
					"content": "Cidden kıskandın, ha? Bir düşününce, Alkami bir mimar olarak hiçbir zaman o kadar yetenekli değildi. Sadece mesleki becerilerine bakarak kimse ondan ders almak istemezdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780804
					],
					"speakerTitle": "Aabid"
				},
				{
					"id": 190780804,
					"content": "Doğru, ama tanıtım konusunda iyi iş çıkarıyor kabul etmek lazım... Sonuçta Akademi, sadece giriş sınavını geçenleri kabul ediyor. Bu yüzden Kshahrewar'ın sınıflarında mimarlık eğitimi almaya yalnızca çok az sayıda kişi erişebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780805
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780805,
					"content": "Sınavı geçemeyenler ya da doğrudan sektöre atılmak isteyenler de eğitim merkezine Mora kazandırıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190780806
					],
					"speakerTitle": "Adil"
				},
				{
					"id": 190780806,
					"content": "Yani, böyle bir ticari zekaya sahip olmak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aabid"
				}
			]
		},
