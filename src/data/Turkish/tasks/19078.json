			},
			"dialogs": [
				{
					"id": 190785001,
					"content": "Kaveh Hoca gerçekten kızgın görünüyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785002
					],
					"speakerTitle": "Uzayr"
				},
				{
					"id": 190785002,
					"content": "Kim takar onu? Belki de mezun olunca bütün projeleri elinden almamızdan korkuyordur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785003
					],
					"speakerTitle": "Waiz"
				},
				{
					"id": 190785003,
					"content": "A-Ama o kadarı da olamaz, değil mi? Kaveh Hoca çok ünlü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190785004
					],
					"speakerTitle": "Tanisha"
				},
				{
					"id": 190785004,
					"content": "Kim bilir? Babam hep, biri ne kadar ünlü olursa kibri de inatçılığı da o kadar çok olur derdi. Bay Alkami gibi cana yakın insanlara denk gelmek zor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Waiz"
				}
			]
		},
