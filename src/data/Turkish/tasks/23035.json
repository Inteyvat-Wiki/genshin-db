			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fukumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350301,
					"content": "Şşş... Oradaki Cyno değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350302
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350302,
					"content": "Kıyafetine, saç tarzına ve rengine bakın... Bir kart oyunu romanındaki kahramanın tam da böyle görünmesi gerekir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350303,
						230350305
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350303,
					"content": "Bunun ne anlamı var, ne de manası...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350304
					]
				},
				{
					"id": 230350304,
					"content": "Heh, piyasada benim içgüdülerime güven. Şimdi açıklamanın zamanı değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350309,
					"content": "Gezgin, lütfen Cyno'dan benim romanım için modellik yapmasını iste... Sana güveniyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350305,
					"content": "Bu kategoriye girebilecek oldukça fazla kişi tanıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350306
					]
				},
				{
					"id": 230350306,
					"content": "Gerçekten mi? Harika. \"Yakarışların Kralı\"nın üçüncü kitabı üzerinde çalışıyorum ve bu sefer Dehanın Yakarışı Kart Oyununun oynama mekaniği üzerinde durmayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350307
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350307,
					"content": "Yepyeni bir oyun oluşturmaya karar verdim. Örneğin... Alandaki tüm kartlar havada kalır ve oyuncular bir sonraki hamlelerini düşünürken onları toplamak zorundadır; bu da rakiplerin kartları toplamasını engeller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350308
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350308,
					"content": "Hahaha! Bunu düşünmek bile çok eğlenceli! Ama şimdi bunun sırası değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "Fukumoto"
				}
			]
		},
		{
			"id": 2303504,
			"completionStepIds": [
				2303504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303504",
							"2"
						],
						"stepId": 2303504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Cyno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350401,
					"content": "... Hımm, bu kart kombinasyonu o kadar da fena olmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350402
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350402,
					"content": "Ama herhangi bir seri saldırıyla başa çıkabilecek kadar güçlü değiller...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350403
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350403,
					"content": "Neler yapıyorsun, Cyno?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350404
					]
				},
				{
					"id": 230350404,
					"content": "#{NICKNAME}, sen misin? Seni burada görmeyi hiç ummazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350405
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350405,
					"content": "Dehanın Yakarışı Kart Oyunu kartlarım ile yavaş saldırı hızına sahip bir deste oluşturmaya çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350406
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350406,
					"content": "Bu desteyi kullanan oyuncu bolca zengin kaynak ve çeşitli güçlü kartlar elde edecek diye umuyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350407
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350407,
					"content": "Ama dürüst olmak gerekirse böyle bir desteyi oluşturmak epey zor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350408
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350408,
					"content": "Mevcut durumdaki Dehanın Yakarışı Kart Oyununda, bazı oyuncular hızlı saldırı kartlarını kullanmayı tercih ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350409
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350409,
					"content": "Oyunun başındayken rakiplerini hızlı bir şekilde yenmek için çok sayıda kart oynarlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350410
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350410,
					"content": "Ama bu taktiği pek sevdiğim söylenemez. Çeşitli yöntemlerle kaynak biriktirmeye devam etmeyi tercih ederim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350411
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350411,
					"content": "Mümkün olan her fırsatı değerlendirmek, avantajlar biriktirmeye devam etmek ve nihai zaferi garantilemek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350412
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350412,
					"content": "Evet! İşte bu! Harika, evet! Aynı romanımdaki ana karakter gibisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350413
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350413,
					"content": "Özür dilerim! Şey... Ben...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350414,
						230350415
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350414,
					"content": "Bu Fukumoto.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350415,
					"content": "Bu da \"Yakarışların Kralı\"nın yazarı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350416,
					"content": "Merhaba General Mahamatra. Beni duyduğunuzu pek sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350417
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350417,
					"content": "Romanınızı okudum, çok güzeldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350418
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350418,
					"content": "Gerçekten onur duydum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350419
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350419,
					"content": "Romanda, kahraman ne zaman dezavantajlı bir duruma düşse, destesinde olmayan bir kartı daima çeşitli yollarla almayı başarıyor ve sonra da rakibini yeniyor. Bu bende kalıcı bir etki bıraktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350420
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350420,
					"content": "Roman yazmanın yaratıcı özgürlük gerektirdiğini anlıyorum ama bu kazanma yöntemi, Dehanın Yakarışı Kart Oyununun temel mekaniğinden biraz uzaklaşmış gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350421
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350421,
					"content": "Ha, o konuya gelince... Dehanın Yakarışı Kart Oyununu çok oynamama rağmen, yine de bu oyunda çok iyi olduğum söylenemez... Ayrıca, düellolarla ilgili yazarken gerçekten rekabetçi düşünceyi kullanırsanız, bu hiç de ilginç bir hikaye olmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350422
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350422,
					"content": "Hımm, öyle mi? Tesadüfe bak ki ben de az önce iki deste yaptım. Birkaç tur Dehanın Yakarışı Kart Oyunu oynayabiliriz. Bakarsın belki sana da biraz ilham gelir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350423,
						230350424
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350423,
					"content": "(Birazdan kart oynayacaklar...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350424,
					"content": "(Bu adamın tek derdi kart oynamak değildir herhalde...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350425,
					"content": "Eee? Kiminle oynuyorum? Sizinle mi? Çok mutlu olurum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350426,
						230350427
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350426,
					"content": "Bir saniye açıklayayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350427,
					"content": "Fukumoto'nun isteğine gelince...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350428,
					"content": "Cyno'ya Fukumoto'nun isteğinden bahsediyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230350429,
					"content": "\"Yakarışların Kralı\"ndaki çizimler için modellik yapmamı mı istiyorsun? Tamam, hiç sorun değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350430
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350430,
					"content": "Harika! Gezgin, acele et! Hemen fotoğrafımızı çek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				}
			]
		},
