			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fukumoto"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350101,
					"content": "*iç çeker* Inazuma'ya geri dönmek istiyorum... Başıma nasıl böyle bir şey gelebilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350102,
						230350103
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350102,
					"content": "Sorun nedir?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				},
				{
					"id": 230350104,
					"content": "Gezgin? *iç çeker* Romandan bahsetme bile. Dehanın Yakarışı Kart Oyunu üzerinde çalışan araştırmacılar biraz zor durumdalar sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350105
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350105,
					"content": "Çok iyi tanıdığım bir araştırmacıya göre ekip, kafa karıştırıcı her türlü zorlukla karşılaştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350106
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350106,
					"content": "Örneğin, bir Haravatat araştırmacısı bir gün aniden bir soru sormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350107
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350107,
					"content": "Kartların üzerindeki kart efekti açıklamalarının çok uzun olduğunu, bu durumun uzun metin paragraflarını okumaya alışkın olmayan insanları oyun oynamaktan caydırabileceğini söylemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350108
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350108,
					"content": "Araştırmacılar uzun metinleri okumaya alışkındır ve bu sorun olmaz ancak uzun açıklamalar birçok okuyucuyu uzaklaştırabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350109
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350109,
					"content": "Bu yüzden, okuması kolay olacak şekilde bazı kartlardaki metin miktarını yarı yarıya azaltmayı önermiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350110,
						230350111
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350110,
					"content": "Böyle bir şeye gerçekten gerek var mı ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350112,
					"content": "Bence bu hiç sorun teşkil etmiyor... Ancak araştırmacılar halen konu üzerinde çalışıyorlar. Bu durum, sonuçta oyuncuların deneyimleriyle ilgili ve ne kadar az sorun olursa bizim için de o kadar iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350113
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350113,
					"content": "Her neyse... Daha büyük bir problem var. Bana romanım için model bulacaklarına söz vermişlerdi ancak bunda da bir şeyler ters gitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350114
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350114,
					"content": "Hatırlıyor musun? Sana daha önce romanıma ilham olması için beni Tighnari ve Cyno ile tanıştıracağını söyleyen bir araştırmacıdan bahsetmiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350115
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350115,
					"content": "Ama onlar şu anda çok meşguller. Onlara pek bel bağlayabileceğimi sanmıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350116,
						230350117
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350116,
					"content": "İyi de ne yapacaksın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350118,
					"content": "Beni karşılayan araştırmacı, bu konuda bana yardımcı olamadı ama bana bir fikir verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350119
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350119,
					"content": "Cyno'nun, kart oynamak için bazen Puspa Kafeye gittiğini söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350120
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350120,
					"content": "Eğer istersem... Şansımı önce orada deneyebilirim. Ya da vakitleri olduğunda, kendileri iletişime geçmeme yardım ederler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350121
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350121,
					"content": "Sen ne düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350122
					]
				},
				{
					"id": 230350122,
					"content": "*iç çeker*... Yani onların eli boş olduğunda, ben de ancak romanıma devam etmiş olurum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350123
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350123,
					"content": "Sanırım, kendim gidip Cyno'yu arayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350124
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350124,
					"content": "Olur da şansım yaver giderse ve Cyno'yu o kafede bulursam, kendimi ona nasıl tanıtacağım ki? Off, iki arada bir derede kaldım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350128,
						230350129
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350128,
					"content": "Ben yardım ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350130,
					"content": "Gerçekten mi? Harika! Ama sen nasıl oluyor da... Ah, neyse ne. Artık her şeyi merak etmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350131
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350131,
					"content": "O zaman daha neyi bekliyoruz? Hadi o zaman hemen Puspa Kafeye! Umarım ki Cyno'yu yakalayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350129,
					"content": "Cyno'yu iyi tanırım ben.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350117,
					"content": "Nasıl iletişime geçeceksin peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350111,
					"content": "Gerçekten bu kadar uzun mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350103,
					"content": "Yazar ilhamını mı kaybetmiş?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				}
			]
		},
		{
			"id": 2303503,
			"completionStepIds": [
				2303503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
