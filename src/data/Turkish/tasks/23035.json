					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230350601,
					"content": "Bunun çok yardımı olacak. Eminim ki Asagiri buna bakarak güzel bir resim çizecektir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350602
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350602,
					"content": "Çok teşekkürler Cyno. Romanım basılır basılmaz sana mutlaka bir kopyasını göndereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350603
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350603,
					"content": "Cyno, elinde iki deste mi var senin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350604
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350604,
					"content": "Birkaç el Dehanın Yakarışı Kart Oyunu oynayacağız diye söz vermemiş miydin bana?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350605
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350605,
					"content": "Şey, yani ben... Ben çok iyi oynayamıyorum, bu yüzden... Gezgin, sen benden çok daha iyisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350606,
						230350607
					],
					"speakerTitle": "Fukumoto"
				},
				{
					"id": 230350606,
					"content": "Ben daha önce hiç oynamadım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350608
					]
				},
				{
					"id": 230350607,
					"content": "Bu işte iyisin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350608
					]
				},
				{
					"id": 230350608,
					"content": "O zaman şöyle yapalım. İşte, al bu hızlı saldırı destesini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350609
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350609,
					"content": "Ve ben de bu yavaş saldırı destesini kullanacağım; bakalım saldırılarınla nasıl baş edeceğim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350610
					],
					"speakerTitle": "Cyno"
				},
				{
					"id": 230350610,
					"content": "Elimden geleni yapacağım, Cyno...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fukumoto"
				}
			]
