			"dialogs": [
				{
					"id": 722120301,
					"content": "*iç çeker* Ne zaman bir iş bulacağım ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120302
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120302,
					"content": "Bana mı bakmıştın? Konu nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120303,
						722120304
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120303,
					"content": "Nasıl taş oyma yapacağını biliyor musun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				},
				{
					"id": 722120305,
					"content": "Ne? Ha... Ha, bu harika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120306
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120306,
					"content": "Ah pardon, kendimi tanıtmayı unutmuşum. Adım Ooshima Junpei. Eskiden Tatarasuna'da çalışıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120307
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120307,
					"content": "Malum kazadan sonra hepimiz tahliye olduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120308
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120308,
					"content": "İşe dönmemiz konusunda hâlâ bir bildiri gelmedi, bunca zamandır ben de burada boş boş duruyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120309
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120309,
					"content": "Taş oymacılığı yapabilen birini arıyorsunuz demek. Aslında uzmanlık alanım bu değil ama pek fena sayılmam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120310
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120310,
					"content": "Ne tür bir taş oymacılığı gerekiyor size? Söyleyebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120311
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120311,
					"content": "Durum şöyle...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120312
					]
				},
				{
					"id": 722120312,
					"content": "Bir dakika... Konuşan bir kedi sizden onun heykelini yapması için zanaatkar bulmanızı istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120313
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120313,
					"content": "Hani inanmadığım için falan değil ama sanki... Biraz fazla garip bir hikaye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120314
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120314,
					"content": "Kabul ettiğimi varsaysak bile sizin şu... geçici başrahibe bana nasıl ödeme yapacak? Kim ne derse desin bedavaya çalışmam ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120315
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120315,
					"content": "Rahatla, hiç sorun çıkmayacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120316
					]
				},
				{
					"id": 722120316,
					"content": "(Gerçekten çıkmayacak mı acaba?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120317,
					"content": "Çıkmayacak mı? Hımm, sanki beni dolandırıyorsunuz gibi geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120318
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120318,
					"content": "Yine de eh, salla gitsin. Bomboş duruyorum ne de olsa. Sizinle gelip bir göz atmamda bir sakınca yok, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120319
					],
					"speakerTitle": "???"
				},
				{
					"id": 722120319,
					"content": "Ödeme alabilsem bari...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "???"
				},
				{
					"id": 722120304,
					"content": "Taşları işleyebilecek bir zanaatkar arıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120305
					]
				}
			]
		},
