			"dialogs": [
				{
					"id": 722120601,
					"content": "Taş kadar sert bir şey benim suretime nasıl girecek çok merak ediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120602
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120602,
					"content": "Taş insan bu kadar güçlü mü? Büyü yapabiliyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120603,
						722120605
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120603,
					"content": "Hem de nasıl güçlü...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120604
					]
				},
				{
					"id": 722120604,
					"content": "Anlıyorum. Ne güzel!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120605,
					"content": "Yemek yaptığımız zaman vardı ya, ona benziyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120606
					]
				},
				{
					"id": 722120606,
					"content": "Ah, anlıyorum. Hibiki ve senin yaptığınız yemekler iyi şeylerdi. Taş insanın yontacağı taş da o zaman iyi bir şey olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120607
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120607,
					"content": "İnsanlar yer yer yetenekli olabiliyormuş demek. Teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				}
			]
		}
