			"dialogs": [
				{
					"id": 722120101,
					"content": "Mükemmel zamanlama. Bir kez daha yardım etmen gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120102,
					"content": "Söyle bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120103
					]
				},
				{
					"id": 722120103,
					"content": "İsteğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120104,
					"content": "Bu tapınağın yanına benim suretimde uzun ve büyük bir taş koymanı istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120105,
					"content": "Nereden bulacağız öyle bir taşı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120106,
					"content": "Heykel demek istiyor Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120107
					]
				},
				{
					"id": 722120107,
					"content": "Neyse ne, şu çok uzak adadaki tilki taşları gibi bir şey istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120108
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120108,
					"content": "Eskiden Hibiki o adada onlardan bir sürü olduğunu söylerdi. Hatta öyle bir şey ister miyim diye de sormuştu bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120109,
					"content": "Hibiki istediyse bence bu iyi bir şey olmalı. Bu yüzden sizden böyle bir taş yapmanızı istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120110,
						722120113
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 722120110,
					"content": "Taş oymaktan da hiç anlamam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120111
					]
				},
				{
					"id": 722120111,
					"content": "Hımm, ne yapacağız şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120112,
					"content": "Tamam, gidip Taisuke'ye soralım. Kedileri çok seviyor. Hatta sırf Neko'ya yardım edebilmek için oymacılığı öğrenir belki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 722120113,
					"content": "Galiba Taisuke'ye sormaktan zarar gelmez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120114
					]
				},
				{
					"id": 722120114,
					"content": "Doğru! Kedileri çok seviyor! Belki o bize yardım eder!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7221202,
			"completionStepIds": [
				7221202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
