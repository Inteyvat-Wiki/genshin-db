			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Taisuke",
					"Eiko"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722120201,
					"content": "Ah, merhabalar. Neler yapıyorsunuz bugün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120202
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120202,
					"content": "Neko'ya heykel yapıyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120203
					]
				},
				{
					"id": 722120203,
					"content": "Ah... Ne? Heykel mi? Burada mı? Cidden mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120204
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120204,
					"content": "Hemen oymacılığa başlıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120205
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120205,
					"content": "O kadar vaktimiz olmayabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120206
					]
				},
				{
					"id": 722120206,
					"content": "Hımm, Neko yine başka bir şey mi istedi sizden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120207
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722120207,
					"content": "Bak ne diyeceğim, Tatarasuna'da yaşanan bunca sorundan sonra iş arayan usta bulman pek zor olmaz bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120208
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722120208,
					"content": "Loncaya bununla ilgili bir sürü görev gelmişti. Ayrıca bazı insanların Tatarasuna'da hâlâ iş aradığını duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120209
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722120209,
					"content": "Hatta bir görev esnasında böyle bir yerleşkeye denk geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120210
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722120210,
					"content": "Yani isterseniz şansınızı orada deneyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120211,
						722120212
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722120211,
					"content": "Teşekkürler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120214
					]
				},
				{
					"id": 722120214,
					"content": "Hah, boş ver gitsin. O kadar da zor değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120215
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722120215,
					"content": "Ayrıca bu tapınağın tekrardan capcanlı bir yer olmasını görmek isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120216
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722120216,
					"content": "Neko'nun hakkında konuşup durduğu şu \"Hibiki\"yi de görmek isterim. Bir kedi, bir insanı nasıl bu kadar sevebilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120217
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722120217,
					"content": "Neyse, beni boş verin. Kendi kendime konuşuyorum. Gidin şu zanaatkarı arayın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120218
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722120218,
					"content": "Kaya oymacılığı bilip bilmediğine gelince... Orası da senin şansına bağlı artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120219
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722120219,
					"content": "Yapma ama Eiko Hanım, sen de Leydi Neko'ya yardım etmek istiyorsun işte. Haha, pek de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120220
					],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120220,
					"content": "Taisuke, inceleme planımız hâlâ bitmedi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120221
					],
					"speakerTitle": "Eiko"
				},
				{
					"id": 722120221,
					"content": "Ah, neredeyse bitiyor. Pardon...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taisuke"
				},
				{
					"id": 722120212,
					"content": "Her zamanki halinden biraz farklısın Eiko.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722120213
					]
				},
				{
					"id": 722120213,
					"content": "Ne oldu, önden bilgi vermeme alışkın değil misin yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722120214
					],
					"speakerTitle": "Eiko"
				}
			]
		},
