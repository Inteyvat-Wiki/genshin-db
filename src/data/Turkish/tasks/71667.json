			"trigger": {
				"objectNames": [
					"Ranjit"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716670101,
					"content": "Aa, geldiniz sonunda! Kök salacaktım neredeyse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670102
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670102,
					"content": "Yalancı Ateş Ağacıyla arkadaş oldun mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670103
					]
				},
				{
					"id": 716670103,
					"content": "Of, hiç sorma. Sen yaptığın \"müzakere\" ile bir süre sakinleştirmeyi başardın... Ama çok, çok kısa sürdü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670104
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670104,
					"content": "İyileştiği anda yine bana saldırmaya başladı! ... Var ya, aslında sen haklıymışsın. Bu canavarla arkadaş olmak mümkün değilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670105
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670105,
					"content": "Yine de meyvesi gayet lezzetli, sanki Ateş gibi. Natlan'daki dostlarımın da beğeneceğini düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670106
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670106,
					"content": "Tadı neye benziyor ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670107,
					"content": "Denemek ister misin? Eğer istersen ben hemen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670108
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670108,
					"content": "Iıı, yani, yok sağ ol! Neyse, şimdi sırada Kadim Toprak Ejderi mi var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670109,
					"content": "Evet. Bu defa iyi sonuç alacağımızı düşünüyorum. Kadim Toprak Ejderleri, Tepetlizorlara epey benziyor ne de olsa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670110
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670110,
					"content": "Benim yaptığım gibi Natlan'a Sumeru üzerinden gidecek olursan ilk onlarla karşılaşırsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670111
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670111,
					"content": "Tamam, sen nasıl istersen. Gerçi Paimon'un pek bir umudu yok yine... Neden Ejder Yavrularını seçmedin ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670112,
					"content": "... Onların karınları toparlak değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670113
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670113,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 716670114,
					"content": "Toprak Ejderi Yavrularının karınları toparlak değil. Muhtemelen hızlıca yuvarlanıp durmaları yüzünden. Sürekli yağ yakıyorlardır öyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670115
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670115,
					"content": "*iç çeker* Ama asıl sebebi... Etkisinin az olması. Sürüngenlerle yaşayan dostlarım için bir Ejder Yavrusu ne ifade eder ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670116
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670116,
					"content": "Ama tabii Kadim Toprak Ejderi olunca iş başka. Sadece hikayesi için bile buna değer. Hem güçlü bir kahramanın rakibi de güçlü olmalı, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670117
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670117,
					"content": "Tamam, hadi vakit kaybetmeyelim o zaman. Kadim Toprak Ejderi bekler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716670118,
						716670119
					],
					"speakerTitle": "Ranjit"
				},
				{
					"id": 716670118,
					"content": "Gidelim bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 716670119,
					"content": "Halletmem gereken başka işler var. Birazdan görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716670120
					]
				},
				{
					"id": 716670120,
					"content": "Sorun değil. Ben seni burada bekliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Ranjit"
				}
			]
		}
	]
}