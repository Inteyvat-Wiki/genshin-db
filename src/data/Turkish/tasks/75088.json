			"dialogs": [
				{
					"id": 750880101,
					"content": "Peki o Işıltılı Yazıt parçalarını buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		},
		{
			"id": 7508802,
			"completionStepIds": [
				7508802
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508802",
							"2"
						],
						"stepId": 7508802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880201,
					"content": "Haha! Güzel, güzel! Yakında Yazıtların altın desenlerindeki şifreleri çözeceğim... Sonra da... Ödüller benim olacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880202
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880202,
					"content": "Aslında pek bir seçeneğim de yok, tekrar başarısız olursam tüm param bitecek. Ya batacağım ya çıkacağım yani!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880203
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880203,
					"content": "Ha bu arada, işte ödemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		},
		{
			"id": 7508803,
			"completionStepIds": [
				7508803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7508803",
							"2"
						],
						"stepId": 7508803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Chuno"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750880301,
					"content": "Hımm, elimde yeteri kadar numune olsaydı belki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880302
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880302,
					"content": "Şuna bir bakar mısın? Tuhaf biri burada mırıldanıp duruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880303,
					"content": "Ben mi? Natlan'da benim gibi bir sürü insan var. Burada tuhaf olan birileri varsa o da sizsiniz! Diyeceğiniz başka bir şey yoksa lütfen araştırmamı bölmeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880304
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880304,
					"content": "Bu ayki harcamalarım beklentilerimi aştı. Derneğin ödüllü araştırma sorularını çözerek açığı kapatmam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880305
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880305,
					"content": "Vay, Paimon araştırma için ödeme alınabildiğini bilmiyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880306,
					"content": "Sürüngen Kalıntıları Derneği böyle bir yerdir. Her türlü konunun araştırılması Morayla teşvik edilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880307
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880307,
					"content": "Bu sefer Işıltılı Yazıtların şifresini çözme işi bende... Şimdiye kadar bu şifreyi kimse çözemediği için ucunda hatırı sayılır bir Mora olduğu söyleniyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880308
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880308,
					"content": "Ama asıl sorun şu ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880309
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880309,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880310,
					"content": "Bu görevi yapabilmem için bana yeteri kadar yazıt parçası lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880311
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880311,
					"content": "Hımm... Şuna ne dersin o zaman? Sen bana Işıltılı Yazıt parçaları getir, ben de sana karşılığında ödeme yapayım. Nasıl olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880312
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880312,
					"content": "Deneyimli maceracılara benziyorsunuz, eminim bu tür görevleri sürekli yapıyorsunuzdur, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880313
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880313,
					"content": "Sana yardım edebiliriz, onda sorun yok. Ancak bu ay zaten cebindeki paradan çok daha fazlasını harcamamış mıydın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880314,
					"content": "Bütçeyi zaten çoktan aştığım için artık ne kadar aştığımın bir önemi yok... O parçaları bulup şifreyi çözdüğümde bütçe sorunu falan kalmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880315,
						750880316
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880315,
					"content": "Biz sana o parçaları buluruz ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				},
				{
					"id": 750880317,
					"content": "Merak etmeyin. Siz bana \"gerçek\" olanları bulun yeter. Bir sokak satıcısının bana sahte \"Gizli Kaynağın Kalıntıları\" sattığı aklıma geldikçe... Hâlâ öfkeden deliye dönüyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880318
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880318,
					"content": "O işte de az Mora batırmadım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880319
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880319,
					"content": "Demek bütçeni bu şekilde aştın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 750880320,
					"content": "İşte tam da bu sebeple o yazıtları kullanarak kaybettiklerimi geri almak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880321
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880321,
					"content": "Bu yüzden lütfen bana yardım edin! O parçaları bulmak için size ihtiyacım var! Onları bulup bana getirir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880322
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880322,
					"content": "Öyle çok fazlasında gözüm yok. Sadece... Üç... Yok, yok, dört tane olsun yeter! Daha fazlasına gücüm yetmez zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880316,
					"content": "İşine yarayıp yaramayacağını bilemeyiz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750880317
					]
				}
			]
		},
		{
			"id": 7508806,
