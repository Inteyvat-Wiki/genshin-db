			},
			"dialogs": [
				{
					"id": 750880601,
					"content": "Aa, gelmişsin! Yazıt parçalarını getirdiğin için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880602
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880602,
					"content": "Ancak şifre çözme işi, nasıl desem... Biraz zahmetli. Görünüşte Filojiston Oymalarına epey benziyor ama beklediğimden çok daha karmaşık çıktı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750880603
					],
					"speakerTitle": "Chuno"
				},
				{
					"id": 750880603,
					"content": "Ama artık geri dönüş yok, o yüzden... Öyle ya da böyle bu işi halletmem lazım, hahaha!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Chuno"
				}
			]
		}
	]
}