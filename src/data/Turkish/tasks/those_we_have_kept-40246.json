						],
						"pointId": 9
					}
				]
			},
			"dialogs": [
				{
					"id": 402461001,
					"content": "Eh, bu eski meseleyi de tarihe gömdük. Aradan çıkardığımıza sevindim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461002
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461002,
					"content": "Arada sırada iyilik yapmak güzel hissettiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461003
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461003,
					"content": "Nod-Krai'da da herkese çok yardım ettin! Özünde iyi birisin aslında!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461004
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461004,
					"content": "Heh, ben olsam o kadar emin olmazdım. Yakında Fatui'ye döneceğim. Siz ikiniz bazen insanlara fazla güveniyorsunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461005
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461005,
					"content": "Eh, en azından sana güvenebileceğimizi biliyoruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402461006
					]
				},
				{
					"id": 402461006,
					"content": "Hıh, peki. Bu iş dönüp dolaşıp başınıza bela olursa uyarmadı demeyin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461007
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461007,
					"content": "Ee, şimdi nereye gideceğiz? Gemiye mi dönüyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461008
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461008,
					"content": "Evet! Kişisel işlerin, Nergis Haçı meselesi falan hepsi halloldu. Yani artık \"görüşülmesi gereken kişilerle görüşebilirsin\" değil mi Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461009
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461009,
					"content": "Herkes geri döndüğüne çok sevinecek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461010
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461010,
					"content": "Heh... Eskiden olsa bunu ölsem itiraf etmezdim ama... Evet. Herkesi gerçekten özledim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461011
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461011,
					"content": "Ama Columbina istisna! Yıllardır yaptığı tüm o sinir bozucu maskaralıkların acısını ondan çıkaracağım bu sefer!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		},
		{
			"id": 4024611,
			"completionStepIds": [
				4024611
			],
