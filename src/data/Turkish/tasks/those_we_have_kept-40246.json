			"dialogs": [
				{
					"id": 402460501,
					"content": "Şu ana kadar hiçbir iz yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460502
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460502,
					"content": "Çağırma ayinine başlayayım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460503,
					"content": "Önce kulenin bu katındaki suyu boşaltalım. Böylece hareket etmemiz kolaylaşır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460504
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460504,
					"content": "Bir dakika, bunu yapabilir miyiz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460505,
					"content": "Elbette. Alain ve Rene, Fontaine'i bekleyen geleceği gördüler, hatta binaları su geçirmez hale getirmek için birkaç yöntem de paylaştılar. Bunun arkasındaki prensip...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460506
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460506,
					"content": "... Öhöm, neyse. Mekanizmaların kilidini size söylediğim sırayla açmanız yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		},
		{
			"id": 4024607,
			"completionStepIds": [
				4024607
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4024607",
							"2"
						],
						"stepId": 4024607,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20359,
						"position": [
							2652.556,
							253.937,
							3640.104
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 402460701,
					"content": "Hazır mısın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460702,
					"content": "Evet. Ortaya çıkınca içindeki ruhlarla konuşmayı deneyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460703,
					"content": "Ama büyük ihtimalle çoktan deliliğe sürüklenmişlerdir. İletişim kuramazsak savaşmak zorunda kalacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460704,
					"content": "O zaman Paimon saklanacak bir yer bulsa iyi eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460705,
					"content": "Bir kavga çıkarsa son darbeyi indiren ben olmalıyım. Bu konuda bana güvenin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460706,
					"content": "Anlaşıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460707,
					"content": "Pekala, bana sessizlik lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460708,
					"content": "... Metcezirde sürüklenen avare ruhlar, duyun sesimi. Susturulmuş, parçalanmış ve terk edilmiş kırık ruhlar, geçmişin izlerini takip edin ve bize geri dönün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460709,
					"content": "... Hınç, hıncı tanısın. Kötücül varlıklar birbirine çekilsin ve burada bir kez daha vücut bulsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460710,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460712,
					"content": "(... Şimdi ne olacak? Bu kadar mı?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460713,
					"content": "(Öf... İşte tam da bu yüzden sihirle değil matematikle uğraşıyorum. Büyünün hangi aşamada olduğunu nereden bileceğiz ki? Ortada mantıktan eser yok sanki.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460714,
					"content": "(Mekanik bilimini anlamak çok daha kolay...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460715,
					"content": "!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460716,
					"content": "Dikkat!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460717,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "Avare Ruhların Hıncı"
				},
				{
					"id": 402460718,
					"content": "Hey, sen! Ya da içinde her kim varsa... Beni dinlemen gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460719,
					"content": "Fontaine'in \"Usta Lord\"u Alain Guillotin'in soyundan geliyorum. Seni yeniden bir bütün haline getirip Ley Hatlarına geri döndürebilirim. Sadece benimle iş birliği yapman gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460720,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "Avare Ruhların Hıncı"
				},
				{
					"id": 402460721,
					"content": "Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460722,
					"content": "Hıh... Anlaşılan bunu konuşarak halledemeyeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460723,
					"content": "Pekala, B planı... Biraz stres atma zamanı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		},
		{
			"id": 4024609,
			"completionStepIds": [
				4024609
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
