			},
			"dialogs": [
				{
					"id": 402460201,
					"content": "Citlali dün gece bayağı içti yalnız... Uyanabilmiş midir acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460202,
					"content": "Günaydın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460203
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460203,
					"content": "Aaa! C-Columbina! S-Sen... Nasıl sürpriz bir giriş yapılacağını cidden çok iyi biliyorsun... Ne yapıyorsun burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460204,
					"content": "Son dakika eklenen bir sahnenin çekimini yeni bitirdik, ben de biraz temiz hava almak için yukarı çıktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460205
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460205,
					"content": "Diğerleri hâlâ aşağıda son sahnenin ne olması gerektiğini tartışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460206
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460206,
					"content": "Filmin nasıl bitmesi gerektiğini mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460207,
					"content": "Evet. Kadın kahramanın eski arkadaşıyla yeniden bir araya gelip gelmemesi konusunda kararsızlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460208
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460208,
					"content": "Ah... Çünkü konusu arkadaşını aramak için onun memleketine gelmesiydi, değil mi? Paimon az kalsın hikayeyi unutuyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460209,
					"content": "Evet. Yönetmen Furina ve Bayan Chiori, ikisinin asla karşılaşmadığı trajik bir sonun daha dokunaklı olacağını düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460210
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460210,
					"content": "Ama Yönetmen Xavier, ikisinin yeniden bir araya gelmesinin daha dokunaklı ve yürekleri ısıtan bir son olacağını düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460211
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460211,
					"content": "Sen ne düşünüyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460212
					]
				},
				{
					"id": 402460212,
					"content": "Ben mi? Ben... Emin değilim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460213
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460213,
					"content": "Kendi adıma, tabii ki onu tekrar görmek istiyorum... Tabii ki yeniden bir araya geldiğimiz o anı yaşamak istiyorum... Sadece Kameralar için olsa bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460214
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460214,
					"content": "Ama bunun için... Onun yerine bir oyuncunun geçmesi gerekecek ve bu beni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460215
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460215,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460216,
					"content": "Onu şimdilik kafana takma.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460217
					]
				},
				{
					"id": 402460217,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460218
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460218,
					"content": "Evet! Bu kadar endişeli olma! Film çekmek eğlenceli bir şey olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460219,
					"content": "A-Ayrıca, her şey yoluna girecek! Bu konuda Paimon'a güvenebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460220,
					"content": "Yoluna girecek derken? Nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460221
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460221,
					"content": "Iı, şey... Bilirsin işte...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460222,
					"content": "Her şey tatlıya bağlanacak. Göreceksin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460223
					]
				},
				{
					"id": 402460223,
					"content": "Evet! Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460224,
					"content": "Hehe... Tamam. Size güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460225
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460225,
					"content": "Şimdilik sadece eğlenmeye odaklanacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460226
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460226,
					"content": "#Oo, kimleri görüyorum! {NICKNAME} ve Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460227
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460227,
					"content": "Hıı, şu bizi eken ışık uzmanı ve ikinci yardımcı kameraman...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460228
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460228,
					"content": "Şey, evet... Biraz ortadan kaybolmuş olabiliriz. Çok özür dileriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460229
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460229,
					"content": "Hehe, hiç dert etmeyin. Bizim tarafta her şey yolunda, siz ne yapmanız gerekiyorsa onu yapmaya bakın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460230,
						402460231
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402460230,
					"content": "Anlayışın için teşekkür ederim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				},
				{
					"id": 402460232,
					"content": "Şimdi moraliniz daha iyi görünüyor Bayan Columbina. Önceki konuşmamız sizi zor durumda bıraktıysa özür dilerim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460233
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460233,
					"content": "#Sorun değil, şimdi iyiyim. {NICKNAME} ve Paimon benimle konuşup beni rahatlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460234
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460234,
					"content": "Peki o zaman, son hakkında ne düşünüyorsunuz? Yeniden kavuşsunlar mı, kavuşmasınlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460235
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460235,
					"content": "Her şeyi... Tatlıya bağlamalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460236
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402460236,
					"content": "... Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Furina"
				},
				{
					"id": 402460231,
					"content": "Söz, bunu telafi edeceğiz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				}
			]
		},
