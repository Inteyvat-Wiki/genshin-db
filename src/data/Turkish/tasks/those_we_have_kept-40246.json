			"dialogs": [
				{
					"id": 402461101,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461102
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402461102,
					"content": "Şey, Sandrone...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461103
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402461103,
					"content": "Anın büyüsünü bozma. Yoksa bunu yapmamanı açıkça söyledikten sonra beni rastgele bir yere ışınladığın zamanı düşünmeye başlarım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461104
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461104,
					"content": "Ş-Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461105
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402461105,
					"content": "Veee... Sahne! Bravo! Bravo! İşte bu! Tam da umduğum son buydu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461106
					],
					"speakerTitle": "Xavier",
					"speakerSubtitle": "Film Yapımcısı"
				},
				{
					"id": 402461106,
					"content": "... Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461107
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461107,
					"content": "Az önce nereye gittiniz Bayan Columbina? Ortadan kayboldunuz ve bir saniye sonra geri dönüp buradaki, ıı... Yeni arkadaşa sarıldınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461108
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461108,
					"content": "B-Bunların... Hepsi... Kameraya mı... Alındı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461109
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461109,
					"content": "Şey, Kamera zaten kayıttaydı ve her şey çok hızlı gelişti, o yüzden... Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461110
					],
					"speakerTitle": "Chiori"
				},
				{
					"id": 402461110,
					"content": "Bir saniye, yoksa bu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461111
					],
					"speakerTitle": "Furina"
				},
				{
					"id": 402461111,
					"content": "Evet, en yakın arkadaşım. Aradığım kişi. Onu gerçekten tekrar görebileceğimi hiç düşünmemiştim. Ben... O kadar mutluyum ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461112
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402461112,
					"content": "Üstelik film de mutlu sonla bitti. Hepsi senin sayende Sandrone.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461113
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402461113,
					"content": "... Sandrone?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461114
					],
					"speakerTitle": "Küçük Hanım"
				},
				{
					"id": 402461114,
					"content": "Bir saniye bile sinir bozucu olmayı bırakamadın mı? Columbinaaaa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		},
		{
