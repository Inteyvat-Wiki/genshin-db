			"dialogs": [
				{
					"id": 402461201,
					"content": "Citlali, biz geldik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461202,
					"content": "Hah, tam zamanında geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461203,
					"content": "Şey, evet... Dün o kadar içip dağıtan biz değildik sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461204,
					"content": "Hıh, ne? Ninenizin içkiyi kaldıramadığını mı ima ediyorsun? Beni sarhoş etmek için bundan çok daha fazlası gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461205,
					"content": "Emin misin? Çünkü... Bir süre sonra söylediklerin anlamsızlaşmaya başlamıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461206,
					"content": "Iıı... Öyle mi oldu? Hadi ya, hiç farkında değilim. Umarım... Çok saçmalamamışımdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461207,
					"content": "Bakalım... Yarım saatini Ororon'u kötülemekle, yarım saatini işten şikayet etmekle, bir saatini resimli romanlardan bahsetmekle geçirdin... Şey, Paimon ondan sonra biraz uyuyakaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461208,
					"content": "... Gittiler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461209,
					"content": "Hım? Ha, ekip mi? Evet, güvertede onlarla karşılaştık ama az önce gittiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461210,
					"content": "Dur bir saniye, çekirdeğinle ilgili her şey hallolduğuna göre Columbina'yı görmene engel olan ne? Seni çok özlüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402461211,
					"content": "Ben... Önce bu karmaşayı halletmek istiyorum. Hem bir kez olsun onu yerinden sıçratmak için mükemmel bir fırsat bu. Biraz daha plan yapmam lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461212,
					"content": "Neyse, kapatalım bu konuyu. Hedefimizin yerini tam olarak tespit edebildin mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461213,
					"content": "Elbette. Itztli Nine bir söz verdiyse yerine getirir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461214,
					"content": "Harika, bir bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461215,
					"content": "Morte Bölgesi... Bir dakika, burası Gestalt Kulesi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461216,
					"content": "Ruhların ayrıldığı yer... Hıncın kaynağı orası mı? Yoksa genel olarak Nergis Haçı Derneği mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461217,
					"content": "Ben de geleyim. Bu şey sabit durmuyor. Oraya vardığımızda yerinde olmazsa onu çağırmak için ayin yapabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461218,
					"content": "Zaten fazlasıyla zahmete girdin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461219,
					"content": "Sorun değil. Zaten bu ihtiyarın yapacak daha iyi bir işi yok. Bir ruh çağırmak elime yapışmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461220,
					"content": "(Hem gitmezsem kendi aralarında benim katılamayacağım espriler yapmaya devam edecekler!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402461221,
					"content": "Peki o zaman. Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402461222,
					"content": "Hehe, o halde kaybedecek vaktimiz yok. Hadi yola çıkalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
