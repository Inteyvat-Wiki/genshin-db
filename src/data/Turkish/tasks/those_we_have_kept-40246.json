						],
						"pointId": 8
					}
				]
			},
			"dialogs": [
				{
					"id": 402460901,
					"content": "... Bitti mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460902,
					"content": "Evet. Size çocuk oyuncağı olacak demiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460903,
					"content": "Bunu nasıl yaptın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460904,
					"content": "O yaratığın öyle özel bir yanı yoktu. Gidecek hiçbir yeri olmayan bir sürü ruha bir tutam kötücül enerji, ufak tefek pislikler ve bolca hınç eklersen ortaya bu çıkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460905,
					"content": "Tek yaptığım, asıl ruhları pisliğin geri kalanından ayırıp dünyanın mevcut kurallarınca kabul görmelerini sağlamaktı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460906,
					"content": "Dünya Formülü temelinde \"Yol Ayrımı\" prensibine dayanır. Belirli cevaplara ulaşmak için bir köken noktasından yola çıkarak dünyanın olasılıklarını parçalarına ayırır ve yeniden yapılandırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460907,
					"content": "Yani mantıken Dünya Formülünü tersine hesaplamak, bunun yerine yakınsama ve yenileme elde etmemizi sağlar. Numerolojik dizilimi kullanarak tam olarak bunu başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460908,
					"content": "Matematikteki homolojik indirgeme kavramına benziyor. Asıl doğalarını değiştirmeden, onları varlıklarının en basit, en temel özüne indirgedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460909,
					"content": "Yani bunun anlamı... Öf, boş verin. O boş bakışlarınıza bakılırsa sanırım pek de umurunuzda değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460910,
					"content": "Sanırım Şaman işleriyle ilgili çenem düştüğünde yabancıların ne hissettiğini sonunda anlıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 402460911,
					"content": "N-Neyse, çok etkileyiciydi! Süpersin Sandrone!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 402460912,
					"content": "Hah, daha yeni mi fark ettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460913,
					"content": "Tüm Mantığın Çözücüsünden başka türlüsü beklenemezdi zaten...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "Öhöm, neyse, bu konuyu kapatalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "Kukla"
				},
				{
					"id": 402460915,
					"content": "Ç-Çıksak iyi olur artık! Ben gidip kulenin içindeki mekanizmaları sıfırlayayım. Karada görüşürüz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kukla"
				}
			]
		},
		{
