					"Ahangar"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230150301,
					"content": "Tamam! Tamam! Senin şu çarklarını yapacağım! Yeter ki artık konuşma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150302
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150302,
					"content": "İyi ama açıklamamı henüz bitirmemiştim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150303
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150303,
					"content": "Demir Parçalarını da aldığımıza göre ben işimin başına dönüyorum. Sen de çekil şuradan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150304
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150304,
					"content": "Ahangar çekicini o kadar şiddetli savuruyor ki Garcia ondan uzaklaşmak zorunda kalıyor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230150305
					]
				},
				{
					"id": 230150305,
					"content": "Bırakalım da Bay Ahangar işini yapsın. İşte ödemen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150306
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150306,
					"content": "Umarım bu kez başarırsın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150307
					]
				},
				{
					"id": 230150307,
					"content": "Bu, benim için çok anlamlı. Teşekkür ederim Gezgin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150308
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150308,
					"content": "Ben... Bu konuyla ilgili temkinli bir umutsuzluk içindeyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150309
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150309,
					"content": "Bay Garcia makinalar konusunda bir dahi. Buna hiç şüphe yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150310
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150310,
					"content": "Yine de bence Bay Garcia'nın yapmaya çalıştığı makina için bir \"dehadan\" fazlası gerekli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				}
			]
		},
