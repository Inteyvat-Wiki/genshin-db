			},
			"dialogs": [
				{
					"id": 230150101,
					"content": "Bu mil yatağı çok büyük. Sığmıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150102
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150102,
					"content": "Önceki sefer çok küçüktü, şimdiyse çok büyük! Elimdeki tüm Demir Parçalarını bitireceksin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150103
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150103,
					"content": "Hatta elimizdeki tüm Morayı da bitirmek üzereyiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150104
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150104,
					"content": "Niye tartışıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150105
					]
				},
				{
					"id": 230150105,
					"content": "Bu adam benden bir sürü demir boru ve çark yapmamı istedi, her biri için de farklı talepleri var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150106
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150106,
					"content": "Zaten bu şeyleri üretmek için elimdeki tüm Demir Parçalarını bitiriyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150107
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150107,
					"content": "Ama o bunların da yetmeyeceğini düşünüyor, daha fazla çark istiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150108
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230150108,
					"content": "İşimi sana tekrar açıklayayım, eminim beni anlayacaksın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150109
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230150109,
					"content": "Burada ne arıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150110
					]
				},
				{
					"id": 230150110,
					"content": "Bırakalım da Bay Garcia, Bay Ahangar'a her şeyi açıklasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150111
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150111,
					"content": "Gezgin, benim... Yani, Bay Garcia'nın bir isteği var. Bizim için biraz Demir Parçası toplayabilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150112,
						230150113
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150112,
					"content": "Bunun için vaktim var ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				},
				{
					"id": 230150114,
					"content": "Şey... Beklediğim gibi birkaç zorlukla karşılaştık. Bay Garcia da hâlâ çözüm bulmaya çalışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150115
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150115,
					"content": "Eğer bir noktada bu konuyu merak edersen Bay Garcia'dan daha fazla bilgi alabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150116
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150116,
					"content": "Maalesef onun dışında kimse bu makinanın mekanizmalarını tam olarak anlayamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230150117
					],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150117,
					"content": "Yine de lütfen önce bize birkaç Demir Parçası getir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lutong"
				},
				{
					"id": 230150113,
					"content": "Makinasında yaptığı değişiklikler nasıl gidiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230150114
					]
				}
			]
		},
