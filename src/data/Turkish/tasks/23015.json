			},
			"dialogs": [
				{
					"id": 230155001,
					"content": "Tüm bu çarklar ve borularla ne yapacaksın? Demirden bir ev falan mı yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155002
					],
					"speakerTitle": "Ahangar"
				},
				{
					"id": 230155002,
					"content": "Çok doğru! Gerçekten de çarklarla dolu bir ev yapıyorum. Yaptığım şey tam olarak bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155003
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155003,
					"content": "Çarkların bazıları \"Depo\" olarak adlandırdığım bölümün içinde, mil yatağı ve çarkların geri kalanı ise \"Numaratör\" kısmını oluşturuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155004
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155004,
					"content": "Depoda bulunan çarklar numaraları kaydetmek ve depolamak için, Numaratör ise hesaplamalar için kullanılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155005
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155005,
					"content": "Belki bir taslak çizersem daha iyi anlayabilirsin. Yanında kağıt var mı? Yok mu? Neyse, giysime çizeyim. Böylece daha iyi anlatabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230155006
					],
					"speakerTitle": "Garcia"
				},
				{
					"id": 230155006,
					"content": "Kömürü uzatabilir misin? Teşekkürler. Şimdi şuna bir bak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Garcia"
				}
			]
		}
	]
