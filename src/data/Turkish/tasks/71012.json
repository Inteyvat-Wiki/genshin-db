			},
			"dialogs": [
				{
					"id": 710121101,
					"content": "Zaman ve rüzgar... Ne bulmuş acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121102,
						710121106
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121102,
					"content": "Zaman ve rüzgar mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121103
					]
				},
				{
					"id": 710121103,
					"content": "Arkadaşımın gönderdiği son mektupta bahsettiği bir şeydi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121104
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121104,
					"content": "Yazdıklarına göre Mondstadt'ın sırlarından biri \"zaman ve rüzgar\"da gizliymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121105
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121105,
					"content": "Buralı olmama rağmen daha önce hiç böyle bir ifade duymamıştım. Acaba ne demek istiyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121106,
					"content": "Sumeru Akademisinde mi eğitim aldın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121107
					]
				},
				{
					"id": 710121107,
					"content": "Evet. Mondstadtlıyım ama kendimi bildim bileli Sumeru Akademisinde çalışıyorum. Muhtemelen orada geçirdiğim zaman Mondstadt'ta geçirdiğimden fazladır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121108
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121108,
					"content": "Orada neler olduğunu öğrenmek istiyorsun demek? Şey, devlet sırrı değil aslında... Nasıl desem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121109
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121109,
					"content": "Bir avuç tuhaf adam işte. Hım, böyle söyleyince kulağa çok laubali geldi... \"İlginç bir izlenim uyandıran insanlar\" demek daha uygun olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121110
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121110,
					"content": "Yolun o taraflara düşerse ne demek istediğimi anlarsın ama oralarda çok uzun zaman harcamanı tavsiye etmem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				}
			]
		},
