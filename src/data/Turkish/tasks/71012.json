			},
			"dialogs": [
				{
					"id": 710120201,
					"content": "\"Rüzgarın getirdiği hikayeler zamanla efsaneler olarak yeniden doğar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120202
					],
					"speakerTitle": "Tahrip Edilmiş Oyma"
				},
				{
					"id": 710120202,
					"content": "Bu not defterinde bahsi geçen güneş saati olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120203,
					"content": "Paimon saatin nesinin bu kadar özel olduğunu anlamıyor ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120204,
					"content": "Not defterini biraz daha dikkatli okursak bir ipucu bulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101210,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7101210",
							"2"
						],
						"stepId": 7101210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Henry Morton"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710121001,
					"content": "Hım? Seni buraya hangi rüzgar attı Gezgin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121002
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121002,
					"content": "Fırtınanın Gözü hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121003
					]
				},
				{
					"id": 710121003,
					"content": "Fırtınanın Gözü mü? Uzun zamandır buradayım ama hiç söylediğine benzer bir şey görmedim. Şu aniden bastıran rüzgar dışında tabii...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121004
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121004,
					"content": "Hoş, onun da Fırtınanın Gözü olmadığından eminim. O şeyleri nerede görsem tanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121005,
						710121007
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121005,
					"content": "Tamam o zaman...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121006
					]
				},
				{
					"id": 710121006,
					"content": "İnan bana, öyle bir şey gelip de araştırmamı bölmeye kalksa emin ol unutmazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121009,
					"content": "Hatta bir arkadaşımla birlikte yapıyoruz araştırmayı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121010
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121010,
					"content": "O da bir alimdir. Birlikte Sumeru Akademisinde okuduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121011
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121011,
					"content": "O mezun olduktan sonra arkeolog oldu, dünyayı gezip incelemeler yaptı. Ben de Akademide araştırmalarıma devam ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121012
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121012,
					"content": "Mondstadt'a geldiğinde hemen yanıma uğrayıp büyük bir heyecanla Bin Rüzgar Tapınağı hakkında araştırma yaptığını anlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121013
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121013,
					"content": "Hatta \"Memleketinin sırlarını açığa çıkardığımda ilk sana söyleyeceğim.\" diye söz verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121014
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121014,
					"content": "Sonrasında ondan haber alamadım. Birinden Cyrus'a mektup göndermesini, Maceracılar Loncasından arkadaşımı bulmam için yardım istemesini rica ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121015
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121015,
					"content": "Ama ondan da haber alamadım. Ben de araştırmalarımı durdurup buraya geldim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121016
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121016,
					"content": "Burada güneş saati dışında hiçbir şey yok. Hiçbir ipucu yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121017
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121017,
					"content": "Şu adada da bir güneş saati var...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121018
					]
				},
				{
					"id": 710121018,
					"content": "Ne? Bunun tıpatıp aynısı bir güneş saati mi buldunuz? Üstüne üstlük bir adada, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121019
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121019,
					"content": "Ah, evet! Şimdi hatırladım. Havanın güneşli olduğu günler o adayı birkaç kez görmüştüm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121020
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121020,
					"content": "Bir dakika... Demek güneş saatinin yanında bir de not buldunuz. Arkadaşım orada mıydı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121021
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121021,
					"content": "Teşekkür ederim. İlk fırsatta adayı kontrol etmeye gideceğim ama önce buranın gizemini çözmem gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121022
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121022,
					"content": "Araştırmama devam etmeliyim. İlgini çekerse notlarım hemen şurada duruyor, göz atabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121023
					],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121023,
					"content": "Kim bilir? Belki işine yarayacak bir şeyler bulursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Henry Morton"
				},
				{
					"id": 710121007,
					"content": "Ne yapıyorsun burada?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710121008
					]
				},
				{
					"id": 710121008,
					"content": "Ben mi? Ufak bir araştırma yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710121009
					],
					"speakerTitle": "Henry Morton"
				}
			]
		},
		{
			"id": 7101211,
