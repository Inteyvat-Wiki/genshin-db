			"dialogs": [
				{
					"id": 710120101,
					"content": "\"Rüzgarın getirdiği hikayeler zamanla efsaneler olarak yeniden doğar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120102
					],
					"speakerTitle": "Tahrip Edilmiş Oyma"
				},
				{
					"id": 710120102,
					"content": "Bu ne demek acaba? Paimon'un hiçbir fikri yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120103,
					"content": "Yine de burada saklı bir gizem var gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710120104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710120104,
					"content": "Etrafı kontrol edelim. Belki ne olduğuna dair bir ipucu buluruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7101202,
