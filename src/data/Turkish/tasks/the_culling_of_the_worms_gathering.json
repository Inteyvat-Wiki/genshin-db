			},
			"dialogs": [
				{
					"id": 735120101,
					"content": "Ah... Teşekkürler cesur Gezgin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120102
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120102,
					"content": "Oh! Aradan çok zaman geçmedi, hâlâ iyi durumdalar... Sadece birkaç ayar daha lazım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120103
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120103,
					"content": "Vinayak makinalarla uğraşmaya başlar...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735120104
					]
				},
				{
					"id": 735120104,
					"content": "... Vinayak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120105
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120105,
					"content": "Neredeyse tamamladım... Az kaldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120106
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120106,
					"content": "Vi-na-yak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120107
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120107,
					"content": "Aaa! Shriya? Sen ne zaman geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120108
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120108,
					"content": "Sen parçalarla uğraşırken...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120109
					]
				},
				{
					"id": 735120109,
					"content": "Buranın tehlikeli ve canavarlarla dolu olduğunu söyleyen sen değil miydin? Ne işin var burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120110
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120110,
					"content": "... Ben parçalarımız için endişelenmiştim. Bu görevi tamamlayamazsak Akademiye geri dönemem!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120111
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120111,
					"content": "Hah, ben demiştim. Bak, hepsini topladım. Geri dönüp birkaç ayarlama yaptıktan sonra birleştirmeye başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120112
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120112,
					"content": "Peki tüm bu parçalar ne için?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735120113,
					"content": "Ah, size anlatmayı unuttum. Bunlar mezuniyet projemiz Solucanezen Topu için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120114
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120114,
					"content": "Niye böyle pek bilinmeyen bir konu seçtiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735120115,
					"content": "Sen de mezun olacak olsaydın neden seçtiğimizi anlardın... Her neyse, bunun bir önemi yok şimdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120116
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120116,
					"content": "Kendimi tanıtayım. Adım Shriya, Amurta Darşanından mezun bir araştırmacıyım. Çöl biyolojisi ve ekolojisi üzerine çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120117
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120117,
					"content": "Bu mekanik takıntısı olan sersem da uygulamalı mekanik alanında uzman bir Kshahrewar araştırmacısı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120118
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120118,
					"content": "... Ben Vinayak. Yardımlarınız için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120119
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120119,
					"content": "Tamamen farklı alanlar üzerinde çalışan insanlar birlikte çalışabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735120120,
					"content": "O konuya hiç girmeyeyim... Mezuniyet tezimizde bu adamla birlikte çalışmak kesinlikle öğrencilik hayatımın en büyük hatasıydı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120121
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120121,
					"content": "Hayır, böyle diyemezsin. Sonuçta ikimiz de mezun olduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120122
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120122,
					"content": "Olmasına olduk da, kaç yıl uzattığımızı unuttun mu acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120123
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120123,
					"content": "Neyse ne, mezun olduk işte. Bazı dönem arkadaşlarımızın tez önerilerini daha geçen sene tamamladıklarını duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120124
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120124,
					"content": "Of... Yeter! Öğrenci değiliz artık, bu anlamsız tartışmaları bıraksak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120125
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120125,
					"content": "Her zaman sen başlatıyorsun ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120126
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120126,
					"content": "Saçmalık! Biz ilk prototipi yaparken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120127,
						735120128
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120127,
					"content": "Hey, hey!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120129
					]
				},
				{
					"id": 735120129,
					"content": "Vay canına... Sizin aranız cidden kötü. Akademi nasıl oldu da ikinizi birden bu işi halletmeye gönderebildi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735120130,
					"content": "*iç çeker* Aslında Akademi bizi yollamayacaktı... Kunar diye birinin bu sorunla uğraşması gerekiyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120160
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120160,
					"content": "Danışman hocamın danışman hocası olur kendisi... Tez savunmam sırasında o da oradaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120161
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120161,
					"content": "Sanırım \"Akademideki bazı genç öğrenciler Solucanezen Topu tasarlamış\" fikrini de oradan edindi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120162
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120162,
					"content": "O yüzden bu sefer sorunla uğraşalım diye buraya yine ikimizi yolladı. \"Akademinin gençlere kendilerini gösterme fırsatı vermesi lazım!\" diyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120163
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120163,
					"content": "Tabii ikimizin mezuniyetten beri konuşmadığımızı hesaba katmamış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120131
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120131,
					"content": "Hatta hocamı bile ikna ederek... Öhöm, neyse, sonuç olarak şu an Solucanezen Topunu ortaya çıkarmak için bir fırsatım var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120132
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120132,
					"content": "Tekrar bir birleştirelim, o haşereler görecek el mi yaman bey mi yaman!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120133
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120133,
					"content": "Bizim mekanik kafalı aptal konuştu yine... Ben de çölün ekolojik dengesini korumak için bu Solucanların neden böyle huzursuz olduklarını araştırmak istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120134
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120134,
					"content": "#Maceracı {M#Bey}{F#Hanım}, anladığım kadarıyla siz epey yeteneklisiniz. Çölde olduğumuz süreçte bizi güvende tutmanızı isteyebilir miyim acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120135,
						735120136
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120135,
					"content": "İyi bir ücret karşılığı yaparım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120137,
					"content": "Merak etmeyin. Akademiden çok destek göremesek de en azından iyi bir bütçemiz var. Tabii birileri bütçenin büyük bir kısmını makinaları geliştirmeye harcadı ama neyse...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120138
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120138,
					"content": "O geliştirmeler gerekliydi! Hem madem böyle kibar konuşabiliyorsun, bana karşı da biraz anlayışlı olsan fena mı olur?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120139
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120139,
					"content": "Ben önce konuştuğum kişinin sabrıma değip değmediğine bakarım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120140
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120140,
					"content": "Eyvah... Yine başladılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120141,
						735120142
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 735120141,
					"content": "Kavganızı daha sonraya mı saklasanız?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120143,
					"content": "*iç çeker* Pardon... Akademi günlerimden kalma bir alışkanlık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120144
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120144,
					"content": "Bu parçaların önce bazı ayarlamalar yapmak üzere Aaru Köyü'ne geri götürülmesi gerekiyor. Her halükarda birleştirmeye en erken yarın başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120145
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120145,
					"content": "Daha önce Solucanezen Topunu, Solucanların aktif olduğu bölgelerin yakınlarında kurmayı planlamıştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120146
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120146,
					"content": "Bunu yaparken çıkardığımız seslere gelen başka yaratıklar da olabilir. Bu konuda sana güveniyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120147,
						735120148
					],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120147,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120149,
					"content": "Tartışmamıza şimdi devam edebiliriz o zaman, değil mi? Yaptığım harcamalarda kesinlikle haklıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735120150
					],
					"speakerTitle": "Vinayak"
				},
				{
					"id": 735120150,
					"content": "Sen var ya... İyi, sen istedin. Harcamaları inceleyelim de görelim bakalım nereye gitmiş Moralar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Shriya"
				},
				{
					"id": 735120148,
					"content": "Yarın görüşürüz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120149
					]
				},
				{
					"id": 735120142,
					"content": "İşe başlayabilir miyiz artık?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120143
					]
				},
				{
					"id": 735120136,
					"content": "Benim için böyle işler çantada keklik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120137
					]
				},
				{
					"id": 735120128,
					"content": "Tartışarak bir yere varamazsınız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735120129
					]
				}
			]
		}
	]
}