		{
			"id": 7110803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110802",
							"2"
						],
						"stepId": 7110802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711080301,
					"content": "\"... Işık Delen idmanı yapıyorum. Yanlışlıkla tüm mankenleri yok ettim... Ne param ne de kaynağım kaldı... Aa, aklıma bir fikir geldi şimdi. Kamışları birbirine bağlayıp kendime bir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080302
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080302,
					"content": "\"... Toplama kamışı yapacağım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080303
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080303,
					"content": "\"Kamış bağlamak çok yorucu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080304
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080304,
					"content": "\"... Işık Delen idmanı yapıyorum. Yanlışlıkla tüm mankenleri yok ettim... Önce kılıçla idman yapayım en iyisi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080305,
						711080306
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080305,
					"content": "Okumaya devam et.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080307
					]
				},
				{
					"id": 711080307,
					"content": "\"... Sıkıldım. Yuvada otururken biraz acıkmaya başladım... Sonra geçen gün gördüklerim üzerine biraz düşününce birden aydınlandım sanki. Kılıcı kullanarak (okunaksız)... Adını Yağmur Kesen koyacağım. Başka bir gün denerim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080308
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080308,
					"content": "\"... Yağmur Kesen alıştırması yaparken yanlışlıkla düştüm. Neyse ki bir yerime bir şey olmadı... Aklıma bir fikir geldi. Direklerin altına derin bir gölet kazsak nasıl olur acaba? Hem düşünce yaralanmam hem de yemek için balık yetiştirebilirim...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080309
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080309,
					"content": "\"... Balıkçıya gidip bir düzine balık satın aldım... Hepsini bir güzel pişirdim. O kadar lezzetliydi ki...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080310
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080310,
					"content": "(Sonraki yaklaşık on sayfa, detaylıca anlatılmış balık pişirme yöntemleriyle dolu. Hatta bazılarına resim bile eklenmiş.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080311
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080311,
					"content": "\"... Yağmur Kesen alıştırması yaparken yanlışlıkla düştüm.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080312
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080312,
					"content": "\"... Başardım.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080313,
						711080314
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080313,
					"content": "Okumaya devam et.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080315
					]
				},
				{
					"id": 711080315,
					"content": "\"... Mızrak ve kılıç aynı ustalıkla... (Okunaksız. Yanında 3. Ustanın yorumu var: \"Bedeninin bir parçası gibi\".) ... Ve gerçek budur... Peki bu yetenek nasıl bahşedilecek, nasıl ortaya çıkacak?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080316
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080316,
					"content": "\"... Kütüphaneyi restore etmeliyiz. İçindeki... Tasarım ve...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080317
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080317,
					"content": "\"... Etrafı <color=#00E1FFFF>gözlerinle</color> gör ve <color=#00E1FFFF>her taraftaki bilgi parşömenlerini</color>, <color=#00E1FFFF>her köşedeki odalarla</color> birleştir. Sonra da...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080318
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080318,
					"content": "(Sonraki birkaç sayfa lekelenmiş ve okunaksız hale gelmiş. Kenarda 3. Ustanın bir yorumu var: \"Gelecek nesillere bol bol okumaları tavsiye ediliyor.\")",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080319,
						711080320
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080319,
					"content": "Okumaya devam et.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080321
					]
				},
				{
					"id": 711080321,
					"content": "\"... Yaraları iyileşen küçük Bai, balık ve kuzu eti ile döndü. Yumuşak ve lezzetliydi ayrıca tuhaf da kokmuyordu. Tarifini istedim... Ölüm Getiren tekniğini aktardım... Buraya kaydedildi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080322
					],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080322,
					"content": "(Sonraki sayfalarda ayrıntılı bir şekilde koyun eti pişirme yöntemleri anlatılmış.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "\"Guhua Notları\""
				},
				{
					"id": 711080320,
					"content": "Bu kadar yeter. Her şey karman çorman zaten...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080314,
					"content": "Yeter bu kadar. Eğitim sürecinden bahsedilmiyor bile...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080306,
					"content": "Yetti artık bu saçmalık...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
