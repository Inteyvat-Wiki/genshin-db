				"points": []
			},
			"dialogs": [
				{
					"id": 736960101,
					"content": "İyi günler Gezgin. Görüyorum ki Bilgelik Şenliğine katılmaya gelmişsin, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960102
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960102,
					"content": "İlgini çekerse Haravatat olarak düzenlediğimiz etkinliği denemek ister misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960103
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960103,
					"content": "Hatırladığım kadarıyla Haravatat'ın alanı...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960104
					]
				},
				{
					"id": 736960104,
					"content": "\"Diller\". Gerçi bu biraz genel kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960105
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960105,
					"content": "Haravatat olarak araştırma konumuz diller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960106
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960106,
					"content": "Ne düşünüyorsun? Şenlik ortamının rahat ve neşeli havasına uymuyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960107
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960107,
					"content": "Darşandaki arkadaşlarımın da çoğu böyle düşünüyor. Herkes dilediğince eğleniyor, o yüzden insanlara bilmeceler sorup tatlarını kaçırmamalıymışız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960108
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960108,
					"content": "Üstelik bilmece cevaplamak gibi bir etkinlik insanların ilgisini çok çekmez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960109
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960109,
					"content": "Uzun ve... Dostane tartışmalar sonrasında \"Gerçeğin Peşinde\" adında küçük bir oyun düzenlemeye karar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960110
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960110,
					"content": "Oyunu oynamak için herhangi bir alete veya eşyaya gerek yok. Berrak bir zihin yeterli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960111
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960111,
					"content": "Oyun başlayınca ben bir hikaye anlatacağım. Hikaye bazen hiçbir sona bağlanmıyormuş gibi, hatta bazı kısımlarında mantıksız bile gelebilir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960112
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960112,
					"content": "Sonra sen bana bazı sorular soracaksın, ben de <color=#00E1FFFF>\"Evet\"</color>, <color=#00E1FFFF>\"Hayır\"</color> ya da <color=#00E1FFFF>\"İlgisi yok.\"</color> şeklinde cevaplayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960113
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960113,
					"content": "Oyunun amacı, sorular sorarak bu hikayenin ardındaki \"gerçeği\" bulmak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960114
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960114,
					"content": "Merak etme, doğru cevap karmaşık bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960115
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960115,
					"content": "Ne dersin? İlgini çektiyse başlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736960116,
						736960118
					],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960116,
					"content": "Pekala, anlat bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960117
					]
				},
				{
					"id": 736960117,
					"content": "Harika! O zaman iyi dinle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahar"
				},
				{
					"id": 736960118,
					"content": "Şu anda yapacak başka bir işim var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736960119
					]
				},
				{
					"id": 736960119,
					"content": "Tamam o zaman. Ben burada olacağım, ne zaman denemek istersen gelebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bahar"
				}
			]
		}
	]
}