			},
			"dialogs": [
				{
					"id": 730200101,
					"content": "*sızlanır*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200102
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200102,
					"content": "Ah! Naralar gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200103
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200103,
					"content": "*öksürür* Beni bu kadar kötü bir vaziyette görmek zorunda kaldığınız için özür dilerim Naralar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200104
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200104,
					"content": "Benim adım Arachatora sevgili Naralar. Sizin adınız nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200105
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200105,
					"content": "#Ben {NICKNAME}.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200106
					]
				},
				{
					"id": 730200106,
					"content": "Paimon'un adı da Paimon!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200107,
					"content": "#Demek Nara {NICKNAME} ve Paimon. Çok teşekkür ederim. Kader bizi bir araya getirmeseydi, iyileşmem çok daha uzun sürerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200108
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200108,
					"content": "Çok uzun derken?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200109,
					"content": "Bunu itiraf etmekten utanıyorum ama kötü mantarlar yüzünden benzer bir durum daha önce de başıma gelmişti. Sudaki Nilotpala Nilüferleri ben iyileşene kadar iki kere çiçek açıp soldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200110
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200110,
					"content": "Çiçek açıp soldu... İki gün mü sürdü yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200111,
					"content": "İki gün... Anladım, demek gün bu anlama geliyor. Siz Naralar gerçekten çok ilginçsiniz. Peki iki gün uzun bir süre mi, yoksa kısa mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200112
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200112,
					"content": "#Hımm... Sen ne düşünüyorsun {NICKNAME}? Uzun mu kısa mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200113,
						730200116,
						730200120,
						730200123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200113,
					"content": "Uzundur herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200114
					]
				},
				{
					"id": 730200114,
					"content": "Doğru. Paimon, Arachatora'nın iki gün boyunca sızlanışını hayal bile edemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200115,
					"content": "Gerçekten mi? Demek ki çok uzun bir süre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200126,
					"content": "Peki sen Arachatora'ysan... Arapacati'nin akrabasısın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200127,
					"content": "Hayır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200128
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200128,
					"content": "Ne? Yani... Arapacati'nin abisi değil misin sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200129,
					"content": "Ah, nereden bildin? Arapacati benim \"kız kardeşim\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200130
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200130,
					"content": "Paimon'un kafası karıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200131,
					"content": "Belki Aranaraların kavramları bizimkinden farklıdır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200132
					]
				},
				{
					"id": 730200132,
					"content": "Neyse, biz sana olanları anlatalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200133,
					"content": "Arachatora'ya olanları anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730200134
					]
				},
				{
					"id": 730200134,
					"content": "Utsava Festivali yine yaklaşıyor... Ne yapacağım şimdi ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200135
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200135,
					"content": "Yemek için en önemli malzemeye sahip değilim. Mantarlı yemeklerin ne kadar harika olduğunu Arasaka, Arapas ve Araphala'ya gösterebilmem için Utsava Festivali tam da zamanı halbuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200136
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200136,
					"content": "Yani, Aras... spa... ara...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200137
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200137,
					"content": "Arasaka, Arapas ve Araphala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200138
					]
				},
				{
					"id": 730200138,
					"content": "Öff! Aranaraların isimleri de amma zor çıktı! Kardeşlerin nerede Arachatora?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200139,
					"content": "Her birimiz farklı bir alanda alıştırma yapmak istedik. O yüzden, tıpkı bir nehrin ayrılan kolları gibi bizim yollarımız da ayrıldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200140
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200140,
					"content": "Yani ayrıldınız öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200141
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200141,
					"content": "Üstün lezzeti pişirmek için hazırlanıyoruz ama onlar mantarlı yemeklerin lezzetli olduğunu kabul etmiyorlar. Kafa Mantarının eşi benzeri olmayan bir lezzet olduğunu nasıl göremiyorlar anlayamıyorum doğrusu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200142
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200142,
					"content": "Her neyse. Sonuç olarak yemeklerimizi hazırlamaya, sonrasında da karşılaştırmaya karar verdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200143
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200143,
					"content": "Paimon, sizin bu lezzetli yiyecek tutkunuzu o kadar iyi anlıyor ki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200144
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200144,
					"content": "E, peki Kafa Mantarın nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200145
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200145,
					"content": "Marana son zamanlarda hızla yayılıyor. Kafa Mantarlarının yaşam alanını bile ele geçirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200146
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200146,
					"content": "Ha, Solduran Bölgeyi diyorsun... Paimon, Rana'nın iyi olmasını umuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200147
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200147,
					"content": "Oradaki solduran pençeler, kıymetli mantarı mahvetmiştir kesin. Herhalde Marana bölgesinin ne kadar tehlikeli olduğunun farkındasınızdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200148
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200148,
					"content": "Kafa Mantarı olmadığı için, yalnızca henüz hiçbir Aranaranın denemediği o tuhaf mantarı deneyebildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200149
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200149,
					"content": "Sonra ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200150,
						730200151
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200150,
					"content": "Ne olduğunu bugün görmüş olduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200152,
					"content": "Utanç verici...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200153
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200153,
					"content": "Paimon şimdi düşündü de Solduran... Yani Marana... Biz bunun üstesinden daha önce de gelmedik mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200154,
						730200155
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200154,
					"content": "Çok da kolay olmuştu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200156,
					"content": "Kulaklarıma inanamıyorum! Marana ile savaşabiliyorsun demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200157
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200157,
					"content": "#Eh, düşününce mantıklı tabii. Nara {NICKNAME} beni Devi Kusanali'nin gücüyle iyileştirebildiğine göre, Marananın etkisini kaldırmak onun için işten bile değildir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200158
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200158,
					"content": "#Acaba benimle birlikte Kafa Mantarının yaşam alanına gelir misin Nara {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200159
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200159,
					"content": "#Gidersek o leziz mantarlı yemeğin tadına bakabiliriz! Hadi bu kardeşlerin yeniden bir araya gelmelerinde ona yardımcı olalım {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200160,
						730200161
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200160,
					"content": "Zaten Arapacati'ye söz vermiştik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200163
					]
				},
				{
					"id": 730200163,
					"content": "İşte ilerideki mağaranın içinde. Lütfen benimle gelin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200161,
					"content": "Senin de tek derdin yemek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200162
					]
				},
				{
					"id": 730200162,
					"content": "Bir taşla iki kuş vuruyoruz işte! Nesini beğenmedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200163
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200155,
					"content": "Az kalsın ölüyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200156
					]
				},
				{
					"id": 730200151,
					"content": "Sızlanıyordu işte.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200152
					]
				},
				{
					"id": 730200116,
					"content": "Kısadır herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200117
					]
				},
				{
					"id": 730200117,
					"content": "Hımm... Doğru diyorsun. Mesela biz birbirimizi uzun zamandır tanıyoruz ama sanki daha dün tanışmışız gibi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200118,
					"content": "Gerçekten mi? Rahatladım. Yani ormanda iki gün boyunca kontrolünü yitirmiş halde kalmak o kadar da uzun sayılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200119
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200119,
					"content": "Demek istediğimiz bu değildi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200120,
					"content": "O süreyi nasıl geçirdiğine göre değişir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200121
					]
				},
				{
					"id": 730200121,
					"content": "Şey... Doğru tabii. İki gün, sızlanmak için uzun bir süre ama bir orman domuzu için oldukça kısa sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200122
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200122,
					"content": "Gerçekten mi? Demek ki çok uzun bir süre...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200123,
					"content": "Zaman öznel ve anlamsız bir kavramdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200124
					]
				},
				{
					"id": 730200124,
					"content": "#Evet Nara {NICKNAME}, ormanın ilkelerini gayet iyi anlamışsın. Ormanın içindeki hayat doğmak, büyümek ve tekrar toprağa dönmekten ibarettir... Böyle bir sürecin \"gün\" kavramına ihtiyacı yoktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200125
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200125,
					"content": "Bu anlattığın şey Paimon'a saçma geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200126
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302002,
			"completionStepIds": [
				7302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
