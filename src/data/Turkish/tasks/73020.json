				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200201,
					"content": "Ah! Ne zamandır bu Kafa Mantarının hayalini kuruyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200202
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200202,
					"content": "Acaba tatlı kokun olmasa da aynı olur muydun, Kafa Mantarı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200203
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200203,
					"content": "Hehe... Bu mantar sahiden de çok güzel kokuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200204,
					"content": "Neyse, hadi çıkalım buradan!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302003,
			"completionStepIds": [
				7302010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302010",
							"2"
						],
						"stepId": 7302010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Arachatora",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730200301,
					"content": "İkinizle karşılaştığım için çok şanslıyım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200302
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200302,
					"content": "Olgunlaşmış bir Kafa Mantarının kokusu bu. Üstelik her zamankinden daha da yoğun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200303
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200303,
					"content": "Demek Marana senin yaşam alanını ele geçirdikten sonra bile büyümeye devam ettin. Harikasın sen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200304
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200304,
					"content": "Şey... Artık tadına bakabilir miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200305,
					"content": "Tabii. Bana yardım etmiş olmanız bir yana, aşçılık eğitimimin amacı başından beri Naralara en lezzetli mantar yemeğini yedirmekti zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200306
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200306,
					"content": "Yaşasın! Kafa Mantarı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200307,
					"content": "Arachatora hemen yemek pişirmeye başlıyor...\\nMantarın taze kokusu tencereden etrafa yayılıyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200308
					]
				},
				{
					"id": 730200308,
					"content": "Yemek hazır olduğunda da Arachatora sana ve Paimon'a servis ediyor.\\nYemek, hayal kırıklığına uğratıcı mı yoksa olması gerektiği gibi mi belli değil çünkü herhangi bir tat alamıyorsunuz.\\nAyrıca diri kalmış ve çiğnemesi çok zor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						730200309
					]
				},
				{
					"id": 730200309,
					"content": "Bitti. Aşçılık eğitimimi de artık başarıyla tamamlamış oldum. Tadı nasıl? Eminim ki bu, Naraların şu ana kadar yediği en lezzetli yemek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200310
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200310,
					"content": "*ham ham* *yutkunur* Şey... Paimon nasıl dese...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200311,
					"content": "*güçlükle çiğner*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200312
					]
				},
				{
					"id": 730200312,
					"content": "*güçlükle yutar*",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200313,
						730200314,
						730200315
					]
				},
				{
					"id": 730200313,
					"content": "Yeterince uğraşırsan yenilebiliyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200316,
					"content": "Hımm... Mantarın kokusu gerçekten de çok güzel ama dokusu ve tadı pek bize göre değil sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200317
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200317,
					"content": "Ha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200318
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200318,
					"content": "Bu nasıl olabilir? Daha önce bunu bir Naraya yedirdiğimde, tadının güzel olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200319
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200319,
					"content": "Daha önce mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200320,
					"content": "Geçmişte mantarlı yemeğimi bir Naraya yedirmiştim. Çok beğendiği için hepsini bir çırpıda yutuvermişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200321
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200321,
					"content": "Tadı güzelmiş demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200322
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200322,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200323
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200323,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200324
					]
				},
				{
					"id": 730200324,
					"content": "Demek ki her Nara mantarın tadını sevmeyebiliyormuş. Tıpkı farklı Aranaraların farklı yaprakları yetiştirmesi gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200325
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200325,
					"content": "Aa, yaprak demişken... Siz Aranaralar ateşten korkmuyor musunuz? Her tarafında yaprak var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200326,
					"content": "Tabii ki korkuyoruz. Bazen ormanda yangın çıktığında her şey yanıp kül oluyor, geriye yalnızca çorak topraklar kalıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200327
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200327,
					"content": "Gerçi ben bu ateşi aşçılık eğitimim için yaktım. Yani korkumu yenmek ve ateşin derecesini kontrol altında tutmak eğitimimin bir parçası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200328
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200328,
					"content": "Demek öyle... Neyse, artık geri dönmemiz lazım. Arapacati sizi bekliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200329,
					"content": "Evet, hemen Vanarana'ya döneceğim. Kıymetli kardeşimi daha fazla merakta bırakmayayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200330
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200330,
					"content": "Diğerlerine gelecek olursak... Arasaka, Arapas ve Araphala şu anda <color=#00E1FFFF>Gandharva</color>, <color=#00E1FFFF>Apam Ormanı</color> ve <color=#00E1FFFF>Devantaka Dağı</color> civarındalar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200331
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200331,
					"content": "#Teşekkürler. Altın Nara {NICKNAME} bir güneş gibi parlıyor. Paimon da çok harika biri sayılır. Kardeşimin talebinde sizlere güveniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200332
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200332,
					"content": "Ne demek Paimon da \"çok harika biri sayılır\"?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200333
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200333,
					"content": "He, onu boş ver şimdi... Bunca yardımınızın karşılığını nasıl öderim hiç bilmiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200334
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200334,
					"content": "Hımm... En iyisi sana Üstün Lezzetimin tarifini vereyim. Belki de büyüdükçe tadını sevmeye başlarsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200335
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200335,
					"content": "#({NICKNAME}! Paimon bu tarifi biraz değiştirirse, çok güzel ve orijinal bir yemek çıkabilir!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730200314,
					"content": "En azından zehirli değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				},
				{
					"id": 730200315,
					"content": "Böyle bir şeyi yiyebilmem için henüz çok erken.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200316
					]
				}
			]
		},
