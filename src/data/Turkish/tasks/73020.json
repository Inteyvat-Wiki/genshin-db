				"points": []
			},
			"dialogs": [
				{
					"id": 730200401,
					"content": "Kafa Mantarı toplayıp aşçılık eğitimimi tamamlayabildiğim için çok mutluyum. Üstelik güçlü ve güvenilir bir Narayla da tanıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200402
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200402,
					"content": "#Arapacati, Arasaka, Arapas ve Araphala da çok minnettar kalacaklar. Nara {NICKNAME} sen iyi bir Narasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730200403
					],
					"speakerTitle": "Arachatora"
				},
				{
					"id": 730200403,
					"content": "Minnettar mı? Neden ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730200404
					]
				},
				{
					"id": 730200404,
					"content": "Çünkü sen bana yardım ederek onlara da Kafa Mantarını tatma fırsatı sundun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arachatora"
				}
			]
		},
