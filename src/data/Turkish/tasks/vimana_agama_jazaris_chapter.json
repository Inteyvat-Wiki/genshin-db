			"dialogs": [
				{
					"id": 730260801,
					"content": "Ne kadar çabuk döndünüz öyle. Ben hâlâ bu bileşenlerin yük taşıyıcı yapısını inceliyorum. Asansörü çalıştırabilmenize de çok şaşırdım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260802
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260802,
					"content": "Makinayı etkinleştirme yöntemini kafadan sallamıştın, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260803
					]
				},
				{
					"id": 730260803,
					"content": "Şey... Sadece kitaplarda okuduğum bilgiler işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260804
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260804,
					"content": "Bilin diye söylüyorum, tüm Akademide bu taslağı okuyabilen kişi sayısı üçü geçmez. Yani doğru tahmin edebilmiş olmam bile bir başarı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260805
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260805,
					"content": "Neyse, asansör çalıştığına göre orta seviyedeki aktarıcıları çalıştırarak yukarıdaki komuta odasına erişebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260806
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260806,
					"content": "Anlıyorum... Orta seviye dişli, güç odasında olmalı. Dört aktarım ünitesini de etkinleştirmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260807
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260807,
					"content": "Eğer işe yarayan bir Enerji Bloku bulamazsak onları geçici olarak cihazdan çıkarabiliriz. En son aşamada birbirlerine bağlı oldukları sürece sorun yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260808
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260808,
					"content": "Ben de sizi burada bekleyeyim en iyisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				}
			]
		},
		{
			"id": 7302609,
			"completionStepIds": [
				7302614
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302614",
							"2"
						],
						"stepId": 7302614,
						"stateName": "QUEST_STATE_UNFINISHED"
