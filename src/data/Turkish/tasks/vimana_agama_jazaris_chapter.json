			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730260601,
					"content": "Vay be! Çalışmaya başladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260616
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260616,
					"content": "Ne düşünüyorsun? Harabe Devinin içindeki makina, ister aktarıcı olsun ister tuzak kapısı, bu Enerji Bloku tarafından güçlendirilebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260602
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260602,
					"content": "Gerçi nedense hiçbir şey değişmemiş gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260603,
					"content": "Bu yedek sistem bir dizi ufak güç aktarıcısından oluşuyor da o yüzden.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260604
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260604,
					"content": "Anlayacağınız tepeye kadar çıkıp hepsini açmamız lazım. Sistem ancak tüm aktarıcılar bağlandıktan sonra çalışmaya başlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260605
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260605,
					"content": "Hepsi mi dedin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260606
					]
				},
				{
					"id": 730260606,
					"content": "Bu Harabe Devinin aldığı hasara bakılırsa tam güçte çalıştırmak epey zor olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260607
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260607,
					"content": "Sen bu aktarıcıyı çalıştırırken güç odasında bunu buldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260608
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260608,
					"content": "Harabe Devinin bir taslağı gibi duruyor. Belki de bakım ekibi burada bırakmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260609
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260609,
					"content": "Bu taslağa göre makinayı başlatmak için birkaç tane ana aktarıcıyı bağlamamız yetecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260610
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260610,
					"content": "En azından şimdi asansörü çalıştırıp komuta kabinine çıkabileceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260611
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260611,
					"content": "Pek de ikna edici gelmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260612
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260612,
					"content": "Eh, yapabileceğimiz başka bir şey yok. Önce asansörü çalıştırmayı deneyin bari.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260613
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260613,
					"content": "Nasıl yani? Sen bizimle gelmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260614,
					"content": "Ben burada kalıp foto... Yani şey, Harabe Devinin iç yapısını inceleyeceğim. O da gayet önemli bir iş sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260615
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260615,
					"content": "Ayrıca ben bir alimim. İşinde sana doğrudan yardımcı olmak için yapabileceğim pek bir şey yok. Yine de teknik bir sorun yaşarsanız buradayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				}
			]
		},
