			"dialogs": [
				{
					"id": 730261301,
					"content": "Talimatlara uyun dememiş miydim ben?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261302
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261302,
					"content": "Biz bir şey yapmadık ki...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261303
					]
				},
				{
					"id": 730261303,
					"content": "Kolu kendi kendine düştü bir kere! Paimon'a göre buradaki tek suçlu makinanın kendisi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730261304,
					"content": "Pekala, bunu bir deney kazası olarak kaydedeceğim o zaman. Off... Umarım raporumu kötü etkilemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261305
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261305,
					"content": "Neyse, belli ki Harabe Devini tekrar çalıştıramıyoruz. Yani sizi burada oyalamamın alemi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261306
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261306,
					"content": "Yer altı harabelerindeki kirliliği araştırmaya geldiğinizi biliyorum ama korkarım ki bu Harabe Devi artık pek bir işinize yaramayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261307
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261307,
					"content": "Yine de kim bilir, belki şu an yaptıklarınız sonucunda beklenmedik bir gelişme olduğunu fark edersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261308
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261308,
					"content": "Ben sizi daha fazla tutmayayım. Zaten burada kendi araştırmamı tamamlamam gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261309
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261309,
					"content": "İşiniz bittiğinde gelip beni bulabilirsiniz... Tabii Harabe Devini mahvettiğim için disipline sevk edilmezsem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261310
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261310,
					"content": "Beni bulursanız Kaos Çekirdeği araştırma projesi için başvurmanıza yardımcı olabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261311
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261311,
					"content": "Projenin sorumlusu ben olacağım ama endişelenmeyin tabii. Tahsis edilen paranın yarısı sizin olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261312
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261312,
					"content": "Öğrenme hevesi olan herkes akademik kariyer yapabilir. Hayallerinizin peşinden gidin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				}
			]
		}
	]
