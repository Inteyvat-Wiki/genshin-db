			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Jazari"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730260901,
					"content": "Siz yukarıda ne yapıyordunuz öyle? Tam bu ilkel devreyi inceliyordum ki kulağıma çok tuhaf bir gürültü geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260902
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260902,
					"content": "Her ne yapıyorsanız lütfen yapmayın. Bu makinayla ilgili bir sorun çıkarsa Akademi için yazacağım raporda durumu açıklamam çok zor olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260903,
						730260906
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260903,
					"content": "Makinanın pilotuyla tanıştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260904
					]
				},
				{
					"id": 730260904,
					"content": "Pilot mu? Şaka yapıyorsunuz herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260905
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260905,
					"content": "Khaenri'ah halkı bile binlerce yıl yaşayamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260909
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260909,
					"content": "Neyse, görüyorum ki ortadaki aktarıcıları bağlamışsınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260910
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260910,
					"content": "Benim de işim bitmek üzere. Hadi komuta kabinine çıkalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260911
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260911,
					"content": "Harabe Devinin kontrol sistemlerini etkinleştirmek için önceden yaptığımız gibi güç sistemini komuta kabinine bağlamamız lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260906,
					"content": "Eski bir dostumuzla karşılaştık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260907
					]
				},
				{
					"id": 730260907,
					"content": "Sen ve bu çocuk... Tamam, neyse. O zaman şöyle yapalım, ben Akademiye iki tane tavsiye mektubu yazayım. Böylece ikiniz gelecekte de beraber çalışmaya devam edebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260908
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260908,
					"content": "Hayır, öyle bir şey değil ya!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260909
					],
					"speakerTitle": "Paimon"
				}
			]
		},
