			"dialogs": [
				{
					"id": 730260101,
					"content": "Bu, daha önce Paimon'un girdiği büyük robota benziyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260102,
					"content": "Daha önce bir Harabe Devinin içine girmiş miydin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260103
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260103,
					"content": "Evet! Çöldeyken Afratu adında biri, bunun gibi makinalara bakmamızı istemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260104,
					"content": "Afratu mu? Lanet olsun, sakın bana onun da bu \"Ünlü Harabe Devi Araştırmacısı\" unvanında gözü olduğunu söyleme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260105
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260105,
					"content": "Yani tam da öyle olduğunu sanmıyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260106
					]
				},
				{
					"id": 730260106,
					"content": "Onun bir Vahumana Araştırmacısı olduğunu hatırlıyorum, bununla ilgileneceğini sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260107
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260107,
					"content": "İmkansız da sayılmaz ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260108
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260108,
					"content": "Ne de olsa burası, bilge Iskandar'ın \"Bak! Binlerce yıllık kadim Khaenri'ah tarihi önümüzde uzanıyor!\" sözünün geldiği yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260109
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260109,
					"content": "\"Ünlü araştırmacı\" konusunu yeterince konuştuk. Bizim daha önce gördüğümüze kıyasla burası oldukça ıssız görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260110,
					"content": "Tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260111
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260111,
					"content": "\"Kadim Khaenri'ah Harabe Devi Araştırmaları Üzerine İnceleme\" adlı metne göre, sistematik bir araştırma yapmak üzere bir Harabe Devinin içine girebilen son araştırmacı Pir Kavikavus imiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260112
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260112,
					"content": "Muhtemelen bunu da bilmiyorsundur ama Pir Kavikavus, Kshahrewar tarihindeki en büyük alimlerden biriydi. Daha otuz yaşına gelmeden Herbad unvanını almıştı, büyük bir akademik dehaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260113
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260113,
					"content": "Başarıları sayesinde eninde sonunda bir bilge olacağına şüphe yoktu fakat bir keşif esnasında kaza geçirdi. Bütün araştırmalarının sonuçları da beraberinde kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260114
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260114,
					"content": "Kshahrewar o zamandan beri eskisi gibi değil. O daha uzun süre yaşasaydı, belki şu an masraflar konusunda bu kadar dertlenip durmazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260115
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260115,
					"content": "Bu arada benim akademik hedefim de Pir Kavikavus'un izinden gitmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260116
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260116,
					"content": "Yani sonraki adımımız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260117,
						730260119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260117,
					"content": "Girişi zorla açmak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260118
					]
				},
				{
					"id": 730260118,
					"content": "Aynen. Tabii önce bu koca makinayı çalıştırmamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260121,
					"content": "Doğru. Harabe Devini etkinleştirebilirsem, çok değerli deneysel veriler elde edebilirim. Bu veriler de araştırmamın dönüm noktası olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260122
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260122,
					"content": "Kendinden öncekileri geçebilmek istiyorsan, bir devrim yapman gerekir sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260123
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260123,
					"content": "Bu devasa şeye komuta kabininden başlayacağız değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260124,
					"content": "Hımm... Genellikle komuta kabinindeki \"ayırma vanası\" açıldığında Harabe Devi de etkinleştirilebilirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260125
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260125,
					"content": "Lakin daha önce de dediğim gibi, tüm harabe makinaları çekirdeklerinde bulunan karanlık enerji sayesinde çalışır. Şu an Harabe Devinin tüm çekirdekleri yer altında mühürlü halde duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260126
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260126,
					"content": "Komuta kabinine girebilsek bile, bilindik yöntemler işimize yaramayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260127
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260127,
					"content": "Aslına bakarsan daha önümüzdeki asansörü bile çalıştıramıyoruz biz. Tepedeki komuta kabinine nasıl gireceğiz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260128
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260128,
					"content": "Hımm, haklısın... O zaman şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260129,
						730260131
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260129,
					"content": "Vurmayı deneyelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260130
					]
				},
				{
					"id": 730260130,
					"content": "Durun bakalım! Akademiden resmi araştırma izni almış olabilirim ama bu, makinaya istediğimiz gibi zarar verebileceğimiz anlamına gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260132
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260132,
					"content": "Ne derler bilirsiniz: \"Bir kapı kapanırken diğeri açılır.\" Khaenri'ah halkının böyle bir durumun gerçekleşme olasılığını göz önünde bulundurduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260133
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260133,
					"content": "Akademinin yaptığı araştırmalara göre, eski harabe makinalarında yedek güç sistemleri de varmış. Belki de bu karanlık enerjiyi kullanmalarını sağlayan teknikler hâlâ gelişme aşamasında olduğu için, böyle bir sistem kurmuşlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260134,
						730260140
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260134,
					"content": "Güç sistemi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260135
					]
				},
				{
					"id": 730260135,
					"content": "Bu güç sistemi, neredeyse sınırsız enerji sağlayan çekirdeklerin aksine bir dizi ufak güç aktarıcısından oluşur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260136
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260136,
					"content": "Bu tarz cihazların güç kaynağı, Ley Hatlarından çıkarılan saf enerjinin depolandığı enerji bloklarıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260137
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260137,
					"content": "Vahu{RUBY#[S]Nedenbilim}mana araştırmacılarına göre, kadim Khaenri'ah'da ilk harabe makinası yapılmadan uzun zaman önce de bu güç sistemi yaygın olarak kullanılıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260138
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260138,
					"content": "Daha önce de söylediğim gibi, bu Harabe Devi eski bir model. Yani içinde o yedek güç sisteminin olması lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260139
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260139,
					"content": "Çekirdek güç kabini altta. Önce oraya inelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260140,
					"content": "Ne yapmam gerektiğini söyle yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260141
					]
				},
				{
					"id": 730260141,
					"content": "Çekirdek güç kabini altta. Önce oraya inelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260131,
					"content": "Alışılmadık bir yöntem olduğunu mu ima ediyorsun yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260132
					]
				},
				{
					"id": 730260119,
					"content": "Akademik araştırma yapmak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260120
					]
				},
				{
					"id": 730260120,
					"content": "Pardon da buraya yer altı harabelerini araştırmaya geldiğimizi unuttun mu yoksa? Akademik araştırma yapmak tabii ki önemli ama önce şu koca makinayı nasıl çalıştıracağımızı çözmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260121
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7302605,
			"completionStepIds": [
				7302605
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302605",
							"2"
						],
						"stepId": 7302605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730260501,
					"content": "Burası Paimon'un düşündüğünden de daha büyükmüş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260502,
					"content": "E, herhalde öyle! Dur, şimdi o ünlü sözü söyleme vakti geldi galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260503
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260503,
					"content": "\"Bak! Binlerce yıllık kadim Khaenri'ah tarihi önümüzde uzanıyor!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260504
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260504,
					"content": "Kusura bakmayın, bir anda kendimi kaptırıverdim. Bir Vahu{RUBY#[S]Nedenbilim}mana bilgesi olan Iskandar'ın söylediği ünlü bir sözdür bu. Daha önce hiç biyografisini okumadınız mı yoksa?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260505,
						730260506
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260505,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260508
					]
				},
				{
					"id": 730260508,
					"content": "Kitaplarda bunu birçok kez okumuş olmama rağmen ilk defa bizzat tanıklık ediyorum. Heyecanıma hakim olmakta zorlanıyorum haliyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260509
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260509,
					"content": "Şu sarmaşıklara baksana. Belli ki buraya epeydir birisi gelmemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260510,
					"content": "\"Kadim Khaenri'ah Harabe Devi Araştırmaları Üzerine İnceleme\" adlı metne göre sistematik bir araştırma yapmak için bir Harabe Devinin içine girebilen son alim Pir Kavikavus imiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260511
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260511,
					"content": "Muhtemelen bunu da bilmiyorsundur ama Pir Kavikavus, Kshahrewar tarihindeki en büyük alimlerden biriydi. Daha otuz yaşına gelmeden Herbad unvanını almıştı, büyük bir akademik dehaydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260512
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260512,
					"content": "Başarıları sayesinde eninde sonunda bir bilge olacağına şüphe yoktu fakat bir keşif esnasında kaza geçirdi. Bütün araştırmalarının sonuçları da kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260513
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260513,
					"content": "Kshahrewar o zamandan beri eskisi gibi değil. O daha uzun süre yaşasaydı belki şu an masraflar konusunda bu kadar dertlenip durmazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260514
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260514,
					"content": "Bu arada benim akademik hedefim de Pir Kavikavus'un izinden gitmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260515
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260515,
					"content": "Tamam ama şimdilik akademik hedefini bir kenara bırak. Şu an yapmamız gereken...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260516,
						730260518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260516,
					"content": "Girişi zorla açmak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260517
					]
				},
				{
					"id": 730260517,
					"content": "Aynen. Tabii önce bu koca oğlanı çalıştırmamız gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260520,
					"content": "Doğru. Harabe Devini etkinleştirebilirsem çok değerli deneysel veriler elde edebilirim. Bu veriler de araştırmamın dönüm noktası olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260521
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260521,
					"content": "Sonuçta kendinden öncekileri geçebilmek istiyorsan bir devrim yaratman gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260522
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260522,
					"content": "O halde çalıştıralım hadi! Buralarda mekanizma gibi bir şey olması gerek... Basınca ışık yanan şeyler var ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260523
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260523,
					"content": "Hımm... Burada bir tane olduğunu hatırlar gibiyim. Kayıtlarımıza göre komuta kabinindeki Ayırma Vanası açılırsa Harabe Devi de etkinleştirilebilirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260524
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260524,
					"content": "Lakin daha önce de dediğim gibi tüm harabe makinaları çekirdeklerinde bulunan karanlık enerji sayesinde çalışır. Şu an Harabe Devinin tüm çekirdekleri yer altında mühürlü halde duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260525
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260525,
					"content": "Komuta kabinine girebilsek bile bilindik yöntemler işimize yaramayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260526
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260526,
					"content": "Zaten daha önümüzdeki asansörü bile çalıştıramıyoruz. Tepedeki komuta kabinine nasıl gireceğiz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260527
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260527,
					"content": "Hımm, haklısın... O zaman şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260528,
						730260530
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260528,
					"content": "Vurmayı deneyelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260529
					]
				},
				{
					"id": 730260529,
					"content": "Durun bakalım! Akademiden resmi araştırma izni almış olabilirim ama makinaya istediğimiz gibi zarar verebiliriz demek değil bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260531
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260531,
					"content": "Ne derler bilirsiniz: \"Bir kapı kapanırken diğeri açılır.\" Khaenri'ah halkının böyle bir durumun gerçekleşme olasılığını göz önünde bulundurduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260532
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260532,
					"content": "Akademinin yaptığı araştırmalara göre eski harabe makinalarında yedek güç sistemleri de varmış. Belki de bu karanlık enerjiyi kullanmalarını sağlayan teknikler hâlâ gelişme aşamasında olduğu için böyle bir sistem kurmuşlardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260533,
						730260539
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260533,
					"content": "Güç sistemi mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260534
					]
				},
				{
					"id": 730260534,
					"content": "Bu güç sistemi, neredeyse sınırsız enerji sağlayan çekirdeklerin aksine bir dizi ufak güç aktarıcısından oluşur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260535
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260535,
					"content": "Bu tarz cihazların güç kaynağı, Ley Hatlarından çıkarılmış saf enerjinin depolandığı enerji bloklarıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260536
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260536,
					"content": "Vahu{RUBY#[S]Nedenbilim}mana araştırmacılarına göre kadim Khaenri'ah'da ilk harabe makinası yapılmadan uzun zaman önce de bu güç sistemi yaygın olarak kullanılıyormuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260537
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260537,
					"content": "Daha önce de söylediğim gibi bu Harabe Devi eski bir model. Yani içinde o yedek güç sisteminin olması lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260538
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260538,
					"content": "Çekirdek güç kabini altta. Önce aşağıya inelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260539,
					"content": "Ne yapmam gerektiğini söyle yeter.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260540
					]
				},
				{
					"id": 730260540,
					"content": "Çekirdek güç kabini altta. Önce aşağıya inelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730260530,
					"content": "Bilinmedik bir yöntem olduğunu mu ima ediyorsun yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260531
					]
				},
				{
					"id": 730260518,
					"content": "Akademik araştırma yapmak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260519
					]
				},
				{
					"id": 730260519,
					"content": "Pardon da buraya yer altı harabelerini araştırmaya geldiğimizi unuttun mu yoksa? Akademik araştırma yapmak tabii ki önemli ama önce şu koca oğlanı nasıl çalıştıracağımızı çözmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730260506,
					"content": "Sen bir Kshahrewar araştırmacısı değil misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260507
					]
				},
				{
					"id": 730260507,
					"content": "Eh, irfan dediğin sonsuzdur. Ben de öğrenciliğime bir sınır koymak istemem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260508
					],
					"speakerTitle": "Jazari"
				}
			]
		},
		{
			"id": 7302606,
			"completionStepIds": [
				7302603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
