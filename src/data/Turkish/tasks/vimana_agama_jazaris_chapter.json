			},
			"dialogs": [
				{
					"id": 730261101,
					"content": "Öff... Burada bu siyah taş levha dışında değerli görünen hiçbir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730261102,
					"content": "Taş levha mı dedin? O levhayı sakın küçümseme. Kontrol sistemini çalıştırabilirsek o levha sayesinde dışarıyı görebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261103
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261103,
					"content": "Bu kontrol sistemi hâlâ çalışabilirmiş gibi duruyor. Khaenri'ah'dan kalan bu yapılar gerçekten de muazzam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261104
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261104,
					"content": "Hayatımda hiç böyle bir fırsat yakalayacağımı hiç düşünmemiştim. Bu araştırma raporunu tamamladıktan sonra Pir Kavikavus Ödülünü kazanacağıma eminim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261105
					],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261105,
					"content": "Hadi şu makinayı çalıştırmayı deneyelim. Paimon heyecandan yerinde duramıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261106,
						730261107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730261106,
					"content": "Harika bir fikir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261108
					]
				},
				{
					"id": 730261108,
					"content": "Durun bakalım, sakın aceleye getirmeyelim. Talimatlara uymamız gerek!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jazari"
				},
				{
					"id": 730261107,
					"content": "Evet, zamanımız boşa gidiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261108
					]
				}
			]
		},
