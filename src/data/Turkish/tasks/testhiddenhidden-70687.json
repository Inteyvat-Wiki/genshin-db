			"dialogs": [
				{
					"id": 706870101,
					"content": "Merhaba sevgili misafirler! Buradan buyurun lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870102
					],
					"speakerTitle": "Minik Kurt"
				},
				{
					"id": 706870102,
					"content": "Madam Büyücü'nün üstün astroloji becerilerine sahip bir arkadaşı, senin için bir hediye hazırladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870103
					],
					"speakerTitle": "Minik Kurt"
				},
				{
					"id": 706870103,
					"content": "Vay canına! Ne şirin bir kristal top... Hem de çok pahalı görünüyor... Margaret ne kadar verir acaba? On milyon mu? Yok yok, en az yirmi milyon Mora!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870104,
					"content": "Şey... Pardon, Paimon kaptırdı biraz! Neyse, bu ne işe yarıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870105,
					"content": "Madam Büyücü'nün arkadaşının deyişiyle: \"Büyücülerin olduğu yerde onlara layık kristal küreler de vardır.\" Onun sayesinde misafirlerimiz muhteşem yeni sahnelere imza atabilecekler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870106
					],
					"speakerTitle": "Minik Kurt"
				},
				{
					"id": 706870106,
					"content": "Ne demeye çalıştığını pek anlamadım ama. Ben sadece bir kapı görevlisiyim! Kristal küreye baksam da kendi yüzümden başka bir şey görmem...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870107
					],
					"speakerTitle": "Minik Kurt"
				},
				{
					"id": 706870107,
					"content": "Ha evet, bir de bu kutu var! Madam Büyücü'den gelen başka bir hediye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870108
					],
					"speakerTitle": "Minik Kurt"
				},
				{
					"id": 706870108,
					"content": "\"Bu gizli sahnede, kaderin bile öngöremediği kadar muhteşem bir performans sergileyebilirseniz bu küçük kutudaki muhteşem hazineler sizin olacak...\" Böyle söyledi en azından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870109
					],
					"speakerTitle": "Minik Kurt"
				},
				{
					"id": 706870109,
					"content": "H-Hazineler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706870110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706870110,
					"content": "Benden bu kadar! Kapı görevlisi olarak olayın heyecanını kaçırmam hoş olmaz. O yüzden lütfen her zamanki gibi tüm cesaretinizle çıkın sahneye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Minik Kurt"
				}
			]
		}
	]
}