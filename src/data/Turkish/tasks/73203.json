				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030301,
					"content": "Tekrar teşekkür ederim. Açıkçası Sumeru Güllerinin bu ortamda yetiştiğini görmek beni çok mutlu ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030302
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030302,
					"content": "Sabbah ile konuşurken, yeni yapraklar çıkmaya başlıyor...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030303
					]
				},
				{
					"id": 732030303,
					"content": "Yapraklar aralanıyor ve tomurcuklar ortaya çıkıyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030304
					]
				},
				{
					"id": 732030304,
					"content": "Çiçek tomurcukları yavaşça açılıyor ve Sumeru Güllerine dönüşüyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030305
					]
				},
				{
					"id": 732030305,
					"content": "Sabbah bir tanesini koparıp sana ve Paimon'a veriyor.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732030306
					]
				},
				{
					"id": 732030306,
					"content": "Hiç gerek yoktu, zaten sende de çok az var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030307
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030307,
					"content": "Önemli değil. Siz olmasaydınız bu da mümkün olmazdı zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030308,
						732030309
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030308,
					"content": "Sadece birazcık yardımcı olduk.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				},
				{
					"id": 732030310,
					"content": "Gül bahçelerinin büyüleyici olduğuna şüphe yoktur zaten ama tek bir gülün de kendine has bir güzelliği vardır. Araştırmacılık yaptığım günlerden beri güller çok ilgimi çeker.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030311
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030311,
					"content": "Ne? Sen araştırmacı mıydın yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030312,
					"content": "Doğru ya, size henüz anlatmamıştım bunu. Ben aslında Aaru Köyü'nün yerlisi değilim. Buraya Akademiden \"taşındım\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030313
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030313,
					"content": "Gördün mü? Paimon sana Sabbah'ın tıpkı karşılaştığımız araştırmacılar gibi çok etkileyici konuştuğunu söylememiş miydi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030314,
					"content": "Gülleri incelemeye devam etmek için diktin, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030315
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030315,
					"content": "Tam olarak değil. Açıkçası araştırmacıların alanlarına duydukları ilginin yalnızca araştırma amaçlı olmaması gerektiğine inanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030316
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030316,
					"content": "Bunu bu dünyayı sevdiğim ve bitkilerin yaşam döngüsünü anlamak istediğim için yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030317
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030317,
					"content": "Bir zamanlar, coğrafi değişikliklerin güllerin evrimi üzerindeki etkisi üzerine çalışırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030318
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030318,
					"content": "Bir düşünsenize. Sumeru'nun çevre koşulları bir anda tamamen değişiverseydi bu güller nasıl adapte olurdu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030319
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030319,
					"content": "Sarmaşık gibi duvarlara mı tırmanırlardı? Öyle olsaydı eğer, Akademinin duvarları şimdiye güllerle kaplı olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030320
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030320,
					"content": "Kümeler oluştururlar mıydı? Bildiğin doğal bir buket! Harika olmaz mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030321
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030321,
					"content": "Hatta belki farklı farklı renkleri oluşturabilirlerdi. Beyaz, kırmızı, altın rengi... Birbirinden farklı, yepyeni türler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030322
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030322,
					"content": "Tabii artık çok az araştırmacı yeni türler keşfediyor. Eskiden en başarılı araştırmacıların yaptığı gibi, yeni türleri geliştirenlerin sayısı ise oldukça azaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030323
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030323,
					"content": "Demek istediğim şu... Aslında her gülde çok büyük bir potansiyel vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030324
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030324,
					"content": "Olasılıkları incelemek bana büyük bir keyif veriyor. Eskiden her gün örnek toplamaya bayılırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030325
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030325,
					"content": "Şimdi geriye dönüp baktığımda, ne kadar da sade ve neşeli zamanlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030326
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030326,
					"content": "Neyse, bunu alın lütfen. Bu benim için bir kayıp değil, aksine sizinle mutluluğumu paylaşıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030327
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030327,
					"content": "Hâlâ içinize sinmediyse beni daha sık ziyaret edin ve yanınızda biraz Sumeru Gülü getirin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030328
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030328,
					"content": "Sizinle konuşurken kendimi rahat hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030329
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030329,
					"content": "Ne anlatırsam anlatayım asla saçma olduğunu düşünüp lafımı kesmediniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030330
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030330,
					"content": "Sizin için küçük hediyelerim de var. Benim işime yaramıyorlar ama hoşunuza gidebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030331
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030331,
					"content": "Geri döneceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030332
					]
				},
				{
					"id": 732030332,
					"content": "Lütfen dönün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030309,
					"content": "Önemli bir şey değildi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030310
					]
				}
			]
		},
