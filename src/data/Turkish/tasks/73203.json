				{
					"id": 732030401,
					"content": "Önsezin yok ama Doğayı kontrol edebiliyorsun. Anladığım kadarıyla sıradan bir maceracı değilsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030402
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030402,
					"content": "Önsezisi olmadan elementleri kontrol edebilen insanlar olduğu söylenir ama bu insanlara pek de iyi gözle bakılmaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030403
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030403,
					"content": "Halbuki senin kalbin tertemiz. Doğru yoldan sakın sapma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
