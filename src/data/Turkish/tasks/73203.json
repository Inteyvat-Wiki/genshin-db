			"dialogs": [
				{
					"id": 731930501,
					"content": "Siz olmasaydınız güllerin filizlendiğini asla göremezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930502
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930502,
					"content": "Bunun olacağını bilseydim... Tohumlar yerine daha fazla kitap getirirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930503,
						731930519
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930503,
					"content": "Buradan değil misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930504
					]
				},
				{
					"id": 731930504,
					"content": "Anlamamış mıydınız? Artık uyum sağlayabilmişim demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930505
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930505,
					"content": "Buraya ilk geldiğimde hiçbir şeye alışamamıştım. Yemekler, evler... Her şey bana yabancıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930506
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930506,
					"content": "Sonra zamanla her şeye alıştım tabii.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930507
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930507,
					"content": "Yine de bu, durumu tamamen kabullendiğim anlamına gelmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930508
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930508,
					"content": "Burada Sumeru Şehri'nden gelen gülleri yetiştirmek de imkansız belli ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930509
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930509,
					"content": "Sen bir araştırmacı mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930510
					]
				},
				{
					"id": 731930510,
					"content": "Bir zamanlar öyle denebilirdi ama artık değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930511
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930511,
					"content": "Haddimi aşan bir şey söyledim ve bilmemem gereken bir şey öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930512
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930512,
					"content": "Akademinin tabularını yıktım, o yüzden beni attılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930513
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930513,
					"content": "Söylediğin şey neydi peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930514
					]
				},
				{
					"id": 731930514,
					"content": "Merak hem bilgelik arzusunun kaynağı hem de günahların sebebidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930515
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930515,
					"content": "Bunu buraya sürüldükten sonra öğrendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930516
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930516,
					"content": "Güvenlik sebebiyle detaylara girmeyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930517
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930517,
					"content": "Pekala.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930518
					]
				},
				{
					"id": 731930518,
					"content": "Öhöm... Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930535
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930535,
					"content": "Maceracılar yalnızca gelip gider, işlerini bitirdikten sonra asla geri dönüp sohbet etmezler sanırdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930536
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930536,
					"content": "Sizinle tekrardan uzunca sohbet etmeyi beklemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930537
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930537,
					"content": "Dürüst olmak gerekirse burada konuşabildiğim çok az arkadaşım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930538
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930538,
					"content": "Tekrar... Buraya gelip bitkilerimi gübreleyebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930539
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930539,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930540
					]
				},
				{
					"id": 731930540,
					"content": "Tamam o halde. Sizi bekleyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930519,
					"content": "Neden Sumeru Gülü yetiştirmek istiyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930520
					]
				},
				{
					"id": 731930520,
					"content": "Sumeru Gülleri hakkında pek bir şey bilmiyorsunuz sanırım. Çok kullanışlı bir bitkidir, pek çok farklı alanda kullanılabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930521
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930521,
					"content": "Yenilebilir, ilaç olarak kullanılabilir, hediye olarak verilebilir ve satılınca iyi para eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930522
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930522,
					"content": "Üstelik bunlar sadece en çok kullanıldığı alanlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930523
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930523,
					"content": "Geçmişte Sumeru Güllerinin çiçeği, yaprakları ve sapı bugün gördüğümüz gibi değildi. Bir zamanlar farklı farklı biçimleri vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930524
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930524,
					"content": "Bence coğrafik değişiklikler güllerin özelliklerini de değiştirmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930525
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930525,
					"content": "Özelliklerine bakarak geçmişe dair coğrafi ve tarihi bilgilere ulaşabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930526
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930526,
					"content": "Bu mekanizma öyle çabucak anlatılabilecek bir şey değil tabii. Böyle bir bilgiyi maceracılarla paylaşmak da muhtemelen kurallara aykırıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930527
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930527,
					"content": "Botanik evrim ile ilgileniyorsanız Akademiyi ziyaret edin derim. Orada bu konu hakkında daha fazla bilgi bulabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930528
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930528,
					"content": "Bunu araştırman için mi yapıyorsun yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930529
					]
				},
				{
					"id": 731930529,
					"content": "Artık araştırmacı değilim, o yüzden araştırmamı devam ettirmeye hakkım yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930530
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930530,
					"content": "İlla bir sebebe ihtiyacın varsa... *iç çeker* Sen de çok meraklı biriymişsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930531
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930531,
					"content": "Eskiden yaşadığım yerde bir sürü Sumeru Gülü yetiştirmiştim. Çok güzellerdi, her gün istediğim gibi seyredebiliyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930532
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930532,
					"content": "Keşke eskiden olduğu gibi şimdi de onları her gün tekrar görebilsem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930533
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930533,
					"content": "Başka bir nedenim yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731930534
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 731930534,
					"content": "Anlıyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731930535
					]
				}
			]
		},
		{
