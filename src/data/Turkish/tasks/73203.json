			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Sabbah"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732030101,
					"content": "Gelmişsiniz! Ne kadar dakiksiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030102
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030102,
					"content": "Tereyağlı Tavuk yaptım. Acıktıysanız benimle oturup yiyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030103
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030103,
					"content": "Tereyağlı Tavuk mu? Bu teklife nasıl hayır diyelim şimdi... Paimon'a kocaman bir tabak verin lütfen!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030104,
						732030105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030104,
					"content": "Kabalık etme Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				},
				{
					"id": 732030106,
					"content": "Tamam, affedersin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030107,
					"content": "Sorun değil, resmiyete gerek yok. Yemek yemeyi sevmek insanın doğasında vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030108
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030108,
					"content": "Sizin için biraz ısıtıp paket yapayım. Yardımınız için çok minnettarım, ne yapsam az kalır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030109
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030109,
					"content": "Çok naziksin Sabbah Hanım! Güllerin kesinlikle istediğin gibi büyüyüp çiçek açacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030110,
					"content": "Toprağı nemli tutuyorum, o yüzden filizler gayet iyi durumda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030111
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030111,
					"content": "Tek endişem biraz yavaş büyümeleri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030112
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030112,
					"content": "Genellikle, tohum iyi durumdaysa hızlıca filizlenir. Oysaki bazılarında hâlâ bir gelişme yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030113
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030113,
					"content": "Toprak yeterince verimli değil diye mi böyle oluyor emin değilim. Böyle giderse biraz daha gübrelemem gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030114,
						732030115
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030114,
					"content": "Hadi tekrar gübreleyelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030116,
					"content": "Bana bu iyiliği yapar mısınız gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732030117
					],
					"speakerTitle": "Sabbah"
				},
				{
					"id": 732030117,
					"content": "İşten bile değil ki. Hemencecik hallederiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732030115,
					"content": "Tekrar Doğa gücünü kullanmayı deneyebiliriz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030116
					]
				},
				{
					"id": 732030105,
					"content": "Paimon adına özür dilerim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732030106
					]
				}
			]
		},
		{
			"id": 7320303,
			"completionStepIds": [
				7320303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320303",
							"2"
						],
						"stepId": 7320303,
						"stateName": "QUEST_STATE_UNFINISHED"
