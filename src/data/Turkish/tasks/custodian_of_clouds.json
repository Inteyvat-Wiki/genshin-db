			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "Zemin unla kaplanmış. Cık, cık... Şef ne kadar dağınıkmış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090302,
					"content": "Hım, tencerede et var gibi duruyor ancak Paimon hangi tür olduğunu anlayamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090303,
					"content": "Sence bunu pişiren kişi Adeptuslara sunmak üzere mi pişiriyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090304,
					"content": "Hımm... Paimon un ve etle yapılan bir adağı tam olarak aklında canlandıramıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090305,
					"content": "Ha? Dağınık şefimiz yere bir kağıt parçası düşürmüş... Iy, üzerinde büyük ayak izleri de var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090306,
					"content": "Ayak izini bir kenara bırakırsak, belki de bu kağıdın gizemli yemekle bir ilgisi vardır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
