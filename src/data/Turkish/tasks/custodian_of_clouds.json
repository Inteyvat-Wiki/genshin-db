				"points": []
			},
			"dialogs": [
				{
					"id": 10091501,
					"content": "Hey, bu masayı buraya kim koydu? Bir de akşam yemeği için hazırlanmış, sürahi falan var...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091502,
					"content": "Konukların isimleri oturaklara kazınmış! \"Burada Hakim oturuyor...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091510
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091510,
					"content": "\"Burada Guizhong oturuyor...\" \"Burada Rex oturuyor...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091503
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091503,
					"content": "Belki de \"Rex\", \"Rex Lapis\"in kısaltmasıdır. Ama Paimon \"Guizhong\"u hiç bilmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091504,
					"content": "\"Hakim\"e gelecek olursak, hım... İşte bu! Ay Oymacısı Adeptus arkadaşlarının adlarını sıralarken \"Bulutlar Hakimi\" diye biri olduğunu söylemişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091505,
					"content": "O zaman Bulutlar Hakimi ve diğer Adeptuslar yemek partilerini burada veriyor olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091506,
					"content": "Neden Adeptuslar için çok özel yemekler pişirmiyoruz? Böylece Bulutlar Hakimi'nin dikkatini çekebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091507,
					"content": "Ama... Adeptuslar ne yer ki? Paimon hiç bilmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091508,
					"content": "İnsanlar buraya sürekli bir şeyler sunmaya getiriyor olmalı. Kalan yemek artıklarına bakarak fikir edinebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091509,
					"content": "Sence Adeptuslar... Karamelize Soslu Rosto denemek istiyor olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
