			},
			"dialogs": [
				{
					"id": 10090201,
					"content": "Birileri burada kesinlikle yemek pişirmiş. Sence bir adak mı sunuyorlardı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090202,
					"content": "Sanırım tüm malzemeleri kullanmamışlar. Bir bakalım... Bir miktar Aslanağzı var, biraz Nilüfer Başı, biraz Tofu... Her ne pişirmişlerse oldukça karmaşık olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090203,
					"content": "Hey, buraya bak... Bazı notlar da bırakmışlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10090204,
					"content": "Evet, bu mükemmel! Paimon hatırlamak için her şeyi not almalarına şaşırmadı, hatırlanacak çok şey var... Dikkatlice okumalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 100903,
			"completionStepIds": [
				100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100903",
