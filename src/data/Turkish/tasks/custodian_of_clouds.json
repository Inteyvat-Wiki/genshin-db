			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Bulutlar Hakimi"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091401,
					"content": "Çok etkilendim. Bu yerleşim yerinden geçen yol, sıradan becerileri olanlar için son derece zorludur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091402
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091402,
					"content": "Karşınızda Adeptus, Bulutlar Hakimi duruyor. Şimdi sizi buraya getiren konuyu anlatın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091403,
						10091405
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091403,
					"content": "Tüm bu mekanı sen mi inşa ettin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091404
					]
				},
				{
					"id": 10091404,
					"content": "Doğru tahmin. Hem bu mekanı hem de içindeki mekanizmaları ben inşa ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091407,
					"content": "Hatta Guizhong ve Rex Lapis bile teknolojik başarılarımı takdire şayan buldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091408
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091408,
					"content": "Burası kocaman bir yer! Bir sürü de mekanizma var... Buranın tümü sana mı ait?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091409,
					"content": "Neden böyle bir yer var? Burayı kendi mekanizma atölyen olarak mı inşa ettin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091410
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091410,
					"content": "Tıpkı hikayelerdeki gibi. Adeptuslar insanların dünyasını terk etti, inzivaya çekilmek için bir yer buldu ve sonrasında araştırma yapıp bu muhteşem şeyleri icat etti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091411,
					"content": "Ben sosyal etkileşimin sıkıcılığına katlanamadığım için biraz huzur ve sükunet istiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091412
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091412,
					"content": "Sonrasında buldum... Kısa süre sonra da elinizde Yetki Mührüyle siz geldiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091413
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091413,
					"content": "Ancak yeter! Hemen sizi buraya getiren meseleyi anlatın! Bu mekanın sükunetini yeterince bozdunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091414
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091414,
					"content": "Rex Lapis... Suikaste mi uğradı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091415
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091415,
					"content": "Bu nasıl olur? Ne kadar iğrenç bir suç... Kim buna cüret eder?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091416
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091416,
					"content": "Bu inanılmaz, akılalmaz bir olay... Doğruluğunu bağımsız olarak teyit etmem gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091417
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091417,
					"content": "... Belki de önce Liyue'yi yerle bir edip sonrasında diğer Adeptuslarla...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091418
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091418,
					"content": "... Pardon?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091419
					]
				},
				{
					"id": 10091419,
					"content": "Bekle, bekle! Az önce \"Liyue Limanı'nı yerle bir etmek\" mi dedin? Tüm şehri yok mu edeceksin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091420,
					"content": "İleride başka sorunlar yaşanmasını yalnızca yeterli şiddette verilen bir yanıt engelleyebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091421,
						10091423
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091421,
					"content": "Ancak Adeptuslar şehri korumaya yemin etti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091422
					]
				},
				{
					"id": 10091422,
					"content": "Dediğiniz gibi. Liyue Limanı'nı Rex Lapis'in önderliğinde 37 yüzyıl boyunca koruduk. Ancak hain taraflarca yapılan bu darbe karşısında... Sıra dışı önlemler alınması gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091425,
					"content": "Daha fazla acı çekildiğini görmek istemediğim için bu sıra dışı zamanda sıra dışı önlemlerin alınması gerekli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091426
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091426,
					"content": "Aman! Çabucak bir şey düşünmen gerek! Liyue'yi dümdüz etmek istiyor ve blöf yapıyor gibi de görünmüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091427,
					"content": "Sunduğumuz adağı kabul ettin, bu da sözleşme yaptık demek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091428
					]
				},
				{
					"id": 10091428,
					"content": "Paimon da aynısını söyleyecekti! Tüm bu lezzetli yemekleri yapıp son lokmasına kadar sana verdik!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091429
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091429,
					"content": "Liyue'ye yardım etmeni umuyorduk... Yerle yeksan etmeni değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091430
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091430,
					"content": "... Ya da en azından... Bir oturup tartışalım mı? İkinci bir görüş almak göz çıkarmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10091431,
					"content": "\"Sözleşme...\" Sözleşme Tanrısı'nın acımasızca öldürülmesinin ardından bu kavramı kullanmış olmanız zalimce bir ironi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091432
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091432,
					"content": "Liyue halkı sözleşmelerinden caymış olmaktan çok memnun gibi görünüyor. Siyah ve beyazı alıp griye çevirme konusunda oldukça ustalar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091433
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091433,
					"content": "Yine de... Madem buraya sözleşmeler adına geldiniz benim de kendi sözleşmemin yükümlülüklerinden caymam yakışık almaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091434
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091434,
					"content": "En azından Yetki Mührüyle geldiğinizde... *iç çeker* Rex Lapis bu mühürleri ilk işlediğinde Adeptus enerjisiyle birleştirdi. Zamanında insanlara savaşta yardım eden bir güçtü bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091435
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091435,
					"content": "Mührün gücünün çoğu uzun zaman önce tükendi... Artık bir anıdan başka bir şey değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091436
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091436,
					"content": "Bu anı güvenilirliğinizin kanıtı olarak kabul göremez. Beyan ettiğiniz iddiaları bağımsız bir şekilde kendim incelemeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091437
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091437,
					"content": "Ay Oymacısı'nın da bizi çağırma sebebi kuşkusuz bu olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091438
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091438,
					"content": "Adeptus ile görüşmen son buldu. Derhal git ve beni daha fazla rahatsız etme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091423,
					"content": "Oradaki insanları koruman gerekmiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091424
					]
				},
				{
					"id": 10091424,
					"content": "Dediğin gibi. Ancak Rex Lapis gerçekten öldürüldüyse Liyue büyük tehlikede demektir. Tehdidi ortadan kaldırmakta gecikmek, gelecek felaketlere davetiyeye çıkarmak olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "Bulutlar Hakimi"
				},
				{
					"id": 10091405,
					"content": "Tüm bu mekanizmaları sen mi tasarladın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091406
					]
				},
				{
					"id": 10091406,
					"content": "Doğru tahmin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "Bulutlar Hakimi"
				}
			]
		},
