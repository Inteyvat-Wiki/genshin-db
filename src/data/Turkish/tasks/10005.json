							1195.911,
							375.446,
							-801.068
						],
						"pointId": 13934
					}
				]
			},
			"dialogs": [
				{
					"id": 100051301,
					"content": "Seni bu kadar boş görmek garip Albedo.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051302
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051302,
					"content": "Ama Usta Rhinedottir'in son görevini tamamladığına göre sanırım bir molayı hak ettin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051303
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051303,
					"content": "Bak! Paimon sana ne demişti? Belayı çağırırsan gelir işte!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051304,
					"content": "Sebas? Ne işin var burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051305
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051305,
					"content": "Bir dakika. Bu kediyi tanıyor musun Albedo?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051306
					]
				},
				{
					"id": 100051306,
					"content": "Evet. O da ustamın yaratılarından biri. Sanırım bu onu... Bir bakıma benim bir aile üyem yapıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051307
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051307,
					"content": "Oldukça alışılmadık bir ailen var doğrusu.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051308
					]
				},
				{
					"id": 100051308,
					"content": "Hıh, benimle bu tonda konuşma. Bil ki o koca evi kahya olarak tek başıma ben çekip çeviriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051309
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051309,
					"content": "Ve evet, buna senin ve Ustanın kullandığı çeşitli şişe ve kavanozları toplamak, yıkamak ve kurulamak da dahil... Bütün bu işler tek bir kedi tarafından yapılıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051310
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051310,
					"content": "Dur bir dakika. Sen kahya mısın? O nasıl oluyor? Şişeleri ve diğer eşyaları nasıl tutuyorsun... Yani, başparmağın olmadan hani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051311,
					"content": "Sen havada nasıl süzülüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051312
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051312,
					"content": "Hı? Paimon bunu yapmasını hep biliyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051313,
					"content": "Ev işleri de benim için aynı. Bu gerçekler sorgulanamaz ve yanıt verilmeyecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051314
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051314,
					"content": "Hey! Paimon'la aynı cevabı veremezsin, seni...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051315,
						100051316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051315,
					"content": "Bu kedi Rhinedottir'in kedisi Paimon...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051317
					]
				},
				{
					"id": 100051317,
					"content": "Öf. Tamam ama Paimon'un onun zırvalıklarını dinlemesini bekleme...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051318,
					"content": "O zaman doğrudan konuya geleyim. Usta Rhinedottir'in isteği üzerine buradayım. Sana iletmemi istediği bir mesajı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051319
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051319,
					"content": "Öhöm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051320
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051320,
					"content": "\"Sevgili Albedo, sana verdiğim görev konusunda kabul edebileceğin bir cevap bulman gerçekten çok sevindirici.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051321
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051321,
					"content": "\"Ne yazık ki, bir sorun çözüldüğünde, onu kafanda evirip çevirmek tüm anlamını yitiriyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051322
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051322,
					"content": "\"Biz konuşurken sürekli çalışan zihnindeki o sarkacın 'sıkıntı'ya doğru sallandığına eminim.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051323
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051323,
					"content": "\"O zaman kendi sorularını sormanı önerebilir miyim?\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051324
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051324,
					"content": "\"En iyisi 'bildiğin cevapları' bir kenara bırak. Onun yerine bilmediğin soruları sor kendine.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051325
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051325,
					"content": "\"Sonuçta sorular her zaman cevaplardan daha ilginç olmuştur ve zamanı geçirmek için çok daha iyidir.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051326
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051326,
					"content": "\"Bir sonraki görüşmemizde bana ne sorular getireceğini merakla bekliyorum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051327
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051327,
					"content": "\"Benim bile hiç düşünmediğim sorularla gelirsen çok daha mutlu olurum.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051328
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051328,
					"content": "\"Pek olası değil tabii ama sen yine de elinden geleni yap. Kim bilir? Şansın yaver giderse beni şaşırtabilirsin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051329
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051329,
					"content": "\"Ha, sırf soru sormak veya düşünmek için bir 'benlik' oluşturmaya kalkışma. Ben denedim, işe yaramıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051330
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051330,
					"content": "\"Son olarak, sana Sebas ile bir hediye gönderdim. Ona iyi bak, tamam mı? Ha, onu beslemene gerek yok bu arada. Acıkmıyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051331
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051331,
					"content": "Sen nasıl istersen Usta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051332
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051332,
					"content": "*öksürür*... Ustamın söyleyecek çok şeyi varmış... Gerçekten çok yoruldum... *öksürür*...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051333
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051333,
					"content": "Pekala, mesajı ilettim, bu dondurucu ölüm tuzağında bir saniye daha durmayacağım. Zaten Mondstadt'a da ayrı bir mesaj iletmem gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051334
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051334,
					"content": "Mondstadt mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051335
					]
				},
				{
					"id": 100051335,
					"content": "Hım, Mondstadt'ta Rhinedottir ile bağlantısı olan başka kim olabilir ki... Haa!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051336
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051336,
					"content": "Nispeten yeni \"doğmuş\" olsa da Usta Rhinedottir onun \"görevinin\" ne olması gerektiğini çoktan öngörmüştü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051337
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051337,
					"content": "Her neyse, ben artık gideyim. Burada bir saniye daha kalırsam kuyruğum buz sarkıtına dönüşebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051338
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051338,
					"content": "Usta Rhinedottir'den gelen \"hediyen\" masada. Güle güle kullan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051339
					],
					"speakerTitle": "Sebas"
				},
				{
					"id": 100051339,
					"content": "Biliyor musun Albedo... Ailen her geçen gün daha da karmaşık bir hal alıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051340
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051340,
					"content": "Evet, şimdi bir de kedi girdi işin içine...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051341
					]
				},
				{
					"id": 100051341,
					"content": "Bu arada, o kedi gerçekten aile üyen sayılır mı? Kendisini kahya olarak tanıttı ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051342
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051342,
					"content": "Ustam, Sebas'ı benden çok önce yaratmış. Normal bir ailenin standartlarına göre bu onu benim \"büyüğüm\" yapıyor sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051343
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051343,
					"content": "\"Tabii benim ailemi 'normal' olarak nitelendirmek pek mümkün değil. Dolayısıyla bu tür bir ilişkinin pek bir anlamı yok.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051344
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051344,
					"content": "Öte yandan Sebas eskiden bana oldukça yardımcı olurdu, çeşitli şişeleri ve kavanozları düzenlememe yardım ederdi... Hatta bazen çizimlerim için modellik bile yapardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051345
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051345,
					"content": "Dur bir saniye, bugün çizdiğin kedi... Oydu, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051346
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051346,
					"content": "Evet. Ne zaman düşünmeye ihtiyacım olsa çizim yapmaya başlarım ve bilinçaltımın kontrolü ele almasına izin veririm. Düşüncelerimi düzenlememe yardımcı olur hep.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051347
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051347,
					"content": "Ve nedense genellikle Sebas'ın portresini çizmeyi seçiyorum... Bugüne dek o kadar çok çizdim ki artık alışkanlık haline geldi. Böylece zihnimin başka konuları düşünmek için serbest kalmasını sağlıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051348,
						100051349
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051348,
					"content": "Şimdi aklıma geldi de...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051350
					]
				},
				{
					"id": 100051350,
					"content": "Evet, öyle rastgele bir kedi olduğunu sanmıştık! Meğer düşündüğümüzden çok daha önemliymiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051351
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100051351,
					"content": "Artık onun gerçek adını biliyorsunuz. İsterseniz bir ara size onun hakkında daha fazla hikaye anlatabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051352
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051352,
					"content": "Ama şu an...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051353
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051353,
					"content": "\"Ağaç, en mükemmel meyvesiyle gurur duyarmış. Eksiksiz ve kusursuz.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051354
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051354,
					"content": "\"Fakat sen, ey hayallerin tohumu, bedeniyle sınırlı bir evrenin kralı olmakla yetinme.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100051355
					],
					"speakerTitle": "\"Rhinedottir\""
				},
				{
					"id": 100051355,
					"content": "... Düşünmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100051349,
					"content": "Daha önce kedi çizdiğini görmüştük...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051350
					]
				},
				{
					"id": 100051316,
					"content": "En iyisi sen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100051317
					]
				}
			]
		},
		{
			"id": 1000514,
			"completionStepIds": [
				1000502
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
