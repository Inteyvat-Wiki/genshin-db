			"dialogs": [
				{
					"id": 100050201,
					"content": "Selam Albedo! Seni burada bulacağımızı tahmin etmiştik. Aa! Resim mi yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100050202,
					"content": "Evet. Sonunda kendime biraz zaman ayırabildim, ben de fırçamı alıp biraz pratik yapmaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050203
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050203,
					"content": "Evet, çok şey yaşandı, değil mi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050204
					]
				},
				{
					"id": 100050204,
					"content": "Evet. Tabii senin yardımın ve diğer Şövalyeler sayesinde malum mesele pek sorun yaşamadan çözüldü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050205
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050205,
					"content": "Ayrıca, ustamın bana bıraktığı son görevi tamamlayabildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050206
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050206,
					"content": "Bundan daha iyi bir sonuç isteyemezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050207
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050207,
					"content": "Sucrose da çalışmalarında hızla ilerliyor. Artık birçok simya projesini kendi başına halledebiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050208
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050208,
					"content": "Favonius Şövalyelerinin şu an bana vereceği bir görev de yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050209
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050209,
					"content": "Ne sorumluluk var ne görev ne de çözülecek sorun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050210,
						100050211
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050210,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				},
				{
					"id": 100050212,
					"content": "Kötü değil. Sadece birbirinden çeşitli sorunlara çözüm bulmak için kafa yormak zorunda olmamak garip geliyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050213
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050213,
					"content": "Açıkçası bu boş hayata alışmakta biraz... Zorlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050214
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050214,
					"content": "Kendimi sürekli çözülmesi gereken başka sorunlar var mı diye düşünürken buluyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050215
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050215,
					"content": "Ama ne yazık ki benim için Mondstadt şu anda tamamen sorunsuz görünüyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050216
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050216,
					"content": "Biraz kendine zaman ayırmanın neresi yanlış? Kendini bu kadar yıpratmanın kimseye faydası yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100050217,
					"content": "Ama gerçekten bu kadar sıkıldıysan bizimle takılabilirsin! Paimon sana hiçbir şey yapmama sanatının tüm inceliklerini öğretir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100050218,
					"content": "Haha, sanırım işin uzmanından öğrenmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100050219,
						100050220
					],
					"speakerTitle": "Albedo"
				},
				{
					"id": 100050219,
					"content": "Olur da başını belaya sokmak istersen...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050221,
					"content": "#{NICKNAME}! Öyle söyleme! Başımıza iş açacaksın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 100050220,
					"content": "Bela bulmak benden sorulur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050221
					]
				},
				{
					"id": 100050211,
					"content": "Bunu kötü bir şeymiş gibi söylüyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100050212
					]
				}
			]
		},
