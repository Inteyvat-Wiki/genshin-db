			},
			"dialogs": [
				{
					"id": 80161001,
					"content": "Ve merak etme, sen hep Natlan'ın kahramanı olarak kalacaksın. Kardeşinin yaptıkları için seni suçlamayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80161002
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80161002,
					"content": "Ama olur da kardeşini bulursak... Onu şöyle sağlam bir dövüp aklını başına getirsem senin için sorun olmaz, değil mi?",
					"roleType": "TALK_ROLE_NPC",
