					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Mavuika"
				],
				"points": [
					{
						"sceneId": 1095,
						"position": [
							7.195,
							2.863,
							0.506
						],
						"pointId": 61
					},
					{
						"sceneId": 1095,
						"position": [
							22.663,
							1.691,
							3.103
						],
						"pointId": 72
					},
					{
						"sceneId": 1095,
						"position": [
							22.617,
							1.691,
							-1.591
						],
						"pointId": 74
					}
				]
			},
			"dialogs": [
				{
					"id": 80160301,
					"content": "Mavuika!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160302
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160302,
					"content": "#Hım? Tam zamanında geldin Iansan. Ben de tam seni çağırmak için birini yollayacaktım. {NICKNAME} ile birlikte gelmeniz çok iyi oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160303
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160303,
					"content": "Durumlar nasıl? Ulaklardan yeni bir haber geldi mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160304
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160304,
					"content": "Hiçlik Tarikatı aynı anda birden fazla kabilenin yakınında görülmüş. Bu saldırının önceden planlandığı kesin yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160305
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160305,
					"content": "Sayıları da beklenenden çok daha fazla üstelik. Örgütleri epey büyümüş gibi görünüyor. Normalde işlerini hep gizli saklı yürüttükleri için biz de bunu yeni öğreniyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160306
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160306,
					"content": "Bu savaşa tüm güçlerini seferber ediyorlar sanki... Ne yapmaya çalışıyorlar acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160307
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160307,
					"content": "Ben de bunu merak ediyorum. Natlan'da bugüne dek Hiçlik Tarikatının eylemlerine pek sık rastlanmadı. Aramızda belirli bir husumet de yaşanmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160308
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160308,
					"content": "Sence bunu... Yakın zaman önce Hiçliği yenmemizin intikamı olarak düşünüyor olabilirler mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160309
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160309,
					"content": "Pek olası gelmedi... Gerçi Paimon Hiçlik Tarikatından her şeyi bekler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160310
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160310,
					"content": "Kesin bir sonuca varmak için henüz erken. Şimdilik durumu gözlemlemeye devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160311
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160311,
					"content": "Savaşlar nasıl gidiyor? Fazla kayıp yoktur, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160312,
					"content": "Tüm güçleriyle saldırsalar bile işleri zor. Cesur savaşçılarımız bizzat Hiçliği daha yeni bozguna uğrattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160313
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160313,
					"content": "Aynen öyle. Savaşçılarımızın hepsi birbirinden tecrübeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160314
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160314,
					"content": "Hiçlik Tarikatı, gerçek Hiçlik kadar büyük bir tehdit teşkil etmiyor. Mesela güçlerini sonsuza dek yenileyemezler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160315
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160315,
					"content": "Ancak yine de bir savaştayız. Elimizden geleni ardımıza koymayıp, savaşı mümkün olduğunca az kayıpla atlatmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160316
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160316,
					"content": "#Kabileler şu anda savunmalarını güçlendiriyor. {NICKNAME}, Natlan bu sorunu kendi başına halledebilir. Müdahil olmak istemiyorsan benimle Stadyumda güvende olursun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160317
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160317,
					"content": "Hayır, bu benim için şahsi bir mesele...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160318
					]
				},
				{
					"id": 80160318,
					"content": "Öyle mi? Nasıl yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160319,
						80160320
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160319,
					"content": "Hiçlik Tarikatının şu anki lideri...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				},
				{
					"id": 80160321,
					"content": "Evet, doğru duydun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160322
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160322,
					"content": "Anladım... Vay canına. Gerçekten de... Epey şahsi bir meseleymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160323
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160323,
					"content": "Sormamda bir sakınca yoksa, kardeşinin amacının ne olabileceğine dair bir fikrin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160324
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160324,
					"content": "Ben de bunu öğrenmek istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160325
					]
				},
				{
					"id": 80160325,
					"content": "Şu anda aralarının pek iyi olduğu söylenemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160326
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160326,
					"content": "#Paimon bildi bileli {NICKNAME} kardeşini bulmak ve bazı sorularına cevap almak için uğraşıyor. Ama kardeşi ondan kaçıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160327
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160327,
					"content": "Anladım. Aranız açıldı demek... Heh, kardeşler arasında yaygın bir durum bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160328
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160328,
					"content": "Yaygın olduğu doğru... Ama konu bu ikisi olduğunda iş ciddiye biniyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160329
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160329,
					"content": "#Kesinlikle öyle... Yine de {NICKNAME} ve ikizi arasında çıkacak bir kavganın tüm dünyanın kaderini etkileyebilecek olması beni şaşırtmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160330
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160330,
					"content": "Emin olmak için soruyorum, hâlâ bizim tarafımızdasın ve kardeşinin neyin peşinde olduğunu bilmiyorsun, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160331,
						80160332
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160331,
					"content": "Kesinlikle.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160333,
					"content": "Haha, içim rahatladı doğrusu. Kardeşinden bahsettiğinde işin içinden çıkamayacağız diye korktum bir an.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160334
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160334,
					"content": "Aldığımız bilgilere göre Hiçlik Tarikatı güçlerinin büyük kısmını Gece Rüzgarının Ustalarına yönlendiriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160335
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160335,
					"content": "Burada benimle kalmayı düşünmüyorsanız oraya yardıma gidebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160336
					],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160336,
					"content": "Bana uyar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160337
					]
				},
				{
					"id": 80160337,
					"content": "Ben de seninle geleyim. Bereket Kolektifi ciddi bir tehlikeyle karşı karşıya değil, bu yüzden diğer kabilelere destek olsak iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160338
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160338,
					"content": "Çok sağ olun. Bir şeye ihtiyacınız olursa bana hemen haber verin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Mavuika"
				},
				{
					"id": 80160332,
					"content": "Hatta muhtemelen siz bile Hiçlik Tarikatından benim kadar nefret etmiyorsunuzdur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160333
					]
				},
				{
					"id": 80160320,
					"content": "#Benim {M#kız}{F#erkek} kardeşim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160321
					]
				}
			]
		},
