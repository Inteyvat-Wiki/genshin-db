					}
				]
			},
			"dialogs": [
				{
					"id": 80160101,
					"content": "Aa, \"Tum{RUBY#[S]Umut}aini\" ve Paimon... Bak sen şu işe. Sizi burada görmeyi beklemiyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160102
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160102,
					"content": "Aa, selam Koç Iansan! Tek başına ne yapıyorsun burada?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160103,
					"content": "Iı... Haberin olsun, Paimon idman yapmaya falan gelmedi... Beslenme veya kas yapma derslerine katılmayı da düşünmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160104,
					"content": "Hahaha... Tamam, peki. Yalnız sen de beni iyice şeytani bir koç belledin. Hiçbir öğrenciyi istemediği bir şeyi yapmaya zorlamam ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160105
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160105,
					"content": "Ama yine de... Biraz aerobik egzersiz yapmaktan zarar gelmez. Mesela benim yerime devriye gezebilirsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160106,
						80160107
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160106,
					"content": "Hımm, bu dediğin idmandan ziyade...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				},
				{
					"id": 80160108,
					"content": "Şaka bir yana, haklısın. Yardıma ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160109
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160109,
					"content": "Bereket Kolektifi yakında bir vücut geliştirme yarışması düzenleyecek. Son dakika hazırlıkları için idman yapmaya giden o kadar fazla katılımcı var ki devriye gezecek yeterli personelimiz kalmadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160110
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160110,
					"content": "Aa, onların yerine devriye geziyorsun yani. Ama... Senin de son dakika idmana ihtiyacın yok mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160111,
					"content": "Ben böyle iyiyim. Zaten bence en iyi kondisyona ulaşmanın sırrı uzun süre düzenli idman yapmaktan geçiyor. Son dakikada yapılan antrenmandan pek fayda gelmez yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160112
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160112,
					"content": "Daha doğrusu... Tahmin edebileceğiniz üzere en popüler ağırlık kategorilerinin çoğunda yarışamıyorum, e kendi kategorimde de düzgün rakip bulamıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160113
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160113,
					"content": "Hımm, doğru diyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160114,
					"content": "... Hiç Paimon'a bakma öyle! Paimon seninle aynı kategoride değil, asla seninle yarışmaya kalkmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160115,
					"content": "#{NICKNAME}, hadi devriyeye yardım edelim, olur mu? Yoksa bu gidişle Koç, Paimon'u zorla vücut geliştirme yarışmasına sokacak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160116,
					"content": "Hahaha... Süper. Tek bakışım yetti ikna etmeye.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160117,
						80160118
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160117,
					"content": "Peki, senin hatırın için yapacağım Paimon.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160119,
					"content": "Sağ olun. Çok zor olmaz zaten, bölgede olağan dışı bir olay yaşanmadığından emin olsanız yeter.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160120
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160120,
					"content": "Böylece ben de diğer bölgeye bakınabilirim. İşimiz bittiğinde kabilede buluşalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160121
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160121,
					"content": "Tamamdır! Hallederiz biz. Devriye gezmekte ve gözcülük yapmakta üstümüze yoktur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160118,
					"content": "Pekala Koç, sana yardım edeceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160119
					]
				},
				{
					"id": 80160107,
					"content": "Sana yardım etmek gibi duruyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160108
					]
				}
			]
		},
		{
			"id": 801602,
