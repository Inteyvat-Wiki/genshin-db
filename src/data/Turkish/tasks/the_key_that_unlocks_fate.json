			},
			"dialogs": [
				{
					"id": 80160701,
					"content": "Bu üs tamamdır. İyi iş çıkardık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160702
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160702,
					"content": "Hıh, Hiçlik Tarikatının tehditleri sadece lafta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160703
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160703,
					"content": "Açıkçası pek tatmin olmadım. En azından benden bizzat özür dilemelerini beklerdim. Bir de Gece Rüzgarının Ustalarının üstün kudretini gördüklerine dair uzun bir konuşma yapsalardı keşke...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160704
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160704,
					"content": "Neyse. Bunu da zafer ziyafetinde fazladan şarapla telafi ederim artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160705
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160705,
					"content": "Üslerini yok ettiğimize göre bu bölge bir süreliğine güvenli olacaktır. Ama yine de... İçimden bir ses tedbiri elden bırakmamak lazım diyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160706
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160706,
					"content": "Belki bana öyle gelmiştir ama normalde kuşatılan bir düşman, ne pahasına olursa olsun üssünü savunur. Savaş, sona erene kadar gitgide daha da şiddetlenir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160707
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160707,
					"content": "Ama bu sefer durum farklıydı. Üç beş tanesi hariç düşmanların hepsi bir anda pes edip kaçtı... Neden bilmiyorum ama sanki bir şey sezmiş gibiydiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160708
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160708,
					"content": "Hım? Tam olarak anlamadım... Taktiksel bir geri çekilmeydi alt tarafı. Farklı bir strateji.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160709
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160709,
					"content": "Ben ikna olmadım... Tüm ulusa savaş açan radikal bir gruptan bahsediyoruz. Öyle yarım yamalak iş yapmazlar. Bir anda savaşa son verip kaçmaları hiç onlara göre bir hareket değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160710
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160710,
					"content": "Bu olayın altında göründüğünden fazlası mı var diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160711
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160711,
					"content": "Şu anda hiçbir şeyden emin olamayız diyorum. O yüzden tetikte kalmalı ve savunmamızı hazır tutmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160712
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160712,
					"content": "(Hiçlik Tarikatının amacını hâlâ bilmiyoruz. Sıfıra sıfır, elde var sıfır...)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160713
					]
				},
				{
					"id": 80160713,
					"content": "#({M#Lumine}{F#Aether} ile görüşebilsem hepimizin sorularına cevap alabilirdim.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160714,
						80160715
					]
				},
				{
					"id": 80160714,
					"content": "Ben Bereket Kolektifine geri dönüyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160716
					]
				},
				{
					"id": 80160716,
					"content": "Paimon bunu diyeceğini tahmin etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160717
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160717,
					"content": "Haklısın gerçi. Anahtarı kullanarak kardeşini bulabilirsek ortalık iyice kızışmadan şu savaşa bir son verebiliriz. Belki sen de sonunda bazı sorularının cevaplarını bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160718
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160718,
					"content": "Bir dakika, gidiyor musun? Ben de seni ilk zafer ziyafetine davet etsem mi diye düşünüyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160719
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160719,
					"content": "Siz gidin. Citlali ve ben buradaki işleri hallederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160715,
					"content": "Şimdiye dek bulduğumuz tek ipucu şu anahtar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160716
					]
				}
			]
		},
