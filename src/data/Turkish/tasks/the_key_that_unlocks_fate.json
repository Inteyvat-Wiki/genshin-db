						],
						"pointId": 1
					}
				]
			},
			"dialogs": [
				{
					"id": 80160401,
					"content": "Of... Böylesi daha iyi. İşte şimdi oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160402
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160402,
					"content": "İyi iş çıkardın Itztli Nine. Burada olduğunu bilsem, kabilenin yardıma ihtiyacı olabileceğini düşünmezdim bile.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160403
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160403,
					"content": "Hıh! Asıl Hiçlik Tarikatının iki kere düşünmesi lazım. Yanlış kişiye bulaştılar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160404
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160404,
					"content": "Tecrübelerimden yola çıkarsak, saldırganların üsleri az önce geldikleri yönde olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160405
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160405,
					"content": "Fırsattan istifade üslerini yok etmeyi mi denesek? Neye uğradıklarını şaşırırlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160406
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160406,
					"content": "Az önce burada bir çatışma mı oldu? Yardıma ihtiyacınız var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160407
					],
					"speakerTitle": "Sutura"
				},
				{
					"id": 80160407,
					"content": "Aa, Gece Rüzgarının Ustalarından savaşçılar geldi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160408,
					"content": "Hiçlikle savaşımızdan daha yeni çıktık, bu yüzden birlikte çalışmaya hepimiz alışığız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160409
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160409,
					"content": "Madem herkes burada ve keyifler yerinde, hadi gidip şu üssü indirelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				}
			]
		},
		{
			"id": 801605,
			"completionStepIds": [
				801605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
