					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Citlali"
				],
				"points": [
					{
						"sceneId": 20265,
						"position": [
							-1758.462,
							181.021,
							9843.676
						],
						"pointId": 1
					}
				]
			},
			"dialogs": [
				{
					"id": 80160501,
					"content": "Bakın, Citlali orada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160502,
					"content": "Hım, sizi burada görmeyi beklemiyordum. Desteğe mi geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160503
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160503,
					"content": "Durumlar nasıl? Mavuika gelmemizi söyledi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160504
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160504,
					"content": "Hım... Citlali bile evden çıktığına göre durum ciddi olmalı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160505,
					"content": "Ciddi demezdim... Sinir bozucu demek daha doğru olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160506
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160506,
					"content": "Duyduğuma göre en fazla saldırıya uğrayan kabile bizimkiymiş. Ne ima ediyor bunlar? Bizi kolay lokma mı sandılar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160507
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160507,
					"content": "Neyse. Bunları düşündükçe tepem attı. Sonra da romanıma odaklanamadım, o yüzden... Hıh, buraya geldim işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160508
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160508,
					"content": "Demek Itztli Nine'yi böyle kızdırdılar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160509,
					"content": "Kendilerine \"Hiçlik Tarikatı\" diyorlar, değil mi? Adları bile sevimsiz. Böyle yüzeysel bir ismi olsa olsa beceriksiz yazarlar kullanır. Kalemleri kuvvetli olmadığından, sırf kötü adamların kim olduğu anlaşılsın diye uydurulmuş sığ isimlere benziyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160510
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160510,
					"content": "Hey, kardeşinin zevkine laf ediyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160511,
						80160512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160511,
					"content": "Böyle düşünen tek kişi olmadığımı bilmek güzel.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				},
				{
					"id": 80160513,
					"content": "Bir dakika, ne? Doğru mu duydum? Kardeşi Hiçlik Tarikatı mensubu mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160514
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160514,
					"content": "(Sinirlendiğim için öyle dedim ama... Fazla mı sert kaçtı acaba?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160515
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160515,
					"content": "Bunları sonra konuşuruz. Düşmanlar yaklaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160516
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160516,
					"content": "Süper! Öfkemi bir şekilde atmam lazımdı! Tam zamanında yetiştiler, burada ortam biraz gerilmeye başlamıştı. Neyse ki konuştukça daha ne kadar batacağımı görmemize gerek kalmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160517
					],
					"speakerTitle": "Citlali"
				},
				{
					"id": 80160517,
					"content": "Son kısmı biz duymasak da olurdu Citlali... Her neyse, hadi şunları ezip geçelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160512,
					"content": "Kardeşimin yerinde olsam o adı şimdiye çoktan değiştirmiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160513
					]
				}
			]
		},
		{
			"id": 801607,
