			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Dağ Yabanisi"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2695.591,
							282.595,
							9928.808
						],
						"pointId": 351500004
					}
				]
			},
			"dialogs": [
				{
					"id": 80160201,
					"content": "Baksana, bir Dağ Yabanisi var! Yoksa... Uyuyor mu? Saldırgan görünmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160202,
					"content": "Neden burada saklanıyor acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160203,
					"content": "Aa, uyandırdın...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160204,
					"content": "Hı? Kaçtı... Natlan'da düşündüğümüzden daha korkutucu bir ikili olarak anılıyoruz herhalde. Dağ Yabanileri bile bize bulaşmak istemiyor artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160205,
					"content": "Yerde bir şey var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160206
					]
				},
				{
					"id": 80160206,
					"content": "Şu parlak şeyi mi diyorsun? Kaçarken düşürdü herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160207,
					"content": "Hım... O Dağ Yabanisi kesin paha biçilmez bir hazine falan bulduğunu düşündü. Tam buralarda bir yere saklayacakken de... Bize rastladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160208,
					"content": "Paimon bir baksın! Dağ Yabanileri pek zeki sayılmaz, o yüzden çok değerli olmasa da belki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160209,
					"content": "!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160210
					]
				},
				{
					"id": 80160210,
					"content": "#Ne oldu {NICKNAME}? Birden yüzün düştü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160211,
					"content": "Bu sıradan bir anahtar değil mi? Görünüşü biraz farklı gerçi. Natlan'daki anahtarlara benzemiyor... Nereden gelmiş olabilir ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160212,
						80160213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160212,
					"content": "Bu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				},
				{
					"id": 80160214,
					"content": "Nasıl yani? Ne uyku odası? Ne uzay gemisi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160215,
					"content": "*nefesi kesilir* Bir saniye... Teyvat'a geldiğin gemiden mi bahsediyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160216,
					"content": "Ta kendisi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160217
					]
				},
				{
					"id": 80160217,
					"content": "İyi de... Bu anahtar nasıl geldi ki buraya? Düşürmediğinden emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160218,
						80160219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160218,
					"content": "Benimki hâlâ yanımda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160220,
					"content": "Vay canına... Evet, bire bir aynılar... O zaman biri seninse diğeri de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160221,
						80160222
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160221,
					"content": "Bu anahtarlardan sadece iki tane var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160223,
					"content": "Paimon tahmin etmişti... Vay be, uzay gemisi anahtarı demek. Böyle demek de hakikaten bir uzaylı olduğunu iyice göze sokuyor... Şey, daha doğrusu bir Gökten Gelen olduğunu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160224,
					"content": "... Her neyse. Anahtarın nereden geldiğini öğrendiğimize göre şu an asıl soru buraya nasıl geldiği. Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160225,
					"content": "Demek ki kardeşin anahtarı yakınlarda düşürmüş, sonra da deminki Dağ Yabanisi onu bulup saklamak için en yakındaki mağaraya girmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160226
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160226,
					"content": "Bu doğruysa... Kardeşin yakın zamanda buralardaymış demektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160227,
						80160228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160227,
					"content": "O halde...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160229,
					"content": "Evet... Bu gerçekten çılgınca. Iansan'ın devriyesine bir yardım edelim dedik, sonra da kardeşinle ilgili çok önemli bir ipucu buluverdik...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160230,
					"content": "Hazır bir iz yakalamışken bu yoldan devam mı edelim, yoksa hemen gidip Iansan'a haber mi verelim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160231
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160231,
					"content": "Hah, demek buradasınız. Devriye sizi epey uğraştırmış olmalı, yardımınız için teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160232
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160232,
					"content": "Aa, Iansan! Ne oldu? Paimon kabilede buluşacağımızı sanıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160233,
					"content": "Biz de tam sana gelecektik. Demin çok önemli bir şey bulduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160234,
					"content": "Artık devriye gezmenize gerek yok demeye geldim. Vücut geliştirme yarışması iptal edildi, her zamanki devriye ekibi görevi geri üstlenecek. Birazdan burada olurlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160235
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160235,
					"content": "İptal mi edildi? Niye ki, bir şey mi oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160236
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160236,
					"content": "Hiçlik Tarikatı saldırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160237
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160237,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160238
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160238,
					"content": "Tahminlerimizin bu kadar çabuk tutmasını beklemiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160239
					]
				},
				{
					"id": 80160239,
					"content": "#({M#Lumine}{F#Aether} yine harekete geçti anlaşılan.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160240
					]
				},
				{
					"id": 80160240,
					"content": "(Bu kez onunla yüz yüze konuşmanın bir yolunu bulacağım. Bulmak zorundayım.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160241
					]
				},
				{
					"id": 80160241,
					"content": "Hiçlik Tarikatının namını duymuştum ama böyle büyük bir operasyon yürüttüklerini ilk kez görüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160242
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160242,
					"content": "Sanki... Natlan'a savaş açmaya hazırlanıyor gibiler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160243
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160243,
					"content": "Ufacık bir tarikat koskoca savaş ulusuna saldırmayı nasıl düşünebilir? Böyle bir şeyi başarabileceklerini mi sanıyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160244,
					"content": "Bildiğimiz kadarıyla genelde işlerini el altından yürütmeyi tercih ediyorlar. Neden bu kez böyle bir şey yapıyorlar? Amaçları ne acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160245
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 80160245,
					"content": "Hiçbir fikrim yok. Tek bildiğimiz kabilemize saldırdıkları, oradan da pek bir sonuca varılmıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160246
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160246,
					"content": "Savunmalarımız şimdilik iyi durumda, o yüzden Kutsal Alev Stadyumuna gidip Mavuika ile bir konuşacağım. Sonuçta birileri olay hakkında bilgi edinebildiyse ona iletmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160247
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160247,
					"content": "#Benimle gelmek ister misin {NICKNAME}? Natlan'ın kahramanının arkamızda olduğunu bilmek herkesin moralini yükseltir hem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80160248,
						80160249
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160248,
					"content": "Ben de durumun ayrıntılarını öğrenmek istiyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160250,
					"content": "Harika, o halde birlikte gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Iansan"
				},
				{
					"id": 80160249,
					"content": "Ayrıca Hiçlik Tarikatı hakkında bilgi verebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160250
					]
				},
				{
					"id": 80160228,
					"content": "Hiçlik Tarikatı da muhtemelen buradaydı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160229
					]
				},
				{
					"id": 80160222,
					"content": "Biri bana ait, diğeriyse kardeşime.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160223
					]
				},
				{
					"id": 80160219,
					"content": "... Gözüm gibi bakıyorum ona.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160220
					]
				},
				{
					"id": 80160213,
					"content": "Uzay gemisindeki Uyku Odasının anahtarı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80160214
					]
				}
			]
		},
		{
			"id": 801603,
			"completionStepIds": [
				801603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
