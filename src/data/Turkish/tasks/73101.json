				},
				{
					"id": 731010102,
					"content": "İri Demir Parçasına eklediğimiz Ararakalarileri katman katman kaldırmamız lazım. En sonunda da kaldırdığımız Ararakalarileri kullanarak savaşabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731010103
					],
					"speakerTitle": "Aradashan"
				},
				{
					"id": 731010103,
					"content": "Aradashan, bu sefer İri Demir Parçasının gücünü bastırmanıza yardımcı olmayacak ama merak etmeyin. Arasata, Arayuta ve Arasaha yine de size yardımcı olacak. Denemek ister misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Aradashan"
				}
			]
		},
