						760090602
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090602,
					"content": "Evet ama az önce bulduğumuz taş yok oldu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090603,
					"content": "Sorun değil! Bu tarz parçaları Mai'ye rüşvet verebilmek için bulmaya çalışıyordum zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090604
