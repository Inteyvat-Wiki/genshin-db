				]
			},
			"dialogs": [
				{
					"id": 760090201,
					"content": "Hımm... Bu da değil gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090202
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090202,
					"content": "#Selam {M#Abi}{F#Abla}... Seni de yanındaki beyaz Feyi de daha önce hiç görmedim galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090203
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090203,
					"content": "Donuk Ay Yerleşkesi'ne hoş geldiniz! Size nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090204
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090204,
					"content": "#Yok, seni burada tek başına görünce merak ettik. Bu arada Paimon'un adı Paimon, bu da {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090205,
					"content": "#Yani {M#Bay}{F#Bayan} {NICKNAME} ve Bayan Paimon! Nasha Kasabası'ndan değilsiniz galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090206,
						760090208
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090206,
					"content": "Biz maceracıyız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090207
					]
				},
				{
					"id": 760090207,
					"content": "Evet! Süper maceracılarız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090211,
					"content": "En yakın arkadaşınla seyahat edip dünyayı birlikte deneyimlemek güzel olsa gerek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090212
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090212,
					"content": "Gerçekten öyle! Daha şimdiden bir sürü yere gittik! Peki ya sen? Burada ne yapıyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090213,
					"content": "Güzel taş arıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090214
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090214,
					"content": "Aa, Paimon anladı! Koleksiyon yapıyorsun demek ha? Yalnız değilsin, bazı yetişkinler de çok ilgilidir böyle şeylerle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090215,
					"content": "Hayır! Güzel taşları kullanarak Mai'ye beni kaçırması için rüşvet vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090216
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090216,
					"content": "Tamam, mantıklı... Dur biraz, ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090217,
						760090218
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090217,
					"content": "Böyle bir şey beklemiyordum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090220
					]
				},
				{
					"id": 760090220,
					"content": "Öyle mi? Efsanevi hırsız Reed Miller ile Fey prensesinin hikayesini duymadın mı hiç? Mai bana bunun başka yerlerde çok meşhur bir hikaye olduğunu söylemişti ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090221
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090221,
					"content": "\"Gel, gözleri ay gibi ışıldayan kadın. Bırak da bakışlarına benzeyen bu mücevherle kalbini çalayım ve seni bu altın varaklı kafesten kurtarayım...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090222
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090222,
					"content": "Bunun ne anlama geldiğinden emin değilim ama birine sevdiği bir şeyi verirsen onunla birlikte bir maceraya atılabilirsin, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090223,
						760090225
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090223,
					"content": "Alakası bile yok...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090224
					]
				},
				{
					"id": 760090224,
					"content": "Evet... Aslında anlamı... Neyse ya, çocuklara uygun bir hikaye değil bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090227,
					"content": "Bu arada şu bahsettiğin Mai kim? Çocuklara böyle tuhaf hikayeler anlatıyormuş... Pek güvenilir biri gibi değil sanki!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090228
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090228,
					"content": "Kötü biri değildir! Benimle aynı yaşta sayılır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090229
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090229,
					"content": "O da bir maceracı, tıpkı sizin gibi! Bir keresinde onu kampın yakınlarında gizlice gezinirken yakaladım, bu yüzden zorla bir hikaye anlatmasını istedim ondan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090230
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090230,
					"content": "Nedense bizim kaçırılan çocukları Ay Tanrıçası'na kurban eden korkunç tipler olduğumuzu düşünüyor gibiydi. Onu öldürmemem için bana yalvarırken sakinmiş gibi davranmaya çalıştı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090231
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090231,
					"content": "Ne tuhaf bir yanlış anlaşılma bu yahu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090232,
					"content": "Değil mi ama? Böyle bir şeyi nereden duyduğunu bile bilmiyorum. Çok tuhaf. Ama bana biraz eğlenceli geldi, bu yüzden düzeltmedim onu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090233
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090233,
					"content": "Onu tam olarak bu yüzden düzeltmelisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090234,
					"content": "Neyse, bunun karşılığında en yakın arkadaşım olacağına dair söz verdi ve bana dışarıdaki dünya hakkında bir sürü hikaye anlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090235
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090235,
					"content": "Annem ve babam dış dünyayla ilgili hikayeleri okumama izin vermezdi hiç, yalnızca inançsız insanların böyle saçma şeylerden hoşlanacağını söylerlerdi... Gel gör ki Mai'nin anlattığı hikayeler son derece ilginçti!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090236
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090236,
					"content": "Feye aşık olan balıkçı gibi, üç kez ölse de Yeraltı Diyarının Leydisi'nden üç kez kaçan kadın ve insan olmak isteyen peri çocuk gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090237
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090237,
					"content": "Kibar olanlar, pek kibar olmayanlar ve gerçekten kötü kalpli olan bazı kişiler vardı. Zengin ya da yoksul; iyi ya da kötü... Nihayetinde herkes sefalet içinde ölüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090238,
						760090240
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090238,
					"content": "Pekala, ebeveynlerin çok da haksız sayılmaz gibi. Bunlar biraz tuhaf hikayeler sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090239
					]
				},
				{
					"id": 760090239,
					"content": "Evet, çocuklara anlatacağın türden hikayeler değil...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090243,
					"content": "Ama ben artık çocuk değilim ki. Mai dışarıdaki dünyanın benim gibi biri için son derece tehlikeli olduğunu söyledi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090244
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090244,
					"content": "Bunu diyenin o olması da ilginç. Daha Ay Tanrıçası'nın lüt{RUBY#[S]Kuuvahki}funu bile kullanamıyor, benimle hemen hemen aynı yaşta üstelik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090245
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090245,
					"content": "Yine de sorun değil! Ben aşırı zeki biriyimdir zaten. Onu yakalamadan önce bir tane \"taş\"tan bahsedip duruyordu... Güzel taşlar bulmaya çalışıyor olmalı yani, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090246
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090246,
					"content": "<color=#00E1FFFF>Güzel taşlar</color> bulursam ona kolaylıkla rüşvet verebilirim! Tıpkı Reed Miller'ın Fey hanımı alıp götürdüğü gibi o da beni buradan uzaklara götürür, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090247
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090247,
					"content": "\"Rüşvet\" deyip durmasan mı? Arkadaşına güzel bir hediye veriyorsun işte, bu çok normal bir şey! Tuhaflaştırmaya gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090248
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090248,
					"content": "Biz zaten buraları arayacaktık. Güzel parçalar bulursak sana getiririz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090249
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090249,
					"content": "Vay be, gerçekten mi? Çok teşekkür ederim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090240,
					"content": "Vay be... Tüm hikayeyi bilmek istiyorum. Biraz daha anlatır mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090241
					]
				},
				{
					"id": 760090241,
					"content": "Peki. Mesela Reed Miller'ın yoldaşı \"Gölge Gelincik\", bir daha hiç ay ışığına çıkmamaya yemin etmiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090242
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090242,
					"content": "Ne? Şimdi böyle hikayelerin sırası değil! Neyse... Bunlar pek de çocuklara uygun hikayeler değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090225,
					"content": "Haklısın, Paimon'u bu yoldan gitmeye de böyle ikna ettim zaten...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090226
					]
				},
				{
					"id": 760090226,
					"content": "Hey, çocuklara tuhaf tuhaf şeyler öğretme! Sırf Paimon yaptığın yemekleri seviyor diye arkadaşlığımızın \"kaçırılma\"yla başladığını söyleyemezsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090218,
					"content": "Nod-Krai için son derece normal bir şey...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090219
					]
				},
				{
					"id": 760090219,
					"content": "Hayır, Nod-Krai için bile normal değil bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090208,
					"content": "Aslında... Nasha Kasabası'nda olup biten her şey benim başımın altından çıktı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760090209
					]
				},
				{
					"id": 760090209,
					"content": "#Vay be, cidden mi? Çok havalı! Hani şu destansı hikayelerdeki gibi müridiniz olabilir miyim o halde {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090210
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090210,
					"content": "Hey, saçmalamayı kes! Buradan geçen maceracılarız sadece, tamam mı? Nasha Kasabası'ndaki olaylara el altından müdahale ettiğimiz falan da yok... Paimon'un bildiği kadarıyla en azından.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090211
