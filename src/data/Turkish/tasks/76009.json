			"dialogs": [
				{
					"id": 760090501,
					"content": "Döndük! Kasha, bu güzel bir taş mı sence?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090502,
					"content": "Vay be, hızlı oldu! Siz gerçekten profesyonel maceracılarmışsınız. Harikasınız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090503
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090503,
					"content": "Hehe, bize her şey kolay! Yerin çok derinlerindeki bir labirenti keşfetmemizi ya da binlerce kilometre ötedeki yerlerin fotoğrafını çekmemizi istemediğin sürece sıkıntı yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090504,
					"content": "Mmmm... Hı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090505
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090505,
					"content": "Ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090506
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090506,
					"content": "Hımm... Bu çok güzel bir taş, evet ama şu büyük taşa çekiliyormuş gibi duruyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090507
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090507,
					"content": "Gerçekten mi? Paimon hiçbir şey hissetmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090508
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090508,
					"content": "Ben de pek emin değilim zaten. Belli belirsiz bir his sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090509
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090509,
					"content": "Sanki... Mai'nin bahsettiği gibi Reed Miller da Fey prensesiyle Ay Tanrıçası'nın rehberliği sayesinde tanışmış. Hislerim de buna benzer bir şeye işaret ediyor olabilir, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090510
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090510,
					"content": "Vay canına, sezgileri kuvvetli dedikleri şey bu mu gerçekten? Dur biraz... Paimon, Ay Tanrıçası'nın böyle bir şeyle uğraşacağını düşünmüyor pek... Muhtemelen böyle işler için fazlasıyla meşguldür!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090511,
					"content": "Sezgilerin sana ne yapmanı söylüyor peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760090512,
					"content": "Hımmm... Taşı buraya geri bırakmalıyız bence.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760090513
					],
					"speakerTitle": "Kasha"
				},
				{
					"id": 760090513,
