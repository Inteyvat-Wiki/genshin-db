						711271103
					],
					"speakerTitle": "Küçük Mao"
				},
				{
					"id": 711271103,
					"content": "Önemli olan son değil, sürecin kendisidir yani oraya nasıl ulaştığındır! Her trajedi bir dizi dövüş sahnesinden ibaret değil!",
					"roleType": "TALK_ROLE_NPC",
