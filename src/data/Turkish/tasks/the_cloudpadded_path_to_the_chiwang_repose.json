				]
			},
			"dialogs": [
				{
					"id": 711270401,
					"content": "#{NICKNAME}, Paimon. Gelmişsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270402
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270402,
					"content": "Ha? Lingyuan? Burada ne işin var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270403,
					"content": "İçeri giremediğim için buradayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270404
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270404,
					"content": "İçeri giremiyor musun? Nereye giremiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270405,
					"content": "Sazan Yuvası'na. Fujin'in dinlendiği yere.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270406
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270406,
					"content": "Sazan Yuvası... Ha! Hani şu Fujin'in bizi sürükleyip götürdüğü yer mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270407,
					"content": "Fujin'in Adeptus enerjisiyle mühürlenmiş bir ev burası. Onun Adeptus enerjisine sahip olmadığım için yanına gidemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270408
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270408,
					"content": "Ha? Ama Fujin dinlenmeye gittiği zaman hiç böyle bir şeyden bahsetmemiştin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270409
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270409,
					"content": "Aklımdan çıkmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270410,
						711270412
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270410,
					"content": "Yardım gerekiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270411
					]
				},
				{
					"id": 711270411,
					"content": "Sahip olduğunuz Adeptus enerjisi, Sazan Yuvası'nın kapısını açmaya yeter. Yani evet, yardımınıza ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270416,
					"content": "Hı? Bir dakika, yani başından beri burada bizi mi bekliyordun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270417,
					"content": "Sizi beklemiyordum. Sadece Sazan Yuvası'na girmek için bir yol arıyordum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270418
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270418,
					"content": "Bu durum şeye çok benziyor... Her neyse, biz de Fujin'in durumundan endişeliyiz, birlikte onu görmeye gidelim mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270419,
					"content": "Olur. İkinize de teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270420
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270420,
					"content": "Beni takip edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270412,
					"content": "Biraz geç kaldın Maviş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270413
					]
				},
				{
					"id": 711270413,
					"content": "Evet, böyle önemli bir şeyi nasıl unutabilirsin? Gerçekten inanılmaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270414
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270414,
					"content": "Çünkü ben kalın kafalı bir yaratığım. Onu gördüğümde bir sürü şey düşünüyorum ama bir sürü şeyi de unutuyorum. Bu benim hatam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270415
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270415,
					"content": "Sahip olduğunuz Adeptus enerjisi, Sazan Yuvası'nın kapısını açmaya yeter. Yani evet, yardımınıza ihtiyacım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270416
					],
					"speakerTitle": "Lingyuan"
				}
			]
		},
		{
