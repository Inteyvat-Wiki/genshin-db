				"points": []
			},
			"dialogs": [
				{
					"id": 711270901,
					"content": "Maviş, Maviş, geçen sefer anlattığın hikayenin sonunu getirmedin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270902
					],
					"speakerTitle": "Küçük Mao"
				},
				{
					"id": 711270902,
					"content": "Evet. Hatırlıyorum. Ancak fikrimi değiştirdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270903
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270903,
					"content": "Fikrini mi değiştirdin? Bu da ne demek oluyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270904
					],
					"speakerTitle": "Küçük Mao"
				},
				{
					"id": 711270904,
					"content": "Hikayenin sonunu... Sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270905
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270905,
					"content": "Ha? Hadi ama Maviş, bu düpedüz hilekarlık! Ben sana bir hikaye anlatırsam sen de bana bir hikaye anlatacağına dair söz vermiştin. Nasıl oluyor da iki hikayeyi de ben anlatmak durumunda kalıyorum?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270906
					],
					"speakerTitle": "Küçük Mao"
				},
				{
					"id": 711270906,
					"content": "Ben basit bir yaratığım sadece. İyi bir hikaye sonu gelmiyor aklıma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270907
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270907,
					"content": "Bulduğum son kötüydü ve dinleyen hiç kimseyi mutlu etmeyecekti. Bu yüzden hikayeye bir son yazma işi sana kaldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270908
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270908,
					"content": "Bu yine de hile olduğu gerçeğini değiştirmiyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270909
					],
					"speakerTitle": "Küçük Mao"
				},
				{
					"id": 711270909,
					"content": "Haklısın. Fakat telafi olarak seni Lingmeng Dağı'nın gizli kalmış manzaralarını görmeye götürebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270910
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270910,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270911
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270911,
					"content": "Lütfen yüzünü şöyle yapma. Beş dakikalığına sırtıma binmen için sana özel izin de veririm... Ya da on dakika olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270912
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270912,
					"content": "O halde... Anlaştık! Hikayen için bir son düşüneceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Küçük Mao"
				}
			]
		},
		{
			"id": 7112710,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7112710",
							"2"
						],
						"stepId": 7112710,
						"stateName": "QUEST_STATE_UNFINISHED"
