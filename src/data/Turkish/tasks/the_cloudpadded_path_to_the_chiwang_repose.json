			},
			"dialogs": [
				{
					"id": 711270501,
					"content": "#Hı? {NICKNAME}, Paimon, Lingyuan... Burada ne işiniz var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270502
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270502,
					"content": "Hey, bu Fujin'in sesi! Ses... Aşağıdan mı geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270503,
						711270505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270503,
					"content": "Senin için biraz endişeleniyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270504
					]
				},
				{
					"id": 711270504,
					"content": "Evet! Hepimiz senin sağlığın için endişeliyiz bu yüzden sana haber vermeden geldik. Fakat habersiz gelme olayını ilk sen başlattığın için Paimon artık ödeştiğimizi düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270509,
					"content": "Hı? Şey, üzgünüm! Dinlenmek için buraya döndüğümde sanırım girişin kilidini açmayı unuttum... Çok üzgünüm. Buraya kadar beni görmeye geldiniz ama ben işinizi iyice zorlaştırdım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270510
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270510,
					"content": "Pek zorlu olmadı aslında. Ama sen neden... Bir su birikintisinin içinde saklanıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270511,
					"content": "Hımm, nasıl desem... Çünkü henüz istediğim forma geri dönemiyorum ve siz beni hep Sazan formundayken gördünüz. Ben de ister istemez biraz... Utanıyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270512,
						711270513
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270512,
					"content": "Seni daha önce defalarca kez gördüğümüzün farkındasın, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270514,
					"content": "Ahaha... Ama önceden istediğim zaman insan suretine dönüşebiliyordum ve Sazan olarak hareket etmek yalnızca bana kolaylık sağladığından tercih ettiğim bir şeydi. Ama şimdi elimde bu kaygan suretten başka bir şey kalmadı, bu yüzden ben de biraz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270515
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270515,
					"content": "Bu konuda böyle takıntılı olman biraz tuhaf... Her neyse, sen iyiysen sorun yok, önemli olan bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270516,
					"content": "Ama Lingyuan senin Adeptus enerjinin tükendiğini ve dağlara, ormanlara, Chenyu Vadisi'nin nehirlerine dağıldığını söyledi. Bu kadar güç kaybetmenin nedeni buymuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270517
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270517,
					"content": "Yani Yaodie Vadisi'nde Altın Sazanı bulduğumuz gibi, dağılmış Adeptus enerjisini bir araya toplarsak iyileşeceksin, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270518,
					"content": "Evet... En azından teorik olarak doğru ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270519
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270519,
					"content": "Öyle mi? O halde benzer bir Sazan görürsek onu hemen buraya getirmeliyiz! Böylece daha hızlı iyileşebilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270520
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 711270520,
					"content": "B-Bu sizin için çok zahmetli olur! Bu arada gücüm tükenmiş falan değil. Burada bir süre dinlenirsem yeterli olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270521
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270521,
					"content": "Pek zahmet sayılmaz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270522
					]
				},
				{
					"id": 711270522,
					"content": "... Karşımıza çıkarsa diye gözümüzü dört açacağız sadece.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270523
					]
				},
				{
					"id": 711270523,
					"content": "Teşekkürler o halde. Fakat artık benim yüzümden daha fazla zahmete girmenizi istemiyorum. Zaten yeterince şey yaptınız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270524
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270524,
					"content": "Eğer yolculuğunuz sırasında daha fazla Adeptus enerjisi bulursanız enerjiyi doğrudan bu yeşime aktarın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270525
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270525,
					"content": "Su ve toprağın dengesi yeniden sağlanmış olsa da Yağmur Yeşimine daha fazla güç katabilirsek elverişli hava şartlarının oluşmasını ve gelecek senelerin bereketli geçmesini sağlayabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270526
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270526,
					"content": "... Peki ya sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270527
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270527,
					"content": "Cidden ama! Söyledim ya, tek ihtiyacım olan şey burada bir süre dinlenmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270528
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270528,
					"content": "#{NICKNAME}, Paimon, buraya beni ziyarete geldiğiniz için çok minnettarım ve mutluyum. Otacı Efendi gittiğinden beri buraya ilk gelenler sizsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270529
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270529,
					"content": "Ve sana da teşekkürler Lingyuan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270530
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270530,
					"content": "Teşekkürü hak edecek bir şey yapmadım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270531
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270531,
					"content": "#Öf, hep aynı şey! O halde {NICKNAME} ve Paimon'u buraya getirdiğin için teşekkür gibi düşün bunu. Sen de yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270532
					],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270532,
					"content": "#Ve son olarak... Yaptığınız her şey için bir kez daha teşekkürler {NICKNAME} ve Paimon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fujin"
				},
				{
					"id": 711270513,
					"content": "Yani aslında saklanmana hiç gerek yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270514
					]
				},
				{
					"id": 711270505,
					"content": "Lingyuan da senin için biraz endişelendi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711270506
					]
				},
				{
					"id": 711270506,
					"content": "Hayır. Ben sadece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270507
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270507,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270508
					],
					"speakerTitle": "Lingyuan"
				},
				{
					"id": 711270508,
					"content": "Evet! Lingyuan senin sağlığından o kadar endişelendi ki neredeyse dilini yuttu. Bu yüzden sana haber vermeden geldik. Fakat habersiz gelme olayını ilk sen başlattığın için Paimon artık ödeştiğimizi düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711270509
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
