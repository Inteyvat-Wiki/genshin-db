			"dialogs": [
				{
					"id": 747100101,
					"content": "Hehe... Geniş, özenle düzenlenmiş tanklarda oradan oraya yüzen uslu küçük balıklar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100102
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100102,
					"content": "Ne güzel bir manzara.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100103
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100103,
					"content": "İşte bu yüzden akvaryumumuz bu kadar popüler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747100104,
					"content": "Keşke açık denizde de böyle uslu dursalar... O zaman insanlar derinlere inip doğanın o eşsiz güzelliğine kendilerini doyasıya kaptırabilirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100105
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100105,
					"content": "Neyse, sayenizde bu balıkları neyin bu kadar huzursuz ettiğini nihayet çözdüm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100106
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100106,
					"content": "Yıllar boyunca çok fazla gemi enkazı birikmiş, bir de bazı haydutlar yasa dışı bir şekilde denize atık boşaltıyormuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100107
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100107,
					"content": "İnsan elinden çıkan bir ton çöp denizin tabanına dağ gibi yığılıp doğal yaşam alanlarını darmadağın etmiş. Balıkların günden güne saldırganlaşmasının sebebi buymuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100108
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100108,
					"content": "Bir grup dalgıç çoktan çöpleri temizlemek için bir görev üstlenmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100109
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100109,
					"content": "Ama görünüşe göre onlara kibarca bir ayar çekip ellerini çabuk tutmalarını söylemem gerekecek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100110,
						747100111
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100110,
					"content": "Sonuçları görmemiz biraz zaman alacak gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				},
				{
					"id": 747100112,
					"content": "Evet. Bu arada biz de işimize devam edip elimizden geldiğince çok hırçın küçük balığı buraya getirelim ki, biraz rahatlayıp kendilerine gelebilsinler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100113
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100113,
					"content": "Hastaları zararlı ortamlardan uzaklaştırmak, iyileşme yolunda önemli bir adımdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747100114
					],
					"speakerTitle": "Sigewinne"
				},
				{
					"id": 747100114,
					"content": "Anlaşıldı, o iş bizde! Yeni hastalar için gözümüzü dört açacağız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 747100111,
					"content": "Bu tarz işleri çabucak halledemeyiz sanırım...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747100112
					]
				}
			]
		}
	]
