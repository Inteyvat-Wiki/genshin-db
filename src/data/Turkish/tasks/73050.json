			"dialogs": [
				{
					"id": 730500301,
					"content": "Utsava Festivali... Ne kadar nostaljik... Ah, bak sen! Uçuşkan Beyazlı ve Altın Nara gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "Aranaga"
				},
				{
					"id": 730500302,
					"content": "Nara dostumuz ve Nara dostumuzun dostu. Umarım Utsava Festivalinde eğlenirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "Aranakin"
				},
				{
					"id": 730500303,
					"content": "Dostumuzun dostu bizim de dostumuzdur! Altın Nara da Uçuşkan Beyazlı da Aragaru'nun arkadaşı!",
					"roleType": "TALK_ROLE_NPC",
