			"trigger": {
				"objectNames": [
					"Arapandu"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500101,
					"content": "#Nara {NICKNAME}, Paimon! Yardımınız sayesinde Varuna Mekanizması artık iyi durumda. Ashavan Diyarı da öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500102
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500102,
					"content": "Tüm Aranaralar Utsava Festivali için yuvasına dönen kuşlar gibi Vanarana'ya döndü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500103
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730500103,
					"content": "Kızgın yağmur sakinleşti ve Aranakula sonunda bahçeyle ilgilenip neşeli Viparyaslar yetiştirme fırsatı buldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500104
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730500104,
					"content": "Mutlu Viparyaslar mutlu birer fener olur. Mutlu fenerler de neşe dolu Utsava Festivalini aydınlatır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500105
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500105,
					"content": "#Bahçe şu an çok iyi durumda Nara {NICKNAME} ve Paimon. Ayrıca Utsava Festivali harikaydı. Varuna Mekanizmasını iyileştirmemize ve Aranakula'yı geri getirmemize yardımcı olduğunuz için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500106
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500106,
					"content": "Önemli olan sonucunun iyi olması! Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730500107,
					"content": "Konusu açılmışken... Merak ettiğim bir şey var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500108
					]
				},
				{
					"id": 730500108,
					"content": "Nara Varuna'nın adı neden Nara Varuna?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500109
					]
				},
				{
					"id": 730500109,
					"content": "O Nara, Varuna Mekanizmasını iyileştirmemize yardım ettiği için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500110
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500110,
					"content": "Gerçek adı ne peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500111
					]
				},
				{
					"id": 730500111,
					"content": "Hımm. Bilmem ki. Nara Varuna bize gerçek adını hiç söylemedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500112,
						730500113
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500112,
					"content": "...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				},
				{
					"id": 730500114,
					"content": "#Nara {NICKNAME} çok yardımcı oldu. Nara {NICKNAME} cesur bir Nara ve pek çok zorluğun üstesinden geldi. Utsava Festivalinde bir araya gelebildiğimiz için çok mutluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500115
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730500115,
					"content": "#Nara {NICKNAME} için bir şey getirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500116
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730500116,
					"content": "Aranaralar böyle teşekkür eder.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500117
					],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500117,
					"content": "#Nara {NICKNAME} beğenecektir. Paimon da öyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500118
					],
					"speakerTitle": "Aranakula"
				},
				{
					"id": 730500118,
					"content": "İşte cesur Nara ve Paimon için bir çiçek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500119
					],
					"speakerTitle": "Arabalika"
				},
				{
					"id": 730500119,
					"content": "#Arakara'nın da bir çiçeği var. Bir Viparyas değil ama Nara {NICKNAME} ve Paimon için!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500120
					],
					"speakerTitle": "Arakara"
				},
				{
					"id": 730500120,
					"content": "#Vana uğruna yaptığınız her şey için teşekkürler Nara {NICKNAME} ve Paimon. Biz Aranaralar, arkadaşlarımızı asla unutmayacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arapandu"
				},
				{
					"id": 730500113,
					"content": "Anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				}
			]
		},
