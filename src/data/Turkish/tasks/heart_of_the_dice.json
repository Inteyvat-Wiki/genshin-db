			"dialogs": [
				{
					"id": 705340101,
					"content": "Aynı oyunun bu kadar fazla çeşidinin olmasının ne anlamı var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340102
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340102,
					"content": "Ah Gezgin! Bir dahaki sefere geleceğini önden haber ver, olmaz mı? Sen de Yakarışların Kralı Turnuvası için mi geldin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340103,
						705340104
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340103,
					"content": "Neler yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340105
					]
				},
				{
					"id": 705340105,
					"content": "Ha, bu Loncaya bağlı bir maceracının tasarladığı bir oyun. Dehanın Yakarışı Kart Oyunu ile savaşı birleştiren yenilikçi bir masaüstü oyunmuş. İsmi \"Zarların Kalbi\".",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340106
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340106,
					"content": "Yakarışların Kralı Turnuvasının organizasyonu ile uğraştığımız için Lonca, maceracının tasarımından yola çıkarak bir mini oyuna daha yer vermeye karar verdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340107,
						705340108
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340107,
					"content": "Kart oyunu ile savaşı nasıl birleştirebilirsin ki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340109,
					"content": "Hahaha, aslına bakarsan ben de pek anlamıyorum. Burada bir kural kitabı var ama... Baksana ne kadar kalın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340110
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340110,
					"content": "Eğer doğru anladıysam Zarların Kalbinin temel oyun mekaniği... Zarlarını stratejik bir şekilde kullanmakla ilgili olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705340111
					],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340111,
					"content": "Neyse, eğer ilgileniyorsan bir dene lütfen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fein"
				},
				{
					"id": 705340108,
					"content": "Bu pek beklenmedik bir birleşim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705340109
					]
				},
				{
					"id": 705340104,
					"content": "Ne oyunu?",
