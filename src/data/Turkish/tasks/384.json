						3840203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840203,
					"content": "Kader buluşması için çok güzel, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840204,
					"content": "Evet, bir savaşa hazırlıklı olmalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840205
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840205,
					"content": "Sonuç ne olursa olsun, işler sonunda iyiye gidiyor gibi görünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840206
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840206,
					"content": "Mondstadt son zamanlarda gerçekten çok şey yaşadı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840207
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840207,
					"content": "Hah! Aslında sorunumuzun çözümü bir gezgin ve bir şarkı kadar basitti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840208
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840208,
					"content": "Sanırım Favonius Şövalyelerinin de katkısı olmuş olabilir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840209
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840209,
					"content": "Ah, Usta Diluc anlıyoruz... Herkes çekilsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840210
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840210,
					"content": "Ben, ölümlü dünyanın en iyi gezgin ozanı, Kutsal Lir performansıma başlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				}
			]
