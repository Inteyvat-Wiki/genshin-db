					"nextDialogs": [
						3840403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840403,
					"content": "Yine de Venti ismini kullanmaya devam ettiğin için teşekkürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840404,
					"content": "Kutsal Lir nasıl?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840405
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840405,
					"content": "Hâlâ çalınabilir mi? Yoksa tamir edilmesi mi gerekiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840406
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840406,
					"content": "Vay be...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840407
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840407,
					"content": "Ne yazık ki, bence bu onarılamaz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840408,
						3840410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840408,
					"content": "Bu Hiçlik Büyücüsünün kaçmasına izin veremeyiz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840409
					]
				},
				{
					"id": 3840409,
					"content": "Haklısın. Kötülükle kaynağında savaşmazsak Dvalin'i kurtaramayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840413,
					"content": "Bu durumda Kaşif Amber'dan onu izlemesini isteyeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840414
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840414,
					"content": "Gerek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840415
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840415,
					"content": "Nedenmiş o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840416
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3840416,
					"content": "Kısa bir süre önce birini Dört Rüzgarın tapınaklarından birinde yok ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840417
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840417,
					"content": "Ne? Ne zaman?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840418
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840418,
					"content": "O canavarları arayıp bulmak istiyorsan, ben de bağlantılarıma sorayım. İşi halletmek için başka yöntemlerim de var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840419
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840419,
					"content": "Diluc...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840420,
					"content": "Favonius Şövalyelerinden hiç hoşlanmasa da Mondstadt'ı kendi yöntemleriyle korur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3840421,
					"content": "Aaa? Küçük Paimon'umuz neden birdenbire bu kadar sevecen oldu ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840422
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3840422,
					"content": "Peh.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840423
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840423,
					"content": "Benden haber bekle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840424
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840424,
					"content": "Hiçlik Tarikatına Mondstadt'ı utanmazca hiçe saymak ne demekmiş göstereceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840425
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840425,
					"content": "... Yaptıkları cezasız kalmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3840410,
					"content": "Dvalin çok büyük tehlikede...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840411
