			"dialogs": [
				{
					"id": 701430201,
					"content": "Merhaba Gezgin. Maceraların sorunsuz gidiyordur diye düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430202,
					"content": "Gayet sorunsuz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "Güzel. Aslında son zamanlardaki işlerini takip ediyorum. Böyle devam edersen bir gün çok iyi bir maceracı olacağın aşikar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430204,
					"content": "Diğer Lonca faaliyetlerine gelecek olursak, ilgini çekerse seninle paylaşmak istediğim macera istihbaratlarım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430205,
					"content": "Yeni bir özel görev mi? Anlat bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "Haha, konuşmana bakılırsa Loncanın iş halletme yöntemine oldukça alışkınsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430207,
					"content": "Ancak bu defa sana vereceğim bir özel görev yok. Yalnızca paylaşmak istediğim bir miktar macera istihbaratı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430208,
					"content": "Mondstadt'ın yakınındaki karlı dağ Ejdersırtı hakkında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430209,
					"content": "Lonca kamp kurup bir miktar maceracıyı oraya konuşlandırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430210,
					"content": "Konumu haritanda işaretledim. Vardığında lütfen Iris adındaki maceracıyı bulur musun? O sana bölgedeki durumu anlatacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 701430211,
					"content": "Benden bu kadar. İyi maceralar dilerim, yıldızlar ve hiçlik yoldaşınız olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				}
			]
		}
