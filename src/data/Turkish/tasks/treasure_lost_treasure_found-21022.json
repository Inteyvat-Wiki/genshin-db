			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210229601,
					"content": "İki taş tablet daha buldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229602
					]
				},
				{
					"id": 210229602,
					"content": "Öyle mi? Bir bakayım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229603
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229603,
					"content": "\"İşte orada, Guili Ovası'nda savaştılar. Siyah tozdan göz gözü görmüyordu, kayalar paramparça oluyordu...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229604
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229604,
					"content": "Vay be. Galiba bir zamanlar Guili Ovası'nda bir savaş olmuş. Hem de çok büyük bir savaş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229605
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229605,
					"content": "Guili Uygarlığının çöktüğü savaş bu sanırım. Şu diğer paragrafa gelince...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229606
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229606,
					"content": "Galiba bu, evinden ayrılmaya gönlü elvermeyen biri tarafından yazılmış. Öyle olunca yazar burada kalmış. Ayrıca...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229607
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229607,
					"content": "Hazine varmış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210220502
					]
				},
				{
					"id": 210220502,
					"content": "Belli ki hazineleri seviyorsun. Haklısın, bu paragrafta yazılanlar mecazi değilse Guili Ovası'nda gerçekten hazine varmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220503
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220503,
					"content": "Sonuçta \"Guizhong'un Dört Emri, bu hazineyi bulmak isteyen gelecek nesillere rehber olsun.\" deniliyor. Sonrasında da:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220504
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220504,
					"content": "\"Akıl ile öğret, erdemli ol, kemiklerini güçlendir, bir amaç etrafında toplan. Bu dört emrin kavuşması bundan böyle 'Guili Uygarlığı' olarak bilinsin.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220505
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220505,
					"content": "Bu nasıl anlaşılabilir ki? Nereden başlamak gerek bilemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220506
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220506,
					"content": "Hadi Wangshu Hanına dönelim. Bence Guizhong'un Dört Emrinin bilmecesini çözmeye çalışmadan önce biraz dinlenmemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		}
	]
}