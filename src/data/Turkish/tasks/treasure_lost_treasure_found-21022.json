			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Soraya"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210220301,
					"content": "Harabelerde bir şey buldun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229501
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210229501,
					"content": "Beş taş tablet buldum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229502
					]
				},
				{
					"id": 210229502,
					"content": "Harika! Bakalım... Off. Bunlar tamamen sırasız. Bakalım doğru sırayı bulabilecek miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220302
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220302,
					"content": "Hımm. Burada çok fazla eksik metin var. Yani bunlar birbirinden epey bağımsız. Ayrıca sırasından da hâlâ emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220303
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220303,
					"content": "Neyse. En iyi tahminim bu. Böyle sıralarsam şöyle oluyor:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220304
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220304,
					"content": "\"İnsanların toprağı işlemek için bir araya geldiği ilk zamanlarda toza hükmeden ve varlığıyla gökyüzünü boydan boya kapatabilen Guizhong adlı bir tanrı belirdi.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220305
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220305,
					"content": "\"Tanrı, halka dört emir verdi. Ardından Toprağa hükmeden ve Liyue halkını buraya getiren başka bir tanrı belirdi. Birlikte, halkın güvenli bir hayat sürmesi için çalıştılar.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220306
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220306,
					"content": "\"Böylece Guili Uygarlığı, adını bu iki tanrıdan almış oldu.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220307
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220307,
					"content": "Sanırım Guili Uygarlığının tarihiyle ve toza hükmederek burayı koruyan bir tanrıyla ilgili.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220308
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220308,
					"content": "Ama sonradan buraya gelen ve kendi halkının da bir kısmını getiren bir tanrıdan da bahsediliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220309
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220309,
					"content": "Ayrıca sanırım Guili Uygarlığındaki \"Guili\" ismi bu iki tanrının adından birer hece alınarak oluşturulmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220310
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220310,
					"content": "Ne kadar etkileyici. Okuduğum onca belgenin hiçbirinde iş birliği yapmak bir yana birlikte barış içinde yaşayan iki tanrı bile görmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220311
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220311,
					"content": "Galiba bunlar el ele veren iki tanrıdan daha fazlasıymış. Birbirlerinin en iyi arkadaşlarıymış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220312
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220312,
					"content": "Acaba onlara ne olmuş? Öylece yok olmuş olamazlar değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220313
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220313,
					"content": "Peki Guili Uygarlığı nasıl tamamen yerle bir olmuş? İki tanrının korumasındayken ister doğal olsun ister olmasın hiçbir felaket bu kadar yıkıcı olmamalıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220314
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220314,
					"content": "Yani ne olduysa tanrıların gücü bile buna dayanmaya yetmemiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220315
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220315,
					"content": "Daha fazla ipucu arayabilir misin gezgin? Yanılmıyorsam buralarda önceden gördüklerin gibi daha fazla taş tablet olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220316
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220316,
					"content": "Belki sonra olanlar o tabletlerde anlatılıyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220317
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220317,
					"content": "Bu taş tabletlerde yazılanlar bazı konularda bazı belgelerdekinden farklı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220318
					],
					"speakerTitle": "Soraya"
				},
				{
					"id": 210220318,
					"content": "*iç çeker* Çok fazla efsane, çok fazla hikaye var. Hangisi doğru acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Soraya"
				}
			]
		},
