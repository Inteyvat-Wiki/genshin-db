				]
			},
			"dialogs": [
				{
					"id": 760470201,
					"content": "Ooo, düzenli müşterilerimiz gelmiş! Yine yatırım yapmaya mı geldiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470202
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470202,
					"content": "Küçük bir kuş bana yatırım kuponlarının dolandırıcılık olduğunu söyledi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470203
					]
				},
				{
					"id": 760470203,
					"content": "Bak sen, öyle mi? Henüz eksiden çıkamadığın için hayal gücün sana oyunlar oynuyor olmasın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470204
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470204,
					"content": "Düşünsene bir. Sadece kazanan fakat asla gideri olmayan bir işletme olabilir mi? Bazıları kazanacak, bazıları kaybedecek. Mesela ben Sumeru Şehri'ndeyken... Öhöm. Bir süredir şanssızdım ben de ama şansın ne zaman döneceği belli olmuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470205
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470205,
					"content": "\"Umut\" yalnızca azimli olanlar tarafından elde edilebilir. Kazanç görmek istiyorsan yatırım yapmaya devam etmelisin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470206,
						760470208
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470206,
					"content": "Pekala. Bir ara yine uğrarım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470207
					]
				},
				{
					"id": 760470207,
					"content": "Bir dakika, şaka mı yapıyorsun? Öylece kabullenecek misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470209,
					"content": "#Bu işin sonu senin için iyi bitmez. Biz... Evet, biz meşhur {NICKNAME} ile Paimon'uz. Nasha Kasabası'nda bir sürü dostumuz var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470210
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470210,
					"content": "\"Dostumuz\" derken... Nasıl yani, bir dakika. Hani \"dost\" mu diyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470211
					],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470211,
					"content": "... Hı? Şey, evet! Tam da düşündüğün türden dostlarımız var! Hem de bir sürü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470212,
					"content": "Ne? N-Niye daha önce söylemediniz ki? Ben... Şey. Bakın. Özür dilerim, tamam mı? Sizi rahat bırakacağım. İşte... Alın bunu. Hepsini alın. Alın ve gidin, bir daha da kupon almaya gelmeyin. Gelseniz de satmam ya zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Dhabit"
				},
				{
					"id": 760470208,
					"content": "Gözümü boyamaya mı çalışıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470209
					]
				}
			]
		}
	]
