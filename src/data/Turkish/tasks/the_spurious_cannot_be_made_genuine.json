			"dialogs": [
				{
					"id": 760470101,
					"content": "Iı... Şey, siz ikinizi bir süredir izliyorum da...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470102
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470102,
					"content": "Ooo, bizi gözetliyor muydun yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760470103
					]
				},
				{
					"id": 760470103,
					"content": "Ha yok, ben... Genelde kitap almaya gelirim buraya ama sizin yatırım yapmaya çok hevesli olduğunuzu fark ettim. Ben... Kesinlikle önermem bunu yapmanızı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470104
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470104,
					"content": "Haklısın, henüz çok bir kazanç elde etmedik... Ama neden denemeyelim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470105
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 760470105,
					"content": "Çünkü \"cömert kazanç\" diye bir şey olmadığından şüpheleniyorum. Patronun ödemesi gereken bir sürü borcu var, öyle bir kaybı göze alacağını sanmam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470106
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470106,
					"content": "Arkadaşım da bir keresinde benzer şekilde dolandırılmıştı, o yüzden sizin de buna devam etmenizi önermem.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760470107
					],
					"speakerTitle": "Pechna"
				},
				{
					"id": 760470107,
					"content": "#Bir dakika, cidden dolandırıcılık olabilir mi bu? {NICKNAME}, o adamı bulup işin aslını öğrenmemiz lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7604702,
