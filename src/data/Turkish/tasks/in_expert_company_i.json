			"dialogs": [
				{
					"id": 740510301,
					"content": "Harika! Kamera gayet sağlam ve içindeki filme de bir şey olmamış...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510328
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510328,
					"content": "Hükümdarların aşkına. Çekimlere en baştan tekrar başlarız sanmıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510302,
						740510303
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510302,
					"content": "Neden buranın filmini çekiyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510303,
					"content": "Sen de Fontaineli değilsin sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510329
					]
				},
				{
					"id": 740510329,
					"content": "Uzun hikaye...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510304,
					"content": "Kısaca bahsedeyim. Biz üçümüz Liyue'deki Qiaoying Köyü'nden geliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510305
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510305,
					"content": "Oradaki insanların çoğu çay ticaretiyle uğraşır ama biz... Çayla pek ilgilenmiyoruz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510306
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510306,
					"content": "Bu yüzden biz de meslek değiştirdik ve köydeki çay satıcılarının tanıtımını yapmak için belgesel filmleri çekmeye başladık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510307
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510307,
					"content": "Açıkçası, çok fazla kişi çay ticareti yaptığından onlarla rekabet edemedik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510308
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510308,
					"content": "Mağazamızdaki yetenekli yardımcılarımız teker teker ayrıldı ve başka yerlerde çalışmaya başladılar. Yani, sadece çay işinde kalsaydık şu anda açlıktan ölüyor olabilirdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510309
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510309,
					"content": "Siz ikiniz.. Olayı bu kadar dramatik bir hale getirmeseniz olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510310
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510310,
					"content": "Köyde bu çay belgesellerini çekerek çok Mora kazandık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510311
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510311,
					"content": "Ama son zamanlarda köyde başkaları da kendi reklam filmlerini çekmeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510312
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510312,
					"content": "Hatta bazıları filmin içine opera bile koydu. Gerçekten büyük bir gösteri sergiliyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510313
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510313,
					"content": "İşte bu yüzden Fontaine'e geldik. Usta film yapımcılarından tavsiye arıyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510314
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510314,
					"content": "Yani buraya Fontaine'deki film yapımını öğrenmeye mi geldiniz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740510315
					]
				},
				{
					"id": 740510315,
					"content": "Evet. Geisert adında bir \"aydınlatma uzmanı\" bulduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510316
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510316,
					"content": "Film şeyinde kullanılan aydınlatmalarda gerçekten çok iyi... Neydi o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510317
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510317,
					"content": "\"Anlatı.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510318
					],
					"speakerTitle": "Yifeng"
				},
				{
					"id": 740510318,
					"content": "Evet! \"Anlatıları\" ışıklandırma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510319
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510319,
					"content": "Bay Geisert'in tavsiyeleriyle tüm Qiaoying Köyü'ndeki en iyi filmleri çekebiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510320
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510320,
					"content": "Patron, geçen ay en iyi filmleri Liyue'de çekeceğiz diyordun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510321
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510321,
					"content": "Ticaret yaparken beklentilerini gerçekçi bir şekilde ayarlaman gerekir... Gerçi sen anlamazsın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510322
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510322,
					"content": "Her neyse, yardımların için teşekkürler Maceracı. İşte, al bu Morayı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510323
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510323,
					"content": "Xingye, Yifeng toparlanın! Örnek çekimimizi tamamlayıp Bay Geisert'e göstermemiz lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510324
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510324,
					"content": "Işıklandırmaya dikkat! Kameranın şu şekilde ışık kaynağına doğru bakması gerekir. Yüksek çözünürlüklü ışığı yakalamamız lazım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510325
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510325,
					"content": "O kitabı hepiniz okudunuz, değil mi? Aydınlatmanın bir dokusu olmalıdır. Ne demek istediğimi anlıyor musunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510326
					],
					"speakerTitle": "Bayan Qiu"
				},
				{
					"id": 740510326,
					"content": "Patron, Bay Geisert'in kitabını okumuş olabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740510327
					],
					"speakerTitle": "Xingye"
				},
				{
					"id": 740510327,
					"content": "Ama elimizdekilerle ne kadar uğraşırsak uğraşalım o yüksek çözünürlüklü aydınlatma dokusunu yakalayamayabiliriz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yifeng"
				}
			]
		},
