			"trigger": {
				"objectNames": [
					"Paimon",
					"Arakunti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730170201,
					"content": "Sonunda bulduk seni! Arakunti, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170202,
					"content": "Kim bilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170203,
					"content": "Ha? Ne demek istiyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170204,
					"content": "Karşındaki bir ağaç, yağmur veya Vana rüyası olabilir. Belki de bir enstrümanın telleridir, kim bilir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170205,
					"content": "Şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170206,
					"content": "#Paimon tek kelimesini bile anlamadı! Sen anladın mı {NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170207,
						730170209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170207,
					"content": "Al benden de o kadar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170208
					]
				},
				{
					"id": 730170208,
					"content": "Paimon bu cümledeki tüm kelimelerin anlamını biliyor ama onları bir cümlede toplayınca hiçbir şey anlayamadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170213,
					"content": "Altın Nara ve uçan minik şey neden Arakunti'yi arıyordu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170214
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170214,
					"content": "Paimon uçan minik bir şey falan değil! Dur biraz, Paimon gerçekten de uçan bir... Ahh! Neyse, Paimon... Paimon'dur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170215
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170215,
					"content": "#\"Altın Naranın\" da bir ismi var ayrıca. O {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170216
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170216,
					"content": "Arapandu senin Düşler Korusu'nda olduğunu söyledi ve seni bir kontrol etmemizi istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170217,
					"content": "Arapandu'ya Arakunti'nin iyi olduğunu söyleyebilirsiniz. Düşler Korusu ve yağmurlu rüyalar da gayet iyi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170218,
					"content": "#Tamam... {NICKNAME}, hadi dönüp Arapandu'yla konuşalım o zaman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170219,
					"content": "Ne dönmesi ya! Buraya Varuna Mekanizmasını iyileştirmek için geldik! Paimon az daha kanıyordu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170220
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170220,
					"content": "Arapandu'ya gidip Arakunti'nin Paimon'u kandırmak istemediğini söyleyebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170221
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170221,
					"content": "Muhtemelen bu Arapandu'nun umurunda değildir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170222
					]
				},
				{
					"id": 730170222,
					"content": "Paimon'un da umurunda değil! Nedir bu Aranaradan çektiğimiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170223
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170223,
					"content": "Arapandu şöyle bir şey demişti...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170224
					]
				},
				{
					"id": 730170224,
					"content": "\"Arakunti, Naralara pek benzemez\". Acaba Arakunti başkalarıyla nasıl iletişim kuracağını mı bilmiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170225,
					"content": "İşin aslı Aranaralarla iletişim kurmasını bilmeyen biziz sanki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170226
					]
				},
				{
					"id": 730170226,
					"content": "Doğru ya... Bu bölgenin geleneklerine göre hareket edip onlarla iletişim kurmayı öğrenmeye çalışması gereken biziz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170227
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170227,
					"content": "Şimdi sen söyleyince aklıma geldi, Aranaralar nasıl iletişim kuruyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170228,
						730170230
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170228,
					"content": "Sence nasıl, uçan minik şey?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170229
					]
				},
				{
					"id": 730170229,
					"content": "Altın Nara bilmiyorsa uçan minik şey nasıl bilsin? Neden ulu Arakunti'ye sormuyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170233,
					"content": "Aranaraların tam olarak birbiriyle nasıl iletişim kurduğunu bize anlatabilir misin? Gerçekten öğrenmek istiyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170234
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170234,
					"content": "Niye öğrenmek istiyorsunuz? Nara dediğin Nara, Paimon dediğin Paimon ve Aranara dediğin Aranaradır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170235
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170235,
					"content": "Ah, Arakunti şimdi anladı. Paimon da bir tohuma dönüşüp toprağa gömülmek istiyor sanırım, öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170236
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170236,
					"content": "Hayır! Olur mu öyle şey?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170237
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170237,
					"content": "Yoksa Altın Nara mı tohum olmak istiyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170238,
						730170240
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170238,
					"content": "Yok, ben almayayım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170239
					]
				},
				{
					"id": 730170239,
					"content": "Ne kötü. Tohumlar iyidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170242,
					"content": "Buraya gelme nedenimizi unutmayalım. Utsava Festivali için buradayız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170243
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170243,
					"content": "Varuna Mekanizmasını iyileştirmemiz lazım ki Utsava Festivali başladığında hava normale dönsün ve o iğrenç sporlardan eser kalmasın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170244
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170244,
					"content": "Paimon haklı. Tüm bu çabalarımız Utsava Festivali ve Mavi Dünyanın merkezi için.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170245
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170245,
					"content": "Nemli Düşler Korusu'nun durumu iyi ama \"sporlar\" kötü. Koşabilen mantarlar da kötü. Ayrıca çok yağmur yağıyor ve bu yüzden mantarları pişirmek zorlaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170246
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170246,
					"content": "Hey, gördün mü? Net olabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170247
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170247,
					"content": "#Varuna Mekanizmasını iyileştireceğiz. Nara {NICKNAME} ve Paimon, Arakunti'yi takip etsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170240,
					"content": "Öyle bir şey mümkünse neden olmasın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170241
					]
				},
				{
					"id": 730170241,
					"content": "Saçmalama, ciddisin sanacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170242
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170230,
					"content": "Mesela daha fazla mecaz kullanarak başlayabiliriz!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170231
					]
				},
				{
					"id": 730170231,
					"content": "Paimon bir denesin o zaman! Altın Nara tıpkı bir... Bir... Şey... Teyvat Usulü Yumurta gibidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170232
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170232,
					"content": "... Aslında, doğrudan Arakunti'ye sorsak daha iyi sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170233
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170209,
					"content": "Tahmin yürütebilirim sanırım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170210
					]
				},
				{
					"id": 730170210,
					"content": "Çok iyi olur! Bu kelimeler ne anlama geliyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170211,
					"content": "Pek çok şeye dönüşebildiğini söylüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170212
					]
				},
				{
					"id": 730170212,
					"content": "#Cidden mi? Lütfen Paimon'la dalga geçme {NICKNAME}...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170213
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7301704,
			"completionStepIds": [
				7301704
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
