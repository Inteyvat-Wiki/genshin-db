				"points": []
			},
			"dialogs": [
				{
					"id": 730171201,
					"content": "Çözüyoruz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171202,
					"content": "Arakunti seni duydu. İniltiler nazik bir melodiye dönüştü fakat bu melodiyi büyük ses akışına dönüştürmek için ihtiyacımız olan şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171203
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171203,
					"content": "Senin yardımın Arakunti. Hehe, Paimon sana güveniyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171204,
					"content": "Arakunti bunun farkında.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171205
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171205,
					"content": "O zaman bir sorun yok, değil mi? Paimon en kısa zamanda Varuna Mekanizmasını iyileştirebileceğimizi umuyor. Yoksa sporlar bütün Apam Ormanı'nı kaplayacak. Düşüncesi bile Paimon'un... Hapşuu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171206,
					"content": "Aranaraların sporlardan etkilenmemesi Paimon'u şaşırtıyor... Nasıl hiç etkilenmiyorsunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171207
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171207,
					"content": "Aranaralar etkilenmez. Aranaralar sadece mantar pişirir. Ama \"Sporlar\" çok küçük ve çok fazlalar, hepsini yakalayamayız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171208
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171208,
					"content": "Varuna Mekanizmasının düzgün çalıştığı zamanlar Vana'da bu kadar fazla mantar yoktu. Yani Varuna Mekanizmasını iyileştirince her şey daha iyi olacak. Marana hariç.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171209
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171209,
					"content": "Her şey kesinlikle daha iyi olacak.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171210
					]
				},
				{
					"id": 730171210,
					"content": "Evet. Biz de yardım edeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171211,
					"content": "Marana konusunu halletmenin de bir yolunu bulacağız.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171212
					]
				},
				{
					"id": 730171212,
					"content": "#Nara {NICKNAME} Nara Varuna mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171213
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171213,
					"content": "Ha? Bu soru da nereden çıktı şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171214
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171214,
					"content": "Arapandu'nun dediğine göre Nara Varuna altın ve cesur bir Naraymış. Aranaralarla birlikte Varuna Mekanizmasını iyileştirmiş, kara yağmurla çamuru defetmiş ve güneşle ayı getirmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171215
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171215,
					"content": "#Nara {NICKNAME} da Varuna Mekanizmasının iyileşmesi için Aranaralara yardım etti. Ayrıca sen altın ve cesur bir Narasın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171216
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171216,
					"content": "Fakat Nara Varuna çok eskiden yaşamamış mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171217
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171217,
					"content": "#Yani Nara Varuna daha sonra Vana'ya dönmedi mi? Nara {NICKNAME}, tamamen farklı bir Nara mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171218
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171218,
					"content": "Farklı Naraların melodisi aynı olabiliyor mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171219,
						730171220
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171219,
					"content": "Belki oluyordur.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				},
				{
					"id": 730171221,
					"content": "Arakunti hiç Nara Varuna'yla tanışmadı ama Arapandu onun hakkında çok şey anlattı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171222
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171222,
					"content": "#Onun melodisiyle seninki aynı olsa gerek Nara {NICKNAME}. Dinleyene mutluluk veriyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171223
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171223,
					"content": "#Evet, yanında {NICKNAME} varken Paimon hep mutlu! Olur da bir gün {NICKNAME}, Paimon'u terk ederse, tıpkı Nara Varuna'nın ormanı terk ettiği gibi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171224
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171224,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171225
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171225,
					"content": "#Arapandu \"dinlenme noktasında\" bizi bekliyordur. Arakunti'yle birlikte dön Nara {NICKNAME}.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730171226,
						730171228
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171226,
					"content": "Hadi gidelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171227
					]
				},
				{
					"id": 730171227,
					"content": "Evet, hadi geri gidelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730171228,
					"content": "Maalesef ilgilenmem gereken başka bir mesele var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171229
					]
				},
				{
					"id": 730171229,
					"content": "Tamam o zaman, Arakunti tek başına dönebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730171220,
					"content": "Bilemedim şimdi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730171221
					]
				}
			]
		}
