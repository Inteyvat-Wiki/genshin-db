			"dialogs": [
				{
					"id": 730171001,
					"content": "Yağmurlu rüya, kurak rüya... Çın çın eder, tik tak eder, hışırdar... Vana'nın melodisidir bu...",
					"roleType": "TALK_ROLE_NPC",
