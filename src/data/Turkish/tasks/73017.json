			"dialogs": [
				{
					"id": 730170401,
					"content": "Büyük ağacın kökleri. Harika. Islak nefes sesini duymak, uyku getiren bir melodi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170402
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170402,
					"content": "Ha... Paimon hâlâ Arakunti'nin ne dediğini anlamıyor ama neyse!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170403,
					"content": "Konusu açılmışken... Paimon buranın bu kadar geniş olacağını düşünmemişti. Peki \"görünenden fazlası\" derken bunlardan mı bahsediyorlardı? Ayrıca sadece Paimon mu diğer yerlere kıyasla buradayken çok daha farklı hissediyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170404,
					"content": "Varuna Mekanizmasına enerji veren \"yaprakları\" burada mı arayacağız yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170405,
					"content": "Burada ama burada değil. Sesini duyabilir, nefesinin kokusunu alabilir, damarlarını görebilirsiniz ama... Paimon onu bulamaz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170406
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170406,
					"content": "Ha? Nasıl yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170407
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170407,
					"content": "Tamam, diyelim ki Paimon onu bulamaz. Peki ya ben?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170408
					]
				},
				{
					"id": 730170408,
					"content": "Altın Nara tıpkı geceleyin esen serin bir rüzgara, bir gölün yüzeyindeki rüyayı bin parçaya bölen şiddetli yağmur damlasına benzeyen melodiyi görebilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170409
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170409,
					"content": "Vay be. Etkileyiciymiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170410
					]
				},
				{
					"id": 730170410,
					"content": "#Tıpkı senden beklendiği gibi {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170411,
					"content": "Hehe.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170412
					]
				},
				{
					"id": 730170412,
					"content": "#Hehe... Bir dakika! {NICKNAME} Paimon'un sözünü çalmasana!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170413,
					"content": "#Nara {NICKNAME}, Paimon'a dönüşüyor... Maranada mantarlarla birlikte dans etmekten bile daha korkunç olurdu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170414
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170414,
					"content": "Hayal bile edemiyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170415
					]
				},
				{
					"id": 730170415,
					"content": "Öyle bir şey olmaz zaten! Olmasa daha iyi yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170416,
					"content": "Arakunti, sen de biraz daha açık konuşsan olmaz mı? Biz şimdi Varuna Mekanizması \"yapraklarını\" nerede bulacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170417,
					"content": "Rüyalarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170418
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170418,
					"content": "Bir saniye... O zaman neden en başta söylemedin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170419
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170419,
					"content": "Çünkü ilk başta \"nerede\" diye sormadın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170420
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170420,
					"content": "Bu Aranaraların iletişim kurma şekli bir anda Paimon'un kafasına dank etti galiba!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170421,
					"content": "Arakunti, aradığımız şu üç \"yaprağın\" nerede olduğunu söyleyebilir misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170422,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170423
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170423,
					"content": "Vay be, lafı dolandırmadan sorunca cevap veriyormuşsun... Peki o zaman, bu üç yer nerede?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170424,
					"content": "Burada, orada ve öteki tarafta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170425
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170425,
					"content": "Hayda... Hiç açıklayıcı olmadı ki bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170426,
					"content": "Veeee Paimon yenilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170427
					]
				},
				{
					"id": 730170427,
					"content": "Hey! Paimon yenildiyse sen de yenildin! Aynı şey! Arakunti'nin sözlerine güven olmuyor... Bu yerleri nasıl öğreneceğiz şimdi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170428
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170428,
					"content": "Varuna Mekanizmasını yapan Aranara olağanüstü birisiydi. \"Dallar\" ve \"yapraklar\" arasındaki bağlantı görünmez fakat aynı zamanda da görünürdür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170429
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170429,
					"content": "#Nara {NICKNAME} Aranaraları görebiliyor. Aranaraların ardında bıraktığı izleri görebiliyorsan yolunu da bulabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170430
					],
					"speakerTitle": "Arakunti"
				},
				{
					"id": 730170430,
					"content": "Pa-Paimon olayı çözdüğüne inanamıyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730170431
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730170431,
					"content": "Aranaraların izini takip ederek bulacağız yani, öyle mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730170432
					]
				},
				{
					"id": 730170432,
					"content": "Ah hadi ama, en azından bunu cevaplaması için Paimon'a bir fırsat ver! Olur mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
