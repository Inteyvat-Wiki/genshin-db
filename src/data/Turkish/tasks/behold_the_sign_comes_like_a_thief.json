					],
					"speakerTitle": "Araştır"
				},
				{
					"id": 732120802,
					"content": "Bu kilim... Çok garip...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120803
					]
				},
				{
					"id": 732120803,
					"content": "Ha? O kilim çok pahalı gibi duruyor. Neden buraya bırakılmış acaba?",
