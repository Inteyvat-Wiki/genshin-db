					"nextDialogs": [
						732120821
					]
				},
				{
					"id": 732120821,
					"content": "Sence de... Bu ipuçları çok düzenli değil mi? Sanki bizi bir yere yönlendirmek için bir hat üzerine dizilmiş gibiler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120822,
						732120823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120822,
					"content": "Biraz... Fazla şüpheci davranıyor olabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120824
					]
				},
				{
					"id": 732120824,
					"content": "Hey! Baksana, araba orada!",
