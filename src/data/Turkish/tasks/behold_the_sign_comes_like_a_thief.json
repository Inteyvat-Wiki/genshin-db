			},
			"dialogs": [
				{
					"id": 732121701,
					"content": "Merhaba, Saygıdeğer Cin Efendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121702
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121702,
					"content": "Canına kastedilmesi ile ilgili araştırmama devam ediyorum. İçin rahat olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121703
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121703,
					"content": "Tanit ile beraberken güvenliğini sağlayabilirim ama çöl kumlarında yürürken... Kendine çok dikkat et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121704,
						732121711,
						732121714,
						732121721
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121704,
					"content": "Sonsuz Vaha hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121705
					]
				},
				{
					"id": 732121705,
					"content": "Yaptıklarınız için Tanit ve Jeht adına size en derin teşekkürlerimi sunuyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121706
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121706,
					"content": "Sonsuz Vaha sadece Jeht için önemli değil, aynı zamanda inancımızın da temel dayanağını oluşturuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121707
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121707,
					"content": "Sonsuz Vaha'yı almak demek, bir zamanlar Tüm Vahaların Kraliçesi Nabu Malikata'ya ait olan egemenlik hakkını da almak demektir. Onun soyundan gelenler için bu miras her şeydir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121708
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121708,
					"content": "Pek anlamıyorum... Tam olarak nasıl bir değeri var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121709
					]
				},
				{
					"id": 732121709,
					"content": "Hahaha. Belki de para bile etmez...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121710
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121710,
					"content": "Ama her şeyin ötesinde değerlidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121711,
					"content": "Jeht bu sıralar meşgul mü?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121712
					]
				},
				{
					"id": 732121712,
					"content": "Evet. Artık Sonsuz Vaha elimizde olduğuna göre onun sınırlarını aşmaya yönelik tüm şüpheli hareketlere engel olmalıyız. Tanit artık Sonsuz Vaha'nın muhafızıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121713
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121713,
					"content": "Ve bence bu görev için en uygun kişi şüphesiz Jeht. O ailesini koruyor, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121714,
					"content": "Hainler hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121715
					]
				},
				{
					"id": 732121715,
					"content": "Sonsuz Vaha'ya giden bir yol açmamız bu hainleri rahatsız etmiş olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121716
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121716,
					"content": "Tanrıçamız, onların gözünde her şeyden daha üstün bir itibarın sembolü ve onlara hayallerinin ötesinde bir zenginlik sağlayabilir... Böyle bir saygısızlığa göz yumamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121717,
						732121719
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121717,
