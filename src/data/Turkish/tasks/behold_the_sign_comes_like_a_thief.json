			"dialogs": [
				{
					"id": 732120801,
					"content": "(Hâlâ iyi durumda olan katlanmış bir kilim. Üzerine dikilmiş bir Tanit kabilesi sembolü ile pek iyiye işaret etmeyen lekeler dikkati çekiyor...)",
					"roleType": "TALK_ROLE_NPC",
