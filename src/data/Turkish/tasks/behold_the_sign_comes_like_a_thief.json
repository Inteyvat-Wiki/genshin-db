			},
			"dialogs": [
				{
					"id": 732120601,
					"content": "(Boş ve kırık bir kutu, yol kenarına devrilmiş ve terk edilmiş halde duruyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120602
					],
					"speakerTitle": "Araştır"
				},
				{
					"id": 732120602,
					"content": "Hım. Bu kutu kervana ait olmalı. Baksana! Üzerinde kabilenin sembolü bile var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120603
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120603,
					"content": "Burası pusu kurmak için uygun bir yer.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120604
					]
				},
				{
					"id": 732120604,
					"content": "Evet... Burası tehlikeli bir yere benziyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120605
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120605,
					"content": "Görünüşe göre en büyük malları bile çalmışlar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120606
					]
				},
				{
					"id": 732120606,
					"content": "Değerli her şeyi alıp kutularını bırakmışlar. Hımm. Paimon onların kalabalık olduğunu fakat kutuları taşıyacak aletleri olmadığını tahmin ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120607
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120607,
					"content": "Ya da bu bir tuzak olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120608
					]
				},
				{
					"id": 732120608,
					"content": "Bir... Tuzak mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120609
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120609,
					"content": "Yani bu boş kutuları bilerek ve insanları çekmek için mi bıraktılar diyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120610,
					"content": "Bizi çekmek için.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120611
					]
				},
				{
					"id": 732120611,
					"content": "Of! Paimon'un tüyleri diken diken oldu! Öyleyse... İlerlesek daha iyi olur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120612,
						732120614
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120612,
					"content": "Korktuysan istediğin zaman geri dönebilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120613
					]
				},
				{
					"id": 732120613,
					"content": "Ne? Pof, Paimon korkmadı. Hıh. Hem sen Paimon'u öylece bırakamazsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120614,
					"content": "Haydutlar hâlâ yakınlarda olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120615
					]
				},
				{
					"id": 732120615,
					"content": "Bu söylediğin Paimon'un içini hiç rahatlatmadı ama... Korkmadığına göre ilerleyebiliriz sanırım...",
