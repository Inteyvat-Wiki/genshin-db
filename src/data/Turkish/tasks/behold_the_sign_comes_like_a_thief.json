			"dialogs": [
				{
					"id": 732120501,
					"content": "(Çatlamış boş bir kavanoz yerde ve henüz kumlara gömülmemiş bir halde yatıyor. Kısa bir süre önce atılmış gibi duruyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120502
					],
					"speakerTitle": "Araştır"
				},
				{
					"id": 732120502,
					"content": "Bak! Şu kavanoz henüz kumlara gömülmemiş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120503,
						732120505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120503,
					"content": "Mallar yol boyunca yere serilmiş...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120504
					]
				},
				{
					"id": 732120504,
					"content": "Bu iyiye işaret değil... Paimon, yolda başka mallar da düşmüş olabileceğini düşünüyor. İlerleyip aramaya devam etsek iyi olabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120505,
					"content": "Bakalım yolda neler bulabileceğiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120506
					]
				},
				{
					"id": 732120506,
					"content": "Tamam... Arkalarında başka eşyalar bırakmış olabilirler. Devam edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
