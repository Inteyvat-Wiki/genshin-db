				{
					"id": 732121005,
					"content": "Kervan pusuya düşürüldü. Mallar götürülmüş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121006
					]
				},
				{
					"id": 732121006,
					"content": "L-Lanet olsun! Yine o hainler yapmış olmalı! B-Bi-Biliyorum kesin onlar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121007
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732121007,
					"content": "Hainler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121008
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732121008,
					"content": "O h-ha-hainler! Kuzeyli iş birlikçi adiler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121009
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732121009,
					"content": "B-Bunun dışında başka n-ne buldunuz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121010
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732121010,
					"content": "Münzeviler bize baskın yaptı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121011
					]
				},
				{
					"id": 732121011,
					"content": "Evet. Tam kervanı araştırmayı bitirmiştik ki Münzeviler ortaya çıkıp bize saldırdı! Ve...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121012
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732121012,
					"content": "Bizi tanıdıklarını söylediler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121013
					]
				},
				{
					"id": 732121013,
					"content": "Evet... O da var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121014
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732121014,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121015
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732121015,
					"content": "E-E-Eğer öyleyse... S-Sizi de gözlerine kestirmişlerdir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121016
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732121016,
					"content": "Ö-Ödemeniz burada. L-Lütfen h-hemen gidip Lider B-Babel ile b-bu konuyu görüşün!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121017
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732121017,
					"content": "Peki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121018
					]
				},
				{
					"id": 732121018,
					"content": "H-Hoşça kalın, Saygıdeğer Cin Efendisi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yuften"
				}
			]
		},
		{
			"id": 7321211,
			"completionStepIds": [
				7321211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321211",
							"2"
						],
						"stepId": 7321211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Babel"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732121101,
					"content": "Merhaba, Saygıdeğer Cin Efendisi. Bir ihtiyacınız var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121102
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121102,
					"content": "Yuften'in kervanı size bağlı hainler tarafından baskına uğradı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121103
					]
				},
				{
					"id": 732121103,
					"content": "Demek öyle... Pek beklenmedik bir şey değil bu. Karlı bölgede yaşayan kuzeyliler uzun bir süredir bizim topraklarımıza girmeye çalışıyor. Saflarımız arasındaki hainler onların sözlerine kandı ve bize karşı cephe aldılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121104
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121104,
					"content": "Bu hainler epey bir süredir karışıklığa sebep oluyor. Son birkaç aydır haydut baskınları ve soygunlar ara ara meydana geliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121105
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121105,
					"content": "Ah... Kusura bakma, bölmek istemedim. Lütfen devam et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121106
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121106,
					"content": "Hainler bizimle de ilgileniyorlar.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121107
					]
				},
				{
					"id": 732121107,
					"content": "Evet. Kervanı incelemeyi bitirdiğimiz gibi Münzevi haydutlar bize baskın yaptı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121108
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732121108,
					"content": "Demek öyle... Ne kadar alçakça.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121109
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121109,
					"content": "Anlaşılan Aderfi ve Azariq'in gitmesiyle beraber, bu kudurmuş sürü meydanı boş buldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121110
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121110,
					"content": "Şöyle yapmaya ne dersiniz? Siz burada bekleyin ve dinlenin. Güvenliğinize dair tüm konularla ben ilgileneceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121111
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121111,
					"content": "Jeht hâlâ dışarıda, kabileye karşı görevlerini yerine getiriyor. Bu konuyu araştırmak için onun sizinle çalışmasını sağlayacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121112
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121112,
					"content": "Ondan önce sizi öldürmek isteyen suikastçıyı bulmak için elimden geleni yapacağım... Karşılığında sizden tek isteğim sabırlı olmanız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121113
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121113,
					"content": "Ah... Bir şey daha var! Bize baskın yapan kötü adamlar bizi tanıyor gibiydi. Kabileden olabilirler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732121114,
					"content": "Olabilir... Fakat pek önemi yok. Saygıdeğer misafirlerimiz olarak ayrıcalıklısınız ve korunacaksınız. Burada kaldığınız sürece size kimse zarar veremez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121115
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121115,
					"content": "Tanit mensubu biri size sorun çıkarırsa her kim olursa olsun, Lider otoriteme dayanarak hakkını kendi ellerimle veririm.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121116
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121116,
					"content": "Lütfen dinlenin. Bu hainler meselesini var gücümle takip edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121117
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121117,
					"content": "Ayrıca sizin için Jeht'e de göz kulak olacağım. Döndüğü an size haber vereceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121118
					],
					"speakerTitle": "Babel"
				},
				{
					"id": 732121118,
					"content": "Tamam! Çok teşekkürler Lider Babel.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732121119,
					"content": "Kibarlığa lüzum yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Babel"
				}
			]
		},
