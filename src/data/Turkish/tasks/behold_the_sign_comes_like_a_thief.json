					"nextDialogs": [
						732120916
					]
				},
				{
					"id": 732120916,
					"content": "Hı? Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120917
					],
					"speakerTitle": "Paimon"
				},
