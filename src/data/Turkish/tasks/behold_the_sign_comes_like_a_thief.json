					"nextDialogs": [
						732120832
					],
					"speakerTitle": "Münzevi Suikastçı"
				},
				{
					"id": 732120832,
					"content": "Ha, Jeht'in dostları bizim de dostumuzdur! Bizim de işimiz yeni bitmişti. Beraber geri dönebiliriz!",
