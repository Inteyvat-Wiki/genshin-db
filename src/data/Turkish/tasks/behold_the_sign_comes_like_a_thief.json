					"nextDialogs": [
						732120833
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120833,
					"content": "Haha, acele etmeyin. Misafirsizin sonuçta, dönmek için bu kadar acele etmenize gerek yok.",
