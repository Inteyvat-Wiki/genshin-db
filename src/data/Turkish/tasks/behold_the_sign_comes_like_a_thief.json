						732120836
					],
					"speakerTitle": "Münzevi Suikastçı"
				},
				{
					"id": 732120836,
					"content": "Onun iyi niyetini karşılıksız bırakmak ayıp olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120837
					],
					"speakerTitle": "Münzevi Suikastçı"
				},
