			"dialogs": [
				{
					"id": 732120401,
					"content": "#{NICKNAME}! Nasılsın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120402
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732120402,
					"content": "Benimle maceraya çıktığın için teşekkürler. Ben... Ailem adına... Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120403
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732120403,
					"content": "Önemli değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120404
					]
				},
				{
					"id": 732120404,
					"content": "Tamam. Babel beni diğer görevlere göndermeseydi sizinle beraber ben de çölü araştıracaktım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120405
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732120405,
					"content": "Birçok harika yer biliyorum! Vaktim olduğunda onları size göstereceğim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120406
					],
					"speakerTitle": "Jeht"
				},
				{
					"id": 732120406,
					"content": "Fakat şu an... Doğru zaman değil. Lanet olası hainler kuzeylilerle iş birliği yapıp bölgemize göz diktiler. Onların hareketlerini takip etmeliyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Jeht"
				}
			]
		},
