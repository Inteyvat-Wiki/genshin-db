			},
			"dialogs": [
				{
					"id": 732120101,
					"content": "Ah, Cin Efendisi! G-Geldiniz demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120102
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732120102,
					"content": "T-Tam da sizden rica edeceğim bir ş-şey olacaktı... Acil bir şey!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120103,
						732120105
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732120103,
					"content": "Sakin ol, dinliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120104
					]
				},
				{
					"id": 732120104,
					"content": "Evet, sakin ol! Neler olduğunu anlatırsan yardım edebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120107,
					"content": "Bir s-sevkiyat, b-bir sevkiyat, b-bir sevkiyat dolusu mal y-yok oldu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120108
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732120108,
					"content": "Üç sevkiyatı da kaybettin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120109,
					"content": "H-Hayır! S-Sadece birini.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120110
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732120110,
					"content": "Bize biraz Anahit Bereketi g-göndermeleri için birileri ile anlaşmıştım a-ama e-epey zaman geçmesine r-rağmen hâlâ gelmedi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120111
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732120111,
					"content": "O k-kuzeylilerin i-işi olabilir... Babel h-hainleri a-aramasına misilleme olarak...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120112
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732120112,
					"content": "Aderfi ve Azariq gittiğinden b-beri... Kuzeyliler d-daha h-hareketliler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120113
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732120113,
					"content": "Pekala, d-daha oyalanmayayım. Gözcülerimizin dediğine göre Anahit Bereketini getiren kervanın bilinen son konumu b-bu bölgede.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120114
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732120114,
					"content": "Umarım malları b-bulmama yardımcı olabilirsiniz ya da e-en azından kervana ne olduğuna dair herhangi bir ipucu bulabiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120115
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732120115,
					"content": "Tabii ki, yardımcı olurum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120116
					]
				},
				{
					"id": 732120116,
					"content": "Kervanın kendi kendine kaybolacak hali yok ya. Haydutlar tarafından soyulmuş gibi duruyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120117,
					"content": "T-Teşekkür ederim. Ç-Çok teşekkür ederim. Lütfen bu eti yaptıklarının bir karşılığı olarak kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120118
					],
					"speakerTitle": "Yuften"
				},
				{
					"id": 732120118,
					"content": "Vay canına! Teşekkürler! Çok kibarsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732120105,
					"content": "Nasıl yardımcı olabilirim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732120106
					]
				},
				{
					"id": 732120106,
					"content": "Sakin ol! Aceleye gerek yok!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732120107
					],
					"speakerTitle": "Paimon"
				}
			]
		},
