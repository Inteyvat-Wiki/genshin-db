				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732121601,
					"content": "Hım... Taş üstünde taş kalmamış. Of, Paimon sinirlenmeye başladı. Dağ yabanileri ortalığı dağıtmayı gerçekten iyi biliyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121602,
						732121604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732121602,
					"content": "Bir dakika, sanki dağ yabanileri tarafından yok edilmemiş gibi...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121603
					]
				},
				{
					"id": 732121603,
					"content": "Ha? Ama... Dağ yabanilerinin burada kampı var, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121606,
						732121608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732121606,
					"content": "Etrafta hiç araba görmüyorum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121607
					]
				},
				{
					"id": 732121607,
					"content": "Evet... Haklısın! Burada hiç araba veya yıkıntı yok... Dağ yabanilerinin arkalarında bıraktığı kulübelerde de hiç araba parçası yok gibiydi... Çok garip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732121610,
					"content": "Yolu biraz daha takip edelim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121611
					]
				},
				{
					"id": 732121611,
					"content": "Pekala, Dağ yabanileri yapmadıysa kim yaptı peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732121608,
					"content": "Bak, kampta da araba yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121609
					]
				},
				{
					"id": 732121609,
					"content": "Evet! Kervana dağ yabanileri saldırsaydı arabaları hemen orada parçalarlardı. Fakat hiç araba veya araba parçası görmedik... Paimon'a göre bu biraz garip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121610
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732121604,
					"content": "Bekle, baskın burada olmamış olabilir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732121605
					]
				},
				{
					"id": 732121605,
					"content": "Ama dağ yabanileri kamplarını yolun ortasına kurmuşlar... Bak, işte orada. Orayı kapatırlarsa soygun yapmaları kolay olmaz mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732121606,
						732121608
					],
					"speakerTitle": "Paimon"
				}
			]
		},
