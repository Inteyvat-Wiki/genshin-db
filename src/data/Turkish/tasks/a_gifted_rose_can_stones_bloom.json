					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060301,
					"content": "Sulamaya ve gübrelemeye devam edeceğim o zaman... Bir işe yarayacak mı sizce?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060302
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060302,
					"content": "Ben artık emin değilim de. *iç çeker*",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060303
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060303,
					"content": "Bu kadar aylaklıktan sonra nihayet bir şey yapmaya karar verdim ama yine de yapamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060304
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060304,
					"content": "Dileğini gerçekleştiremedim yaşlı hortlak. Çok özür dilerim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060305
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060305,
					"content": "Affan Dede...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060306,
					"content": "Yardımlarınız için teşekkürler çocuklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				}
			]
		},
