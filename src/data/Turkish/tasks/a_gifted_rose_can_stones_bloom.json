			},
			"dialogs": [
				{
					"id": 732050501,
					"content": "♪Ey güzeller güzeli gül, yerine getir dileklerimi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050502
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050502,
					"content": "Hımm, siz hâlâ burada mısınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050503,
						732050513
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050503,
					"content": "Niye burada yaşıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050504
					]
				},
				{
					"id": 732050504,
					"content": "Eh, ne de olsa ben garip bir ihtiyarım. \"Garip ihtiyarların anlaşılmaz hareketleri vardır\" diyelim... Bana sizin gibi sorular soran çok az kişi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050505
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050505,
					"content": "Hep karşılaştığım fırsatları değerlendirip yepyeni bir hayat kurmak istemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050506
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050506,
					"content": "Daha yeni evlendiğim sırada az kalsın kaçıp Münzevilere katılacaktım ama sonra vazgeçtim. Başıboş bir hayat sürmek için karımı öylece terk edemezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050507
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050507,
					"content": "Ardından gezgin bir tüccarla tanıştım ve onun gibi ticaret yapmak istedim. Ne var ki o da olmadı çünkü yeteri kadar Moram yoktu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050508
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050508,
					"content": "Epey zaman sonra, karım vefat edince beni burada tutan hiçbir şey kalmamıştı. Tabii bu sefer de artık gitmek için çok yaşlıydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050509
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050509,
					"content": "Bu zamana kadar her şeyi erteledim de erteledim. Bu yüzden elimden kaçırdığım fırsatların haddi hesabı yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050510
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050510,
					"content": "Geriye dönüp bir bakınca, ne bu köye ne de başka bir yere ait olduğumu anladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050511
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050511,
					"content": "En sonunda köyün en ucuna taşındım ve hayatın burada daha rahat olduğunu fark ettim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050512
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050512,
					"content": "Bu şekilde yıllar geçiverdi işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050525,
					"content": "Çiçek açtıklarında onları gelip görmenizi isterim. Muhtemelen yarın veya ertesi gün açarlar. Gelebilecek misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050526
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050526,
					"content": "Elbette.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050527
					]
				},
				{
					"id": 732050527,
					"content": "Tamam, tamam...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050528
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050528,
					"content": "♪Ey güzeller güzeli gül, yerine getir dileklerimi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050513,
					"content": "Yaşlı hortlak hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050514
					]
				},
				{
					"id": 732050514,
					"content": "Sadece yabancılar yaşlı hortlağın kim olduğunu sorar. Köyde onun adını duymamış bir çocuk yoktur çünkü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050515
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050515,
					"content": "Bir çocuk yaramazlık yaptığında annesiyle babası ona şöyle der: \"Yaşlı hortlak seni alıp götürürse görürsün.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050516
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050516,
					"content": "O ufaklıklar da yaşlı hortlağı bildiklerinden değil tabii. İnsanları korkutmak için adını kullanmasını iyi biliyorlar sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050517
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050517,
					"content": "Ben çocukken yaşlı hortlakla bizzat tanışmıştım. Çocukları hiç sevmezdi, orası doğru ama korkunç biri değildi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050518
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050518,
					"content": "Adı bir şekilde yaşlı hortlağa çıktı. Arkasından sadece birkaç kişi dedikodu yapıyor sanıyordum ben.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050519
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050519,
					"content": "Arkadaş değil miydiniz yani?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732050520
					]
				},
				{
					"id": 732050520,
					"content": "Çocukken gizlice bahçesine girip oyun oynardım. Beni görür görmez çapasıyla kovalamaya başlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050521
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050521,
					"content": "Başına bela olan yaramaz bir çocuktum işte. Niye hatırlasın ki beni?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050522
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050522,
					"content": "O kim olduğumu bilmiyor olabilir ama ben onu ve küçük bahçesini hâlâ hatırlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050523
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050523,
					"content": "O halde ona arkadaşım diyebilirim, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050524
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732050524,
					"content": "Anılarımdaki o küçük bahçeyi yeniden yaratmak için aynı çiçeklerden ben de yetiştirmek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732050525
					],
					"speakerTitle": "Affan"
				}
			]
		},
		{
			"id": 7320601,
