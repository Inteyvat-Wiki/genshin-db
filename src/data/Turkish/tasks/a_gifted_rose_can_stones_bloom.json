					"Affan"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732060101,
					"content": "Ah, demek sendin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060102
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060102,
					"content": "Tohumlar ne durumda?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060103
					]
				},
				{
					"id": 732060103,
					"content": "Daha bir tanesi bile filizlenmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060104
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060104,
					"content": "Tohumların yüzeyini kontrol ettim ama bir tanesinde bile filizlenme belirtisi yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060105
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060105,
					"content": "Neden peki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060106
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060106,
					"content": "Bunların doğru tohumlar olduğuna eminim. Kilerde buldum, yaşlı hortlağın notlarında yazıyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060107
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060107,
					"content": "Notlarında yazdığına göre tohumların ömürleri uzunmuş. Onları kuru bir yerde sakladığın sürece bozulmazlarmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060108
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060108,
					"content": "Onları ekerken yanlış bir şey de yapmadım. Gerektiği şekilde suladım ve gübre verdim. Neden filizlenmiyorlar acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060109
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060109,
					"content": "Merak etme Affan Dede. İstersen bir süre daha bekleyelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060110
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060110,
					"content": "Biz ne zaman ormana meyve ve çiçek toplamaya gitsek topladıktan sonra tekrar çıkmaları için birkaç gün beklememiz gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060111,
						732060112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732060111,
					"content": "Sabırlı ol.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				},
				{
					"id": 732060113,
					"content": "Beklemekten başka şansımız yok sanırım. Bugün zamanınız var mı? Tekrar sulamama yardım eder misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060114
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060114,
					"content": "Fidelikteki toprağı havalandırmak saatlerimi aldığı için çok yoruldum, tekrar su getiremedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732060115
					],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060115,
					"content": "Tamamdır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060116
					]
				},
				{
					"id": 732060116,
					"content": "Teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Affan"
				},
				{
					"id": 732060112,
					"content": "Sulamaya devam et.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732060113
					]
				}
			]
		},
		{
			"id": 7320603,
			"completionStepIds": [
				7320603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
