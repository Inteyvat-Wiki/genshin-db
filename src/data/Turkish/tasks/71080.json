					"nextDialogs": [
						710800633
					]
				},
				{
					"id": 710800633,
					"content": "Sorun değil. İzin verirsen şimdi şu dokuz şövalyenin geçmiş hayatları hakkında biraz hayal gücümü kullanacağım.",
