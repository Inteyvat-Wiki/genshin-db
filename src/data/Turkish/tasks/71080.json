					]
				},
				{
					"id": 710800614,
					"content": "Taliesin'e olanları anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800615
					]
				},
				{
					"id": 710800615,
					"content": "Vay be, harika. Mükemmel! Bir dakika, hepsini yazayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800616
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800616,
					"content": "\"Karanlık sis, çığ gibi geliyordu. Hiçlikin ayrı düşmüş iki havarisi hiçbir iz bırakmadan geldiği gibi gitti.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
