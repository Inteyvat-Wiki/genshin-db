						710800631
					]
				},
				{
					"id": 710800631,
					"content": "Bu... Harika! \"Sonra da ünlü Gezgin dedi ki: 'Karşıma tek tek çıkmayın. Dokuzunuzla da tek seferde baş edebilirim!'\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800632
					],
					"speakerTitle": "Taliesin"
				},
				{
