						710800635
					]
				},
				{
					"id": 710800635,
					"content": "Taliesin'e olanları anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800636
					]
				},
				{
					"id": 710800636,
					"content": "Gerçekten... İlginç. Eski ve unutulmuş bir diyar, kıymeti bilinmeyen fedakarlıklar, haksız bir cezayla aklını kaybetmek... Ne harika konular! Çok geniş bir hikaye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800637
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800637,
					"content": "Yolculukların sırasında birçok şeyle karşılaştın ve hedeflerine bu kadar yaklaştın demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800638
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800638,
					"content": "Bunları bana anlattığın için teşekkür ederim. Hepsini kağıda geçireceğim. Tabii bunlardan hemen bir şiir yazmam herhalde. Bence bunlar senin efsanenin sadece küçük bir kısmı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800639
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800639,
					"content": "Sınırlı becerilerimle hikayeni anlatmayacağım. Tek istediğim yolculuğun bittiğinde bana anlatman.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800640
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800640,
					"content": "Zamanı geldiğinde dünyanın gelmiş geçmiş en destansı hikayesini dinleme şerefine ulaşacağımı hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
