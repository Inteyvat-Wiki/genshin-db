				{
					"id": 710800617,
					"content": "Kanyon'un derinliklerinde bulduğun masmavi kristali anlat.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710800618
					]
				},
				{
					"id": 710800618,
					"content": "Taliesin'e olanları anlatıyorsun...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710800619
					]
				},
				{
					"id": 710800619,
					"content": "\"Kristalin yüzeyinden gökler ve denizler geçip gitti, mor ve kırmızı izler söndü...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800620
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800620,
					"content": "#\"Harabelerin kadim yaratığı, {NICKNAME} ona sert bir darbe vurunca yalpaladı. Hikayenin ana karakteri de tam o anda ortaya çıktı!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800621
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800621,
					"content": "\"Gezgine yardıma gelen gizemli dostu hiçbir iz bırakmadan kayboldu ama kristal, dev mekanik yılanı çoktan parçalamıştı...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Taliesin"
				}
			]
		},
