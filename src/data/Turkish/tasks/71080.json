				},
				{
					"id": 710800643,
					"content": "Haha! Çok ilginç bir hikaye! \"Serjant Anton iç çekerek 'Acı bir gün. Baş düşmanımız tarafından kurtarıldık!' dedi.\"",
					"roleType": "TALK_ROLE_NPC",
