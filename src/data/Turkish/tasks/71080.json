						710800624
					]
				},
				{
					"id": 710800624,
					"content": "İnanılmaz... Gerçekten akla hayale sığmaz. Bekle, ne diyeceğimi biraz düşüneyim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800625
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800625,
					"content": "\"Bu, göklere uzanan dev bir mantar olsa da sinsice yaklaşan karanlık karşısında çaresizdi...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710800626
					],
					"speakerTitle": "Taliesin"
				},
				{
					"id": 710800626,
					"content": "#\"Çağrısını duyan {NICKNAME} yardıma geldi. Tüm diyarı arındırarak krize engel oldu.\"",
					"roleType": "TALK_ROLE_NPC",
