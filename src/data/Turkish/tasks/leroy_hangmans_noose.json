			"dialogs": [
				{
					"id": 741540201,
					"content": "Uff, Paimon'un burnuna kötü kokular geliyor... Hem de leş gibi kokular!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}, sen akıllısın, düşün bakalım. Şimdi ne yapacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540203,
					"content": "Benoit yardım istiyor ama sonra da yardım istemem diye diretiyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "Benoit'nın evinin oralara biraz daha mı göz atsak o zaman? Arka pencerenin yanında tuhaf bir kutu vardı sanki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540208,
					"content": "Onun içinde kesin bir şey saklı. Belki aradığımız kanıt da oradadır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540204,
					"content": "Belki o çift de Cendre Nehri'ndendir...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "Yaptıklarına bakılırsa bir işler çeviriyorlar bence...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "Kafamda birtakım teoriler var ama onları destekleyebilecek kanıtım yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
