			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "Bu işin ucunu bırakmanızı beklemiyordum zaten. İnsanın yakasına bir yapıştınız mı bırakmıyorsunuz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540702,
					"content": "Hemen Asayiş Dairesinin yolunu tutarsınız diye düşünmüştüm ama gitmediniz. Başka planlarınız var belli ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540703,
					"content": "Benoit'yı neden burada tutuyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "Ne yalan söyleyeyim, azminiz karşısında etkilendim doğrusu... Hevesinizi daha faydalı şeylere yöneltseniz ne de parlak bir geleceğiniz olurdu halbuki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540706,
					"content": "Ne yazık ki bununla bir yere varamayacaksınız. *iç çeker* Azıcık bile korkunuz yok mu cidden?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540707,
					"content": "Gözdağı vermek için yanlış kişiyi seçtin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "Öyle mi dersin? O halde dünyadan bihabersiniz, belli oldu. Adaleti sağladığınızı falan mı sanıyorsunuz yoksa gerçekten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540709,
					"content": "Haberlerde bir tüccarın boğularak öldüğünden bahsediliyor, adı Brandt imiş. Ağzı iyi laf yapan bir adamdı hakikaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540710,
					"content": "Bilin bakalım ne olmuş? Haberde anlatıldığına göre adamcağız aslında boğularak ölmemiş, öldürülüp göle atılmış meğer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540711,
					"content": "Uzunca bir soruşturmanın ardından Gölge Mareşosesi nihayet bir sonuca varmış. Bu sonuca göre tüccar bir cinayete kurban gitmiş ve katil, kasten cinayet işlemekten suçlu ilan edilmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540712,
					"content": "Haberde yazan bu tabii. Gerçekte ne olduğu ise muamma... Katilin mi, yoksa kurbanın mı ölmeyi daha çok hak ettiğini nasıl bileceğiz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540713,
					"content": "Hımm... Çok zor bir soru gerçekten. Cevabın ne olduğuna karar verebilmiş değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540714,
					"content": "Neyse, uzattıkça uzattım ben de! Bunun konuşacağımız şeyle bir alakası yok ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540715,
					"content": "Ne demeye çalışıyorsun sen?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540716,
					"content": "Diyorum ki olan biteni doğru düzgün anlamadan hareket etmek aptalca. Ayrıca bu istenmeyen sonuçlara da yol açabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540717,
					"content": "Adaletsizlik karşısında sessiz kalmak aptalca olur esas.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "Haha... Öyleyse farklı şartlar altında tanışmış olsaydık arkadaş olurduk belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540720,
					"content": "Düşünce tarzını sevdim ama şu an işim başımdan aşkın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540721,
					"content": "Benim de sabrımın bir sınırı var... Bu size son ikazım, sonra uyarmadı demeyin. Bir daha evimin etrafında dolandığınızı görürsem vay halinize.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540722,
					"content": "Athos kendi kendine bir şeyler homurdanarak oradan ayrılır.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "Sen ise Athos'un bu tuhaf tavrı karşısında hayrete düşüyor ve bu meseleye nasıl yaklaşman gerektiğini ölçüp tartmaya başlıyorsun.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "Derken arka pencereden hafif bir tıklama sesi gelir. Daha sonra, zar zor duyulabilen bir gıcırtının ardından pencereden bir not süzülerek düşer...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "Kağıdın üzerinde kahverengi bir yazı var. Yazan kişinin acelesi varmış herhalde, mürekkep olarak kahve kullanmış olmalı...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "Hadi açıp ne yazıyormuş bakalım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540727,
					"content": "Benoit'dan gelmiş bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540728,
					"content": "Şşş, sessiz ol!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "... Pardon! Neyse, o zaman ondan işaret bekleyelim. Bir gözümüz de kedinin mama kabında olsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540718,
					"content": "Adalet yerini bulmadan içim rahat etmez benim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "Benoit ile aranızdaki asıl bağlantı ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
		{
