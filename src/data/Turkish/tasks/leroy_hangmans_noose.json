					}
				]
			},
			"dialogs": [
				{
					"id": 741540801,
					"content": "#Baksana {NICKNAME}! Burada Taze Balık var, hem yerler de tertemiz duruyor. Birileri ortalığı derleyip toplamış olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540802,
					"content": "Benoit'nın evinde biri var, orası kesin. Hadi gidip kulak kabartalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540803,
					"content": "... Doğru söylüyor, öyle yer yarılmış da içine girmiş gibi aniden sırra kadem basarsa çok göze batar. En azından arada bir insan içine çıkması lazım... Yürüyüş falan yapsın mesela.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540804
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540804,
					"content": "Komşuların Asayiş Dairesine haber uçurmasına engel olsak yeter. Şimdi bir de Özel Devriye Silahşorları çıkmasın başımıza.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540805
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540805,
					"content": "Dolaşmaya çıkmak istiyorsun, değil mi baba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540806
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540806,
					"content": "Ç-Çıkabilir miyim yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540807
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540807,
					"content": "Niye çıkamayasın, tabii çıkabilirsin! Hem biz de seninle gelmeyi çok isteriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540808
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540808,
					"content": "Biz ayağımızı denk alalım yine de. Kaşla göz arasında yardım falan çağırır, belli mi olur? Zaten şu iki veledi de musallat etti başımıza, göz hapsine aldılar bizi resmen...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540809
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540809,
					"content": "Babam yapmaz öyle şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540810
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540810,
					"content": "Asayiş Dairesinin bu olanları öğrenmesini hiç istemezsin, değil mi baba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540811
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540811,
					"content": "... Neyi öğrenmesini? Ne konuşuyorlar böyle sessiz sessiz? Paimon hiçbir şey duyamıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540812,
					"content": "Dışarı çıkmak üzereler.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540813
					]
				},
				{
					"id": 741540813,
					"content": "Peki o zaman, biraz daha uzağa gidelim. Bu sefer bizzat Benoit ile konuşmanın bir yolunu bulmamız lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540814,
					"content": "Evet.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540815
					]
				},
				{
					"id": 741540815,
					"content": "Peki, hadi tüyelim buradan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540816,
					"content": "Nasılsın baba? Şimdi daha iyi hissediyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540817
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540817,
					"content": "Siz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540818
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540818,
					"content": "Benoit...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 741540819,
					"content": "Yardım edin bana! Yani şey... Ne yardımı, yardım etmeyin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540820
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540820,
					"content": "Neler diyorsun sen baba? \"Yardım edin, yardım etmeyin\" falan nereden çıktı öyle? Hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540821
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540821,
					"content": "Hah, demek sizdiniz. Babamın sizinle konuşmaya bu kadar can atmasına şaşmamalı... Bir tanışıklığınız var sonuçta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540822
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540822,
					"content": "... N-Ne tanışıklığı canım! Kimmiş bunlar, tanımam etmem ben bunları!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540823
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540823,
					"content": "Hadi ya. Hayret... O halde neden burada seni bekliyorlar baba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540824
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540824,
					"content": "Çok iyi insanlar gerçekten, bizim için gazeteleri almışlar. Hatta eski komşumuz Snodgrass ile konuşmak için Cendre Nehri'ne bile gitmişler, biliyor muydun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540825
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540825,
					"content": "Çok yakın olduğunuz ayan beyan ortada! Çocukları da hep seversin zaten, öyle değil mi baba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540826
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540826,
					"content": "Ben de çocukları çok severim aslında ama ben babam kadar fedakar biri değilim. Kendi evladımdan kıymetlisi yoktur gözümde... O da ne yazık ki artık burada değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540827,
						741540829
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540827,
					"content": "Siz ne dolaplar çeviriyorsunuz böyle?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540828
					]
				},
				{
					"id": 741540828,
					"content": "Athos ve ben onun evlatlarıyız. Babam bizi çok sever, biz de onu çok severiz. Nesi garip geldi ki size?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540831,
					"content": "Baksana Morticia, hava da günlük güneşlik. Tam yürüyüş havası.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540832
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540832,
					"content": "Haklısın Athos.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540833
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540833,
					"content": "Bugünkü Buğukuş'u okudun mu? Çok ilginç bir haber vardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540834
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540834,
					"content": "Aa, hayır. Henüz okumamıştım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540835
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540835,
					"content": "Hayatını kaybeden yaşlı, talihsiz bir adamdan bahsediliyordu. Yürürken yolunu bir avuç hırsız kesmiş. Yanında onu koruyacak kimsesi olmadığı için de uçurumdan aşağı düşüp rahmetli olmuş diyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540836
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540836,
					"content": "Ne diyorsun! Yazık adamcağıza, ne istemişler garibandan...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540837
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540837,
					"content": "Bir de gölde boğulan bahtsız bir tüccar hakkında bir haber gördüm. Sünger gibi içmiş diyorlar, kör kütük sarhoş olup göl kenarına gitmiş... Sonra da göle düşüp boğulmuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540838
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540838,
					"content": "Vah vah! Kör talih işte, eceliyle ölmek herkese nasip olmuyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540839
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540839,
					"content": "Sonuncu haberi duy hele bir de sen! Milletin işine maydanoz olup duran işgüzarın biriyle ilgili bu da... *iç çeker* Zavallı işte. Fark etmeden yanlış bir ilaç içmiş, sonra da tahtalıköyü boylamış diyorlar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540840
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540840,
					"content": "Hastalığı için aldığı ilacı karıştırmış, içtiği şey de zehirmiş meğer. Hem de tek dikişte mideye indirmiş hepsini! Saatlerce can çekişmiş diyorlar, acılar içinde kıvranarak ölmüş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540841
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540841,
					"content": "Yapma yahu! Ölümün de sağı solu belli olmuyor gerçekten... Ee, başka bir haber var mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540842
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540842,
					"content": "... Özür dilerim, özür dilerim! Yemin ederim ki bir daha yapmayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540843
					],
					"speakerTitle": "Benoit Leroy"
				},
				{
					"id": 741540843,
					"content": "Ağzından neler çıkıyor öyle baba? Senin ne suçun var şimdi? Bugün çok koşturduk herhalde, yorgun düşmüşsün sen.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540844
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540844,
					"content": "Hadi geri dönüp babama şu gazeteyi okuyalım Athos. Senin ev de gazeteden geçilmiyor doğrusu baba, abone olmadığın gazete kalmamış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540845
					],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540845,
					"content": "Süper fikir! Sohbeti de tadında bırakmak lazım. Artık eve dönelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540846
					],
					"speakerTitle": "Athos"
				},
				{
					"id": 741540846,
					"content": "Hadi gidelim canım babacığım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Morticia"
				},
				{
					"id": 741540829,
					"content": "Bunu neden yapıyorsunuz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540830
					]
				},
				{
					"id": 741540830,
					"content": "Yürüyüş yaparken ona eşlik etmemizi mi diyorsun? Evlatları olarak ona yardımcı olmak vazifemiz değil mi? Üzerimizdeki hakkını başka türlü nasıl öderiz? Böyle basit bir sorumluluğu yerine getiremeyen evlat olmaz olsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540831
					],
					"speakerTitle": "Morticia"
				}
			]
		}
	]
}