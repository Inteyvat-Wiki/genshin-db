					"Bresson"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746690101,
					"content": "Kendine inan, Bresson... İnan. Tüm araçlar hazırlandı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690102
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690102,
					"content": "Sadece... Su altına gitmen gerekiyor. Evet, su altına... Oraya git ve bu aletlerin güvenilir olduğunu kanıtla, sonra işin tamam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690103
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690103,
					"content": "Ne yapıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690104
					]
				},
				{
					"id": 746690104,
					"content": "Hı? Nereden geldin? Hiç duymadım bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690105
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690105,
					"content": "Neredeyse suya düşüyordum. Eğer dengemi sağlayamasaydım Fontaine'de fotoğrafçılığın geleceği de... Suya batacaktı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690106,
						746690107
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690106,
					"content": "Bunu duyduğuma üzüldüm.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690108
					]
				},
				{
					"id": 746690108,
					"content": "Bir dakika, sen yüzme bilmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746690109,
					"content": "Ve sen Fontainelisin, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690110
					]
				},
				{
					"id": 746690110,
					"content": "Kim... Fontainelilerin yüzme bilmesi gerektiğini kim söyledi ki? Liyueli her insan yemek yapamaz ve her Mondstadtlı şair değildir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690111
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690111,
					"content": "Her neyse. Dalış ekipmanı alabilmek için bunca zahmete katlandım. Bugün, birkaç fotoğraf çekmek için su altına girmem gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690112
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690112,
					"content": "Ah, demek böyle...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 746690113,
					"content": "Bu Kamera hakkında özel bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690114
					]
				},
				{
					"id": 746690114,
					"content": "Özel mi? Ben, Bresson Cartier, Kamerayı bizzat ben modifiye ettim. Bu yüzden \"özel\" bir kamera.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690115
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690115,
					"content": "Modifikasyon tekniklerim çok sıkı ve özgündür. Ayrıca yalnızca en iyi malzemeleri kullanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690131
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690131,
					"content": "Bu Kameranın lensi diğer Kameralardakilerden çok daha iyidir. Su altındayken bile görüntü kalitesinde bir değişiklik olmaz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690116
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690116,
					"content": "Ama Kamera Kulübündekiler... Yeni tekniklerimi hiç umursamıyorlar. Fotoğrafçılıkta olayın cihazlarda değil, fotoğrafçının kendi becerisinde olduğunu iddia ediyorlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690117
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690117,
					"content": "Ama sadece beklesinler. Harika fotoğraflar çekeceğim ve o cahillerin çenesini kapatacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690118
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690118,
					"content": "Vay... Hadi, Bresson. Kendine inan... Yapabilirsin... Su hem ılık hem güzel ve insan yiyen balıklar da yok...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690119
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690119,
					"content": "Şey, bu dalış giysisi gerçekten işe yarayacak mı? Su altındayken bir anda patlar mı acaba?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690120
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690120,
					"content": "Öyle olursa sonsuza dek suların derinliklerine gömülür giderim... Ben... Ah, Hükümdarlar...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690121,
						746690122
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690121,
					"content": "Eğer gerçekten yapamazsan sana yardım edebilirim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690123
					]
				},
				{
					"id": 746690123,
					"content": "Gerçekten mi? Bunu yapar mısın? Bana yardım eder misin? Çok cömert birisin! Gerçekten, sen benim kurtarıcımsın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690124,
						746690125
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690124,
					"content": "Şey, yine de ödeme yapmalısın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690126
					]
				},
				{
					"id": 746690126,
					"content": "Tabii ki sana bunu bedavaya yaptırmayacağım. Ödemen yüklü olacak, bana güven!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690127
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690127,
					"content": "Ah, doğru ya. Müsaade et de haritan da güzel su altı manzaraları olan yerleri işaretleyeyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690128
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690128,
					"content": "Bazıları da karada... Iı... Şuralarda olmalı... Bu yepyeni bir ekipman ne de olsa. Birkaç yerde daha denemekten zarar gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690129
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690129,
					"content": "Pekala, bu olur. Fontaine'in teknik fotoğrafçılık geleceğini ve Kamera araçlarına yönelik vizyonumu yetenekli ellerine bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746690130
					],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690130,
					"content": "Ben... Şey, seni sahilde bekleyeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Bresson"
				},
				{
					"id": 746690125,
					"content": "Lonca kurallarına göre bir ödeme almam gerekiyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690126
					]
				},
				{
					"id": 746690122,
					"content": "Senin için su altında fotoğraf çekeyim mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690123
					]
				},
				{
					"id": 746690107,
					"content": "Bu kadar yoğun tepki vermeni beklemiyordum...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746690108
					]
				}
			]
		}
	]
}