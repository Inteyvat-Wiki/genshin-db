			"dialogs": [
				{
					"id": 760920101,
					"content": "Kaçsan iyi olur dostum! Burası çok tehlikeli. Vahşi Av gelirse seni koruyamam!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920102,
						760920109,
						760920112
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920102,
					"content": "Vahşi Avın ortaya çıkacağını nereden anlıyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920103
					]
				},
				{
					"id": 760920103,
					"content": "Işık Muhafızı olarak Vahşi Avla baş etmek benim ezeli yeminim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920104
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920104,
					"content": "Şuradaki Gelgit Mührü Taşını görüyor musun? Vahşi Avın tamamen yok olduğundan emin olmak için başında üç gün üç gece nöbet tutmam gerekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920105
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920105,
					"content": "Gelgit Mührü Taşı mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920106
					]
				},
				{
					"id": 760920106,
					"content": "Bu taşlar, Vahşi Avın sızmasını engellemek için Işık Muhafızlarının yerleştirdiği mühürler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920107
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920107,
					"content": "Nasıl çalıştığını anlamasam da yayılmalar kontrol edilmezse, Vahşi Av tekrar aynı bölgeye çekiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920108
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920108,
					"content": "Bu yüzden bu taşları genelde Vahşi Avın geri püskürtüldüğü alanlara koyuyoruz. Olur da av geri dönerse, taşlar aynı zamanda savaşta bizi koruyabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920109,
					"content": "Vahşi Avdan korkmuyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920110
					]
				},
				{
					"id": 760920110,
					"content": "Bu özgüven nereden geliyor bilmiyorum ama Vahşi Av hafife alınacak bir düşman değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920111
					],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920111,
					"content": "Sana bir çift tavsiye vereyim. Gelgit Mührü Taşı gördüğün yerlerde dikkatli ol.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				},
				{
					"id": 760920112,
					"content": "Seni daha fazla rahatsız etmeyeyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920113
					]
				},
				{
					"id": 760920113,
					"content": "Görüşmek üzere. Yolda kendine dikkat et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Rolf"
				}
			]
		},
