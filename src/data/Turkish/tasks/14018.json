				"points": []
			},
			"dialogs": [
				{
					"id": 140180901,
					"content": "Kendimden biraz fazla şüphe etmeye başladım sanırım. Kendimi toparlayacağım ve hepiniz için çok daha güvenilir bir Başkan olacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180902
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180902,
					"content": "Şu an düşününce davranışlarımdan utandım hatta, hehe.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180903,
						140180907,
						140180912
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180903,
					"content": "Kasaba halkının hediyesi hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180904
					]
				},
				{
					"id": 140180904,
					"content": "Her insanın başkalarına göre sıradan ama kendisi için ulaşılamaz gördüğü bir şey vardır mutlaka.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180905
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180905,
					"content": "Benim için bu bir aile portresi mesela. Başkalarının aile fotoğraflarını oldum olası çok kıskanmışımdır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180906
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180906,
					"content": "Bir gün benim de bir aile portrem olacağını düşünmezdim, hele böylesini hiç beklemezdim. O kadar da şanssız biri değilmişim demek ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180907,
					"content": "Clementine hakkında...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180908
					]
				},
				{
					"id": 140180908,
					"content": "Aslında bir ara düşünmüştüm... Annem benim \"sadece\" mutlu bir hayat yaşamamı istemiş olsa da pek kolay bir istek değil bu. Düşününce babamın benden beklentilerini karşılamak kadar zor sayılır hatta.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180909
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180909,
					"content": "Annemle babamın karakterleri çok zıttı ama birbirlerine hep saygı duyarlardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180910
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180910,
					"content": "Feribüs projesi, tüm Fontaine'in yararına olan dev bir projeydi. Bu projeyi sadece \"klan\" açısından bakarak değerlendirmek dar görüşlülük olurdu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180911
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180911,
					"content": "Bence annemin ara buluculuğa yanaşmamasının veya hatların inşaatına itiraz etmemesinin sebebi bu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180912,
					"content": "\"Beni gerçekten ortağın olarak görüyor musun\" diye sormuştun ya...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180913
					]
				},
				{
					"id": 140180913,
					"content": "Dur, dur, bir dakika, niye hatırlattın bunu şimdi? Lütfen, bir daha duymayayım! Çok utanıyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180914
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180914,
					"content": "Unut çabuk, unut öyle bir şey dediğimi! Gerçi bir dakika, unutman da kötü olur sanırım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180915
					],
					"speakerTitle": "Navia"
				},
				{
					"id": 140180915,
					"content": "Neyse tamam ama lütfen aramızda sır olarak kalsın bu! Bir daha konusunu açma!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Navia"
				}
			]
		}
	]
}