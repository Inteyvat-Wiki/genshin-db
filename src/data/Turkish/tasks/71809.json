			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Fan Er'ye"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090301,
					"content": "Bu operayı her dinlediğimde kafam daha da karışıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090302
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090302,
					"content": "Bir sorun mu var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090303
					]
				},
				{
					"id": 718090303,
					"content": "Merhaba sevgili Gezgin. Sorun şu: Heyu Çayevi son zamanlarda birkaç yeni opera çıkardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090304
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090304,
					"content": "Bu operalar... Çok hareketliler, orası kesin ama bu yeni operaların anlatmak istediklerini veya gençlerin neden bu kadar zevk aldığını anlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090305
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090305,
					"content": "Bu konuda nasıl hissediyorsun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090306
					]
				},
				{
					"id": 718090306,
					"content": "Güzel soru. Şahsen eski opera klasiklerini dinlemeyi tercih ediyorum. Sonuçta kulağım onlara alışmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090307
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090307,
					"content": "Liyue Limanı büyük bir değişimden geçiyor tabii. Yeni operalar da şu anki ortama gayet uyuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090308
					],
					"speakerTitle": "Fan Er'ye"
				},
				{
					"id": 718090308,
					"content": "*iç çeker* Yine de bu değişiklikler çok çabuk yaşanıyor sanki. Eski operalar bir süredir sahne almıyor. Acaba Rex Lapis olsa... Hayır, bunu konuşmayalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Fan Er'ye"
				}
			]
		},
		{
			"id": 7180904,
			"completionStepIds": [
				7180909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
