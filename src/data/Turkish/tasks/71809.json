				"objectNames": [
					"Qingzhou"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090401,
					"content": "Ne öğrendiniz efendim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090402
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090402,
					"content": "Pek çok şey.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090403
					]
				},
				{
					"id": 718090403,
					"content": "Ah, öyle mi? Lütfen benimle de paylaşın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090404
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090404,
					"content": "Güney rıhtımında bir sürü köpek var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090405
					]
				},
				{
					"id": 718090405,
					"content": "Ah, ne güzel. Çok canlı bir yer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090406
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090406,
					"content": "Bubu Eczanesi yakınlarında bir sürü serçe var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090407
					]
				},
				{
					"id": 718090407,
					"content": "Serçeler, evet... Huzurlu zamanların işareti. Güzel şiirsel imgeler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090408
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090408,
					"content": "Bazı insanlar sadece yemekle ilgileniyor...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090409
					]
				},
				{
					"id": 718090409,
					"content": "Hahaha, bunda yanlış bir şey yok. Yemek yemek, özellikle de Liyue Limanı gibi bir şehirde yaşamın en önemli ihtiyaçlarından ve zevklerinden birisidir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090410
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090410,
					"content": "Evet, bu da oldukça büyüleyici. Bunu not alacağım. Eserlerimde kullanabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090411
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090411,
					"content": "Bazıları ise şehrin çok hızlı değiştiğini düşünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090412
					]
				},
				{
					"id": 718090412,
					"content": "Hımm, bu da gayet doğal. Bazı insanlara göre Liyue sanki her geçen gün adeta deri değiştiriyor. Ben bile her bir değişikliğe ayak uydurmakta ya da kabul etmekte zorlanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090413
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090413,
					"content": "Ama bu çok geniş bir konu tabii. Korkarım tek bir şiire sığmaz. Yine de not edeceğim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090414
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090414,
					"content": "Şimdilik bu kadarı yeterli. Yardımınızı istemekle akıllıca bir seçim yapmışım efendim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090415
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090415,
					"content": "Anlattıklarınız bir sonraki şiir kitabımda mutlaka yer edinecektir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090416
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090416,
					"content": "Ah, evet, bazı maddi eşyaların yanı sıra size küçük bir hediye hazırladım. Lütfen yardımınız için bir teşekkür olarak kabul edin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090417
					],
					"speakerTitle": "Qingzhou"
				},
				{
					"id": 718090417,
					"content": "Yeni şiir kitabım yayınlandığında bu imzayı vererek kitabımı ücretsiz alabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Qingzhou"
				}
			]
		},
