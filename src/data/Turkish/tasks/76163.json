			"dialogs": [
				{
					"id": 761630101,
					"content": "... Sonnet. Son birkaç yıldır işlerinden kaytarıp gizlice insanlarla oynamaya daha sık gitmeye başladın, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630102
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630102,
					"content": "N-Ne var ki bunda? Tüm işleri şu Ay Elçilerine bırakabiliriz sonuçta, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630103
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630103,
					"content": "Yeni efendimize epey ısındınız kardeşlerim, o da iş yükümüzü bölüşelim diye kendi hizmetkarlarını yollamaya razı zaten. Hal böyleyken kabul etmek dışında ne yapabilirim ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630104
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630104,
					"content": "Hem sen de gezip tozuyorsun Canon! Gidip insanların bir festivaline bile katıldın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630105
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630105,
					"content": "... O görevimin bir parçasıydı. Başrahipleri adımı andı, haliyle benim de seslerine karşılık vermem icap etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630106
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630106,
					"content": "Sıradan bir insan kızı gibi davranıp kendi heykelinin önünde dans etmek de mi görevlerinden biri yani? Bak bunu ilk kez duyuyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630107
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630107,
					"content": "... Aria.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630108
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630108,
					"content": "Canon.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630109
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630109,
					"content": "... Sana adımı söyle demedim ki... Aman, boş ver. Madem yeni Ay Elçisi Sonnet'e işlerinde yardımcı olmayı sorun etmiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630110
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630110,
					"content": "Zibai. Kızın adı Zibai. İsimleri biraz aklında tutsan iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630111
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630111,
					"content": "... Madem Zibai'ın bir itirazı yok, ben daha ne diyeyim? Ama Sonnet, Ayın İradesi olarak dünyayı döndüren temel formülleri de aklından çıkarmamalısın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630112
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630112,
					"content": "Hazırlan. Sana morfolojik izomorfizmleri doğrulama konusunda birkaç temel problem vereceğim. Hepsini çözmeden yüzeye dönmek yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630113
					],
					"speakerTitle": "Canon"
				},
				{
					"id": 761630113,
					"content": "Hehe, çok fenasın. Aynı şu yeryüzü romanlarında kaçak prensesi yaka paça aya geri götürmeye çalışan kötü karakter gibisin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630114
					],
					"speakerTitle": "Aria"
				},
				{
					"id": 761630114,
					"content": "Aynen öyle!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761630115
					],
					"speakerTitle": "Sonnet"
				},
				{
					"id": 761630115,
					"content": "... Bu hikayedeki ay sensin! Deme öyle şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Canon"
				}
			]
		}
	]
}