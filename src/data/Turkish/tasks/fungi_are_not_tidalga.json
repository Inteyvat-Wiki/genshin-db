			"dialogs": [
				{
					"id": 745080101,
					"content": "Bir süre sonra Paimon ile birlikte Küçük Mantarların Eğlenceli Şöleni standında varıyorsunuz...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						745080102
					]
				},
				{
					"id": 745080102,
					"content": "Mmm! Bu pofuduk, zıpzıp, sevimli mi sevimli Mantarlara bayıldım ben! Hehe, oynamaya devam etmek istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080103
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080103,
					"content": "Seninle tanışmadık galiba.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080104
					]
				},
				{
					"id": 745080104,
					"content": "Ben Enghiene. Turenna, Özel Devriyeye katılmadan önce onun eğitmeniydim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080105
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080105,
					"content": "Ben ona benzemem bu arada, tamam mı? Hiç ama hiç alakamız yok! Sırf Zirvelerin Arşa Değen Lider Savaşçılarısınız diye önünüzde diz falan çökmem, ona göre!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080106
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080106,
					"content": "Şey... Demek bu kibirli Melusina eskiden Turenna'nın eğitmeniymiş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080107
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080107,
					"content": "Altın Yıldız, Gümüş Yardımcı, canınızı sıkmayın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080108
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080108,
					"content": "Bayan Turenna kısa süre önce yeni bir göreve atandı, o yüzden Özel Devriye üssüne döndü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080109
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080109,
					"content": "Gitmeden önce de Bayan Enghiene'den onun yerine etkinlik alanına göz kulak olmasını istedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080110
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080110,
					"content": "Bayan Enghiene Küçük Mantarların Eğlenceli Şölenine bayıldı resmen. Sürekli oynuyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080111
					],
					"speakerTitle": "Haniyyah"
				},
				{
					"id": 745080111,
					"content": "Evet! O toparlak Mantarları çok sevdim! Hem masa oyununda hem gerçek hayatta aşırı sevimliler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080112
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080112,
					"content": "Pofuduk, tatlı ve yumuşacıklar... Tidalgalar gibi... Hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080113,
						745080114
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080113,
					"content": "Ağzın mı sulanıyor senin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				},
				{
					"id": 745080115,
					"content": "Yemeyecektim zaten! Onlara sarılıp başımı yaslamak istiyorum sadece. Ateş Saçan'ı o kadar sevip mıncıkladım, Haniyyah hiç laf etmedi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080116
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080116,
					"content": "D-Daha fazlasını yapamazsın işte! Davul Kafa'ya ancak biz sarılabiliriz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080117,
					"content": "Aman be, gıcığa bak! Ben ikisine de sarılmak istiyorum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080118
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080118,
					"content": "Haniyyah sizin bu oyunda usta olduğunuzu söyledi. Benimle de bir tur oynayın da görelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080119
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080119,
					"content": "Ben kazanırsam Davul Kafa'ya sarılıp yanağını mıncıklayacağım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080120
					],
					"speakerTitle": "Enghiene"
				},
				{
					"id": 745080120,
					"content": "Şuna bak, bizi nasıl da hor görüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080121,
					"content": "#Hadi {NICKNAME}! Biz bu oyunun ilk oyuncularından biriyiz. Oynayalım da ona haddini bildirelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745080122,
						745080123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080122,
					"content": "Ayrıca Nilotpala Kupasının da ilk şampiyonlarıyız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080124,
					"content": "Aynen öyle! Bu unvanları sokakta bulmadık biz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 745080123,
					"content": "Ayrıca Muhteşem Kahramanlığın Çifte Yıldızlarıyız!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080124
					]
				},
				{
					"id": 745080114,
					"content": "Sakın onları yiyeyim deme! Mantarları yemek yasak!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745080115
					]
				}
			]
		}
	]
}