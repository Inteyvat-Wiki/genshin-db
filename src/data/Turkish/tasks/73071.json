			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710401,
					"content": "#Paimon, {NICKNAME}. Tüm bunları siz mi hazırladınız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710402
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710402,
					"content": "Hem evet hem hayır... Bu bahçeyle asıl Aranakula ve Arakara ilgileniyor. Biz yalnızca bazı işlerin ucundan tuttuk. Anlayacağın hikayemi desteklemek için yaptığımız bir yer değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710403
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710403,
					"content": "Aranakula ve Arakara... Onlar da orman ruhları dediğiniz \"Aranaralar\" mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710404
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710404,
					"content": "Evet! Artık Paimon'a inanıyor musun? Bahçeyle ilgilenmelerine yardım etmekle kalmadık, Aranaralarla maceraya bile çıktık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710405,
					"content": "Kaçırılan çocukları Vimara Köyü'ne götürenler Aranaralar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710406
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710406,
					"content": "Hikayelere hâlâ pek inanamıyorum ama... Burada beklersem ben de onları görebilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710407
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710407,
					"content": "Vanarana tehlikeli değildir ama Gandharva'ya dönmek istemediğine emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710408
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710408,
					"content": "Süzgeç gibi bir hafızan var Paimon. Yetişkinlere güvenemeyeceğimi ve kendi yoluma gitmek istediğimi söyledim ya.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710409
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710409,
					"content": "Ama...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710410
					]
				},
				{
					"id": 730710410,
					"content": "Tamam, benim için endişelenmene gerek yok. Şu ana kadar kendi başımın çaresine bakabildim, unuttun mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710411
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710411,
					"content": "Ayrıca bitkilerle de aram çok iyidir. Bahçeyle ilgilensem Aranaraların hoşuna gitmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710412
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710412,
					"content": "Madem ısrar ediyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710413,
					"content": "Ne kadar da evhamlısın Paimon. Kimsenin benim için bu kadar endişelendiğini hatırlamıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710414
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710414,
					"content": "Bak, beni dinle Varsha. Burada, Vanarana'da güvendesin ama hâlâ bir çocuk olduğunu unutma ve kendine dikkat et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710415
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710415,
					"content": "Biliyorum, biliyorum. Siz de kendinize dikkat edin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varsha"
				}
			]
		},
		{
			"id": 7307105,
			"completionStepIds": [
				7307107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307107",
							"2"
						],
						"stepId": 7307107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710501,
					"content": "Garip, bu çocuk burada ne yapıyor? Hey sen! Burada bir başına ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710502,
					"content": "Hı! Tuhaf bir tip ve yanında da uçan tuhaf bir tip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710503
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710503,
					"content": "Hey, çok kabasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710504
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710504,
					"content": "Evet, öyle. Kabayım tabii. Bana \"görgü kurallarını\" öğretecek bir ailem yoktu, bilmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710505
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710505,
					"content": "(Bu sözlerin arkasında kesinlikle bir hikaye var.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710506
					]
				},
				{
					"id": 730710506,
					"content": "Hımm... Neyse, bizler garip tipler değiliz ve kesinlikle kötü değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710507,
						730710509
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710507,
					"content": "Yalnızca iki nazik gezginiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710508
					]
				},
				{
					"id": 730710508,
					"content": "Aynen öyle. Bu yüzden de derdi olanlara derman oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710511,
					"content": "#Paimon'un adı Paimon, bu da {NICKNAME}. Senin adın ne bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710512
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710512,
					"content": "Adım Varsha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710513
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710513,
					"content": "Neden burada tek başınasın Varsha? Kaybolduysan seni geri götürebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710514
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710514,
					"content": "Hayır. Geçmiş geçmişte kalsın. Ben önüme bakmaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710515
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710515,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710516
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710516,
					"content": "Yetişkinlere güvenemem. Kendi yoluma gitmeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710517
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710517,
					"content": "Hâlâ küçük bir çocuk olmana rağmen neden böyle büyük laflar ediyorsun? Hem orman çok tehlikeli olabilir. Senin gibi bir çocuk bu tehlikelerle baş edemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710518,
					"content": "Kötü bir adam beni kaçırmaya çalıştı ama önemli değil. Artık daha çok dikkatliyim. Tehlikelerle başa çıkabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710519
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710519,
					"content": "Vimara Köyü'ndendi ve iyi birine benziyordu. Sonra gördüm ki önceden tanıdığım yetişkinlerden bir farkı yokmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710520
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710520,
					"content": "Neredeyse biri tarafından kaçırılıyor muydun? O halde dersini hiç almamışsın! Peki ama elinden kurtulmayı nasıl başardın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710521
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710521,
					"content": "Küçük bir yaratık beni buraya fırlattı. Gandharva'da daha önce hiç bu kadar küçük bir şey görmemiştim, muhtemelen bir orman ruhuydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710522
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710522,
					"content": "(Bir Aranara olmalı.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710523
					]
				},
				{
					"id": 730710523,
					"content": "(Acaba \"Vimara Köyü'nden biri\" derken...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710524
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710524,
					"content": "Her neyse, ormanda bir başına kalmak çocuklar için güvenli değil. Her türlü tehlikeyle karşılaşabilirsin, mesela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710525,
					"content": "Tehlikeli mantarlarla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710526
					]
				},
				{
					"id": 730710526,
					"content": "Evet! Nara Marana gibi kötüleri de unutmamak lazım. Ah, hayır. Paimon'un demeye çalıştığı şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710527,
					"content": "Seni kaçırmaya çalışan kötü insanlarla karşılaşabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710528
					]
				},
				{
					"id": 730710528,
					"content": "#Evet! {NICKNAME} doğru söylüyor! Hem... Hem aç kalabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710529
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710529,
					"content": "Doğanın armağanlarıyla dolu bir ormanda aç kalmak imkansız. Her yerde Yıldız Mantarı, Tatlı Çiçek ve Nane var. Zaten kuş kadar yiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710530
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710530,
					"content": "Ayrıca bitkilerle aram çok iyidir, karnımı doyurmak için Tatlı Çiçeklerin veya Nanelerin olduğu güvenli bir yer bulmak zor olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710531
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710531,
					"content": "Haha, Tatlı Çiçeklerle dolu bir bahçe... Cennet dediğin budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710532
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710532,
					"content": "Tatlı Çiçeklerle dolu bir bahçe... Hey Paimon şimdi hatırladı, bakımı için Aranaralara yardım ettiğimiz bahçede bir sürü vardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710533
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710533,
					"content": "Yoksa gerçekten de böyle bir cennetin var olduğunu mu söylüyorsun Paimon?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710534
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710534,
					"content": "Aynen öyle! Ayrıca ister inan ister inanma ama seni kurtaran bir \"orman ruhu\" vardı ya işte o Aranara denen bir türdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710535
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710535,
					"content": "Onların bir sürü Viparyas dikmelerine yardım ettik, oradan biliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710536
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710536,
					"content": "Toprağın hatırlamasına yardım ettik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710537
					]
				},
				{
					"id": 730710537,
					"content": "Bu doğru. Aranakula'ya göre Vanarana her şeyi hatırlarmış, yani toprak hatırladığında Viparyas yeniden büyüyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710538
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710538,
					"content": "Böyle sayısız hikaye duydum zamanında ama bunlara yalnız çocuklar inanır. Senin de bunları iyi niyetle söylediğini biliyorum Paimon, teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710539
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710539,
					"content": "Sen de çocuk sayılmaz mısın? Hem Paimon hikaye anlatmıyor. Paimon gerçekleri söylüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710540
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710540,
					"content": "Tabii. Hikaye anlatan herkes böyle der.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710541
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710541,
					"content": "Bize inanmıyorsan... Kendi gözlerinle görünce inanırsın! Bizimle gel de kendin gör!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710542
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710542,
					"content": "Dur, gerçekten hikayeni kanıtlamak için bir yer mi hazırladın? Şimdi ilgimi çekti işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710543
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710543,
					"content": "Ah, Paimon sana gerçekleri söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710544
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710544,
					"content": "#{NICKNAME}, hadi onu Aranara bahçesine götürelim. Böylece kafasındaki soru işaretleri ortadan kalkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710509,
					"content": "Kayıp kardeşimi arıyoruz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710510
					]
				},
				{
