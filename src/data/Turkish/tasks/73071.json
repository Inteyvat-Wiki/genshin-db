			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710201,
					"content": "Tohum olduğu sürece Tatlı Çiçek yetiştirebilirim ama ekmek ayrı. Ekmeği ekemezsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710202
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710202,
					"content": "Ekmeği ikiye böldüğünde kendi kendine tamamlansaydı kimse aç kalmazdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varsha"
				}
			]
		},
		{
			"id": 7307103,
			"completionStepIds": [
				7307103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307103",
							"2"
						],
						"stepId": 7307103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710301,
					"content": "Selam Varsha! Hâlâ buradasın demek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710302
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710302,
					"content": "#Paimon. {NICKNAME}. Sizi gördüğüme sevindim. Burada keyfim yerinde. Endişelenmenizi gerektiren bir şey yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710303
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710303,
					"content": "Keyfin yerinde öyle mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710304,
					"content": "Hâlâ beni ikna etmeye mi çalışıyorsunuz? Sizinle hiçbir yere gelmiyorum. Hiçbir yere...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710305
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710305,
					"content": "Yani... Seni bir şey yapman için zorlamıyoruz ama \"Tatlı Çiçeklerle dolu bir bahçe\"den bahsedişini hatırlıyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710306
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710306,
					"content": "Şey... Fazlasıyla iyimser bir düşünceydi. Öyle bir yer olmadığını biliyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710307
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710307,
					"content": "Hımm... Bir çocuğun böyle olgun davrandığını görünce hâlâ tuhaf hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710308
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710308,
					"content": "Sana iyi bir haberimiz var! Tahmin et bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710309
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710309,
					"content": "Gerçekten de Tatlı Çiçeklerle dolu bir bahçe mi var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710310
					]
				},
				{
					"id": 730710310,
					"content": "Evet! Ayrıca ister inan ister inanma ama seni kurtaran bir \"orman ruhu\" vardı ya işte o Aranara denen bir türdü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710311
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710311,
					"content": "Onların bir sürü Viparyas dikmelerine yardım ettik, oradan biliyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710312
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710312,
					"content": "Toprağın hatırlamasına yardım ettik.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710313
					]
				},
				{
					"id": 730710313,
					"content": "Bu doğru. Aranakula'ya göre Vanarana her şeyi hatırlarmış, yani toprak hatırladığında Viparyas yeniden büyüyecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710314
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710314,
					"content": "Böyle sayısız hikaye duydum zamanında ama bunlara yalnız çocuklar inanır. Senin de bunları iyi niyetle söylediğini biliyorum Paimon, teşekkür ederim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710315
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710315,
					"content": "Sen de çocuk sayılmaz mısın? Hem Paimon hikaye anlatmıyor. Paimon gerçekleri söylüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710316
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710316,
					"content": "Tabii. Hikaye anlatan herkes böyle der.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710317
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710317,
					"content": "Bize inanmıyorsan... Kendi gözlerinle görünce inanırsın! Bizimle gel de kendin gör!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710318
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710318,
					"content": "Dur, gerçekten hikayeni kanıtlamak için bir yer mi hazırladın? Şimdi ilgimi çekti işte.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710319
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710319,
					"content": "Ah, Paimon sana gerçekleri söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710320
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710320,
					"content": "#{NICKNAME}, hadi onu Aranara bahçesine götürelim. Böylece kafasındaki soru işaretleri ortadan kalkar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7307104,
			"completionStepIds": [
				7307105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307105",
							"2"
