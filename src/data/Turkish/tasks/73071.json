			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Varsha"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730710101,
					"content": "Garip, bu çocuk burada ne yapıyor? Hey sen! Burada bir başına ne yapıyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710102,
					"content": "Hı! Tuhaf bir tip ve yanında da uçan tuhaf bir tip.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710103
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710103,
					"content": "Hey! Çok kabasın!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710104,
					"content": "Evet, öyle. Kabayım tabii. Bana \"görgü kurallarını\" öğretecek bir ailem yoktu, bilmiyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710105
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710105,
					"content": "(Bu sözlerin arkasında kesinlikle bir hikaye var.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710106
					]
				},
				{
					"id": 730710106,
					"content": "Hımm... Neyse, bizler garip tipler değiliz ve kesinlikle kötü değiliz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710107,
						730710109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710107,
					"content": "Yalnızca iki nazik gezginiz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710108
					]
				},
				{
					"id": 730710108,
					"content": "Aynen öyle. Bu yüzden de derdi olanlara derman oluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710111,
					"content": "#Paimon'un adı Paimon, bu da {NICKNAME}. Senin adın ne bakalım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710112,
					"content": "Adım Varsha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710113
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710113,
					"content": "Neden burada tek başınasın Varsha? Kaybolduysan seni geri götürebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710114,
					"content": "Hayır. Geçmiş geçmişte kalsın. Ben önüme bakmaya karar verdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710115
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710115,
					"content": "Ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710116,
					"content": "Yetişkinlere güvenemem. Kendi yoluma gitmeliyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710117
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710117,
					"content": "Hâlâ küçük bir çocuk olmana rağmen neden böyle büyük laflar ediyorsun? Hem orman çok tehlikeli olabilir. Senin gibi bir çocuk bu tehlikelerle baş edemez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710118
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710118,
					"content": "Kötü bir adam beni kaçırmaya çalıştı ama önemli değil. Artık daha çok dikkatliyim. Tehlikelerle başa çıkabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710119
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710119,
					"content": "Vimara Köyü'ndendi ve iyi birine benziyordu. Sonra gördüm ki önceden tanıdığım yetişkinlerden bir farkı yokmuş...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710120
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710120,
					"content": "Neredeyse biri tarafından kaçırılıyor muydun? O halde dersini hiç almamışsın! Peki ama elinden kurtulmayı nasıl başardın?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710121
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710121,
					"content": "Küçük bir yaratık beni buraya fırlattı. Gandharva'da daha önce hiç bu kadar küçük bir şey görmemiştim, muhtemelen bir orman ruhuydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710122
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710122,
					"content": "(Bir Aranara olabilir.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710123
					]
				},
				{
					"id": 730710123,
					"content": "(Acaba \"Vimara Köyü'nden biri\" derken...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710124
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710124,
					"content": "Her neyse, ormanda bir başına kalmak çocuklar için güvenli değil. Her türlü tehlikeyle karşılaşabilirsin, mesela...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710125
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710125,
					"content": "Tehlikeli mantarlarla.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710126
					]
				},
				{
					"id": 730710126,
					"content": "Evet! Nara Marana gibi kötüleri de unutmamak lazım. Ah, hayır. Paimon'un demeye çalıştığı şey...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710127
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710127,
					"content": "Seni kaçırmaya çalışan kötü insanlarla karşılaşabilirsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710128
					]
				},
				{
					"id": 730710128,
					"content": "#Evet! {NICKNAME} doğru söylüyor! Hem... Hem aç kalabilirsin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710129
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710129,
					"content": "Doğanın armağanlarıyla dolu bir ormanda aç kalmak imkansız. Her yerde Yıldız Mantarı, Tatlı Çiçek ve Nane var. Zaten kuş kadar yiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710130
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710130,
					"content": "Ayrıca bitkilerle aram çok iyidir, karnımı doyurmak için Tatlı Çiçeklerin veya Nanelerin olduğu güvenli bir yer bulmak zor olmayacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710131
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710131,
					"content": "Haha, Tatlı Çiçeklerle dolu bir bahçe... Cennet dediğin budur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710132
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710132,
					"content": "Ne güzel bir hayal...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710133
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710133,
					"content": "Neyse. Artık Gandharva'da olduğumdan çok daha mutluyum ve dövülmüyorum. Kibarlığın için teşekkür ederim ama şimdilik beni yalnız bıraksan daha iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710134
					],
					"speakerTitle": "Varsha"
				},
				{
					"id": 730710134,
					"content": "Hımm... Paimon, başından neler geçti bilmiyor ama onu dönmesi için ikna edemeyeceğiz gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710135
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710135,
					"content": "Doğrusu burası o kadar da tehlikeli görünmüyor... Şansımız yaver giderse daha sonra gelir onu kontrol ederiz. Hem belki o zamana kadar fikrini değiştirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 730710109,
					"content": "Kayıp kardeşimi arıyoruz...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730710110
					]
				},
				{
					"id": 730710110,
					"content": "Senin gibi küçük bir kızı burada tek başına görünce de endişelendik! Yardıma ihtiyacın olabilirdi, seni öylece bırakıp gidemezdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730710111
					],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7307102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
