			"dialogs": [
				{
					"id": 220480101,
					"content": "Tapınak yine kir pas içinde...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480102
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480102,
					"content": "Sorun ne?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480103
					]
				},
				{
					"id": 220480103,
					"content": "Miyav, tekrar hoş geldin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480104
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480104,
					"content": "Yine tapınağın dört bir yanı dökülen yapraklarla doldu. Göz zevkimi bozuyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480105
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480105,
					"content": "Buraya saygılarını sunmaya gelen insanlara ayıp olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480106
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480106,
					"content": "Daha önce yaptığın gibi tapınağı temizlememe yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480107,
						220480112
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480107,
					"content": "Taisuke ve Eiko buralarda değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480108
					]
				},
				{
					"id": 220480108,
					"content": "O iki yeşilli ile konuşmak istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480109
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480109,
					"content": "Uzun olan bana hep bir garip bakıyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480110
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480110,
					"content": "Diğer yeşilli ise biraz... İsteksiz gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480111
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480111,
					"content": "Miyav miyav. Her neyse, onlar güvenilir insanlar değiller.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480115,
					"content": "Ne olursa olsun güvenebileceğim tek kişi sensin. Temizlemek için uzun çubuğu kullan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480116,
						220480117
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480116,
					"content": "O iş bende.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480118,
					"content": "Neyse, bu işi sana bırakıyorum. Ben de...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480119
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480119,
					"content": "Seni burada bekleyeceğim. Miyav.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480117,
					"content": "Hallederim herhalde.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480118
					]
				},
				{
					"id": 220480112,
					"content": "Şey, Bay Ooshima'ya sorabilirdin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220480113
					]
				},
				{
					"id": 220480113,
					"content": "O taş adam sürekli bir şeylere vurarak çalışıyor. Kim bilir ne yapıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480114
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480114,
					"content": "En son tak tak diye taşa vurmuştu zaten, şimdi neye vuruyor acaba? Çok sinir bozucu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480115
					],
					"speakerTitle": "Neko"
				}
			]
		},
