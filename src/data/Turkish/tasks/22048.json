					"nextDialogs": [
						220480303
					]
				},
				{
					"id": 220480303,
					"content": "Miyav, güzel. Gerçekten güvenilir kişilersiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480304
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480304,
					"content": "Tapınak, sonunda bir şeye benzedi. Hibiki döndüğünde buna pek bir sevinecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220480305
					],
					"speakerTitle": "Neko"
				},
				{
					"id": 220480305,
					"content": "Bu tapınakla ilgilenmeye devam etmeliyim... Miyav.",
					"roleType": "TALK_ROLE_NPC",
