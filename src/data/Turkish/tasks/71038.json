	"talks": [
		{
			"id": 7103604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103801",
							"2"
						],
						"stepId": 7103801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Zhiqiong"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360401,
					"content": "Merhaba! Lütfen otur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360402
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360402,
					"content": "Önceki maceramız konusunda...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360403
					]
				},
				{
					"id": 710360403,
					"content": "Neden o kadar inat ettiğimi mi yoksa neden herkese sorun yaşattığımı mı soruyorsun? Haha, hadi ama, hatalı olduğumu biliyorum. Tekrar etmek zorunda değilsin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360404
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360404,
					"content": "Dürüst olmak gerekirse maceracılar olarak tehlike görünce heyecan duymanın doğamızda olduğundan şüpheleniyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360405
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360405,
					"content": "Sonuçta doğduğumuzdan beri sırtımız sağlam, bacaklarımız çevik. Tüm bunlara sahipken sakin bir yaşamla yetinmek bana yanlış geliyor, biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360406
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360406,
					"content": "Ölüm tehlikesi hakkında düşünmedim değil ancak... Hımm, sana bir soru sorabilir miyim?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360407
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360407,
					"content": "Sor bakalım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360408
					]
				},
				{
					"id": 710360408,
					"content": "Meşhur Mondstadtlı maceracı Stanley, Mare Jivari'den geçtiği için bu kadar meşhur oldu ancak bu macera sırasında değerli bir arkadaşını kaybetti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360409
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360409,
					"content": "O arkadaşın adını yalnızca birkaç kişi biliyor olsa da maceraya katıldığı için ona ait anılar daima bizim gibi maceracıların aklında olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360410
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360410,
					"content": "Düşünüyordum da... Şey... Lütfen düşüncemi çocukça bulursan bana gülme. Sence Stanley'nin geri dönmeyen arkadaşının gerçekten ölmediği ve hâlâ \"hayatta\" olduğu söylenebilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360411,
						710360414,
						710360418
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360411,
					"content": "Önemli olan tek şey yaşamaktır.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360412
					]
				},
				{
					"id": 710360412,
					"content": "Ancak hatırlanmak... Erkenden ölsek bile hatırlanmak hayatımızın uzaması anlamına gelmez mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360413
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360413,
					"content": "Farklı bir şekilde yaşardık... Başkalarının anılarında, bize hayranlık duyulan anılarda.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360422,
					"content": "İnsanların ne düşündüğünü bu kadar önemseme.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360423
					]
				},
				{
					"id": 710360423,
					"content": "Bunu bana birçok kişi söyledi. \"Kendin ol,\" \"yalnızca işini yap\" ve daha nicesi... Bu gibi ifadeler yol gösteriyormuş gibi dursa da aslında bana pes etmemi söylüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360424
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360424,
					"content": "Galiba daha önce söylemiştim ancak ben, kendim dahil kimse için maceraya çıkmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360425
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360425,
					"content": "Hımm, bunun hakkında daha önce düşünmüş müydün?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360426
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360426,
					"content": "Tanrılar bu dünyayı meydana getirdi ve bizim gibi sıradan ölümlüleri umursamadı. Yine de biz bu dünyadan sessizce ayrılmak ve hiçbir şey olmamış gibi unutulmak istemiyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360427
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360427,
					"content": "Bu tatminsizliğin anlamsız olmadığını düşündüğüm için tehlikeli bölgeleri keşfe çıkıyorum. Demek istiyorum ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360428
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360428,
					"content": "Demek istiyorum ki bizi \"insan\" yapan... şu dayanıksız bedenlerimizle tanrıların bile korktuğu şeylerle mücadele etmemiz değil mi? Ben böyle düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360429,
						710360432
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360429,
					"content": "Yine de bir maceraya anlam biçme hakkına sahip tek kişi sen değilsin.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360430
					]
				},
				{
					"id": 710360430,
					"content": "Biliyorum... İnsanların yardımlarını unutmayacağım... Sana yaşattığım sıkıntıları da. Sonuçta bu macerayı tek başıma gerçekleştirmedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360437,
					"content": "Maceracılar öyle değil midir zaten?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360432,
					"content": "Yeniden kahraman olmaya mı soyundun?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360433
					]
				},
				{
					"id": 710360433,
					"content": "Heh, sana yetişmek için hâlâ kırk fırın ekmek yemem gerekiyor... Kendimi \"kahraman\" olarak değil de \"gerçekten yaşayabilmek için ölmekten korkmayan biri\" olarak tanımlayabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360434
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360434,
					"content": "Bunu bana Sumerulu bir ihtiyar söylemişti. O da bunu bizzat Münzevilerden duymuş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360435
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360435,
					"content": "Mantıklı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360436
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360436,
					"content": "Paimon ise senin daha çok \"talihsiz olayların peşinde koşan biri\" olduğunu düşünüyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360437
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 710360414,
					"content": "Sanırım hatırlanmak da bir tür başarı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360415
					]
				},
				{
					"id": 710360415,
					"content": "Yani... Daha önce \"başarılı\" bir hayat sürmeyi hiç düşünmedim. Aksine \"başarısız\" olsam bile insanlarda bir izlenim bırakmak istedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360416
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360416,
					"content": "Böylece en azından \"Zhiqiong da bir zamanlar Kanyon'un mücadeleleriyle yüzleşti!\" derlerdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360417
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360417,
					"content": "İşte o zaman kendilerini kuş uçmaz kervan geçmez yerlerde feda edenler gibi veya... Bildiğin üzere şu anki halim gibi unutulmazdım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360418,
					"content": "Daha önce bu konuda hiç düşünmemiştim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360419
					]
				},
				{
					"id": 710360419,
					"content": "Gerçekten mi? Sanırım senin gibi bir yabancı gittiği her yerde ister istemez odak noktası olduğu için bu konuda düşünmemiş olabilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360420
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360420,
					"content": "Bence bu durum ağzında gümüş kaşıkla dünyaya gelen çocukların yoksulluğu heyecan verici ancak nihayetinde gereksiz bir macera gibi görmesine benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360421
					],
					"speakerTitle": "Zhiqiong"
				},
				{
					"id": 710360421,
					"content": "Ah, özür dilerim... Öyle demek istememiştim. Demek istiyorum ki... Boş ver. Bir şey demediğimi varsay.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360422
					],
					"speakerTitle": "Zhiqiong"
				}
			]
		},
		{
			"id": 7103802,
			"completionStepIds": [
				7103802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103802",
							"2"
						],
						"stepId": 7103802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"Jinwu",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710380201,
					"content": "Of, yine Zhiqiong... Şu işaretçileri almaya gitti ama henüz dönmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380202
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380202,
					"content": "Oraya buraya gitmek gibi saçma bir alışkanlığı olduğu için ona üç saat daha tanıdım... Ancak o zamandan beri en az beş altı saat oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380203
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380203,
					"content": "Onu bulmama yardım edebilir misin? Sana gerçekten saygı duyuyor, o yüzden daha iyi anlaşırsınız belki... Bir de benim nöbetimde birinin daha başının belaya girmesini istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710380204
					],
					"speakerTitle": "Jinwu"
				},
				{
					"id": 710380204,
