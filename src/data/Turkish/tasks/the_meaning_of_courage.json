			"dialogs": [
				{
					"id": 150310301,
					"content": "İşte budur! Bu çekirdek mükemmel görünüyor. Bakın! İçindeki Filojiston hâlâ etkin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310302
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310302,
					"content": "Bir bakalım... Of, çok sıcak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310303
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310303,
					"content": "Böyle birkaç parça daha bulursak tamamdır. Hadi yukarı bakalım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
