			},
			"dialogs": [
				{
					"id": 150310401,
					"content": "Hasılat sağlam görünüyor! Bir sürü Gören Göz ve gelinciğin ateş püskürtmek için kullandığı bir şey var!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310402,
					"content": "Bence orası zırhı! Filojiston ateşleyerek her yönden saldırabiliyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310403
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310403,
					"content": "Babam bana bunların yanardağda yaşayan yaratıklar olduğundan bahsetmişti. Onlara denk gelmeyi beklemiyordum!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310404
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310404,
					"content": "Bu zırhın Gören Gözlerden bile daha yüksek sıcaklıklar üretebileceğini düşünüyorum. Hehe, bu sefer mantarları iyice kavuralım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310405
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310405,
					"content": "Bu arada çok iyi savaştın.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310406
					]
				},
				{
					"id": 150310406,
					"content": "Evet... Savaşmayı sevmesem de bazen mecbur kalıyorum, bu yüzden savaş moduna girmenin birçok farklı yolunu bulmaya çalıştım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310407
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310407,
					"content": "Yaptığım şeylerden biri de çok sayıda kahraman hikayesi okumaktı mesela. En sevdiğim kahramanımdan bahsetmiştim daha önce, ismi Fietena.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310408
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310408,
					"content": "Fietena'nın en ikonik özelliği maskesiydi, bu yüzden onunkinin aynısından yaptım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310409
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310409,
					"content": "O nedenle, maskeyi ne zaman taksam kendimi Fietena'ya dönüşmüş gibi hissederim. Onun namına gölge düşürmemek için cesur olmak zorundayım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310410
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310410,
					"content": "Öte yandan... Bir tür dayanak gibi de. Yani onun gücünün arkasına saklanıyor gibi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310411
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310411,
					"content": "Gerçekten öyle mi düşünüyorsun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310412,
						150310413
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310412,
					"content": "Ama işine yarıyor, değil mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				},
				{
					"id": 150310414,
					"content": "Gerçekten mi? Ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310415
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310415,
					"content": "Bir gün... O maskeyi çıkarıp gerçeklerle bizzat yüzleşmek zorunda kalacakmış gibi hissediyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310416
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310416,
					"content": "Ancak bunu yapmayı erteledikçe maskeme daha da bağımlı hale geleceğim. O yüzden... Bunu yapabileceğimden emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310417,
						150310418
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310417,
					"content": "Fakat bu olayı araştırmak senin kararındı.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310419,
					"content": "Evet, o kararı verecek cesareti gösteren sendin. Maceracılık da tam olarak böyle bir şey! Dövüşmek sadece küçük bir kısmı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310420,
					"content": "Ha...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310421
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310421,
					"content": "Ayrıca Paimon harika bir iş çıkardığını düşünüyor! Acele etme, bu bir yarışma değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310422
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310422,
					"content": "Bana inandığınız için teşekkür ederim. Sizden çok şey öğrendim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310423
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310423,
					"content": "Öğrenmeye de devam edeceğim, ta ki sonunda gerçeklerle bizzat yüzleşene kadar!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310424
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310424,
					"content": "Bu motivasyon konuşmasından sonra iştahım iyice kabardı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310425
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310425,
					"content": "Yine mi acıktın? Paimon daha son yemeğini sindirmedi bile!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310426
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310426,
					"content": "Hadi kabileye dönelim. Bu sefer o mantarın onayını kazanacağız mutlaka!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310418,
					"content": "Maskenin değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310413,
					"content": "Utanılacak bir şey değil.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				}
			]
		}
	]
