				{
					"id": 150310202,
					"content": "Çekirdekleri çok sıcaktır. Belki de ihtiyacımız olan şey odur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310203
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310203,
					"content": "Herkes bize bu şekilde yardım eli uzattığına göre, kabile bir süredir yeşil mantarlardan şüpheleniyor olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310204,
					"content": "Evet ama siz olmasaydınız asla bu kadar ilerlemeyecektik. Yani o mantarı bir sürü insan denedi ve hiçbiri kafasının içinde konuşan sesler duymadı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310205
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310205,
					"content": "Haklısın... Yani araştırmak isteseydiniz bile nereden başlayacağınızı bilemezdiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310206
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310206,
					"content": "Evet, bu fırsatı uzun zamandır bekliyorduk! Ayrıca Bilge Efendinin kibirli tavrı kesinlikle kabilemin rekabetçi ruhunu harekete geçirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310207
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310207,
					"content": "Evet, buradaki herkes rekabeti seviyor gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310208
					]
				},
				{
					"id": 150310208,
					"content": "Gerçi sen genelde pek rekabetçi görünmüyorsun Varesa. İdman yapmak ve canavarlarla savaşmak dışında en azından...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310209,
					"content": "Evet, şey... Aslında dövüşmeyi ve rekabeti pek sevmem. Benim için önemli olan günlük, basit mutluluklar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310210
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310210,
					"content": "Ancak Koç Iansan'dan çok şey öğrendim. Mesela gücün bir hedef değil, bir araç olduğunu öğrenmem gibi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310211
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310211,
					"content": "Gücümüzü, ona ihtiyacımız olduğunda kullanmak için artırırız. Hiçlik istilasında olduğu gibi mesela. Önsezimde ustalaşmak için yaptığım antrenmanlar sayesinde canavarlara karşı koyabildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310212
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310212,
					"content": "Ne kadar korkarsam korkayım cesur olmalıyım çünkü insanlar bana güveniyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310213,
						150310214
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310213,
					"content": "Belli oluyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				},
				{
					"id": 150310215,
					"content": "Teşekkürler. Hâlâ üzerinde çalışıyorum. Umarım bir gün Leydi Fietena kadar cesur olabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310216
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310216,
					"content": "Pekala, aramaya devam edelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310214,
					"content": "İçinde bir güç var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				}
			]
		},
