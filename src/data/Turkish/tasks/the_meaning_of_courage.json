			"dialogs": [
				{
					"id": 150310101,
					"content": "Şef Acatl, Varesa'nın mantarlar hakkındaki raporunu dinlemek için kabiledekileri bir araya toplar.",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150310102
					]
				},
				{
					"id": 150310102,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310103
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310103,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310104
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310104,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310105
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310105,
					"content": "O an çok normal hissetmiştim ama şimdi tekrar duyunca biraz... Saçma geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310106,
					"content": "Bu sessizlik manidar...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310107
					]
				},
				{
					"id": 150310107,
					"content": "Bahçedeki mantarların bilinci mi varmış? Bu inanılmaz bir keşif!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310108
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310108,
					"content": "Kesinlikle. Bu araştırmayı yapmasaydınız kim bilir neler yaşanırdı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310109
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310109,
					"content": "Topladığınız bilgiler ve araştırmalarınız için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310110
					],
					"speakerTitle": "Xoctli"
				},
				{
					"id": 150310110,
					"content": "Oh, rahatladım... Keçileri kaçırdığımı düşüneceksiniz sanmıştım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310111
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310111,
					"content": "Hahaha, kulağa biraz gerçek dışı geliyor. Ne de olsa hiçbirimizin bir mantarla konuşmuşluğu yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310112
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310112,
					"content": "Ancak senin yalan söyleyeceğine inanmıyoruz Varesa. Ayrıca yeşil mantarların kökeni bizim için her zaman gizemini korumuştur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310113
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310113,
					"content": "Sayenizde artık kötü bir şeylerin döndüğünü biliyoruz. Bu yüzden biz de üzerimize düşeni yapacağız!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310114
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310114,
					"content": "Yardım edebileceğim bir şey olursa mutlaka bana haber verin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310115
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310115,
					"content": "Vay be. Hemencecik ikna oldular...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310116
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310116,
					"content": "Hepinize teşekkür ederim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310117
					]
				},
				{
					"id": 150310117,
					"content": "Mantarların yüksek ateşte pişmesi gerektiğini söylemiştin, değil mi? Hemen pişireyim. Çok uzun sürmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310118
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310118,
					"content": "Geldim, geldim. Bu sefer dökme demir kullandım, yeterince sıcak olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310119
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310119,
					"content": "Oh, harika kokuyor! Paimon'un birden karnı guruldamaya başladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310120,
					"content": "O halde yiyelim hadi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310121
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310121,
					"content": "Hımm...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310122
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310122,
					"content": "Bir dakika, bu onun sesi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310123
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310123,
					"content": "Hahaha, anlaşılan doğru yoldasınız fakat bu sıcaklık benim aradığım samimiyetin yakınından bile geçmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310124
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310124,
					"content": "Gerçekten de sıradan bir ocaktan çıkan ateşin Bilge Efendinin onayını kazanmak için yeterli olacağını mı düşündünüz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310125
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310125,
					"content": "İnsanlar beni hayal kırıklığına uğrattı. Bilmecelerimi ancak cevaplar size gümüş bir tepside sunulduğunda çözebiliyorsunuz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310126
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310126,
					"content": "Ancak ortada ipucu yoksa... Zekanın kırıntısı dahi görülmüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310127
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310127,
					"content": "Bu sefer beyninizi kullanmayı deneyin, hehehe...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310128
					],
					"speakerTitle": "Bifrons"
				},
				{
					"id": 150310128,
					"content": "N-Nasıl geçti? Sesini duydunuz mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310129
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310129,
					"content": "Of! Ne sinir bozucu bir mantar bu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310130
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310130,
					"content": "Mantarların Bilge Efendisi sıcaklığın hâlâ yeterince yüksek olmadığını söyledi. Her şeyde bir kusur buluyor!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310131,
						150310132
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310131,
					"content": "Yine de amacını anlamanın tek yolu...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				},
				{
					"id": 150310133,
					"content": "Yeterince sıcak değil ha... Sanırım daha güçlü bir ısı kaynağına ihtiyacımız var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310134
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310134,
					"content": "Duydunuz mu millet? Yoğun sıcaklık yayan eşyalar gerekiyor. Bulabildiğiniz her şeyi verin!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310135
					],
					"speakerTitle": "Acatl"
				},
				{
					"id": 150310135,
					"content": "Elimden geleni yaparım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310136
					],
					"speakerTitle": "Atolli"
				},
				{
					"id": 150310136,
					"content": "O iş bende!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310137
					],
					"speakerTitle": "Iansan"
				},
				{
					"id": 150310137,
					"content": "Biz de aramalıyız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310138
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310138,
					"content": "Evet. Bu bölgeyi çok iyi bilmiyoruz gerçi. Senin bir fikrin var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310139
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310139,
					"content": "Hımm... Somut bir şey yok ama şu yanardağın çevresini inceleyebiliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310140
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310140,
					"content": "Her türden şeyi püskürtüyor. Belki işimize yarar bir şey buluruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310141
					],
					"speakerTitle": "Varesa"
				},
				{
					"id": 150310141,
					"content": "Harika, hadi gidelim! Paimon aşırı sıcak bir şey bulup o aptal mantarın yüzüne fırlatacak!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 150310132,
					"content": "Onunla oynamaya devam etmek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310133
					]
				}
			]
		},
