				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170401,
					"content": "Evet, her gün bunları topluyoruz. Çöp, çöp ve biraz daha çöp... Belki de o cimri Goldman bunları yiyordur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170402
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170402,
					"content": "Yardımın için teşekkürler. Bu Goldman'dan aldığım avans, lütfen bunu kabul et.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170403
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170403,
					"content": "Ben bunu kabul edemem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170404
					]
				},
				{
					"id": 240170404,
					"content": "Ama almalısın. Bu senin çalışmanın karşılığı. Bu para benim değil artık. Eğer almazsan bu para kesesini suya atacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170405
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170405,
					"content": "Tamam, tamam...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170406
					]
				},
				{
					"id": 240170406,
					"content": "İşte bu! Eğer ileride bulunması gereken bir şeyin olursa bana gel. Ne olduğu fark etmez, ben senin için sapasağlam bulur getiririm!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170407
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170407,
					"content": "Ama şimdilik dalgıç giysimi onarmaya devam etmem gerekiyor. *iç çeker* Bu delik biraz fazla büyük değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2401705,
			"completionStepIds": [
				2401706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401706",
							"2"
						],
						"stepId": 2401706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170501,
					"content": "Bunlar... Tüm bu ıvır zıvırlar da ne? Goldman'ın kurtarmamızı istediği şeyler cidden bunlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170502
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170502,
					"content": "Yardımın için çok teşekkür ederim! İşte... Bu Morayı al ve lütfen bundan kimseye bahsetme.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170503
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170503,
					"content": "Eğer bunları satabilirsem kendime bir dalgıç giysisi alabilirim. Goldman'dan kiralamama gerek kalmaz artık!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170504,
						240170505
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170504,
					"content": "Ben bunu kabul edemem.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170506
					]
				},
				{
					"id": 240170506,
					"content": "Hayır, hayır! Bunu hak ettin. Verdiğin emeğin karşılığında bu hiçbir şey biliyorum ama elimde sadece bu kadar kaldı. Hatta bu gece gidip biraz içki almayı planlıyordum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170507
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170507,
					"content": "O yüzden lütfen al bunu. Ben de birkaç şeyi halledip sonra bunu... Gizlice nasıl satacağıma bakacağım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170505,
					"content": "Benden sır çıkmaz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170506
					]
				}
			]
		},
		{
			"id": 2401706,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401705",
							"2"
						],
						"stepId": 2401705,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401702",
							"2"
						],
						"stepId": 2401702,
						"stateName": "QUEST_STATE_UNFINISHED"
