			},
			"dialogs": [
				{
					"id": 240170101,
					"content": "Of... Cidden... Ne şanssızlık...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170102,
						240170103
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170102,
					"content": "Sen bir dalgıç mısın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170104
					]
				},
				{
					"id": 240170104,
					"content": "Evet. Zaten dalgıç giysim de üstümde, değil mi? Her neyse, yardıma mı ihtiyacın var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170105
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170105,
					"content": "Eğer öyleyse korkarım şans senden yana değil. Herhangi bir yere dalış yapmayacağım, en azından şimdilik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170106
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170106,
					"content": "Buradaki sular adeta dolambaçlı labirentler gibi. Hatta iyice dibe dalınca akıntılar daha da vahşileşiyor ve içindeki yosunlar ve çöpler adeta bacaklarıma dolanıp beni çekiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170107
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170107,
					"content": "Bir anlık dikkatsizliğime denk geldi ve bir metal parçası dalış giysimi delip sızdırmasına neden oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170108
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170108,
					"content": "Neyse ki kıyıdan çok uzakta değildim ama ona rağmen kıyıya varmak benim için bir ölüm kalım mücadelesine döndü. Giysim zarar görmüş olsa da şansıma bacağım iyi durumdaydı... Tıbbi müdahaleye verecek kadar Moram yok çünkü.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170109
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170109,
					"content": "Ancak Goldman'ın verdiği işi tamamlayamayacağım sanırım. Aslında o cimri adama benim ödeme yapmam bile gerekebilir. Ne şans ama.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170110,
						240170112
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170110,
					"content": "Sana bir şey olmadı ya önemli olan o.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170111
					]
				},
				{
					"id": 240170111,
					"content": "Çok rahatlattın sağ ol... Haklısın tabii. Sağlam vücudumdan başka bir şeyim yok zaten.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170116,
					"content": "*iç çeker* Yani sana pek yardımcı olamayacağım. Önce dalgıç giysime yama yapıp ardından Goldman'ın verdiği iş için suyun altındaki çöpleri aramaya devam etmem gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170117,
						240170118
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170117,
					"content": "Sana yardım edebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170119
					]
				},
				{
					"id": 240170119,
					"content": "Nezaketin için sağ ol ama dalmak öyle herkesin yapabileceği bir şey değil. Ayrıca sana ödeme yapabilecek kadar Moram yok.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170120,
						240170121
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170120,
					"content": "Nasıl dalış yapılacağını biliyorum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170122
					]
				},
				{
					"id": 240170122,
					"content": "*iç çeker* Tamam, tamam. Bu delik benim hemen onaramayacağım kadar büyük, o yüzden ancak senden yardım isteyebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170127
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170127,
					"content": "İyi bir kalbin var. Eminim herkes seni seviyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170123
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170123,
					"content": "O açgözlü yağ tulumu Goldman bizi hep en berbat işlere yollar. İstediği şeyler ya suların en derinliklerinde ya da toprağa gömülü haldedir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170128
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170128,
					"content": "Senin için bakman gereken yerleri tek tek işaretleyeyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170124
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170124,
					"content": "Tamamdır, ben birkaç yer işaretledim. Sana güveniyorum, tamam mı? Ah, bu dalış giysisinin böyle zarar gördüğüne inanamıyorum. Ne kadar Mora ayırmam gerekiyor buna?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170121,
					"content": "Merak etme, yapabilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170122
					]
				},
				{
					"id": 240170118,
					"content": "Ben o çöpleri toplamanda sana yardım edebilirim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170119
					]
				},
				{
					"id": 240170112,
					"content": "Goldman kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170113
					]
				},
				{
					"id": 240170113,
					"content": "O mu? Hıh, kendisi benim patronum. Benim gibi pek bir becerisi olmayan ama geçimini sağlamak için var gücüyle çalışacak kişileri işe alma konusunda uzmandır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170114
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170114,
					"content": "Tam bir Fonta beyinlidir, aynı zamanda çok katı ve cimridir! Çalışırken de o büyük ve kalın çalışma rehberine bağlı kalmamız konusunda ısrarcıdır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170125
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170125,
					"content": "Ayrıca çalışırken kullandığımız bu dalış giysileri bile onun \"kiraladığı\" şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170115
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170115,
					"content": "Eğer bu kuralları çiğnersek ya da dalgıç giysilerimize bir şey olursa bizim ona ödeme yapmamız gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170126
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170126,
					"content": "Diğer bir deyişle bir anlık dikkatsizliğim sonucu hem ona ödeme yapmam hem de beni işten kovmasın diye yalvarmam gerekecek! Peh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170116
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170103,
					"content": "Daha yeni mi daldın?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170104
					]
				}
			]
		},
		{
			"id": 2401702,
			"completionStepIds": [
				2401701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
