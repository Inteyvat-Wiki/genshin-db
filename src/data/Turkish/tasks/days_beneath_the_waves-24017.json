			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170601,
					"content": "Peh, o cimri haydut!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170602,
						240170608,
						240170612
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170602,
					"content": "Bana Goldman'dan tekrar bahseder misin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170603
					]
				},
				{
					"id": 240170603,
					"content": "Kendisi benim patronum. Benim gibi pek bir becerisi olmayan ama geçimini sağlamak için var gücüyle çalışacak kişileri işe alma konusunda gerçek bir uzmandır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170604
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170604,
					"content": "Tam bir Fonta beyinlidir, aynı zamanda çok katı ve cimridir! Çalışırken de o büyük ve kalın çalışma rehberine bağlı kalmamız konusunda ısrarcıdır...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170614
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170614,
					"content": "Ayrıca çalışırken kullandığımız bu dalış giysileri bile onun \"kiraladığı\" şeyler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170605
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170605,
					"content": "Eğer bu kuralları çiğnersek ya da dalgıç giysilerimize bir şey olursa bizim ona ödeme yapmamız gerekiyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170615
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170615,
					"content": "Diğer bir deyişle bir anlık dikkatsizliğim sonucu hem ona ödeme yapmam hem de beni işten kovmasın diye yalvarmam gerekecek! Peh!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170606
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170606,
					"content": "Neden onunla ilgili daha fazla şey bilmek istiyorsun? Sana yalvarırım ondan uzak dur. Kendi iyiliğin için!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170616
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170616,
					"content": "O utanmaz bir adam ve etrafını da kendisi gibi insanlarla dolduruyor. Hepsi kötüler.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170607
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170607,
					"content": "Onunla arkadaşlık yapma sakın, ondan bulaşan pisliği bir ton suyla yıkasan da temizleyemezsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170617
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170617,
					"content": "Temiz bir suyu birazcık çamurla kirletmek çok kolaydır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170608,
					"content": "Gerçekten çok çalışıyorsun...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170609
					]
				},
				{
					"id": 240170609,
					"content": "Hah, değil mi? Ama geçimimi sağlamak için bundan başka çarem yok. Zeki değilim, başka bir yeteneğim de yok ama kötü şeyler yapmak da istemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170618
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170618,
					"content": "Karnımı doyurmak için kötülük yapacağıma aç kalırım daha iyi!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170610
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170610,
					"content": "Evet yüküm ağır ama en azından gece başımı yastığa huzurla koyabiliyorum. Birinin benden nefret etmesinden ya da ben uyurken beni öldürmeye çalışmasından endişe etmek zorunda kalmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170611
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170611,
					"content": "Böyle düşündüğün zaman Goldman'ınkinden çok daha iyi bir hayatım var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170612,
					"content": "Hoşça kal.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170613
					]
				},
				{
					"id": 240170613,
					"content": "Pekala, o zaman bu arama işini sana bırakıyorum. Ben de dalgıç giysimi onarmaya devam edeceğim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				}
			]
		},
		{
			"id": 2401707,
			"completionStepIds": [
				2401701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
