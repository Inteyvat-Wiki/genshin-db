			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Yves"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240170201,
					"content": "Şu açgözlü haydut...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170203
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170203,
					"content": "Dalgıç giysine ne oldu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170204
					]
				},
				{
					"id": 240170204,
					"content": "Ah, sen miydin? Seni görmek bugün yaşadığım en güzel şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170205
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170205,
					"content": "Eminim Goldman'ın bizim için hazırladığı yeni işkenceden haberin yoktur...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170206
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170206,
					"content": "Her birimizin günde kaç eşya toplayabildiğini sayması için hesaplamada iyi olan birini işe aldı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170222
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170222,
					"content": "Sonra bu hesaplamalara bakıp bizi daha fazla şey tutmaya zorladı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170207
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170207,
					"content": "Ama yeri gelir yorulur acıkırız, yeri gelir yaralanırız, bazen hiç gücümüz kalmaz. Yani her seferinde o kadar çok şey tutamayız. Peki bu Goldman'ın umurunda mı? Tabii hayır!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170223
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170223,
					"content": "Eğer günlük hedefi tutturamazsak bizi azarlıyor, hatta ödememizden kesiyordu!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170208
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170208,
					"content": "Ama hesap tutan kişinin hiçbir suçu yok. Adı Finnegan, kendisi çok sempatik biri.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170209
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170209,
					"content": "Hesaplamalarını yaparken günlük yaptığımız işlerle ilgili bize danışmayı da ihmal etmiyordu. Bir gün söyleyeceklerimizi dinleyip işini bitirdikten sonra...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170224
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170224,
					"content": "Sonra bir anda ayağa kalkıp Goldman'ın evine doğru koştu ve o hayduta bağırmaya başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170210
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170210,
					"content": "\"... Bu hiç mantıklı değil. Onlar makina değil, birer insan!\" Dediğini duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170211
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170211,
					"content": "... Goldman'ın adamları onu dışarı attılar ve bir su birikintisine düştü. Kalkıp çıkması için yardım etmemiz gerekti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170212
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170212,
					"content": "Sonra adam bizden özür diledi, hatta gözyaşı döktü. Ancak hiçbirimiz onu suçlayamayız, sonuçta o da bizim gibi Goldman'ın kurbanlarından biriydi sadece.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170213
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170213,
					"content": "Bizim adaleti bulmamıza yardımcı olacağına dair bize söz verdi... Ama cidden hepimiz sadece onun tekrar çöplüğe dönmemesini umuyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170214,
						240170215
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170214,
					"content": "Bugün daha ne kadar çalışman gerekiyor?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170216
					]
				},
				{
					"id": 240170216,
					"content": "Korkarım daha tonla işim var. Ne zaman bitireceğimi de bilemiyorum. Sadece elimden geldiği kadarını halletmeye çalışacağım, umarım çok fazla Moram kesilmez... Bana dalgıç giysisi ödünç verecek birini bulup çalışmaya dönmem lazım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170217,
						240170218
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170217,
					"content": "Sana yardım edeyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170219
					]
				},
				{
					"id": 240170219,
					"content": "Gerçekten mi? Yine de bana yardım eder misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170220
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170220,
					"content": "Sen... Gerçekten benim kurtarıcımsın. Keşke Goldman en azından senin yarın kadar iyi kalpli olabilse! ... Ah, hayır özür dilerim, o hödüğü seninle kıyaslamamam gerekirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240170221
					],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170221,
					"content": "Önceki gibi ben eşyaların yerini işaretleyeceğim, sonra da ayrılıp arayacağız. *iç çeker* Ödünç aldığım bu dalgıç giysisi de zarar görürse yandım bittim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Yves"
				},
				{
					"id": 240170218,
					"content": "Yükünü hafifleteyim.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170219
					]
				},
				{
					"id": 240170215,
					"content": "Bugün için daha ne kadar işin kaldı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240170216
					]
				}
			]
		},
		{
