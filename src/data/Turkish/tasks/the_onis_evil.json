			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Ogura Mio",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090201,
					"content": "Arataki Itto mu? Evet, olanları duydum. Tenryou Heyetinin yanıldığına eminim. Arataki Itto öyle biri değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090202
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090202,
					"content": "Nasıl bu kadar emin olabiliyorsun? Ona güveniyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090203
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090203,
					"content": "Hayır, beni yanlış anladınız. Öyle biri değil derken... Bu tarz işleri yapabilecek nitelikte olmadığını söylemek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090204,
						120090205
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090204,
					"content": "Yeterince güçlü mü değil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090206
					]
				},
				{
					"id": 120090206,
					"content": "Bir örnekle anlatsam daha iyi anlaşılır sanırım. Eskiden vaktinin çoğunu sokaktaki çocuklarla taş-kağıt-makas ve saklambaç oynayarak geçirirdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090207
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090207,
					"content": "Çocukları yenmek o kadar da zor değildir. Bilirsiniz, çocuk sonuçta. Fakat o her zaman kaybederdi. Hem de bazen fena kaybederdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090208
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090208,
					"content": "Bilerek kaybediyordur herhalde, değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090209
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090209,
					"content": "Hayır, tam tersi. Günün birinde bir oyunu kazandı ve sevinçten havalara uçtu. \"Ben kazandım! Sonunda kazandım! Ben yenilmezim!\" diye bağırıp duruyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090210
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090210,
					"content": "Sonra ödül olarak çocuğun elinden şekerini aldı ve gözünün önünde yemeye başladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090211
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090211,
					"content": "Ah, bu çok yanlış!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090212,
					"content": "Çok ileri gitmişti. Zavallı çocuk ağlamaya başlayınca dayanamayıp Itto'yu bir güzel azarladım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090213
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090213,
					"content": "Haksız olduğunu hemen kabul etti. Çocuk da ağlamayı bıraktı ve sanki hiçbir şey yaşanmamış gibi oynamaya devam etti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090214
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090214,
					"content": "Aslında çocuklar onunla birlikte oynamaktan zevk alıyor çünkü oyunu her zaman ciddiye alır ve hiçbir zaman bilerek kaybetmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090215
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090215,
					"content": "Yani demeye çalıştığım şey... Çocuk oyununda bile kaybeden biri bu denli şeytani işler yapabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090216,
						120090217
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090216,
					"content": "Sanırım ne demek istediğini anladım.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090218
					]
				},
				{
					"id": 120090218,
					"content": "Aslında kötü biri değil sanki. Hatta bana dürüst biri gibi geldi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090219
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090219,
					"content": "Evet, tamamen aynı fikirdeyim. Ancak Tenryou Heyetinin elindeki deliller doğru olsa gerek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090220
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090220,
					"content": "Yaptıklarını onayladığımı söylemiyorum elbette. Bu denli büyük bir hata yaptıysa diğer herkes gibi sonuçlarına katlanmalıdır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090221
					],
					"speakerTitle": "Ogura Mio"
				},
				{
					"id": 120090221,
					"content": "Verdiğin bilgiler için teşekkürler! Biz soruşturmaya devam edeceğiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090217,
					"content": "Böyle bir şey duymayı hiç beklemiyordum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090218
					]
				},
				{
					"id": 120090205,
					"content": "Yeterince zeki mi değil?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090206
					]
				}
			]
		},
		{
			"id": 1200903,
			"completionStepIds": [
				1200903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200903",
							"2"
						],
						"stepId": 1200903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Furuya Noboru",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090301,
					"content": "Arataki Itto mu? Evet duymuştum. Epey salakça bir şey yapmış ama kaçmayı başarmış diye duydum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090302
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090302,
					"content": "Ne yalan söyleyeyim, duyunca biraz şaşırdım ama O KADAR da şaşırmadım yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090303
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090303,
					"content": "Ne yani, daha önce de böyle şeyler yapmış mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090304
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090304,
					"content": "Yok, tam olarak öyle değil. *öksürür* O biraz... Zorba bir tiptir. Olay çıkartıp durur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090305
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090305,
					"content": "Bir yandan hayat doludur ama öte yandan duygusal olarak dengesizdir. Keyfi yerindeyse ondan mutlusu yoktur fakat keyfi kaçarsa öfkeden kudurur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090306
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090306,
					"content": "Bence kötü biri değil ama öfkelenip kontrolünü kaybetmesine de şaşırmam yani.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090307,
						120090308
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090307,
					"content": "Genelde neler yapar?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090309
					]
				},
				{
					"id": 120090309,
					"content": "Hımm, maalesef emin değilim. *öksürür* Bu şehirde neler olup bittiğini bilirim ve gördüğüm kadarıyla o sadece aylak aylak dolaşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090310
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090310,
					"content": "Biri isterse yardım eder yoksa ya çocuklarla vakit geçirir ya da çetesiyle.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090311
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090311,
					"content": "*iç çeker* Sanırım geçimini sağlamak için kötü bir işe kalkıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090312
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090312,
					"content": "Paimon yanılıyor mu yoksa Itto adlı bu arkadaş tuhaf biri mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090313
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090313,
					"content": "Söyleyebileceğim çok şey yok ne yazık ki. Genelde benden daha hayat dolu insanlarla vakit geçirir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090314
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090314,
					"content": "Etraftaki insanlara da sorun isterseniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090315
					],
					"speakerTitle": "Furuya Noboru"
				},
				{
					"id": 120090315,
					"content": "Peki, teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090308,
					"content": "Sabit bir işte falan çalışıyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090309
					]
				}
			]
		},
		{
			"id": 1200904,
			"completionStepIds": [
				1200904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200904",
							"2"
						],
						"stepId": 1200904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Uesugi",
					"Paimon"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090401,
					"content": "Arataki Itto mu? Tabii ki tanıyorum. Son zamanlarda onun peşindeydik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090402
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090402,
					"content": "Inazuma Şehri'nden gittiğini biliyoruz ama onu takip edebileceğimiz hiçbir ipucu bırakmadığı için başkalarından yardım istemekten başka seçeneğimiz yok. Buna Maceracılar Loncası da dahil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090403
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090403,
					"content": "Katheryne'in dediğine göre Arataki Itto daha önce çok kötü bir şey yapmamış. Oldukça enteresan.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090404
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090404,
					"content": "Paimon bu suçlamaları kanıtlayacak herhangi bir delil var mı diye merak ediyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090405
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090405,
					"content": "Evet, tabii ki. Yoksa bu kadar insanı boşuna uğraştırmazdık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090406
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090406,
					"content": "Çoğu hırsız kimliğini gizlemenin bir yolunu arar fakat bahsettiğimiz kişi bir Oni. O boynuzları saklamak imkansız. Herhangi bir durumda hemen tanınır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090407
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090407,
					"content": "Başka bir Oni olmadığı ne malum?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090408
					]
				},
				{
					"id": 120090408,
					"content": "İlk başta şüphelilerden sadece biriydi fakat soruşturmaya gittiğimizde bizzat her şeyi itiraf etti ve görevlileri kışkırtmaya çalıştı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090409
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090409,
					"content": "İşin kötüsü, çetesiyle birlikte kaçmayı başardı. Başından beri her şeyi planlamış olmalı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090410
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090410,
					"content": "Bunları yapmasının bir sebebi var mı sence?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090411
					]
				},
				{
					"id": 120090411,
					"content": "Tabii ki var. Hem maddi hem manevi nedenlere dair bir sürü kanıt var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090412
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090412,
					"content": "Hayatı boyunca ne bir Mora kazandı ne de bir iş sahibi oldu. Söylenenlere göre bir de çete üyelerinden birine bakıyormuş ve bu yük ona fazla gelmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090413
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090413,
					"content": "Bunca yıldır geçimini sağlamaya çalışmaktan bunalıp kötü biri olarak hayatına devam etmeyi bir çözüm olarak görmüştür belki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090414
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090414,
					"content": "Manevi nedenlere gelirsek, biraz utanç verici bir konu ama şey... Önsezi Avı Fermanı sırasında onun Önsezisine el koyduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090415
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090415,
					"content": "Tenryou Heyetinden intikam alıyordu yani.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090416
					]
				},
				{
					"id": 120090416,
					"content": "O zaman Arataki Itto epey direnmişti. Çok sayıda insan ve kaynak kullandık ama yetmedi. En sonunda Önsezisini güvence altına almak için Kujou Sara'dan yardım istemek zorunda kaldık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090417
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090417,
					"content": "Önsezi Avı bir hataydı ama bizden intikam almak için bu kadar ileri gitmesini hiç beklemezdik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090418
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090418,
					"content": "İnsanların dediği gibi biraz dengesiz birine benziyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090419,
						120090420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090419,
					"content": "Kendince geçerli sebepleri de var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090421
					]
				},
				{
					"id": 120090421,
					"content": "Olur da Arataki Itto'yu yakalarsanız lütfen doğruca buraya getirin. Gerisini biz hallederiz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090422
					],
					"speakerTitle": "Uesugi"
				},
				{
					"id": 120090422,
					"content": "Verdiğin bilgiler için teşekkürler!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090420,
					"content": "Kanıtlar sağlam.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090421
					]
				}
			]
		},
		{
			"id": 1200905,
			"completionStepIds": [
				1200905
			],
