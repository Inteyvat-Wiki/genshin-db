			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Katheryne"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090101,
					"content": "Merhaba Katheryne, biz geldik! Yardım edebileceğimiz bir şey var mıydı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090102,
					"content": "Evet, bir konuda daha yardımınıza ihtiyacım var. Geçtiğimiz günlerde Tenryou Heyeti Maceracılar Loncasına bir görev verdi. Bu görev hem acil hem de tehlikeli.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090103,
					"content": "Lonca bu görevi değerlendirdikten sonra deneyimli maceracıların yardımına ihtiyacı olduğuna karar verdi. Doğal olarak da aklımıza ilk siz geldiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090104
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090104,
					"content": "Hehe, iş üstünde bir gün daha.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090105,
						120090106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090105,
					"content": "Tehlikeli mi demiştin?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090107
					]
				},
				{
					"id": 120090107,
					"content": "Şöyle ki, Tenryou Heyeti geçtiğimiz günlerde Arataki Itto isimli genç bir Oni için tutuklama emri çıkardı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090108
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090108,
					"content": "Oni mi dedin? Şu boynuzları olan iri yarı, sert görünümlü olanlar mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090109,
					"content": "Evet onlar. Bahsettiğimiz Oni, lafını esirgemeyen korkusuz biri. Haliyle sokaklarda da tanınıyor. Fakat hiç büyük bir suç işlememişti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090110,
					"content": "O nedenle hırsızlık ve insan kaçırmayla suçlandığını öğrenmek şaşırtıcı oldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090111
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090111,
					"content": "Bununla da kalmadı, kendisini yakalamak için gelen Tenryou Heyeti Doushinlerine saldırıp suç ortaklarıyla birlikte ortadan kayboldu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090112
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090112,
					"content": "Çok belalı bir tipmiş.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090113
					]
				},
				{
					"id": 120090113,
					"content": "Paimon'un tahminine göre bu Oni'yi yakalamak bize düştü!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090114,
					"content": "Sorun değil, tam Gezginin dişine göre bir görev. Göz açıp kapayıncaya kadar Oni'yi geri getirir!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090115
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090115,
					"content": "Bu işi başaracağınızdan şüphem yok fakat lütfen dikkatli olun. Bu oni aynı zamanda Arataki Çetesi olarak bilinen organizasyonun lideri ve bir Önsezi de taşıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090116,
						120090118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090116,
					"content": "Çetelerle kavga etme konusunda pek deneyimli değilim...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090117
					]
				},
				{
					"id": 120090117,
					"content": "Hımm, haklısın... Bizi neyin beklediğini bilmiyoruz. Dikkat etsek iyi olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090120,
					"content": "Arataki Itto'nun yerini ve bu suçları işleme nedenini hâlâ araştırıyoruz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090121
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090121,
					"content": "Ancak siz yine de sokaklarda soruşturun. Itto'yla ilgili benden daha fazla bilgiye sahip biriyle karşılaşırsınız belki. İşinize yarayacak bilgiler edinebilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090122
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090122,
					"content": "Tamam. İnsanlarla konuşuruz.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090123
					]
				},
				{
					"id": 120090123,
					"content": "Teşekkürler. Sizi bekleyeceğim. Yıldızlar ve hiçlik yoldaşınız olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 120090118,
					"content": "Onun çetesi varsa benim de Paimon'um var.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090119
					]
				},
				{
					"id": 120090119,
					"content": "Hehe, düşündüm de Paimon dövüşme kısmına karışmayacak. Paimon'un isteyeceği son şey bir çeteyle dövüşmek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090106,
					"content": "Tenryou Heyeti bu olayı kendi halledemiyor mu?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090107
					]
				}
			]
		},
		{
			"id": 1200902,
			"completionStepIds": [
				1200902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
