			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Paimon",
					"Sango"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090501,
					"content": "Merhaba, Arataki Itto hakkında birkaç soru sormak istiyorduk.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090502
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090502,
					"content": "Yine mi o... Tabii ki, cevaplarım. Tenryou Heyeti için biraz araştırma yaptık zaten. Ancak başlamadan... Yeterli Moranız var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090503
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090503,
					"content": "Yaptığınız seyahatlerden haberdarım. Yaşadığınız onca şeyden sonra işlerin nasıl yürüdüğünü anlamışsınızdır herhalde.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090504
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090504,
					"content": "Şey... Kaç Moradan bahsediyoruz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090505
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090505,
					"content": "Önden 397.000 Moralık bir ödeme alıyorum buna ek olarak Arataki Itto'nun yakalanıp adalete teslim edilmesi durumunda Maceracılar Loncasından alacağınız ücretin %5'ini de isterim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090506
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090506,
					"content": "Yuh, bu aşırı pahalı! Nasıl bu kadar yüksek bir ücret istersin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090507
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090507,
					"content": "Hehe, dur da lafımı bitireyim. İlk ödeme zaten Tenryou Heyeti tarafından yapıldı. Size düşen sadece ufak bir danışmanlık ücreti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090508
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090508,
					"content": "Onun miktarını da Itto'yu yakaladığımızda Maceracılar Loncasıyla hallederim. Bence bu sizin için gayet iyi bir anlaşma.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090509
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090509,
					"content": "Pekala, buradaki durumu iyice kavramanız için ünlü bir Inazuma masalını yeniden anlatmakla işe başlamalıyız...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090510
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090510,
					"content": "Nasıl yani? Bu kadar mı? Küçük mavi Oni'ye ne oldu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090511
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090511,
					"content": "Sanırım mavi Oni bir daha geri gelmemek üzere ortadan kayboldu. Artık yalnızca kızıl Oni var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090512
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090512,
					"content": "*ağlar* A-Ama... Mavi Oni masum bir çocuktu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090513
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090513,
					"content": "Bu hikayenin konumuzla bir ilgisi var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090514
					]
				},
				{
					"id": 120090514,
					"content": "Tabii ki var! Olmasaydı anlatmazdım. Bunu hikayenin büyük ölçüde tarihsel olaylara dayandığı ve Arataki Itto'nun aslında kızıl Oni'nin soyundan geldiği yönünde yorumlayabilirsiniz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090515
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090515,
					"content": "Onilerin zamanında insanlarla kaynaşmak için birçok fedakarlık yaptığını fakat soylarında hâlâ dengesiz kişilik özellikleri bulunduğunu anlatmaya çalışıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090516
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090516,
					"content": "Her Oni nesli bu özellikleri taşır. Peki, Arataki Itto'nun daha önce yanlış bir şey yapmaması kötü tarafının onu ele geçirme olasılığını ortadan kaldırır mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090517
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090517,
					"content": "Ama... Nasıl böyle bir şey yapabilir? Mavi Oni'nin fedakarlığından sonra bu ihanet anlamına gelir...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090518
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090518,
					"content": "Bu çok eski bir hikaye. Mavi Oni'nin ne zaman ortadan kaybolduğunu kimse bilmiyor. Sadece uzun zaman önce soyunun tükendiğini varsayabiliriz. Bu durumda yapılan şeyi hâlâ ihanet olarak görmek biraz abartı olur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090519
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090519,
					"content": "Ayrıca şüpheli zaten her şeyi itiraf etti. Ne diye tartışıyoruz daha?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090520
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090520,
					"content": "Araştırmalarıma göre güneybatıya doğru gitti. Çoktan <color=#00E1FFFF>Yashiori Adası'na</color> varmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090521
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090521,
					"content": "Tenryou Heyetinin Sangonomiya askerlerinin kontrolündeki bölgeye girme izni yok. Arataki Itto kesin o tarafa doğru kaçmıştır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090522
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090522,
					"content": "Anlıyorum. Verdiğin bilgiler için teşekkürler!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090523
					]
				},
				{
					"id": 120090523,
					"content": "Ne demek. Yalnızca görevimi yapıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090524
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090524,
					"content": "Bekle, Paimon'un bir sorusu daha var. Kötü tarafı Arataki Itto'yu ele geçirdiyse o artık çok kaba ve vahşi biri haline mi geldi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090525
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090525,
					"content": "Öyle olduğunu düşünüyorum. Önceki karşılaşmalarına bakacak olursak çok güçlü ve yetenekli bir dövüşçü. Onunla başa çıkabileceğinizden emin değilim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090526
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090526,
					"content": "Peki, insanlar neden Oni'ye fasulye fırlatıyordu? Ne alakası var?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090527
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090527,
					"content": "Şimdi sen söyleyince hatırladım. Arataki Itto'nun fasulyeye alerjisi var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090528
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090528,
					"content": "Aslında hiçbir Oni fasulyeyi sevmez ama Itto hiç sevmez. Duyduğuma göre temas etmesi bile elden ayaktan kesilmesi için yeterliymiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090529
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090529,
					"content": "Alerjisini tetikleyerek onu biraz da olsa zayıflatmayı başarabilirseniz etkisiz hale getirme şansınız artar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090530,
						120090532
					],
					"speakerTitle": "Sango"
				},
				{
					"id": 120090530,
					"content": "Tek seçeneğimiz bu gibi görünüyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090531
					]
				},
				{
					"id": 120090531,
					"content": "Evet, hedefimizin zayıf noktasını bilmek işimizi oldukça kolaylaştırır.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090534
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 120090534,
					"content": "Şansınıza yanımda bir torba fasulye var. Lapa yapmak için kullanacaktım ama sizin daha çok ihtiyacınız var sanırım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
