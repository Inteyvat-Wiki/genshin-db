			"dialogs": [
				{
					"id": 706660201,
					"content": "Miyav! (Harika! Yükseltme Mücadelesini tamamladığın için tebrikler. Artık Gelişmiş bir oyuncusun!)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660202
					],
					"speakerTitle": "Prens"
				},
				{
					"id": 706660202,
					"content": "Miyav? (Gelişmiş bir oyuncu olmak için sadece bir mücadele yeterli mi? Çoğu insan bunu sadece eğlenmek için oynadığından çok da ciddiye almıyor...)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660203
					],
					"speakerTitle": "Prens"
				},
				{
					"id": 706660203,
					"content": "(Başka bir deyişle, sadece çok az sayıda kişi bu oyunu ciddiye alıyor. Ancak sadece eğlenmek için olsa bile bu ciddiye almaya değer bir şey.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660204
					],
					"speakerTitle": "Prens"
				},
				{
					"id": 706660204,
					"content": "Miyav! (Ah, evet! Artık seni tanıdığıma göre handa diğerlerine de meydan okuyabilirsin. Hımm... Seni kesin severler.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660205
					],
					"speakerTitle": "Prens"
				},
				{
					"id": 706660205,
					"content": "Diğerleri?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660206
					]
				},
				{
					"id": 706660206,
					"content": "Miyav. (Doğru duydun. Tabii onlar da benim gibiler. Handaki diğer kedilerden bahsediyorum. Ama sakın onları hafife alma.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660207
					],
					"speakerTitle": "Prens"
				},
				{
					"id": 706660207,
