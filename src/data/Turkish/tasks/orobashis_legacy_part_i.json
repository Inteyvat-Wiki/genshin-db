			"dialogs": [
				{
					"id": 721290401,
					"content": "Fena değil yabancı! Bulutların hepsi gitmiş neredeyse. Tahminim doğru çıktı galiba.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290402
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290402,
					"content": "Sırada Yılan Başı ve Jakotsu Madeni'ndeki iki Tılsım var tamir edilmesi gereken.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290403
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290403,
					"content": "Senin için bir sakıncası yoksa onları da sana bırakıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290404
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290404,
					"content": "Tabii!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721290405
					]
				},
				{
					"id": 721290405,
					"content": "Yardımların için çok teşekkür ederim. Zengin bir adam değilim ama sana hak ettiğinin ödeneceğine söz verebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290406
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290406,
					"content": "Ne zaman olacağını hâlâ bilmiyorum ama arkadaşlarıma ve aileme yakında kavuşacağım galiba...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290407
					],
					"speakerTitle": "Kaji"
				},
				{
					"id": 721290407,
					"content": "Bu arada, işin bitince beni adanın batısında bulabilirsin. Mumei Kalesi daha önce asilerin saldırısına uğradı ve saldırının bu değişiklerle bir alakası olduğunu düşünüyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Kaji"
				}
			]
		},
