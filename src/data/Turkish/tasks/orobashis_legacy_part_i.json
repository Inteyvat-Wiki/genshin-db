					"speakerTitle": "Tılsıma Dokun"
				},
				{
					"id": 721290202,
					"content": "Sana direnmediğini ve bir şey istediğini fark ediyorsun...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290203
					],
					"speakerTitle": "Tılsıma Dokun"
				},
				{
					"id": 721290203,
					"content": "Bu tılsımın bir eksiği var gibi. En iyisi etrafta eksik parçaları aramak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290204
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290204,
					"content": "Yakınlarda dağılmış elementlerin izlerini taramak için Element Görüşünü kullan. Belki bir şeyler bulursun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
