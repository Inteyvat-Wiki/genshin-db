			},
			"dialogs": [
				{
					"id": 721290101,
					"content": "Bu garip şekilli taş fenerden uğursuz bir enerji yayılıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290102
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721290102,
					"content": "Bu taş fener çok tuhaf... Tüylerim ürperdi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290103,
					"content": "O fenerin üzerinde ne yazıyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 721290104,
					"content": "\"Yolu buraya düşen gezginler: Bu tılsımla alakalı herhangi bir sorunuz varsa lütfen Musoujin Geçidi'ne gidip Bay Kaji ile konuşun.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290105
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721290105,
					"content": "Yeni yazılmış gibi ve altında yağmur yüzünden silinmeye başlamış küçük bir yazı daha var:",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290106
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721290106,
					"content": "\"Lütfen Bay Kaji'ye denediğimizi söyleyin... Ama ne yazık ki... Belki yakında bir yerlerde bulabilir...\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290107
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721290107,
					"content": "\"Lütfen Bay Kaji'ye en kısa zamanda sığınağa gelmesini söyleyin. Ailesi onu çok özlüyor.\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721290108
					],
					"speakerTitle": "İncele"
				},
				{
					"id": 721290108,
					"content": "Bu Bay Kaji bu taş fenerlere kafayı takmış galiba. Musoujin Geçidi'ne gidip soralım mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7212902,
