			"dialogs": [
				{
					"id": 706760101,
					"content": "Böyle bir yerin kütüphanede ne işi var? Lisa'nın bahsettiği Özel Bölüm burası olabilir mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760102,
					"content": "Hımm, pek benzemiyor aslında...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760103
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760103,
					"content": "... Sana da burada çok gizemli bir şeyler dönüyor gibi gelmiyor mu? Korku hikayelerinde duyduğumuz o odalar gibi sanki ha? Genelde kimsenin girmesine izin verilmeyen odalar olur ya hani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760104
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760104,
					"content": "Öyle olsaydı kapısı kilitli olurdu ama.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760105
					]
				},
				{
					"id": 706760105,
					"content": "O da doğru... Biz resmen elimizi kolumuzu sallayarak girdik buraya, kapının kilidi de kırık falan değildi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760106
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760106,
					"content": "Hey, bir saniye! Biz bu kapıdan girmemiştik! Kütüphanede olduğumuza emin miyiz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760107,
						706760109
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760107,
					"content": "Berrak Göl'ün dibinde olabilir miyiz?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760108
					]
				},
				{
					"id": 706760108,
					"content": "Öyle mi dersin? Vay be. Bunca şeyi gölün dibine yapmaları ne kadar etkileyici... Hayır hayır, bu çok saçma! Orada olmamız imkansız.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760111,
					"content": "Hımm... Keşke Lisa bugün çalışıyor olsaydı, ona sorardık... Öyle veya böyle buradayız, neyse ki çok tehlikeli bir yere benzemiyor. Hadi gel, etrafa bir bakalım...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760112
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760112,
					"content": "Sonuçta yeni yerler keşfedilmek içindir! İyi ve deneyimli bir rehber olmak için her türlü yeni şeyi denemek gerekir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760113
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760113,
					"content": "Aa baksana, oyuncak bir pelüş kurt! Ne kadar da sevimli!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760114
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760114,
					"content": "Çok yumuşak ve pofuduk! Hımm, acaba bunu buraya kim bırakmış?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760115,
						706760117
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760115,
					"content": "Kim bilir, bu oyuncak belki de bu odanın gerçek sahibidir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760116
					]
				},
				{
					"id": 706760116,
					"content": "\"Raaarr! Seni aptal Gezgin! Bu kıyamet kalesine davetsiz girmeye nasıl cüret edersin? Şimdi seni çiğ çiğ yiyeceğim!\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760120,
					"content": "... Şimdilik burada bıraksak iyi olur. Burası kocaman bir yer, keşfe devam edelim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760117,
					"content": "Ya da bu gizemli odanın muhafızı olabilir.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760118
					]
				},
				{
					"id": 706760118,
					"content": "Hangi muhafız koltuğun üzerinde böyle horul horul uyur ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760119
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760119,
					"content": "\"*horlar* Görünürde bir tehlike yok... Görünmüyorsa bir şey olmamış demektir... *horlar*\"",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760120
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 706760109,
					"content": "Belki başka bir dünyaya ulaşmışızdır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706760110
					]
				},
				{
					"id": 706760110,
					"content": "Başka bir dünya derken, nasıl bir dünya yani?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706760111
					],
					"speakerTitle": "Paimon"
				}
			]
		}
	]
}