			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Diluc"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970201,
					"content": "Hiçlik Tarikatı... İnsan ırkının düşmanları. Yeraltı ağlarında bile onlarla ilgili bilgilere çok nadiren rastlanıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970202
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970202,
					"content": "Bununla birlikte, biraz zor oldu ama birkaç ipucu bulmayı başardım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970203
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970203,
					"content": "Gerçekten mi? Bu kadar çabuk mu? Çevreniz gerçekten çok geniş Usta Diluc.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970204
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970204,
					"content": "Büyük Rüzgar Tanrısı Barbatos Hazretleri, önemsiz insanların yardımını isteme nedenin tam olarak nedir?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970205
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970205,
					"content": "Ahh... Nasıl desem?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970206
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970206,
					"content": "Şimdi \"Yediler\" olarak bilinen bu kişiler, bir zamanlar \"Yedi Hükümdarlar\" olarak biliniyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970207
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970207,
					"content": "Her hükümdar Teyvat'ın bir kısmını yönetiyordu. Hükümdarların yaptığı buydu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970208
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970208,
					"content": "Güce yalnızca bu görevi yerine getirerek ulaşabiliriz, ama Mondstadt'ı yönetme fikri hoşuma gitmiyor ve Mondstadt'ın da bundan hoşlanacağını sanmıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970209
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970209,
					"content": "\"Öne çık ve kuralların olmadığı bir özgürlük şehri kur.\" Barbatos'un Mondstadt için arzusunu unutmadık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970210
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970210,
					"content": "Jean... Ne kadar da tutkulusun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970211
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970211,
					"content": "Belki de birileri biraz fazla özgür kaldı ve ilgilenemeyecek kadar tembelleşti...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970212
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970212,
					"content": "Ahh... Ne olursa olsun... Mondstadt'a çok uzun bir süredir dönmemiştim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970213
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970213,
					"content": "Hiç şüphesiz, şimdi Yediler arasındaki en zayıf hükümdar benim!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970214,
						3970215
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970214,
					"content": "Yine de neredeyse gurur duyar gibisin...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				},
				{
					"id": 3970216,
					"content": "Ayy, iltifat ediyorsun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970217
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970217,
					"content": "Ah, ne mütevazı bir tanrı... Bu bir lütuf mu yoksa lanet mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970218
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970218,
					"content": "Ama konu dışına çıktık. Esas konuya geri dönelim, yani tüm insanlığın ortak düşmanına.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970219
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970219,
					"content": "<color=#00E1FFFF>Hiçlik Büyücüsünü</color> <color=#00E1FFFF>şaraphane</color> yakınlarına kadar takip ettik.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970220
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970220,
					"content": "Kaçmasına izin vermemek ne kadar önemli anlatamam.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970221
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970221,
					"content": "Hadi onu yakalayalım!",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3970215,
					"content": "Sanırım bu yüzden Özgürlük Şehri'nin tanrısısın...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970216
					]
				}
			]
		},
		{
			"id": 39704,
			"completionStepIds": [
				39704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
