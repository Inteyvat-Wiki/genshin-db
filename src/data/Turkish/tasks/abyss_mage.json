					"Venti"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3970401,
					"content": "Ha? Bu da ne?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970402
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970402,
					"content": "Hiçlik Büyücüsü yenildikten sonra bedeninden belirli bir enerji yayıldı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970403
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970403,
					"content": "Görünüşe göre enerji, benimle Dvalin arasındaki bağı kesmek için kullanılmış.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970404
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970404,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970405
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970405,
					"content": "#{NICKNAME}, <color=#00E1FFFF>Fırtına Dehşeti'nin İnini</color> biliyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970406,
						3970408
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970406,
					"content": "Yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970407
					]
				},
				{
					"id": 3970407,
					"content": "Ama Jean ve Usta Diluc kesin biliyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970410
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970410,
					"content": "Dvalin uyandıktan sonra kadim harabeleri kendine in olarak seçti.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970411
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970411,
					"content": "Önceden Mondstadt'ı dış dünyadan ayıran fırtınalarda olduğu gibi harabelerin girişi de özel bir bariyerle mühürlenmiş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970412
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970412,
					"content": "Ama şimdi, Hiçlik Büyücüsünden yayılan enerji dağıldığında, bariyerin büyü örüntüsünün ritmik akışını okuyabildim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970413
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970413,
					"content": "İtiraf etmeliyim, kulağa bir dağ yabanisi korosundan bile daha korkunç geliyor, ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970414
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970414,
					"content": "... Sanırım bu fırtına bariyerini aşmamız ve <color=#00E1FFFF>Fırtına Dehşeti'nin İnine</color> ulaşmamız için yeterli olmalı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970415
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970415,
					"content": "Yani Dvalin'in karşısına mı çıkacağız?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970416
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970416,
					"content": "Benim için sorun yok... Doğrudan çatışmalardan kaçınmak isteyen Jean.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970417
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970417,
					"content": "Hayır. Başka seçenek kalmadığında, eylem planımızı değiştirmekten ben sorumluyum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970418
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970418,
					"content": "Onu öldürmek tek seçeneğimiz ise, seve seve bu saldırıya öncülük eden şövalye olabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970419
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970419,
					"content": "Neyse ki bu kadar ileri gitmemiz gerekmiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970420
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970420,
					"content": "Hım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970421
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970421,
					"content": "Bununla demek istediğin...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970422
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970422,
					"content": "Yani Kutsal Lir tek kozumuz değil demek istiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970423
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970423,
					"content": "#Gerçek kozumuz? {NICKNAME} tabii ki.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970424
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970424,
					"content": "#{NICKNAME}?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970425,
						3970427
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970425,
					"content": "Gözyaşı Kristalini arındırdığım için mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970426
					]
				},
				{
					"id": 3970426,
					"content": "Evet.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970430,
					"content": "Gözyaşlarındaki bozulmalar ve Dvalin'i bağlayan lanet aynı kötü güce ait.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970431
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970431,
					"content": "Yani...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970432
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970432,
					"content": "Sen, Detone Ozan, bunun ne kadar çılgınca olduğunu görmüyor musun?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970433
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970433,
					"content": "#Dvalin'in tepesi attığında nasıl biri olduğunu gördün! {NICKNAME} daha parmağını bile kıpırdatamadan ona yem olur!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970434,
						3970435
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970434,
					"content": "Sadece nasıl savaşabileceğimden bahsetmiyor muyduk?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970436,
					"content": "... Hey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970437
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970437,
					"content": "Güzel plan. Denemeye değer.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970438
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970438,
					"content": "Seninleyim, Fahri Şövalye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970439
					],
					"speakerTitle": "Jean"
				},
				{
					"id": 3970439,
					"content": "Ha! Yani hiçlikten gelen canavarlarla... Ve bir de ejderle savaşmamız gerek! Hiç stresli değil.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970440
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 3970440,
					"content": "İnsanların güçleri olmadan olmaz. Haydi gidelim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970441
					],
					"speakerTitle": "Diluc"
				},
				{
					"id": 3970441,
					"content": "Ve böylece...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970442
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970442,
					"content": "Cesur kahramanların destansı başarıları sayesinde sona yaklaştık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970435,
					"content": "Bu savaş... Herkesin sahip olduğu her şeyi alıp götürecek.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970436
					]
				},
				{
					"id": 3970427,
					"content": "Savaşabildiğim için mi?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970428
					]
				},
				{
					"id": 3970428,
					"content": "Evet, bunu söyleyebilirsin... Kesinlikle dikkate alınması gereken bir güçsün.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970429
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970429,
					"content": "Ama çok daha eşsiz ve güçlü bir tarafın var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3970430
					],
					"speakerTitle": "Venti"
				},
				{
					"id": 3970408,
					"content": "Sanırım Mondstadt'ta bu konuda konuşanları duydum.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3970409
					]
				},
				{
					"id": 3970409,
					"content": "Tabii ki. Sanırım Mondstadt'taki herkes bunu bilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
