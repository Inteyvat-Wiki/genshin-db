			"dialogs": [
				{
					"id": 221110101,
					"content": "Yeni Özel Görev var mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110102
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110102,
					"content": "Selam Maceracı. Başarıların artık tüm Mondstadt'ta konuşuluyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110103
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110103,
					"content": "Böyle devam edersen, çağımızın en iyi Maceracısı olarak anılacağın kesin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110104,
						221110107
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110104,
					"content": "Yapmamı istediğin bir şey var mı?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110105
					]
				},
				{
					"id": 221110105,
					"content": "Büyük bir Maceracı olmak istiyorsan, bir noktada bildiğin yerlerin ötesine geçmen gerekecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110106
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110106,
					"content": "Bu kadar macera deneyimi biriktirdiğine göre, belki de artık başka yerler keşfetmenin zamanı gelmiştir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110110,
					"content": "Bu mektubu al ve Liyue'deki Katheryne'e götür.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110111,
						221110113
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110111,
					"content": "Liyue'de de mi Katheryne var?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110112
					]
				},
				{
					"id": 221110112,
					"content": "Evet, onu bulurken eminim zorlanmayacaksın.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110115,
					"content": "Her neyse, Liyue'deki Katheryne bu mektubu aldıktan sonra, bütün maceracılık ihtiyaçların için irtibata geçeceğin kişi o olacak.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110116
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110116,
					"content": "Tabii Mondstadt'a döndüğünde sana hizmet etmekten mutluluk duyacağım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110117
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110117,
					"content": "Yolda mektubu açmamanı isteyeceğim. İçindekiler düşecek olursa karışıklığa yol açabilir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110118
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110118,
					"content": "Maceracı! Yıldızlar ve hiçlik yolunda yeni bir adım atmanın zamanı geldi. Yıldızlar ve hiçlik yoldaşın olsun!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110113,
					"content": "O zaman artık sana \"Mondstadt'taki Katheryne\" diye mi seslenmeliyim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110114
					]
				},
				{
					"id": 221110114,
					"content": "Maceracılık kariyerine faydası olacaksa, bana istediğin gibi hitap edebilirsin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110115
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110107,
					"content": "Ama benim tek bildiğim yer Mondstadt...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221110108
					]
				},
				{
					"id": 221110108,
					"content": "Bunun nedeni şimdiye kadar tamamladığın tüm maceraların Mondstadt bölgesiyle kısıtlı olmasıydı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110109
					],
					"speakerTitle": "Katheryne"
				},
				{
					"id": 221110109,
					"content": "Ama bu değişmek üzere. Yakında buranın ötesindeki diyarlara gitmeye cesaret edeceksin.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221110110
					],
					"speakerTitle": "Katheryne"
				}
			]
		},
		{
			"id": 2211102,
