					"Asilzade"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10031801,
					"content": "Sonunda geri döndünüz. Jueyun Gölü seyahatiniz nasıldı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031802
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031802,
					"content": "... Anlıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031806,
					"content": "Adeptusların tümünü kendi gözlerinle göremedin mi? ... Dedikleri gibi, kadere bağlı değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031807
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031807,
					"content": "Endişelenme! Boş vaktin varsa bir daha denemekten zarar gelmez.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031808
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031808,
					"content": "Ayrıca İblislerin Fatihiyle ilgili bilgi yeterince değerli. Dönüş hediyesi olarak benim de size verecek bilgilerim var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031809
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031809,
					"content": "Hükümdarın ölümü üzerine... Liyue'nin Yedi Yıldızının yanıtı beni gerçekten düşündürdü...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031810
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031810,
					"content": "Gerçek katil henüz bulunamadığı için kimsenin Exuvia'ya hürmetini göstermesine izin vermediklerini açıkladılar.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031811
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031811,
					"content": "Bilgi akışını kesmeyi bile denediler... Ancak Zuhur Ayini ve diğer olaylarla birlikte Yedi Yıldız bile bazı şeyleri gizleyemiyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031812
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031812,
					"content": "Exuvia mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031813
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031813,
					"content": "Rex Lapis'in de bir Adeptus olduğu Liyue'de bilinen bir şey.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031814
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031814,
					"content": "Toprak Hükümdarı aynı zamanda Sözleşme Tanrısı ve Exuvia yani Adeptusların Başı olarak bilinir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031815
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031815,
					"content": "Günümüzün kudretli ve aydınlanmış Adeptuslarının her biri geçmişte Liyue'yi korumak için sözleşme imzaladı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031816
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031816,
					"content": "Sanırım bu, Liyue'nin durumuna neden bu kadar özen gösterdiklerini açıklıyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031817
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031817,
					"content": "Elbette. Bu onların hem sorumluluğu hem de yetenekli oldukları bir iş.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031818
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031818,
					"content": "Eğer Yedi Yıldız iktidarı görevlerini düzgün bir şekilde yerine getiremez hale gelirse Adeptusların düzeltici eylemde bulunma hakkı var.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031819
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031820,
					"content": "Bu benim için de işleri zorlaştırıyor.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031821,
					"content": "Aynen öyle, bir şeyler yanlış.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031822
					]
				},
				{
					"id": 10031819,
					"content": "Toprak Hükümdarı'nın ruhu göğe yükseldi, Yedi Yıldız neden bedenini saklıyor? Gerçekten çok şüphe uyandırıcı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031820,
						10031821
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031822,
					"content": "Doğru ya! Buraya gelme nedenimiz o!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031823
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031823,
					"content": "Liyue'nin Yedi Yıldızı Exuvia'yı korumaya aldıysa ve kimseyi yaklaştırmıyorsa...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031824
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031824,
					"content": "#O zaman Yedileri bulma görevin çoktan sona erdi {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031826,
					"content": "Seni ilgilendirmez.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031827,
					"content": "Yorum yok.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031828
					]
				},
				{
					"id": 10031825,
					"content": "Yedileri mi bulmaya çalışıyorsun? Peki neden söyler misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031826,
						10031827
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031828,
					"content": "Ha ha... Ne hoş bir yanıt.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031829
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031829,
					"content": "Fatui tarafından kandırılan bir şövalye, gerçekten şövalye olamaz değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031830
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031830,
					"content": "Ama sana bu konuda da yardım edebilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031831
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031831,
					"content": "Ne? Gerçekten mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031832
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 10031832,
					"content": "Bana biraz zaman tanı.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031833
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031833,
					"content": "Birilerini... Bulabilirim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031834
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031834,
					"content": "Seni bu çıkmazın içinden çıkarabilecek birini bulabileceğimi sanıyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031835
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031835,
					"content": "Gerçekten büyüleyici. Durumu ne kadar saklamaya çalışırlarsa o kadar büyük bir kaos patlak verecek.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031836
					],
					"speakerTitle": "Asilzade"
				},
				{
					"id": 10031836,
					"content": "Tümünün çöktüğü anı görmek istiyorsan sonraki buluşmamıza kadar hayatta kalmalısın değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Asilzade"
				}
			]
		},
