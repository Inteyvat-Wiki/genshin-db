			"dialogs": [
				{
					"id": 732951201,
					"content": "Ah, dostlarım. Kayıp çizimler...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732951202
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732951202,
					"content": "Henüz bulamadık.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732951203
					]
				},
				{
					"id": 732951203,
					"content": "Anladım. Sorun değil. Zaten çok da değerli değillerdi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
			]
