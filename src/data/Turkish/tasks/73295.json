			"dialogs": [
				{
					"id": 732950101,
					"content": "Yiyecek güzel bir şey mi bıraksak?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950102
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950102,
					"content": "(Bir şey beklercesine size bakıyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Köpek"
				}
			]
		},
		{
			"id": 7329504,
			"completionStepIds": [
				7329504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329504",
							"2"
						],
						"stepId": 7329504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950401,
					"content": "İyi misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950402
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950402,
					"content": "B-Beni... *iç çeker* Beni kurtardığınız için sağ olun.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950403
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950403,
					"content": "Dün gece harika bir rüya gördüm. Rüyamda Tırtıl kutsal yolun sonunda durmuş bana el sallıyordu. Bir de... Neyse, garipti açıkçası. Neden yol sürekli mağaradan mağaraya gidiyordu ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950404
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950404,
					"content": "Ama Tırtıl oradaydı, dar bir yolun en sonunda bekliyordu. Ben de ona doğru koştum, ama ona ulaşamadan köpek beni uyandırdı...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950405
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950405,
					"content": "Köpekli kısım hariç bunu iyiye işaret olarak yorumladım. O yüzden çizim eşyalarımı alıp yola koyuldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950406
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950406,
					"content": "Sonra... Başsız Cicin gibi labirentte dolanıp durdum. Hatta dağ yabanileri bile saldırdı... Kaçamadığım yetmezmiş gibi bir de taslak çizimlerimin olduğu çantayı kovalama sırasında kaybettim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950407
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950407,
					"content": "Yine kayıp dolu bir gün olmuş senin için.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950408
					]
				},
				{
					"id": 732950408,
					"content": "Suç bende mi? Burada doğru yolu bulmak Fontaine'in lağımlarında dolaşmaktan daha zor! Bir dakika, Sumeru'da insanlar ağaçlarda yaşıyorlar, değil mi? Yoksa burası gerçekten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950409
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950409,
					"content": "Sumeru'daki insanlar, şey... Nereye yapıyorlar?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950410
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950410,
					"content": "Bu düşündüğün şey değil!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950411
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950411,
					"content": "*iç çeker* Hayatım ardı ardına başarısızlıklarla dolu. Hep yanlış kararlar veriyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950412
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950412,
					"content": "Bu sabah güvende olduğum alanı neden terk ettim? Çünkü rüyamda iyi bir işaret gördüm ama bu bir rüyadan başka bir şey değildi. Neden gerçek sandım ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950413
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950413,
					"content": "İçinde olduğum durumu size daha dürüst bir şekilde söylemem gerekirdi... Sizden önden gitmenizi isteseydim bu duruma düşmezdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950414
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950414,
					"content": "Of, niye en baştan Fontaine'den ayrıldım ki? Oradaki yaşamım henüz tahammül edilemez de değildi... Öte yandan buraya geldiğimden beri işler hiç iyi gitmedi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950415
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950415,
					"content": "Henüz pes etme! Sana hâlâ güzel yerler gösterebiliriz ama önce kaybettiğin şeyleri bulmana yardım edeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950416
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950416,
					"content": "Şey, onları tekrar bir araya getirebilir miyiz bilmiyorum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950417
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950417,
					"content": "Hahaha, dağ yabanileri alıp tuvalet kağıdı niyetine kullanmış bile olabilir! Neyse... Ne olduysa oldu... Pahalı şeyler değillerdi zaten...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950418
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950418,
					"content": "Dürüst ol lütfen.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950419
					]
				},
				{
					"id": 732950419,
					"content": "Evet. Mora bazında pek değerli olmasalar bile senin için değerliler, öyle değil mi? Bulmana yardım edeceğiz!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950420
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950420,
					"content": "Bu arada Tarçın nerede? Yanında değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950421
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950421,
					"content": "Hıh, o kalpsiz mahluk uzun zaman önce kaçtı... Kesin şimdi bir yere saklanmış keyfine bakıyordur.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950422
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950422,
					"content": "İnanılır gelmedi pek...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950423
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950423,
					"content": "Neyse, sen kampına dön ve yaralarınla ilgilen. Biz kayıp eşyaları bulduğumuzda yanına geliriz.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950424
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950424,
					"content": "Sağ olun... Dostlarım. Ah, bu hayatta dostlarımızdan başka neye güvenebiliriz ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
			]
		},
		{
			"id": 7329506,
			"completionStepIds": [
				7329506
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329506",
							"2"
						],
						"stepId": 7329506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Köpek"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950601,
					"content": "Hı? Tarçın değil mi bu? Bir şeyi koruyor hem de! Bir dakika, bu çok tanıdık geldi...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950602
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950602,
					"content": "(Sizi tanımış gibi görünüyor ve kuyruğunu sallıyor.)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950603
					],
					"speakerTitle": "Köpek"
				},
				{
					"id": 732950603,
					"content": "Aa, Julien'ın çizimlerini mi koruyor?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950604
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950604,
					"content": "Tarçın iki kere havlayıp hemen kaçıyor...",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732950605
					]
				},
				{
					"id": 732950605,
					"content": "Yine gitti... Geçen sefer de böyle olmuştu... Bu arada dağ yabanileri bu çizimleri niye almış ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950606,
						732950608
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950606,
					"content": "Etrafı süslemek istemişlerdir belki.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950607
					]
				},
				{
					"id": 732950607,
					"content": "Iı, öyle bir şey isterler mi ki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950608,
					"content": "Belki tuvalet kağıdı olarak kullanıyorlardır...",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950609
					]
				},
				{
					"id": 732950609,
					"content": "#Of! Hayal gücün çok kötü {NICKNAME}!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Paimon"
				}
			]
		},
		{
			"id": 7329508,
			"completionStepIds": [
				7329508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329508",
							"2"
						],
						"stepId": 7329508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"Julien"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732950801,
					"content": "Düşündüğümüz gibi, Tarçın çoktan dönmüş!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950802
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950802,
					"content": "Julien! Çizimlerini bulduk!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950803
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950803,
					"content": "Ah, çok teşekkür ederim dostlarım... Bu değersiz şeyler için bunca zahmete girdiniz...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950804
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950804,
					"content": "Deme öyle! Fontaineli meşhur bir ressam değil misin sen? Çizimlerin iyi para eder, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950805
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950805,
					"content": "Iı, şey, sanırım... Açıkçası böyle şeyleri pek düşünmem ben. Sonuçta gerçek sanata paha biçilemez, öyle değil mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950806
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950806,
					"content": "Ünlü bir sanatçı olduğuna şaşmamalı. Seçtiğin kelimeler çok sanatsal! Bu arada çizimlerini bulduğumuz sırada Tarçın onları koruyordu.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950807
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950807,
					"content": "Geçen seferki gibi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950808
					]
				},
				{
					"id": 732950808,
					"content": "Evet! Paimon Tarçın'ın sana çok önem verdiğini düşünüyor.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950809
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950809,
					"content": "Ne kadar beslersem besleyeyim beni garip yollara sokan köpekten mi bahsediyorsun? Hani o, beni dağ yabanileriyle bir başıma bırakandan mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950810
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950810,
					"content": "Şey... B-Bir bildiği vardır belki?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950811
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950811,
					"content": "Bu dediklerine rağmen sen de aslında Tarçın'ı seviyorsun, değil mi? Özel bir Kamerayla fotoğrafını niye çekesin ki yoksa.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950812
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950812,
					"content": "Fotoğraf mı? Ne fotoğrafı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950813
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950813,
					"content": "Çizimlerin arasında bir köpeğin resmi vardı. Tıpkı Tarçın'a benziyordu. Resmin renkleri de benzersizdi. O fotoğrafı özel bir Kamerayla çekmişsindir, haksız mıyım?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950814
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950814,
					"content": "Şey... Aslında o benim çizimim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950815
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950815,
					"content": "Ne? C-Ciddi misin? Demek gerçekten yeteneklisin Meşhur Sanatçı Bey. Çok gerçekçi duruyordu, ama renkleri kullanımın da çok... Sanatsaldı!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950816
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950816,
					"content": "...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950817
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950817,
					"content": "(Paimon yanlış bir şey mi söyledi?)",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950818,
						732950819
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950818,
					"content": "(Bana sorma. Ben de anlamıyorum ki.)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950820
					]
				},
				{
					"id": 732950820,
					"content": "Bu şekilde çizmek istememiştim... Ben sadece... Üst düzey bir sanatçı olmak istemiştim. Sizce bu imkansız mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950821
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950821,
					"content": "*iç çeker* Özür dilerim, sizlere yalan söylememeliydim dostlarım. İnsan bir kere yalan söyleyince devamını getirmesi gerekiyor... Daha fazla yalan söylemek istemiyorum...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950822
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950822,
					"content": "Ben aslında renkleri diğer insanlar gibi \"doğru\" ayırt edemeyen amatör bir sanatçıyım. Buna rağmen gerçek bir sanatçı olma hayalimden vazgeçmek istemedim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950823
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950823,
					"content": "Bir arkadaşımın... Gücünün yardımıyla artık her şeyi tıpkı göründüğü gibi çizebiliyorum ama hâlâ renkleri ayırt edemiyorum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950824
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950824,
					"content": "Bir dakika, her şeyi tıpkı göründüğü gibi çizebildiğini söyledin... Bu gerçekten de... Bir gecede öğrenebileceğin bir şey mi?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950825
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950825,
					"content": "Arkadaşım oldukça güçlü biridir.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950826
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950826,
					"content": "Öyle mi? İnanması güç geldi.",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950827
					]
				},
				{
					"id": 732950827,
					"content": "Aslında bir şeyi tıpkı göründüğü şekil haricinde, başka bir şekilde çizme yetimi kaybettim diyebilirim. \"Gücün bedeli\" dedikleri bu olsa gerek. Biraz acayip duruyor, biliyorum ama...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950828
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950828,
					"content": "Julien senin için bir Maceracının Tecrübesinin kopyasını çıkarıyor.\\nKopya ile aslını yan yana inceliyorsun fakat aralarında hiçbir fark göremiyorsun.",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732950848
					]
				},
				{
					"id": 732950848,
					"content": "Belki de tek fark, okuduktan sonra kopyanın aklında yalnızca garip bir boşluk hissi bırakması...\\nHem okumuş hem de okumamış gibi hissediyorsun, sanki hiç tecrübe kazanmadan boşa vakit geçirmişsin gibi...",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732950849
					]
				},
				{
					"id": 732950849,
					"content": "Aslından pek de farklı durmuyor...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950829
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950829,
					"content": "Yani tabii ünlü bir sanatçı olmadım ama sahtecilikte uzman oldum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950830
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950830,
					"content": "Yasa dışı değil mi o?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950831
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950831,
					"content": "... Öyle. Cezamı çektikten sonra meşru bir iş yapmaya kararlıydım. Bu sefer gerçek bir sanatçı olacaktım!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950832
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950832,
					"content": "Fakat gördüklerimi bire bir çizebilme becerisi... Bana bu beceriyi bahşeden Tırtıl olmasaydı buna beceri değil lanet derdim.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950833
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950833,
					"content": "Ben yalnızca yanlış renklerde fotoğraf çekebilen bir kamera gibiyim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950834
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950834,
					"content": "Okeanidlerin yolunda kutsal bir yolculuğa çıkarsam bu derdime bir deva bulabilirim diye düşündüm... Renkleri diğer insanlar gibi ayırt etmemi ve bana masum çocuklarınkine benzer bir yaratıcılık bahşedecek bir deva...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950835,
						732950837
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950835,
					"content": "Bir dakika. Tırtıl kim?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950836
					]
				},
				{
					"id": 732950836,
					"content": "Bir arkadaşım... Çok güvendiğim bir arkadaşım. Okeanidlerin kutsal yolculuğunu takip edersem Sumeru'da tüm acıları iyileştirebilen ve insana hayatında yeni bir sayfa bahşedebilecek bir ilaç bulabileceğimi o söyledi bana.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950839
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950839,
					"content": "Anlattıkların çok şüpheli geliyor kulağa! Nasıl bir arkadaş ki bu? Kandırılmadığına emin misin?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950840
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950840,
					"content": "Çok şey görüp geçirdi. Neden beni kandırsın ki? Kabahat bende olmalı... Dedim ya, hayatım böyle kabahatlerle dolu...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950841
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950841,
					"content": "Bu mucizevi ilaç, sıkı kilit altında tutuluyor olmalı. Benim gibi sıradan birinin onu bulması imkansız... Ben... Bunu kabullendim artık.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950842
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950842,
					"content": "Bahse girerim Tarçın benimle Sumeru'ya gelmek istememiştir. Yoksa bu kadar sorun çıkarmazdı. Keşke onu Fontaine'de bıraksaydım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950843
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950843,
					"content": "Paimon... Onun kesinlikle senin yanında kalmak istediğini düşünüyor. Çizimlerini de sevdiği kesin... O yüzden böyle pes edeyim deme!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950844
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950844,
					"content": "Beni teselli ettiğiniz için teşekkür ederim ama... Ben çoktan umudu kestim. Kaç seferdir yardımıma koşuyorsunuz, ben hâlâ karşılığını hak ettiğiniz gibi ödeyemedim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950845
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950845,
					"content": "İşlerimi yoluna soktuğumda Fontaine'e dönme hazırlıklarına başlayacağım. Biraz hadsizce bir talebim olacak ama rica etsem beni ana yola götürebilir misiniz?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950846
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950846,
					"content": "*iç çeker* Daha önce pes etseydim ya da sürekli bocalamasaydım... Belki çoktan doğru yolda olurdum.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950847
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950847,
					"content": "Sana yol göstermemizi istiyorsan hiç sorun değil. Ne yapacağına karar verdiğine göre... Yola çıkmadan önce senin dinlenmeni bekleyelim, tamam mı?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950850
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950850,
					"content": "Sağ olun dostlarım.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950837,
					"content": "Bu kutsal yolculuk ne peki?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950838
					]
				},
				{
					"id": 732950838,
					"content": "Tırtıl bana Okeanidlerin bu yolu izlediğini ve yolun sonunun Sumeru'ya çıktığını söyledi. Orada tüm acıları iyileştirebilen ve insana hayatında yeni bir sayfa bahşedebilen bir ilaç bulabilirmişim...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950839
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950819,
					"content": "(Bu sanat eseri seni aşıyor olabilir mi Paimon?)",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732950820
					]
				}
			]
		},
