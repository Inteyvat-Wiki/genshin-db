			"dialogs": [
				{
					"id": 732950901,
					"content": "Kutsal yol... Nasıl kaybettim ki...",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950902
					],
					"speakerTitle": "Julien"
				},
				{
					"id": 732950902,
					"content": "... Kutsal yol mu?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732950903
					],
					"speakerTitle": "Paimon"
				},
				{
					"id": 732950903,
					"content": "Boş verin, önemli bir şey değil. Öyle... Lafın gelişi.",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "Julien"
				}
			]
		},
