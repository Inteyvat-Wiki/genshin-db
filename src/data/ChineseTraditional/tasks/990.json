			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 9901508,
					"content": "在這裡還習慣嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901509
					]
				},
				{
					"id": 9901519,
					"content": "想一起聊聊天嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901520
					]
				},
				{
					"id": 9901536,
					"content": "有什麼想做的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901537
					]
				},
				{
					"id": 9901509,
					"content": "嗯，我很喜歡這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901510
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901510,
					"content": "與蒙德城不同的風景，對我來說很有新鮮感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901511
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901511,
					"content": "練習唱歌的時候，也可以放開歌喉。不用擔心萬一打擾到了別人該怎麼辦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901512
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901512,
					"content": "芭芭拉的歌聲不能說是打擾吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901513
					]
				},
				{
					"id": 9901516,
					"content": "那就太好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901517
					]
				},
				{
					"id": 9901513,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901514
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901514,
					"content": "#謝謝{F#妳}{M#你}能這樣說。但我…還是要多考慮點別人的感受嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901515
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901515,
					"content": "#總之，我很開心能收到{F#妳}{M#你}的邀請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901516
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901517,
					"content": "#嗯，我很開心能收到{F#妳}{M#你}的邀請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901518
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901518,
					"content": "我還想在這裡多待一會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901520,
					"content": "啊，好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901521
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901521,
					"content": "嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901522
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901522,
					"content": "妳怎麼突然笑了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901523
					]
				},
				{
					"id": 9901524,
					"content": "啊，我剛剛意識到，自己很久沒有像現在這樣，輕輕鬆鬆地和朋友聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901525
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901525,
					"content": "突然就覺得很幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901526
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901526,
					"content": "芭芭拉很容易滿足啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901527
					]
				},
				{
					"id": 9901530,
					"content": "因為芭芭拉總是在為別人考慮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901531
					]
				},
				{
					"id": 9901527,
					"content": "唔，唔，是這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901528
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901528,
					"content": "好像，這也不是什麼壞事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901529
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901529,
					"content": "很容易就感到幸福的話，就會有很多的能量，然後就可以把幸福的感覺傳遞給別人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901530
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901531,
					"content": "那也是理所當然的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901532
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901532,
					"content": "我一直受到著大家的照顧，我也想用自己的努力來回應這些善意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901533
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901533,
					"content": "真不愧是芭芭拉啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901534
					]
				},
				{
					"id": 9901534,
					"content": "#唔，{F#妳}{M#你}不要總是誇我啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901535
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901535,
					"content": "有批評…才會有進步，對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901537,
					"content": "啊，我最近練習了一首新的曲子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901538
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901538,
					"content": "但有些細節我還把握不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901539
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901539,
					"content": "副歌在重複的時候要不要升調，舞步有沒有改善的空間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901540
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901541,
					"content": "我會為妳「全力應援」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901542
					]
				},
				{
					"id": 9901542,
					"content": "這是我的榮幸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901543
					]
				},
				{
					"id": 9901540,
					"content": "#如果不麻煩的話，我希望{F#妳}{M#你}能看我的表演，再給我一些建議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901541
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901543,
					"content": "謝謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901544
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901544,
					"content": "唔…如果有不成熟的地方，不要笑我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901545
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901545,
					"content": "#我思考過很多次，現在是鼓起勇氣，才敢在那麼近的地方表演給{F#妳}{M#你}看的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901546
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901547,
					"content": "不會的，放心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						9901548
					]
				},
				{
					"id": 9901546,
					"content": "#要是{F#妳}{M#你}笑我的話，我都不知道要往哪裡躲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901547
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901549,
					"content": "呼…好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901550
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901550,
					"content": "那麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						9901551
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 9901551,
					"content": "演唱，開始！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				}
			]
		},
