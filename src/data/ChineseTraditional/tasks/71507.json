			},
			"dialogs": [
				{
					"id": 715070101,
					"content": "這效果比我想像的還要好，所有現象和數據都已經記錄在冊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070102,
					"content": "最關鍵的，這裡的黑泥確實被清理一空了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070103
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070103,
					"content": "只不過，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070104
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070104,
					"content": "怎麼還是一臉不開心的樣子啊，難道礦區被清空不是好事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715070105,
					"content": "讓我想想，我和海迪夫之前分析的時候認為，湧出黑泥的地脈出口應該就在礦區。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070106,
					"content": "地脈出口不會這麼簡單就被清理乾淨，所以地脈出口其實是在其他地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070107,
					"content": "這次受到黑泥氾濫影響的區域除了礦區就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070108,
					"content": "前線礦道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715070109
					]
				},
				{
					"id": 715070109,
					"content": "是的…說明湧出黑泥的地脈出口就在礦道的區域，礦道相較這裡更加狹窄，黑泥容易堆積，更易招來怪物，造成的問題更嚴重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070110
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070110,
					"content": "不過我相信「普爾希娜光釘」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070111,
					"content": "這可是普爾希娜前輩製造的相當偉大的儀器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715070112
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715070112,
					"content": "只不過我得先維修一下，之後就等約好的礦工們下來把光釘搬到礦道裡去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				}
			]
		}
	]
}