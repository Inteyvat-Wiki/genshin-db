					"nextDialogs": [
						700140110
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700140110,
					"content": "#那傢伙的位置已經標在地圖上了，接下來希望{F#妳}{M#你}能找到一直搜尋的目標吧！",
					"roleType": "TALK_ROLE_NPC",
