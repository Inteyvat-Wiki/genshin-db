						700140106
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700140106,
					"content": "Dada odomu! Kundala dada! Kundala zido, mi dada!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700140107
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700140107,
					"content": "Ya zido? Ye? Mi?",
