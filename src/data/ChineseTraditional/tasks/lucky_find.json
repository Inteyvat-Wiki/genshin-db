			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"歐拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110030201,
					"content": "好…好冷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030202
					],
					"speakerTitle": "歐拉夫"
				},
				{
					"id": 110030202,
					"content": "他的身體好冷！得趕快幫他暖暖才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030203
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030203,
					"content": "那在這裡生火吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110030204,
					"content": "嗯，最好還能有一碗熱湯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030205
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030205,
					"content": "#{NICKNAME}，我在這裡照顧他，能麻煩{F#妳}{M#你}去準備一份<color=#00E1FFFF>美味的熱湯</color>嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030206
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030206,
					"content": "我記得來的路上有個丘丘人營地，那裡大概就有能做湯的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030207
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030207,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030208
					]
				},
				{
					"id": 110030208,
					"content": "好的，準備好了就盡快回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				}
			]
		},
		{
			"id": 1100304,
			"completionStepIds": [
				1100304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100304",
							"2"
						],
						"stepId": 1100304,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"108021",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"歐拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110030401,
					"content": "哈啊…哈啊…好多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030402
					],
					"speakerTitle": "歐拉夫"
				},
				{
					"id": 110030402,
					"content": "#謝謝{F#妳}{M#你}們，這碗湯真好喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030403
					],
					"speakerTitle": "歐拉夫"
				},
				{
					"id": 110030403,
					"content": "怎麼會凍成這個樣子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030404
					]
				},
				{
					"id": 110030404,
					"content": "我本來在追一隻野豬，追了好遠，牠逃進了那邊的地下遺蹟裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030405
					],
					"speakerTitle": "歐拉夫"
				},
				{
					"id": 110030405,
					"content": "我追進去，卻遇到了一棵好大好大的急凍樹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030406
					],
					"speakerTitle": "歐拉夫"
				},
				{
					"id": 110030406,
					"content": "我被凍僵了，清醒之後就跑了出來，但跑到這裡身體就使不出力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030407
					],
					"speakerTitle": "歐拉夫"
				},
				{
					"id": 110030407,
					"content": "急凍樹？一棵樹，還會攻擊人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030408
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030408,
					"content": "是啊，我以前只是聽別人說過，親眼見到還是頭一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030409
					],
					"speakerTitle": "歐拉夫"
				},
				{
					"id": 110030409,
					"content": "聽起來好危險…我們還是不要靠近那個遺蹟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110030410,
					"content": "說不定會很好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030411,
						110030412
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030411,
					"content": "…啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				},
				{
					"id": 110030413,
					"content": "就是這個！一錘定音的食材，肯定會很好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030414
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030414,
					"content": "冷靜啊，這麼兇猛的植物真的能吃嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110030415,
					"content": "不試試看怎麼知道，快，我們出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030416
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110030416,
					"content": "又跑掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110030417,
						110030418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110030417,
					"content": "我們要先走一步了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030419,
					"content": "沒事，不用管我，但一定要阻止她，很危險的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歐拉夫"
				},
				{
					"id": 110030418,
					"content": "你先回清泉鎮吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030419
					]
				},
				{
					"id": 110030412,
					"content": "這也能聯想到吃的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110030413
					]
				}
			]
		},
