				"points": []
			},
			"dialogs": [
				{
					"id": 4680301,
					"content": "我還有事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680302
					]
				},
				{
					"id": 4680302,
					"content": "這樣啊，那我只能等兒子休假回來，再教訓這些壞東西了",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特納"
				}
			]
		},
		{
			"id": 46804,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46802",
							"3"
						],
						"stepId": 46802,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特納"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680401,
					"content": "#{F#妳}{M#你}好，客人。我兒子有沒有從{F#妳}{M#你}那帶來什麼口信？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680601,
					"content": "你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680602
					]
				},
				{
					"id": 4680602,
					"content": "我啊？酒莊裡的夥計們都叫我老特納，是這晨曦酒莊的農夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680603
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680603,
					"content": "#我們家祖祖輩輩都在耕這塊地，如果{F#妳}{M#你}在這嚐到過什麼好葡萄酒，我敢說十有八九是這地裡的葡萄釀的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680604
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680604,
					"content": "所以這酒莊歷代的大老闆，總是待我們家不薄，少不了吃的穿的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680605
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680605,
					"content": "可想到子子孫孫也都要這麼種一輩子田，好像也不是什麼好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680701,
					"content": "你的兒子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680702
					]
				},
				{
					"id": 4680702,
					"content": "蓋伊！他叫蓋伊，我的寶貝兒子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680703
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680703,
					"content": "#什麼？{F#妳}{M#你}沒聽說過這名字？哈哈，沒關係，{F#妳}{M#你}遲早會知道他的，全蒙德都會知道他的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680704
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680704,
					"content": "他會成為全蒙德最優秀的西風騎士，他就是這麼跟我說的，我當然相信自己的兒子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680705
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680705,
					"content": "唉，想想他小時候，為了不讓他也像我這樣種一輩子田，我可把全部心血都花在他身上啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680706
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680706,
					"content": "不過這小子果然很爭氣，十六歲就當上了見習騎士，我們家就要靠他翻身了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680601,
						4680701,
						4680801
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680801,
					"content": "再見",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680802
					]
				},
				{
					"id": 4680802,
					"content": "再見，如果見到我兒子蓋伊，幫我跟他說，讓他有空回來看看~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特納"
				}
			]
		},
