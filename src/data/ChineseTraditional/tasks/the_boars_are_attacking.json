			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特納"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4680201,
					"content": "有什麼可以幫忙的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4680202
					]
				},
				{
					"id": 4680202,
					"content": "#{F#妳}{M#你}是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680203
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680203,
					"content": "…是旅行者啊，可真是個熱心腸的好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680204
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680204,
					"content": "現在正是葡萄生長的關鍵時節，可不知道哪來的野豬，成群結隊，盯上這塊地盤啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680205
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680205,
					"content": "我一個人趕又趕不走，兒子現在又不在身邊，只能眼睜睜看著它們在地裡橫衝直撞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4680206
					],
					"speakerTitle": "特納"
				},
				{
					"id": 4680206,
					"content": "#{F#妳}{M#你}要是能幫忙給這些野豬一點教訓的話，我特納一定會好好答謝{F#妳}{M#你}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特納"
				}
			]
		},
		{
			"id": 46803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
