			"dialogs": [
				{
					"id": 401650201,
					"content": "原來魔水就是墨水…真是神奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650202
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650202,
					"content": "柑橘女士，請問有沒有不加魔水的飲品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650203
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650203,
					"content": "當然有，要什麼口味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650204
					],
					"speakerTitle": "柑橘"
				},
				{
					"id": 401650204,
					"content": "日落果？琴，妳感興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650205
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650205,
					"content": "…好，那我也要一杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650206
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650206,
					"content": "好呀，兩杯日落果口味！馬上就來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柑橘"
				}
			]
