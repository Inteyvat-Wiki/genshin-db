			},
			"dialogs": [
				{
					"id": 401650701,
					"content": "奧茲華爾多·赫芙那梵茵斯…告訴我，此刻映照於我覽遍三千世界斷罪之眼中的景象絕非虛妄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650702
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 401650702,
					"content": "小姐，妳沒看錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650703
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 401650703,
					"content": "那我將以幽夜淨土的王室之禮向兩位行以問候。千星之國的至高夜龍，以及他身側冠帽的扈從。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650704
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 401650704,
					"content": "妳說誰是扈從？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650705
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650705,
					"content": "小姐的意思是，兩位好，很高興認識你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650706
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 401650706,
					"content": "你們好！我也很高興認識你們，但阿帽是我的朋友，不是扈從。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650707
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650707,
					"content": "嘖…沒必要解釋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650708
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650708,
					"content": "阿帽！小杜林！終於找到你們了！哇，還有菲謝爾你們也在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650709,
					"content": "哦呵呵！受幽夜淨土祝聖的異世旅人！汝於此星空下與本皇女相遇一定也是命運的選擇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650710,
						401650711
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 401650710,
					"content": "誠如皇女所言。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650712
					]
				},
				{
					"id": 401650712,
					"content": "#榮譽騎士{M#哥哥}{F#姐姐}和小派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650713
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650713,
					"content": "兩位別來無恙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650714
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650714,
					"content": "嘿嘿，小可莉在這裡玩得還開心嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650715,
					"content": "開心！有好多好多可愛的小動物！好長好長的魔法小火車！還有好高好高的國王大城堡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650716
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650716,
					"content": "我帶可莉走過一圈，沿路收穫不少，不愧是艾莉絲女士的魔法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650717
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650717,
					"content": "媽媽好厲害！可莉也想造大大的房子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650718
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650718,
					"content": "可莉的媽媽…是我媽媽的朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650719
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650719,
					"content": "嗯！媽媽以前經常念故事給我聽，小杜林哥哥的媽媽寫故事真好看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650720
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650720,
					"content": "小杜林…哥哥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650721
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650721,
					"content": "當哥哥了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650722
					]
				},
				{
					"id": 401650722,
					"content": "哇…謝謝可莉！阿帽，我能和可莉一起去玩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650723
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650723,
					"content": "隨你便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650724
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650724,
					"content": "阿貝多哥哥，阿貝多哥哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650725
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650725,
					"content": "去吧，別跑太遠，我會來接妳的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650726
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650726,
					"content": "嗯！我們走吧，小杜林！菲謝爾姐姐也來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650727
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650727,
					"content": "哼哼！本皇女接受你們的邀請。慶賀吧！即使你們藏身於迷霧之中，也將有幸一睹此斷罪之眼的威姿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650728
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 401650728,
					"content": "小姐說，大家可以一起玩捉迷藏，她來當鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650729
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 401650729,
					"content": "好耶！捉迷藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650730
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650730,
					"content": "捉迷藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650731
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650731,
					"content": "說回剛才的話題，阿帽先生，你所說的預言一事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650732
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650732,
					"content": "我當時聽到「B」對「M」這麼說——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650733
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650733,
					"content": "看在妳這麼執著的分上，我就告訴妳一個秘密吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650734
					],
					"speakerTitle": "魔女B"
				},
				{
					"id": 401650734,
					"content": "「R」的孩子，有朝一日會復活喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650735
					],
					"speakerTitle": "魔女B"
				},
				{
					"id": 401650735,
					"content": "欸？那位觀星的魔女說…龍脊雪山的杜林…會復活？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650736
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650736,
					"content": "我也很驚訝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650737
					]
				},
				{
					"id": 401650737,
					"content": "都是記憶中的景象，錯了也別賴到我頭上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650738
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650738,
					"content": "我明白了，我最近在龍脊雪山的觀察結果也佐證了這個預言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650739
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650739,
					"content": "相較以往，杜林的心臟正在慢慢活躍起來。雖然過程十分緩慢，但已顯出趨勢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650740
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650740,
					"content": "唔…那我們該怎麼做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650741
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650741,
					"content": "先制定應對各種情況的策略，當然也包括最壞的情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650742
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650742,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650743
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650743,
					"content": "我瞭解杜林的過去，並不希望事態發展到那一步，但凡事都需做好充足的準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650744
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650744,
					"content": "如果正如預言所說，杜林的心臟終將跳動如常，我會希望復活的並非「邪龍」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650745
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650745,
					"content": "#{F#妳}{M#你}們能明白我的意思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650746
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650746,
					"content": "隱隱約約…馬馬虎虎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650747
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650747,
					"content": "為此…阿帽先生，屆時能請你和希穆蘭卡的杜林也助我們一臂之力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650748
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650748,
					"content": "啊？還有我的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650749
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650749,
					"content": "你在希穆蘭卡的世界拯救了杜林，我認為這不是偶然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650750
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650750,
					"content": "如果三位女神的此中作為存在意義，除去浪漫的解讀之外，我可以做出大膽猜測…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650751
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650751,
					"content": "此片映射之天的命運，或許也能對彼處產生影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650752
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650752,
					"content": "如果龍脊雪山的杜林將要復活，我們會需要小杜林…以及與其命運交錯的你來幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650753
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650753,
					"content": "嘖…麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650754
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650754,
					"content": "的確不會容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650755
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650755,
					"content": "阿貝多哥哥！那邊有一個小紙船欸！能飄在空中的那種！要和可莉一起去看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650756
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650756,
					"content": "好，我這就來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650757
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650757,
					"content": "請再考慮一下我的建議，阿帽先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650758
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650758,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650759
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650759,
					"content": "阿帽，我回來了。嗯？你們剛才聊什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650760
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650760,
					"content": "沒什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650761
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650761,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650762
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650762,
					"content": "嗯？那我們也一起過去吧，大家都在我們新做的小船那裡呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650763
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650763,
					"content": "好，我這就來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650764,
						401650765
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650764,
					"content": "#{REALNAME[ID(1)]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650766
					]
				},
				{
					"id": 401650766,
					"content": "幹嘛？我像是那種會在乎別人破事的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650767
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650767,
					"content": "（拯救了希穆蘭卡的杜林之後，他會不會同情起現實中的杜林呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650768
					]
				},
				{
					"id": 401650768,
					"content": "別在這亂猜我的想法，走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650769
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650769,
					"content": "（就像阿貝多說的，留給以後再考慮吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650770
					]
				},
				{
					"id": 401650770,
					"content": "哇！好可愛的小船！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650771
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650771,
					"content": "是我們和森林仙子一起做的喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650772
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650772,
					"content": "說起來，破碎之海的人似乎少了很多，看來大家都順利回到王城了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650773
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650773,
					"content": "這艘船有名字嗎？可莉在哪裡都沒有找到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650774
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650774,
					"content": "欸？名字…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650775
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650775,
					"content": "嗯！可莉見過的船都有自己的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650776
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650776,
					"content": "為了寄託美好的寓意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650777
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650777,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650778
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650778,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650779
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650779,
					"content": "就叫「杜林號」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650780
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650780,
					"content": "欸？我的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650781
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650781,
					"content": "哦！是寓意小杜林的故事能夠駛向這個世界之外的新篇章嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650782
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650782,
					"content": "嗯，以無上之夜龍尊貴的名字來命名，本皇女欣賞你的品味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650783
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 401650783,
					"content": "「杜林號」…嘿嘿，那就叫這個吧！謝謝你，阿帽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650784
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650784,
					"content": "那個…阿帽，能求你一件事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650785
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650785,
					"content": "…說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650786
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650786,
					"content": "之前媽媽的朋友不是說我能出去嗎？我…我想去阿帽你生活的世界看看，看一下就回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650787
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650787,
					"content": "…哈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650788
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650788,
					"content": "不…不行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650789
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650789,
					"content": "這不是滿好的嗎？希穆蘭卡的人本來就可以出去，帶小杜林出去轉一轉也沒什麼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650790
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650790,
					"content": "…我還得在外面保護你的安全？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650791
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650791,
					"content": "我…我會保護好自己的，也會聽你的話，絕不亂飛！可以嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650792
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650792,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650793
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650793,
					"content": "…在外面我可不管你，自己跟緊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650794
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650794,
					"content": "好！我知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650795
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650795,
					"content": "不如就乘「杜林號」出去吧，以命名後的初次航行開啟新的旅程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650796
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 401650796,
					"content": "小杜林哥哥現在就要走了嗎？那…記得要來蒙德找可莉玩！可莉把來家裡的路畫給你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650797
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401650797,
					"content": "相處之刻雖如長夜虹光一般短暫，但幽夜淨土將為重逢之刻高奏樂歌，我等定將於星辰的注視之下再會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650798
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 401650798,
					"content": "小姐說，她也隨時歡迎你們到家裡坐坐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650799
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 401650799,
					"content": "嗯！認識了這麼多新朋友，我很開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650800
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650800,
					"content": "嘖…還有完沒完？要走的話就趕緊上來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650801
					],
					"speakerTitle": "#{REALNAME[ID(1)|HOSTONLY(true)]}"
				},
				{
					"id": 401650801,
					"content": "一路順風。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650802
					]
				},
				{
					"id": 401650802,
					"content": "謝謝大家，謝謝你們所有人！你們給予我的祝福，比任何東西都要寶貴，比任何童話都要美麗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650803
					],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650803,
					"content": "下次，就換我來實現你們的願望吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小杜林"
				},
				{
					"id": 401650765,
					"content": "你在擔心杜林嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650766
					]
				},
				{
					"id": 401650711,
					"content": "我也很高興見到你們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650712
					]
				}
			]
		}
	]
}