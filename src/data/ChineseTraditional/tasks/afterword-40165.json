			},
			"dialogs": [
				{
					"id": 401650501,
					"content": "啊？我看錯了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650502
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650502,
					"content": "怎麼可能…真是難以置信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650503
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650503,
					"content": "莫娜，妳好呀！好遠就聽到妳一個人嘀嘀咕咕的聲音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650504,
					"content": "妳的水占盤又出問題了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650505,
					"content": "#是{F#妳}{M#你}們啊，拯救了世界的英雄。我的水占盤好得很，出問題的可能是我的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650506
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650506,
					"content": "#{F#妳}{M#你}們看，看這個女神像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650507
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650507,
					"content": "怎麼了嗎？沒看到哪裡有缺了個角呀？不就是「預言女神」，妳的師父嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650508,
					"content": "我才不信呢！那個老太婆哪長這個樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650509
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650509,
					"content": "說不定是年輕的時候？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650510
					]
				},
				{
					"id": 401650510,
					"content": "年輕的時候…呃…這麼說來，是的確滿像她那本少女日記裡寫的愛趕時髦的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650511
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650511,
					"content": "這話不會被老太婆聽見吧？總覺得背後陰陰的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650512
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650512,
					"content": "這樣在人家雕像底下議論好像是不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650513,
					"content": "不過，既然莫娜都沒見過妳師父年輕時的樣子，妳先前是怎麼知道這座雕像是她的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650514,
					"content": "我進來時用水占盤算了算，結果星空的「倒影」卻令我大為驚訝，像是將提瓦特作為了這個「希穆蘭卡」世界命運的基底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650515
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650515,
					"content": "現實命運的「映射」，真實世界的「虛像」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650516
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650516,
					"content": "嗯…通俗一點說，妳就理解成「創造者」是在一面鏡子，或者一汪湖水的倒影中創造了這個世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650517
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650517,
					"content": "聽起來還是很了不起的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650518,
					"content": "繼續觀測下去，那些占式就越來越熟悉，一看就是老太婆的手筆…但它們遠比想像的複雜，現在的我光是解讀就已經很費力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650519
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650519,
					"content": "後來我就去找人打聽了一下，「司掌星辰與軌跡」——她還真是演都不演，徹底陶醉在她的創作裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650520
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650520,
					"content": "跟那本日記的風格也對得起來…咳咳，不對！我們還是換個話題吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650521
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650521,
					"content": "啊，莫娜！妳有見過一隻小龍嗎？差不多和我一樣大，揮舞著小小的翅膀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650522,
					"content": "曾經闖禍的那位是吧？我沒親眼見到，但聽說他不久前來王城向人們道歉，還帶了很多積木礦和植物油作為賠禮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650523
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650523,
					"content": "大多數人接受了他的賠罪，但也有些人說要看他未來的行為再做判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650524
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650524,
					"content": "這樣啊…那妳知道要去哪裡找他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650525,
					"content": "稍等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650526
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650526,
					"content": "哦，他現在在破碎之海那邊，身邊還有不少人在呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650527
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650527,
					"content": "那莫娜要一起來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650528,
					"content": "#我就不湊熱鬧了吧，難得可以跟年輕的老太婆待一會，琢磨琢磨她布下的星軌。{F#妳}{M#你}們好好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650529,
						401650531
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650529,
					"content": "那莫娜多加小心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650530
					]
				},
				{
					"id": 401650530,
					"content": "為什麼是小心啦？這麼說才會讓人緊張吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650533
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 401650533,
					"content": "我們走啦！拜拜哦莫娜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650531,
					"content": "謝謝莫娜的占星術…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650532
					]
				},
				{
					"id": 401650532,
					"content": "哪裡的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650533
					],
					"speakerTitle": "莫娜"
				}
			]
		},
