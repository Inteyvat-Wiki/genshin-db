			"dialogs": [
				{
					"id": 401650101,
					"content": "兩位的魔水來啦——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650102
					],
					"speakerTitle": "柑橘"
				},
				{
					"id": 401650102,
					"content": "感謝妳，美麗的女士。琴，不坐下來喝一杯嗎？我幫妳也點了一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650103
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650103,
					"content": "唉，是不是有些太鬆懈了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650104
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650104,
					"content": "在擔心小可莉嗎？沒關係，不是還有阿貝多陪著嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650105
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650105,
					"content": "琴團長和凱亞！你們怎麼在這裡？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650106,
					"content": "#看看誰來了？這不是{NICKNAME}和派蒙嗎？原來艾莉絲女士說的「驚喜」就是這個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650107
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650107,
					"content": "兩位好，沒想到能在這裡相遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650108
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650108,
					"content": "#難道這裡的人們口耳稱讚，拯救了世界的勇者就是{F#妳}{M#你}們兩位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650109
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650109,
					"content": "也不全是我們的功勞啦，要說的話，我們只是勇者小隊的一員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650110,
					"content": "那也很了不起嘛！果然真正優秀的騎士到哪裡都不失「榮譽」之名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650111
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650111,
					"content": "剛才說到艾莉絲女士和可莉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650112
					]
				},
				{
					"id": 401650112,
					"content": "嗯，我們收到一封艾莉絲女士寄來的邀請函，她建議我們在空閒的時候帶可莉來童話世界度個假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650113
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650113,
					"content": "原本還不知道她指的「童話世界」是什麼意思，但現在看來，還真是個恰如其分的比喻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650114
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650114,
					"content": "可莉剛進來就激動得到處跑，我有些擔心，但阿貝多說他會照顧好可莉，讓我們自由活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650115
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650115,
					"content": "此等美意，我們怎麼好意思拒絕呢？於是我就找了琴到這個世界的酒館來坐坐啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650116
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650116,
					"content": "我看你就是想趁機喝酒而已吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650117,
					"content": "哈哈，都出來休假了，就該好好享受一下嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650118
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650118,
					"content": "…你說得對，我也該鬆鬆自己的弦。不然就辜負了艾莉絲女士的一番美意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650119
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650119,
					"content": "欸！等等…你和酒保是怎麼說的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650120,
					"content": "當然是來一杯這個酒館最純正的飲品囉，這才能感受到不同世界的風土人情嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650121
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650121,
					"content": "噗嗤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650122,
					"content": "欸？派蒙妳這是什麼表情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650123
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650123,
					"content": "沒…沒什麼，我很欣賞你的生活方式，你喝，你快喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650124,
					"content": "嗯？那我是不是應該小心一下呢？這酒看起來色澤滿不錯的，味道…噗咳…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650125
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650125,
					"content": "嘻嘻嘻嘻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650126,
					"content": "我那杯就不喝了吧…但不喝會不會有些浪費…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650127
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401650127,
					"content": "好啊，派蒙，原來是這麼回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650128
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650128,
					"content": "我…我也是上過一次當的！不是在針對你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650129,
					"content": "對了，接到邀請的也不只我們，剛才我還見到了柯萊。她往那棵大樹的方向去了，我沒來得及叫她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650130
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650130,
					"content": "是鈴風王國那邊吧？嘿嘿，這麼多老朋友都來了，感覺就像聚會一樣呢。我們去和她打個招呼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401650131,
					"content": "嗯，也代我向她問個好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401650132,
						401650133
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401650132,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650134
					]
				},
				{
					"id": 401650134,
					"content": "#也祝{F#妳}{M#你}旅途愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 401650133,
					"content": "祝兩位休假愉快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401650134
					]
				}
			]
		},
