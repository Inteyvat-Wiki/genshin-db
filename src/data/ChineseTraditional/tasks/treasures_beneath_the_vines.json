				"points": []
			},
			"dialogs": [
				{
					"id": 736740101,
					"content": "小傢伙，不是你帶我來的嗎？來點作用，再動一動啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740102
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740102,
					"content": "唉，好吧，你就待著別動吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740103,
						736740104
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740103,
					"content": "你在做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740106
					]
				},
				{
					"id": 736740106,
					"content": "#唉，我這次算是又被這小傢伙給坑了…我從頭和{F#妳}{M#你}簡單說說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740107
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740107,
					"content": "#說出來{F#妳}{M#你}可能不太相信，但是我這人不知道為什麼，總是特別容易吸引仙靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740108
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740108,
					"content": "在那些過來跟著我不走的仙靈裡，我發現了一種特別熱衷於尋寶的仙靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740109
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740109,
					"content": "我也不會取名，就直接叫它們「尋寶仙靈」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740110
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740110,
					"content": "它們很擅長尋寶，在它們的幫助下，我也挖到了不少寶貝，小小地賺了一筆錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740111
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740111,
					"content": "但它們有時候會突然不搭理我，也不知道是尋寶累了，還是覺得我這個人沒什麼意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740112
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740112,
					"content": "這個時候，我一般就會找個能讓仙靈看順眼的幫手合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740113
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740113,
					"content": "他負責帶著「尋寶仙靈」尋寶，而我嘛…就負責把這些寶貝變現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740114
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740114,
					"content": "我之前聽人說，須彌這裡遍地遺蹟，滿地古玩，所以就想要過來撈一筆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740115
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740115,
					"content": "來了之後，我果然又吸引來了一堆仙靈，其中的幾個「尋寶仙靈」把我帶到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740116
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740116,
					"content": "但我沒挖幾鏟子，這些小傢伙又不搭理我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740117
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740117,
					"content": "咦？它怎麼突然動彈起來了？難道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740118
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740118,
					"content": "#旅行者，{F#妳}{M#你}對和仙靈一起尋寶這件事，有興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740119,
						736740120
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740119,
					"content": "我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740121,
					"content": "不用和它說話，只要跟著它走，看它停下了就往下挖，就這麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740122
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740122,
					"content": "#怎麼樣？{F#妳}{M#你}就試試看吧，嗯…如果{F#妳}{M#你}真找到了寶藏，我只要裡面的「古鐵錢」，其他的東西全都歸{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740123
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740123,
					"content": "#而且，要是{F#妳}{M#你}真能幫我找到一些「古鐵錢」，那我也會付給{F#妳}{M#你}相應的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740124,
						736740126
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740124,
					"content": "我可以試試…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740125
					]
				},
				{
					"id": 736740125,
					"content": "#爽快！我就喜歡{F#妳}{M#你}這種人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740130,
					"content": "總之，我們現在就是合作關係了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740131
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740131,
					"content": "#這個筆記本{F#妳}{M#你}先拿好，這是我之前找到的一些藏寶地，還沒來得及去挖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740132
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740132,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者。如果找到「古鐵錢」的話，記得帶回來給我啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740126,
					"content": "「古鐵錢」是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740127
					]
				},
				{
					"id": 736740127,
					"content": "簡單來說，就是一種另類的古董啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740128
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740128,
					"content": "只要找到好門路，我就能用這些「古鐵錢」換到不少好東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740129
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740129,
					"content": "雖然…現在我還沒有找到好門路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740130
					],
					"speakerTitle": "烏爾曼"
				},
				{
					"id": 736740120,
					"content": "我不會和仙靈說話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740121
					]
				},
				{
					"id": 736740104,
					"content": "這是…仙靈？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736740105
					]
				},
				{
					"id": 736740105,
					"content": "#{F#妳}{M#你}說這小傢伙？呃…就算它是吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736740106
					],
					"speakerTitle": "烏爾曼"
				}
			]
		},
