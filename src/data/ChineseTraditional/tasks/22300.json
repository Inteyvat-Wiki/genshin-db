			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慕勝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000101,
					"content": "這樣應該就可以了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000102
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000102,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000103
					]
				},
				{
					"id": 223000103,
					"content": "#我正在敬拜岩王爺呢。唔，看起來{F#妳}{M#你}不是本地人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000104
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000104,
					"content": "這裡是倚岩殿，是給岩王爺上香的地方，璃月港的人會經常來上炷香，討個吉利彩頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000105
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000105,
					"content": "但我住得很遠，不能經常來上香，所以每次都要多待點時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000106
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000106,
					"content": "不過，我也看了許多和岩王爺相關的典籍，越是看，越是能瞭解岩王爺的了不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000107
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000107,
					"content": "比起岩王爺為璃月港做的事，我只是多走了些路來上香，倒也沒什麼所謂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000108
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000108,
					"content": "#對了，{F#妳}{M#你}應該不太瞭解岩王爺吧，我倒是可以給{F#妳}{M#你}好好講講岩王爺的事蹟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000109
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000109,
					"content": "#但是，光是說{F#妳}{M#你}肯定也印象不深。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000110
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000110,
					"content": "#嗯…不如這樣，{F#妳}{M#你}去<color=#00E1FFFF>璃月港附近</color>找點東西來吧，我搭配著實物，來給{F#妳}{M#你}講一講岩王爺的事蹟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000111,
						223000113
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000111,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000112
					]
				},
				{
					"id": 223000112,
					"content": "#那麼，請{F#妳}{M#你}快去快回吧，我就在這等著{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000113,
					"content": "具體是什麼東西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223000114
					]
				},
				{
					"id": 223000114,
					"content": "#只要是和<color=#00E1FFFF>璃月港</color>，或者{F#妳}{M#你}覺得和<color=#00E1FFFF>岩王爺有關</color>的東西就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000115
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000115,
					"content": "不過，我知道的故事有限…也不能什麼都講出點緣由來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223000116
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223000116,
					"content": "#等{F#妳}{M#你}找到了之後，我們再具體看看，快點去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕勝"
				}
			]
		},
