					"慕勝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223008001,
					"content": "#哦…不知不覺，{F#妳}{M#你}已經聽我講了這麼多故事了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008002
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223008002,
					"content": "#怎麼樣，{F#妳}{M#你}感覺自己對岩王爺瞭解多少了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008003
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223008003,
					"content": "感覺瞭解了一些…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223008004
					]
				},
				{
					"id": 223008004,
					"content": "那就好，但岩王爺的故事可不止這些，下次有空的話，我們再講點其他的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008005
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223008005,
					"content": "#咦？{F#妳}{M#你}還整理了這麼多便條…{F#妳}{M#你}還真是認真啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008006
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223008006,
					"content": "#這樣，{F#妳}{M#你}先把這些便條給我吧，我看看什麼時候有空，再去整理一些故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008007
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223008007,
					"content": "#到時候，連同這些便條裡的故事一起，我整理一個筆記給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008008
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223008008,
					"content": "不過岩王爺的故事可有很多，我要好好整理一下，我看得花點時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223008009
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223008009,
					"content": "#這些東西先給{F#妳}{M#你}，請收下吧，謝謝{F#妳}{M#你}願意聽我講故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕勝"
				}
			]
		}
	]
