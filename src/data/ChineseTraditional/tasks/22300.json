				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223000301,
					"content": "嗯…這個故事就到這了，下次有機會，我們再講講其他的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
