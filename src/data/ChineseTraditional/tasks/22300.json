				}
			]
		},
		{
			"id": 2230010,
			"completionStepIds": [
				2230010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230010",
							"2"
						],
						"stepId": 2230010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慕勝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001001,
					"content": "#哈哈，是礦石啊，看來{F#妳}{M#你}還是很瞭解「岩」的意義嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001002
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001002,
					"content": "對於璃月港的先民們來說，除了冶煉用外，這些礦石在最開始，還有著更重要的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001003
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001003,
					"content": "在第一批先人們到達這裡，開始墾荒的時候，他們用石頭壘起了爐灶，又用石頭互相碰撞，點起了火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001004
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001004,
					"content": "有了火，就能做飯了，有了熱菜熱飯，人們才有力氣幹活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001005
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001005,
					"content": "這些都是來源於「石頭」，也就是岩王爺的恩賜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001006
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001006,
					"content": "於是，岩王爺在一部分典籍裡，就有了「爐灶之神」的名號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001007
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001007,
					"content": "那些剛剛開張的飯店酒肆，都會給岩王爺上香，祈禱他們的爐灶不熄，生意興隆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001008
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001008,
					"content": "#下次{F#妳}{M#你}去璃月港的飯店吃飯的時候，也不要忘記在心裡對岩王爺默念幾句啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕勝"
				}
			]
		},
		{
			"id": 2230011,
			"completionStepIds": [
				2230011
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230011",
							"2"
						],
						"stepId": 2230011,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慕勝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001101,
					"content": "#哦，這是{F#妳}{M#你}去野外採的嗎？一定花了不少功夫吧，辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001102
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001102,
					"content": "#嗯…{F#妳}{M#你}看到了吧，現在的璃月港規模很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001103
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001103,
					"content": "但是再大的城市，也是由微小的一磚一瓦建立起來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001104
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001104,
					"content": "在我們的祖先剛剛到達這片土地時，還沒有什麼「璃月港」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001105
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001105,
					"content": "是他們用汗水和勇氣，一點點向外開墾，將這座龐大的城市興建了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001106
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001106,
					"content": "#{F#妳}{M#你}也知道，璃月港附近多是凹凸不平的山岩，十分難以開墾。但是這些植物，依然頑強地在這些山岩中生長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001107
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001107,
					"content": "而這些各有用處的植物，則為那些向外開拓的先人們提供了極大的助力，人們認為，這是岩王爺給予人們的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001108
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001108,
					"content": "先人們的奮鬥事蹟一直在璃月港內流傳著。到現在，一部分從璃月港走出來的冒險家們，依然被這些事蹟所感染。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001109
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001109,
					"content": "除了繼承下先人們頑強的開拓精神外，他們還將岩王爺敬為「開拓之神」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001110
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001110,
					"content": "如同岩石一般堅強不屈的冒險家，這就是他們對於自己的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕勝"
				}
			]
		},
		{
			"id": 2230012,
			"completionStepIds": [
				2230012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230012",
							"2"
						],
						"stepId": 2230012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慕勝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001201,
					"content": "#嚯，這個東西{F#妳}{M#你}是從哪裡弄到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001202
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001202,
					"content": "我聽說，現在幾乎只有玉京臺能看見這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001203
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001203,
					"content": "#{F#妳}{M#你}也是有心了，為了聽岩王爺的故事，連這個都找來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001204
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001204,
					"content": "不過，這個「琉璃百合」倒是也直指璃月港的建城之本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001205
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001205,
					"content": "#不明白？{F#妳}{M#你}想想，「琉璃百合」的特徵是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001206
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001206,
					"content": "#對，貴重，「琉璃百合」非常貴重，能賣出一個非常好的價錢，讓{F#妳}{M#你}賺很多摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001207
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001207,
					"content": "而「摩拉」的命名，正是來源於岩王爺的另一個名字「摩拉克斯」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001208
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001208,
					"content": "所以，岩王爺在人們心中也是「財神」，無論是哪路商賈大家，出去做生意都要先拜拜岩王爺，給他上炷香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001209
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001209,
					"content": "因為岩王爺，是這個世界上最有錢的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001210
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001210,
					"content": "而且按我想，即使是在七神裡…岩王爺也一定是最有錢的神吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕勝"
				}
			]
		},
		{
			"id": 2230013,
			"completionStepIds": [
				2230013
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230013",
							"2"
						],
						"stepId": 2230013,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慕勝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223001301,
					"content": "#看來{F#妳}{M#你}也很愛好美食嘛。我們璃月港的美食確實都很不錯，有機會{F#妳}{M#你}一定要去好好嚐一嚐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001302
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001302,
					"content": "#和岩王爺有沒有關係？哈哈哈，{F#妳}{M#你}別說，在璃月港裡，很多飯館都打著「老店」的旗號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001303
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001303,
					"content": "#{F#妳}{M#你}要是去問證據，老闆們一準都說在之前的某年某月某日，岩王爺曾經在店裡特意點過哪碗菜，讚過哪碗湯的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001304
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001304,
					"content": "#這些傳說的真假先不論。但是{F#妳}{M#你}也能從這些傳說裡感覺到吧，岩王爺可是在璃月港裡待了很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001305
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001305,
					"content": "城裡研究璃月港歷史的老學者們，有的會說岩王爺是「此世最年長者」，將他作為「歷史之神」來崇敬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223001306
					],
					"speakerTitle": "慕勝"
				},
				{
					"id": 223001306,
					"content": "但是，岩王爺到底在這個世界上待了多久，我想大概誰也不清楚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕勝"
				}
			]
		},
		{
			"id": 2230080,
