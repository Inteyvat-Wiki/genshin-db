			"dialogs": [
				{
					"id": 4890301,
					"content": "甜甜花釀雞，已查收~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890302
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890302,
					"content": "#味道聞起來…還不錯呢，{F#妳}{M#你}的手藝還可以嘛，真是找對人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890303
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890303,
					"content": "#既然這樣…不如訂單裡的這份<color=#00E1FFFF>蜜醬胡蘿蔔煎肉</color>也交給{F#妳}{M#你}吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890304
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890304,
					"content": "<color=#00E1FFFF>蜜醬胡蘿蔔煎肉</color>！之前和安柏一起吃過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4890305,
					"content": "沒錯，這可是「獵鹿人」的招牌菜，是「獵鹿人」的驕傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890306
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890306,
					"content": "騎士團來聚餐的時候似乎常常會點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890307
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890307,
					"content": "#那現在就先把<color=#00E1FFFF>蜜醬胡蘿蔔煎肉</color>的食譜教給{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890308
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890308,
					"content": "等等，不是說這是「獵鹿人」的招牌菜嗎，就這樣教給我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4890309,
					"content": "#以{F#妳}{M#你}的手藝的話，應該不會砸了「獵鹿人」的招牌吧，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890310
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890310,
					"content": "那一份<color=#00E1FFFF>蜜醬胡蘿蔔煎肉</color>，等做好就端過來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		},
