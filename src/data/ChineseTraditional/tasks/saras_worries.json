			"dialogs": [
				{
					"id": 4890201,
					"content": "把食材帶回來了嗎？我瞧瞧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890202
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890202,
					"content": "嗯~沒錯，食材已經齊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890203
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890203,
					"content": "然後…7號訂單的一份<color=#00E1FFFF>甜甜花釀雞</color>，謝謝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890204
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890204,
					"content": "真把人家當廚子呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4890205,
					"content": "都說好要給「獵鹿人」幫忙了嘛，做好趁熱送過來哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		},
