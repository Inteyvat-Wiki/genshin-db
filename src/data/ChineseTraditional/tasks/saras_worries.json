			"trigger": {
				"objectNames": [
					"莎拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4890101,
					"content": "我知道啦，我馬上就出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4890102,
					"content": "是安柏！妳是來處理委託的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4890103,
					"content": "#哇，是{F#妳}{M#你}們。我正準備去呢，清理商路上的丘丘人什麼的，交給偵察騎士再合適不過了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890104
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4890104,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890105
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890105,
					"content": "莎拉小姐…為什麼還是很苦惱的樣子？放心啦，偵察騎士的實力不會讓妳失望的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4890106,
					"content": "哦、哦不是這樣的，我沒有懷疑妳的實力，只是現在的訂單實在太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890107
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890107,
					"content": "就在剛才，又新來了一份奇怪的訂單，看起來好像是要準備一整場宴會的量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890108
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890108,
					"content": "咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4890109,
					"content": "還有什麼可以幫忙的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890110
					]
				},
				{
					"id": 4890110,
					"content": "其實我也可以幫忙做飯！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4890111
					]
				},
				{
					"id": 4890111,
					"content": "#真的嗎！{F#妳}{M#你}願意幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890112
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890112,
					"content": "#太好了，{F#妳}{M#你}簡直就是「獵鹿人」的恩人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890113
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890113,
					"content": "唔…我怎麼覺得我的風頭被搶了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890114
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4890114,
					"content": "#那這份新的訂單就交給{F#妳}{M#你}了，先從收集食材開始吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890115
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890115,
					"content": "#可是…{NICKNAME}真的可以嗎，料理的口味什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4890116,
					"content": "顧不上那麼多啦，這可是事關「獵鹿人」聲譽的戰鬥，挑三揀四什麼的是不行的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890117
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890117,
					"content": "戰、戰鬥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4890118,
					"content": "料理需要<color=#00E1FFFF>三份甜甜花和三份禽肉</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890119
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890119,
					"content": "#好了快去準備吧，還有安柏小姐那邊也是，我在這裡等{F#妳}{M#你}們哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4890120
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4890120,
					"content": "哦…哦、哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
			]
		},
