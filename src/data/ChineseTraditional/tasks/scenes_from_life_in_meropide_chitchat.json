					{
						"sceneId": 3,
						"position": [
							4423.1,
							150.1,
							4652.613
						],
						"pointId": 6257
					}
				]
			},
			"dialogs": [
				{
					"id": 740620101,
					"content": "兩位、兩位請留步。聽說兩位是有求必應的閒人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620102,
						740620103
					],
					"speakerTitle": "納庫爾"
				},
				{
					"id": 740620102,
					"content": "確有此事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620105
					]
				},
				{
					"id": 740620105,
					"content": "咳！其實是此前，穿紫裙的女童拜託我多多關照兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620106
					],
					"speakerTitle": "納庫爾"
				},
				{
					"id": 740620106,
					"content": "我想兩位既然有求必應，想必是本領高強，哪裡有需要我來關照的道理。不如說，應該是兩位多關照關照我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620107
					],
					"speakerTitle": "納庫爾"
				},
				{
					"id": 740620107,
					"content": "關照可以，打折不行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620108
					]
				},
				{
					"id": 740620108,
					"content": "規矩我懂，這個好說。無論能不能成事，我都會按市場價支付報酬。此處摩拉無用，就以特許券計費。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620109
					],
					"speakerTitle": "納庫爾"
				},
				{
					"id": 740620109,
					"content": "不管結果如何都能拿到報酬？真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620110,
					"content": "千真萬確。事情就是這樣難辦，也怪尼扎米，拳頭厲害，但用錯地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620111
					],
					"speakerTitle": "納庫爾"
				},
				{
					"id": 740620111,
					"content": "我還要滯留一段時間，想找個適合治學的場所。最好有書架、有桌椅，有可供書寫和黏貼資料的板子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620112
					],
					"speakerTitle": "納庫爾"
				},
				{
					"id": 740620112,
					"content": "#{F#妳}{M#你}應該猜到我心中所想的地方了，但這地方借不得，理由多問無益。我想對面的一間理應構造相同，可堪一用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620113
					],
					"speakerTitle": "納庫爾"
				},
				{
					"id": 740620113,
					"content": "但那間蹊蹺得很，似乎是被某人霸佔了，且鮮少開門。我從未見過這個某人，也未見過開門的情景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620114
					],
					"speakerTitle": "納庫爾"
				},
				{
					"id": 740620114,
					"content": "於是我委派尼扎米作為代理，他原本是我雇傭的保鏢，一向辦事可靠。但他也與這個某人話不投機，交涉失敗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620115
					],
					"speakerTitle": "納庫爾"
				},
				{
					"id": 740620115,
					"content": "嗯…感覺交涉和談判應該不是他的長項呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620116,
					"content": "的確。那不是交涉與談判的場景，他在外面用拳頭捶門，從門裡傳出嚎叫。真讓我大開眼界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620117,
						740620119
					],
					"speakerTitle": "納庫爾"
				},
				{
					"id": 740620117,
					"content": "哇哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620118
					]
				},
				{
					"id": 740620118,
					"content": "這跟交涉根本就沾不上邊了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620121,
					"content": "所以想要拜託兩位作為代理，與這位某人交涉，讓他同意出借他現在佔用的空間。我的預期是…五萬四千特許券以內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620122
					],
					"speakerTitle": "納庫爾"
				},
				{
					"id": 740620122,
					"content": "不求成功，但求一試。有勞兩位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納庫爾"
				},
				{
					"id": 740620119,
					"content": "真不專業啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620120
					]
				},
				{
					"id": 740620120,
					"content": "他本來也不是這方面的專家吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620103,
					"content": "你聽誰說的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620104
					]
				},
				{
					"id": 740620104,
					"content": "這個嘛…閒言閒語，只是閒言閒語罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620105
					],
					"speakerTitle": "納庫爾"
				}
			]
		},
		{
			"id": 7406202,
