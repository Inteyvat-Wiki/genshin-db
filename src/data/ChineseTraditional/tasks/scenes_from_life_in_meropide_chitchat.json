					{
						"sceneId": 3,
						"position": [
							4345.289,
							158.024,
							4642.497
						],
						"pointId": 4927
					}
				]
			},
			"dialogs": [
				{
					"id": 740620301,
					"content": "（聽納庫爾的說法，不是楓丹本地人的話，好像會受排斥？他會不會也不願意理我們呀？有沒有什麼好辦法…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620302,
					"content": "（敲門。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620303
					]
				},
				{
					"id": 740620303,
					"content": "誰啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620304,
						740620306,
						740620309
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620304,
					"content": "無名的旅人，周遊各國的冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620305
					]
				},
				{
					"id": 740620305,
					"content": "…這裡什麼時候變成觀景點了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620312
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620312,
					"content": "#{NICKNAME}，認真一點啦！別忘了我們的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620313,
						740620378
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620313,
					"content": "我們受人委託有事找你商量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620314
					]
				},
				{
					"id": 740620314,
					"content": "事情是這樣，我們受人委託和你商量，不知道你願不願意租借這個房間？當然，委託人會支付特許券的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620315,
					"content": "#之前好像也發生過類似的事情…三番兩次的，還真是不死心啊！就是那個說話怪腔怪調的傢伙派{F#妳}{M#你}們來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620316
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620316,
					"content": "#算了，看在他鍥而不捨的份上…{F#妳}{M#你}們開個價吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620317
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620317,
					"content": "（太好了，看來也不是完全沒有溝通的餘地嘛！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620318,
					"content": "（納庫爾已經告訴我們他的心理預期，我們開價的話，要一開始就老實報出底線嗎？還是試試壓價？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620319,
						740620356
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620319,
					"content": "（誠實報出底線吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620320
					]
				},
				{
					"id": 740620320,
					"content": "好喔，那我就實話實說了。委託人的心理預期就是五萬四千特許券，我覺得是很划算啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620321,
					"content": "五萬四千？和上次捶門的瘋子的報價相比…只漲了一成。也沒漲多少嘛！真吝嗇啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620322
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620322,
					"content": "這還少嗎？我覺得已經很多了欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620323,
					"content": "#真沒見識啊！{F#妳}{M#你}們知道卡蘭薩嗎？他出手可闊綽多了，他願意出…出十萬八！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620324
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620324,
					"content": "真的嗎？這麼多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620326
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620326,
					"content": "…當、當然是真的。妳看我像會說謊的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620327
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620327,
					"content": "隔著門我們根本什麼都看不見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620328,
					"content": "（聽他說話不是很有底氣的樣子，說不定根本就是他編出來騙我們的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620329,
					"content": "#（{NICKNAME}，我們接下來要怎麼談呢？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620330,
						740620340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620330,
					"content": "（誠意就這麼多，要他不要太超過吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620331
					]
				},
				{
					"id": 740620331,
					"content": "我們一開始就實話實說了，只有五萬四千這麼多。十萬八也太誇張了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620332,
					"content": "如果你不願意的話，我們…我們好像也沒有別的好辦法，只能放棄了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620333,
					"content": "#只要再等等…再等等就會漲上去的。等{F#妳}{M#你}們下次，下下次來的時候，一定會帶來更高的報價！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620334
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620334,
					"content": "我是不會看錯走勢的！一定會漲！所以我得忍住！不能這麼輕易就同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620335
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620335,
					"content": "你說得這麼篤定，是有什麼根據嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620336,
					"content": "那當然是經驗！前兩次的經驗告訴我，只要我不打斷，上升的趨勢就會繼續，這不是很簡單的道理嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620337
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620337,
					"content": "這是哪門子的道理啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620338,
					"content": "#妳是小孩子，當然不懂。總之，現在還不是時候，我是不會鬆口的，{F#妳}{M#你}們走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620339
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620339,
					"content": "#呃…看來他是不會改變心意了。{NICKNAME}，我們回去告訴納庫爾吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620340,
					"content": "（他想算計我們，那就用這招對付他。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620341
					]
				},
				{
					"id": 740620341,
					"content": "嗚嗚…沒想到有卡蘭薩這麼強的競爭對手，不管怎麼想都比不過嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620342,
					"content": "#{NICKNAME}，我們這就走吧，回去告訴納庫爾，他的出價太低，人家根本看不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620343,
					"content": "門那頭的先生，祝你和卡蘭薩聊得開心。我們先告辭了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620344
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620344,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620345,
					"content": "…欸？這就走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620346
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620346,
					"content": "#喂，{F#妳}{M#你}們還在嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620347
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620347,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620348
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620348,
					"content": "#喂——先別急著走啊——{F#妳}{M#你}們回來一下——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620349
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620349,
					"content": "大老遠就聽到你喊我們，怎麼啦，是想要讓我們幫你把卡蘭薩喊過來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620350
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620350,
					"content": "#那怎麼好意思，太麻煩{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620351
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620351,
					"content": "#不麻煩不麻煩，反正是順路，對吧，{NICKNAME}？這點小忙只是舉手之勞而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620352
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620352,
					"content": "#咳咳…妳這小傢伙還滿壞心眼。說正經的，{F#妳}{M#你}們剛才的報價還算數嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620353
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620353,
					"content": "現在還算，但等等就不知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620354
					]
				},
				{
					"id": 740620354,
					"content": "#好吧，我認了，那就這個數字吧。不過，讓{F#妳}{M#你}們的委託人親自來談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620355
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620355,
					"content": "#好欸！{NICKNAME}，我們回去告訴納庫爾吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620356,
					"content": "（狠狠地壓價！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620357
					]
				},
				{
					"id": 740620357,
					"content": "那…那就兩萬七！兩萬七特許券你看怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620358
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620358,
					"content": "#兩萬七？！開什麼玩笑，{F#妳}{M#你}們是特地來羞辱我的嗎？怎麼比之前還少了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620359
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620359,
					"content": "#那個捶門的瘋子帶來的報價高得多了我都沒答應，怎麼可能答應{F#妳}{M#你}們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620360
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620360,
					"content": "#（{NICKNAME}，怎麼辦，我們還要堅持這個數目嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620361,
						740620370
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620361,
					"content": "行情在跌，之後只會跌得更厲害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620362
					]
				},
				{
					"id": 740620362,
					"content": "真的假的？納庫爾不是很想要這個房間嗎？他肯定願意出高價的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620363
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620363,
					"content": "這個嘛…畢竟人的耐心都是有限的！你之前都那麼過分地拒絕兩次了，說不定他心灰意冷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620364
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620364,
					"content": "這次是一半，說不定下次就…哦！說不定根本沒有下次了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620365
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620365,
					"content": "…我考慮一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620366
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620366,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620367
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620367,
					"content": "喂喂！門那頭的先生，你考慮好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620368
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620368,
					"content": "#好吧，我認了，那就這個數字吧。不過，讓{F#妳}{M#你}們的委託人親自來談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620369
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620369,
					"content": "#好欸！{NICKNAME}，我們回去告訴納庫爾吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620370,
					"content": "（抬到委託人的心理預期價位吧？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620371
					]
				},
				{
					"id": 740620371,
					"content": "嗯…那五萬四特許券呢？比兩萬七整整多出一倍呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620372
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620372,
					"content": "五萬四千？和上次捶門的瘋子的報價相比…只漲了一成。也沒漲多少嘛！真吝嗇啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620373
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620373,
					"content": "#而且{F#妳}{M#你}們這幫人的開價忽高忽低的…我看一定是還有上漲空間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620374
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620374,
					"content": "#只要再等等…再等等就會漲上去的。等{F#妳}{M#你}們下次，下下次來的時候，一定會帶來更高的報價！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620375
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620375,
					"content": "我是不會看錯走勢的！一定會漲！所以我得忍住！不能這麼輕易就同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620376
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620376,
					"content": "#{F#妳}{M#你}們走吧。我不會同意的，至少這次不會同意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620377
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620377,
					"content": "#呃…看來他是不會改變心意了。{NICKNAME}，我們回去告訴納庫爾吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620378,
					"content": "（嘗試開門。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620379
					]
				},
				{
					"id": 740620379,
					"content": "#…喂！{F#妳}{M#你}、{F#妳}{M#你}想幹什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620380
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620380,
					"content": "想要開門？這樣隔著門說話都看不到對方的表情欸，要談事情的話，當然還是面對面說話比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620381
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620381,
					"content": "而且梅洛彼得堡的房間不是誰的私有物吧？只是暫住的話，我們應該也能進去才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620382
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620382,
					"content": "#不行！當然不行！{F#妳}{M#你}們根本不懂…根本不懂門後隱藏著怎樣的黑暗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620383
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620383,
					"content": "#呃…我是說，我和人四目相對的話就會緊張得說不出話來。我們還是隔著門交流吧！{F#妳}{M#你}們到底有什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620384,
						740620449
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620384,
					"content": "我們受人委託有事找你商量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620385
					]
				},
				{
					"id": 740620385,
					"content": "嗯，我們受人委託和你商量，不知道你願不願意租借這個房間？當然，委託人會支付特許券的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620386
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620386,
					"content": "#之前好像也發生過類似的事情…三番兩次的，還真是不死心啊！就是那個說話怪腔怪調的傢伙派{F#妳}{M#你}們來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620387
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620387,
					"content": "#算了，看在他鍥而不捨的份上…{F#妳}{M#你}們開個價吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620388
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620388,
					"content": "（太好了，看來也不是完全沒有溝通的餘地嘛！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620389
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620389,
					"content": "（納庫爾已經告訴我們他的心理預期，我們開價的話，要一開始就老實報出底線嗎？還是試試壓價？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620390,
						740620427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620390,
					"content": "（誠實報出底線吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620391
					]
				},
				{
					"id": 740620391,
					"content": "好喔，那我就實話實說了。委託人的心理預期就是五萬四千特許券，我覺得是很划算啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620392
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620392,
					"content": "五萬四千？和上次捶門的瘋子的報價相比…只漲了一成。也沒漲多少嘛！真吝嗇啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620393
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620393,
					"content": "這還少嗎？我覺得已經很多了欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620394
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620394,
					"content": "#真沒見識啊！{F#妳}{M#你}們知道卡蘭薩嗎？他出手可闊綽多了，他願意出…出十萬八！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620395
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620395,
					"content": "真的嗎？這麼多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620396
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620396,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620397
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620397,
					"content": "…當、當然是真的。妳看我像會說謊的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620398
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620398,
					"content": "隔著門我們根本什麼都看不見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620399
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620399,
					"content": "（聽他說話不是很有底氣的樣子，說不定根本就是他編出來騙我們的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620400
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620400,
					"content": "#（{NICKNAME}，我們接下來要怎麼談呢？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620401,
						740620411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620401,
					"content": "（誠意就這麼多，要他不要太超過吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620402
					]
				},
				{
					"id": 740620402,
					"content": "我們一開始就實話實說了，只有五萬四千這麼多。十萬八也太誇張了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620403,
					"content": "如果你不願意的話，我們…我們好像也沒有別的好辦法，只能放棄了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620404,
					"content": "#只要再等等…再等等就會漲上去的。等{F#妳}{M#你}們下次，下下次來的時候，一定會帶來更高的報價！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620405
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620405,
					"content": "我是不會看錯走勢的！一定會漲！所以我得忍住！不能這麼輕易就同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620406
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620406,
					"content": "你說得這麼篤定，是有什麼根據嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620407,
					"content": "那當然是經驗！前兩次的經驗告訴我，只要我不打斷，上升的趨勢就會繼續，這不是很簡單的道理嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620408
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620408,
					"content": "這是哪門子的道理啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620409,
					"content": "#妳是小孩子，當然不懂。總之，現在還不是時候，我是不會鬆口的，{F#妳}{M#你}們走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620410
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620410,
					"content": "#呃…看來他是不會改變心意了。{NICKNAME}，我們回去告訴納庫爾吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620411,
					"content": "（既然他想算計我們，那就用這招對付他。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620412
					]
				},
				{
					"id": 740620412,
					"content": "嗚嗚…沒想到有卡蘭薩這麼強的競爭對手，不管怎麼想都比不過嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620413,
					"content": "#{NICKNAME}，我們這就走吧，回去告訴納庫爾，他的出價太低，人家根本看不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620414,
					"content": "門那頭的先生，祝你和卡蘭薩聊得開心。我們先告辭了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620415,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620416,
					"content": "…欸？這就走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620417
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620417,
					"content": "#喂！{F#妳}{M#你}們還在嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620418
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620418,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620419,
					"content": "#喂——先別急著走啊——{F#妳}{M#你}們回來一下——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620420
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620420,
					"content": "大老遠就聽到你喊我們，怎麼啦，是想要讓我們幫你把卡蘭薩喊過來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620421,
					"content": "#那怎麼好意思，太麻煩{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620422
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620422,
					"content": "#不麻煩不麻煩，反正是順路，對吧，{NICKNAME}？這點小忙只是舉手之勞而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620423,
					"content": "#咳咳…妳這小傢伙還滿壞心眼。說正經的，{F#妳}{M#你}們剛才的報價還算數嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620424
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620424,
					"content": "現在還算，但等等就不知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620425
					]
				},
				{
					"id": 740620425,
					"content": "#好吧，我認了，那就這個數字吧。不過，讓{F#妳}{M#你}們的委託人親自來談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620426
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620426,
					"content": "#好欸！{NICKNAME}，我們回去告訴納庫爾吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620427,
					"content": "（狠狠地壓價！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620428
					]
				},
				{
					"id": 740620428,
					"content": "那…那就兩萬七！兩萬七特許券你看怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620429,
					"content": "#兩萬七？！開什麼玩笑，{F#妳}{M#你}們是特地來羞辱我的嗎？怎麼比之前還少了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620430
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620430,
					"content": "#那個捶門的瘋子帶來的報價高得多了我都沒答應，怎麼可能答應{F#妳}{M#你}們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620431
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620431,
					"content": "#（{NICKNAME}，怎麼辦，我們還要堅持這個數目嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620432,
						740620441
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620432,
					"content": "行情在跌，之後只會跌得更厲害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620433
					]
				},
				{
					"id": 740620433,
					"content": "真的假的？納庫爾不是很想要這個房間嗎？他肯定願意出高價的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620434
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620434,
					"content": "這個嘛…畢竟人的耐心都是有限的！你之前都那麼過分地拒絕兩次了，說不定他心灰意冷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620435
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620435,
					"content": "這次是一半，說不定下次就…哦！說不定根本沒有下次了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620436,
					"content": "…我考慮一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620437
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620437,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620438
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620438,
					"content": "喂喂！門那頭的先生，你考慮好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620439
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620439,
					"content": "#好吧，我認了，那就這個數字吧。不過，讓{F#妳}{M#你}們的委託人親自來談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620440
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620440,
					"content": "#好欸！{NICKNAME}，我們回去告訴納庫爾吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620441,
					"content": "（那就抬到委託人的心理預期價位吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620442
					]
				},
				{
					"id": 740620442,
					"content": "嗯…那五萬四特許券呢？比兩萬七整整多出一倍呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620443,
					"content": "五萬四千？和上次捶門的瘋子的報價相比…只漲了一成。也沒漲多少嘛！真吝嗇啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620444
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620444,
					"content": "#而且{F#妳}{M#你}們這幫人的開價忽高忽低的…我看一定是還有上漲空間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620445
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620445,
					"content": "#只要再等等…再等等就會漲上去的。等{F#妳}{M#你}們下次，下下次來的時候，一定會帶來更高的報價！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620446
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620446,
					"content": "我是不會看錯走勢的！一定會漲！所以我得忍住！不能這麼輕易就同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620447
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620447,
					"content": "#{F#妳}{M#你}們走吧。我不會同意的，至少這次不會同意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620448
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620448,
					"content": "#呃…看來他是不會改變心意了。{NICKNAME}，我們回去告訴納庫爾吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620449,
					"content": "（繼續嘗試開門。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620450
					]
				},
				{
					"id": 740620450,
					"content": "#天哪！{F#妳}{M#你}怎麼還不停手？我都說了，{F#妳}{M#你}們根本不懂門後隱藏著怎樣的黑暗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620451
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620451,
					"content": "不面對面交流我怎麼知道你是真人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620452
					]
				},
				{
					"id": 740620452,
					"content": "#我當然是真人…而且，就算不是真人又有什麼關係？就像我也不知道{F#妳}{M#你}們是不是真實存在的，我們不也一樣在交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620453,
						740620455
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620453,
					"content": "我可以捏派蒙的臉，她看起來很真實。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620454
					]
				},
				{
					"id": 740620454,
					"content": "#好吧，看來{F#妳}{M#你}們可以互相證明彼此的真實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620458
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620458,
					"content": "#不管怎麼說，我是不會開門的，勸{F#妳}{M#你}們也不要做這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620459
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620459,
					"content": "欸…可是我們受人委託和你商量，希望你能出借這個房間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620460
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620460,
					"content": "那只好請他放棄了。與黑暗為伍的人有我一個就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620461
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620461,
					"content": "從剛才開始就在說黑暗黑暗的，到底是說什麼東西呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620462
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620462,
					"content": "聽妳說話的聲音像小孩子，小孩子不會懂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620463
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620463,
					"content": "哼，我覺得根本就是你在故弄玄虛，想糊弄我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620464
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620464,
					"content": "#哈哈，也有這種可能。不過我該說的已經說完了，門是不會打開的，出借房間的請求也是不會答應的。{F#妳}{M#你}們請回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620465
					],
					"speakerTitle": "某人"
				},
				{
					"id": 740620465,
					"content": "門後的聲音消失了。\\n等待了一段時間，又敲了敲門，也沒有任何回應。就好像一開始就沒有任何人存在。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740620466
					]
				},
				{
					"id": 740620466,
					"content": "欸？他好像真的不理我們了…我們是不是把委託給搞砸了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740620467
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620467,
					"content": "唔，不管怎麼說，先回去告訴納庫爾吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740620455,
					"content": "也許我只是某人夢裡的角色。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740620456
					]
				},
				{
					"id": 740620456,
					"content": "#那會是我的夢嗎？我聽過{F#妳}{M#你}們的聲音…我聽到{F#妳}{M#你}們和一個活潑的小女孩交談的聲音。",
