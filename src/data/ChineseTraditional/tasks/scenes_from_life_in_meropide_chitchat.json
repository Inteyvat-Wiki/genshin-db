				"points": []
			},
			"dialogs": [
				{
					"id": 740620201,
					"content": "要是之前沒惹惱卡蘭薩就好了，說不定和他交涉反而更輕鬆呢？唉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納庫爾"
				}
			]
		},
		{
