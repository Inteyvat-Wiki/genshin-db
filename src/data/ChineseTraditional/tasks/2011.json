			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"北斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110301,
					"content": "#喲，{F#妳}{M#你}們終於來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110302
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110302,
					"content": "#過去連暴風雨都沒法讓「南十字船隊」耽擱，這次我可是給足了{F#妳}{M#你}們面子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110303,
						20110304
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110303,
					"content": "久等了，大姐頭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				},
				{
					"id": 20110305,
					"content": "#哈哈哈，玩笑話而已。{F#妳}{M#你}們來得正好，出海工作剛剛就緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110306
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110306,
					"content": "既然人都到齊了，也是時候——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110307
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110307,
					"content": "朝著雷霆驟雨所包圍的「永恆」國度，起航！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110308
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110308,
					"content": "出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110304,
					"content": "榮幸之至！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110305
					]
				}
			]
		},
		{
			"id": 201107,
			"completionStepIds": [
				201107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201107",
							"2"
						],
						"stepId": 201107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"托馬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110701,
					"content": "終於來了，「璃月人的大姐頭」，可真是讓我望穿秋水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110702
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20110702,
					"content": "還有這兩位偷渡客…哦不，貴客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110703
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20110703,
					"content": "噓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110704,
					"content": "還不是因為你們的將軍大人，最近稻妻外海的雷暴和風浪比之前還要強烈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110705
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110705,
					"content": "我的船隊儘管大顯身手了一番，但還是耽誤了些時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110706
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110706,
					"content": "#哦對了，給{F#妳}{M#你}們介紹一下，這位是托馬，算是我最近才熟絡的商業夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110707
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110707,
					"content": "#喲，我一直很期待見到{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110708
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20110708,
					"content": "托馬，這兩位是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110709
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110709,
					"content": "不用介紹了，異鄉旅人的名望，可是外海的暴風雨都攔不住的，早就如雷貫耳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110710,
						20110711
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20110710,
					"content": "你好，托馬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110712
					]
				},
				{
					"id": 20110712,
					"content": "你說話真好聽，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110713,
					"content": "嗯，這樣倒也方便了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110714
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110714,
					"content": "#{NICKNAME}，托馬在離島混跡了很長一段時間了，說他是這裡的地頭蛇也不為過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110715
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110715,
					"content": "#如果有什麼難處就找他吧，但如果他對{F#妳}{M#你}圖謀不軌…等下次來稻妻，我會替{F#妳}{M#你}出頭的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110716
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110716,
					"content": "哈哈哈…放心放心，我有預感我們會相處很愉快的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110717
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20110717,
					"content": "那時間差不多了，畢竟我的船上還藏了個「通緝犯」，不方便久留。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110718
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110718,
					"content": "是說萬葉呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110719,
					"content": "#下次再見吧，旅行者，不管{F#妳}{M#你}在稻妻遇上什麼「驚濤駭浪」，都要好好給我捱過去啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110720,
						20110721
					],
					"speakerTitle": "北斗"
				},
				{
					"id": 20110720,
					"content": "我可是自信滿滿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110722
					]
				},
				{
					"id": 20110722,
					"content": "拜拜，一路順風，北斗船長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110723,
					"content": "那麼，還是先去監察站登記一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110724
					],
