			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20110101,
					"content": "#旅行者，有什麼可以幫{F#妳}{M#你}的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110102,
						20110103
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 20110102,
					"content": "關於前往稻妻的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				},
				{
					"id": 20110104,
					"content": "#嗯，我聽說了，{F#妳}{M#你}們和南十字船隊的大姐頭約好了，她會帶{F#妳}{M#你}們前往稻妻是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110105
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 20110105,
					"content": "確實已經過去滿久了，我這邊倒也沒有什麼值得注意的情報…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110106
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 20110106,
					"content": "#終於找到{F#妳}{M#你}了！{F#妳}{M#你}就是大姐頭看好的那個旅行者吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110107,
						20110109
					],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110107,
					"content": "等很久了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110108
					]
				},
				{
					"id": 20110108,
					"content": "是嗎哈哈，可真是榮幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110110
					],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110110,
					"content": "我們船隊的補給工作已經做得差不多了，到了清點人頭的環節了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110111
					],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110111,
					"content": "#大姐頭派我來找{F#妳}{M#你}，說等{F#妳}{M#你}一到就開船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110112
					],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110112,
					"content": "北斗果然是個很守約的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110113,
					"content": "#那是當然的，大姐頭身上讓人死心塌地的地方可多得是。等出了航，{F#妳}{M#你}們就慢慢體會吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110114
					],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110114,
					"content": "#兩位這就準備離開了嗎？還是要恭喜{F#妳}{M#你}們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110115
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 20110115,
					"content": "不論前路是星辰還是深淵，能向前邁出下一步都是值得慶賀的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110116
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 20110116,
					"content": "#那我們就再見吧，祝{F#妳}{M#你}們一路順風~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110117,
						20110118
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 20110117,
					"content": "凱瑟琳小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110119,
					"content": "是啊，有些捨不得，畢竟我們幾乎天天都會見面呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110120,
					"content": "#呵呵，既然如此，到了稻妻就快點找到我喔。我會在鳴神島等著{F#妳}{M#你}們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110121,
						20110122
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 20110121,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110123,
					"content": "果然稻妻也有一個凱瑟琳小姐嗎！那就不要這麼鄭重其事地告別啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110124,
					"content": "#哈哈，跟璃月好好道別一下吧，船還停在孤雲閣附近。既然通知到了{F#妳}{M#你}們，我就先回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110125
					],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110125,
					"content": "嗯，辛苦你跑一趟了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20110126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20110126,
					"content": "沒什麼，咱們船上見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海龍"
				},
				{
					"id": 20110122,
					"content": "…我就知道！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110123
					]
				},
				{
					"id": 20110118,
					"content": "我們會想念妳的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110119
					]
				},
				{
					"id": 20110109,
					"content": "情報送上門來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110110
					]
				},
				{
					"id": 20110103,
					"content": "關於南十字船隊的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20110104
					]
				}
			]
		},
		{
			"id": 201103,
			"completionStepIds": [
				201103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
