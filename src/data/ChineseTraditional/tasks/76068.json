			"dialogs": [
				{
					"id": 760680101,
					"content": "艾莉亞，看來，妳也已經為自己選好了屬於「人」的姿態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680102
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 760680102,
					"content": "呵呵，妳的模樣也很符合我的預想呢，卡儂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680103
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 760680103,
					"content": "不過，我沒有想到的是妳居然也會為那些可愛的小生命，主動創造出這樣的形體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680104
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 760680104,
					"content": "這是理所應當的，艾莉亞。那些脆弱的生命信任我、呼喚我，我便會回應他們的聲音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680105
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 760680105,
					"content": "我們為維繫世界而誕生。若是名為「人」的生命願意在我們的世界定居，聆聽他們的呼求，便也是王賦予我們的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680106
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 760680106,
					"content": "嗯，畢竟王說過，凡是星海間的生命，都是與我們共同對抗漆黑的盟友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680107
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 760680107,
					"content": "不過我要說的不是那個。我是說，沒想到「霜月」居然也會表現出這樣感性的一面。很可愛呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680108
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 760680108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680109
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 760680109,
					"content": "…我能看出妳的語言已經開始被那些小小的人類影響了，艾莉亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680110
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 760680110,
					"content": "他們的詞語總是像這般含糊。不要用。我完全無法理解妳說的「可愛」究竟想要表達什麼含義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680111
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 760680111,
					"content": "哎呀，好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680112
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680112,
					"content": "艾莉亞姐姐、卡儂姐姐，為自己捏出這樣的形體，第一件事難道不應該是偷偷溜出去，和那些地上的人們一起玩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680113
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680113,
					"content": "要不然不是白捏了嘛！快點快點，趁著沒人發現——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680114
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680114,
					"content": "呵呵，看來我們親愛的妹妹已經等不及了，卡儂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680115
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 760680115,
					"content": "他們剛開始在地上建起文明的時候，妳還說「那個外來者不是什麼好東西，它的造物當然也一樣」，看都不願意看一眼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680116
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 760680116,
					"content": "那、那是不一樣的事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680117
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680117,
					"content": "我現在也覺得姐姐們不該把那個外來者放進來，但地上的人們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680118
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680118,
					"content": "哈…妳們玩得開心就好。去吧，記得跟緊艾莉亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680119
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 760680119,
					"content": "嗯？卡儂姐姐不和我們一起去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680120
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680120,
					"content": "那位降臨者的從者說是要找我談一些事——關於這個世界的重力位與度量{RUBY#[D]時間規則}張量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680121
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 760680121,
					"content": "伊斯塔露？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680122
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 760680122,
					"content": "應該是這個名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680123
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 760680123,
					"content": "要好好記住別人的名字啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680124
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 760680124,
					"content": "不過，也許是我的錯覺，但我總覺得，她對那位降臨者似乎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680125
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 760680125,
					"content": "我不會過早判斷，艾莉亞。但我會留意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680126
					],
					"speakerTitle": "卡儂"
				},
				{
					"id": 760680126,
					"content": "嗯，那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680127
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 760680127,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680128
					],
					"speakerTitle": "桑娜妲"
				},
				{
					"id": 760680128,
					"content": "呵呵，沒什麼。那我們就先走啦，卡儂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680129
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 760680129,
					"content": "放心吧，我和桑娜妲妹妹會為妳帶禮物回來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760680130
					],
					"speakerTitle": "艾莉亞"
				},
				{
					"id": 760680130,
					"content": "…我不需要禮物。妳們當心別被認出來就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡儂"
				}
			]
		}
	]
}