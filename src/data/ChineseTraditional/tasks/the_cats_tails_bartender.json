			"trigger": {
				"objectNames": [
					"寧錄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191010101,
					"content": "真不錯…這「貓尾酒館」的酒真不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010102
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010102,
					"content": "什麼酒館？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010103
					]
				},
				{
					"id": 191010103,
					"content": "#咦？呃…是旅行者啊，{F#妳}{M#你}…{F#妳}{M#你}不知道「貓尾酒館」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010104
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010104,
					"content": "#看{F#妳}{M#你}的樣子，一定沒聽說過，也沒光顧過…欸，{F#妳}{M#你}虧大了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010105
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010105,
					"content": "#「貓尾酒館」裡面可是有不少奇妙特調，這些特調的味道{F#妳}{M#你}絕對從未嘗試過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010106
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010106,
					"content": "而且，「貓尾酒館」就和它的名字一樣，裡面還有很多，很多的可愛小貓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010107
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010107,
					"content": "在那麼多可愛小貓的圍繞下，喝著美味的特調酒…總是會讓人不由自主地忘記時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010108,
						191010109
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010108,
					"content": "現在「貓尾酒館」在營業中嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				},
				{
					"id": 191010110,
					"content": "#呃…可是{F#妳}{M#你}看起來，好像還沒到可以喝酒的年紀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010111
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010111,
					"content": "不過沒關係，沒關係！那位叫做迪奧娜的調酒師，可是蒙德城最棒的調酒師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010112
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010112,
					"content": "#給{F#妳}{M#你}調一杯不含酒的飲品…對她來說應該是小事一樁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010113
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010113,
					"content": "而且，那位叫做迪奧娜的調酒師也很可愛，就像是隻小貓一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010114
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010114,
					"content": "#嗝…嗝！說出來了，不行不行，{F#妳}{M#你}、{F#妳}{M#你}可別告訴迪奧娜，我說過這個詞啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010115
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010115,
					"content": "#不囉嗦了，{F#妳}{M#你}要是想去「貓尾酒館」的話，酒館的門就在後面，{F#妳}{M#你}直接過去就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191010116
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010116,
					"content": "我…呃！我去旁邊醒醒酒，之前喝了太多，看來喝不動第五輪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						0
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 191010109,
					"content": "我也想去試試…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191010110
					]
				}
			]
		}
	]
}