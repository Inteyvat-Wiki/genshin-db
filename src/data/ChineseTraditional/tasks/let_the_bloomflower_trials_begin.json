				"points": []
			},
			"dialogs": [
				{
					"id": 756640101,
					"content": "#{NICKNAME}和派蒙！哈哈，終於見到真人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640102
					],
					"speakerTitle": "巴羅"
				},
				{
					"id": 756640102,
					"content": "#歡迎來到榮花演武的主會場。我已經聽首領們說過了，{F#妳}{M#你}們是來報名參賽的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640103
					],
					"speakerTitle": "巴羅"
				},
				{
					"id": 756640103,
					"content": "是呀！不過我們還不是很瞭解，比賽的具體內容是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756640104,
					"content": "#既然這樣，由我來為{F#妳}{M#你}們簡單介紹一下規則吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640105
					],
					"speakerTitle": "巴羅"
				},
				{
					"id": 756640105,
					"content": "首先呢，榮花演武會分成「進攻戰」和「守備戰」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640106
					],
					"speakerTitle": "巴羅"
				},
				{
					"id": 756640106,
					"content": "守備戰很好理解嘛，就是阻止對手進攻部族。進攻戰要複雜一些，它是假定部族已經失守，現在要吹響反攻的號角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640107
					],
					"speakerTitle": "巴羅"
				},
				{
					"id": 756640107,
					"content": "為了讓比賽更有趣味性，我們製作了特殊的儀式道具。進攻方需要為它積蓄能量，破壞掉對手的特殊結界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640108
					],
					"speakerTitle": "巴羅"
				},
				{
					"id": 756640108,
					"content": "還有，即使是比賽，我們也不想見到純粹的暴力與衝突。打壞的東西要重新修好，另外遇到魔物也請及時清剿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640109
					],
					"speakerTitle": "巴羅"
				},
				{
					"id": 756640109,
					"content": "#嗚哇…我已經有點聽暈了。{NICKNAME}，{F#妳}{M#你}記住了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756640110,
						756640111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756640110,
					"content": "差不多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756640112
					]
				},
				{
					"id": 756640112,
					"content": "沒關係，有什麼問題都可以來問我。而且比賽並不複雜，親身參與幾次，很快就能掌握要領。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴羅"
				},
				{
					"id": 756640111,
					"content": "沒記住…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756640112
					]
				}
			]
		}
	]
}