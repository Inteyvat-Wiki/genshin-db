						"position": [
							-1373.609,
							169.233,
							7665.231
						],
						"pointId": 350400243
					}
				]
			},
			"dialogs": [
				{
					"id": 755050101,
					"content": "是希諾寧！妳居然在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050102,
					"content": "嗨，是派蒙和旅行者啊。怎麼了？在家門口看到我很奇怪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050103
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050103,
					"content": "不是啦，因為剛剛解決了那麼大的問題，我還以為妳會找一棵漂亮的樹，用力躺個幾天說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050104,
					"content": "哈哈，我是有那樣想過，但現在大家還在忙著重建工作，這時候偷懶不太像話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050105
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050105,
					"content": "所以妳在這裡工作嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050106
					]
				},
				{
					"id": 755050106,
					"content": "#喏，給{F#妳}{M#你}們看個東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050107
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050107,
					"content": "哇！好漂亮的寶石！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050108,
						755050110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050108,
					"content": "看起來很珍貴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050109
					]
				},
				{
					"id": 755050109,
					"content": "沒錯，但不只這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050112,
					"content": "這是最近才開始在市場流通的異紋燃素蜜珠，燃素蜜珠原本只是燃素蜜蟲產的小玩意，那些很常見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050113
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050113,
					"content": "但這種異紋的燃素蜜珠卻很新奇，數量也不多，所以價格不菲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050114
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050114,
					"content": "這個我懂…我們在野外找寶箱的時候，也喜歡那種花紋看起來很厲害的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050115,
					"content": "呵呵，所以我也稍微買了幾枚回來收藏，結果沒過幾天，我養在旁邊的盆栽卻枯萎了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050116
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050116,
					"content": "一開始我沒有很在意，我本來就搞不懂怎麼養綠植，但後來我聽卡齊娜說族裡有些人生病了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050117
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050117,
					"content": "病人大多是夏溫寶石店的顧客，老闆夏溫自己也不例外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050118
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050118,
					"content": "啊？這樣想的話…難道和這顆寶石有關？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050119,
					"content": "我也猜是這樣，所以我砸碎了一顆蜜珠，發現裡面居然包裹著一些深淵能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050120
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050120,
					"content": "這些深淵能量的濃度非常低，又被蜜珠外殼隔絕，所以幾乎察覺不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050121
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050121,
					"content": "那病人現在怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050122
					]
				},
				{
					"id": 755050122,
					"content": "安心，因為濃度實在不高，所以大家的病情普遍不嚴重，多半是一些嗜睡、容易疲勞的症狀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050123
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050123,
					"content": "像我和卡齊娜這樣體能比較好的完全沒影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050124
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050124,
					"content": "噢…還好是史級危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050125,
					"content": "史級？史詩級？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050126
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050126,
					"content": "我猜是史萊姆級。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050127
					]
				},
				{
					"id": 755050127,
					"content": "#嘿嘿，還是{F#妳}{M#你}懂我。就是像史萊姆那樣只能威脅到普通人的等級。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050128,
					"content": "#哈哈，{F#妳}{M#你}們兩個真有默契。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050129
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050129,
					"content": "話說回來，我們也有遇過不少被史萊姆嚇到瑟瑟發抖的人，所以這種危險也不能放著不管吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050130,
					"content": "沒錯，我已經向首領說明情況，請他把市場上的異紋蜜珠收集起來集中銷毀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050131
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050131,
					"content": "還有源頭也必須處理乾淨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050132
					]
				},
				{
					"id": 755050132,
					"content": "#我跟{F#妳}{M#你}的想法一樣。前面說過，燃素蜜珠是燃素蜜蟲產的東西，所以我猜問題的源頭就在牠們身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050133
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050133,
					"content": "我就去找了基尼奇，他在調查這方面比較在行。昨天他傳來消息，的確有發現被深淵汙染的蜜蟲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050134
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050134,
					"content": "除了這裡，「懸木人」和「流泉之眾」附近也有牠們的蹤跡。嗯，他也順便通知瑪拉妮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050135
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050135,
					"content": "不過他們的族人對寶石不怎麼熱衷，所以影響更小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050136
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050136,
					"content": "原來是這樣…看來深淵衍生出的問題還沒有完全解決，要耐心處理才可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050137,
					"content": "那你們打算怎麼處理蜜蟲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050138
					]
				},
				{
					"id": 755050138,
					"content": "先把牠們抓起來，這種程度的深淵汙染我們有辦法淨化，不至於傷及蜜蟲的性命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050139
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050139,
					"content": "基尼奇標記了蜜蟲集中出現的地方，我現在正打算去部族附近的那一處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050140
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050140,
					"content": "#話說，{F#妳}{M#你}們有沒有興趣一起來？抓蜜蟲還滿好玩的對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050141
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050141,
					"content": "我本來想找卡齊娜一起，可惜她還有別的事要忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050142,
						755050146,
						755050148
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050142,
					"content": "妳就是想偷懶吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050143
					]
				},
				{
					"id": 755050143,
					"content": "#說什麼，我才不打算躺在樹上旁觀，我會和{F#妳}{M#你}們一起抓的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050144
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050144,
					"content": "開玩笑的，我們出發吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050145
					]
				},
				{
					"id": 755050145,
					"content": "#很高興{F#妳}{M#你}們願意來，這樣我就不會很無聊了。我們出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050146,
					"content": "樂意奉陪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050147
					]
				},
				{
					"id": 755050147,
					"content": "#很高興{F#妳}{M#你}們願意來，這樣我就不會很無聊了。我們出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050148,
					"content": "感覺不怎麼好玩，算了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050149
					]
				},
				{
					"id": 755050149,
					"content": "#那我就會無聊死…真的不來嗎？我還打算送{F#妳}{M#你}們個小東西喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050150
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050150,
					"content": "哦！原來還有報酬嗎？！是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050151,
					"content": "閃閃發光的小玩意，很好看的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050152
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050152,
					"content": "#哦！是摩拉！{NICKNAME}，我們千萬不能錯過賺摩拉的機會啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050153,
						755050155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755050153,
					"content": "前面是開玩笑，現在出發吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050154
					]
				},
				{
					"id": 755050154,
					"content": "哈哈，那我們走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050155,
					"content": "看在摩拉的分上，陪妳跑一趟吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050156
					]
				},
				{
					"id": 755050156,
					"content": "哈哈，那我們走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755050110,
					"content": "看起來不太對勁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755050111
					]
				},
				{
					"id": 755050111,
					"content": "#還是{F#妳}{M#你}敏銳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755050112
					],
					"speakerTitle": "希諾寧"
				}
			]
		},
		{
