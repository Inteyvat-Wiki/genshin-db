			"dialogs": [
				{
					"id": 761180401,
					"content": "#{F#妳}{M#你}們回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180402
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180402,
					"content": "哥倫比婭，妳猜得一點也沒錯，菈烏瑪她什麼都沒和我們說呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180403,
					"content": "她好像滿忙碌的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180404
					]
				},
				{
					"id": 761180404,
					"content": "這幾天我們會在這裡陪妳的！妳就好好期待吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180405,
					"content": "期待什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180406
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180406,
					"content": "呃…！沒、沒什麼，我們也不知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180407,
					"content": "#呵呵…好吧，那我就先期待有{F#妳}{M#你}們相伴的這幾天吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180408
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180408,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180409
					],
					"speakerTitle": "長翎䴉"
				},
				{
					"id": 761180409,
					"content": "哦！送菜的來了——欸？菜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180410,
					"content": "！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180411
					],
					"speakerTitle": "長翎䴉"
				},
				{
					"id": 761180411,
					"content": "#牠說「時間到了」——{F#妳}{M#你}們知道是什麼意思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180412
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180412,
					"content": "噢噢噢我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180413,
					"content": "哥倫比婭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180414
					]
				},
				{
					"id": 761180414,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180415
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180415,
					"content": "妳不是蒙著眼睛嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180416
					]
				},
				{
					"id": 761180416,
					"content": "嗯，怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180417
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180417,
					"content": "但妳蒙著眼睛也能用月矩力觀察外界的模樣對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180418,
					"content": "沒錯，不如說，這樣的感知還更清晰一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180419
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180419,
					"content": "那…那如果要妳先別去感知外面發生了什麼變化的話，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180420,
					"content": "是「驚喜」，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180421
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180421,
					"content": "看來妳已經猜到了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180422,
					"content": "#好的，我知道了，那我把手交給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
