			"dialogs": [
				{
					"id": 761180101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180102,
					"content": "#{F#妳}{M#你}有沒有聞到一股好香的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180104,
					"content": "哥倫比婭一個人在大吃大喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180105,
					"content": "#{NICKNAME}、派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180106,
					"content": "她吃得好開心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180107,
					"content": "#{F#妳}{M#你}們要不要也吃一點？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180108,
					"content": "妳吃妳吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180109
					]
				},
				{
					"id": 761180109,
					"content": "難得看到妳在這裡吃東西的樣子，是妳特意從外面買回來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180110,
					"content": "是菈烏瑪送來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180111,
					"content": "噢！她還是很照顧妳的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180112,
					"content": "前提是我不能離開這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180113,
					"content": "這是軟禁吧？！妳就被這些東西收買了嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180114,
					"content": "她還帶了一些有趣的書本、精巧的玩具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180115,
					"content": "簡直像出差的媽媽和留守家中的孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180116,
					"content": "菈烏瑪有解釋原因嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180117
					]
				},
				{
					"id": 761180117,
					"content": "她要我最近都別出門，尤其不要去霜月之子那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180118
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180118,
					"content": "我問了來送餐的小動物們，但牠們也受到了菈烏瑪的指示，每一隻都保持著沉默。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180119,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180120,
					"content": "我猜她可能是在準備什麼吧？和我有關的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180121
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180121,
					"content": "放心吧，我原本也不覺得待在這裡有什麼無聊的。飯菜好吃，合我胃口，不出門也很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180122,
					"content": "況且，如果是霜月之子的大家在準備什麼的話，我更不該出於好奇心而去打亂大家的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180123
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180123,
					"content": "要不要我們去探探口風？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180124
					]
				},
				{
					"id": 761180124,
					"content": "是啊，說得我也好奇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180125,
					"content": "#可以啊，不過{F#妳}{M#你}們最好做點心理準備哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 761180126,
					"content": "#她恐怕猜得出{F#妳}{M#你}們會來見我，可能什麼都不會對{F#妳}{M#你}們講。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
