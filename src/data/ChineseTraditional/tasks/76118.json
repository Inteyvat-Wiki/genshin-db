							1803.217,
							240.145,
							10366.37
						],
						"pointId": 360600060
					}
				]
			},
			"dialogs": [
				{
					"id": 761180301,
					"content": "重修庫塔爾神像？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180302,
					"content": "正是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180303
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180303,
					"content": "她不再是沒有翅膀，只能孤獨望著天外之月的「庫塔{RUBY#[S]月之少女}爾」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180304
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180304,
					"content": "我們見證了她舒展雙翼的模樣，知曉了她重獲生命的自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180305
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180305,
					"content": "所以，與之相對，神像也該好好修繕一番了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180306
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180306,
					"content": "聽起來倒是不錯啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180307,
					"content": "妳有告訴霜月之子其他人了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180308
					]
				},
				{
					"id": 761180308,
					"content": "嗯，我為大家講述了月神的犧牲與重臨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180309
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180309,
					"content": "以及在那片柔光的引領下，我們是如何對抗那汙染世界的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180310
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180310,
					"content": "對於月神回歸這件事，眾人無不喜悅。我便藉此機會傳達了哥倫比婭的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180311
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180311,
					"content": "她想將我們視作家人，也想被我們看作是家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180312
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180312,
					"content": "大家怎麼說？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180313
					]
				},
				{
					"id": 761180313,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180314
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180314,
					"content": "月神大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180315
					],
					"speakerTitle": "索妮齊婭"
				},
				{
					"id": 761180315,
					"content": "把月神大人當家人這件事…真的不會太僭越嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180316
					],
					"speakerTitle": "洛烏佳"
				},
				{
					"id": 761180316,
					"content": "我相信，這正是哥倫比婭內心真實的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180317
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180317,
					"content": "（詠月使大人竟然真的直接叫月神大人「哥倫比婭」！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180318
					],
					"speakerTitle": "庫涅貢妲"
				},
				{
					"id": 761180318,
					"content": "諸位或許仍能記得，我前些時日說過的那句話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180319
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180319,
					"content": "「路當以真相鋪就，當由我們自己鋪就。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180320
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180320,
					"content": "我不會要求每個人都與我做出同等選擇，但在今日，我也有一句良言想與各位分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180321
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180321,
					"content": "「如果想要邀請月光駐留，首先便需打開緊閉的門戶。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180322
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180322,
					"content": "…就是這樣，根據這幾天的情況來看，似乎比我預期的還要樂觀一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180323
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180323,
					"content": "菈烏瑪大人，新一批石材已經運到倉庫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180324
					],
					"speakerTitle": "馬西捷"
				},
				{
					"id": 761180324,
					"content": "知道了，我馬上過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180325
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180325,
					"content": "#剛才我說的話，包括{F#妳}{M#你}見到的這些景象，能暫時對哥倫比婭保密嗎？我想為她準備一個驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180326
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 761180326,
					"content": "我知道是好心啦，但你們月神和信奉月神的人還真是喜歡驚喜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180327,
					"content": "我們會保密的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761180328
					]
				},
				{
					"id": 761180328,
					"content": "那個，菈烏瑪，封口費…我是說，今天的饗月餐還有沒有多餘的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761180329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761180329,
					"content": "哈，我來為兩位準備。對了，還有一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
