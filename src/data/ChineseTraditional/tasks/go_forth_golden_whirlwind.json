			"trigger": {
				"objectNames": [
					"安彥太郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726860101,
					"content": "請問閣下的名字是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860102
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860102,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860103
					]
				},
				{
					"id": 726860103,
					"content": "好，我記下了，請問閣下可有賭上武者榮譽的覺悟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860104,
						726860105
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860104,
					"content": "什麼？好突然！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				},
				{
					"id": 726860106,
					"content": "難道閣下不是慕名前來參與這場決鬥的武者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860107
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860107,
					"content": "完全沒聽說過這回事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860108
					]
				},
				{
					"id": 726860108,
					"content": "閣下難道沒有聽說過「孤劍爭逐」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860109
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860109,
					"content": "這不應當，我明明已經張貼過公告了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860110
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860110,
					"content": "你貼在哪裡了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726860111,
					"content": "就在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860112
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860112,
					"content": "貼在這裡沒有用啦，這樣的宣傳方式怎麼會有人來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726860113,
					"content": "哼，還不是因為社奉行說「容彩祭不宜舞刀弄槍」，拒絕了我在離島舉辦決鬥，也禁止我張貼傳單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860114
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860114,
					"content": "因此，我只能把決鬥場選在這裡，把公告也貼在旁邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860115
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860115,
					"content": "不過，實際上已經有四名武者前來參與比試了，如果連同閣下在內，那就有五人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860116
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860116,
					"content": "#這樣還能有人來參加，真是神奇。話說{NICKNAME}來這裡是為了什麼，完全沒有印象了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726860117,
					"content": "我看閣下能在不知此事的前提下，來到這小島上，一定是位有著強烈武道精神的勇者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860118
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860118,
					"content": "癡迷於武道的人是會相互吸引的，這是常識，兩位不必感到奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860119
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860119,
					"content": "這是哪個世界的常識啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726860120,
					"content": "呵呵，如何？閣下是否願意前來比試？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860121
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860121,
					"content": "如果閣下能一一勝過那四位參賽者，屆時自有禮金奉上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726860122
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860122,
					"content": "讓我考慮考慮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860123
					]
				},
				{
					"id": 726860123,
					"content": "好，那麼就請閣下好好考慮一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726860105,
					"content": "沒有沒有，打擾了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726860106
					]
				}
			]
		}
	]
}