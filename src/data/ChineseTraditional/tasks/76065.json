					}
				]
			},
			"dialogs": [
				{
					"id": 760650101,
					"content": "#{F#妳}{M#你}來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650102
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650102,
					"content": "哥倫比婭居然在這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650103
					]
				},
				{
					"id": 760650103,
					"content": "#嗯，現在{F#妳}{M#你}也來了，所以，是我們一起在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650104
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650104,
					"content": "說得好像妳知道我會來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650105
					]
				},
				{
					"id": 760650105,
					"content": "#我不知道是什麼時候，但{F#妳}{M#你}總會來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650106
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650106,
					"content": "#就像月亮與提瓦特之間總有一股相互連結的引力。{F#妳}{M#你}總能找到我，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650107
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650107,
					"content": "#來，一起坐坐吧，為{F#妳}{M#你}留了位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650108
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650108,
					"content": "#上次我們在{F#妳}{M#你}的飛船上，看提瓦特。這次就看看星空吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650109
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650109,
					"content": "寧寧和她的前輩們，就是被這片星空吸引了。那裡一定也有著別樣的引力。我感受得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650110
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650110,
					"content": "寧寧和她送出的訊息…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650111
					]
				},
				{
					"id": 760650111,
					"content": "別擔心，她沒有遇到危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650112
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650112,
					"content": "她安全地走了很遠很遠的路，遠到已經感應不到我用來護送她的力量了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650113
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650113,
					"content": "但是，我很好奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650114
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650114,
					"content": "好奇什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650115
					]
				},
				{
					"id": 760650115,
					"content": "嗯，有很多。比如，望月者的訊息會被其他人接收到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650116
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650116,
					"content": "接收到的人，或者其他存在…他們會是誰呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650117
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650117,
					"content": "他們會怎麼想？會和我們一樣，心裡也有愛和恨嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650118
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650118,
					"content": "會和我們一樣，即使深淵環伺，依然被頭頂這片美麗又神秘的星空吸引嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650119
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650119,
					"content": "會和我們一樣，也想找到其他人，然後招招手說：「好朋友，很高興認識你」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650120
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650120,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650121
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650121,
					"content": "這片星空深處，還有沒被黑暗吞噬的文明嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650122
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650122,
					"content": "我想會有的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650123
					]
				},
				{
					"id": 760650123,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650124
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650124,
					"content": "我們的飛船，曾接收過一段訊息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650125
					]
				},
				{
					"id": 760650125,
					"content": "什麼訊息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650126
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650126,
					"content": "有效內容幾乎缺失了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650127
					]
				},
				{
					"id": 760650127,
					"content": "但一定屬於一個智慧文明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650128
					]
				},
				{
					"id": 760650128,
					"content": "缺失…是因為走了太遠的路嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650129
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650129,
					"content": "不過，光是這樣，就已經夠讓人高興了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650130
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650130,
					"content": "#對了，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650131
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650131,
					"content": "嗯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650132
					]
				},
				{
					"id": 760650132,
					"content": "#{F#妳}{M#你}原本的家鄉，也在那深處吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650133
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650133,
					"content": "#如果有一天，{F#妳}{M#你}想要回到{F#妳}{M#你}啟程的地方，打掃打掃那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650134
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650134,
					"content": "#我很樂意幫忙，像{F#妳}{M#你}幫我打掃月亮一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650135
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650135,
					"content": "那我不會忘記來邀請妳的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650136
					]
				},
				{
					"id": 760650136,
					"content": "再開一個派對？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650137
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650137,
					"content": "再開一個派對。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650138
					]
				},
				{
					"id": 760650138,
					"content": "那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650139
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650139,
					"content": "#名字就叫「歸旅之夜」，{F#妳}{M#你}覺得怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650140
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650140,
					"content": "也許是白天。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650141
					]
				},
				{
					"id": 760650141,
					"content": "那就從白天玩到夜晚，把好朋友們都叫來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760650142
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 760650142,
					"content": "聽起來很愉快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760650143
					]
				},
				{
					"id": 760650143,
					"content": "願那個夜晚在一個好天氣裡到來。在朋友們的團聚下到來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哥倫比婭"
				}
			]
		}
	]
}