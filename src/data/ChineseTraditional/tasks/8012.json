			"dialogs": [
				{
					"id": 80120101,
					"content": "怎麼回事，不對啊，這怎麼可能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120102,
						80120103
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120102,
					"content": "消失了…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120104
					]
				},
				{
					"id": 80120104,
					"content": "那些朝拜的丘丘人也不知道去哪裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120105
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120105,
					"content": "之前難道都是幻覺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120106,
						80120107
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120106,
					"content": "不太可能…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120108
					]
				},
				{
					"id": 80120108,
					"content": "的確…不可能是幻覺，那股偉大而神秘的力量還在我的頭腦裡、在我的身體裡迴盪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120109
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120109,
					"content": "不是幻覺，不是巧合，更不是夢境，而是確確實實存在的「神秘」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120110
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120110,
					"content": "…走吧，旅行者，「它」的消失一定有意義…我相信在未來一定還會遇到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120111,
						80120112
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120111,
					"content": "你真是執迷不悟啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120113
					]
				},
				{
					"id": 80120113,
					"content": "不是神明…而是「罪人」嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120112,
					"content": "先回去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120113
					]
				},
				{
					"id": 80120107,
					"content": "總不能我們兩個同時出現幻覺了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120108
					]
				},
				{
					"id": 80120103,
					"content": "明明就是這裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120104
					]
				}
			]
		},
		{
