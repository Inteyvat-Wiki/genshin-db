				"points": []
			},
			"dialogs": [
				{
					"id": 80120401,
					"content": "巡林員…糟糕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120402
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120402,
					"content": "喂，你們是什麼人，怎麼好像沒見過你們，在這裡幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120403
					],
					"speakerTitle": "巡林員"
				},
				{
					"id": 80120403,
					"content": "你們有看到丘丘人嗎？從這個方向過去的丘丘人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120404
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120404,
					"content": "先回答我的問題…不要自找麻煩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120405
					],
					"speakerTitle": "巡林員"
				},
				{
					"id": 80120405,
					"content": "我問你！有沒有！見到丘丘人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120406
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120406,
					"content": "埃德…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120407
					]
				},
				{
					"id": 80120407,
					"content": "你…你幹什麼啊，有什麼好激動的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120408
					],
					"speakerTitle": "巡林員"
				},
				{
					"id": 80120408,
					"content": "丘丘人不是隨處可見嗎？當然有看到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120409
					],
					"speakerTitle": "巡林員"
				},
				{
					"id": 80120409,
					"content": "是啊，就在剛剛，我們還在那邊解決掉了幾個，呆頭呆腦的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120410
					],
					"speakerTitle": "巡林護衛"
				},
				{
					"id": 80120410,
					"content": "你們…你們…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120411
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120411,
					"content": "該死的巡林員，該死的七神子民！給我為卡利貝爾償命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120412
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120412,
					"content": "你…！口出狂言的外國人，是在挑釁我們巡林員嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120501
					],
					"speakerTitle": "巡林員"
				},
				{
					"id": 80120501,
					"content": "你們這些巡林員…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120502,
						80120503
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120502,
					"content": "適可而止，埃德！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120515
					]
				},
				{
					"id": 80120503,
					"content": "否則我會和巡林員一起制服你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120515
					]
				},
				{
					"id": 80120515,
					"content": "#在{F#妳}{M#你}的規勸下，雙方暫時冷靜了下來…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80120505
					]
				},
				{
					"id": 80120505,
					"content": "真弄不懂，我們不過是幹掉了幾個丘丘人，怎麼就發這麼大的火…不可理喻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120506
					],
					"speakerTitle": "巡林護衛"
				},
				{
					"id": 80120506,
					"content": "你們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120507
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120507,
					"content": "他才剛剛恢復神智，怎麼能就這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120508
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120508,
					"content": "巡林員…真的、真的都沒手下留情嗎？對所有見到的丘丘人都下手了嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120509
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120509,
					"content": "好吧，莫名其妙的傢伙，非要問的話，我之前自己離隊去…去上廁所的時候，剛好遇見一個丘丘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120510
					],
					"speakerTitle": "巡林護衛"
				},
				{
					"id": 80120510,
					"content": "我一開始很緊張，但後來發現那個丘丘人沒什麼敵意，只是渾渾噩噩在往…往那個方向走了，我就沒管它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120511
					],
					"speakerTitle": "巡林護衛"
				},
				{
					"id": 80120511,
					"content": "還有希望！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120513
					]
				},
				{
					"id": 80120512,
					"content": "很有可能是卡利貝爾！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120513
					]
				},
				{
					"id": 80120513,
					"content": "是啊，太好了…太好了…走，我們快過去找他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120514
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120514,
					"content": "喂，就這麼走了？你們也太目中無人了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巡林員"
				}
			]
		},
