			"dialogs": [
				{
					"id": 80120801,
					"content": "#…醒了，太好了，{NICKNAME}醒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120802,
					"content": "#真是擔心死我了…{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120803,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120804
					]
				},
				{
					"id": 80120804,
					"content": "#{F#妳}{M#你}昏迷的時候，發生了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120805
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120805,
					"content": "我已經調查過附近的地脈了，似乎曾經受過深淵力量的影響，一直躁動不已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120806
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120806,
					"content": "#地脈裡畢竟流動著世間的訊息與記憶，莫非{F#妳}{M#你}看到了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120807,
						80120808
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120807,
					"content": "創立深淵教團的亞爾伯里奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120809
					]
				},
				{
					"id": 80120809,
					"content": "#{F#妳}{M#你}是說克洛達爾·亞爾伯里奇嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120810
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120810,
					"content": "他創立深淵教團以後，為了自己對深淵的「信仰」而做了許多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120811
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120811,
					"content": "但最終不死詛咒同時折磨著他的肉體和精神，他信仰的深淵並沒有拯救他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120812
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120812,
					"content": "在百年後，他完全變得瘋瘋癲癲，然後再也不知所蹤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120813
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120813,
					"content": "#不過他也的確留下了很多麻煩，就比如之前{F#妳}{M#你}們遇到過的「污穢逆位神像」，甚至也是他當年利用深淵力量製造的神秘產物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120814,
						80120815
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120814,
					"content": "可是最終…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120816
					]
				},
				{
					"id": 80120816,
					"content": "#可以這麼說吧，不然{M#她}{F#他}也就不會是深淵教團的{M#公主}{F#王子}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120817
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120817,
					"content": "#{NICKNAME}…{F#妳}{M#你}還好嗎？看{F#妳}{M#你}的表情…到底發生什麼事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120818,
					"content": "我有一個故事…要跟你們說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120819
					]
				},
				{
					"id": 80120819,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120820
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120820,
					"content": "#{F#妳}{M#你}的講述令戴因斯雷布陷入了深深的思考…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80120821
					]
				},
				{
					"id": 80120821,
					"content": "#以{F#妳}{M#你}的視角，看到了{M#她}{F#他}數百年前的記憶…真是不可思議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120822
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120822,
					"content": "果然「命運的織機」這個概念出現於那個時代…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120823
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120823,
					"content": "而且很有可能克洛達爾的兒子卡利貝爾當時的狀態，還與之有所關聯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120824
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120824,
					"content": "#只是這段故事，{F#妳}{M#你}的血親從未和我提起…所以其實那個時候，{M#她}{F#他}就已經下定決心要走這條路了嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120825,
						80120826
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120825,
					"content": "我也很想知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120827,
						80120828
					]
				},
				{
					"id": 80120827,
					"content": "但可以確定的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120829
					]
				},
				{
					"id": 80120829,
					"content": "是啊，那傢伙一定獨自思考了很久吧，可以說…這件事就是一切的「開端」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120830,
						80120831
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120830,
					"content": "對了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120832
					]
				},
				{
					"id": 80120832,
					"content": "什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120833
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120833,
					"content": "這片田地裡埋了什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120834
					]
				},
				{
					"id": 80120834,
					"content": "#田地？{F#妳}{M#你}怎麼忽然關心這種事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120835
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120835,
					"content": "…是這裡嗎？那就挖開來看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120836
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120836,
					"content": "#{F#妳}{M#你}和戴因花了一點時間確認田地下埋藏的東西…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80120837
					]
				},
				{
					"id": 80120837,
					"content": "…嚇死我了，你們埋、埋回去了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120838,
					"content": "埋好了，睜眼吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120839
					]
				},
				{
					"id": 80120839,
					"content": "一具男性屍骨和一具女性屍骨被埋在一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120840
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120840,
					"content": "有趣的是，這具男性屍骨埋葬時間明顯晚於女性屍骨，男性屍骨手裡還握著一條絲巾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120841
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120841,
					"content": "#這代表了什麼，{NICKNAME}？{F#妳}{M#你}怎麼知道這下面埋著屍體的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120842,
						80120843
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120842,
					"content": "我想這具男性屍骨的身分…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120844
					]
				},
				{
					"id": 80120844,
					"content": "什麼？這不可能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120845
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120845,
					"content": "除非…克洛達爾·亞爾伯里奇最終擺脫了不死詛咒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120846
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120846,
					"content": "或許吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120847
					]
				},
				{
					"id": 80120847,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120848
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120848,
					"content": "這一切太混亂了，我需要時間整理，也需要再努力從我的記憶中搜羅一些東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120849
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120849,
					"content": "#就這麼先分別吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120850
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120850,
					"content": "欸，你怎麼又要走了，明明跟我們一起也可以呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120851
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120851,
					"content": "#暫且還是分開行動的好，因為…「那傢伙」說不定已經看見{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120852
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120852,
					"content": "「那傢伙」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120853,
						80120854
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120853,
					"content": "難道你指的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120855
					]
				},
				{
					"id": 80120855,
					"content": "沒錯，我已經對他的身分有了猜測…這也是我需要串聯線索來確認的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120856
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120856,
					"content": "#如果時機成熟，下次見面我會告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120857
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120857,
					"content": "#可是你說，「那傢伙」說不定已經看到{NICKNAME}了，要怎麼「看到」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120858,
						80120859
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120858,
					"content": "那畢竟是在回憶裡的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120860
					]
				},
				{
					"id": 80120860,
					"content": "如果是他的話…這些恐怕都不是可以限制他的要素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120861
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120861,
					"content": "這…究竟是什麼樣的存在啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120862
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80120862,
					"content": "「罪人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120863
					]
				},
				{
					"id": 80120863,
					"content": "#好了，就聊到這裡吧，{NICKNAME}的精神也需要好好休息，再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120864
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80120864,
					"content": "戴因那傢伙又走了呢，這下又剩下我們兩個啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
