			"dialogs": [
				{
					"id": 80120202,
					"content": "怎麼回事，卡利貝爾呢！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120203,
						80120204
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120203,
					"content": "不在房間裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120205
					]
				},
				{
					"id": 80120205,
					"content": "不，卡利貝爾…難道有人來過了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120206
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120206,
					"content": "不對，門沒被破壞，周圍好像也沒有任何其他人留下的痕跡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120207,
						80120208
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120207,
					"content": "他自己跑出去了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120209
					]
				},
				{
					"id": 80120209,
					"content": "糟了，卡利貝爾現在的樣子，萬一遇上巡林員或者冒險家的話，豈不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120210,
						80120211
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120210,
					"content": "想辦法先找到他吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120212
					]
				},
				{
					"id": 80120212,
					"content": "等等…這裡好像被動過了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120213
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120213,
					"content": "難道說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120214
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120214,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120215
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120215,
					"content": "鏡子…碎掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120216
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120216,
					"content": "（鏡子？那面鏡子…不是早就碎掉了嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120217
					]
				},
				{
					"id": 80120217,
					"content": "鏡子碎掉了表示什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120218
					]
				},
				{
					"id": 80120218,
					"content": "他一定是摘掉了面具…看到了面具下自己的模樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120219
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120219,
					"content": "糟了，不聽話的孩子…我們快去追他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120211,
					"content": "事不宜遲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120212
					]
				},
				{
					"id": 80120208,
					"content": "怎麼這麼突然…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120209
					]
				},
				{
					"id": 80120204,
					"content": "難道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120205
					]
				}
			]
		},
