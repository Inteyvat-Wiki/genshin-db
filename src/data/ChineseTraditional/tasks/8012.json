			"dialogs": [
				{
					"id": 80120701,
					"content": "…哈哈，沒錯，就是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120702
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120702,
					"content": "我終於弄明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120703
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120703,
					"content": "（我…剛剛昏過去了嗎，隱約記得卡利貝爾摘下了面具，然後…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120704
					]
				},
				{
					"id": 80120704,
					"content": "#啊，{F#妳}{M#你}醒了，旅行者…我正想跟{F#妳}{M#你}分享這份喜悅呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120705
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120705,
					"content": "#哦，不對…沒必要叫{F#妳}{M#你}什麼「旅行者」了，我早就認出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120706,
						80120707
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120706,
					"content": "認出我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120708
					]
				},
				{
					"id": 80120708,
					"content": "#呵呵…我原本就認識{F#妳}{M#你}啊，只不過是在聊天的過程中逐漸確認是{F#妳}{M#你}罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120709
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120709,
					"content": "但我之前並不認識你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120710
					]
				},
				{
					"id": 80120710,
					"content": "#這很正常，{F#妳}{M#你}是那樣高貴，怎麼可能認識我們所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120711
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120711,
					"content": "而且…從一開始我就用了假名，埃德是我以往的侍從的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120712
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120712,
					"content": "而我真正的名字是克洛達爾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120713
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120713,
					"content": "…克洛達爾·亞爾伯里奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120714,
						80120715
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120714,
					"content": "亞爾伯里奇！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120716
					]
				},
				{
					"id": 80120716,
					"content": "#所以{F#妳}{M#你}也看到了吧，那種力量…卡利貝爾身上的力量與{F#妳}{M#你}口中「罪人」的力量如出一轍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120717
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120717,
					"content": "而我現在非常確信…那種力量就是…「深淵」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120718
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120718,
					"content": "我終於見識到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120719,
						80120720
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120719,
					"content": "我什麼也沒看清楚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120721
					]
				},
				{
					"id": 80120721,
					"content": "#{F#妳}{M#你}少管！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120722
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120722,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120723
					]
				},
				{
					"id": 80120723,
					"content": "罪人…罪人…唯有罪人才能拯救罪人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120724
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120724,
					"content": "卡利貝爾的命運不該是這樣，不過現在…太好了，他可以重新紡織自己的命運了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120725
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120725,
					"content": "在那極度的悲傷之中誕生，他將會成為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120726
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120726,
					"content": "…「命運的織機」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120727
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120727,
					"content": "（這個概念出現了…「命運的織機」…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120728,
						80120729
					]
				},
				{
					"id": 80120728,
					"content": "那的確是深淵的東西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120730
					]
				},
				{
					"id": 80120730,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120731
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120731,
					"content": "危險…不祥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120732
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120732,
					"content": "#沒想到，{F#妳}{M#你}居然會這麼說，居然在否定深淵…真是可笑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120733
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120733,
					"content": "#我們曾經都相信，{F#妳}{M#你}會帶給坎瑞亞力量與希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120734
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120734,
					"content": "#因為{F#妳}{M#你}就代表著深淵，代表了超乎想像、超越理解的神秘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120735
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120735,
					"content": "而坎瑞亞只要掌控了深淵，就能掌控一切！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120736
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120736,
					"content": "#我們曾如此憧憬著那樣的未來，如此凝望著{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120737
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120737,
					"content": "#可是{F#妳}{M#你}…究竟為我們帶來了什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80120738
					],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120738,
					"content": "#坎瑞亞的…{M#公主}{F#王子}大人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃德"
				},
				{
					"id": 80120729,
					"content": "但是深淵是危險而不祥的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120730
					]
				},
				{
					"id": 80120720,
					"content": "卡利貝爾到底怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120721
					]
				},
				{
					"id": 80120715,
					"content": "你是！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120716
					]
				},
				{
					"id": 80120707,
					"content": "埃德，你還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80120708
					]
				}
			]
		},
