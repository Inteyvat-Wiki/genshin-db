			"dialogs": [
				{
					"id": 751890701,
					"content": "偵測到陰影大敵之威脅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890702
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890702,
					"content": "內部抵禦…自動修復模式啟動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890703
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890703,
					"content": "啊，沒想到在這種建築內部也有這種機關…那些魔物一下子就被消滅了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890704,
					"content": "「畢竟這座建築是為了矗立千萬年而建造的，不僅能夠禦敵，還可以自我修復…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890705
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890705,
					"content": "而且，金光閃閃的…真想摸一摸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890706,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890707
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890707,
					"content": "#「哈哈，{F#妳}{M#你}最好還是打消那個念頭…牠可認不得{F#妳}{M#你}是『朋友』還是『敵人』…牠只會無條件地燒卻碰到的所有東西。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890708
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890708,
					"content": "「…愚蠢又粗暴的做法，哼，不知道是誰設計的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890709
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890709,
					"content": "不過，我們也可以用這個打開那個罩住許可的罩子吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890710,
						751890712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890710,
					"content": "值得一試…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890711
					]
				},
				{
					"id": 751890711,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890716,
					"content": "那我們就…想辦法把這個東西升上去好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890712,
					"content": "好正經的提案…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751890713
					]
				},
				{
					"id": 751890713,
					"content": "波嗯，嗚呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890714
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890714,
					"content": "「說得沒錯，沒想到這位白色的使者還真是深藏不露…有著這樣的智慧呢，真是讓人訝異。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890715
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890715,
					"content": "…我是不懂你們在驚訝什麼啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890716
					],
					"speakerTitle": "派蒙"
				}
			]
		}
