						],
						"pointId": 72
					}
				]
			},
			"dialogs": [
				{
					"id": 751890601,
					"content": "「那裡，能解鎖鱗石的鐫刻之光，那就是許可…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890602
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890602,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890603
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890603,
					"content": "這裡能夠看到…看到整座聖城呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890604,
					"content": "「是啊，真是昔日輝煌可悲的殘影啊…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890605
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890605,
					"content": "唔嗯…呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890606
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890606,
					"content": "「你想問那場審判最後的結果？呵呵…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890607
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890607,
					"content": "「說想要進行聖裁的人當然知道執掌一切光焰的主人陷入假死，只是當偶爾清醒的王真的出現在場…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890608
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890608,
					"content": "「原本聒噪不休的十三位領主和三位親王立刻收回了他們的話語，整場鬧劇般的審判不了了之…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890609
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890609,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890610
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890610,
					"content": "「再然後…其中的三位親王死於與人類的戰爭，眾領主中的十位消亡於聖城圖蘭的崩塌，一位殘留於奇琴烏圖…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890611
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890611,
					"content": "「唯有一位領主存活至今…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890612
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890612,
					"content": "「但想必，那並不是它想要存續的形式吧…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890613
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890613,
					"content": "「好了…繼續前往聖山之心吧，那裡埋藏了一切…埋藏了…旅途終末的熱望。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890614
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890614,
					"content": "「我在此處的使命將盡…受龍所選者，此處曾是多麼美麗的地方啊…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890615
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890615,
					"content": "「去觸碰那火鱗鐫刻之光吧…去獲得，通往聖山之心的許可…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890616
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890616,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890617
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890617,
					"content": "阿萬尤…唔，又走了！這名字我都還沒有叫上幾次呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890618,
					"content": "不過，這下總算弄到了前往「聖山之心」的許可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890619,
					"content": "唔嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890620
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890620,
					"content": "這邊的光…消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
