			"dialogs": [
				{
					"id": 751890501,
					"content": "「我就知道你們要到這裡來，所以就提前來恭迎大駕了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890502
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890502,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890503
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751890503,
					"content": "「雖然我知道你只是出於禮貌，但我見到你的確很高興。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890504
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890504,
					"content": "啊，果然是你，呃，這次你又要叫什麼名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890505,
					"content": "「這次的名字屬於『審議之庭』的書記官，實際上在秘源龍僕被發明出來以後，他已經很少親自動筆。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890506
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890506,
					"content": "「阿萬尤…你可以這麼稱呼。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890507
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890507,
					"content": "好吧，阿萬尤，這次你是來幫我們搞定那個什麼進入「聖山之心」的許可的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890508,
					"content": "「不然『聖山之心』設置的『象擬聚星』會在無許可的進入者進入的瞬間進行攻擊…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890509
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890509,
					"content": "「…我提取了這具『阿萬尤』的紀錄，進入聖山之心的許可被放置在了審議之庭之上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890510
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890510,
					"content": "「為此我不得不踏足這裡…愚昧卻自以為是者集合處，無能而為無能自傲者的聚集地。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890511
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890511,
					"content": "「也是這些傢伙裝模作樣，審度同族的所在…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秘源龍僕"
				}
			]
		},
