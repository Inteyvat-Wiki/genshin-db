					}
				]
			},
			"dialogs": [
				{
					"id": 751890301,
					"content": "「走吧，讓我們看看它們把許可藏在了哪裡…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890302
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890302,
					"content": "「看來它們就把東西放在那…還真是藏都不藏…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890303
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890303,
					"content": "「不過看上去只是一個空殼載體…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890304
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890304,
					"content": "嗚哇，怎麼突然有這麼多的獸境獵犬…唔，那個許可也被…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890305,
					"content": "「大概是門口的保護沒有了，所以它們得以乘虛而入了吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890306
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890306,
					"content": "那、那現在怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751890307,
					"content": "「沒關係，只要啟動審議之庭的修復淨化裝置就好。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751890308
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751890308,
					"content": "「在那裡…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秘源龍僕"
				}
			]
		},
