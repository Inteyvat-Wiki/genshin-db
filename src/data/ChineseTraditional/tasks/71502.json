	"talks": [
		{
			"id": 7150201,
			"completionStepIds": [
				7150201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7150201",
							"2"
						],
						"stepId": 7150201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715020101,
					"content": "#{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020102,
					"content": "對，我們來幫忙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715020103,
					"content": "我正在檢查「普爾希娜光釘」，璃月的礦工身體素質可真強啊，只靠兩個人就把這個光釘搬到這裡來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020104
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020104,
					"content": "不過因為「普爾希娜光釘」有一些比較精密的部分，得確認是否在搬運過程中被影響了…當然理論上應該沒有什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020105
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020105,
					"content": "#你上次也說是理論上沒問題，結果差點把我和{NICKNAME}害慘了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715020106,
					"content": "#咳，理論和實際還是有差距的，不過{F#妳}{M#你}來之前我都檢查過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020107
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020107,
					"content": "一切都已準備好，之後就能啟動並進行運轉，而且甚至不需要用元素力給予「普爾希娜光釘」初始動力，也可持續充能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020108,
						715020109
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020108,
					"content": "不需要初始動力？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020110
					]
				},
				{
					"id": 715020110,
					"content": "對，之前我為了適應稻妻的環境，所以做了相應的改裝，讓它透過雷元素力才可以進行充能和運轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020111,
					"content": "但是那並不是「普爾希娜光釘」最初的啟動模式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020112
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020112,
					"content": "「普爾希娜光釘」一開始，其實就是應該在這種環境進行運轉的，這些黑泥其實就是它的能量來源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020113
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020113,
					"content": "黑泥為光釘提供能量？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020114
					]
				},
				{
					"id": 715020114,
					"content": "對，所以「普爾希娜光釘」才能完美解決這次的事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020115
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020115,
					"content": "#{F#妳}{M#你}想，現在層岩巨淵出現的「黑泥氾濫」，其實有「標」和「本」兩個需要解決的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020116,
					"content": "其中，「本」就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020117,
						715020119
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020117,
					"content": "地脈？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020118
					]
				},
				{
					"id": 715020118,
					"content": "確實如此，「治本」就是封閉地脈噴湧黑泥的入口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020122
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020122,
					"content": "但是光封閉地脈也不能完全解決已經噴湧出的黑泥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020123
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020123,
					"content": "而「普爾希娜光釘」就能吸取黑泥的能量，消減噴湧而出的黑泥的汙染性，就是所謂的「治標」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020124
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020124,
					"content": "這樣一來地脈湧出的黑泥提供「普爾希娜光釘」運轉的能源，而「普爾希娜光釘」運作之後，又可封閉黑泥湧出的地脈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020125
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020125,
					"content": "那些一直被黑泥長時間影響怪物也應該會因為失去黑泥內能量的支撐而急劇弱化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020126
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020126,
					"content": "哦！這樣一來黑泥、地脈和怪物的問題都解決了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715020127,
					"content": "比我想像中要能幹呢，「噗嚕噗嚕光釘」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715020128,
					"content": "是「普爾希娜光釘」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020129
					]
				},
				{
					"id": 715020129,
					"content": "普爾希娜前輩真是了不起，讓人感覺就像是，就像是光釘這件設備，完全就是為了處理類似問題而被造出來的一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020130
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020130,
					"content": "如果這個猜想是真的，解決黑泥氾濫的問題，整個事件就能作為非常可貴的實驗案例…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020131
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020131,
					"content": "說不定我能透過「普爾希娜光釘」的研究，揭開普爾希娜前輩透過儀器來影響地脈的原理，一定會發現很多前所未見的東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020132
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020132,
					"content": "這個研究課題還挺有價值的，唉…如果能靠這個研究獲得「教令院」的「迦毗鳩師獎」就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020133,
						715020134
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020133,
					"content": "迦毗鳩師獎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020135
					]
				},
				{
					"id": 715020135,
					"content": "那是「教令院」專門為青年學者頒發的獎項。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020136
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020136,
					"content": "每年，學院的賢者們都會閱覽當年提交的研究報告，然後統一投票評選出獎項得主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020137
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020137,
					"content": "得獎學者的要求就是，研究的課題有突破性，創新能力強，個人發展潛力大，在四十歲以下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020138
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020138,
					"content": "每個能在四十歲前得到「迦毗鳩師獎」的學者，後來都在須彌的學術界闖下了赫赫聲名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020139
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020139,
					"content": "這麼厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715020140,
					"content": "那現在就啟動「普爾希娜光釘」吧，希望能夠解決礦區湧現黑泥的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020141
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020141,
					"content": "#不過，{NICKNAME}，注意了，「普爾希娜光釘」雖然是非常偉大的儀器，但是也因此精密而脆弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020142
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020142,
					"content": "如果在運行過程中遇到衝擊，或者直接被黑泥覆蓋造成淤塞，光釘都會立刻自行停止運行以避免更嚴重的損害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020143
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020143,
					"content": "所以充能運作的過程中，要小心黑泥和靠近的怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020134,
					"content": "那是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020135
					]
				},
				{
					"id": 715020119,
					"content": "氾濫的黑泥？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020120
					]
				},
				{
					"id": 715020120,
					"content": "不，氾濫的黑泥是更表面的問題，其根本在於地脈噴湧黑泥的入口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020121
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020121,
					"content": "所以需要「治本」，即用「普爾希娜光釘」封閉地脈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715020122
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 715020109,
					"content": "可以持續充能？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715020110
					]
				}
			]
		}
	]
}