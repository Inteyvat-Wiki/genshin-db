					}
				]
			},
			"dialogs": [
				{
					"id": 746890101,
					"content": "#（…是{M#他們}{F#她們}嗎…師父說的…金髮的旅人和會飛的白色精靈…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890102
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890102,
					"content": "嗯？妳一直盯著我們看，還一邊小聲講話，難道我們臉上有什麼奇怪的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746890103,
					"content": "呀！對、對不起！我不是故意的！我只是…只是覺得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890104,
						746890105
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890104,
					"content": "別緊張，慢慢說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890106
					]
				},
				{
					"id": 746890106,
					"content": "#嗯…我叫妮內特，我的師父是樂平波琳。她、她提過您，說您是…傳奇的冒險家{NICKNAME}，身邊還有最好的夥伴派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890107
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890107,
					"content": "#我、我沒想到真的能夠見到{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890108
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890108,
					"content": "哦！原來是樂平波琳的徒弟啊！看來她最近事業發展得不錯嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746890109,
					"content": "嗯！而且多虧了師父，我才能從人生低谷裡爬起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890110
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890110,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890111
					]
				},
				{
					"id": 746890111,
					"content": "我原本是跟著另一位老師學習攝影的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890112
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890112,
					"content": "為了能成為獨當一面的攝影師，我把所有積蓄都投注進去，買了一整套當時最昂貴的留影設備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890113
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890113,
					"content": "我的技術，老師也說還不錯…我以為只要拍出好畫片，就一定賺得到錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890114
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890114,
					"content": "可是…可是我一到街上，看到路人，就緊張得一個字都說不出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890115
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890115,
					"content": "想問一句：「您好，需要留影嗎？」話就在嘴邊打轉，怎樣也開不了口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890116
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890116,
					"content": "結果，客人們全都跑去找那些能說會道、熱情招攬的攝影師了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890117
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890117,
					"content": "後來，我連摩拉都快花光了，甚至還準備把心愛的留影機賣掉換點生活費…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890118
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890118,
					"content": "真是不容易啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890119
					]
				},
				{
					"id": 746890119,
					"content": "就在那個時候，我遇到了樂平波琳師父。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890120
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890120,
					"content": "她看到我的設備和畫片之後，鼓勵了我，還要我跟著她幫忙測試新鏡頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890121
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890121,
					"content": "她說…她說我拍出的畫片裡，有一種別人沒有的安靜和溫柔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890122
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890122,
					"content": "所以！當師父成功研發出這款「瞬影」鏡頭時，我比誰都高興！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890123
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890123,
					"content": "「瞬影」鏡頭？這是做什麼用的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746890124,
					"content": "它可以清晰地捕捉到高速運動中的人物姿態和神韻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890125
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890125,
					"content": "不過…它目前還處在最終測試階段，需要大量的實際拍攝來收集資料，驗證效能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890126
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890126,
					"content": "師父最近分不開身，就把這個任務交給我了。我本來想說可以去招募一些臨時測試員來幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890127
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890127,
					"content": "可是…可是我又犯了老毛病，每次主動去跟陌生人搭話，我就會緊張得語無倫次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890128
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890128,
					"content": "結果他們都用疑惑的眼神看著我，大概是把我當成什麼可疑的人了…好幾天過去了，還是沒有一個人願意幫我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890129
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890129,
					"content": "嗚…我連這麼簡單的事情都辦不好，我真是太沒用了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890130
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890130,
					"content": "欸，別哭啊！這也不能怪妳嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746890131,
					"content": "突然跑去拜託陌生人幫忙，對很多人來說都是個挑戰啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890132,
						746890133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746890132,
					"content": "別自責了，妳已經很努力了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890134
					]
				},
				{
					"id": 746890134,
					"content": "#對啊！{NICKNAME}的拍攝技術很好的哦，而且，{M#他}{F#她}的朋友遍布整個大陸，找人留影這事鐵定沒問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746890135,
					"content": "真、真的嗎？您…您願意幫我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890136
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890136,
					"content": "#嗚哇——！真的、真的太感謝您了！{NICKNAME}大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890137
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890137,
					"content": "這臺搭載了「瞬影」鏡頭的特製留影機就拜託您了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746890138
					],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890138,
					"content": "請用它記錄下您那些朋友們最生動、最獨特的瞬間吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妮內特"
				},
				{
					"id": 746890133,
					"content": "這件事，或許我們可以幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890134
					]
				},
				{
					"id": 746890105,
					"content": "我們認識嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746890106
					]
				}
			]
		}
	]
}