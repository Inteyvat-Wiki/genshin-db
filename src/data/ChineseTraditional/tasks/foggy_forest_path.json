					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820719
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820719,
					"content": "呃…這滴水珠是珀西芙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820720
					],
					"speakerTitle": "派蒙"
				},
				{
