				]
			},
			"dialogs": [
				{
					"id": 740820701,
					"content": "一滴晶瑩的水珠出現在了祭壇上。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740820702
					]
				},
				{
					"id": 740820702,
					"content": "咦！這滴水珠…這滴水珠不會就是寶藏吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820703,
					"content": "長得不太像寶藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820704
					]
				},
				{
					"id": 740820704,
					"content": "我也覺得…畢竟這麼順利就得到了…那它會是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820705,
						740820710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820705,
					"content": "說不定是鎮壓魔王的關鍵物品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820706
					]
				},
				{
					"id": 740820706,
					"content": "什麼？那我們豈不是闖大禍了，快！快把它放回去！希望還來得及！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820707,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820708
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820708,
					"content": "完蛋了！魔王出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820709,
					"content": "魔王？美露莘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820715
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740820715,
					"content": "嚇死我了…原來是一位美露莘…妳怎麼在這裡呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820716,
					"content": "鑰匙。",
