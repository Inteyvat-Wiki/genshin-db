			"dialogs": [
				{
					"id": 740820401,
					"content": "（大部分字跡被磨毀，僅能依稀辨識出——「…清露…三…」）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820402
					],
					"speakerTitle": "神秘祭壇"
				},
				{
					"id": 740820402,
					"content": "可惡，這上面的字也被毀掉了，一定有秘密！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820403,
						740820406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820403,
					"content": "清露？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820404
					]
				},
				{
					"id": 740820404,
					"content": "「清露」是什麼意思？清清的露水？可是這附近到處都是水啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820405,
					"content": "至於這個「三」字，該不會是指三滴水吧？真頭痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820409,
					"content": "快問問妳的絕對敏銳寶藏嗅覺啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820410
					]
				},
				{
					"id": 740820410,
					"content": "已經問過了！總之…總之…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820411,
					"content": "總之它說跟「三」和「水」有關嘛，我們應該在附近找一找！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820406,
					"content": "三？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740820407
					]
				},
				{
					"id": 740820407,
					"content": "「三」是三個東西的意思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740820408,
					"content": "至於「清露」，難道是清清的露水？可是這附近到處都是水…真頭痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740820409
					],
					"speakerTitle": "派蒙"
				}
			]
		},
