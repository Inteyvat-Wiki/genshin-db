			},
			"dialogs": [
				{
					"id": 220450401,
					"content": "#怎麼樣，{F#妳}{M#你}們拍到畫片了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450402
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450402,
					"content": "已經拍到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450403
					]
				},
				{
					"id": 220450403,
					"content": "我看看…喔！這角度，這姿態，真不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450404,
						220450405
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450404,
					"content": "氣勢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				},
				{
					"id": 220450406,
					"content": "絕對沒問題，這些畫片用來做參考再好不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450407
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450407,
					"content": "#旅行者，謝謝{F#妳}{M#你}幫忙。這些東西請{F#妳}{M#你}收下，我等會就去接著練習木雕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450408
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450408,
					"content": "哎呀，真不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450405,
					"content": "這些能做參考嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450406
					]
				}
			]
