			"dialogs": [
				{
					"id": 220450301,
					"content": "唔？在做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450302
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220450302,
					"content": "在拍畫片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450303
					]
				},
				{
					"id": 220450303,
					"content": "那是什麼？汝等，真是奇怪啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450304
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 220450304,
					"content": "算了，汝等繼續吧，只要別把神社弄亂了就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				}
			]
