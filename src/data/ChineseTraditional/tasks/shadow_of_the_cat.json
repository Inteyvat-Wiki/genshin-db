			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220450101,
					"content": "嗯…這種感覺不太對啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450102
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450103
					]
				},
				{
					"id": 220450103,
					"content": "#旅行者！{F#妳}{M#你}來得正好，我正想找{F#妳}{M#你}呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450104
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450104,
					"content": "最近我製作木雕的時候，總覺得…製作出來的木雕沒有靈性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450105,
						220450107
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450105,
					"content": "畢竟是木雕嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450106
					]
				},
				{
					"id": 220450106,
					"content": "哎呀，不能這麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450108
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450108,
					"content": "#嗯…怎麼向{F#妳}{M#你}形容呢？簡單來說，我想要的「靈性」就是一種…活力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450109
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450109,
					"content": "你看，代宮司大人雖然平時都在睡覺，但偶爾也會起來晃晃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450110
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450110,
					"content": "這種時候，代宮司大人偶爾就會跳一跳，撲撲落葉，或者是伸伸懶腰什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450111
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450111,
					"content": "這些動作，就是我想要的那種活力。我想…以這種動作為原型製作的雕像，應該也有著我想要的那種「靈性」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450112,
						220450113
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450112,
					"content": "那你直接去觀察吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450114,
					"content": "哎呀，我這…不是不好意思去嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450115
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450115,
					"content": "代宮司大人怎麼說都是發我工錢的老闆，總是蹲在她旁邊觀察，總感覺會惹代宮司大人不高興…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450116
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450116,
					"content": "#{F#妳}{M#你}應該和代宮司大人關係很好吧，就請{F#妳}{M#你}幫我拍幾張畫片回來給我參考吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450117,
						220450118
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450117,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450121
					]
				},
				{
					"id": 220450121,
					"content": "#那就拜託{F#妳}{M#你}了，拍好畫片之後，就快點拿來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450118,
					"content": "如果拍不到那種動作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450119
					]
				},
				{
					"id": 220450119,
					"content": "沒關係，不用專門拍那種大動作，以我現在的技術，也雕不好那種大動作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450120
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450120,
					"content": "只要拍下代宮司大人的一些小姿態，就足夠我練習了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220450121
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220450113,
					"content": "寢子不就在那邊嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450114
					]
				},
				{
					"id": 220450107,
					"content": "你要追求什麼樣的「靈性」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220450108
					]
				}
			]
		},
		{
