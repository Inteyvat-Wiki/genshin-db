			"dialogs": [
				{
					"id": 110400301,
					"content": "不好意思，關於阿貝多先生，我只能給出這種程度的描述。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400302
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400302,
					"content": "#要是能幫{F#妳}{M#你}們畫一幅他的肖像畫就好了，但是我的畫技也遠遠不如他…",
					"roleType": "TALK_ROLE_NPC",
