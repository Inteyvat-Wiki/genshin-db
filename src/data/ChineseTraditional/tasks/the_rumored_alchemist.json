			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"砂糖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400501,
					"content": "咦，蒂瑪烏斯先生今天好像不在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400502,
					"content": "（咦，這兩位是…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400503
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400503,
					"content": "#那個！嗯…是派蒙和{NICKNAME}啊，請問，{F#妳}{M#你}們是找蒂瑪烏斯有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400504
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400504,
					"content": "沒什麼沒什麼，只是平時他總是站在這裡，有點奇怪而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400505,
					"content": "哦，這樣啊。他剛剛被阿貝多先生叫走了，我是被叫來看煉金鋪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400506
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400506,
					"content": "需要我幫忙的話，就叫我的名字，如果不需要，我…我就在那邊看書，嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400507
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400507,
					"content": "#嘿嘿，謝謝妳的好意，不過不用擔心啦，煉金台的使用已經很熟悉了，對吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400508,
					"content": "嗯，不會打擾到妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400509
					]
				},
				{
					"id": 110400509,
					"content": "#{NICKNAME}，不愧是擊退了那隻風魔龍的人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400510
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400510,
					"content": "#對了，如果是{F#妳}{M#你}的話，一定能幫上阿貝多先生的忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400511
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400511,
					"content": "說起來，上次就一直從妳和蒂瑪烏斯口中聽到什麼「阿貝多先生」，他也是蒙德城的煉金術士嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400225,
					"content": "的確是沒聽過的名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "抱歉，一直沒能介紹，阿貝多先生是西風騎士團首席煉金術士，也是我和蒂瑪烏斯先生的老師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400228,
					"content": "平時看到的都是蒂瑪烏斯先生在教別人煉金術。這麼說，那他就是老師的老師？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400229,
					"content": "是的，他致力於探究世界的真相，已經有了很多很多偉大的成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400230,
					"content": "經常會有煉金術士不遠萬里來到蒙德，請求他的幫助。在他們看來艱深複雜的問題，只需要阿貝多先生稍加指點，就能完美解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400231,
					"content": "哇，居然是這麼厲害的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400232,
					"content": "嗯。可是，最近他的研究好像遇到了瓶頸，我見到他的時候，他總是一副愁眉不展的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400233,
					"content": "我能幫得到這麼厲害的人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "#{F#妳}{M#你}在冒險中一系列非凡經歷，一定會讓阿貝多先生特別感興趣，這應該能為他提供很多很多靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400236,
					"content": "#阿貝多先生是一位很有風度的人，如果{F#妳}{M#你}幫助了他，他肯定會給{F#妳}{M#你}相應的回報的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400237,
					"content": "能讓我變得更強嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
					"content": "我想應該沒問題，探究生命的極限本來也是阿貝多先生的研究內容之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400241,
					"content": "#阿貝多先生現在應該和蒂瑪烏斯先生一起在雪山做研究，我很想帶{F#妳}{M#你}們去，可是煉金鋪不能沒人顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400242
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400242,
					"content": "#就麻煩{F#妳}{M#你}們去雪山的入口找找看吧，是一位溫文爾雅的年輕先生，很有學者氣質，然後，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400243
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400243,
					"content": "#…抱歉，我也不知道要怎麼說得更清楚，還要麻煩{F#妳}{M#你}們努力辨認了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400244
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400244,
					"content": "嗯，好，放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400239,
					"content": "能讓派蒙變得更強嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400240
					]
				},
				{
					"id": 110400240,
					"content": "我沒有這個需求啦。想回報我的話，嘿嘿，用摩拉結算怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400234,
					"content": "我對煉金的瞭解只有煉金台。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400226,
					"content": "好像聽說過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				}
			]
		}
	]
}