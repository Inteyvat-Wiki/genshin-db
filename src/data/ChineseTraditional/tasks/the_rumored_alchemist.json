				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400201,
					"content": "咦，蒂瑪烏斯先生今天好像不在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400202,
					"content": "（是、是客人？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400203
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400203,
					"content": "#那個！嗯…請問，{F#妳}{M#你}們找他有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400204
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400204,
					"content": "沒什麼沒什麼，只是平時他總是站在這裡，有點奇怪而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400205,
					"content": "哦，這樣啊。他剛剛被阿貝多先生叫走了，我是被叫來幫看煉金鋪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400206
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400206,
					"content": "我叫砂糖，是阿貝多先生的助手。煉金術方面如果有問題，也可以問我，我…會盡量幫上忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400207,
						110400209
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400207,
					"content": "有自信一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400208
					]
				},
				{
					"id": 110400208,
					"content": "我…其實我很不擅長做這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400211
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400211,
					"content": "不、不好意思，平時我都在實驗室裡，不怎麼出門，也不太經常和別人說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400212
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400212,
					"content": "需要我幫忙的話，就叫我的名字，如果不需要，我…我就在那邊看書，嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400213
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400213,
					"content": "#嘿嘿，謝謝你的好意，不過不用擔心啦，煉金台的使用已經很熟悉了，對吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400214,
						110400215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400214,
					"content": "嗯，不會打擾到妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400216
					]
				},
				{
					"id": 110400216,
					"content": "#欸？{NICKNAME}…難道{F#妳}{M#你}就是傳說中的那位，擊退了風魔龍的旅行者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400217,
						110400218
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400217,
					"content": "「傳說中的」太誇張了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400220
					]
				},
				{
					"id": 110400220,
					"content": "#我聽說了很多關於{F#妳}{M#你}的故事，一直夢想著能有機會近距離研究{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400221
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400221,
					"content": "研、研究？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400222,
					"content": "啊，對不起，不用在意，一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400223
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400223,
					"content": "#不過，既然是{F#妳}{M#你}的話，一定能幫上阿貝多先生的忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400224
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400224,
					"content": "說起來剛剛就一直聽到「阿貝多先生」，他也是蒙德城的煉金術士嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400225,
						110400226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400225,
					"content": "的確是沒聽過的名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400227,
					"content": "抱歉，一直沒能介紹，阿貝多先生是西風騎士團首席煉金術士，也是我和蒂瑪烏斯先生的老師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400228
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400228,
					"content": "平時看到的都是蒂瑪烏斯先生在教別人煉金術。這麼說，那他就是老師的老師？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400229,
					"content": "是的，他致力於探究世界的真相，已經有了很多很多偉大的成果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400230
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400230,
					"content": "經常會有煉金術士不遠萬里來到蒙德，請求他的幫助。在他們看來艱深複雜的問題，只需要阿貝多先生稍加指點，就能完美解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400231
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400231,
					"content": "哇，居然是這麼厲害的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400232,
					"content": "嗯。可是，最近他的研究好像遇到了瓶頸，我見到他的時候，他總是一副愁眉不展的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400233,
						110400234
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400233,
					"content": "我能幫得到這麼厲害的人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400235,
					"content": "#{F#妳}{M#你}在冒險中一系列非凡經歷，一定會讓阿貝多先生特別感興趣，這應該能為他提供很多很多靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400236
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400236,
					"content": "#阿貝多先生是一位很有風度的人，如果{F#妳}{M#你}幫助了他，他肯定會給{F#妳}{M#你}相應的回報的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400237,
						110400239
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400237,
					"content": "能讓我變得更強嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400238
					]
				},
				{
					"id": 110400238,
					"content": "我想應該沒問題，探究生命的極限本來也是阿貝多先生的研究內容之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400241,
					"content": "#阿貝多先生現在應該和蒂瑪烏斯先生一起在雪山做研究，我很想帶{F#妳}{M#你}們去，可是煉金鋪不能沒人顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400242
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400242,
					"content": "#就麻煩{F#妳}{M#你}們去雪山的入口找找看吧，是一位溫文爾雅的年輕先生，很有學者氣質，然後，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400243
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400243,
					"content": "#…抱歉，我也不知道要怎麼說得更清楚，還要麻煩{F#妳}{M#你}們努力辨認了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400244
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400244,
					"content": "嗯，好，放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400239,
					"content": "能讓派蒙變得更強嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400240
					]
				},
				{
					"id": 110400240,
					"content": "我沒有這個需求啦。想回報我的話，嘿嘿，用摩拉結算怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400234,
					"content": "我對煉金的瞭解只有煉金台。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400235
					]
				},
				{
					"id": 110400226,
					"content": "好像聽說過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400227
					]
				},
				{
					"id": 110400218,
					"content": "可以免費幫妳簽名。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400219
					]
				},
				{
					"id": 110400219,
					"content": "啊，謝謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400220
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 110400215,
					"content": "好…好像有點忘記了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400216
					]
				},
				{
					"id": 110400209,
					"content": "別緊張。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400210
					]
				},
				{
					"id": 110400210,
					"content": "欸？我…我看上去很緊張嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400211
					],
					"speakerTitle": "砂糖"
				}
			]
		},
		{
			"id": 1104003,
			"completionStepIds": [],
