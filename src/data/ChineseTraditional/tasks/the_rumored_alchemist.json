				1104004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104004",
							"2"
						],
						"stepId": 1104004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘿莎莉亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110400401,
					"content": "原、原來妳在這裡，蘿莎莉亞小姐，唱詩班的活動馬上就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400402
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 110400402,
					"content": "都說了我不參加這種活動，我還有更重要的事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400403
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400403,
					"content": "可是，這次是有紀念性的活動，希望所有的修女都要出席。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400404
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 110400404,
					"content": "希望歸希望，我的工作內容裡又沒有「滿足別人希望」這一條。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400405
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400405,
					"content": "這、這個，話不能這麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400406
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 110400406,
					"content": "倒是妳，妳是這次活動的組織者吧，妳不覺得很奇怪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400407
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400407,
					"content": "哪、哪裡奇怪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400408
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 110400408,
					"content": "按現在的時間算，就算妳立刻趕回蒙德城，大概也趕不上活動開始的時間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400409
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400409,
					"content": "難道不是有人算好了這個，想讓妳出醜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400410
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400410,
					"content": "欸欸？怎、怎麼可能！大家不是這樣的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400411
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 110400411,
					"content": "是不是這樣的人，講的是證據，而不是妳的感覺。唉，還是說妳太容易相信別人了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400412
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400412,
					"content": "放心吧，即便妳就這麼回去了，也不會有人責怪妳。因為我看也沒有幾個人覺得我真的會去參加。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400413
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400413,
					"content": "但再拖下去，妳就真的遲到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400414
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400414,
					"content": "對啊！重要的紀念活動，如果遲到了就…那、那我回去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400415
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 110400415,
					"content": "聽上去…這位修女好像完全是在靠詭辯騙人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400416,
					"content": "#從剛才起，就注意到{F#妳}{M#你}們了——{F#妳}{M#你}們是什麼人，又為什麼要偷聽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400417
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400417,
					"content": "小心點！我覺得她是個危險人物…呃，至少，有點狡猾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400418,
					"content": "哦？相比起歷史悠久的西風教會的成員，妳這種來歷不明的小漂浮物才更危險吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400419
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400419,
					"content": "被聽到了？！我還以為我說得夠小聲了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400420,
					"content": "#嗯，帶著小漂浮物的外鄉人…原來如此，{F#妳}{M#你}就是…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400421
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400421,
					"content": "#擊退了風魔龍的「榮譽騎士」，憑這層身分，就先不急著追究{F#妳}{M#你}的偷聽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400422
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400422,
					"content": "#否則…視{F#妳}{M#你}們的回答而定，最壞的情況可能會是牢獄之災呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400423
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400423,
					"content": "欸！蒙德城的修女還能負責抓捕可疑人士的嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400424,
					"content": "至少不能對明顯存在的隱患視而不見吧，修女就不可以擁有正義感嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400425
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400425,
					"content": "呃，聽上去怪怪的，但好像沒辦法反駁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400426,
					"content": "#還是說說{F#妳}{M#你}們吧，{F#妳}{M#你}們是為什麼要到雪山來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400427,
						110400428
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400427,
					"content": "來找阿貝多先生。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400431
					]
				},
				{
					"id": 110400431,
					"content": "找他的話，我之前特意留意了一下他的足跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400432
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400432,
					"content": "雪停之後，往來雪山的人很多，希望一路上的痕跡還沒有被蓋掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400433
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400433,
					"content": "難不成，妳也是來找他的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110400434,
					"content": "不是的，這應該算職業習慣吧，因為我察覺到這些足跡上殘留了元素力，警惕一點總沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400435,
						110400436
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400435,
					"content": "以修女而言，妳好像太神秘了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400437,
					"content": "#無所謂{F#妳}{M#你}怎麼想，走吧，我也順路去看看他在幹什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400436,
					"content": "像偵探一樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400437
					]
				},
				{
					"id": 110400428,
					"content": "來探究世界的真相。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110400429
					]
				},
				{
					"id": 110400429,
					"content": "#但{F#妳}{M#你}只是個旅行者，並非什麼偉大的煉金術士吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400430
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 110400430,
					"content": "#無所謂，我大概知道{F#妳}{M#你}是想來找誰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110400431
					],
					"speakerTitle": "蘿莎莉亞"
				}
			]
		},
		{
			"id": 1104005,
			"completionStepIds": [
				1104002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1104002",
