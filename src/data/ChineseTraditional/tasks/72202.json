				"points": []
			},
			"dialogs": [
				{
					"id": 722020101,
					"content": "雷鳥大人…拋棄了我嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020102,
						722020103
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020102,
					"content": "你好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				},
				{
					"id": 722020104,
					"content": "雷鳥大人…請您不要動怒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020105
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020105,
					"content": "我會盡我之力，閱讀您的旨意，閱讀您的教諭…但是…但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020106
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020106,
					"content": "但是…為什麼您在拒絕我…為什麼…嗚嗚…嗚嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020107
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020107,
					"content": "為什麼…我無法深入您的迷霧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020108,
						722020113
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020108,
					"content": "閱讀…你在說什麼呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020109,
					"content": "您留下的雷石…我會再想辦法的…銀璨璨的船來了，我的時間不多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020110
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020110,
					"content": "雷石…那是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020111
					]
				},
				{
					"id": 722020111,
					"content": "逢嶽之野的雷石…只有操使雷電的人才能夠讓它們活起來…只有在迷霧中尋覓通路的人，才能找到它們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722020112
					],
					"speakerTitle": "知世"
				},
				{
					"id": 722020112,
					"content": "如雷鳥佇立…如雷鳥展翼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "知世"
				},
				{
					"id": 722020113,
					"content": "迷霧…不是已經消散了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020109
					]
				},
				{
					"id": 722020103,
					"content": "需要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722020104
					]
				}
			]
		},
