			"dialogs": [
				{
					"id": 760930101,
					"content": "為邊地照亮黑夜的鑄燈者啊，吾等執燈人在此宣誓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930102
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930102,
					"content": "「如是我預見：海浪翻起白沫，死寂毀滅了星月夜。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930103
					],
					"speakerTitle": "執燈士眾人"
				},
				{
					"id": 760930103,
					"content": "「如是我宣告：誰掌中燈火不滅，就不必陷入如此黑暗…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930104
					],
					"speakerTitle": "執燈士眾人"
				},
				{
					"id": 760930104,
					"content": "「我們是執燈人，無盡雪原中執燈守護永燃的希望。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930105
					],
					"speakerTitle": "執燈士眾人"
				},
				{
					"id": 760930105,
					"content": "那麼諸位，此次作戰的目標是擊退盤踞在苦壑崖的魔物…以及調查引發此次狂獵的罪魁禍首。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930106
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930106,
					"content": "時隔三年，如今我們將再度踏足崖上，進行決勝之戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930107
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930107,
					"content": "我知道你們當中許多人和我一樣，有著不得不加入這次作戰的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930108
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930108,
					"content": "要記住，我們的身後就是皮拉米達城，為了生者，為了未來，我們絕不能後退！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930109
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930109,
					"content": "正如誓言所說：「我們將使骨血做燃料，我們將使生大於死」…完成我們身為執燈士的職責吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930110
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930110,
					"content": "出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930111
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930111,
					"content": "是！隊長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "執燈士眾人"
				}
			]
		},
