			"dialogs": [
				{
					"id": 760930401,
					"content": "#可惜現在沒時間帶{F#妳}{M#你}們參觀總部了，接下來等待我們的將會是一場苦戰。{F#妳}{M#你}們要是需要做一些準備，可以盡快安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930402
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930402,
					"content": "#我就帶著大部隊先行前往「望崖營壁」做必要的戰備工作了，在那裡等{F#妳}{M#你}們會合。",
					"roleType": "TALK_ROLE_NPC",
