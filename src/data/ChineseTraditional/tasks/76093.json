				]
			},
			"dialogs": [
				{
					"id": 760930301,
					"content": "真是有夠見鬼的，這輛破車怎麼又停著不動了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930302
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930302,
					"content": "我說月廂車大哥，你就不能再多撐一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930303
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930303,
					"content": "就差那麼幾步路我們就可以回到皮拉米達了，到時候你是熄火還是拋錨都沒人管你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930304
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930304,
					"content": "結果你呢，偏偏要停在這裡。怎麼樣，難道是要我們把你抬回城裡去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930305
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930305,
					"content": "唉，真是多事之秋，不管幹什麼都觸霉頭。我才沒工夫跟你耗，羅洛老弟，看來我們要多找幾個幫手來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930306
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930306,
					"content": "哎喲，我都還沒叫人，怎麼就有兩位朋友來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930307
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930307,
					"content": "看起來不是很眼熟啊，難不成是新入行的寶藏獵人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930308
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930308,
					"content": "#你們好，我是派蒙，{M#他}{F#她}是{NICKNAME}，我們是路過這裡的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760930309,
					"content": "#看{F#妳}{M#你}們的樣子，是遇到什麼困難了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760930310,
					"content": "#喔！{F#妳}{M#你}們好，我叫安萊夫，是一名執燈士。原來兩位是冒險家啊…那{F#妳}{M#你}們恐怕來錯地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930311,
						760930312
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930311,
					"content": "放心，我們不會亂動東西的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930313
					]
				},
				{
					"id": 760930313,
					"content": "#也不是這個意思，{F#妳}{M#你}們剛來或許不知道，最近北邊的苦壑崖一帶爆發了大規模的狂獵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930314
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930314,
					"content": "那裡有一座開拓時代遺留下來的古老遺蹟，幾年前就出過事故，但沒想到會突然變得這麼嚴重…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930315
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930315,
					"content": "#{F#妳}{M#你}們往北邊看，看見了嗎？這陣子不少魔物從那邊冒出來，很不太平，{F#妳}{M#你}們要是沒什麼要緊事，最好也別在這一帶遊蕩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930316
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930316,
					"content": "這次我們就是受到了老爺子的召喚，為了參加討伐狂獵的行動才趕回皮拉米達城的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930317
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930317,
					"content": "你說對吧，羅洛老弟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930318
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930318,
					"content": "喂，你這是怎麼了？從剛才開始就一言不發的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930319
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930319,
					"content": "！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930312,
					"content": "這裡不歡迎冒險家嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930313
					]
				}
			]
		},
