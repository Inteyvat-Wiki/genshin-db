					}
				]
			},
			"dialogs": [
				{
					"id": 760930801,
					"content": "為邊地照亮黑夜的鑄燈者啊，吾等執燈人在此宣誓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930802
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930802,
					"content": "「如是我預見：海浪翻起白沫，死寂毀滅了星月夜。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930803
					],
					"speakerTitle": "執燈士眾人"
				},
				{
					"id": 760930803,
					"content": "「如是我宣告：誰掌中燈火不滅，就不必陷入如此黑暗…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930804
					],
					"speakerTitle": "執燈士眾人"
				},
				{
					"id": 760930804,
					"content": "「我們是執燈人，無盡雪原中執燈守護永燃的希望。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930805
					],
					"speakerTitle": "執燈士眾人"
				},
				{
					"id": 760930805,
					"content": "那麼諸位，此次作戰的目標是擊退盤踞在苦壑崖的魔物…以及調查引發此次狂獵的罪魁禍首。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930806
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930806,
					"content": "時隔三年，如今我們將再度踏足崖上，進行決勝之戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930807
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930807,
					"content": "我知道你們當中許多人和我一樣，有著不得不加入這次作戰的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930808
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930808,
					"content": "要記住，我們的身後就是皮拉米達城，為了生者，為了未來，我們絕不能後退！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930809
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930809,
					"content": "正如誓言所說：「我們將使骨血做燃料，我們將使生大於死」…完成我們身為執燈士的職責吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930810
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930810,
					"content": "出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930811
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760930811,
					"content": "是！隊長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "執燈士眾人"
				}
			]
		}
	]
}