							5152.701,
							228.696,
							9595.494
						],
						"pointId": 14738
					}
				]
			},
			"dialogs": [
				{
					"id": 760930501,
					"content": "羅洛老弟，你真的沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930502
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930502,
					"content": "我沒事。抱歉…想到馬上就能回到皮拉米達城，精神稍微鬆懈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930503
					],
					"speakerTitle": "羅洛"
				},
				{
					"id": 760930503,
					"content": "#你沒事就好。剛才你中了狂獵的招，多虧這位小英雄出手相助…總之謝謝{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930504
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930504,
					"content": "舉手之勞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930505
					]
				},
				{
					"id": 760930505,
					"content": "#對{NICKNAME}來說就是小菜一碟啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760930506,
					"content": "說來小英雄的身手不錯啊。怎麼樣，要不要加入我們執燈人軍團呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930507
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930507,
					"content": "#不過這樣講的話，在這個節骨眼上邀請{F#妳}{M#你}們，在外人看來可能有點恩將仇報的意思…還是算了，{F#妳}{M#你}們就當我沒說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930508
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930508,
					"content": "剛才我們對付的就是來自苦壑崖的狂獵，這些狂獵怪得很，不僅會成群結隊地襲擊遇上的活物，據說還有攝人心智的能力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930509
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930509,
					"content": "不知道它們用的是什麼邪術，會在人意志鬆懈的瞬間趁虛而入，把人裹挾進狂獵的隊伍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930510
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930510,
					"content": "這次的作戰就是要對付它們，要是不順利，從今往後還有沒有「執燈人」都難說了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930511
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930511,
					"content": "這、這麼嚴重嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760930512,
					"content": "#是啊，不過這不是{F#妳}{M#你}們冒險家…而且還是小孩子該擔心的事，就交給我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930513
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930513,
					"content": "#若是還能再見的話，我一定請{F#妳}{M#你}們喝「皮拉米達的夜鶯」，再來一點肉餡黑麥包表達感謝，這才是我們執燈人的待客之道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930514
					],
					"speakerTitle": "安萊夫"
				},
				{
					"id": 760930514,
					"content": "一定會再見的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760930515
					]
				},
				{
					"id": 760930515,
					"content": "加油啊，一定要平安回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760930516,
					"content": "那借兩位的吉言，我們就先回皮拉米達城了。有緣再會吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安萊夫"
				}
			]
		},
		{
			"id": 7609306,
			"completionStepIds": [
				7609308,
