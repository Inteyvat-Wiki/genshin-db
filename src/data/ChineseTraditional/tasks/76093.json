			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"尼基塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760930601,
					"content": "要是平常的話，我恐怕不會主動請纓，但這次的麻煩真的不需要我出手嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930602
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930602,
					"content": "哦，你來了啊，菲林斯。我還以為你不會來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930603
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930603,
					"content": "如果您真的那樣想，為何不直接減少寄信給我的頻率呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930604
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930604,
					"content": "沒記錯的話，您一個星期前就把通知送到我的燈塔來了，我要是都不來看看，也太不尊重您這位執燈長了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930605
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930605,
					"content": "總部的通知從來也沒落下你，說到底還是因為那孩子吧。在執燈人裡他跟你走得最近，總向我打聽你的近況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930606
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930606,
					"content": "他的近況如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930607
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930607,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930608
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930608,
					"content": "你還是選擇了將重任放在他的肩上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930609
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930609,
					"content": "是啊。我需要他，而我也深切地信任著他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930610
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930610,
					"content": "我已經給出了忠告，那並非尋常的狂獵，那些魔物是被吸引過來的——被某個過去被封印在苦壑崖的古老存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930611
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930611,
					"content": "關於「他」，我也略知一二，我曾在白沙皇的宮廷中與他有過一面之緣，那條毒蛇絕非等閒之輩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930612
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930612,
					"content": "我記得他的眼睛，就和現在正盯著我們的那隻一模一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930613
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930613,
					"content": "我說，菲林斯啊，你還記得我們是怎麼成為執燈人的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930614
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930614,
					"content": "你是說「你們」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930615
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930615,
					"content": "「我們」，菲林斯，我們。最近我總夢到過去的事情，夢見你我一起經歷過的那些戰場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930616
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930616,
					"content": "災難總是突然到來…無論是枕戈待旦、坦然面對之人，還是提心吊膽、心懷僥倖之輩，大限來時，無人能夠倖免。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930617
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930617,
					"content": "但你我都知道，在永恆的寧靜到來前，人的抗爭是有意義的。而我們執燈人正是這樣，用五百年的抗爭，鑄成了這座堡壘的根基。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930618
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930618,
					"content": "我看葉洛亞沒到需要補上這一課的程度吧？你比我更清楚他曾經失去過一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930619
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930619,
					"content": "這道理他想必早已知道，只是眼下，少年的心氣讓他還不願意承認罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930620
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930620,
					"content": "但我的時間也不多了…比起他即將肩負的責任，我本該為他爭取的歲月，現在也所剩無幾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930621
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930621,
					"content": "看來你決心已定了。那我就不再白費口舌了，畢竟你才是執燈長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930622
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930622,
					"content": "話說回來，上次託你尋的物品，你還記得吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930623
					],
					"speakerTitle": "尼基塔"
				},
				{
					"id": 760930623,
					"content": "執燈長先生的委託我怎麼會忘？五百年前的古物，且與最初的詠月使有著千絲萬縷的關聯。即使是我也費了不少周折…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760930624
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760930624,
					"content": "呵呵，既然如此，我們也該開始準備了。鑄燈者留下的「弓矢」，就讓我們見識一下它的威力吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼基塔"
				}
			]
		},
