			"dialogs": [
				{
					"id": 220440301,
					"content": "#喔！這些就足夠了，謝謝{F#妳}{M#你}，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440302
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440302,
					"content": "我等一下就來研究…看看怎麼樣才能把木頭雕成鳴草的模樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440303
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440303,
					"content": "唔，如果我能把這些裝飾做得好一些，種類也再做多一些的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440304
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440304,
					"content": "說不定，裝飾也能單獨拿出來賣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				}
			]
		}
