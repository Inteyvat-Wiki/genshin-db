			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220440101,
					"content": "#旅行者，{F#妳}{M#你}怎麼來了？{F#妳}{M#你}是想過來拜一拜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440102
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440102,
					"content": "你的木雕怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440103
					]
				},
				{
					"id": 220440103,
					"content": "哈哈哈，也還算順利，就是木雕的尺寸還得再拿捏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440104
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440104,
					"content": "畢竟，依照我最初的想法，這些木雕的大小最好不超過人的手掌尺寸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440105
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440105,
					"content": "這樣子，才方便拿在手裡把玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440106
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440106,
					"content": "而且，除了雕像本身之外…我還想要再做一點「裝飾」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440107
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440107,
					"content": "我之前看人做雕像的時候，除了製作雕像本身，還會在雕像旁邊搭配一些小裝飾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440108
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440108,
					"content": "比如花啦、動物啦，或者是帶花紋的底座之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440109
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440109,
					"content": "我也想為我的這種小木雕做一個帶裝飾物的底座…雖然因為尺寸問題，一個木雕應該只能附帶一個裝飾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440110
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440110,
					"content": "但是我想，只要把那些裝飾做成可以拆卸的就行了。到時候客人想要什麼裝飾，我就為它們裝上什麼裝飾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440111
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440111,
					"content": "我想要先從簡單的裝飾開始練起，比如…鳴草之類的植物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440112
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440112,
					"content": "旅行者，能請你幫我去採三株「鳴草」做參考嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440113,
						220440114
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440113,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440117
					]
				},
				{
					"id": 220440117,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者。{F#妳}{M#你}採到鳴草後，就快點帶來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440114,
					"content": "為什麼要三株？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220440115
					]
				},
				{
					"id": 220440115,
					"content": "有三株的話，我就可以同時觀察三種不同狀態的鳴草了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440116
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 220440116,
					"content": "這樣的話，我一定能雕出最好看的鳴草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220440117
					],
					"speakerTitle": "大島純平"
				}
			]
		},
