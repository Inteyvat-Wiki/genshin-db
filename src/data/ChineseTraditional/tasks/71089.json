					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890101,
					"content": "唔…好長的一封信，是志瓊留下來的呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710890102,
					"content": "沒錯，是志瓊的信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890103
					]
				},
				{
					"id": 710890103,
					"content": "可惡…還是找不到她人在哪裡，我們先回去跟瑾武說一聲吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7108902,
			"completionStepIds": [
				7108903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7108903",
							"2"
						],
						"stepId": 7108903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710890201,
					"content": "瑾武姐，我們找到了這個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710890202,
					"content": "#好了，好了，不要著急。{F#妳}{M#你}們找到了什麼？和志瓊的下落有關嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890203
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890203,
					"content": "是她留下的信，她去了層岩巨淵的更深處。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890204
					]
				},
				{
					"id": 710890204,
					"content": "…謝謝，請讓我看看她寫了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890205
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890205,
					"content": "瑾武仔細地閱讀了志瓊的信。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710890206
					]
				},
				{
					"id": 710890206,
					"content": "這個孩子…我從沒有想過這麼宏大的問題，也不好評價她的選擇。但或許…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890207
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890207,
					"content": "或許我沒能來得及重視她的發現，沒能給她足夠的尊重和理解吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890208
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890208,
					"content": "明明沒有她的地圖的話，後續的勘察根本難以完成…但我一直只顧著擔心她的身體情況，卻無視了她的努力與拼命達成的成就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890209
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890209,
					"content": "畢竟她與我們這些礦工從一開始就是不同的，我怎麼就沒有想過這點呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890210
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890210,
					"content": "她只是不想被遺忘。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710890211
					]
				},
				{
					"id": 710890211,
					"content": "對我們這些從未被神審視的普通人來說，誰又不是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890212
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890212,
					"content": "誰又不是呢…但誰像她這樣執著呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890213
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890213,
					"content": "但一旦想到自己曾在某一刻放棄了想讓自己變得偉大的執著…一旦意識到自己習慣了日復一日的平凡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710890214
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710890214,
					"content": "也就更無顏面評判志瓊這樣的年輕人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		}
	]
}