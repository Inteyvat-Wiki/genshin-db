			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5227.368,
							340.132,
							9402.115
						],
						"pointId": 361100039
					},
					{
						"sceneId": 3,
						"position": [
							5225.431,
							340.113,
							9401.865
						],
						"pointId": 361100040
					},
					{
						"sceneId": 3,
						"position": [
							5228.457,
							340.132,
							9401.264
						],
						"pointId": 361100049
					}
				]
			},
			"dialogs": [
				{
					"id": 766720202,
					"content": "白靈蛋捲、煙燻魚排、漿果煎肉還有夜守暖湯…這麼多菜，我都要吃不完啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766720203,
					"content": "嗯…我是按照為執燈士們準備晚餐的份量做的，對三個人來說可能的確有點多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720204
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766720204,
					"content": "#不過沒關係，{F#妳}{M#你}們慢慢吃。我一會還要去見老爹一趟，{F#妳}{M#你}們待到晚上都可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720205,
						766720206
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766720205,
					"content": "沒想到你廚藝這麼好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720208
					]
				},
				{
					"id": 766720208,
					"content": "其實在當隊長以前，我可是經常為大家做飯的，只是最近都沒有這樣的空閒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720209
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766720209,
					"content": "皮拉米達裡的人來自天南地北，口味也各有不同，所以各種風味的料理都得掌握一點，才能讓每一個人都盡興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720210
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766720210,
					"content": "#不過我不太知道{F#妳}{M#你}們的喜好，所以這次各種風格的都做了一點。有什麼合{F#妳}{M#你}們口味的嗎？請一定要告訴我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720211,
						766720214
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766720211,
					"content": "派蒙愛吃的我也愛吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720212
					]
				},
				{
					"id": 766720212,
					"content": "#什麼意思啦！我先說，那盤漿果煎肉已經被我看中了，{F#妳}{M#你}可不要跟我搶喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766720213,
					"content": "#哈哈，{F#妳}{M#你}們不用搶，我再多做一點就好了啊。怎麼能讓我的隊員餓肚子呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720216
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766720216,
					"content": "不管大家嘴上怎麼說，吃到愛吃的東西的時候，臉上幸福的表情可是不會騙人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720217
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766720217,
					"content": "對我來說，沒有比看到大家幸福的笑容更開心的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720218
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766720218,
					"content": "只要能讓大家露出笑容，無論是履行執燈人的職責還是端上美味的料理，我都願意去做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720219
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766720219,
					"content": "#在{F#妳}{M#你}們看來這些可能都是微不足道的小事吧？但這的確就是我最真實的願望了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720220,
						766720221
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766720220,
					"content": "不要妄自菲薄。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720222
					]
				},
				{
					"id": 766720222,
					"content": "對啊！你為大家做了這麼多，大家一定都很感謝你的。要是看你老是說自己不好，他們說不定還會生氣呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766720223,
					"content": "#至少在他們之前，我跟{NICKNAME}就會生氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766720224,
					"content": "#嘿嘿，謝謝{F#妳}{M#你}們。好了，與飯桌無關的話題就不說了，請好好享用料理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766720221,
					"content": "你可以做到這些已經很厲害了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720222
					]
				},
				{
					"id": 766720214,
					"content": "是你做的我都愛吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720215
					]
				},
				{
					"id": 766720215,
					"content": "#恭維的話就不必啦。{F#妳}{M#你}這樣說，我就更想要做出能最合{F#妳}{M#你}心意的料理了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720216
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 766720206,
					"content": "派蒙絕對吃得完。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766720207
					]
				},
				{
					"id": 766720207,
					"content": "那是當然啦，別人的心意就是要好好吃完才對吧！不過沒想到葉洛亞你的廚藝這麼好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766720208
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}