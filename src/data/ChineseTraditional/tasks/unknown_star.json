			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110101,
					"content": "#旅行者，{F#妳}{M#你}來得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110102,
					"content": "凱瑟琳，出什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110103,
					"content": "是的，發生了一件不得不請冒險家們出手相助的大事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110104,
					"content": "#有非常緊急的任務要委託給{F#妳}{M#你}，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110142
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110142,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110105
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110105,
					"content": "嗚哇…聽起來很嚴重的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110106,
					"content": "實不相瞞，我們也是第一次遇到這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110107,
					"content": "協會裡忙得不可開交，也要靠各位在外遊歷的冒險家齊心協力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110108,
						411110109
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110108,
					"content": "義不容辭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				},
				{
					"id": 411110110,
					"content": "請稍等，安全起見…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110111
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110111,
					"content": "凱瑟琳！幽夜淨土的子民啊，莫非是妳在虔誠地高呼本皇女之尊名？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110112
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110112,
					"content": "啊，來了來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110113
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110113,
					"content": "又見面了，凱瑟琳女士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110114
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411110114,
					"content": "啊！這隻烏鴉會說話？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110115,
					"content": "哈哈，何必為這等小事驚訝呢，我的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110116
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411110116,
					"content": "我忠誠的臣屬，看妳一臉憂慮，想必是那些罪愆邪佞又一次妄圖染指蒙德的安寧吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110117
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110117,
					"content": "旅行者，這位是蒙德冒險家協會的資深成員菲謝爾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110118
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110118,
					"content": "菲謝爾，奧茲，這位就是我提起過的旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110119
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110119,
					"content": "#哦？就是{F#妳}{M#你}嗎？哼…眼神不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110120
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110120,
					"content": "西風騎士團榮譽騎士與其旅伴派蒙。久仰了，很高興見到二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110121
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411110121,
					"content": "#旅人，{F#妳}{M#你}也想要對抗那無邊深邃的黑暗結晶嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110122
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110122,
					"content": "對抗…什麼什麼黑暗？黑暗什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110123,
					"content": "凱瑟琳，妳剛才說的不是這個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110125
					]
				},
				{
					"id": 411110125,
					"content": "小姐說的，就是那些<color=#00E1FFFF>隕石</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110126
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411110126,
					"content": "協會方面還不能確定隕石雨的成因及副作用。因此，我們希望冒險家能夠組成二人小隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110127
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110127,
					"content": "#旅行者，菲謝爾，希望{F#妳}{M#你}們能彼此關照，在保證自身安全的前提下行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110128
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110128,
					"content": "哼，既然是忠誠的凱瑟琳的請求，本皇女也只能允諾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110129
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110129,
					"content": "#雀躍吧！能與斷罪的皇女菲謝爾一同踏上征途，{F#妳}{M#你}之餘生都應為此感到驕傲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110130
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110130,
					"content": "這位是我的主人，來自異界·幽夜淨土的皇女菲謝爾，我是她的眷屬夜鴉，奧茲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110131
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411110131,
					"content": "好、好有來頭的人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110132,
					"content": "#我是派蒙，{F#她}{M#他}是{NICKNAME}，請多關照啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110133,
						411110134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110133,
					"content": "你剛剛說，異世界？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110135,
					"content": "#呃，以後{F#妳}{M#你}會慢慢明白的…只要和菲謝爾相處久了，就能明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110136
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 411110136,
					"content": "#區區旅人，未曾領略無盡幽夜淨土的偉大也是意料之中。無妨，我寬恕{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110137
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110137,
					"content": "寬恕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110138,
					"content": "#她的意思是「{F#妳}{M#你}好」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110139
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411110139,
					"content": "這兩個人從剛才開始就像唱雙簧一樣…主人神秘兮兮的，眷屬卻時不時拆臺，好奇怪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110140,
					"content": "二位想必有很多疑問，我們不如邊走邊說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110141
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411110141,
					"content": "話說回來，我們哪是二人小隊，明明是四人小隊啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110134,
					"content": "幽夜淨土…我還是第一次聽說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110135
					]
				},
				{
					"id": 411110109,
					"content": "謝謝妳告訴我，我馬上動身。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110110
					]
				}
			]
		},
		{
			"id": 4111105,
			"completionStepIds": [
				4111105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4111105",
							"2"
						],
						"stepId": 4111105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲謝爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411110501,
					"content": "這裡就是凱瑟琳所說離蒙德最近的事發地點，清泉鎮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110502,
					"content": "看來，情況比預想還嚴重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110503
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411110503,
					"content": "許多人倒下了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110504
					]
				},
				{
					"id": 411110504,
					"content": "祝聖之鐘當鳴！斷罪之時已至！讚頌吧，呼喚救贖的人，只因「斷罪皇女」降臨此間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110505
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110505,
					"content": "這位皇女還真是有幹勁啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
