			"dialogs": [
				{
					"id": 411111701,
					"content": "啊！我還以為我會死在那裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111702
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 411111702,
					"content": "臭小子！非常時期，還敢惹麻煩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111703
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 411111703,
					"content": "我錯了，我再也不敢了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111704
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 411111704,
					"content": "實在是非常抱歉，我一定好好教訓他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111705
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 411111705,
					"content": "下次可別亂跑了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411111706,
					"content": "隕石就在那邊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111707
					]
				},
				{
					"id": 411111707,
					"content": "我去看看有什麼…咦？皇女，妳的<color=#00E1FFFF>神之眼</color>在<color=#00E1FFFF>閃</color>哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411111708,
					"content": "咦？難道說，冷冽詛咒已經意識到，這淵色秘珠裡流淌的能量，正在奏響它命運的挽歌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111709
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411111709,
					"content": "唔，神之眼會對什麼東西起反應嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411111710,
					"content": "世界的幽邃，群星的低語。魔骸的詛咒，還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111711
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411111711,
					"content": "都是些什麼呀！妳說話真的很難懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411111712,
					"content": "失禮了，皇女對凡人的語言並不熟悉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111713
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411111713,
					"content": "所以才要靠你翻譯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411111714,
					"content": "在下惶恐，這不是翻譯，只是代傳皇女的意旨。我想周遭會對<color=#00E1FFFF>神之眼</color>造成影響的，恐怕只有<color=#00E1FFFF>元素力</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111715
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411111715,
					"content": "嗯，辛苦你了，奧茲。被塵世凡俗掩沒雙眼之人，總是無法像你這樣，第一時間領會本皇女的真意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111716
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411111716,
					"content": "隕石中含有元素力？神之眼會發光，是在回應元素力的呼喚嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411111717,
						411111718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411111717,
					"content": "神之眼可以反向搜尋元素力嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				},
				{
					"id": 411111719,
					"content": "感覺…也許可以？要不然我們就先試試，能不能利用<color=#00E1FFFF>神之眼</color>來搜索<color=#00E1FFFF>隕石碎片</color>、清理危害吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411111718,
					"content": "這種呼喚會雙向發生嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411111719
					]
				}
			]
		},
