				"points": []
			},
			"dialogs": [
				{
					"id": 411110601,
					"content": "凡人，本皇女恩許你免卻禮節，就這樣將機要線索悉數稟報吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110602
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110602,
					"content": "哎？妳是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110603
					],
					"speakerTitle": "喬伊斯"
				},
				{
					"id": 411110603,
					"content": "無意冒犯，先生。只是想請您透露一些有關病患的資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110604
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411110604,
					"content": "啊啊請不要誤會！我們是冒險家協會成員，受委託前來調查情況的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110605,
					"content": "噢，好的。昨天晚上，這個人摸了地上的隕石，很快便昏睡過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110606
					],
					"speakerTitle": "喬伊斯"
				},
				{
					"id": 411110606,
					"content": "所以，你們調查時千萬不能直接觸碰隕石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110607
					],
					"speakerTitle": "喬伊斯"
				},
				{
					"id": 411110607,
					"content": "粗莽的進諫。本皇女自有淵色秘珠秘法加護，區區黑晶可奈我何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110608
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110608,
					"content": "不不，小姐，您是皇女，有必要聽取正確的諫言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110609
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 411110609,
					"content": "是嗎…看來只能照辦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110610
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110610,
					"content": "#{NICKNAME}，您是…您是冒險家，有必要聽取正確的諫言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110611,
					"content": "好、好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411110612
					]
				},
				{
					"id": 411110612,
					"content": "難得說說這種話，感覺還不錯呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411110613,
					"content": "是在模仿本皇女嗎？哼，一千世界寂滅的悲願豈是凡人所能領會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110614
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110614,
					"content": "#不過也好。畢竟對{F#妳}{M#你}而言，「斷罪皇女」的命運還是太過沉重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411110615
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 411110615,
					"content": "請、請皇女移駕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
