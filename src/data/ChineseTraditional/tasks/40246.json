			"dialogs": [
				{
					"id": 402460701,
					"content": "準備好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460702
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460702,
					"content": "嗯，我會先嘗試著和他們溝通兩句。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460703
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460703,
					"content": "但這些靈魂的聚合體恐怕已經失去了理智，如果無法溝通，事態很可能演變為一場戰鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460704
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460704,
					"content": "好，假如變成了最壞的情況，我會找個地方好好躲著的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460705,
					"content": "#嗯，真的打起來的話，最後一擊讓我來，{F#妳}{M#你}們不要出手。相信我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460706
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460706,
					"content": "明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460707
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460707,
					"content": "#好了，{F#妳}{M#你}們安靜點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460708
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460708,
					"content": "…隨潮汐飄搖的遊魂，我呼喚你們。被分離、被遺棄、被迫沉默的碎魂啊，循著舊日的氣息歸來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460709
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460709,
					"content": "…讓失名的怨恨彼此識別，讓禁穢的惡質相互吸引，在此，重新聚合成形！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460710
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460710,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460711
					]
				},
				{
					"id": 402460711,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460712,
					"content": "（…然後呢？這樣就結束了？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460713
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460713,
					"content": "（啊…所以我才對付不來這些魔法秘術什麼的…根本不知道演算法進展到了哪一步，術式邏輯也看不通透。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460714
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460714,
					"content": "（和我熟知的機械科學完全…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460715
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460715,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460716
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460716,
					"content": "當心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460717
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460717,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460718
					],
					"speakerTitle": "「遊魂的怨意」"
				},
				{
					"id": 402460718,
					"content": "那邊的人——或者說裡面的人——能聽懂我說話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460719
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460719,
					"content": "我是楓丹「奇械公」，阿蘭·吉約丹的後人。我有辦法幫你們恢復原樣，回歸地脈。只需要你們稍微配合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460720
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460720,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460721
					],
					"speakerTitle": "「遊魂的怨意」"
				},
				{
					"id": 402460721,
					"content": "桑多涅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460722
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460722,
					"content": "呿…這架勢，看來是怎麼都勸不動了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460723
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460723,
					"content": "好吧。那就陪你們發洩發洩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
