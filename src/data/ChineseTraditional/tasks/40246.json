						402461107
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461107,
					"content": "妳剛才去哪了，哥倫比婭小姐？怎麼一轉眼就從片場消失，又突然…呃，和這位小姐一起出現，擁抱著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461108
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 402461108,
					"content": "你…你們剛才…在拍…拍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461109
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461109,
					"content": "事情發生得太突然，留影機一直在運轉，剛才的畫面也拍下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461110
					],
					"speakerTitle": "千織"
				},
				{
					"id": 402461110,
					"content": "這位難道就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461111
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 402461111,
					"content": "嗯，她就是我最好的朋友。沒想到真的能和她再次相見。我好高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402461112,
					"content": "看來，這部映影有了個好結局呢。桑多涅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402461113,
					"content": "…桑多涅？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402461114,
					"content": "果然…果然我還是覺得妳好煩人啊！！哥·倫·比·婭！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
