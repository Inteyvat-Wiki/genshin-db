			"dialogs": [
				{
					"id": 402460901,
					"content": "這樣就…結束了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460902,
					"content": "結束了。說了這是很簡單的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460903
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460903,
					"content": "妳是怎麼做到的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460904
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460904,
					"content": "那個怨意的集合體，不過是眾多無家靈魂聚合在一起的產物，其中混雜著許多汙穢與邪念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460905
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460905,
					"content": "我不過是將它們最原本的靈魂與汙穢分離，讓它們得以被現在的世界規則容納罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460906
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460906,
					"content": "「世界式」的原理是「發散」。從一個原點出發，解構與重組世界的可能性，從中尋找答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460907
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460907,
					"content": "而利用「數秘陣列」反向運算「世界式」，就能達到歸攏收束與還原的功能——即術式的反轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460908
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460908,
					"content": "這類似數理中的同調歸約，在不改變群體本質的情況下，將他們還原為更簡單和實質性的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460909
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460909,
					"content": "#所以…呃，算了。看{F#妳}{M#你}們的樣子也不是真的想搞明白這些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460910
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460910,
					"content": "我好像理解外地人聽煙謎主薩滿講東西是什麼感覺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460911
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402460911,
					"content": "總…總之我知道很了不起就對了！妳果然很厲害呢！桑多涅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460912,
					"content": "笑話，我一直很厲害！哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460913
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460913,
					"content": "不愧是析構萬理的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460914
					]
				},
				{
					"id": 402460914,
					"content": "這個就算了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460915
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402460915,
					"content": "差…差不多該走了！我去把格式塔內部的機關還原一下，我們岸上見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				}
			]
		},
