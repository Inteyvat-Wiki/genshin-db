			"dialogs": [
				{
					"id": 402461201,
					"content": "茜特菈莉，我們來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402461202,
					"content": "喲。滿準時嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461203
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461203,
					"content": "妳才是…昨天喝那麼多沒關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402461204,
					"content": "呵？妳是小看奶奶我了？就那點可醉不倒我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461205
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461205,
					"content": "可是妳後來都開始亂說話了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402461206,
					"content": "有…有嗎？我怎麼不記得？我沒說什麼…了不得的事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461207
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461207,
					"content": "罵孫子罵了半小時、抱怨煙謎主工作抱怨了半小時、分享輕小說分享了一小時…還有…呃，好像後面我也睡著了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402461208,
					"content": "…她們走了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461209
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461209,
					"content": "她們？哦，是說劇組吧？已經走了，我們剛好在甲板碰上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402461210,
					"content": "不過，既然妳都解決了自己的問題，為什麼還不去見哥倫比婭呢？她明明很想見妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402461211,
					"content": "我…我想先處理完手上這爛攤子再去見她。再說了，這麼好一個嚇她一跳的機會，我肯定得多計劃計劃啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461212
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461212,
					"content": "不說這個了，那個汙穢聚合體的位置找到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461213
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461213,
					"content": "當然，黑曜石奶奶我說辦得到就辦得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461214
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461214,
					"content": "辛苦了。我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461215
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461215,
					"content": "莫爾泰區…嗯？這不是格式塔嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461216
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461216,
					"content": "果然還是對自己靈魂被切割時的地方怨意最深嗎？還是說，這是對「水仙十字」的怨意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461217
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461217,
					"content": "#我陪{F#妳}{M#你}們一起去吧。這東西的出現地點其實不算很固定，如果它不在那的話，我也有辦法用某種儀式把它招過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461218
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461218,
					"content": "真的嗎？但這件事已經給妳添了很多麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461219
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461219,
					"content": "別客氣，這老骨頭閒著也是閒著，幫小年輕招個魂什麼的還累不到我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461220
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461220,
					"content": "#（我不去的話誰知道{F#妳}{M#你}們又會聊出什麼我參與不了的話題？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461221
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 402461221,
					"content": "好吧，那就辛苦妳了。謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402461222
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 402461222,
					"content": "嘿嘿，那麼事不宜遲，我們這就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
