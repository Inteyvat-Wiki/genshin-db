					{
						"sceneId": 3,
						"position": [
							3538.825,
							452.648,
							4179.689
						],
						"pointId": 16573
					}
				]
			},
			"dialogs": [
				{
					"id": 402460201,
					"content": "昨天茜特菈莉喝得還滿多的，也不知道她現在醒了沒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460202,
					"content": "早安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460203
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460203,
					"content": "呃啊！哥倫比婭！妳…妳怎麼在這裡？不對，妳怎麼老是喜歡從人背後出現啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460204,
					"content": "今早和大家一起來這邊補個鏡頭，剛剛拍完。我就先到甲板上來透透氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460205,
					"content": "其他人好像還在下面討論有關「最後一幕」的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460206
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460206,
					"content": "最後一幕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460207,
					"content": "嗯，就是這部映影的結尾。大家在煩惱故事中的女主角最終有沒有找到自己曾經的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460208
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460208,
					"content": "啊…這兩天做別的事情都快忙到忘了，這部藝術片的確是以主角發現友人不見了，所以回到她故鄉為背景的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460209,
					"content": "嗯，芙寧娜導演和千織小姐認為從故事韻味上來說，最終兩人沒有相見的悲劇式結尾會更加令人惋惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460210,
					"content": "澤維爾導演則認為相見的結局更加令人感動，療癒人心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460211
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460211,
					"content": "哥倫比婭怎麼想？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460212
					]
				},
				{
					"id": 402460212,
					"content": "我嗎？我…我不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460213
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460213,
					"content": "如果是「我」的話，我當然想和她見面…多希望她真的還能和我見面…哪怕是在映影中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460214
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460214,
					"content": "但想到這樣意味著要讓另一個人來演她，我心中又有些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460215
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460215,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460216,
					"content": "先別擔心這些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460217
					]
				},
				{
					"id": 402460217,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460218
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460218,
					"content": "對啊對啊，別因為這個就愁眉苦臉的，映影就應該享受地去拍才對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460219,
					"content": "而且…我、我敢向哥倫比婭保證！事情一定會順利的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460220,
					"content": "順利？指的是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460221,
					"content": "呃，就…就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460222,
					"content": "一定會是個好結局。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460223
					]
				},
				{
					"id": 402460223,
					"content": "嗯！就是這個意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460224,
					"content": "#哈…好吧。我相信{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460225
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460225,
					"content": "#那就像{F#妳}{M#你}們說的，先享受拍戲的過程吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460226
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460226,
					"content": "#喲？這不是{NICKNAME}和派蒙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460227
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 402460227,
					"content": "喲？這不是翹班的燈光師和場記嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460228
					],
					"speakerTitle": "千織"
				},
				{
					"id": 402460228,
					"content": "呃…抱歉…這次拍攝我們請假是有些頻繁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402460229,
					"content": "#呵呵，開個玩笑，別往心裡去。我們這次拍攝滿順利的，{F#妳}{M#你}們先安心忙自己的事就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460230,
						402460231
					],
					"speakerTitle": "千織"
				},
				{
					"id": 402460230,
					"content": "感謝各位諒解…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				},
				{
					"id": 402460232,
					"content": "咦？哥倫比婭小姐似乎心情好了不少。啊，抱歉，是我們剛才討論結局的話題讓妳為難了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460233
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 402460233,
					"content": "#沒關係，我現在沒事了。{NICKNAME}和派蒙已經幫我想通了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460234
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460234,
					"content": "哦？那是想拍個相見的結局還是不相見的結局？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460235
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 402460235,
					"content": "拍個好結局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402460236
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 402460236,
					"content": "…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 402460231,
					"content": "之後一定補償…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402460232
					]
				}
			]
		},
