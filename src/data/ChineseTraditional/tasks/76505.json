			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦雷莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765050101,
					"content": "#{NICKNAME}和派蒙？真是巧呀！我之前聽說{F#妳}{M#你}們出發去挪德卡萊了，沒想到這麼快就能在這裡碰到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050102
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050102,
					"content": "對啊對啊，我還以為我看錯了呢！瓦雷莎，妳怎麼也跑到這麼遠的地方來啦？難道也是來旅行的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765050103,
					"content": "嘿嘿，差不多吧！我這次是來幫家裡的果園採購一批農用機械的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050104
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050104,
					"content": "爸爸說挪德卡萊這邊有些好東西，能讓果子長得更好，也能讓我省點力氣，這樣我就有更多的時間睡覺…和健身了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050105
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050105,
					"content": "來了之後發現，這裡有好多納塔沒有的好吃的！這幾天除了辦正事以外，我幾乎所有時間都花在吃吃喝喝上面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050106
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050106,
					"content": "不知不覺，馬上就要到回程的時間了，都有點不捨得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050107
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050107,
					"content": "所以呀，我要把握最後的機會，再好好逛逛，把沒吃過的都吃一遍，沒看過的都看個夠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050108
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050108,
					"content": "#{F#妳}{M#你}們呢？讓我猜猜…我們無敵的大英雄{NICKNAME}，是不是又在這片新的土地上忙著維護正義呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050109,
						765050110
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050109,
					"content": "我們正在四處參觀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				},
				{
					"id": 765050111,
					"content": "嘿嘿，我懂我懂！到了新的國家，看什麼都新鮮得不得了，簡直想把每個有趣的角落，都用留影機「咔擦」一下保存下來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050112
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050112,
					"content": "這麼說來…哎呀！我應該也把在這裡吃過的所有美食都仔仔細細地拍下來才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050113
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050113,
					"content": "這樣的話，等我回納塔，說不定能讓阿托力大叔照著畫片，嘗試把這些美味都給還原出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050114
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050114,
					"content": "瓦雷莎說不定能當美食攝影師呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050115
					]
				},
				{
					"id": 765050115,
					"content": "嘿嘿，真的嗎？美食攝影師啊…聽起來就很棒！每天都能和好吃的打交道，還能把它們拍得讓人看了就流口水！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050116,
						765050117
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050116,
					"content": "在拍攝美食之前…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050118,
					"content": "欸，要拍我嗎？真的可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050119
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050119,
					"content": "#我、我的頭髮有沒有亂？嘴角沒沾到醬汁吧？哎呀，早知道今天會遇到{F#妳}{M#你}們，我就把昨天在市集買到的飾品戴上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765050120,
						765050121
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050120,
					"content": "妳現在這樣就很好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050122,
					"content": "#好！那…那就拜託{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 765050121,
					"content": "我想拍下妳開心的樣子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050122
					]
				},
				{
					"id": 765050117,
					"content": "可以為妳拍攝畫片嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050118
					]
				},
				{
					"id": 765050110,
					"content": "順便尋找拍攝素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765050111
					]
				}
			]
		},
