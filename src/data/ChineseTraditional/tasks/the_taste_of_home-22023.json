			},
			"dialogs": [
				{
					"id": 220230101,
					"content": "唔…要是能吃到璃月菜就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230102
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230102,
					"content": "妳怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230103
					]
				},
				{
					"id": 220230103,
					"content": "#{F#妳}{M#你}是？這身打扮…{F#妳}{M#你}就是旅行者吧。抱歉，我只是有點想家而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230104,
						220230105
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230104,
					"content": "妳剛剛說想吃璃月菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				},
				{
					"id": 220230118,
					"content": "#欸？莫非…{F#妳}{M#你}會做璃月菜嗎？那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230119
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230119,
					"content": "#那、那就請{F#妳}{M#你}快點幫幫我，做點正宗的璃月菜給我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230120
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230120,
					"content": "讓我想想…我現在的最想吃的就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230121
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230121,
					"content": "嗯！我想要吃肉！大口吃肉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230122
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230122,
					"content": "那種細膩的質感，還有那肉脂與璃月特色佐料混合在一起，散發而出的絕頂香氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230123
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230123,
					"content": "一想起這樣的肉，我就情不自禁地顫抖起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230124
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230124,
					"content": "所以，我想吃肉！請幫我準備一份用肉做成的璃月菜吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230105,
					"content": "遇到什麼麻煩了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230106
					]
				},
				{
					"id": 220230106,
					"content": "先自我介紹一下，我叫湯雯，是來自璃月的歷史學者，之前正在實地調研稻妻的特色風俗與民話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230107
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230107,
					"content": "本來資料已經蒐集得差不多了，正準備返回璃月。但是因為稻妻的鎖國令結被迫滯留在這裡，已經有一段時間了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230108
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230108,
					"content": "其實，我覺得這對我來說也算是好事。因為我感覺，此刻的稻妻正處於一個歷史性的時刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230109
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230109,
					"content": "我很確信，這段特殊的時期，必然會在提瓦特的史冊上留下濃墨重彩的一筆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230110
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230110,
					"content": "親眼見證這樣的歷史，然後真實、完整、清晰地將這一切記錄成冊，留給後人，就是歷史學者所要做的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230111
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230111,
					"content": "不過…雖然這樣的事業很讓我振奮，但它可沒辦法滿足我的肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230112
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230112,
					"content": "妳是餓了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230113
					]
				},
				{
					"id": 220230113,
					"content": "也不能說…是餓啦…哈哈哈，稻妻的食物都還挺好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230114
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230114,
					"content": "我特別喜歡這邊的「天婦羅」，雖然感覺…就是把東西裹上麵衣炸一炸啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230115
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230115,
					"content": "但是吃久了稻妻菜，我還是想要再吃點璃月菜。不過，我一直都找不到能做出正宗璃月菜的餐館。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230116
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230116,
					"content": "我前幾天都狠下心來，去冒險家協會掛了一道「烹飪委託」，但到現在也沒回音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230117
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230117,
					"content": "我可以試試嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230118
					]
				}
			]
		},
