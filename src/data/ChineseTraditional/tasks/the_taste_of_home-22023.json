			"dialogs": [
				{
					"id": 220230201,
					"content": "#這麼快就回來了？{F#妳}{M#你}不會是個深藏不露的大廚吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230202
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230202,
					"content": "嗯…我都快要等不及了，請讓我嚐一嚐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230203,
						220230204
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220230203,
					"content": "請享用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220230204,
					"content": "我想想…剛剛討論了哪些菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220230205
					]
				},
				{
					"id": 220230205,
					"content": "唔…是摩拉肉、乾鍋臘肉，還有稠汁蔬菜燉肉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220230206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220230206,
					"content": "決定好就交給湯雯小姐吧!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
