			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"弗麗德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705320101,
					"content": "嗯…還要加入這張牌…咦？還有幾張牌呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320102
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320102,
					"content": "#咦？旅行者！抱歉抱歉，我剛才在想牌組的事，沒注意到{F#妳}{M#你}過來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320103
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320103,
					"content": "我是由冒險家協會委派來協辦「召喚王大獎賽」的冒險家，我這邊負責的是…嗯…一種有著特殊規則的卡牌對決！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320104
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320104,
					"content": "我們把它取名為「零時召喚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320105,
						705320106
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320105,
					"content": "結果就是普通的打牌嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705320107
					]
				},
				{
					"id": 705320107,
					"content": "不不不，我們「零時召喚」屬於坊間比賽，有一套特別的規則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320108
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320108,
					"content": "簡單來說就是，參賽者不能使用自己收藏的卡牌，而是要從我們已經準備好的八套不完整卡牌組中挑選三套，組成一套完整的牌組。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320109
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320109,
					"content": "#在這三組牌組中，還有一些剛推出的全新卡牌，至於如何使用它們…就看{F#妳}{M#你}打牌的本事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320110
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320110,
					"content": "除了這些之外，其他的規則就和正常的對局沒什麼不同啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320111
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320111,
					"content": "#要是{F#妳}{M#你}覺得自己沒有什麼可靠的組牌想法，我們也可以幫{F#妳}{M#你}建構牌組…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320112
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320112,
					"content": "但是組出來的牌組究竟好不好用嘛…嘿嘿，那就不知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320113
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320113,
					"content": "#總之，我的建議還是由{F#妳}{M#你}自己來挑選並建構牌組啦，畢竟{F#妳}{M#你}可是要拿著這套牌去和別人對決的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320114
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320114,
					"content": "如果您對自己的實力有信心，甚至可以去其他的「召喚王大獎賽」舉辦區域，繼續玩「零時召喚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320115
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320115,
					"content": "#啊，當然啦，{F#妳}{M#你}也不用有什麼心理負擔，只要參加「零時召喚」，無論對局的結果是勝是敗，我們都有好禮相贈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705320116
					],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320116,
					"content": "#旅行者，{F#妳}{M#你}要是有興趣的話，就來體驗一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗麗德"
				},
				{
					"id": 705320106,
					"content": "和「召喚王大獎賽」的感覺一樣嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705320107
					]
				}
			]
		}
	]
}