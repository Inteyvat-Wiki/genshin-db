					"阿幸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230701,
					"content": "別…別追了，已經繞了三圈又繞回原地了，我實在跑不動了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230702
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230702,
					"content": "為了利益不惜與外人勾結，你這傢伙十惡不赦！就算讓我再跑十圈我也絕對不會饒了你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230703
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230703,
					"content": "#呼…旅行者，看{F#妳}{M#你}一臉輕鬆，剛才的麻煩已經都解決掉了吧，感謝{F#妳}{M#你}幫了我這麼多忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230704
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230704,
					"content": "雷櫻樹的力量絕對不能落入這種傢伙的手裡，更何況這件事背後還有愚人眾作祟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230705
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230705,
					"content": "很難說愚人眾到底打了什麼鬼主意，我既然逮住了這傢伙，就一定會問個明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230706
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230706,
					"content": "後續的處理就交給我吧，幕府軍駐紮的地方我也認識，這傢伙是跑不掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿幸"
				}
			]
		},
