				"objectNames": [
					"阿幸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230401,
					"content": "雷櫻樹怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230402
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230402,
					"content": "「小手腳」已經全被清理掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230403
					]
				},
				{
					"id": 721230403,
					"content": "太好了，這樣雷櫻樹的狀況也會穩定下來，神子大人應該也能安心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230404
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230404,
					"content": "這些膽大妄為的傢伙，竟敢盜竊雷櫻樹的力量用來牟利，簡直罪無可恕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230405
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230405,
					"content": "#而且{F#妳}{M#你}提到，盜寶團營地裡有一顆聚集雷櫻樹力量的結晶？那也太危險了，一定要盡快處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230406
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230406,
					"content": "#之前麻煩{F#妳}{M#你}幫了我那麼多，這次我實在不好意思再讓{F#妳}{M#你}一個人行動了，我也會去一起處理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230407
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230407,
					"content": "事不宜遲，我們現在就走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿幸"
				}
			]
		},
		{
			"id": 7212305,
			"completionStepIds": [
				7212315
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
