				"points": []
			},
			"dialogs": [
				{
					"id": 721230602,
					"content": "晦氣，我這是碰上了什麼硬骨頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230603
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230603,
					"content": "你們這些無恥的傢伙，居然跟愚人眾相互勾結，鳴神大人的懲罰早晚會降到你們頭上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230604
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230604,
					"content": "#別、別以為{F#妳}{M#你}們能唬住我，搞砸了我的買賣還想把我人也折進去，沒門！我還有最後一招。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秀秋"
				}
			]
		},
		{
			"id": 7212307,
			"completionStepIds": [
				7212319
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
