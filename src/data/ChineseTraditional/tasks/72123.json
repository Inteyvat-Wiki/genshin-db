			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿幸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230901,
					"content": "#說起來，雷櫻樹的位置{F#妳}{M#你}應該都知道吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230902
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230902,
					"content": "#…看{F#妳}{M#你}的反應，我明白了，{F#妳}{M#你}應該還不清楚雷櫻樹的位置。也難怪，{F#妳}{M#你}畢竟是外來的旅行者，是我太過想當然爾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230903
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230903,
					"content": "那五棵雷櫻樹並不難找，只要沿著<color=#00E1FFFF>西側的海岸線</color>，從九條陣屋所在島嶼的<color=#00E1FFFF>最北端</color>一路走到<color=#00E1FFFF>踏鞴砂的最北端</color>，就能發現其中三棵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230904
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230904,
					"content": "另外兩棵雷櫻樹，一棵長在<color=#00E1FFFF>踏鞴砂西北面</color>的山崖上，一棵長在<color=#00E1FFFF>踏鞴砂西南面</color>的山崖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230905
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230905,
					"content": "#現在我為{F#妳}{M#你}指明了方向，事情應該容易些了。那麼，雷櫻樹的事情就拜託{F#妳}{M#你}了，路上還請小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿幸"
				}
			]
		}
	]
