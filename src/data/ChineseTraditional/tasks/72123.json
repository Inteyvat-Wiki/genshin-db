			"trigger": {
				"objectNames": [
					"秀秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230501,
					"content": "哼，原來是妳這個女人要妨礙我賺錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230502
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230502,
					"content": "你們真是不知好歹，雷櫻樹的主意也敢打，神子大人不會讓你們好過的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230503
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230503,
					"content": "#少說大話了，{F#妳}{M#你}們也不看看惹到的是誰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230504
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230504,
					"content": "大爺，妨礙您生意的就是那邊那個旅行者，您不出手我們的買賣就吹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230505
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230505,
					"content": "呵呵，就憑這弱不禁風的身形，也敢在我面前逞威風？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愚人眾先遣隊"
				}
			]
		},
		{
			"id": 7212306,
			"completionStepIds": [
				7212317
			],
