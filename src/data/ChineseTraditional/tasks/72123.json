	"talks": [
		{
			"id": 7212302,
			"completionStepIds": [
				7212305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212305",
							"2"
						],
						"stepId": 7212305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"秀秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230204,
					"content": "別、別殺我，雷櫻樹的事情跟我一點關係都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230205
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230205,
					"content": "你怎麼知道我們是為了雷櫻樹的事情來的？你果然做了虧心事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230206,
					"content": "恐怕這個和無相之雷一樣的東西，也是你們從不正當的管道弄來的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230207,
					"content": "#我…{F#妳}{M#你}們…這關{F#妳}{M#你}們什麼事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230208
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230208,
					"content": "我受人之託。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230209
					]
				},
				{
					"id": 721230209,
					"content": "對，我們受人之託，代行正義！盜寶團到底對雷櫻樹做了什麼，這東西是哪裡來的，快老實交待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230210,
					"content": "不乖乖交待的話，哼哼，旅行者的劍可是很厲害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230211,
					"content": "我說我說！那什麼，這幾棵樹反正也沒人管，我帶弟兄幾個借它們的力量賺一筆也沒什麼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230212
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230212,
					"content": "有個厲害的買家對雷櫻樹有點興趣，而且對方連導出雷櫻樹力量的方法和工具都提供好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230213
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230213,
					"content": "只要我們按照買家說的，在樹上開個口子，嘿嘿，要用工具汲取雷櫻樹的力量就輕輕鬆鬆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230214
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230214,
					"content": "然後再把力量導入到這座結晶裡去，咱就賺到了能抵三座天領奉行大宅的寶貝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230215
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230215,
					"content": "#買家可是提供了一大筆報酬，{F#妳}{M#你}這種小角色一輩子也花不完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230216
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230216,
					"content": "#{F#妳}{M#你}願意放過我的話，我還能勉為其難算{F#妳}{M#你}一份，到時候一九分帳，{F#妳}{M#你}一我們九。怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230217,
						721230218
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230217,
					"content": "太少了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				},
				{
					"id": 721230219,
					"content": "#什麼？可惡，我可是好心提供{F#妳}{M#你}們生路，等買主到了，{F#妳}{M#你}們都得哭著來求我秀秋大爺的原諒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230220
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230220,
					"content": "口氣也太大了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230221,
					"content": "小東西，妳囂張什麼，我的兄弟們馬上就會找到幫手回來救我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230222
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230222,
					"content": "哪怕你們再叫一百個人來，也碰不到派蒙我的一根頭髮，旅行者會把你們統統打跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230223,
					"content": "山田，這小東西說你們根本傷不著她，你還不出手？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230224
					],
					"speakerTitle": "秀秋"
				},
				{
					"id": 721230224,
					"content": "山田？那是誰呀…不好！旅行者快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230225,
					"content": "欸？根本什麼人都沒有嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721230218,
					"content": "在做夢吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230219
					]
				}
			]
		},
		{
			"id": 7212303,
			"completionStepIds": [
				7212306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212306",
							"2"
						],
						"stepId": 7212306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿幸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721230301,
					"content": "#{F#妳}{M#你}有什麼發現嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230302
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230302,
					"content": "關於秀秋…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230303
					]
				},
				{
					"id": 721230303,
					"content": "居然有這麼一回事？但盜寶團動的那點小手腳真能引起這麼嚴重的後果嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230304
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230304,
					"content": "雷櫻樹的凋零說不定還有其他原因…我有些猜想，不知道準不準確…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230305
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230305,
					"content": "什麼意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230306
					]
				},
				{
					"id": 721230306,
					"content": "這裡是神無塚啊，不論是稻妻人的信仰，還是珊瑚宮人的信仰，都無法照耀的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230307
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230307,
					"content": "眼狩令頒佈之後，幕府軍和叛軍經常在這裡發生衝突，軍隊的人可不會在乎是否波及到了雷櫻樹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230308
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230308,
					"content": "用神子大人的話來說，那都是些「滿腦子只有功勳的傢伙」，沒法講道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230309
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230309,
					"content": "我們神社對這一點早就有心理準備，但是沒想到，雷櫻樹的狀況已經糟到這個地步了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230310
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230310,
					"content": "#總之，當務之急是把盜寶團動的那些小手腳清理掉，旅行者，我能再次拜託{F#妳}{M#你}嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230311,
						721230313
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230311,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230312
					]
				},
				{
					"id": 721230312,
					"content": "請千萬不要掉以輕心，正因為雷櫻樹變得脆弱了情況才會變危險，畢竟樹下還鎮守著那位大人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230315,
					"content": "#啊，我不該多嘴的，{F#妳}{M#你}、{F#妳}{M#你}就當沒聽見吧。總之，一定要小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230316
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230316,
					"content": "我也需要點時間整理狀況，畢竟這件事現在還有疑點：到底是誰在背後指點盜寶團？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230317
					],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230317,
					"content": "事情變得複雜起來了，真是棘手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿幸"
				},
				{
					"id": 721230313,
					"content": "清理應該很容易吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721230314
					]
				},
				{
					"id": 721230314,
					"content": "恐怕沒那麼簡單，正因為雷櫻樹變得脆弱了情況才會變危險，畢竟樹下還鎮守著那位大人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721230315
					],
					"speakerTitle": "阿幸"
				}
			]
		},
		{
			"id": 7212304,
