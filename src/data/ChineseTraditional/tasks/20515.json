			},
			"dialogs": [
				{
					"id": 205150101,
					"content": "安娜又跑到哪去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150102
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205150102,
					"content": "又找不到安娜了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150103
					]
				},
				{
					"id": 205150103,
					"content": "對啊，我都要把全城找遍了，就是找不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150104
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205150104,
					"content": "#{F#妳}{M#你}也幫我找找吧，我已經累得走不動了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150105,
						205150107
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205150105,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150106
					]
				},
				{
					"id": 205150106,
					"content": "#那就拜託{F#妳}{M#你}了，這丫頭，她的病是快好了，再這麼搞下去，我就要得病了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205150111,
					"content": "對了…之前安娜說，她一直想去教堂感謝修女們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150112
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205150112,
					"content": "#{F#妳}{M#你}不如先去教堂附近看看，還有，{F#妳}{M#你}可以去問問艾伯特先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150113
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205150113,
					"content": "他是經常在教堂附近…呃，逗留的，說不定注意到了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205150107,
					"content": "說不定已經成了冒險家了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150108
					]
				},
				{
					"id": 205150108,
					"content": "不可能啦，不可能，怎麼可能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150109
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205150109,
					"content": "#{F#妳}{M#你}，{F#妳}{M#你}怎麼突然不說話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150111
					],
					"speakerTitle": "安東尼"
				}
			]
		},
