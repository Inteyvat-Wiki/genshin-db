						205150403
					]
				},
				{
					"id": 205150403,
					"content": "#{F#妳}{M#你}是說安娜吧，見過，她剛從我面前跑過，轉了個彎就不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150404
					],
					"speakerTitle": "艾伯特"
				},
				{
					"id": 205150404,
					"content": "不過，我記得安娜不是一直在生病嗎，偶爾還會到教堂來接受治療。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150405
					],
					"speakerTitle": "艾伯特"
				},
				{
					"id": 205150405,
					"content": "但是她這幅樣子，哪裡像是生病的，簡直比我還有活力。到底發生了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾伯特"
