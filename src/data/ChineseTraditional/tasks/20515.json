			"dialogs": [
				{
					"id": 205150201,
					"content": "哎呀，修女們可真警覺，差點就被發現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150202
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205150202,
					"content": "妳的身手還真好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205150203
					]
				},
				{
					"id": 205150203,
					"content": "#哇！{F#妳}{M#你}怎麼知道我在這的，連修女們都沒發現我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150204
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205150204,
					"content": "#好啦，既然被{F#妳}{M#你}找到了，我馬上就回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205150205
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205150205,
					"content": "我就是來這裡看看風景而已啦，別擔心我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				}
			]
		},
