				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010201,
					"content": "您回來了啊，您受累，您辛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010202
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010202,
					"content": "我這書越說越多，也越忘越多，也是沒辦法的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010203
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010203,
					"content": "那，您問到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茶博士劉蘇"
				}
			]
		},
		{
			"id": 2230104,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2230108",
							"2"
						],
						"stepId": 2230108,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茶博士劉蘇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223010401,
					"content": "您還在這呢，哈哈哈，我這書…您覺著怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010402,
						223010405
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010402,
					"content": "還有呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010403
					]
				},
				{
					"id": 223010403,
					"content": "您看您，《裁雨聲》和《海山履雲記》，那可都是大部頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010404
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010404,
					"content": "簡簡單單三言兩語可講不完，您想聽，之後您掐著時間來就成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010407,
					"content": "這書還是多謝您幫忙，這些您拿好了，以後還請您來多多捧場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 223010405,
					"content": "只記得且聽下回分解了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223010406
					]
				},
				{
					"id": 223010406,
					"content": "哈哈，您想聽下回分解，那您得常來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223010407
					],
					"speakerTitle": "茶博士劉蘇"
				}
			]
		},
