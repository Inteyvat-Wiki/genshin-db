						223011102
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 223011102,
					"content": "請問，您聽過劉蘇說書嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223011103
					]
				},
				{
					"id": 223011103,
					"content": "#{F#妳}{M#你}說老劉頭？他這個書說的可真有意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011104
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 223011104,
					"content": "我上次得了空去聽他說了一次<color=#00E1FFFF>《海山履雲記》</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011105
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 223011105,
					"content": "剛開了頭，說海上風波狂湧，天上驚雷劈落，南十字船隊依然是一路往前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011106
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 223011106,
					"content": "打頭的旗艦上，船頭有一位拄劍挺立，正是南十字船隊船長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011107
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 223011107,
					"content": "只看前方惡浪滔天，龐龐然如山黑影從海底長嘯而出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223011108
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 223011108,
					"content": "然後，老劉頭就不講了，且聽下回分解，哈哈哈，這分解了多少天了，什麼也沒分解出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "范二爺"
				}
			]
