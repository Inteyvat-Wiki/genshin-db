			"trigger": {
				"objectNames": [
					"焦躁的市民"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010401,
					"content": "嗯？怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010402
					],
					"speakerTitle": "焦躁的市民"
				},
				{
					"id": 700010402,
					"content": "風花天上飄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010403
					]
				},
				{
					"id": 700010403,
					"content": "#風花？什麼風花，{F#妳}{M#你}是說蒲公英嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010404
					],
					"speakerTitle": "焦躁的市民"
				},
				{
					"id": 700010404,
					"content": "那怎麼了嗎？很正常吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010405
					],
					"speakerTitle": "焦躁的市民"
				},
				{
					"id": 700010405,
					"content": "不好意思，打擾了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700010406,
					"content": "看起來好像是普通的市民，我們問問其他人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7000105,
			"completionStepIds": [
				7000107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000107",
							"2"
						],
						"stepId": 7000107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"失落的市民"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010501,
					"content": "到底還有沒有機會呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010502
					],
					"speakerTitle": "失落的市民"
				},
				{
					"id": 700010502,
					"content": "怎麼了？有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010503
					],
					"speakerTitle": "失落的市民"
				},
				{
					"id": 700010503,
					"content": "風花天上飄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010504
					]
				},
				{
					"id": 700010504,
					"content": "#嗯，是啊，{F#妳}{M#你}是想說，「不管發生了什麼，還是要好好享受風花節」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010505
					],
					"speakerTitle": "失落的市民"
				},
				{
					"id": 700010505,
					"content": "也對，不能因為被拒絕了就灰心喪志啊，節日還沒有結束呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010506
					],
					"speakerTitle": "失落的市民"
				},
				{
					"id": 700010506,
					"content": "#謝謝{F#妳}{M#你}的鼓勵，我會振作起來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010507
					],
					"speakerTitle": "失落的市民"
				},
				{
					"id": 700010507,
					"content": "好像被誤解了，不過這樣的人，應該不會有嫌疑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7000106,
			"completionStepIds": [
				7000111
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
