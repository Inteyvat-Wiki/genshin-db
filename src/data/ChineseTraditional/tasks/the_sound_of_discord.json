			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"可疑的市民"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010301,
					"content": "到處都這麼熱鬧，真好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010302
					],
					"speakerTitle": "可疑的市民"
				},
				{
					"id": 700010302,
					"content": "風花天上飄…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010303
					]
				},
				{
					"id": 700010303,
					"content": "哦？嗯嗯…行人細細瞧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010304
					],
					"speakerTitle": "可疑的市民"
				},
				{
					"id": 700010304,
					"content": "#原來是夥伴，{F#妳}{M#你}來得正好，我盯上了一堆粗心大意的情侶，我們去搞點摩拉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010305
					],
					"speakerTitle": "可疑的市民"
				},
				{
					"id": 700010305,
					"content": "#{F#妳}{M#你}吸引他們的注意，我趁機下手。等得手了之後，我們就去風起地找其他的兄弟，不知道他們的收穫如何…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010306
					],
					"speakerTitle": "可疑的市民"
				},
				{
					"id": 700010306,
					"content": "在那之前，你得先和我走一趟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010307
					]
				},
				{
					"id": 700010307,
					"content": "#欸？！等、等一下，{F#妳}{M#你}不是盜寶團的人，{F#妳}{M#你}是什麼人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010308
					],
					"speakerTitle": "可疑的市民"
				},
				{
					"id": 700010308,
					"content": "騎士團的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010309
					]
				},
				{
					"id": 700010309,
					"content": "他已經被騎士團帶走了。但西風騎士怎麼來得這麼快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700010310,
					"content": "唔，先不管這些了，剛才他好像說了要去風起地找同夥，我們去風起地那邊看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
