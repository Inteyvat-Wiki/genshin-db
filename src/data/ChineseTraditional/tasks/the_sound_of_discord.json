			"dialogs": [
				{
					"id": 700010601,
					"content": "盜寶團的事怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010602
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010602,
					"content": "已經全部解決了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010603
					]
				},
				{
					"id": 700010603,
					"content": "#嗯，不愧是西風的榮譽騎士，做得很好。{F#妳}{M#你}之前和那位盜寶團搭話的方式也很巧妙，果然是「那位先生」看中的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010604
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010604,
					"content": "妳…妳一直在看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010605
					]
				},
				{
					"id": 700010605,
					"content": "當然啦，不然我怎麼能及時把西風騎士叫過去呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010606
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010606,
					"content": "#總之，謝謝{F#妳}{M#你}幫忙，這些東西請{F#妳}{M#你}收下吧，不用客氣，這些也都是「那位先生」專門給我撥的款。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010607
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010607,
					"content": "那麼再見了，祝你們有愉快的一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇爾"
				}
			]
