				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700010201,
					"content": "啊呀，旅行者，又見面了，怎麼樣，還喜歡城裡的氣氛嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010202
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010202,
					"content": "滿喜歡的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010203
					]
				},
				{
					"id": 700010203,
					"content": "#{F#妳}{M#你}喜歡就好。不過…雖然很不符合現在的氛圍，但我還是有件和風花節有關的事要拜託{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010204
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010204,
					"content": "#不對，準確地說，是「那位先生」又有事拜託{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010205
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010205,
					"content": "風花節期間不是不能隨便拜託人做事嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010206
					]
				},
				{
					"id": 700010206,
					"content": "#這個啊，這不用擔心。因為我要拜託{F#妳}{M#你}的這件事，並不在風花節的這條規則內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010207
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010207,
					"content": "#{F#妳}{M#你}也注意到了吧，每年的風花節都非常熱鬧，市民來來往往，熙熙攘攘，大家都沉醉在節日的氣氛中，西風騎士因為要維持秩序，也忙得不可開交…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010208
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010208,
					"content": "毫無防備的擁擠人群、忙得不可開交的西風騎士，對於那群盜寶團來說，這當然是適合犯案的好機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010209
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010209,
					"content": "根據「那位先生」的情報，有些盜寶團成員已經趁亂混進了城，正在城門口的各家店鋪附近假裝慶祝節日，實際上是為後續的行動勘查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010210
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010210,
					"content": "如果騎士團大張旗鼓地搜尋，一方面會打草驚蛇，一方面也一定會壞了節日的氣氛。但又不能放著他們不管…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010211
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010211,
					"content": "所以，你就又來找我了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010212
					]
				},
				{
					"id": 700010212,
					"content": "#那是當然，這次也是「那位先生」特別指名{F#妳}{M#你}，根據他的說法，{F#妳}{M#你}是解決這件事的不二人選。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010213
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010213,
					"content": "好了，我們說正事。根據我打聽到的情報，混進來的那群盜寶團為了彼此標記身分，都帶著一個<color=#00E1FFFF>小包</color>，而且在確認同伴身分的時候，還會用到一組<color=#00E1FFFF>暗號</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010214
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010214,
					"content": "<color=#00E1FFFF>「風花天上飄，行人細細瞧。」</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010215,
						700010216
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010215,
					"content": "太好記了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				},
				{
					"id": 700010217,
					"content": "能對上暗號的就是混進城裡的盜寶團，而且從他們的口中，應該能套出野外營地的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010218
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010218,
					"content": "#套出情報後，就拜託{F#妳}{M#你}也將他們全部擊退吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010219
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010219,
					"content": "為什麼不直接交給騎士團？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010220
					]
				},
				{
					"id": 700010220,
					"content": "為了維持節日期間城內的秩序，騎士團一定已經忙得焦頭爛額了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010221
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010221,
					"content": "在這個時候，能夠為他們分擔一點，就分擔一點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700010222
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010222,
					"content": "#那就拜託{F#妳}{M#你}了，「榮譽騎士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇爾"
				},
				{
					"id": 700010216,
					"content": "是他們的風格。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700010217
					]
				}
			]
		},
		{
			"id": 7000103,
			"completionStepIds": [
				7000103
			],
