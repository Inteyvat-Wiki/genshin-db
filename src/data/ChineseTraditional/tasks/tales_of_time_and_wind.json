				]
			},
			"dialogs": [
				{
					"id": 100070101,
					"content": "…那麼我就當作您默認了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070102
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070102,
					"content": "溫迪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070103
					]
				},
				{
					"id": 100070103,
					"content": "#哎呀，{NICKNAME}，{F#妳}{M#你}終於來了，是有人捎給我口信嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070104,
						100070105
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070104,
					"content": "口信？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				},
				{
					"id": 100070106,
					"content": "「並沒有從那本辭典裡看見任何有關於你的預言。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070107
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070107,
					"content": "對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070108,
						100070109
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070108,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070110,
					"content": "#哎呀？{NICKNAME}，稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070111
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070111,
					"content": "嗯…看來芭比洛斯女士的求知慾還是這麼強。可惜，我的「未來」恐怕無法記載進她的辭典裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070112
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070112,
					"content": "畢竟，風雖然樂意被蒲公英描出形狀，再任由詩人頌唱，但卻並不願真正地居留於某人之手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070113
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070113,
					"content": "所以，尊敬的芭比洛斯女士，請妳放下手中的筆吧。風中所傳誦的那些辭藻，並不適合直接落筆成文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070114
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070114,
					"content": "如果您真的對這一則神話感興趣，那容我對這篇詩文做些潤色，待到下次茶會時，再為各位女士吟誦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070115
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070115,
					"content": "芭比洛斯？她…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070116
					]
				},
				{
					"id": 100070116,
					"content": "哈哈哈，芭比洛斯女士向來通情達理，看來她已經聽到了我的請求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070117
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070117,
					"content": "現在，不會有人打擾我們的談話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070118
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070118,
					"content": "剛才芭比洛斯小姐在偷聽？可、可是我們什麼也沒發現啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100070119,
					"content": "畢竟是魔女會的一員嘛，芭比洛斯小姐可是很厲害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070120
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070120,
					"content": "可是你一下子就發現了，還把她請走了。賣唱的，那你不是比芭比洛斯小姐還厲害？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100070121,
					"content": "嗯…考慮到各種現實因素，我應該也只能算是厲害得有限吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070122
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070122,
					"content": "又是這副神神秘秘的樣子。先說好喔，我們在魔女的那本辭典裡，根本沒發現和你有關的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070123,
						100070124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100070123,
					"content": "她只是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070125,
					"content": "這就足夠了。不得不說，芭比洛斯女士對我的「預言」雖然並不完整，但也談不上「錯誤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070126
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070126,
					"content": "#我所要做的那件事，的確需要{NICKNAME}的協助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070127,
						100070128
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070127,
					"content": "有什麼事儘管說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070129,
					"content": "喔，真是可靠，那麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070130
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070130,
					"content": "#{NICKNAME}，稍後可以和我一起彈奏一首曲子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070131,
						100070132
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070131,
					"content": "欸？可以是可以…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070133,
					"content": "是的，僅此而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070134
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070134,
					"content": "放心，這次的共奏邀請並不是出於命運的重壓，或者是什麼遙遠的因果…而純粹是出於我們之間的友誼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070135
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070135,
					"content": "上次我親手彈這首曲子時，唯一的聽眾是呼嘯的狂風，它們把曲聲席捲而去，只留下了零星的尾聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070136
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070136,
					"content": "#如今，既然我已經有了{F#妳}{M#你}這位友人，那又何必只讓風獨坐觀眾席呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070137
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070137,
					"content": "#再說了，有{F#妳}{M#你}這位朋友在身邊，我彈奏樂器的手，或許會更平穩一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070138
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070138,
					"content": "我會認真彈的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070139
					]
				},
				{
					"id": 100070139,
					"content": "好，那麼我們先去演奏場吧。我們跟著風走，馬上就能到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070132,
					"content": "但你只需要我做這件事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070133
					]
				},
				{
					"id": 100070128,
					"content": "包在我身上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070129
					]
				},
				{
					"id": 100070124,
					"content": "要我來這裡等待。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070125
					]
				},
				{
					"id": 100070109,
					"content": "但魔女依然要我來找你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070110
					]
				},
				{
					"id": 100070105,
					"content": "但我其實…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070106
					]
				}
			]
		},
