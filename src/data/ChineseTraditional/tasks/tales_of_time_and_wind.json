			"dialogs": [
				{
					"id": 100070701,
					"content": "#好了，到此為止。真是一場優美的合奏，多謝啦，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070702
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070702,
					"content": "你剛才使出的力量…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070703
					]
				},
				{
					"id": 100070703,
					"content": "#不用擔心，剛才{F#妳}{M#你}所看見的力量，純粹出自我自身，並非來自外人，也沒有藉助任何外物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070704
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070704,
					"content": "要打個比方的話，就像是…替一架樂器調了調音，讓它能夠演奏出更動聽的樂曲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070705
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070705,
					"content": "哇，你果然藏著一手！等一下，你不會還藏著更多手吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100070706,
					"content": "欸，小派蒙，我真的只有兩隻手，不信妳看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070707
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070707,
					"content": "賣！唱！的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100070708,
					"content": "哈哈哈哈哈，今天的風也許會很大，我們還是趕緊回蒙德城，提醒大家收收衣服吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		},
