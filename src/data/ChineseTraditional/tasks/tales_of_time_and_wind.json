					"nextDialogs": [
						100070402
					]
				},
				{
					"id": 100070402,
					"content": "有什麼特別的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100070403
					]
				},
				{
					"id": 100070403,
					"content": "這座島嶼本身並無特殊之處，它和大部分島嶼一樣，都只是普通砂石的聚合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070404
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070404,
					"content": "直到，風帶來了故事的種子，時間使它在這座島上生根發芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070405
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070405,
					"content": "爾後，風帶來了新的故事，時間使它在這座島外成為神話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070406
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070406,
					"content": "#{NICKNAME}，歡迎{F#妳}{M#你}「真正」登上這座被「時間」所青睞的小島。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070407
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070407,
					"content": "在久遠的過去，時與風曾在此交會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070408
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 100070408,
					"content": "等一下等一下，賣唱的…你突然好嚴肅，說的話也好難懂喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100070409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100070409,
					"content": "哎呀，別急嘛小派蒙，一篇好故事的開頭總是要起點高調，留點懸念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
