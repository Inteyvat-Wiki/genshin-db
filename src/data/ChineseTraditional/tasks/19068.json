					"nextDialogs": [
						190680202
					],
					"speakerTitle": "貝雅特麗奇"
				},
				{
					"id": 190680202,
					"content": "聞起來也有點奇怪…你們該不會，是想把這個送去給昆恩吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190680203
					],
					"speakerTitle": "貝雅特麗奇"
				},
				{
					"id": 190680203,
					"content": "當、當然不會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190680204
					]
				},
				{
					"id": 190680204,
					"content": "就是說嘛，那我繼續等你們囉。",
					"roleType": "TALK_ROLE_NPC",
