			"trigger": {
				"objectNames": [
					"娜扎法琳",
					"莎拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705270101,
					"content": "妳們好呀！是在聊什麼好吃的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270102,
						705270103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705270102,
					"content": "妳們好，莎拉、娜扎法琳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705270107
					]
				},
				{
					"id": 705270107,
					"content": "又見面了，兩位。確實我們聊的也算是跟吃的有關係吧，不過…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270108
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 705270108,
					"content": "發生什麼事情了呀，快說吧，說不定我們能幫上忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705270109,
					"content": "#既然事關好吃的，那我們一定不會袖手旁觀的！嘿嘿，對吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270110,
						705270111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705270110,
					"content": "沒錯，為了好吃的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705270112
					]
				},
				{
					"id": 705270112,
					"content": "噢，草王在上。兩位大人還是一如既往，非常熱心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270113
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270113,
					"content": "是這樣子的，上次兩位大人救我於水火之中後，我回到須彌，整理出了一份璃月調味料市場調查報告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270114
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270114,
					"content": "沒想到被鼎鼎有名的桑歌瑪哈巴依老爺給看上了，她表示希望買斷我研究出來的調味料配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270115
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270115,
					"content": "這位善良好心的大商人甚至願意出資支持我後續的調查與研究！噢，多麼幸運！我毫不猶豫地答應了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270116
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270116,
					"content": "我向好朋友芭爾瓦涅寫了信，告訴了她這件事情，她也非常支持我的決定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270117
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270117,
					"content": "所以妳現在是在蒙德展開妳的調味料調查嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705270118,
					"content": "噢，派蒙閣下真是說到重點了。我本來應該已經展開了我的蒙德調味料調查，只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270119
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270119,
					"content": "只是，娜扎法琳想要和獵鹿人合作，在獵鹿人的菜餚裡加入她所謂的秘製調味料，再讓我們的客人食用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270120
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 705270120,
					"content": "但獵鹿人身為餐廳，出餐是有標準的，沒辦法加入新的調味料，要不然恐怕會有很多老客人投訴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270121
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 705270121,
					"content": "#唉，說實話，其實在{F#妳}{M#你}們來之前，我們聊了很久，都沒有想到什麼比較好的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270122
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 705270122,
					"content": "甚至還在想，要不要找琴團長幫忙解決，她一定能完美解決這種棘手的問題吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270123
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 705270123,
					"content": "嗚哇！琴團長那麼忙，這種小事情就不用打擾她啦！都交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705270124,
					"content": "噢，看吧，我早就說過了，兩位大人果然是拯救娜扎法琳的大英雄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270125
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270125,
					"content": "太好了，那麼事不宜遲，這口鍋請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270126
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270126,
					"content": "就按我們之前那樣吧，製作調味料，加入料理中，再邀請您的朋友們試吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270127
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270127,
					"content": "嘿嘿，就照我們之前那樣吧，最好的夥伴派蒙來當您的第一位試吃員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705270111,
					"content": "好吧，就當是為了派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705270112
					]
				},
				{
					"id": 705270103,
					"content": "妳們好，請問這位是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705270104
					]
				},
				{
					"id": 705270104,
					"content": "噢，您好，我的小吉祥草王啊。大人您不記得我了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270105
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270105,
					"content": "可能我的存在感，就像是一粒沙塵，風一吹就消散了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270106
					],
					"speakerTitle": "娜扎法琳"
				},
				{
					"id": 705270106,
					"content": "不過兩位大人之前在璃月，幫忙製作調味料，又邀請大家試吃，大恩大德，我一直銘記於心呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705270107
					],
					"speakerTitle": "娜扎法琳"
				}
			]
		}
	]
}