			},
			"dialogs": [
				{
					"id": 200110201,
					"content": "#謝謝{F#妳}{M#你}，旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110202
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200110202,
					"content": "可是還有個路障在這，我還是過不去，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110203
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200110203,
					"content": "哈哈哈，本來我可以自己搞定…可是我吃了丘丘人好幾下，全身都在痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110204
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200110204,
					"content": "不過還好，我替安娜摘的這些草藥都沒壞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110205
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200110205,
					"content": "#抱歉，雖然已經很麻煩{F#妳}{M#你}了，但是{F#妳}{M#你}能再幫我把這路障給解決掉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110206,
						200110207
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200110206,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110208
					]
				},
				{
					"id": 200110208,
					"content": "謝謝，我要休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200110207,
					"content": "我還有急事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200110209
					]
				},
				{
					"id": 200110209,
					"content": "#可是安娜還在家等著我…請{F#妳}{M#你}再幫幫我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				}
			]
		},
