			"dialogs": [
				{
					"id": 200110301,
					"content": "這樣子可以走過去了…謝謝，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110302
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200110302,
					"content": "因為沒多少錢，安娜的病又始終不見好，所以我經常來這採藥草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110303
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200110303,
					"content": "#雖然草藥採到了，但沒想到今天會被這群傢伙襲擊，還好{F#妳}{M#你}趕過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110304
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200110304,
					"content": "#這個給{F#妳}{M#你}，我經常用這個泡茶給安娜喝，這樣她的咳嗽才會好些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200110305
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200110305,
					"content": "#{F#妳}{M#你}也經常在野外跑吧，自己要照顧好自己啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				}
			]
		}
