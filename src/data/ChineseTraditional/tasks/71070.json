			},
			"dialogs": [
				{
					"id": 710702801,
					"content": "#哈哈，{F#妳}{M#你}回來了。請隨便休息一下吧，把這裡當自己家就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702802,
						710702803
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710702802,
					"content": "這裡可不像能住人的樣子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				},
				{
					"id": 710702804,
					"content": "#哈哈哈哈哈！{F#妳}{M#你}這孩子，說話怎麼這麼尖銳呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702805
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710702805,
					"content": "#唉，多虧了{F#妳}{M#你}的幫助，營地的氛圍也輕鬆了許多。如果之前我讓{F#妳}{M#你}感覺太嚴肅緊張的話，實在是對不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702806
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710702806,
					"content": "要緊事務已經完成了，現在留給我們的是長期工作。也就是…常駐地下，監督異變情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702807
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710702807,
					"content": "過一段時間或許礦坑就可以部分開放了，但這麼深的地下還不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702808
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710702808,
					"content": "我們要負責封鎖這片區域，不能讓礦工…不，不能讓任何人下到這裡來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710702803,
					"content": "我要把自己當做穴居人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702804
					]
				}
