				"objectNames": [
					"志瓊",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710702701,
					"content": "#實在抱歉…之前因為我的任性，給{F#妳}{M#你}添麻煩了，前輩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702702
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710702702,
					"content": "我之後還會繼續細化已有的地圖，以及幫瑾武姐佈置信標，監測那些汙黑物質的活動情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702703
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710702703,
					"content": "那些東西…聽他們說很可能和五百年前的漆黑災禍有關。只不過不清楚是過去的餘震，還是捲土重來的徵兆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702704
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710702704,
					"content": "無論如何，感謝前輩，讓我知道了普通人的極限所在，以及…在限度之內怎樣尋求自身的意義…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702705
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710702705,
					"content": "哇…志瓊怎麼突然說話像個哲學家一樣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710702706,
					"content": "我從沒想過那麼多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702707
					]
				},
				{
					"id": 710702707,
					"content": "只是前輩真的幫了我很多，相比起來…我就連繪製地圖，也總是要麻煩前輩的幫助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702708
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710702708,
					"content": "#更何況面對險境時，總是會拖累前輩{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702709,
						710702710
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710702709,
					"content": "我只是在意妳的安全而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				},
				{
					"id": 710702711,
					"content": "嗯…我也不會放棄的，等整備好了，我會再度出發的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710702710,
					"content": "沒關係，希望妳能完成地圖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702711
					]
				}
			]
		},
