					"nextDialogs": [
						710701903
					]
				},
				{
					"id": 710701903,
					"content": "我是老派吟遊詩人嘛，當然是來這裡尋找靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701904
					],
					"speakerTitle": "塔列辛"
				},
				{
					"id": 710701904,
					"content": "哇…明明之前還很有精神的，怎麼現在一副要死的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710701905,
					"content": "我又沒下過礦…再加上…就是之前來的時候急匆匆的，有點…抽筋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701906
					],
