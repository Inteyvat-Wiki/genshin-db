			"dialogs": [
				{
					"id": 710702901,
					"content": "#啊，{F#妳}{M#你}來了！歡迎來到層岩巨淵勘探隊的爆破組與飲料供應處！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702902
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710702902,
					"content": "#全體成員——也就是我，克里托夫，向{F#妳}{M#你}致敬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702903
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710702903,
					"content": "#哈哈，這杯算請{F#妳}{M#你}了！多謝{F#妳}{M#你}為我們做的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702904,
						710702905
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710702904,
					"content": "接下來有什麼打算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
					]
				},
				{
					"id": 710702906,
					"content": "既然我已經正式成為勘探隊的一員了，當然要跟隨隊伍留在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702907
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710702907,
					"content": "哼…不過如果海迪夫和瑾武姐能幫我申請到更多幫手就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702908
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710702908,
					"content": "雖說到那時候呀，恐怕我就當不成爆破組長兼唯一隊員了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710702905,
					"content": "你要留在這裡嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710702906
