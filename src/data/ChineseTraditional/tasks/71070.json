	"talks": [
		{
			"id": 7107001,
			"completionStepIds": [
				7107001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107001",
							"2"
						],
						"stepId": 7107001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑾武",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710700101,
					"content": "#啊，{F#妳}{M#你}來了。多謝{F#妳}{M#你}幫我們打通了道路，志瓊為了給我們開路，也幫了很多忙。我們都很感謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700102,
						710700113,
						710700122
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700102,
					"content": "關於營地…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700103
					]
				},
				{
					"id": 710700103,
					"content": "怎麼樣，還不錯吧？老本行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700104
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700104,
					"content": "我從十幾歲開始，就跟著老爹學習這些了…如何搭建營地，如何製作晶石燈，如何維護礦具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700105
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700105,
					"content": "學著學著，他就老了…後來老爹眼睛不行了，礦上的安全設備就都由我來維護了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700106
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700106,
					"content": "#再然後，{F#妳}{M#你}看…我歲數也不小了。剩下的日子沒什麼好說啦…有了男人，男人沒了，生了閨女，閨女去須彌上學了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700107
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700107,
					"content": "有時候，礦上的男人去得早，留下的小孩子們也都由我攬下來照顧…身上就總是帶著些小甜食什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700108
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700108,
					"content": "所以呀…在我的印象裡，小孩子總是帶著甜甜的氣味，眼巴巴地等在地面上，等著我們的糖瓜，或者好看的小石頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700109
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700109,
					"content": "哇…所以瑾武姐現在也帶著糖果嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710700110,
					"content": "#糖果呀？嗯…城裡那種花俏的糖果沒有囉。不過{F#妳}{M#你}也不要嫌棄砂糖塊呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700111
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700111,
					"content": "原來是這種糖呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710700112,
					"content": "#身邊的人來來去去，留下的只有掛念，在這裡陪著我。哈哈，還有{F#妳}{M#你}們這些下礦的冒險家們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700113,
					"content": "關於志瓊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700114
					]
				},
				{
					"id": 710700114,
					"content": "志瓊是礦上的新生代，明蘊鎮出生的。其實層岩巨淵裡有經驗的礦工都是明蘊鎮來的…志瓊沒趕上好時候吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700115
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700115,
					"content": "啊…不要誤會，我不是說現在日子過得不好。我的意思是，明蘊鎮好些年前因為礦產枯竭，已經停產了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700116
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700116,
					"content": "志瓊後來來了層岩巨淵，層岩巨淵也出事停產了…這孩子可能天生不適合做礦工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700117
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700117,
					"content": "這…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700118
					]
				},
				{
					"id": 710700118,
					"content": "後來嘛，大家各尋生路，我繼續留在礦坑——撤離後留下的設備還要維護嘛。她就去做了冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700119
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700119,
					"content": "這孩子總是長不大，一點也不愛惜自己。還是在礦下做工的日子太少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700120
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700120,
					"content": "如果她能夠習慣礦工的生活，如果她也以自己的雙手拯救過那些身陷危險的人…恐怕會對生命有更深的認識吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710700121
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700121,
					"content": "#雖然不是什麼像樣的請求…我希望{F#妳}{M#你}能多盯著她一點，可別讓她把自己害死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710700122,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710700123
					]
				},
				{
					"id": 710700123,
					"content": "嗯，保重安全！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑾武"
				}
			]
		},
		{
			"id": 7107017,
			"completionStepIds": [
				7107002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107002",
							"2"
						],
						"stepId": 7107002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克里托夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701701,
					"content": "#{F#妳}{M#你}好！旅途如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701702
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710701702,
					"content": "還好，你過得如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701703
					]
				},
				{
					"id": 710701703,
					"content": "#感謝{F#妳}{M#你}給的機會，自從調配炮彈引信成功以後，大家都願意接受我留在這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701704
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710701704,
					"content": "至於上到地面之後的打算嘛…哈哈，還沒想好！反正大概是不會做盜寶團啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701705,
						710701706
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710701705,
					"content": "大概…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				},
				{
					"id": 710701707,
					"content": "肯定不會，肯定不會啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701708
					],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710701708,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701709
					]
				},
				{
					"id": 710701709,
					"content": "保重！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克里托夫"
				},
				{
					"id": 710701706,
					"content": "真的…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701707
					]
				}
			]
		},
		{
			"id": 7107018,
			"completionStepIds": [
				7107003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107003",
							"2"
						],
						"stepId": 7107003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海迪夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710701801,
					"content": "#這傢伙…唉…啊？啊，{F#妳}{M#你}好。抱歉，{F#妳}{M#你}打擾到我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701802
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701802,
					"content": "那我們算是扯平了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701804
					]
				},
				{
					"id": 710701804,
					"content": "#好了，不要和我開玩笑了。現在我們的情況很不妙，{F#妳}{M#你}知道嗎？很不妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701805
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701805,
					"content": "#{F#妳}{M#你}也看到那塊發光的晶石碎片了，對吧？據我猜測，在更深處應該還有一塊更大的…我猜{F#妳}{M#你}也早就預料到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701806
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701806,
					"content": "理論上說，當上面那塊碎片「回歸」之後，能量讀數應該是趨於穩定的…嗯，事實也是這樣。但…波形完全不對…完全不對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701807,
						710701808
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701807,
					"content": "你在說什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				},
				{
					"id": 710701809,
					"content": "沒怎麼上過學，嗯？好吧…簡單來說。我們正在面臨著兩種強大力量的鬥爭，就像石磨上的豆子一樣，明白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701810
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701810,
					"content": "在更大的時間尺度上，我們正在被來自上面和下面的兩種力量，急速磨成豆漿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701811
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701811,
					"content": "不信的話就等著瞧吧，那個叫志瓊的冒險家…我見過近距離接觸過那種東西之後人的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701812
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701812,
					"content": "今天她咳血，明天她就有可能把自己的肺組織也一併咳出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701813
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701813,
					"content": "我有什麼能幫忙的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701814
					]
				},
				{
					"id": 710701814,
					"content": "#{F#妳}{M#你}？嗯…讓我想想，讓我想想…給我時間，一定有辦法的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701815
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701815,
					"content": "#不過現在，我們最要緊是需要{F#妳}{M#你}繼續探索，看看下面究竟發生了什麼事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701816
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701816,
					"content": "放心吧，我不會放著這麼嚴重的事情不管的…我可得對勘探隊員的安全負責，不能讓自己的錢白花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701817
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701817,
					"content": "你也會對我的安全負責嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701818
					]
				},
				{
					"id": 710701818,
					"content": "#唔…不得不承認，{F#妳}{M#你}的能力已經超出了我的預估，所以…既然{F#妳}{M#你}完全有能力為自己負責…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710701819
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701819,
					"content": "#唉，算了，不要提那些不知所謂的話了…一旦{F#妳}{M#你}出了意外，我也會付出補償的，好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710701808,
					"content": "請用我聽得懂的語言。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710701809
					]
				}
			]
		},
