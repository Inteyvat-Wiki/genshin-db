			"dialogs": [
				{
					"id": 710702001,
					"content": "#啊，{F#妳}{M#你}來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710702002
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710702002,
					"content": "志瓊她最近很不對勁，我懷疑是那些…汙黑的東西在影響她的心智和身體。",
					"roleType": "TALK_ROLE_NPC",
