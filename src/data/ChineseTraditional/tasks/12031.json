				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"派蒙",
					"岡崎陸斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310401,
					"content": "#小傢伙，{F#妳}{M#你}們來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310402
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310402,
					"content": "神子，我們都還沒到，妳竟然就已經開始吃了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310403,
					"content": "#嗯，對啊，因為{F#妳}{M#你}們請客嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310404
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310404,
					"content": "一想到能免費吃最貴的菜，喝最好的酒，我就趕快過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310405
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310405,
					"content": "#啊，老闆，看見這兩個人沒有？這桌等會是{F#她}{M#他}們買單哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310406
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310406,
					"content": "好嘞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310407
					],
					"speakerTitle": "岡崎陸斗"
				},
				{
					"id": 120310407,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310408,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310409
					]
				},
				{
					"id": 120310409,
					"content": "#怎麼啦{F#妳}{M#你}們兩個，快過來坐啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310410
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310410,
					"content": "來嚐嚐這個，這可是清籟島附近才有的魚，連夜運到稻妻城的，剛才還是活的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310411
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310411,
					"content": "或者來杯這個？像這樣名貴的酒，我平時也不捨得喝呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310412,
					"content": "不能喝酒也沒關係，果汁也很多的，各種價位都有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310413
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310413,
					"content": "嗚——神子，妳太過分了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310414,
					"content": "上次在這裡趕稿的時候，妳給我們吃的只是最大眾的炸串啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310415,
					"content": "咦，有這回事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310416,
						120310417
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310416,
					"content": "就是這麼回事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				},
				{
					"id": 120310418,
					"content": "#哦，那又怎樣呢？之前說要請客的，不是{F#妳}{M#你}們自己嗎？再說了，{F#妳}{M#你}們忍心虧待我這個貴客嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310419
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310419,
					"content": "神子，這頓飯要好多好多錢呀，妳就不怕我們付不起嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310420,
					"content": "#呵呵，不用怕，付得起。我們之前一起寫的那本小說，最近又再版了，{F#妳}{M#你}們的稿費還不少呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310421
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310421,
					"content": "妳、妳說什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310422,
					"content": "#啊啊啊啊，可惡！{NICKNAME}，我們被氣氛給騙了！神子打從一開始就在打我們稿費的主意哪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310423,
						120310424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310423,
					"content": "大意了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310425,
					"content": "#哈哈哈哈，{F#妳}{M#你}們現在這副樣子，真是太有趣了，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310426
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310426,
					"content": "哦對了，因為上次無月之夜許願後什麼都沒有發生，現在咒語之類的小說，已經完全不流行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310427
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310427,
					"content": "#所以《旅行者的奇妙冒險》的最新章，{F#妳}{M#你}們得想點新的套路才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310428
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310428,
					"content": "#截稿期馬上就到了，那就拜託{F#妳}{M#你}了哦，「老師」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310424,
					"content": "被算計了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310425
					]
				},
				{
					"id": 120310417,
					"content": "只有炸串，和油豆腐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310418
					]
				}
			]
		},
