			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麻紀",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310201,
					"content": "下山？這是宮司大人的命令嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310202
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 120310202,
					"content": "是的，神子說接下來要舉行的儀式，對妳們的身體可能會有影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310203,
					"content": "#原來如此…我會立刻安排。{F#妳}{M#你}們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310204
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 120310204,
					"content": "我們會幫她做些事情，然後回到這裡來，和她一起進行儀式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310205,
						120310206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310205,
					"content": "因為還是有點擔心她。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				},
				{
					"id": 120310207,
					"content": "#看來宮司大人對{F#妳}{M#你}們很信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310208
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 120310208,
					"content": "之前遇到這種重要的儀式，宮司大人身邊是一個人都不會留的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310209
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 120310209,
					"content": "#那儀式就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310210
					],
					"speakerTitle": "麻紀"
				},
				{
					"id": 120310210,
					"content": "放心吧，我們可是很強的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310206,
					"content": "因為有點想看看妖怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310207
					]
				}
			]
		},
		{
			"id": 1203104,
			"completionStepIds": [
				1203106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
