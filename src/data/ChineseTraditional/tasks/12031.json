	"talks": [
		{
			"id": 1203101,
			"completionStepIds": [
				1203101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203101",
							"2"
						],
						"stepId": 1203101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120310101,
					"content": "#嗨，小傢伙們，{F#妳}{M#你}們來了呀。不錯，很準時。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310102
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310102,
					"content": "哼，為了稿費，不來也不行嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310103,
					"content": "神子，要幫大家進行「百鬼夜行」，具體要怎麼做呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310104,
					"content": "其實我們連百鬼夜行是什麼都不清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310105,
					"content": "「百鬼夜行」聽起來挺嚇人的，但簡單來說，就是妖怪們的聚會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310106,
					"content": "當年妖怪們在一起聚會，酒酣之時，紛紛使出妖力騰空而起，翻飛的身影能把月亮都遮住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310107,
					"content": "不過現在，地脈中溢出的妖怪記憶，力量很微弱，他們已經做不到騰空而起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310108
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310108,
					"content": "所以，我會為他們進行一場聚靈儀式，讓逸散的記憶能夠匯聚在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310109,
					"content": "到時候，他們就會在這鳴神大社的上空相會。然後，力量耗盡的他們，就會心滿意足地重新回到屬於他們的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310110
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310110,
					"content": "原來如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310111
					]
				},
				{
					"id": 120310111,
					"content": "儀式的鋪墊其實早就已經做好了。還記得我在小說中加入的咒語和「無月之夜」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310112,
					"content": "好像是要在「無月之夜」念誦「狐狸小姐秘傳術法」來著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310113,
					"content": "對，那裡寫著的可不是什麼實現願望的咒語，而是能安撫地脈記憶的術式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310114
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310114,
					"content": "到時候，就讓大家一起幫忙送他們一程吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310115,
					"content": "那麼我該做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310116
					]
				},
				{
					"id": 120310116,
					"content": "#等下我會開始籌備儀式，希望{F#妳}{M#你}們幫我做兩件事：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310117
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310117,
					"content": "首先是通知神社巫女們下山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310118,
					"content": "百鬼夜行之時，大量妖怪的記憶盤踞在鳴神大社上空，萬一有誰不小心被附了身，還是會有點麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310119
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310119,
					"content": "#之後，我會啟動儀式讓記憶匯聚。這個過程會花一定時間，{F#妳}{M#你}們就去影向山下觀察附近魔物的動向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310120
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310120,
					"content": "雖說平常分散的記憶沒有什麼危險，可是把力量聚攏，魔物們還是難免會受到影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310121,
					"content": "#它們可能會憑藉本能想要上山，{F#妳}{M#你}們就負責把它們都打倒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310122
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310122,
					"content": "明白啦。那之後呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310123,
					"content": "#嗯，那之後啊…如果{F#妳}{M#你}們想到神社這裡幫忙，順便近距離看看那些妖怪，也不是不可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310124
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310124,
					"content": "#好，{NICKNAME}，我們出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
