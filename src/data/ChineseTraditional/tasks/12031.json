					"nextDialogs": [
						120310804
					]
				},
				{
					"id": 120310803,
					"content": "幫神子處理掉它們吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120310804
					]
				},
				{
					"id": 120310804,
					"content": "嗯沒錯！趕快清理掉它們，我還想上山去看看妖怪們呢，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310805,
					"content": "#{NICKNAME}，它們衝過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
