				{
					"id": 120310903,
					"content": "嗯？我很好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310904
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310904,
					"content": "可是，妳剛才的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310905,
					"content": "沒事啦，我很好的，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310906
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310906,
					"content": "呵…真是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310907
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310907,
					"content": "神子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120310908,
					"content": "#好啦，如果{F#妳}{M#你}們真的想為我做點什麼，不如就下次請我吃飯好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310909
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120310909,
					"content": "好，沒問題，我們請妳吃飯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120310910
					],
					"speakerTitle": "派蒙"
				},
				{
