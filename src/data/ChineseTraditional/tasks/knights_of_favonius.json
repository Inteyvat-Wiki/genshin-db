		},
		{
			"id": 35801,
			"completionStepIds": [
				35802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"35802",
							"2"
						],
						"stepId": 35802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3580101,
					"content": "…事情的經過，就是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580102
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3580102,
					"content": "#蒙德歡迎{F#妳}{M#你}們，隨風而來的旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580103
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580103,
					"content": "我是代理團長，琴。這位是麗莎，騎士團的圖書管理員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580104
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580104,
					"content": "呀，是因為人手不足，所以來幫忙的好心孩子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580105
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3580105,
					"content": "真可愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580106
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3580106,
					"content": "只是，時機不怎麼巧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580107
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3580107,
					"content": "風魔龍自從復甦以來，一直在城市周圍活動，製造混亂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580108
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3580108,
					"content": "現在蒙德的元素流動、地脈循環，都已經變得好像被貓咪抓過的線團一樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580109
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3580109,
					"content": "對魔法師來說這是最糟糕的情況喔…皮膚和心情都會變差…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580110
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3580110,
					"content": "#如果不受這些干擾，騎士團就有比尋人啟事更好的辦法來幫助{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580111
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580111,
					"content": "現在就請在蒙德暫住一下，由我們西風騎士團來努力解決問題吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580112,
						3580114
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580112,
					"content": "也不能只讓騎士團煩心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580113
					]
				},
				{
					"id": 3580113,
					"content": "派蒙也會幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3580116,
					"content": "那麼，就來決定一下作戰計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580117
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3580117,
					"content": "風魔龍進攻蒙德，反而讓我們見到了終結災難源頭的契機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580118
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580118,
					"content": "在麗莎的魔法偵測之下，籠罩蒙德的颶風已經暴露了源流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580119
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580119,
					"content": "哦？ 那麼答案是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580120
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3580120,
					"content": "被廢棄的<color=#00E1FFFF>「四風守護」廟宇</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580121
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3580121,
					"content": "風魔龍能夠掀起這種程度的暴風，就是借助了那些殘餘的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580122
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 3580122,
					"content": "而我們的目標，是這四座廢棄廟宇中的<color=#00E1FFFF>三座</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580123
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580123,
					"content": "只選三座的理由…大家應該都明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580124
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580124,
					"content": "我不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580125,
						3580126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3580125,
					"content": "這可能是本地人的默契…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580127,
					"content": "各位西風騎士，事不宜遲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580128
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580128,
					"content": "暴風正在肆虐，被動防守也沒有意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580129
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3580129,
					"content": "在龍災擴大之前，就由我們搶先一步，向<color=#00E1FFFF>廢棄廟宇</color>的<color=#00E1FFFF>遺蹟</color>前進吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 3580126,
					"content": "我們等一下再問…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580127
					]
				},
				{
					"id": 3580114,
					"content": "那就全靠騎士團了。旅館在哪裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3580115
					]
				},
				{
					"id": 3580115,
					"content": "喂！不要偷懶，我們也該參與進來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3580116
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}