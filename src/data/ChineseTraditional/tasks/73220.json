						732201402
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201402,
					"content": "這個地方…和母親日誌裡的古代草圖能夠對應上。應該就是這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201403
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201403,
					"content": "是個安眠的好地方，對吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201404
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201404,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201405
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201405,
					"content": "危機四伏的沙漠，背叛和陰謀…無法原諒的事情，無法釋懷的事情，明明剛發生了不久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201406
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201406,
					"content": "但在這裡，我卻很平靜…很開心。我不知道…為什麼會這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201407
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201407,
					"content": "因為這裡是花的女主人最後的領域…天空的饋贈在地下深處維持著它的靜止，這裡保存了她最後的精魄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201408
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201408,
					"content": "所以即使她已經死去，這裡依然平靜如初，就像從未有人來過。所以，進入這片領域的人…只會感受到平靜與快樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201409
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201409,
					"content": "因為女主人是瘋癲僧人與歧途旅客的保護者…這裡對於他們來說，曾是歸宿的樂園。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201410
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201410,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201411
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201411,
					"content": "婕德沒有說話，默默上前放下母親的筆記，又將哲伯萊勒的大斧斜倚在一旁…\\n就彷彿他們從未走遠一樣。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7322015,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
