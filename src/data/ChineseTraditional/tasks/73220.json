	"talks": [
		{
			"id": 7322006,
			"completionStepIds": [
				7322006
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322006",
							"2"
						],
						"stepId": 7322006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德",
					"利露帕爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732200601,
					"content": "抱歉…我一時有點不知道該說什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200602
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200602,
					"content": "時間就像忘記流動了一樣，一切都是靜止的。不知為什麼，我甚至忘記了驚嘆這裡的奇異景色…只感到了平靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200603
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200603,
					"content": "在這種地方，伴著已死的神長眠…唉，雖然我寧願他們從沒有離開過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200604
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200604,
					"content": "真希望他們能永遠留駐這裡，不再被時間遺忘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200605
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200605,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200606
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732200606,
					"content": "起初進來時，我們攪擾了碎片的力量，也破壞了維持穩定的機關…這裡早晚會崩毀，被黃沙吞沒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200607
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732200607,
					"content": "到那時候，女主人維持這片綠洲靜止的殘力也會回歸諸天…這是無可挽回的結局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200608
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732200608,
					"content": "嗯…我知道。但至少在那之前，至少在那之前…我的父母終於重聚了，就像他們從沒離開彼此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200609
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200609,
					"content": "或許終有一天，我也會回到這裡吧…等到我厭倦了所有冒險，離開了所有能稱之為「家」的地方之後。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200610
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200610,
					"content": "到那時候，再從容地說一句「我回來囉！」然後，躺在父母中間沉沉睡去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200611
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200611,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200612
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200612,
					"content": "婕德…那一天一定還很遠呢！現在…唔…現在哲伯萊勒肯定很高興，雖然板著臉，但是肯定很高興的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200613,
					"content": "謝謝妳，派蒙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200614
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200614,
					"content": "#還有{NICKNAME}，很感謝{F#妳}{M#你}願意一路陪我，完成這個小小的任性心願…但現在我一個人想多陪父母一會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200615,
						732200617
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200615,
					"content": "我理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200616
					]
				},
				{
					"id": 732200616,
					"content": "#嗯…謝謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200617,
					"content": "別忘了回去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200618
					]
				},
				{
					"id": 732200618,
					"content": "不用管我…我隨後會跟上來的。哈，現在還不是在這裡定居的好時候呢，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				}
			]
		},
		{
			"id": 7322008,
			"completionStepIds": [
				7322008
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322008",
							"2"
						],
						"stepId": 7322008,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德",
					"芭別爾",
					"利露帕爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732200801,
					"content": "我們安全回來了，芭別爾主母。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200802
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200802,
					"content": "我們探明了「永恆綠洲」的秘密，為部族打開了通道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200803
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200803,
					"content": "感謝您給我這次機會，讓我得以完成父母的夙願…即使他們並不受塔尼特的護佑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200804
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200804,
					"content": "請不要這麼說，孩子。妳的夙願，我一直記在心裡。滿足孩子們的願望，也是我作為主母的職責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200805
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200805,
					"content": "謝謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200806
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200806,
					"content": "很好，婕德。那麼，阿薩里格的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200807
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200807,
					"content": "您的判斷是正確的…他是叛徒無疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200808
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200808,
					"content": "#欸，所以{F#妳}{M#你}們早就知道阿薩里格會叛變了嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200809,
					"content": "不，之前還只是懷疑而已，一路上我都在監視著他…但我沒想到阿薩里格會這麼快攤牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200810
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200810,
					"content": "芭別爾主母警告過我，但我那時寧願選擇相信他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200811
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200811,
					"content": "請看，這裡是有關他與愚人眾勾結的證據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200812
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200812,
					"content": "婕德將阿德菲的信件交給了芭別爾主母。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732200813
					]
				},
				{
					"id": 732200813,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200814
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200814,
					"content": "請不要悲傷，芭別爾主母…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200815
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200815,
					"content": "嗯…我早就察覺到他懷有異心，只可惜沒能親手處決他…我曾經那麼看重他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200816
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200816,
					"content": "但現在，部族的環境愈加凶險…我失去了兩個曾精心培養的人物，以後部族的大事小情，就要多多要妳承擔了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200817
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200817,
					"content": "欸…所以說，婕德是晉升了呀？恭喜妳啦，婕德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200818,
					"content": "晉升？哈哈…這個詞在沙漠裡可不多見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200819
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200819,
					"content": "在我們沙漠人眼中可沒有什麼官僚層級。只是誰負責的事情更多了，誰就更有可能在未來掌握更多權力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200820
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200820,
					"content": "婕德…塔尼特的未來在妳身上，請不要辜負族人們的希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200821
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200821,
					"content": "族人…所以，您也承認我是塔尼特真正的族人了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200822
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200822,
					"content": "別傻了，我一直這樣認為。不論之前發生過什麼，妳是塔尼特的女兒，妳的身上永遠流著與我們相同的血。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200823
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200823,
					"content": "嗯…謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200824
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200824,
					"content": "唔，總覺得有什麼不太對勁的東西沒有提到呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200825,
					"content": "#{NICKNAME}，我們之前遇到過什麼可疑的東西來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200826,
						732200845
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200826,
					"content": "關於峽谷裡的那些廢棄營地…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200827
					]
				},
				{
					"id": 732200827,
					"content": "妳曾往綠洲派出過其他族人，並且任由他們死在了那裡，然後以「禁忌」的藉口禁止後來人進入，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200828
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732200828,
					"content": "但妳卻鼓勵我們深入險地，對這些東西隻字不提，這是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200829
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732200829,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200830
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200830,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200831
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200831,
					"content": "尊敬的利露帕爾，此前的種種不便與誤會，請容我向您致歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200832
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200832,
					"content": "但塔尼特部族的確並非最近才開始探索居爾城的遺蹟，以及「永恆綠洲」之所在…我此前已經派出過許多族人前往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200833
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200833,
					"content": "今人之所以能夠確定這幾處地點的位置與地形情況，也是多虧了他們的探險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200834
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200834,
					"content": "只是由於風險巨大，人員往往十不存一，而考察結果寥寥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200835
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200835,
					"content": "我才要求停止這種行動，將這些地方劃為部族的禁忌區域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200836
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200836,
					"content": "#阿薩里格那個叛徒…也曾經帶隊考察過那些峽谷與遺蹟，我以為我能信任他給{F#妳}{M#你}們開路…但卻沒想到他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200837
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200837,
					"content": "但妳沒跟我們說過這些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200838
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200838,
					"content": "#因為我從一開始就知道，{F#妳}{M#你}們會安然無恙地回來。妳是我所信任託付的後輩，婕德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200839
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200839,
					"content": "妳的勇敢無畏，妳的凶猛和機智，妳對待族人和朋友的真誠和溫柔，我都看在眼裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200840
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200840,
					"content": "如果我的女兒未曾被沙漠帶走，我想她一定也會長成妳的樣子。任何危險都打不倒她，任何沙暴都無法吞沒她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200841
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200841,
					"content": "所以，我也這樣相信著妳，一直在默默為妳祈禱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200842
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200842,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200843
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200843,
					"content": "…抱歉，芭別爾主母，是我頂撞您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200844
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200844,
					"content": "#不，引起了{F#妳}{M#你}們的誤解和疑慮，應該是我要請求{F#妳}{M#你}們的原諒才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200864
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200864,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200865
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732200865,
					"content": "抱歉，我的大人，是我多慮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200866
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732200866,
					"content": "#那麼，很高興大家都能解開誤會。{NICKNAME}，作為貴客，塔尼特部族永遠歡迎{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200867
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200867,
					"content": "尊貴的「鎮靈主人」，無論您提出什麼樣的要求，請儘管與我相談，我將盡全力滿足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200868
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200868,
					"content": "任何要求嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200869
					]
				},
				{
					"id": 732200869,
					"content": "任何要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200870,
						732200873,
						732200876
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200870,
					"content": "我想要摩拉做報酬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200871
					]
				},
				{
					"id": 732200871,
					"content": "這才對嘛！摩拉、摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200872
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200872,
					"content": "#很好，這是{F#妳}{M#你}應得的報酬。還有…感謝{F#妳}{M#你}為我照顧婕德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200881
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200881,
					"content": "#好了，不要讓我留{F#妳}{M#你}們太長時間了。再次感謝{F#妳}{M#你}們的幫助，「鎮靈主人」…還望您能夠多多光顧塔尼特部族…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200882
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200882,
					"content": "畢竟，我們仰仗著您與利露帕爾的引導。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200873,
					"content": "我想要一件紀念物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200874
					]
				},
				{
					"id": 732200874,
					"content": "欸，我們不要摩拉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200875
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200875,
					"content": "#{F#妳}{M#你}與塔尼特的友誼當然值得留下紀念，請收下我們的薄禮，希望{F#妳}{M#你}不要嫌棄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200881
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200876,
					"content": "在婕德生日的宴會上替我敬杯酒吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200877
					]
				},
				{
					"id": 732200877,
					"content": "嗯嗯，那也別忘了我的份！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200878
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732200878,
					"content": "欸…？謝謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200879
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200879,
					"content": "#噗…這是{F#妳}{M#你}們外人的傳統嗎？那好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200880
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200880,
					"content": "#我就為{F#妳}{M#你}們留著這個人情好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200881
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200845,
					"content": "關於叛徒的書信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732200846
					]
				},
				{
					"id": 732200846,
					"content": "阿薩里格和阿德菲的信裡提及，他們反叛的原因是你將婕德這個「叛徒的女兒」當做掌中寶和繼承人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200847
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732200847,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200848
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200848,
					"content": "另外，妳也在部族中刻意清理「外人」的黨羽，即使之前妳曾依賴他們和「北方人」交流？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200849
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732200849,
					"content": "#我聽不懂{F#妳}{M#你}們的話中話，但方才這些話是什麼意思…我很好奇呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200850
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732200850,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200851
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200851,
					"content": "尊敬的利露帕爾，此前的種種不便與誤會，請容我向您致歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200852
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200852,
					"content": "但塔尼特部族的經營與生存，必須依賴多方貿易才能維持。這之中就包括那些來自北方的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200853
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200853,
					"content": "縱我忙於處理部族事務的方方面面，也難以料定他們居心叵測…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200854
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200854,
					"content": "但後來，我逐漸發現他們帶來的風險多於益處…也就只能先從內部下手清理叛徒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200855
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200855,
					"content": "這也正是我需要婕德的原因，她總能夠堅定迅速地為部族排除叛徒，我欣賞她的忠誠和能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200856
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200856,
					"content": "但妳沒跟我們說過這些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200857
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200857,
					"content": "#因為我從一開始就知道，{F#妳}{M#你}們會安然無恙地回來。妳是我所信任託付的後輩，婕德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200858
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200858,
					"content": "妳的勇敢無畏，妳的凶猛和機智，妳對待族人和朋友的真誠和溫柔，我都看在眼裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200859
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200859,
					"content": "如果我的女兒未曾被沙漠帶走，我想她一定也會長成妳的樣子。任何危險都打不倒她，任何沙暴都無法吞沒她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200860
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200860,
					"content": "所以，我也這樣相信著妳，一直在默默為妳祈禱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200861
					],
					"speakerTitle": "芭別爾"
				},
				{
					"id": 732200861,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200862
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732200862,
					"content": "…抱歉，芭別爾主母，是我頂撞您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
