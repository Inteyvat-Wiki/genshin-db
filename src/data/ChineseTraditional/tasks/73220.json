				},
				{
					"id": 732200863,
					"content": "#不，引起了{F#妳}{M#你}們的誤解和疑慮，應該是我要請求{F#妳}{M#你}們的原諒才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732200864
					],
					"speakerTitle": "芭別爾"
				}
			]
		},
		{
