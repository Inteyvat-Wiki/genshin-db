					"nextDialogs": [
						732201502
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201502,
					"content": "（她只是靜靜地坐在這裡，享受著與父母獨處的時光。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201503,
						732201505
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201503,
					"content": "（還是先不打擾她了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201504
					]
				},
				{
					"id": 732201504,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201505,
					"content": "我們回去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201506
					]
				},
				{
					"id": 732201506,
					"content": "#如果{F#妳}{M#你}不介意的話，我還想多在這裡待一會…抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201507,
						732201509
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201507,
					"content": "（還是不打擾她了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201508
					]
				},
				{
					"id": 732201508,
					"content": "……",
