			},
			"dialogs": [
				{
					"id": 732201201,
					"content": "我的女主人…她不在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201202
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201202,
					"content": "但我卻在這裡尋到了自己的碎片…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201203
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201203,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利露帕爾"
				}
			]
		},
		{
			"id": 7322013,
			"completionStepIds": [
				7322013
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7322013",
							"2"
						],
						"stepId": 7322013,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"婕德",
					"利露帕爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732201301,
					"content": "#隨著閃光的碎片匯入利露帕爾的魔瓶，{F#妳}{M#你}感到自身的力量也被抽離了少許…但很快，一股溫暖的感覺充實了{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732201302
					]
				},
				{
					"id": 732201302,
					"content": "#從鎮靈恍惚的目光中，{F#妳}{M#你}看到了紅玉堆砌的宮闕與花園…千萬種花朵盛開，萬千鳥兒鳴囀。\\n鎮靈們是女主人富有靈性的僕從，是她的樂師與斟酒者。\\n她的花園中，發瘋的僧人與破落的旅人伴著薩吉的水仙旋舞，啜飲著葡萄藤女兒的鮮血…\\n這是世上無二的花園，曾是花之女主人的居所，如今是她長眠的陵墓…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201303
					]
				},
				{
					"id": 732201303,
					"content": "「玫瑰綻放如火，將夜鶯的生命點燃。蠟燭燦然微笑，卻給飛蛾帶來災難。」",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201304
					]
				},
				{
					"id": 732201304,
					"content": "#{F#妳}{M#你}看見她伸出手來，膚色如月光般透明。{F#妳}{M#你}望見她的臉龐，難以言喻的美麗。彷彿每一個美妙的鎮靈都是她的花瓣，每一縷馨香都來自她一般…\\n然後，{F#妳}{M#你}對上了她的目光——",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201305
					]
				},
				{
					"id": 732201305,
					"content": "#那裡什麼都沒有。\\n只有無垠的虛空，令{F#妳}{M#你}墜落其中，恐懼不已…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201306
					]
				},
				{
					"id": 732201306,
					"content": "#{F#妳}{M#你}的意識逐漸恢復，婕德正握著{F#妳}{M#你}的手，神情擔憂。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732201307
					]
				},
				{
					"id": 732201307,
					"content": "#{F#妳}{M#你}醒了…{F#妳}{M#你}還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201308
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201308,
					"content": "#{F#妳}{M#你}剛剛…唉，算了。{F#妳}{M#你}沒事就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201309
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201309,
					"content": "#{F#妳}{M#你}都看到了什麼呀…就像做了一個長夢一樣，看起來滿嚇人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201310,
						732201311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732201310,
					"content": "是「花的女主人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201312
					]
				},
				{
					"id": 732201312,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201313
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201313,
					"content": "她已經不在這裡了，他騙了我們，騙了我們所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201314
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201314,
					"content": "#{F#妳}{M#你}說什麼…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201315
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201315,
					"content": "沒什麼，一個很久以前的契約取消了。我想…我自由了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201316
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201316,
					"content": "沙海的王曾向我們承諾，花的女主人沉眠在此處，終有一日會從這裡醒來…但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201317
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201317,
					"content": "真是奇怪…女主人已經死去了，他騙了我…騙了我的族人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201318
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201318,
					"content": "我本應該發了瘋般地恨他，為了這片沙漠，為了女主人的死去…就像我曾愛他和仰視他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201319
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201319,
					"content": "但…我卻失去了憎恨的動力…為什麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201320,
						732201321
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201320,
					"content": "或許這就是「自由」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201322
					]
				},
				{
					"id": 732201322,
					"content": "這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201323
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201323,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201324
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201324,
					"content": "哼，少賣乖了…我的主人仍舊是您，我們的契約還沒有結束呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201325
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201325,
					"content": "#我們走吧，婕德還在這裡等著{F#妳}{M#你}呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201326
					],
					"speakerTitle": "利露帕爾"
				},
				{
					"id": 732201326,
					"content": "嗯…我看到有一片好地方，就在那邊。我先過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732201327
					],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201327,
					"content": "#{F#妳}{M#你}也別忘了過來呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "婕德"
				},
				{
					"id": 732201321,
					"content": "妳不用依賴「愛人」或「仇人」了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201322
					]
				},
				{
					"id": 732201311,
					"content": "是這裡很久以前的樣子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732201312
					]
				}
			]
		},
		{
