				"points": []
			},
			"dialogs": [
				{
					"id": 761060401,
					"content": "堂堂愚人眾就只有這種程度的本領？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060402
					]
				},
				{
					"id": 761060402,
					"content": "#現在的新人說話怎麼都這麼嗆…等一下，仔細看{F#妳}{M#你}好像不是這次招進來的新人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060403
					],
					"speakerTitle": "沃莉斯菈娃"
				},
				{
					"id": 761060403,
					"content": "還企圖撒謊混入我們的隊伍，被我看穿了吧？給我拿下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沃莉斯菈娃"
				}
			]
		},
