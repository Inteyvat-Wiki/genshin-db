			},
			"dialogs": [
				{
					"id": 761060101,
					"content": "#嗯？{F#妳}{M#你}看起來有點陌生，是新來的對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沃莉斯菈娃"
				}
			]
		},
		{
			"id": 7610602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沃莉斯菈娃"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060201,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060202
					]
				},
				{
					"id": 761060202,
					"content": "#我是為{F#妳}{M#你}好——沒事不要到設計局裡去，尤其是二層！要是吸收了太多月矩力…輕則頭痛重則嘔吐。別怪我沒提醒過{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沃莉斯菈娃"
				}
			]
		},
		{
			"id": 7610603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沃莉斯菈娃"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761060301,
					"content": "真的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060302
					]
				},
				{
					"id": 761060302,
					"content": "#那當然！只要是在裡面工作的傢伙都會多發一杯蘋果釀。{F#妳}{M#你}想想，要是對身體沒有傷害，怎麼會有這樣的好事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060303
					],
					"speakerTitle": "沃莉斯菈娃"
				},
				{
					"id": 761060303,
					"content": "#再說了，我之前在霜月之子那邊親眼見到！他們的那些執祭頭上都長出角來了，{F#妳}{M#你}覺得這難道是正常的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060304
					],
					"speakerTitle": "沃莉斯菈娃"
				},
				{
					"id": 761060304,
					"content": "原來是這樣…多謝提醒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761060305
					]
				},
				{
					"id": 761060305,
					"content": "聽起來好可怕哦！會、會變成怪物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761060306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761060306,
					"content": "#唉…淨派新來的做這些危險的事…{F#妳}{M#你}自己小心一點，不要在裡面待太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沃莉斯菈娃"
				}
			]
		},
		{
			"id": 7610604,
			"completionStepIds": [
				7610601
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
