						],
						"pointId": 6250
					}
				]
			},
			"dialogs": [
				{
					"id": 740640101,
					"content": "我說，不是想辦法清除掉它，就是搞清楚到底是誰幹的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640102
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740640102,
					"content": "用說的當然簡單…我試了各種清潔劑都沒辦法清除它，再更強效的…就只能試試濁水幻靈剋星了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640103
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640103,
					"content": "濁水幻靈剋星？你是想在牆上開個洞，讓所有人都跟魚一起睡覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640104
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740640104,
					"content": "那就只能找到罪魁禍首再說了。話雖如此，我們現在可是一點線索也沒有啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640105
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640105,
					"content": "怎麼了？有什麼我們能幫上忙的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640106,
					"content": "#是這樣的，{F#妳}{M#你}們看牆上的標記，梅洛彼得堡是禁止亂塗亂畫的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640107
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640107,
					"content": "我們試了各種辦法都沒辦法清除掉標記，如果至少能找到是誰幹的好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640108
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640108,
					"content": "仔細想想也不是毫無線索，我好像聽克蘭茨說過，在楓丹科學院有一種標記，需要用特殊的方法解讀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640109
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740640109,
					"content": "妳是說這個標記可能是他說的那種？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640110
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640110,
					"content": "當時我完全沒有興趣，所以也沒有繼續追問。要是他人在這裡，或許就能給出答案了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640111,
						740640113
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740640111,
					"content": "說不定就是他本人幹的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640112
					]
				},
				{
					"id": 740640112,
					"content": "的確不能排除這種可能。但如果真的是這樣，呵呵…他應該知道規矩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740640115,
					"content": "#{NICKNAME}和派蒙，{F#妳}{M#你}們是見多識廣的冒險家，{F#妳}{M#你}們有什麼好辦法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640116
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740640116,
					"content": "幫我們找到亂塗亂畫的罪魁禍首，或者找到克蘭茨讓他來看看。唔…就當作是正式的工作委託好了，我們會支付特許券作為報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640117
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740640117,
					"content": "好吧，既然是正式的工作委託，那我們就想想辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640118,
					"content": "感謝，我們也再試試看有沒有可以清除標記的辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740640113,
					"content": "那去找他來看看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640114
					]
				},
				{
					"id": 740640114,
					"content": "不知道他人在哪裡…我今天都還沒有見到他，而且真的要拜託他嗎？每次拜託他做點什麼，我的自尊都會死去一點點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640115
					],
					"speakerTitle": "莫普瓦"
				}
			]
		},
		{
			"id": 7406402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
