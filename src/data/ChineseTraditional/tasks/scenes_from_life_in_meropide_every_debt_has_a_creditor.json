			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫普瓦",
					"嘉維婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640201,
					"content": "抓一隻膨膨獸來對著它吐口水會有用嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640202
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640202,
					"content": "認真的嗎？你最近是不是壓力有點大？精神還健康嗎？是不是排班排太多了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640203
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740640203,
					"content": "我的精神很健康啊！我只是想看膨膨獸吐口水而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640204
					],
					"speakerTitle": "莫普瓦"
				},
				{
					"id": 740640204,
					"content": "你還是休個假吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉維婭"
				}
			]
		},
		{
			"id": 7406403,
			"completionStepIds": [
				7406403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7406403",
							"2"
						],
						"stepId": 7406403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"克蘭茨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740640301,
					"content": "欸？這不是克蘭茨嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640302,
						740640304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640302,
					"content": "你好，克蘭茨，又見面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640303
					]
				},
				{
					"id": 740640303,
					"content": "…嗯？克蘭茨在這裡的話也就是說，那個標記果然是你留下的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640306,
					"content": "#唉，怎麼會是{F#妳}{M#你}們啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640307
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640307,
					"content": "#{F#妳}{M#你}們說的是什麼事？我一點頭緒也沒有，還是{F#妳}{M#你}們去問問別人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640308,
						740640310
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640308,
					"content": "派蒙，看來我們找錯人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640309
					]
				},
				{
					"id": 740640309,
					"content": "#原來是我們找錯人了嗎…不對吧！{NICKNAME}，{F#妳}{M#你}不要被他騙了，這裡除了他根本就沒有其他人了嘛！一定是他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640312,
					"content": "#好吧，{F#妳}{M#你}們贏了，是我幹的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640313
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640313,
					"content": "#唉，我還以為能靠這個找到熟人敘敘舊呢！沒想到來的是{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640314
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640314,
					"content": "靠這個找到熟人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640315,
					"content": "是啊，密圖函是布托爾先生開發的技術，楓丹科學院裡知道解讀方法的人也不多。我也是因為曾經受到他不少照顧所以才知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640316
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640316,
					"content": "可惜他去世得太早了，密圖函的技術也不受管理層重視，所以我想如果還有能夠解讀密圖函的傢伙，我們應該有得聊吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640317
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640317,
					"content": "#哦，我的意思不是和{F#妳}{M#你}們無話可說，只是我們之間可能缺少一些共同話題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640318,
						740640321
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640318,
					"content": "不要勉強自己了，的確無話可說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640319
					]
				},
				{
					"id": 740640319,
					"content": "#{F#妳}{M#你}還真是誠實。我曾經有一個朋友，就和{F#妳}{M#你}一樣也是有話直說，也曾經因此惹了不少麻煩過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640320
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640320,
					"content": "不過現在回想起來，那真是一段快樂的時光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640325,
					"content": "#話說回來，{F#妳}{M#你}們找我只是為了這件事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640326
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640326,
					"content": "差點忘了！是嘉維婭和莫普瓦拜託我們調查亂塗亂畫的罪魁禍首。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640327,
					"content": "你自首吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640328
					]
				},
				{
					"id": 740640328,
					"content": "自首吧！拒捕的話我們不會手下留情的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640329,
					"content": "欸…真的沒有商量的餘地嗎？莫普瓦姑且不提，我可不想又落到嘉維婭手上啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640330
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640330,
					"content": "兩位有沒有可能就對這件事睜一隻眼閉一隻眼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640331
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640331,
					"content": "可是莫普瓦說了，梅洛彼得堡禁止亂塗亂畫，違反規定是不好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640332,
					"content": "不要這麼嚴格的話，密圖函和牆上的那些文字也沒有什麼不同嘛！都是裝飾，裝飾而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640333
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640333,
					"content": "#這樣好了，我和{F#妳}{M#你}們回去，但是要不要檢舉我，就看{NICKNAME}的決定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640334
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640334,
					"content": "#當然，如果{F#妳}{M#你}選擇幫我一把，讓我不至於落入嘉維婭的魔爪之中，我也願意提供相應的回報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640335
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640335,
					"content": "#我把我的命運託付給{F#妳}{M#你}們了，我們現在就走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640321,
					"content": "那還真是抱歉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640322
					]
				},
				{
					"id": 740640322,
					"content": "#哈，{F#妳}{M#你}這樣說我就接不下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640323
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640323,
					"content": "#我也知道，按照常理這種時候應該說一些「聽{F#妳}{M#你}們講講旅途的經歷或許也很不錯吧？」之類的客套話，不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640324
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640324,
					"content": "唯獨這件事，我決定對自己誠實一點。我不想聽外面的新鮮故事了，只想找人敘舊，所以要道歉的是我才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640325
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740640310,
					"content": "你看看這裡除了你還有誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640311
					]
				},
				{
					"id": 740640311,
					"content": "對嘛對嘛！少拿這種蹩腳的演技糊弄我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740640304,
					"content": "老實交代，就是你這傢伙幹的對吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740640305
					]
				},
				{
					"id": 740640305,
					"content": "老實交代！那個標記就是你幹的好事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740640306
					],
					"speakerTitle": "派蒙"
				}
			]
		},
