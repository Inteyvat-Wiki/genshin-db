					}
				]
			},
			"dialogs": [
				{
					"id": 401660501,
					"content": "…來，妳要的貨，放心吧，都是好東西。嘿嘿嘿，要不要再順手帶一份桑歌瑪哈巴依老爺我新進的好貨啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660502
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660502,
					"content": "啊？不要嗎？慢走不送。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660503
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660503,
					"content": "多莉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660504,
					"content": "唉呀呀！看看誰來啦！是我的兩位大客戶！還有…噢？妳是阿如村的守護者坎蒂絲小姐…唔唔唔，有趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660505
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660505,
					"content": "有何貴幹啊？我可沒在沙漠進行任何不合時宜的買賣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660506
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660506,
					"content": "您誤會了，親愛的多莉大商人。我們此行是想來向您打聽一個消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660507
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660507,
					"content": "哦！是要買情報啊！歡迎歡迎！我最喜歡做情報生意了，帶在身上不累，賣給別人翻倍！啊不…是…免稅、免稅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660508
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660508,
					"content": "我今早購入了一塊有些奇特的寶石，商人的名字我寫在紙上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660509
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660509,
					"content": "我想向那位商人打聽一下製作這塊寶石的工匠，是從哪裡得到原石的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660510
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660510,
					"content": "是找人的工作啊？這就有些麻煩呢，總覺得要花掉不少摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660511
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660511,
					"content": "當然，也可以省去找人的步驟，如果萬能的多莉大商人能夠直接打聽到來源的話，我也願意支付這筆情報費。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660512
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660512,
					"content": "（找人倒是一點也不麻煩，就是賺得少一點…剛好我有幾個熟人平常也加工寶石，隨口問他們一句應該就能搞定。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660513
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660513,
					"content": "唉呀，聽您說的，可不就是為難桑歌瑪哈巴依老爺我嗎？這類消息來源都是商業機密，打聽起來費勁得很呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660514
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660514,
					"content": "請您開個價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660515
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660515,
					"content": "哎喲！痛快！那等我算算哦…跑路的車馬費，加上送禮給別人的費用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660516
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660516,
					"content": "二十萬摩拉，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660517
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660517,
					"content": "唔…好貴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660518,
					"content": "實在不好意思，這個價格稍微有些超出我們的預算了，能便宜一些嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660519
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660519,
					"content": "…好吧！阿如村是個有人情味的地方，這個面子我可以賣。妳開個價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660520
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660520,
					"content": "五萬摩拉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660521
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660521,
					"content": "什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660522
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660522,
					"content": "（這…殺得比剛才還狠…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660523
					]
				},
				{
					"id": 401660523,
					"content": "怎麼了？這類型的情報在沙漠一般就賣這個價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660524
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660524,
					"content": "不賣不賣！這簡直…簡直虧得我身上的鏡片都剩不下來啦！絕對不賣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660525
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660525,
					"content": "這樣嗎…真是可惜——那三萬摩拉怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660526
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660526,
					"content": "怎麼還往下砍啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660527
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660527,
					"content": "三萬摩拉，外加您的商隊到阿如村拜訪時的食宿安全保障，還有一些雜稅的減免，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660528
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660528,
					"content": "什…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660529
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660529,
					"content": "（等等…阿如村最近的確充滿商機，如果藉此得到守護者的庇護還能拿點方便的話…倒是一筆不錯的交易…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660530
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660530,
					"content": "（嘖…坎蒂絲這傢伙，該不會是想順帶為村裡招攬些貿易吧…真是可怕的女人…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660531
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660531,
					"content": "呃…嘿嘿…好吧！桑歌瑪哈巴依老爺考慮了一下，這次的生意就不計成本了！三…嘖…三萬就三萬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660532
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660532,
					"content": "真的嗎？不愧是須彌第一的大商人，您的眼界和氣度非比常人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660533
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660533,
					"content": "那…那是當然，誰叫客戶是阿如村的守護者嘛！重在結交朋友，這買賣就是虧本我也得做！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660534
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660534,
					"content": "那不如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660535
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660535,
					"content": "啊停停停！三萬！說好三萬了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660536
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660536,
					"content": "（唉…到時候隨便請那寶石商人吃點五百摩拉的路邊攤吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660537
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660537,
					"content": "#收集情報也要些時間，{F#妳}{M#你}們…明天再來找我吧！跑這麼一趟可不是什麼輕鬆事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660538
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401660538,
					"content": "謝謝多莉大商人，真是幫大忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660539
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660539,
					"content": "#{NICKNAME}，{F#妳}{M#你}們剛回須彌，接下來不妨就在奧摩斯港多逛逛吧。購買的物資交給我來處理就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660540
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660540,
					"content": "真的嗎？總覺得有些不好意思呢，我們也沒幫上太多忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660541,
					"content": "#請別這麼說，倒是我還要麻煩{F#妳}{M#你}們隨我一起調查，這才過意不去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660542
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660542,
					"content": "小事小事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660543
					]
				},
				{
					"id": 401660543,
					"content": "#哈哈，{F#妳}{M#你}還是一如既往地崇高。願神明保佑{F#妳}{M#你}，親愛的{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660544
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660544,
					"content": "多莉大商人也是，願您此行順利。我們明日再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660545
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660545,
					"content": "唉…再見再見，慢走不送了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				}
			]
		}
	]
}