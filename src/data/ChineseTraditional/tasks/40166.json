			"dialogs": [
				{
					"id": 401660401,
					"content": "我記得水果攤就在那邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660402,
					"content": "呃…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660403
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660403,
					"content": "咦？坎蒂絲妳沒事吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660404,
					"content": "…！危險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660405
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660405,
					"content": "…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660406
					],
					"speakerTitle": "哈蒂絲"
				},
				{
					"id": 401660406,
					"content": "坎蒂絲飛身一躍，救下了差點被箱子砸到的孩子…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401660407
					]
				},
				{
					"id": 401660407,
					"content": "沒受傷吧孩子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660408
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660408,
					"content": "沒…沒事…謝謝大姐姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660409
					],
					"speakerTitle": "哈蒂絲"
				},
				{
					"id": 401660409,
					"content": "發生什麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660410
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660410,
					"content": "那邊的箱子突然倒了下來，還好坎蒂絲護住了這孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660411,
					"content": "妳父母呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660412
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660412,
					"content": "我…他們在港口的酒館，我一個人無聊，才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660413
					],
					"speakerTitle": "哈蒂絲"
				},
				{
					"id": 401660413,
					"content": "已經沒事了，親愛的孩子，下次玩耍時注意安全就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660414
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660414,
					"content": "…快回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660415
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660415,
					"content": "好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660416
					],
					"speakerTitle": "哈蒂絲"
				},
				{
					"id": 401660416,
					"content": "這是誰家的箱子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660417
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660417,
					"content": "是…是我的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660418
					],
					"speakerTitle": "庫特比"
				},
				{
					"id": 401660418,
					"content": "都說了不要在道路周圍堆放重物！怎麼還在犯這種錯誤？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660419
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660419,
					"content": "抱歉！最近…最近貨物稍微多了一點，倉庫不夠放…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660420
					],
					"speakerTitle": "庫特比"
				},
				{
					"id": 401660420,
					"content": "嗯？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660421
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660421,
					"content": "我這就處理！下次再也不放了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660422
					],
					"speakerTitle": "庫特比"
				},
				{
					"id": 401660422,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660423
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660423,
					"content": "#謝謝{F#妳}{M#你}們，都怪我監督不周。要不是坎蒂絲小姐，還真不知道事情會變成什麼樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660424
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660424,
					"content": "舉手之勞罷了。夏姆先生也不必過於自責，我很能理解守護一片區域的不易。只是節日在即，各處還需要您多多留神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660425
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660425,
					"content": "唉…花神誕祭期間還真是有幾隻眼睛都看不過來。哦，請別誤會，坎蒂絲小姐的提醒我已經記下了，一定注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660426
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660426,
					"content": "#幾位是來採購的嗎？那我也不再叨擾了，祝{F#妳}{M#你}們節日愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660427
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 401660427,
					"content": "坎蒂絲妳動作也太快了吧！總感覺那箱子還沒掉下來的時候妳就衝過去了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660428,
					"content": "簡直就像知道箱子會掉一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660429
					]
				},
				{
					"id": 401660429,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660430
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660430,
					"content": "其實…我當時的確看到了那箱子掉下的「未來」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660431
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660431,
					"content": "欸？妳的意思是…妳預知了未來？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660432,
					"content": "嗯…包括剛才爐火的意外也是，我看到了將要發生的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660433,
						401660434
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660433,
					"content": "「預示之眼」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660435
					]
				},
				{
					"id": 401660435,
					"content": "我不覺得我的琥珀色左眼有何特殊之處，以前它從未讓我看到什麼奇怪的異象過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660436
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660436,
					"content": "但從今早開始，我時常看見某些畫面，它們與現實不符，卻在幾秒後真真切切地發生了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660437
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660437,
					"content": "妳有告訴其他人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660438
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660438,
					"content": "還沒有…我尚且無法確定這是否真的是「預示」，也不想讓大家擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660439,
						401660440
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660439,
					"content": "為什麼是今早開始？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660441
					]
				},
				{
					"id": 401660441,
					"content": "回憶起來…並沒有太過特殊的。我同往常一樣安排好一日事務，向神明做完禱告，就來見朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660442
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660442,
					"content": "實在要挑出一些不尋常的話…大概就是我在路上買了一塊好看的寶石吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660443
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660443,
					"content": "的確滿好看的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660444
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660444,
					"content": "但總覺得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660445
					]
				},
				{
					"id": 401660445,
					"content": "#{F#妳}{M#你}也察覺到了？這塊寶石中似乎蘊藏著些微特殊的元素痕跡，我也是對此感到好奇才買下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660446
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660446,
					"content": "難道說這些「預示」…是寶石的作用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660447,
					"content": "#有這種可能。來{NICKNAME}，{F#妳}{M#你}拿著寶石試試看，看看能不能感覺到什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660448
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660448,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660449
					]
				},
				{
					"id": 401660449,
					"content": "好像沒什麼感覺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660450
					]
				},
				{
					"id": 401660450,
					"content": "嗯…看來也不是對每個人都有效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660451
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660451,
					"content": "難道需要某種條件來觸發嗎…還是說，與我身為阿赫瑪爾大人的子民有關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660452
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660452,
					"content": "要不要去找其他人問一問？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660453
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660453,
					"content": "最近大家都忙於準備花神誕祭，不到萬不得已，我可不能因為這種小事打擾朋友們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660454
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660454,
					"content": "剛好這兩天分配給我的任務不多，我自行調查就好。這也是一位「守護者」該做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660455
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660455,
					"content": "我們也可以幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660456
					]
				},
				{
					"id": 401660456,
					"content": "#那就再好不過了，有{F#妳}{M#你}在身邊，總能讓人感到安心，就像夜晚的篝火旁有人陪伴一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660457
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660457,
					"content": "先將採購的工作做完吧。再之後就去打聽打聽關於這塊石頭的情報，至少得從商人口中知道它的來源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660458
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660458,
					"content": "說到「商人」的話，我們不是正好認識一位消息靈通的大商人嗎？雖然從她嘴裡要情報，可能會花掉包包裡不少摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660459
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660459,
					"content": "是說那位「多莉」大商人吧？我在阿如村也早有耳聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660460
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660460,
					"content": "沒錯，就是她！呃…不過多莉那傢伙對摩拉可是很敏感的哦！坎蒂絲妳和她談價格時，最好下手輕一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660461
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660461,
					"content": "與坎蒂絲一起購買了清單上的水果…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401660462
					]
				},
				{
					"id": 401660462,
					"content": "同時還從商販們那裡打聽到了多莉的下落…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 401660440,
					"content": "今早發生了什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660441
					]
				},
				{
					"id": 401660434,
					"content": "真的應驗了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660435
					]
				}
			]
		},
		{
			"id": 4016605,
