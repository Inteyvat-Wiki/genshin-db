						"sceneId": 3,
						"position": [
							-1944.971,
							203.139,
							2561.759
						],
						"pointId": 9285
					}
				]
			},
			"dialogs": [
				{
					"id": 401660301,
					"content": "哇，今天的奧摩斯港聞起來香噴噴的，連海風的味道都要被壓下去了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660302,
					"content": "聽說這裡是花車巡遊的終點，很多商家提前佈置攤位，自然會比平常更熱鬧一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660303
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660303,
					"content": "阿如村最近也來了不少商人，大家都在準備過一個難忘的花神誕祭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660304
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660304,
					"content": "嘿嘿，看來不愁買不到東西了！砍價這件事就交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660305,
					"content": "好，那就…唔…！呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660306,
						401660307
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660306,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660308
					]
				},
				{
					"id": 401660308,
					"content": "我沒事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660309
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660310
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660310,
					"content": "#抱歉，讓{F#妳}{M#你}們擔心了。我們先去那家店訂一些東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660311
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660311,
					"content": "喲，歡迎光臨，客人想吃點什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660312
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660312,
					"content": "想訂一些花神誕祭當日的小吃，大概在花車巡遊結束後來拿，到時候能幫我提前做好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660313
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660313,
					"content": "外帶的預定單是吧？沒問題，您到時候要吃些什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660314
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660314,
					"content": "馬薩拉起司球和馬鈴薯船各三份、綠汁脆球十人份，咖哩蝦也要三份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660315
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660315,
					"content": "稍等我記一下…馬鈴薯船…綠汁脆球…嗯，沒問題，這些食材都還夠，客人還真是大手筆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660316
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660316,
					"content": "買這麼多的話，請問能便宜一些嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660317
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660317,
					"content": "當然可以！我算算哦…一共兩萬九千摩拉，打個折算您兩萬六怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660318
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660318,
					"content": "兩萬摩拉可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660319
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660319,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660320,
					"content": "（坎蒂絲…殺價殺得好凶…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660321
					]
				},
				{
					"id": 401660321,
					"content": "呃…這…這多少有點為難我了。花車巡遊當天我這裡的客人也不少，食材也得專門為您留一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660322
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660322,
					"content": "這樣嗎…那我再加五份薩巴桑炸角怎麼樣？能再便宜一些嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660323
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660323,
					"content": "啊，這樣的話…我最多給客人您打到八折…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660324
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660324,
					"content": "好吧，那就八折，辛苦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660325
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660325,
					"content": "應該的應該的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660326
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660326,
					"content": "總感覺坎蒂絲比我們還會砍價呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660327,
					"content": "另外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660328
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660328,
					"content": "客人還有什麼想要的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660329
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660329,
					"content": "沒有了。只是想提醒您檢查一下爐火，用得久了可能會存有安全隱患。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660330
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660330,
					"content": "哦，謝謝客人關心。不過這是我今天剛換的一批炭料，絕對不會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660331
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660331,
					"content": "（砰——！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660332
					]
				},
				{
					"id": 401660332,
					"content": "嗚啊！咳咳…好大的煙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660333,
					"content": "唔咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660334
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660334,
					"content": "您沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660335
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660335,
					"content": "沒事…沒事…謝謝您。咦？真是奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660336
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660336,
					"content": "是不是鼓風裝置出了故障？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660337
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660337,
					"content": "咳咳…的確有可能，前陣子也出過類似的事…我才換鼓風的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660338
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660338,
					"content": "爐子的問題可以晚點再檢查，您人沒事才是最重要的。要喝些水嗎？我身上有帶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660339
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660339,
					"content": "不要緊不要緊，也是客人您眼睛好。要是您今天早點到我店裡提醒我，說不定就不會這樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660340
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660340,
					"content": "總之，我今天就趕緊修一修這個爐子，不會耽擱您花神誕祭當天的訂單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660341
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660341,
					"content": "還是身體和安全要緊，您慢慢來。訂金我就放這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660342
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660342,
					"content": "好，客人您慢走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660343
					],
					"speakerTitle": "賈漢吉爾"
				},
				{
					"id": 401660343,
					"content": "剛才真是危險呢！還好坎蒂絲妳反應快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660344
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660344,
					"content": "妳怎麼知道爐火有問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660345
					]
				},
				{
					"id": 401660345,
					"content": "唔…或許是冥冥之中的感覺吧？我說不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660346
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660346,
					"content": "呼…接下來去哪裡？希望是個沒有爐子的地方，我真是被嚇得不輕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660347,
					"content": "去買一些水果吧，在製作糖果時會用到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401660348
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 401660348,
					"content": "好！我們也好久沒逛奧摩斯港了，順帶買點其他東西吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401660307,
					"content": "身體不舒服嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401660308
					]
				}
			]
		},
