			"dialogs": [
				{
					"id": 752460101,
					"content": "#{NICKNAME}，快看那邊，有人在呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460102,
					"content": "唔？這兩個背影是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460103
					]
				},
				{
					"id": 752460103,
					"content": "歐洛倫和伊法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460104,
					"content": "#熟悉的聲音，是{M#爺爺}{F#奶奶}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460105
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460105,
					"content": "噢哥們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460106
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460106,
					"content": "#好久不見，{F#妳}{M#你}們也來度假村了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460107
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460107,
					"content": "#恰斯卡說過{F#妳}{M#你}們來度假村工作的事，沒想到突然就遇到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460108,
					"content": "是啊，這裡氛圍不錯，聽說大家都玩得很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460109
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460109,
					"content": "嘿嘿，希望這裡辦得越來越好、遊客越來越多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460110,
					"content": "#{F#妳}{M#你}們呢？工作還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460111,
					"content": "還不錯，我們負責照顧的龍員工和蜜蟲都很健康，活力十足。託這個的福，我們也有空到處轉轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460112
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460112,
					"content": "…員工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460113
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460113,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460114
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460114,
					"content": "蜜蟲員工。龍員工和蜜蟲員工，你說漏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460115
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460115,
					"content": "沒錯哥們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460116
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460116,
					"content": "哎…抱歉啊。那麼感謝所有的員工，以及積極為各位員工服務的歐洛倫先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460117
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460117,
					"content": "早到幾天，為重要的事物奮鬥。嗯，很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460118
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460118,
					"content": "#這哥們第一次接到如此正式的邀請函，超積極的，{F#妳}{M#你}別見怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460119
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460119,
					"content": "保持熱情是好事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460120
					]
				},
				{
					"id": 752460120,
					"content": "#你看，{M#爺爺}{F#奶奶}也這麼說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460121
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460121,
					"content": "每一天都很重要，每一天的工作都是為守護重要的事物而戰。這是咔庫庫教會我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460122
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460122,
					"content": "哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460123
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460123,
					"content": "可是…看樣子你們是在釣魚吧？釣魚也算為重要的事而戰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460124,
					"content": "聽聽妳說的話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460125
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460125,
					"content": "很重要，因為釣魚是一位朋友給我們的建議。他是蒙德有名的冒險家，運氣極佳，聽他的準沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460126
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460126,
					"content": "（啊…班尼特嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460127
					]
				},
				{
					"id": 752460127,
					"content": "那位哥們用樹枝轉了一圈，指向這片水池，歐洛倫說擇運不如撞運，就過來釣魚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460128
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460128,
					"content": "等一等等一等，我從剛才就想問了，這池子周圍不都是豚獸嗎！真的能釣到魚嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460129,
					"content": "沒問題的。豚獸性情溫和，不太野，所以不需要提防。有水就能野釣，這是奶奶的教誨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460130
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460130,
					"content": "奶奶還說有飯就吃，有臺階就下呢，你記住了沒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460131
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460131,
					"content": "#我現在正在給出臺階。{M#爺爺}{F#奶奶}、派蒙，來都來了，要不要一起釣魚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460132
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460132,
					"content": "順便一提，釣到最大的魚的人，可以得到這傢伙的蜜酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460133
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460133,
					"content": "有這種好事怎麼不早說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460134,
					"content": "#哼哼，看來你還不知道自己招惹了什麼人…面對挑戰、說幹就幹！遇到{NICKNAME}你可真是遇到對手啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460135,
						752460137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460135,
					"content": "親愛的哥們，一決勝負吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460136
					]
				},
				{
					"id": 752460136,
					"content": "真有幹勁，那我就奉陪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460137,
					"content": "親愛的孫子，一起釣魚吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460138
					]
				},
				{
					"id": 752460138,
					"content": "沒問題。賭上魚的一切和蜜蟲員工的酒，一決高下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歐洛倫"
				}
			]
		},
