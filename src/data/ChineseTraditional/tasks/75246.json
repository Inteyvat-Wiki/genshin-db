			"dialogs": [
				{
					"id": 752460384,
					"content": "#有請輩分最高的{M#爺爺}{F#奶奶}先來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460385
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460385,
					"content": "那我就不客氣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460301
					]
				},
				{
					"id": 752460301,
					"content": "#哇，一上來比賽就進入高潮！高手{NICKNAME}使出絕技，拉桿出水！甩出一條…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460302,
					"content": "呃…一隻…一位…阿夏？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460303,
					"content": "真不得了…一上來就釣到了意想不到的東西，直接對評分系統提出挑戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460304
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460304,
					"content": "#不愧是{M#爺爺}{F#奶奶}！如果其他人不能釣到更特別的嘉賓，我覺得這就是冠軍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460305
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460305,
					"content": "謝謝強大的對手們、謝謝親愛的觀眾們！借乖孫吉言，本人有望成為冠軍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460306
					]
				},
				{
					"id": 752460306,
					"content": "#真是太好了呢！{NICKNAME}旗開得勝，為另外兩位選手帶來壓力了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460307,
					"content": "伊法選手請就位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460308,
					"content": "加油，哥們！幫個忙哥們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460309
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460309,
					"content": "抱歉，咔庫庫，現在不是互相幫助的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460310
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460310,
					"content": "你們好了啦…等等，來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460311,
						752460313
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460311,
					"content": "伊法拼盡全力拉動釣竿，看起來像是釣到了大的。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460312
					]
				},
				{
					"id": 752460312,
					"content": "然而浮出水面的卻是…",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460313,
					"content": "呃…伊法選手從池子裡釣上來一條鰭游龍，後面還拖著一隻豚獸？不知道牠們為什麼接在一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460314,
					"content": "真棒，還是這麼受動物歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460315
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460315,
					"content": "不對，這條鰭游龍的尾巴不對勁…難道是牠被水底的石頭卡住了，然後這隻豚獸想要幫牠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460316
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460316,
					"content": "也有可能是豚獸想吃鰭游龍的尾巴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460317
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460317,
					"content": "不對吧哥們。咔庫庫，去問問看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460318
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460318,
					"content": "嗯嗯…對的哥們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460319
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460319,
					"content": "你看，我猜對了吧…不對不對，當務之急是這個嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460320,
						752460322
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460320,
					"content": "伊法迅速檢查了鰭游龍的尾巴。還好只是輕微擦傷，並無大礙。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752460321
					]
				},
				{
					"id": 752460321,
					"content": "簡單消毒和上藥後，鰭游龍和豚獸結伴離開了。",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 752460322,
					"content": "交到朋友了呢。看來今天也是牠們的幸運日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460323
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460323,
					"content": "「也」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460324
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460324,
					"content": "嗯，我有贏的預感。輪到我奮鬥了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460325
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460325,
					"content": "幫個忙吧！哥們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460326
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460326,
					"content": "到底從哪學來的…不會是在幫我們加油的意思吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460327
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460327,
					"content": "「釣魚鼓勵大師」咔庫庫！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460328
					]
				},
				{
					"id": 752460328,
					"content": "我們在奮鬥，所以牠應該叫「奮鬥鼓勵大師」，這樣聽起來更偉大…嗯？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460329
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460329,
					"content": "什麼東西？！大家快閃開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460330
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460330,
					"content": "雖然看起來有點特別…但怎麼又是豚獸啊！不是說這種生物性格很溫和的嗎，今天居然這麼有幹勁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460331,
					"content": "一定也在為自己的重要之事奮鬥吧，嗯，我能感覺到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460332
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460332,
					"content": "…唔，好像不對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460333
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460333,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460334
					],
					"speakerTitle": "豚獸"
				},
				{
					"id": 752460334,
					"content": "牠現在心情不好，該奮鬥的是我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460335
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460335,
					"content": "噢我親愛的老夥計！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460336
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460336,
					"content": "——？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460337
					],
					"speakerTitle": "豚獸"
				},
				{
					"id": 752460337,
					"content": "哈哈！太棒了哥們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460338
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460338,
					"content": "什、什麼意思？咔庫庫在說服牠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460339,
					"content": "應該是在安撫。別看咔庫庫這個樣子，牠在安撫患者情緒方面技術高超。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460340
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460340,
					"content": "原來如此，不過咔庫庫的詞彙量夠用嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460341,
					"content": "派蒙，用人的詞彙本來就也無法和豚獸交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460342
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460342,
					"content": "啊？對哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460343,
					"content": "在這種情況下，就得相信哥們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460344
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460344,
					"content": "而且我認為，交流時比起內容，聲調更重要，更具有說服力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460345
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460345,
					"content": "比如像這樣，「你好」。這是高興的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460346
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460346,
					"content": "「你好」…這是無奈的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460347
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460347,
					"content": "「你好」！這是生氣的意思，通常表示有危險靠近，要躲避。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460348
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460348,
					"content": "不能說完全沒有道理，但怎麼想都太難理解了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460349,
					"content": "學到了，非常感謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460350
					]
				},
				{
					"id": 752460350,
					"content": "#真的嗎？為{F#妳}{M#你}開心。我通常都是這樣跟蜜蟲溝通的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460351
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460351,
					"content": "「員工」。「蜜蟲員工」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460352
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460352,
					"content": "也有不想當員工的蜜蟲，我理解牠們的心情，尊重牠們的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460353
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460353,
					"content": "…那能不能先理解一下我的心情？我現在心情很複雜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460354
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460354,
					"content": "真的嗎？我覺得你現在應該感到驕傲才對。看那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460355
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460355,
					"content": "——。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460356
					],
					"speakerTitle": "豚獸"
				},
				{
					"id": 752460356,
					"content": "哈哈！對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460357
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460357,
					"content": "——。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460358
					],
					"speakerTitle": "豚獸"
				},
				{
					"id": 752460358,
					"content": "天哪天哪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460359
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460359,
					"content": "聊得如火如荼的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460360
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460360,
					"content": "驕傲多少有點，但我覺得…欸？歐洛倫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460361
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460361,
					"content": "別擔心，我有辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460362
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460362,
					"content": "你好，豚獸大王。要吃點零食嗎？新鮮的餅乾，伊法剛做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460363
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460363,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460364
					],
					"speakerTitle": "豚獸"
				},
				{
					"id": 752460364,
					"content": "豚獸大王？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460365
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460365,
					"content": "吃了！看起來很高興的樣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460366
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460366,
					"content": "哎呀！哎呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460367
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460367,
					"content": "話說回來，誰還記得我們是在比賽釣魚啊？這裡都快變成動物樂園了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460368,
						752460369
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460368,
					"content": "不也滿好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460370
					]
				},
				{
					"id": 752460370,
					"content": "也是…那，這次釣魚比賽的冠軍，應該是歐洛倫對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460371
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460371,
					"content": "因為他釣到了那個什麼…豚獸大王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460372
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460372,
					"content": "真是個好名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460373
					]
				},
				{
					"id": 752460373,
					"content": "可以，就算他吧，反正大家釣到的都不是魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460374
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460374,
					"content": "哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460375
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752460375,
					"content": "那蜜酒就歸我了，真好！不過，東西本來就是我的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460376
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460376,
					"content": "能留住手裡的好東西也是一種好運呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460377
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460377,
					"content": "你說得對，而且我們還有額外收穫。看，豚獸大王好像給我們拿了禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460378
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752460378,
					"content": "「閃閃禮蛋」和一張畫片？畫片上拍到的地方有點眼熟呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460379
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752460379,
					"content": "難道是豚獸大王要我們去這個地方嗎？看起來是某種指引呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460380
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752460380,
					"content": "不如找找看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752460381
					]
				},
				{
					"id": 752460381,
					"content": "我也這麼想，大家有空可以留意一下畫片上的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752460382
					],
					"speakerTitle": "伊法"
				},
