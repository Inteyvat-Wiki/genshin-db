				]
			},
			"dialogs": [
				{
					"id": 150000401,
					"content": "嗷嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000402
					],
					"speakerTitle": "波奇奇",
					"speakerSubtitle": "匿葉龍寶寶"
				},
				{
					"id": 150000402,
					"content": "龍寶寶在這裡！咦？旁邊有一個…阿喬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000403,
					"content": "這不是吾那僕從的兩位劣友嗎？是在山下窺見了吾的英姿，特地爬上來供奉的吧？看來日前一見，吾的偉岸已深嵌汝等心靈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000404
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000404,
					"content": "真是拿下人沒辦法，來吧，親吻吾的腳背，偉大聖龍庫胡勒阿喬允許汝等獻上朝拜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000405
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000405,
					"content": "你…你不是基尼奇的那個小跟班嗎？在自言自語什麼？居然比上次更討厭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000406,
					"content": "胡言亂語！什麼小跟班？吾乃無上之龍！烈焰之國的至高領主！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000407
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000407,
					"content": "上次要不是基尼奇三拜九叩，吾才不會恩施汝等絲毫言語的仁慈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000408
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000408,
					"content": "什麼嘛…明明就是被基尼奇關起來了吧？你還滿會裝模做樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000409,
						150000411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000409,
					"content": "領主大人，你在這山上幹嘛？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000410
					]
				},
				{
					"id": 150000410,
					"content": "哼哼，這還差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000413,
					"content": "近日吾應許了吾那僕從的祈求，為其調查維茨特蘭附近的深淵事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000414
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000414,
					"content": "深淵事件？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000415,
					"content": "看見這小爬蟲了嗎？牠的母親，一隻中爬蟲，被深淵力量侵蝕，錯亂地攻擊了吾那僕從的族人，甚至還攻擊了自己的後裔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000416
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000416,
					"content": "天哪…那牠現在怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000417,
					"content": "低等的爬蟲如何能與深淵久鬥？自然是去了夜神之國。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000418
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000418,
					"content": "弱小的生靈啊…聽說是自我了斷，從高崖上一躍而下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000419
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000419,
					"content": "跳崖…？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000420,
					"content": "白色小飛蟻，別再露出還有一百個問題的愚蠢表情，偉大的聖龍庫胡勒阿喬可不是誰人的許願靈泉啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000421
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000421,
					"content": "誰是白色小飛蟻？！你…我一定要給你想個難聽的綽號！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000422,
					"content": "哼…吾探查到附近有微弱的深淵氣息，必有擅於隱藏的邪惡術士存在。要是遇見了可疑的外地人，汝等需細細盤問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000423
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000423,
					"content": "可疑的外地人…你不是在指深淵罵我們吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000424,
					"content": "呸！下人之心度領主之腹！汝等若非吾那僕從的劣友，吾早就打打打打打打！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000425
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000425,
					"content": "既然不是來朝拜，就速速退去！偉大的聖龍庫胡勒阿喬要去辦正事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿喬"
				},
				{
					"id": 150000411,
					"content": "小跟班，你在這山上幹嘛？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000412
					]
				},
				{
					"id": 150000412,
					"content": "#是領主大人！你想氣死偉大聖龍庫胡勒阿喬嗎？{F#妳}{M#你}的罪行將遭回火焚燒千年！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000413
					],
					"speakerTitle": "阿喬"
				}
			]
		},
		{
			"id": 1500005,
			"completionStepIds": [
				1500007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1500007",
							"2"
						],
						"stepId": 1500007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡妮",
					"多巴"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2373.144,
							259.097,
							8480.769
						],
						"pointId": 9113
					},
					{
						"sceneId": 3,
						"position": [
							-2375.592,
							259.064,
							8479.979
						],
						"pointId": 9114
					},
					{
						"sceneId": 3,
						"position": [
							-2374.284,
							259.103,
							8478.566
						],
						"pointId": 9115
					},
					{
						"sceneId": 3,
						"position": [
							-2374.395,
							259.072,
							8482.007
						],
						"pointId": 9116
					}
				]
			},
			"dialogs": [
				{
					"id": 150000501,
					"content": "#哇！{M#哥哥姐姐}{F#兩位姐姐}好厲害！這麼快就回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000502
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000502,
					"content": "#龍寶寶沒事真是太好了，這下我們可以放心地回家啦。謝謝{M#哥哥姐姐}{F#兩位姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000503
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000503,
					"content": "不用客氣啦，我們根本沒費什麼工夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000504,
					"content": "#{F#妳}{M#你}們爬了好高的山呢，肯定很辛苦，看{M#哥哥姐姐}{F#兩位姐姐}的打扮，應該也不是當地人吧？來我家休息一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000505
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000505,
					"content": "#沒錯，給個機會吧，讓我們展現一下懸木人的熱情好客！{F#妳}{M#你}們這麼好心，跟之前那個眼鏡仔完全不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000506
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000506,
					"content": "聽你們說的，那傢伙也是外地人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000507,
					"content": "他的衣服不是納塔款式…現在想想真是可疑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000508
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000508,
					"content": "可疑的外地人？該不會是阿喬說的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000509,
					"content": "可以詳細講一下那個人的情況嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000510
					]
				},
				{
					"id": 150000510,
					"content": "#{M#哥哥姐姐}{F#兩位姐姐}對那個叔叔有興趣嗎？那我想想，事情是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000511
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000511,
					"content": "這位叔叔，我已經講了好幾個故事了…什麼時候才能幫我去找龍寶寶啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000512
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000512,
					"content": "再講一個吧，再講講那團火的故事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000513
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000513,
					"content": "叔叔聽說有一團巨大的、透明的火，燃燒在過去五百年、一千年甚至更多不計其數的時間裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000514
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000514,
					"content": "那個叫回火！古名「馬{RUBY#[D]回火}力卜」就是從這個傳說裡誕生的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000515
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000515,
					"content": "哇哦，是古名的起源嗎？這麼厲害？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000516
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000516,
					"content": "嗯嗯，所有的古名都有起源傳說。在傳說裡，回火出現在納塔大聯盟的年代，被暴君奧奇坎拿來統治納塔，鎮壓反對他的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000517
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000517,
					"content": "回火和普通火焰最不同的就是，被它點燃的人雖然會覺得背後灼痛難忍，但不會馬上死掉，這時候千萬不能回頭檢查！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000518
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000518,
					"content": "不可以回頭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000519
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000519,
					"content": "一回頭就完蛋了，立刻就會被燒成灰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000520
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000520,
					"content": "哇哦，燒衣服燒行頭就算了，燒人還真是殘暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000521
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000521,
					"content": "是吧？怎麼可以燒人家後背還不許人家回頭看呢？奧奇坎真是個暴君。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000522
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000522,
					"content": "按照傳說的慣例，接著該有人挺身而出了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000523
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000523,
					"content": "眼鏡大叔，你還滿內行的嘛。的確是這樣，那個人就是我們懸木人的祖先，尤潘基大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000524
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000524,
					"content": "嗯，尤潘基大人和暴君奧奇坎還有最初的火神希巴拉克大人都是朋友，他是當時大聯盟的軍械官。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000525
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000525,
					"content": "他不認同奧奇坎的殘酷統治，就為人們偷走了回火，並把它拋向暴君的軍隊。沒有人能抵擋，士兵們全被燒成了灰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000526
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000526,
					"content": "就這樣，祖先解放了人們，但就在逃出城的時候，他好像聽到奧奇坎的呼喚從背後傳來，於是鬼使神差地回了頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000527
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000527,
					"content": "但他卻只看到了焦黑的城市、枯萎的士兵、沖天的火焰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000528
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000528,
					"content": "再下一刻，映在眼底的火舌突然從他瞳孔中鑽出來，把祖先吞沒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000529
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000529,
					"content": "只回頭看了一眼哦！就也被燒成了灰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000530
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000530,
					"content": "這是竊火…還是回頭的代價呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000531
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000531,
					"content": "不知道，但尤潘基大人身上的火比別處的都要凶，燒了整整一百天，最後連地脈都被燒開了個大洞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000532
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000532,
					"content": "然後火光「嗶咻」地一下就掉進了黑漆漆的夜神之國，一直燒到現在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000533
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000533,
					"content": "大人都說它照亮了往生之路，但也要亡者接受它的灼燒，這樣才能純淨地迎接來世。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000534
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000534,
					"content": "就像是對一生的回顧與審問…所以人們就叫它尤潘基的回火。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000535
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000535,
					"content": "噢…多麼富有詩意的故事！所以在夜神之國真的可以見到這團火嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000536
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000536,
					"content": "不知道欸…這只是個傳說吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000537
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000537,
					"content": "所以後來你們有人繼承了這個古名吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000538
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000538,
					"content": "當然，比如「回火夜」祭祀的英雄布基納，不過他是五百年前的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000539
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000539,
					"content": "嗯，現在這個古名屬於基尼奇哥哥…「馬{RUBY#[D]回火}力卜」的基尼奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000540
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000540,
					"content": "基尼奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000541
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000541,
					"content": "好了，眼鏡大叔，我們已經說了很多故事了，你該去找龍寶寶了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000542
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000542,
					"content": "啊…但回火的傳說不是教導我們不要回頭看嗎？所以不要再提前面說過的部分了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000543
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000543,
					"content": "請再講一講這個基尼奇吧，從現在開始的才算數。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000544
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000544,
					"content": "咦？多巴，你怎麼露出了那種想要罵人的眼神？不可以哦，那是大人的特權。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000545
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000545,
					"content": "叔叔…要是你騙我們…死了之後會被回火燒得很慘的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000546
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000546,
					"content": "當地火怎麼會燒外地人呢？叔叔可不是你們的同鄉哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000547
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000547,
					"content": "啊…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000548
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000548,
					"content": "等等…那是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000549
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000549,
					"content": "#好了孩子們，叔叔不會白聽故事的，叔叔派了兩個朋友過來，嗯…{M#他們}{F#她們}會來付報酬的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000550
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000550,
					"content": "#你們一定要狠狠使喚{M#他們}{F#她們}，千萬別顧忌叔叔我的面子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000551
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000551,
					"content": "真的嗎？那眼鏡大叔，你叫什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000552
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000552,
					"content": "我們在這山崖下相遇，大叔自然叫「山下」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000553
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000553,
					"content": "真的假的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000554
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000554,
					"content": "#不信回頭看看，{M#他們}{F#她們}已經來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000555
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 150000555,
					"content": "嗯？哪有啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000556
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000556,
					"content": "叔叔…你人呢？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000557
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000557,
					"content": "聽起來這傢伙真的有點可疑呢…他好像在打聽關於古名的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000558
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000558,
					"content": "是吧！這個可惡的眼鏡仔，他背叛了我們！他會付出代價的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000559
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000559,
					"content": "但也只是聽了一些故事，應該不會怎麼樣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000560
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000560,
					"content": "#唔…{NICKNAME}，我們是不是該讓基尼奇知道一下？雖然那個臭屁阿喬已經在調查了，但總覺得牠不怎麼可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000561
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000561,
					"content": "#欸？{F#妳}{M#你}們也認識基尼奇哥哥嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000562
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000562,
					"content": "其實也不算很熟，我們只是見過面，還一起吃過飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000563
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000563,
					"content": "好羨慕！我都沒有和基尼奇哥哥說過話。他是族裡的獵龍人，還有很厲害的古名，真是太酷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000564
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000564,
					"content": "我也是！不過我爸爸不太喜歡他，還叫我跟他少接觸…肯定是因為他身邊那個自大又惡毒的夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000565
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000565,
					"content": "啊！是那個自稱庫胡勒阿喬的壞東西！我們也領教過了，真是生怕別人不討厭牠的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000566
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000566,
					"content": "就是嘛！真不知道基尼奇哥哥怎麼會選擇那傢伙當夥伴，怎麼不選我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000567
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000567,
					"content": "唉呀！不好了，胡妮，我們出來太久，再不回家要挨罵了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000568
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000568,
					"content": "#對哦，那…{M#哥哥姐姐}{F#兩位姐姐}，沿著這條路往前走就能到我們族裡，要是{F#妳}{M#你}們打算過去，要記得來我家做客哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000569
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000569,
					"content": "#有什麼需要的，我都會請爸爸幫{F#妳}{M#你}們的，一定要來哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000570
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000570,
					"content": "#{M#哥哥姐姐}{F#兩位姐姐}再見，我們先走啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多巴"
				}
			]
		},
