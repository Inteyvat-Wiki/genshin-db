				]
			},
			"dialogs": [
				{
					"id": 150000101,
					"content": "#{M#哥哥姐姐}{F#兩位姐姐}好！我是胡妮，{F#妳}{M#你}們是來找龍寶寶的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000102
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000102,
					"content": "#我是多巴，如果我沒猜錯的話，幫手就是{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000103
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000103,
					"content": "咦？小朋友，見到你們很高興，但我們只是路過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000104,
					"content": "#可是山下叔叔說他派了朋友過來幫忙…不是{F#妳}{M#你}們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000105
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000105,
					"content": "我們是有些朋友，但都不叫山下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000106
					]
				},
				{
					"id": 150000106,
					"content": "…雖然不知道具體情況，但你們好像搞錯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000107,
					"content": "搞錯了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000108
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000108,
					"content": "完蛋，胡妮，我們一定是被騙了，那個眼鏡仔果然是個騙子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000109
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000109,
					"content": "那龍寶寶該怎麼辦…時間要不夠了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000110
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000110,
					"content": "小朋友，妳先不要急，妳說的龍寶寶怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000111,
					"content": "最近族裡不太平靜，我爸爸的龍夥伴出事了，牠叫南娜，有三個寶寶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000112
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000112,
					"content": "南娜出事後，寶寶們很害怕，就躲了起來，我很擔心，就想來找找牠們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000113
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000113,
					"content": "妳爸爸的龍夥伴啊…那他自己不管嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000114,
					"content": "爸爸是族裡的長老，正忙著籌備回火夜，那個很重要，至少比這件事重要。我也是瞞著他偷跑出來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000115
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000115,
					"content": "本來以為不會很久，可是剛才那個叔叔纏著我們跟他講了很多故事，浪費了好多時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000116
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000116,
					"content": "真可惡，眼鏡仔的心裡沒有一點愛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000117
					],
					"speakerTitle": "多巴"
				},
				{
					"id": 150000117,
					"content": "#不要生氣啦，要不然我們來幫忙找吧！聽起來也不麻煩，我們心裡可是很有愛的，對吧？{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150000118,
					"content": "當然，龍寶寶在附近嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000119
					]
				},
				{
					"id": 150000119,
					"content": "應該是的，我已經發現了一些痕跡，牠們應該就躲在附近的山崖上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000120
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000120,
					"content": "交給我和派蒙吧，不會很久。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150000121
					]
				},
				{
					"id": 150000121,
					"content": "#真的嗎？那…那謝謝{NICKNAME}{M#哥哥}{F#姐姐}，謝謝派蒙姐姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150000122
					],
					"speakerTitle": "胡妮"
				},
				{
					"id": 150000122,
					"content": "#哇！{M#哥哥姐姐}{F#兩位姐姐}要注意安全哦，山崖很陡，族裡的大人也沒那麼容易爬上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多巴"
				}
			]
		},
