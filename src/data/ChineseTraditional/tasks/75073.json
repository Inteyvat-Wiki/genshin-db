			"dialogs": [
				{
					"id": 750730301,
					"content": "嗚嗚，終於可以從這個籠子裡出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730302
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730302,
					"content": "這個熱氣球搖搖晃晃的，嘿，說不定來上一陣風，整個籠子都會被吹下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730303
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730303,
					"content": "那時候大概就連黑曜石奶奶都沒辦法救我囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730304
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730304,
					"content": "妳是誰，為什麼在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730305
					]
				},
				{
					"id": 750730305,
					"content": "啊，我還沒做自我介紹，我啊，我的名字叫科奴拉芙，是「煙謎主」的實習祭司…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730306
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730306,
					"content": "現在正在祭司的修行途中，嗯…之前一直待在部族裡，所以部族裡的長輩跟我說：「妳總得出去見見世面吧！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730307
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730307,
					"content": "於是就以修行為名把我一腳踢出部族大門——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730308
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730308,
					"content": "#不過被丘丘人抓起來這種「世面」還是不見為妙啊…{F#妳}{M#你}說對不對啊，恩人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730309,
						750730311
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730309,
					"content": "獨自冒險很危險…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730310
					]
				},
				{
					"id": 750730310,
					"content": "對嘛對嘛，要不是遇到恩人，我還不知道要在這裡被困到什麼時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730313,
					"content": "唔…總之，多謝恩人救了小女子…在這上面吹了這麼多風，還是先下去想想繼續修行的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730314
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730314,
					"content": "小女子身上的盤纏不多，不過家裡人說受人恩惠總要回報，這些就給恩人吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730311,
					"content": "只要夠強…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750730312
					]
				},
				{
					"id": 750730312,
					"content": "#嘿…這{F#妳}{M#你}就騙不了小女子我啦，像恩人這麼強的冒險者，這個世上也是少數吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730313
					],
					"speakerTitle": "科奴拉芙"
				}
			]
		},
