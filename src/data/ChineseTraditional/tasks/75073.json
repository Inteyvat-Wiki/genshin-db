					"科奴拉芙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750730101,
					"content": "#啊，恩人！唉呀，恩人，多謝{F#妳}{M#你}出手相助…清理了這些丘丘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730102
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730102,
					"content": "實不相瞞，我剛才只是站在山崖上看風景，一個不注意就被丘丘人敲暈腦袋了，醒來的時候就被關在這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730103
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730103,
					"content": "關著，對鑰匙…啊，鑰匙就在那邊的箱子上，可以請您再伸出您的貴手，幫我一個微不足道的小忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750730104
					],
					"speakerTitle": "科奴拉芙"
				},
				{
					"id": 750730104,
					"content": "小女子我一定感激不盡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科奴拉芙"
				}
			]
		},
