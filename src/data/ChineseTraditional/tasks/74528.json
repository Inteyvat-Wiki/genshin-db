					"絲柯克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745280401,
					"content": "#是{F#妳}{M#你}啊。我們的旅途，又交會到了一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280402,
						745280403
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 745280402,
					"content": "絲柯克，好久不見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				},
				{
					"id": 745280404,
					"content": "我在觀察這個世界留下的「傷疤」，那次爆炸將這裡夷為廢墟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280405
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 745280405,
					"content": "但如今，人們又在廢墟之上建起了新的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280406
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 745280406,
					"content": "萬物皆有終點，但凋亡之後，亦會孕育新的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280407
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 745280407,
					"content": "#{F#妳}{M#你}的力量比上次見面時又成長了一些，看來{F#妳}{M#你}沒有懈怠鍛煉，不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280408,
						745280409
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 745280408,
					"content": "其實，我有一個小小的請求…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280410,
					"content": "留影嗎？對這個世界而言，我只是過客，又何必留下存在的印記呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280411,
						745280412
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 745280411,
					"content": "但對我而言，妳不是過客。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280413,
					"content": "#…既然是{F#妳}{M#你}想做的事，那就去做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745280414
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 745280414,
					"content": "我就在這裡，隨時可以開始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 745280412,
					"content": "每次重逢都值得紀念。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280413
					]
				},
				{
					"id": 745280409,
					"content": "我希望可以為妳拍一張畫片。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280410
					]
				},
				{
					"id": 745280403,
					"content": "妳在這裡做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745280404
					]
				}
			]
		}
	]
