				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730201,
					"content": "#欸？{F#妳}{M#你}怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730202
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730202,
					"content": "#雖然我剛才還在想，{F#妳}{M#你}是不是會跟來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730203
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730203,
					"content": "我想知道更多風神的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730204
					]
				},
				{
					"id": 3730204,
					"content": "風神巴巴托斯？那傢伙已經從蒙德消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730205
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730205,
					"content": "鄰國璃月的岩神、稻妻的雷神都還在，但蒙德人已經很久沒見過他們的神了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730206
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730206,
					"content": "為什麼要打聽風神的事？是因為特瓦林嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730207
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730207,
					"content": "啊，這個嘛…是因為「神」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3730208,
					"content": "嗯，有人告訴我龍的過往。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730209
					]
				},
				{
					"id": 3730209,
					"content": "哦？大家現在是怎麼看待「風魔龍」的？我很感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730210
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730210,
					"content": "不過，也不用那麼急著說給我聽——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730211
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730211,
					"content": "很久沒回這裡了，好像有些東西對我的到來很不滿呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		},
		{
			"id": 37304,
			"completionStepIds": [
				37304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37304",
							"2"
						],
						"stepId": 37304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3730401,
					"content": "呼…風向的變化，影響的不止是龍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730402
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730402,
					"content": "#對了，剛才{F#妳}{M#你}說，有人告訴{F#妳}{M#你}龍的過往？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730405,
					"content": "…是嗎？那位叫做麗莎的蒙德學者，是這樣看待這件事的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730406
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730406,
					"content": "沒錯，衝突到了這一步，當然是因為雙方都已經開始動用武力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730407
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730407,
					"content": "但牠最初的憎恨，絕對不是因為人們不再祭祀「四風守護」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730408
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730408,
					"content": "…那不是自然誕生的恨，而是腐蝕之後的產物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730409
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730409,
					"content": "腐……腐蝕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3730410,
					"content": "是流入心臟的黑血折磨著牠，令牠多年的沉睡不得安寧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730411
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730412,
					"content": "深淵法師？沒聽過的名字…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730413
					]
				},
				{
					"id": 3730414,
					"content": "我好像在蒙德聽過這個詞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730415
					]
				},
				{
					"id": 3730411,
					"content": "所以這一次醒來，牠的精神才會被「深淵法師」的詛咒腐蝕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730412,
						3730414
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730413,
					"content": "非人之物組成的深淵教團，是與人類為敵的組織。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730415,
					"content": "沒錯，非人之物組成的深淵教團，是與人類為敵的組織。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730416
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730416,
					"content": "我不知道它們的來歷，只知道它們對人類世界懷有極深的惡意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730417
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730417,
					"content": "荒野上的那些丘丘人，也會聽從它們的指揮、成為它們的武器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730418
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730418,
					"content": "來這裡前，我也和特瓦林一樣，被詛咒腐蝕著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730419
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730419,
					"content": "不過現在我們所在的位置，正是「英雄的象徵」、今日蒙德一切的源流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730420
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730420,
					"content": "樹間的風很好，有我喜歡的氣味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730421
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730421,
					"content": "#與{F#妳}{M#你}一起待在樹蔭下，就能像剛才淨化龍淚一樣，驅除我身體裡的毒素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730422
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730423,
					"content": "啊…感覺好多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730424
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730424,
					"content": "所以，你當初又是怎麼中毒的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3730425,
					"content": "這個嘛，是因為我之前試圖與特瓦林交流，但卻被…嗯…打斷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730426
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730427,
					"content": "呃，那個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730428,
					"content": "所以是我…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3730429
					]
				},
				{
					"id": 3730426,
					"content": "結果不僅沒能為特瓦林驅除詛咒，自己反而被「深淵」的毒性侵蝕啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730427,
						3730428
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730429,
					"content": "沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730430
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730431,
					"content": "#所以作為賠罪——{NICKNAME}，就跟我一起去蒙德大教堂吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730432
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3730432,
					"content": "蒙德大教堂？要去那裡做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3730433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3730433,
					"content": "去取一把…叫做「天空」的豎琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		}
	]
}