	"talks": [
		{
			"id": 37302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"37302",
							"2"
						],
						"stepId": 37302,
						"stateName": "QUEST_STATE_UNFINISHED"
