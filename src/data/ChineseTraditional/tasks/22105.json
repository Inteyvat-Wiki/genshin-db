			"dialogs": [
				{
					"id": 221050101,
					"content": "真煩人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050102
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221050102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050103
					]
				},
				{
					"id": 221050103,
					"content": "我總感覺這客棧周圍怪怪的，又說不出來個所以然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050104
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221050104,
					"content": "而且我們這客棧裡，又都是住著些格外敏感的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050105
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221050105,
					"content": "一有什麼風吹草動，門窗總會掉幾扇，說不定樓板都要破幾塊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050106
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221050106,
					"content": "雖然客人們都會自己出錢修，但是這東一塊西一塊的，太難看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050107
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221050107,
					"content": "您能幫我去客棧周圍看看嗎？有什麼怪地方，就…處理一下，我還要在這接待客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050108,
						221050109
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221050108,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050110
					]
				},
				{
					"id": 221050110,
					"content": "那就拜託您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221050109,
					"content": "這些客人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221050111
					]
				},
				{
					"id": 221050111,
					"content": "客人？哎呀，不用在意，長年在野外摸爬滾打的人，免不了過度敏感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221050112
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 221050112,
					"content": "那麼就拜託您了，就是去周圍看看，應該也不會出什麼事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				}
			]
		},
