			"dialogs": [
				{
					"id": 760840101,
					"content": "#{F#妳}{M#你}們來了？今天月靈們又在玩琴，能像上次一樣彈一首給它們聽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760840102,
					"content": "我正好也想聽些不一樣的曲調。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760840103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760840103,
					"content": "（彈什麼好呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7608402,
			"completionStepIds": [],
