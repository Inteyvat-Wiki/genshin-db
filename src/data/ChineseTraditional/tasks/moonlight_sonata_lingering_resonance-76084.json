				]
			},
			"dialogs": [
				{
					"id": 760840201,
					"content": "演奏哥倫比婭常哼的歌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202
					]
				},
				{
					"id": 760490202,
					"content": "演奏哥倫比婭常哼的歌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "（以什麼樣的情緒演奏呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "平和的樂調…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "#好聽。我平時哼的旋律，原來{F#妳}{M#你}都記下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490605,
					"content": "嘿嘿，因為妳唱歌很好聽嘛，我們有時會悄悄在旁邊聽上一會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490606,
					"content": "月靈們也聽得入迷了，不知道它們有沒有學會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490607,
					"content": "#說不定，以後還得多請{F#妳}{M#你}們教幾次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490608,
					"content": "來吧，把手給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490609,
					"content": "欸？我們這是無償演出，不用收學費的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490610,
					"content": "嗯？學費？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490611,
					"content": "我只是覺得，好聽的旋律應該有美麗的月光相伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490701,
					"content": "愉快的樂調…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "結束了？感覺都還沒聽夠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490703,
					"content": "我曾說過這是我唯一記得的「搖籃曲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490704,
					"content": "#儘管還沒找到其中的意義，但聽{F#妳}{M#你}彈過之後，我開始覺得在月亮上等待著我的那個答案，至少是美好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490705,
					"content": "來，把手給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490706,
					"content": "這次就不用回報啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490707,
					"content": "不，我只是想為這旋律添上一束美好的月光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
