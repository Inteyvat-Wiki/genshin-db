			"trigger": {
				"objectNames": [
					"珊瑚",
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190602901,
					"content": "#旅行者，我相信{F#妳}{M#你}一定能查出真相，絕對是鹿野院在搞鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602902
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 190602902,
					"content": "唉…明明社長和平藏先生都是很好的人，怎麼碰到一起就要壞事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190602903
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 190602903,
					"content": "龍二，麻煩你成熟一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				}
			]
		},
