			},
			"dialogs": [
				{
					"id": 190603101,
					"content": "#上杉那小子的話，{F#妳}{M#你}們聽聽就算了，可別當真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603102
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 190603102,
					"content": "關於鷹司勇與龍二…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603103
					]
				},
				{
					"id": 190603103,
					"content": "#{F#妳}{M#你}問這個啊？真要說這個的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603104
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 190603104,
					"content": "龍二把鷹司勇當作義父是板上釘釘的，但鷹司勇把龍二從垃圾堆裡撈出來，幾分為情，幾分為利，我不好說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603105
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 190603105,
					"content": "畢竟鷹司勇也不是什麼簡單角色，遇到龍二這種單純又天真的傢伙，拿他當個幕僚不行，當個心腹，當條忠犬，綽綽有餘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603106
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 190603106,
					"content": "而且鷹司勇後來自己也是有孩子的，只是很可惜，還沒出世鷹司勇就遇害了，連孩子的面都沒見上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603107
					],
					"speakerTitle": "大和田"
				},
				{
					"id": 190603107,
					"content": "#哎，不說這個了，{F#妳}{M#你}們不是要去查案嗎？快去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大和田"
				}
			]
		},
