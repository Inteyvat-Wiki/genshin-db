			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"上杉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 190603001,
					"content": "#嗨，旅行者，查案很頭痛吧，{F#妳}{M#你}們聽我的準沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603002
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603002,
					"content": "關於珊瑚社長…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603003
					]
				},
				{
					"id": 190603003,
					"content": "#哎呀！{F#妳}{M#你}說這個珊瑚社長，鷹司家真是請了個了不起的偵探啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603004
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603004,
					"content": "隔三差五她就跑來提交申請，要重查「龍二案」，但每次都被平藏前輩擋了回去，沒想到這次居然去寫投訴信了，真厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603005
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603005,
					"content": "至於平藏前輩為什麼不讓，大概是怕珊瑚社長遇到危險吧，畢竟這是個大人物的命案，水很深呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603006
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603006,
					"content": "珊瑚雖然是偵探社的社長，但說到底也只是個普通人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603007
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603007,
					"content": "他們關係很好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						190603008
					]
				},
				{
					"id": 190603008,
					"content": "唔…不算好，我看他們每次見面講話都夾槍帶棒的。不過平藏前輩應該還是念及舊情吧，聽說他以前和珊瑚一起工作的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603009
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603009,
					"content": "他有時會吩咐我，把一些無關緊要的案件交給偵探社去做，我猜是想讓他們多點收入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						190603010
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 190603010,
					"content": "嗯，平藏前輩是很好的人，這點毋庸置疑。",
					"roleType": "TALK_ROLE_NPC",
