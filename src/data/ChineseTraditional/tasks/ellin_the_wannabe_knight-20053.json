			},
			"dialogs": [
				{
					"id": 200530101,
					"content": "傷腦筋…這裡要怎麼解決啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530102
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530102,
					"content": "妳在做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530103
					]
				},
				{
					"id": 200530103,
					"content": "為了下一次的騎士選拔，我正在訓練呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530104
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530104,
					"content": "唔…不過，我可沒有琴大人那樣的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530105
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530105,
					"content": "比起鍛煉「力量」，我覺得學習「技巧」更適合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530106
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530106,
					"content": "比如，一口氣把這些木樁全部破壞掉的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530107
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530107,
					"content": "#{F#妳}{M#你}有空的話，也和我一起來想一想吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530108,
						200530109
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530108,
					"content": "我想一想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530110
					]
				},
				{
					"id": 200530110,
					"content": "沒關係，好好想喔，木樁不會自己跑掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530111
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530111,
					"content": "唯一會自己跑掉的只有被消耗的時間和生命，唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530114,
					"content": "這種距離，自己對付一邊，丟個炸彈炸掉另外一邊就是最好的選擇啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530115
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530115,
					"content": "哈哈哈我開玩笑的，炸彈這種東西，怎麼可能這麼輕鬆找到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530109,
					"content": "我們兩個一起上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200530112
					]
				},
				{
					"id": 200530112,
					"content": "#{F#妳}{M#你}習慣團體作戰嗎？真羡慕啊…隨時都能叫到幫手的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530113
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200530113,
					"content": "像我這樣的，只能學習獨自作戰啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200530114
					],
					"speakerTitle": "艾琳"
				}
			]
		},
