							154.182,
							170.359,
							413.867
						],
						"pointId": 18
					}
				]
			},
			"dialogs": [
				{
					"id": 760950301,
					"content": "伊斯托利亞，現在三個區域基本上都解放了，人也差不多都救出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950302,
					"content": "彩特琳德丟失的東西也都找回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950303,
					"content": "#哦哦，太謝謝{F#妳}{M#你}們了。尼西里塔開眼之後的眼光真是不錯啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950304
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950304,
					"content": "現在該你說一說，之前提到的去往上面的方法和代價了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950305,
					"content": "如果只是再來一些小冒險或者花點小摩拉什麼的，我派蒙是不怕的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950306,
					"content": "還有哦，我們要怎麼把彩特琳德送下去啊？她的事情已經忙完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950307,
					"content": "#沒問題，不過{F#妳}{M#你}們先休息一下吧。明天我會和{F#妳}{M#你}們詳細解釋的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950308
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950308,
					"content": "那好啊——可是這裡沒有床也沒有吃的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950309,
					"content": "在這裡欲望是止息的。妳發現了嗎？在這裡這麼久了妳既不餓也不睏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950310
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950310,
					"content": "哇，那我休息一天要怎麼打發時間啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950311,
					"content": "這裡有縱貫歷史的各種奇人異士，和他們聊天應該滿有趣的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950312
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950312,
					"content": "#那好吧。但是睡覺是我的基本權利，就算不想睡我也要趴在{NICKNAME}頭上睡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950313,
					"content": "彩特琳德，等妳休息好了，我想和妳談談——就是我之前說需要時間想想的那件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950314
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950314,
					"content": "妳晚一點來找我聊聊，好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950315
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950315,
					"content": "好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950316
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950316,
					"content": "#{NICKNAME}和派蒙，{F#妳}{M#你}們休息好了的話，過來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯托利亞"
				}
			]
		},
