					}
				]
			},
			"dialogs": [
				{
					"id": 760950501,
					"content": "休息好了嗎？有興趣的人、有興趣的話都聊過了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950502,
						760950504
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950502,
					"content": "還沒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950503
					]
				},
				{
					"id": 760950503,
					"content": "好好休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950506,
					"content": "彩特琳德，妳冷靜一點聽我說。我沒有任何不尊重或者妄想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950507
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950507,
					"content": "妳的姐姐應該沒有死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950508
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950508,
					"content": "我都見到墓碑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950509
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950509,
					"content": "墓碑上甚至還有姐姐的照片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950510
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950510,
					"content": "但是，墓碑下面也有可能是空的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950511
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950511,
					"content": "雖然我也很希望彩特琳德姐姐沒事，但是你這個猜測有點過於樂觀了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950512,
					"content": "我姐姐最後給我的信上寫了，她決心要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950513
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950513,
					"content": "她的告別，寫的一定不是她準備結束生命吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950514
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950514,
					"content": "她說她要去很遠的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950515
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950515,
					"content": "她和我說過，她的理想是在老去之前環遊世界一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950516
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950516,
					"content": "希爾妲只是字面意思。她從療養院離開，去環遊世界了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950517
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950517,
					"content": "她還和你說過這些啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950518
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950518,
					"content": "她一直很開朗，和大家相處得很愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950519
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950519,
					"content": "那她一定沒有和你說過，我們沒有別的親人了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950520
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950520,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950521
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950521,
					"content": "我用最冷血的方式算算這件事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950522
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950522,
					"content": "她的離開如果會讓三、四個人傷心，那這份沉重或許會贏過她的哀愁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950523
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950523,
					"content": "但是現在只剩下了我。而她知道我理解她，我會原諒她的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950524
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950524,
					"content": "不是這樣的，不能這麼算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950525
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950525,
					"content": "不用那麼憐憫。在我們的童年中，父母都還在，生活很幸福的。這些回憶足以支撐我們長大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950526
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950526,
					"content": "可是，大人的世界，好艱難啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950527
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950527,
					"content": "我從小就更加內向，工作裡與人打交道都格外耗費心神，我本以為外向的姐姐會如魚得水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950528
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950528,
					"content": "姐姐長大以後，臉上也常年掛著疲憊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950529
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950529,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950530,
					"content": "妳們還有未來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950531
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950531,
					"content": "哦，看來她也沒有和你說她未婚夫的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950532
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950532,
					"content": "一個普通的好人，一個有趣的好人——他為什麼不是一個壞蛋呢？要是他是一個惡人就好了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950533
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950533,
					"content": "他家裡有著短壽的遺傳，好像是某種怪病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950534
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950534,
					"content": "他也總是自嘲都怪風神把蒙德規劃得太好了，他家這種不應該延續的血脈都延續了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950535
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950535,
					"content": "後來，他說他要去拯救世界，然後就走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950536
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950536,
					"content": "拯救世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950537
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950537,
					"content": "我們的世界現在還在運轉，說不定真的是因為他在某個不起眼的角落拯救了世界吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950538
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950538,
					"content": "你們不是常說「永恆的生命如果不能去愛所有人，然後被所有人愛，世界會被悲哀淹沒」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950539
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950539,
					"content": "說得很有道理。短暫的生命就是不配去愛的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950540
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950540,
					"content": "他想要用自己的生命去愛，結果只是讓姐姐受傷更深。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950541
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950541,
					"content": "甚至讓她住進了山裡的療養院。我們腳下這個，縈繞著詛咒的療養院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950542
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950542,
					"content": "她從沒有和我說過這些。對不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950543
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950543,
					"content": "聽了這些，你還要堅持姐姐依舊活著的論點嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950544
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950544,
					"content": "是的。因為她在這裡，做了一件事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950545
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950545,
					"content": "因為我的怯懦，她不得不活下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950546
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950546,
					"content": "我很敬重您，伊斯托利亞。但是我覺得，或許你在歷史長河裡見過的苦難太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950547
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950547,
					"content": "足以淹沒世界好多次的悲傷之沙，只要一抔就可以蓋住平凡如我的人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950548
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950548,
					"content": "您無法理解我和姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950549
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950549,
					"content": "請問，我該如何回到地上呢？我只是朝生暮死的小人物，不配得到永恆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950550
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950550,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950551
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950551,
					"content": "伊斯托利亞先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950552
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950552,
					"content": "原先此處天地不通，我們是絕無可能離開的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950553
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950553,
					"content": "#但尼西里塔墮天之後，小右似乎有能力帶{F#妳}{M#你}們現世之人來往柱殿與地面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950554
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950554,
					"content": "但是它是無法帶走蒙選上來的人，因為它就是守望者的幼體。這是深埋在它體內的規則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950555
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950555,
					"content": "什麼？小右居然和尼西里塔是同一種東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950556
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950556,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950557
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950557,
					"content": "我們想要下去，只有放棄自己的一切記憶和知識，登上最高處。以前是去覲見女主人，如今是覲見梅蘭塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950558
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950558,
					"content": "#所以我是沒辦法和{F#妳}{M#你}們一起下去啦。請讓我送送{F#妳}{M#你}們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 760950504,
					"content": "已經好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760950505
					]
				},
				{
					"id": 760950505,
					"content": "那好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950506
					],
					"speakerTitle": "伊斯托利亞"
				}
			]
		},
