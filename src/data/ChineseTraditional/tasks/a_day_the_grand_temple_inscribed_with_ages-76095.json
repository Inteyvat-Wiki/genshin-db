						"pointId": 266
					}
				]
			},
			"dialogs": [
				{
					"id": 760950101,
					"content": "#{NICKNAME}、派蒙，謝謝{F#妳}{M#你}們。在最後認識{F#妳}{M#你}們真幸運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950102
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950102,
					"content": "嘿嘿，沒有啦。感覺妳還是因為和我們在一起才捲進這些事情裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950103,
					"content": "等等，什麼叫最後？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950104,
					"content": "雖然都是一些高危險性的冒險，不過見識到了很多神奇的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950105
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950105,
					"content": "也不賴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950106
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 760950106,
					"content": "彩特琳德妳不要避重就輕啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760950107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760950107,
					"content": "有嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彩特琳德"
				}
			]
		},
		{
