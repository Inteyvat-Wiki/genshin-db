			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麗莎"
				],
				"points": [
					{
						"sceneId": 51203,
						"position": [
							2191.695,
							230.219,
							-780.41
						],
						"pointId": 1
