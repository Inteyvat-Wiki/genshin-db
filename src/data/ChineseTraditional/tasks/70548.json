					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480101,
					"content": "啊呀，看樣子，赫塔回去忙了，格蘭菲狄也不在…飲品小站完全由小可愛接管了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480102,
						705480103
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480102,
					"content": "沒錯，正是在下！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				},
				{
					"id": 705480104,
					"content": "好啊，我可以放心點餐啦~而不用擔心…喝到後勤小隊的神奇特調，整夜翻來覆去，完全沒有睡意，只好熬夜工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480105,
						705480106
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480105,
					"content": "熬夜工作都是過去式了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480107,
					"content": "沒錯哦，現在的我只是一個清閒的圖書管理員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480108
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480108,
					"content": "#要是借閱逾期的人再少一點，不用我費心費力去上門追回，我就能早點來和小可愛閒聊，多試試{F#妳}{M#你}的傑作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480109,
						705480110
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480109,
					"content": "那，今天想喝點什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480111,
					"content": "我想想哦…我沒有特別偏愛的配方，請給我一杯恢復元氣、改善心情的特調。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480112
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480112,
					"content": "能讓我以鬆弛、閒適的狀態入睡，就再好不過啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480113
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480113,
					"content": "（飲品小站已經有很多經典配方了，先從這些裡面選一種吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480114
					]
				},
				{
					"id": 705480114,
					"content": "（麗莎想要恢復元氣，「雪韻晨暉」似乎是個不錯的選擇…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 705480110,
					"content": "有什麼特別的口味要求嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480111
					]
				},
				{
					"id": 705480106,
					"content": "麗莎現在應該不會這麼忙了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480107
					]
				},
				{
					"id": 705480103,
					"content": "榮譽調飲師為您效勞！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480104
					]
				}
			]
		},
		{
			"id": 7054802,
			"completionStepIds": [
				7054806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
