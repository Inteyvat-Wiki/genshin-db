				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麗莎"
				],
				"points": [
					{
						"sceneId": 51203,
						"position": [
							2191.695,
							230.219,
							-780.41
						],
						"pointId": 1
					},
					{
						"sceneId": 51203,
						"position": [
							2194.736,
							230.089,
							-781.087
						],
						"pointId": 2
					}
				]
			},
			"dialogs": [
				{
					"id": 705480201,
					"content": "這杯是「雪韻晨暉」，請慢用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480202
					]
				},
				{
					"id": 705480202,
					"content": "真不錯，小可愛~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480203
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480203,
					"content": "酸度適中，甜而不膩，入口溫潤，回甘輕快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480204
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480204,
					"content": "不過，我覺得喝完這杯特調後，好像更有精神了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480205
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480205,
					"content": "#說不定…{F#妳}{M#你}在冥冥之中破解了格蘭菲狄的秘密，調出了比她更厲害的提神飲品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480206,
						705480207
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480206,
					"content": "還是調整一下飲品裡的成分？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480208
					]
				},
				{
					"id": 705480208,
					"content": "#沒關係，不用著急~{F#妳}{M#你}的眼神裡充滿好奇，好像還有許多想問我的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480209
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480209,
					"content": "#我們聊聊天，{F#妳}{M#你}慢慢想一想，很快就有靈感啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480210
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480210,
					"content": "今天麗莎追回了哪些書？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480211
					]
				},
				{
					"id": 705480211,
					"content": "讓我有點煩惱，又有些哭笑不得的問題啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480212
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480212,
					"content": "一位剛剛出師，從楓丹來到歌德大飯店任職的廚師，借走了最貴重的那本《千年蒙德甜品全書》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480213
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480213,
					"content": "她居然想用製作甜品的方式來改良各種肉菜，減輕油膩感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480214,
						705480215
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480214,
					"content": "純甜味的肉類嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480216
					]
				},
				{
					"id": 705480216,
					"content": "是啊，從結果上看，她有些濫用焦糖醬，反而讓本該香氣撲鼻的肉片甜得發慌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480217
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480217,
					"content": "焦糖醬明明是個好孩子，加入各種飲品都不可能讓人反感的。有時，我也會在下午茶裡加上一小匙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480218
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480218,
					"content": "這麼看來，改進料理，不是越有創意就越好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480219
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480219,
					"content": "麗莎好像還帶了一本筆記本來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480220
					]
				},
				{
					"id": 705480220,
					"content": "哦，這是今天另一項工作的見證者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480221
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480221,
					"content": "再過不久，遠征隊的許多成員就要陸續返回蒙德了，他們長期在外活動，口味可能發生變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480222
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480222,
					"content": "為了進口一批新食材滿足這些騎士變化後的習慣，琴拜託我走訪了十來戶代表性的家庭，做了幾項調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480223,
						705480224
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480223,
					"content": "好細緻的計畫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480225
					]
				},
				{
					"id": 705480225,
					"content": "嗯，他們都為蒙德付出了勞苦、時間和血汗，值得大家用尊重和關照回報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480226
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480226,
					"content": "調查結果中，被提及次數最多的食材就是納塔的苦種，以及用這種奇特植物製作出來的可可了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480227
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480227,
					"content": "許多騎士在信件中提到他們習慣用可可讓自己保持精力充沛，我也試過可可熱飲，感覺提神的效果不輸咖啡呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480228
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480228,
					"content": "最近還去了什麼別的地方嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480229
					]
				},
				{
					"id": 705480229,
					"content": "#是說藉機在外逛逛嗎？被{F#妳}{M#你}猜到啦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480230
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480230,
					"content": "為了調查蒙德現有的冷門飲品，我去了一趟晨曦酒莊，和愛德琳女僕長聊了一下天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480231
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480231,
					"content": "返程的路上，還遇到了一位巡邏的小騎士艾瑪托，她遇見了不知怎麼對付的魔物，慌慌張張向我求援。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480232
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480232,
					"content": "我就陪她繞道奔狼領，好好教訓了那幾隻暴躁的獵犬…難得這樣活動筋骨，很暢快哦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480233
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480233,
					"content": "麗莎最近喜歡什麼植物呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480234
					]
				},
				{
					"id": 705480234,
					"content": "哦？小可愛的用詞很謹慎嘛，加上了「最近」這個限定詞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480235
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480235,
					"content": "是考慮到一段時間沒見，我也會有變化…還是對以前的事記不太清楚了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480236,
						705480237
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480236,
					"content": "畢竟麗莎見多識廣、博學多聞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480238
					]
				},
				{
					"id": 705480238,
					"content": "不錯嘛，回答得滴水不漏~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480239
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480239,
					"content": "在學生時期，我可能會被書本上的新奇植物吸引，不斷開拓見聞、跳出舒適圈，但現在我已經習慣了安穩和規律。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480240
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480240,
					"content": "借用一位璃月律法專家的比喻——我的生活快要接近「頤養天年」的狀態啦，不再是個善變的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480241
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480241,
					"content": "#所以，{F#妳}{M#你}肯定還記得幾年前一起冒險的時候，{F#妳}{M#你}就為我找來了一種清甜的煉金材料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480242
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480242,
					"content": "我的喜好一直沒變過哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705480243
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480243,
					"content": "好，我已經拿定主意了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480244
					]
				},
				{
					"id": 705480244,
					"content": "讓我為妳準備一款改良的特調吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705480245
					]
				},
				{
					"id": 705480245,
					"content": "果然，小可愛的聰穎才智又進步了，只需要稍微提醒一下，就能抓住靈感~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麗莎"
				},
				{
					"id": 705480237,
					"content": "偶爾有些新興趣，很合理吧？",
