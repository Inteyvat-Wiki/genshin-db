			},
			"dialogs": [
				{
					"id": 751080101,
					"content": "說是要做料理，不過要選哪種料理才好啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080102,
					"content": "我記得以前我們餵過魚肉給膨膨獸「嗚嗚葡萄」，那魚料理應該很不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080103,
					"content": "#要讓膨膨獸和{REALNAME[ID(2)|SHOWHOST(true)]}吃得開心…感覺納塔特色的「薄荷醬烤魚」很不錯呦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080104,
						751080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080104,
					"content": "這個我拿手。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				},
				{
					"id": 751080106,
					"content": "#好，那就開工吧！我也會在一邊替{F#妳}{M#你}出主意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080107,
						751080109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080107,
					"content": "花刀切深一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080108
					]
				},
				{
					"id": 751080108,
					"content": "支持，深一點更容易入味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080111,
					"content": "鹹一點，吃得更開心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080112
					]
				},
				{
					"id": 751080112,
					"content": "#嗯，剛進嘴巴的那種厚實滋味，膨膨獸和{REALNAME[ID(2)|SHOWHOST(true)]}應該都喜歡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080115,
					"content": "薄荷醬，多多益善。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080116
					]
				},
				{
					"id": 751080116,
					"content": "清清涼涼的口感，一定很不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080119,
					"content": "辣椒，必不可少。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080120
					]
				},
				{
					"id": 751080120,
					"content": "適當的辣味，一點點就開胃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080123,
					"content": "猛火強烤，外酥內嫩！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080124
					]
				},
				{
					"id": 751080124,
					"content": "嘿嘿，聽起來太香，我都要流口水了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080127,
					"content": "#經過一段精彩的烹飪過程，為膨膨獸和{REALNAME[ID(2)|SHOWHOST(true)]}特製的烤魚完成了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751080125,
					"content": "文火慢烤，香軟多汁！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080126
					]
				},
				{
					"id": 751080126,
					"content": "#嗚哇，真不錯，{NICKNAME}獨門秘技之烤魚…以後說不定可以當成拿手料理做給其他朋友吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080121,
					"content": "楓丹生物有可能怕辣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080122
					]
				},
				{
					"id": 751080122,
					"content": "可是完全沒有辣椒的話好像缺了一點什麼，我們就少放一點吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080123,
						751080125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080117,
					"content": "水裡的膨膨獸會怕薄荷的清涼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080118
					]
				},
				{
					"id": 751080118,
					"content": "好像不是這樣講喔？水裡的膨膨獸上岸應該會很乾很熱，加一點薄荷醬反而能讓牠降溫吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080119,
						751080121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080113,
					"content": "味道夠就無需多鹽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080114
					]
				},
				{
					"id": 751080114,
					"content": "沒錯，之後還會加其他調味料，不一定要放很多鹽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080115,
						751080117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080109,
					"content": "花刀切淺一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080110
					]
				},
				{
					"id": 751080110,
					"content": "也不錯，說不定味道稍微淡一點，裡面保留一部分魚肉的原味，膨膨獸會吃得更習慣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751080111,
						751080113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751080105,
					"content": "不是很熟練，但沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751080106
					]
				}
			]
		},
