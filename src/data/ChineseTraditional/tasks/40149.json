						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490201,
					"content": "…好香，鹹味跟鮮味都恰到好處，每一粒米都有味道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490202
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490202,
					"content": "剛出鍋時恰到好處的熱氣，也很讓人懷念呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490203
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490203,
					"content": "哼哼，能夠讓「騎士團最好的軍糧」都相形見絀…報上名吧，這道菜叫什麼名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490204
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401490204,
					"content": "叫…叫——總不能真的叫「隨便做點」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490205,
					"content": "…連名字都沒有，用料跟做法也很普通，根本不知道從哪裡開始介紹啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490206,
					"content": "用料和做法都很普通嗎？我還以為一定是用了什麼特別的食材，或者特別的手法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490207,
						401490208
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490207,
					"content": "這不是「最美味」的菜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490208,
					"content": "而是我認為「最適合」的菜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490209
					]
				},
				{
					"id": 401490209,
					"content": "不是「最美味」，而是「最適合」…是、是什麼意思啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490210,
						401490211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490210,
					"content": "你們趕了很久的路…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490211,
					"content": "又吃了很久的口糧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490212
					]
				},
				{
					"id": 401490212,
					"content": "是因為餓了，所以覺得特別好吃嗎？好像也不完全是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490213
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490213,
					"content": "…也是因為一直在吃冷掉的口糧，所以難免會懷念大火烹飪出的香味吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490214
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401490214,
					"content": "啊，這是叫「鍋氣」嗎？我好像聽說過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490215
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490215,
					"content": "是啊，聞著香氣，就像回到「獵鹿人」餐館一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490216
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490216,
					"content": "欸？像回「獵鹿人」餐館的話，不就沒有來吃璃月菜的意義了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490217,
					"content": "不是說味道啦，是說…這種安心的感覺？就像回到老家一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490218
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490218,
					"content": "安心…老家…難道這就是言笑說的「賓至如歸」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490219,
					"content": "世上沒有絕對的「美味」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490220
					]
				},
				{
					"id": 401490220,
					"content": "每個人都有各自的偏好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490221
					]
				},
				{
					"id": 401490221,
					"content": "但廚師為了每個客人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490222
					]
				},
				{
					"id": 401490222,
					"content": "設身處地著想的心意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490229,
					"content": "…卻都是相似的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490223
					]
				},
				{
					"id": 401490223,
					"content": "所以這道菜的秘密調味料…就是「心意」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490224
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490224,
					"content": "雖然聽起來像是什麼老掉牙的論調…不過吃完這頓飯，的確像這麼回事。不錯，這個配方，我記住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490225
					],
					"speakerTitle": "優菈"
				},
