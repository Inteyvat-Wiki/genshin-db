							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401490101,
					"content": "時間過得可真快啊…我這手也好得差不多了，明天開始應該就能重新掌勺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401490102,
					"content": "#這陣子真是辛苦{F#妳}{M#你}了，{NICKNAME}。但願這最後一天，也能安安穩穩地度過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490103
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401490103,
					"content": "呃…你這話一說，我就感覺又有事要發生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490104,
					"content": "一日無事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401490105
					]
				},
				{
					"id": 401490105,
					"content": "呼——普普通通地到晚上了呢…結果真的沒出什麼差錯…嗯，一定是因為我們已經完全熟練了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490106,
					"content": "記得第一天上工的時候，連加鹽加辣都要記個半天…現在不管發生什麼，都只是「小菜一碟」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490107,
						401490108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490107,
					"content": "話不要說那麼早…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				},
				{
					"id": 401490109,
					"content": "都這個時候了，不會再有人了吧？呃…不對，第一天林尼他們來的時候，好像也是這個時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490110,
					"content": "#{NICKNAME}？派蒙？好久不見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490111,
					"content": "安柏？還有優菈和米卡！你們是來吃飯的嗎？怎麼這麼晚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490112,
					"content": "我們剛完成了護衛商隊的任務，還在返回石門的路上。雖然原計畫是想直接吃一些隨身口糧就繼續趕路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490113
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490113,
					"content": "不過優菈隊長說很久沒吃璃月菜了，不如順道來這間客棧，看看還能不能夠點餐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490114
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490114,
					"content": "欸？居然是優菈的提議嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490115,
					"content": "…咳！這一路過來吃的都是隨身口糧…偶爾也要換一下口味吧！怎麼了，不行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490116,
						401490117
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401490116,
					"content": "歡迎來到望舒客棧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490118,
					"content": "#來點什麼呢…嗯？等等，為什麼是{F#妳}{M#你}在招待…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490119
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401490119,
					"content": "#{NICKNAME}現在可是這家客棧的大廚哦！你們來得也很巧，剛好能夠趕上{M#他}{F#她}在這裡掌廚的最後一頓飯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490120,
					"content": "欸！是嗎？幸好優菈路上提了一下，不然就要錯過這一餐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490121,
					"content": "那要點什麼菜呢…我對璃月菜的印象也有點淡了…米卡、優菈，你們有什麼想吃的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490122
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490122,
					"content": "能夠嚐到「榮譽騎士」前輩的手藝，對我來說已經是個學習的好機會了，隨便吃什麼都好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490123
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 401490123,
					"content": "…我也隨便吃一點就好，吃完還要繼續趕路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490124
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401490124,
					"content": "不是妳提議要來的嗎？怎麼連妳也隨便了…那就看妳了安柏，隨便來點什麼條件！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490125,
					"content": "欸，那…我也「隨便」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401490126
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 401490126,
					"content": "喂——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401490117,
					"content": "請問要來點什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490118
					]
				},
				{
					"id": 401490108,
					"content": "今天還沒結束呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401490109
					]
				}
			]
		},
		{
