				]
			},
			"dialogs": [
				{
					"id": 401710401,
					"content": "呼~順利地走進來了，什麼都沒發生。也許茜特菈莉的陷阱真的認識我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710402,
					"content": "嗚哇！快看！那裡有個人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710403,
					"content": "嗨！你還好嗎？喂！聽得見我們說話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710404,
					"content": "似乎沒反應。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710405
					]
				},
				{
					"id": 401710405,
					"content": "睡著了嗎？還是生病了…會不會這就是歐洛倫說要救的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710406,
					"content": "這個營地也是神神秘秘的，是幹什麼的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710407,
					"content": "像是什麼儀式。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710408
					]
				},
				{
					"id": 401710408,
					"content": "唔…我們去叫歐洛倫進來吧，他肯定知道這是什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710409,
					"content": "對不起，奶奶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710410
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710410,
					"content": "翅膀硬了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710411
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710411,
					"content": "真的對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710412
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710412,
					"content": "是不是覺得自己當上了六個英雄之一，可以無法無天了？嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710413
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710413,
					"content": "給我解釋一下，臭小子，憑什麼插手那個靈性白痴的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710414
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710414,
					"content": "歐洛倫！還有茜特菈莉…哈哈…妳也來了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710415,
					"content": "#欸？欸欸欸？{F#妳}{M#你}們怎麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710416
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710416,
					"content": "#（糟糕，{M#他們}{F#她們}怎麼現在就來了，我剛才凶巴巴的樣子不會被{NICKNAME}看見了吧？哦天啊，我的形象！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710417
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710417,
					"content": "#哈哈…{F#妳}{M#你}們好啊，那什麼…剛才我和歐洛倫在玩…模仿遊戲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710418
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710418,
					"content": "就是模仿輕小說裡的人物和情節、背他們的臺詞，我說的話都不是我的本意——對吧，歐洛倫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710419
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710419,
					"content": "啊？啊…對的，對的，奶奶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710420
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710420,
					"content": "#{NICKNAME}，也對不起{F#妳}{M#你}，本來是請{F#妳}{M#你}來幫忙的，結果我卻沒有注意身後，先被奶奶抓住了，和她一起玩模仿遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710421,
						401710422,
						401710423
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710421,
					"content": "這種事就不用道歉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710425
					]
				},
				{
					"id": 401710425,
					"content": "茜特菈莉和歐洛倫，你們到底在幹什麼呀？是不是這個人出了問題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710426,
					"content": "嗯，他叫勒拉，在一次暝視中出了差錯，變成了現在這個樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710427
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710427,
					"content": "暝視是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710428
					]
				},
				{
					"id": 401710428,
					"content": "#一種操縱靈性出體，用來獲知神秘的法術，{F#妳}{M#你}有在小說裡見到過通靈這種事嗎？跟那個就很像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710429
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710429,
					"content": "而現在他的問題是，他的靈性在某處迷路了，無法返回身體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710430
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710430,
					"content": "也就是說，他只是身體在這裡，但靈魂不在了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710431,
					"content": "雖說靈魂和靈性不完全是同樣一回事，但現在可以簡單這麼理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710432
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710432,
					"content": "嗯，我就是想把勒拉失蹤的靈性找回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710433
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710433,
					"content": "哼，如果這個勒拉是一般人就罷了，我不會阻止歐洛倫。可是問題在於…勒拉是個靈性白痴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710434
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710434,
					"content": "靈性白痴又是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710435
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710435,
					"content": "就是對靈性完全沒天分的人，他們無法感知、操控靈性，更無法使用相關的法術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710436
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710436,
					"content": "#反過來，如果他們用特殊方式強行施法…後果{F#妳}{M#你}們看到了，就是這位勒拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710437
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710437,
					"content": "我們煙謎主的法術與靈性密不可分，解決問題的手段也如此，所以對靈性白痴而言一般的治療手段都沒有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710438
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710438,
					"content": "他們一旦因為施法出現問題，就幾乎等於無藥可救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710439
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710439,
					"content": "有藥可救的。只要是靈魂層面的事，我就還有辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710440
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710440,
					"content": "#聽明白了吧？{F#妳}{M#你}們應該都知道歐洛倫這小子想幹嘛了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710441
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710441,
					"content": "哦！歐洛倫，你是想用你的特殊體質…會不會對你比較危險？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710442
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710442,
					"content": "不會有事的，奶奶太操心了。我的身體基本上沒問題了，現在應該能找到安全的辦法。我想，只有這樣才能找回勒拉的靈性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710443
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710443,
					"content": "你想你想，想都別想。如果勒拉的問題有點難辦你會做到什麼程度，我還不知道嗎？我看你也是個白痴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710444
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710444,
					"content": "唔…歐洛倫的確是很會捨己為人的那種，這點讓人擔憂。但茜特菈莉也是操心的性格，真難辦啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710445,
						401710448,
						401710450
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710445,
					"content": "我支持茜特菈莉，歐洛倫是白痴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710446
					]
				},
				{
					"id": 401710446,
					"content": "#說我是白痴也無所謂，只要{F#妳}{M#你}們支持我，我就能把勒拉的靈性找回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710447
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710447,
					"content": "喂！你把奶奶我當成什麼了？什麼時候輪到孫子來撐場面了？我當然還有辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710452
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710452,
					"content": "噢？！哦？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710453
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710453,
					"content": "欸？奶奶真的還有辦法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710454
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710454,
					"content": "笨辦法也是辦法！真是會給人找麻煩，你這臭小子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710455
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710455,
					"content": "#{NICKNAME}，其實我本來就打算聯絡{F#妳}{M#你}的，因為我的辦法動靜比較大，可能需要{F#妳}{M#你}幫個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710456
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710456,
					"content": "那正好啊，歐洛倫已經把我們先找來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710457
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710457,
					"content": "沒問題，要怎麼幫忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710458
					]
				},
				{
					"id": 401710458,
					"content": "我打算從兩個方向開始，一個就是大海撈針的笨辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710459
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710459,
					"content": "我在勒拉的周圍畫下了通往夜神之國的邊界之門——就是這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710460
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710460,
					"content": "邊界之門發動後，會吸引附近所有游離的靈性，運氣好的話就能找到屬於勒拉的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710461
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710461,
					"content": "#{NICKNAME}，和之前一樣，我會把能力暫時借給{F#妳}{M#你}，與{F#妳}{M#你}共享暝視，但要依靠這個出神香爐才能實現，別忘了先用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710462
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710462,
					"content": "#放心，不會再有上次那種意外！{F#妳}{M#你}只會感覺自己到了夜神之國，能看見很多遊靈，只要把它們都集中起來就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710463
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710463,
					"content": "至於之後的分辨工作，就交給歐洛倫吧，既然他執意要管這件事，就讓他做最辛苦的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710464
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710464,
					"content": "另一個方向呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710465
					]
				},
				{
					"id": 401710465,
					"content": "利用靈性的本能聚合性質。眾所皆知，暝視一般都是為了探尋某種神秘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710466
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710466,
					"content": "如果我們能夠知道勒拉原本想知道的事，就有可能把他失散的靈性吸引過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710467
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710467,
					"content": "我會以勒拉的身體為媒介進行暝視，多少能探查出一些勒拉的所思所想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710468
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710468,
					"content": "#噢！我有點聽明白了，如果說第一個方法是網魚，第二個方法就是釣魚。就像前面歐洛倫讓{NICKNAME}用輕小說來釣妳一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710469
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710469,
					"content": "唔…派蒙，不舉這個例子也沒關係的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710470
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710470,
					"content": "蛤？之後再來收拾你們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710471
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710471,
					"content": "但是奶奶，妳真厲害，居然可以用人為媒介來進行暝視，我一直以為只能用物品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710472
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710472,
					"content": "拍馬屁也沒用。哼，一個人如果失去了靈性，剩下的不過是軀殼，和物品也沒什麼區別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710473
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710473,
					"content": "#{NICKNAME}，那邊是我的靈性織機，能記錄我暝視出的一些破碎片段，在我開始的時候，請{F#妳}{M#你}幫忙把它們拼接到織物上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710474
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710474,
					"content": "準備好了就和我說一聲，現在要開始工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710448,
					"content": "我支持歐洛倫，茜特菈莉才是白痴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710449
					]
				},
				{
					"id": 401710449,
					"content": "喂！喂！你們都把黑曜石奶奶當成什麼了？我當然也有辦法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710452
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710450,
					"content": "茜特菈莉一定還有辦法的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710451
					]
				},
				{
					"id": 401710451,
					"content": "哼哼，那是當然，不然黑曜石奶奶我在這裡幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710452
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710422,
					"content": "下次注意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710425
					]
				},
				{
					"id": 401710423,
					"content": "模仿遊戲？我也要玩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710424
					]
				},
				{
					"id": 401710424,
					"content": "現在不是玩遊戲的時候啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710425
					],
					"speakerTitle": "派蒙"
				}
			]
		},
