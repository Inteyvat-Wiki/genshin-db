				]
			},
			"dialogs": [
				{
					"id": 401710101,
					"content": "#只要{NICKNAME}出現，一切就會好起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710102
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710102,
					"content": "嘿！歐洛倫，這邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710103,
					"content": "#啊，{NICKNAME}、派蒙，{F#妳}{M#你}們好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710104
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710104,
					"content": "聽說你有事找我們，所以就立刻過來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710105,
					"content": "原來是這樣…讓我心裡很溫暖，這就是幸福的感覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710106
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710106,
					"content": "噫！幹嘛突然說這種話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710107,
					"content": "#{F#妳}{M#你}們是真正的好朋友。如果我家的蔬菜見到{F#妳}{M#你}們，一定也會長得更茂盛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710108
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710108,
					"content": "那又是什麼原理啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710109,
					"content": "#是誇獎。聽說誇獎別人會讓人快樂，{F#妳}{M#你}快樂了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710110
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710110,
					"content": "謝謝，但你好像不是很快樂？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710111
					]
				},
				{
					"id": 401710111,
					"content": "#被{F#妳}{M#你}發現了。的確，我現在就跟產蜜困難的蜜蟲一樣煩惱。奶奶堵住了我的前路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710113
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710113,
					"content": "茜特菈莉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710114
					]
				},
				{
					"id": 401710114,
					"content": "#是的，{F#妳}{M#你}們知道奶奶是個天才，天才總會堵住別人的路，讓別人絕望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710115
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710115,
					"content": "而我又是她的孫子，她讓別人有多絕望，在我這個孫子身上都是要加倍的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710116
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710116,
					"content": "#應該說得很嚴重了吧？嗯，所以，請{F#妳}{M#你}們幫忙搞定奶奶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710117
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710117,
					"content": "你經歷了什麼啊？說得這麼嚴重，到底是怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710118,
					"content": "#我需要拉攏{F#妳}{M#你}們，畢竟…能搞定奶奶的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710119,
						401710121
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710119,
					"content": "那個人就是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710120
					]
				},
				{
					"id": 401710120,
					"content": "#沒錯，我也是第一個就想到了{M#爺爺}{F#奶奶}{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710123
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710123,
					"content": "#{M#爺爺}{F#奶奶}，最開始見面的時候，我就是這樣叫{F#妳}{M#你}的。雖然被批評了，但請允許我再叫一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710124
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710124,
					"content": "#{F#妳}{M#你}給人的感覺不太一樣，茜特菈莉奶奶對{F#妳}{M#你}的態度也不一樣，後來的事情也證明了這兩點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710125
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710125,
					"content": "#我想，如果翻開名為《搞定茜特菈莉的四十人》的織卷，排在首位的就會是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710126
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710126,
					"content": "那後面不是還有三十九個嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710127,
					"content": "#後面的也是{NICKNAME}，三十九個{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710128,
						401710130
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710128,
					"content": "就算你這樣講，我也還不想認孫子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710129
					]
				},
				{
					"id": 401710129,
					"content": "拜託了，請幫幫我，真的很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710132
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710132,
					"content": "我只是看起來無所事事，其實我在為前路感到煩惱，奶奶她成了攔路虎，讓我無路可走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710133
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710133,
					"content": "#但現在{F#妳}{M#你}們到了，就可以開始行動起來了，時間不會一直等著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710134
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710134,
					"content": "那我要怎麼幫你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710135
					]
				},
				{
					"id": 401710135,
					"content": "#{F#妳}{M#你}肯定知道奶奶喜歡看輕小說、喝悶酒、睡大覺，如果是{F#妳}{M#你}，一定可以對症下藥，把她引走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710136
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710136,
					"content": "所以就是要我們像釣魚那樣釣走茜特菈莉，這樣她就沒空管你了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710137,
					"content": "#是的。我當然沒有閒著，去做了不少功課，說辭我也準備了一些。{F#妳}{M#你}們可以走到奶奶面前說：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710138
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710138,
					"content": "「親愛的奶奶，我有一本《蜃樓戰記》最新卷，還有一本《奧西茲小姐事件簿》特別番外篇，要來一起看看嗎？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710139
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710139,
					"content": "#她就會假矜持幾句，然後馬上給自己找臺階下，滿口答應。{NICKNAME}，如果是{F#妳}{M#你}丟的誘餌，奶奶一定會上鉤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710140
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710140,
					"content": "可是我真的有這種功效嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710141
					]
				},
				{
					"id": 401710141,
					"content": "是場面話啦！連我都聽出來了，歐洛倫說的都是好聽的場面話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710142,
					"content": "#不對。奶奶嘴上不說而已，我能看得出來，她有在在意{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710143
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710143,
					"content": "好吧…雖然我還是覺得歐洛倫在病急亂投醫，但如果只是和茜特菈莉說幾句話什麼的，倒也沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710144,
					"content": "簡直就像幫蔬菜澆水一樣輕鬆，如果我家的蔬菜在這裡…啊…抱歉，沒時間再講蔬菜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710145
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710145,
					"content": "#請相信我，跟我來一趟吧，只要{NICKNAME}出現，一切就會好起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710130,
					"content": "#乖孫，{M#爺爺}{F#奶奶}我啊，已經心花怒放了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710131
					]
				},
				{
					"id": 401710131,
					"content": "#好的，那{M#爺爺}{F#奶奶}{F#妳}{M#你}一定願意幫忙了吧？這真的很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710132
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710121,
					"content": "哈哈，不可能是我吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710122
					]
				},
				{
					"id": 401710122,
					"content": "#就是{F#妳}{M#你}，我第一個就想到了{M#爺爺}{F#奶奶}{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710123
					],
					"speakerTitle": "歐洛倫"
				}
			]
		},
		{
