			"dialogs": [
				{
					"id": 401710201,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710202
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710202,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710203,
					"content": "奶奶…居然不見了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710204
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710204,
					"content": "她原本就站在那個洞口，防止我進去。我的前路就是這樣被阻斷的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710205
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710205,
					"content": "原來是字面意義上的攔路虎啊！我還以為這也是比喻呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710206,
					"content": "奶奶說一個段落比喻兩次的輕小說是二流，我不想變成二流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710207
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710207,
					"content": "喂，你把自己比成輕小說了吧？這是第二次比喻了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710208,
					"content": "什麼？糟糕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710209
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710209,
					"content": "總之，現在歐洛倫應該暢行無阻了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710210
					]
				},
				{
					"id": 401710210,
					"content": "對喔，看來茜特菈莉已經想通了。歐洛倫，不管想幹什麼，你都可以大展身手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710211,
					"content": "我覺得沒那麼簡單…奶奶不會這麼輕易放棄抓我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710212
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710212,
					"content": "也許我一走進去洞裡，就會被奶奶的監視法術發現，又或者踩中她留下的陷阱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710213
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710213,
					"content": "可是她幹嘛要抓你啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710214
					]
				},
				{
					"id": 401710214,
					"content": "是啊，甚至還佈置了陷阱！不會你又像之前那樣…幹了什麼引人懷疑的事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710215,
					"content": "我只是想救人而已…是奶奶不讓我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710216
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710216,
					"content": "救、救人？！誰出事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710217,
					"content": "#能請{F#妳}{M#你}們先去洞裡面看看嗎？雖然現在應該還安全，但是拖得越久，有危險的人就會越有危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710218
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710218,
					"content": "那你怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710219,
					"content": "我只能先在門口等一會，以防自投奶奶的羅網。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710220
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710220,
					"content": "可是如果有陷阱的話，踩中的人豈不就是我們了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710221,
					"content": "#不會有事的，奶奶的陷阱認得{NICKNAME}，不會把{F#妳}{M#你}們怎麼樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710222
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710222,
					"content": "有這回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710223
					]
				},
				{
					"id": 401710223,
					"content": "#嗯，我跟我家的蜜蟲講過{F#妳}{M#你}的豐功偉績，奶奶應該也跟她的陷阱講過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710224
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710224,
					"content": "不要以為所有人都像你啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401710225,
					"content": "#總而言之，拜託了，好{M#爺爺}{F#奶奶}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710226
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401710226,
					"content": "#{NICKNAME}，既然事關人命，我們還是先進去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
