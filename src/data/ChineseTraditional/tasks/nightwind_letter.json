			"dialogs": [
				{
					"id": 401710601,
					"content": "準備好了嗎？靈性織機的使用方法很簡單的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401710602,
						401710604
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710602,
					"content": "那我來試試吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710603
					]
				},
				{
					"id": 401710603,
					"content": "#這可能是{F#妳}{M#你}第一次接觸這些，但我覺得{F#妳}{M#你}會做得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401710604,
					"content": "再等一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401710605
					]
				},
				{
					"id": 401710605,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
			]
		},
