				"points": []
			},
			"dialogs": [
				{
					"id": 200330101,
					"content": "旅行者！快看快看，我這身衣服怎麼樣？好不好看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330102
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330102,
					"content": "這身衣服…難道？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330103
					]
				},
				{
					"id": 200330103,
					"content": "沒錯！我已經通過冒險家協會的考試了，正式成為一名冒險家啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330104,
						200330105
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330104,
					"content": "很帥氣！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				},
				{
					"id": 200330106,
					"content": "#嘿嘿，謝謝{F#妳}{M#你}。我還想讓哥哥也試試看呢，結果他怎麼樣都不肯去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330107
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330107,
					"content": "我對冒險沒什麼興趣…再說了，我們倆都做了冒險家，誰來照顧爸媽啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330108
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200330108,
					"content": "那我們就把爸媽都帶上，一起去世界各地旅行啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330109
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330109,
					"content": "妳啊…行了，既然當上了冒險家，那就好好幹，家裡的事我來打理就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330110
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200330110,
					"content": "但是！一定要注意安全，不要把自己弄傷了，也不要太累…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330111
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200330111,
					"content": "知道啦知道啦！我要出去執行委託了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330112
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330112,
					"content": "#旅行者，{F#妳}{M#你}要和我一起去嗎？我還想請教{F#妳}{M#你}許多有關冒險家的問題呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330113,
						200330114
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330113,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330115,
					"content": "好，我看看啊…這次的委託是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200330116
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330116,
					"content": "護送貨運熱氣球！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200330114,
					"content": "出發吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330115
					]
				},
				{
					"id": 200330105,
					"content": "恭喜妳！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200330106
					]
				}
			]
		},
