			},
			"dialogs": [
				{
					"id": 3830401,
					"content": "成功啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830402,
					"content": "和原先的感覺完全不一樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830403
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830403,
					"content": "風元素…滿溢到了活潑的程度呢。這樣的話應該沒問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830404
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3830404,
					"content": "#多虧了{F#妳}{M#你}呀，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830405
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3830405,
					"content": "那麼，我們該在哪裡呼喚風魔龍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830406
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830406,
					"content": "在蒙德城內肯定不行，如果失敗，就會造成難以彌補的損失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830407
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830407,
					"content": "就在這酒莊的話，顯然也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830408
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830408,
					"content": "哦。酒莊沒了倒也不是什麼難以彌補的損失，但最好不要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830409
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3830409,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830410
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830410,
					"content": "海風或者高處的風，都可以讓詩人的歌聲傳頌得更遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830411
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3830411,
					"content": "如果空氣乾燥、沉悶又壓抑，那不僅詩人，就連龍都會生氣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830412
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3830412,
					"content": "原來如此。海風或者高處的風，是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830413,
					"content": "所以，最適合彈奏的地方應該就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830414,
						3830415,
						3830416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830414,
					"content": "懸崖？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830418,
					"content": "從星落湖向東一段距離，在海灘的南方有一片山地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830419
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3830419,
					"content": "#…啊！是在說{F#妳}{M#你}上次睡懶覺的那片海灘呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830420,
					"content": "沿著山地延伸的方向攀登，可以抵達一個叫做<color=#00E1FFFF>摘星崖</color>的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830421
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3830421,
					"content": "歌者，你想要的海風與高處的風，在那裡都能找到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830422
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3830422,
					"content": "嗯，我想想，摘星崖是吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830423
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3830423,
					"content": "…確實是很不錯的位置呢，是個很襯我歌聲的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830424
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3830424,
					"content": "很好。那我們就做好準備，在摘星崖集合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830425
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830425,
					"content": "還請大家認真對待，不要遲到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830426
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830426,
					"content": "遵命，團長大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830427,
					"content": "啊…抱歉，一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 3830415,
					"content": "海邊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830418
					]
				},
				{
					"id": 3830416,
					"content": "在天上一邊滑翔一邊彈？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3830417
					]
				},
				{
					"id": 3830417,
					"content": "那種事連安柏都做不到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830418
					],
					"speakerTitle": "琴"
				}
			]
		}
	]
}