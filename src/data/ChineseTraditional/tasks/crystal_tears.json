			"dialogs": [
				{
					"id": 3830201,
					"content": "唔吼——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830202,
					"content": "「特瓦林保護協會」！再次集結！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3830203,
					"content": "那麼，快把收集到的結晶拿出來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830204
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3830204,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830205
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3830205,
					"content": "結晶的色澤似乎更加渾濁了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830206
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3830206,
					"content": "特瓦林…究竟在忍受怎樣的折磨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830207
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3830207,
					"content": "#總之，先把這些結晶淨化吧。異邦的旅行者，拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830208
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3830208,
					"content": "若不是親眼所見，還真是難以置信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830209
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3830209,
					"content": "很有意思。就像濾酒一樣，令人神清氣爽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830210
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3830210,
					"content": "有這麼多淚滴就夠了。那麼接下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		},
		{
			"id": 38303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3830211,
					"content": "像上次一樣，把它們滴在天空之琴上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3830302
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3830302,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 38304,
			"completionStepIds": [
