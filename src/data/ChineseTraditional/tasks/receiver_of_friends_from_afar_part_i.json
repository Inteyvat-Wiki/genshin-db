						],
						"pointId": 310400531
					}
				]
			},
			"dialogs": [
				{
					"id": 401430101,
					"content": "「招募啟事…望舒客棧現高薪急聘臨時廚師一位，待遇從優，酬勞面議…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430102,
					"content": "#——{NICKNAME}！{F#妳}{M#你}看{F#妳}{M#你}看，高薪急聘！有賺錢的機會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430103,
					"content": "望舒客棧怎麼會突然招廚師？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430104
					]
				},
				{
					"id": 401430104,
					"content": "#欸…{F#妳}{M#你}說的對…不會是言笑出什麼事了吧？那傢伙連別人隨便進廚房都要訓一頓…不像是會找人來打雜的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430105,
					"content": "告示後面好像還有…「有意者請移步樓上與掌櫃淮安詳談…」不然我們也上去看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430106,
						401430108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430106,
					"content": "妳是想去問問言笑的情況嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430107
					]
				},
				{
					"id": 401430107,
					"content": "嗯——順便也去問問酬勞有多少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430108,
					"content": "妳是想去問問酬勞有多少吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430109
					]
				},
				{
					"id": 401430109,
					"content": "…順、順便也關心一下言笑嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4014302,
			"completionStepIds": [
				4014302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4014302",
							"2"
						],
						"stepId": 4014302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							896.893,
							265.09,
							332.755
						],
						"pointId": 310400532
					}
				]
			},
			"dialogs": [
				{
					"id": 401430201,
					"content": "…掌櫃的，真沒必要。不過是燙到手而已，也不耽誤我做菜呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430202
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430202,
					"content": "就算現在不耽誤做菜，也耽誤你痊癒啊。這幾天你先歇著，我們來想辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430203
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430203,
					"content": "嘿，掌櫃的！還有言笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430204,
					"content": "#嗯？是{NICKNAME}和派蒙啊！什麼風把{F#妳}{M#你}們兩個給吹來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430205
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430205,
					"content": "我們在樓下看到了招募啟事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430206
					]
				},
				{
					"id": 401430206,
					"content": "然後就想上來…上來問問言笑怎麼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430207,
					"content": "#唉！我就說不該貼那張告示，居然連{F#妳}{M#你}們也開始擔心了…才多大點事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430208
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430208,
					"content": "哈哈，兩位能有這份心，我先替言笑謝過了。欸，你也別不好意思了，就跟他們說說吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430209
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430209,
					"content": "好吧…其實就是前陣子過海燈節，來的客人太多，起鍋的時候有點心急不小心燙到了手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430210
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430210,
					"content": "沒想到言笑也會犯這種錯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430211
					]
				},
				{
					"id": 401430211,
					"content": "咳！常在河邊走，哪能不濕鞋嘛。再好的廚子也總有失手的時候！況且這點小傷，根本不礙事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430212
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430212,
					"content": "你可別逞強了，到時候傷勢要是更重，就不是休養一天兩天的事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430213
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430213,
					"content": "可是這海燈節過去沒多久，店裡的客人那麼多，還不是休息的時候吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430214
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430214,
					"content": "客人裡頭還有不少遠道而來的外賓，這要是隨便找個廚子應付，萬一砸了我們客棧的招牌…我第一個不答應！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430215
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430215,
					"content": "瞧你這話說的，都不知道誰是掌櫃了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430216
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430216,
					"content": "不過他說的也有理，言笑怎麼說也是當初「廚王爭霸賽」的種子選手，隨便找個廚師，還真的不好代班。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430217
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430217,
					"content": "也不是我自誇，這種水平的廚師，應該都有自己的生意要照顧吧？能抽出空來客棧幫忙的，怕是不好找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430218
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430218,
					"content": "唉，看來還得再提高一點報酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430219
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430219,
					"content": "唔…廚藝很好、又有時間的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430220,
						401430221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430220,
					"content": "遠在天邊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430222
					]
				},
				{
					"id": 401430222,
					"content": "#啊——不就是{F#妳}{M#你}嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430223,
					"content": "#對呀…仔細一想，之前是有聽說過…當時只記著{F#妳}{M#你}身手了得，都忘了{F#妳}{M#你}還有這手廚藝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430224
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430224,
					"content": "不記得廚藝只記得身手…這是客棧掌櫃該記的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430225,
					"content": "#哈，不用在意細節。總之，{F#妳}{M#你}要是願意來的話，言笑應該也能放心把廚房交給{F#妳}{M#你}吧？你說是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430226
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430226,
					"content": "#這…如果是{NICKNAME}的話…唉，確實，總比交給其他人要好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430227
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430227,
					"content": "#那…{NICKNAME}，我們要接下這份工作嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430228,
						401430230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430228,
					"content": "掌櫃剛才說提高報酬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430229
					]
				},
				{
					"id": 401430229,
					"content": "#哈哈，說話算話，一言為定。這酬勞絕對少不了{F#妳}{M#你}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430231
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430231,
					"content": "#不過我還是要提一句，在客棧裡掌勺跟自己做飯可不一樣。這幾天，我也會留在廚房裡幫{F#妳}{M#你}熟悉工作的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430232
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430232,
					"content": "結果還是放心不下嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430233,
					"content": "掌櫃的，記得店裡應該還有一些閒置的廚具，你看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430234
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430234,
					"content": "哦，好說好說，我這就去準備！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430235
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430235,
					"content": "",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401430236
					]
				},
				{
					"id": 401430236,
					"content": "#呼——完工了。快來看看，這可是為{F#妳}{M#你}量身打造的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430237
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430237,
					"content": "掌櫃的，你這木工…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430238
					]
				},
				{
					"id": 401430238,
					"content": "哎呀，一點點小手藝，不值一提、不值一提。那言笑，這裡就先交給你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430239
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 401430239,
					"content": "居然這麼大動干戈…就不能直接用現成的灶臺嗎？你是有多不想讓別人碰你的廚具啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430240,
					"content": "#欸，哪有的事？老闆說過，用人不疑，疑人不用。我只是覺得原先的灶臺對{F#妳}{M#你}來說…呃…有點高了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430241,
						401430242
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430241,
					"content": "是你看誰都覺得矮吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430243
					]
				},
				{
					"id": 401430243,
					"content": "咳咳——之前不也說了嗎？在客棧掌勺跟自己做菜不同，既要講究色、香、味，也要講究快、準、穩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430244
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430244,
					"content": "用不合適的灶臺做一天菜，累得手痠背疼不說，出菜的效率一慢，外頭的客人也要不耐煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430245
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430245,
					"content": "所以做菜的傢伙是一定要準備妥當——這就是「快」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430246
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430246,
					"content": "那「準」跟「穩」又是什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430247,
					"content": "嘿，所謂「準」，就是放亮眼睛。一塊肉從哪裡下刀、一勺油舀起多少、一鍋菜要到什麼時候起鍋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430248
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430248,
					"content": "自己做菜的時候，可以水多了加鹽、鹽多了加水，看情況調味，但客棧裡可沒那麼多機會試錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430249
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430249,
					"content": "這點我還算有自信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430250
					]
				},
				{
					"id": 401430250,
					"content": "萬一真的做壞了，就交給我來解決掉吧！嘿嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430251
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430251,
					"content": "最後的「穩」，是說不管多刁鑽的要求，都要用最穩妥的手法實現。尤其是招待天南地北、口味迥異的客人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430252
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430252,
					"content": "既要照顧他們原本的飲食習慣，又要考慮到他們想嘗試當地特色的心情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430253
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430253,
					"content": "呃…這個倒是沒那麼好懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430254,
					"content": "#不要緊，{NICKNAME}走南闖北見得多了，實際應付起來，估計只會比我更得心應手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430255
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430255,
					"content": "#何況這幾天我也會留在廚房支援{F#妳}{M#你}們，一定能讓每個客人都覺得「賓至如歸」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430242,
					"content": "對我來說也不算是問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430243
					]
				},
				{
					"id": 401430230,
					"content": "難得見言笑讓出廚房…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430231
					]
				},
				{
					"id": 401430221,
					"content": "近在眼前。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430222
					]
				}
			]
		},
		{
			"id": 4014303,
			"completionStepIds": [
				4014303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4014303",
							"2"
						],
						"stepId": 4014303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							888.421,
							255.563,
							329.875
						],
						"pointId": 310400533
					},
					{
						"sceneId": 3,
						"position": [
							922.885,
							258.972,
							363.918
						],
						"pointId": 310400534
					},
					{
						"sceneId": 3,
						"position": [
							924.154,
							258.972,
							367.775
						],
						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401430301,
					"content": "事不宜遲，直接來試試吧。基本的烹飪應該不用我多嘴。要注意的無非就是每桌不同的需求，不要記混了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430302,
					"content": "嘿嘿，還有我幫忙記呢！你就放一百個心吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430303,
					"content": "一天過去…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401430304
					]
				},
				{
					"id": 401430304,
					"content": "呃…到幾號桌了…一號桌的客人要蔥不要辣，二號桌的要辣不要蔥…三號桌…三號桌要辣不要辣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430305,
						401430306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430305,
					"content": "客人都吃完了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430307
					]
				},
				{
					"id": 401430307,
					"content": "…欸！我、我剛剛是在夢遊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430308,
					"content": "妳從中途開始就胡言亂語了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430309
					]
				},
				{
					"id": 401430309,
					"content": "嗚…中間連休息的時間都沒有，我的腦子都快變成漿糊了。你們客棧平常有這麼多人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430310,
					"content": "#最近還在旺季嘛，{F#妳}{M#你}們這是頭一次在店裡掌勺吧？已經做得很不錯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430311
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430311,
					"content": "不過還好這次來的都是熟面孔，也沒有提什麼偏門的需求，不然怕是會更麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430312
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430312,
					"content": "這些需求還不算偏嗎！杏仁豆腐上面居然要淋一匙醬油，連我都沒這樣吃過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430313,
					"content": "哈哈，天下那麼大，每個人的口味都不一樣，能包容一切才是璃月菜的精髓嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430314
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430314,
					"content": "況且這些客人的要求都很明確，只要順著意思去做就不會走偏——真正麻煩的，還是那些讓你看著辦的客人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430315
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401430315,
					"content": "請問…已經打烊了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430316
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401430316,
					"content": "咦？這個聲音是…我去看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430317,
					"content": "怎麼辦…好像真的沒人…要是我能夠早點過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430318
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401430318,
					"content": "沒關係的，現在開始準備野炊應該也還來得及。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430319
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430319,
					"content": "是啊，而且要怪也只能怪哥哥一「考察」就忘了時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430320
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 401430320,
					"content": "啊！林尼、琳妮特、菲米尼，還真的是你們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430321,
					"content": "#派蒙？那…難道{NICKNAME}也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430322
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401430322,
					"content": "你們好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430323
					]
				},
				{
					"id": 401430323,
					"content": "#{NICKNAME}、派蒙！真沒想到會在這裡看見{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430324
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430324,
					"content": "#我剛想說這句話呢！我跟{NICKNAME}是在這裡幫忙啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430325,
					"content": "#{F#妳}{M#你}們向三人說明了原委…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401430326
					]
				},
				{
					"id": 401430326,
					"content": "情況就是這樣…倒是你們怎麼會來這裡？你們的…呃…「父親」不會又給你們派了什麼任務吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430327,
					"content": "恰恰相反，我們是來璃月度假的。嗯…順便到處「考察」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430328
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430328,
					"content": "「父親」說…前陣子我們忙了那麼久，也是時候休息一下了，不然不利於下次任務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430329
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401430329,
					"content": "機會難得，加上前陣子又是海燈節，哥哥就帶著我們來璃月玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430330
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 401430330,
					"content": "那林尼說的「考察」是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430331
					]
				},
				{
					"id": 401430331,
					"content": "我們在璃月港裡看到了不少有趣的魔術…哦，在璃月，應該叫它們「戲法」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430332
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430332,
					"content": "還有人把「戲法」跟「璃月戲」、「舞獸戲」結合在一起…真的很精彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430333
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401430333,
					"content": "所以我們就想在這裡多留幾天，看看能不能夠多收集一些靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430334
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430334,
					"content": "之前還去輕策莊拜訪了若心婆婆，今天也在附近考察…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430335
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430335,
					"content": "結果忘了時間，到現在都還沒吃飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430336
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 401430336,
					"content": "#哈哈…說起吃飯，{F#妳}{M#你}也知道楓丹和璃月都有不少水產，但處理牠們的手法各有各的特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430337
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430337,
					"content": "這回難得過來一趟，不多嘗試一下不行，這也是我們逗留那麼久的理由之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430338
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430338,
					"content": "哦哦！那你們都吃了什麼？要不要聽聽我的推薦呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430339,
					"content": "…聽名字完全不覺得辣的那個魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430340
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 401430340,
					"content": "妳說的難道是…「水煮黑背鱸」？第一次聽名字是會有這種誤解啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401430341,
					"content": "呵，當時琳妮特看是魚，聞起來也香，毫無準備地吃了一口，結果被嗆得一整天都說不出話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430342
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430342,
					"content": "還好她本來也不喜歡說話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430343
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401430343,
					"content": "咕——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430344
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 401430344,
					"content": "（琳妮特，突然發出了誇張的聲音…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430345
					]
				},
				{
					"id": 401430345,
					"content": "哥哥、菲米尼，你們肚子不餓嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430346
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 401430346,
					"content": "…是、是有點餓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430347
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 401430347,
					"content": "#哈…哈哈，說的也是。那{NICKNAME}，就拜託{F#妳}{M#你}下廚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430348
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430348,
					"content": "要來點什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430349
					]
				},
				{
					"id": 401430349,
					"content": "#光看菜單上的名字也看不出什麼…既然湊巧有{F#妳}{M#你}在，不如就由{F#妳}{M#你}來推薦吧。{F#妳}{M#你}也清楚我們的口味，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401430350
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 401430350,
					"content": "…那我回廚房商量商量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430351
					]
				},
				{
					"id": 401430351,
					"content": "還有…請不要加辣，拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 401430306,
					"content": "妳快清醒一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401430307
