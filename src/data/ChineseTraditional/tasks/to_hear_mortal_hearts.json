			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180701,
					"content": "九條鐮治受了傷，鷹司家的後人，你們負責照顧好他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180702
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180702,
					"content": "沒有挑戰的勇氣，這種小事總歸做得到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180703
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180703,
					"content": "是的，對不起，實在抱歉，非常抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180704
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180704,
					"content": "如今的九條家難當大局，這件事我之前也聽說了，本來尋找天領奉行的繼任者的確是當務之急…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180705
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180705,
					"content": "但這番決鬥之後，我認為可以暫緩對九條家的處置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180706
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180706,
					"content": "在這段時間裡，鷹司家就依然像以前一樣，為九條家提供幫助吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180707
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180707,
					"content": "全依將軍大人指示，絕無二心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180708
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180708,
					"content": "如果你們還覺得，可以如法炮製愚人眾的策略，靠提供錯誤的資訊，讓我做出錯誤的判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180709
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180709,
					"content": "那我就會像今天這樣再次出現，我的刀也不會再留情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180710
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180710,
					"content": "明白，感謝將軍大人，將軍大人英明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180711
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180711,
					"content": "行了，其他的調查我會讓奧詰眾負責的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180712
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180712,
					"content": "#{F#妳}{M#你}們也跟我走吧，去個安靜的地方，我有話和{F#妳}{M#你}們說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "影"
				}
			]
		},
		{
			"id": 1201810,
			"completionStepIds": [
				1201810
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201810",
							"2"
