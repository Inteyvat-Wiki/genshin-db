					"影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180301,
					"content": "嗚哇，居然有這麼隱蔽的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120180302,
					"content": "一般來說，沒有理由在深山中修建這樣的建築。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180303,
						120180304
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180303,
					"content": "可能是危機避難所。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120180305
					]
				},
				{
					"id": 120180305,
					"content": "我感覺到了不屬此地的氣息，危險的氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180306
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180306,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120180307,
					"content": "小心點前進吧。那位九條家的後人，可能已經受困其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "影"
				},
				{
					"id": 120180304,
					"content": "可能是為了避人耳目。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120180305
					]
				}
			]
		},
		{
			"id": 1201805,
			"completionStepIds": [
				1201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201805",
							"2"
						],
						"stepId": 1201805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九條鐮治"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120180506,
					"content": "將軍大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180507
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180507,
					"content": "將軍大人怎麼會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180508
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180508,
					"content": "把這個地方的情況講給我聽，鷹司家的後人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180509
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180509,
					"content": "我們只是在討論最近發生在天領奉行裡的一些瑣事，並不值得將軍大人費心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180510
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180510,
					"content": "為此，專門選了這麼隱蔽的地方，還找了一群流浪武士和海亂鬼在外鎮守？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180511
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180511,
					"content": "那是因為最近頗為動盪，要考慮安全的問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180512
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180512,
					"content": "住口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180513
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180513,
					"content": "九條家的後人，你來講。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180514
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180514,
					"content": "好的。原本我也是抱著談判的目的前來，結果他們想要的，只是九條家的認罪書而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180515
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180515,
					"content": "認罪書？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180516
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180516,
					"content": "對，陳述九條家從眼狩令起所犯下的諸條罪責，也包括了這段時間的各類失職…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180517
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180517,
					"content": "都是根據事實在陳述，並無捏造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180518
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180518,
					"content": "確實沒有，但認罪書裡還多次強調鷹司家的功勞，提到了鷹司家臨危不亂，試圖力挽狂瀾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180519
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180519,
					"content": "但這些，就全是子虛烏有之事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180520
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180520,
					"content": "誰說的？你…你怎麼能突然變臉，出爾反爾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180521
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180521,
					"content": "我也是在陳述事實，將軍大人自會明斷。鷹司家的想法，不過就是想要樹立正面的形象，謀求替代九條家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180522
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180522,
					"content": "不然，為什麼要在九條家的認罪書裡強調從不存在的功勞，還要用軟禁的方式逼迫我簽下名字呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180523
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180523,
					"content": "你在說什麼？誰軟禁你了！這是談判！這和剛剛談的完全不一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180524
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180524,
					"content": "情況我大概知曉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180525
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180525,
					"content": "不要聽這小子一派胡言，九條家之前犯了多大的錯，將軍大人應該知道，他們的話一句都不可信！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180526
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180526,
					"content": "哼，你們的糾紛，我並無興趣。但鷹司家的後人，你想要成為天領奉行，沒錯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180527
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180527,
					"content": "呃，這個…是的，為將軍大人肝腦塗地，這是每一位天領奉行眾的永恆追求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180528
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180528,
					"content": "那大可不必如此麻煩，畢竟任命天領奉行的是我。只要有人能在決鬥中勝過我，他就是新的天領奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180529
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180529,
					"content": "這…要和將軍大人決鬥？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180530
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180530,
					"content": "初代的天領奉行就是用手中的刀劍證明了他的意志，才會有傳承到現在的九條家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180531
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180531,
					"content": "想要我認可一個新的名字，那麼自然要重新經歷我的考驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180532
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180532,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180533
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180533,
					"content": "難道你不會劍術嗎？還是說，因為年邁體弱失去了信心呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180534
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180534,
					"content": "口口聲聲要為我肝腦塗地，卻不敢面對我的刀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180535
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180535,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180536
					],
					"speakerTitle": "鷹司進"
				},
				{
					"id": 120180536,
					"content": "也罷，你們呢？不管是鷹司還是什麼，只要有人能戰勝我，他就是新的天領奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180537
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180537,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180538
					],
					"speakerTitle": "鷹司家臣"
				},
				{
					"id": 120180538,
					"content": "敢站出來的人，一個都沒有嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180539
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180539,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180540
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180540,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180541
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180541,
					"content": "我想要挑戰妳，將軍大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180542
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180542,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180543
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120180543,
					"content": "九條家的後人，很遺憾，就算你贏了我，九條家所犯下的錯誤，也無法一筆勾銷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180544
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180544,
					"content": "不，我不覺得我有勝算，我也心知肚明，家主犯下那樣的過錯，九條家在天領奉行中的傳承，理應結束了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180545
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180545,
					"content": "在執行眼狩令的時候，我對父親的想法一直抱有懷疑，我也覺得我在做錯誤的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180546
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180546,
					"content": "但僅是一直懷疑，一直思忖，明明什麼都明白，卻沒有任何行動，也沒有拯救任何人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180547
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180547,
					"content": "如今九條家敗落的境遇，就是對我的懲罰吧。我不是什麼都沒有做到，而是什麼都沒有去做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180548
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180548,
					"content": "殘酷地說，你的力量，也做不到什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180549
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180549,
					"content": "是的，我的力量很弱小，父親不聽我的，兄長也幫不了我，有時候一平都能教訓我，一直以來都是這樣…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180550
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180550,
					"content": "但是至少現在，在九條家的最後時光中，我是九條家的名代！履行和父親相同的職責！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180551
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180551,
					"content": "就像將軍所說，我的祖先以刀劍證明了自身的意志…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180552
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180552,
					"content": "那麼，也請讓我，九條鐮治，以這樣的方式來結束！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180553
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180553,
					"content": "這是我最後「能做些什麼」的機會了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180554
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120180554,
					"content": "明明，沒有意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120180555
					],
					"speakerTitle": "影"
				},
				{
					"id": 120180555,
					"content": "不過我接受了，上前來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "影"
				}
			]
		},
		{
			"id": 1201807,
			"completionStepIds": [
				1201807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
