			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120181001,
					"content": "影在處理事情的時候，果然還是將軍的感覺，特別威嚴呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120181002,
					"content": "這樣嗎？我覺得我已經很會變通了，如果是將軍的話，很有可能…會毫不留情地斬掉九條鐮治。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181003,
						120181004
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181003,
					"content": "他也算運氣好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181005
					]
				},
				{
					"id": 120181005,
					"content": "我覺得他做好這樣的準備了，我從他的眼睛裡能看出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181006
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181006,
					"content": "九條家從輝煌到沒落，實在是發生了難以想像的巨大變化，九條鐮治並不是什麼優秀的繼承者，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181007
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181007,
					"content": "他讓我在巨大的變化中，看到了那些仍沒有改變的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181008
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181008,
					"content": "#這也是多虧了{F#妳}{M#你}們、在街道中的遊覽，還有{F#妳}{M#你}們的畫片，讓我意識到這件事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181009
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181009,
					"content": "接下來九條家會怎麼樣呢？有可能繼續當天領奉行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120181010,
					"content": "那還是不行，就算是這位繼承者有突出之處，也不能抹平之前所犯下的過錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181011
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181011,
					"content": "但…多留一些時間吧，畢竟犯下錯誤的也不只是他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181012
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181012,
					"content": "將軍不會錯，也不能錯。但作為「影」，我還是想要表達我的歉意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181013
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181013,
					"content": "接下來的日子需要思考的東西還有很多，不過至少現在我能看清方向了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181014
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181014,
					"content": "那妳會直接管理稻妻嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181015
					]
				},
				{
					"id": 120181015,
					"content": "還是會交給將軍去做吧，最威脅永恆的，始終還是時間帶來的「磨損」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181016
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181016,
					"content": "我說過將軍有自我保護的機制，就是預想到了我會因為時間而產生改變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181017
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181017,
					"content": "但既然是已經想通的事，就算再困難我也會去做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181018
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181018,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181019
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181019,
					"content": "果然很值得紀念啊，這一段時光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181020
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181020,
					"content": "是啊，天領奉行的事解決了，城裡的人也見到了健康的將軍，不好的猜想都會自然而然地消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181021
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120181021,
					"content": "妳要是很喜歡出來玩，下次我們再來邀請妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181022,
						120181023
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120181022,
					"content": "再帶點土產。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181024
					]
				},
				{
					"id": 120181024,
					"content": "不必了，這並非我生活的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181025
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181025,
					"content": "而且，不要說得我很需要陪伴似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181026
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181026,
					"content": "好了，那麼我準備回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181027
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181027,
					"content": "閉門靜養還會持續一段時間，但不會太久。有些小事，就交給你們這些人類處理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181028
					],
					"speakerTitle": "影"
				},
				{
					"id": 120181028,
					"content": "那就下次再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181029
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120181029,
					"content": "雖然發生了很多意料之外的事，但最後好像格外順利啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181030
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120181030,
					"content": "最後，就只剩下把通行證還給八重神子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120181023,
					"content": "再帶點新鮮的玩意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181024
					]
				},
				{
					"id": 120181004,
					"content": "可能這也在他意料之中。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181005
					]
				}
			]
		},
		{
			"id": 1201812,
			"completionStepIds": [
				1201812
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
