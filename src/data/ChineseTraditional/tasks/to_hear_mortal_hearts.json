			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120181201,
					"content": "神子，我們回來啦，一路上很順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120181202,
					"content": "#喔，那可要和我好好講講{F#妳}{M#你}們的故事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181203
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181203,
					"content": "呵呵，太有意思了，堂堂的將軍大人，進城逛街的時候就像個從鄉下來的土包子一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181204
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181204,
					"content": "沒能親眼目睹，真是可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181205,
						120181206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181205,
					"content": "也就妳敢這麼說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181207
					]
				},
				{
					"id": 120181207,
					"content": "沒事啦，她不會介意的，肯定不會介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181208,
					"content": "#不過，聽{F#妳}{M#你}們說，她好像隱約觸及到了「永恆」理想中的樣貌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181209
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181209,
					"content": "#那就是最重要的收穫了。說實話，借給{F#妳}{M#你}們通行證明的時候，我也沒想到會有這麼大的進展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181210
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181210,
					"content": "嗯，她好像不會再強求一切都靜止下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120181211,
					"content": "說好聽點，這叫神明的一廂情願。說難聽點，即便是「塵世七執政」，在面對更強大的存在時，也有做不到的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181212,
						120181213
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181212,
					"content": "是指人心嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120181214
					]
				},
				{
					"id": 120181214,
					"content": "#呵呵，{F#妳}{M#你}猜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181215,
					"content": "#總之聽{F#妳}{M#你}們講下來，這一路上都挺愉快的吧，{F#妳}{M#你}們應該也見識到影她不那麼刻板的一面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181216,
					"content": "以後還要見她的時候，再來找我借通行證吧，她雖然嘴上不會說，但其實還是挺容易寂寞的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181217
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181217,
					"content": "欸？但她說了她不需要陪伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120181218,
					"content": "因為她是神啊，神不是不需要陪伴，而是「陪伴」太奢侈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120181219
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181219,
					"content": "#但{F#妳}{M#你}，不屬此世之人，說不定是很好的選擇呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120181213,
					"content": "是指天理嗎？",
