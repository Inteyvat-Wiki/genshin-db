			"dialogs": [
				{
					"id": 221000301,
					"content": "怎麼樣？周圍的怪物都清乾淨了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000302
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000302,
					"content": "已經清乾淨了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000303
					]
				},
				{
					"id": 221000303,
					"content": "那就好，辛苦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000304
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000304,
					"content": "這是說好的報酬，您拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000305
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000305,
					"content": "這下子，肯定能清淨一段時間了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000306
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000306,
					"content": "那位小爺是誰？嗯…您還是去問老闆吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		}
	]
