					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221000201,
					"content": "怎麼樣？周圍的怪物都清乾淨了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000202,
					"content": "還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000203
					]
				},
				{
					"id": 221000203,
					"content": "倒也不用太著急，那些怪物也只是在外圍遊蕩，近前是不敢近前的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000204
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000204,
					"content": "不過，要是哪個不長眼的怪物腳底打了個溜，礙了那位小爺的清淨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000205
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000205,
					"content": "不說荻花洲會不會再被折騰個底朝天，就說我這客棧，怕又要好幾天不能開業了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
