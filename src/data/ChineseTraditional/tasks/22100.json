			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221000101,
					"content": "唉，這可怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000103
					]
				},
				{
					"id": 221000103,
					"content": "唉，在這裡開個客棧可不容易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000104,
					"content": "這荻花洲上，荻花多，寶貝多，怪物更多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000105,
					"content": "還好託了千岩軍的福，周圍的怪物都差不多被清理乾淨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000106,
					"content": "但是不知道最近怎麼了，那些怪物又莫名其妙地鑽出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000107
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000107,
					"content": "雖然它們絕對不敢到客棧近前，但是每天看著這些傢伙，不說客人，連我都覺得礙眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000108,
					"content": "如果您有空的話，能幫我去周圍看看，把客棧旁邊的怪物給清一清嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000109,
						221000110
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000111
					]
				},
				{
					"id": 221000111,
					"content": "哈哈，您說話做事真是爽利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000114,
					"content": "對了，讓客人替我忙碌，實在是有些不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000115
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000115,
					"content": "事結之後，報酬我絕不會少您一分的，請客人放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000116
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000116,
					"content": "那麼，就萬事拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000110,
					"content": "只是礙眼嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221000112
					]
				},
				{
					"id": 221000112,
					"content": "您看您說的，礙眼就是那些個怪物最煩人的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000113
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221000113,
					"content": "唉，特別是那位愛清淨的小爺，他要覺得煩，那整個荻花洲，怕是都要跟著他一起煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221000114
					],
					"speakerTitle": "淮安"
				}
			]
		},
		{
			"id": 2210002,
			"completionStepIds": [],
