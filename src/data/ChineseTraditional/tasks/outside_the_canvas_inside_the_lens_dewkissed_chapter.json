				]
			},
			"dialogs": [
				{
					"id": 745140101,
					"content": "好…好冷，果然不該隨便吹風的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140102
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140102,
					"content": "#欸？{NICKNAME}！派蒙！{F#妳}{M#你}們…哈啾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140103
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140103,
					"content": "朝霧？妳怎麼會在這裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140104
					]
				},
				{
					"id": 745140104,
					"content": "妳的身體好了嗎？居然有辦法一個人來這麼遠的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745140105,
					"content": "#我…那個…好、好得差不多了！{F#妳}{M#你}看，我都不咳嗽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140106
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140106,
					"content": "哈哈…哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140107,
						745140108
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140107,
					"content": "真的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				},
				{
					"id": 745140109,
					"content": "嗚哇！不要啊！我承認，我是自己偷偷跑出來的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140110
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140110,
					"content": "我…我也沒辦法啊…老是窩在稻妻，怎麼可能畫出好看的畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140111
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140111,
					"content": "#就算有{F#妳}{M#你}幫我去到處留影，但不管怎樣，畫片一定比不過實景啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140112
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140112,
					"content": "所以我就拜託之前合作過的一個老師幫忙聯絡一支商隊，悄悄地出來旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140113
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140113,
					"content": "虧妳還把畫具都背過來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140114
					]
				},
				{
					"id": 745140114,
					"content": "那當然。畫板可是我的靈魂，怎麼能隨便丟下呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140115
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140115,
					"content": "而且我的畫在楓丹也賣得很好，還有幾個楓丹的作家請我替他們的小說畫封面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140116
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140116,
					"content": "不過…他們居然沒有在小說中間插入插畫的習慣…真沒想到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140117
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140117,
					"content": "#對了，{NICKNAME}，剛好{F#妳}{M#你}在這裡…{F#妳}{M#你}願意再幫我去取材嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140118,
						745140120
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140118,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140119
					]
				},
				{
					"id": 745140119,
					"content": "#好耶！有{F#妳}{M#你}幫忙我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140123,
					"content": "好的…讓我看看喔…正好我又接到了幾個作家的約稿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140120,
					"content": "好，妳不要亂跑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140121
					]
				},
				{
					"id": 745140121,
					"content": "我知道啦，我才對付不了那些機關鐵塊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140122
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140122,
					"content": "#論起對付各類奇奇怪怪的魔物，當然還是{F#妳}{M#你}最在行了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745140123
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 745140108,
					"content": "我要寫信回去問了喔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745140109
					]
				}
			]
		}
	]
}