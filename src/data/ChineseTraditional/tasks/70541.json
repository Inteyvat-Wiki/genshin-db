			},
			"dialogs": [
				{
					"id": 705410101,
					"content": "喵嗷~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410102
					],
					"speakerTitle": "「大桔騎士」"
				},
				{
					"id": 705410102,
					"content": "嘿嘿，「大桔騎士」也變得乖巧聽話啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410103,
					"content": "以後，你千萬要做一個溫柔的好孩子，快快樂樂地和大家一起生活哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410104,
					"content": "我，我也想撓撓牠的頭，捏捏牠的耳朵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410105
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705410105,
					"content": "不鬧騰的時候，明明是個非常討人喜歡的傢伙…那牠眼睛上的傷是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410106
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705410106,
					"content": "根據復原製劑的殘留痕跡，「大桔騎士」應該就在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410107
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410107,
					"content": "#唔，{NICKNAME}和派蒙…教會的蘿莎莉亞修女，還有一位冒險家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410108
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410108,
					"content": "#看樣子，「大桔騎士」已經和{F#妳}{M#你}們交上朋友了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410109
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410109,
					"content": "阿阿阿阿阿貝多？好久不見了！見到你很開心，不過…你確定沒走錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410110,
					"content": "調查小隊的隊長突然造訪一間流浪動物收養所，是有什麼重要的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410111
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705410111,
					"content": "妳說隊長？他是騎士團的隊長？重要的長官沒有任何預兆地來了…我都沒有準備招待客人的茶和點心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410112
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705410112,
					"content": "不對，請聽我解釋，我們「貓茸茸城堡」是拿到了經營許可的正式營業場所！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410113
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705410113,
					"content": "瓦樂瑞娜誤以為自己的收養所會被查處，慌慌張張地找來騎士團開具的資料，向阿貝多解釋了一番「貓茸茸城堡」的用途…\\n其實她只是被調查小隊的字首給震懾了，調查小隊並不負責城市管理方面的事務…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						705410114
					]
				},
				{
					"id": 705410114,
					"content": "請別緊張，我只是順路幫部下解決麻煩而已，那隻貓就是我此行的目的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410115
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410115,
					"content": "不久前，「臨時隊貓·三號治療病例·大桔騎士」打暈了照顧牠的武器官，逃竄至城門附近，失去了影蹤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410116
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410116,
					"content": "「屬於調查小隊，戴著騎士團徽記的大貓在城裡作亂」，多少會造成不妙的影響，還是盡早制止為妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410117
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410117,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410118,
						705410119
					],
					"speakerTitle": "「大桔騎士」"
				},
				{
					"id": 705410118,
					"content": "牠原來是調查小隊的貓？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705410120
					]
				},
				{
					"id": 705410120,
					"content": "「大桔騎士」居然能打暈調查小隊的騎士？名字前面還有好長的一串稱號…好像還有什麼隱情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410121,
					"content": "說來的確很巧。兩個月前，牠在野外迷路，誤食了騙騙花蜜，結果由於某些暫不明確的反應，體型膨脹成了原本的三倍大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410122
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410122,
					"content": "三倍！一般的貓貓凶起來就很難安撫了…三倍大的話，豈不是連丘丘人都不怕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410123,
					"content": "這樣啊，難怪牠那麼緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410124
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705410124,
					"content": "對於貓…以至於生活在野外的所有生物而言，體型太大並不會帶來多少益處，反而會讓自己更醒目，動作變得更遲緩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410125
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705410125,
					"content": "最後只會讓牠們生活在極易暴露的危險處境中，頻繁遭到其他掠食者的攻擊，受到過度驚嚇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410126
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705410126,
					"content": "是的，牠出現在調查小隊的駐地附近時，顯然吃了不少苦，全身傷痕累累，異常驚恐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410127
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410127,
					"content": "好，好可憐…這樣一想，被牠打了，我也不覺得難過了…換成我，我也會害怕陌生的人和動物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410128
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705410128,
					"content": "不用擔心，問題已經解決了。之前我開發了一種消除煉金藥劑影響的復原製劑，就用這種製劑讓牠的體型恢復正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410129
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410129,
					"content": "雖然體型依然大於普通的貓，但至少不會影響牠的生活了，騎士們也能輪流照顧牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410130
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410130,
					"content": "可莉根據牠的顏色，給牠起了「大桔騎士」這個名字，大家都覺得很適合，還給牠訂製了這條圍巾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410131
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410131,
					"content": "嘿嘿，明明沒有和可莉商量過，卻起了完全一樣的名字，看來我倆的想法超級合拍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410132,
					"content": "喵嗚~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410133
					],
					"speakerTitle": "「大桔騎士」"
				},
				{
					"id": 705410133,
					"content": "或許是因為後遺症，牠面對每個人都緊張兮兮，過度戒備，小隊的武器官和訊號官總是被牠欺負，可莉又不會經常到駐地來玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410134
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410134,
					"content": "#現在看來，「大桔騎士」似乎很喜歡{NICKNAME}和派蒙。隊裡的大家應該也想不到，「大桔騎士」會這麼親近人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410135
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410135,
					"content": "畢竟是偉大的貓貓救星，榮譽騎士和白貓魔法師！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410136
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705410136,
					"content": "#不管是多凶多嚇人的貓，和{M#他們}{F#她們}一起玩了以後，都會變得乖巧可愛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410137
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705410137,
					"content": "#既然如此，{NICKNAME}和派蒙願意收養「大桔騎士」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410138
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410138,
					"content": "咦？這樣沒關係嗎？「大桔騎士」不是妳們的隊貓嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410139,
					"content": "臨時隊貓的頭銜也是出於無奈，我們本來打算在「大桔騎士」的狀況穩定後，尋找一位好心人，正式收養牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410140
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410140,
					"content": "調查小隊畢竟是騎士團的作戰單位，一直待在我們身邊，生活條件並不理想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410141
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410141,
					"content": "熟悉牠的騎士們終歸是要出勤的，把「大桔騎士」留在營地裡，就會讓牠不知所措，帶著牠行動的話，又會讓牠再次受到驚嚇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410142
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410142,
					"content": "明智的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410143
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705410143,
					"content": "對於受到過驚嚇的動物，盡量讓牠遠離一切刺激，才能使牠慢慢走出陰影，徹底變得平和…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410144
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705410144,
					"content": "這麼說來，我們的確可以在塵歌壺裡搭一個暖暖的貓窩，讓「大桔騎士」安安心心快快樂樂地生活，再也不用擔心被魔物欺負。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410145,
					"content": "喵嗷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410146,
						705410147
					],
					"speakerTitle": "「大桔騎士」"
				},
				{
					"id": 705410146,
					"content": "好耶！我們收養新的貓貓！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705410148
					]
				},
				{
					"id": 705410148,
					"content": "實在太謝謝你啦，阿貝多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410149,
					"content": "#別客氣，等到{F#妳}{M#你}們不忙時，還可以帶著「大桔騎士」來駐地，看望一下調查小隊的大家，讓大家見見牠乖巧時的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410150
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410150,
					"content": "真是…真是令人感動，我見證了意義非凡的領養現場！這應該是「貓茸茸城堡」幫助流浪動物找到新家的第一個案例！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410151
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705410151,
					"content": "喂，別拿我的頭巾擦眼淚啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410152
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705410152,
					"content": "說起來，原來蘿莎莉亞修女喜歡和小動物打交道嗎？有點令人意外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410153
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410153,
					"content": "對哦對哦，我好像感覺到了！蘿莎莉亞對貓貓應該也有一種親和力，只不過自己也沒有發現，一般不會表現出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410154
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410154,
					"content": "一開始，「雪糕」也親近了蘿莎莉亞，「大桔騎士」剛來的時候，也是蘿莎莉亞穩住了牠的情緒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410155,
					"content": "呃…我只是一直在旁邊看著熱鬧而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410156
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705410156,
					"content": "我悟了！蘿莎莉亞小姐！最近我從榮譽騎士和白貓魔法師那裡學到了好多好多安撫貓貓的技巧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410157
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705410157,
					"content": "我決定延長試營業的時間，好好領會這幾天的學習成果，迅速成長為…嗯…貓貓見習魔法師！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410158
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705410158,
					"content": "到時候，我們繼續一起管理「貓茸茸城堡」，一起幫幫全蒙德的流浪貓，好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410159
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705410159,
					"content": "蘿莎莉亞要繼續協助瓦樂瑞娜嗎…貓貓魔法師和貓貓修女？是很特別的組合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410160,
					"content": "罷了…這份差事的感覺還不錯，工作不多，沒什麼煩人的點。這樣的熱鬧，繼續看下去也無妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410161
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705410161,
					"content": "雖說不太瞭解流浪動物收養的細節，但妳們似乎邁過了一個里程碑，恭喜妳們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410162
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410162,
					"content": "之後我會提醒其他騎士，要是遇見了不知該如何處置的流浪貓，就優先送到妳們這裡來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410163
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 705410163,
					"content": "太太太太太感謝各位的支援了！我要給各位一大筆酬謝金！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410164
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705410164,
					"content": "「貓茸茸城堡」的試營業階段超級成功！等到正式開張時，我一定宴請幾位來剪綵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410165
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705410165,
					"content": "圓滿成功，好心情和摩拉雙收，還領養了特別的「大桔騎士」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410166
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410166,
					"content": "我也開始期待「貓茸茸城堡」開業的那天啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705410167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705410167,
					"content": "喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「大桔騎士」"
				},
				{
					"id": 705410147,
					"content": "棒欸！大桔騎士入住新家！",
