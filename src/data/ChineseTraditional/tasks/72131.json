			},
			"dialogs": [
				{
					"id": 721310101,
					"content": "形狀奇特的石燈，似乎放射著令人不安的能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310102
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721310102,
					"content": "這是…石燈籠？為什麼這裡會有石燈籠呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721310103,
					"content": "欸，燈柱上被人寫了字，我們看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721310104,
					"content": "「諸位工友，關於此鎮物如有疑問，請至無想刃狹間，與梶先生商談。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310105
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721310105,
					"content": "字跡看起來很新。下面還有幾列粗獷的小字：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310106
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721310106,
					"content": "「十分抱歉我們也幫不上什麼忙，昨日剛剛接到天領奉行大人的緊急疏散令。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310107
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721310107,
					"content": "「希望有緣來日再見，共同商討解決『祟神』作亂之事。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721310108
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721310108,
					"content": "這個梶先生似乎對石燈籠很在意的樣子，我們不如去無想刃狹間問問他吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
