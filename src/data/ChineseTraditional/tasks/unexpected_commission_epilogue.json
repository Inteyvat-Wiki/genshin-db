				"points": []
			},
			"dialogs": [
				{
					"id": 706900301,
					"content": "嗯？居然這麼快就把所有書都整理好了，超出我的預期了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900302
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900302,
					"content": "#小可愛想要什麼獎勵嗎？多虧了{F#妳}{M#你}們才空出來了一整個下午，用來陪{F#妳}{M#你}的話也不錯呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900303,
						706900305
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900303,
					"content": "關於我的報酬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900304
					]
				},
				{
					"id": 706900304,
					"content": "只想要這個？別著急，報酬我不會忘的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900306
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900306,
					"content": "#{F#妳}{M#你}們也發現了吧？這批書從名字到內容都很奇怪呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900307
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900307,
					"content": "而且照理來說，這裡作為北陸最大的圖書館，不可能會收到這麼多連名字都沒聽過的新書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900308
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900308,
					"content": "除非…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900309
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900309,
					"content": "其實剛才我們遇到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706900310,
					"content": "呵呵，看起來是一些我不太想知道的麻煩事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900311
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900311,
					"content": "不管怎麼說，既然是已經存在於這個世界上的書籍，就有將其收藏在圖書館的必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900312
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900312,
					"content": "放在這裡，總比讓它們流傳在外面，落入什麼奇怪的人手裡要好得多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706900313
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900313,
					"content": "#報酬在這裡，這次也辛苦{F#妳}{M#你}們啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麗莎"
				},
				{
					"id": 706900305,
					"content": "關於這些書…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706900306
					]
				}
			]
		}
	]
