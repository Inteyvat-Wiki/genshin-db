			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽琉斯",
					"冒失的帕拉德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708020201,
					"content": "居然在這個區域…帕拉德，你確定嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020202
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020202,
					"content": "我很確定，賽琉斯先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020203
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020203,
					"content": "你們在討論喬爾父親的事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020204
					]
				},
				{
					"id": 708020204,
					"content": "#這不是旅行者嗎？看來{F#妳}{M#你}是從喬爾那邊過來的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020205
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020205,
					"content": "那孩子，每天都要拜託人從我這裡打聽消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020206
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020206,
					"content": "不過，這次我可是要帶給他一個大大的好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020207
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020207,
					"content": "前段時間，我們冒險家協會剛剛組織了一場「雪山特訓」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020208
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020208,
					"content": "接下來的就由我說吧，賽琉斯先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020209
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020209,
					"content": "在參加那場特訓的途中，我因為風雪太大而偏離了預定的路線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020210
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020210,
					"content": "當我摸索著準備回到路線上時，突然在一處山崖上，看見了一個模糊的人影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020211
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020211,
					"content": "我最開始還以為是一個和我一樣迷路的冒險家，就大聲喊他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020212
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020212,
					"content": "但是，在吸引到那個人的注意力之前…我的喊聲先引來了魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020213
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020213,
					"content": "在雪山的那種環境裡，我沒有打倒那些魔物的自信，只能先撤退了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020214
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020214,
					"content": "回來之後，我就把這件事和賽琉斯先生說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020215,
						708020217
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020215,
					"content": "那個人影就是喬爾的父親？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020216
					]
				},
				{
					"id": 708020216,
					"content": "我們也不能確定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020218
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020218,
					"content": "無論如何，至少我們知道了有人被困在雪山裡，必須要組織營救行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020219
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020219,
					"content": "至於那個人到底是不是喬爾的父親喬瑟夫先生…就只能看運氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020220
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020220,
					"content": "總之，我已經讓協會裡有能力進入雪山的人都去展開搜救了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020221
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020221,
					"content": "我也準備一下，等會就去雪山裡參加搜救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020222,
						708020223
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020222,
					"content": "我和你一起去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020224,
					"content": "#{F#妳}{M#你}願意幫忙嗎？太好了，那我們就一起出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020223,
					"content": "我去打倒那些魔物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020224
					]
				},
				{
					"id": 708020217,
					"content": "也許是另外哪位迷路的冒險家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020218
					]
				}
			]
		},
