				"points": []
			},
			"dialogs": [
				{
					"id": 708020101,
					"content": "這次，真的能找到爸爸嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020102
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 708020102,
					"content": "你爸爸有消息了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020103
					]
				},
				{
					"id": 708020103,
					"content": "#大{F#姐姐}{M#哥哥}，是你呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020104
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 708020104,
					"content": "帕拉德哥哥和我說，賽琉斯叔叔好像找到了和我爸爸有關的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020105
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 708020105,
					"content": "雖然他還不能確定…但帕拉德哥哥說，這次他們找到的線索很有力，說不定真能找到我爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020106
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 708020106,
					"content": "我想要和他們一起進雪山去，但賽琉斯叔叔要我留在營地裡，有了消息他們自然會告訴我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020107
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 708020107,
					"content": "#大{F#姐姐}{M#哥哥}，如果可以的話，{F#妳}{M#你}能幫我去向賽琉斯叔叔打聽一下消息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020108,
						708020109
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 708020108,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				},
				{
					"id": 708020110,
					"content": "我、我害怕聽到…不好的消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020111
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 708020111,
					"content": "#總之，拜託{F#妳}{M#你}了！大{F#姐姐}{M#哥哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "喬爾"
				},
				{
					"id": 708020109,
					"content": "你為什麼不自己去問？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020110
					]
				}
			]
		},
		{
			"id": 7080202,
			"completionStepIds": [
				7080203
			],
