			"dialogs": [
				{
					"id": 708020301,
					"content": "這周圍總算安全點了，多謝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020302
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020302,
					"content": "關於喬瑟夫先生…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020303
					]
				},
				{
					"id": 708020303,
					"content": "唉，我剛才也沒發現什麼新線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020304
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020304,
					"content": "不過，既然這周圍都安全了，那我也會繼續搜索的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020305
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 708020305,
					"content": "#請{F#妳}{M#你}先回協會一趟，告訴賽琉斯先生我已經開始搜索工作了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "冒失的帕拉德"
				}
			]
		},
