			"dialogs": [
				{
					"id": 708020401,
					"content": "#旅行者，{F#妳}{M#你}回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020402,
						708020404
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020402,
					"content": "帕拉德已經開始搜索了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020403
					]
				},
				{
					"id": 708020403,
					"content": "嗯，那傢伙偶爾還是能幹點正事的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020406,
					"content": "等我整理一下手上的情報之後，也會去雪山那邊見見喬爾那孩子，把事情詳細地講給他聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020407
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020407,
					"content": "#旅行者，請{F#妳}{M#你}先去告訴喬爾，我等一下就會過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020408
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020408,
					"content": "我整理情報還要些時間，可別讓那孩子等急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 708020404,
					"content": "真的能找到那個人嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708020405
					]
				},
				{
					"id": 708020405,
					"content": "這我…不能保證。只能說，我們會盡最大的努力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708020406
					],
					"speakerTitle": "賽琉斯"
				}
			]
