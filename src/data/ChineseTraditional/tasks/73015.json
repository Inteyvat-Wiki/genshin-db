			},
			"dialogs": [
				{
					"id": 730151601,
					"content": "蘭那庫拉，我們回來了！不過之後就得靠你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730151602,
					"content": "#謝謝派蒙，謝謝那菈{NICKNAME}，蘭那庫拉知道該怎麼做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151603
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730151603,
					"content": "喔！看樣子這裡應該也沒問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730151604,
					"content": "希望森林能快點恢復正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151605
					]
				},
				{
					"id": 730151605,
					"content": "治好法留納神機，一定可以。不過無留陀…必須清除，為了桓那，為了沙恆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151606
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730151606,
					"content": "就像為了那菈法留納而造的「紀念碑」被壞種子蓋住。因為無留陀，「覺樹之堂」也受到影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151607
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730151607,
					"content": "那是比那菈法留納來到桓那蘭那更早的時候，那菈和蘭那羅一起建造的苗圃。但是現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151608
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730151608,
					"content": "除了維摩莊的孩子們還能看見，蘭那羅對大人們來說不過是故事裡的存在…曾經的苗圃也因為無留陀而一度變得荒蕪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730151609,
					"content": "蘭那庫拉想要在苗圃裡種滿花朵，那菈忘記了蘭那羅，但是沒關係，因為那菈會看到花朵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151610
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730151610,
					"content": "蘭那庫拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730151611,
					"content": "#那菈{NICKNAME}，派蒙，謝謝，蘭那庫拉不會忘記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151612
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730151612,
					"content": "現在，蘭那庫拉要回「歇腳處」，蘭般度知道「紀念碑」被清理乾淨了，一定很高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151613
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730151613,
					"content": "#那菈{NICKNAME}和派蒙要不要和蘭那庫拉一起回「歇腳處」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730151614,
						730151616
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730151614,
					"content": "好呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151615
					]
				},
				{
					"id": 730151615,
					"content": "有金色的那菈同行，非常安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730151616,
					"content": "還有其他事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730151617
					]
				},
				{
					"id": 730151617,
					"content": "#蘭穆護昆達看顧那菈{NICKNAME}和派蒙，小心不要被壞傢伙吞掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭那庫拉"
				}
			]
