					"nextDialogs": [
						730150345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150345,
					"content": "蘭那庫拉比派蒙厲害，卻差點被壞傢伙吃掉。派…派蒙這麼小隻，太危險了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150346
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150346,
					"content": "#好、好像有點道理？不對！{NICKNAME}厲害，一定會保護派蒙的啦，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150347,
						730150349
					],
					"speakerTitle": "派蒙"
				},
