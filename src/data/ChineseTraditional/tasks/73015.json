					"id": 730150347,
					"content": "那當然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150348
					]
				},
				{
					"id": 730150348,
					"content": "#嘿嘿，畢竟我是{NICKNAME}最好的夥伴嘛！",
