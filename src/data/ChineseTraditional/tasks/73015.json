			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"蘭那庫拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730150301,
					"content": "你一定就是蘭那庫拉了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150302,
					"content": "嗚哇！被、被那菈發現了！該、該怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150303
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150303,
					"content": "你先別逃跑！是蘭般度告訴我們你在這裡的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150304,
					"content": "#既、既然是蘭般度告訴{F#妳}{M#你}們的，那一定是好那菈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150305
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150305,
					"content": "#嗯？蘭那庫拉是不是太輕信了？萬一{NICKNAME}是壞那菈，用蘭般度的名字來騙你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150306,
					"content": "呀！那、那金色的那菈，其實是在騙蘭那庫拉？金色的那菈，其實是壞那菈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150307
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150307,
					"content": "感覺突然湧出了罪惡感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150308,
					"content": "別聽派蒙的，我是好那菈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150309
					]
				},
				{
					"id": 730150309,
					"content": "#太好了，感謝蘭穆護昆達，金色的那菈果然是好那菈。雖然那菈{NICKNAME}比蘭那庫拉高很多，但是不害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150310
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150310,
					"content": "派蒙…派蒙小隻，也不害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150311
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150311,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150312,
						730150314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150312,
					"content": "派蒙的確很小隻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150313
					]
				},
				{
					"id": 730150313,
					"content": "小看我可是要吃大虧的！哼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150316,
					"content": "不過說回正事，我們是來治好法留納神機的，這片「桓那」應該也有法留納神機的「枝」和「葉」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150317,
					"content": "蘭般度讓我們來看看情況，如果你遇到了困難，也好幫幫你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150318,
					"content": "啊！很多壞傢伙在桓那…有安全的路，但是要小心。而且到處都是壞種子，就連為了那菈法留納而造的…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150319
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150319,
					"content": "#那菈{NICKNAME}又高又大，說不定和蘭百梨迦一樣強…那菈{NICKNAME}，說不定有辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150320
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150320,
					"content": "#…那菈{NICKNAME}，說不定能夠幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150321
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150321,
					"content": "#我們本來就是來幫忙的呀，對吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150322,
					"content": "交給我們吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150323
					]
				},
				{
					"id": 730150323,
					"content": "蘭那庫拉有別的請求，在治好法留納神機以前…想要先去找回石頭的記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150324
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150324,
					"content": "…「石頭的記憶」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150325
					]
				},
				{
					"id": 730150325,
					"content": "桓那不會忘記，蘭那羅不會忘記，但是蘭那羅留下看得到的記憶。壞傢伙來了以後，四處都是壞種子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150326
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150326,
					"content": "和蘭那羅說話就像猜謎一樣呢…不過，實際見到之後應該就明白了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150327,
					"content": "總之，我們先和蘭那庫拉一起過去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150328,
					"content": "好那菈，好派蒙！我們不要驚動壞傢伙，有安全的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150329
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150329,
					"content": "欸？蘭那庫拉說的「壞傢伙」應該就是蕈獸吧，那完全不用擔心呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150330,
					"content": "#哼哼，蘭那庫拉，你聽好了，那菈{NICKNAME}可是很強的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150331,
					"content": "而且不是一般的強！是非——常——強！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150332,
					"content": "我們之前已經和蘭般度一起打敗了好多蕈獸呢！就連蘭般度也認可了我們的實力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150333,
					"content": "#知道了，那菈{NICKNAME}一定和蘭百梨迦一樣厲害。可是派蒙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150334
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150334,
					"content": "我？我怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150335,
					"content": "發生過這樣的事…蘭那庫拉被壞傢伙追趕，鑽進了土裡，但是被刨出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150336
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150336,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150337,
					"content": "壞傢伙的大口裡滴出來，濕的、熱的，還有果實壞掉的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150338
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150338,
					"content": "嗚哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150339,
					"content": "要不是蘭百梨迦及時趕到，蘭那庫拉就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150340
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150340,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150341,
					"content": "之後蘭般度說教了很久，太陽下去又上來，就連苗圃裡種下的種子都已經發芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150342
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730150342,
					"content": "…這說教也太久了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730150343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730150343,
					"content": "可是這跟派蒙有什麼關係？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730150344
					]
				},
				{
					"id": 730150344,
					"content": "對呀對呀，這和派蒙有什麼關係呢？",
