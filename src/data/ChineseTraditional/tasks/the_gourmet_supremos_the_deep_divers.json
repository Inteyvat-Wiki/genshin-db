				{
					"id": 721700301,
					"content": "海草…魚肉…還有稻米…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700302
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700302,
					"content": "應該是這樣做吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700303
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700303,
					"content": "這樣就做好了！這就是「飯糰」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700304
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700304,
					"content": "這還真是…樸實無華…我要這個好了，感覺我應該吃不完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700305
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 721700305,
					"content": "只要味道好就行啦，我要這個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700306
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 721700306,
					"content": "#這是{F#妳}{M#你}的，旅行者。還有這份「飯糰」的製作方法，我也抄了一份給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700307
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700307,
					"content": "雖然「飯糰」的做法看起來很簡單，但想要做得好吃，還是需要一點技巧的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700308
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700308,
					"content": "咳…好了，閒話就先不說了，忙了這麼久，我也要去吃一點了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700309
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700309,
					"content": "喂！芭爾瓦涅，妳不是說妳吃不完嗎？給我留一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				}
			]
