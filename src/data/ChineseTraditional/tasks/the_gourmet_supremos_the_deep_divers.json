			"dialogs": [
				{
					"id": 721700201,
					"content": "#旅行者，{F#妳}{M#你}採到海草了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700202
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700202,
					"content": "#喔！就是這個，謝謝{F#妳}{M#你}幫忙啦，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700203
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700203,
					"content": "我這就開始做那種叫做…「飯糰」的食物，聽說做起來還挺簡單的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700204
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700204,
					"content": "#噢，我處理食材需要一點時間，{F#妳}{M#你}先去旁邊稍等一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				}
			]
		},
