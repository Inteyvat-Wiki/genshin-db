			},
			"dialogs": [
				{
					"id": 721700101,
					"content": "這可下不去啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700102
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700103
					]
				},
				{
					"id": 721700103,
					"content": "旅行者，又見面了。我們正在想怎麼…潛進前面的水裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700104
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700104,
					"content": "然後，去裡面取一點新鮮的海草來，做一種叫做「飯糰」的食物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700105,
						721700107
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700105,
					"content": "在海邊取就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700106
					]
				},
				{
					"id": 721700106,
					"content": "那種在海邊的海草都不太新鮮，用來做菜總感覺少點味道啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700109,
					"content": "我向城裡的人打聽過了，這裡底下生長著一些品質很不錯的海草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700110
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700110,
					"content": "不過今天一來…就看見這裡完全被海水淹沒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700111
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700111,
					"content": "而且我們三個都…完全不會潛水，只能在這裡傻傻看著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700112
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700112,
					"content": "周圍有什麼機關嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700113
					]
				},
				{
					"id": 721700113,
					"content": "那邊有一個機關喔！不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700114
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 721700114,
					"content": "不過那個機關，又被罩在那種屏障裡面了，根本進不去啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700115
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700115,
					"content": "唉，我們繼續在這裡研究一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700116
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700116,
					"content": "#旅行者，要是{F#妳}{M#你}知道怎麼解決這個問題，就請快點過來告訴我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700117
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700117,
					"content": "#當然啦，如果{F#妳}{M#你}能直接把那些海草拿過來的話就更好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700118
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700118,
					"content": "旭東先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700119
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 721700119,
					"content": "#咳！要是{F#妳}{M#你}能直接把那些海草拿來的話，那報酬肯定少不了{F#妳}{M#你}的，還有一頓飯糰大餐奉上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700120
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700120,
					"content": "飯糰到底怎麼能稱得上是「大餐」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700121
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 721700121,
					"content": "哎呀，只要數量夠多就行了…咳，我們還是接著研究吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 721700107,
					"content": "一定要潛進去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721700108
					]
				},
				{
					"id": 721700108,
					"content": "那種在海邊就能採到的海草都不太新鮮，用來做菜總感覺少點味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721700109
					],
					"speakerTitle": "旭東"
				}
			]
		},
