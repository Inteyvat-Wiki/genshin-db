			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"經綸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300101,
					"content": "旅行者，這裡，這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300102
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300103
					]
				},
				{
					"id": 411300103,
					"content": "還是輕策莊的事。因為掉下來的那些隕石，輕策莊周圍的魔物都亂了。它們在路上到處肆虐，輕策莊幾乎都要被它們給圍住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300106
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300106,
					"content": "雖然輕策莊有我們守著，不會出大問題，但是城裡支援過來的物資，還是要從外面過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300107
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300107,
					"content": "現在這個情況，總務司也不可能分出很多人來護送…要是遇見了大群的魔物，只怕物資會有風險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300108
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300108,
					"content": "所以，我和幾個兄弟就尋思著…就算不能離開輕策莊太遠，但是，輕策莊周圍的那些魔物，我們還是能清理一下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300109
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300109,
					"content": "這樣也算是給送物資過來的兄弟幫個忙了。但按照之前我們的偵察，周圍的魔物聚集點還不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300110
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300110,
					"content": "只憑我們的話，很難把這些魔物營地迅速地全部清理乾淨。但如果時間拖太長了，我擔心輕策莊裡說不定也會出問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300111
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300111,
					"content": "#旅行者，{F#妳}{M#你}願意幫我們去清理一部分魔物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "經綸"
				}
			]
		},
		{
			"id": 4113002,
			"completionStepIds": [
				4113003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113003",
							"2"
						],
						"stepId": 4113003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"經綸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300201,
					"content": "不行…必須得要人來支援…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300202
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300202,
					"content": "魔物營地已經清理乾淨了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300203
					]
				},
				{
					"id": 411300203,
					"content": "#好的，謝謝{F#妳}{M#你}。但是剛才又出現了意外情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300204
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300204,
					"content": "我本來以為，在輕策莊周邊徘徊的只有一些普通的魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300205
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300205,
					"content": "我領著幾個人，剛清理完了一個魔物營地，正準備休息一下之後再繼續前進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300206
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300206,
					"content": "但是旁邊的樹林裡，突然出現了一隻丘丘岩盔王…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300207
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300207,
					"content": "我們還沒來得及做出反應，它就襲擊了我們，很多人受了傷…我們只能暫時撤退。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300208
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300208,
					"content": "那隻魔物的威脅太大了，絕不能坐視不管。但去其他地方清理魔物營地的人還沒回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300209
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300209,
					"content": "#旅行者，{F#妳}{M#你}願意幫忙去打倒那個魔物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300210,
						411300212
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300210,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300211
					]
				},
				{
					"id": 411300211,
					"content": "#那就拜託{F#妳}{M#你}了，真是不好意思…這本來是我們的職責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300212,
					"content": "受傷的人沒事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300213
					]
				},
				{
					"id": 411300213,
					"content": "還好治療及時，都沒什麼大礙…但一時半會是沒法自如行動了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300214
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300214,
					"content": "#所以，只能拜託{F#妳}{M#你}去打倒那個魔物了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300215
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300215,
					"content": "真是不好意思…這本來是我們的職責…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "經綸"
				}
			]
		},
