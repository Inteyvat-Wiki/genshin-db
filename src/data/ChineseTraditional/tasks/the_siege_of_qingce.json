			"dialogs": [
				{
					"id": 411300401,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300402
					]
				},
				{
					"id": 411300402,
					"content": "太好了。那我先去叫其他人，我們馬上出發，速戰速決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300403
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300403,
					"content": "把魔物營地清理乾淨之後，我們再回來這裡碰頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "經綸"
				}
			]
		},
		{
			"id": 4113005,
