			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"經綸"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411300601,
					"content": "#怎麼樣，{F#妳}{M#你}把那隻魔物打倒了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300602
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300602,
					"content": "已經打倒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411300603
					]
				},
				{
					"id": 411300603,
					"content": "太好了…這樣子總算能緩口氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300604
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300604,
					"content": "#謝謝{F#妳}{M#你}幫忙，旅行者，這些東西請收下吧，就當是謝禮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300605
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300605,
					"content": "但輕策莊周圍為什麼會突然出現這種魔物，真是奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300606
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300606,
					"content": "算了，不管怎麼樣，我都得向總務司報告一下這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411300607
					],
					"speakerTitle": "經綸"
				},
				{
					"id": 411300607,
					"content": "希望總務司能再調一些人過來支援…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "經綸"
				}
			]
		}
