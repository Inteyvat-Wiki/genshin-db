			"dialogs": [
				{
					"id": 250340101,
					"content": "牠不喜歡你們，走開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340102
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340102,
					"content": "臭小子…你認識這隻龍嗎？你們是什麼關係？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340103
					],
					"speakerTitle": "不耐煩的賊匪"
				},
				{
					"id": 250340103,
					"content": "嗚…嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340104
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250340104,
					"content": "你看看，這隻龍都不耐煩了。小子，滾一邊去，我們不打小孩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340105
					],
					"speakerTitle": "不耐煩的賊匪"
				},
				{
					"id": 250340105,
					"content": "兄弟，把袋子拿過來。哼哼，這隻小龍絕對可以賣個好價錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340106
					],
					"speakerTitle": "不耐煩的賊匪"
				},
				{
					"id": 250340106,
					"content": "不許過來！再過來我就要動手了喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340107
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340107,
					"content": "動…動手？你？哈哈哈哈哈哈，兄弟，他要和我們動手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340108
					],
					"speakerTitle": "不耐煩的賊匪"
				},
				{
					"id": 250340108,
					"content": "我好怕喔，小子。但既然你都放話了，那就別怪我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340109
					],
					"speakerTitle": "不耐煩的賊匪"
				},
				{
					"id": 250340109,
					"content": "嗚！嗚嗚！嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340110
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250340110,
					"content": "嘖，這小龍還滿凶的…小子，你就好好睡一覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340111,
						250340112
					],
					"speakerTitle": "不耐煩的賊匪"
				},
				{
					"id": 250340111,
					"content": "要睡一覺的是你們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				},
				{
					"id": 250340113,
					"content": "#{M#大哥哥}{F#大姐姐}！他們是壞蛋！想要搶走奇卡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340114
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340114,
					"content": "嗚嗚！嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340115
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250340115,
					"content": "#…路過的好漢，只要{F#妳}{M#你}不管這件事，哥們承{F#妳}{M#你}的情，事成後分{F#妳}{M#你}一份錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340116,
						250340117
					],
					"speakerTitle": "不耐煩的賊匪"
				},
				{
					"id": 250340116,
					"content": "不許傷害奇卡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340118,
					"content": "那就是沒得談了。可以，那就還是道上規矩，我們手上見真章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340119
					],
					"speakerTitle": "不耐煩的賊匪"
				},
				{
					"id": 250340119,
					"content": "嘿嘿…兄弟們給我上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "不耐煩的賊匪"
				},
				{
					"id": 250340117,
					"content": "誰說輪到你了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340118
					]
				},
				{
					"id": 250340112,
					"content": "那你們也別怪我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340113
					]
				}
			]
		},
