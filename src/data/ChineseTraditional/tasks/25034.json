			},
			"dialogs": [
				{
					"id": 250340501,
					"content": "#{M#大哥哥}{F#大姐姐}，謝謝{F#妳}{M#你}救了我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340502
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340502,
					"content": "嗚，嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340503
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250340503,
					"content": "#這裡離部族太遠我都沒辦法通知伊萊帕姐姐，要是{F#妳}{M#你}沒來，奇卡絕對會被抓走的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340504
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340504,
					"content": "你來這裡做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250340505
					]
				},
				{
					"id": 250340505,
					"content": "我們還是來這裡訓練爬山，但訓練到一半的時候我們肚子都餓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340506
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340506,
					"content": "所以我就和奇卡去摘果子，沒想到一邊摘果子，一邊走太遠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340507
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340507,
					"content": "等到我們吃飽的時候已經走了好遠，回去鐵定又要被媽媽唸了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340508
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340508,
					"content": "#再次謝謝{F#妳}{M#你}救了我，{M#大哥哥}{F#大姐姐}，這些「苦種」給{F#妳}{M#你}，都是我剛摘下來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340509
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340509,
					"content": "我們快點回去吧，奇卡，走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250340510
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250340510,
					"content": "嗚！嗚嗚！嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇卡"
				}
			]
		}
	]
