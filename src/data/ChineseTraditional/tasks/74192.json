				},
				{
					"id": 741920402,
					"content": "夏諾蒂拉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920403
					]
				},
				{
					"id": 741920403,
					"content": "#咦？{F#妳}{M#你}終於回來了！嗚嗚！我好擔心，要是{F#妳}{M#你}一直回不來要怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920404
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920404,
					"content": "#{F#妳}{M#你}進去以後，我一直在外面等，等了好久、好久。我去找別的美露莘幫忙，但大家都不知道怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920405
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920405,
					"content": "（…看來我也在這裡待得夠久了。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920406
					]
				},
				{
					"id": 741920406,
					"content": "我該走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920407
					]
				},
				{
					"id": 741920407,
					"content": "#咦？{NICKNAME}，{F#妳}{M#你}要去哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920408
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920408,
					"content": "不用擔心。我找到夏諾蒂拉就回來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920409
					]
				},
				{
					"id": 741920409,
					"content": "再稍微等我一下，好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920410
					]
				},
				{
					"id": 741920410,
					"content": "雖然我知道，對妳說這些也沒用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920411,
						741920412
					]
				},
				{
					"id": 741920411,
					"content": "不過，相信我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920413
					]
				},
				{
					"id": 741920413,
					"content": "#{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920412,
					"content": "毋須擔心。",
					"roleType": "TALK_ROLE_PLAYER",
