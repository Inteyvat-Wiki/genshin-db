				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741920101,
					"content": "我看見：王座上的火焰已經熄滅，燒卻的灰燼重新變成了樹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920102
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920102,
					"content": "#花朵隨著{F#妳}{M#你}的腳步綻放，{F#妳}{M#你}能為必然頹敗的未來帶來變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920103
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920103,
					"content": "夏諾蒂拉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920104
					]
				},
				{
					"id": 741920104,
					"content": "#咦！原來是{NICKNAME}{M#哥哥}{F#姐姐}！{F#妳}{M#你}怎麼會在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920105
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920105,
					"content": "啊！對了！金色的蝴蝶已經回來了，要趕快去看看才行！再見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏諾蒂拉"
				}
			]
		},
		{
