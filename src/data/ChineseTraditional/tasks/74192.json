				"points": []
			},
			"dialogs": [
				{
					"id": 741920301,
					"content": "既然記憶能被製作成書，那麼反過來，書本中的內容，應該也能被直接寫入記憶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920302
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920302,
					"content": "夏諾蒂拉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920303
					]
				},
				{
					"id": 741920303,
					"content": "#啊！是奇奇怪怪的{NICKNAME}{M#哥哥}{F#姐姐}。怎麼了，找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920304
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920304,
					"content": "妳在說什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920305
					]
				},
				{
					"id": 741920305,
					"content": "嗯…不管怎麼想，將「記憶」製作成書本都是相當不可思議的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920306
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920306,
					"content": "製作這本書的人，一定將「記{RUBY#[D]妄想}憶」中的心情當作最為珍貴的事物，才能做出這樣的書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920307
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920307,
					"content": "不過這樣子的書是真的很難懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920308
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920308,
					"content": "…而且，也不知道會對「讀者」產生什麼樣的影響。這還真的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏諾蒂拉"
				}
			]
		},
