			},
			"dialogs": [
				{
					"id": 741920201,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920202
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920202,
					"content": "夏諾蒂拉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920203
					]
				},
				{
					"id": 741920203,
					"content": "#咦？{M#哥哥}{F#姐姐}…{F#妳}{M#你}是誰？我還以為，這裡除了我誰也進不來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920204
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920204,
					"content": "#{F#妳}{M#你}為什麼知道我的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920205,
						741920207
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920205,
					"content": "我們認識。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920206
					]
				},
				{
					"id": 741920206,
					"content": "#騙人！{F#妳}{M#你}一定也和那些怪物一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920207,
					"content": "（說謊）是瑟琳讓我來找妳的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920208
					]
				},
				{
					"id": 741920208,
					"content": "是喔…老是讓她這麼擔心，我真是個壞孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920209
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920209,
					"content": "#我是{NICKNAME}，妳還記得嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920210
					]
				},
				{
					"id": 741920210,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}，我想起來了…雖然是個一口能吞下世界的大怪獸，但是很善良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920211,
						741920213
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920211,
					"content": "真沒禮貌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920212
					]
				},
				{
					"id": 741920212,
					"content": "對不起喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920214
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920214,
					"content": "發生什麼事情了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920215
					]
				},
				{
					"id": 741920215,
					"content": "我看到，有幾個人，他們慢慢融化、變成了怪物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741920216
					],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920216,
					"content": "啊啊！好可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏諾蒂拉"
				},
				{
					"id": 741920213,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741920214
					]
				}
			]
		},
		{
