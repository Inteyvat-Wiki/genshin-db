				"points": []
			},
			"dialogs": [
				{
					"id": 3980401,
					"content": "來了來了，熱鬧起來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980402
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 3980402,
					"content": "危機啊，災難啊！冒險啊，熱血啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980403
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 3980403,
					"content": "冒險家協會！終於！要脫離那些抓貓抓狗的瑣碎委託了！新的冒險時代就要來臨了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980404
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 3980404,
					"content": "年輕人啊，快來加入冒險家協會吧！在這動盪的時期，共赴龍災，拯救蒙德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980405
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 3980405,
					"content": "這個嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980406
					]
				},
				{
					"id": 3980406,
					"content": "#…啊，{F#妳}{M#你}說什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980407
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 3980407,
					"content": "龍災的問題解決了？我錯過了代理團長的演講？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980408
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 3980408,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980409
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 3980409,
					"content": "風魔龍為什麼不能再堅持一下啊！我們還沒出場呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽琉斯"
				}
			]
		},
		{
			"id": 39807,
			"completionStepIds": [
				39807
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
