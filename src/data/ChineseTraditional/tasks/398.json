			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莎拉",
					"凱亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980701,
					"content": "啊，客人今天要點些什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980702
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 3980702,
					"content": "唉…真是無情啊，就這樣無視了我這個「摯友」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980703,
						3980705
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980703,
					"content": "不小心把你看漏了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980704
					]
				},
				{
					"id": 3980704,
					"content": "#哈哈哈…看來大戰之後，{F#妳}{M#你}不僅是實力成長了，還具備了騎士「幽默」的美德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980707,
					"content": "蒙德的新晉英雄站在我的面前，身為騎士，感覺真是士氣大振啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980708
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980708,
					"content": "凱亞又在花言巧語了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980709,
					"content": "哈哈，我說的可都是真心話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980710,
						3980714
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980710,
					"content": "你在這邊做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980711
					]
				},
				{
					"id": 3980711,
					"content": "我正準備找個清靜些的地方，好好整理一下思緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980712
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980712,
					"content": "明明其他騎士都在辛苦地打掃戰場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980713,
					"content": "思考也是一件辛苦的差事啊，我倒覺得清理那些垃圾更輕鬆一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980717,
					"content": "嗯？那你在思考些什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980718,
					"content": "是關於…深淵教團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980719
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980719,
					"content": "龍災肆虐，騎士團長身在遠方、討伐巨龍，這對深淵教團來說，是非常好的戰略機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980720
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980720,
					"content": "#如果{F#妳}{M#你}是深淵教團的怪物，{F#妳}{M#你}會只派丘丘人來「抓住這個好機會」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980721,
						3980722
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980721,
					"content": "只有丘丘人進攻，的確奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980723,
					"content": "為了看清真相，我的決定是等待——等著觀察他們的進一步行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980724
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980724,
					"content": "#直到{F#妳}{M#你}們把風龍廢墟搞得天昏地暗，丘丘人的喊聲在城門響起的那天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980725
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980725,
					"content": "我終於在蒙德城裡，發現了可疑的身影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980726
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980726,
					"content": "城裡？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980727,
					"content": "嗯，其他騎士在城外禦敵的時候，不就是城內防禦最空虛的時候嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980728
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980728,
					"content": "所以，留守城中的我，就與深淵教團的潛入者…周旋了一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980729
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980729,
					"content": "透過一些小手段，我獲得了新的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980730
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980730,
					"content": "情報是：這些集結起來的深淵教團怪物，在它們背後，還有一位統領者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980731
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980731,
					"content": "深淵教團的…統領者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980732,
					"content": "將特瓦林改造成戰爭兵器的計畫，也是那位統領者所謀劃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980733
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980733,
					"content": "用什麼樣的「小手段」，才能打聽出這些啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980734,
					"content": "#呵呵呵…{F#妳}{M#你}們可以認為是我在「語言」方面的天然才華吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980735
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980735,
					"content": "#那位統領者，被深淵教團的怪物稱為…「{F#王子}{M#公主}殿下」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980736
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980736,
					"content": "#「{F#王子}{M#公主}」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980737
					]
				},
				{
					"id": 3980737,
					"content": "好了，情報分享就先到這裡，我好像看到安柏正在向這邊過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980738
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980738,
					"content": "沒去城門陪她一起禦敵，她好像還在生我的氣…請容我先離開一下，避避風頭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980739
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980739,
					"content": "凱亞那個傢伙居然跑掉了！做賊心虛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980740,
						3980742
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980740,
					"content": "其實他也在暗地裡努力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980741
					]
				},
				{
					"id": 3980741,
					"content": "是這樣嗎？唔…該不會你被他的什麼花言巧語騙了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980744,
					"content": "算了，先不提他啦。累了這麼久，我已經肚子咕咕叫了，還是先點菜吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980745
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980745,
					"content": "莎拉小姐，我要「蜜醬胡蘿蔔煎肉」——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980742,
					"content": "對！真是個壞傢伙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980743
					]
				},
				{
					"id": 3980743,
					"content": "是呀，騎兵隊長居然這麼不以身作則，哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980744
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980722,
					"content": "那麼，真相是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980723
					]
				},
				{
					"id": 3980714,
					"content": "你又在打什麼主意？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980715
					]
				},
				{
					"id": 3980715,
					"content": "我嗎？不不，恰恰相反，我在思考「別人」正在打什麼主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980716
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980716,
					"content": "我正準備找個清靜些的地方，好好整理一下思緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980717
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 3980705,
					"content": "是你啊，我的摯友凱亞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980706
					]
				},
				{
					"id": 3980706,
					"content": "哦~我的熱情得到回應了，這就是真誠的魅力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980707
					],
					"speakerTitle": "凱亞"
				}
			]
		},
		{
			"id": 39809,
			"completionStepIds": [
				39809
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39809",
							"2"
						],
						"stepId": 39809,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980901,
					"content": "#既然龍災已經告一段落，{F#妳}{M#你}們接下來有什麼安排呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980902
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980902,
					"content": "#大概會離開蒙德，繼續以走遍七國為目標，尋找{F#她}{M#他}親人的線索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980903,
					"content": "這樣啊…那也就是說要暫時分別了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980904,
						3980905
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980904,
					"content": "我也捨不得離開蒙德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				},
				{
					"id": 3980906,
					"content": "#沒關係！不管去了哪裡，只要是風能夠吹到的地方，{F#妳}{M#你}永遠都是西風騎士團的戰友，是榮譽騎士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980907,
						3980908
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980907,
					"content": "聽憑風引！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980909,
					"content": "#嗯！蒙德隨時歡迎{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980910
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980910,
					"content": "嘿嘿，我們快點吃吧，再多聊一會，肉就要涼啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980911
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980911,
					"content": "嗯——好吃。不愧是安柏的推薦菜，沒讓我白白期待呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980912,
					"content": "那當然啦，雖然我對廚藝沒什麼自信，但我的品味還是很不錯的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980913
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980913,
					"content": "#啊，對了，差點忘記告訴{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980914
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980914,
					"content": "#琴團長正在<color=#00E1FFFF>大教堂</color>等{F#妳}{M#你}，好像是關於天空之琴的事…還是趕快去一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980908,
					"content": "以後一定會回來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980909
					]
				},
				{
					"id": 3980905,
					"content": "我也捨不得騎士團的大家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980906
					]
				}
			]
