			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"寧錄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980301,
					"content": "#謝謝{F#妳}{M#你}們！這一切終於真正地結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980302
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 3980302,
					"content": "受龍災的影響，好多商路都不通了。糧食水果也就算了…酒要是斷了貨，那可是真的要命囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980303
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 3980303,
					"content": "我沒辦法想像沒有酒喝的日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980304
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 3980304,
					"content": "唉，希望商道的修復可以快點完成吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寧錄"
				}
			]
		},
