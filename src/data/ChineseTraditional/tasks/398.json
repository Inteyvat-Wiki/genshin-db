	"talks": [
		{
			"id": 39801,
			"completionStepIds": [
				39801
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39801",
							"2"
						],
						"stepId": 39801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3980101,
					"content": "#啊，是{F#妳}{M#你}們！榮譽騎士凱旋歸來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980102,
					"content": "#嘿嘿，{NICKNAME}陪特瓦林好好胡鬧了一番呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980103,
					"content": "#嗯，{F#妳}{M#你}們是昨天回來的吧？琴團長比{F#妳}{M#你}們先回蒙德，{F#妳}{M#你}們的事蹟，她都已經告訴大家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980104
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980104,
					"content": "呼…我什麼時候也能有這樣的機會呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980105,
						3980108
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980105,
					"content": "多虧了安柏的引薦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980106
					]
				},
				{
					"id": 3980106,
					"content": "#不對不對，事情能這樣和平解決，是多虧了{F#妳}{M#你}們才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980107
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980107,
					"content": "#那時我把{F#妳}{M#你}們帶來蒙德，也只是普通地盡了偵察騎士的職責而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980111,
					"content": "哼哼，不用客氣——對了，安柏是在這裡等我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980112,
					"content": "呃，雖然我這次的任務不是出征，但也沒那麼閒啦…妳看，正在忙著做善後工作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980113,
					"content": "「善後工作」？蒙德城這邊發生什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980114,
					"content": "嗯…趁我們沒有琴團長指揮的時候，附近的魔物向蒙德城發動了「總攻」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980115
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980115,
					"content": "好在很早之前我就偵察到了動向，丘丘人的聚落不自然地向蒙德城附近遷移。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980116
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980116,
					"content": "啊，我還記得。我們第一次見面的時候，妳正在清理其中一個營地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980117,
					"content": "對，如果不是我們之前早有準備，蒙德城就會陷入危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980118,
						3980121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980118,
					"content": "成功擊退了就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980119
					]
				},
				{
					"id": 3980119,
					"content": "嗯，可是事情依舊蹊蹺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980120
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980120,
					"content": "丘丘人應該沒有發動總攻的組織能力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980123,
					"content": "所以我們猜測，這背後也是深淵教團在搞鬼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980124
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980124,
					"content": "他們操縱了那些丘丘人嗎？嗯…如果我們不去解救特瓦林，那特瓦林也會像這樣被操縱吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980125,
					"content": "沒錯。身為偵察騎士，看來今後要想辦法多多監視深淵教團的傢伙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980126
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980126,
					"content": "#啊，真是不好意思。明明{F#妳}{M#你}們才剛經歷大戰歸來，我就又說起這些嚴肅的話題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980127
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980127,
					"content": "#對了！我記得之前有過約定，要請{F#妳}{M#你}們吃「蜜醬胡蘿蔔煎肉」的，可是後來一直在忙龍災的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980128
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980128,
					"content": "#不如這次就當作慶功，我來請{F#妳}{M#你}們吃吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980129
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980129,
					"content": "好耶！就算安柏忘了，派蒙也不會忘的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3980130,
					"content": "嘿嘿，我也好久沒吃「蜜醬胡蘿蔔煎肉」了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980131
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980131,
					"content": "#{F#妳}{M#你}們先去<color=#00E1FFFF>「獵鹿人」</color>等我吧，等戰場打掃完了，我就過去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980121,
					"content": "可是為什麼丘丘人會…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980122
					]
				},
				{
					"id": 3980122,
					"content": "是很奇怪，丘丘人應該沒有發動總攻的組織能力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980123
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980108,
					"content": "希望這樣的「機會」不要太多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3980109
					]
				},
				{
					"id": 3980109,
					"content": "啊…說得也對，畢竟和平來之不易嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980110
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3980110,
					"content": "#這次也是多虧了{F#妳}{M#你}們，事情才能這樣和平解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3980111
					],
					"speakerTitle": "安柏"
				}
			]
		},
