			"dialogs": [
				{
					"id": 220320601,
					"content": "咦？這、這道菜的味道怎麼…這麼…這麼微妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320602
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320602,
					"content": "也不能說是微妙…應該是說…奇異，還是什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320603
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320603,
					"content": "#居然能做出這樣的菜，{F#妳}{M#你}的廚藝還真是…另闢蹊徑呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320604
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320604,
					"content": "#辛苦{F#妳}{M#你}了！旅行者，這些東西請收下吧，這道菜我稍後…稍後再細細品嚐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
