			"dialogs": [
				{
					"id": 220320701,
					"content": "所以說，要準備哪一道用魚做成的菜呢？不如我們替她挑選一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220320702,
					"content": "我想想…我最近喜歡的魚有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220320703,
					"content": "麻辣口的水煮黑背鱸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220320704,
					"content": "酸甜口的松鼠魚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220320705,
					"content": "還有萬能的蒙德烤魚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220320706,
					"content": "這都是妳愛吃的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320707
					]
				},
				{
					"id": 220320707,
					"content": "嘿嘿，沒問題的，你就相信我的品味吧，快來選一樣~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320708,
						220320710,
						220320712,
						220320714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220320708,
					"content": "那就水煮黑背鱸吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320709
					]
				},
				{
					"id": 220320709,
					"content": "聽起來很棒！我們就趕緊做一份水煮黑背鱸給湯雯小姐吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220320710,
					"content": "那就松鼠魚吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320711
					]
				},
				{
					"id": 220320711,
					"content": "好耶！我們就趕緊做一份松鼠魚給湯雯小姐吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220320712,
					"content": "那就蒙德烤魚吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320713
					]
				},
				{
					"id": 220320713,
					"content": "真不錯！我們就趕緊做一份蒙德烤魚給湯雯小姐吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220320714,
					"content": "我再想想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320715
					]
				},
				{
					"id": 220320715,
					"content": "嗯~想好了就趕緊做給湯雯小姐吧！",
