					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320101,
					"content": "唔…要是能吃到璃月菜就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320102
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320102,
					"content": "妳怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320103
					]
				},
				{
					"id": 220320103,
					"content": "#{F#妳}{M#你}是？這身打扮…{F#妳}{M#你}就是旅行者吧。抱歉，我只是有點想家而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320104,
						220320105
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320104,
					"content": "妳剛剛說想吃璃月菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				},
				{
					"id": 220320118,
					"content": "#欸？莫非…{F#妳}{M#你}會做璃月菜嗎？那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320119
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320119,
					"content": "#那、那就請{F#妳}{M#你}快點幫幫我，做點正宗的璃月菜給我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320120
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320120,
					"content": "讓我想想…我現在的最想吃的就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320121
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320121,
					"content": "嗯…我想要吃魚！想起小時候媽媽做的魚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320122
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320122,
					"content": "魚身洗淨，兩邊打上花刀，塞入香料和老酒稍加醃漬，入鍋煎至兩面金黃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320123
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320123,
					"content": "再加熱水和醬料燉煮，最後大火調味收汁，勾芡裝盤…啊！那可是真真正正的色香味俱全！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320124
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320124,
					"content": "還小的弟弟在旁邊聞著，都拍手跳著直叫：「正好！正好！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320125
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320125,
					"content": "嗚…我媽媽可會燒魚了，但我什麼時候才能回去吃呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320105,
					"content": "遇到什麼麻煩了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320106
					]
				},
				{
					"id": 220320106,
					"content": "先自我介紹一下，我叫湯雯，是來自璃月的歷史學者，之前正在實地調研稻妻的特色風俗與民話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320107
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320107,
					"content": "本來資料已經蒐集得差不多了，正準備返回璃月。但是因為稻妻的鎖國令結被迫滯留在這裡，已經有一段時間了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320108
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320108,
					"content": "其實，我覺得這對我來說也算是好事。因為我感覺，此刻的稻妻正處於一個歷史性的時刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320109
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320109,
					"content": "我很確信，這段特殊的時期，必然會在提瓦特的史冊上留下濃墨重彩的一筆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320110
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320110,
					"content": "親眼見證這樣的歷史，然後真實、完整、清晰地將這一切記錄成冊，留給後人，就是歷史學者所要做的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320111
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320111,
					"content": "不過…雖然這樣的事業很讓我振奮，但它可沒辦法滿足我的肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320112
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320112,
					"content": "妳是餓了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320113
					]
				},
				{
					"id": 220320113,
					"content": "也不能說…是餓啦…哈哈哈，稻妻的食物都還挺好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320114
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320114,
					"content": "我特別喜歡這邊的「天婦羅」，雖然感覺…就是把東西裹上麵衣炸一炸啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320115
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320115,
					"content": "但是吃久了稻妻菜，我還是想要再吃點璃月菜。不過，我一直都找不到能做出正宗璃月菜的餐館。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320116
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320116,
					"content": "我前幾天都狠下心來，去冒險家協會掛了一道「烹飪委託」，但到現在也沒回音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320117
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320117,
					"content": "我可以試試嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320118
					]
				}
			]
		},
		{
