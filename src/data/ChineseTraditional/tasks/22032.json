			},
			"dialogs": [
				{
					"id": 220320201,
					"content": "#這麼快就回來了？{F#妳}{M#你}不會是個深藏不露的大廚吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320202
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320202,
					"content": "嗯…我都快要等不及了，請讓我嚐一嚐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320203,
						220320204
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320203,
					"content": "請享用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 220320204,
					"content": "我想想…剛剛討論了哪些菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320205
					]
				},
				{
					"id": 220320205,
					"content": "唔…是松鼠魚，水煮黑背鱸，還有蒙德烤魚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220320206,
					"content": "決定好就交給湯雯小姐吧!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
