			"trigger": {
				"objectNames": [
					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320801,
					"content": "唔…要是能吃到璃月菜就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320802
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320802,
					"content": "妳怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320803
					]
				},
				{
					"id": 220320803,
					"content": "#{F#妳}{M#你}是？這身打扮…{F#妳}{M#你}就是旅行者吧。抱歉，我只是有點想家而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320804,
						220320805
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320804,
					"content": "妳剛剛說想吃璃月菜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				},
				{
					"id": 220320818,
					"content": "#欸？莫非…{F#妳}{M#你}會做璃月菜嗎？那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320819
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320819,
					"content": "#那、那就請{F#妳}{M#你}快點幫幫我，做點正宗的璃月菜給我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320820
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320820,
					"content": "讓我想想…我現在的最想吃的就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320821
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320821,
					"content": "嗯…我想要吃魚！想起小時候媽媽做的魚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320822
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320822,
					"content": "魚身洗淨，兩邊打上花刀，塞入香料和老酒稍加醃製，入鍋煎至兩面金黃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320823
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320823,
					"content": "再加熱水和醬料燉煮，最後大火調味收汁，勾芡裝盤…啊！那可是真真正正的色香味俱全！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320824
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320824,
					"content": "還小的弟弟在旁邊聞著，都拍手跳著直叫：「正好！正好！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320825
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320825,
					"content": "嗚…我媽媽可會燒魚了，但我什麼時候才能回去吃呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320805,
					"content": "遇到什麼麻煩了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320806
					]
				},
				{
					"id": 220320806,
					"content": "先自我介紹一下，我叫湯雯，是來自璃月的歷史學者，之前正在實地調研稻妻的特色風俗與民話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320807
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320807,
					"content": "本來資料已經搜集的差不多了，正準備返回璃月。但是因為最近稻妻發生了很多大事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320808
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320808,
					"content": "我感覺，此刻的稻妻正處於一個歷史性的時刻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320809
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320809,
					"content": "這段特殊的時期，必然會在提瓦特的史冊上留下濃墨重彩的一筆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320810
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320810,
					"content": "親眼見證這樣的歷史，然後真實、完整、清晰地將這一切記錄成冊，留給後人，就是歷史學者所要做的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320811
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320811,
					"content": "不過…雖然這樣的事業很讓我振奮，但它可沒辦法滿足我的肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320812
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320812,
					"content": "妳是餓了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320813
					]
				},
				{
					"id": 220320813,
					"content": "也不能說…是餓啦…哈哈哈，稻妻的食物都還挺好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320814
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320814,
					"content": "我特別喜歡這邊的「天婦羅」，雖然感覺…就是把東西裹上麵衣炸一炸啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320815
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320815,
					"content": "但是吃久了稻妻菜，我還是想要再吃點璃月菜。不過，我一直都找不到能做出正宗璃月菜的餐館。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320816
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320816,
					"content": "我前幾天都狠下心來，去冒險家協會掛了一道「烹飪委託」，但到現在也沒回音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320817
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320817,
					"content": "我可以試試嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220320818
					]
				}
			]
		}
	]
}