					"湯雯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220320301,
					"content": "啊！沒錯！這、這就是我夢寐以求的家鄉味道啊…真是…嗚嗚…真是令人感動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320302
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320302,
					"content": "#謝謝{F#妳}{M#你}！有了這些好吃的，我也能提起勁了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220320303
					],
					"speakerTitle": "湯雯"
				},
				{
					"id": 220320303,
					"content": "#這些送給{F#妳}{M#你}，祝{F#妳}{M#你}往後的旅程順遂無憂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "湯雯"
				}
			]
		},
		{
			"id": 2203204,
			"completionStepIds": [
				2203204
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
