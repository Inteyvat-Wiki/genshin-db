				"objectNames": [
					"蘭利遮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500201,
					"content": "#那菈{NICKNAME}和派蒙！想讓桓那「生病」的壞傢伙沒有再來了，現在放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500202
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730500202,
					"content": "#謝謝那菈{NICKNAME}和派蒙幫忙，蘭利遮才能保護桓那…所以，蘭利遮給那菈{NICKNAME}還有派蒙花花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500203
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730500203,
					"content": "收下花花吧，蘭利遮的好朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭利遮"
				}
			]
		},
		{
			"id": 7305003,
			"completionStepIds": [
