			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"蘭般度"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500101,
					"content": "#那菈{NICKNAME}還有派蒙！多虧{F#妳}{M#你}們幫忙，法留納神機現在很好，善見地也很好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500102
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730500102,
					"content": "蘭那羅都回到桓那蘭那，慶祝無憂節，像歸巢的鳥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500103
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730500103,
					"content": "生氣的雨變回了溫柔的雨，蘭那庫拉也可以安心照看苗圃，培育毗波耶，高興的毗波耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500104
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730500104,
					"content": "高興的毗波耶做高興的燈，高興的燈點綴高興的無憂節…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500105
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730500105,
					"content": "#那菈{NICKNAME}和派蒙，苗圃現在很好，無憂節也很開心，謝謝{F#妳}{M#你}們幫忙，治好法留納神機，讓蘭那庫拉回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500106
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730500106,
					"content": "那就好！嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730500107,
					"content": "這麼說來，有個事情還挺在意的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500108
					]
				},
				{
					"id": 730500108,
					"content": "那菈法留納為什麼叫那菈法留納？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500109
					]
				},
				{
					"id": 730500109,
					"content": "嗯嗯。因為那個那菈，是幫助我們治好法留納神機的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500110
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730500110,
					"content": "#那{M#她}{F#他}的名字叫什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500111
					]
				},
				{
					"id": 730500111,
					"content": "唔…不知道耶，那菈法留納，一直都沒說過名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500112,
						730500113
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730500112,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				},
				{
					"id": 730500114,
					"content": "#那菈{NICKNAME}也幫了好多好多忙，是勇敢的那菈，戰勝很多困難。我們一起在無憂節，很高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500115
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730500115,
					"content": "#我們有東西想交給那菈{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500116
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730500116,
					"content": "是表達蘭那羅的感謝的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500117
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730500117,
					"content": "#那菈{NICKNAME}一定會喜歡的，派蒙也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500118
					],
					"speakerTitle": "蘭那庫拉"
				},
				{
					"id": 730500118,
					"content": "蘭那羅的花，送給勇敢的那菈，還有派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500119
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730500119,
					"content": "#蘭伽盧也有小花，不是毗波耶，但是送給那菈{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500120
					],
					"speakerTitle": "蘭伽盧"
				},
				{
					"id": 730500120,
					"content": "#謝謝那菈{NICKNAME}和派蒙為桓那做過的一切，蘭那羅不會忘記朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730500113,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730500114
					]
				}
			]
		},
