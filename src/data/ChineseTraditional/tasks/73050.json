			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"蘭納迦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730500301,
					"content": "無憂節…懷念的感覺…唔？白蓬蓬飛飛…還有金色的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500302
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730500302,
					"content": "是那菈朋友，和那菈朋友的朋友，希望在無憂節過得開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730500303
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730500303,
					"content": "朋友的朋友也是朋友！金色的那菈，還有飛飛白毛都是蘭迦魯的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭迦魯"
				}
			]
		}
	]
