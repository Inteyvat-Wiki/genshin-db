				"points": []
			},
			"dialogs": [
				{
					"id": 710590301,
					"content": "#{F#妳}{M#你}們回來了，我還有些火水可以分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590302
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590302,
					"content": "#哈哈…沒有要{F#妳}{M#你}們陪我喝酒啦，如果{F#妳}{M#你}們受傷的話，火水也可以用來清潔傷口的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590303
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590303,
					"content": "怎麼樣？有何收穫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590304
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590304,
					"content": "我們找到了這些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7105904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_A_AND_ETCOR",
				"conditions": [
					{
