			"trigger": {
				"objectNames": [
					"卡塔琳娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710580601,
					"content": "我要休息了，舊傷還在痛…抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710580602
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710580602,
					"content": "#有事的話，請改天再來找我吧…我正好也有事要拜託{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				}
			]
		},
		{
			"id": 7105901,
			"completionStepIds": [
				7105901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105901",
							"2"
						],
						"stepId": 7105901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"卡塔琳娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590101,
					"content": "#{F#妳}{M#你}們來了！請隨便坐坐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590102
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590102,
					"content": "#抱歉，之前急匆匆把{F#妳}{M#你}們趕走，也沒有說清楚要請{F#妳}{M#你}們幫什麼忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590103,
						710590104
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590103,
					"content": "沒關係，妳請說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590107
					]
				},
				{
					"id": 710590107,
					"content": "#放心吧，我不會讓{F#妳}{M#你}們做壞事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590108,
						710590109
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590108,
					"content": "那妳請說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590113
					]
				},
				{
					"id": 710590113,
					"content": "是這樣的…我的科利亞…我的隊員尼古拉和我失散了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590114
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590114,
					"content": "#所以…我想拜託{F#妳}{M#你}尋找他留下的線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590115
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590115,
					"content": "如果他還活著，請帶他回來見我。如果他犧牲了…也請讓我知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590116
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590116,
					"content": "#實在抱歉，拜託{F#妳}{M#你}這樣的事情…但希望{F#妳}{M#你}們能夠考慮一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590117
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590117,
					"content": "這樣呀…我還以為妳要找我們做什麼壞事呢！比如說，給千岩軍搞破壞…什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710590118,
					"content": "千岩軍…為什麼？和他們為敵對我們愚人眾沒有好處的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590119
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590119,
					"content": "妳是什麼意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590120
					]
				},
				{
					"id": 710590120,
					"content": "#我還想問{F#妳}{M#你}…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590121
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590121,
					"content": "等等…我明白了…我們在地面上和璃月人鬧翻了…？這就解釋了為什麼我們的補給會中斷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590122
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590122,
					"content": "可惡…地面上到底發生了些什麼啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590123,
						710590124
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590123,
					"content": "說來話長…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590125,
					"content": "哼…那個之後再說。戰爭就是這樣…敵友瞬息萬變，這就是愚人眾棲身其中的環境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590126
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590126,
					"content": "但我現在…至少是現在，我只關心科利亞一個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590127
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590127,
					"content": "在我們撤退的途中，他和小隊失散了…後來，我回來找他，結果自己也和其他人失散了。唉，真是丟人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590128
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590128,
					"content": "#至於他最後出現的地點…我可以幫{F#妳}{M#你}在地圖上標出位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590129
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590129,
					"content": "他在那裡和我們分開了，他想要引開追擊的敵人…他是個優秀的戰士，我知道他不會死在那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590130
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590130,
					"content": "希望他在那邊留下了線索…希望如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590124,
					"content": "事端是你們挑起的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590125
					]
				},
				{
					"id": 710590109,
					"content": "妳當然不會讓我們壞愚人眾的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590110
					]
				},
				{
					"id": 710590110,
					"content": "對啊，如果我們做的好事對於你們這些壞傢伙來說是壞事的話，妳可不許阻止我們呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710590111,
					"content": "#什麼好事…壞事…我阻止{F#妳}{M#你}們…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590112
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590112,
					"content": "#唉…{F#妳}{M#你}們好煩啊，聽我把話說完好不好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590113
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590104,
					"content": "沒關係，我們還沒答應妳呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710590105
					]
				},
				{
					"id": 710590105,
					"content": "對呀，你們是愚人眾嘛！要是指使我們做壞事的話，我們可不幹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710590106,
					"content": "#噗…{F#妳}{M#你}說的很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590107
					],
					"speakerTitle": "卡塔琳娜"
				}
			]
		},
		{
			"id": 7105902,
