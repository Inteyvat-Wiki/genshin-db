			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590201,
					"content": "「…倒楣，卡佳老姐的巴拉萊卡琴壞掉了。行動事出緊急，不知道是怎麼弄壞的，一定要搶在挨駡前修好…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590202
					],
					"speakerTitle": "尼古拉下士的日誌殘片"
				},
				{
					"id": 710590202,
					"content": "「…五百年前的祖先們就是這樣對抗災變的嗎？大尉說，我們經歷的苦戰相比祖先而言，不過只是零頭而已…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590203
					],
					"speakerTitle": "尼古拉下士的日誌殘片"
				},
				{
					"id": 710590203,
					"content": "（中間許多頁被黑色的物質浸染，清除掉黑色物質後，墨水寫下的字跡也被完全毀掉了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590204
					],
					"speakerTitle": "尼古拉下士的日誌殘片"
				},
				{
					"id": 710590204,
					"content": "「…這裡不能待下去了，那些傢伙可以透過黑色的泥狀物窺視我的行蹤…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590205
					],
					"speakerTitle": "尼古拉下士的日誌殘片"
				},
				{
					"id": 710590205,
					"content": "「…接下來要繼續往反方向前進，把它們再度引向遠離小隊主力的地方…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590206
					],
					"speakerTitle": "尼古拉下士的日誌殘片"
				},
				{
					"id": 710590206,
					"content": "「…東南方的堡壘遺蹟旁邊有一處洞口，或許可以走那條路…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590207
					],
					"speakerTitle": "尼古拉下士的日誌殘片"
				},
				{
					"id": 710590207,
					"content": "「…祝我好運吧，捨我其誰！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼古拉下士的日誌殘片"
				}
			]
		},
		{
			"id": 7105903,
