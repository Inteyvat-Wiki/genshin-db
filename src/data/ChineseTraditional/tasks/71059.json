			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡塔琳娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590401,
					"content": "#{F#妳}{M#你}回來了。請問有什麼發現嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590402
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590402,
					"content": "沒有的話也沒關係的，請隨便休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590403
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590403,
					"content": "#不用在乎我是否著急啦…反正我也有留在這裡養老的計畫，說不定還要拜託{F#妳}{M#你}替我申請退休金呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590404
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710590404,
					"content": "哇，妳這傢伙倒是悠閒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710590405,
					"content": "#哼，{F#妳}{M#你}們再沒什麼新發現的話，我可要在這裡悠閒到老囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				}
			]
		},
		{
			"id": 7105906,
			"completionStepIds": [
				7105907
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105907",
							"2"
						],
						"stepId": 7105907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710590603,
					"content": "咦…這個徽記…就是那個愚人眾傢伙留下的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590601
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710590601,
					"content": "唔…連個人影都沒有，這下我們要怎麼回去交差呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710590602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710590602,
					"content": "嗯，也沒有別的辦法啦，我們回去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7105913,
			"completionStepIds": [
				7105909
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105909",
							"2"
						],
						"stepId": 7105909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡塔琳娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591305,
					"content": "這些是…士官徽章，行動日誌和…筆記？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591306
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591306,
					"content": "請告訴我，科利亞他人在哪裡？他還活著嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591307,
						710591308
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591307,
					"content": "我們沒有找到他，但他可能還活著。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				},
				{
					"id": 710591309,
					"content": "#科利亞不可能丟下我去做逃兵的。{F#妳}{M#你}們…{F#妳}{M#你}們可以放心，我明白的，他是不會臨陣脫逃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591310
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591310,
					"content": "#這些東西，{F#妳}{M#你}們是在哪裡發現的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591311
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591311,
					"content": "東南方一處山洞，我為妳標出來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591312
					]
				},
				{
					"id": 710591312,
					"content": "是一個很邪門的地方，有很多奇怪的怪物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710591313,
					"content": "#謝謝…謝謝{F#妳}{M#你}，我…抱歉……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591314
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591314,
					"content": "我…我希望科利亞犧牲了，我寧願這樣相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591315
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591315,
					"content": "科利亞，請不要讓女皇陛下蒙羞，不要讓我蒙羞……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591316
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591316,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591317
					]
				},
				{
					"id": 710591317,
					"content": "#咳，咳…我沒事的…抱歉，抱歉！把氣氛搞得這麼僵…才想起來，還沒來得及好好感謝{F#妳}{M#你}們呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591318
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591318,
					"content": "#對了，火水…啊，唉…{F#妳}{M#你}們不喝酒的，是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591319
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591319,
					"content": "#我還有些摩拉…還有就是…之前收集的一些物資，反正已經沒有什麼用了，請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591320,
						710591321
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591320,
					"content": "接下來有何打算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591322,
					"content": "#接下來嗎？謝謝關心，不過我不需要再拜託{F#妳}{M#你}幫忙「做壞事」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591323
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591323,
					"content": "嗯…也許我還是會去找我的科利亞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591324
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591324,
					"content": "部隊調防之前他寄給我的信，我還留在身上…對於我來說，這是他還在這世上的最後證據了…我會永遠將它留在身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591325
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591325,
					"content": "如果他還活著…作為女皇陛下的愚人眾，我會獵取那個叛徒的首級，無論他逃到哪裡，藏到什麼時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591326
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591326,
					"content": "如果他已經犧牲了…作為他的姐姐，我也將迎向每一位愚人眾必然面臨的命運，並且為他而自豪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591327
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591327,
					"content": "所謂「捨我其誰」呢…就是這樣的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591328,
						710591330
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591328,
					"content": "如果妳在作惡，而我必須阻止妳呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591329
					]
				},
				{
					"id": 710591329,
					"content": "…我們都有沒得選擇的時候，也都有不得不去做的事情，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591333,
					"content": "#好啦…{F#妳}{M#你}真的太嚴肅了，沒到喝酒年紀的孩子呀，總是有奇奇怪怪的煩惱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591334
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591334,
					"content": "到時候再說吧，到不得不選擇的時候再說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591335
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591335,
					"content": "#不過現在，我要休息了…{F#妳}{M#你}也要睡一會嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591336
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591336,
					"content": "只有一張草鋪，妳叫我們怎麼睡呀？明明是在趕我們走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710591337,
					"content": "#哈哈哈哈哈！那是{F#妳}{M#你}們自己的問題…真可憐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591338
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591338,
					"content": "#不過不管怎樣，我真心感謝{F#妳}{M#你}們幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591330,
					"content": "妳一定要拘泥於愚人眾的立場嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591331
					]
				},
				{
					"id": 710591331,
					"content": "嗯？是呀，很奇怪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591332
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591332,
					"content": "理念呀、立場呀，都是無聊的問題。噗…我的面具下面可不是只有理念，我是怕子彈的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591333
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591321,
					"content": "還需要我幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591322
					]
				},
				{
					"id": 710591308,
					"content": "他可能透過密道逃走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591309
					]
				}
			]
		},
		{
			"id": 7105914,
			"completionStepIds": [
				7105908
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591401,
					"content": "「…成功進入了這處暗室，巨大的機關怪物還在外面遊蕩，似乎在耐心地等待我逃出去，就像掠食者，居心叵測，險惡異常…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591402
					],
					"speakerTitle": "尼古拉下士的筆記"
				},
				{
					"id": 710591402,
					"content": "「…左腿受了重傷，草草包紮了一下，很痛，腫起來了。可能有感染…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591403
					],
					"speakerTitle": "尼古拉下士的筆記"
				},
				{
					"id": 710591403,
					"content": "「…岩穴裡還有另一個出口，不敢確定通往何處。出口的結構很脆弱，如果沒有支撐的話，遇到強大的外力很容易垮塌…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591404
					],
					"speakerTitle": "尼古拉下士的筆記"
				},
				{
					"id": 710591404,
					"content": "「…我被發現了，有人來了。來者是一個…渾身漆黑的…劍士…？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591405
					],
					"speakerTitle": "尼古拉下士的筆記"
				},
				{
					"id": 710591405,
					"content": "「…他，不，它…？似乎堅固的金屬柵欄也攔不住它，看到它的模樣我就知道了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591406
					],
					"speakerTitle": "尼古拉下士的筆記"
				},
				{
					"id": 710591406,
					"content": "「…對不起，卡佳。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼古拉下士的筆記"
				}
			]
		}
	]
}