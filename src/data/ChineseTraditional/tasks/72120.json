			},
			"dialogs": [
				{
					"id": 721200201,
					"content": "希望一切順利，讓這件事快點結束吧，再拖下去不知道會變成什麼樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				}
			]
		},
		{
			"id": 7212003,
			"completionStepIds": [
				7212009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7212009",
							"2"
						],
						"stepId": 7212009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721200301,
					"content": "怎麼樣？您把道路都檢查過了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200302
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721200302,
					"content": "道路已經很通暢了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200303
					]
				},
				{
					"id": 721200303,
					"content": "好。那、那我們過段時間就出發…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200304
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721200304,
					"content": "你是在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200305
					]
				},
				{
					"id": 721200305,
					"content": "我是在…思考！思考可能發生的各種情況，您明白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200306
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721200306,
					"content": "比如進去的時候，發現核心已經被那群瘋子掏出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200307
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721200307,
					"content": "然後那群瘋子還把核心塞進了遺蹟守衛裡，然後這個遺蹟守衛失去控制，把我們全都打飛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200308
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721200308,
					"content": "或者是我們在淨化「御影爐心」的時候，突然蹦出來一個什麼元素生物，一口氣把核心吃下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200309
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721200309,
					"content": "最、最糟糕的就是，要是那個傳說中的大蛇借此復活，那我們可就徹底完蛋了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200310,
						721200311
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721200310,
					"content": "你冷靜一點…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				},
				{
					"id": 721200312,
					"content": "呃…唔，抱歉，我老毛病又犯了，每次都會不由自主地把事情往最壞的那方面想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200313
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721200313,
					"content": "我會好好做一份計畫，等時候到了，我們就正式出發去搞定這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721200314
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721200314,
					"content": "希望一切順利，希望一切順利，希望一切順利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721200311,
					"content": "應該不會那麼誇張…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721200312
					]
				}
			]
		},
