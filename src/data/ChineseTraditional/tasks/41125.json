			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"傑克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411250101,
					"content": "唉…要是我也能去看看就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250102
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250103
					]
				},
				{
					"id": 411250103,
					"content": "#是{F#妳}{M#你}啊。倒也沒發生什麼特別的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250104
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250104,
					"content": "呃，其實也算挺特別的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250105,
						411250108
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250105,
					"content": "是隕石的事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250106
					]
				},
				{
					"id": 411250106,
					"content": "#對，{F#妳}{M#你}也看見了吧，最近一段時間，不斷有隕石從天而降。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250107
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250107,
					"content": "不過…該說是風神護佑，還是單純運氣好呢，隕石一直沒有砸進城裡來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250113,
					"content": "但還有不少的隕石墜落在了野外，而且據說…只要摸到了隕石的人，都會陷入沉睡，怎麼樣都叫不醒的那種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250114
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250114,
					"content": "賽琉斯先生已經發佈委託召集了一些冒險家，一部分去通知那些還留在野外的人進城避難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250115
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250115,
					"content": "另外一部分，則是幫助西風騎士團去確認各處隕石的落點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250116
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250116,
					"content": "然後以落點為中心，向四周搜索援救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250117
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250117,
					"content": "至於我嘛…賽琉斯先生說，我最好還是留在城裡，幫助照顧那些陷入昏睡的人比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250118
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250118,
					"content": "也許是因為我實力沒達標吧…但總是負責這些小事，我也一點變強的機會都沒有嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250119
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250119,
					"content": "#唉，但不管怎麼說，我也得先把分內的事處理好才行…不過旅行者，能請{F#妳}{M#你}幫我個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250120
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250120,
					"content": "#我想請{F#妳}{M#你}幫我去野外看看，搜集一下和那些隕石相關的資訊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250121,
						411250126
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250121,
					"content": "搜集這些做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250122
					]
				},
				{
					"id": 411250122,
					"content": "賽琉斯先生總是說，在開始冒險前，一定要做好萬全的準備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250123
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250123,
					"content": "如果我能說服賽琉斯先生，我已經對現在的情況十分瞭解，也做好了充足的準備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250124
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250124,
					"content": "那麼，說不定他就能讓我也去野外加入調查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250125
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250125,
					"content": "但我現在還得去幫忙照顧那些人，沒機會出去搜集資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250133,
					"content": "#所以，只能拜託{F#妳}{M#你}了，旅行者！請{F#妳}{M#你}幫我去野外調查一下吧，就…去低語森林附近就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250134
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250134,
					"content": "#有收穫的話，就快回來告訴我吧。我能不能去野外加入調查…就全靠{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250126,
					"content": "你想偷偷地…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250127
					]
				},
				{
					"id": 411250127,
					"content": "啊？我偷偷地…沒有！沒有，絕對沒有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250128
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250128,
					"content": "雖然我確實很想去野外調查…但城裡也需要有人幫忙，城裡的事也很重要！我可不能擅離職守…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250129
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250129,
					"content": "哎呀，就是…賽琉斯先生總說，在開始冒險前，一定要做好萬全的準備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250130
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250130,
					"content": "如果我能說服賽琉斯先生，我已經對現在的情況十分瞭解，也做好了充足的準備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250131
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250131,
					"content": "那麼，說不定他就能讓我也去野外加入調查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250132
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250132,
					"content": "但我現在還得去幫忙照顧那些人，沒機會出去搜集資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250133
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250108,
					"content": "是「獵鹿人」慶祝活動全店半價？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411250109
					]
				},
				{
					"id": 411250109,
					"content": "什麼？！我怎麼不知道！「獵鹿人」今天還有活動嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250110
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250110,
					"content": "哎！不對不對…我要說的不是這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250111
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250111,
					"content": "#{F#妳}{M#你}也看見了吧，最近一段時間，不斷有隕石從天而降。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250112
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 411250112,
					"content": "不過…該說是風神護佑，還是單純運氣好呢，隕石一直沒有砸進城裡來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411250113
					],
					"speakerTitle": "傑克"
				}
			]
		},
