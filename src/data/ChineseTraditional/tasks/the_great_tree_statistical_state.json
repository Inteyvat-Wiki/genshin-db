				"points": []
			},
			"dialogs": [
				{
					"id": 230300501,
					"content": "咳咳咳，咳咳…在這裡應該可以了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300502
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300502,
					"content": "嗚…嘔…你…這都是你的手筆！你居然也會嘔吐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300503
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300503,
					"content": "呃…咳…咳咳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300504
					]
				},
				{
					"id": 230300504,
					"content": "我和你…和你…解釋了多少次了，我加入的是生理催吐劑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300505
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300505,
					"content": "和習不習慣沒關係，只要人一聞到，身體就會自行做出嘔吐反應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300506
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300506,
					"content": "我為什麼要再重複一遍，你絕對聽不懂…唔…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300507
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300507,
					"content": "咦？拉德普和法爾希，還有旅行者？你們怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300508
