				"points": []
			},
			"dialogs": [
				{
					"id": 230300101,
					"content": "我們需要，更多的數據！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300102
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300102,
					"content": "你的這些裝置沒有數據支撐，怎麼可能正常運行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300103
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300103,
					"content": "你想把所有數據都搜集地盡善盡美了再動手？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300104
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300104,
					"content": "你抓魚的時候需要看清楚每一道波浪嗎？你只需要看清下面有魚的那一道就行了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300105
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300105,
					"content": "這就是你永遠也抓不到魚的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300106
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300106,
					"content": "你又沒在室羅婆耽進修過！別掐字眼了，我們必須得先做起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300107
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300107,
					"content": "再拖下去，我們和雅絲敏的論文說不定就要失去時效性了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300108
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300108,
					"content": "你們在吵什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300109
					]
				},
				{
					"id": 230300109,
					"content": "你是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300110
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300110,
					"content": "這位一定是雅絲敏提到過的旅行者，您幫了我們不少忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300111
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300111,
					"content": "幸會！旅行者，真是幸會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300112
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300112,
					"content": "我叫法爾希，現在正在刹訶伐羅學院求學。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300113
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300113,
					"content": "我是拉德普，是悉般多摩學院的學生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300114
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300114,
					"content": "#旅行者，我們也想請{F#妳}{M#你}來幫一個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300115
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300115,
					"content": "#{F#妳}{M#你}知道雅絲敏最近正在這種「聖樹」的根系周圍播撒藥水吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300116
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300116,
					"content": "不過…呃…最近雅絲敏撒的藥水好像出了點問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300117
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300117,
					"content": "在她投藥的區域周圍，總是會出現各式各樣的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300118
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300118,
					"content": "我發誓，我絕對沒有修改任何配方或者投藥比例。一定是…呃，出現了什麼預料之外的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300119
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300119,
					"content": "#隨你怎麼說…總之，旅行者，請{F#妳}{M#你}和我們一起去雅絲敏播撒藥物的地方看一看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300120
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300120,
					"content": "那邊說不定又出現了不少魔物，我們可不敢自己過去…必須得找個武力高強的人同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300121
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300121,
					"content": "更重要的是，就算那些蕈獸沒什麼太大危險性，但要是導師知道我們的藥水出了這種問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300122
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300122,
					"content": "我們這篇論文的論文提案一定會被打回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300123
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300123,
					"content": "特別是我們悉般多摩學院，如果提交上去的資料有錯誤，導師會罵死我們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300124,
						230300125
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300124,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230300125,
					"content": "你們之前怎麼解決這問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230300126
					]
				},
				{
					"id": 230300126,
					"content": "我們一般會雇傭冒險家，或者是去找我們的導師，請他出面，找幾個信得過的鍍金旅團成員幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300127
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300127,
					"content": "但我們導師的耐心也是有限的，現在這種情況，我們也不敢再去找他了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300128
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300128,
					"content": "#所以，只能拜託{F#妳}{M#你}了！旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉德普"
				}
			]
		},
		{
