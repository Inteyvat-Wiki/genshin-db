			"dialogs": [
				{
					"id": 230300201,
					"content": "喔！看那個箱子，裡面應該裝著那些藥水吧，雅絲敏應該已經來過這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300202
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300202,
					"content": "咦？箱子上這些藥水的蓋子還沒打開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300203
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300203,
					"content": "別把蓋子打開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300204
					],
					"speakerTitle": "法爾希"
				},
				{
					"id": 230300204,
					"content": "嗚啊！看後面，有蕈獸鑽出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230300205,
					"content": "什麼？！之前還沒有呢？這到底是怎麼回事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230300206
					],
					"speakerTitle": "拉德普"
				},
				{
					"id": 230300206,
					"content": "#別聽他們嘮叨了，{NICKNAME}，我們快點上吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
