					{
						"sceneId": 48000,
						"position": [
							43.884,
							0.49,
							41.953
						],
						"pointId": 11
					}
				]
			},
			"dialogs": [
				{
					"id": 706800101,
					"content": "客人客人，請到這邊來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800102
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800102,
					"content": "有一則好消息要告知兩位，雖然耽擱了一陣子…不過現在新的舞臺已經準備妥當了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800103
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800103,
					"content": "為觀眾奉上精彩表演的客人，將會獲得開啟畫中世界門扉的鑰匙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800104
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800104,
					"content": "先、先等一下！故事書之後又是畫中世界？這地方真是越來越叫人摸不著頭緒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706800105,
					"content": "我懂！我在故事書裡有看過這種說法，魔術師要是把自己的把戲全部都透露給觀眾，那就是從觀眾那裡奪走了驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800106
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800106,
					"content": "所以摸不著頭緒才好，魔女小姐的魔法就和愛一樣，不是用來思考的東西，而是要去感受的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800107
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800107,
					"content": "好吧…聽你這樣一說好像也有點道理…不過話說回來，畫中世界的舞臺和之前的舞臺有什麼不同嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706800108,
					"content": "畫中世界是規矩很多的世界，在新的舞臺上，友誼和信賴將會被考驗，是很常見的故事主題喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800109
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800109,
					"content": "而通過考驗的朋友，會得到魔女小姐送上的一份小小祝福…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800110
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800110,
					"content": "欸？會是什麼讓人走運的咒語嗎？譬如…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800111,
						706800112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706800111,
					"content": "不要隨便許願…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706800113
					]
				},
				{
					"id": 706800113,
					"content": "啊！對哦，不應該輕率地許願…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706800114,
					"content": "請放心，顏料已經在畫框裡面了，魔女小姐的小小祝福也不再是秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800115
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800115,
					"content": "客人若是準備好了，不妨親自去畫中世界的舞臺一窺究竟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706800116
					],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800116,
					"content": "就像在故事裡開始新的冒險那樣——「吹起歡快的口哨吧。把煩憂拋在身後，將勇氣戴於心上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小狼"
				},
				{
					"id": 706800112,
					"content": "應該不是吧？而且…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706800113
					]
				}
			]
		}
	]
}