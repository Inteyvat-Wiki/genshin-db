			"trigger": {
				"objectNames": [
					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721190101,
					"content": "呃！旅行者，我覺得…事情好像不太妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190102
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190102,
					"content": "裡面的愚人眾們突然把人都聚集到了核心附近，好像是有什麼發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190103
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190103,
					"content": "他們不會真的能攻破核心的防禦吧…不行，我們不能再拖下去了，必須馬上開始進行功能性測試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190104
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190104,
					"content": "功能性測試？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190105
					]
				},
				{
					"id": 721190105,
					"content": "就是測試一下這位新夥計的淨化能力，我可不想把它運進去之後才發現它沒法幹活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190106
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190106,
					"content": "所以，我想請您幫我去找三隻「鬼兜蟲」來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190107
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190107,
					"content": "我想要將這些小傢伙們放入現在的「御影爐心」周圍，讓它們沾染上「祟神」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190108
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190108,
					"content": "然後再將它們拿出來，用淨化裝置嘗試淨化它們所沾染的「祟神」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190109
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190109,
					"content": "這，就是我所設計的「功能性測試」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190110
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190110,
					"content": "在哪能找到「鬼兜蟲」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190111
					]
				},
				{
					"id": 721190111,
					"content": "嗯…它們通常都棲息在雷元素富集區域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190112
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190112,
					"content": "而且我還聽說，它們在「御影爐心」附近也能生存…真是一群厲害的小傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190113
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190113,
					"content": "那我不如直接去「御影爐心」裡抓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190114
					]
				},
				{
					"id": 721190114,
					"content": "雖然這樣也可以…但是，如果直接從「御影爐心」裡面抓「鬼兜蟲」來測試的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190115
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190115,
					"content": "說實話，我真有些擔心我們這位新夥計的…可靠性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190116
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190116,
					"content": "做測試，最好還是講一個「循序漸進」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190117
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190117,
					"content": "咳，總之，請您拿三隻「鬼兜蟲」過來吧，我就在這等著您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190118,
						721190120
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190118,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190119
					]
				},
				{
					"id": 721190119,
					"content": "那就拜託您了，只要三隻「鬼兜蟲」就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190120,
					"content": "不如我直接進去轉一圈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721190121
					]
				},
				{
					"id": 721190121,
					"content": "呃…就測試本身而言，您直接進去轉一圈，沾滿「祟神」再出來，確實也可以作為測試對象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190122
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190122,
					"content": "但我之前也說了，這個裝置的可靠性有些…不達預期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190123
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190123,
					"content": "如果在淨化過程中，真的發生了什麼預期之外的情況，您可能也會…呃，面臨一些預期之外的問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190124
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190124,
					"content": "咳，總之，我們還是就用「鬼兜蟲」來測試吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721190125
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721190125,
					"content": "只要三隻「鬼兜蟲」就好，您抓到了之後，就拿回來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				}
			]
		},
