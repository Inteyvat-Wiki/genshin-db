			"dialogs": [
				{
					"id": 4660101,
					"content": "迪盧克老爺！聽我說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660102,
					"content": "哼，凱亞那傢伙嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660103
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660103,
					"content": "我早該意識到了。對他來說，現在就是從我這裡扳回一城的最好時機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660104
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660104,
					"content": "你們好像有什麼恩怨的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660105,
					"content": "先不說這個，騎士團的想法倒是跟我預料的差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660106
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660106,
					"content": "現在將計就計就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660107,
						4660111
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660107,
					"content": "乾脆先別去酒館代班了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660108
					]
				},
				{
					"id": 4660108,
					"content": "不行。既然騎士團已經知道我代班的事，不去的話反而招致懷疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660109
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660109,
					"content": "這也是凱亞的算計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660110
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660110,
					"content": "那該怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660112,
					"content": "安靜一點，讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660113
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660113,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660114
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660114,
					"content": "…既然要監視我，那就如他所願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660115
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660115,
					"content": "我們來創造一個完美的「不在場證明」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660116
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660116,
					"content": "「不在場證明」？那是什麼意思呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660117,
					"content": "想知道的話，就先幫我個小忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660118
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660118,
					"content": "怎麼還要賣關子呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660119,
					"content": "<color=#00E1FFFF>酒莊西北</color>方向，有蒙德最好的冰霧花產地。周邊地方也零零散散長了一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660120
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660120,
					"content": "#請{F#妳}{M#你}們幫我收集幾株回來吧，我在這裡做些其它準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660111,
					"content": "你有什麼想法了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4660112
					]
				}
			]
		},
