			},
			"dialogs": [
				{
					"id": 4660901,
					"content": "哦，回來了嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660902
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660902,
					"content": "介紹一下，他是酒莊的釀造師…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660903
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660903,
					"content": "這麼多冰霧花！我已經開始期待「它」的效果了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660904
					],
					"speakerTitle": "康納"
				},
				{
					"id": 4660904,
					"content": "精煉裝置可以承受這樣的純度嗎？會不會出什麼問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660905
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660905,
					"content": "喔…喔喔喔——大老闆親自對我說話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660906
					],
					"speakerTitle": "康納"
				},
				{
					"id": 4660906,
					"content": "放心好了，老爺！只要是您的意思，我就算搭上這條命都十分甘心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660907
					],
					"speakerTitle": "康納"
				},
				{
					"id": 4660907,
					"content": "這不是可以拼上性命的事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660908,
					"content": "你們先聊，我這就開工！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660909
					],
					"speakerTitle": "康納"
				},
				{
					"id": 4660909,
					"content": "他拿那些冰霧花去幹什麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660910,
					"content": "事情是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660911
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660911,
					"content": "前些日子酒莊在研發新口味的時候，試著加了些冰霧花來讓口感清涼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660912
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660912,
					"content": "經過精煉後的冰霧花確實有很強的吸引力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660913
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660913,
					"content": "所以賣的很好嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660914
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660914,
					"content": "不，我指的不是吸引酒客，而是…吸引史萊姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660915
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660915,
					"content": "這類依靠汲取元素力量維生的生物，完全抵抗不了它的誘惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660916
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660916,
					"content": "於是我想，乾脆利用這一點做些文章…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660917
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660917,
					"content": "咚！喀啦喀啦…哐哐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660918
					],
					"speakerTitle": "康納"
				},
				{
					"id": 4660918,
					"content": "嗚哇！剛剛那是什麼聲音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660919,
					"content": "好冷…好冷！迪、迪盧克…老爺，精、精煉…已經…完成了，只是設、設備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660920
					],
					"speakerTitle": "康納"
				},
				{
					"id": 4660920,
					"content": "辛苦你了，設備你不用在乎，我會讓管家重新訂購。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660921
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660921,
					"content": "真是闊氣的發言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660922,
					"content": "剛才說的就是這東西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660923
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660923,
					"content": "精煉後的冰霧花——可以叫它「元素誘餌」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660924
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4660924,
					"content": "好厲害，這撲面而來的元素氣息！要怎麼試效果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4660925
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4660925,
					"content": "灑一點在那邊的地上吧，當心…就一點點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪盧克"
				}
			]
