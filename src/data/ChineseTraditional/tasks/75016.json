			"dialogs": [
				{
					"id": 750160301,
					"content": "打擾一下，兩位…應該是從異邦而來的旅人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160302
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160302,
					"content": "#哈…抱歉，{F#妳}{M#你}們身邊的這隻小嵴鋒龍，難道是{F#妳}{M#你}們的夥伴嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160303
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160303,
					"content": "尾巴上還綁著漂亮的絲巾，真是個有精神的小傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160304
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160304,
					"content": "#對啊，我們剛進納塔就遇到了。牠是{REALNAME[ID(2)|SHOWHOST(true)]}，最近都和我們一起旅行呦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160305,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160306
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160306,
					"content": "在一起旅行嗎？不過，恕我僭越，這是個相當危險的行為啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160307,
						750160308
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160307,
					"content": "人和龍一起旅行很危險？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160310
					]
				},
				{
					"id": 750160308,
					"content": "謝謝，我有小心不被吃掉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160309
					]
				},
				{
					"id": 750160309,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}才不會吃{F#妳}{M#你}呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160310,
					"content": "在納塔，人和龍一起生活不是很正常的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160311,
					"content": "#難道是旅行這件事很危險？{REALNAME[ID(2)|SHOWHOST(true)]}不能夠長途跋涉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160312,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160313
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160313,
					"content": "#也不是這樣…多走走對任何龍和人都有好處，恕我直言，只是{F#妳}{M#你}們的小嵴鋒龍，{REALNAME[ID(2)|SHOWHOST(true)]}不太一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160314
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160314,
					"content": "抱歉，自顧自地說了那麼多還沒自我介紹。我的名字是曼科，是龍遺物研究協會的研究員，負責考察一些部族風俗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160315
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160315,
					"content": "簡單來說，也就是探究部族過去習俗的研究者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160316
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160316,
					"content": "小嵴鋒龍的名字我已經知道了，兩位是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160317
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160317,
					"content": "#我是派蒙！{M#他}{F#她}的名字是{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160318,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160319
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160319,
					"content": "#真是有活力，看來派蒙和{NICKNAME}把你照顧得很好哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160320
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160320,
					"content": "嗯…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160321,
					"content": "#那是當然啦！我們一起吃了好多好吃的呦，對吧，{REALNAME[ID(2)|SHOWHOST(true)]}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160322,
					"content": "#啊，{REALNAME[ID(2)|SHOWHOST(true)]}，不許亂跑啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160323,
					"content": "真是可惜啊，明明是這麼有活力的小嵴鋒龍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160324,
						750160325
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160324,
					"content": "所以到底是有什麼危險的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160326
					]
				},
				{
					"id": 750160325,
					"content": "不要用這種語氣說牠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160326
					]
				},
				{
					"id": 750160326,
					"content": "抱歉，恕我不善言辭…不過我也是真心感到遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160327
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160327,
					"content": "#我就開門見山地說了，{F#妳}{M#你}應該已經看過不少小嵴鋒龍了吧？可是{REALNAME[ID(2)|SHOWHOST(true)]}與牠們都不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160328,
						750160330
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160328,
					"content": "尾巴上的漂亮絲帶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160329
					]
				},
				{
					"id": 750160330,
					"content": "角上的紅色印記？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160331
					]
				},
				{
					"id": 750160227,
					"content": "#我就開門見山地說了，{F#妳}{M#你}應該已經看過不少小嵴鋒龍了吧？可是{REALNAME[ID(2)|SHOWHOST(true)]}與牠們都不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160228,
						750160230
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160329,
					"content": "#哈哈，那應該是出自{F#妳}{M#你}的手筆吧？我要說的當然不是那個，而是牠角上的印記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160331
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160331,
					"content": "那不是普通小龍會有的印記，實際上這在記載中被稱為「焰{RUBY#[D]修庫特爾}主之祝」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160332
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160332,
					"content": "怎麼說呢…擁有這個印記的幼龍往往具備不可思議的力量，例如力氣比較大、游得比較快，或是跳得比較高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160333
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160333,
					"content": "聽起來滿不錯的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160334
					]
				},
				{
					"id": 750160334,
					"content": "但是之前就說了，那是「焰主」之祝，不是牠們自己的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160335
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160335,
					"content": "那是來自更遠古的龍眾力量，而現在納塔龍的身軀已無法承擔那樣的偉力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160336
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160336,
					"content": "而「大靈」和夜神之國也都排斥這樣的力量，不願意接納牠們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160337
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160337,
					"content": "所以在成長過程中，牠們或許會因為這個力量死去，也或許會因此失去理智——兩者都很危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160338
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160338,
					"content": "#或許{F#妳}{M#你}應該把牠交給回聲之子，他們會妥善處置牠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160339,
						750160340
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160339,
					"content": "處置？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160341
					]
				},
				{
					"id": 750160340,
					"content": "句子裡有個很冰冷的詞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160341
					]
				},
				{
					"id": 750160341,
					"content": "恕我嘴拙…但交給當地人是個比較好的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160342
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160342,
					"content": "…謝謝你告訴我這些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160343
					]
				},
				{
					"id": 750160343,
					"content": "#但是{F#妳}{M#你}仍然不打算放棄牠，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160344,
						750160345
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160344,
					"content": "放棄永遠不是第一順位…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160346
					]
				},
				{
					"id": 750160345,
					"content": "我不會放棄自己的夥伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160346
					]
				},
				{
					"id": 750160346,
					"content": "#唉…好吧，好吧。旅人，我已經看到{F#妳}{M#你}的決心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160347
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160347,
					"content": "#我不知道應不應該告訴{F#妳}{M#你}，畢竟這也是納塔「在地人」才知道的秘辛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160348
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160348,
					"content": "#如果{F#妳}{M#你}想試著拯救{REALNAME[ID(2)|SHOWHOST(true)]}，就必須帶著牠踏上前往火山的朝聖路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160349
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160349,
					"content": "傳說中，部族的勇士會帶著被一分為二的信物，在大火山之中洗去自己夥伴的姓名——被死去{RUBY#[D]修庫特爾}之龍惦記著的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160350
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160350,
					"content": "然後在那裡讓夜神之國重新接納自己的龍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160351
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160351,
					"content": "你為什麼要告訴我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160352
					]
				},
				{
					"id": 750160352,
					"content": "因為現在六大部族的人已經不會，也無暇去做這樣的嘗試了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160353
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160353,
					"content": "#但{F#妳}{M#你}不一樣，{F#妳}{M#你}是異邦的旅人，不被部族陳舊的觀念所束縛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160354
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160354,
					"content": "#而如果{F#妳}{M#你}能成功，就可以證明那些古物的銘刻和險些化為塵土的織卷裡所描述的，直到今日仍然確鑿無疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160355
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160355,
					"content": "#這對我來說很重要…如果{F#妳}{M#你}想試的話，我就為{F#妳}{M#你}找到信物所在之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160356
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160356,
					"content": "#{F#妳}{M#你}也可以救{F#妳}{M#你}的夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160357,
						750160358
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160357,
					"content": "聽起來是個雙贏的局面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160359
					]
				},
				{
					"id": 750160358,
					"content": "值得一試…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160359
					]
				},
				{
					"id": 750160359,
					"content": "#那…等我找到說好的地方，我會再聯絡{F#妳}{M#你}們的，或是{F#妳}{M#你}們也可以來找我，我最近會在回聲之子那邊考察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160360
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160360,
					"content": "再會了，朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160361
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160361,
					"content": "於是，名為曼科的龍遺物研究協會會員轉身離去了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750160362
					]
				},
				{
					"id": 750160362,
					"content": "#真是的，{REALNAME[ID(2)|SHOWHOST(true)]}，下次不許亂跑了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160363
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160363,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160364
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160364,
					"content": "#啊，對了，{NICKNAME}，剛才那個部族的人走了嗎？他沒說什麼奇怪的話吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160365
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160365,
					"content": "事情是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160366
					]
				},
				{
					"id": 750160366,
					"content": "#唔…也就是說，其實{REALNAME[ID(2)|SHOWHOST(true)]}現在生了病，我們要帶著需要帶的東西去火山，幫{REALNAME[ID(2)|SHOWHOST(true)]}治病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160367
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160367,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160368
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160368,
					"content": "#唉…{REALNAME[ID(2)|SHOWHOST(true)]}一副沒有聽懂的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160369
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160369,
					"content": "不過沒關係，說不定在牠長大之前，我們就「咻咻咻」地把所有問題都解決了，就可以讓牠正常地健康長大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160370
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160370,
					"content": "#真不知道那個人可不可靠…反正只是找什麼信物，{NICKNAME}我們也到各種地方找找看吧，說不定我們比他更早找到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160371
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160371,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160372
					]
				},
				{
					"id": 750160372,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160373
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160373,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}也一起吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160374
					]
				},
				{
					"id": 750160374,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		}
	]
}