			"dialogs": [
				{
					"id": 750160201,
					"content": "打擾一下，兩位…應該是從異邦而來的旅人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160202
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160202,
					"content": "#哈…抱歉，{F#妳}{M#你}們身邊的這隻小嵴鋒龍，難道是{F#妳}{M#你}們的夥伴嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160203
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160203,
					"content": "尾巴上還綁著漂亮的絲巾，真是個有精神的小傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160204
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160204,
					"content": "#對啊，我們剛進納塔就遇到了。牠是{REALNAME[ID(2)|SHOWHOST(true)]}，最近都和我們一起旅行呦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160205,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160206,
					"content": "在一起旅行嗎？不過，恕我僭越，這是個相當危險的行為啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160207,
						750160208
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160207,
					"content": "人和龍一起旅行很危險？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160210
					]
				},
				{
					"id": 750160210,
					"content": "在納塔，人和龍一起生活不是很正常的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160211,
					"content": "#難道是旅行這件事很危險？{REALNAME[ID(2)|SHOWHOST(true)]}不能夠長途跋涉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160212,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160213,
					"content": "#也不是這樣…多走走對任何龍和人都有好處，恕我直言，只是{F#妳}{M#你}們的小嵴鋒龍，{REALNAME[ID(2)|SHOWHOST(true)]}不太一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160214
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160214,
					"content": "抱歉，自顧自地說了那麼多還沒自我介紹。我的名字是曼科，是龍遺物研究協會的研究員，負責考察一些部族風俗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160215
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160215,
					"content": "簡單來說，也就是探究部族過去習俗的研究者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160216
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160216,
					"content": "小嵴鋒龍的名字我已經知道了，兩位是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160217
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160217,
					"content": "#我是派蒙！{M#他}{F#她}的名字是{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160218,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160219,
					"content": "#真是有活力，看來派蒙和{NICKNAME}把你照顧得很好哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160220
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160220,
					"content": "嗯…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160221
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750160221,
					"content": "#那是當然啦！我們一起吃了好多好吃的呦，對吧，{REALNAME[ID(2)|SHOWHOST(true)]}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160222,
					"content": "#啊，{REALNAME[ID(2)|SHOWHOST(true)]}，不許亂跑啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750160223,
					"content": "真是可惜啊，明明是這麼有活力的小嵴鋒龍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160224,
						750160225
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160224,
					"content": "所以到底是有什麼危險的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160226
					]
				},
				{
					"id": 750160226,
					"content": "抱歉，恕我不善言辭…不過我也是真心感到遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160227
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160227,
					"content": "#我就開門見山地說了，{F#妳}{M#你}應該已經看過不少小嵴鋒龍了吧？可是{REALNAME[ID(2)|SHOWHOST(true)]}與牠們都不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160228,
						750160230
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160228,
					"content": "尾巴上的漂亮絲帶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160229
					]
				},
				{
					"id": 750160229,
					"content": "#哈哈，那應該是出自{F#妳}{M#你}的手筆吧？我要說的當然不是那個，而是牠角上的印記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160231
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160231,
					"content": "那不是普通小龍會有的印記，實際上這在記載中被稱為「焰{RUBY#[D]修庫特爾}主之祝」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160232
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160232,
					"content": "怎麼說呢…擁有這個印記的幼龍往往具備不可思議的力量，例如力氣比較大、游得比較快，或是跳得比較高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160233
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160233,
					"content": "聽起來滿不錯的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160234
					]
				},
				{
					"id": 750160234,
					"content": "但是之前就說了，那是「焰主」之祝，不是牠們自己的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160235
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160235,
					"content": "那是來自更遠古的龍眾力量，而現在納塔龍的身軀已無法承擔那樣的偉力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160236
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160236,
					"content": "而「大靈」和夜神之國也都排斥這樣的力量，不願意接納牠們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160237
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160237,
					"content": "所以在成長過程中，牠們或許會因為這個力量死去，也或許會因此失去理智——兩者都很危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160238
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160238,
					"content": "#或許{F#妳}{M#你}應該把牠交給回聲之子，他們會妥善處置牠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160239,
						750160240
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160239,
					"content": "處置？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160241
					]
				},
				{
					"id": 750160241,
					"content": "恕我嘴拙…但交給當地人是個比較好的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160242
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160242,
					"content": "…謝謝你告訴我這些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160243
					]
				},
				{
					"id": 750160243,
					"content": "#但是{F#妳}{M#你}仍然不打算放棄牠，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160244,
						750160245
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160244,
					"content": "放棄永遠不是第一順位…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160246
					]
				},
				{
					"id": 750160246,
					"content": "#唉…好吧，好吧。旅人，我已經看到{F#妳}{M#你}的決心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160247
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160247,
					"content": "#我不知道應不應該告訴{F#妳}{M#你}，畢竟這也是納塔「在地人」才知道的秘辛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160248
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160248,
					"content": "#如果{F#妳}{M#你}想試著拯救{REALNAME[ID(2)|SHOWHOST(true)]}，就必須帶著牠踏上前往火山的朝聖路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160249
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160249,
					"content": "傳說中，部族的勇士會帶著被一分為二的信物，在大火山之中洗去自己夥伴的姓名——被死去{RUBY#[D]修庫特爾}之龍惦記著的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160250
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160250,
					"content": "然後在那裡讓夜神之國重新接納自己的龍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160251
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160251,
					"content": "你為什麼要告訴我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160252
					]
				},
				{
					"id": 750160252,
					"content": "因為現在六大部族的人已經不會，也無暇去做這樣的嘗試了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160253
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160253,
					"content": "#但{F#妳}{M#你}不一樣，{F#妳}{M#你}是異邦的旅人，不被部族陳舊的觀念所束縛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160254
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160254,
					"content": "#而如果{F#妳}{M#你}能成功，就可以證明那些古物的銘刻和險些化為塵土的織卷裡所描述的，直到今日仍然確鑿無疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160255
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160255,
					"content": "#這對我來說很重要…如果{F#妳}{M#你}想試的話，我就為{F#妳}{M#你}找到信物所在之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160256
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160256,
					"content": "#{F#妳}{M#你}也可以救{F#妳}{M#你}的夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160257,
						750160258
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160257,
					"content": "聽起來是個雙贏的局面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750160259
					]
				},
				{
					"id": 750160259,
					"content": "#那…等我找到說好的地方，我會再聯絡{F#妳}{M#你}們的，或是{F#妳}{M#你}們也可以來找我，我最近會在回聲之子那邊考察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160260
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160260,
					"content": "再會了，朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750160261
					],
					"speakerTitle": "曼科"
				},
				{
					"id": 750160261,
					"content": "於是，名為曼科的龍遺物研究協會會員轉身離去了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750160262
					]
