						730140311
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140311,
					"content": "桓那蘭那的大家都感謝那菈法留納，都喜歡那菈法留納，就像太陽，泥土，雨露。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140312
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140312,
					"content": "#哇，聽起來好厲害！{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}一定是個好那菈吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140313,
					"content": "#不過，嘿嘿，那菈{NICKNAME}也幫助了很多人，獲得了很多感謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140314,
					"content": "#蘭般度一定也會喜歡那菈{NICKNAME}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140315,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140316
					]
				},
				{
					"id": 730140316,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}離開桓那蘭那之後，許多從泥中誕生，許多又回到泥裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140317
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140317,
					"content": "法留納神機的枝和葉也沒有了氣力，法留納法寶像被嚇到的團雀，胡亂撲騰翅膀，雨變得很多，很怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140318
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140318,
					"content": "會跑的蘑菇在桓那住了下來，四處都是沒見過的種子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140319
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140319,
					"content": "…難道是蕈獸和孢子？不過，法留納神機和法留納法寶到底說的是什麼東西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140320,
					"content": "會是什麼很厲害的武器嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140321,
						730140323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140321,
					"content": "能將巴螺迦一分為二的刀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140322
					]
				},
				{
					"id": 730140322,
					"content": "再怎麼說這也厲害過頭了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140327,
					"content": "#唔…不對，不對。那菈{NICKNAME}和派蒙都不對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140328
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140328,
					"content": "#我們去高處，蘭般度告訴{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140323,
					"content": "可能不是武器…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140324
					]
				},
				{
					"id": 730140324,
					"content": "那會是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140325,
					"content": "可能是水造的長了翅膀的蘭那羅…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140326
					]
				},
				{
					"id": 730140326,
					"content": "那不是水之幻形嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "派蒙"
				}
			]
