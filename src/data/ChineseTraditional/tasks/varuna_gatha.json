			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"蘭般度",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730140301,
					"content": "啊，是那菈，金色的那菈，勇敢的那菈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140302
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140302,
					"content": "#我叫派蒙，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是{NICKNAME}，桓那蘭那的大家正在為無憂節做準備呢，你怎麼獨自到這裡來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140303,
					"content": "蘭般度有重要的任務，為了無憂節、為了水天叢林、為了那菈法留納。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140304
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140304,
					"content": "那麼你就是蘭般度了，不過，那菈法留納？好像是聽過的名字呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140305,
					"content": "#那菈法留納…{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}就像那菈{NICKNAME}一樣，是金色的，勇敢的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140306
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140306,
					"content": "看不到月亮和太陽的時候，就連桓那的大樹也被多牙的風啃落了葉子，被黑色的雨咬爛了枝幹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140307
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140307,
					"content": "桓那的痛啪嗒嗒，滴進了泥裡，到處都是鐵的味道，鹽的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140308
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140308,
					"content": "嗚哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140309,
					"content": "不知道日落又日升了多少次，那菈法留納來了，金色的那菈，說著金色的語言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140310
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140310,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}和蘭那羅一起，帶回了月亮和太陽。法留納神機洗掉了桓那的痛，再也沒有黑色的雨，再也沒有鐵和鹽的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140311
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140311,
					"content": "桓那蘭那的大家都感謝那菈法留納，都喜歡那菈法留納，就像太陽，泥土，雨露。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140312
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140312,
					"content": "#哇，聽起來好厲害！{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}一定是個好那菈吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140313,
					"content": "#不過，嘿嘿，那菈{NICKNAME}也幫助了很多人，獲得了很多感謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140314,
					"content": "#蘭般度一定也會喜歡那菈{NICKNAME}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140315,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140316
					]
				},
				{
					"id": 730140316,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}離開桓那蘭那之後，許多從泥中誕生，許多又回到泥裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140317
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140317,
					"content": "法留納神機的枝和葉也沒有了氣力，法留納法寶像被嚇到的團雀，胡亂撲騰翅膀，雨變得很多，很怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140318
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140318,
					"content": "會跑的蘑菇在桓那住了下來，四處都是沒見過的種子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140319
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140319,
					"content": "…難道是蕈獸和孢子？不過，法留納神機和法留納法寶到底說的是什麼東西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140320,
					"content": "會是什麼很厲害的武器嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140321,
						730140323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140321,
					"content": "能將巴螺迦一分為二的刀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140322
					]
				},
				{
					"id": 730140322,
					"content": "再怎麼說這也厲害過頭了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140327,
					"content": "#唔…不對，不對。那菈{NICKNAME}和派蒙都不對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140328
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140328,
					"content": "#我們去高處，蘭般度告訴{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730140323,
					"content": "可能不是武器…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140324
					]
				},
				{
					"id": 730140324,
					"content": "那會是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730140325,
					"content": "可能是水造的長了翅膀的蘭那羅…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730140326
					]
				},
				{
					"id": 730140326,
					"content": "那不是水之幻形嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730140327
					],
					"speakerTitle": "派蒙"
				}
			]
		},
