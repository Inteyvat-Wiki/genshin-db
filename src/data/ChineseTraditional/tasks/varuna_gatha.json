					"nextDialogs": [
						730141208
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730141208,
					"content": "#啊，畢竟蘭那羅個頭這麼小呢，這點小事就交給那菈{NICKNAME}吧。",
