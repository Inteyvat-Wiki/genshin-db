			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"波卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750960101,
					"content": "#{F#妳}{M#你}們回來了啊，去得滿久的，怎麼樣，有遇到什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960102
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960102,
					"content": "我們在下面做了很多事喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750960103,
					"content": "向波卡說了發生在火榴樹根系的事…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750960104
					]
				},
				{
					"id": 750960104,
					"content": "真的被這傢伙解決了…好，這下可以向瓦伊納大哥報告，不用拉下臉去找煙謎主或沃陸之邦的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960105
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960105,
					"content": "我就說他做得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960106
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960106,
					"content": "咦？原來你們的瓦伊納大哥竟然早就知道火榴樹根系有問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750960107,
					"content": "那是當然的囉。火榴大母樹的狀況大家當然都知道，只有提佐科這傢伙覺得大家沒有發覺，還死腦筋地想要自己解決問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960108
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960108,
					"content": "雖然腦子轉不過來，不過我覺得這傢伙就是這點很討人喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960109
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960109,
					"content": "#這次也多謝{F#妳}{M#你}們啦，哈哈。{NICKNAME}和派蒙，{F#妳}{M#你}們的名字我其實早就知道了，畢竟訊使是靠資訊吃飯的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960110
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960110,
					"content": "#所以就稍微順水推舟了一把…在{F#妳}{M#你}們會出現在的地方放了通行證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960111
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960111,
					"content": "好啊，原來都是妳安排的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750960112,
					"content": "#哈哈，好，那個死腦筋大概也給了{F#妳}{M#你}們一份酬勞，我怎麼可以給得比他少。來，這些給{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960113
					],
					"speakerTitle": "波卡"
				},
				{
					"id": 750960113,
					"content": "看在報酬的分上，兩位就大人不記小人過吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "波卡"
				}
			]
		},
		{
			"id": 7509602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
