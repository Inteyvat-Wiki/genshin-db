			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提佐科"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750960201,
					"content": "「山王火榴」終於成熟了，真是讓人鬆了口氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960202
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960202,
					"content": "#咦？是{F#妳}{M#你}啊，怎麼了？如果要進去的話就速去速回，不要被部族的人發現了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960203,
						750960208,
						750960212
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960203,
					"content": "關於「山王」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960204
					]
				},
				{
					"id": 750960204,
					"content": "哦，是想問關於「山王」的事嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960205
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960205,
					"content": "「山王」康加瑪托，是從前與英傑一起對抗深淵的龍，很了不起，部族裡的所有人都很尊敬牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960206
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960206,
					"content": "「山王火榴」其實也會有專人採摘獻給牠食用，不過也有說法是其他的匿葉龍也會偷偷餵「山王」大人吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960207
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960207,
					"content": "所以「山王」大人才會比別的匿葉龍…呃，健碩那麼多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960208,
					"content": "關於火榴果…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960209
					]
				},
				{
					"id": 750960209,
					"content": "#這{F#妳}{M#你}就問對人了。火榴果是很了不起的燃素植物，欸，能夠把自己的根系伸入液態燃素，對於植物來說很有勇氣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960210
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960210,
					"content": "而且結出來的果子裡也飽含燃素，多吃吃對匿葉龍也有好處…只要牠們不丟出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750960211
					],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960211,
					"content": "畢竟劇烈碰撞的話火榴果就會爆裂開來嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提佐科"
				},
				{
					"id": 750960212,
					"content": "只是路過啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750960213
					]
				},
				{
					"id": 750960213,
					"content": "是嗎…真的不進去看「山王火榴」一眼嗎？多看看「山王火榴」就覺得心情也變好了…如果覺得煩惱，一定要來看看哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提佐科"
				}
			]
		}
	]
}