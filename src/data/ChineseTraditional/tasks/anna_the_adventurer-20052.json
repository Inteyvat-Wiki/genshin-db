			"dialogs": [
				{
					"id": 200520301,
					"content": "#旅行者，還請{F#妳}{M#你}多照顧一下安娜，這孩子最近好像興奮過頭了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520302
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200520302,
					"content": "你不希望她做冒險家嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520303
					]
				},
				{
					"id": 200520303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520304
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200520304,
					"content": "我尊重我妹妹的夢想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520305
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200520305,
					"content": "她的病好不容易痊癒了，也得到了追逐自己夢想的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520306
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200520306,
					"content": "作為她的哥哥，我…會全力支持她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520307
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200520307,
					"content": "就這樣。",
