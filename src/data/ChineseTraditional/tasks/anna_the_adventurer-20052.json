			"dialogs": [
				{
					"id": 200520101,
					"content": "好…今天也要努力完成委託！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520102,
						200520106
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200520102,
					"content": "真是有幹勁啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520103
					]
				},
				{
					"id": 200520103,
					"content": "那是當然了，做冒險家可是很有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520104
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200520104,
					"content": "不過…嘿嘿，我執行委託的時候，還是有很多事不熟悉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520105
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200520105,
					"content": "#旅行者，能請{F#妳}{M#你}再陪我去執行一下委託嗎？我還有事想要請教{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520108
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200520108,
					"content": "那我們就快出發吧，今天的委託是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520109
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200520109,
					"content": "嗯…又是護送貨運熱氣球…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200520106,
					"content": "要我陪妳去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200520107
					]
				},
				{
					"id": 200520107,
					"content": "#可以嗎？嘿嘿，我正好有很多事想要請教{F#妳}{M#你}呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200520108
					],
					"speakerTitle": "安娜"
				}
			]
		},
