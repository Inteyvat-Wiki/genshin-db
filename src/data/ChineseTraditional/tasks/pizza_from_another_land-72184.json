				"points": []
			},
			"dialogs": [
				{
					"id": 721840501,
					"content": "#謝謝{F#妳}{M#你}，有這些食材就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840502
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840502,
					"content": "加入了稻妻當地食材的披薩，不知道做出來會是什麼味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840503
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840503,
					"content": "完成了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840504
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840504,
					"content": "這披薩…看起來還不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840505
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840505,
					"content": "#謝謝{F#妳}{M#你}幫忙，旅行者，這些東西請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840506
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840506,
					"content": "我等會就去仔細品嚐一下這披薩的味道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840507
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840507,
					"content": "如果還不錯的話…應該很快就能作為新品正式推出啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				}
			]
