				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721840301,
					"content": "#旅行者，{F#妳}{M#你}回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840302
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840302,
					"content": "#怎麼樣，{F#妳}{M#你}有問到什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840303
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840303,
					"content": "關於客人們的反饋…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840304
					]
				},
				{
					"id": 721840304,
					"content": "用堇瓜做的披薩…倒也不會太複雜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840305
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840305,
					"content": "其餘的材料就照常準備好了，唔，既然都說要「融入一些稻妻當地食材」了，那我就再加一點其他的材料好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840306
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840306,
					"content": "唔，海靈芝？鳴草？嗯…幽燈蕈怎麼樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840307
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840307,
					"content": "那個，要我幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840308
					]
				},
				{
					"id": 721840308,
					"content": "喔！抱歉，我光顧著想放什麼食材好了！我看看，店裡的堇瓜好像沒多少了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840309
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840309,
					"content": "#旅行者，請{F#妳}{M#你}去幫我拿一個堇瓜來吧，材料的話…應該就只差這個了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840310,
						721840312
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840310,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840311
					]
				},
				{
					"id": 721840311,
					"content": "#嗯，那就拜託{F#妳}{M#你}了，只要一個堇瓜就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 721840312,
					"content": "還要找其他的食材嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840313
					]
				},
				{
					"id": 721840313,
					"content": "#其他的食材店裡還有些存貨，{F#妳}{M#你}帶一個堇瓜回來就好，拜託{F#妳}{M#你}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				}
			]
		},
