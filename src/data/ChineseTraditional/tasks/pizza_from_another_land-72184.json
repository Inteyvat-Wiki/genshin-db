			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梨繪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721840201,
					"content": "#{F#妳}{M#你}好呀，有什麼事找我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840202
					],
					"speakerTitle": "梨繪"
				},
				{
					"id": 721840202,
					"content": "關於「木南料亭」的披薩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721840203
					]
				},
				{
					"id": 721840203,
					"content": "#哦，{F#妳}{M#你}說那個披薩啊，味道確實很不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840204
					],
					"speakerTitle": "梨繪"
				},
				{
					"id": 721840204,
					"content": "但是…怎麼說呢，總感覺不太吃得慣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840205
					],
					"speakerTitle": "梨繪"
				},
				{
					"id": 721840205,
					"content": "我個人是覺得，要是能在那種披薩裡融入一些稻妻當地食材的話，比如堇瓜之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721840206
					],
					"speakerTitle": "梨繪"
				},
				{
					"id": 721840206,
					"content": "說不定，這種披薩會更受大家歡迎呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梨繪"
				}
			]
		},
		{
			"id": 7218403,
			"completionStepIds": [
				7218403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7218403",
							"2"
						],
						"stepId": 7218403,
						"stateName": "QUEST_STATE_UNFINISHED"
