			},
			"dialogs": [
				{
					"id": 750180301,
					"content": "「嘎——！」\\n像是知道自己不是敵手，絨翼龍嘯叫著飛向遠方…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750180302
					]
				},
				{
					"id": 750180302,
					"content": "哇！！飛、飛得好快！一眨眼就跑了那麼遠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180303,
						750180305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180303,
					"content": "派蒙，快追！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180304
					]
				},
				{
					"id": 750180304,
					"content": "欸，我去追？我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180307,
					"content": "——嗯，飛得這麼快，看來至少體力已經恢復得差不多了，接下來就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180308
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180308,
					"content": "話說回來，那頭絨翼龍為什麼會這麼生氣啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180309,
					"content": "…啊，我知道了！該不會是妳偷吃了牠的點心吧？因為食物而結下的仇怨可是很重的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180310,
					"content": "點心？吃是有吃過，不過咕嚕嚕是不拘小節的絨翼龍，所以不會在意這種小事啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180311
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180311,
					"content": "「咕嚕嚕」？原來牠也是有名字的龍啊…不過看起來脾氣很壞耶，剛才還亂打人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180312,
					"content": "嗯…這也不怪牠，都是為了治療。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180313
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180313,
					"content": "原來被打也是治療哦，長知識了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180314
					]
				},
				{
					"id": 750180314,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180315
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180315,
					"content": "#怎麼可能會有這種療法啊！{F#妳}{M#你}看，都怪{F#妳}{M#你}亂說，{REALNAME[ID(2)|SHOWHOST(true)]}都當真了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180316,
					"content": "嗯？嗚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180317
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180317,
					"content": "哈哈，要是真的有這種療法而且還有效的話，那我也想試試看！不過龍和人不一樣，就算跟牠們說都是為了快點痊癒，牠們也不懂嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180318
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180318,
					"content": "對了，還沒自我介紹。我是瑪茲嘉，平常都在這附近照看受傷跟生病的龍，不是我自誇，我配的藥風評還不錯哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180319
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180319,
					"content": "#嗯，{F#妳}{M#你}們的小小夥伴看起來很健康的樣子，看來是不需要我的關照了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180320
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180320,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180321
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180321,
					"content": "原來妳是幫龍看病的醫生啊。呃…看咕嚕嚕的樣子，應該是很辛苦的工作吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180322,
					"content": "我覺得也沒有那麼辛苦啦，只是咕嚕嚕的情況比較特殊…牠現在極度不信任人類，也很抗拒治療和吃藥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180323
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180323,
					"content": "唉…要是我也是龍就好了。之前觀察下來，牠和其他龍相處得還不錯，如果是龍勸牠吃藥，說不定牠就會願意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180324
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180324,
					"content": "嗚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180325,
					"content": "如果是這樣的話，說不定我們可以幫上忙哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180326,
					"content": "#欸？難、難道{F#妳}{M#你}們雖然外表是這樣，但其實是龍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180327
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180327,
					"content": "妳的想法也太跳躍了吧！呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180328,
					"content": "#對、對了！其實是因為{REALNAME[ID(2)|SHOWHOST(true)]}是超級聰明的小龍！這件事可以讓牠來幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180329,
					"content": "欸？原來牠這麼厲害嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180330,
						750180332
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180330,
					"content": "牠選到我，至少很有眼光。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180331
					]
				},
				{
					"id": 750180331,
					"content": "話是沒錯…但現在重點不是這個吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180333,
					"content": "#總之這點小事交給{REALNAME[ID(2)|SHOWHOST(true)]}，一定沒問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180334,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180335
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180335,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}，那我就先替咕嚕嚕謝謝你囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180336
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180336,
					"content": "原本真的很擔心牠再這樣鬧下去，不僅舊傷不能痊癒，還會有新傷…有你們幫忙就放心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180337
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180337,
					"content": "我為咕嚕嚕準備了兩種藥劑，雖然很想兼顧療效和味道，但是現在我還拿不出這樣完美的配方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180338
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180338,
					"content": "所以現在的兩種藥劑，療效好的那種大概是龍不太喜歡的口味，而口味是牠們喜歡的那種，療效可能又沒那麼好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180339
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180339,
					"content": "#唔…與其我來解釋，不如讓{REALNAME[ID(2)|SHOWHOST(true)]}聞聞看，{F#妳}{M#你}們看看牠的反應應該會更明白吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180340
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180340,
					"content": "這個是療效更好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180341
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180341,
					"content": "嗚…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180342
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180342,
					"content": "這個是療效沒那麼好的，但是顏色看起來讓人覺得很有食欲喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180343
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180343,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180344
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180344,
					"content": "哇，真的一目瞭然！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180345,
					"content": "#不管是哪種，只要咕嚕嚕願意吃，總歸是對恢復有幫助的。所以兩種藥劑都交給{F#妳}{M#你}們，要用哪一種就看{F#妳}{M#你}們的判斷啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180346
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180346,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180347
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750180347,
					"content": "嘿嘿，真可靠！那我先回營地做一些準備工作，咕嚕嚕就拜託你們了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180348
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180348,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}是很可靠的夥伴哦，這次就交給牠吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750180332,
					"content": "足以在人和龍之間架起友誼的橋樑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180333
					]
				},
				{
					"id": 750180305,
					"content": "這樣就逃了，有本事回來啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750180306
					]
				},
				{
					"id": 750180306,
					"content": "龍才聽不懂這些吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180307
					],
					"speakerTitle": "派蒙"
				}
			]
