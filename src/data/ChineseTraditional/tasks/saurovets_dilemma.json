			},
			"dialogs": [
				{
					"id": 750181001,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181002
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750181002,
					"content": "你們回來了！怎麼樣？咕嚕嚕願意吃藥了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181003
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750181003,
					"content": "吃是吃了，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750181004,
					"content": "簡要地說明了剛才的情況…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750181017
					]
				},
				{
					"id": 750181017,
					"content": "原來是這樣…那我檢查一下吧！唔——沒事，應該沒有什麼大礙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181005
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750181005,
					"content": "不管怎麼說，牠願意吃藥就是好事！而且也知道了牠的反應，之後就好調整配方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181006
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750181006,
					"content": "#嗯，一定沒問題的。真是多謝你們了，特別是{REALNAME[ID(2)|SHOWHOST(true)]}，真是了不起的小嵴鋒龍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181007
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750181007,
					"content": "呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181008
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750181008,
					"content": "#嘿嘿，聽別人誇{REALNAME[ID(2)|SHOWHOST(true)]}，感覺比自己被誇更高興耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750181009,
					"content": "#可以和小嵴鋒龍這樣有默契的兩位也很了不起！我也得向{F#妳}{M#你}們學習才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181010,
						750181011
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750181010,
					"content": "真不愧是我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				},
				{
					"id": 750181012,
					"content": "雖然想說有什麼我能幫到你們或者為你們做的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181013
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750181013,
					"content": "但還是祝你們健健康康，最好永遠也不需要找我幫忙吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181014
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750181014,
					"content": "啊，不過如果你們只是想來和我聊聊天，隨時歡迎你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181015
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750181015,
					"content": "好哦，也祝咕嚕嚕早點恢復，至少不要再不由分說就亂打人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750181016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750181016,
					"content": "這個嘛…就相信我吧，之後我也會想想辦法的。傷養好了，說不定脾氣自然也就變好了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750181011,
					"content": "#哪裡，還是{REALNAME[ID(2)|SHOWHOST(true)]}更了不起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750181012
					]
				}
			]
		},
