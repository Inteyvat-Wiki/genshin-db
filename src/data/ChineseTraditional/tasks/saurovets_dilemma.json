			"dialogs": [
				{
					"id": 750180101,
					"content": "——嘎嘎嘎嘎嘎嘎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180102
					],
					"speakerTitle": "「咕嚕嚕」"
				},
				{
					"id": 750180102,
					"content": "好孩子，不要鬧了，不吃藥的話身體怎麼恢復…唉呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750180103
					],
					"speakerTitle": "瑪茲嘉"
				},
				{
					"id": 750180103,
					"content": "#危險！{NICKNAME}，我們得去幫幫她！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
