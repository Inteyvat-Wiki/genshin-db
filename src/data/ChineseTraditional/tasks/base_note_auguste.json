			"dialogs": [
				{
					"id": 140390601,
					"content": "哇…這些就是…奧古斯都花？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390602,
					"content": "居然有那麼多…這得花多少時間啊？還都是一個人幹的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390603,
					"content": "比起開闢園圃的時間，使用邪眼需要付出的壽命，只怕還要更多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390604
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390604,
					"content": "不過基里亞…真的需要這麼多奧古斯都花嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390605,
					"content": "想完成他的計畫，只要能製作出幾瓶「奧古斯都」就夠了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390606,
					"content": "…也許除了仇恨以外，他還寄託了別的情感在「奧古斯都」上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390607
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390607,
					"content": "…別的情感？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390608
					]
				},
				{
					"id": 140390608,
					"content": "不久前他跟我說過不希望旅館裡的花，就這樣凋零在異國的土地上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390609
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390609,
					"content": "但對叛離了至冬、告別了楓丹，終生戴著假面生活在須彌的基里亞來說…到底哪裡才算他的故鄉呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390610
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390610,
					"content": "大概在他心裡跟姐姐一樣，死在開滿奧古斯都花的園圃裡…才是最好的歸宿吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾梅莉埃"
				}
			]
		},
