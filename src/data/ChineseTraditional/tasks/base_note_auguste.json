			"dialogs": [
				{
					"id": 140390501,
					"content": "啊——奧烏茲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390502
					],
					"speakerTitle": "伊娜姆"
				},
				{
					"id": 140390502,
					"content": "你沒事吧！是…是被誰襲擊了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390503
					],
					"speakerTitle": "伊娜姆"
				},
				{
					"id": 140390503,
					"content": "唔…沒、沒有…我只是一路追著那個黑影跑進來，然後突然就感覺很難受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390504
					],
					"speakerTitle": "奧烏茲"
				},
				{
					"id": 140390504,
					"content": "讓我來檢查一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390505
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390505,
					"content": "這裡的空氣的確有種很壓抑的感覺呢…雖然很香，卻讓人喘不過氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390506,
					"content": "這種感覺…我好像在哪裡遇過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390507
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 140390507,
					"content": "看起來沒有什麼大礙。應該只是追得太急，加上環境影響導致的身體不適，出去休息一下應該就會好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390508
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390508,
					"content": "不行！艾德加先生肯定還在裡面…他還教過我妹妹調香…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390509
					],
					"speakerTitle": "奧烏茲"
				},
				{
					"id": 140390509,
					"content": "——這樣的好人，怎麼能死在基里亞手上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390510
					],
					"speakerTitle": "奧烏茲"
				},
				{
					"id": 140390510,
					"content": "奧烏茲…你冷靜點聽我說，艾德加…就是我們要追的基里亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390511
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 140390511,
					"content": "這…這怎麼可能！不是說基里亞…是個三十多歲的青年嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390512
					],
					"speakerTitle": "奧烏茲"
				},
				{
					"id": 140390512,
					"content": "艾德加先生現在都七十來歲了…就算是易容，也裝不出那副老態吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390513
					],
					"speakerTitle": "奧烏茲"
				},
				{
					"id": 140390513,
					"content": "嗯…所以基里亞動用了非常的手段，使自己的身體老化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390514
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390514,
					"content": "…是邪眼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390515
					]
				},
				{
					"id": 140390515,
					"content": "基里亞用邪眼培育了奧古斯都花，同時也損耗了自己的壽命…就跟他的姐姐一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390516
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390516,
					"content": "不…不會的，艾德加先生在奧摩斯港住了那麼久！要是有人想偽裝成他，我們一定能看出破綻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390517
					],
					"speakerTitle": "奧烏茲"
				},
				{
					"id": 140390517,
					"content": "但如果這個偽裝，從十幾年前就開始了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390518
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390518,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390519
					],
					"speakerTitle": "奧烏茲"
				},
				{
					"id": 140390519,
					"content": "…雖然還只是推測，但我懷疑真正的調香師艾德加…在楓丹出獄後不久，就已經被基里亞謀害了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390520
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390520,
					"content": "艾德加尚在獄中的那幾年裡，基里亞就已經做好了頂替的準備——老化的身體、調香的知識…和後續的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390521
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390521,
					"content": "當年的「艾德加」藉口要忘卻舊事，遠赴須彌，甚至暫停調香轉而授課…都是為了避免被故人識破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390522
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390522,
					"content": "在無人熟識的須彌，只要簡單地易容，蓄起鬍鬚，戴上眼鏡…就能讓人相信他就是艾德加…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390523
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390523,
					"content": "十多年的漫長歲月裡，再一點點地卸去易容，不斷地精進自己的技術…周圍不會有任何人發現異常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390524
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390524,
					"content": "所以席爾萬剛見到他的時候，才說他老得都認不出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390525,
					"content": "為了復仇，把自己從一個青年，變成一個垂垂老矣的老人…這真的值得嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390526,
					"content": "我…我得去見艾德加先生…他不可能是這種人…咳…咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390527
					],
					"speakerTitle": "奧烏茲"
				},
				{
					"id": 140390527,
					"content": "喂，你還是趕緊出去休息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390528
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 140390528,
					"content": "可是我還撐得住…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390529
					],
					"speakerTitle": "奧烏茲"
				},
				{
					"id": 140390529,
					"content": "等等…這裡的環境，大概也受到了邪眼的影響。就算現在只是輕微的不適，也不能掉以輕心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390530
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 140390530,
					"content": "奧烏茲先生，我知道怎麼緩解這類症狀…請先跟我一起出去休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390531
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 140390531,
					"content": "我覺得基里亞…不，是艾德加先生…一定也不希望再牽連到無辜的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390532
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 140390532,
					"content": "#柯萊說得對，後面的探索交給我跟{NICKNAME}就好。從我們少量接觸「奧古斯都」而無礙的反應來看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390533
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390533,
					"content": "受神之眼庇佑或是本身就善用元素力的人，對異常元素力的耐受性也會強一些，在這裡會相對安全一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390534
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390534,
					"content": "夏姆先生、奧烏茲先生，這處據點說不定還會有其他出入口。萬一目標從那裡逃離，就很難再抓住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390535
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390535,
					"content": "所以…能請你們在外面搜尋一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390536
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390536,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390537
					],
					"speakerTitle": "奧烏茲"
				},
				{
					"id": 140390537,
					"content": "呵…謝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390538
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 140390538,
					"content": "——喂，沒聽見嗎？快跟我出去，我們還有的是事情要做！回奧摩斯港再多叫點人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390539
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 140390539,
					"content": "我明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390540
					],
					"speakerTitle": "奧烏茲"
				},
				{
					"id": 140390540,
					"content": "#{NICKNAME}、艾梅莉埃，還有派蒙，{F#妳}{M#你}們千萬要小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390541
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 140390541,
					"content": "只為復仇而活的人…在這條路的最後，會做出什麼事情…我不敢想像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390542
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 140390542,
					"content": "放心吧，不管是我們還是基里亞，都不應該在這裡結束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390543
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390543,
					"content": "…「奧古斯都」帶來的死亡，是時候跟它的神話一起終結了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾梅莉埃"
				}
			]
		},
