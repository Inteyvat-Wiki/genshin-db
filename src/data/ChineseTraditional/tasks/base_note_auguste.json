			"dialogs": [
				{
					"id": 140390801,
					"content": "…妳知道嗎？艾梅莉埃小姐要推出新的香水了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390802
					],
					"speakerTitle": "議論紛紛的群眾"
				},
				{
					"id": 140390802,
					"content": "啊，我也聽說了，名字好像是叫…「葉蓮娜」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390803
					],
					"speakerTitle": "議論紛紛的群眾"
				},
				{
					"id": 140390803,
					"content": "感覺最近楓丹上下…都在討論妳還沒出的新香水呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390804,
					"content": "我本來只想低調上架，沒想到消息傳得這麼快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390805
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390805,
					"content": "希望不要又成了另一個「神話」…不然就沒有為「奧古斯都」祛魅的意義了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390806,
						140390807
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390806,
					"content": "這個香水…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390808
					]
				},
				{
					"id": 140390808,
					"content": "#嗯，我後來又調整了一下配方，讓它的香味能更持久宜人…今天正好帶了一些樣品過來，希望{F#妳}{M#你}們能喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390809
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390809,
					"content": "#另外…我也想請{F#妳}{M#你}們在正式發售前試試香，再說說自己的感想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390810
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390810,
					"content": "好啊！我聽說味覺靈敏的人，嗅覺也不會差，就交給我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390811,
					"content": "…嗯…很香！非常好聞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390812,
					"content": "這才不是什麼有用的感想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390813
					]
				},
				{
					"id": 140390813,
					"content": "呵呵，沒關係，這也是一種值得納入考量的顧客意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390814
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390814,
					"content": "而且對一款香水來說…「很香」就已經是最直達本質的評價了，不需要有多少深意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390815
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390815,
					"content": "說起深意…基里亞最後的問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390816
					]
				},
				{
					"id": 140390816,
					"content": "對哦…那幾種花…有什麼特別的含義嗎？好像他在聽到這幾個花名的時候，態度就有點變化了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390817,
					"content": "大概…是因為「花語」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390818
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390818,
					"content": "花語？啊，從前好像有聽過，塞西莉亞花的「花語」是「浪子的真情」…之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390819,
					"content": "每種花在不同的時期、不同人的口中，都會被賦予不同的花語…構成奧古斯都花香氣的數種花卉也是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390820
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390820,
					"content": "我回楓丹後去查了一下…然後發現將它們的花語拆解組合之後，可以拼出一句話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390821
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390821,
					"content": "「…忘記過往，堅強地活下去。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390822
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390822,
					"content": "奧古斯都的花語，在世人的眼裡是高貴、神聖，但在培育它的葉蓮娜眼裡…或許是這個意思吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390823
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390823,
					"content": "又或許…這才是她對弟弟的期許…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390824
					]
				},
				{
					"id": 140390824,
					"content": "對哦！那基里亞…他知道這件事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390825,
					"content": "我在開庭前去探視過一次，也說過這個猜想…但他看起來不是很在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390826
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390826,
					"content": "「誰知道呢？說不定她那時候什麼都沒想呢？」——他是這麼說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390827
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390827,
					"content": "「…姐姐已經不在了，她真正的想法已經無人能知。後人做的一切註解，都只是附會與猜測。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390828
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390828,
					"content": "「就算她真是這麼想的，我也沒辦法忘掉她活著。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390829
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390829,
					"content": "「…為她復仇，就是我給自己的人生賦予的意義。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390830
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390830,
					"content": "…他已如自己所願地綻放過，哪怕沒有結出自己希望的果實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390831
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390831,
					"content": "基里亞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390832
					]
				},
				{
					"id": 140390832,
					"content": "#不過，老師還是託我向{F#妳}{M#你}們帶了一句「謝謝」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390833
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390833,
					"content": "#「…謝謝{F#妳}{M#你}們，在那時讓我活了下來。讓我活著知道了…奧古斯都的『花語』，還有這種可能。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390834
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390834,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390835
					]
				},
				{
					"id": 140390835,
					"content": "無論是愛還是恨，都是生者的特權。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390836
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390836,
					"content": "逝者的思緒早已隨生命而去，奧古斯都真正的花語，已經是永遠的謎了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390837
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390837,
					"content": "但…就算是附會猜測，我也還是願意相信自己的解讀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390838
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390838,
					"content": "花語的寓意、香水的象徵…儘管會在世事跌宕中不停地被曲解與利用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390839
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390839,
					"content": "但最初的最初，它們的誕生都源自人們最簡單、最美好的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390807,
					"content": "是用那時的諧香改良的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390808
					]
				}
			]
		},
