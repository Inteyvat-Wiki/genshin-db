			"dialogs": [
				{
					"id": 140390701,
					"content": "咳…咳…咳！咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390702
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390702,
					"content": "花香…濃烈…終點應該…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390703
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390703,
					"content": "…這麼快就追上來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390704
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390704,
					"content": "不…是我已經沒力氣了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390705
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390705,
					"content": "…不過到這裡…就已經夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390706
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390706,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390707
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390707,
					"content": "哈——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390708
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390708,
					"content": "…這裡是…「奧古斯都」的花圃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390709
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390709,
					"content": "…不是我的花圃…是那天在楓丹被燒毀的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390710
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390710,
					"content": "…姐姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390711
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390711,
					"content": "——姐姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390712
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390712,
					"content": "我…其實一直都明白的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390713
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390713,
					"content": "都是因為我，妳才會繼續用邪眼！都是因為我，妳才會燒掉花圃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390714
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390714,
					"content": "那一天…我就不該聽妳說的帶錢離開楓丹廷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390715
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390715,
					"content": "等我發現不對的時候…花圃也好…妳也好…什麼都沒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390716
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390716,
					"content": "我早該過來找妳的…十多年前我就應該來找妳的…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390717
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390717,
					"content": "我早該跟妳…一起死在這一天的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390718
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390718,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390719
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390719,
					"content": "…姐姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390720
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390720,
					"content": "——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390721
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390721,
					"content": "——姐姐！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390722
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390722,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390723
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390723,
					"content": "不要——不要留下我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390724
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390724,
					"content": "葉蓮娜——！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390725
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390725,
					"content": "呃…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390726
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390726,
					"content": "…艾梅莉埃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390727
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390727,
					"content": "我…還沒死？怎麼可能？我明明…都見到她了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390728
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390728,
					"content": "…只是你體內殘留的毒素和奧古斯都花粉引致的幻覺而已，並不致命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390729
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390729,
					"content": "不可能…我服下的「奧古斯都」…劑量明明是夠的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390730,
						140390731
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390730,
					"content": "很遺憾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390732
					]
				},
				{
					"id": 140390732,
					"content": "…仿製？這怎麼可能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390733
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390733,
					"content": "…從昨晚開始，我們就在著手準備了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390734
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390734,
					"content": "——「奧古斯都」的諧{RUBY#[D]Accord}香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390735
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390735,
					"content": "那個時候…妳就調換了「奧古斯都」嗎？藉著向我報告席爾萬死訊的機會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390736
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390736,
					"content": "那時候您以為復仇已經完成…是最容易放鬆戒備的時刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390737
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390737,
					"content": "不可能…就算有機會調換，又怎麼調得出「奧古斯都」的諧香？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390738
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390738,
					"content": "如果它有那麼容易仿製，姐姐就不會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390739
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390739,
					"content": "我用了虹彩薔薇、琉璃百合…還有塞西莉亞花…這在十多年前是個會互相衝突的配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390740
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390740,
					"content": "但現在，已經有辦法互相協調了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390741
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390741,
					"content": "…虹彩薔薇…琉璃百合…塞西莉亞花…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390742
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390742,
					"content": "…「奧古斯都」已經是十多年前的香水了，在這些年裡對它的分析和模仿從未停止。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390743
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390743,
					"content": "調香的技術也已經日新月異，除了古老的精油萃取、油脂分離…我們還發現了更多調和香味的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390744
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390744,
					"content": "十多年前牢不可破的神話…現在也是時候成為過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390745
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390745,
					"content": "「過去」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390746
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390746,
					"content": "您這些年作為調香師並沒有固步自封，理論上有沒有可能您其實很清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390747
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390747,
					"content": "只是您太執著於自己為「奧古斯都」賦予的意義…就像陷入「香水狂熱」時的人們一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390748
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390748,
					"content": "相信著它的「神聖」、相信著它的「高貴」、相信著它的「獨一無二」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390749,
						140390750
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390749,
					"content": "卻偏偏忘了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390751
					]
				},
				{
					"id": 140390751,
					"content": "也是因為你對「奧古斯都」的執著，我們才能預見你想要的「結局」…提前做好準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390752
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390752,
					"content": "只是沒想到這麼快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390753
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390753,
					"content": "甚至還動用了邪眼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390754
					]
				},
				{
					"id": 140390754,
					"content": "哈…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390755
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390755,
					"content": "#還真是…全被{F#妳}{M#你}們說中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390756
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390756,
					"content": "所以…席爾萬他也沒死，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390757
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390757,
					"content": "#既然{F#妳}{M#你}們從昨晚開始就在準備「奧古斯都」的諧香…那肯定早就發現了我的手法吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390758
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390758,
					"content": "#今天一早的死訊、圍觀的群眾——都是夏姆配合{F#妳}{M#你}們演給我看的一齣戲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390759
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390759,
					"content": "是的…如果不這麼做，您可能會用邪眼做最後一搏，也可能用「靈酚香」跟「奧古斯都」製造混亂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390760
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390760,
					"content": "誰知道呢…說不定會直接給自己一個痛快吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390761
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390761,
					"content": "那「艾德加」的死、這處花圃的位置…就都成為永遠的謎了…我不想再看見任何死亡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390762
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390762,
					"content": "席爾萬昨晚只是輕度中毒，現在已經在被收押的路上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390763
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390763,
					"content": "他在十多年前隱瞞的罪行都會受到公開的審判，所有的秘密都會被昭示…而老師，您也一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390764
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390764,
					"content": "我也一樣嗎…看來我剩下的時間，是要在監獄裡度過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390765
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390765,
					"content": "唔…他接受得好像有點快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390766
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140390766,
					"content": "…我不會為自己的行為辯解，也沒有懺悔的打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390767
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390767,
					"content": "#該做的事我都已經做完了，就算最後輸給{F#妳}{M#你}們，一切也都是我自己的選擇，就算從頭再來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390768
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390768,
					"content": "呵…又怎麼可能從頭再來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390769
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390769,
					"content": "…大家小心…我在前面開路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390770
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 140390770,
					"content": "…都跟緊一點…別讓艾德加死了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390771
					],
					"speakerTitle": "夏姆"
				},
				{
					"id": 140390771,
					"content": "看來已經沒有時間了…我還有最後一個問題想問妳，艾梅莉埃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390772
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390772,
					"content": "…請問吧，老師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390773
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390773,
					"content": "「奧古斯都」諧香裡用到的那幾種香型…妳是怎麼判斷出來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390774
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390774,
					"content": "…「奧古斯都」的香氣層次複雜且紛繁，主原料卻只用到了奧古斯都花一種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390775
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390775,
					"content": "所以前天研究殘液的時候我就在想…會不會是在花卉的培育階段就已經完成了這些香型的混合？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390776
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390776,
					"content": "妳是說…她當初就是比照這幾種花的香韻來培育「奧古斯都」的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390777
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390777,
					"content": "虹彩薔薇、琉璃百合、塞西莉亞花…直接混合它們的精油會互相衝突排斥，在多年前是無解的難題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390778
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390778,
					"content": "但如果能培育出一種兼具它們特色的新花種，就規避了這個問題…不得不說，這在過去是個非常天才的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390779
					],
					"speakerTitle": "艾梅莉埃"
				},
				{
					"id": 140390779,
					"content": "虹彩薔薇、琉璃百合、塞西莉亞花…呵，真像是妳會選的花啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390780
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390780,
					"content": "…葉蓮娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140390781
					],
					"speakerTitle": "艾德加"
				},
				{
					"id": 140390781,
					"content": "在這之後，鍍金旅團匆匆趕到…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140390782
					]
				},
				{
					"id": 140390782,
					"content": "基里亞未發一言，默然接受了命運。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 140390750,
					"content": "它本身只是一瓶香水而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390751
					]
				},
				{
					"id": 140390731,
					"content": "那是仿製的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140390782
					]
				}
			]
		},
