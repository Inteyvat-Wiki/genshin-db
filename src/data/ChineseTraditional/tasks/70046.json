			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哲倆阿"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700460101,
					"content": "完美，準備工作全都搞定了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460102
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460102,
					"content": "加把勁，哲倆阿，看有沒有辦法幾天之內把牠們全抓起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460103,
						700460104
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460103,
					"content": "抓、抓什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				},
				{
					"id": 700460105,
					"content": "噫！怎麼楓丹也冒出盜獵者了…最近倒賣動物很賺錢嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460106,
					"content": "不行不行，我們要先把妳抓起來，押送執律庭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460107,
					"content": "#…是{F#妳}{M#你}們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460108
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460108,
					"content": "好啊好啊，我剛從執律庭過來，要不要我來帶路？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460109
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460109,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460110,
						700460112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460110,
					"content": "棒欸，我喜歡爽快的人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460111
					]
				},
				{
					"id": 700460111,
					"content": "等等，有點不對勁…聽說要被抓起來還一副完全不怕的模樣，要嘛是慣犯，要嘛是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460114,
					"content": "就是站在正義這邊的好人哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460115
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460115,
					"content": "正確來說，是為了環境去戰鬥的執律庭特聘顧問——「放生徒追獵者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460116
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460116,
					"content": "因為我要抓的可是入侵楓丹水域的外來魚種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460117
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460117,
					"content": "外來…魚種？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460118,
						700460120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460118,
					"content": "好像有點耳熟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460119
					]
				},
				{
					"id": 700460119,
					"content": "啊，的確有印象，以前有在蒙德聽說過類似的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460122,
					"content": "過去的事先不提了，現在的情況更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460123
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460123,
					"content": "這些外來魚種啊，是被有奇怪信仰的商人們特意放生的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460124
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460124,
					"content": "牠們有的非常凶猛，有的繁殖能力超級強，有的還被特殊的飼料餵過，對於本土水生生物來說全都是大麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460125
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460125,
					"content": "要是被牠們鳩佔鵲巢，改變了水下生物的結構，楓丹的水質有可能受到影響…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460126
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460126,
					"content": "就算不談楓丹人的健康這種長遠問題，楓達這類飲料的口感應該也會第一時間就變樣吧。到時候楓丹的經濟也會受到牽連，事情就大條了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460127,
						700460128
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460127,
					"content": "楓達，你還不能倒下！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460129,
					"content": "越是輕描淡寫，越覺得問題很嚴重，我們不能坐視不管！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460130,
					"content": "抓魚這種事我們也很在行的，不如就讓我們來幫妳一把？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460131,
					"content": "#太對了，我就在等這句話，這才是{F#妳}{M#你}們的作風！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460132
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460132,
					"content": "我已經搭好了一個圍捕區，裡面的誘餌會將入侵魚類統統吸引過去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460133
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460133,
					"content": "#拿出{F#妳}{M#你}們執行正義的氣勢吧，榮譽騎士和白色小幫手，我會盡全力支援{F#妳}{M#你}們的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460134
					],
					"speakerTitle": "哲倆阿"
				},
				{
					"id": 700460134,
					"content": "不知道為什麼，感覺這位小姐很瞭解我們…是我的錯覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460128,
					"content": "雖然不怎麼喝，但楓達很重要…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460129
					]
				},
				{
					"id": 700460120,
					"content": "什麼東西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460121
					]
				},
				{
					"id": 700460121,
					"content": "好像有點印象，應該是很久以前我們有在蒙德聽說過類似的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460112,
					"content": "等等…我們好像誤會什麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460113
					]
				},
				{
					"id": 700460113,
					"content": "沒錯，聽說要被抓起來還一副完全不怕的模樣，要嘛是慣犯，要嘛是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700460114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700460104,
					"content": "盜、盜獵？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700460105
					]
				}
			]
		}
	]
}