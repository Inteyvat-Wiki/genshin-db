			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420101,
					"content": "#瞧{F#妳}{M#你}一臉焦急，該不會又有事求我了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420102
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420102,
					"content": "#幸虧來的是{F#妳}{M#你}，換了別人，我可沒心思一而再再而三地笑臉相迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420103
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420103,
					"content": "可我看妳一直在笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420104,
					"content": "剛才那是俗語，好嗎？不許挑我的毛病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420105
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420105,
					"content": "派蒙，說重點…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420106
					]
				},
				{
					"id": 120420106,
					"content": "啊對對，出大事了！影她…她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420107,
					"content": "為八重神子講述了事件經過…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120420108
					]
				},
				{
					"id": 120420108,
					"content": "哦——原來如此，影想把稻妻託付給人類，自己一個人面對這場不知何時才能結束的惡戰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420109,
					"content": "死板又極致，完全憑藉自身意志行動，只要缺少一分實力都無法達成目的…確實是她的作風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420110
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420110,
					"content": "#我說，過去那麼多年她都是這樣，現在{F#妳}{M#你}又是為什麼擔心呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420111,
						120420112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420111,
					"content": "這場對決嚴重性不同於以往。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420113
					]
				},
				{
					"id": 120420113,
					"content": "操之過急…呵呵，這麼說也沒錯。影啊，有時候像個小孩子似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420114
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420114,
					"content": "#所以，{F#妳}{M#你}覺得我能幫上忙？誰告訴{F#妳}{M#你}的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420115,
					"content": "她是在裝傻吧？她故意的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420116,
					"content": "小東西變聰明了嘛。不過這次我說的是實話，有關雷電真的意識空間，我也知之甚少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420117
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420117,
					"content": "我只知道它是神櫻樹的根基，也聽說它和影的「一心淨土」有些差別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420118,
					"content": "是因為雷電真已經不在了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420119,
					"content": "#倒也不全是這樣。空間本身的性質也有差別…比起我在這裡紙上談兵，{F#妳}{M#你}們這些親身造訪過的人應該更有體會吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420120,
						120420121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420120,
					"content": "沒看出來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420122
					]
				},
				{
					"id": 120420122,
					"content": "總之，這些都是細節啦，只是等一下解釋起來比較麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420123
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420123,
					"content": "先跟我到空間入口去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420121,
					"content": "沒注意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420122
					]
				},
				{
					"id": 120420112,
					"content": "她有些操之過急了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420113
					]
				}
			]
		},
		{
			"id": 1204202,
			"completionStepIds": [
				1204204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204204",
							"2"
						],
						"stepId": 1204204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420201,
					"content": "辦法嘛，總是有的，雖然有些狡猾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420202
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420202,
					"content": "意識空間對外行來說非常抽象。好在我是影的眷屬，多少能感應到她的所在之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420203
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420203,
					"content": "#換句話說，我無法定位那個地點在空間裡的確切位置，但能把{F#妳}{M#你}們送到影身邊去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420204
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420204,
					"content": "抽象…？位置？什麼跟什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420205,
					"content": "#{F#妳}{M#你}不用理解了。簡單來說，現在她身旁的一切都很混沌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420206,
					"content": "如湍流一般無序…強行闖入也許會被巨浪捲走，徹底迷失在時間空間之中哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420207
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420207,
					"content": "正因如此，進入「一心淨土」時把意識寄宿在物體上，才是比較保險的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420208,
					"content": "#啊？那我不去了，{F#妳}{M#你}們去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420209,
						120420210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420209,
					"content": "想得美哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420211
					]
				},
				{
					"id": 120420211,
					"content": "不去也行，最壞的情況不就是失去影嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420212,
					"content": "#{F#妳}{M#你}、{F#妳}{M#你}們…唉討厭啦！我陪{F#妳}{M#你}去吧，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420213,
					"content": "#既然心意已決，那我就送{F#妳}{M#你}上路了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420214
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420214,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420215,
					"content": "嗯？這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420216,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420217
					]
				},
				{
					"id": 120420217,
					"content": "沒什麼。感覺很紊亂，證實了我心中的判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420218
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420218,
					"content": "#對了，在進入空間時，記得不斷在心中重複{F#妳}{M#你}的願望哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420219
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420219,
					"content": "#只有強大到一定地步的意識才能不被抽象空間裡的巨浪吞沒。{F#妳}{M#你}足夠強，我才能將{F#妳}{M#你}送到最合適的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420220
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420220,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420221
					]
				},
				{
					"id": 120420221,
					"content": "那麼，門開了，請進吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420222
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420222,
					"content": "#我會守在外側隨機應變，做{F#妳}{M#你}的最後一道保險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420223
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420223,
					"content": "#我的神明就交給{F#妳}{M#你}了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420224
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420224,
					"content": "#為了我，為了稻妻，{F#妳}{M#你}可要好好努力啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420225
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420225,
					"content": "神子，妳靠得住嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420226,
					"content": "我們一定會成功。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420227
					]
				},
				{
					"id": 120420227,
					"content": "好了好了，快去努力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420210,
					"content": "派蒙，妳不會不要我吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420211
					]
				}
			]
		},
		{
			"id": 1204203,
			"completionStepIds": [
				1204206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204206",
							"2"
						],
						"stepId": 1204206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電將軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420301,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420302
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420302,
					"content": "為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420303
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420303,
					"content": "#{F#妳}{M#你}們…怎麼能再次來到這裡？而且…{F#妳}{M#你}們的模樣居然還和當年一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420304
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420304,
					"content": "當年？妳的意思是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420305
					]
				},
				{
					"id": 120420305,
					"content": "這場對決，令人甚是懷念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420306
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420306,
					"content": "彷彿回到了永恆的法則剛剛訂立之時，妳如今這份意志，竟堪比那時。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420307
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420307,
					"content": "無數場戰鬥，妳一次都未落敗，也絲毫沒有猶豫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420308
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420308,
					"content": "即便我將一切永恆之敵都展現在妳的面前，妳也不曾動搖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420309
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420309,
					"content": "能如此堅定地執行規則，妳也值得敬佩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420310
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420310,
					"content": "妳無愧「永恆的守護者」之名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420311
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420311,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}們再次回到這個空間，就像是命運的必然一般。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420312
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420312,
					"content": "那就以這決戰，為我們五百多年的宿命畫上句號吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420313
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420313,
					"content": "決戰？難道妳終於…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420314
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420314,
					"content": "向後退，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420315
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420315,
					"content": "妳要結束一切嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420316
					]
				},
				{
					"id": 120420316,
					"content": "我會成為下一個「開始」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷電將軍"
				}
			]
		},
		{
			"id": 1204204,
			"completionStepIds": [
				1204208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1204208",
							"2"
						],
						"stepId": 1204208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電將軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420401,
					"content": "到此為止。妳贏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420402
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420402,
					"content": "我原以為妳無法超越過去，看來我還是太過武斷，輕視了妳的靈魂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420403
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420403,
					"content": "永不磨損的意志，終究是無法擁抱未來啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420404
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420404,
					"content": "妳無需擔憂未來，也無需獨自前行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420405
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420405,
					"content": "我最懂得妳的強大，若只憑我一己之力，這場決鬥的敗者必然是我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420406
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420406,
					"content": "然而出刀的理由，決定了武藝的格局與極限。我所背負的是投向天光的萬千視線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420407
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420407,
					"content": "每思及此，我就能感覺到這把「夢想一心」中傳來的異動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420408
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420408,
					"content": "這把從真手裡接過的刀，像是在試圖提醒我…激勵我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420409
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420409,
					"content": "我也感覺到了，方才激戰中，它似乎釋放出了全新的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420410
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420410,
					"content": "這份力量，甚至在我的認知之外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420411
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420411,
					"content": "這是真{RUBY#[D]前代雷神}的佩刀。可能在我真正理解並認同她的時候，刀才會全力回應我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420412
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420412,
					"content": "握緊「夢想一心」，讓我有了與她再次並肩的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420413
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420413,
					"content": "熟悉而又陌生…從不揮刀的她，始終在我身旁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420414
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420414,
					"content": "我，認可了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420415
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420415,
					"content": "妳嶄新的意志並非源於磨損。我不會再阻礙妳試圖修改法則的行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420416
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420416,
					"content": "從今往後，此身依然是妳的協助者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420417
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420417,
					"content": "我不會再設下什麼絕不容更改的法則了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420418
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420418,
					"content": "妳曾代表我的過去，但從今天起，妳——就是我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420419
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420419,
					"content": "真從沒把我當成無懼無畏的武器，我也不該將妳視為工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420420
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420420,
					"content": "…呵，妳真的變了。這就是人類常說的「成長」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420421
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420421,
					"content": "我明白了，我會成為妳的影子，就像妳曾經是真的影子一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420422
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420422,
					"content": "我將履行的職責不會改變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420423
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420423,
					"content": "但作為武者，我很期待以後還有像這樣戰鬥的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420424
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420424,
					"content": "單論勝負本身，妳仍心有不甘，是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420425
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420425,
					"content": "只是從來沒有過這樣的感覺，很新奇，值得回味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420426
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420426,
					"content": "打完了？這就算，全部結束了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420427,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420428
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420428,
					"content": "「夢想一心」在發光？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420429
					]
				},
				{
					"id": 120420429,
					"content": "#{F#妳}{M#你}們好啊，影，還有在此的見證者們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420430
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420430,
					"content": "#我是雷電真，沒能盡到職責的前代雷神，為{F#妳}{M#你}們留下了無數的麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420431
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420431,
					"content": "真…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420432
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420432,
					"content": "我很開心，我知道如果是妳的話，一定能走到這一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420433
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420433,
					"content": "我在「夢想一心」中留下了些許微弱的意志，妳發揮出它所有力量的那一刻，我也會被釋放出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420434
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420434,
					"content": "至於為什麼要用如此迂回的方法——因為那時的妳深信自己的想法，什麼都聽不進去嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420435
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420435,
					"content": "可我沒有時間等待妳回心轉意。請原諒，我只能以這種方式等待妳的歸來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420436
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420436,
					"content": "但妳從未向我提起這些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420437
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420437,
					"content": "一切來得太過突然…抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420438
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420438,
					"content": "我一直覺得很愧疚，突然就將稻妻託付給了妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420439
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420439,
					"content": "這些道理，本應由我循序漸進地傳授給妳，讓妳不再執著於「無想」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420440
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420440,
					"content": "那時妳就感知到坎瑞亞即將發生的事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420441
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420441,
					"content": "嗯，多少有點吧。無論是對於哪位塵世執政來說，「那邊」都是不容忽視的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420442
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420442,
					"content": "現在的我已經無法感知到時間了。我不知道我們闊別多久才重逢，也不知道在此期間稻妻經歷了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420443
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420443,
					"content": "但我知道，妳一定走過了極其艱難的路，一定有許多次想要落淚，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420444
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420444,
					"content": "…別小看我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420445
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420445,
					"content": "妳看，妳承認了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420446
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420446,
					"content": "我考慮到這種可能性，才特地為妳留下一份禮物，以緩解稻妻的痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420447
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420447,
					"content": "來吧，在我最後的意識消逝前，收下它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420448
					],
					"speakerTitle": "真"
				},
				{
					"id": 120420448,
					"content": "不過，最重要的一步還是要由妳親手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "真"
				}
			]
		},
