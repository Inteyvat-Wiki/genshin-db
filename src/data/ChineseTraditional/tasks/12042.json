							"2"
						],
						"stepId": 1204209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電將軍"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120420501,
					"content": "#離開意識空間返回神社後，{F#妳}{M#你}們向八重神子講述了一切…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120420502
					]
				},
				{
					"id": 120420502,
					"content": "如今的影親手在意識空間裡種下神櫻樹，它在過去的稻妻發了芽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420503
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420503,
					"content": "無論怎麼想，都是不可思議的事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420504
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420504,
					"content": "這些都歸功於真的力量。對於永恆，她的理解比我更深。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420505
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420505,
					"content": "「永恆」是與時間息息相關的概念。一旦觸及永恆，時間的概念就會變得模糊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420506
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420506,
					"content": "進入空間時我看到了奇妙的景象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420507
					]
				},
				{
					"id": 120420507,
					"content": "時間既在前進，又在後退。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420508
					]
				},
				{
					"id": 120420508,
					"content": "時間本身不具有意義，也無法以常理詮釋…原來，這就是我感受到的「湍流」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420509,
					"content": "#或許，這正是{F#妳}{M#你}們能順利返回這個時間節點的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420510
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420510,
					"content": "不過，那種紊亂感已經完全消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420511
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420511,
					"content": "我還不能完全理解。但直覺告訴我，一切的根源…就是那顆種子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420512
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420512,
					"content": "我倒覺得，只靠真的力量，或許…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420513
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420513,
					"content": "#我明白{F#妳}{M#你}在想什麼。或許真有「更高層{RUBY#[D]伊斯塔露}次的力量」參與其中。但無論如何，她的這個辦法在最後關頭保護了我們所有人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420514
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420514,
					"content": "要是沒有神櫻樹，稻妻可能早在幾百年前就被災難與汙穢完全吞沒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420515
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420515,
					"content": "我知道妳對神櫻樹有奇妙的感知，可對我來說，神櫻樹一直都存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420516
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420516,
					"content": "以前妳還想向我證明這棵神櫻樹與真的意識空間存在關聯，可惜沒能成功，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420517
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420517,
					"content": "嗯，現在我明白了。因為那個時候神櫻樹甚至都還沒有被種下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420518
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420518,
					"content": "可是，妳們不覺得那棵樹跟現在這副樣子差別很大嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420519,
					"content": "神櫻樹可是種在我的地盤裡，當然要根據我的趣味進行修剪啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420520
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420520,
					"content": "呃…妳好霸道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420521,
					"content": "開玩笑的。發芽至今，這棵樹也經歷了很多。多虧狐狸的悉心照料，它才能有如今這副模樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420522
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420522,
					"content": "和我也不是完全無關的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420523
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420523,
					"content": "#{F#妳}{M#你}們離開又再次進入空間，按理說間隔很短，可內部的惡戰已經持續了幾百年，沒錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420524
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420524,
					"content": "#如果我沒猜錯…旅行者，{F#妳}{M#你}一定像我說的，一直默念著心中的願望吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420525,
						120420526
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420525,
					"content": "當然了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420527
					]
				},
				{
					"id": 120420527,
					"content": "那時我感知到影的所在地，也同樣察覺到內部的「時間」有異常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420528
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420528,
					"content": "如果「時間」也是我們追尋所求之物的要素之一，那只知道「位置」是不夠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420529
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420529,
					"content": "#不過幸好，憑藉{F#妳}{M#你}們頑強的意志，湍流帶{F#妳}{M#你}們去到的，正是一切心願匯聚的時間交點——最具有可能性的那個瞬間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420530
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420530,
					"content": "#湍流的走向或許受到了真的影響，但能幫到影，每個人的努力都不可或缺。這一次確實要謝謝{F#妳}{M#你}們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420531
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420531,
					"content": "難道說，我們碰上那場決戰不是偶然，而是我們一定會遇到、見證的場面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420532,
						120420533
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420532,
					"content": "或許這也是將軍說的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420534
					]
				},
				{
					"id": 120420534,
					"content": "我本以為，空間內外的時間流動一致，所以旅行者再度出現，令我非常震驚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420535
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420535,
					"content": "那一刻我首先想到，「莫非稻妻遭遇了巨大的災難？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420536
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420536,
					"content": "#結果原來是{F#妳}{M#你}想要救我…{F#妳}{M#你}們為我而來，幫助我迎來了最好的結局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420537
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420537,
					"content": "#多謝二位。{F#妳}{M#你}們為我做了許多，我銘記在心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420538
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420538,
					"content": "影，妳現在感覺如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420539
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420539,
					"content": "身體完全恢復了，將軍的意志不再和我對抗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420540
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420540,
					"content": "身體當然很重要啦，但我更想知道，妳的心情平復了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420541
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420541,
					"content": "妳見到真的意識了，對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420542
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420542,
					"content": "只是聽到了她的聲音，不算是見到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420543
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420543,
					"content": "沒關係，有點懷念而已。我已經決定向前了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420544
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420544,
					"content": "但這一次又讓我堅信，真確實很厲害，她在那時就預料到了稻妻未來的種種可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420545
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420545,
					"content": "甚至，連我的這份不成熟，都被她計算在內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420546
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420546,
					"content": "稻妻能迎來今天，也是她的功勞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420547,
						120420548
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420547,
					"content": "真很厲害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420549
					]
				},
				{
					"id": 120420549,
					"content": "我只是種了一顆種子而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420550
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420550,
					"content": "妳和她的意志，缺一不可。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420551
					]
				},
				{
					"id": 120420551,
					"content": "對啊！妳是憑自己的本事回到她面前的，很厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420552,
						120420553
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420552,
					"content": "最後的行為看似簡單。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420554,
						120420555
					]
				},
				{
					"id": 120420554,
					"content": "不能因為因果倒轉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420556
					]
				},
				{
					"id": 120420556,
					"content": "#…謝謝{F#妳}{M#你}，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420557
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420557,
					"content": "#直到今天，{F#妳}{M#你}和稻妻才真正從幾百年前的陰影中完全走出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420558
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420558,
					"content": "真和妳，是稻妻不可或缺的「過去」與「未來」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420559
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420559,
					"content": "難得從妳這裡聽到安慰的話，我也收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420560
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420560,
					"content": "哎呀，那不還是因為以前的妳根本聽不進去嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420561
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420561,
					"content": "和真說了一樣的話呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420562
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420562,
					"content": "真的嗎？那將軍的位置，是不是也可以給我坐兩天呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420563
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420563,
					"content": "算了算了，這種麻煩事我才不要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420564
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120420564,
					"content": "玩笑就到此為止。接下來，我還有很多事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420565
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420565,
					"content": "我會和將軍一起仔細審視如今的稻妻，整理現狀，斟酌未來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420566
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420566,
					"content": "隨後…我將下令解除鎖國。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420567
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420567,
					"content": "真的嗎？這是不得了的大事呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420568
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120420568,
					"content": "我已決定不再追逐靜止的「永恆」。既然如此，沒必要再封鎖這個國度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420569
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420569,
					"content": "接下來，稻妻一定會面臨更多挑戰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120420570
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420570,
					"content": "也會誕生出更多「相遇」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420571
					]
				},
				{
					"id": 120420571,
					"content": "我對此充滿期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120420555,
					"content": "就妄自菲薄。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120420556
					]
				},
