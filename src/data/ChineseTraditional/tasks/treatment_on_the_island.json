			},
			"dialogs": [
				{
					"id": 721380501,
					"content": "#呼…呼…心臟都要跳出來了，感謝{F#妳}{M#你}救了我一命，我是不會忘記的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380502
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380502,
					"content": "這種事情也算是正常現象，被「祟神」沾染的生物會不自覺地被散發著不祥氣息的源頭吸引。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380503
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380503,
					"content": "因為藥方中滲透了大量「祟神」的能量，把它們吸引來也是理所應當了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380504
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380504,
					"content": "唔…這樣說，我大致明白應該如何改進調配方式了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380505
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380505,
					"content": "只不過上次的失敗浪費了一部分新鮮藥材，所以我還需要一些藥材來繼續進行製藥試驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380506
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380506,
					"content": "#在接下來的旅途中，還望{NICKNAME}對島上的藥材多加注意，在早上放在屋子前的竹籃裡就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380511
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380511,
					"content": "報酬我會如數付清的，只不過恐怕要麻煩您稍等一陣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380507
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380507,
					"content": "#如果{NICKNAME}還有別的事要忙，也沒有關係，或許我還能找到其他人幫忙採摘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380508,
						721380509
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380508,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				},
				{
					"id": 721380510,
					"content": "#那麼再見了，旅行者{NICKNAME}。希望{F#妳}{M#你}在八醞島的行程一路順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "保本"
				},
				{
					"id": 721380509,
					"content": "我會留意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380510
					]
				}
			]
