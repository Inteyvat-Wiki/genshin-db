			"dialogs": [
				{
					"id": 721380301,
					"content": "沒錯，沒錯，莖葉沒有損壞，而且還很新鮮…謝謝，非常感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380302
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380302,
					"content": "就是這些吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380303
					]
				},
				{
					"id": 721380303,
					"content": "很好，這些足夠了。新藥方的研究可以開始進行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380304
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380304,
					"content": "#再次感謝{F#妳}{M#你}的努力，這裡是之前答應{F#妳}{M#你}的報酬。希望不要嫌棄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380305
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380305,
					"content": "順便，外國人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380306
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380306,
					"content": "#啊，抱歉。麻煩了{F#妳}{M#你}這麼多事，還不知怎麼稱呼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380307
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380307,
					"content": "#叫我{NICKNAME}就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380308
					]
				},
				{
					"id": 721380308,
					"content": "#{NICKNAME}，如果{F#妳}{M#你}還有意幫忙的話，就請過一陣子再回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380309
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380309,
					"content": "當然，報酬是不會少的，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "保本"
				}
			]
		},
