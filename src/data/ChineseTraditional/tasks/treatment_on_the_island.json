			},
			"dialogs": [
				{
					"id": 721380401,
					"content": "#辛苦{F#妳}{M#你}了，{NICKNAME}。如果造成了困擾的話十分抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380402,
						721380403
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380402,
					"content": "不會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				},
				{
					"id": 721380404,
					"content": "#我用{F#妳}{M#你}採到的藥材調配了新的藥方，只是沒有試驗藥效的對象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380405
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380405,
					"content": "#所以能否請{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380406
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380406,
					"content": "請直說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380407
					]
				},
				{
					"id": 721380407,
					"content": "#能否請{NICKNAME}見證我服藥的效果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380408
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380408,
					"content": "新的藥方性質還很不穩定，目前還沒辦法預測最壞的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380409
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380409,
					"content": "所以我希望至少有人能夠見證我的成功…或者替我處理失敗的後果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380410
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380410,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721380403,
					"content": "哪裡的話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380404
					]
				}
			]
