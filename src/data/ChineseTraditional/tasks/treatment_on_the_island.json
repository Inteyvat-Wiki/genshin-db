	"talks": [
		{
			"id": 7213801,
			"completionStepIds": [
				7213801
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213801",
							"2"
						],
						"stepId": 7213801,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"保本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721380101,
					"content": "哇啊！我…我不是什麼可疑人士，只是當地的醫師而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380102
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380102,
					"content": "#不信的話，我可以帶{F#妳}{M#你}們去我的住處，{F#妳}{M#你}們缺什麼直接拿走就好，請放過我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380103
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380103,
					"content": "或者帶我去找你們的總大將九條大人！他認得我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380104,
						721380105
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380104,
					"content": "可能你誤會了什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				},
				{
					"id": 721380106,
					"content": "#欸…？{F#妳}{M#你}們看起來不像是幕府軍的人…也不像是珊瑚宮來的那群傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380107
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380107,
					"content": "#{F#妳}{M#你}們是…外國人？為什麼會出現在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380108,
						721380109
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380108,
					"content": "這個嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380110,
					"content": "#唉…不管怎樣，{F#妳}{M#你}們還是快點離開這裡為妙。現在的八醞島很危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380111
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380111,
					"content": "到今天為止，「祟神」還沒有消散的跡象，天領奉行也沒有撤軍的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380112
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380112,
					"content": "這座島已經不再適宜居住了，更遑論觀光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380113
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380113,
					"content": "#如果{F#妳}{M#你}是為了逃避奉行方追捕而逃來的外國人，就再往西去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380144
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380144,
					"content": "#天領奉行不歡迎來歷不明的逃亡者，但海賊說不定會收留{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380114,
						721380115
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380114,
					"content": "島上發生了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380116,
					"content": "#哼…{F#妳}{M#你}自己看看吧。城裡人和珊瑚宮的傢伙們給我們帶來了什麼好事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380117
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380117,
					"content": "先是踏鞴砂的爆炸，那天的夜空都被染上了奇怪的色彩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380140
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380140,
					"content": "很多親友沒了工作、衣食無著，很多人回家時傷得很重、模樣很悲慘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380141
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380141,
					"content": "也有很多朋友…沒能逃出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380118
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380118,
					"content": "然後，珊瑚宮的傢伙破壞了鎮壓大蛇遺骨的鎮物，「祟神」暴起，島上人人死走逃亡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380119
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380119,
					"content": "「祟神」帶來的怪病也在不斷蔓延，這裡的居民大多病入膏肓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380142
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380142,
					"content": "恐怕傳入兩軍營地，也只不過是時間問題吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380143
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380143,
					"content": "這裡是什麼地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380120
					]
				},
				{
					"id": 721380120,
					"content": "這裡原本是稻妻煉製「玉鋼」所需的晶石的首要產地。只要礦石不枯竭，我們不必受城裡的大人們太多制約，就能過得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380121
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380121,
					"content": "現在呢？現在島上已經沒有幾個活人了…我是說，像我這樣，還能好好說話的「人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380122
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380122,
					"content": "為什麼不離開？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380123
					]
				},
				{
					"id": 721380123,
					"content": "誰不願意離開呢？天領奉行大人的公子也曾延請過我…他現在應該還在軍中督戰吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380124
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380124,
					"content": "「你有醫術，與尋常百姓不同。留在島上實是危險，不如來做我的軍醫。我可以直接將你保舉給父親大人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380145
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380145,
					"content": "他是這麼說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380125
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380125,
					"content": "沒打仗之前，為鳴神島的奉行大人治病，是我這種鄉村小醫生想也不敢想的殊榮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380126
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380126,
					"content": "#但現在…{F#妳}{M#你}想想，奉行大人身邊名醫不會少，可是八醞島呢？這裡只有我一個醫生可以依靠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380127
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380127,
					"content": "所以我不會離開，也不會專門替某一方的軍士看病。我的敵人只有「祟神」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380128
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380128,
					"content": "有什麼可幫忙的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380129
					]
				},
				{
					"id": 721380129,
					"content": "沒什麼…唔，算了，我確實需要幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380130
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380130,
					"content": "我需要一些特殊的草藥來調配藥方，嘗試治療「祟神」引起的怪病。雖然不知道效果會如何…但試試總是好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380131
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380131,
					"content": "只不過…那些草藥被「祟神」所沾染，又大多分佈在危險的環境裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380146
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380146,
					"content": "要嘛被天塹相隔、要嘛有怪物盤踞，而且這些地帶「祟神」肆虐最嚴重…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380132
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380132,
					"content": "以我的膽量和能力，怕是很難應付得來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380133
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380133,
					"content": "而且我作為醫生，不敢冒著這麼大的風險採集藥材，便只能使用慢效的保守療法…久久實驗不出新的藥方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380134
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380134,
					"content": "#外國人，我看{F#妳}{M#你}隨身攜帶著「風之翼」，想必是經驗豐富的旅行者了。這種程度的危險，應該很容易便能克服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380135
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380135,
					"content": "#所以，希望能辛苦{F#妳}{M#你}在這些地點幫我採到合適的藥材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380136
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380136,
					"content": "等採到之後，來這裡與我會合。請不必擔心報酬，我還有些積蓄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380137
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380137,
					"content": "雖然只是素不相識之人的委託，希望您務必考慮一下。多謝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380138
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380138,
					"content": "#順便，希望{F#妳}{M#你}一路小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "保本"
				},
				{
					"id": 721380115,
					"content": "你看起來很沮喪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380116
					]
				},
				{
					"id": 721380109,
					"content": "說來話長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380110
					]
				},
				{
					"id": 721380105,
					"content": "確實可疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721380106
					]
				}
			]
		},
		{
