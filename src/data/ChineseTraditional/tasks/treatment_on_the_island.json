			"dialogs": [
				{
					"id": 721380201,
					"content": "#啊，{F#妳}{M#你}來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721380202
					],
					"speakerTitle": "保本"
				},
				{
					"id": 721380202,
					"content": "#請問{F#妳}{M#你}採到我所說的藥材了嗎？",
					"roleType": "TALK_ROLE_NPC",
