			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐寧",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740801,
					"content": "算上這次的，一共是九枚「老石」，這下應該夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740802
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740802,
					"content": "#這麼快就滿足了輝山廳的需求…真不愧是{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740803
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740803,
					"content": "只不過是巨獸之勞啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740804,
					"content": "是「舉手之勞」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740805
					]
				},
				{
					"id": 710740805,
					"content": "哇！我是說…嗯…這種東西和打倒巨獸一樣，都是小意思而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740806,
					"content": "派蒙學會強詞奪理了，可喜可賀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740807
					]
				},
				{
					"id": 710740807,
					"content": "#哈哈…派蒙說的沒錯啦，兩位力搏海魔的功績，我們都看在眼裡的。相信此等壯舉對{F#妳}{M#你}們來說確實並不困難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740808,
						710740809
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740808,
					"content": "確實如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				},
				{
					"id": 710740810,
					"content": "說來，沒想到進了總務司，還要負責「在層岩找老石」這種工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740811
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740811,
					"content": "對喔，你那個時候不是還天天和自己父親吵架。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740812,
					"content": "怎麼後來去了總務司的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740813,
					"content": "之前我不是欠了一大筆錢，走投無路，更不願回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740814
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740814,
					"content": "結果討債的人直接去盛露廳找上了我爸…我聽到這件事時心想，我爸非得把我腿打斷不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740815
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740815,
					"content": "可是你的腿看起來還挺完整的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740816,
					"content": "是…說來慚愧，我爸幫我把錢還了，在街上找到了落魄的我，說，「你所有欠條都在我手裡，所以現在你欠我錢了」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740817
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740817,
					"content": "以此要脅我找工作…以償還欠款。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740818
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740818,
					"content": "原來你現在欠的是你爸的錢啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740819,
					"content": "是這樣沒錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740820
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740820,
					"content": "當然，那個時候我每日逃債，惶惶不可終日，早就決定，如果有機會就一定洗心革面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740821
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740821,
					"content": "但是我沒想到這個機會竟然是那個時常跟我吵架的老爸給我的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740822
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740822,
					"content": "我爸也破天荒沒有和我吵架，反而開誠佈公地談了談，這種談話要是能早些開始就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740823
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740823,
					"content": "不過就算之前他有心跟我談，那個時候我也沒心情聽吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740824
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740824,
					"content": "看來你家老爺子對你還蠻好的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740825,
					"content": "是啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740826
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740826,
					"content": "所以無論如何，都得做好手上的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740827
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740827,
					"content": "無論是這次層岩的事，還是幫輝山廳打雜找「老石」的活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740828
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740828,
					"content": "這次活明明是我幫你做的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740829
					]
				},
				{
					"id": 710740829,
					"content": "找人幫忙完成工作，也是完成工作的一種方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740830
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740830,
					"content": "不過這次也真是多虧了二位，能這麼快完成這件工作，出乎了我的意料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740831
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740831,
					"content": "知道就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740809,
					"content": "要說困難還是有一點啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740810
					]
				}
			]
		}
	]
}