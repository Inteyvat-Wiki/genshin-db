				"points": []
			},
			"dialogs": [
				{
					"id": 710740301,
					"content": "請問兩位找到「老石」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740302
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740302,
					"content": "在這裡了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7107404,
			"completionStepIds": [
				7107403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7107403",
							"2"
						],
						"stepId": 7107403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐寧",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740401,
					"content": "#果然是「老石」，還真是多謝{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740402
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740402,
					"content": "#委託{F#妳}{M#你}們真是正確的決定。若是委託冒險家協會，他們都不可能那麼快找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740403
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740403,
					"content": "那可不一定，說不定冒險家協會他們會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740404,
					"content": "直接把委託轉給我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740405
					]
				},
				{
					"id": 710740405,
					"content": "確實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740406
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740406,
					"content": "冒險家…嗯…以前我還挺羡慕那些冒險家的，每天不是上高就是下低，好像沒有他們不敢去的地方似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740407
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740407,
					"content": "像我被派來層岩巨淵幹了這麼多年了，連層岩巨淵之頂…啊就是丹砂崖，都沒上去過一次呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740408
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740408,
					"content": "你居然沒去過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740409,
					"content": "丹砂崖，怎麼說呢，就像是那種「很知名，但是本地人卻不怎麼去的旅遊景點」一類的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740410
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740410,
					"content": "可能是想著，反正離得那麼近，之後有空的時候總有時間去看一眼…結果一次都沒去成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740411
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740411,
					"content": "不如現在就去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740412,
					"content": "想到就做也是很重要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740413,
					"content": "免了免了，現在還不是我「有空」的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740414
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740414,
					"content": "更何況，那種到處跑腿的事，交給那群冒險家做就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740415
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740415,
					"content": "他們去的都是些很危險的地方，我要是去了，半路受傷的話…那可就不好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740416
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740416,
					"content": "確實，受傷是件很嚴重的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740417,
					"content": "若是我受傷的話，下面勘探隊就會沒人監督，礦工安全檢查也沒人負責了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740418
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740418,
					"content": "但凡有什麼意外，就要出很嚴重的大問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740419
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740419,
					"content": "原來問題嚴重在這裡嗎…我還以為沐寧只是怕受傷而已呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740420,
					"content": "像是層岩巨淵周圍那些高得要命的懸崖呀、深得不行的深澗呀…還有岩王爺留下的古戰場呀，那種危險的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740421
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740421,
					"content": "我可是一點都不想靠近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740422
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740422,
					"content": "#好了，這就是{F#妳}{M#你}們找這三枚老石的酬金。輝山廳對老石的需求還是挺大的，要是{F#妳}{M#你}發現了老石，這裡按照三枚一批來收…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740423
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740423,
					"content": "當然了，也會給到相應的報酬，找到老石記得來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740424
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740424,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
