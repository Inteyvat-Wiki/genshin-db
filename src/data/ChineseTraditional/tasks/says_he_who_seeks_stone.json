					"nextDialogs": []
				}
			]
		},
		{
			"id": 7107406,
			"completionStepIds": [
				7107405
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐寧",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710740601,
					"content": "又是三枚「老石」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740602
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740602,
					"content": "這兩位「熱心群眾」上交的「老石」，我就好好收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740603
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740603,
					"content": "沒想到這麼快就找到了兩枚，而且品相比我之前見過的都好上不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740604
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740604,
					"content": "唉…這讓我想起以前我有的那枚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740605
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740605,
					"content": "你的那枚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740606,
						710740607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740606,
					"content": "你自己有還要我們找？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				},
				{
					"id": 710740608,
					"content": "是「以前」我有的那枚啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740609
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740609,
					"content": "我爸在盛露廳，那枚「老石」是一小塊過他手的邊角料，品相也不是很好，他就把那枚石頭當玩具丟給了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740610
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740610,
					"content": "我那時天天和他吵架，遊手好閒，還流連岩上茶室，欠了一大筆錢，走投無路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740611
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740611,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740612,
					"content": "有點差勁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740613
					]
				},
				{
					"id": 710740613,
					"content": "這個，誰都有年輕的時候嘛，反正就是我走投無路之時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740614
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740614,
					"content": "正好有認出「老石」的人願意花錢買，一塊石頭罷了，賣就賣了，得了摩拉解了一時之憂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740615
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740615,
					"content": "結果前幾日我爸聊起這件事時，說，「沐寧啊，你以前玩的那塊石頭怎麼不見了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740616
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740616,
					"content": "我只好說，「一塊石頭而已，還能留到現在？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740617
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740617,
					"content": "嘴上那麼說，心裡卻想著，要是當初沒賣那石頭，他聊起的時候掏出來給他看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740618
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740618,
					"content": "…算了算了，想這些也沒用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740619
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740619,
					"content": "現在改正了就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710740620,
					"content": "#{F#妳}{M#你}說的是…只不過以前欠的錢還是要慢慢償還。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740621
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740621,
					"content": "不說了，如果還有「老石」，記得帶給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740622,
						710740623
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740622,
					"content": "還不夠嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740624,
					"content": "我想想，再給我三枚吧，再給我三枚應該夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710740625
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740625,
					"content": "老石本來就是稀有礦材，輝山廳如果還要，層岩這邊應該也找不到更多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710740623,
					"content": "到底需要多少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740624
					]
				},
				{
					"id": 710740607,
					"content": "來，把你自己的先繳了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710740608
					]
				}
			]
		},
