				"points": []
			},
			"dialogs": [
				{
					"id": 706570101,
					"content": "#{F#妳}{M#你}好，我是西風騎士團的莉茲。相信{F#妳}{M#你}也聽說了吧，風花節期間，蒙德會有各式各樣的好玩活動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570102,
						706570103
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706570102,
					"content": "有所耳聞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				},
				{
					"id": 706570104,
					"content": "我的工作，就是接待來到蒙德的客人，讓每個人都能充分享受這個節日的樂趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570105
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706570105,
					"content": "因為舉辦活動的地方不一定在城內，如果沒人來介紹，有很多精彩遊戲就會被錯過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570106
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706570106,
					"content": "#現在要隆重向{F#妳}{M#你}推薦的就是這個——「百發百中」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570107
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706570107,
					"content": "顧名思義，就是射擊天上的目標，如果又快又準，就可以獲得高分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570108,
						706570109
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706570108,
					"content": "感覺很有意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570110,
					"content": "#沒關係啦，我把位置幫{F#妳}{M#你}標記出來，{F#妳}{M#你}親自去試一試就知道啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570111
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706570111,
					"content": "#根據{F#妳}{M#你}獲得的分數，還可以獲得價值不等的獎品，無論是體驗一下，還是追求極致，都很有樂趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570112,
						706570113
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706570112,
					"content": "有點興趣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570114,
					"content": "嗯嗯，先去試試看吧！如果還想了解接下來的活動，也可以來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706570115
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706570115,
					"content": "#祝{F#妳}{M#你}玩得愉快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉茲"
				},
				{
					"id": 706570113,
					"content": "謝謝妳的介紹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570114
					]
				},
				{
					"id": 706570109,
					"content": "感覺有點難。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570110
					]
				},
				{
					"id": 706570103,
					"content": "第一次聽說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706570104
					]
				}
			]
		}
	]
