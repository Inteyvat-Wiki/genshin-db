			},
			"dialogs": [
				{
					"id": 4861001,
					"content": "咦，是凱亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4861002,
					"content": "#哦，我正在等{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861003
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4861003,
					"content": "#琴病倒的事我已經聽說了，我應該代表騎士團的大家向{F#妳}{M#你}們表示感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861004
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4861004,
					"content": "凱亞突然這麼認真地道謝，感覺好不習慣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4861005,
					"content": "哈哈，畢竟事關我們所重視的代理團長大人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861006
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4861006,
					"content": "對了，除了道謝以外，還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861007
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4861007,
					"content": "要安排工作給我們？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861008
					]
				},
				{
					"id": 4861008,
					"content": "沒錯~！我們之間還真是有默契。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861009
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4861009,
					"content": "是給獎勵的環節了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4861010
					]
				},
				{
					"id": 4861010,
					"content": "#哈哈哈，我喜歡{F#妳}{M#你}的說話風格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861011
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4861011,
					"content": "不過在談這些之前，希望還能再幫騎士團一些忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861012
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4861012,
					"content": "是要分擔琴的工作吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4861013,
					"content": "#是的，雖然{F#妳}{M#你}之前彙報給琴的委託已經安排過人去辦了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861014
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4861014,
					"content": "…可是畢竟不是琴親自出馬，我擔心還是會有些紕漏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861015
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4861015,
					"content": "#希望{F#妳}{M#你}可以去看看還有沒有可以幫忙的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861016
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4861016,
					"content": "如果能有享譽蒙德的「榮譽騎士」出手的話，我也就可以放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861017
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4861017,
					"content": "#即使你再怎麼誇{NICKNAME}，我也要說——你為什麼不自己去幫忙呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4861018,
					"content": "哈哈，我的身上還有更重要的任務…有很多東西要…嗯，「準備」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861019
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4861019,
					"content": "哼，那好吧。我記得是…<color=#00E1FFFF>莎拉小姐、查爾斯先生還有瑪格麗特小姐</color>那邊，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4861020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4861020,
					"content": "沒錯，那麼就辛苦兩位了，回頭見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				}
			]
		},
