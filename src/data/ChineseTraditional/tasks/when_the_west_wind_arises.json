				{
					"id": 4860815,
					"content": "琴的工作那麼多，多一份人手總歸是好事啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860816
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4860816,
					"content": "#拜託{F#妳}{M#你}們<color=#00E1FFFF>回騎士團看看吧</color>，琴這邊有我在就好，我自己一個人就可以啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860817
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4860817,
					"content": "怎麼有點著急趕人走的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860818,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860819
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 4860819,
					"content": "#沒事啦，那就不打擾妳們了。走吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
