			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莎拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860203,
					"content": "有什麼事嗎，莎拉小姐？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860204
					]
				},
				{
					"id": 4860204,
					"content": "抱歉，剛剛已經吃過飯了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860205
					]
				},
				{
					"id": 4860202,
					"content": "#終於等到{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860203
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860205,
					"content": "不是在招攬生意啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860206
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860206,
					"content": "#我要委託騎士團一些事，想要麻煩{F#妳}{M#你}們帶話給代理團長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860207
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860207,
					"content": "原來是要找琴呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860209,
					"content": "是互相信賴的同伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860210
					]
				},
				{
					"id": 4860211,
					"content": "有過一面之交。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860212
					]
				},
				{
					"id": 4860213,
					"content": "是她忠實的奴僕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860214
					]
				},
				{
					"id": 4860208,
					"content": "#嗯？{F#妳}{M#你}們和琴團長很熟嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860209
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860210,
					"content": "這樣啊？和琴小姐在一起的話，一定很令人安心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860211
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860212,
					"content": "#我倒是聽說琴小姐很喜歡{F#妳}{M#你}們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860213
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860214,
					"content": "奴，奴僕？西風騎士團難道也要走上舊貴族的道路了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860215
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860215,
					"content": "#對不起，{NICKNAME}的幽默感有時很怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860216,
					"content": "所以莎拉小姐要帶的話是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860217,
					"content": "嗯…很不好意思，我現在沒法自己去騎士團，因為最近餐館實在忙得團團轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860218
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860218,
					"content": "可是就在這種時候，我們與清泉鎮的食材供應路線，似乎被丘丘人佔領了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860219
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860220,
					"content": "是要拜託騎士團清理道路吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860221
					]
				},
				{
					"id": 4860222,
					"content": "明白了，該給獵人們一點教訓了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860223
					]
				},
				{
					"id": 4860219,
					"content": "但清泉鎮的獵人們又一副事不關己的樣子，說他們只負責狩獵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860220
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860221,
					"content": "沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860222
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860223,
					"content": "不對吧！那樣真的能解決問題嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860225,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860226
					]
				},
				{
					"id": 4860224,
					"content": "請代我<color=#00E1FFFF>委託</color>琴團長安排人手，清理運輸路線的丘丘人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860225
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860226,
					"content": "呼…有救了。有琴去處理的話，一定很快就能解決了吧，謝謝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860227
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860227,
					"content": "琴真是被大家信任著呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860228,
					"content": "啊，對了。<color=#00E1FFFF>酒保查爾斯</color>先生也說過有些麻煩事的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860229
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860229,
					"content": "#不如{F#妳}{M#你}們先順路去他那裡看看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860230
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 4860230,
					"content": "好吧，幫人幫到底也是派蒙我的作風哦…嗯，雖然好像不是那麼順路的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 48603,
			"completionStepIds": [
				48603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48603",
							"2"
						],
						"stepId": 48603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"查爾斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4860301,
					"content": "把我這裡當成果汁店了嗎？小朋友們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860302
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4860302,
					"content": "哼，真是失禮，我們明明是來幫忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860303,
					"content": "#幫忙？哦對了，{F#妳}{M#你}們是代理團長面前的紅人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860304
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4860304,
					"content": "唔…好奇怪的說法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860305,
					"content": "#那麻煩{F#妳}{M#你}們幫我跟琴要來這個季度的稅收報表。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860306
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4860306,
					"content": "畢竟又到了找埃澤先生彙總帳目的時候了…不得不說，蒙德酒水的稅費還真是高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860307
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4860307,
					"content": "這種事也要直接找琴嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860308
					]
				},
				{
					"id": 4860308,
					"content": "可是晨曦酒莊依然那麼有錢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4860309
					]
				},
				{
					"id": 4860309,
					"content": "那主要還是歸功於迪盧克老爺經營有方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860310
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4860310,
					"content": "為什麼報表在琴那裡，記帳也是琴的工作嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4860311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4860311,
