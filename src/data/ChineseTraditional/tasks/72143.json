				]
			},
			"mark": "TALK_MARK_BILLBOARD_ONLY",
			"trigger": {
				"objectNames": [
					"露子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721430101,
					"content": "您好，自外而來的客人。我叫露子，是珊瑚宮的巫女。請問客人是來幫忙的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430102
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430102,
					"content": "幫忙…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430103
					]
				},
				{
					"id": 721430103,
					"content": "這個人怎麼一見面就要人幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430104,
					"content": "哈哈，抱歉失禮了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430105
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430105,
					"content": "只是此前我求過願。根據籤文，我所苦惱之事、困擾之事，必定有人相助而得以圓滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430106
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430106,
					"content": "現在命中的貴人果然來幫助我了，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430107,
						721430109
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430107,
					"content": "這是藉口吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430108
					]
				},
				{
					"id": 721430108,
					"content": "真是沒辦法呢，還是先聽聽露子姐姐怎麼說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430111,
					"content": "非常感謝。那麼，就請允許我為您稍事介紹吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430112
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430112,
					"content": "珊瑚宮正對的深潭便是「淵下宮」的入口，傳說也是海祇人的起源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430113
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430113,
					"content": "在古代，曾經有「海祇美人」的說法，並且說海祇人膚質細嫩，可以令七種難隱的汙痕都不再顯眼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430114
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430114,
					"content": "這種說法的來由呢，是因為我們的祖先在淵下宮得不到日照…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430115,
						721430116
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430115,
					"content": "咳咳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430117
					]
				},
				{
					"id": 721430117,
					"content": "啊，抱歉。以前日子和平時，我經常擔任嚮導，向旅人介紹海祇島，不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430118
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430118,
					"content": "為了紀念海祇大御神與先人，我們傳統上會將祭品沉入淵下宮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430119
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430119,
					"content": "先前有說，我們的祖先起源於「白夜國」，仰賴著文獻記載中的大日御輿的微薄光亮，在深海龍嗣的利爪下苟且生存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430120
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430120,
					"content": "直至數千年前，海祇大御神降臨，擊敗深海龍嗣，最終又帶領我們回到地面上，建立珊瑚宮，以腳下的海祇島為新的故鄉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430121
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430121,
					"content": "而海面下的白夜國，從此被稱為淵下宮，與海面上的珊瑚宮相對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430122
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430122,
					"content": "當然…傳說只是傳說，正如鳴神人的魔神征服論之於幕府軍一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430123
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430123,
					"content": "犧牲與銘記的主題也是我們捍衛自身的武器之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430124
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430124,
					"content": "這是巫女該說的話嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430125,
					"content": "巫女的確不應該說這樣的話，但是生而為人，我認為應當用批判的眼光看待歷史與民俗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430126
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430126,
					"content": "抱歉，我又離題了…如今，海祇島的「聖土」問題愈發嚴重了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430127
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430127,
					"content": "「聖土」…那是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430128
					]
				},
				{
					"id": 721430128,
					"content": "正如人心與水總往低處流，海祇島的「靈」被淵下宮的深邃吸引…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430129
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430129,
					"content": "所以土地也漸漸白化，也就是聖土化。這麼下去海祇島終有一天會淪為和月光一般蒼白的荒漠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430130,
						721430132
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430130,
					"content": "聽起來很可怕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430131
					]
				},
				{
					"id": 721430131,
					"content": "是嗎？在我看來，不過是老人們駭人聽聞的說法罷了。雖然其中有一定的道理，但依然缺乏可信的邏輯聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430133
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430133,
					"content": "依照傳統的教導，每隔數百年，就需要在靈脈流淌合適時，解開阻斷淵下宮與珊瑚宮連接的結界…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430134
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430134,
					"content": "潛入淵下宮，取出一株大御神留下的，鎮壓深海龍嗣的珊瑚玉枝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430135
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430135,
					"content": "借玉枝進行海祇御靈祭，就可以使沉下去的「靈」歸還，遏制聖土侵蝕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430136
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430136,
					"content": "鎮壓深海龍嗣的東西被取走…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430137
					]
				},
				{
					"id": 721430137,
					"content": "您有著敏銳的洞察力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430138
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430138,
					"content": "鎮壓用的珊瑚玉枝有許多，但這樣下去，深海的龍嗣恐怕總有一天能突破鎮壓，進而入侵海祇地表。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430139
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430139,
					"content": "所以說，我想拜託您…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430140,
						721430142
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430140,
					"content": "取回珊瑚玉枝？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430141
					]
				},
				{
					"id": 721430141,
					"content": "#{NICKNAME}很擅長找東西的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430144,
					"content": "現階段而言，還不是這些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430145
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430145,
					"content": "之後還要幫忙喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430146,
					"content": "之後的話…嗯…看情況吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430147
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430147,
					"content": "…是看求籤的結果嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430148,
					"content": "咳咳，我需要麻煩您造訪海祇島上的「五傷岩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430149
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430149,
					"content": "五傷岩是隔斷珊瑚宮與淵下宮的結界的五處節點，由珊瑚宮初代的神人們同大御神設下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430150
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430150,
					"content": "如果要解除結界，進入淵下宮，就要解除這五處封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430151
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430151,
					"content": "聽起來很危險的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430152,
					"content": "確實，貿然打開封印的話風險很大。畢竟已經過了很多年，我們這一代人誰也不知道下面隱藏著怎樣的危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430153
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430153,
					"content": "值得仰賴的記錄很少，大多都是語焉不詳、沒有多少參考價值的古文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430154
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430154,
					"content": "或許深海龍嗣正在下面蓄勢待發，抑或是有比龍嗣更危險的魔物潛入其中，等待著封印鬆動之刻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430155
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430155,
					"content": "或許過去的城墟已經被掩埋在珊瑚與海綿之下無處找尋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430156
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430156,
					"content": "或者最差勁的結果——下面什麼都沒有，只是空洞與海水？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430157
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430157,
					"content": "無論如何，我們只在這裡胡思亂想是沒辦法得知這些結果的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430158
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430158,
					"content": "雖然說得好像很有道理，但出力的還是我們嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430159
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430159,
					"content": "不過既然淵下宮這麼多年無人造訪，或許祖先留下的寶藏也還在其中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430160
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430160,
					"content": "#寶…咳咳。{NICKNAME}，我覺得幫當地人解決問題，是能充實閱歷的好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430161,
					"content": "…露子小姐真會說話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430162
					]
				},
				{
					"id": 721430162,
					"content": "您過獎了。那麼，就進入正題吧。五傷岩有五處，分別是「眼」、「牙」、「鰭」、「尾」，與「心」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430163
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430163,
					"content": "#首先是<color=#00E1FFFF>西邊的島</color>上，被稱為「眼」的封印。{F#妳}{M#你}看，就在那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430164
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430164,
					"content": "那妳自己去不就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430165
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430165,
					"content": "嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430166
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430166,
					"content": "給我嚴肅點啦！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430167,
					"content": "封印本身維持已久，如今解除封印的儀式對大多數人而言都是未知的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430168
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430168,
					"content": "再加上現人神巫女大人因為現在的形勢，很難騰出時間及時舉行盛大儀式解除五重封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430169
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430169,
					"content": "告知外人這些，實在是令人羞赧難當。嗚呼，能夠仰賴的，只有像您這樣見多識廣、博聞強記的遠國異人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430170
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430170,
					"content": "就是萬一搞砸了，也可以借您異人的身分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430171
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430171,
					"content": "頂罪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430172
					]
				},
				{
					"id": 721430172,
					"content": "不…您想多了，只不過是「不知者不罪」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430173
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430173,
					"content": "如果以<color=#00E1FFFF>珊瑚宮</color>為方位基點的話，則「牙」位於<color=#00E1FFFF>西北方</color>，「鰭」位於<color=#00E1FFFF>正北方</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430174
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430174,
					"content": "最後，是<color=#00E1FFFF>東面淺灘</color>上的「尾」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430175
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430175,
					"content": "這四處封印附近，各有一座石碑，記錄著儀式相關事宜…只是年代已久，字跡已經難以辨認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430176
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430176,
					"content": "取得這四處封印中的「御靈珠」，就能解開第五重的「心」之封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430177
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430177,
					"content": "聽起來很複雜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430178
					]
				},
				{
					"id": 721430178,
					"content": "沒關係的，如果怕忘記的話就請來珊瑚宮找我，我再逐一為您提示就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430179
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430179,
					"content": "最後…這次將您攔下，私自委託如此重要的事情，實在有違禮節，我在此深切致歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430180
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430180,
					"content": "但無論如何，這件事情對海祇島來說事關重大…如果您能夠幫忙，珊瑚宮將對此感激不盡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 721430142,
					"content": "解決深海龍嗣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430143
					]
				},
				{
					"id": 721430143,
					"content": "#{NICKNAME}很擅長戰鬥呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721430132,
					"content": "那要怎麼解決呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430133
					]
				},
				{
					"id": 721430116,
					"content": "關於要幫忙的事情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430117
					]
				},
				{
					"id": 721430109,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430110
					]
				},
				{
					"id": 721430110,
					"content": "這都是什麼求人幫忙的理由…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430111
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7214302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7214301",
							"3"
						],
						"stepId": 7214301,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7214302",
							"2"
						],
						"stepId": 7214302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"露子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721430201,
					"content": "您回來了。請問有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430202,
						721430206,
						721430211
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430202,
					"content": "關於「五傷岩」的位置…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430203
					]
				},
				{
					"id": 721430203,
					"content": "<color=#00E1FFFF>「眼」</color>在<color=#00E1FFFF>正西邊的島嶼</color>上；<color=#00E1FFFF>「牙」</color>在<color=#00E1FFFF>西北方的海岸</color>上；<color=#00E1FFFF>「鰭」</color>在<color=#00E1FFFF>正北方的海岸</color>上，而<color=#00E1FFFF>「尾」</color>則在<color=#00E1FFFF>東南方的淺灘</color>上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430204
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430204,
					"content": "這四處封印附近，各有一座石碑，記錄著儀式相關事宜…只是年代已久，字跡已經難以辨認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430205
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430205,
					"content": "從這四處封印中取得四枚「御靈珠」，才能解開「心」之封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430214
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430214,
					"content": "然後在必要的時刻，再解開封印取玉枝，行海祇御靈祭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430215
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430215,
					"content": "但我在教令院學到的知識告訴我，所謂的聖土化是海祇島的地質結構決定的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430216
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430216,
					"content": "隨著海水的浸入，土地變得乾硬，鹽鹼會排除掉原有的養分，讓土壤中的元素反應惰化，不再適合耕種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430217
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430217,
					"content": "而玉枝中蘊含的大御神的力量，可以為土地補充元素，抵消白化的影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430218
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430218,
					"content": "咳咳，抱歉，又說了離題的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 721430206,
					"content": "關於「五傷岩」的名字…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430207
					]
				},
				{
					"id": 721430207,
					"content": "啊，您是想問為什麼這幾處封印這樣稱呼是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430208
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430208,
					"content": "大御神大人有一神使，神人們在它的骸骨上設置了封印，用它的力量屏斷了海祇與淵下的聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430209
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430209,
					"content": "不信的話您可以自己看看地圖，左邊突出鼓泡的便是「眼」，右下角伸展而出的便是「尾」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430210
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430210,
					"content": "好啦，別這樣看著我！同行的解釋就是這樣的！我也很難接受啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 721430211,
					"content": "關於「聖土化」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721430212
					]
				},
				{
					"id": 721430212,
					"content": "通行的說法是，土地白化是海祇土地的「靈」被白夜國吸引、下沉所致，最終會使海祇淪為荒漠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721430213
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721430213,
					"content": "而多虧了珊瑚宮的鎮壓作用，以及現人神巫女大人所繼承的大御神之神力，「聖土化」才沒有擴散至全島。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				}
			]
		}
	]
}