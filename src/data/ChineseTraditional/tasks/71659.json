			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鶯兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590301,
					"content": "#{F#妳}{M#你}們終於想起我啦？還帶來了一位朋友…是特意來陪我的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590302
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590302,
					"content": "嗚，我有點不好意思了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590303,
					"content": "其實…鶯兒小姐，我們是來拜訪「丹劑宗匠」的，請問妳認識這位大師嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590304,
					"content": "啊呀，原來還是另有所圖嗎？我有一點失望哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590305
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590305,
					"content": "#不過，{F#妳}{M#你}們居然在打聽我的秘密，還挺讓我驚喜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590306,
						716590307
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590306,
					"content": "秘密？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590308
					]
				},
				{
					"id": 716590308,
					"content": "等等！難道說，鶯兒小姐就是「丹劑宗匠」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590309,
					"content": "越來越聰明啦，真招人喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590310
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590310,
					"content": "完全沒想到會是這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590311,
					"content": "「丹劑宗匠」竟然如此年輕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590312
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590312,
					"content": "和阿貝多老師給人的感覺截然不同，但也有一股深不可測的氣息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590313
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590313,
					"content": "看你們急切的神情，似乎遇上了難題呢，不妨和我直說吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590314
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590314,
					"content": "不知為什麼，總覺得事情要朝著無法預料的方向發展了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590315,
					"content": "和蒂瑪烏斯一起向鶯兒解釋了「煙霰丹劑」的研究課題。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590316
					]
				},
				{
					"id": 716590316,
					"content": "原來如此，這位煉金術士正在研究奇妙的「煙霰丹劑」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590317
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590317,
					"content": "可惜啊，要讓你們失望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590318
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590318,
					"content": "你們正在調查的「煙霰丹劑」只不過是我特製的一種古法香膏而已，和煉金術完全無關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590319
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590319,
					"content": "香膏？那不是一種固體香料嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590320
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590320,
					"content": "「煙霰丹劑」這個名字聽起來明明很厲害啊！書裡也寫著它能讓人們變強…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590321,
					"content": "呵呵，大概是我的古法香膏太受歡迎的緣故吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590322
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590322,
					"content": "古代的文人曾強調「薰陶」一詞。長期沉浸在香膏的芬芳中，人們的氣質和心性也會受到影響哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590323
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590323,
					"content": "使用了我的古法香膏之後，人們的氣質大變，魅力大增，待人接物的信心大漲，人際關係也不斷改善。事業步步高升，生活順心順意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590324
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590324,
					"content": "就像是使用了仙人的丹藥一樣，運勢明顯好轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590325
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590325,
					"content": "因此，人們給我的古法香膏取了個富有詩意的稱號，還寫下了簡單易懂的詩詞，誇讚它們的功效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590326
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590326,
					"content": "原來是這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590327,
					"content": "不可能啊…難不成，我在那本書裡讀到的論文並不準確？或者說，我對詩詞的理解出現了偏差？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590328
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590328,
					"content": "比如「丹香悠邈煥儀質」。這一段的含義應該是：「煙霰丹劑」能激發出人的威儀和潛力…沒錯吧，鶯兒小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590329
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590329,
					"content": "啊呀，「儀質」其實是一個完整的詞，意為人的風度和氣質。這句詩詞其實是在說，古法香膏令人擁有了煥然一新的容姿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590330
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590330,
					"content": "也不能怪你，詩詞也是一門深奧的學問，可不能像分析數據那樣，拆開成零散的文字來解讀，而是要注意整體的意境哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590331
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590331,
					"content": "逐字逐句拆解的分析方法居然不管用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590332
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590332,
					"content": "可是那本書還提到了不少「煙霰丹劑」發揮神奇功效的例子，讓我看得目瞪口呆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590333
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590333,
					"content": "刺激而神秘的事物總是令人神往的嘛，就像透過窗紙的婀娜身影。記錄坊間傳聞的書籍，也需要適當的藝術加工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590334
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590334,
					"content": "多謝那位作者的誇讚啦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590335
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590335,
					"content": "怎麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590336
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590336,
					"content": "也就是說，蒂瑪烏斯的參考資料誇大了香膏的效果，他也錯誤地理解了詩詞。導致他誤以為「煙霰丹劑」是強大的煉金術藥劑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590337,
						716590338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590337,
					"content": "還好有心理準備。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590339
					]
				},
				{
					"id": 716590339,
					"content": "到頭來，我的研究課題完全建立在錯誤的理論上啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590340
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590340,
					"content": "這次研究失敗了，我又做了無用功…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590341
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590341,
					"content": "欸呀，也不必喪氣嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590342
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590342,
					"content": "有道是「峰迴路轉見蹊徑，枯樹新芽亦成蔭」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590343
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590343,
					"content": "或許煉製香膏的古法能給你一些啟示，讓你突破最後的瓶頸，製作出理想中的藥劑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590344
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590344,
					"content": "的確，雖然出發點不太可靠，但蒂瑪烏斯憑藉自己的理解，也取得了一定的進展呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590345,
					"content": "既然鶯兒小姐都這樣提議了，不如就試一試吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590346
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590346,
					"content": "也許能收穫意外之喜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590347
					]
				},
				{
					"id": 716590347,
					"content": "說得在理…煉金術是一門深奧的學問，我也不是第一次失敗了，必須打起精神來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590348
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590348,
					"content": "大多時候，我還是能準確解讀資料的，這次是意外！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590349
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590349,
					"content": "就算無法做出傳說中的奇妙藥劑，改進現有的煉金藥劑，也算是不錯的成就！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590350
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590350,
					"content": "鶯兒小姐，旅行者，我們現在就去合成台附近吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590338,
					"content": "總感覺不太意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590339
					]
				},
				{
					"id": 716590307,
					"content": "驚喜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590308
					]
				}
			]
		},
		{
			"id": 7165904,
			"completionStepIds": [
				7165904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165904",
							"2"
						],
						"stepId": 7165904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂瑪烏斯",
					"鶯兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590401,
					"content": "製作古法香膏的流程啊，可是相當講究的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590402
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590402,
					"content": "要像摩挲戀人的肌膚一樣，以極為溫柔的力道剝開花苞，取下花瓣，將它們細緻地疊放。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590403
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590403,
					"content": "纖薄的花瓣在上，厚實的花瓣在下，留下適當的空隙，再將它們搗碎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590404
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590404,
					"content": "臼杵不必握得太緊，手腕要放鬆，節奏要起伏有致。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590405
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590405,
					"content": "等到花瓣的汁液瀰漫，臼杵的底部完全濕潤，再適當加快速度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590406
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590406,
					"content": "這…咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590407
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590407,
					"content": "鶯兒小姐的用詞還真是…特別！我大概理解妳的意思了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590408
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590408,
					"content": "謹慎處理原料，注意置入容器的次序，把握浸入基液的時間，以便精確控制火候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590409
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590409,
					"content": "製作一些高等煉金藥劑時，也需要以這麼嚴格的要求把控細節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590410
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590410,
					"content": "你的悟性很不錯嘛，但製作香膏的要點遠不止這些哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590411
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590411,
					"content": "有些香膏的「昇華效應」極為重要，需要加入合適的輔料，比如薄荷和星螺磨製的粉末。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590412
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590412,
					"content": "這樣一來，香膏的氣味就能快速瀰漫開來，讓周圍的人心曠神怡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590413
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590413,
					"content": "但「昇華效應」也不能太強，否則，香膏很快就會消耗殆盡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590414
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590414,
					"content": "昇華…昇華？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590415
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590415,
					"content": "我懂了，古法香膏的這種特性，正是我所追求的關鍵之處！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590416
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590416,
					"content": "瀰漫在空氣裡的藥劑能同時作用於使用者和環境，相比普通的精油，效果應該更明顯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590417
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590417,
					"content": "而且，適當控制昇華的速度以後，持續時間應該也會比普通的精油更長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590418
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590418,
					"content": "向這個方向努力，絕對不會有錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590419
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590419,
					"content": "進入學術討論後，就完全插不上嘴了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590420,
					"content": "還是不要打擾他們兩位了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590421,
					"content": "在鶯兒的指點下，蒂瑪烏斯嘗試製作了改進的煉金藥劑。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590422
					]
				},
				{
					"id": 716590422,
					"content": "好香啊！只是聞到這種氣味，就讓人感覺十分清爽，又充滿力量呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590423,
						716590424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590423,
					"content": "的確讓人打起精神來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590425
					]
				},
				{
					"id": 716590425,
					"content": "成功了！我總算成功了！結合了香膏古法的煉金藥劑完成了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590426
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590426,
					"content": "多虧了鶯兒小姐的指導，我才能在這麼短的時間內找到竅門，順利製備這些藥劑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590427
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590427,
					"content": "太謙虛的話，就會顯得虛假和客套啦。你的學識和悟性才是成功的關鍵哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590428
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590428,
					"content": "現在…不如先為你的心血之作取個名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590429
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590429,
					"content": "就叫它們「煙霰魔藥」吧！它們結合了鶯兒小姐的香膏和煉金藥劑的特性，意義非凡，一定會被記載在學術史上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590430
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590430,
					"content": "啊呀，真讓我受寵若驚呢~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590431
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590431,
					"content": "不過這個名字和之前的「煙霰丹劑」…沒什麼區別吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590432,
					"content": "咳咳，言歸正傳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590433
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590433,
					"content": "#旅行者，{F#妳}{M#你}會是「煙霰魔藥」的首位使用者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590434
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590434,
					"content": "#目前的「煙霰魔藥」還需要完善，能麻煩{F#妳}{M#你}試驗一下這些藥劑的效果嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590435
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590435,
					"content": "在空氣流動相對緩慢的區域，「煙霰魔藥」的效果會更明顯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590436
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590436,
					"content": "聽說璃月有一些無人造訪的秘境，它們是相當理想的試驗場地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590437,
						716590438
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590437,
					"content": "幫人幫到底。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590439
					]
				},
				{
					"id": 716590439,
					"content": "#那就有勞{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590440
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590440,
					"content": "#我會在這裡待上一段時間，繼續和鶯兒小姐交流學術，等著{F#妳}{M#你}的回饋，準備改進「煙霰魔藥」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590441
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590441,
					"content": "#等{F#妳}{M#你}們的好消息哦~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 716590438,
					"content": "我也起興致了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590439
					]
				},
				{
					"id": 716590424,
					"content": "的確有著神奇的功效。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590425
					]
				}
			]
		},
