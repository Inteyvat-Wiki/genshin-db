					"弘毅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590701,
					"content": "你好！我們在找吃虎岩的「丹劑宗匠」，請問你知道他住在哪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590702,
					"content": "不好意思，我不了解街坊鄰居們的綽號，只記得他們登記在冊的正式姓名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590703
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 716590703,
					"content": "或許你們可以請教「春香窯」的鶯兒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590704
					],
					"speakerTitle": "弘毅"
				},
				{
					"id": 716590704,
					"content": "有道理哦！鶯兒小姐應該很熟悉這方面的事吧，我們去問問她好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
