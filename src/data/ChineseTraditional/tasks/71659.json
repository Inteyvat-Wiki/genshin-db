			"dialogs": [
				{
					"id": 716590601,
					"content": "你好！請問你認識住在這附近的「丹劑宗匠」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590602,
					"content": "「丹劑宗匠」？沒聽說過這號人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590603
					],
					"speakerTitle": "小千"
				},
				{
					"id": 716590603,
					"content": "只有地位顯赫的人才配得上「宗匠」這種稱號吧？我這種小人物當然不認識了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590604
					],
					"speakerTitle": "小千"
				},
				{
					"id": 716590604,
					"content": "唔，那我們去問問其他人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
