			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂瑪烏斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716590101,
					"content": "似乎只差一點了…爭取在九個小時內製作出第一份「煙霰丹劑」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590102
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590102,
					"content": "蒂瑪烏斯？你在幹嘛呀，表情這麼嚴肅？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590103,
					"content": "#是{F#妳}{M#你}們！好久不見了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590104
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590104,
					"content": "實在不好意思，我正在試製「煙霰丹劑」，可能需要佔用合成台一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590105
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590105,
					"content": "「煙霰丹劑」？完全沒聽說過這種東西呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590106,
					"content": "這是近年來出現的神秘藥劑，我也是在一本冷門的學術書籍上讀到相關資料的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590107
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590107,
					"content": "據作者所說，「煙霰丹劑」起源於璃月，能讓使用者的力量成倍增長，效果無與倫比，想必是強大煉金術的造物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590108
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590108,
					"content": "「煙霰丹劑」在璃月得到了高度認可，有著諸如「丹香悠邈煥儀質」的描述…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590109
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590109,
					"content": "我仔細進行了評估——如果成功試製「煙霰丹劑」，我對煉金術的理解至少能進步十年！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590110
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590110,
					"content": "進步十年？這也太厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590111,
						716590112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590111,
					"content": "前提是那本書的說法屬實。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590113
					]
				},
				{
					"id": 716590113,
					"content": "放心吧！這本書的作者是個萬事通，寫過不少令人拍案叫絕的論文！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590114
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590114,
					"content": "煉金術是一門奇妙的學問，在發掘古代的技術的同時，參考當世之人的研究成果，不斷演化和進步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590115
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590115,
					"content": "所以我才會尋找各種資料，從中發掘能為煉金術提供幫助的知識，推進我的主要課題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590116
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590116,
					"content": "蒂瑪烏斯的心態還真是積極進取呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590117,
					"content": "如果兩位能協助我，我肯定能順利完成這次研究，獲得阿貝多老師的認可！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590118
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590118,
					"content": "也許我能藉此機會成為阿貝多老師的助手，常駐在他的營地裡，研究更高深的課題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590119
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590119,
					"content": "#怎麼辦，{NICKNAME}？我們要答應他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590120,
						716590121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590120,
					"content": "為了自由使用合成台…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590122
					]
				},
				{
					"id": 716590122,
					"content": "還是幫幫他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590123,
					"content": "#感謝兩位！我一定會全力答謝{F#妳}{M#你}們的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590124
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590124,
					"content": "等到我的「煙霰丹劑」試製成功，兩位就能第一時間享受到它的神奇功效，快速變強！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590125,
						716590126
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590125,
					"content": "也不必這麼客氣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590127
					]
				},
				{
					"id": 716590127,
					"content": "比起試用藥劑和快快變強，我更想要很多很多好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590128,
					"content": "那更不成問題了！事成之後，我會支付足夠的報酬，然後請兩位任選餐館，痛痛快快吃一頓大餐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590129
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590129,
					"content": "真的嗎！一言為定哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590130,
					"content": "協助蒂瑪烏斯，嘗試製作傳說中的「煙霰丹劑」…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						716590131
					]
				},
				{
					"id": 716590131,
					"content": "唉！只憑我掌握的工藝，還是沒法製作出「煙霰丹劑」，果然還是要請教一下專家啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590132
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590132,
					"content": "比如阿貝多嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590133,
					"content": "不行！絕對不行，這麼幹不就等於在考試途中向老師詢問答案嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590134
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590134,
					"content": "要是被阿貝多老師知道，我連這麼一種藥劑都做不出來，他就更不可能認可我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590135
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590135,
					"content": "有道理哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590136,
					"content": "不如去問問砂糖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590137
					]
				},
				{
					"id": 716590137,
					"content": "雖然砂糖小姐對煉金術的理解的確遠遠超過我，但她專攻的領域和「煙霰丹劑」基本無關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590138
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590138,
					"content": "而且她平時研究也很忙，我也不好意思去打擾她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590139
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590139,
					"content": "不如去請教麗莎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590140
					]
				},
				{
					"id": 716590140,
					"content": "麗莎小姐最近正在整理圖書館的藏書，據說工作量很恐怖…要是被人打擾了，麗莎小姐說不定心情也會不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590141
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590141,
					"content": "總之！我們還是、還是別去打擾她了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590142
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590142,
					"content": "那怎麼辦？這不是完全沒辦法了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590143,
					"content": "辦法…倒是有。只不過不在蒙德，而是在…璃月。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590144
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590144,
					"content": "那本書籍裡提到過，「宗匠閒清隱隔鄰，薰風郁靄籠岩港」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590145
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590145,
					"content": "聽說「薰風」這個詞在璃月有著「南風」的意思，所以創造出「煙霞丹劑」的「丹劑宗匠」應該就住在璃月港的南部區域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590146
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590146,
					"content": "直接請教那位「丹劑宗匠」，當然是最有效的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590147
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590147,
					"content": "所以，能不能請二位和我一同前往璃月？我對那裡實在是不熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590148,
						716590149
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590148,
					"content": "這句詩的含義…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590150
					]
				},
				{
					"id": 716590150,
					"content": "當然！請相信我分析資料的能力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590151
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590151,
					"content": "還要去璃月…好遠啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590152,
					"content": "對了，聽說璃月的料理相當美味，事成之後，我們可以直接在璃月吃飯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590153
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590153,
					"content": "好主意欸！我支持！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590154
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590154,
					"content": "那我要把「萬民堂」的所有招牌菜都吃一遍！「萬民堂」的菜，無論吃幾次都不夠呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590155,
						716590156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716590155,
					"content": "會不會太破費了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590157
					]
				},
				{
					"id": 716590157,
					"content": "別擔心，比起研究的成果…不對，是兩位幫助我的恩情，這點錢根本不算什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590158
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590158,
					"content": "我們現在就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590156,
					"content": "蒂瑪烏斯的存款…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590157
					]
				},
				{
					"id": 716590149,
					"content": "你確定嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590150
					]
				},
				{
					"id": 716590126,
					"content": "我不需要藉助外力變強…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590127
					]
				},
				{
					"id": 716590121,
					"content": "為了蒂瑪烏斯的學術生涯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590122
					]
				},
				{
					"id": 716590112,
					"content": "前提是你的評估足夠準確。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716590113
					]
				}
			]
		},
