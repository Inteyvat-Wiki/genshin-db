				"points": []
			},
			"dialogs": [
				{
					"id": 716590201,
					"content": "我看看地圖啊…璃月港的南部是叫「吃虎岩」沒錯吧？那傳說中的「丹劑宗匠」應該就住在這一帶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716590202
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 716590202,
					"content": "我們到了，這裡就是「吃虎岩」！趕快在附近找找看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7165903,
			"completionStepIds": [
				7165903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7165903",
							"2"
						],
						"stepId": 7165903,
						"stateName": "QUEST_STATE_UNFINISHED"
