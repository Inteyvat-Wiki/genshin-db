	"talks": [
		{
			"id": 7165901,
			"completionStepIds": [
				7165901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
