				"objectNames": [
					"阿鴻"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760401,
					"content": "「馱獸大王」，那是幾天前的事啦，為了找一種特殊礦石，不知不覺就翻到山外去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760402
					],
					"speakerTitle": "阿鴻"
				},
				{
					"id": 730760402,
					"content": "哎呀，就看到那隻大馱獸，真的大啊，從沒見過那麼大的馱獸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760403
					],
					"speakerTitle": "阿鴻"
				},
				{
					"id": 730760403,
					"content": "一見到我就往我這邊衝，幸好我跑得快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760404
					],
					"speakerTitle": "阿鴻"
				},
				{
					"id": 730760404,
					"content": "翻到哪邊的山外？嗯，是西邊那塊的某座山吧，具體的…我也記不清楚了，但肯定是西邊就對了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿鴻"
				}
			]
		},
