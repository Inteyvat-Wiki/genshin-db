			"trigger": {
				"objectNames": [
					"納吉布",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760501,
					"content": "#喔，「馱獸大王」？{F#妳}{M#你}們說的就是那個巨大的馱獸是吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760502
					],
					"speakerTitle": "納吉布"
				},
				{
					"id": 730760502,
					"content": "前兩天我想要去璃月，途徑層岩巨淵旁的時候，就看到了那個傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760503
					],
					"speakerTitle": "納吉布"
				},
				{
					"id": 730760503,
					"content": "幸好那個時候它在睡覺。我小心翼翼地繞過去，逃了一劫啊。它睡覺的時候就跟個小山丘似的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760504
					],
					"speakerTitle": "納吉布"
				},
				{
					"id": 730760504,
					"content": "#嗯？{F#妳}{M#你}說位置嗎，從這裡到璃月得向南走，應該是南邊的某個地方吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760505
					],
					"speakerTitle": "納吉布"
				},
				{
					"id": 730760505,
					"content": "…咦，可是一般從須彌到璃月應該走水路才對，為什麼要往層岩巨淵那個方向去啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760506,
					"content": "#這、這是個人隱私吧，和{F#妳}{M#你}們問的東西又沒關係！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760507
					],
					"speakerTitle": "納吉布"
				},
				{
					"id": 730760507,
					"content": "好了，我知道的就這麼多，我還有別的事要做…別來煩我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納吉布"
				}
			]
		},
