				{
					"id": 730761001,
					"content": "「關於近期出現在附近的大型長鬢虎一事：」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761002
					],
					"speakerTitle": "一張告示"
				},
				{
					"id": 730761002,
					"content": "「請勿在入夜後於附近逗留，據調查，該長鬢虎經常在夜間出沒。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730761003
					],
					"speakerTitle": "一張告示"
				},
				{
					"id": 730761003,
					"content": "「請勿在附近投放肉食，投放肉食令長鬢虎飽足，並非正確的保持安全之法，反而會吸引長鬢虎長期在此活動。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一張告示"
				}
			]
