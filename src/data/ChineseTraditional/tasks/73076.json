				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760701,
					"content": "咦，什麼，已經把兇猛動物驅趕走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760702
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760702,
					"content": "我都還沒見到呢…怎麼樣，那些兇猛動物是不是都挺強悍的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760703,
						730760705
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760703,
					"content": "也就那樣吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760704
					]
				},
				{
					"id": 730760704,
					"content": "哈哈，看起來真是游刃有餘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760707,
					"content": "雖然聽說那些兇猛動物都被驅逐，打從心底鬆了口氣，但是不知為何，沒有親手驅逐他們，也讓人覺得不甘心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760708
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760708,
					"content": "獵物被更強的對手搶走的畫面，在自然中也是屢見不鮮啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760709
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760709,
					"content": "哈哈哈，如果還有下次，我是不會輸的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760710
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760710,
					"content": "我們也不會輸的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760711
					]
				},
				{
					"id": 730760711,
					"content": "是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760712,
					"content": "不過，之前就覺得，「兇猛動物的防治」，在須彌應該是巡林員的工作吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760713,
					"content": "喔，我不是之前也說了嗎，我接受了委託…其實那個委託就是認識的巡林員給我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760714
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760714,
					"content": "由於最近「死域」的一些問題，具體我也不清楚，但是他們似乎花了很多人力負責調查那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760715
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760715,
					"content": "所以「兇猛動物的防治」這樣的工作就委託給我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760716
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760716,
					"content": "原來是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760717,
					"content": "#這次就多謝{F#妳}{M#你}了！這是驅逐兇猛動物的報酬，還請拿好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760705,
					"content": "可厲害了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760706
					]
				},
				{
					"id": 730760706,
					"content": "是嗎，真想親眼見一見…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760707
					],
					"speakerTitle": "桑頓"
				}
			]
		},
