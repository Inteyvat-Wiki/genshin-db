				"objectNames": [
					"安納亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760601,
					"content": "咦，關於「馱獸大王」…啊啊，那是我前幾天晚上去森林裡的時候看到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760602
					],
					"speakerTitle": "安納亞"
				},
				{
					"id": 730760602,
					"content": "本來就是個全是烏雲的晚上，我走路走到一半，發現旁邊有一個小山般的黑影伴隨著地震般轟隆隆的響聲向我衝來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760603
					],
					"speakerTitle": "安納亞"
				},
				{
					"id": 730760603,
					"content": "當時我就被嚇暈過去，恢復意識已經是第二天的事了。把我背回來的人說，我昏倒在了山腳下…幸好沒受什麼重傷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760604
					],
					"speakerTitle": "安納亞"
				},
				{
					"id": 730760604,
					"content": "#{F#妳}{M#你}說位置嘛…我也不太清楚，反正應該是在東邊吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安納亞"
				}
			]
		},
