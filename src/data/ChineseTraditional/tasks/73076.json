			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760101,
					"content": "哎呀…果然在須彌，才能感受到更多自然的氣息啊，哈哈，相較而言，楓丹簡直就是烏煙瘴氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760102
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760102,
					"content": "嗯？怎麼了，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760103
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760103,
					"content": "只是有些好奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760104
					]
				},
				{
					"id": 730760104,
					"content": "是啊，你就住在這個帳篷裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760105,
					"content": "對，最近一段時間我都住在這裡…哈哈我懂了，看到一個楓丹人住在須彌野外的帳篷，覺得很不可思議對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760106
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760106,
					"content": "至於為什麼這樣，就讓我好好解釋一番吧…啊，首先，兩位的名字是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760107
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760107,
					"content": "我叫派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760108,
					"content": "#我叫{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760109
					]
				},
				{
					"id": 730760109,
					"content": "#原來如此，是{NICKNAME}和派蒙，我記住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760110
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760110,
					"content": "#我是桑頓，如{F#妳}{M#你}們所見，我是一個楓丹人…之所以來須彌的理由嘛，當然是因為喜歡森林！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760111
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760111,
					"content": "總是生活在城市中，身體會因為缺少鍛煉而衰弱，精神也會變得鬆懈和倦怠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760112
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760112,
					"content": "只有在廣袤的自然中，才能重新得到那種與自然萬物共存的深刻體會，而森林正是貼近自然最好的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760113
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760113,
					"content": "所以就來須彌了，畢竟這裡的森林大概是全提瓦特最好的森林啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760114
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760114,
					"content": "好像聽懂了，但是又好像完全沒有懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760115,
					"content": "不過須彌的森林可是很危險的，有各種大大小小的魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760116,
					"content": "當然要危險才行啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760117
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760117,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760118,
					"content": "要是不危險的話，就沒有那種求生的感覺了！不用擔心，我其實在楓丹也是有名的獵人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760119
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760119,
					"content": "什麼呀，原來你說喜歡森林，是喜歡在森林裡狩獵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760120,
					"content": "哼，根本就是個楓丹來的偷獵者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760121,
						730760122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760121,
					"content": "看來我們必須干預一下了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				},
				{
					"id": 730760123,
					"content": "#等等等等，{F#妳}{M#你}們弄錯了，我可不是偷獵者…偷獵可是相當嚴重的違法行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760124
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760124,
					"content": "在楓丹如果被抓到偷獵，那一輩子就完了，我可不敢。我們楓丹獵人所做的，其實大多只是「兇猛動物的防治」而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760125
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760125,
					"content": "兇猛動物的…防治？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760126,
					"content": "#{F#妳}{M#你}想啊，太過靠近人類居住區的兇猛動物會導致雙方都受到傷害吧…所以得把它們趕到居住區一定距離以外才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760127
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760127,
					"content": "是、是這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760128,
					"content": "這樣，附近的居民就不用面臨兇猛動物的侵擾，而對於那些動物來說，居民的活動也不會對它們正常生活產生困擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760129
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760129,
					"content": "實不相瞞，我也是聽說了附近有類似的兇猛動物，接受了驅逐它們的委託，才住在這裡的，身為獵人，怎麼能坐視不管呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760130
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760130,
					"content": "…當然了，我個人也對這些兇猛動物有點興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760131
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760131,
					"content": "#{F#妳}{M#你}看，這個就很讓人在意，「生長過度的大型鱷魚」，被孩子們稱為「鱷魚大王」，總覺得是在什麼下水道傳說裡出現的角色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760132
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760132,
					"content": "聽說經常出沒在附近的水域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760133
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760133,
					"content": "還有「經常會嘗試偷走孩童的長鬢虎羅闍」，「攔在通往璃月道路上的巨大馱獸」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760134
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760134,
					"content": "「長鬢虎羅闍」好像在西邊的密林裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760135
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760135,
					"content": "「馱獸大王」，喔也就是那隻巨大馱獸，也有幾個被嚇破了膽子的目擊者，說是在東邊的某塊區域徘徊，一看到行人就會攻擊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760136
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760136,
					"content": "聽起來都挺危險的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760137,
					"content": "#是啊，要是{F#妳}{M#你}們遇到了，一定要小心…嗯，不知為何能從{F#妳}{M#你}們身上感受到那種老練獵人的氣息，或許我的擔憂是多餘的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760138
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760138,
					"content": "如果路上遇到了，就幫忙驅逐一下這些兇猛動物吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760139
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760139,
					"content": "這樣周圍的居民也不會遇到危險了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760140
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760140,
					"content": "嗯，如果遇到的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760141
					]
				},
				{
					"id": 730760141,
					"content": "那真是太感謝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760142
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760142,
					"content": "#附近居民的安全，這些兇猛動物的安全，當然了，還有{F#妳}{M#你}們自己的安全，都要注意啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760143
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 730760143,
					"content": "嗯嗯，知道啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730760122,
					"content": "偷獵是會破壞生態的行為！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760123
					]
				}
			]
		},
