					"桑頓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730760301,
					"content": "#怎麼樣，{F#妳}{M#你}遇到那些兇猛動物了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760302
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760302,
					"content": "#遇到的話就請{F#妳}{M#你}幫忙驅逐掉那些兇猛動物吧…「兇猛動物防治」，可是件有利於居民和動物雙方的有益之舉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760303,
						730760305,
						730760309,
						730760313
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760303,
					"content": "關於「鱷魚大王」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760304
					]
				},
				{
					"id": 730760304,
					"content": "據說「鱷魚大王」就在城東邊的水域附近…不過似乎很是狡猾，我去了好幾次都沒有見到啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760305,
					"content": "關於「長鬢虎羅闍」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760306
					]
				},
				{
					"id": 730760306,
					"content": "附近似乎都在傳「長鬢虎羅闍」的故事，說在夜半時分，它會從西邊的森林裡跑出來，抓走那些不願乖乖睡覺的頑皮鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760307
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760307,
					"content": "雖然後面大概是父母嚇唬孩子的說辭，不過據說「長鬢虎」在夜間確實會更活躍一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760308
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760308,
					"content": "聽說有半夜趕路的旅人就曾經看到過那隻巨大的「長鬢虎」，被追了好一段路，好在沒有出什麼事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760309,
					"content": "關於「馱獸大王」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760310
					]
				},
				{
					"id": 730760310,
					"content": "聽說一些野生馱獸有很強的領地概念，陌生人一旦進入領地就會受到它們的攻擊，恐怕「馱獸大王」也一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760311
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760311,
					"content": "它的領地就在東邊的某個區域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730760312
					],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760312,
					"content": "究竟多大的馱獸能夠被人叫作「馱獸大王」，真是讓人在意啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑頓"
				},
				{
					"id": 730760313,
					"content": "還在調查…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730760314
					]
				},
				{
					"id": 730760314,
					"content": "是嘛，那就繼續加油吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "桑頓"
				}
			]
		},
		{
