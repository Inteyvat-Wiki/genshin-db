			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"申鶴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705090101,
					"content": "#{NICKNAME}，{F#妳}{M#你}好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090102
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090102,
					"content": "妳好呀！唉，要不是連續見了那麼多朋友，我肯定會很驚訝，連妳都來了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090103,
					"content": "不…不對，這不是申鶴嘛！我果然還是被驚訝到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090104,
					"content": "嗯…這裡確實不好找。「天使的饋贈」…名字拗口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090105
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090105,
					"content": "多虧熱心的鍾離先生幫忙指路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090106
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090106,
					"content": "還請人指路了啊…我猜猜看，妳是專程趕來喝東西的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090107,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090108
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090108,
					"content": "因為是…朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090109
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090109,
					"content": "想喝點什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090110
					]
				},
				{
					"id": 705090110,
					"content": "來，這裡有菜單！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090111,
					"content": "北風之望…北風，是涼嗖嗖的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090112
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090112,
					"content": "唔，這個名字裡的北風應該是指北風狼吧？冷…的確挺冷的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090113,
					"content": "焦糖松果…為什麼能拿來喝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090114
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090114,
					"content": "啊，這個我嚐過。是焦糖味的咖啡，松果…松果說的應該是顏色！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090115,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090116
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090116,
					"content": "看名字，完全無法理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090117
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090117,
					"content": "#交給{F#妳}{M#你}們吧。類似清心、琉璃袋…那種味道的就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090118
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090118,
					"content": "這裡的土壤不長這些藥材啦，想喝苦的東西，就只有咖啡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090119,
					"content": "要不要試試甜味的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090120
					]
				},
				{
					"id": 705090120,
					"content": "…好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090121
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090121,
					"content": "也對，修行久了是該換換口味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090122,
					"content": "我們給申鶴來一杯覆雪之吻吧！看名字就跟她很搭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7050902,
			"completionStepIds": [
				7050903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7050903",
							"2"
						],
						"stepId": 7050903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"申鶴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705090201,
					"content": "很甜，口感順滑，不苦澀。這是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090202
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090202,
					"content": "它叫「覆雪之吻」！把牛奶打成細密的奶泡輕輕倒在果汁上，看起來就像是覆蓋著積雪一樣哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090203,
					"content": "至於為什麼要叫吻什麼的…我也不懂…可能是商家的花招吧，為了讓它更好賣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090204,
					"content": "更好賣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090205
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090205,
					"content": "欸？不是嗎？我、我亂說的…那、那它是一種…浪漫的形容！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090206,
					"content": "浪漫…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090207
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090207,
					"content": "嗚…好難解釋啊！不要逼我編故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090208,
						705090209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090208,
					"content": "奶泡沒有太多味道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090210
					]
				},
				{
					"id": 705090210,
					"content": "是這樣沒錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090211,
						705090212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090211,
					"content": "喝到果汁的那一刻很甜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090213
					]
				},
				{
					"id": 705090213,
					"content": "…啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090214
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090214,
					"content": "這樣啊…我似乎明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090215
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090215,
					"content": "欸？欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090216,
					"content": "等一下，為什麼啊！現在換我不明白了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705090217,
					"content": "我在山間走動時，偶爾會嚼食仙草，也曾親眼目睹幼芽破土的刹那。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090218
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090218,
					"content": "心中那份悸動…的確，與此刻很是相似。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090219
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090219,
					"content": "#{NICKNAME}，謝謝{F#妳}{M#你}能讓我明白這些…難懂的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705090220
					],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090220,
					"content": "#往後，或許也要麻煩{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "申鶴"
				},
				{
					"id": 705090212,
					"content": "如同嫩芽破冰，親吻了妳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090213
					]
				},
				{
					"id": 705090209,
					"content": "就像山頂的積雪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705090210
					]
				}
			]
		}
	]
}