			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"庫蕾瑪娜",
					"派蒙"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2944.732,
							203.779,
							9785.503
						],
						"pointId": 11062
					},
					{
						"sceneId": 3,
						"position": [
							-2946.541,
							203.922,
							9783.725
						],
						"pointId": 11325
					},
					{
						"sceneId": 3,
						"position": [
							-2945.759,
							203.869,
							9785.573
						],
						"pointId": 11326
					}
				]
			},
			"dialogs": [
				{
					"id": 751940101,
					"content": "#等一下、等一下，這是商品，不買別碰啊！欸…{F#妳}{M#你}，對黃頭髮那位，就是{F#妳}{M#你}，別著急走，讓我再看看{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940102
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940102,
					"content": "#唔——果然如此，有如太陽般耀眼的頭髮、有如夜神之國般深邃的雙目…我大概，不，我篤定，{F#妳}{M#你}將來會成為不得了的人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940103
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940103,
					"content": "#來來來，我這裡有一組奇妙的玉飾，裡面蘊含著各式各樣不同的旋律，正巧配得上{F#妳}{M#你}這樣的大英雄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940104
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940104,
					"content": "#不過，這可是無價之寶。一般人來買，我起碼開價一千多萬摩拉。但我看{F#妳}{M#你}與這些玉飾有緣，就給{F#妳}{M#你}打個一折，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940105
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940105,
					"content": "哇，一折！那豈不是跳樓大拍賣嗎！等等…那不還是要一百多萬摩拉嗎！這也太貴了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751940106,
					"content": "哎呀，沒辦法。這已經是成本價了，畢竟我們這種小商小販也不好做嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940107,
						751940108
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940107,
					"content": "經費可不應該這樣賺哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				},
				{
					"id": 751940109,
					"content": "#原來您都聽到了啊。啊哈哈，{F#妳}{M#你}看我這喜歡自言自語的毛病啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940110
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940110,
					"content": "唉——既然都被發現了，我就實話實說了。這玉帛是我撿來的，也的確不值這個價格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940111
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940111,
					"content": "但我也沒辦法，如您所聽到的，我們很缺經費，缺到連請人回收水上浮標資料的工錢都湊不出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940112
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940112,
					"content": "那就不要回收了嘛，總比騙人好吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751940113,
					"content": "不行啊…對於別的組織來說，缺經費無非就是不活動了，但我們的組織還肩負著觀察火山的志工任務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940114
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940114,
					"content": "我們投放浮標也是為了藉助收集水溫等資料監控火山的活動情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940115
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940115,
					"content": "眼下火山的活動越來越活躍，浮標的回收也必須加緊，不然可能會出大問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940116
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940116,
					"content": "要不是我受過傷，根本破壞不了浮標，更不要提回收裡面的資料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940117
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940117,
					"content": "#{NICKNAME}，{F#妳}{M#你}看我們要不要幫幫她？畢竟火山的事情，跟大家的安危有關，我們總不能視而不見吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751940118,
					"content": "#真、真的？如果{F#妳}{M#你}們願意幫我的話，這些玉帛我就免費送{F#妳}{M#你}們了！就當成{F#妳}{M#你}們的報酬，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940119,
						751940120
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940119,
					"content": "不是說有一百萬嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940121,
					"content": "#{F#妳}{M#你}放心，雖然沒有特別多，但除了玉帛之外，一定還會有額外的報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940122
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940122,
					"content": "嘿嘿，只要玉帛也足夠啦！畢竟這次是為了在火山旁邊的大家嘛！總而言之，妳就放心交給我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940123,
						751940124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751940123,
					"content": "現在就開始吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 751940124,
					"content": "需要準備一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940125
					]
				},
				{
					"id": 751940125,
					"content": "嗯嗯，我這邊隨時都可以開始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940120,
					"content": "啊…原來只有玉帛呀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940121
					]
				},
				{
					"id": 751940108,
					"content": "什麼打雜值一百萬摩拉啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940109
					]
				}
			]
		},
		{
			"id": 7519404,
			"completionStepIds": [
				7519404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7519404",
							"2"
						],
						"stepId": 7519404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"庫蕾瑪娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940401,
					"content": "呼…太好了，從結果上來看，火山的情況並沒有預想中的那麼糟，這下大家能睡個好覺了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940402
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940402,
					"content": "#這還得多謝{F#妳}{M#你}們，要不是{F#妳}{M#你}們不計前嫌出手相助，想來這件事也不會這麼順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940403
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940403,
					"content": "#請{F#妳}{M#你}們務必收下這份報酬，這算是我個人的賠罪和感謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940404
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940404,
					"content": "嘿嘿，既然妳這麼說，那我們就恭敬不如從命啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940405
					]
				},
				{
					"id": 751940405,
					"content": "妳接下來準備怎麼辦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940406
					]
				},
				{
					"id": 751940406,
					"content": "我手裡還有一些囤積的貨物，只要運作一番，經費自然就有啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940407
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940407,
					"content": "#哈哈，當然啦，這次沒有什麼緊急情況，所以會誠信經商的，{F#妳}{M#你}們放心好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫蕾瑪娜"
				}
			]
		},
		{
			"id": 7519405,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7519404",
							"3"
						],
						"stepId": 7519404,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"庫蕾瑪娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751940501,
					"content": "一十、二十…賣了這麼多錢，最近的經費應該是足夠了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940502,
						751940510
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940502,
					"content": "不再多賺點嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940503
					]
				},
				{
					"id": 751940503,
					"content": "#哈哈，不用啦，見好就收！要不是{F#妳}{M#你}不計較我的小手段，幫了我一把，我恐怕早就因為那幾塊玉惹上大麻煩啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940504
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940504,
					"content": "再說了，每天只盯著錢很沒意思的，對我而言賺錢只是愛好，觀察火山才是生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940505
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940505,
					"content": "錢沒了可以再賺，可是萬一因為我們這幫人的疏忽，導致對火山噴發沒有預警，那可就得不償失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940506
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940506,
					"content": "「話事處」不給妳們經費嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940507
					]
				},
				{
					"id": 751940507,
					"content": "我們沒去申請。畢竟，平時的各種事務已經夠讓「話事處」和首領們焦頭爛額了，怎麼能這個時候再去給他們增添負擔呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940508
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940508,
					"content": "而我和我的旅伴就不一樣了。平時，我們這群人也是一邊各處旅行一邊賺旅費的，早就習慣這種生活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751940509
					],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940509,
					"content": "#在旅行中順便觀察一下火山也不是什麼難事，就像{F#妳}{M#你}們經常順手幫助一些有困難的人一樣，輕輕鬆鬆啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫蕾瑪娜"
				},
				{
					"id": 751940510,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751940511
					]
				},
				{
					"id": 751940511,
					"content": "慢走慢走，嘿嘿，有緣再見啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫蕾瑪娜"
				}
			]
		},
