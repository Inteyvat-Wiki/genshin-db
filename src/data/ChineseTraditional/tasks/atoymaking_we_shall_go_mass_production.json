			"completionStepIds": [
				7269701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7269701",
							"2"
						],
						"stepId": 7269701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伯特蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726970101,
					"content": "#嘿嘿，{NICKNAME}，派蒙，{F#妳}{M#你}們來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970102
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970102,
					"content": "我的玩具城就要開業了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970103
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970103,
					"content": "玩具城？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970104,
					"content": "咳咳，當然了，說是玩具城，實際上也只有我和我的「大工機」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970105
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970105,
					"content": "我改良了一下工序，現在沒必要那麼等待那麼長時間才能完成製造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970106
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970106,
					"content": "雖然稱不上是「瞬間完成」，但也好歹也可以說是「現場可取」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970107
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970107,
					"content": "哇，聽起來很了不起的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970108,
					"content": "還有這個，我改良了「素材收集器」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970109
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970109,
					"content": "之前不是必須完成一個工序以後回來一趟嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970110
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970110,
					"content": "那之後我就覺得效率有點低，就做了調整，現在它會根據收集的狀況更新當下的工序內容了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970111
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970111,
					"content": "根據收集狀況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970112,
					"content": "調節工序內容？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970113,
					"content": "聽不懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970114
					]
				},
				{
					"id": 726970114,
					"content": "#哎，該怎麼跟{F#妳}{M#你}們解釋呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970115
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970115,
					"content": "譬如我在第一道工序需要十個日落果，第二道工序需要水元素，第三道工序需要擊敗兩隻水史萊姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970116
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970116,
					"content": "現在你帶著「素材收集器」，收集了十個日落果，那麼它就會判定第一道工序所需材料已全部收集完畢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970117
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970117,
					"content": "然後它就會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970118
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970118,
					"content": "我懂了，然後它就會自動進入第二個工序的收集模式！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970119,
					"content": "對，它就會進入「元素充能」的模式，補充水元素。等到水元素補充完了以後，又會進行一次變更。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970120,
						726970121
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970120,
					"content": "就會進入第三個工序…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				},
				{
					"id": 726970122,
					"content": "是的，到時候你就只用擊敗兩隻水史萊姆就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970123
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970123,
					"content": "聽起來真的方便了好多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970124,
					"content": "是吧，改良這個素材收集器啊，花了我一晚上時間，我願稱它為終極居家三合一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970125
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970125,
					"content": "「素材收集器」真是好了不起啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970126,
					"content": "確實。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970127
					]
				},
				{
					"id": 726970127,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970128
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970128,
					"content": "不過，為什麼要把這個「素材收集器」給我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970129,
					"content": "嘿嘿，我暫時被禁足，只能在離島上…根本沒辦法收集材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970130
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970130,
					"content": "#幫人幫到底嘛，到時候製造玩具賣出的收入也會給{F#妳}{M#你}們一些的，而且這些製造出的玩具，{F#妳}{M#你}可以免費拿走一個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970141
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970141,
					"content": "#還記得之前給{F#妳}{M#你}們的那張券嗎，嘿嘿，用那個券就可以免費兌換…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970142
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970142,
					"content": "#只要是{F#妳}{M#你}試出來的玩具造型，隨便兌換哪個都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970131
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970131,
					"content": "好啊，我們跑前跑後，製造的材料是我們出的，做出來的玩具賣的摩拉大部分歸你，玩具也只能留一個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970132,
					"content": "#哪有這樣的事，我們走，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970133,
					"content": "#那…分給{F#妳}{M#你}們的分成多一些，玩具可以拿走兩個…要嘛…三個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970134
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970134,
					"content": "我們走，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970135
					]
				},
				{
					"id": 726970135,
					"content": "四個！四個！這可是底線了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970136
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970136,
					"content": "#唉，要是我沒欠錢，這些玩具全給{F#妳}{M#你}們都行，但是{F#妳}{M#你}、{F#妳}{M#你}看我還欠著萬國商會的錢要還…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970137
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970137,
					"content": "哼，看你可憐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970138
					]
				},
				{
					"id": 726970138,
					"content": "…唉，是呀，我們可是看著你可憐才願意幫你的，可不是為了分成的摩拉和那四個玩具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726970139,
					"content": "嘿嘿，多謝兩位幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726970140
					],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970140,
					"content": "這下，總算能夠稍微鬆一口氣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯特蘭"
				},
				{
					"id": 726970121,
					"content": "就會進入「核心啟動」工序…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726970122
					]
				}
			]
		}
	]
}