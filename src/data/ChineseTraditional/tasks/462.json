			"trigger": {
				"objectNames": [
					"薇爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620301,
					"content": "唉…怎麼會遇到這種事，早知道就不該幫<color=#00E1FFFF>他</color>這個忙了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620302
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 4620302,
					"content": "「他」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620303,
					"content": "#真是謝謝{F#妳}{M#你}們！差點就要有大麻煩了，{F#妳}{M#你}們可比那些西風騎士可靠多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620304
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 4620304,
					"content": "#小意思小意思，畢竟{NICKNAME}作為旅行者，每天都要面對很多麻煩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620305,
					"content": "#旅行者？我好像聽過{F#妳}{M#你}的情報，沒想到被<color=#00E1FFFF>接頭人</color>救了一命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620306
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 4620306,
					"content": "哇！原來妳就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620307,
					"content": "#呵呵呵…本來還不知道該如何報答{F#妳}{M#你}們。既然這樣，就把情報免費送給{F#妳}{M#你}們好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620308
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 4620308,
					"content": "做情報生意的，都知道多交朋友的重要性呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620309,
						4620311
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 4620309,
					"content": "真的可以嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620310
					]
				},
				{
					"id": 4620310,
					"content": "當然，畢竟是救命恩人嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620312
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 4620312,
					"content": "嘿，真是好運！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620313,
					"content": "可是…怎麼感覺便宜了凱亞那傢伙，說好情報費由他來出的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620314,
					"content": "那聽好囉，有關「阿卡狄亞遺蹟」的情報…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620315
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 4620315,
					"content": "「在那湖中之城裡，住著三隻六臂巨人。兩位守護著神像，一位守護著眾神的財寶」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620316
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 4620316,
					"content": "…嗯？這就完啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620325,
					"content": "記錄著情報的紙上還附了這樣一張圖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620317
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 4620317,
					"content": "唔…這圖上畫的難道就是藏寶地？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620318,
					"content": "唔…好不容易拿到了線索，原來還要猜謎呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620319,
					"content": "#不過以{NICKNAME}的聰明才智應該不是問題吧~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620320,
						4620321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620320,
					"content": "那是當然！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620322,
					"content": "唔嗯，就算解不出來，至少還可以去問問凱亞，他好像腦袋也很好用的樣子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620326,
					"content": "#那這份情報就先放在{F#妳}{M#你}們這邊吧，如果忘記了可以隨時拿出來看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620327
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 4620327,
					"content": "嘿嘿，謝謝薇爾小姐啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620323,
					"content": "「湖中之城裡住著三隻六臂巨人，兩位守護著神像，一位守護著眾神的財寶」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620324,
					"content": "…究竟是指什麼呢？如果不想麻煩凱亞，就自己好好想想吧~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620321,
					"content": "…應該…沒問題吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620322
					]
				},
				{
					"id": 4620311,
					"content": "謝謝妳，朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620312
					]
				}
			]
		},
