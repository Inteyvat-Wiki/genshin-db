			},
			"dialogs": [
				{
					"id": 4620401,
					"content": "快讓我看看~！藏起來的是什麼東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620402,
					"content": "「她根本不愛他。清泉的熱情奔放只是虛浮表象，冰冷寂寞之時，她的心才顯露真實」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620407,
					"content": "這次同樣也附了一張圖呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620403,
					"content": "什麼嘛，還要猜謎嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620404,
					"content": "不行了，派蒙覺得好累，頭暈暈的，大概是用腦過度了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620405,
					"content": "妳明明就沒動過腦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620406
					]
				},
				{
					"id": 4620406,
					"content": "#總之這次也靠{F#妳}{M#你}了，嘻嘻。沒有想法的話，就再去找凱亞幫忙吧~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 46205,
