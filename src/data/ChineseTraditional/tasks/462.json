			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620501,
					"content": "#{NICKNAME}！{F#妳}{M#你}們回來了，看起來線索{F#妳}{M#你}們已經拿到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620502
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620502,
					"content": "拿到了是沒錯，但好像比想像中複雜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620503,
					"content": "「在那湖中之城裡，住著三隻六臂巨人。兩位守護著神像，一位守護著眾神的財寶」，這是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620504,
					"content": "居然是用猜謎的方式…真是傳統呢。讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620505
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620505,
					"content": "湖中之城應該指的是蒙德城沒錯…六臂巨人？六…什麼東西與六相關來著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620506
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620506,
					"content": "難道是螃蟹腳？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620507
					]
				},
				{
					"id": 4620507,
					"content": "所以六臂巨人是巨大的螃蟹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620508,
					"content": "…先不說哪裡有巨大螃蟹的問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620509
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620509,
					"content": "螃蟹是有八隻蟹腳的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620516
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620516,
					"content": "…那應該是指風車？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620517
					]
				},
				{
					"id": 4620517,
					"content": "應該是指…風車？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620518
					]
				},
				{
					"id": 4620518,
					"content": "#哦~！不愧是{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620519
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620519,
					"content": "風車上的扇葉剛好有六個，稱它為「六臂巨人」似乎很形象呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620510
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620510,
					"content": "嗚哇！你這麼一說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620511,
					"content": "剩下的問題就簡單了，三座風車中，有兩座離神像很近，是守護神像的「巨人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620512
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620512,
					"content": "而除此之外的那一座所守護的東西，應該就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620513
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620513,
					"content": "寶藏！這裡可難不倒我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620514,
					"content": "呵呵呵…希望真的能那樣順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620515
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620515,
					"content": "#走吧走吧，{NICKNAME}我們快去那座風車下看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 46207,
			"completionStepIds": [
				46207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"46207",
							"2"
						],
						"stepId": 46207,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_NOT_EQUAL",
						"rawParams": [
							"46206",
							"3"
						],
						"stepId": 46206,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4620701,
					"content": "「她根本不愛他。清泉的熱情奔放只是虛浮表象，冰冷寂寞之時，她的心才顯露真實」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620702
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620702,
					"content": "想到什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620703,
					"content": "#這該不會是{F#妳}{M#你}們碰巧撿到的戀愛小說的殘頁吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620704
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620704,
					"content": "原來搞錯了呀，難怪我這麼聰明都猜不出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620705,
					"content": "哈哈哈…我開玩笑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620706
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620706,
					"content": "唔嗯…你認真點啦，凱亞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620707,
					"content": "哈哈，這個謎題確實更難猜一點。清泉…是說清泉鎮嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620708
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620717,
					"content": "有人在泉水裡洗澡的時候？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620724,
					"content": "遇到高低落差的時候？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620708,
					"content": "「清泉的熱情奔放」…什麼情況下清泉會顯得熱情奔放呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620709
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620718,
					"content": "…這種有傷風化的事，感覺蒙德已經很少見了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620719,
					"content": "#難道…這是{F#妳}{M#你}的興趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620720,
					"content": "哦哦，真是抱歉，我本不該對他人的興趣評頭論足的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620721,
					"content": "#喂，你把{NICKNAME}想像成什麼人了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620723,
					"content": "嗯…難道說是清泉遇到高低落差的時候？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4620722,
					"content": "呵呵。關鍵是如果那樣，熱情奔放的就不是清泉，而是在洗澡的人了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620725,
					"content": "不錯的想法！比如…遇到瀑布之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620726,
					"content": "這樣看來，我想它指的應該是清泉鎮後山的瀑布。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620727,
					"content": "只有在那裡，恩澤蒙德的清泉才會顯露熱情奔放的一面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620709,
					"content": "至於「瀑布的心」，應該就是瀑布左側的山崖之上吧，我巡邏的時候從瀑布下面眺望過那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620710
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620710,
					"content": "最後「冰冷寂寞之時」，大概和神之眼所能操控的冰元素脫不了關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620711
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620712,
					"content": "多虧了凱亞幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4620713
					]
				},
				{
					"id": 4620711,
					"content": "#{F#妳}{M#你}最好<color=#00E1FFFF>帶上一位能夠掌控冰元素的朋友一起去</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620712
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620713,
					"content": "不足掛齒，作為西風騎士如果連猜謎都不擅長的話，還怎麼看穿罪犯的陰謀詭計呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620714
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620714,
					"content": "那我們去清泉鎮看看了，就不打擾你的陰謀詭計啦~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4620715,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4620716
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 4620716,
					"content": "哦不對…是不打擾你看穿罪犯的陰謀詭計！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
