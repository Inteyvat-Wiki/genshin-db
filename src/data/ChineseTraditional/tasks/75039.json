					{
						"sceneId": 3,
						"position": [
							-1331.644,
							247.597,
							9510.976
						],
						"pointId": 9810
					}
				]
			},
			"dialogs": [
				{
					"id": 750390301,
					"content": "#設法幫助了乾渴的路人，{F#妳}{M#你}們注意到他的體型浸水之後似乎大了一圈。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750390302
					]
				},
				{
					"id": 750390302,
					"content": "#呼…哈…哈…咳咳…！謝謝，謝謝{F#妳}{M#你}們…差點就出人命了…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390303
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390303,
					"content": "所以說這傢伙…差點守在水源旁邊然後把自己渴死嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390304,
					"content": "#欸？原來水源就在這麼近的地方嗎？！唉呀呀…不管怎樣，謝謝{F#妳}{M#你}們救了我一命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390305
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390305,
					"content": "#馬尼菲科·德·拉·馬尼菲桑斯，叫我馬尼菲科就好。正如{F#妳}{M#你}們所見，我出身楓丹貴胄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390306
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390306,
					"content": "#我的老朋友們有時叫我「警探」，有時叫我「布魯圖斯」，有時叫我「磁先生」…但{F#妳}{M#你}們的話，隨便什麼稱呼都可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390307
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390307,
					"content": "哇…好奇怪的傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390308,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390309,
						750390314,
						750390325
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390309,
					"content": "「警探」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390310
					]
				},
				{
					"id": 750390310,
					"content": "我曾經在逐影庭做過幾年警探，跟隨法蘭克·德雷賓警督辦過幾件大案，後來他升任警司，而我退役了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390311
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390311,
					"content": "那還真是讓人難忘的時光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390312
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390312,
					"content": "是啊…男孩遇見女孩，男孩失去女孩，女孩尋找男孩，男孩忘記女孩，男孩記起女孩，女孩被千靈節的映影花車碾壓了三遍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390313
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390313,
					"content": "那種亂七八糟的時光還是不要回顧啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390332,
					"content": "咳咳…總之，從逐影庭退役以後，我無所事事了一段時間，最終決定還是做個攝影家，描摹人與物所蘊含的生命力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390333
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390333,
					"content": "所以我來到了這裡，納塔！諸元素生命力最為璀璨驚心的國度！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390334
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390334,
					"content": "是很驚心啦…你差點就乾死在這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390335,
					"content": "#嘿嘿，實在是不好意思，我是不會忘記{F#妳}{M#你}們救我一命的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390336
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390336,
					"content": "#唔…對了，借{F#妳}{M#你}們的地圖看一下。嗯…我看看接下來我的目的地是在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390348
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390348,
					"content": "#對…這裡、這裡和…這裡！不好意思…地圖還給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390337
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390337,
					"content": "啊！對了…我的禮貌跑去哪裡了！我還不知道你們的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390338
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390338,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390339
					]
				},
				{
					"id": 750390339,
					"content": "#叫我派蒙就好！還有牠，牠叫{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390340,
					"content": "嗯唔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390341
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390341,
					"content": "#很好，{NICKNAME}和派蒙，我記住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390342
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390342,
					"content": "嗯？唔？嚇——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390343
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390343,
					"content": "#哈哈，不要急不要急！還有{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390344
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390344,
					"content": "#希望不久後我們能在旅途中再次相見，說不定下次我又要拜託{F#妳}{M#你}們幫忙，又說不定我可以幫上{F#妳}{M#你}們的忙哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390345
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390345,
					"content": "哇…你要去這麼遠的地方啊…那小心不要再把自己渴到乾掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390346
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390346,
					"content": "哈哈，不會的！我們有機會再見囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390347
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390347,
					"content": "#馬尼菲科飛快地打包好行李與飲水，向{F#妳}{M#你}們揮手告別。\\n不一會，他矮小的身影便從{F#妳}{M#你}們的視野中消失了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750390314,
					"content": "「布魯圖斯」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390315
					]
				},
				{
					"id": 750390315,
					"content": "#啊，{F#妳}{M#你}可能不知道，我曾在逐影庭做過幾年警探，那時候是法蘭克·德雷賓警督的部下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390316
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390316,
					"content": "當時我們在公園裡，看到五個穿長袍的傢伙在一百多人面前用刀襲擊一個老頭，於是「砰、砰、砰、砰、砰！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390317
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390317,
					"content": "我們把他們全部撂倒了，地上沒有一個在呼吸的——哈，你覺得自己很幸運嗎，小賊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390318
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390318,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390319,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390320
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390320,
					"content": "後來警長告訴我，那是一幫科學院的行政科員，正在排練《雷穆利亞》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390321
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390321,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390322,
					"content": "所以，「布魯圖斯」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390323
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390323,
					"content": "嗚嗷？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390324
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390324,
					"content": "不過反正沒什麼關係，當時科學院正在裁撤冗員，他們遲早會被開除。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390332
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390325,
					"content": "「磁先生」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390326
					]
				},
				{
					"id": 750390326,
					"content": "當然是說我超凡的人格魅力，每個認識我的人都會不可避免地被我所吸引！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390327
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390327,
					"content": "噫…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390328,
					"content": "以及…所有不起眼的金屬小物品、零散摩拉、細小首飾什麼的，都會莫名其妙被吸引到我的口袋裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390329
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390329,
					"content": "那應該叫「偷竊癖」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390330,
					"content": "沒錯，那正是我們家族的美德之一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390331
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390331,
					"content": "咿——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390332
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
