					"nextDialogs": [
						750390402
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390402,
					"content": "<color=#00E1FFFF>水…請給我水…</color>謝謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390403
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390403,
					"content": "我們還是快看看這個躺在地上的傢伙吧！他看起來狀態很不妙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7503917,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"馬尼菲科"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750391701,
					"content": "#設法幫助了乾渴的路人，{F#妳}{M#你}們注意到他的體型浸水之後似乎大了一圈。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						750391702
					]
				},
				{
					"id": 750391702,
					"content": "#呼…咳咳！咳咳！謝謝{F#妳}{M#你}們…但是，咳咳…救人的方式可以少點攻擊性啦…我不會游泳的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391703
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391703,
					"content": "沒關係，到時候我們再想辦法把你撈回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391704,
					"content": "#我寧願{F#妳}{M#你}們不要到時候再想辦法…不過不管怎麼樣，謝謝{F#妳}{M#你}們救了我一命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391705
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391705,
					"content": "#馬尼菲科·德·拉·馬尼菲桑斯，叫我馬尼菲科就好。正如{F#妳}{M#你}們所見，我出身楓丹貴胄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391706
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391706,
					"content": "#我的老朋友們有時叫我「警探」，有時叫我「布魯圖斯」，有時叫我「磁先生」…但{F#妳}{M#你}們的話，隨便什麼稱呼都可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391707
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391707,
					"content": "哇…好奇怪的傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391708,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391709,
						750391714,
						750391725
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391709,
					"content": "「警探」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391710
					]
				},
				{
					"id": 750391710,
					"content": "我曾經在逐影庭做過幾年警探，跟隨法蘭克·德雷賓警督辦過幾件大案，後來他升任警司，而我退役了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391711
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391711,
					"content": "那還真是讓人難忘的時光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391712
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391712,
					"content": "是啊…男孩遇見女孩，男孩失去女孩，女孩尋找男孩，男孩忘記女孩，男孩記起女孩，女孩被千靈節的映影花車碾壓了三遍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391713
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391713,
					"content": "那種亂七八糟的時光還是不要回顧啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391732,
					"content": "咳咳…總之，從逐影庭退役以後，我無所事事了一段時間，最終決定還是做個攝影家，描摹人與物所蘊含的生命力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391733
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391733,
					"content": "所以我來到了這裡，納塔！諸元素生命力最為璀璨驚心的國度！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391734
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391734,
					"content": "是很驚心啦…你差點就乾死在這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391735
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391735,
					"content": "#嘿嘿，實在是不好意思，我是不會忘記{F#妳}{M#你}們救我一命的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391736
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391736,
					"content": "#這樣好了，我接下來要去的地方…讓我在{F#妳}{M#你}的地圖上標記出來…嗯，在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391737
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391737,
					"content": "啊！對了…我的禮貌跑去哪裡了！我還不知道你們的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391738
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391738,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391739
					]
				},
				{
					"id": 750391739,
					"content": "#叫我派蒙就好！還有牠，牠叫{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391740
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391740,
					"content": "嗯唔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391741
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391741,
					"content": "#很好，{NICKNAME}和派蒙，我記住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391742
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391742,
					"content": "嗯？唔？嚇——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391743
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391743,
					"content": "#哈哈，不要急不要急！還有{REALNAME[ID(2)|SHOWHOST(true)]}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391744
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391744,
					"content": "#希望不久後我們能在旅途中再次相見，說不定下次我又要拜託{F#妳}{M#你}們幫忙，又說不定我可以幫上{F#妳}{M#你}們的忙哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391745
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391745,
					"content": "哇…你要去這麼遠的地方啊…那小心不要再把自己渴到乾掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391746
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391746,
					"content": "哈哈，不會的！我們有機會再見囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391747
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391747,
					"content": "#馬尼菲科飛快地打包好行李與飲水，向{F#妳}{M#你}們揮手告別。\\n不一會，他矮小的身影便從{F#妳}{M#你}們的視野中消失了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750391714,
					"content": "「布魯圖斯」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391715
					]
				},
				{
					"id": 750391715,
					"content": "#啊，{F#妳}{M#你}可能不知道，我曾在逐影庭做過幾年警探，那時候是法蘭克·德雷賓警督的部下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391716
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391716,
					"content": "當時我們在公園裡，看到五個穿長袍的傢伙在一百多人面前用刀襲擊一個老頭，於是「砰、砰、砰、砰、砰！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391717
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391717,
					"content": "我們把他們全部撂倒了，地上沒有一個在呼吸的——哈，你覺得自己很幸運嗎，小賊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391718
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391718,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391719,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391720
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391720,
					"content": "後來警長告訴我，那是一幫科學院的行政科員，正在排練《雷穆利亞》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391721
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391721,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391722
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391722,
					"content": "所以，「布魯圖斯」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391723
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391723,
					"content": "嗚嗷？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391724
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750391724,
					"content": "不過反正沒什麼關係，當時科學院正在裁撤冗員，他們遲早會被開除。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391732
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391725,
					"content": "「磁先生」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750391726
					]
				},
				{
					"id": 750391726,
					"content": "當然是說我超凡的人格魅力，每個認識我的人都會不可避免地被我所吸引！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391727
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391727,
					"content": "噫…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391728,
					"content": "以及…所有不起眼的金屬小物品、零散摩拉、細小首飾什麼的，都會莫名其妙被吸引到我的口袋裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391729
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391729,
					"content": "那應該叫「偷竊癖」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750391730,
					"content": "沒錯，那正是我們家族的美德之一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391731
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750391731,
					"content": "咿——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750391732
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
