			"dialogs": [
				{
					"id": 750390101,
					"content": "#{F#妳}{M#你}好，黑暗，我的老朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390102
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390102,
					"content": "嗚哇…是一個…說話像大人的小孩子，好奇怪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390103,
					"content": "欸？等等，這不是「了不起的馬尼菲科」嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390104,
						750390107,
						750390110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390104,
					"content": "馬…馬什麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390105
					]
				},
				{
					"id": 750390105,
					"content": "馬…馬尼菲科，了不起的馬尼菲科！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390106
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390106,
					"content": "呃…我知道我現在的樣子有那麼一點點狼狽，但請給我一點水，救救我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390119
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390119,
					"content": "水…請給我水…謝謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390120
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390120,
					"content": "哇…這傢伙又變回半死不活的樣子了…我們救救他吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390107,
					"content": "一點也不像是「了不起」的樣子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390108
					]
				},
				{
					"id": 750390108,
					"content": "變得像小魚乾一樣了，真可憐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390109,
					"content": "喂！有點身為人類的同理心好嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390119
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390110,
					"content": "你好，我是黑暗，你的老朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390111
					]
				},
				{
					"id": 750390111,
					"content": "什麼…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390112,
					"content": "哈！對，就是那首歌！我也喜歡那個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390113
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390113,
					"content": "啊…西梅翁和卡本克爾兄弟，怎樣都聽不膩…喔對了，我上一個工作還是因為他們丟的，所以我才會到這裡來冒這該死的險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390114
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390114,
					"content": "呃…不過那就是之後的事了，嘿嘿。現在要緊的是幫我弄點水來喝，好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390115
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390115,
					"content": "畢竟，嗯，嘿嘿…就是，呵呵，真不好意思，我要渴死了，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390116
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390116,
					"content": "人命關天的事，你傻笑什麼啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390117,
					"content": "不知道，迴光返照吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390118
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390118,
					"content": "哦…啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390119
					],
					"speakerTitle": "派蒙"
				}
			]
		},
