			"dialogs": [
				{
					"id": 750390201,
					"content": "#{F#妳}{M#你}好，黑暗，我的老朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390202
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390202,
					"content": "嗚哇…是一個…說話像大人的小孩子，好奇怪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390203,
					"content": "喂，妳的父母沒有教過妳要尊重我這樣的人嗎？要知道，小小的人也能做出大大的事來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390204
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390204,
					"content": "事實上，許多大大的事，正是由像我這樣小小的人所成就的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390205
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390205,
					"content": "他還有鬍子！噫…看起來有點噁心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390206,
					"content": "至少不要拿鬍子羞辱我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390207,
						750390220
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390207,
					"content": "你好，我是黑暗，你的老朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390208
					]
				},
				{
					"id": 750390208,
					"content": "#呃…不，{F#妳}{M#你}不用這樣配合我，我的意思是我…我快死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390209,
						750390214
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390209,
					"content": "哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390210
					]
				},
				{
					"id": 750390210,
					"content": "變得像小魚乾一樣了耶…真可憐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390211,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390212,
					"content": "#喂，{F#妳}{M#你}們身為人類的同理心跑去哪裡了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390213
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390213,
					"content": "#給我水！我要渴死了，難道{F#妳}{M#你}們看不出來嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390214,
					"content": "你需要什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390215
					]
				},
				{
					"id": 750390215,
					"content": "啊，太好了…我困在這裡三天，終於聽到一句人話了…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390216
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390216,
					"content": "我要兩份九號餐、一份大九號、一份六號餐醬多、一份七號餐、兩份四十五號，其中一份加起司，再來一杯大楓達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390217
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390217,
					"content": "好的，你還需要什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750390218,
					"content": "唔，嗷？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750390219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750390219,
					"content": "#還需要什麼？還需要什麼！我需要水！我要渴死了，{F#妳}{M#你}們難道第一眼看不出來嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750390220,
					"content": "請你振作點，我們該怎麼幫助你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750390221
					]
				},
				{
					"id": 750390221,
					"content": "水…請給我水…謝謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬尼菲科"
				}
			]
		},
		{
			"id": 7503903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
