			"dialogs": [
				{
					"id": 718120201,
					"content": "怎麼樣，有什麼發現嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120202
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 718120202,
					"content": "發現了這個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120203
					]
				},
				{
					"id": 718120203,
					"content": "這是…我從來沒見過這種東西，這是在哪裡發現的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120205
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 718120205,
					"content": "在遁玉陵附近…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718120206
					]
				},
				{
					"id": 718120206,
					"content": "遁玉陵？那裡怎麼還有這種東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120207
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 718120207,
					"content": "#謝謝{F#妳}{M#你}幫忙解開了那條線索，按照冒險家的規矩，這件東西就歸{F#妳}{M#你}了，這些報酬也請收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120208
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 718120208,
					"content": "我也會盡快安排人，去遁玉陵那邊進行更仔細的搜索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718120209
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 718120209,
					"content": "真奇怪…遁玉陵那一帶都搜索過好幾次了，怎麼還會有遺漏的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				}
			]
		},
