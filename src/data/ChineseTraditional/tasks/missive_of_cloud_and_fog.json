					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 414111020,
					"content": "嗯，妳說得對，我只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111021
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 414111021,
					"content": "哈哈，是在害怕吧？那我們陪妳一起去，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111022
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111022,
					"content": "哎？各位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111023
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 414111023,
					"content": "這位修女小姐要同行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111024
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111024,
					"content": "我就不必了。一看就知道，不是什麼大事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111025
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 414111025,
					"content": "嗯？她剛才說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111026
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111026,
					"content": "#沒什麼。{F#妳}{M#你}們去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111027
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 414111027,
					"content": "芭芭拉小姐，妳好點了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111028
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111028,
					"content": "嗯！我、我沒事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111029
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 414111029,
					"content": "蘿莎莉亞說得對，與其自己嚇自己，不如直接去領教犯人的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111030
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 414111030,
					"content": "沒錯沒錯，我們幾個一起去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111031
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111031,
					"content": "謝謝各位，那我們現在就去地圖指向的地方看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111032
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 414111032,
					"content": "好，芭芭拉衝呀——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4141113,
			"completionStepIds": [
				4141113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
