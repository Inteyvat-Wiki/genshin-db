					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111502,
					"content": "請留步！幾位，有何貴幹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111503
					],
					"speakerTitle": "阿托"
				},
				{
					"id": 414111503,
					"content": "凱亞在嗎？我們找他有事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111504,
					"content": "找凱亞隊長的話，他在琴團長辦公室執勤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111505
					],
					"speakerTitle": "阿托"
				},
				{
					"id": 414111505,
					"content": "咦，怎麼在琴團長辦公室裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111506,
					"content": "風花節慶典一直是由我們西風騎士團主辦，慶典期間，琴團長會親自外出巡邏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111507
					],
					"speakerTitle": "阿托"
				},
				{
					"id": 414111507,
					"content": "積壓的書案工作，就交由凱亞隊長代理了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111508
					],
					"speakerTitle": "阿托"
				},
				{
					"id": 414111508,
					"content": "原來如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
