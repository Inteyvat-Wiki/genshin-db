			},
			"dialogs": [
				{
					"id": 414110501,
					"content": "我們回來啦！凱亞，你寫完了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110502,
					"content": "老師要來收作業啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110503
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414110503,
					"content": "歡迎回來，我這邊剛好也差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110504
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110504,
					"content": "快快快，交作業交作業~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110505,
					"content": "來了來了，別笑我就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110506
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110506,
					"content": "嗯…嗯？唔唔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110507
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414110507,
					"content": "賣唱的，評價一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110508,
					"content": "凱亞，我可以把這首詩讀出來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110509
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414110509,
					"content": "請吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110510
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110510,
					"content": "咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110511
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414110511,
					"content": "「mi muhe ye\\n在丘丘人的語言裡\\n是我愛你」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110512
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414110512,
					"content": "嗯？嗯？？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110513,
					"content": "讀完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110514
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414110514,
					"content": "沒啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110515,
					"content": "主旨清晰，表達到位，我認為這種長度足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110516
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110516,
					"content": "哎哎哎？！完全就是丘丘語教學啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110517,
						414110518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110517,
					"content": "太誇張了，根本沒有愛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414110519
					]
				},
				{
					"id": 414110519,
					"content": "哈哈哈，不覺得是很有我風格的情詩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110520
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110520,
					"content": "更像是敷衍的情詩呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110521
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414110521,
					"content": "凱亞居然會丘丘人語？好奇怪啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
