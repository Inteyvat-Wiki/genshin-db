			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414111302,
					"content": "這是什麼，快打開看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111303,
					"content": "我、我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111304
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 414111304,
					"content": "這麼精緻的禮盒，卻出現在這種荒郊野嶺，好有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111305
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111305,
					"content": "……咦？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111306
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 414111306,
					"content": "哇，好精緻的風車菊花環，還有很多紙星星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111307,
						414111308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111307,
					"content": "是惡作劇嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				},
				{
					"id": 414111309,
					"content": "所謂的「犯人」好像是芭芭拉小姐的粉絲呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111310
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111310,
					"content": "還有張紙條，寫了什麼呢？我看看…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111311,
					"content": "「很抱歉用這樣的方式吸引您，為您的美德與可愛獻上飽含誠意的風之花。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111312,
					"content": "啊？以恐嚇為手段的騙局？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111313,
					"content": "無論是對神明還是對重要、摯愛之人，都要以最飽滿的情感獻上鮮花。這才是如今風花節的核心儀式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111314
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111314,
					"content": "為了在特殊的節日裡向妳送出愛與祝福之花，不惜選擇引人矚目的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111315
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111315,
					"content": "看似嚇人，背後卻是精心準備的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111316
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111316,
					"content": "嗚，真離譜…怎麼聽都是個沒分寸的傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111317,
					"content": "哈哈哈，確實。這樣的人選，我心中似乎有一個哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111318
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111318,
					"content": "你說的是誰呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111319,
					"content": "（我好像也想到了呢。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111320
					]
				},
				{
					"id": 414111320,
					"content": "噓…不要說出來，讓小派蒙猜一會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111321
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111321,
					"content": "啊！怎麼這樣啊——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111308,
					"content": "是引起注意的手段嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414111309
					]
				}
			]
		},
		{
			"id": 4141114,
