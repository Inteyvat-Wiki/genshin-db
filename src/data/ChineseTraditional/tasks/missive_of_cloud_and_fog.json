			},
			"dialogs": [
				{
					"id": 414110101,
					"content": "唷哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110102,
					"content": "#旅行者，派蒙，{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110103
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414110103,
					"content": "#我才想到{F#妳}{M#你}們，{F#妳}{M#你}們就來了，真巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110104
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110104,
					"content": "凱亞，你的作業寫完了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110105,
					"content": "恐怕要讓妳失望了，我還沒開始寫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110106
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110106,
					"content": "不交作業的學生可不是好學生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110107
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414110107,
					"content": "凱亞不做作業是在忙什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110108,
					"content": "嗯~如妳所見，在幫琴團長處理各種事務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110109
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110109,
					"content": "慶典期間蒙德城裡熱鬧得很，隨之而來的雜事也多得可怕。我已經忙了好久啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110110
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110110,
					"content": "#旅行者，能請{F#妳}{M#你}幫個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110111
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110111,
					"content": "#有位酒友託我辦事，但我實在脫不開身…想請{F#妳}{M#你}代我跑一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110112
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110112,
					"content": "酒友，是在酒館認識的朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110113
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414110113,
					"content": "是啊。下班偶爾去酒館喝一杯，不知不覺結交了許多朋友呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110114
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110114,
					"content": "他叫寧錄，通常會在酒館附近出沒。這個時間，我猜他應該閒著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110115
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110115,
					"content": "#我得留下來寫作業，寧錄的事就麻煩{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110116,
						414110117
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 414110116,
					"content": "凱亞，作業加油哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 414110117,
					"content": "好吧，也算是融入慶典。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
