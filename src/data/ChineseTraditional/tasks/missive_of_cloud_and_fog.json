			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"寧錄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414110301,
					"content": "#謝謝，謝謝{F#妳}{M#你}們！有了這個，我馬上就能開工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110302
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414110302,
					"content": "不要只是做禮物，以後也好好對你太太呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414110303,
					"content": "一定，一定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110304
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414110304,
					"content": "唉，要是我做的這些禮物能讓她喜歡就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110305
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414110305,
					"content": "沒人不喜歡飽含情意的禮物，放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414110306
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414110306,
					"content": "好好做哦，不要浪費了我們辛辛苦苦找來的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
