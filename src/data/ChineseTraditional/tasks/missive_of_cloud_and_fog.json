			},
			"dialogs": [
				{
					"id": 414111401,
					"content": "唉，怎麼辦才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111402
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414111402,
					"content": "你就是寧錄嗎？凱亞說你找他有事，他現在走不開，讓我們來幫你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111403,
					"content": "#嗯？旅行者，沒想到是{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111404
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414111404,
					"content": "是這樣的，我在為我太太準備風花節的禮物，想麻煩酒友凱亞出個主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111405
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414111405,
					"content": "呃…我、我這人，酒癮有些重，三天兩頭泡在酒館。我太太反對我喝酒，為此我們總是吵架。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111406
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414111406,
					"content": "原來你是個酒鬼呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111407,
					"content": "我明白，酒是好東西！不過你這樣的喝法，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111408
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111408,
					"content": "道理我都懂，所以才覺得，有些對不起她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111409
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414111409,
					"content": "#旅行者，能麻煩{F#妳}{M#你}們幫我蒐集材料嗎？我想親手製作一份禮物送給我太太。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111410
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414111410,
					"content": "照理說我得自己準備，可是最近酒喝多了，一不留神睡了過去。醒來時慶典已經開始啦！憑我自己，大概是來不及了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111411
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414111411,
					"content": "這人也太亂來了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111412,
					"content": "未婚的蒙德人可不敢在慶典期間託人辦事，寧錄，還好你已經結婚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111413
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111413,
					"content": "#哎哎，是啊…真抱歉，讓{F#妳}{M#你}們看笑話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111414
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414111414,
					"content": "真沒辦法。說吧，需要什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111415,
					"content": "#我會在城裡搜索木材，用於填充的植物只能到野外採集，就拜託{F#妳}{M#你}們了。我需要兩株小燈草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111416
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414111416,
					"content": "小燈草和木板，能做出什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111417,
					"content": "我想用木板搭一間小房子，配上發光的花朵和手工製作的小家具…送給她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111418
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414111418,
					"content": "很溫情的禮物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111419
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414111419,
					"content": "一點心意，哈哈。我剛認識她的時候，經常做手工小禮物送她，她非常喜歡，還說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111420
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414111420,
					"content": "啊！咳咳，抱歉，以前的事就不提了。總之，麻煩各位啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111421
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 414111421,
					"content": "算你運氣好，遇到我們這麼好心的幫手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414111422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414111422,
					"content": "走吧！去找他要的東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
