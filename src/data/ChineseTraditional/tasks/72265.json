				"points": []
			},
			"dialogs": [
				{
					"id": 722650301,
					"content": "#{NICKNAME}{F#妳}{M#你}看，有個人影從神社裡走出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650302,
					"content": "沒錯，是假玄冬！她向著山下的方向走了，我們快追！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7226505,
			"completionStepIds": [
				7226505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226504",
							"3"
						],
						"stepId": 7226504,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226505",
							"2"
						],
						"stepId": 7226505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葉菲·雪奈茨維奇",
					"柳達希卡·雪奈茨芙娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722650501,
					"content": "應該還不到和老師例行會面的日期才對，一定是因為那件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650502
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650502,
					"content": "柳達希卡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650503
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650503,
					"content": "啊，老師您來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650504
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650504,
					"content": "您辛苦了，我馬上向您彙報近日的進展。關於您吩咐的滲透終末番一事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650505
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650505,
					"content": "夠了，柳達希卡，妳那些拖延時間的說辭，我已經聽夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650506
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650506,
					"content": "什麼「頻繁發佈假任務可能會引起對方懷疑」，「眼狩令廢止後，終末番的行動方針可能會有變化，需要蒐集情報」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650507
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650507,
					"content": "每次都是這樣！我猜妳根本就沒有獲得那兩個終末番成員的信任，所以才不得不編出這些謊話來搪塞我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650508
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650508,
					"content": "不是的老師！我確實已經獲得了他們的信任，只是還需要一點時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650509
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650509,
					"content": "時間？我已經給了妳很多時間了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650510
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650510,
					"content": "妳要知道，我的耐心是有限的，「僕人」大人的耐心也是有限的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650511
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650511,
					"content": "真是萬分抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650512
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650512,
					"content": "我辛辛苦苦在妳身上花了這麼多年時間，要的不是妳的道歉！我要的是「結果」，「結果」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650513
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650513,
					"content": "…算了，我不想追究之前的事。不管是妳沒取得敵人的信任，還是現在的生活讓妳昏了頭，都不重要了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650514
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650514,
					"content": "這張紙上是妳的「最終指令」，拿著它。妳給我一個字一個字地，好好看清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650515
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650515,
					"content": "是，老師！我一定會完成任務，不負您的信任！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650516
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650516,
					"content": "…這、這是？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650517
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650517,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650518
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650518,
					"content": "啊，不，沒什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650519
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650519,
					"content": "柳達希卡，妳剛才那句「我一定會完成任務，不負您的信任」，我可以當作是妳的承諾吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650520
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650520,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650521
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650521,
					"content": "回答我，「是」還是「不是」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650522
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650522,
					"content": "老師！我當然支持您的決斷，只是…只是您說過，「僕人」大人隨時都可能讓我們從稻妻撤離。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650523
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650523,
					"content": "而且現在幕府和海祇島已經停戰，我們這樣做，真的有必要嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650524
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650524,
					"content": "呵呵，正因為如此，這個任務才有價值！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650525
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650525,
					"content": "雖然「女士」大人在稻妻遇害了，但現在，也正是我們回報「僕人」大人的恩情，為其建立威望的好時機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650526
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650526,
					"content": "而且我也一直告訴你們，「混亂」才是最能讓我們愚人眾壯大的土壤！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650527
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650527,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650528
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650528,
					"content": "柳達希卡，妳還在猶豫什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650529
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650529,
					"content": "只是這樣一來，一定又會有很多孤兒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650530
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650530,
					"content": "那不是更好嗎？我們也可以收留他們，讓他們成為新的戰力。當然前提是，妳能順利完成這個任務！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650531
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650531,
					"content": "柳達希卡，別再讓我失望。我們有這麼多年的情分，我也不想把事情做得太絕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650532
					],
					"speakerTitle": "葉菲·雪奈茨維奇"
				},
				{
					"id": 722650532,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650533
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650533,
					"content": "不好了，海祇島要發生可怕的事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650534,
					"content": "#{NICKNAME}，現在只剩下柳達希卡一個人了，我們快去把她手裡的最終指令搶過來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7226506,
