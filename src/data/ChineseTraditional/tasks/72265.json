				"points": []
			},
			"dialogs": [
				{
					"id": 722651301,
					"content": "我會在這裡一邊做校對工作，一邊為二位祈禱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651302
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722651302,
					"content": "說起來，校對的工作怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651303,
					"content": "還算順利，不過這次要校對的內容非常多，加上八重堂這兩天人手不足，可能要通宵吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651304
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722651304,
					"content": "好辛苦呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651305,
					"content": "呵呵，雖然辛苦，但我覺得非常有趣！能夠提前看到喜歡的小說，偶爾還能接觸到作者們的手稿，簡直太棒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				}
			]
		},
