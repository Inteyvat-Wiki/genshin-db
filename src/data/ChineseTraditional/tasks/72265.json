					"百代",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722651701,
					"content": "#做得不錯，有了這個東西，就能夠挫敗愚人眾的陰謀了。我馬上就去找人安排後續的行動，{F#妳}{M#你}們就不用擔心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651702
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651702,
					"content": "那個，百代小姐，其實我們有一件事想求妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651703,
					"content": "把剛才發生的事詳細告訴了百代。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722651704
					]
				},
				{
					"id": 722651704,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651705
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651705,
					"content": "#嗚，百代小姐，{F#妳}{M#你}不要這樣盯著我嘛！妳…妳就說好不好嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651706,
					"content": "#{F#妳}{M#你}們想救愚人眾？這關我什麼事？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651707
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651707,
					"content": "#那個女人頂替了我的位置，如果不是因為{F#妳}{M#你}們之前誤打誤撞，終末番很可能就會遇到重大危機！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651708
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651708,
					"content": "#{NICKNAME}，{F#妳}{M#你}也想辦法勸勸百代小姐吧，要不然柳達希卡小姐就性命難保了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651709,
						722651710,
						722651711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651709,
					"content": "做出可憐巴巴的表情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722651712
					]
				},
				{
					"id": 722651712,
					"content": "哼，沒用的。我已經說過了，愚人眾和我沒關係！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651713
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651713,
					"content": "#而且{F#妳}{M#你}們以為，偽造人體是這麼輕鬆的事嗎？這幾天{F#妳}{M#你}們去探聽情報的時候，我沒日沒夜地工作，才把他們要的假人做完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651714
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651714,
					"content": "需要那麼多<color=#00E1FFFF>獸肉</color>才能湊夠一個人的重量！還要把<color=#00E1FFFF>白鐵塊</color>和其他許多材料燒在一起偽造成骨頭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651715
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651715,
					"content": "如果不放<color=#00E1FFFF>海靈芝</color>，脂肪含量不足，效果就不夠逼真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651716
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651716,
					"content": "啊啊，最煩的就是把<color=#00E1FFFF>衣服</color>套在拼出來的假人上燒的過程了。畢竟要小心別把衣服燒得面目全非了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651717
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651717,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651718,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722651719
					]
				},
				{
					"id": 722651719,
					"content": "#{F#妳}{M#你}們是聽不懂人話嗎？還愣著幹嘛？！<color=#00E1FFFF>八塊獸肉，四塊白鐵塊，三顆海靈芝</color>，外加一件容易辨識身分的<color=#00E1FFFF>衣服</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651720
					],
					"speakerTitle": "百代"
				},
				{
					"id": 722651720,
					"content": "嗚嗚嗚！我就知道百代小姐妳最好了！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722651721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722651721,
					"content": "別煩我，快走快走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "百代"
				},
				{
					"id": 722651710,
					"content": "做出特別可憐巴巴的表情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722651712
					]
				},
				{
					"id": 722651711,
					"content": "做出特別可憐巴巴都要哭了的表情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722651712
					]
				}
			]
