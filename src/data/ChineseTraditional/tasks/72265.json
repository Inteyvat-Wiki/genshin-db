			"dialogs": [
				{
					"id": 722650601,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650602
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650602,
					"content": "柳達希卡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650603
					]
				},
				{
					"id": 722650603,
					"content": "誰？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650604
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650604,
					"content": "#{NICKNAME}，您…您怎麼會在這裡？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650605
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650605,
					"content": "那個…不，您誤會了，我…我之所以在這裡，其實…其實是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650606
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650606,
					"content": "我覺得並沒有什麼誤會。因為…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650607,
						722650608
					]
				},
				{
					"id": 722650607,
					"content": "妳回應了「柳達希卡」這個名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650609
					]
				},
				{
					"id": 722650609,
					"content": "…哎呀哎呀，看來現在，再說什麼都沒有用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650610
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650610,
					"content": "#既然{F#妳}{M#你}已經發現了我的真實身分，就別想活著離開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650608,
					"content": "妳身上的衣服說明了一切。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650609
					]
				}
			]
		},
		{
			"id": 7226508,
			"completionStepIds": [
				7226508
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226507",
							"3"
						],
						"stepId": 7226507,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7226508",
							"2"
						],
						"stepId": 7226508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柳達希卡·雪奈茨芙娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722650801,
					"content": "咳…咳咳咳！呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650802
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650802,
					"content": "喂，妳還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650803,
					"content": "抱歉，下手有點重。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650804
					]
				},
				{
					"id": 722650804,
					"content": "呼…為什麼，不乾脆了結掉我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650805
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650805,
					"content": "#{F#妳}{M#你}們應該是想知道我身上那張「最終指令」的內容吧。只要幹掉我，一切不就很簡單了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650806
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650806,
					"content": "對，那樣確實很簡單。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650807
					]
				},
				{
					"id": 722650807,
					"content": "而且對妳而言也是種「解脫」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650808
					]
				},
				{
					"id": 722650808,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650809
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650809,
					"content": "#玄冬…不，柳達希卡小姐，我們其實已經發現了，妳剛才雖然氣勢洶洶地衝了過來，但妳和{NICKNAME}戰鬥的時候，根本就沒有用全力吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650810,
						722650811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650810,
					"content": "而且氣勢也太假了一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650812
					]
				},
				{
					"id": 722650812,
					"content": "欸！不…不至於吧，真的有那麼假嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650813
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650813,
					"content": "但妳想要自我了斷是真的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650814
					]
				},
				{
					"id": 722650814,
					"content": "柳達希卡小姐，我們剛才聽到了妳和那個「老師」的談話，妳似乎有一些苦衷。能和我們講講嗎？我們可以幫妳的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650815,
					"content": "但是我…我是愚人眾啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650816,
						722650818
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650816,
					"content": "派蒙說了，會幫妳的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650817
					]
				},
				{
					"id": 722650817,
					"content": "#哇，謝謝{F#妳}{M#你}{NICKNAME}，我好感動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650819,
					"content": "嗯，妳放心吧，我們是不會對好人出手的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650820,
					"content": "但其實，我的確不能算是什麼好人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650821
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650821,
					"content": "我一開始接到任務混進鳴神大社，只是為了接觸終末番的成員，混進他們內部。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650822
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650822,
					"content": "但我來到神社之後卻發現，老師所說的那兩個終末番成員，卻是曾經在蒙德和璃月鼎鼎有名的旅行者和跟班…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650823
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650823,
					"content": "派蒙不是跟班！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650824,
						722650825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650824,
					"content": "難怪妳知道我的名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650826
					]
				},
				{
					"id": 722650826,
					"content": "是的。所以，老師讓我滲透進終末番，從根本上就是無法成立的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650827
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650827,
					"content": "因為老師對這一行動寄予厚望，我不知道該如何向他彙報。他如果知道了真相，一定會大發雷霆，我不會有好下場的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650828
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650828,
					"content": "不過，我能夠來到稻妻，還能在神社裡當巫女，簡直像做夢一樣！能夠做這樣一個夢，我已經非常滿足了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650829
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650829,
					"content": "所以，我就一直用各種理由搪塞老師，決定過一天是一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650830
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650830,
					"content": "我以為自己的謊言總有一天會穿幫，不過卻沒想到，老師並沒有追究這件事，而是給了我新的任務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650831
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650831,
					"content": "老師到底給了妳什麼任務？剛才妳一看見紙上的字，臉就變白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650832,
					"content": "因為…我的任務是「投毒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650833
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650833,
					"content": "呀，投毒？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650834
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650834,
					"content": "老師要我和其他幾個人進入海祇島，在那裡投毒。然後故意暴露出我們鳴神大社巫女和天領奉行士兵的身分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650835
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650835,
					"content": "這樣，幕府與海祇島之間一定會再起衝突，愚人眾也就能乘虛而入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650836
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650836,
					"content": "那個「老師」也太狠毒了！如果被他實行了這樣的計畫，許多人之前為了稻妻和平做出的努力就都白費了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650837,
					"content": "柳達希卡，妳準備怎麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650838
					]
				},
				{
					"id": 722650838,
					"content": "我…我不知道。我根本沒有違抗老師命令的資格，但我並不想看見這樣的事情發生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650839
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650839,
					"content": "因為妳也是「雪奈茨芙娜」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650840
					]
				},
				{
					"id": 722650840,
					"content": "#說起來我之前就經常聽見這個詞，它到底是什麼意思呀？{NICKNAME}{F#妳}{M#你}好像已經完全知道了的樣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650841
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650841,
					"content": "是代表孤兒的意思吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650842
					]
				},
				{
					"id": 722650842,
					"content": "對，「雪奈茨維奇」和「雪奈茨芙娜」，是愚人眾給予我們這些被收養的孤兒們的姓氏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650843
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650843,
					"content": "我們從小在「僕人」大人設立的福利院裡長大，我們不知道自己究竟是誰，頂多知道自己有哪裡的血統。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650844
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650844,
					"content": "我就是因為有稻妻的血統，所以從小就在學習關於這裡的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650845
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650845,
					"content": "其實我的老師，他也是一個「雪奈茨維奇」。所以，我才更不能理解他…不，是不能原諒他說的那些話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650846
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650846,
					"content": "因為一直以來我都在思考著：我究竟是誰？我為什麼是孤身一人？我的父母他們遭遇了不幸嗎？還是他們拋棄了我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650847
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650847,
					"content": "但老師那些話，卻無視了孤兒們的痛苦…讓我忍不住去想，我的命運，難道是被愚人眾…被老師這樣的人創造出來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650848
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650848,
					"content": "確實不可原諒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650849
					]
				},
				{
					"id": 722650849,
					"content": "#{NICKNAME}，我們幫幫柳達希卡小姐吧。她雖然是愚人眾，可她並不是壞人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650850
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650850,
					"content": "#謝謝{F#妳}{M#你}們的好意，但我覺得我的命運已經註定了。「老師」是個對背叛者毫不留情的人，只要我還活著，他就一定會把我找出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650851
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650851,
					"content": "#可能被{F#妳}{M#你}們了結掉，才是我最好的歸宿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650852
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650852,
					"content": "難道只有死了才不會被他盯上嗎？怎麼會這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650853
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650853,
					"content": "嗯？等一下，我總覺得好像想到了點什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650854
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650854,
					"content": "是百代小姐吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650855
					]
				},
				{
					"id": 722650855,
					"content": "百代小姐？…啊！我想起來了，對啊！她最近不就正在做假屍——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650856
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650856,
					"content": "噓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650857
					]
				},
				{
					"id": 722650857,
					"content": "嗯，咳咳，柳達希卡小姐，總之，我們已經有辦法救妳了！而且我們也會挫敗「老師」的陰謀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650858
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650858,
					"content": "咦，真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650859
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650859,
					"content": "妳就放心吧！不過這幾天，妳要先找個地方躲起來，等到我們把事情都辦妥之後再出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650860
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650860,
					"content": "妳有地方可去嗎？最好是那種方便我們找到妳，也不會被人懷疑的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650861
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650861,
					"content": "讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650862
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650862,
					"content": "啊，有一個地方似乎可以！我之前曾經用過一個假名在八重堂打過工，做小說新刊的校對。因為我很喜歡讀八重堂出版的小說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650863
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650863,
					"content": "他們在稻妻城的書店後面有一間小屋，偶爾會給拖稿的作者或者校對員使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650864
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650864,
					"content": "聽起來是個不錯的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650865
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650865,
					"content": "嗯，大隱隱於市。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650866
					]
				},
				{
					"id": 722650866,
					"content": "柳達希卡小姐，妳就暫時躲在那裡吧，我們如果有事就過去找妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650867
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650867,
					"content": "#我明白了。真不知道該如何感謝{F#妳}{M#你}們，我明明之前一直在欺騙{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650868
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650868,
					"content": "#老師給我的這張紙上，寫有任務的詳細計畫。海祇島無辜眾人的性命，就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722650869
					],
					"speakerTitle": "柳達希卡·雪奈茨芙娜"
				},
				{
					"id": 722650869,
					"content": "柳達離開了",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722650870
					]
				},
				{
					"id": 722650870,
					"content": "她走了。我們也趕快回百代小姐那去吧，接下來還有很多事情要做呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722650825,
					"content": "原來妳知道我的事情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650826
					]
				},
				{
					"id": 722650818,
					"content": "如果妳真的有苦衷的話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650819
					]
				},
				{
					"id": 722650811,
					"content": "而且笑聲也太假了一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722650812
					]
				}
			]
		},
