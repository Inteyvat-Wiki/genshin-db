			"dialogs": [
				{
					"id": 221010201,
					"content": "怎麼樣？周圍的怪物都清乾淨了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010202,
					"content": "還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010203
					]
				},
				{
					"id": 221010203,
					"content": "倒也不用太著急，那些個怪物也頂多敢騷擾騷擾來往進出的人，不敢進客棧來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010204
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010204,
					"content": "就算是有三五隻膽子大的進來了，唔…我倒也能趕出去，客人不用擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010205
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010205,
					"content": "哈哈哈，在這郊外開客棧，會點拳腳防防身，也是很正常的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
