			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221010101,
					"content": "沒完沒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010103
					]
				},
				{
					"id": 221010103,
					"content": "唉，在這裡開個客棧可不容易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010104,
					"content": "不知道是不是我的錯覺…總覺得周圍的那些怪物，是越來越多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010105,
					"content": "雖然它們也不會靠近客棧，但是客人總要進出，來往道路上的千岩軍也不可能時刻把守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010106,
					"content": "#如果有空的話，{F#妳}{M#你}能幫我去周圍看看，把客棧旁邊的怪物給清一清嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010107,
						221010108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010109
					]
				},
				{
					"id": 221010109,
					"content": "哈哈，您說話做事真是爽利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010113,
					"content": "讓您受累，實在是有些不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010114
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010114,
					"content": "事結之後，報酬我絕不會少您一分的，請您放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010115
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010115,
					"content": "那麼，就萬事拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010108,
					"content": "這家客棧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221010110
					]
				},
				{
					"id": 221010110,
					"content": "在這種地方開客棧，這種問題也免不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010111
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010111,
					"content": "不過，要是沒了我們這家客棧，那野外的行人去哪落腳呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010112,
					"content": "雖然累，不過開著也是好事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010113
					],
					"speakerTitle": "淮安"
				}
			]
		},
