					"nextDialogs": [
						221010303
					]
				},
				{
					"id": 221010303,
					"content": "那就好，辛苦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010304
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010304,
					"content": "這是報酬，您收好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221010305
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221010305,
					"content": "這年頭真是…開個客棧，不會功夫都不行。",
					"roleType": "TALK_ROLE_NPC",
