			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060301,
					"content": "哎呀，食譜寫好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060601,
					"content": "寫好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060602
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060602,
					"content": "謝謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060603
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060603,
					"content": "哇…真期待啊，好想馬上去做新菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060604
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060604,
					"content": "#旅行者，派蒙，抱歉耽擱了{F#妳}{M#你}們的用餐時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060605
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060605,
					"content": "嘿嘿，勞動後的食物更美味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060606,
					"content": "讓我們趁熱吃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060607
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060607,
					"content": "#怎麼樣，稻妻的料理合{F#妳}{M#你}們口味嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060608
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060609,
					"content": "很不錯，我喜歡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060611
					]
				},
				{
					"id": 120060610,
					"content": "別有一番風味喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060611
					]
				},
				{
					"id": 120060608,
					"content": "好吃！這個好吃，還有那邊那個也很好吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060609,
						120060610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060611,
					"content": "哈哈，那我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060612
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060612,
					"content": "#對了，剛才我在那邊試做料理的時候，{F#妳}{M#你}們有跟店主閒聊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060613
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060613,
					"content": "她、她有沒有說什麼…有關我的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060614
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060614,
					"content": "說了一些喔，不過她是為你高興，沒有別的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060615,
					"content": "為我…高興？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060616
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060616,
					"content": "嗚…果然說了吧！她、她是不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060617
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060617,
					"content": "唉，算了，我就是朋友很少，我自己也知道啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060618
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060618,
					"content": "不奇怪喔，別人只是還沒有找到跟妳多說話的機會而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060619,
					"content": "謝謝妳安慰我，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060620
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060620,
					"content": "那些都是實話，我這個人…朋友確實比較少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060621
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060622,
					"content": "才沒有這種事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060623,
					"content": "我就是妳的朋友喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060624
					]
				},
				{
					"id": 120060621,
					"content": "#平日跟我走得近的只有家人和下屬。所以，看見我約{F#妳}{M#你}出來吃飯，大家應該會很震驚吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060622,
						120060623
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060624,
					"content": "對呀對呀，妳有朋友，我們都是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060625,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060626
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060626,
					"content": "#謝謝{F#妳}{M#你}們，我、我很開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060627
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060627,
					"content": "抱歉…真是失態啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060628
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060628,
					"content": "有什麼情緒就發洩出來嘛，不要憋著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060629,
					"content": "嗯！所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060630
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060630,
					"content": "#我也是{F#妳}{M#你}們重要的朋友了。我真的…非常高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060631
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060631,
					"content": "應該的嘛，我們一直都是這樣，誰對我們好，我們就也對他好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060632
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060632,
					"content": "友情很重要，會影響到很多人！就像妳媽媽的筆記本也會讓妳想要見見那個名叫「椿」的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060633,
					"content": "#嗯！友情對我來說很珍貴，我會好好珍惜與{F#妳}{M#你}們的這份因緣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060634
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060634,
					"content": "不過這麼一說，那個名叫「椿」的人到底是誰呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060636,
					"content": "願聞其詳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060637
					]
				},
				{
					"id": 120060635,
					"content": "關於這件事，我有一個初步推測。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060636
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060638,
					"content": "……？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060639
					]
				},
				{
					"id": 120060637,
					"content": "我認為，「椿」…或許是「狐狸神使」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060638
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060639,
					"content": "「狐狸神使」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060640
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060640,
					"content": "嗯，我是這麼想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060641
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060641,
					"content": "就連我也從未聽過母親有這樣一位朋友，如此神秘，一定是平日很難見到的高人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060642
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060642,
					"content": "稻妻自古就有不少關於狐狸神使的逸聞喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060643
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060643,
					"content": "#{F#妳}{M#你}們應該見過八重宮司了吧？她就是狐狸神使喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060644
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060644,
					"content": "若是朝這個方向推測，稻妻大地上或許還有其他不為人知的狐狸神使…而那位「椿」，也許就是其中一員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060645
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060645,
					"content": "哇喔，稻妻也有仙人啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060646
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060646,
					"content": "妳說「也」的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060647
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060647,
					"content": "來稻妻之前，我們去過璃月。璃月有很多仙人喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060648
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060648,
					"content": "天上飛的、地下跑的、水裡游的、土裡埋的…面面俱到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060649
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060649,
					"content": "雖說我曾在書上見過類似說法，但聽人親口說起，還是非常驚訝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060650
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060650,
					"content": "不愧是璃月…古老的文化孕育著最美麗的傳說，令人嚮往。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060651
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060651,
					"content": "有機會可以一起去璃月看看，那邊也有非常非常多美食，可厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060652,
					"content": "可以嗎？太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060653
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060653,
					"content": "#不過在那之前，旅行者，派蒙，{F#妳}{M#你}們吃飽了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060654
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060654,
					"content": "吃飽了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060655
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060655,
					"content": "那麼我們先去取衣物，然後就請兩位隨我一同見證棲身於稻妻的神秘高人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
