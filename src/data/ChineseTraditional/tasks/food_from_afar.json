				{
					"id": 120060414,
					"content": "#派蒙過獎了。如果看見它能讓{F#妳}{M#你}們想起我，自然是再好不過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060415
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060415,
					"content": "嘿嘿，一定會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060416,
					"content": "好，既然拿到東西，就可以出發啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060417,
					"content": "到「椿」的住處去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060411,
					"content": "我會好好珍藏的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060412
					]
				}
			]
		},
		{
			"id": 1200605,
