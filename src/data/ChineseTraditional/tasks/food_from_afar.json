				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"木南杏奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120060101,
					"content": "是這間店對吧？真的是臨街的開放式店鋪呢，好親切呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060102,
					"content": "歡迎光臨！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060103
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060103,
					"content": "木南小姐，妳好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060104
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060104,
					"content": "哎呀神里小姐，來得真準時！我們約定的差不多就是這個時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060105
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060105,
					"content": "是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060106
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060106,
					"content": "點餐就按之前我預約的內容，另外，和妳說好的那件事…也拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060107
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060107,
					"content": "好好，沒問題，您要的東西我都準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060108
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060108,
					"content": "旅行者和這位小小的客人請在這邊稍等一下，我去備菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060109
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060109,
					"content": "旅行者，派蒙，先入座吧。我稍稍失陪一會，馬上就來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060110,
						120060111
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060110,
					"content": "有什麼緊急狀況嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060112
					]
				},
				{
					"id": 120060112,
					"content": "咳咳…不是那種情況啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060113
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060113,
					"content": "只是處理一些小事，馬上就來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060114
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060114,
					"content": "走掉了…好像是有什麼急事的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060115,
					"content": "兩位是神里小姐的朋友吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060116
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060116,
					"content": "#哈哈，我們店做的都是民間菜色，不敢說形式有多高級…啊不過，味道是很好的喔！希望{F#妳}{M#你}們能喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060117
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060117,
					"content": "我們店開了很多年，與神里家的各位大人還算是有些交情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060118
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060118,
					"content": "神里家兩兄妹都滿喜歡我們店的菜，以前總是請人來店裡下單，買回府上享用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060119
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060119,
					"content": "不過沒想到，這次她親自過來店裡，還帶了朋友。我還是頭一次聽說神里小姐請朋友吃飯呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060120
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060120,
					"content": "居然是第一次，我們真有面子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060121,
					"content": "#是啊，雖然這話說起來有些冒犯…我也就跟{F#妳}{M#你}們說說，據我所知，神里小姐朋友似乎不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060122
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060122,
					"content": "真叫人意外…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060123
					]
				},
				{
					"id": 120060123,
					"content": "怎麼會？她人很好，又有禮貌，應該很受歡迎才對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060124,
					"content": "原本我也這麼想，但人際的規律卻不是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060125
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060125,
					"content": "街坊鄰里都說，神里小姐相貌美麗，出身高貴，舉止優雅得體，簡直像是高嶺之花一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060126
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060126,
					"content": "太過完美，反而給人強烈的距離感。普通人家的孩子，幾乎都不敢跟她隨便搭話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060127
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060127,
					"content": "這麼好的女孩子，反而難交到朋友呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060128
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060128,
					"content": "居然是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060129,
					"content": "我跟她聊天不多，但也算是認識挺久了，一直很欽佩她年紀輕輕就肩負起了那麼多責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060130
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060130,
					"content": "今天看她帶人過來，我也很開心喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060131
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060131,
					"content": "你們今天可要多吃點！可以的話，請多陪她聊聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060132
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060132,
					"content": "就當是我們街坊鄰居的請求，拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060133
					],
					"speakerTitle": "木南杏奈"
				},
				{
					"id": 120060133,
					"content": "啊…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060134
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060134,
					"content": "嗯？是綾華的聲音？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060135,
					"content": "抱歉，旅行者…呃、呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060136,
						120060137
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060136,
					"content": "好像有爆炸聲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060138
					]
				},
				{
					"id": 120060138,
					"content": "#能不能跟我到那邊去，有件事…想麻煩{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060139
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060139,
					"content": "#對不起！突然把{F#妳}{M#你}叫出來，其實、其實…我剛才做料理失敗了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060140
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060140,
					"content": "原來那聲巨響是鍋子炸開的聲音啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060141,
					"content": "如你所見，這棟房屋就在餐廳旁邊，是店主的私人住宅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060142
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060142,
					"content": "這間院子也是他們家的私人區域，我是請店主幫忙準備了一些料理用具和食材，想在這裡做一道特色料理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060143
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060143,
					"content": "為什麼要做料理？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060144
					]
				},
				{
					"id": 120060144,
					"content": "對啊，如果只是想吃東西，店裡應該直接可以點菜吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060145,
					"content": "我想做的是…送給「椿」的見面禮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060146
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060146,
					"content": "我母親筆記中提到，「椿」喜歡異國料理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060147
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060147,
					"content": "這次要去見「椿」，我便想著，是不是做一份異國料理帶給對方比較好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060148
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060148,
					"content": "異國料理…只要不是稻妻料理就行吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060149,
					"content": "這樣的話，我們不是有很多選擇嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060150,
						120060152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060150,
					"content": "其實，我是個大廚喔！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060151
					]
				},
				{
					"id": 120060151,
					"content": "#我也這麼想！像{F#妳}{M#你}這樣四處旅行的人，一定懂得很多知識，瞭解各地美食…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060154
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060154,
					"content": "#可以請{F#妳}{M#你}幫我完成這件事嗎？就當是幫我的忙，可、可以嗎…？我會好好酬謝{F#妳}{M#你}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060155,
						120060156
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060155,
					"content": "好啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120060157
					]
				},
				{
					"id": 120060157,
					"content": "什麼樣的異國食物適合帶出門送人呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060158
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 120060158,
					"content": "我知道我知道！說起這種類型的食物，一定就是那個吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120060159
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120060159,
					"content": "「披薩」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
