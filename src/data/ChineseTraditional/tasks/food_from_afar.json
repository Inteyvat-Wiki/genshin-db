	"talks": [
		{
			"id": 1200601,
			"completionStepIds": [
				1200601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200601",
							"2"
						],
						"stepId": 1200601,
