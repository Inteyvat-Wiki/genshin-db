			"dialogs": [
				{
					"id": 747070101,
					"content": "…好，沒問題！再來一個——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070102
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747070102,
					"content": "好。停——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070103
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747070103,
					"content": "芙寧娜！還有哥倫比婭和千織，又見面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747070104,
					"content": "嗯，我們剛好拍完上次說的氛圍鏡頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070105
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747070105,
					"content": "哦！就是讓魚兒來當演員的那個吧？怎麼樣怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747070106,
					"content": "#多虧{F#妳}{M#你}們的幫助，我們找到了一位適合的「演員」。拍攝很順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070107
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747070107,
					"content": "#{F#妳}{M#你}們佈置水族箱也很有一套。芙寧娜導演剛才還說看得她想去拍部水下紀錄片了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070108,
						747070109
					],
					"speakerTitle": "千織"
				},
				{
					"id": 747070108,
					"content": "多謝誇獎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				},
				{
					"id": 747070110,
					"content": "#嗯，我也很喜歡。我能感覺到魚兒們游得很愜意，很滿足，{F#妳}{M#你}們照料得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070111
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747070111,
					"content": "真希望這個水族館一直留在這裡呢，這樣就能時不時來看看這些魚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070112
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747070112,
					"content": "真的捨不得的話，就多剪幾個鏡頭到映影裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070113
					],
					"speakerTitle": "千織"
				},
				{
					"id": 747070113,
					"content": "妳說得對。那乾脆再補幾條吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070114
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747070114,
					"content": "補幾條魚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 747070115,
					"content": "補鏡頭啦…燈光師、攝影師，還有場記就位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747070116
					],
					"speakerTitle": "芙寧娜"
				},
				{
					"id": 747070116,
					"content": "來啦！不過為魚兒們打板還真是頭一回呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747070109,
					"content": "妳們喜歡就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747070110
					]
				}
			]
		}
	]
