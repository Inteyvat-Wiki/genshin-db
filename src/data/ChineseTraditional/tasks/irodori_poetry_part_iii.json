			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大伴",
					"萊內"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930201,
					"content": "#{M#小哥}{F#姑娘}，畫片的事情怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930202
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930202,
					"content": "在這裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726930203
					]
				},
				{
					"id": 726930203,
					"content": "謝謝，謝謝，有了這些素材，應該可以寫出滿意的詩句來。嗯，讓我構思一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930204
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930204,
					"content": "#{M#小哥}{F#姑娘}，根據{F#妳}{M#你}的畫片，我試寫了這些。詩裡要用哪句，也請{F#妳}{M#你}來選一選吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大伴"
				}
			]
		},
		{
			"id": 7269303,
