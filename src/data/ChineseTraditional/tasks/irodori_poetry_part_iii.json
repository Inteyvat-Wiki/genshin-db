			"dialogs": [
				{
					"id": 726930501,
					"content": "這裡的野果是虛指一些悲傷的事情吧，不像初次飲酒、初次讀詩一樣是什麼愉快的記憶，但是卻和即將到來的離別一樣，讓人印象深刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊內"
				}
			]
		},
		{
