			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萊內",
					"大伴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726930601,
					"content": "大伴先生的這首詩，突破了稻妻詩歌的格式，卻又用了稻妻的古典手法，羅列了人生中各種難忘的回憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930602
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726930602,
					"content": "是想告訴我，蒙德和稻妻，雖然看起來大相徑庭，但是卻也有共通的美感吧。正如我們二人拋開蒙德人與稻妻人的身分，單純作為詩人的交流一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930603
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726930603,
					"content": "萊內先生這樣年輕，卻能如此快速地領會詩句的情誼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930604
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930604,
					"content": "老頭子我之前以為所謂忘年之交不過是一些妄言，今天才知道確有其事，也算是一大快事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930605
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930605,
					"content": "#還有這位玉成雅事的{M#小哥}{F#姑娘}，我們三人能在這裡相會，也算是有緣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930606
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930606,
					"content": "是啊，遠渡來稻妻這一路上的顛簸都不重要了，而即便回到蒙德，我也會鮮明地記得稻妻的一草一木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930607
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726930607,
					"content": "#這也多虧了這位朋友帶來的畫片，謝謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930608
					],
					"speakerTitle": "萊內"
				},
				{
					"id": 726930608,
					"content": "希望將來有一天，我們三人還能有機會再會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726930609
					],
					"speakerTitle": "大伴"
				},
				{
					"id": 726930609,
					"content": "一定會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊內"
				}
			]
		},
