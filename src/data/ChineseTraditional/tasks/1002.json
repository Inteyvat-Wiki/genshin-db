			"dialogs": [
				{
					"id": 10020201,
					"content": "爾是何人，因何擅闖「絕雲間」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020202,
						10020203
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020202,
					"content": "我受人之託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020203
					]
				},
				{
					"id": 10020203,
					"content": "請您看看這個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020204
					]
				},
				{
					"id": 10020204,
					"content": "「百無禁忌籙」…多年不見這東西了，原來凡人手中還有殘餘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020205
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020205,
					"content": "#我乃三眼五顯仙人，削月築陽真君。旅者，說出{F#妳}{M#你}的來意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020206
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020206,
					"content": "其實…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10020207,
					"content": "是刺客！他們居然潛逃到了這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020208
					],
					"speakerTitle": "千岩軍教頭"
				},
				{
					"id": 10020208,
					"content": "頭兒，我們已經太深入「絕雲間」了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020209
					],
					"speakerTitle": "千岩軍士兵"
				},
				{
					"id": 10020209,
					"content": "這…沒法子，捉拿刺客是頭等大事，硬著頭皮也要上啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020210
					],
					"speakerTitle": "千岩軍教頭"
				},
				{
					"id": 10020210,
					"content": "…滋擾清境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020211
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020211,
					"content": "送走他們，莫要殺生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "削月築陽真君"
				}
			]
		},
		{
			"id": 100205,
			"completionStepIds": [
				100205
			],
