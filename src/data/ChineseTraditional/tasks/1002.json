			"trigger": {
				"objectNames": [
					"削月築陽真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10020501,
					"content": "#那麼，重歸正題——旅者，說出{F#妳}{M#你}的來意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020502
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020502,
					"content": "其實…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10020503,
					"content": "豈有此理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020504
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020504,
					"content": "豈有此理！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020505
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020505,
					"content": "璃月七星…實在令人失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020506
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020506,
					"content": "「請仙典儀」上，如何能有人行刺帝君…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020507
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020507,
					"content": "帝君遇刺之後…又如何能將嫌疑推給觀禮凡民？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020508
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020508,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020509
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020509,
					"content": "#旅者，{F#妳}{M#你}受誣為刺客的冤情，我也已然知曉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020510
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020510,
					"content": "此事我心已有判斷。然我獨斷，或有差錯，尚需知會眾仙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020511
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020511,
					"content": "#去吧。拿著{F#妳}{M#你}的「百無禁忌籙」，為我去傳口信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020512,
						10020513
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020512,
					"content": "我該去找誰呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020513
					]
				},
				{
					"id": 10020513,
					"content": "我該去哪裡呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10020514
					]
				},
				{
					"id": 10020514,
					"content": "#理水疊山真君、留雲借風真君，這兩位常在此間，但{F#妳}{M#你}未必有緣相遇——隨緣即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10020515
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10020515,
					"content": "還有一位降魔大聖、護法夜叉。去往「望舒客棧」，或可覓其蹤跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "削月築陽真君"
				}
			]
		}
	]
}