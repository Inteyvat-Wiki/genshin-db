							4784.226
						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300201,
					"content": "#{F#妳}{M#你}們來得正好，來幫個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300202,
						740300206
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300202,
					"content": "讀心術？好恐怖！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300203
					]
				},
				{
					"id": 740300203,
					"content": "嘉維婭要我們來幫忙…你是怎麼知道的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300204,
					"content": "#啊？因為這裡只有{F#妳}{M#你}們能幫忙啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300205
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300205,
					"content": "…也對哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300210,
					"content": "#反正不是什麼難事，這裡的研察終端需要兩個人同時操作。實際的指令我已經輸入完畢了，{F#妳}{M#你}們過去拉下拉杆就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300211
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300211,
					"content": "#差點忘了…儲能裝置應該就在附近，麻煩{F#妳}{M#你}們先安裝好儲能裝置再開啟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300212
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300212,
					"content": "#以及…我先確認一下，{F#妳}{M#你}們不是什麼機械殺手吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300213,
						740300214
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300213,
					"content": "這取決於你對機械殺手的定義。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300215,
					"content": "為什麼問這個呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300216,
					"content": "之前請嘉維娜幫忙，我剛把視線移開沒多久，研察終端就報廢了。問她怎麼回事，她自己也說不清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300217
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300217,
					"content": "後來從她妹妹那裡得知，沒有機械造物能在她手裡撐過半天。我猜就算是阿蘭·吉約丹本人見了她也只能嘆氣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300218
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300218,
					"content": "#當時的修理費用還是扣在我的報酬裡的…如果{F#妳}{M#你}們也和她一樣，那我這麼長時間辛勤勞動，最後還要倒貼特許券…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300219
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300219,
					"content": "居然還有這種事…我們絕對不會跟她一樣，你就放心交給我們好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300220,
					"content": "#那就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300214,
					"content": "如果研察終端會攻擊我，那我就是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300215
					]
				},
				{
					"id": 740300206,
					"content": "這忙不能白幫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300207
					]
				},
				{
					"id": 740300207,
					"content": "#等等叫嘉維婭幫{F#妳}{M#你}們申請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300208
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300208,
					"content": "欸？可是她叫我們直接找你索取報酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300209,
					"content": "她是這麼說的？那好吧。在這裡申請一點經費比在楓丹科學院還難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300210
					],
					"speakerTitle": "克蘭茨"
				}
			]
		},
		{
