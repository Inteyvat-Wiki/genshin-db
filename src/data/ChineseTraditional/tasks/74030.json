					"嘉維婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740300101,
					"content": "#{F#妳}{M#你}們好，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300102,
						740300105
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740300102,
					"content": "好巫師姐姐，幫幫我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300103
					]
				},
				{
					"id": 740300103,
					"content": "#怎麼連{F#妳}{M#你}也學起莉諾爾了？有什麼話就直說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300104
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740300104,
					"content": "我們需要很多特許券！想問問有沒有什麼我們能做的工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300107,
					"content": "#{F#妳}{M#你}們該不會是加入了艾蒂安的遊戲吧？玩鬧也要適可而止哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300108
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740300108,
					"content": "#…說起來，的確有件事想要拜託{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300109
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740300109,
					"content": "#克蘭茨現在應該正在海蝕裂隙那邊修理他的什麼裝置…{F#妳}{M#你}們去幫幫他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300110
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740300110,
					"content": "至於報酬，就直接找他索取好了。他不會有異議的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300111
					],
					"speakerTitle": "嘉維婭"
				},
				{
					"id": 740300111,
					"content": "嗯嗯！交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300105,
					"content": "有我們可以幫忙的事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300106
					]
				},
				{
					"id": 740300106,
					"content": "最好是有報酬的那種！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300107
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7403002,
			"completionStepIds": [
				7403002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
