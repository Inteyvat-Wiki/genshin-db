							4784.226
						],
						"pointId": 6254
					}
				]
			},
			"dialogs": [
				{
					"id": 740300401,
					"content": "#{F#妳}{M#你}們還滿熟練的。要不是在這種地方，我都想雇{F#妳}{M#你}們當助手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300402
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300402,
					"content": "哼哼，這點小事怎麼可能難倒我們。話說回來，這個裝置到底是做什麼用的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740300403,
					"content": "這裡原本有條通往外部的裂隙需要看守看管，現在用閉鎖裝置把路封起來就可以節省一些人力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300404
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300404,
					"content": "這項技術在楓丹科學院也不是什麼新鮮的玩意，不過反正閒著也是閒著，我就稍微做了點改造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300405
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300405,
					"content": "#{F#妳}{M#你}們現在看到的還不是完全版，完全版被用在晶簇礦坑道…咳，好像說太多了。{F#妳}{M#你}們就當沒聽到吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300406,
						740300408
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300406,
					"content": "晶簇礦坑道也有可以出去的路。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300407
					]
				},
				{
					"id": 740300407,
					"content": "#唉，是啊，{F#妳}{M#你}真的是太聰明了，如果更聰明一點，就應該把這句話放在心裡，而不是直接說出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300411,
					"content": "好了，這下問題也算解決了，嘉維娜可以不用那麼常來這裡看守，我也可以休息一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300412
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300412,
					"content": "#…差點忘了，這些是給{F#妳}{M#你}們的報酬，謝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300408,
					"content": "完全版更厲害嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740300409
					]
				},
				{
					"id": 740300409,
					"content": "#那當然了，完全版還加裝了配件…{F#妳}{M#你}打聽這麼多做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300410
					],
					"speakerTitle": "克蘭茨"
				},
				{
					"id": 740300410,
					"content": "#{F#妳}{M#你}要是想知道完全版的實際情況，可以自己去試試…被抓了不要說是我慫恿{F#妳}{M#你}去的就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740300411
					],
					"speakerTitle": "克蘭茨"
				}
			]
		}
	]
}