					"id": 760490705,
					"content": "來，把手給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490706,
					"content": "這次就不用回報啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
