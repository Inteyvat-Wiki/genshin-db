			"dialogs": [
				{
					"id": 762080101,
					"content": "咦？周圍好像有一道透明的幕升起來了…是那棵樹做的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762080102,
					"content": "感覺它好像是在吐樹脂，把這裡變成了一塊琥珀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762080103,
					"content": "那我們就變成琥珀裡的小蟲了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080104
					]
				},
				{
					"id": 762080104,
					"content": "#裝了{F#妳}{M#你}和我的琥珀，應該會在拍賣會上成為壓軸的寶貝吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762080105,
					"content": "那最後作軸子的寶貝呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762080106
					]
				},
				{
					"id": 762080106,
					"content": "當然是這棵樹了啊——畢竟是它做的琥珀嘛。可惜看樣子沒辦法把它帶走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762080107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762080107,
					"content": "不知道附近有沒有留下關於它的線索。",
					"roleType": "TALK_ROLE_NPC",
