			"dialogs": [
				{
					"id": 750100101,
					"content": "「我沒有必須達成的目標，也沒有迫切的渴望，我是個快樂的牧民，我只關心綿馱獸，關心日月花草、清風雨露…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100102
					],
					"speakerTitle": "瓦達娜"
				},
				{
					"id": 750100102,
					"content": "這是我最喜歡的小曲，怎麼樣？還不錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦達娜"
