			},
			"dialogs": [
				{
					"id": 750100201,
					"content": "#啊，是毛茸茸，有什麼毛茸茸的東西攔住了{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100202
					]
				},
				{
					"id": 750100202,
					"content": "嗯——？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100203
					],
					"speakerTitle": "活潑的綿馱獸"
				},
				{
					"id": 750100203,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100204
					],
					"speakerTitle": "「半熟蛋」"
				},
				{
					"id": 750100204,
					"content": "嗯嗯——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100205
					],
					"speakerTitle": "活潑的綿馱獸"
				},
				{
					"id": 750100205,
					"content": "欸？原來你們是朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750100206,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100207
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100207,
					"content": "看起來是在附近看管綿馱獸的人走過來安撫匿葉龍…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750100208
					]
				},
				{
					"id": 750100208,
					"content": "「半熟蛋」，你冷靜一點喔。就是因為你老是這樣輕率地下判斷，所以才是個「半熟蛋」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100209
					],
					"speakerTitle": "瓦達娜"
				},
				{
					"id": 750100209,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100210
					],
					"speakerTitle": "「半熟蛋」"
				},
				{
					"id": 750100210,
					"content": "抱歉啦，牠就是責任心太重，看到陌生人靠近就會很緊張。不過也多虧了牠這麼賣力看管綿馱獸，我才能悠閒度日，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100211
					],
					"speakerTitle": "瓦達娜"
				},
				{
					"id": 750100211,
					"content": "所以幾位到這裡來是有何貴幹呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100212,
						750100214
					],
					"speakerTitle": "瓦達娜"
				},
				{
					"id": 750100212,
					"content": "只是四處冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100213,
					"content": "#唉呀，原來是冒險家。說不定在「半熟蛋」的眼裡，{F#妳}{M#你}是渾身散發出強敵氣息的危險人物哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100216
					],
					"speakerTitle": "瓦達娜"
				},
				{
					"id": 750100216,
					"content": "沒想到匿葉龍還可以幫忙管綿馱獸。之前遠遠看到牠們，還以為綿馱獸要被襲擊了，原來是我誤會牠了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750100217,
					"content": "哈哈，常有的事。別看牠凶凶的，其實和綿馱獸關係好得很哦。說是朋友也不為過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100218
					],
					"speakerTitle": "瓦達娜"
				},
				{
					"id": 750100218,
					"content": "嗚…呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100219
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100219,
					"content": "怎麼啦，小傢伙，你也想和牠們交朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100220
					],
					"speakerTitle": "瓦達娜"
				},
				{
					"id": 750100220,
					"content": "呀！呀呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100221
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100221,
					"content": "#哇，這麼激動，看來是真的很想和牠們交朋友。不過說來也是，平常都是和我還有{NICKNAME}在一起，可以和動物交朋友的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750100222,
					"content": "那畫面一定很可愛，被綿馱獸簇擁著的頑皮小嵴鋒龍，光是看著這樣的場景我就能夠吃下三碗火焰燉肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100223
					],
					"speakerTitle": "瓦達娜"
				},
				{
					"id": 750100223,
					"content": "啊，不過也要看綿馱獸牠們願不願意，畢竟友誼這種事也勉強不來。對不對啊，「半熟蛋」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100224
					],
					"speakerTitle": "瓦達娜"
				},
				{
					"id": 750100224,
					"content": "嗚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100225,
						750100228
					],
					"speakerTitle": "「半熟蛋」"
				},
				{
					"id": 750100225,
					"content": "#誰敢不喜歡我家{REALNAME[ID(2)|SHOWHOST(true)]}？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100226
					]
				},
				{
					"id": 750100226,
					"content": "#{F#妳}{M#你}不要一副怪物監護人的樣子啦！給{REALNAME[ID(2)|SHOWHOST(true)]}一點機會，讓牠自己試試看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750100227,
					"content": "小孩子總歸要靠自己努力嘗試才能成長起來，嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750100231,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100232
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750100232,
					"content": "看牠信心滿滿的樣子應該是不用太擔心了，那我就回去休息囉。遇到問題再來找我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100233
					],
					"speakerTitle": "瓦達娜"
				},
				{
					"id": 750100233,
					"content": "哦，不過找我應該沒有找「半熟蛋」有用，要說綿馱獸還是牠最瞭解了，哈哈，開個玩笑。小傢伙，希望你交朋友順利哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦達娜"
				},
				{
					"id": 750100228,
					"content": "沒關係，牠們不願意還有我們在。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750100229
					]
				},
				{
					"id": 750100229,
					"content": "#雖然知道{F#妳}{M#你}是想讓{REALNAME[ID(2)|SHOWHOST(true)]}知道即便失敗了也不用太難過…但是也不用一開始就這麼悲觀吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750100230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750100230,
