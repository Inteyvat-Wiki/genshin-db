			"trigger": {
				"objectNames": [
					"埃爾欣根",
					"考特里亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400821301,
					"content": "預賽快要開始了，埃爾欣根好像在發表賽前的演講呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821302,
					"content": "各位選手與觀眾，「月蓮盃馴獸師大賽」即將正式開幕。我由衷希望各位能在這場比賽中找到樂趣，有所收穫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821303
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400821303,
					"content": "同時，也請各位在比賽中保持一顆純粹的競技之心，友善地比拼。盡力而為就足夠了，不必太動氣，鬥個你死我活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821304
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400821304,
					"content": "我一直在尋找人與危險生物和諧共處的方法，而你們手中的「意智寶珠」讓我看到了可能性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821305
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400821305,
					"content": "希望這次大賽能向更多人展示「馴獸」的潛力，為將來的世界提供一種規避衝突的措施，使人們在野外活動時更加安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821306
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400821306,
					"content": "原來如此！埃爾欣根是為了這個目標，才願意出讓自己的資產嗎？感覺他很有理想呢！相比之下，那個考特里亞就有點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821307,
					"content": "由衷感謝埃爾欣根先生的發言！接下來我也簡單說兩句…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821308
					],
					"speakerTitle": "考特里亞"
				},
				{
					"id": 400821308,
					"content": "各位馴獸師！你們手中的「意智寶珠」是劃時代的產物，凝聚著教令院幾百年來技術結晶，它的偉大之處有九點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821309
					],
					"speakerTitle": "考特里亞"
				},
				{
					"id": 400821309,
					"content": "考特里亞，大家都躍躍欲試呢，現在不必解釋得這麼細緻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821310
					],
					"speakerTitle": "埃爾欣根"
				},
				{
					"id": 400821310,
					"content": "咳咳！有機會的話，我再跟各位說明吧！你們在比賽中絕對能感覺到它的先進。信任你們的「意智寶珠」，盡情去比拼吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821311
					],
					"speakerTitle": "考特里亞"
				},
				{
					"id": 400821311,
					"content": "完全是個技術狂人呢，不管場合自顧自地發表觀點…還好，埃爾欣根先生很會看氣氛，沒有讓他耽誤我們的時間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821312,
					"content": "預賽總算要開始了，我們好好迎戰第一位對手吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821313,
					"content": "（賽諾？他也注意到這場比賽了嗎…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
