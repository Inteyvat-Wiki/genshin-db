			},
			"dialogs": [
				{
					"id": 400821401,
					"content": "那邊有好多人圍在一起，好像在看什麼東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821402,
					"content": "聽說主辦方準備了好幾塊留言板，讓觀眾們自由發表留言，互相交流，這種辦法確實能提高大賽的討論度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821403
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821403,
					"content": "那我和「轉轉悠悠獸」也會被大家討論嗎？要是這段經歷也能被用在論文裡就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821404
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821404,
					"content": "我覺得很適合喔！聽說寫論文要引用很多資料，這件事很讓人頭痛。現在萊依拉自己就是提供資料的人，怎麼高興就怎麼寫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821405,
					"content": "派蒙的想法真好啊…可是我是明論派的學員，只有生論派的論文會用到這種資料吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821406,
						400821407
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821406,
					"content": "隔行如隔山。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821408
					]
				},
				{
					"id": 400821408,
					"content": "嗯…萊依拉也可以向生論派學員提供資料嘛，說不定還可以賺一筆摩拉…啊呸，是資料費！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821409,
					"content": "摩拉倒是次要的…不過，作為交換，可以請生論派的學員查閱高級文獻，弄清楚「轉轉悠悠獸」的同類都喜歡什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821410
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821410,
					"content": "縮小了調查範圍後，我就輕鬆多了。不然，我可能要買幾百種東西，每樣都拿給「轉轉悠悠獸」嚐嚐看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821411
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821411,
					"content": "光是想想，我就要累昏了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821412
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821412,
					"content": "還有這種想法？萊依拉真厲害啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821413,
					"content": "那「咚咚小圓帽」的喜好也麻煩妳留意一下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821414,
					"content": "我一定盡力…回去之後我就寫信，託人送去阿彌利多學院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821415
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821415,
					"content": "（賽諾的部下？他在監視賽場…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821416
					]
				},
				{
					"id": 400821416,
					"content": "小傢伙，三十二強賽的對陣列表公佈了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821417
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821417,
					"content": "欸？下場比賽居然就要和左右加小姐對決了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821418,
					"content": "噗…我最期待的畫面出現了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821419
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821419,
					"content": "幹嘛這麼高興？妳就不怕妳寄予厚望的作者被我們打敗嗎？那八重堂的須彌之旅就會草草收場的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821420,
					"content": "#千萬別客氣啊~我從沒要求過左右加奪冠。說不定被{F#妳}{M#你}們打敗後，左右加還會因此頓悟呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821421
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821421,
					"content": "畢竟一帆風順的經歷可能讓人們變得固執，認為只有自己才是正確的，有時挫折反而更寶貴喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821422,
						400821423
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821422,
					"content": "我明白了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821424
					]
				},
				{
					"id": 400821424,
					"content": "#不錯的反應。我很期待下一場比賽喔，等{F#妳}{M#你}們的捷報~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821423,
					"content": "就按主編大人的意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821424
					]
				},
				{
					"id": 400821407,
					"content": "隔山有商機。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821408
					]
				}
			]
		}
	]
