			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"風速棗椰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400820301,
					"content": "啊哈！沒想到預賽的對手看起來這麼普通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820302
					],
					"speakerTitle": "風速棗椰"
				},
				{
					"id": 400820302,
					"content": "#來吧，就讓本小姐用華麗的快攻打敗{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820303
					],
					"speakerTitle": "風速棗椰"
				},
				{
					"id": 400820303,
					"content": "不用緊張喔，「咚咚小圓帽」，只是預賽的對手而已，把他們當成踏腳石就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4008207,
			"completionStepIds": [
				4008207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008207",
							"2"
						],
						"stepId": 4008207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"風速棗椰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400820701,
					"content": "「咚咚小圓帽」，幹得漂亮！還有大家，打得真棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400820702,
					"content": "怎麼這樣…我的風速攻勢居然輸掉了…大家快撤退！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "風速棗椰"
				}
			]
		},
		{
			"id": 4008208,
			"completionStepIds": [
				4008208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008208",
							"2"
						],
						"stepId": 4008208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"萊依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400820801,
					"content": "我覺得，指揮蕈獸和別人比賽的感覺很特別，很有趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400820802,
					"content": "不過，剛才的那個馴獸師和蕈獸們的配合也滿不錯的，簡直和我們不相上下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820803,
						400820804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400820803,
					"content": "派蒙也想參戰嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400820805
					]
				},
				{
					"id": 400820805,
					"content": "我不是那個意思啦！我是說，對方好像和蕈獸形成了一種「流派」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400820806,
					"content": "如果我們能和「咚咚小圓帽」配合得更自然就好了，我希望，我們一個眼神，「咚咚小圓帽」就知道該做什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400820807,
					"content": "這就要仰仗「夥伴間的默契」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820808
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400820808,
					"content": "神子！還有萊依拉！妳們的比賽還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400820809,
					"content": "沒想到「轉轉悠悠獸」和蘑菇夥伴們這麼厲害，兩三下就打垮了對手，我都沒反應過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820810
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400820810,
					"content": "#回到賽場時，我看見八重小姐的對手丟了魂似地逃走了…剛好，八重小姐打算和{F#妳}{M#你}們商談要事，我就跟著她一起過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820811
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400820811,
					"content": "小萊依拉順利戰勝了對手，左右加也首戰告捷，略勝對手一線。我倒是有點遺憾…對手完全沒讓我盡興呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820812
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400820812,
					"content": "現在只是開始嘛，如果預賽的對手就超能打，這場比賽未免就太難了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400820813,
					"content": "不過說起來，神子打算和我們商量什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400820814,
					"content": "#啊呀，派蒙，妳進步了呢，已經意識到了我要提醒{F#妳}{M#你}們的事。今後的對手會越來越強，我們可不能鬆懈啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820815
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400820815,
					"content": "不如就藉著贏下預賽的氣勢，和蕈獸開展「特別修行」，加強與夥伴們的配合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400820816
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400820816,
					"content": "很有先見之明！那我們現在就出發吧，和蘑菇夥伴們開始特別修行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400820804,
					"content": "絕技是「爆裂銀光轟轟拳」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400820805
					]
				}
			]
		},
		{
			"id": 4008210,
			"completionStepIds": [
				4008210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008210",
							"2"
						],
						"stepId": 4008210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶",
					"八重神子",
					"萊依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400821001,
					"content": "#怎麼是{F#妳}{M#你}們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821002
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400821002,
					"content": "海妮耶？妳救下了那些孩子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821003,
					"content": "碰巧而已。那幾個孩子想模仿參賽選手，結果被野生蕈獸圍攻。還好我聽見了動靜，才保住了他們的性命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821004
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400821004,
					"content": "這也太危險了，他們怎麼連「意智寶珠」都不拿，就冒冒失失靠近蕈獸啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821005,
					"content": "不怪他們，以前我也被蕈獸可愛的外表迷惑過…好在我還牢記著家族的教誨和祖輩們吃過的苦頭，沒有貿然接近它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821006
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400821006,
					"content": "大家原本都明白，蕈獸是危險的魔物。但最近人們被「月蓮盃」影響，慢慢對蕈獸放下了警惕心，這是埃爾欣根考慮欠妥的一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821007,
						400821008
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400821007,
					"content": "大賽的討論度太高…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821009
					]
				},
				{
					"id": 400821009,
					"content": "我會讓這場鬧劇盡快結束的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821010
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400821010,
					"content": "「意智寶珠」非常適合大規模剿殺蕈獸。等到我奪得了冠軍，就能隨意支配這些道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821011
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400821011,
					"content": "妳在說什麼啊，海妮耶？什麼鬧劇…什麼剿殺蕈獸？妳在「火一」面前說出這樣的話，就不怕傷它的心嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821012
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821012,
					"content": "妳不也參賽了嗎？還主動給過我們指導，明明也樂在其中吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821013,
					"content": "假如「火一」能意識到同類犯過的錯，想必也會支持我的。可惜它無法理解人的情感，它只是被道具控制的「棋子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821014
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400821014,
					"content": "#至於教導{F#妳}{M#你}們的理由…{F#妳}{M#你}們不也意識到了嗎？我只是看中了{F#妳}{M#你}們的實力，想要讓{F#妳}{M#你}們協助我實現自己的目標罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821015
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400821015,
					"content": "#現在{F#妳}{M#你}們居然在為蕈獸辯護，{F#妳}{M#你}們已經沉浸在這場荒謬的遊戲裡了，配不上「黃金流星」和「白銀伴星」這兩個響亮的稱號…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821016
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400821016,
					"content": "別走啊，海妮耶！我們剛剛還關閉了「意智寶珠」，在和蕈獸們一起玩呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821017
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821017,
					"content": "不打算聽我們的話啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821018
					]
				},
				{
					"id": 400821018,
					"content": "啊呀呀，還真是一位性格鮮明的角色，言行中的執著也恰到好處，我嗅到了有趣展開的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821019
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821019,
					"content": "神子？萊依拉？妳們也被呼救聲吸引過來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821020,
					"content": "#剛剛我們還聊到了她，小萊依拉說，海妮耶是{F#妳}{M#你}們參賽之初的引路人，但在{F#妳}{M#你}們遇見小萊依拉後，她又突然離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821021
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821021,
					"content": "現在看來，原來她是個經典的「迷途角色」。因為某些個體犯下了過錯，就把矛頭指向整個群體，要將對方徹底抹除…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821022
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821022,
					"content": "在「迷途角色」看來，這還是最有效、最穩妥的辦法呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821023,
						400821024
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821023,
					"content": "她似乎經歷過蕈獸的災害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821025
					]
				},
				{
					"id": 400821025,
					"content": "暴躁的蕈獸確實對環境造成過破壞，可是，也有一些研究理論說，它們只是遵循著自己的本性，和野獸沒什麼區別吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821026
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821026,
					"content": "這個物種已經存在很長時間了，一下子把它們全都除掉，反而不知道會對雨林的生態造成什麼影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821027
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821027,
					"content": "萊依拉說得對啊，做事不能太極端！不管海妮耶經歷過什麼，我們都不能看著她亂來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821028
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821028,
					"content": "#「攔在她前往冠軍的路上」？{F#妳}{M#你}們的反應也在我的意料之中呢。聽說她是大賽著名的種子選手，實力異常強勁，{F#妳}{M#你}們做好準備了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821029,
						400821030
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821029,
					"content": "我們要加強訓練。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821031
					]
				},
				{
					"id": 400821031,
					"content": "神子妳帶我們過來的目的，不就是要讓我們和蕈獸夥伴彼此熟悉，配合得更好嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821032
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821032,
					"content": "等等，難道妳一開始就料到了這種事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821033
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821033,
					"content": "#呵呵，把一切都安排得妥妥當當，反而會有些無趣吧？這次{F#妳}{M#你}們和海妮耶意外相遇，反倒給了我不少驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821034
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821034,
					"content": "今天的修行先到此為止，預賽應該已經結束了，我們去瞭解之後的賽程吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821030,
					"content": "我們要繼續培養默契。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821031
					]
				},
				{
					"id": 400821024,
					"content": "她的看法應該是有緣由的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821025
					]
				},
				{
					"id": 400821008,
					"content": "導致了新的問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821009
					]
				}
			]
		},
		{
			"id": 4008212,
			"completionStepIds": [
				4008212
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008212",
							"2"
						],
						"stepId": 4008212,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"萊依拉",
					"遇襲的小孩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400821201,
					"content": "嗯，這裡風景不錯，空氣裡有一股雨林的香氣，還足夠僻靜，沒人會來打擾我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821202
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821202,
					"content": "我們可以陪著蕈獸盡情玩耍，休息的時候，就來享受須彌的特色美食吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821203
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821203,
					"content": "好耶！吃零食吃零食！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821204,
					"content": "等等…我們不是來修行的嗎？難道神子在這些零食裡加入了特別的配方…能讓我們和蕈獸夥伴心意相通？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821205,
					"content": "就算我有那種神通，也不能濫用吧？我只帶了一些普通的果乾和點心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821206,
					"content": "#也許{F#妳}{M#你}們以為，我會為{F#妳}{M#你}們準備一場魔鬼訓練？但那種事對{F#妳}{M#你}們完全沒必要，相反，一直緊繃著弦，會錯過很多重要的事物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821207
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821207,
					"content": "既然要和蕈獸培養感情，就該把它們當成朋友來對待，留下快樂的回憶嘛，和朋友一起吃喝玩樂，是更重要的「默契修行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821208,
					"content": "假如小傢伙只想著讓妳變強，逼著妳練出石頭般的肌肉來，想看妳一拳打飛丘丘暴徒…妳會開開心心地聽話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821209
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821209,
					"content": "肌肉派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821210
					]
				},
				{
					"id": 400821210,
					"content": "#幹嘛這樣看著我！如果{F#妳}{M#你}敢做那種事…我、我就三天，不對，我就五天不理{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821211,
					"content": "#妳看，妳和小傢伙的交情這麼深，都不想被{M#他}{F#她}強迫著鍛煉，何況是剛剛認識不久的蕈獸夥伴呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821212,
					"content": "呃，完全被妳的邏輯說服了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821213,
					"content": "八重小姐的想法屬實在理。我也想看看，如果關閉了「意智寶珠」，或是寶珠出現故障，蘑菇夥伴還會聽我們的話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821214
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821214,
					"content": "關閉意智寶珠？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821215
					]
				},
				{
					"id": 400821215,
					"content": "嗯，朋友之間都是慢慢熟悉彼此，才一步步達成互相信任的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821216
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821216,
					"content": "我不能總是依賴道具去和「轉轉悠悠獸」溝通，這樣多少有點命令它的感覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821217
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821217,
					"content": "哎呀，「純粹的情感，絕不能依靠身外之物來維繫」…小萊依拉的想法還真是經典~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821218
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821218,
					"content": "可是，這就等於解除了對蕈獸的控制…真的沒問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821219,
						400821220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821219,
					"content": "我覺得值得一試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821221
					]
				},
				{
					"id": 400821221,
					"content": "儘管試試看吧，小萊依拉。不用擔心，我和小傢伙們會幫妳的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821222
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821222,
					"content": "好，請大家做好準備，我要開始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821223
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821223,
					"content": "真的耶，關掉了「意智寶珠」以後，「轉轉悠悠獸」只是自顧自地活動了起來，並沒有像以前那樣攻擊附近的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821224,
					"content": "或許「意智寶珠」能讓蕈獸們的性格變得平和，以便搭起溝通的橋樑，而不是憑藉某種技術強行控制它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821225
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821225,
					"content": "#如果這個假設屬實，小萊依拉的期待就有望成真了——{F#妳}{M#你}們和蕈獸熟悉彼此後，不使用「意智寶珠」也能毫無障礙地溝通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821226
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821226,
					"content": "還是神子說得好！什麼神秘技術都靠邊站，這個假設我更喜歡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821227,
					"content": "我會努力的！我要瞭解「轉轉悠悠獸」的喜好，然後去找一位「全能商人」，買很多它喜歡的零食…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821228
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821228,
					"content": "那我也要和原本的「咚咚小圓帽」交流！我們也試著關掉「意智寶珠」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821229,
					"content": "（為什麼「意智寶珠」會有如此之強的效果？考特里亞掌握著其他學者都不瞭解的強大技術嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821230
					]
				},
				{
					"id": 400821230,
					"content": "#「轉轉悠悠獸」想去那邊玩水？{NICKNAME}、派蒙和八重小姐，要帶著蘑菇夥伴一起來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821231
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821231,
					"content": "妳得特別注意，站在水裡時，別離「百雷遮羅」太近，否則可能享受到特別的腿部按摩服務喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821232,
						400821233
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400821232,
					"content": "「咚咚小圓帽」是浮游水蕈獸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821234
					]
				},
				{
					"id": 400821234,
					"content": "妳不說我都快忘了…我們應該讓「咚咚小圓帽」體驗一些新奇的事？比如帶著它爬樹，去樹頂看風景？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821235,
					"content": "那萊依拉、神子，妳們先去吧。「咚咚小圓帽」以前在水邊生活，應該對玩水習以為常了，我們想幫它換點花樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821236,
					"content": "#原來如此…之後我們就在這裡會合吧，希望{F#妳}{M#你}們也玩得開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821237
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400821237,
					"content": "萊依拉和八重神子帶著蕈獸去遠處玩耍了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400821238
					]
				},
				{
					"id": 400821238,
					"content": "「咚咚小圓帽」，你想玩什麼都行，可以和我們說喔，我應該能理解你的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821239,
					"content": "噫！居然不理我…我要塞好多好多好吃的給它，努力和它變熟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821240,
					"content": "救命、救命啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821241
					],
					"speakerTitle": "遇襲的小孩"
				},
				{
					"id": 400821241,
					"content": "這和說好的不一樣！蕈獸怎麼這麼凶啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821242
					],
					"speakerTitle": "遇襲的小孩"
				},
				{
					"id": 400821242,
					"content": "#{F#妳}{M#你}聽見了嗎？好像有人在呼救！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400821243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821243,
					"content": "不對勁，我們趕快去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400821233,
					"content": "「咚咚小圓帽」總是在玩水。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821234
					]
				},
				{
					"id": 400821220,
					"content": "我也想知道結論。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400821221
					]
				}
			]
		},
		{
			"id": 4008213,
