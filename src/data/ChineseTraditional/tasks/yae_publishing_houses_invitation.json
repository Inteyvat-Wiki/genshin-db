			"trigger": {
				"objectNames": [
					"常九爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060201,
					"content": "#咦？旅行者，{F#妳}{M#你}今天過來是有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060202
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 728060202,
					"content": "關於「八重堂」的信件和禮物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060203
					]
				},
				{
					"id": 728060203,
					"content": "「八重堂」的信？不會又是來叫我改筆名的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060204
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 728060204,
					"content": "我都說了，我署原名就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060205
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 728060205,
					"content": "算了，算了，我還是看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060206
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 728060206,
					"content": "小說比賽…評審，這…我也許沒空去啊，但還是謝謝他們的好意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060207
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 728060207,
					"content": "咦？這後面怎麼還有這麼多，這是…創作建議…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060208
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 728060208,
					"content": "#呃，我、我會好好看看的，謝謝{F#妳}{M#你}，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
				}
			]
		},
		{
			"id": 7280604,
			"completionStepIds": [
				7280604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280604",
							"2"
						],
						"stepId": 7280604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728060401,
					"content": "嗯…這裡寫得倒是不錯，文筆頗為新穎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060402
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060402,
					"content": "行秋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060403
					]
				},
				{
					"id": 728060403,
					"content": "原來如此，原來如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060404
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060404,
					"content": "行秋！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060405
					]
				},
				{
					"id": 728060405,
					"content": "#欸？是{F#妳}{M#你}啊，{NICKNAME}，好久不見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060406
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060406,
					"content": "#聽{F#妳}{M#你}剛才打招呼的語氣，{F#妳}{M#你}還挺有精神的嘛，不錯，不錯…找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060407
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060407,
					"content": "其實，我們是想向你打聽一個人，你讀的書多，說不定會知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728060408,
					"content": "#一個人？{F#妳}{M#你}們莫不是要找哪位作者？唔…但說無妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060409
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060409,
					"content": "關於「枕玉」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060410
					]
				},
				{
					"id": 728060410,
					"content": "#「枕玉」？{F#妳}{M#你}、{F#妳}{M#你}是從哪聽到這名字的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060411
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060411,
					"content": "這本《沉秋拾劍錄》上寫著呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060412
					]
				},
				{
					"id": 728060412,
					"content": "我們正在找這位「枕玉」，稻妻那邊的「八重堂」拜託我們把一封信帶給這位作者呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728060413,
					"content": "你知道這位「枕玉」到底是誰嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728060414,
					"content": "嗯…這位「枕玉」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060415
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060415,
					"content": "說來慚愧，其實正是…我的筆名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060416
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060416,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 728060417,
					"content": "之前沒聽你說過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728060418
					]
				},
				{
					"id": 728060418,
					"content": "這件事…這件事也沒什麼好提起的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060419
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060419,
					"content": "當初在璃月時，負責的編輯說我寫的這本書「設定過於離譜，劇情卻意外地俗套，沒人會喜歡」，然後就把我的稿給拒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060420
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060420,
					"content": "我聽了之後…咳，不太服氣，就自己印了幾本，偷偷放在「萬文集舍」裡，看有沒有人喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060421
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060421,
					"content": "結果，取閱者依然寥寥，我就沒再把心放在這上面了。沒想到，這本書在稻妻居然能受到如此好評。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060422
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060422,
					"content": "但無論如何，我寫的這書有人願意看，自然是好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728060423
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 728060423,
					"content": "#我會好好看看這封信的，謝謝{F#妳}{M#你}旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				}
			]
		},
