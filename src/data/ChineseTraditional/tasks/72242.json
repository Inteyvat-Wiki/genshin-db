			"dialogs": [
				{
					"id": 722420401,
					"content": "原來海祇島下面有這麼巨大的空間嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722420402,
					"content": "看起來，我們的目標應該就是中間那個地方了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722420403,
					"content": "#好咧，{NICKNAME}，我們就穩步推進吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722420404,
					"content": "那邊的廢墟看起來比較近，先從那塊開始探索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722420405,
					"content": "有建築物就說明曾經有人，有人的話就會留下那種紙條。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722420406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722420406,
					"content": "紙多的地方最容易找到根本看不懂的提示了。",
					"roleType": "TALK_ROLE_NPC",
