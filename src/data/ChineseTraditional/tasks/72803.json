			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"尖刻的盜寶團成員"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030201,
					"content": "你們這些小偷！都怪你們拿走我的供品，神明大人才不給我回應！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030202
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030202,
					"content": "供品？你是說之前在神龕旁邊放著的東西？拜託，那些破爛你送我都不要好嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030203
					],
					"speakerTitle": "尖刻的盜寶團成員"
				},
				{
					"id": 728030203,
					"content": "再說，用那些破爛供奉神龕，神明給你回應才怪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030204
					],
					"speakerTitle": "尖刻的盜寶團成員"
				},
				{
					"id": 728030204,
					"content": "你…你…你胡說！那才不是破爛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030205
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030205,
					"content": "算了，我可沒時間和你們折騰了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030207
					],
					"speakerTitle": "尖刻的盜寶團成員"
				},
				{
					"id": 728030207,
					"content": "我…我供奉給神明大人的那些東西，才不是破爛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030208
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030208,
					"content": "可以告訴我們你的願望嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030209
					]
				},
				{
					"id": 728030209,
					"content": "好吧…反正事情都這樣了，我的願望也肯定不會成真了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030210
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030210,
					"content": "我的兩個願望都很簡單，一個是以後再也不用考試了！不用考試的話，我就不會被批評了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030211
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030211,
					"content": "另一個就是…和我一起念書的那個壞蛋不要再欺負我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030212,
						728030214
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030212,
					"content": "我也不喜歡考試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030213
					]
				},
				{
					"id": 728030213,
					"content": "對吧！考試太讓人難受了…可是，那個壞蛋比考試還讓人難受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030216,
					"content": "她好幾次撞見我向神龕許願說不想考試，就去老師那裡問到了我考試的成績。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030217
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030217,
					"content": "從那以後，她就總是抓著我說，與其一個勁向神明祈禱不要考試，不如把時間花在功課上，老是這麼嘮叨神明大人也會不耐煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030218
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030218,
					"content": "還說什麼，我這麼做看著就很…很沒出息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030219
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030219,
					"content": "太依賴神明的確不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030220
					]
				},
				{
					"id": 728030220,
					"content": "可大人們遇見問題的時候，也會經常去神龕那邊供奉啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030221,
						728030222
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030221,
					"content": "那只是一種祈願。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030223,
					"content": "唔…我不明白…大家難道不是為了讓神明幫忙解決問題，而去神龕供奉的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030224
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030224,
					"content": "我們去找別人問問吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030225
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030225,
					"content": "嗯…好吧，但不管怎麼樣，我的願望肯定是不能實現了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030222,
					"content": "最終還是要自己解決問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030223
					]
				},
				{
					"id": 728030214,
					"content": "壞人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030215
					]
				},
				{
					"id": 728030215,
					"content": "是和我一起念書的一個人，但是她…她不講道理嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030216
					],
					"speakerTitle": "翔太"
				}
			]
		},
		{
			"id": 7280304,
			"completionStepIds": [
				7280306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280306",
							"2"
						],
						"stepId": 7280306,
						"stateName": "QUEST_STATE_UNFINISHED"
