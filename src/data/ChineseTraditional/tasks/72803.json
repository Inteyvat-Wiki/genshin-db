				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宏一"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030401,
					"content": "你們好，找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030402
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030402,
					"content": "關於供奉神龕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030403
					]
				},
				{
					"id": 728030403,
					"content": "喔…你說這個啊，我倒是也去過幾次啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030404
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030404,
					"content": "嘿嘿，我想讓神明大人保佑我，長大之後能去外面的世界看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030405
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030405,
					"content": "不過嘛，供奉歸供奉，我平時也在好好地努力學習功課。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030406
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030406,
					"content": "因為我爸媽說，想要去外面旅行的話，必須要有足夠的錢才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030407
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030407,
					"content": "對，只要神明大人護佑的話，這些肯定能順利成功的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030408
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030408,
					"content": "哎呀，話也不能這麼說啦。畢竟要是我真去外面旅行了，稻妻的神明應該也沒辦法護佑到國外吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030409
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030409,
					"content": "用我爸媽的話說，供奉神明這件事，頂多算是求個心安啦。想要完成願望，還是得靠自己的努力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030410
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030410,
					"content": "具體的道理，我也說不清啦，你們要是想瞭解的話，就去問問七月姐吧，她很懂這種事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030411
					],
					"speakerTitle": "宏一"
				},
				{
					"id": 728030411,
					"content": "#唔…那{F#大姐姐}{M#大哥哥}，我們就去找七月姐姐吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
		{
			"id": 7280305,
			"completionStepIds": [
				7280307
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7280307",
							"2"
						],
						"stepId": 7280307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"彌生七月"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 728030501,
					"content": "翔太？怎麼一副委屈的表情，有人欺負你嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030502
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030502,
					"content": "七月姐姐，妳肯定知道城裡大家供奉神龕，祈求神明大人保佑的事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030503
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030503,
					"content": "只要盡全力供奉神龕，讓神明大人願意回應，所有願望都會實現…對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030504
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030504,
					"content": "咦？為什麼突然提到這些…是發生了什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030505
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030505,
					"content": "事情是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030507
					]
				},
				{
					"id": 728030507,
					"content": "你這孩子…原來你抱著這樣的想法，才這麼積極地供奉神龕啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030508
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030508,
					"content": "嗯！我可是很誠心地供奉了神明大人，但供品卻被人拿走了…神明大人肯定會怪罪我，不會護佑我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030509
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030509,
					"content": "你這孩子…放心吧，神明大人不會為了這麼點事而生氣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030510
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030510,
					"content": "是、是這樣嗎？那就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030511
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030511,
					"content": "但是同樣，神明大人也不會為了一點供品，而專門去護佑某人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030512
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030512,
					"content": "誒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030513
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030513,
					"content": "大家之所以會去供奉神龕，祈求神明大人的保佑，與其說是希望神明幫助自己完成心願，倒不如說，是為自己樹立一個牢固的「信心」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030514
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030514,
					"content": "信心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030515
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030515,
					"content": "「都已經在神明面前說過願望了，一定要認真努力才行。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030516
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030516,
					"content": "「有神明護佑，努力下去一定會成功的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030517
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030517,
					"content": "有了這樣的「信心」之後，再朝著自己的願望全力前進。這才是大家去供奉神龕的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030518
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030518,
					"content": "畢竟…事在人為，如果只是祈求神明的幫助，自己卻不採取行動，就算神明真的想要幫助你，也完全沒有地方插手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030519
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030519,
					"content": "可、可是！之前供奉了神龕之後，神明大人都很直接地給了幫助啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030520
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030520,
					"content": "像那場火災啦、想變強的大伯啦，還有我的那個漫畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030521,
						728030522
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030521,
					"content": "（還是唸叨著神明啊…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				},
				{
					"id": 728030523,
					"content": "嗯…確實，看來這位神明實現願望的方式確實很直接…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030524
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030524,
					"content": "但是，但是這次考試沒有消失，那個欺負我的人也還在，她一個勁地要我去學習功課，每天都催個不停…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030525
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030525,
					"content": "唔，等一下，那麼這個「欺負」你的人，叫什麼名字？是什麼時候出現的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030526
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030526,
					"content": "她叫…她…她叫…欸？她叫什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030527
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030527,
					"content": "她好像是和我一起入學…不對不對，好像比我早一些…還是晚一些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030528
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030528,
					"content": "奇怪…我怎麼，我怎麼什麼都記不清了，只記得有一個小女孩，每天來催我做功課…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030529
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030529,
					"content": "嗯，看來，那位神明這一次也回應了你的祈求，正在幫助你對付考試呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030530
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030530,
					"content": "妳、妳是說，那個老是欺負我的人，是神明大人讓她過來督促我做功課的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030531
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030531,
					"content": "不，不要啊！我不想做功課，我不想考試！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030532
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030532,
					"content": "嗚哇！她又來了，就在那邊，從街那邊過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030533,
						728030534
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030533,
					"content": "在哪呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030535,
					"content": "#{F#大姐姐}{M#大哥哥}！{F#妳}{M#你}們看不見她嗎？！她手裡抱著好大一疊試卷啊！嗚哇！不要啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030536
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 728030536,
					"content": "看來，那位神明大人還是很敬業的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030537,
						728030538
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030537,
					"content": "這神明也太不按牌理出牌了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030539,
					"content": "不過，有了神明大人親自督促做作業，那孩子應該會順利通過考試吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030540
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030540,
					"content": "畢竟那孩子總是在神龕前面嘮叨，神明大人應該也快受不了了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						728030541
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030541,
					"content": "咦，等會，這路上哪裡來的葉子，剛才還沒有的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 728030538,
					"content": "聽起來不像神明做的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030539
					]
				},
				{
					"id": 728030534,
					"content": "完全沒看見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030535
					]
				},
				{
					"id": 728030522,
					"content": "（完全說不通…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						728030523
					]
				}
			]
		}
	]
}