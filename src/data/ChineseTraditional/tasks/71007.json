			"trigger": {
				"objectNames": [
					"梵米爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710070101,
					"content": "你畫得怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710070102
					]
				},
				{
					"id": 710070102,
					"content": "從雕像眼睛發光開始，我就一直在那兩個雕像旁邊畫畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070103
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710070103,
					"content": "不過，怎麼說呢…總感覺，我一直沒畫出最完美的那一幅畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070104
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710070104,
					"content": "#我總感覺我的畫裡缺了什麼東西…{F#妳}{M#你}能理解嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070105
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710070105,
					"content": "就像是一道菜，無論是用料還是做法，一切都很好，但是…但是就感覺缺點什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070106
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710070106,
					"content": "哎呀，我也不知道怎麼表達，而且也抓不住那個感覺，所以我只能不停地畫下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070107
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710070107,
					"content": "#哈哈哈，不怕{F#妳}{M#你}笑我，我畫得頭都有點暈了，就想要閉眼休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070108
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710070108,
					"content": "但不知道為什麼，我閉眼的時候，突然又看見那兩個雕像亮起來的眼睛…就在我眼前。就和那兩個雕像活了似的，直直地盯著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070109
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710070109,
					"content": "我，我就回來這裡，想要休息一下，這裡應該看不見那兩個雕像的眼睛了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070110
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710070110,
					"content": "#對了，請{F#妳}{M#你}收下這幅畫吧，這是目前為止，我覺得最好的一幅畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070111
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710070111,
					"content": "#{F#妳}{M#你}別在意我說的話，我肯定是太累了，休息一下就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710070112
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710070112,
					"content": "但是我的畫，到底缺了什麼呢，缺了什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米爾"
				}
			]
		}
	]
}