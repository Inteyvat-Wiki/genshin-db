			},
			"dialogs": [
				{
					"id": 200280101,
					"content": "#謝，謝謝{F#妳}{M#你}，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280102
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 200280102,
					"content": "雖然是獵人…但是我也拿這些史萊姆沒辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280103
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 200280103,
					"content": "被這群傢伙一攪合，這次狩獵我又什麼都帶不回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280104
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 200280104,
					"content": "只希望別的獵人不要和我一樣倒楣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280105
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 200280105,
					"content": "#對了，說起這個，能請{F#妳}{M#你}去周圍看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280106
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 200280106,
					"content": "不知道是不是我的錯覺，在鎮子周圍…史萊姆好像越來越多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280107
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 200280107,
					"content": "#請{F#妳}{M#你}去前頭看看吧。如果發現了史萊姆，就直接把它們消滅掉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280108,
						200280109
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 200280108,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280110
					]
				},
				{
					"id": 200280110,
					"content": "#那就拜託{F#妳}{M#你}了，我也會回去和杜拉夫先生報告的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200280111
					],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 200280111,
					"content": "希望他別喝太多了，能聽進去我說的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "膽小的莫羅"
				},
				{
					"id": 200280109,
					"content": "還有別的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200280112
					]
				},
				{
					"id": 200280112,
					"content": "#但有能力能解決這件事的人，只有{F#妳}{M#你}了。為了清泉鎮，就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "膽小的莫羅"
				}
			]
		}
	]
