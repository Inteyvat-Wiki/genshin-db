			"dialogs": [
				{
					"id": 401720101,
					"content": "嗨！各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720102
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720102,
					"content": "奶奶，妳來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720103
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720103,
					"content": "你這裡沒有好消息吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720104
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720104,
					"content": "#一眼就被奶奶看出來了啊。{NICKNAME}收集了很多遊靈，我一一分辨了，都沒有勒拉的特徵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720105
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720105,
					"content": "看你的樣子就知道了。沒關係，大海撈針本來就是很難的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720106
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720106,
					"content": "雖然勒拉的情況還比較穩定，可是這樣下去也不是辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720107
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720107,
					"content": "我倒是有些進展，勒拉的父母告訴我勒拉前陣子認識了一個朋友，經常一出門就好幾天不回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720108
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720108,
					"content": "他們有一次悄悄跟了過去，發現勒拉和那個朋友在一個營地裡弄些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720109
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720109,
					"content": "他們看到那個人了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720110
					]
				},
				{
					"id": 401720110,
					"content": "嗯，是個男人，名叫谷中，穿著似乎是稻妻的款式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720111
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720111,
					"content": "谷中先生，用這個就可以了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720112
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401720112,
					"content": "據我從古籍裡學習的知識，大多數過敏的症狀會使用相應的減敏療法，我想反過來也一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720113
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 401720113,
					"content": "您是對靈性完全沒天分的可憐人，只能完全將自己浸泡在充滿靈性的物質中。這樣的方法，我稱為過敏療法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720114
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 401720114,
					"content": "…會有問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720115
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401720115,
					"content": "您才是靈性白痴，強行施法會怎麼樣您應該比我更清楚。如何決定，還是看您自己了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720116
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 401720116,
					"content": "好吧…但我還有一個問題，谷中先生為什麼要幫助我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720117
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401720117,
					"content": "畢竟像我這樣的傢伙，在族裡根本插不了什麼話，沒有什麼能回報的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720118
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401720118,
					"content": "回報？請您好好看看我的臉吧，看看上面寫了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720119
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 401720119,
					"content": "呃…寫了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720120
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401720120,
					"content": "「樂於助人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720121
					],
					"speakerTitle": "淵上"
				},
				{
					"id": 401720121,
					"content": "嗚哇！沒想到是個稻妻人，居然還是為了替勒拉治病？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720122,
					"content": "過敏療法，真是天馬行空的點子啊…真的有用嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720123
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720123,
					"content": "看勒拉現在的樣子，結果應該是失敗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720124,
					"content": "哼，很久以前族內是有過這種辦法，但成功率很低，又太過冒險，漸漸就被禁止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720125
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720125,
					"content": "至於這個谷中的目的，我看也沒那麼簡單，在勒拉出事後他就消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720126
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720126,
					"content": "我按照勒拉父母給的地址去了營地，那裡有明顯的靈性殘留。另外，我還發現了這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720127
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720127,
					"content": "這是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720128
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720128,
					"content": "某種碎片…似乎是武器或者儀具上的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720129
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720129,
					"content": "你也感覺到了吧？雖然看起來有點年代，但上面還是有很強大的靈性殘留。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720130
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720130,
					"content": "勒拉應該就是用這個東西做媒介的，這能解釋他這個靈性白痴是怎麼開始暝視的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720131
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720131,
					"content": "等等，我還有一種熟悉的感覺，它似乎與我的古名有關係…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720132
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720132,
					"content": "歐洛倫的古名？難道這是古名碎片嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720133,
					"content": "不…我覺得它可能是古名的前主人留下的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720134
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720134,
					"content": "難道是桑哈傑的遺物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720135
					]
				},
				{
					"id": 401720135,
					"content": "奶奶我開始手癢了，這次的暝視就用這個來做媒介。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720136
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720136,
					"content": "#那還是和上次一樣吧？讓{NICKNAME}用靈性織機把茜特菈莉看到的畫面織下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720137,
					"content": "不，這次讓歐洛倫來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720138
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720138,
					"content": "為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720139
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720139,
					"content": "這是安全措施。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720140
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720140,
					"content": "#你對靈性領域的認知比{NICKNAME}強，如果這是桑哈傑的遺物，萬一出現意外狀況，你能更好地應對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720141
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720141,
					"content": "#噢…看見了吧，派蒙。我就說奶奶很在意{NICKNAME}吧，一點都不肯讓{M#他}{F#她}冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720142
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720142,
					"content": "我這樣的孫子就無所謂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720143
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720143,
					"content": "喂！你在說什麼啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720144
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720144,
					"content": "不好意思，奶奶，我準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720145
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720145,
					"content": "那我們就開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720149
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720146,
					"content": "按照計畫，茜特菈莉以神秘碎片為媒介，開始了第二次暝視。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401720147
					]
				},
				{
					"id": 401720149,
					"content": "出來了！這次的織物…好像是一張碎掉的弓，在火焰裡燃燒著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720150,
					"content": "#{F#妳}{M#你}們看，其中一塊是不是和這個碎片有點像啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720151
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720151,
					"content": "真的！好像是弓身的位置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720152,
					"content": "我在奶奶家裡的織卷上有看過跟這把弓很像的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720153
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720153,
					"content": "沒錯…它是桑哈傑征戰燼寂海時使用的武器。看來這塊碎片，是貨真價實的桑哈傑遺物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720154
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720154,
					"content": "#不愧是桑哈傑前輩，雖然遺物的靈性波動很強，但剛才並沒有什麼危險。如果是{NICKNAME}來的話，應該也沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720155
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720155,
					"content": "果然這就是英雄！留下來的東西都可以拿來給後人治療。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720156,
					"content": "僅僅是治療嗎？我總覺得…那個谷中還別有目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720157
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720157,
					"content": "讓我想想，剛剛我們看見了完整的弓的樣子…難道是…他想找到其他碎片的下落？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720158,
					"content": "雖說是桑哈傑前輩的東西，但既然都已經碎掉了，就算找齊了也派不上什麼用場了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720159
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720159,
					"content": "而且為什麼要找一個靈性白痴來做這件事？這樣只會什麼也得不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720160
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720160,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720161
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401720161,
					"content": "欸？勒拉的身體好像有反應了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720162,
					"content": "讓我看看。我感覺到有靈性在向碎片附著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720163
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720163,
					"content": "那就是說，奶奶的方向是正確的。勒拉的游離靈性正在被吸引過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720164
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720164,
					"content": "既然如此，我要再試一次，用勒拉的身體與這塊碎片一起當作媒介。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720165
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720165,
					"content": "加油，奶奶。我也會加油的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720166
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720166,
					"content": "這次讓我來操縱靈性織機吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401720167
					]
				},
				{
					"id": 401720167,
					"content": "#{F#妳}{M#你}也手癢了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720168
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720168,
					"content": "一人一次，這樣比較公平嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720169
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401720169,
					"content": "安全性我也確認過了，應該不會有危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720170
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401720170,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401720171
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401720171,
					"content": "#好，既然{NICKNAME}有這個想法，就這麼做吧。準備好了就告訴我一聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
			]
		},
