			"dialogs": [
				{
					"id": 140001001,
					"content": "妳好，那個…請問妳就是嘉瑪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140001002,
					"content": "…你們是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001003
					],
					"speakerTitle": "嘉瑪"
				},
				{
					"id": 140001003,
					"content": "別緊張，我們沒有惡意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001004
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001004,
					"content": "妳好像受傷了，不要緊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001005
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001005,
					"content": "謝謝關心。你們到底是誰，找我有什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001006
					],
					"speakerTitle": "嘉瑪"
				},
				{
					"id": 140001006,
					"content": "我叫林尼，這是我妹妹琳妮特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001007
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001007,
					"content": "#我是派蒙、這位是{NICKNAME}。我們是來調查怪盜貂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001008
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140001008,
					"content": "今天早上，怪盜貂又公開了預告函。如果怪盜貂還活著，表示塞薩爾是被冤枉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001009
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001009,
					"content": "妳是最瞭解塞薩爾的人，我們想聽聽妳的看法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001010
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001010,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001011
					],
					"speakerTitle": "嘉瑪"
				},
				{
					"id": 140001011,
					"content": "請妳相信我們。我們不會傷害妳。相反地，我們會盡可能保護妳的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001012
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001012,
					"content": "我…從來就不相信塞薩爾會是怪盜貂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001013
					],
					"speakerTitle": "嘉瑪"
				},
				{
					"id": 140001013,
					"content": "果然。那十年前，妳有察覺到什麼異樣嗎？比如有沒有人和他發生過衝突？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001014
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001014,
					"content": "…沒有。我什麼也不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001015
					],
					"speakerTitle": "嘉瑪"
				},
				{
					"id": 140001015,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001016
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140001016,
					"content": "這樣啊。抱歉，打擾到妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001017
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001017,
					"content": "沒什麼事就請離開吧，我想和他單獨待一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001018
					],
					"speakerTitle": "嘉瑪"
				},
				{
					"id": 140001018,
					"content": "總覺得她剛剛的表情好像不太自然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001019
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140001019,
					"content": "她在說謊，她一定知道些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001020
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140001020,
					"content": "也許是不太信任我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140001021
					]
				},
				{
					"id": 140001021,
					"content": "嗯，畢竟我們突然出現，冷不防地要查十年前的事，她會提防我們也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140001022
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140001022,
					"content": "看來暫時很難問出什麼消息了。今天先到此為止吧，明天我們在德波大飯店門口碰頭，再開始下一步的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				}
			]
		},
