						140000402
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140000402,
					"content": "#抱歉，路上遇到了{NICKNAME}和夏洛蒂，一起聊了一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000403
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000403,
					"content": "琳妮特，好久不見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000404,
					"content": "我們現在是林尼的臨時助手，來幫你們一起調查怪盜貂的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000405,
					"content": "#謝謝，{F#妳}{M#你}們人真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000406
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140000406,
					"content": "怎麼樣，見到嘉瑪了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000407
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000407,
					"content": "我一直在這裡等著，並沒有人來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000408
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140000408,
					"content": "奇怪，難道說情報有問題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000409
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000409,
					"content": "#光在這裡等著也不是辦法。{NICKNAME}、派蒙，我們先去附近打聽一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				}
			]
