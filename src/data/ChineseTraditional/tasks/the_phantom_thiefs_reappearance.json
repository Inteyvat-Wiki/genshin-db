					},
					{
						"sceneId": 3,
						"position": [
							3482.697,
							429.834,
							4610.486
						],
						"pointId": 5446
					},
					{
						"sceneId": 3,
						"position": [
							3485.519,
							429.834,
							4611.608
						],
						"pointId": 5447
					}
				]
			},
			"dialogs": [
				{
					"id": 140000201,
					"content": "魔術師哥哥，剛才你怎麼知道我選的是哪張卡牌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000202
					],
					"speakerTitle": "大衛"
				},
				{
					"id": 140000202,
					"content": "很簡單。噓…悄悄告訴你，其實魔術師都會「讀心術」，可以輕鬆看穿一個人內心藏著的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000203
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000203,
					"content": "真的假的？那你猜猜我在想什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000204
					],
					"speakerTitle": "大衛"
				},
				{
					"id": 140000204,
					"content": "放輕鬆，我看到你內心緊閉，似乎在說「絕對不能被猜到」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000205
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000205,
					"content": "唔…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000206
					],
					"speakerTitle": "大衛"
				},
				{
					"id": 140000206,
					"content": "現在你變得有點慌張。你開始想辦法放空大腦，強迫自己什麼也不去想。不過越是想要隱藏，秘密也就暴露得越快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000207
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000207,
					"content": "你是瞞著家人偷偷跑出來的吧？為了出來玩，你對他們說謊了，這可不是個好習慣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000208
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000208,
					"content": "這你都能看出來嗎？好厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000209
					],
					"speakerTitle": "大衛"
				},
				{
					"id": 140000209,
					"content": "那當然。好了，魔術演出結束，你也該回去了。記得要好好向擔心你的家人道歉，明白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000210
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000210,
					"content": "嗯，我知道了…再見，魔術師哥哥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000211
					],
					"speakerTitle": "大衛"
				},
				{
					"id": 140000211,
					"content": "林尼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000212,
					"content": "#{F#妳}{M#你}們好，又見面了。{F#妳}{M#你}們是來找我的嗎，發生什麼事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000213
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000213,
					"content": "你不是會「讀心術」嗎，猜猜看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000214,
					"content": "#別難為我了，{F#妳}{M#你}們不會也相信我有讀心術吧？我可沒有那麼大的本事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000215
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000215,
					"content": "剛剛我們可是看到了，林尼先生準確地看穿了那孩子內心的秘密！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000216
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000216,
					"content": "那只是魔術手法而已，我會透過他臉上的微表情做出判斷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000217
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000217,
					"content": "魔術散場後，只有他的身邊沒有家長陪同，而他的視線也有點閃躲，猜中他的心事並不難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000218
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000218,
					"content": "#至於{F#妳}{M#你}們的來意…這讓我怎麼猜呢？總不會是為了怪盜貂的事情吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000219
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000219,
					"content": "你怎麼知道！這也是「魔術手法」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000220,
					"content": "啊，我猜對了？哈哈…不是什麼手法，這次只是純粹的運氣好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000221
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000221,
					"content": "#今天早上預告函的事鬧得沸沸揚揚，我想說不定{F#妳}{M#你}們也在打聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000222
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000222,
					"content": "沒錯，我打算做一期專欄，報導怪盜貂的最新情報！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000223
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000223,
					"content": "林尼先生，請問你對怪盜貂重現人間的事情怎麼看呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000224
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000224,
					"content": "這個嘛…說實話，我很生氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000225
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000225,
					"content": "生氣？為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000226,
					"content": "#{F#妳}{M#你}們應該看過那封預告函了吧？怪盜貂說，他會在三天後的晚上在歌劇院作案，而我恰好在那天有一場魔術表演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000227
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000227,
					"content": "這麼巧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000228,
					"content": "等等，該不會怪盜貂這次盯上的人…是你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000229,
					"content": "如果真是這樣，那這封預告函就是對我的挑釁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000230
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000230,
					"content": "就算不是衝著我來的，我也很頭痛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000231
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000231,
					"content": "怪盜貂的名聲很差，大家對他避之不及，等預告函的內容流傳開，大概沒多少人敢來看我的表演了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000232
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000232,
					"content": "我為這場表演準備了很久，不能眼睜睜地看著它被怪盜貂毀掉。所以…我打算在表演開始前，拆穿怪盜貂的真實身分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000233
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000233,
					"content": "真的嗎！也就是說…我們能看到魔術師與怪盜的對決了？這可真是了不得的獨家新聞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000234
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000234,
					"content": "我也不確定能不能成功，畢竟十年前怪盜貂就是出名的竊賊，有著讓人捉摸不透的手法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000235
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000235,
					"content": "林尼先生太謙虛啦，我倒是覺得你平時變魔術的「手法」比怪盜還要神秘呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000236
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000236,
					"content": "多謝稱讚，不過這個對比稍微有點不妥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000237
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000237,
					"content": "世人常常將魔術師和怪盜聯繫在一起，因為他們都能神不知鬼不覺地把東西變消失。但其實，這兩種手法是不一樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000238
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000238,
					"content": "#讓我用一個小小的魔術來舉例吧，這是一朵剛摘不久的花。請{F#妳}{M#你}們盯著它，千萬不要眨眼。三、二、一…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000239
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000239,
					"content": "消失了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000240,
					"content": "花去哪了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140000241
					]
				},
				{
					"id": 140000241,
					"content": "是啊，去哪了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000242
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000242,
					"content": "#——{F#妳}{M#你}看，這就是魔術師與怪盜不同的地方。怪盜只會讓寶物消失，但魔術師可以把它再變出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000243
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000243,
					"content": "現在，請各位檢查一下自己的衣裝，看看有沒有多出什麼「驚喜」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000244
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000244,
					"content": "驚喜？我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000245,
					"content": "！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140000246
					]
				},
				{
					"id": 140000246,
					"content": "在這裡！！這是怎麼做到的？你明明就站在那沒有動——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000247,
					"content": "真是精彩的魔術！抱歉林尼先生，剛剛我的稱讚不是很恰當，魔術和偷竊絕對不能混為一談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000248
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000248,
					"content": "沒關係，我並不介意，只是想藉機改變一下大家對魔術師的刻板印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000249
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000249,
					"content": "塞薩爾死後，民眾常常會把魔術師和怪盜關聯在一起，讓我很苦惱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000250
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000250,
					"content": "原來是這樣。說回剛剛的魔術，我其實有個疑問，林尼先生懂「花語」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000251
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000251,
					"content": "我看別的魔術師在表演有關花的魔術時，通常都會選用「虹彩薔薇」，因為虹彩薔薇象徵著「熱情」與「美好的相遇」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000252
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000252,
					"content": "但林尼先生用的卻是「柔燈鈴」。在我的印象中，柔燈鈴通常意味著「分別」，林尼先生選用它是有什麼特別的深意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000253
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000253,
					"content": "不愧是知名記者，真敏銳。我對花語沒什麼研究，用柔燈鈴來變魔術只是一種習慣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000254
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000254,
					"content": "改天我去買一本《楓丹花語大全》，好好研究一下。現在暫時沒有時間，我要開始調查怪盜貂的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000255
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000255,
					"content": "好的，那採訪就到此結束，期待林尼先生與傳聞中怪盜的終極對決！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000256
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000256,
					"content": "如果有什麼進展的話，可以隨時聯絡我。三天後我也會到現場去看林尼先生的魔術秀，希望怪盜貂那時候已經落網。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000257
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000257,
					"content": "我先走啦！剛剛的採訪已經足夠我寫一篇獨家新聞了，時間不等人，越快發表越好。回頭見各位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000258
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140000258,
					"content": "林尼，你還沒告訴我們呢，剛剛的魔術到底是怎麼變的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000259
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000259,
					"content": "這個嘛…保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000260
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000260,
					"content": "唔…我也知道魔術的秘密很重要，不過搞不清楚的話，總覺得心裡好像有貓在抓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000261
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000261,
					"content": "#{NICKNAME}，{F#妳}{M#你}也這麼想吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000262,
						140000263
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000262,
					"content": "怪盜貂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140000264
					]
				},
				{
					"id": 140000264,
					"content": "#看來{F#妳}{M#你}更在意怪盜貂的事情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000265
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000265,
					"content": "既然這樣，要不要當我的「臨時魔術助手」，和我一起調查？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000266
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000266,
					"content": "「臨時魔術助手」？聽起來還不錯，好像我們也變成魔術師啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000267
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000267,
					"content": "#而且這也是一個從他身上挖出秘密的好機會，{F#妳}{M#你}覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000268,
						140000270
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140000268,
					"content": "一起調查吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140000269
					]
				},
				{
					"id": 140000269,
					"content": "#太好了，感謝{F#妳}{M#你}們的信任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000271
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000271,
					"content": "目前最重要的是搞清楚塞薩爾的真實身分。如果他是怪盜貂的話，那怪盜貂已死，這次發預告函的就只是模仿犯而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000272
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000272,
					"content": "如果他不是怪盜貂的話…那就有意思了，表示真正的怪盜貂還活著，這十年來他一直銷聲匿跡，潛伏在楓丹的某個角落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000273
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000273,
					"content": "想要調查塞薩爾，可以從他的未婚妻嘉瑪入手。我聽說嘉瑪經常去墓園，所以提前讓琳妮特在那裡等她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140000274
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000274,
					"content": "時間差不多到了，我們去墓園找琳妮特會合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				},
				{
					"id": 140000270,
					"content": "林尼有什麼計畫嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140000271
					]
				},
				{
					"id": 140000263,
					"content": "真的沒問題嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140000264
					]
				}
			]
		},
