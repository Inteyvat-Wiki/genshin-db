			"dialogs": [
				{
					"id": 762260101,
					"content": "梅拉快看，我們把你的畫都找回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260102,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260103
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 762260103,
					"content": "嘿嘿，不用客氣啦。畢竟這些畫還有我們的功勞呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260104,
					"content": "派蒙什麼時候聽得懂梅拉的話了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260105
					]
				},
				{
					"id": 762260105,
					"content": "#哎呀，我都和{F#妳}{M#你}一起去了好幾次銀月之庭了，聽得懂梅拉的意思也不奇怪吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260106,
					"content": "那梅拉說畫是怎麼弄丟的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260107
					]
				},
				{
					"id": 762260107,
					"content": "呃…這個…我理解一下哦…梅拉說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260108,
					"content": "可能是其他月靈偷走的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260109,
					"content": "嗯…也可能是月亮上那些神奇的運輸機關偷走的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260110,
					"content": "嗯…還可能是哥倫比婭偷走的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260111,
					"content": "這個絕對不可能吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260112
					]
				},
				{
					"id": 762260112,
					"content": "欸？對哦…難道我理解錯了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260113,
					"content": "原來只是連矇帶猜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762260114
					]
				},
				{
					"id": 762260114,
					"content": "哼哼，學習外語哪有那麼容易啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260115,
					"content": "我需要一個好老師，等有機會，我要請哥倫比婭好好教教我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
