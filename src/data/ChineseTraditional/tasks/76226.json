			"dialogs": [
				{
					"id": 762260201,
					"content": "欸？這不是梅拉嗎？居然在月亮上碰面了，真是意想不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260202,
					"content": "一定是哥倫比婭帶你來的吧？畢竟她說過要帶你來月亮上辦畫展呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260203,
					"content": "對了，說到畫展…你的畫呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762260204,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260205
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 762260205,
					"content": "怎麼了？難道…畫弄丟了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762260206
					],
					"speakerTitle": "派蒙"
				},
				{
