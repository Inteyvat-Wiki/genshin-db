						],
						"pointId": 244
					}
				]
			},
			"dialogs": [
				{
					"id": 762140201,
					"content": "#…喵。{F#妳}{M#你}的劍技…令貓印象深刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140209
					],
					"speakerTitle": "「橘貓小姐」"
				},
				{
					"id": 762140209,
					"content": "#感謝{F#妳}{M#你}，可敬的異邦騎士。那些高傲而強大的凶惡之徒不會再侵擾我子民的家園了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140210
					],
					"speakerTitle": "「橘貓小姐」"
				},
				{
					"id": 762140210,
					"content": "那麼，請說吧——閣下為何來到我的王庭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140202,
						762140204
					],
					"speakerTitle": "「橘貓小姐」"
				},
				{
					"id": 762140202,
					"content": "王庭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140203
					]
				},
				{
					"id": 762140203,
					"content": "呃…既然是童話，那這個應該也是設定的一部分吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762140206,
					"content": "向橘貓小姐轉達了灰貓先生的茶會邀請…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140207
					]
				},
				{
					"id": 762140207,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140208
					],
					"speakerTitle": "「橘貓小姐」"
				},
				{
					"id": 762140208,
					"content": "#…我知道了。謝謝{F#妳}{M#你}，可敬的異邦騎士。那麼，我便聽從{F#妳}{M#你}的良言，動身前往吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「橘貓小姐」"
				},
				{
					"id": 762140204,
					"content": "王上啊，讓我來報告…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140205
					]
				},
				{
					"id": 762140205,
					"content": "入戲好快！咳咳，既然是設定的一部分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140206
					],
					"speakerTitle": "派蒙"
				}
			]
		},
