			},
			"dialogs": [
				{
					"id": 762140301,
					"content": "#嗚汪？怎麼了，黃金的旅人{M#先生}{F#小姐}？有什麼我可以幫您做的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140302
					],
					"speakerTitle": "「淑女犬小姐」"
				},
				{
					"id": 762140302,
					"content": "向淑女犬小姐轉達了灰貓先生的茶會邀請…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						762140303
					]
				},
				{
					"id": 762140303,
					"content": "欸？原來已經到這個時間了嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140304
					],
					"speakerTitle": "「淑女犬小姐」"
				},
				{
					"id": 762140304,
					"content": "謝謝您！嗚汪，要不是太忙，我就親自去邀請橘貓小姐了…那樣的話，灰貓先生說不定也不會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140305
					],
					"speakerTitle": "「淑女犬小姐」"
				},
				{
					"id": 762140305,
					"content": "無論是貓還是狗，大家都是可以和平共處的…一定可以的。總之，我現在就去參加茶會啦，謝謝您提醒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「淑女犬小姐」"
				}
			]
		},
