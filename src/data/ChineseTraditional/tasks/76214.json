			},
			"dialogs": [
				{
					"id": 762140101,
					"content": "喵嗚…已經是茶會的時間了喵，她們會不會迷路了喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140102
					],
					"speakerTitle": "「灰貓先生」"
				},
				{
					"id": 762140102,
					"content": "#啊，黃金的旅人{M#先生}{F#小姐}，您一定是被選中的勇者喵！可以請您幫我找找看我的兩位朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140103,
						762140104
					],
					"speakerTitle": "「灰貓先生」"
				},
				{
					"id": 762140103,
					"content": "你的朋友是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140106
					]
				},
				{
					"id": 762140106,
					"content": "還沒有到場的兩位小姐，一位是和我一樣會說話的貓，不過是橘色的喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140107
					],
					"speakerTitle": "「灰貓先生」"
				},
				{
					"id": 762140107,
					"content": "另一位則是很有禮貌的淑女犬，雖然是犬類，但是很溫柔喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140108
					],
					"speakerTitle": "「灰貓先生」"
				},
				{
					"id": 762140108,
					"content": "就算一方是貓，一方是狗，只要能坐在一起喝茶，大家就一定會很開心喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140109
					],
					"speakerTitle": "「灰貓先生」"
				},
				{
					"id": 762140109,
					"content": "為了喵嗚蘭諾珀里斯的和平，請您幫幫我喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「灰貓先生」"
				},
				{
					"id": 762140104,
					"content": "勇者的標準好隨便！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762140105
					]
				},
				{
					"id": 762140105,
					"content": "不要在意那種細節喵。就算沒有傳說中的聖劍，就算沒有找到傳說中的純水之杯，勇者也是勇者喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762140106
					],
					"speakerTitle": "「灰貓先生」"
				}
			]
		},
		{
			"id": 7621402,
