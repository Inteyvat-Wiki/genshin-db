				"points": []
			},
			"dialogs": [
				{
					"id": 120190101,
					"content": "怎麼了，還想聊點什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190102,
						120190105,
						120190109,
						120190113
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190102,
					"content": "關於「糰子牛奶」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190103
					]
				},
				{
					"id": 120190103,
					"content": "她絕對特別喜歡那個飲料，我猜她心裡都開心到開花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190104
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190104,
					"content": "她的潛臺詞就是，「快，把這個鋪子開到我的『一心淨土』裡去！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190105,
					"content": "關於「雷電將軍」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190106
					]
				},
				{
					"id": 120190106,
					"content": "那個人偶是吧，修改人偶的規則很困難，這個我也聽說過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190107,
					"content": "#這種困難可能是史無前例的，{F#妳}{M#你}們可以想像一下，能讓神武英明的影也感到困難的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190108
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190108,
					"content": "「無想的一刀」也不能解決的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190109,
					"content": "關於「輕小說」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120190110
					]
				},
				{
					"id": 120190110,
					"content": "轉生成為雷電將軍，不是很有趣的想法嗎？輕小說只要有趣就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190111,
					"content": "但對她來說，嗯，有點太前衛了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190112
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190112,
					"content": "唔，下次要不要以「轉生為八重宮司」為題材徵稿呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120190101
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120190113,
					"content": "沒什麼了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}