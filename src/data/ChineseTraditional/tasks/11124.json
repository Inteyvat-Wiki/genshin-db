				"points": []
			},
			"dialogs": [
				{
					"id": 111240101,
					"content": "此碑由理水疊山真君所立。碑文中稱若陀為惡龍，是為提醒後人遠離這處封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240102
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111240102,
					"content": "可惜…善與惡只隔一線。若他的善惡是可以簡單說清的事，倒也罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240103
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111240103,
					"content": "（靜靜注視立在樹下的鍾離…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111240104
					]
				},
				{
					"id": 111240104,
					"content": "（寂靜中，惟聞風聲颯颯。時間彷彿化作無形的河流，自身旁靜靜淌過…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111240105
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 111240105,
					"content": "（浮光一瞬，人間千年。岩石有心，大地與神明亦然。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
