					"nextDialogs": [
						200260202
					]
				},
				{
					"id": 200260202,
					"content": "這下子材料就夠了，稍等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260203
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260203,
					"content": "#好啦，拜託{F#妳}{M#你}把這份特製的<color=#00E1FFFF>炸蘿蔔丸子</color>送給厄尼斯特先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260204
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260204,
					"content": "#別這麼看著我嘛，我知道{F#妳}{M#你}肚子很餓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260205
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260205,
					"content": "#回來的時候，我會用獵鹿人餐館特製料理來答謝{F#妳}{M#你}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		},
