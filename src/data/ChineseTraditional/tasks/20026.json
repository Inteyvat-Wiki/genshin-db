					"nextDialogs": [
						200260404
					]
				},
				{
					"id": 200260404,
					"content": "我看看…沒錯，太感謝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260405
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260405,
					"content": "#還有，這份<color=#00E1FFFF>蟹黃火腿焗時蔬</color>給{F#妳}{M#你}，剛剛做好的，趕快趁熱吃了吧。",
