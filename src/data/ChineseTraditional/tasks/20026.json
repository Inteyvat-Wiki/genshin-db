				"points": []
			},
			"dialogs": [
				{
					"id": 200260101,
					"content": "餐品外送訂單",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260102
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260102,
					"content": "#旅行者，{F#妳}{M#你}來得正好——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260103
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260103,
					"content": "#咦？{F#妳}{M#你}說{F#妳}{M#你}只是來吃東西的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260104
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260104,
					"content": "#我，我知道了，但是請{F#妳}{M#你}幫我個忙吧，我一定會把最好吃的料理給{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260105
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260105,
					"content": "晨曦酒莊的厄尼斯特先生經常在我們這裡訂下酒菜，而且總是會提出各種奇怪的加料要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260106
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260106,
					"content": "嗯…這次他雖然訂的是<color=#00E1FFFF>炸蘿蔔丸子</color>，但他一定要我們多加蛋類，可是我們的蛋類料理材料都用光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260107
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260107,
					"content": "#所以，請{F#妳}{M#你}幫我們找兩顆鳥蛋回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260108,
						200260111
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260108,
					"content": "好吧，但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260109
					]
				},
				{
					"id": 200260109,
					"content": "在風起地，應該可以找到很多鳥蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260110
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260110,
					"content": "#那麼，就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260111,
					"content": "太餓了，我只是來吃飯的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200260112
					]
				},
				{
					"id": 200260112,
					"content": "在風起地，應該可以找到很多鳥蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200260113
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200260113,
					"content": "#等{F#妳}{M#你}幫完我的忙之後，我，我就請{F#妳}{M#你}吃獵鹿人特製料理，就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		},
