			"dialogs": [
				{
					"id": 400030701,
					"content": "果然，那個是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030702,
						400030703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030702,
					"content": "要追上去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030704
					]
				},
				{
					"id": 400030704,
					"content": "等一等，似乎還有人——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030703,
					"content": "追上去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030704
					]
				}
			]
		},
		{
			"id": 4000309,
