			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘉毅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030201,
					"content": "你們…哦，對了，是昨天來提醒險情的二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030202
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 400030202,
					"content": "唉…實不相瞞，海燈節期間，總務司事務繁雜，暫時抽不出人手來調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030203
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 400030203,
					"content": "欸？怎麼這樣——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030204,
					"content": "真對不起，難得你們這麼熱心提供情報…容我想想…也許…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030205
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 400030205,
					"content": "也許，我們有一個小隊能幫上忙。他們手上的任務，今天只剩最後一個了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030206
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 400030206,
					"content": "他們在歸離原清剿怪物，如果你們能聯絡上他們的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉毅"
				}
			]
		},
		{
			"id": 4000304,
			"completionStepIds": [
				4000304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4000304",
							"2"
						],
						"stepId": 4000304,
						"stateName": "QUEST_STATE_UNFINISHED"
