			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"星火"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030401,
					"content": "好了，這裡的怪物痕跡已經調查完畢，該收工了——嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030402
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030402,
					"content": "你們是什麼人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030403
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030403,
					"content": "是嘉義要我們來找你的，他說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030404,
					"content": "原來如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030405
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030405,
					"content": "感謝你們對總務司工作的支援，這件事我們記下了，很快就會提上日程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030406
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030406,
					"content": "那麼，我們在璃月港有緣再見吧，熱心的旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030407
					],
					"speakerTitle": "星火"
				},
				{
					"id": 400030407,
					"content": "#{NICKNAME}，{F#妳}{M#你}有沒有覺得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030408,
						400030413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030408,
					"content": "總務司的態度有點隨便。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030409
					]
				},
				{
					"id": 400030409,
					"content": "派蒙我也這麼認為！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030410,
					"content": "本地人大概習慣了那些好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030411,
					"content": "但流落荒野、在最慘的時候只能吃奇怪蘑菇維持生活的旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030412,
					"content": "#對{F#妳}{M#你}來說，海燈節，意，義，非，凡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030416,
					"content": "所以我們再去昨天目擊的地點看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030417,
					"content": "聽巡捕大爺說，罪犯都喜歡回案發地點看看。罪犯的心理就是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030418,
					"content": "還沒「案發」呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030419
					]
				},
				{
					"id": 400030419,
					"content": "所以說要把握時間啊，如果易燃物被人動了手腳，那案發了一切就都晚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030413,
					"content": "還是需要我們來解決問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030414
					]
				},
				{
					"id": 400030414,
					"content": "我也這麼認為！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030415,
					"content": "根據我們四處冒險的經驗，這件事還是負責到底比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030416
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4000307,
			"completionStepIds": [
				4000307
			],
