			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400030901,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030902,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030903
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030903,
					"content": "#{NICKNAME}，怎麼辦，這個人看起來很難溝通的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030904,
					"content": "嗚啊。感、感覺，並不是善人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030905,
					"content": "不要只依靠感覺，就對「善惡」隨口評說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030906
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030906,
					"content": "不過，我確實是惡鬼。我是斬殺妖物、魔障的護法夜叉，魈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030907
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030908,
					"content": "這個名詞前兩天好像聽過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030909,
					"content": "派蒙知道「夜叉」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400030910
					]
				},
				{
					"id": 400030907,
					"content": "護法夜叉…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030908,
						400030909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030910,
					"content": "對、對了…之前有聽璃月的人說過…夜叉也是守護璃月的仙人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030911,
					"content": "暗中鎮守人類的世界，為不知情的凡人斬妖除魔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030912
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030912,
					"content": "一般意義上，這不就是叫做善人嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030913,
					"content": "…不。夜叉的「護法」，並不出於對人類的善意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030914
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030914,
					"content": "嗚…明明海燈節的主題，就是紀念英雄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030915,
					"content": "歷史上護佑璃月的那些英雄，難得有一個活到現在的，卻對紀念自己的節日不領情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030916,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030917
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030917,
					"content": "魈先生…呃，魈上仙…？為什麼你剛才不直接制伏那個可疑的傢伙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400030918,
					"content": "本以為是妖物作祟，我才過來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030919
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030919,
					"content": "如果在仙與魔的世界，有什麼東西失去桎梏，那就是我的責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030920
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030920,
					"content": "#但這次的威脅來自人類的世界——你們的世界，所以這是{F#妳}{M#你}的責任，人類旅者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400030921
					],
					"speakerTitle": "魈"
				},
				{
					"id": 400030921,
