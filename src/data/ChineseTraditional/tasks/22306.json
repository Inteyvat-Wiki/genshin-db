				"objectNames": [
					"博來"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223060301,
					"content": "幫我標上吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223060302
					]
				},
				{
					"id": 223060302,
					"content": "好，我現在就把地方幫您標好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223060303
					],
					"speakerTitle": "博來"
				},
				{
					"id": 223060303,
					"content": "您走好，拿到寶藏之後，記得拿回來我們一起分啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博來"
				}
			]
		},
