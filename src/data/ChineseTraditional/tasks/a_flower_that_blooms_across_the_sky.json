				"points": []
			},
			"dialogs": [
				{
					"id": 130320101,
					"content": "我剛剛就想問了，準備是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320102,
					"content": "那菈艾文還沒有完全想起來，回憶與夢想，都不可或缺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320103
					],
					"speakerTitle": "蘭浮婆"
				},
				{
					"id": 130320103,
					"content": "夢想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320104
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320104,
					"content": "可是我，再也站不起來了。就算是恢復，也不知道能不能好，需要多久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320105
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320105,
					"content": "不需要有這樣的擔心。那菈艾文要記住，夢想關聯的是妳的心，而不是身體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320106
					],
					"speakerTitle": "蘭浮婆"
				},
				{
					"id": 130320106,
					"content": "心…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320107
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320107,
					"content": "老身就送到這裡了。寶貴的東西，就靠那菈艾文自己去找回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320108
					],
					"speakerTitle": "蘭浮婆"
				},
				{
					"id": 130320108,
					"content": "欸？他就這樣不見了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320109
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320109,
					"content": "周圍的天色，好像也有點改變了的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320110
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320110,
					"content": "心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320111
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320111,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320112
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320112,
					"content": "欸——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320113,
					"content": "我…站起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320114
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320114,
					"content": "毫不費力，也沒有奇怪的感覺，一切都和生病之前一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320115
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320115,
					"content": "喂，難道說我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320116,
					"content": "進入夢裡了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320117
					]
				},
				{
					"id": 130320117,
					"content": "嗯，之前也有過這種事，怪不得他說不需要擔心，在夢裡艾文就是可以自由活動的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320118,
					"content": "#{F#妳}{M#你}們看，我站起來了！嘿嘿，我站起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320119
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320119,
					"content": "那不是太好了嘛，這樣我們就能一起去找蘭莎妮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320120
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320120,
					"content": "我們來賽跑吧，正好也讓我看看妳究竟有多麼厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320121
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320121,
					"content": "我可能還沒恢復好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320122
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320122,
					"content": "算了，不管了，來跑吧！就算是大人我也完全不害怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320123
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320123,
					"content": "啊，跑出去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320124,
					"content": "沒想到這麼順利，還以為她需要再適應適應呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320125,
						130320126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320125,
					"content": "這就是天賦吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				},
				{
					"id": 130320127,
					"content": "嘿嘿，是啊，我們也追上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320126,
					"content": "這就是願望吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320127
					]
				}
			]
		},
