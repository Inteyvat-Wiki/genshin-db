			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宵宮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320901,
					"content": "唔…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320902,
					"content": "怎麼就醒過來了，我還沒看夠呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320903,
					"content": "我們用願望召喚出的流星，居然是從地上飛出來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320904
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320904,
					"content": "這不是和煙花一模一樣嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320905
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320905,
					"content": "——意猶未盡、意猶未盡啊！這真是我做過的最真實、最豪華、最浪漫的一場夢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320906
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320906,
					"content": "我也是，不過我真沒想到，妳會直接帶著我們跳上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320907,
					"content": "嘿嘿，其實我也沒想太多，只是覺得不趁機胡鬧一次，那就太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320908,
						130320909
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320908,
					"content": "宵宮，妳其實…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320909,
					"content": "早就意識到是夢了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320910
					]
				},
				{
					"id": 130320910,
					"content": "妳知道我的，是不是夢之類的問題，我完全不在乎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320911
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320911,
					"content": "#但我還是要感謝{F#妳}{M#你}們，這一切都是{F#妳}{M#你}們知道了流星雨沒那麼容易看到，所以才準備的替代方案吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320912
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320912,
					"content": "我很喜歡哦，非常非常喜歡，就算在我收到過的所有禮物裡排名，都是最好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320913
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320913,
					"content": "那就好、就好，我還擔心和妳解釋了真相，妳會生氣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320914
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320914,
					"content": "怎麼會呢？我夢見了樂於助人、性格友善、可可愛愛的蘭那羅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320915
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320915,
					"content": "還夢見了我們在一堆大蘑菇中到處跑到處飛，用意料之外的方式找到了「蒼松石」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320916
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320916,
					"content": "原本以為醒過來了，接下來的事情卻更加了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320917
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320917,
					"content": "艾文從心口取出了「蒼松石」變成的眼鏡，我們一起找到了從地上飛起來的流星，成為了流星的一部分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320918,
						130320919
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320918,
					"content": "我們一直都在夢中。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320919,
					"content": "我們從未醒來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320920
					]
				},
				{
					"id": 130320920,
					"content": "是啊，雖然夢是虛幻的，但同樣是不可複製、不可重溫的一次「經歷」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320921
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320921,
					"content": "如果拘泥於真假，那豈不是就錯過了很多美好與感動嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320922
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320922,
					"content": "嘿嘿，宵宮真會誇。我要把妳在「派蒙的好朋友」排行榜上再提高一位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320923
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320923,
					"content": "還有這種排行榜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320924
					]
				},
				{
					"id": 130320924,
					"content": "對了，說到蘭那羅，他們不願意被…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320925
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320925,
					"content": "對啊對啊，蘭那羅也好可愛，這還要多虧了那些製作精美的木刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320926
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320926,
					"content": "欸，木刻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320927,
					"content": "對啊，如果我們沒見過木刻，怎麼會夢見那種樣子的蘭那羅嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320928
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320928,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320929,
						130320930
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320929,
					"content": "宵宮明白我們的意思了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320930,
					"content": "我也覺得比木刻更可愛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320931
					]
				},
				{
					"id": 130320931,
					"content": "嘻嘻，放心啦，我懂的。我覺得他們的形象很可愛，我很樂意保護他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320932
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320932,
					"content": "好了，時間也差不多了，該送她回家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321101,
					"content": "將艾文送回了家，又和宵宮在須彌逗留了幾天。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130321102
					]
				}
			]
		},
