			"dialogs": [
				{
					"id": 130320201,
					"content": "哈啊，哈啊，還是姐姐比較厲害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320202
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320202,
					"content": "嘿嘿，距離長一點還真不好說，我還以為我會被追上呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320203
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320203,
					"content": "艾文好像完全不落下風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320204,
					"content": "我以前也跑贏過很多大人，腿長可不一定跑得就快，鍛煉也很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320205
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320205,
					"content": "再過幾年，我就不是對手啦，哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320206
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320206,
					"content": "唔，我看看，接下來應該往哪個方向走呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320207
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320207,
					"content": "欸，快看，前面好像有個東西飄起來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320208,
					"content": "像是…星星？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320209
					]
				},
				{
					"id": 130320209,
					"content": "難道是要我們跟上去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320210
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320210,
					"content": "嗯，有可能，跟上去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
