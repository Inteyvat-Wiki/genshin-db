			"dialogs": [
				{
					"id": 130321105,
					"content": "須彌真是個好地方，下次我還要來玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321106
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321106,
					"content": "隨時歡迎妳過來，艾文也會很開心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321107
					],
					"speakerTitle": "妮歐莎"
				},
				{
					"id": 130321107,
					"content": "一言為定哦，我會一直等妳過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321108
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130321108,
					"content": "哈哈哈，沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321109
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321109,
					"content": "姐姐，在妳回去之前，我還想告訴妳——我有了一個新的夢想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321110
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130321110,
					"content": "我要靠自己去稻妻，見識一下稻妻的煙花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321111
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130321111,
					"content": "哦，很了不起嘛！呵呵，我也沒想到出來玩還能給家裡的煙花店拉到客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321112
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321112,
					"content": "放心吧，我會專門為妳設計一個煙花，讓妳過目不忘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321113
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321113,
					"content": "#{F#妳}{M#你}們也是，不管冒險再忙，也要常來稻妻看看，無論什麼時候，大家都很歡迎{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321114
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321114,
					"content": "#這次旅行的成果，說什麼也要在{F#妳}{M#你}們的見證之下，讓它升上天空！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321115
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321115,
					"content": "好的，一言為定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321116,
						130321118,
						130321120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130321116,
					"content": "路上保重。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321117
					]
				},
				{
					"id": 130321117,
					"content": "#會的會的，{F#妳}{M#你}還是這麼穩重，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321122,
					"content": "#對了對了，{F#妳}{M#你}看這是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321123
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321123,
					"content": "蘭那羅木刻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321124
					]
				},
				{
					"id": 130321124,
					"content": "#對哦，是{F#妳}{M#你}幫我挑的那個款式，{F#妳}{M#你}和派蒙都說覺得有點像我。剛剛我也去買了一個，送給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321125
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321125,
					"content": "#不開心的時候就看看這個，說不定就能讓{F#妳}{M#你}打起精神，覺得至少還有我在支持{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321126
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321126,
					"content": "當然，最好還是來見我本人啦，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321127,
						130321128
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321127,
					"content": "謝謝妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321129,
					"content": "嗯，那我回去啦，我相信我們很快又能再見的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321130
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321130,
					"content": "#我很喜歡{F#妳}{M#你}們為我準備的旅行，嗯，不如說，是很欽佩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321131
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321131,
					"content": "#這份友善與溫柔，無論{F#妳}{M#你}們走到哪裡，都會成為在背後支撐{F#妳}{M#你}們的強大力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321132
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321132,
					"content": "就像這樣，走到旅途的終點、世界的盡頭吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321133
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321133,
					"content": "再見囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321128,
					"content": "我會珍惜的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321129
					]
				},
				{
					"id": 130321118,
					"content": "天天開心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321119
					]
				},
				{
					"id": 130321119,
					"content": "天天開心，永遠開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130321120,
					"content": "煙花易逝，人情長存！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130321121
					]
				},
				{
					"id": 130321121,
					"content": "#{F#妳}{M#你}、{F#妳}{M#你}突然喊出來幹什麼啦，怪不好意思的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130321122
					],
					"speakerTitle": "宵宮"
				}
			]
