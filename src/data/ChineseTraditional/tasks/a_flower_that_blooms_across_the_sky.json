			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾文",
					"宵宮",
					"蘭莎妮",
					"蘭浮婆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130320601,
					"content": "這、這是…結束了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320602
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320602,
					"content": "做了個非常非常好的夢啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320603
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320603,
					"content": "不用露出寂寞的表情哦，他就在妳的旁邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320604
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320604,
					"content": "蘭莎妮！太好了，你還在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320605
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320605,
					"content": "蘭莎妮想道歉，不是蘭莎妮不想去找那菈，只是蘭莎妮記不清時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320606
					],
					"speakerTitle": "蘭莎妮"
				},
				{
					"id": 130320606,
					"content": "蘭莎妮不敢去城裡，沒見到那菈，蘭莎妮以為那菈艾文交到了新的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320607
					],
					"speakerTitle": "蘭莎妮"
				},
				{
					"id": 130320607,
					"content": "這是常有的事，也是沒辦法的事，並不是遺憾的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320608
					],
					"speakerTitle": "蘭浮婆"
				},
				{
					"id": 130320608,
					"content": "沒關係，我明白，都是因為我沒能振作起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320609
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320609,
					"content": "但是現在我已經想明白了，姐姐說得很對，壞運氣誰都會遇到，重要的是互相扶持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320610
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320610,
					"content": "謝謝大家的幫助，我不會辜負大家幫我找回的記憶和夢想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320611
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320611,
					"content": "嘿嘿，妳也幫了姐姐很多哦，不用客氣。本來我們對「蒼松石」還一頭霧水呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320612
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320612,
					"content": "按現在這樣的方向，我覺得我們也很快就能找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320613
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320613,
					"content": "姐姐是想看一場流星雨對吧，是因為這個需要「蒼松石」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320614
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320614,
					"content": "嗯，對了，到時候我們找到了，妳也來一起看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320615
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320615,
					"content": "如果是這樣的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320616
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320616,
					"content": "我願意把「蒼松石」借給妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320617
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320617,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320618,
					"content": "這、這是怎麼回事啊？從胸口裡拿出了一個…眼鏡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130320619,
					"content": "我也不知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130320620
					]
				},
				{
					"id": 130320620,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320621
					],
					"speakerTitle": "蘭浮婆"
				},
				{
					"id": 130320621,
					"content": "哈哈哈，妳怎麼知道我需要這個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320622
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320622,
					"content": "我也不知道，我只是覺得妳幫我找回來了最好的朋友，我也要用最珍貴的東西幫妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320623
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320623,
					"content": "然後光就變成了這個樣子，這是妳需要的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320624
					],
					"speakerTitle": "艾文"
				},
				{
					"id": 130320624,
					"content": "謝謝妳，沒想到這樣就解決了，那我現在就試試看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320625
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320625,
					"content": "雖然不太清楚用法，姑且就憑直覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320626
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320626,
					"content": "在哪裡呢、在哪裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320627
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320627,
					"content": "哦！我好像看到了，還滿明顯的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320628
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320628,
					"content": "走吧，我來帶路。我們看完流星雨之後再送妳回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320629
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320629,
					"content": "也謝謝你願意幫我們，客套的話就不多說了，我有一句由衷的誇獎——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320630
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320630,
					"content": "你們真的很會講故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130320631
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 130320631,
					"content": "哎呀，真是巧合。老身對妳也有相同的評價，紅色的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭浮婆"
				}
			]
		},
