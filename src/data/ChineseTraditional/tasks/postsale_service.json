			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瓦希德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220370101,
					"content": "糟了…怎麼會這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370102
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370103
					]
				},
				{
					"id": 220370103,
					"content": "#旅行者，我正在找{F#妳}{M#你}呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370104
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370104,
					"content": "#{F#妳}{M#你}還記得紺田傳助這個顧客嗎？他前幾天來過店裡，問了問關於肥料的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370105
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370105,
					"content": "他對肥料還滿意嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370106
					]
				},
				{
					"id": 220370106,
					"content": "滿意不滿意的…倒也不能這麼說，嚴格來說，我覺得紺田傳助先生應該是「迷茫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370107
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370107,
					"content": "迷茫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370108
					]
				},
				{
					"id": 220370108,
					"content": "#呃是這樣的，{F#妳}{M#你}上次去宣傳了之後，紺田先生確實也按照{F#妳}{M#你}說的方法施用了我們的肥料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370109
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370109,
					"content": "但是，雖然這之後莊稼確實長了起來，但同時…地裡還莫名其妙地冒了大量的蘑菇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370110
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370110,
					"content": "紺田先生來說了之後，說實話，我也有點茫然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370111
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370111,
					"content": "但不管怎麼樣，這種情況應該和施用在地裡的肥料脫不開關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370112
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370112,
					"content": "#旅行者，能拜託{F#妳}{M#你}再去紺田村一趟，幫紺田先生清理一下田裡的那些蘑菇嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370113,
						220370116
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370113,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370114
					]
				},
				{
					"id": 220370114,
					"content": "#那就拜託{F#妳}{M#你}了，我要在店裡再查一下資料，看看到底是什麼原因導致了這個情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370115
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370115,
					"content": "唉，要是愛拉尼在這裡就好了，她肯定能很快找出原因來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370116,
					"content": "不如讓愛拉尼研究一下這問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370117
					]
				},
				{
					"id": 220370117,
					"content": "如果她在的話，肯定能很快找出原因來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370118
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370118,
					"content": "但是她到現在還沒回來，不知道到底去了哪裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370119
					],
					"speakerTitle": "瓦希德"
				},
				{
					"id": 220370119,
					"content": "#只能拜託{F#妳}{M#你}了，旅行者，我要在店裡再查一下資料，看看到底是什麼原因導致了這個情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦希德"
				}
			]
		},
