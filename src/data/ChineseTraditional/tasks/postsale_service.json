			},
			"dialogs": [
				{
					"id": 220370301,
					"content": "#{F#妳}{M#你}都摘乾淨了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370302
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 220370302,
					"content": "摘來的蘑菇都在這裡了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370303
					]
				},
				{
					"id": 220370303,
					"content": "只有這些嗎？我印象裡，地裡長出的蘑菇不止這些啊，是不是沒摘乾淨啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370304
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 220370304,
					"content": "#但無論如何我都要謝謝{F#妳}{M#你}，年輕人。這些東西給{F#妳}{M#你}，就當做是報酬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370305
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 220370305,
					"content": "不過，這肥料還真是厲害啊，居然能讓蘑菇長這麼快，要是莊稼也能長這麼快就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370306
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 220370306,
					"content": "等我有空了之後，一定要再買點回來試試…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紺田傳助"
				}
			]
		},
