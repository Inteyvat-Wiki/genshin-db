			"dialogs": [
				{
					"id": 220370201,
					"content": "這些蘑菇到底是怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370202,
						220370203
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 220370202,
					"content": "我來清理蘑菇了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370205
					]
				},
				{
					"id": 220370205,
					"content": "#{F#妳}{M#你}這次是從瓦希德先生那邊過來，幫我清理蘑菇的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370206
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 220370206,
					"content": "#唔，那就拜託{F#妳}{M#你}了，那些田裡的蘑菇實在是太多了，我這把老骨頭可摘不完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370207
					],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 220370207,
					"content": "這些蘑菇，怎麼長得這麼快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紺田傳助"
				},
				{
					"id": 220370203,
					"content": "對不起，給您添蘑菇了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220370204
					]
				},
				{
					"id": 220370204,
					"content": "添蘑菇？呃，我家的餐桌上可不太缺蘑菇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220370205
					],
					"speakerTitle": "紺田傳助"
				}
			]
		},
