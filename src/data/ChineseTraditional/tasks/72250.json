			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賀摩",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722500101,
					"content": "啊！救、救命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500102
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500102,
					"content": "小人聽說最近大人們疲於應付須婆達之彥領導的反叛，大日御輿防衛空虛，才動了不該動的歪念頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500103
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500103,
					"content": "看在小人上有重疾老母需要贍養，下有十二個出於愛心拉扯大的孤兒的份上！還請守備大人高抬一手，把小人當個屁，就放了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500104
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500104,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722500105
					]
				},
				{
					"id": 722500105,
					"content": "咦，嗐，什麼呀，原來不是大日御輿的守衛啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500106
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500106,
					"content": "#看{F#妳}{M#你}這奇裝異服的…不會是從什麼奇怪地方來的同行吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500107
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500107,
					"content": "什麼同行不同行的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722500108,
					"content": "都到這裡了還裝什麼呀，唉，真是出師不利，好不容易進入大日御輿，大肆搜刮了一把，卻被機關困住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500109
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500109,
					"content": "看來今日不宜…不宜行劫富濟貧的義舉之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500110
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500110,
					"content": "哼，小偷就小偷，還說成是劫富濟貧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722500111,
					"content": "妳懂什麼，大人們每日聽著靡靡之音，飲酒作樂，我們這些底層人就得累死累活，為他們倒尿盆，熱草鞋，哪有這種道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500112
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500112,
					"content": "#哎對了，我跟{F#妳}{M#你}說個秘密，就當{F#妳}{M#你}們救我的回報。我之前收買了維修大日御輿的工匠，像這樣藏有財寶的房間，還有兩個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500113
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500113,
					"content": "還有兩個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722500114,
					"content": "#{NICKNAME}，我覺得我們也有必要，行、行一些劫富濟貧的義舉之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722500115,
					"content": "不過這兩個房間的位置我也不是很清楚了，畢竟那工匠也不敢再說其他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500116
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500116,
					"content": "這情報就當是賀禮吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500117
					],
					"speakerTitle": "賀摩"
				},
				{
					"id": 722500117,
					"content": "反正現在的淵下宮也沒有人在，說不定那裡有很多以前的古董呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722500118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722500118,
					"content": "#{NICKNAME}，待會我們就悄悄在周圍找找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}