				7665401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7665401",
							"2"
						],
						"stepId": 7665401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菈烏瑪"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1801.445,
							240.255,
							10364.15
						],
						"pointId": 12540
					}
				]
			},
			"dialogs": [
				{
					"id": 766540101,
					"content": "這樣就算是，把「大書庫」建好了吧。接下來是…鳥架、坐墊，還有存錢桶也要放來這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540102
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540102,
					"content": "#啊，{F#妳}{M#你}們好，{NICKNAME}和小派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540103
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540103,
					"content": "#多虧了{F#妳}{M#你}們的幫忙，書庫修護得差不多了，算是…有模有樣了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540104
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540104,
					"content": "妳剛才說的東西，是準備也要放在書庫裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540105,
					"content": "是啊。但數量太多了，我一個人可能忙不過來。我正準備拜託手藝靈巧的族人，也幫忙我一下呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540106,
						766540107
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540106,
					"content": "這些東西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540108
					]
				},
				{
					"id": 766540108,
					"content": "這間「大書庫」對所有人和動物開放。既然有給人坐的家具，自然也要給小動物們準備一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540109
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540109,
					"content": "對喔…這樣一說倒是滿有道理的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540110,
						766540111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540110,
					"content": "不對不對…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540112
					]
				},
				{
					"id": 766540112,
					"content": "這些都是我之前聽小動物們的煩惱時用的，本來想說做新的，但有些小動物念舊，我就把這些古董也拿過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540113
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540113,
					"content": "聽小動物們的煩惱？難道還要幫牠們做心理輔導？嘿嘿，聽起來就像是小動物版本的「秋沙錢湯」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540114,
						766540115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540114,
					"content": "菈烏瑪也太辛苦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540116
					]
				},
				{
					"id": 766540116,
					"content": "身為「詠月使」，這是我的職責之一，還不算辛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540117
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540117,
					"content": "況且，無論是人還是動物，的確都需要一個傾訴對象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540118
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540118,
					"content": "我一直鼓勵大家，有麻煩的話就直接來找我，不要有任何顧慮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540119
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540119,
					"content": "把心思藏在心底，並不會解決任何問題。有時候反而會讓問題更加難以處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540120,
						766540121,
						766540122
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540120,
					"content": "唔，我有點好奇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540123
					]
				},
				{
					"id": 766540123,
					"content": "這個…我還真的沒有統計過。但從感覺上來說，應該是來諮詢的小動物比較多吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540124
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540124,
					"content": "畢竟，我和人們的作息差不多，平時大家也不會在我工作的時候過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540125
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540125,
					"content": "只有在我閒下來的時候，才會有零星的人陸陸續續來向我傾訴問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540126
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540126,
					"content": "但小動物們…牠們的作息可和我們的不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540127
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540127,
					"content": "帔髦獾偶爾會在凌晨時刻拜訪，長翎䴉則常常在太陽出來後拜訪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540128
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540128,
					"content": "團雀們總是在中午成群結隊地過來，嘰嘰喳喳地說個不停。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540129
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540129,
					"content": "凜角鹿會在傍晚單獨過來，有時候會帶著一兩個朋友。入夜後，盜寶鼬偶爾會悄悄地鑽進屋子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540130
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540130,
					"content": "這不是完全沒有任何空閒嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540131,
					"content": "一整天都占滿了啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540132
					]
				},
				{
					"id": 766540132,
					"content": "是啊。有一次盜寶鼬偷走了團雀囤的松果，大概有二十隻團雀在深夜飛到了我的床頭，嘰嘰喳喳地告狀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540133
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540133,
					"content": "我還是拜託一隻剛和我聊完天的嗅嗅鼴鼠，把那隻盜寶鼬請過來，花費了很多心力，才讓牠說出了藏松果的地點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540134
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540134,
					"content": "等到大家都滿意地離開，太陽都已經升起來了。我倒頭就睡，一直到中午才醒過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540135,
						766540136
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540135,
					"content": "二十隻團雀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540137
					]
				},
				{
					"id": 766540137,
					"content": "要是我的話，絕對講到一半就會崩潰，吵著我要睡覺我要睡覺，然後用被子蓋住頭，誰的話也不聽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540138,
					"content": "大家既然都找到了我，那我就有義務為牠們排解煩惱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540139
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540139,
					"content": "而且，排解煩惱的效果很明顯。在吵完之後，團雀們依然每天都高高興興地蹦來蹦去，盜寶鼬也每天都在興沖沖地找寶物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540140
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540140,
					"content": "人們卻不像小動物們一樣直接，總是把心思藏在心底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540141
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540141,
					"content": "即使是那些找我傾訴問題的人，所說出來的…我覺得也不是真正困擾他們內心的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540142
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540142,
					"content": "…或許，是他們不願說出…或者面對那些真正的問題吧。畢竟，在那個以人為主的社會裡，人們總是習慣將真心偽裝起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540143
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540143,
					"content": "就像是習慣於躲藏在枯葉中的蝴蝶一般，把自己的雙翼也變成和環境一樣的枯黃色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540144
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540144,
					"content": "我也知道人世交際複雜艱深，每個人都有自己的處世之道，我不會對此多說什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540145
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540145,
					"content": "但…一直把心思藏在心底，難免會變得憂傷、憂鬱。即使我再如何勸導，也難解他們的心結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540146
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540146,
					"content": "所以我想，或許可以讓心思複雜的人，和心思直接的動物們待在一起。這樣，搞不好兩方都會有不一樣的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540147
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540147,
					"content": "於是，我才把「大書庫」改造成了現在的樣子。四面敞開，通風透氣，無論是人或動物，都可以隨時造訪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540148
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540148,
					"content": "除了大雨天要躲躲雨之外…在大部分的時間裡，大家可以和小動物們待在一起，輕鬆地看書、休息和曬太陽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540149
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540149,
					"content": "…或許，在面對這些不會說話的朋友時，人們反而願意敞開心扉，說出一些心裡話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540150
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540150,
					"content": "欸？原來妳改造書庫的時候，還有這方面的想法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540151,
					"content": "嘿嘿，聽起來很不錯呢。能抱著毛茸茸的小動物，窩在椅子上發一整天的呆，想一想就覺得很開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766540152,
						766540153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766540152,
					"content": "我也要來！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540154
					]
				},
				{
					"id": 766540154,
					"content": "#呵呵，{F#妳}{M#你}們可是幫我修繕書庫的重要幫手，「霜月之子」的書庫，隨時為{F#妳}{M#你}們敞開大門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766540153,
					"content": "幫我留一張椅子！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540154
					]
				},
				{
					"id": 766540136,
					"content": "已經感覺到耳鳴了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540137
					]
				},
				{
					"id": 766540121,
					"content": "到底是來諮詢的人多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540123
					]
				},
				{
					"id": 766540122,
					"content": "還是來諮詢的小動物多？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540123
					]
				},
				{
					"id": 766540115,
					"content": "無論是人還是動物都來找妳傾訴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540116
					]
				},
				{
					"id": 766540111,
					"content": "那存錢桶…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540112
					]
				},
				{
					"id": 766540107,
					"content": "是應該放在書庫裡的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766540108
					]
				}
			]
		}
	]
}