					"content": "沒找到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130203
					]
				},
				{
					"id": 221130203,
					"content": "請您快點吧，您把木板拿回來，我就即刻開工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
