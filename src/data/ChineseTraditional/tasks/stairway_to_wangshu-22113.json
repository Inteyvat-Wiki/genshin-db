					"content": "您拿到木板了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130302
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130302,
					"content": "拿到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130303
					]
				},
				{
					"id": 221130303,
					"content": "太好了，這些怪物真是煩人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130304
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130304,
					"content": "這些就夠了，實在是謝謝您，我這就開工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
