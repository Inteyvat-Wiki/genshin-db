			"dialogs": [
				{
					"id": 221130501,
					"content": "這下子全部都修好了，怎麼樣，我的手藝還不錯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130502
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130502,
					"content": "這樣客棧的客人們也方便多了。哈哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130503
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130503,
					"content": "對了，這些您拿好，實在是辛苦您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130504
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130504,
					"content": "您有空的話，可以多來坐坐，喝杯茶，吃點點心，我們這廚子的手藝，還是不錯的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
