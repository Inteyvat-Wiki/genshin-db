			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221130101,
					"content": "真是，壞事怎麼就接連著來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130102,
					"content": "還在修樓梯嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130103
					]
				},
				{
					"id": 221130103,
					"content": "您來得正好。上次謝謝您了，然後…這次還得麻煩您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130104,
					"content": "這斷口有點大，木板不夠用了，我又買了一批，本來是讓客棧裡的搬運工去接貨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130105,
					"content": "但是沒想到，他在路上被一群怪物襲擊，慌慌張張地跑回來，木板全都丟路上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130106,
					"content": "這個人被嚇了個好歹，把丟木板的地方指出來之後，怎麼說都不願意回去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130107
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130107,
					"content": "我思來想去，只能麻煩您了，您能幫我去把那些木板拿回來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130108,
						221130110
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130108,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130109
					]
				},
				{
					"id": 221130109,
					"content": "那就麻煩您了，我在這等著您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130110,
					"content": "這斷口這麼大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221130111
					]
				},
				{
					"id": 221130111,
					"content": "您別這麼看著我，這段不是怪物砸的，這得多大塊頭才能砸成這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130112,
					"content": "這斷口是這麼來的…客棧裡呢，曾經先後來了兩個客人，兩人之間有點私怨，之前是一追一躲，一直沒遇見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130113
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130113,
					"content": "結果，這兩位都準備在我們這客棧投宿，上樓梯的時候，互相遇見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130114
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130114,
					"content": "然後這兩位就玩了命打…打了一陣，把樓梯都打斷了這麼大一截，我去分了半天才分開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130115
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130115,
					"content": "我這個氣啊…當時就多收了他們三天房錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130116
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130116,
					"content": "好了，閒話就說到這，您快幫我把木板拿回來吧，我趕緊把這給修了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221130117
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221130117,
					"content": "要是再這麼搞一次，我也不收額外房錢了，誰砸斷的，誰給我當場修好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
