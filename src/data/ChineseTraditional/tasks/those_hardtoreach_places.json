			"trigger": {
				"objectNames": [
					"阿拉米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030101,
					"content": "唉，該怎麼辦呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030102
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030102,
					"content": "遇到什麼麻煩了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030103
					]
				},
				{
					"id": 700030103,
					"content": "風花節一到，總有人到這裡向神像獻上各種花卉，風一吹，那些花卉散落的花瓣就會飛向全城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030104
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030104,
					"content": "為了清理這些枯花，我們也花了不少力氣，但是，廣場上的花瓣和落葉我還能幫忙清理一下，吹到屋頂和城牆上的我就沒辦法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030105
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030105,
					"content": "特別是我這個膝蓋，真是越來越不行了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030106
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030106,
					"content": "我可以幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030107
					]
				},
				{
					"id": 700030107,
					"content": "#{F#妳}{M#你}願意幫忙嗎？那太好了，那些枯萎的花瓣堆很明顯，{F#妳}{M#你}爬上屋頂之後，應該很輕易就能看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿拉米"
				}
			]
		},
		{
