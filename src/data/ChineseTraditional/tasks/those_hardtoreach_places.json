			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迷路的小貓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030501,
					"content": "真的有隻小貓呢，為什麼會跑到這裡來呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700030502,
					"content": "喵…喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030503,
						700030504
					],
					"speakerTitle": "迷路的小貓"
				},
				{
					"id": 700030503,
					"content": "喵喵喵？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				},
				{
					"id": 700030505,
					"content": "喵，喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030506
					],
					"speakerTitle": "迷路的小貓"
				},
				{
					"id": 700030506,
					"content": "#嗯…我覺得牠聽不懂{F#妳}{M#你}在說什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700030507,
					"content": "還是先把牠抱下去吧，說不定阿拉米先生會知道牠的主人是誰呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700030504,
					"content": "你迷路了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030505
					]
				}
			]
		},
		{
			"id": 7000306,
			"completionStepIds": [
				7000308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7000308",
							"2"
						],
						"stepId": 7000308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿拉米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700030601,
					"content": "實在抱歉，我好像沒見到，如果真的看見的話，我應該有印象才對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030602
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030602,
					"content": "是嗎，那孩子一直很喜歡花瓣，我還以為它會追著花瓣跑到這來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030603
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700030603,
					"content": "你們是在找貓嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030604
					]
				},
				{
					"id": 700030604,
					"content": "喵…喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030605
					],
					"speakerTitle": "迷路的小貓"
				},
				{
					"id": 700030605,
					"content": "這聲音是…小蝴蝶？真是的，你跑到哪裡去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030606
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700030606,
					"content": "牠跑到屋頂上去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030607
					]
				},
				{
					"id": 700030607,
					"content": "#果然和我想的一樣…多謝{F#妳}{M#你}了。小蝴蝶總喜歡追著花瓣到處跑，在這個滿城都飄著花瓣的風花節，特別讓人頭痛，幸好有{F#妳}{M#你}幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030608
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700030608,
					"content": "#下次{F#妳}{M#你}來「貓尾酒館」的話，我可以請{F#妳}{M#你}喝一杯哦，啊，當然是不含酒精的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030609,
						700030610
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700030609,
					"content": "果然是這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				},
				{
					"id": 700030611,
					"content": "#呵呵，總之謝謝{F#妳}{M#你}了，那就晚點再見啦。祝{F#妳}{M#你}風花節快樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030612
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 700030612,
					"content": "#沒想到連貓也會被花瓣吸引，風花節還真是熱鬧…不過，還好{F#妳}{M#你}找到了牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030613
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030613,
					"content": "要是我得爬上城牆去找貓，我這膝蓋真的就吃不消了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700030614
					],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030614,
					"content": "#真是麻煩{F#妳}{M#你}了，這些謝禮請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿拉米"
				},
				{
					"id": 700030610,
					"content": "還是以後再說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700030611
					]
				}
			]
		}
	]
}