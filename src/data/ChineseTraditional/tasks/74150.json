			"dialogs": [
				{
					"id": 741500301,
					"content": "#{F#妳}{M#你}們忙完了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500302
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500302,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500303
					]
				},
				{
					"id": 741500303,
					"content": "我們都清理乾淨啦！小茉莉也餵過貓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741500304,
					"content": "伯努瓦，屋子旁邊有一堆很髒的舊箱子，那些也要一起清理掉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741500305,
					"content": "箱子？哦，那些不用，那是我用來放舊東西的雜物箱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500306
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500306,
					"content": "有些我搬到這裡來之前的家具和小東西我捨不得丟，放在屋子裡又和室內裝飾風格不搭，就堆在那裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500307
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500307,
					"content": "我幾乎不會動它們，住在這裡人的也都很守法，沒有人會偷拿的，就讓它們待在那裡就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500308
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500308,
					"content": "勒魯瓦先生、勒魯瓦先生，我有幫到你的忙了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500309
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500309,
					"content": "妳當然幫了我好大的忙，茉莉。別忘了回去代我向妳父母問好，我會更感謝妳的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500310
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500310,
					"content": "點心和零用錢我都準備好了，孩子們，過來分吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500311
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500311,
					"content": "不用不用，我不需要零用錢，我只想再摸一下娜娜，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500312
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500312,
					"content": "可以，去吧。小心牠的爪子，記得玩夠了就過來吃點心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500313
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500313,
					"content": "爸爸，您怎麼出門了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500314
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500314,
					"content": "我的孩子們不在家裡陪伴我，孤單老頭子寂寞了就出門呼吸一下新鮮空氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500315
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500315,
					"content": "莫蒂西婭，妳看，我們才走了幾天，爸爸就不高興了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500316
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500316,
					"content": "但要是爸爸知道我們這次帶了什麼禮物回來給他，他一定會原諒我們的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500317
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500317,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500318
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741500318,
					"content": "禮物？你們帶了什麼回來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500319
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500319,
					"content": "絕對是好東西，爸爸，你看了就知道。莫蒂西婭知道你喜歡又貴又漂亮的，她特別為你挑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500320
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500320,
					"content": "謝謝妳，我的女兒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500321
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500321,
					"content": "這是我應該做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500322
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741500322,
					"content": "啊對了，這兩位小客人是你們出遠門的時候，到我這裡玩的孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500323
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500323,
					"content": "#{F#妳}{M#你}們好。我父親是個和善的人，非常喜歡孩子，{F#妳}{M#你}們願意來陪伴他真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500324
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500324,
					"content": "#不過現在我和太太已經回來了，該由我們兩個接替{F#妳}{M#你}們的工作陪伴他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500325
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500325,
					"content": "你們回來了就好，快讓我看看禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500326
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500326,
					"content": "爸爸，我們回家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500327
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741500327,
					"content": "好，阿托斯，你記得給這兩個年輕人一些點心和報酬，他們幫我掃了地，還餵了娜娜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500328
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500328,
					"content": "哦，還有旁邊那個小女孩，也給她一些點心吧。我先進門了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500329
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500329,
					"content": "勒魯瓦先生，娜娜讓我摸肚皮了…欸，他不在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500330
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500330,
					"content": "妳在找我的父親嗎，小妹妹？我是他的女婿，妳可以把我想成是他的兒子就好，我叫阿托斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500331
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500331,
					"content": "我知道女婿是什麼意思，意思就是你是他女兒的丈夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500332
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500332,
					"content": "哈哈，妳懂得真多！我父親先回家了，謝謝妳陪他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500333
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500333,
					"content": "這些點心給妳，接下來有我和我太太來陪他，妳不來也沒有關係的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500334
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500334,
					"content": "早點回家吧！在外面玩這麼久，妳的家人會擔心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500335
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500335,
					"content": "不不，叔叔，我一點都不覺得麻煩，而且我和勒魯瓦先生約好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500336
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500336,
					"content": "我想他還會需要我的幫助，餵貓啊、澆樹啊之類的，可以幫得上忙我很開心！以後我還會來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500337
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500337,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500338
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500338,
					"content": "嘖，就是這樣才麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500339
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500339,
					"content": "嗯，叔叔怎麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500340
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500340,
					"content": "沒什麼。小妹妹，叔叔有件事要和妳商量…不，不是商量，有件事要請妳做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500341
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500341,
					"content": "好啊，叔叔有什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500342
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500342,
					"content": "叔叔把點心和零用錢給妳，妳以後不要再過來了好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500343
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500343,
					"content": "為什麼呢？我做錯什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500344
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500344,
					"content": "不，妳什麼都沒有做錯。只是我父親他身體一直都不是很好，最近的失眠問題也很嚴重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500345
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500345,
					"content": "為了他的身體健康考慮，我和我太太希望他可以有一個安靜的休養環境——妳能夠理解對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500346
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500346,
					"content": "勒魯瓦先生身體不好啊…我明白了，以後我多帶一點泡泡桔過來給他好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500347
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500347,
					"content": "每次我吃太多蛋糕，吃壞了肚子，爸爸都會叫我少吃甜食，多吃水果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500348
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500348,
					"content": "只要勒魯瓦先生多吃水果，他一定就會好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500349
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500349,
					"content": "唉…算了，只能這樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500350
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500350,
					"content": "#兩位年輕的朋友，{F#妳}{M#你}們的點心和報酬我來給。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500351
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500351,
					"content": "接下來，讓我把話說清楚一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500352
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500352,
					"content": "#我的態度代表了勒魯瓦家的態度，我希望{F#妳}{M#你}們以後不要再過來打擾我們的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500353
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500353,
					"content": "#我相信{F#妳}{M#你}們雖然年輕，但是聽得懂話，所以請{F#妳}{M#你}們不要特地再來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500354
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500354,
					"content": "就這樣，我先告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500355
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500355,
					"content": "為什麼不能再來啊？好奇怪，勒魯瓦先生明明脾氣很好，這個叔叔怎麼偏不讓我們來啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500356
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500356,
					"content": "對呀！這個傢伙說話滿有禮貌，但做的事情真是有夠冷漠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500357
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741500357,
					"content": "#不管這個叔叔說什麼，我過一天還是要來看勒魯瓦先生的，{F#妳}{M#你}們來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500358
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500358,
					"content": "來嘛來嘛！娜娜很可愛，我還想多摸摸牠，而且勒魯瓦先生還會給點心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500359,
						741500361
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500359,
					"content": "我們會來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500360
					]
				},
				{
					"id": 741500360,
					"content": "說好了哦！要一起過來摸貓貓，找勒魯瓦先生玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741500361,
					"content": "有空再說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741500362
					]
				},
				{
					"id": 741500362,
					"content": "好吧，那下次再見哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茉莉"
				}
			]
		},
