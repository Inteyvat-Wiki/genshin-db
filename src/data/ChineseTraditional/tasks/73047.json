			"trigger": {
				"objectNames": [
					"蘭拉迦",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730470101,
					"content": "#那菈{NICKNAME}、派蒙，又見面了。呵呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470102
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730470102,
					"content": "蘭拉迦看起來很開心呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730470103,
					"content": "呵呵呵…老身看到桓那蘭那這麼熱鬧，有這麼多蘭那羅回家了，真是太高興了。哎呀，沒想到能親身參與無憂節…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470104,
						730470105
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730470104,
					"content": "你沒參加過嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470107
					]
				},
				{
					"id": 730470107,
					"content": "老身在故事中，曾經參與過一次。那是很久很久以前的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470108
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730470108,
					"content": "老身、蘭穆護昆達、蘭拉娜、蘭拉吉…我們許許多多的蘭那羅，與那菈法留納一同，慶祝無憂節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470109
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730470109,
					"content": "那是十分艱難的時期。但是，在無憂節中，我們還是一同歡笑、歌唱。老身非常喜歡這個故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470110
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730470110,
					"content": "咦，蘭拉迦這不是參加過嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730470111,
					"content": "喔，在故事中，確實參加過。但是，老身已經不記得了。那些故事，都是蘭拉娜他們後來告訴老身的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470112
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730470112,
					"content": "嗯…感覺蘭拉迦說話像老爺爺似的，可能是因為年紀大了，記不清了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730470113,
					"content": "#或許是這樣也不錯…不管怎麼說，那菈{NICKNAME}、派蒙，{F#妳}{M#你}們願意收下這個嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470114
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730470114,
					"content": "是小花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730470115,
					"content": "#嗯。希望在未來的旅途中，這朵花能一直陪伴著{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470116,
						730470117
					],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730470116,
					"content": "我收下了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470118,
					"content": "#那菈的時間比蘭那羅珍貴許多，老身便不耽誤{F#妳}{M#你}們了，盡情享受吧。晚點{F#妳}{M#你}們去找找蘭加惟，他也在準備無憂節的儀式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭拉迦"
				},
				{
					"id": 730470117,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470118
					]
				},
				{
					"id": 730470105,
					"content": "我也很開心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730470106
					]
				},
				{
					"id": 730470106,
					"content": "我也很開心！不過，蘭拉迦以前沒有參加過無憂節嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730470107
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}