			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂蕾娜"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3436.863,
							449.586,
							4437.817
						],
						"pointId": 340100474
					}
				]
			},
			"dialogs": [
				{
					"id": 746790101,
					"content": "進入陣位，全員列隊，銃槍抵肩，迅速瞄準，精準射擊，拒止敵人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790102
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790102,
					"content": "歡迎參與「特巡隊」的特別活動，體驗銃槍射手的快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790103,
						746790104
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790103,
					"content": "銃槍？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746790105
					]
				},
				{
					"id": 746790105,
					"content": "提到我們不太熟悉的概念了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790106,
					"content": "不過看這位警備隊員的攤位，難道她說的活動也和「千靈映影節」有關嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790107,
					"content": "啊！是「超天頂領隊級戰力」！您居然出現了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790108
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790108,
					"content": "如果有您幫忙宣傳，那我一定可以達成任務的目標！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790109,
						746790110
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790109,
					"content": "妳說誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746790111
					]
				},
				{
					"id": 746790111,
					"content": "#呃啊…那個什麼什麼戰力，又是我和{NICKNAME}的奇怪外號嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790112,
					"content": "#沒錯沒錯，這是{F#妳}{M#你}們兩位在一些警備隊員之中流傳的美稱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790113
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790113,
					"content": "#我曾與{F#妳}{M#你}們有過一面之緣，不過…我這種普通路人般的平庸射手，沒有讓{F#妳}{M#你}們留下深刻的印象…也再正常不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790114
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790114,
					"content": "當成初次見面也完全沒問題！我是「特巡隊」的新晉成員蒂蕾娜，負責隊內的各種雜務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790115
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790115,
					"content": "「特巡隊」希望藉助「千靈映影節」的人氣來舉辦一個宣傳活動，並招募市民當中的潛在人才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790116
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790116,
					"content": "所以，鏘鏘！兩位請看桌上的這個模擬射擊裝置「千步攔射角分間」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790117
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790117,
					"content": "這個裝置…像是一個小小的楓丹廷模型？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790118,
					"content": "啊哈！不止是楓丹廷哦！這個沙盤還可以切換區域，更換成野外的風景，當然，那遠不如楓丹廷壯觀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790119
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790119,
					"content": "配合楓丹科學院之前為我們研究的特殊光學目鏡，就能模擬「特巡隊」射手在高處打擊敵人時的情景！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790120
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790120,
					"content": "總之，聽起來就是一種…模擬銃槍使用情景，瞄準目標並射擊的遊戲沒錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790121,
					"content": "不過這個名字好複雜，攔射和角分又是什麼意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790122,
					"content": "咳咳，我根據夏沃蕾隊長教導我們的一句名言，總結出了這個活動名稱，超級厲害的目標！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790123
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790123,
					"content": "「作為優秀的銃槍射手應追求的終極準確度，是在千步級別的距離上，打出小於一角分的散布！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790124
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790124,
					"content": "雖然以目前量產銃槍的加工精密度和我們射手的視力，別說千步了，一百步以上的散布要小於一角分都是天方夜譚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790125
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790125,
					"content": "但以夏沃蕾隊長的實力，說不定真的做得到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790126
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790126,
					"content": "慢一點慢一點，我光聽都暈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790127,
						746790128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790127,
					"content": "技術的名詞也不用真的弄懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746790129
					]
				},
				{
					"id": 746790129,
					"content": "「超天頂領隊級戰力」說得對！有的東西不用計較那麼多，照做就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790130
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790130,
					"content": "我剛入隊的時候，夏沃蕾隊長也是這樣教我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790131
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790131,
					"content": "總之，請兩位收下這副目鏡，配合桌上的模擬裝置就可以開始遊戲了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790132
					],
					"speakerTitle": "蒂蕾娜"
				},
				{
					"id": 746790132,
					"content": "話都說到這裡了，我們就試試看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746790133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790133,
					"content": "我本來就有點好奇用銃槍這樣的武器射擊目標是什麼感覺呢？說不定還滿有趣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746790128,
					"content": "只要開開心心玩遊戲就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746790129
					]
				},
				{
					"id": 746790110,
					"content": "聽不懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746790111
					]
				},
				{
					"id": 746790104,
					"content": "射手？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746790105
					]
				}
			]
		}
	]
}