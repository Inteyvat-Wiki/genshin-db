			"dialogs": [
				{
					"id": 761500101,
					"content": "咳咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500102
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500102,
					"content": "妳沒事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500103
					]
				},
				{
					"id": 761500103,
					"content": "我…沒事，我做了一個很長很長的噩夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500104
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500104,
					"content": "算了，上一句話當我沒說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500105
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500105,
					"content": "我忍不了了——為什麼我要遇到這種事情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500106
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500106,
					"content": "為什麼我總要遇到這些事情？爸爸媽媽，然後是姐姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500107
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500107,
					"content": "沒事的，我在。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500108
					]
				},
				{
					"id": 761500108,
					"content": "#嗯，我沒有生{F#妳}{M#你}們的氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500109
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500109,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500110
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761500110,
					"content": "小右撿了個什麼東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500111
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500111,
					"content": "我把這個叫做「念亡碎片」，或許是向死而生的出路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500112
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761500112,
					"content": "一起走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761500113
					]
				},
				{
					"id": 761500113,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500114
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 761500114,
					"content": "既然找到琳德了，我們就去找找出去的辦法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500115
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761500115,
					"content": "這裡真的可以靠實力出去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500116
					],
					"speakerTitle": "阿羅邏"
				},
				{
					"id": 761500116,
					"content": "既然梅蘭塔和尼西里塔可以自由往來，通常都還會帶人出入，那小右應該也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500117
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761500117,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500118
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761500118,
					"content": "現在收集到了三枚「念亡碎片」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500119
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761500119,
					"content": "哦，這個是暫定的名稱。因為我也不知道小右收集這個要做什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500120
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761500120,
					"content": "小右，接下來怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500121
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761500121,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761500122
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761500122,
					"content": "跟著它指示的方向走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯托利亞"
				}
			]
		},
