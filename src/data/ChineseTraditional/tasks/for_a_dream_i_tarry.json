				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"賈維"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090101,
					"content": "咦？應該就在這附近啊，怎麼不見了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090102
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090102,
					"content": "你在找什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090103
					]
				},
				{
					"id": 731090103,
					"content": "#{F#妳}{M#你}是…喔，應該是旅行者吧，我聽人家提起過{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090104
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090104,
					"content": "我叫賈維，是個…是個普通的售貨員，我正在這裡找我之前埋下去的一個「夢想盒」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090105
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090105,
					"content": "好奇怪的名字…這盒子裡面裝著什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731090106,
					"content": "嗯…非要說的話，應該是裝著我小時候「期待實現的夢想」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090107
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090107,
					"content": "為什麼要這麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090108
					]
				},
				{
					"id": 731090108,
					"content": "哈哈哈，這是我在很小的時候，和我的朋友們一起做的一種遊戲啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090109
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090109,
					"content": "把自己最想要實現的那個夢想寫下來，然後埋在這裡。然後再約定一個時間，一起過來把這「夢想盒」挖出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090110
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090110,
					"content": "現在就是我們約定的時間啦。但是…看來只有我一個人還記得這件事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090111
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090111,
					"content": "唉，這件事他們忘了就忘了吧…只要別忘了自己的夢想就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090112
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090112,
					"content": "總之，我這次過來就是想把自己的盒子挖出來，也算是了結一樁心事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090113
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090113,
					"content": "但我找了一圈，卻什麼也沒找到，不會被人給挖走了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090114,
						731090115
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090114,
					"content": "你那個時候做了標記嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090118
					]
				},
				{
					"id": 731090118,
					"content": "我記得，那個時候我是埋在一棵樹旁邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090119
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090119,
					"content": "一棵樹？這、這周圍可是有好多樹啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731090120,
					"content": "我小時候也沒有注意過這種事啊，當時我們就在埋盒子的地方插了一個小牌子做標記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090121
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090121,
					"content": "過了這麼長時間，那個牌子已經不見了，周圍的樹我也完全認不出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090122
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090122,
					"content": "我就隱約記得，埋盒子的地方就在這附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090123
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090123,
					"content": "#旅行者，能請{F#妳}{M#你}幫我一起找找看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090124,
						731090127
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090124,
					"content": "怎麼找？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090125
					]
				},
				{
					"id": 731090125,
					"content": "我把那個盒子埋在了一棵樹的旁邊，所以…就先在樹旁邊挖挖看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090126
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090126,
					"content": "#幫幫忙啦旅行者，我會支付{F#妳}{M#你}報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090130,
					"content": "#{F#妳}{M#你}看，這片樹林這麼大，我一個人可找不完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090131
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090131,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090132
					]
				},
				{
					"id": 731090132,
					"content": "#嘿嘿，多謝{F#妳}{M#你}了，那我們就分頭行動吧，我在這邊，另外一邊就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090127,
					"content": "反正夢想都飛走了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090128
					]
				},
				{
					"id": 731090128,
					"content": "就是因為我的夢想飛走了，我才更要挖出來那個盒子，看看我當初希望實現的夢想啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090129
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090129,
					"content": "#拜託{F#妳}{M#你}啦旅行者，就幫幫我吧，我會支付{F#妳}{M#你}報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090130
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090115,
					"content": "夢想飛走了啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090116
					]
				},
				{
					"id": 731090116,
					"content": "哈哈哈…我倒是不否認這件事，畢竟我現在都不記得我當初寫下來的夢想了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090117
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090117,
					"content": "但就算我的夢想會飛走，那個盒子也不會飛走啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090118
					],
					"speakerTitle": "賈維"
				}
			]
		},
		{
			"id": 7310903,
			"completionStepIds": [
				7310903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310903",
							"2"
						],
						"stepId": 7310903,
						"stateName": "QUEST_STATE_UNFINISHED"
