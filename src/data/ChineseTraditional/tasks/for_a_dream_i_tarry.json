	"talks": [
		{
			"id": 7310901,
			"completionStepIds": [
				7310901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310901",
							"2"
						],
						"stepId": 7310901,
						"stateName": "QUEST_STATE_UNFINISHED"
