				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿米",
					"賈維"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090501,
					"content": "這個…是給我的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090502
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090502,
					"content": "那個盒子我是隨便埋下去的，裡面的紙條也是我隨便寫的，叔叔看到了沒什麼關係，不用向我道歉的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090503
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090503,
					"content": "沒事，這花盆反正放在我那裡也沒用，就送給妳啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090504
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090504,
					"content": "我還拜託人去找種子，應該馬上就會過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090505,
						731090506
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090505,
					"content": "種子來了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				},
				{
					"id": 731090507,
					"content": "#欸？{F#妳}{M#你}是什麼時候來的，我都沒注意到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090508
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090508,
					"content": "咳…阿米，妳不是想要當花匠嗎？妳就先用這些東西開始種花吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090509
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090509,
					"content": "謝謝…但我如果在爸爸的店旁邊養花的話，蟲蟲說不定就會飛進那個鍋裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090510
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090510,
					"content": "掉進鍋裡的蟲蟲很可憐，吃到蟲蟲的大人也很可憐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090511
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090511,
					"content": "如果把花挪遠的話，我又擔心會忘記去照顧它，枯掉的花也很可憐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090512
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090512,
					"content": "而且爸爸平常很忙，也不讓我一個人跑太遠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090513
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090513,
					"content": "#嗯…如果{F#妳}{M#你}願意的話，我和{F#妳}{M#你}一起照顧這盆花，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090514
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090514,
					"content": "雖然我每天只能下班的時候過來，但多少也有點閒置時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090515
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090515,
					"content": "好呀！但是爸爸也許不會答應…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090516
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090516,
					"content": "我和賈漢吉爾先生也算是認識了，等等我們一起去跟他說說，他應該會答應的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090517
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090517,
					"content": "好！那…那我還要再種幾盆花！我最喜歡須彌薔薇了！將來…我要在爸爸的店旁邊種滿須彌薔薇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090518
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090518,
					"content": "不錯啊，小丫頭還挺有理想的，那我們兩個就一起努力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090519,
						731090520
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090519,
					"content": "到時候記得分我一朵。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090521,
					"content": "#嗯！謝謝{F#妳}{M#你}，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BIGBROTHER|INFO_FEMALE_PRONOUN_BIGSISTER]}，我想想…我還要再種一盆甜甜花，然後再種什麼好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090522
					],
					"speakerTitle": "阿米"
				},
				{
					"id": 731090522,
					"content": "看來這孩子是真心喜歡種花啊，希望她能一直堅持自己的夢想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090523
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090523,
					"content": "嘿嘿…可別和我一樣，變成這麼一個普通又無聊的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090524
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090524,
					"content": "#咳！旅行者，謝謝{F#妳}{M#你}幫忙，這些報酬給{F#妳}{M#你}，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090525,
						731090526
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090525,
					"content": "認真的生活並不普通。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090527,
					"content": "#謝謝{F#妳}{M#你}啊，我也不是在抱怨什麼啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090528
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090528,
					"content": "只不過…今天看見我埋下去的「夢想」，稍微有點感慨而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090529
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090529,
					"content": "#好了，我也差不多要回去了，今天多謝{F#妳}{M#你}幫忙了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090530
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090530,
					"content": "我要不要…重新寫一份「夢想」，然後再埋回去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090526,
					"content": "認真的生活並不無聊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090527
					]
				},
				{
					"id": 731090520,
					"content": "加油啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090521
					]
				},
				{
					"id": 731090506,
					"content": "這些花種給妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090507
					]
				}
			]
