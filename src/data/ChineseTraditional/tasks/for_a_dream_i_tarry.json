				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賈維"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731090301,
					"content": "壞了，這個「夢想盒」不是我的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090302,
						731090304
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090302,
					"content": "我們挖到了一個盒子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090303
					]
				},
				{
					"id": 731090303,
					"content": "哈哈…我也挖到了一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090305
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090305,
					"content": "我還把這個「夢想盒」打開了，盒子裡的紙條上還署著阿米的名呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090306
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090306,
					"content": "我記得這孩子，她是賈漢吉爾的女兒，經常在那個食品店旁邊待著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090307
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090307,
					"content": "這孩子的夢想是當一個花匠，要種很多花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090308
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090308,
					"content": "看不出來啊，我還以為賈漢吉爾要把她培養成自家店的接班人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090309,
						731090310
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090309,
					"content": "先看看你的夢想吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090311,
					"content": "喔！對對，得先看看我自己的夢想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090312
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090312,
					"content": "我看看啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090313
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090313,
					"content": "「希望成為『林行者』，一直住在樹林裡…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090314
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090314,
					"content": "我小時候的夢想居然是這個？真不知道我當時在想什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090315
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090315,
					"content": "唉…臭小子，林行者可不是一個能輕鬆賺錢的活啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090316,
						731090317
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090316,
					"content": "我覺得沒什麼不好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090318,
					"content": "那是小孩子才能有的想法，到我這個年紀了，夢想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090319
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090319,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090320
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090320,
					"content": "倒不如想想怎麼多賺幾個摩拉，晚上睡覺的時候能睡得安穩些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090321
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090321,
					"content": "好了，別說我那個無聊的夢想了，還是看看阿米的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090322
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090322,
					"content": "我把她的「夢想盒」給拆了，要做點事向她賠罪才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090323
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090323,
					"content": "嗯…讓我想想，既然她想做花匠，那首先就要學一學種花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090324
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090324,
					"content": "我那裡正好有閒置的花盆，可以拿去給她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090325
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090325,
					"content": "#旅行者，{F#妳}{M#你}知道怎麼弄到花的種子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090326,
						731090327
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090326,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090332
					]
				},
				{
					"id": 731090332,
					"content": "#那種子的事情就拜託{F#妳}{M#你}了，旅行者，我們等一下在賈漢吉爾的店旁邊碰頭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090327,
					"content": "你為什麼要這麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090328
					]
				},
				{
					"id": 731090328,
					"content": "哈哈哈…算是一時興起吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090329
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090329,
					"content": "我是不可能再去追逐夢想了，一方面是年紀不小了，另一方面…是我也不怎麼在意這個夢想了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090330
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090330,
					"content": "但阿米還小，她還能嘗試實現自己的夢想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090331
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090331,
					"content": "我這個無聊的大人也沒什麼能幫她的，就送個花盆，算是為她加油打氣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731090332
					],
					"speakerTitle": "賈維"
				},
				{
					"id": 731090317,
					"content": "夢想沒有好壞之分。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090318
					]
				},
				{
					"id": 731090310,
					"content": "這是你的「夢想盒」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090311
					]
				},
				{
					"id": 731090304,
					"content": "你也挖出來一個？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731090305
					]
				}
			]
		},
		{
			"id": 7310905,
			"completionStepIds": [
				7310905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
