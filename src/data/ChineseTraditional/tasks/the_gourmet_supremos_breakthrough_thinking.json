			},
			"dialogs": [
				{
					"id": 220140401,
					"content": "#這些應該就足夠了，{F#妳}{M#你}們稍等一下，我看看怎麼處理這些食材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140402
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140402,
					"content": "做好了。唔…但我感覺，好像和平常我做的那些菜沒什麼太大的區別…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140403
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140403,
					"content": "#{F#妳}{M#你}們拿回去給旭東吧，希望這道菜能解決他的問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卯師傅"
				}
			]
		},
