				"objectNames": [
					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140601,
					"content": "這裡的竹筍應該還不錯，挖一點帶回去好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140602
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140602,
					"content": "#咦？是{F#妳}{M#你}啊，{F#妳}{M#你}怎麼在這裡？是又想吃點好菜了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140603,
						220140604
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140603,
					"content": "有事情想請教妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140607
					]
				},
				{
					"id": 220140607,
					"content": "用璃月的手法，處理稻妻的食材嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140608
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140608,
					"content": "#嘿嘿，{F#妳}{M#你}們問我算是問對人啦。我之前聽說過稻妻那邊，有一種用麵粉裹住食材下鍋油炸的做菜手法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140609
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140609,
					"content": "用這種手法做出來的食物，似乎是稱為「天婦羅」，還要搭配特別的蘸汁來著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140610
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140610,
					"content": "我之前試做「天婦羅」的時候，對這種蘸汁特別感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140615
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140615,
					"content": "而且還試過好多材料呢，比如騙騙花蜜啦、烈焰花啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140611
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140611,
					"content": "還有史萊姆凝液是吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140612
					]
				},
				{
					"id": 220140612,
					"content": "沒有沒有，這道菜用史萊姆凝液不太合適啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140616
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140616,
					"content": "我還是更傾向於加入雷螢翅膀上的粉末，讓口感更加有層次感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140613
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140613,
					"content": "#這麼說{F#妳}{M#你}肯定也記不住，我抄一份給{F#妳}{M#你}，{F#妳}{M#你}拿去給旭東吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140614
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140614,
					"content": "唉，要是我也能去稻妻就好了，那裡一定有很多我沒試過的食材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140604,
					"content": "和卯師傅的反應一模一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140605
					]
				},
				{
					"id": 220140605,
					"content": "#{F#妳}{M#你}還去店裡了啊，不過，看{F#妳}{M#你}也不是專程去吃飯的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140606
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 220140606,
					"content": "#難道，{F#妳}{M#你}是遇見了什麼和做菜有關的問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140607
					],
					"speakerTitle": "香菱"
				}
			]
		},
