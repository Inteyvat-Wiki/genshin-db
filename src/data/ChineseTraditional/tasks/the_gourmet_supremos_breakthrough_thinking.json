			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140101,
					"content": "旅行者，嘿嘿，又見面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140102,
						220140104
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140102,
					"content": "有什麼事要幫忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140103
					]
				},
				{
					"id": 220140103,
					"content": "#{F#妳}{M#你}還記得我上次承諾{F#妳}{M#你}的那頓飯吧？我正在為這頓飯做準備呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140106,
					"content": "為了做一頓好菜，我們可是四處蒐集各種新鮮的食材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140107
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140107,
					"content": "現在食材蒐集得差不多了，我正在想做菜方法呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140108
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140108,
					"content": "朱莉和芭爾瓦涅去哪了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140109
					]
				},
				{
					"id": 220140109,
					"content": "她們啊，芭爾瓦涅說還想要繼續尋找其他的食材，去做她想要的那種「萬能調味料」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140110
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140110,
					"content": "然後她就拉著朱莉去野外尋找食材去了…她們說不會離城太遠，不用擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140111
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140111,
					"content": "#不過，我倒是需要{F#妳}{M#你}幫幫忙。雖然蒐集到了很多稻妻的新鮮食材，但我卻沒有什麼…突破性的靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140112
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140112,
					"content": "#{F#妳}{M#你}看，海草…海靈芝，還有這個…呃，緋櫻繡球…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140113
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140113,
					"content": "雖然都是些新鮮的食材，我卻完全不知道如何下手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140114
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140114,
					"content": "我本來是想請教一下稻妻當地的廚師。但如果這樣做，那我做出來的菜肯定又是尋常的「稻妻菜」，沒有任何新意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140115
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140115,
					"content": "所以，我想要以璃月廚師的思維，來處理這些稻妻的食材。這樣的話，說不定就能做出新奇的好菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140116
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140116,
					"content": "#旅行者，能請{F#妳}{M#你}幫我回璃月一趟，請教一下「萬民堂」的卯師傅嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140117,
						220140119
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140117,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140118
					]
				},
				{
					"id": 220140118,
					"content": "#那就拜託{F#妳}{M#你}了，我就在這等著{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140124,
					"content": "希望卯師傅能有些好主意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140119,
					"content": "你是想要那種「噼咔」的感覺對吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140120
					]
				},
				{
					"id": 220140120,
					"content": "#「噼咔」是、是什麼感覺？{F#妳}{M#你}是說那種…美食給人的震驚感嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140121
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140121,
					"content": "如果能找到有那種感覺的食譜，那當然最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140122
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140122,
					"content": "不過，能想出這種食譜的人，我可不認識啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140123
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140123,
					"content": "#總之，拜託{F#妳}{M#你}先去幫我請教一下卯師傅吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140124
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 220140104,
					"content": "你是準備請我吃那頓飯嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140105
					]
				},
				{
					"id": 220140105,
					"content": "哈哈哈，我這不正是在為這頓飯做準備嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140106
					],
					"speakerTitle": "旭東"
				}
			]
		},
		{
			"id": 2201402,
			"completionStepIds": [
				2201402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2201402",
							"2"
						],
						"stepId": 2201402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卯師傅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220140201,
					"content": "#咦？旅行者，{F#妳}{M#你}怎麼來了，是又想吃點好菜了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140202
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140202,
					"content": "是想要請教一件事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140203
					]
				},
				{
					"id": 220140203,
					"content": "旭東居然為了做菜去稻妻了啊，他還真是有毅力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140204
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140204,
					"content": "你認識他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140205
					]
				},
				{
					"id": 220140205,
					"content": "算是吧，之前我們倆也切磋過廚藝，勉強算是…不相上下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140206
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140206,
					"content": "他之前就一直說，自己想要尋求突破，想要去世界各地旅行…沒想到他還真這麼做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140207
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140207,
					"content": "不過，看樣子他也遇到瓶頸了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140208,
						220140210
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140208,
					"content": "你知道怎麼解決他的問題嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140209
					]
				},
				{
					"id": 220140209,
					"content": "我也不能保證，但我會盡力試試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140214,
					"content": "海草…海靈芝…還有這個什麼…緋櫻繡球？這都是什麼奇怪的食材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140215
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140215,
					"content": "不過，如果單看海草和海靈芝…的話，我想也許可以做一道菜…但還需要些另外的配料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140216
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140216,
					"content": "#旅行者，能請{F#妳}{M#你}幫我去找一些絕雲椒椒和禽肉來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140217,
						220140219
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140217,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140218
					]
				},
				{
					"id": 220140218,
					"content": "那就拜託了，找到絕雲椒椒和禽肉之後，就帶回來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140219,
					"content": "果然是經典食材啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140220
					]
				},
				{
					"id": 220140220,
					"content": "#哈哈哈，那是當然了，這些食材可都是最可靠的，{F#妳}{M#你}拿到之後，就帶回來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140221
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140221,
					"content": "不過，這個什麼緋櫻繡球，我是真不知道怎麼入菜…不知道稻妻那邊的廚師會怎麼處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140210,
					"content": "也許香菱知道怎麼解決他的問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220140211
					]
				},
				{
					"id": 220140211,
					"content": "香菱啊，嗯…這孩子做菜一向很有創意，說不定真能找到解決方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140212
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140212,
					"content": "但她現在去輕策莊那邊採竹筍去了，暫時不在店裡。你們想找她，應該要花點時間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140213
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 220140213,
					"content": "旭東應該急著等回覆呢，還是我來看看能不能解決他的問題吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220140214
					],
					"speakerTitle": "卯師傅"
				}
			]
		},
