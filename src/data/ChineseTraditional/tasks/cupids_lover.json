							3923.576
						],
						"pointId": 7248
					}
				]
			},
			"dialogs": [
				{
					"id": 740750201,
					"content": "這裡好像有人不久前來過啊。居然遇到了比我們還熟悉考古探險的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750202,
					"content": "地上還有…一塊懷錶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750203,
					"content": "按照我們冒險的慣例，讓我看看這個石碑提示哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750204,
					"content": "「此處乃靈魂之象限，靈魂之廟宇，靈魂之間」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750205,
					"content": "「伴你長眠」…「生於一瞬，常與相違，從不分離」…「人間至寶」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750206,
						740750207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750206,
					"content": "啊，很明顯我的朋友…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750208
					]
				},
				{
					"id": 740750208,
					"content": "思考思考。很貴重的懷錶，又是人間之寶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750209,
					"content": "我明白了，一定是摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750210,
					"content": "不、不太像是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750211
					]
				},
				{
					"id": 740750211,
					"content": "#{F#妳}{M#你}說的有道理。一般謎底不會這麼俗氣的。應該就是，怎麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750212,
					"content": "對了，是「財富」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750213,
					"content": "很好，我們姑且當作不是。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750214
					]
				},
				{
					"id": 740750214,
					"content": "#氣死我了。{F#妳}{M#你}怎麼這麼不信任我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750215,
					"content": "#那{F#妳}{M#你}說這個是什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750216,
						740750218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750216,
					"content": "今天天氣滿好的。",
