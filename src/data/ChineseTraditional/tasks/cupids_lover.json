			"dialogs": [
				{
					"id": 740750101,
					"content": "「此處乃靈魂之象限，靈魂之廟宇，靈魂之間」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750102
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740750102,
					"content": "「伴你長眠」…「生於一瞬，常與相違，從不分離」…「人間至寶」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750103
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740750103,
					"content": "呼——這次沒有可怕的東西了。解答是，一塊懷錶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750104,
					"content": "說來，安是不是也有一個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750105,
					"content": "錶的話，的確很貴吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750106
					]
				},
				{
					"id": 740750106,
					"content": "所以答案就是錢，也就是摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750107,
					"content": "和錢一起永眠了可是人生第二大悲劇啊。以及不要問第一大是什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750108
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740750108,
					"content": "那第一悲劇是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750109
					],
					"speakerTitle": "安"
				},
				{
					"id": 740750109,
					"content": "這個我知道，答案是「身無分文地躺在棺材裡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750110
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740750110,
					"content": "這個價值觀不太好哦！世界上更重要的東西有很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750111
					],
					"speakerTitle": "安"
				},
				{
					"id": 740750111,
					"content": "所以我說了別問了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750112
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740750112,
					"content": "我很抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750113
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740750113,
					"content": "話說回來，基於上面的原因，我不認為答案會是名錶或者摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750114
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740750114,
					"content": "那會是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740750115,
					"content": "答案很簡單，這個能搜尋到類似的謎語，相符率百分之七十。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750116
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740750116,
					"content": "出自幾百年前的古典小說，原文：「我生於一瞬的視線相交，背對著追求之人奔跑。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750117
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740750117,
					"content": "「…割掉所有的肉、骨與內臟，我仍在骨髓中與你同床。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750118
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740750118,
					"content": "答案是「愛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750119
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740750119,
					"content": "這樣就懂了。這塊懷錶和我的那塊懷錶一樣，裡面一定也有充滿愛的回憶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750120
					],
					"speakerTitle": "安"
				},
				{
					"id": 740750120,
					"content": "要是那塊懷錶可以打開就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740750121
					]
				},
				{
					"id": 740750121,
					"content": "對啊，總有一天會打開它的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750122
					],
					"speakerTitle": "安"
				},
				{
					"id": 740750122,
					"content": "笨狗狗，做得不錯！你是最可愛的機械狗狗了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750123
					],
					"speakerTitle": "安"
				},
				{
					"id": 740750123,
					"content": "我的榮幸。不過可愛是個主觀形容，我的理想稱呼是「可靠、耐用的原型機4ACV07」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750124
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740750124,
					"content": "哈哈！這就是為什麼你這麼可愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750125
					],
					"speakerTitle": "安"
				},
				{
					"id": 740750125,
					"content": "…你們兩個是不是在引經據典。我總感覺我看過這一幕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740750126
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740750126,
					"content": "無論如何，這裡的謎題已經被他人解開。我們盡快行動吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
