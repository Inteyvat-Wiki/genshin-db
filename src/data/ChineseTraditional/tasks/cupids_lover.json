			"dialogs": [
				{
					"id": 740751701,
					"content": "仔細檢查了機關頂部的空間，什麼都沒有發現。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740751702
					]
				},
				{
					"id": 740751702,
					"content": "這裡依舊什麼都沒有欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740751703,
					"content": "所以卡特皮拉你能告訴我們，我們究竟要找什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751704
					],
					"speakerTitle": "安"
				},
				{
					"id": 740751704,
					"content": "我們是在尋找鍛鑄水仙十字聖劍的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751705
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751705,
					"content": "水仙十字結社依據地下之國與古楓丹的神秘哲學，在物質世界重現了必要的四種架空物質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751706
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751706,
					"content": "無法理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751707
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740751707,
					"content": "神秘的東西本身只作用於體驗，可以說比元素力還要跳脫常理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751708
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751708,
					"content": "幾十年前我輸入過教令院的素論派入門及中級教科書，元素力也沒有那麼神奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751709
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740751709,
					"content": "是嗎？那反正從結論上來說，這是楓丹古法與地下古國技術的交匯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751710
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751710,
					"content": "世界上出現了「記憶」、「願望」、「靈魂」與「人格」這四種物質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751711
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751711,
					"content": "為了防止歧義，我們把它們叫做「記憶」之塊、「願望」之塊、「靈魂」之塊與「人格」之塊好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751712
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751712,
					"content": "為什麼這些東西會用來打造聖劍啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740751713,
					"content": "水仙十字結社的神秘哲學裡，神殿是宇宙的縮影，社員是眾神的代行，聖油是錘鍊的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751714
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751714,
					"content": "聖劍，則是破開一切的「理性」。它需由完整的人之意志誕生而出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751715
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751715,
					"content": "好玄學。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740751716
					]
				},
				{
					"id": 740751716,
					"content": "哎呀！神秘哲學就是這樣，看起來相似就可以攀附。當這種東西變成魔法就以假成真的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740751717
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740751717,
					"content": "總之，我們趕快去下一個地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
		},
