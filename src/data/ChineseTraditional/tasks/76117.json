						],
						"pointId": 14269
					}
				]
			},
			"dialogs": [
				{
					"id": 761170401,
					"content": "…呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170402
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170402,
					"content": "是誰來了？我沒有錢…什麼也沒有，如果你們想要我的命，就拿去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170403
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170403,
					"content": "伊赫安提，我幫你把東西拿回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170404
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170404,
					"content": "…雅珂達？是妳嗎？我聽見了妳的聲音，但我的眼睛看不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170405
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170405,
					"content": "是我，伊赫安提，是我在你面前。你病得這麼重，為什麼不去找我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170406
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170406,
					"content": "落魄的野狗就算瀕死，也不敢踏入富麗堂皇的城市…畢竟牠之前挨過太多富人的鞭子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170407
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170407,
					"content": "我不是那樣的人，奈…老闆也不是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170408
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170408,
					"content": "那我就更不能去了。如果有人知道妳們會付出好心，那妳們可能每天都要付出好心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170409
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170409,
					"content": "沒有人敢在老闆面前這麼不長眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170410
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170410,
					"content": "但妳總是偷偷存好心，然後，再被那些受到妳好心的人倒刺一劍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170411
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170411,
					"content": "我向老闆學了很多，沒有人能刺傷我了，之後再也不會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170412
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170412,
					"content": "妳就是不願意收起好心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170413
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170413,
					"content": "這是我自己的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170414
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170414,
					"content": "呵呵，也許這就是老大看重妳的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170415
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170415,
					"content": "也許這就是我活到現在的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170416
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170416,
					"content": "哈哈哈…咳…咳咳！妳說得對，雅珂達，妳說得對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170417
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170417,
					"content": "…好了，伊赫安提，有什麼我能為你做的，現在就說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170418
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170418,
					"content": "妳還是這樣，就不怕我突然削妳一筆？或者給妳挖個大坑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170419
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170419,
					"content": "你不會這麼做的，我們認識很久了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170420
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170420,
					"content": "就因為這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170421
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170421,
					"content": "而且，看你這副模樣，還能怎麼威脅我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170422
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170422,
					"content": "哈！總算有點長進，救一條骨頭已經被抖散的毒蛇，相對來說還算安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170423
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170423,
					"content": "那就幫個忙，把那個袋子裡的畫捲起來，塞進我口袋裡吧，我沒力氣把它拿起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170424
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170424,
					"content": "這幅畫是我和妻子還有女兒一起畫的，也是我如今在這個世界上唯一關心的事物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170425
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170425,
					"content": "其他的東西對我來說，都已經沒有意義了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170426
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170426,
					"content": "要是從前的你聽見這句話，肯定會笑得打滾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170427
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170427,
					"content": "可惜…這些我之前無比重視的東西，到頭來，既無法挽救我的妻子，也救不了我的人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170428
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170428,
					"content": "或許這就是盜賊的宿命吧。我們掠奪而來的東西，到頭來都會被再掠奪走，最後，重新變得一無所有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170429
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170429,
					"content": "那枚我用來刊登委託的吊墜，也是我最後的一點財產…哈哈…也不能說是「我的」最後一點財產。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170430
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170430,
					"content": "這是你偷到手的第一枚首飾，你和我說過很多次了，你還和我說過你用的手段，還有那個富翁發覺自己被盜後的表情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170431
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170431,
					"content": "是啊，現在它是妳的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170432
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170432,
					"content": "這枚首飾的主人是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170433
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170433,
					"content": "是個至冬人，叫霍洛莫夫，曾經在挪德卡萊居住過，但現在應該已經回至冬了，妳想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170434
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170434,
					"content": "我已經不是盜賊了，也不會把偷來的東西據為己有。這枚首飾本來屬於誰，就應該歸還給誰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170435
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170435,
					"content": "哈哈…哈哈哈哈…！妳真是個…真是個傻瓜，雅珂達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170436
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170436,
					"content": "老大說得對，妳這樣的人做賊，一輩子也…咳咳…也發不了財…咳咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170437
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170437,
					"content": "咳咳…咳…咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170438
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170438,
					"content": "好了，不要再說話了。我這就回去替你找醫生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170439
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170439,
					"content": "不用了，就讓我去我應該去的地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170440
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170440,
					"content": "你…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170441
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170441,
					"content": "雅珂達，妳知道老大訂下的「規矩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170442
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170442,
					"content": "…「企望安息者，應得安息。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170443
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170443,
					"content": "履行它吧，妳明白我的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170444
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170444,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170445
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170445,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170446
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170446,
					"content": "我很高興來幫我忙的人是妳，雅珂達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170447
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170447,
					"content": "可惜，我沒有什麼寶物給妳，如果妳想要的話，就把這個布娃娃拿走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170448
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170448,
					"content": "這是…可是那些娃娃，我不是叫你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170449
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170449,
					"content": "啊，別誤會。這是我自己做的，妳之前做的那些娃娃，我都按照妳說的，全部燒光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170450
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170450,
					"content": "怎麼樣，我在眼睛徹底瞎掉之前，手藝還滿厲害的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170451
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170451,
					"content": "拿去吧，雅珂達。就當做是我最後的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170452
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170452,
					"content": "我會回來看你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170453
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170453,
					"content": "去吧，再見了，雅珂達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170454
					],
					"speakerTitle": "伊赫安提"
				},
				{
					"id": 761170454,
					"content": "謝謝妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊赫安提"
				}
			]
		},
