			},
			"dialogs": [
				{
					"id": 761170301,
					"content": "我認輸，停手，停手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170303
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170303,
					"content": "早這樣，哪來這麼多事？錢拿著，找個可靠的醫生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170304
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170304,
					"content": "…妳什麼意思？可憐我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170305
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170305,
					"content": "別廢話，錢拿著。之後是把它丟水裡，還是用這些錢僱人來揍我，都隨你的便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170306
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170306,
					"content": "挨餓和渾身痛的滋味都不好受，別給自己找苦頭吃，卡列瓦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170307
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170308
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170308,
					"content": "從那個病病殃殃的手上拿的東西，我放在旁邊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170309
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170309,
					"content": "裡面除了零錢之外，就只有一張畫、一個破娃娃。錢我花完了，其他東西還沒來得及丟，都在那邊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170310
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170310,
					"content": "好。最後一個問題，你剛才說伊赫安提「病病殃殃的」——什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170311
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170311,
					"content": "就是字面意思，他病得都快沒人樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170312
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170312,
					"content": "我看見這傢伙的時候，他趴在地上一動也不動，我還以為他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170313
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170313,
					"content": "然後…我就把他身邊的包包撿走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170314
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170314,
					"content": "把你最後一次看見伊赫安提的位置標記給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170315
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170315,
					"content": "最後一次？我想想…應該就在這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170316
					],
					"speakerTitle": "卡列瓦"
				},
				{
					"id": 761170316,
					"content": "#我知道了。{NICKNAME}、派蒙，我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761170317
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761170317,
					"content": "我得把拿回來的東西，當面還給委託人才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂達"
				}
			]
		},
		{
			"id": 7611704,
			"completionStepIds": [
				7611705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
