			"trigger": {
				"objectNames": [
					"露子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490201,
					"content": "#歡迎回來，{NICKNAME}。請問有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490202
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490202,
					"content": "關於妳的委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490203
					]
				},
				{
					"id": 721490203,
					"content": "我們已經取得四顆「御靈珠」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721490204,
					"content": "這樣嗎？真是太可靠了，非常感謝！那麼接下來距離解開最後的「心」之封印就只有一步之遙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490205
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490205,
					"content": "接下來還要辛苦兩位隨我一同前去，希望您不要介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490206
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490206,
					"content": "#既然都到這裡了，我們也不在乎多走兩步路啦！對吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490207,
						721490208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721490207,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				},
				{
					"id": 721490209,
					"content": "那麼事不宜遲，我們現在就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 721490208,
					"content": "我沒什麼所謂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490209
					]
				}
			]
		},
		{
			"id": 7214903,
			"completionStepIds": [
				7214906
			],
