					"露子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721490301,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490302
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490302,
					"content": "露子小姐…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490303
					]
				},
				{
					"id": 721490303,
					"content": "啊，抱歉，剛剛太入神了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490304
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490304,
					"content": "#多謝{F#妳}{M#你}們的幫助，終於取得「月浴淵之鑰」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490305
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490305,
					"content": "「餘噦魚圓只月」…好拗口…那是什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721490306,
					"content": "哈哈，簡稱「淵之鑰」就好，我們不會強求外國人的讀音準確與否的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490307
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490307,
					"content": "這是打開淵下宮入口的必備之物，由大御神大人身上流出的血鑄結而成…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490308
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490308,
					"content": "至少傳說是這樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490309
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490309,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721490310,
					"content": "玄之又玄呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490311
					]
				},
				{
					"id": 721490311,
					"content": "一點也不玄啦，恰恰相反…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490312
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490312,
					"content": "接下來要上報現人神巫女大人，等她批准，再等靈脈的流動正確…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490313
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490313,
					"content": "之後，就可以進入淵下宮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490314
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490314,
					"content": "所以妳在支使我們做什麼啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721490315,
					"content": "#{F#妳}{M#你}們這趟又不是全無收穫！對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490316
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490316,
					"content": "#比如…{F#妳}{M#你}們收獲了珊瑚宮官方長久的友誼！海祇島今後會一直歡迎{F#妳}{M#你}們的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490317
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490317,
					"content": "什麼啦！說得像真的一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721490318,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490319
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490319,
					"content": "記載中有說，「御靈珠」只會應正直純良之輩的召喚，「月浴淵之鑰」也只會為心靈清澈如水之人凝聚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490320
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490320,
					"content": "雖然我不總是相信那些文書，但我相信您能為海祇島帶來轉機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490321
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490321,
					"content": "那麼，待下淵下宮之刻到來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490322,
						721490323
					],
					"speakerTitle": "露子"
				},
				{
					"id": 721490322,
					"content": "我們後會有期。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490325
					]
				},
				{
					"id": 721490325,
					"content": "那麼，再見啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "露子"
				},
				{
					"id": 721490323,
					"content": "妳會再求一次籤？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721490324
					]
				},
				{
					"id": 721490324,
					"content": "呵呵，我籤運很好的。我們一定還會再見面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721490325
					],
					"speakerTitle": "露子"
				}
			]
		},
