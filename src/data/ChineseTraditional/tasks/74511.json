				"points": []
			},
			"dialogs": [
				{
					"id": 745110101,
					"content": "#兩位朋友，{F#妳}{M#你}們好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110102
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110102,
					"content": "你們是…警備隊？找我們有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745110103,
					"content": "嘿嘿，猜猜看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110104,
						745110105
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745110104,
					"content": "難道說是在城裡飛簷走壁…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				},
				{
					"id": 745110106,
					"content": "#{F#妳}{M#你}們居然還做過這種事啊！講慢一點，我立刻記錄在案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110107
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745110107,
					"content": "原來是在詐我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745110108,
					"content": "開個玩笑。介紹一下，我叫謝妮，這位是我的前輩，弗雷瑞斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110109
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745110109,
					"content": "前輩最近做了一款新發明，想找人幫忙嘗試一下，不知道兩位有沒有興趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110110
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745110110,
					"content": "發明？什麼新發明呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745110111,
					"content": "一種可以遠距離控制的炮臺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110112
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110112,
					"content": "#{F#妳}{M#你}們看，以前的炮臺需要有人在旁邊操控吧？那敵方只要瞄準炮臺，就可以把我們一次斃掉啦。但是如果我們可以遠距離操控的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110113
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745110113,
					"content": "就可以盡量減少傷亡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110114
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110114,
					"content": "就是這樣！不愧是「曾三次拒絕楓丹科學院邀請」的弗雷瑞斯前輩，居然能輕鬆做出這麼神奇的發明！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110115
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745110115,
					"content": "三次拒絕楓丹科學院邀請？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110116
					]
				},
				{
					"id": 745110116,
					"content": "這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110117
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110117,
					"content": "#沒錯！我跟{F#妳}{M#你}們說哦，楓丹科學院曾經看中弗雷瑞斯前輩的才華，三次花重金聘請他去做高級研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110118
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745110118,
					"content": "前輩因為熱愛警備隊的工作，所以一直留在這裡，多麼感人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110119
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745110119,
					"content": "即便如此，前輩還是不忍自己的才華被浪費，所以時不時會創造出一些新發明，為我們解決各種苦惱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110120
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745110120,
					"content": "聽起來好厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745110121,
					"content": "咳。過譽了。謝妮，還記得我對妳的教導嗎？越是聰明的人，越懂得謙虛的可貴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110122
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110122,
					"content": "是，弗雷瑞斯前輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110123
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745110123,
					"content": "總之，我們想請兩位幫忙驗證這款遠距離炮臺的可行性。「場地」和「標靶」我們已經準備好了，關於酬勞，我們也絕對不會吝嗇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110124
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110124,
					"content": "嘿嘿，這你就找對人啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745110125,
					"content": "#我和{NICKNAME}一路走來，見過各式各樣新鮮的東西。就讓我們幫你鑑定一下，你的發明到底好不好用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745110126,
					"content": "加油，兩位。加油，弗雷瑞斯前輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745110127
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 745110127,
					"content": "呃…總之，這邊請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 745110105,
					"content": "難道說是在城裡舞刀弄劍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745110106
					]
				}
			]
		}
	]
}