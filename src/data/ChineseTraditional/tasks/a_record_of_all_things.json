	"talks": [
		{
			"id": 1102401,
			"completionStepIds": [
				1102401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102401",
							"2"
						],
						"stepId": 1102401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110240101,
					"content": "#之前對{F#妳}{M#你}提過，孤雲閣之下，鎮壓了很多舊日的魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240102
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240102,
					"content": "如今仙眾已將璃月交給凡人，而赫烏莉亞的時代，是更久遠的過去。她留下的「鹽盞」與「鹽尺」，不應該回到璃月港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240103
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240103,
					"content": "讓它們留在這裡，既是沉眠，也是返鄉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240104
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240104,
					"content": "所以鍾離要我做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240105
					]
				},
				{
					"id": 110240105,
					"content": "我親手終結了一個時代。我一直在想，如何記錄那些…被我終結的歷史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240106
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240106,
					"content": "歷史可以記錄，但歷史並不可靠，這次的事也證明了這點。時間擁有強大的力量，歷史會在歲月中扭曲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240107
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240107,
					"content": "我需要找到更好的「記錄」，才能銘刻真實的歷史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240108
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240108,
					"content": "刻石曾是一種久遠的「記錄」。但看似不變的磐石、看似不變的世界與我…或許也都會在某一天消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240109
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240109,
					"content": "鍾離…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110240110,
					"content": "#所以，旅行者，我想到了{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240111
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240111,
					"content": "#{F#妳}{M#你}是遠渡重天、跨越星海之人。把歷史刻在{F#妳}{M#你}的記憶裡，就可以在未來某日，隨{F#妳}{M#你}一同前往別的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240112
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240112,
					"content": "#身為旅行者的{F#妳}{M#你}，只要能夠「記錄」，那麼，提瓦特的時代與歷史，就獲得了一種「存在的備份」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240113,
						110240115
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240113,
					"content": "原來這才是找我同行的理由。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240114
					]
				},
				{
					"id": 110240114,
					"content": "任重而道遠啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110240118,
					"content": "那麼，接下來，就是將「鹽盞」與「鹽尺」投入海中的時刻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240119
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240119,
					"content": "啊？為什麼要扔進海裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110240120,
					"content": "剛才我說過吧？這裡鎮壓了很多舊日的魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240121
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240121,
					"content": "也包括被「群玉閣」重鎖深海的「漩渦之魔神」，奧賽爾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240115,
					"content": "原來不是為了讓我找寶箱啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110240116
					]
				},
				{
					"id": 110240116,
					"content": "#哈哈哈…祝{F#妳}{M#你}離開提瓦特以後，在星海之間也能撿到寶箱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240117
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110240117,
					"content": "我有「財富之神」的別號，所以這句話是有效力的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110240118
					],
					"speakerTitle": "鍾離"
				}
			]
		}
	]
}