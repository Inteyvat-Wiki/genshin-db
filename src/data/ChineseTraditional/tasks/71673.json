			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"聞冀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716730101,
					"content": "嗯…總感覺這幅畫裡缺了點什麼，是不是應該再找點靈感呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730102
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730102,
					"content": "你是在…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730103
					]
				},
				{
					"id": 716730103,
					"content": "#哎，這不是{NICKNAME}嗎？久聞大名，久仰啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730104
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730104,
					"content": "如您所見，在下正遵照總務司的安排，在這裡佈置節日遊樂之所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730105
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730105,
					"content": "呃…你要教人畫畫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730106
					]
				},
				{
					"id": 716730106,
					"content": "哎，非也非也，並非是「教人作畫」，而是「替人作畫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730107
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730107,
					"content": "這海燈節一年比一年盛大，來往的客人也越來越多，其中不乏從璃月之外遠道而來的遊客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730108
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730108,
					"content": "雖然總務司也為他們安排了無償的「紀念留影」，但留影嘛，畢竟還是缺少了點璃月風味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730109
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730109,
					"content": "於是，總務司就命我來港口，替來往遊客作畫留念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730110
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730110,
					"content": "我看最近在璃月港內，「白馬仙人」的傳說最為炙手可熱，就想著乾脆以此為主題作畫好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730111
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730111,
					"content": "所謂龍騰虎躍，龍馬精神，替各位客人以白馬奔騰為題，作一幅「騰躍之畫」，再吉利不過了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730112
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730112,
					"content": "#怎麼樣，{NICKNAME}，{F#妳}{M#你}心中可有什麼適合作畫的意象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716730113
					],
					"speakerTitle": "聞冀"
				},
				{
					"id": 716730113,
					"content": "那還滿多的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716730114
					]
				},
				{
					"id": 716730114,
					"content": "#噢？哈哈哈哈，那好啊，儘管說來，待我為{F#妳}{M#你}潑墨一番！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "聞冀"
				}
			]
		}
	]
}