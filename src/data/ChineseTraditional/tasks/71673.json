			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7167301",
							"2"
						],
						"stepId": 7167301,
						"stateName": "QUEST_STATE_UNFINISHED"
