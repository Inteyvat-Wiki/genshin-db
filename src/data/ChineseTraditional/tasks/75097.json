			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970101,
					"content": "嗯？總覺得納塔的七天神像有點怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970102,
					"content": "第一次摸到神像的時候，感覺不是應該更強烈一點嗎…有「嗡」地一下的那種感覺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970103,
						750970105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970103,
					"content": "我覺得還好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970104
					]
				},
				{
					"id": 750970104,
					"content": "可是真的有點奇怪啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970108,
					"content": "唔…我想想該怎麼說，總覺得以前在摸其他神像的時候，可以建立更穩固的連結…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970109,
					"content": "#這次感覺就像是碰到了什麼開關一樣，{F#妳}{M#你}碰一下它才亮一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970110,
					"content": "#對了，對了，{F#妳}{M#你}之前摸到神像就能感受到元素的力量，這次呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970111,
					"content": "有沒有火元素那種，很活潑、很熱烈的感覺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970112,
						750970113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970112,
					"content": "（仔細感受了身軀之內…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970114,
					"content": "咦，一點也沒有嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970115,
					"content": "總覺得有點奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970113,
					"content": "（沒有預想的熾熱感…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970114
					]
				},
				{
					"id": 750970105,
					"content": "其實之前都是我「嗡」的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970106
					]
				},
				{
					"id": 750970106,
					"content": "原來是這樣，是這次忘了「嗡」呀，下次一定得注意了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970107,
					"content": "#才不是啦！{F#妳}{M#你}最好是每次摸七天神像的時候都會自己配音啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970108
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7509702,
			"completionStepIds": [
				7509706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
