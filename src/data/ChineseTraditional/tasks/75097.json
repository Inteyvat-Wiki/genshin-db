			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970301,
					"content": "哦哦，這樣才正常嘛…那種和七天神像建立穩固連結的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970302,
					"content": "所以之前七天神像不正常，果然是因為夜神之國裡有那個壞傢伙！看來七天神像之前也很辛苦呢…你很努力了，七天神像！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970303,
					"content": "雖然和火元素共鳴的力量也不是你給的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970304,
					"content": "嗯，是和火神共同戰鬥時候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970305
					]
				},
				{
					"id": 750970305,
					"content": "#對啊，那個時候我超擔心的…不過果然還是{NICKNAME}比較強！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970306,
					"content": "解決了深淵的怪物，七天神像也恢復正常了，真是太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
