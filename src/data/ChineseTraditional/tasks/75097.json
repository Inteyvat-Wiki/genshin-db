			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750970201,
					"content": "#…嗯，感覺還是很不習慣。{F#妳}{M#你}現在還是沒有辦法從七天神像獲得元素力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970202,
					"content": "哎呀，七天神像到底出了什麼問題呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970203,
						750970206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970203,
					"content": "可能是年久失修。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970204
					]
				},
				{
					"id": 750970204,
					"content": "明明摸起來的時候有好好發光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970205,
					"content": "唔，七天神像…你有在好好工作嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970208,
					"content": "感覺一點頭緒都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750970206,
					"content": "可能是納塔比較特殊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750970207
					]
				},
				{
					"id": 750970207,
					"content": "這麼說來，納塔好像一直在受到深淵的影響，難道是因為這個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750970208
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
