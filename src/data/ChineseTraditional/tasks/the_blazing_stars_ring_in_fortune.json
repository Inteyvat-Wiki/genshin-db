	"talks": [
		{
			"id": 4003502,
			"completionStepIds": [
				4003502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003502",
							"2"
						],
						"stepId": 4003502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凝光"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350201,
					"content": "…這份通知送去總務司，讓他們把上面列出的各項工作整理安排給各部門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350202
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350202,
					"content": "轉告他們，海燈節諸事繁雜，但無論大小工作都要辦妥辦好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350203
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350203,
					"content": "凝光小姐！嘿嘿，我們又來玩啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350204,
					"content": "沒有打擾妳吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350205
					]
				},
				{
					"id": 400350205,
					"content": "貴客來訪，怎麼能說是打擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350206
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350206,
					"content": "#看{F#妳}{M#你}們的樣子，是來璃月過海燈節的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350207
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350207,
					"content": "是呀！今年海燈節妳們都在忙什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350208,
					"content": "還是老樣子，各種雜事。對了，總務司今年策劃了一場「煙花會」，值得一看哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350221
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350221,
					"content": "海燈節向來以放飛「明霄燈」為節日重點，但最近璃月發生了許多事。我想，人們需要更多溫暖與團結感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350222
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350222,
					"content": "所以我認為，至少今年我們要採取更特別也更貼近每一個人的慶祝方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350223
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350223,
					"content": "將「煙花」送至璃月各處，選擇合適的時間全數點燃。讓更為熾熱的光與熱連接起人們的情感，這便是總務司的決定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350209
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350209,
					"content": "煙花？我們在別的地方似乎也見過煙花哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350210,
					"content": "璃月的煙花有什麼特別之處嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350211,
					"content": "煙花這一事物，最早是從璃月的某種發明演變而來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350212
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350212,
					"content": "璃月祖先創造煙花時，為它取名「爆竹」。它能發出強光與巨響，可用於驅趕毒蛇猛獸或是警示他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350213
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350213,
					"content": "早年人們在外耕種，聯絡不便。「爆竹」一物因能發出巨響，必要時會被用來傳遞信號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350214
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350214,
					"content": "璃月港正式建立後，人們生活好轉，不再趕往百里之外的土地耕種。漸漸地，也不再靠「爆竹」防身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350215
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350215,
					"content": "但先民手持「爆竹」艱苦墾荒的精神被延續下來，作為一種習俗流傳在民間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350216
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350216,
					"content": "「爆竹」便是煙花的前身。我們改良了「爆竹」，放到海燈節期間燃放，以這種形式來紀念先民們的奮鬥精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350217
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350217,
					"content": "不愧是璃月。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350218
					]
				},
				{
					"id": 400350218,
					"content": "真厲害…璃月的東西都好有歷史淵源啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350219,
					"content": "#相信{F#妳}{M#你}們也已經習慣了。歷史越久遠，土地上的每一件事物就會承載越多價值。這便是璃月。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350220
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350220,
					"content": "#煙花相關的事務，我交由刻晴負責了。如果{F#妳}{M#你}們對煙花感興趣，就隨我一同去見她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 4003503,
			"completionStepIds": [
				4003503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003503",
							"2"
						],
						"stepId": 4003503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"刻晴",
					"朋義"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350301,
					"content": "唔…佈置煙花的地點還得再加幾個。眼光要全面，不能侷限在城裡，難道輕策莊的人就不過海燈節了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350302
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350302,
					"content": "但、但是大人，這樣的話，預算就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350303
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350303,
					"content": "預算是什麼？是「辦好某件事最合適的量」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350304
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350304,
					"content": "如果你認為現在的預算不夠辦好這件事，就向總務司提出申請，重新核算審批。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350305
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350305,
					"content": "我們的目的是辦好這屆海燈節，預算是為了更好地規劃，不能本末倒置啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350306
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350306,
					"content": "是，我明白了，刻晴大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350307
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350307,
					"content": "嗯。安全第一，務必保證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350308
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350308,
					"content": "#凝光，旅行者。難得見{F#妳}{M#你}們過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350309
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350309,
					"content": "旅行者是來參加海燈節的嗎？剛好再過不久應該就能準備完畢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350310
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350310,
					"content": "刻晴在忙什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350311
					]
				},
				{
					"id": 400350311,
					"content": "覆核煙花佈置，再檢查一下相關設施。算是日常的小工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350312
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350312,
					"content": "恕我直言，這類工作交給下屬處理也行。妳已經日夜工作了好幾天，也該休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350313
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350313,
					"content": "小事而已，無妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350314
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350314,
					"content": "朋義，勞煩你重新做個規劃，總結成書面報告遞交到總務司。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350315
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350315,
					"content": "我去城裡看看煙花佈置點的情況，稍後回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350316
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350316,
					"content": "#旅行者，{F#妳}{M#你}是貴客，適逢佳節，還請留在城內好好享受節日氛圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350317
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350317,
					"content": "朋義，我交代你的事，都記住了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350318
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350318,
					"content": "是，記清楚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350319
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350319,
					"content": "好。凝光，旅行者，告辭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350320
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350320,
					"content": "凝光大人，還有這位…旅行者，我就先不打擾二位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350321
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350321,
					"content": "刻晴大人跟我講了好多計畫，我得重新去寫一份計畫書…抓緊時間，抓緊時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350355
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350355,
					"content": "啊對！差點忘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350356
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350356,
					"content": "#旅行者，這裡有個「煙花筒」，刻晴大人之前提過{F#妳}{M#你}可能會感興趣，讓我留著它，等見到{F#妳}{M#你}就交給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350357
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350357,
					"content": "#有動手能力的人，有了這個就能親手調配製作屬於自己的煙花了。{F#妳}{M#你}要是有時間，請務必試試！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350322
					],
					"speakerTitle": "朋義"
				},
				{
					"id": 400350322,
					"content": "剛才我完全插不上話欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350323,
					"content": "不對，應該說，我是「完全不敢插話」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350324,
					"content": "刻晴，好強的氣勢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350325
					]
				},
				{
					"id": 400350325,
					"content": "#{F#妳}{M#你}也這麼覺得對吧？刻晴的氣勢比之前更強了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350326,
					"content": "而且也比之前更忙…為什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350327,
					"content": "眾仙家將璃月港交由凡人全權治理，我們七星便擔起了引導民眾的責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350328
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350328,
					"content": "我們接手各個領域的重要工作，緊鑼密鼓地安排各項事宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350329
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350329,
					"content": "話雖如此，事事親為仍很費神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350330
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350330,
					"content": "往年，海燈節相關的統籌事宜都由江舟負責。但她家中老父年邁，今年便請調去了其他部門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350331
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350331,
					"content": "海燈節的工作，便落到了我和刻晴肩上。我擔任總負責人，至於萬眾矚目的「煙花會」，就交給刻晴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350332
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350332,
					"content": "茲事體大，我認為，應當託付給最可靠的人。而刻晴嚴於律己，又對工作充滿熱忱，是最佳人選。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350333
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350333,
					"content": "確實是非常嚴格的人呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350334,
					"content": "不錯。對人對己都萬分嚴格，以至於投入過度，連續操勞了好些日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350335
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350335,
					"content": "我認為，這不是長久之計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350336
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350336,
					"content": "過猶不及，是璃月人都該懂得的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350337
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350337,
					"content": "#我不是沒勸過她，但她的性格{F#妳}{M#你}們也知道。巧舌如簧的人遇上刻晴，也是要碰一鼻子灰的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350338
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350338,
					"content": "#旅行者，{F#妳}{M#你}跟刻晴關係不錯，又見識廣闊，不如也幫我勸勸她？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350339,
						400350340
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350339,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350341
					]
				},
				{
					"id": 400350341,
					"content": "#不愧是旅行者。勸說刻晴絕非易事，有{F#妳}{M#你}幫忙我也安心得多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350342
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350342,
					"content": "#我還得回群玉閣處理些事務，先行一步。刻晴的事，就勞{F#妳}{M#你}多費心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350343
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 400350343,
					"content": "凝光離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400350344
					]
				},
				{
					"id": 400350344,
					"content": "#{F#妳}{M#你}真的有辦法說服刻晴嗎？連凝光小姐都搞不定她欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350345,
					"content": "而且，想要說服一個人，至少得理解那個人現在的感受吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350346
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350346,
					"content": "刻晴現在應該是連續操勞，連休息日都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350347,
					"content": "感受是…「很累」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350348
					]
				},
				{
					"id": 400350348,
					"content": "這麼淺顯的理解根本沒用吧！再想想，更重要更深入的感受是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350349,
					"content": "或者，我們找個有心得的可靠的朋友問問吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350350
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350350,
					"content": "那就找鍾離吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350351
					]
				},
				{
					"id": 400350351,
					"content": "嗯？鍾離…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350352
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350352,
					"content": "他也比較了解璃月人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350353
					]
				},
				{
					"id": 400350353,
					"content": "嗯，確實很可靠！就問他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350354
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350354,
					"content": "他現在是「往生堂」的客卿，那我們就去「往生堂」找找他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350340,
					"content": "我會想個辦法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350341
					]
				}
			]
		},
