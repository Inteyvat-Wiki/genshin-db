					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350602
					],
					"speakerTitle": "擺渡人"
				},
				{
					"id": 400350602,
					"content": "二位好。請問有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350603
					],
					"speakerTitle": "擺渡人"
				},
				{
					"id": 400350603,
					"content": "我想找客卿鍾離…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350604
					]
				},
				{
					"id": 400350604,
					"content": "客卿跟堂主一起出門了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350605
					],
					"speakerTitle": "擺渡人"
				},
				{
					"id": 400350605,
					"content": "兩個人都出門了？難、難道他們是去工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350606,
					"content": "堂主說，是去散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350607
					],
					"speakerTitle": "擺渡人"
				},
				{
					"id": 400350607,
					"content": "如果二位要找他們，可以去「三碗不過港」看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350608
					],
					"speakerTitle": "擺渡人"
				},
				{
					"id": 400350608,
					"content": "聽說，堂主經常去那一帶…做宣傳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "擺渡人"
				}
			]
		},
		{
			"id": 4003507,
