			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡桃",
					"香菱",
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400350701,
					"content": "呼——吃飽了吃飽了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350787
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350787,
					"content": "♪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350702
					],
					"speakerTitle": "鍋巴"
				},
				{
					"id": 400350702,
					"content": "香菱呀，真虧妳能想出那種烤魚配蘸水的新吃法，特別是那碗蘸水，味道可真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350703
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350703,
					"content": "嘿嘿，那可是我的特製蘸水，味道當然好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350704
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350704,
					"content": "乾煸絕雲椒椒磨成粉，加蒜泥、蔥段拌勻，再加入鹽、醋、醬油，最後以滾油釣香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350705
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350705,
					"content": "看似粗獷的手法背後，是廚師對口味與調料比例的精準理解。多一分則多，少一分則少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350706
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350706,
					"content": "此謂之「精道」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350780
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350780,
					"content": "嗯嗯嗯對對。怎麼樣香菱，誇到妳心坎裡了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350781
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350781,
					"content": "嘿嘿…怪害羞的呢…謝謝鍾離先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350782
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350782,
					"content": "我覺得吧，我這個人已經很能說會道了，沒想到跟你一比，還是不夠看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350783
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350783,
					"content": "堂主何必跟我客氣。堂主的口才，整座璃月港有目共睹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350784
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350784,
					"content": "♪~♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350785
					],
					"speakerTitle": "鍋巴"
				},
				{
					"id": 400350785,
					"content": "鍋巴要來點什麼嗎？不用客氣，本堂主請你！帳記香菱頭上就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350786
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350786,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350707
					],
					"speakerTitle": "鍋巴"
				},
				{
					"id": 400350707,
					"content": "你們又在說什麼好吃的啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350708,
					"content": "#喲！是旅行者和派蒙啊，什麼風把{F#妳}{M#你}們吹來啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350709
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350709,
					"content": "慢著！先別說，讓本堂主細細算來…唔，是來過海燈節的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350710
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350710,
					"content": "一看就看出來了吧，還用猜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350711,
					"content": "#哎呀，這不是跟{F#妳}{M#你}們熟，逗{F#妳}{M#你}們樂嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350712
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350712,
					"content": "#{F#妳}{M#你}們來得剛好，我正在請大家試吃新菜呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350779
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350779,
					"content": "「三碗不過港」的老闆給了好評，鍾離先生和胡桃也都滿意，但我總覺得，還得請更多人試試才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350713
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350713,
					"content": "#怎麼樣，{F#妳}{M#你}們要吃吃看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350714
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 400350714,
					"content": "要吃要吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350715,
					"content": "我們是來找鍾離先生的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350716
					]
				},
				{
					"id": 400350716,
					"content": "啊？不、不吃嗎？好吧…那先辦正事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350717,
					"content": "許久不見，近來旅行可還順利？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350718
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350718,
					"content": "還不錯，長了不少見識。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350719
					]
				},
				{
					"id": 400350719,
					"content": "如此甚好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350720
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350720,
					"content": "所以呢所以呢？找咱們客卿有何貴幹呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350721
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350721,
					"content": "先說好，我們今天出門也有正事要辦哦！試菜只是順便啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350722
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350722,
					"content": "辦、辦事，不能是往生堂的事吧？明明在過節呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350723,
					"content": "過節也有生老病死是不是？別大驚小怪的。好啦，嚇唬妳的，我是想著今天天氣不錯，出來看看街景，順道宣傳一下業務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350724
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350724,
					"content": "你們聊著吧，我跟香菱去老闆那邊蹭點茶喝。鍾離忙完記得找我就行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350725
					],
					"speakerTitle": "胡桃"
				},
				{
					"id": 400350725,
					"content": "可以。堂主慢走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350726
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350726,
					"content": "旅行者，發生什麼事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350727
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350727,
					"content": "事情是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350728
					]
				},
				{
					"id": 400350728,
					"content": "向鍾離說明了刻晴的情況…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400350729
					]
				},
				{
					"id": 400350729,
					"content": "玉衡星為人剛正又聰敏勤勉，自是棟梁之才。不過，凡事均有度，還是身體要緊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350730
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350730,
					"content": "有什麼辦法勸勸她嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350731
					]
				},
				{
					"id": 400350731,
					"content": "對呀對呀，你說話總是很有道理的樣子，她應該會聽你的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350732,
					"content": "我若是岩王帝君，尚能說服她幾分。但我如今是一介客卿，也得考慮身分了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350733
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350733,
					"content": "何況玉衡星和我並不算熟識，冒昧進言說教，只會招人反感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350734
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350734,
					"content": "欸？那怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350735
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350735,
					"content": "旁敲側擊，或可一試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350736
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350736,
					"content": "#要是有一個能讓她動容的故事，就能將{F#妳}{M#你}要說的道理融入其中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350737
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350737,
					"content": "取材自生活，便能贏得共鳴。話中談及親近的人事，更能事半功倍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350738
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350738,
					"content": "呃…是什麼意思呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350739,
					"content": "我們去找熟悉刻晴的人問問。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350740
					]
				},
				{
					"id": 400350740,
					"content": "旅行者果真是一點就通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350741
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350741,
					"content": "#尋些素材來吧。{F#妳}{M#你}若願意，我也可以幫著提些建議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350742
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350742,
					"content": "#構思妥當後，將此故事經{F#妳}{M#你}之口說與玉衡星即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350743
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350743,
					"content": "我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350744
					]
				},
				{
					"id": 400350744,
					"content": "#玉衡星與{F#妳}{M#你}有交情。要說人選，{F#妳}{M#你}最是合適。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350745
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350745,
					"content": "原來是這樣！也就是說，找刻晴認識的人多打聽對吧？從誰先開始呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350746
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350746,
					"content": "#原來{F#妳}{M#你}們在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350747
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350747,
					"content": "咦？刻、刻晴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350748
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350748,
					"content": "沒想到鍾離先生也在。上次「送仙典儀」還是多虧了先生幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350749
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350749,
					"content": "幫了些小忙而已，玉衡星不必客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350750
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350750,
					"content": "妳、妳怎麼來了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350751
					]
				},
				{
					"id": 400350751,
					"content": "#怎麼了？{F#妳}{M#你}們的表情為什麼這麼奇怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350752
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350752,
					"content": "#莫非是我來得太突然，打擾到{F#妳}{M#你}和鍾離先生談話了？抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350753
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350753,
					"content": "不不，沒打擾沒打擾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350754
					]
				},
				{
					"id": 400350754,
					"content": "刻晴怎麼突然想到要找我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350755
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350755,
					"content": "#我來，是想請{F#妳}{M#你}們將我引見給仙家。佳節將至，我要代表璃月七星給各路仙家送些禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350756
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350756,
					"content": "上次跟仙人們並肩作戰的時候，他們不都見過妳了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350757
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350757,
					"content": "既然認識，直接去絕雲間就行啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350758
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350758,
					"content": "一面之緣而已，仙人們或許已經記不得我了。貿然訪問，怕是會惹人不快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350759
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350759,
					"content": "#所以我想，請{F#妳}{M#你}們引見才是最符合禮數的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350760,
						400350761
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350760,
					"content": "當然沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350764
					]
				},
				{
					"id": 400350764,
					"content": "原來還要負責上門送禮，做七星可真辛苦啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350765
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350765,
					"content": "我們會幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350766
					]
				},
				{
					"id": 400350766,
					"content": "好，那便說定了。我先回去準備禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350767
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350767,
					"content": "#大好的節日卻要麻煩{F#妳}{M#你}陪著我東奔西跑，實在抱歉…我們速戰速決，絕不耽擱{F#妳}{M#你}看煙花的行程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350768
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350768,
					"content": "那不如一起去看煙花吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350769
					]
				},
				{
					"id": 400350769,
					"content": "欸？一、一起嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350770
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350770,
					"content": "#也好，等我忙完手上的事，就隨{F#妳}{M#你}一起去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350771
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350771,
					"content": "鍾離先生也是。今年的「煙花會」品質不錯，先生切莫錯過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350772
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350772,
					"content": "當然。多謝提醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350773
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350773,
					"content": "#我先去忙了。旅行者，{F#妳}{M#你}準備完畢直接來群玉閣找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350774
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350774,
					"content": "走掉了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350775
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350775,
					"content": "玉衡星辦事向來雷厲風行，令人安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350776
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350776,
					"content": "#鍾離你也很可靠啊！對吧{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350777
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400350777,
					"content": "承蒙誇獎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350778
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350778,
					"content": "#剛才說的事，也請二位記在心上。等{F#妳}{M#你}們搜集了足夠多的素材，我們可以約在此處，再做商討。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				},
				{
					"id": 400350761,
					"content": "刻晴沒問過甘雨嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400350762
					]
				},
				{
					"id": 400350762,
					"content": "甘雨這幾天請假，一時半會找不到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350763
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 400350763,
					"content": "#還是麻煩{F#妳}{M#你}吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400350764
					],
					"speakerTitle": "刻晴"
				}
			]
		},
		{
			"id": 4003508,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
