			"dialogs": [
				{
					"id": 3600101,
					"content": "呼，小菜一碟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600102,
					"content": "#不過沒想到，原來{F#妳}{M#你}也不是沒有戰鬥能力的路人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600103,
					"content": "#謝謝{F#妳}{M#你}剛才的支援啦，這一戰感覺如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600104,
						3600105
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600104,
					"content": "輕輕鬆鬆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				},
				{
					"id": 3600106,
					"content": "說起來，「丘丘人」怎麼會出現在這裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3600107,
					"content": "這種生物，通常不會在離城市這麼近的地方建立營地吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3600108,
					"content": "是啊。它們本該只在荒野遊蕩才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600109,
					"content": "但最近風魔龍經常出現，果園被摧毀，商路也受到了影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600110
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600110,
					"content": "風暴爆發時又經常有人受傷…所以騎士團要分心防禦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600111,
					"content": "所以這些煩人的生物，活動範圍就越來越近？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3600112,
					"content": "是呀。不過今天又清理了一個營地，還是很有收穫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3600113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600113,
					"content": "#跟我來吧！認真負責的好騎士要護送{F#妳}{M#你}們進城了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3600105,
					"content": "勉勉強強。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3600106
					]
				}
			]
		}
	]
