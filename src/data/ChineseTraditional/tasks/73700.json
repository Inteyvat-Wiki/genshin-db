	"talks": [
		{
			"id": 7370001,
			"completionStepIds": [
				7370001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370001",
							"2"
						],
						"stepId": 7370001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖爾宛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000101,
					"content": "不知不覺訓練也進行到後半了。進展還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000102,
						737000103
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737000102,
					"content": "可以說是漸入佳境。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				},
				{
					"id": 737000104,
					"content": "不過斯露莎在跟我們講故事的時候，的確有反省的樣子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000105,
					"content": "對話對於斯露莎來說是很好的學習方法。特別是當對話的對象不是矯論團那群無趣的傢伙的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000106
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737000106,
					"content": "#前輩這話未免有點太武斷了…{NICKNAME}擔任「謁頌主」是很出眾，但矯論團的人也並不全是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000107
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000107,
					"content": "或許在吹捧與欺瞞之外也有零星被遺漏的美德吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000108
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737000108,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000109
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000109,
					"content": "#看妳不服氣的樣子，稍後剛好讓{NICKNAME}和派蒙兩位見證者來評價一下。當然，在妳的講述之後。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 737000103,
					"content": "還有進步的空間。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000104
					]
				}
			]
		},
		{
			"id": 7370006,
			"completionStepIds": [
				7370006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7370006",
							"2"
						],
						"stepId": 7370006,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737000601,
					"content": "好安靜啊，大家都不在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000602,
					"content": "就算拉沙魯在這裡，應該也會很安靜吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000603
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000603,
					"content": "嗯，不過如果她在的話，我們說話那就得小聲點了。她總是一副睏睏的樣子，之前被我們用俱利鼓吵醒的時候也有點不高興呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000604,
					"content": "聽說越是沉默寡言的傢伙，真的發起火來越是可怕。不知道拉沙魯大發雷霆會是什麼樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000605,
					"content": "這麼說來，吾之「謁頌主」才是最讓人害怕的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000606
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000606,
					"content": "#欸？我最瞭解{M#他}{F#她}了，這傢伙雖然話很少，但是其實很溫柔的。對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000607,
						737000609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000607,
					"content": "我要認真生氣了，嗷嗚嗷嗚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000608
					]
				},
				{
					"id": 737000608,
					"content": "妳看，一點也不可怕嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000611,
					"content": "好了，還是說回正事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000612
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000612,
					"content": "#如{F#妳}{M#你}們所見，這棵樹被稱為「跋爾松」，花靈拉沙魯是「跋爾松」之眷屬，不過她現在不在此處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000613
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000613,
					"content": "然後呢然後呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000614,
					"content": "然後？沒有然後了，關於拉沙魯和「跋爾松」，已經沒什麼可補足的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000615
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000615,
					"content": "總覺得斯露莎在隱瞞些什麼…對了，關於俱利鼓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000616,
					"content": "#遮、遮掩？沒有這回事。至於俱利鼓…{F#妳}{M#你}們不是已經見識過了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000617
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000617,
					"content": "對了，記得當時拉沙魯說俱利鼓是被她扔在不同的地方，那先朱那還大吃一驚呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000618,
					"content": "沒記錯的話，斯露莎當時慌慌張張的，也沒有回應那先朱那的質疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000619,
					"content": "這樣看來，矯論團的文獻典籍真的錯得離譜呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000620,
					"content": "雖然按鼓譜演奏確實喚醒了拉沙魯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000621
					]
				},
				{
					"id": 737000621,
					"content": "好像知道為什麼祖爾宛信不過現在的矯論團了，仔細想想，他們真的幫上忙了嗎？從矯論團得知的線索幾乎都是半真半假的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000622,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000623
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000623,
					"content": "現在的矯論團是有一些不怎麼可靠的成員，但是就像大樹，無論多繁茂，總會有些枯枝敗葉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000624
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000624,
					"content": "只要這些枯枝敗葉都散去了，剩下的…剩下的就一定是堅定可靠的…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000625
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000625,
					"content": "…矯論團怎麼會變成現在這個樣子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000626
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000626,
					"content": "我也想知道這個問題的答案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000627
					]
				},
				{
					"id": 737000627,
					"content": "正因為一直和矯論團的人類在一起，對於他們的種種變化反而難以察覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000628
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000628,
					"content": "#只有在和{F#妳}{M#你}們這樣的外來者對話時才發現，原來矯論團早已不是過去的樣子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000629
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000629,
					"content": "畢竟都過去幾百年了嘛，除了「矯論團」這個名字還和以前一樣，其中的成員一定都歷經了好幾代人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000630,
					"content": "我所希求的聲名，由人類「謁頌主」所傳頌的聲名難道最後也會像這樣…一切都改變了，只有空虛的名號本身仍存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000631
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000631,
					"content": "前輩就是想讓我知道這件事嗎？不應該是這樣的…可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000632
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 737000632,
					"content": "…斯露莎也不要這麼沮喪嘛！說不定…說不定祖爾宛不是這個意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000633,
					"content": "看到斯露莎無精打采的樣子，總覺得自己做了什麼壞事一樣…之後還是讓祖爾宛來勸勸她好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737000609,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737000610
					]
				},
				{
					"id": 737000610,
					"content": "#…{NICKNAME}{F#妳}{M#你}還是說點什麼吧！一言不發的樣子真的有點嚇人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737000611
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}