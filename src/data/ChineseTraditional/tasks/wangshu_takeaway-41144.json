			"dialogs": [
				{
					"id": 411440301,
					"content": "聽說有特別訂單…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411440302
					]
				},
				{
					"id": 411440302,
					"content": "#怎麼，{F#妳}{M#你}是來幫忙送餐的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440303
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411440303,
					"content": "哼，來得正好，有個叫鈴官的客人在我這點了一份松茸釀酒捲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411440304,
					"content": "她讓我晚些時候送到荻花洲西北面的一個地方，錢已經付好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411440305
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411440305,
					"content": "#怎麼樣，如果{F#妳}{M#你}有空的話，就幫忙送過去吧，報酬少不了{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
