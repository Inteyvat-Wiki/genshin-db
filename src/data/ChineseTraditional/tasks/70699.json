			"dialogs": [
				{
					"id": 706990101,
					"content": "能請到榮譽騎士前輩試玩遊藝設施實在是太幸運了，感覺安心了不少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990102
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990102,
					"content": "說實話，我還是第一次參與這種開發工作，有點緊張，感覺腦力常常不夠用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990103
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990103,
					"content": "明明只是幫一個成熟的機關裝上外殼，卻要顧及各方面的設計、除錯許多參數…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990104
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990104,
					"content": "要是像阿貝多長官那樣，從零開始製作專用裝備，不知道會遇見多少難題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990105,
						706990106
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990105,
					"content": "現在的成品已經很穩定了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				},
				{
					"id": 706990107,
					"content": "嗚啊…謝謝…謝謝榮譽騎士前輩的肯定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990108
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990108,
					"content": "我、我會加油的，努力在以後能獨自為游擊小隊開發出更多實用的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990109
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990109,
					"content": "#之前我贏來了幾隻玩偶，這一隻送給{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706990110
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990110,
					"content": "#我有一隻一樣的，以後，只要看到這個玩偶，我就能想起{F#妳}{M#你}給我的鼓勵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米卡"
				},
				{
					"id": 706990106,
					"content": "相信自己，你會不斷進步。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706990107
					]
				}
			]
		}
	]
