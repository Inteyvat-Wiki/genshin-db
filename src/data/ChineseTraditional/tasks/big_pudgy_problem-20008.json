				"points": []
			},
			"dialogs": [
				{
					"id": 200080101,
					"content": "#謝謝，謝謝{F#妳}{M#你}救了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080102
					],
					"speakerTitle": "亞瑟"
				},
				{
					"id": 200080102,
					"content": "這些史萊姆突然冒出來，我沒想到史萊姆會在這裡出現，還來不及跑就被它們圍住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080103
					],
					"speakerTitle": "亞瑟"
				},
				{
					"id": 200080103,
					"content": "你們千萬別告訴我爸。我爸本來要我一直待在家裡。他說最近這周圍的史萊姆都特別凶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080104
					],
					"speakerTitle": "亞瑟"
				},
				{
					"id": 200080104,
					"content": "而且史萊姆都開始出現在蒙德城周圍了，我已經悶在家裡好幾天了，今天是偷跑出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080105
					],
					"speakerTitle": "亞瑟"
				},
				{
					"id": 200080105,
					"content": "如果你們願意的話，能去前面看看嗎，如果有史萊姆的話，就請消滅它們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200080106,
						200080107
					],
					"speakerTitle": "亞瑟"
				},
				{
					"id": 200080106,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080108
					]
				},
				{
					"id": 200080108,
					"content": "太好了！我總算能安心去玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亞瑟"
				},
				{
					"id": 200080107,
					"content": "還有別的急事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200080109
					]
				},
				{
					"id": 200080109,
					"content": "#可，可是，我不敢告訴我爸…能處理這事的只有{F#妳}{M#你}，拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "亞瑟"
				}
			]
		}
	]
