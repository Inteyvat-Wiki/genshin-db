			"dialogs": [
				{
					"id": 705400101,
					"content": "嘶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400102
					],
					"speakerTitle": "「大桔騎士」"
				},
				{
					"id": 705400102,
					"content": "嗚…蘿莎莉亞小姐，牠好凶好凶，我好怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400103
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705400103,
					"content": "妳還是退後吧，不然會被牠抓成大花臉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400104
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705400104,
					"content": "怎麼回事？瓦樂瑞娜小姐被貓貓欺負了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400105,
						705400106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705400105,
					"content": "難道是流浪貓的入侵者…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				},
				{
					"id": 705400107,
					"content": "榮譽騎士！白貓魔法師！「雪糕」出去散步的時候，那隻大貓盯上了牠，跟著牠闖了進來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400108
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705400108,
					"content": "不用這麼緊張，這裡不會有人傷害妳的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400109
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705400109,
					"content": "凶惡的東西，會讓你去做壞事的傢伙們，都被城牆擋在外邊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400110
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705400110,
					"content": "有些老好人會圍著你轉，雖然偶爾有點煩，但他們都是為了你好。放鬆下來，習慣悠閒的生活，也還不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400111
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705400111,
					"content": "嘶——嗚——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400112
					],
					"speakerTitle": "「大桔騎士」"
				},
				{
					"id": 705400112,
					"content": "那，那隻大貓居然聽懂了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400113
					],
					"speakerTitle": "瓦樂瑞娜"
				},
				{
					"id": 705400113,
					"content": "好像有效果了，看來這隻貓還滿聰明的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400114
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705400114,
					"content": "比起其他的貓貓，牠好大好大，顏色又像泡泡桔的果汁。仔細看，牠還戴著一個圍巾，圍巾上還有騎士團的標誌呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705400115,
					"content": "不如，我們就叫牠「大桔騎士」好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705400116,
					"content": "喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400117
					],
					"speakerTitle": "「大桔騎士」"
				},
				{
					"id": 705400117,
					"content": "妳的方法還真靈驗，牠徹底放下了戒心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400118
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705400118,
					"content": "但我覺得，「大桔騎士」和蘿莎莉亞聊了兩句以後，就沒那麼凶了，所以這回是蘿莎莉亞立大功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400119,
						705400120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705400119,
					"content": "蘿莎莉亞和貓貓的關係變好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400121,
					"content": "無所謂吧，可愛的麻煩倒是不嫌多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705400122
					],
					"speakerTitle": "蘿莎莉亞"
				},
				{
					"id": 705400122,
					"content": "#接下來，{NICKNAME}，我們就多多使用貓貓魔法，讓不知道為什麼生氣的「大桔騎士」徹底放鬆下來，開開心心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705400120,
					"content": "蘿莎莉亞的特別工作更開心了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400121
					]
				},
				{
					"id": 705400106,
					"content": "又有點像貓貓獨行騎士。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705400107
					]
				}
			]
		}
	]
}