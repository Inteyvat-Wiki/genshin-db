				"points": []
			},
			"dialogs": [
				{
					"id": 4670101,
					"content": "下一道菜做什麼好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670102
					],
					"speakerTitle": "琳"
				},
				{
					"id": 4670102,
					"content": "#嗯？{F#妳}{M#你}們也是附近的冒險家嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670103
					],
					"speakerTitle": "琳"
				},
				{
					"id": 4670103,
					"content": "是路過的旅行者哦。妳是在準備做飯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4670104,
					"content": "是旅行者呀，歡迎歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670105
					],
					"speakerTitle": "琳"
				},
				{
					"id": 4670105,
					"content": "#我是琳，冒險家協會的生存專家，如{F#妳}{M#你}所見正在研究烹飪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670106
					],
					"speakerTitle": "琳"
				},
				{
					"id": 4670106,
					"content": "畢竟「吃飽了再上路」，是「野外生存守則」的第一條呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670107
					],
					"speakerTitle": "琳"
				},
				{
					"id": 4670107,
					"content": "野餐！我也很喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4670108,
					"content": "我的旅伴也很擅長烹飪哦，對吧對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670801,
						4670901
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4670801,
					"content": "只會一些最簡單的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670802
					]
				},
				{
					"id": 4670802,
					"content": "#沒關係，鍋子已經架好了，讓我看看{F#妳}{M#你}的手藝吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670803
					],
					"speakerTitle": "琳"
				},
				{
					"id": 4670803,
					"content": "生存專家親自指導，機會可不多哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "琳"
				},
				{
					"id": 4671001,
					"content": "我放了些蘑菇和肉在那邊的桶裡，試著做一份<color=#00E1FFFF>「野菇雞肉串」</color>給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳"
				},
				{
					"id": 4670901,
					"content": "沒錯，我也喜歡烹飪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4670902
					]
				},
				{
					"id": 4670902,
					"content": "#哦！鍋子已經架好了，讓我看看{F#妳}{M#你}的手藝吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4670903
					],
					"speakerTitle": "琳"
				},
				{
					"id": 4670903,
					"content": "有這樣切磋廚藝的機會真是難得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4671001
					],
					"speakerTitle": "琳"
				}
			]
		},
