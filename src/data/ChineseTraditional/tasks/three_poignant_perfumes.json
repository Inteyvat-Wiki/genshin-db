	"talks": [
		{
			"id": 101202,
			"completionStepIds": [
				101202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101202",
							"2"
						],
						"stepId": 101202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博來"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10120201,
					"content": "老闆，你們這裡有霓裳花嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120202,
					"content": "霓裳花？當然有，要哪一種？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120203
					],
					"speakerTitle": "博來"
				},
				{
					"id": 10120203,
					"content": "唔…哪一種？就、就是，最好的那種？原來霓裳花還有很多種的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120204,
					"content": "哼，沒見過世面的外國人，還問這種問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120205
					],
					"speakerTitle": "博來"
				},
				{
					"id": 10120205,
					"content": "「金屋藏嬌」、「山陰錦簇」、「縹緲仙緣」，這三種霓裳花，麻煩老闆各拿一株來看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120206
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120206,
					"content": "——喔！這位老爺，是大行家啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120207
					],
					"speakerTitle": "博來"
				},
				{
					"id": 10120207,
					"content": "身邊兩個，是僕人吧。僕人就別搶在老爺之前開口了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120208,
						10120209,
						10120210
					],
					"speakerTitle": "博來"
				},
				{
					"id": 10120208,
					"content": "終於有一天，輪到我了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120212
					]
				},
				{
					"id": 10120212,
					"content": "請，請，貴客看看吧，還有什麼想法，也請說道說道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120213
					],
					"speakerTitle": "博來"
				},
				{
					"id": 10120213,
					"content": "嗯，根據生長環境與祖先親族的不同，霓裳花會呈現出不同的性狀…老闆這幾株都不錯，保存得很新鮮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120214
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120214,
					"content": "比如這種，枝繁葉茂，花蕊如金屋藏嬌。綠葉長存，多生於有複雜水文條件之地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120215
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120215,
					"content": "而山陰或者潮濕之地，霓裳花多生得瓣大而蕊密，香氣撲鼻，堪稱花團錦簇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120216
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120216,
					"content": "最後這類則是孤傲清冷，枝、葉、花排佈極疏，開花時香氣寡淡，卻極為持久，是古人登山訪仙時偶然發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120217
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120217,
					"content": "不過時至今日，大多野生的霓裳花都在璃月地理變遷的過程中絕跡了，現在多是依靠人工培育…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120218
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120218,
					"content": "哎，先生確實是行家，連我自己都不知道有這麼多講究…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120219
					],
					"speakerTitle": "博來"
				},
				{
					"id": 10120219,
					"content": "略通一二而已。我這位旅行家朋友才是不容小覷，是終將踏遍大陸各處之人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120220,
						10120221
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120220,
					"content": "其實也沒那麼厲害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120222
					]
				},
				{
					"id": 10120222,
					"content": "鍾離先生太客氣了…那麼這三種霓裳花，我們該選哪種呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120223,
					"content": "老闆，我全要了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120224
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120224,
					"content": "又來？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120225,
					"content": "呵，聽戲時要點最紅的名伶，遛鳥時要買最名貴的畫眉——此即人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120226
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120226,
					"content": "不過，這次買三種霓裳花，倒不是出於我的人生信條。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120227
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120227,
					"content": "妳有所不知，根據傳統，若將不同的霓裳花分別做成香膏，供奉在「七天神像」前，岩王帝君便會自己作出選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120228
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120228,
					"content": "不過這種古早時期的講究，和一些過於複雜的傳統，都已經逐漸被簡化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120229
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120229,
					"content": "但這是三千七百年來，唯一屬於七神之一的「送仙典儀」。我們還是遵照傳統，逐一供奉這些香膏吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120230
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120230,
					"content": "#嗯，所以…嗯…{F#妳}{M#你}們有帶錢嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120231
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120231,
					"content": "你又沒帶錢嗎——！鍾離——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120232,
						10120233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120232,
					"content": "好像已經習慣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120234
					]
				},
				{
					"id": 10120234,
					"content": "…呃，客官們，不好意思，插一句嘴。你們是要把這些花，獻給岩王爺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120235
					],
					"speakerTitle": "博來"
				},
				{
					"id": 10120235,
					"content": "這麼說也沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120236,
					"content": "唉，你們應該早說…那次「請仙典儀」之後，我也聽到了不好的消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120237
					],
					"speakerTitle": "博來"
				},
				{
					"id": 10120237,
					"content": "不吉利的話，就不說了。總之我也一直很擔心岩王爺，擔心那個消息是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120238
					],
					"speakerTitle": "博來"
				},
				{
					"id": 10120238,
					"content": "如果是為了岩王爺的話，這些花就不收你們的錢了，替我帶一份心意就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120239
					],
					"speakerTitle": "博來"
				},
				{
					"id": 10120239,
					"content": "這、真的合適嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120240,
					"content": "瞧妳這話說的，沒有岩王爺，就沒有我這種小民的棲身之地呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120241
					],
					"speakerTitle": "博來"
				},
				{
					"id": 10120241,
					"content": "若不是當年岩王爺題詩，這些珍品霓裳花的身價，哪能這麼金貴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120242
					],
					"speakerTitle": "博來"
				},
				{
					"id": 10120242,
					"content": "哇…一路上聽到的璃月風土人情，很多都是在某個時期，受到過神靈本人的直接關懷呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120243,
					"content": "…總之，要謝謝老闆了，解了我們的燃眉之急。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120244
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120244,
					"content": "忘帶錢還不是鍾離的錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120245,
					"content": "唉，不過是一點小意思罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博來"
				},
				{
					"id": 10120233,
					"content": "他帶了的話可能更奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120234
					]
				},
				{
					"id": 10120221,
					"content": "我的確對霓裳花很無知…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120222
					]
				},
				{
					"id": 10120209,
					"content": "這是把派蒙當應急食品的報應嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120212
					]
				},
				{
					"id": 10120210,
					"content": "不，你不覺得我有點眼熟嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120211
					]
				},
				{
					"id": 10120211,
					"content": "嗯？我們好像見過…哦，是旅者吧，不好意思了，剛才語氣不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120212
					],
					"speakerTitle": "博來"
				}
			]
		},
		{
			"id": 101203,
			"completionStepIds": [
				101203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
