				"objectNames": [
					"綺命"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10120401,
					"content": "嗯？有什麼事嗎，二位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120402
					],
					"speakerTitle": "綺命"
				},
				{
					"id": 10120402,
					"content": "綺命小姐有空的話，想問妳件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120403,
						10120405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120403,
					"content": "綺命小姐會熬香膏嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120404
					]
				},
				{
					"id": 10120404,
					"content": "香膏啊…我平時不用的，也沒想過自己去熬製。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120411
					],
					"speakerTitle": "綺命"
				},
				{
					"id": 10120411,
					"content": "#不過我的身上應該會有一些脂粉的味道，可能讓{F#妳}{M#你}們誤會了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120412
					],
					"speakerTitle": "綺命"
				},
				{
					"id": 10120412,
					"content": "我平常在碼頭附近擺攤，可不希望香膏引來更多色眯眯的水手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120413
					],
					"speakerTitle": "綺命"
				},
				{
					"id": 10120413,
					"content": "這樣呀，好遺憾哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120414,
					"content": "#不過，說起香膏，{F#妳}{M#你}們居然沒聽說過「鶯兒的手工香膏」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120415
					],
					"speakerTitle": "綺命"
				},
				{
					"id": 10120415,
					"content": "鶯兒，是…「春香窯」的那位<color=#00E1FFFF>鶯兒</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120416,
					"content": "是的，許多人家的千金小姐，都會拜託她熬香膏來用。據說她手工自製的品質，比市面上販賣的還要好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120417
					],
					"speakerTitle": "綺命"
				},
				{
					"id": 10120417,
					"content": "太好了，謝謝妳的情報！這下應該不會再撲個空啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120405,
					"content": "綺命小姐聞起來很香。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120406
					]
				},
				{
					"id": 10120406,
					"content": "啊…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120407
					],
					"speakerTitle": "綺命"
				},
				{
					"id": 10120407,
					"content": "#…抱歉，沒想到{F#妳}{M#你}會這麼直白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120408
					],
					"speakerTitle": "綺命"
				},
				{
					"id": 10120408,
					"content": "#不過我對{F#妳}{M#你}其實還不是十分瞭解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120409
					],
					"speakerTitle": "綺命"
				},
				{
					"id": 10120409,
					"content": "嗯？我們的意思是想問妳平時用不用香膏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120410,
					"content": "啊，咳咳…香膏的話，我沒有在用哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120411
					],
					"speakerTitle": "綺命"
				}
			]
		},
		{
			"id": 101205,
			"completionStepIds": [
				101205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101205",
							"2"
						],
						"stepId": 101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鶯兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10120501,
					"content": "#欸，終於找到我了嗎？我可是等{F#妳}{M#你}們好久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120502
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120502,
					"content": "嗯？妳怎麼會知道我們要過來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120503,
					"content": "我剛聽說有兩個人在滿城找身上很香的人下手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120504
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120504,
					"content": "#我還擔心{F#妳}{M#你}們不會來呢，某種意義上講，這也是對我魅力的考驗呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120505
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120505,
					"content": "「下手」？怎麼說得我們好像是危險人物的樣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120506,
					"content": "以訛傳訛，三人成虎，言行最好謹慎一些哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120507
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120507,
					"content": "#放心，我知道{F#妳}{M#你}們的來意，是想我幫忙做香膏吧？需要什麼樣的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120508,
						10120509
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120508,
					"content": "想用這三種霓裳花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120513
					]
				},
				{
					"id": 10120513,
					"content": "欸~居然要同時做三份…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120514
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120514,
					"content": "想不到明明這麼年輕，胃口卻不小呢，呵呵。該不會之前的傳言是真的吧？是在物色可以送香膏的目標嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120515,
						10120518
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120515,
					"content": "是要獻給「岩王帝君」的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120516
					]
				},
				{
					"id": 10120516,
					"content": "噗…情急之下編了個這樣的藉口嗎？就算是獻給神明，也不需要這麼多種類吧？漏洞百出呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120517
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120517,
					"content": "唔…好像鍾離也說過，這種傳統已經被遺忘很久了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120520,
					"content": "#總之，「花開堪折直須折，莫待無花空折枝」…誰又能說{F#妳}{M#你}做得不對呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120521
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120521,
					"content": "咦，派蒙又聽不懂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120522,
					"content": "#好了，我幫{F#妳}{M#你}做就是了。來當我的助手吧。在熬香膏的這段時間裡，{F#妳}{M#你}可得把心思放在我一個人身上呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120523
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120523,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120524
					]
				},
				{
					"id": 10120524,
					"content": "那麼，去哪裡熬香膏比較好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120525,
						10120528
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120525,
					"content": "達達烏帕谷裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120526
					]
				},
				{
					"id": 10120526,
					"content": "那是哪裡…是蒙德嗎？熬製香膏而已，不用那麼大動干戈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120527
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120527,
					"content": "不如選個近一點的地方，就去借用一下<color=#00E1FFFF>「萬民堂」</color>的廚房吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120528,
					"content": "香菱家的廚房…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120529
					]
				},
				{
					"id": 10120529,
					"content": "#哦，{F#妳}{M#你}說的是<color=#00E1FFFF>「萬民堂」</color>？不錯的選擇，那我們一起過去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120518,
					"content": "有什麼不好呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120519
					]
				},
				{
					"id": 10120519,
					"content": "#欸呀！出人意料的坦蕩呢。不過{F#妳}{M#你}長得這麼俊，也確實有拈花惹草的資本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120520
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120509,
					"content": "就想要妳用的那種。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120510
					]
				},
				{
					"id": 10120510,
					"content": "呵呵，我根本沒用什麼香膏哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120511
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120511,
					"content": "#莫非{F#妳}{M#你}迷上我的體香了？那可就讓人為難了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120512
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10120512,
					"content": "#欸…{F#妳}{M#你}們在說什麼奇怪的話？{NICKNAME}，快把那三種霓裳花拿出來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120513
					],
					"speakerTitle": "派蒙"
				}
			]
		},
