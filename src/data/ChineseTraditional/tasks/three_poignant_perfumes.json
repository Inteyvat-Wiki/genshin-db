				},
				{
					"id": 10121306,
					"content": "#嗯~三種香膏都順利完成了。助手，{F#妳}{M#你}的工作完成得不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121307
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121307,
					"content": "#這也說明…{F#妳}{M#你}是個願意為了感情而努力的人呀，真是難得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121308,
						10121309
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121308,
					"content": "都說了不是這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10121312
					]
				},
				{
					"id": 10121312,
					"content": "#好了好了，要我幫{F#妳}{M#你}介紹一下這幾種香膏嗎？可以方便{F#妳}{M#你}對症下藥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121313
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121313,
					"content": "派蒙也要聽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10121314,
					"content": "這第一種香膏呢，甜蜜而夢幻的感覺…是小女孩們最喜歡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121315
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121315,
					"content": "第二種聞上去貴氣凌人，是富家千金們的最愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121316
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121316,
					"content": "最後一種香氣輕柔卻久久不散，如天光昏暗霧色朦朧，最受成熟女性們的歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121317
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121317,
					"content": "記住了嗎？可別用錯場合呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121318
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121318,
					"content": "記，記住了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10121319
					]
				},
				{
					"id": 10121319,
					"content": "好，那需要我幫忙的地方，就到這裡了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121320
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121320,
					"content": "#那麼，最後再送{F#妳}{M#你}一句話吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121321
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121321,
					"content": "想腳踏三條船，可要想好先抬哪隻腳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121322
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121322,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10121323
					]
				},
				{
					"id": 10121323,
					"content": "呵呵，有空再來「春香窯」陪陪我吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121309,
					"content": "我剛才只想著妳哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10121310
					]
				},
				{
					"id": 10121310,
					"content": "#欸呀，{F#妳}{M#你}居然還記得我隨口一提的約定嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121311
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121311,
					"content": "#{F#妳}{M#你}比預想中更討人喜歡呢，若是不當心的話…連我都可能會動心了，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121312
					],
					"speakerTitle": "鶯兒"
				}
			]
