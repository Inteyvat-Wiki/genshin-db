						10121202
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121202,
					"content": "#接下來就要請{F#妳}{M#你}幫忙，去合成台，從霓裳花裡提煉出精油了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121203
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121203,
					"content": "#製造香膏的手法，和煉金的手法大不相同，我來教{F#妳}{M#你}吧。要像這樣，輕輕地…溫柔地握住臼杵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121204
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121204,
					"content": "手掌也要注意緊貼，這樣才不容易滑脫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121205
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121205,
					"content": "#然後用{F#妳}{M#你}最順手的節奏攪動…直到霓裳花的汁水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121206,
						10121207
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121206,
					"content": "放心，我很在行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10121208
					]
				},
				{
					"id": 10121208,
					"content": "嗯~果然有這方面的天賦，一說就懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121209
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121209,
					"content": "帶上這些，到附近的<color=#00E1FFFF>合成台</color>去試試吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10121210
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121210,
					"content": "#記得，三種都要製作哦。雖然在精油階段的外形很相似，但製成香膏以後，我會用不同的盒子幫{F#妳}{M#你}裝好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 10121207,
					"content": "好了好了，我明白了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10121208
					]
				}
