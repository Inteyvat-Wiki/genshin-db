						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嵐姐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10120301,
					"content": "嵐姐，我們想請妳幫個忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120302,
					"content": "我已經很長時間不接委託了，不好意思二位，請找其他冒險家吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120303
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 10120303,
					"content": "不用掛委託啦，只是很小很小的一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120304,
						10120307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120304,
					"content": "嵐姐會熬香膏嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120305
					]
				},
				{
					"id": 10120305,
					"content": "…唔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120306
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 10120306,
					"content": "#我看上去像是會用那種東西的人嗎，總感覺被{F#妳}{M#你}小瞧了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120311
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 10120311,
					"content": "可是嵐姐身上確實很香呀，不是香膏的話，會是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120312,
					"content": "這麼說來，確實好像有一股香味，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120313
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 10120313,
					"content": "哦，莫非是我上次回來時採摘的「清心」？原來我一直帶在身上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120314
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 10120314,
					"content": "欸，原來是這樣啊…嵐姐竟然還有在路邊摘花的雅興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120315,
					"content": "…唔，不過是藥用而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120316
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 10120316,
					"content": "#不要繼續這種無意義的話題了，香膏的話…{F#妳}{M#你}們不如去找<color=#00E1FFFF>綺命</color>問問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120317
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 10120317,
					"content": "是那位占卜師姐姐吧？嗯，確實給人香香的印象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120318,
					"content": "那我們先走啦，謝謝嵐姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120307,
					"content": "嵐姐聞起來很香。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120308
					]
				},
				{
					"id": 10120308,
					"content": "…唔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120309
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 10120309,
					"content": "讓我確定一下你們是不是在捉弄我，或者說什麼反話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120310
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 10120310,
					"content": "我常年在外奔走，雖然也很注意打理自己，但要說「聞起來很香」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120311
					],
					"speakerTitle": "嵐姐"
				}
			]
		},
		{
			"id": 101204,
			"completionStepIds": [
				101204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
