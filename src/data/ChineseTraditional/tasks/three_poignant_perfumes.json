			},
			"dialogs": [
				{
					"id": 10120801,
					"content": "鍾離先生！我們把香膏帶過來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120802,
					"content": "鍾離先生…剛才好像在對著神像發呆呢，是不是讓你等得太久啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120803,
					"content": "#哦，{F#妳}{M#你}們回來了，我也沒有等很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120804
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120804,
					"content": "比起神像所刻的岩王帝君的守望，不過是短短一瞬而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120805
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120805,
					"content": "哈哈，人怎麼能跟雕像比呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120806,
					"content": "#說得也是。如何，{F#妳}{M#你}們把香膏帶來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120807
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120807,
					"content": "三份香膏，一份不少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120808,
					"content": "辛苦二位了，我們試著依次供奉上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120809
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120809,
					"content": "（供奉「金屋藏嬌」）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120810
					]
				},
				{
					"id": 10120810,
					"content": "這是第一種香膏，鶯兒小姐說它甜蜜夢幻，是小女孩們最喜歡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120811,
					"content": "（供奉「山陰錦簇」）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120812
					]
				},
				{
					"id": 10120812,
					"content": "這是第二種香膏，說是貴氣凌人，富家千金的最愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120813,
					"content": "（供奉「縹緲仙緣」）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120814
					]
				},
				{
					"id": 10120814,
					"content": "第三種香膏，香氣輕柔卻久久不散，如霧色朦朧…什麼什麼的，最受成熟女性的歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120815,
					"content": "欸…剛才那是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120816,
						10120817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120816,
					"content": "「岩王帝君」很喜歡的樣子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120818
					]
				},
				{
					"id": 10120818,
					"content": "那是成熟的大姐姐喜歡用的款式吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120819,
					"content": "難道說…「岩王帝君」其實是一位大姐姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120820,
					"content": "哈哈哈…說不定呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120821
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120821,
					"content": "「岩王帝君」的化身有萬萬千千，或許真有這麼一個形象存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120822
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120822,
					"content": "可惜我們只見過那個特別巨大的龍形，而且…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120823,
					"content": "希望「璃月七星」能抓到真正的兇手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120824
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120824,
					"content": "那些就留給位高權重之人去苦惱吧，我們只需做好與「岩王帝君」的餞別之禮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120825,
						10120826
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120825,
					"content": "（七星和公子，究竟各有什麼圖謀…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120827
					]
				},
				{
					"id": 10120827,
					"content": "所以，我們又完成了一項準備工作呢。下一項該是什麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120828
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120828,
					"content": "接下來…希望二位可以代我去借一下「滌塵鈴」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120829
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120829,
					"content": "「滌塵鈴」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120830
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120830,
					"content": "#如今，保管「滌塵鈴」的是我的一位朋友，叫做萍姥姥。她人在玉京臺附近，{F#妳}{M#你}們向她問，她自然知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120831
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120831,
					"content": "好的…可是，這次鍾離先生不和我們同去了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120832
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120832,
					"content": "嗯，我有些不便露面的理由，麻煩二位代勞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10120833
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10120833,
					"content": "欸…這次鍾離先生的態度，怎麼神神秘秘的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10120826,
					"content": "（算了，為了見到「仙祖法蛻」…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120827
					]
				},
				{
					"id": 10120817,
					"content": "看來答案是第三種香膏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10120818
					]
				}
			]
