		{
			"id": 7106211,
			"completionStepIds": [
				7106207
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106207",
							"2"
						],
						"stepId": 7106207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安東",
					"拉多米爾",
					"達尼拉",
					"提莫爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710621101,
					"content": "#{F#妳}{M#你}們回來了，怎麼樣，有什麼新的消息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621102
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621102,
					"content": "補給站已經廢棄了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621103
					]
				},
				{
					"id": 710621103,
					"content": "#這樣嗎…那麼，{F#妳}{M#你}們有找到什麼東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621104
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621104,
					"content": "璃月港不再歡迎你們了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621105
					]
				},
				{
					"id": 710621105,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621106
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621106,
					"content": "除此之外，還有什麼消息嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621107
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621107,
					"content": "唔…我們還找到了一封信，好像是留給你的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710621108,
					"content": "在這裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621109
					]
				},
				{
					"id": 710621109,
					"content": "信件在愚人眾成員之間傳遞了一會…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710621110
					]
				},
				{
					"id": 710621110,
					"content": "啊，是彦博老弟。我明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621111
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621111,
					"content": "怎麼了？千岩軍都撤走了？給我也看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621112
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710621112,
					"content": "唉，這些傢伙是怎麼回事…我們是在為他們而戰的！我們應該是盟友才對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621113
					],
					"speakerTitle": "達尼拉"
				},
				{
					"id": 710621113,
					"content": "現在沒有「盟友」了！我們已經斷交了…準確來講是作為「愚人眾」的我們，已經和璃月斷交了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621131
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710621131,
					"content": "這是背叛！我們被璃月人背叛了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621132
					],
					"speakerTitle": "提莫爾"
				},
				{
					"id": 710621132,
					"content": "或許對璃月人來說恰恰相反呢？是我們，作為「愚人眾」的我們背叛了他們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621114
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710621114,
					"content": "開什麼玩笑…我們是來保護璃月人的！還記得大尉在出發前說的話嗎？這次遠征無關任何小算盤和陰謀詭計！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621115
					],
					"speakerTitle": "達尼拉"
				},
				{
					"id": 710621115,
					"content": "但是攔不住小算盤和陰謀詭計上了我們的身…這事不是我們能控制得了的，達尼拉兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621116
					],
					"speakerTitle": "提莫爾"
				},
				{
					"id": 710621116,
					"content": "好了，我明白了。呼…我決定了，我們需要撤離這裡，愈快愈好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621117
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621117,
					"content": "沒關係，責任全由我承擔就好。如果我們之中存在逃兵…如果有逃兵讓第九連隊蒙羞，那個逃兵就是我，只有我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621118
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621118,
					"content": "達尼拉說得對，我們是來保護璃月人免遭黑災侵染的，我們不能就這麼灰溜溜離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621119
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710621119,
					"content": "現在是談個人自尊的時間嗎，米爾卡？你還沒看出來嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621120
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621120,
					"content": "璃月人不需要我們保護，璃月人也不歡迎我們！他們甚至擊敗了我們那些自鳴得意的戰友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621121,
						710621122
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621121,
					"content": "沒錯，是你們辜負了璃月的信任。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				},
				{
					"id": 710621123,
					"content": "我們準備撤離吧，一定要盡可能悄無聲息地走，不要驚動了本地的千岩軍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621124
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621124,
					"content": "大尉說我們是抱著不再回家的覺悟來的。我們至少也要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621125
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710621125,
					"content": "大尉一樣說過，他不會讓任何人的犧牲毫無意義！大尉一樣說過，他不希望我把連隊斷送掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621126
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621126,
					"content": "至少我們還活著，就意味著第九連隊的番號還存在，明白了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621127
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621127,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621128
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710621128,
					"content": "明白，連長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621129
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710621129,
					"content": "好了，還有人有任何問題嗎？我不想聽到任何反對意見。解散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621130
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621130,
					"content": "#無論如何，{NICKNAME}，感謝{F#妳}{M#你}們的幫忙。這些摩拉和物資請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東"
				},
				{
					"id": 710621122,
					"content": "你們還是考慮一下自己的後路吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710621123
					]
				}
			]
		},
