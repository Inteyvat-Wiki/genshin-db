					"安東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620137,
					"content": "先告訴我你們的目的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620140
					]
				},
				{
					"id": 710620140,
					"content": "#這麼說吧，不論{F#妳}{M#你}們懷著怎樣的疑慮…我們的任務只針對層岩巨淵的災難之源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620141
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620141,
					"content": "什麼災難呀…層岩巨淵不是還好好的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710620142,
					"content": "五百年前的災變，只是戰爭的前奏而已。對抗漆黑大敵的戰爭一直持續著，而戰場之一就在我們的腳下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620143
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620143,
					"content": "唉，我們的上士連長都餓到說大話了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620144
					],
					"speakerTitle": "達尼拉"
				},
				{
					"id": 710620144,
					"content": "他一直都愛說大話…可說胡話還是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620145
					],
					"speakerTitle": "提莫爾"
				},
				{
					"id": 710620145,
					"content": "算啦，算啦…安托哈說的是這個道理。簡單來說就是…你們，璃月人，不是我們的敵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620146
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710620146,
					"content": "至少不是我們第九連隊在這場行動中的敵人…不過，另一些被打散的弟兄就不一定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620147
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620147,
					"content": "出於人道我會幫你，但下不為例。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620148
					]
				},
				{
					"id": 710620148,
					"content": "#謝謝…謝謝{F#妳}{M#你}們，我們是不會忘記的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東"
				}
			]
		},
