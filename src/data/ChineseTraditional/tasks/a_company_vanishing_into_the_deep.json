	"talks": [
		{
			"id": 7106201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106201",
							"2"
						],
						"stepId": 7106201,
						"stateName": "QUEST_STATE_UNFINISHED"
