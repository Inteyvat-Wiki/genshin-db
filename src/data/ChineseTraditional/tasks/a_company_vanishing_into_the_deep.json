				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"安東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620101,
					"content": "#呼…如果{F#妳}{M#你}們在趕路的話抱歉打擾，我是安東·梅利尼科夫上士，第九連隊的…代理連長。叫我安東就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620102
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620102,
					"content": "這幾位，分別是達尼拉、提莫爾、拉多米爾和…呃，羅曼斯基，他現在不在這裡，他在…衛生營地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620103
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620103,
					"content": "沒有羅曼斯基了，也沒有衛生營地了，安托哈…他沒撐過今早。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620104
					],
					"speakerTitle": "達尼拉"
				},
				{
					"id": 710620104,
					"content": "達尼拉，達尼拉…我說過多少次了，我是連長，叫我安東上士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620105
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620105,
					"content": "哈！連長！上士！安托哈你這傢伙…自從大尉失蹤以後，你這狐假虎威的傢伙倒是把大尾巴豎起來了！哈！哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620106
					],
					"speakerTitle": "提莫爾"
				},
				{
					"id": 710620106,
					"content": "夠了，提莫爾老弟…你餓壞腦子了。省省體力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620107
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710620107,
					"content": "是「代理連長」，安托哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620149
					],
					"speakerTitle": "達尼拉"
				},
				{
					"id": 710620149,
					"content": "「代理連長」！「代理連長」！我們還要跟著這個拿雞毛當令箭的繡花枕頭多久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620150
					],
					"speakerTitle": "提莫爾"
				},
				{
					"id": 710620150,
					"content": "我說，提莫爾你是餓壞腦子了，何不吃點拳頭清醒一下呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620151
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710620151,
					"content": "好呀，來啊！也讓我餵你幾腳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620152
					],
					"speakerTitle": "提莫爾"
				},
				{
					"id": 710620152,
					"content": "太好了，現在輪到把理智和耐心咽下肚子裡消化殆盡了…真是太好了。耗盡了這點精神，我們剩下的能量可真的不多囉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620108
					],
					"speakerTitle": "達尼拉"
				},
				{
					"id": 710620108,
					"content": "咳咳…！給我安靜！你們要打架嗎？想打架的話就下去打！和黑泥巴裡面冒出來的那些東西打！餓著肚子去啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620109
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620109,
					"content": "我們想要活下去，想要撤離這裡，就必須團結一致！不要，再讓我，重複，明白？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620110
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620110,
					"content": "一、二、口號！捨我其誰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620111
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620111,
					"content": "捨我其誰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620112
					],
					"speakerTitle": "達尼拉"
				},
				{
					"id": 710620112,
					"content": "捨我其誰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620113
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710620113,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620153
					],
					"speakerTitle": "提莫爾"
				},
				{
					"id": 710620153,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620114
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620114,
					"content": "#呃，呵呵…朋友，{F#妳}{M#你}也看到了，我們稍微有點…咳咳，不在戰鬥狀態。畢竟…最近遇到了一點小小的挫折。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620115
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620115,
					"content": "哼…「小小的挫折」！倒是跟大尉學得挺像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620116
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710620116,
					"content": "大尉不在這裡，我就是連長！省省你的力氣，給我閉嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620117
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620117,
					"content": "#抱歉…朋友，我們現在急需{F#妳}{M#你}的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東"
				}
			]
		},
