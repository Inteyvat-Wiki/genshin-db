			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"安東",
					"達尼拉",
					"提莫爾",
					"拉多米爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620701,
					"content": "這群傢伙好弱呀，三拳兩腳就解決了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710620702,
					"content": "#請{F#妳}{M#你}們停下！求{F#妳}{M#你}們不要再打了！只要給我們分一點食物，我們願意聽從{F#妳}{M#你}們任意處置！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620703
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620703,
					"content": "哼…這些傢伙看起來是真的餓得受不了了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620704,
						710620705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710620704,
					"content": "先告訴我你們的目的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				},
				{
					"id": 710620706,
					"content": "#這麼說吧，不論{F#妳}{M#你}們懷著怎樣的疑慮…我們的任務只是針對層岩巨淵的災難之源的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620707
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620707,
					"content": "什麼災難呀…層岩巨淵不是還好好的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710620708,
					"content": "五百年前的災變，只是戰爭的前奏而已。對抗漆黑大敵的戰爭一直持續著，戰場之一就在我們的腳下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620709
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620709,
					"content": "唉，我們的上士連長都餓到說大話了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620710
					],
					"speakerTitle": "達尼拉"
				},
				{
					"id": 710620710,
					"content": "他一直都愛說大話…可說胡話還是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620711
					],
					"speakerTitle": "提莫爾"
				},
				{
					"id": 710620711,
					"content": "算啦，算啦…安托哈說的不是沒有道理，你們，璃月人，不是我們的敵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620712
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710620712,
					"content": "至少不是我們這支部隊的敵人…另一些被打散的弟兄就不一定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620713
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620713,
					"content": "好吧…我會幫你，但下不為例。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 710620705,
					"content": "我該怎麼信任你們？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620706
					]
				}
			]
		},
		{
			"id": 7106209,
			"completionStepIds": [
				7106205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7106205",
							"2"
						],
						"stepId": 7106205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安東",
					"達尼拉",
					"提莫爾",
					"拉多米爾",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710620901,
					"content": "唉…真是抱歉。我們的指揮網發生了一點小小的…故障…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620902
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620902,
					"content": "「小小的」！「故障」？！我們在手足相殘了！我們在眼睜睜看著外人把自己的戰友打跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620903
					],
					"speakerTitle": "達尼拉"
				},
				{
					"id": 710620903,
					"content": "否則呢？我們要讓他們把我們打跑，搶走我們的食物嗎？我建議你把嘴裡的東西都咽下去再說話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620904
					],
					"speakerTitle": "提莫爾"
				},
				{
					"id": 710620904,
					"content": "安托哈，不要輕描淡寫了…我們的指揮網被摧毀了，完蛋了。尉官以上的所有軍官都犧牲或失蹤了…除了撤退別無選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620905
					],
					"speakerTitle": "拉多米爾"
				},
				{
					"id": 710620905,
					"content": "但很多人還不願意撤退…他們寧願守著長官的遺物戰到最後一人倒下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620906
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620906,
					"content": "是餓到最後一人…按照合作協定，上面給我們輸送食物和命令，但我們很久沒有接到上面的消息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620907
					],
					"speakerTitle": "達尼拉"
				},
				{
					"id": 710620907,
					"content": "我們對愚人眾和執行官大人的忠誠不容質疑是沒錯，但我們也不是傻子…至於現在這種情況，唯有撤離才是上策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620908
					],
					"speakerTitle": "提莫爾"
				},
				{
					"id": 710620908,
					"content": "所以你們有何打算？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620909
					]
				},
				{
					"id": 710620909,
					"content": "#嗯…我知道，這事可能與{F#妳}{M#你}無關。如果{F#妳}{M#你}想轉頭就走也悉聽尊便，但我們確實陷入了絕境，急需{F#妳}{M#你}的幫助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620910,
						710620912
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620910,
					"content": "我需要考慮一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620911
					]
				},
				{
					"id": 710620911,
					"content": "好吧…前路請注意安全。還留在周圍的其他戰友們就不會像我們這樣友好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620913
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620913,
					"content": "#雖然告知{F#妳}{M#你}很不合適，但…在靠近地面的地方有一處補給站。負責為我們轉運物資，有時也負責傳送命令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620914
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620914,
					"content": "此前派出了幾位戰友上去請求調撥食物，但他們一直沒有回來…我擔負不起再一次冒險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620915
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620915,
					"content": "#而補給站那邊也很久沒有下來過人了…我們希望{F#妳}{M#你}能替我們前去偵查一下他們的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620916,
						710620917
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620916,
					"content": "請讓我稍事考慮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620918,
					"content": "#拜託{F#妳}{M#你}這種事情實在抱歉，但我們需要瞭解地面據點的情況…否則不好擅自行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710620919
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710620919,
					"content": "好啦！不要說那麼多難懂的話啦！我們路過的時候會注意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710620917,
					"content": "我會幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620918
					]
				},
				{
					"id": 710620912,
					"content": "你需要我幫什麼忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710620913
					]
				}
			]
		},
		{
