			"dialogs": [
				{
					"id": 710621001,
					"content": "#無論如何，多謝{F#妳}{M#你}分享食物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710621002
					],
					"speakerTitle": "安東"
				},
				{
					"id": 710621002,
					"content": "我們會想辦法離開這裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東"
				}
