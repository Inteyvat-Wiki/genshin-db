			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"羅爾夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760920101,
					"content": "#躲遠一點，朋友！這地方很危險，等等要是「狂獵」出現了，我可沒有多餘的心力保護{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920102,
						760920109,
						760920112
					],
					"speakerTitle": "羅爾夫"
				},
				{
					"id": 760920102,
					"content": "你怎麼知道會有「狂獵」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920103
					]
				},
				{
					"id": 760920103,
					"content": "作為執燈人，應對「狂獵」災禍是我的職責，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920104
					],
					"speakerTitle": "羅爾夫"
				},
				{
					"id": 760920104,
					"content": "看見旁邊這個汐印石了嗎？為了確保對「狂獵」的清剿萬無一失，我得在這盯上三天三夜才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920105
					],
					"speakerTitle": "羅爾夫"
				},
				{
					"id": 760920105,
					"content": "汐印石？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920106
					]
				},
				{
					"id": 760920106,
					"content": "汐印石是我們執燈人為了驅散「狂獵」的氣息所設置的封印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920107
					],
					"speakerTitle": "羅爾夫"
				},
				{
					"id": 760920107,
					"content": "雖然我也不清楚其中的原理，不過通常來說，出現過「狂獵」的地方所殘留的氣息，很容易將它們再次引來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920108
					],
					"speakerTitle": "羅爾夫"
				},
				{
					"id": 760920108,
					"content": "因此在擊退「狂獵」後，我們便會設置這種汐印石。如果附近再有「狂獵」出現，它也能在戰鬥中庇佑我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅爾夫"
				},
				{
					"id": 760920109,
					"content": "我才不怕什麼「狂獵」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920110
					]
				},
				{
					"id": 760920110,
					"content": "#雖然不知道{F#妳}{M#你}哪來的這種自信，不過「狂獵」可不是能隨便應付的敵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760920111
					],
					"speakerTitle": "羅爾夫"
				},
				{
					"id": 760920111,
					"content": "聽我的勸告，遇到有這種汐印石的地方，還是小心謹慎比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅爾夫"
				},
				{
					"id": 760920112,
					"content": "不打擾了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760920113
					]
				},
				{
					"id": 760920113,
					"content": "好的，路上小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅爾夫"
				}
			]
		},
		{
