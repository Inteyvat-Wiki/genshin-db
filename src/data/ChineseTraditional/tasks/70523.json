					"關垂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705230301,
					"content": "關垂先生，我們回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230302,
					"content": "你需要的100箱「假日果釀」已經訂好了，這是給你的單據，請收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230303,
					"content": "好好好！兩位真是幫大忙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230304
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230304,
					"content": "我要好好研究一下「假日果釀」，把這種新鮮飲料和茶水按特定的比例混合，調出最好的口感，讓兄弟們下地幹活時更有幹勁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230305
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230305,
					"content": "呃，聽起來有點像調酒，不過添加的是茶水…真的能做到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230306,
					"content": "放心吧，我以前在外邊當過一段時間廚師。這種做法能在成本和口味之間取得最好的平衡，我已經調配過很多次了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230307
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230307,
					"content": "有點想試試看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230308
					]
				},
				{
					"id": 705230308,
					"content": "#下次{F#妳}{M#你}們來輕策莊玩的時候，我就用成品來招待{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230309
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230309,
					"content": "#好哦！到時候就讓{NICKNAME}先喝喝看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230310,
					"content": "加油啊，調配飲品的廚師！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230311
					]
				},
				{
					"id": 705230311,
					"content": "#謝謝{F#妳}{M#你}們！有空常來啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "關垂"
				}
			]
		},
		{
