			},
			"dialogs": [
				{
					"id": 705230401,
					"content": "這次佳釀節的特色飲品，想來就和輕策莊的山泉茶水很般配！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230402
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230402,
					"content": "#有勞{F#妳}{M#你}們兩位了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230403,
						705230407,
						705230415
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230403,
					"content": "關於你自己…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230404
					]
				},
				{
					"id": 705230404,
					"content": "我和幾個兄弟搬回莊裡還沒多久。平時我負責給下地幹活的兄弟們做點飯菜，送到田裡去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230405
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230405,
					"content": "不過我做的大多是些簡單管飽的菜式，拿出來招待外地的客人還是有點寒磣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230406
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230406,
					"content": "#輕策莊雖不熱鬧，但美食可一點都不少，{F#妳}{M#你}在莊裡逛逛就能見識到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230407,
					"content": "關於茶水…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230408
					]
				},
				{
					"id": 705230408,
					"content": "下地幹活的兄弟們口渴得厲害，經常半天就喝掉一大缸茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230409
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230409,
					"content": "田地和莊裡的茶水攤隔著一段距離，來來回回不太方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230410
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230410,
					"content": "凱叔一把年紀了，可不能麻煩他給兄弟們送茶，這個活兒就由我包攬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230411
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230411,
					"content": "我和幾個兄弟在外地闖蕩過一段時間，大缸的茶水對我們來說有點清淡，有時兄弟們想喝些味道重的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230412
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230412,
					"content": "所以我會往茶水里加些飲品，調出新鮮的風味，讓兄弟們樂呵樂呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230413
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230413,
					"content": "當然，我做的茶水只提供給幾個兄弟，可不能搶凱叔的生意啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230414
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230414,
					"content": "閒下來以後，我們也會去凱叔的茶水攤品茶，幫他幹些雜活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230415,
					"content": "我們去去就回。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230416
					]
				},
				{
					"id": 705230416,
					"content": "#好啊！等著{F#妳}{M#你}們的好消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "關垂"
				}
			]
		},
