			"dialogs": [
				{
					"id": 705230201,
					"content": "#哦！{F#妳}{M#你}們又來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230202
					],
					"speakerTitle": "格奧爾格"
				},
				{
					"id": 705230202,
					"content": "這次還是幫別國的客人下單嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230203
					],
					"speakerTitle": "格奧爾格"
				},
				{
					"id": 705230203,
					"content": "沒錯哦，這次我們需要100箱「假日果釀」，委託人是輕策莊的廚師關垂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230204,
					"content": "我們準備好出價了，格奧爾格先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230205,
						705230206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230205,
					"content": "怎麼有種商業對決的感覺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				},
				{
					"id": 705230207,
					"content": "#喔！氣勢很強嘛！那就讓我看看{F#妳}{M#你}們這次的覺悟吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格奧爾格"
				},
				{
					"id": 705230206,
					"content": "請接招吧，格奧爾格先生！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230207
					]
				}
			]
		},
		{
