			},
			"dialogs": [
				{
					"id": 705230101,
					"content": "外地來的客人？歡迎來到輕策莊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230102,
						705230103
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230102,
					"content": "你好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				},
				{
					"id": 705230104,
					"content": "我先說我先說，我們先自我介紹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230105,
					"content": "#這是無所不能的旅行者{NICKNAME}，我是旅行者最好的夥伴派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230106,
					"content": "我們正在幫外地的客人訂購佳釀節的特色飲品，看到了你的委託，所以就來直接和你商量了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230107,
					"content": "原來如此，真是爽快人！那我也不廢話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230109
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230109,
					"content": "我是廚師關垂，需要採購<color=#00E1FFFF>100箱「假日果釀」</color>，用來兌茶水，給幹體力活的兄弟們喝個痛快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230110
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230110,
					"content": "好！那我們就開工了，請提供採購資金吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230111,
					"content": "早就準備好了，請收下這些「佳釀晶凍」！下單後想必還會有盈餘，不管還剩多少，都是兩位勞苦功高的報酬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230112
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230112,
					"content": "我們都收下了，等等就出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230113,
					"content": "#好極了！等著{F#妳}{M#你}們兩位的好消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230114,
						705230115
					],
					"speakerTitle": "關垂"
				},
				{
					"id": 705230114,
					"content": "好迅速的交流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230116,
					"content": "#別愣著啦，{NICKNAME}，我們快走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230117,
					"content": "有什麼想說的，就等下單以後再來聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230118,
					"content": "早點完成這些工作，我們就能早點開店啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705230119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230119,
					"content": "開店開店，嗯哼哼~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705230115,
					"content": "派蒙也越來越會了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230116
					]
				},
				{
					"id": 705230103,
					"content": "請問你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705230104
					]
				}
			]
		},
		{
