			"dialogs": [
				{
					"id": 401730501,
					"content": "#{NICKNAME}，有事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730502
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730502,
					"content": "#我稍後要去首領那裡還儀式劍，營地的其他東西就暫時留在這裡。{F#妳}{M#你}有興趣的話可以隨便使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730503
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730503,
					"content": "我有一本《蜃樓戰記》最新卷…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730504
					]
				},
				{
					"id": 401730504,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730505
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730505,
					"content": "還有《奧西茲小姐事件簿》番外…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730506
					]
				},
				{
					"id": 401730506,
					"content": "欸欸欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730507
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730507,
					"content": "要來一起看看嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730508
					]
				},
				{
					"id": 401730508,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730509
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730509,
					"content": "#（怎麼回事？怎麼回事？{M#他}{F#她}怎麼知道我喜歡那些？難道，{M#他}{F#她}有在注意我？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730510
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730510,
					"content": "（不，我怎麼會有這種不切實際的想法…肯定是歐洛倫暴露了我，可惡…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730511
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730511,
					"content": "#（可…{M#他}{F#她}記住我的喜好了嗎？欸？其實不記住也沒關係，又不是什麼重要的事…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730512
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730512,
					"content": "#（但…{M#他}{F#她}正在邀請我欸！怎麼辦怎麼辦，要怎麼回應？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730513
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730513,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730514
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730514,
					"content": "好啊，有空吧，等我忙完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
			]
		}
	]
}