			"dialogs": [
				{
					"id": 715330101,
					"content": "唔…感覺也不太對，這種「祝柬」真難做啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330102
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330102,
					"content": "米卡，你在做「祝柬」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330103
					]
				},
				{
					"id": 715330103,
					"content": "#欸？{NICKNAME}，居然能遇見{F#妳}{M#你}，真巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330104
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330104,
					"content": "你是來璃月過海燈節的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715330105
					]
				},
				{
					"id": 715330105,
					"content": "欸？不是不是，我來璃月港本來是為了執行遞送信件的任務，碰巧遇上了海燈節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330106
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330106,
					"content": "我來之前聽可莉前輩說她很想要一封海燈節的「祝柬」，就想說順便買一封回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330107
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330107,
					"content": "結果，沒想到要自己做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330108
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330108,
					"content": "我做了半天，卻總覺得做出來的「祝柬」不太對…但也不知道到底哪裡不對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330109
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330109,
					"content": "#{NICKNAME}，{F#妳}{M#你}見多識廣…能給我一點製作「祝柬」的建議嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715330110
					],
					"speakerTitle": "米卡"
				},
				{
					"id": 715330110,
					"content": "讓我思考一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
