			},
			"dialogs": [
				{
					"id": 3740701,
					"content": "所以你說的「天空」，到底是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3740702,
					"content": "蒙德的至寶，風神巴巴托斯曾經彈奏的豎琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740703
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740703,
					"content": "只要有了天空之琴，我就能從噩夢中喚回特瓦林的本性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740704
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740704,
					"content": "這樣…真的可以讓風魔龍停止破壞嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3740705,
					"content": "當然，因為我可是天下最好的詩人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740706
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740706,
					"content": "過去、未來與現在，沒有我不知道的歌謠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740707
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740707,
					"content": "#看著我的眼睛，{F#妳}{M#你}不覺得我很值得信任嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740708,
						3740709,
						3740710
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740708,
					"content": "…可疑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740711,
					"content": "哈哈哈，這一招對吟遊詩人是無效的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740712
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740712,
					"content": "那麼，該怎麼拿到天空之琴呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3740713,
					"content": "據說它被供奉在大教堂深處，某個安全的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740714
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740714,
					"content": "#我會去探查一下情況，{F#妳}{M#你}有興趣的話也可以跟來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740709,
					"content": "有限地相信一下也沒壞處…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				},
				{
					"id": 3740710,
					"content": "你眼睛的顏色像我故鄉的天空。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740711
					]
				}
			]
		},
