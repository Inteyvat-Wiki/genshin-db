			},
			"dialogs": [
				{
					"id": 3740301,
					"content": "欸嘿，修女她頭也不回地走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740302
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740302,
					"content": "不過呢，其實我也已經達到了預定的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740303
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740303,
					"content": "至少她沒有否認——大教堂裡收藏著天空之琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740304
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740304,
					"content": "#那麼，{NICKNAME}。既然{F#妳}{M#你}是騎士團正當紅的新人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740305
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740305,
					"content": "#要不然，{F#妳}{M#你}也來試試？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		},
