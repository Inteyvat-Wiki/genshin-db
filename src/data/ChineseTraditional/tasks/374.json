					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3740201,
					"content": "看我的吧——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740202
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740202,
					"content": "妳好，修女姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740203
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740203,
					"content": "風神祝福你，年輕的詩人。有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740204
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740204,
					"content": "其實，我掌握了一個秘密，能夠解救蒙德城遇到的危機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740205
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740205,
					"content": "哦？那可真是風神保佑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740206
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740206,
					"content": "但這件事你應該對騎士團報告。我這樣一個無關的修女能幫到你什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740207
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740207,
					"content": "啊哈哈，姐姐妳當然是有能幫忙的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740208
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740208,
					"content": "比如說…天空之琴。借助它的力量，我可以讓風魔龍——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740209
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740209,
					"content": "請回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740210
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740210,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740211
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740211,
					"content": "雖然那條龍非常兇惡，但只要代理團長下定決心，就沒有不能討伐的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740212
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740212,
					"content": "那可不行，那樣的話風魔龍不就會死掉了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740213
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740213,
					"content": "背離東風的愚獸，即便是風神本尊降臨，也不會輕易原諒牠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740214
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740214,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740215
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740215,
					"content": "呃…那個，大姐姐~~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740216
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740216,
					"content": "不行就是不行喲，小詩人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740217
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740217,
					"content": "（嘶…被這孩子叫大姐姐，心裡怎麼會泛起一種不可思議的高興…真荒謬…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740218
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740218,
					"content": "呼…真沒辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740219
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740219,
					"content": "我已經不能再隱瞞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740220
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740220,
					"content": "我虔誠的信徒啊，喜悅吧！在妳面前的，正是<color=#00E1FFFF>風神巴巴托斯</color>本人——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740221
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740221,
					"content": "是不是很震驚？是不是震驚得想哭？終於見到了侍奉的神明，怎樣？很感動吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740222
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3740222,
					"content": "沒別的事情的話，我回去繼續處理教堂的文件了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740223
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740223,
					"content": "呀——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		},
