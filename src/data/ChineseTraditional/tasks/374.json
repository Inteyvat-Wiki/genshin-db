			},
			"dialogs": [
				{
					"id": 3740401,
					"content": "#風神祝福{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740402,
						3740404
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740402,
					"content": "妳好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740403
					]
				},
				{
					"id": 3740403,
					"content": "#啊，{F#妳}{M#你}是…騎士團的那位新成員吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740406,
					"content": "為什麼來這裡？是代理團長大人交待的公務嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740411
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740411,
					"content": "嗯，騎士團，要借用天空之琴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740412
					]
				},
				{
					"id": 3740412,
					"content": "真的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740413
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740413,
					"content": "#倒不是懷疑{F#妳}{M#你}。但早些時候有個可疑的詩人也來借琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740414
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740414,
					"content": "他滿口胡言，竟敢自稱巴巴托斯，一定沒安好心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740415
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740415,
					"content": "天空之琴的使用是有規定的。目前只有羽球節期間才會用到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740416
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740416,
					"content": "出借時需要團長、主教，還有民眾代表協商同意，簽署文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740417
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740417,
					"content": "那麼，騎士團的文件呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740418,
						3740419,
						3740420
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740418,
					"content": "好像沒聽團長提起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740422,
					"content": "總而言之文件是必須的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740423
					],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740423,
					"content": "沒其他事的話，恕我失陪了。最近真的很忙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歌特琳德"
				},
				{
					"id": 3740419,
					"content": "對不起，我忘了拿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740422
					]
				},
				{
					"id": 3740420,
					"content": "在路上被派蒙吃掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740421
					]
				},
				{
					"id": 3740421,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3740404,
					"content": "#我是榮譽騎士{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3740405
					]
				},
				{
					"id": 3740405,
					"content": "#嗯，我認識{F#妳}{M#你}。那天{F#妳}{M#你}跟安柏一起拯救了蒙德呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3740406
					],
					"speakerTitle": "歌特琳德"
				}
			]
		},
