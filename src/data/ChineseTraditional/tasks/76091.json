			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910101,
					"content": "#是會飛的妖精！我的筆記…重要的筆記被愚人眾扣下來了，{F#妳}{M#你}能幫我找回來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910102
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910102,
					"content": "雖然我不是妖精…但這點小忙也不是不能幫啦。話說回來，愚人眾為什麼會扣留小孩子的筆記呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760910103,
					"content": "#說不定是害怕我將筆記上的內容公之於眾…{F#妳}{M#你}們要是能幫我把筆記找回來，我就把這個秘密也告訴{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910105
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910105,
					"content": "#這些待會再說，拜託{F#妳}{M#你}們先幫我<color=#00E1FFFF>找回筆記</color>吧，說不定還有些從筆記本裡<color=#00E1FFFF>散落的紙頁</color>…就在那邊，有愚人眾的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
		{
			"id": 7609102,
			"completionStepIds": [
				7609107
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
