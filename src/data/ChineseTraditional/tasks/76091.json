				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 760910203,
					"content": "將之前撿到的筆記本和紙頁交給他…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910204
					]
				},
				{
					"id": 760910204,
					"content": "我看看…沒錯！就是這些，太感謝了。這裡面可是記錄了不少愚人眾的罪證呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910205
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910205,
					"content": "…罪證？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760910206,
					"content": "#{F#妳}{M#你}看他們在帕哈島上建的那些設施，還有他們帶來的機械裝置…那裡原本也是很多動物的家呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910207
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910207,
					"content": "我剛從緋沙鹽沼回來，一定是因為愚人眾的機器，那邊的水母都奄奄一息了…我得讓大家都知道這件事才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910208
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910208,
					"content": "欸？是說落落莓果凍牠們嗎，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760910209,
					"content": "講述了在緋沙鹽沼的經歷…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						760910210
					]
				},
				{
					"id": 760910210,
					"content": "果然還是太晚了嗎…但是不管怎麼說，都應該留下紀錄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910211
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910211,
					"content": "#這份筆記就交給{F#妳}{M#你}們了。我得快點回去把其他的筆記的內容整理好，寫成文章才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910213
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910213,
					"content": "#對了，如果{F#妳}{M#你}們要和別人說，一定要說是謝苗——也就是我——告訴{F#妳}{M#你}們的。畢竟回去寫成文章在報紙上刊登還需要時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760910214
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 760910214,
					"content": "#總之多謝{F#妳}{M#你}們，再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				}
			]
		},
