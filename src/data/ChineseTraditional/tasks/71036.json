			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"志瓊",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360201,
					"content": "#{F#妳}{M#你}好！{NICKNAME}前輩，最近過得怎樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360202,
						710360204
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360202,
					"content": "還好吧，妳好些了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360203
					]
				},
				{
					"id": 710360203,
					"content": "謝謝關心，我已經沒什麼問題了。實在抱歉之前讓大家費心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360206,
					"content": "哼，志瓊妳就不要到處亂跑啦！免得又像上次一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710360207,
					"content": "不會的，不會的。多虧了前輩的努力，層岩巨淵已經安全了許多。地質特徵也變得…唔，穩定了許多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360208
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360208,
					"content": "不過瑾武姐和海迪夫還需要進一步分析那塊神秘晶體的…那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360209
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360209,
					"content": "唔，波長？海迪夫是這麼說的，大概又是須彌的奇怪術語吧…總之，首先需要安置信標才能取得數據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360210
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360210,
					"content": "瑾武姐最近終於騰出空來把信標組裝齊全了，我需要把它們安置在幾個特定地點來讀取讀數。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360211
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360211,
					"content": "隔一段時間後再前去回收，回收的數據就可以留給海迪夫去運算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360212
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360212,
					"content": "之前由於很多區域都不安全，我們只侷限在營地內進行讀數測算…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360213
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360213,
					"content": "但現在既然通路被前輩打開了，用信標進行實地測量也就能得到更準確的數據了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360214
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360214,
					"content": "呼…有點事情做還是比閒著好。對了，前輩如果沒有其他事情的話，也請跟我一起來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360215,
						710360217
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360215,
					"content": "那麼，我們出發吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360216
					]
				},
				{
					"id": 710360216,
					"content": "好的，那麼我們出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360217,
					"content": "有我們什麼好處嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360218
					]
				},
				{
					"id": 710360218,
					"content": "#{F#妳}{M#你}這也太直接了吧！雖然我也想知道就是啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710360219,
					"content": "#哈哈，咱們這次只是簡單的一趟來回而已，不過瑾武姐應該會感謝{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360204,
					"content": "不怎麼樣，至少還活著。妳呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360205
					]
				},
				{
					"id": 710360205,
					"content": "#我還好啦…唔，也不怎麼樣就是了，冒險的風頭都讓前輩{F#妳}{M#你}出盡了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360206
					],
					"speakerTitle": "志瓊"
				}
			]
		},
		{
			"id": 7103603,
			"completionStepIds": [
				7103610
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103610",
							"2"
						],
						"stepId": 7103610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志瓊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710360301,
					"content": "這一趟辛苦前輩了，一點小心意請收下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360302
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360302,
					"content": "太客氣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710360303
					]
				},
				{
					"id": 710360303,
					"content": "呼…最近層岩巨淵似乎停止了地形上的異變，這也說明我只需要對已有的地圖進行一點小小的增補就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360304
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360304,
					"content": "多謝了前輩的冒險，我們的工作也相對輕鬆了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360305
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360305,
					"content": "啊，我就不多留前輩啦。如果想要休息或者繼續探險，就請自便吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710360306
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710360306,
					"content": "呼…距離回收信標還有挺長時間的，如果下次冒險也能再請前輩同行就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				}
			]
		},
		{
			"id": 7104116,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103713",
							"3"
						],
						"stepId": 7103713,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志瓊",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710411201,
					"content": "請問前輩有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411202,
						710411212,
						710411223,
						710411232
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411202,
					"content": "關於地圖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411203
					]
				},
				{
					"id": 710411203,
					"content": "前輩是說地圖嗎？沒什麼好提的啦…在加入冒險家協會之前，我曾經是礦上的製圖員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411204
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411204,
					"content": "當然啦，我說的不是那些坐辦公室畫圖的製圖師…嘿嘿，我還差得遠呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411234
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411234,
					"content": "之前受過他們的委託，在翹英莊跑上跑下測繪地形…結果完事建築計畫卻取消了…也都是他們一句話的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411205
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411205,
					"content": "他們可以只用委託助手現場勘探，為他們收集地圖資訊，然後自己才動手工作…但我們這些製圖員可不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411206
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411206,
					"content": "所以…身為半個礦工，我也早就習慣在危險的地下通道中穿梭了——工作要求如此，沒辦法嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411207
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411207,
					"content": "而且…在異變發生後，層岩巨淵下層其實很…不穩定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411208
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411208,
					"content": "欸…不穩定？很危險嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710411209,
					"content": "嗯，地質結構一直在緩慢地變化，今天的通路，可能到下個月就變成了石壁…就像…唔，我想想怎麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411210
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411210,
					"content": "就像層岩巨淵在隨著自己的心思發生變化一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411211
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411211,
					"content": "哇…這麼邪門的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710411212,
					"content": "關於冒險家生涯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411213
					]
				},
				{
					"id": 710411213,
					"content": "哈哈，才到哪呀，就「生涯」了！前輩請不要太客氣啦，我還只是個新人冒險家而已…跟前輩差得太遠啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411214
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411214,
					"content": "雖然之前完成過一些冒險家協會的委託，但我經驗尚淺，也並沒有獨立探索過什麼地點，更沒有在哪裡留下自己的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411215
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411215,
					"content": "所以我一直在想，層岩巨淵這個地方，說不定能讓我留下足跡，讓後人記得，我這個人曾經來過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411216
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411216,
					"content": "就像大冒險家艾莉絲曾經說的那樣，層岩巨淵說不定會是「我的『盧比孔河』」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411217,
						710411220
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411217,
					"content": "「鹿鼻孔河」…是丘丘語嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411218
					]
				},
				{
					"id": 710411218,
					"content": "沒聽說過呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710411219,
					"content": "唔…我也不是很懂…艾莉絲畢竟是穿梭諸世界的大冒險家，或許也是她去過的地方之一吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411220,
					"content": "是「露鼻孔盒」呀！真厲害！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411221
					]
				},
				{
					"id": 710411221,
					"content": "#喂，{F#妳}{M#你}自己也不知道那是什麼東西吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710411222,
					"content": "哈哈，不管怎樣，多謝前輩的鼓勵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411223,
					"content": "關於克里托夫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411224
					]
				},
				{
					"id": 710411224,
					"content": "他呀…哼，他這個人我是信不過。我們在礦上和盜寶團不知道周旋過多久了，還能不知道他們的壞心眼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411225
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411225,
					"content": "#這些人呀…我勸{F#妳}{M#你}千萬別信他們那套說辭，什麼「改過自新」什麼「金盆洗手」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411226
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411226,
					"content": "#如果{F#妳}{M#你}認真在聽他們說話，他們一定已經把髒手伸到{F#妳}{M#你}的口袋裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411227
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411227,
					"content": "#假如{F#妳}{M#你}相信了他們的鬼話，恐怕岩王爺他老人家也保不住{F#妳}{M#你}的錢包囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411228
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411228,
					"content": "#哼，我當然不是對他們有偏見…我只是想提醒{F#妳}{M#你}小心一點，盜寶團是不可相信的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411229
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411229,
					"content": "妳這顯然是偏見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411230
					]
				},
				{
					"id": 710411230,
					"content": "#也許吧…{F#妳}{M#你}作為前輩比我更加見多識廣，對盜寶團那些傢伙也能更寬容。但我總還要留些心眼盯著他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710411231
					],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411231,
					"content": "除非這傢伙能證明，他和那群走私犯同夥沒有關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				},
				{
					"id": 710411232,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710411233
					]
				},
				{
					"id": 710411233,
					"content": "前輩再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志瓊"
				}
			]
		}
	]
