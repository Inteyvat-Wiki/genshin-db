					"nextDialogs": [
						4870118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870118,
					"content": "#那好，我們有線索啦！{NICKNAME}，快用<color=#00E1FFFF>「元素視野」</color>查看一下吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
