						4870502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870502,
					"content": "想辦法<color=#00E1FFFF>從它身後接近</color>吧，最好蹲下來，好讓腳步輕一些。",
					"roleType": "TALK_ROLE_NPC",
