			},
			"dialogs": [
				{
					"id": 4870101,
					"content": "…原來那隻貓是妳家走丟的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870102
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 4870102,
					"content": "溫迪！你也是來幫忙的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870103,
					"content": "幫忙？我倒覺得，需要幫忙的其實是我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870104
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 4870104,
					"content": "咦？我看你剛才好像也在問瑪格麗特小姐的「小王子」的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870105,
					"content": "哦，所以偷走我備用的<color=#00E1FFFF>星鐵弦</color>的那隻貓，名字叫「小王子」嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870106
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 4870106,
					"content": "雖說看到蒙德的生靈如此自由自在，是件好事…但未免也太為所欲為了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870107
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 4870108,
					"content": "這就是喜歡放縱孩子的家長吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4870109
					]
				},
				{
					"id": 4870107,
					"content": "啊哈哈，「小王子」就是這樣調皮機靈的寶貝呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870108
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4870109,
					"content": "好像巴巴托斯一樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870110,
					"content": "哈哈哈…真是巧妙的比喻，咳咳。還是先找到「小王子」再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870111
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 4870111,
					"content": "今晚我還有演出，拿不回備用弦的話，可就要讓聽眾失望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870112
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 4870112,
					"content": "話說貓咪為什麼會去偷溫迪的備用琴弦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870113,
					"content": "貓咪都喜歡玩毛線團的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870114
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4870114,
					"content": "欸欸！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870115,
					"content": "星鐵做的琴弦蘊含著風的元素力，有超乎意料的韌性，所以平時我都捲成毛線團的樣子帶在身上啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870116
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 4870116,
					"content": "這可是吟遊詩人的小秘密，哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870117
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 4870117,
					"content": "咦？你說那弦上有風的元素力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870118,
					"content": "#那好，我們有線索啦！{NICKNAME}，快用<color=#00E1FFFF>「元素視野」</color>查看一下吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870119,
					"content": "應該會留下什麼風元素的痕跡吧，比如…腳印什麼的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870120,
					"content": "#靠{F#妳}{M#你}們囉，「小王子」應該就在城裡的商業區和居民區附近，是一隻純黑色的貓哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4870121,
					"content": "#啊…對了，這塊<color=#00E1FFFF>魚肉</color>是我家「小王子」最愛吃的，{F#妳}{M#你}帶上的話或許會派上用場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪格麗特"
				}
			]
		},
