					"瑪格麗特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4870301,
					"content": "「小王子」~！你跑哪去了呀，終於回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870302
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4870302,
					"content": "可讓我們好找呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870303,
					"content": "唉，「小王子」呀，你怎麼忍心這樣拋棄我呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870304
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4870304,
					"content": "已經進入「二人世界」了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870305,
					"content": "還有你的星鐵弦在這哦，溫迪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870306,
					"content": "#還真的被{F#妳}{M#你}們找到了，我原本都不怎麼抱希望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870307
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 4870307,
					"content": "#為了表示感謝，用這弦為{F#妳}{M#你}們辦一場「專場演唱」都不過分呢…阿、阿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870308
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 4870308,
					"content": "阿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870309,
					"content": "阿嚏——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870310
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 4870310,
					"content": "咳咳…啊哈哈…離「小王子」這麼近的話，我對貓過敏的體質果然又…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870311
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 4870311,
					"content": "難怪你沒有自己去抓它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4870312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4870312,
					"content": "欸嘿，總之幫了大忙啦，那我先走啦…阿、阿嚏——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		},
