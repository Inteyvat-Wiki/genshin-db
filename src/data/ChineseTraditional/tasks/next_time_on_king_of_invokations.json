					"nextDialogs": [
						230350608
					]
				},
				{
					"id": 230350607,
					"content": "你比我強。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350608
					]
				},
				{
					"id": 230350608,
					"content": "那這件事就這麼說定了，來，這副偏向於快速攻擊的卡組給你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350609
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350609,
					"content": "而我就用這套進攻速度偏慢的牌，來看看怎麼應對你的攻擊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350610
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350610,
