	"talks": [
		{
			"id": 2303501,
			"completionStepIds": [
				2303501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303501",
							"2"
						],
						"stepId": 2303501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350101,
					"content": "唉，好想回稻妻…我怎麼會遇到這種事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350102,
						230350103
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350102,
					"content": "你怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				},
				{
					"id": 230350104,
					"content": "旅行者？唉，別提小說了，我覺得那群做「七聖召喚」的人都要撐不住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350105
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350105,
					"content": "據那個跟我關係還可以的學者說，做「七聖召喚」的時候，他們遇見了五花八門堪稱莫名其妙的問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350106
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350106,
					"content": "比如，一個室羅婆耽學院的學者有一天突然提出了一個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350107
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350107,
					"content": "他說，卡面上的卡牌效果描述太長，也許會讓不習慣閱讀長文本的人不想玩「七聖召喚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350108
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350108,
					"content": "學者們都習慣閱讀長文本，對這個問題不敏感。但也許會有玩家不喜歡讀長文本，甚至因此不玩「七聖召喚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350109
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350109,
					"content": "所以他建議，能不能把部分卡牌上的文本字數縮減一半，來方便玩家閱讀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350110,
						230350111
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350110,
					"content": "需、需要這麼做嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350112,
					"content": "我是覺得這根本就不是問題…但學者們還在認真研究這個問題。畢竟事關玩家們的體驗，他們希望不要有任何問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350113
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350113,
					"content": "唉，不說這些了…現在更大的問題是，他們之前承諾幫我找模特兒這件事也出問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350114
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350114,
					"content": "#之前我不是和{F#妳}{M#你}說過，有一位學者說，他們會幫我聯絡提納里先生和賽諾先生，並且拜託這兩位當模特兒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350115
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350115,
					"content": "但他們忙成這樣，我覺得暫時不能指望他們了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350116,
						230350117
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350116,
					"content": "那怎麼辦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350118,
					"content": "接待我的那個學者雖然也沒辦法幫我辦這件事，但是他幫我出了一個主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350119
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350119,
					"content": "他說，賽諾先生有時候會去普斯帕咖啡館打牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350120
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350120,
					"content": "如果我願意的話…可以先去那家咖啡館碰碰運氣。或者，是等他們有空之後再幫我聯絡看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350121
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350121,
					"content": "那你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350122
					]
				},
				{
					"id": 230350122,
					"content": "唉，等他們有空的時候，我小說正文都要寫完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350123
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350123,
					"content": "所以，我還是自力更生，看能不能自己找到那位賽諾先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350124
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350124,
					"content": "但就算我運氣好，在咖啡館遇見了賽諾先生，又要怎麼樣才能跟賽諾先生搭上話呢？真是頭痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350128,
						230350129
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350128,
					"content": "我能幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350130,
					"content": "#真的？！太好了！但{F#妳}{M#你}是怎麼…呃，算了，我就不問這些問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350131
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350131,
					"content": "那事不宜遲，我們趕快去普斯帕咖啡館吧。希望能遇見賽諾先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230350129,
					"content": "我和賽諾很熟啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350130
					]
				},
				{
					"id": 230350117,
					"content": "那要怎麼聯絡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350118
					]
				},
				{
					"id": 230350111,
					"content": "其實也長不到哪裡去吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350112
					]
				},
				{
					"id": 230350103,
					"content": "小說寫得不順利嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350104
					]
				}
			]
		},
		{
			"id": 2303503,
			"completionStepIds": [
				2303503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
