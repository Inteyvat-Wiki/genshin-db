						],
						"stepId": 2303503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350301,
					"content": "噓…那、那是不是賽諾先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350302
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350302,
					"content": "看他的裝扮，看他的髮型，還有那個髮色…簡直是卡牌遊戲小說的最佳主角啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350303,
						230350305
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350303,
					"content": "完全沒有道理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350304
					]
				},
				{
					"id": 230350304,
					"content": "#哎呀，{F#妳}{M#你}就相信我在小說市場裡的直覺吧。但現在不是說這個的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350309,
					"content": "#旅行者，請賽諾先生為我做模特兒的事…就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230350305,
					"content": "那我還認識蠻多這種主角的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350306
					]
				},
				{
					"id": 230350306,
					"content": "真的嗎？那正好啊，我正在籌備《召喚王》的第三部小說，這次我不打算根據「七聖召喚」的玩法寫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350307
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350307,
					"content": "我決定要完全原創一種對戰方式，比如…所有卡牌都懸浮在場地裡，牌手要一邊對戰一邊不斷搜集卡牌，同時還要阻止對手搜集卡牌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350308
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350308,
					"content": "哈哈哈！光是想想就覺得很有趣！但現在不是說這個的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350309
					],
					"speakerTitle": "福本"
				}
			]
		},
		{
			"id": 2303504,
			"completionStepIds": [
				2303504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303504",
							"2"
						],
						"stepId": 2303504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽諾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230350401,
					"content": "…唔，這樣的卡牌組合也許不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350402
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350402,
					"content": "但這些卡牌，應對快速進攻的能力是不是太弱了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350403
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350403,
					"content": "賽諾，你在做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350404
					]
				},
				{
					"id": 230350404,
					"content": "#{NICKNAME}？沒想到會在這裡遇見{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350405
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350405,
					"content": "我正在試著構築一套進攻速度偏慢的「七聖召喚」卡組呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350406
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350406,
					"content": "在我的設想裡，使用這套卡牌的牌手會擁有豐富的資源，和各類強大的卡牌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350407
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350407,
					"content": "但說實話，這樣的卡組還滿難構築的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350408
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350408,
					"content": "現在「七聖召喚」的玩家群體裡，一部分玩家喜歡使用進攻速度偏快的卡組。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350409
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350409,
					"content": "在遊戲剛開始的時候，就一口氣打出大量的卡牌發動攻擊，用最快的速度擊敗對手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350410
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350410,
					"content": "不過我卻不喜歡這種戰術。我喜歡的對決戰術，是不斷用各種方式累積資源…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350411
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350411,
					"content": "把握住每一個時機，不斷累積優勢，穩穩地取得最後的勝利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350412
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350412,
					"content": "沒錯！就是這樣！太好了，太好了！您簡直和我小說裡的主角一模一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350413
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350413,
					"content": "抱歉！呃…我是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350414,
						230350415
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350414,
					"content": "這位是福本。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350415,
					"content": "這位是小說《召喚王》的作者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350416
					]
				},
				{
					"id": 230350416,
					"content": "您好，大風紀官，那個…我猜您應該沒聽說過我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350417
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350417,
					"content": "我看過你寫的小說，很不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350418
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350418,
					"content": "那真是榮幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350419
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350419,
					"content": "這部小說最讓我印象深刻的是，小說主角每次陷入劣勢的時候，總是會透過各種方式獲得並不存在於牌組裡的牌，然後再克敵制勝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350420
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350420,
					"content": "我理解這是情節需要，但這種獲勝方式無疑有些背離了「七聖召喚」的遊戲本質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350421
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350421,
					"content": "哎呀，這個…我雖然經常玩「七聖召喚」，但玩的水準也並不高…而且，如果真的用競技思維來寫小說裡的卡牌對決，那寫出來也不會太好看啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350422
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350422,
					"content": "唔，這樣嗎？那麼正好，我剛剛組好了兩套卡組，我們可以在這裡打幾局「七聖召喚」，你說不定能找到一些靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350423,
						230350424
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350423,
					"content": "（突然就開始要打牌了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350424,
					"content": "（這人不會就是單純想打牌了吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230350425
					]
				},
				{
					"id": 230350425,
					"content": "欸？和、和您打牌？我十分樂意，但其實…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350426,
						230350427
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230350426,
					"content": "我來說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350427,
					"content": "關於福本的請求…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 230350428,
					"content": "旅行者敘述了福本的請求…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 230350429,
					"content": "要請我做《召喚王》插畫的模特兒？那當然沒有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230350430
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 230350430,
					"content": "太好了！旅行者，快、快幫我多拍幾張畫片！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				}
			]
