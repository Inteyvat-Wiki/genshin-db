			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"思妤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420101,
					"content": "果然，還是送盞霄燈過去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420102
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420102,
					"content": "送霄燈？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420103
					]
				},
				{
					"id": 413420103,
					"content": "是旅行者啊，是這樣。從小扳子哥就一直很照顧我，平時也幫了我很多忙，他就和我親哥哥一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420104
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420104,
					"content": "但是大過節的，他似乎還在工作個不停…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420105
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420105,
					"content": "我就想送他一盞霄燈，嘿嘿，我們倆是從小玩到大的，小時候他最喜歡看霄燈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420106
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420106,
					"content": "#現在送一盞霄燈過去，他肯定會高興的。旅行者，能拜託{F#妳}{M#你}幫我把這盞霄燈送給他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420107,
						413420108
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420107,
					"content": "妳自己不去送嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				},
				{
					"id": 413420109,
					"content": "我也想自己去送啦，但家裡還有很多事要做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420110
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420110,
					"content": "我現在出來買東西，家裡的事都是我老公一個人在忙，我得趕緊回去幫幫他才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420111
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420111,
					"content": "#所以霄燈的事就拜託{F#妳}{M#你}啦，等稍微有空了，我會和我老公一起去看扳子哥的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420112
					],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420112,
					"content": "希望那時候扳子哥也能稍微閒一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "思妤"
				},
				{
					"id": 413420108,
					"content": "妳親自送比較好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420109
					]
				}
			]
		},
		{
			"id": 4134202,
			"completionStepIds": [
				4134202
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
