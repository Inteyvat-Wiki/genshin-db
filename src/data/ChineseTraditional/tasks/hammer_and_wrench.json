			"dialogs": [
				{
					"id": 413420901,
					"content": "久等了吧，我都搞定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420902
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420902,
					"content": "怎麼，事情全都弄完了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420903
					],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420903,
					"content": "弄完了，那麼點小事，還有這個旅行者幫忙，輕輕鬆鬆就都解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420904
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420904,
					"content": "你這個人啊…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420905
					],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420905,
					"content": "行了行了，大過節的，別這副表情嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420906
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420906,
					"content": "行，你說什麼就是什麼，霄燈你準備好了沒有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420907
					],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420907,
					"content": "霄燈…哎喲！我給忘了，你說我這記性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420908
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420908,
					"content": "沒事沒事，不就是個霄燈嘛，不放也沒什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420909
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420909,
					"content": "你少來這套，大過節的，不放霄燈像話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420910
					],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420910,
					"content": "#旅行者，能拜託{F#妳}{M#你}再幫我兄弟弄個霄燈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420911
					],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420911,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420912
					]
				},
				{
					"id": 413420912,
					"content": "#謝謝，我們就在這等著{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李錘子"
				}
			]
		},
