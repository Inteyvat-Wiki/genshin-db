						413421003
					]
				},
				{
					"id": 413421003,
					"content": "唉！我能有啥事啊，沒事沒事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421004
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413421004,
					"content": "我還得趕緊幹完這些活，幹完了之後…唉，幹完了活再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421005
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413421005,
					"content": "我也來幫忙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421006
					]
				},
				{
					"id": 413421006,
					"content": "#哦？那敢情好，那就麻煩{F#妳}{M#你}先幫我拿些木板來吧。",
