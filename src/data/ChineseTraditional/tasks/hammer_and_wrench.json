			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"王扳子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413421202,
					"content": "哦，這樣就可以了，多謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421203
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413421203,
					"content": "#還有點零碎工作…能不能請{F#妳}{M#你}幫我去港口清點一下新到的物資？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421204
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413421204,
					"content": "應該就是三個箱子，就堆在港口上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413421205
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413421205,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413421206
					]
				},
				{
					"id": 413421206,
					"content": "#那就拜託{F#妳}{M#你}了，我得趕緊把這些活給收尾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王扳子"
				}
			]
		},
		{
