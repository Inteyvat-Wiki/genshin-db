			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"王扳子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420401,
					"content": "#嗯？旅行者，{F#妳}{M#你}找我有事嗎？我現在正忙著呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420402
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420402,
					"content": "關於思妤送你的霄燈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4134205,
			"completionStepIds": [
				4134205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134205",
							"2"
						],
						"stepId": 4134205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"王扳子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420501,
					"content": "思妤？她…她送我的霄燈？我…我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420502
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420502,
					"content": "哈哈哈，這願望是她幫我寫的吧，我小時候確實最想實現這個願望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420503
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420503,
					"content": "一轉眼都過去了這麼多年了，時間過得可真快啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420504
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420504,
					"content": "#不過，她怎麼讓{F#妳}{M#你}把這盞霄燈送來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420505,
						413420506
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420505,
					"content": "她家裡還有事要忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				},
				{
					"id": 413420507,
					"content": "是嗎，是這樣…也好，也好，很不錯啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420508
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420508,
					"content": "思妤現在過得肯定很不錯吧，這樣就好了…哈哈…哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420509
					],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420509,
					"content": "這樣挺好的…不好意思…我還有很多工作要做，先走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王扳子"
				},
				{
					"id": 413420506,
					"content": "她說要回家幫老公…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420507
					]
				}
			]
		},
		{
			"id": 4134206,
			"completionStepIds": [
				4134206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134206",
							"2"
						],
						"stepId": 4134206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"李錘子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413420602,
					"content": "那個霄燈是思妤送給他的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420603,
						413420604
					],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420603,
					"content": "你剛才聽見了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420605
					]
				},
				{
					"id": 413420605,
					"content": "他那麼點事，我猜都不用猜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420606
					],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420606,
					"content": "去年他也是這樣，出去了一趟之後，回來一個人杵在船邊上敲了一晚上的釘子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420607
					],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420607,
					"content": "我知道他這麼做的意思，但是，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420608
					],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420608,
					"content": "#旅行者，能不能請{F#妳}{M#你}去幫他一下？大過節的，這麼操勞自己也不是辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420609
					],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420609,
					"content": "好的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413420610
					]
				},
				{
					"id": 413420610,
					"content": "#唉…麻煩{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420611
					],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420611,
					"content": "#我猜他又跑回船上工作了…{F#妳}{M#你}趕緊去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413420612
					],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420612,
					"content": "我等會去準備點吃食，你們弄完了之後就過來吧，我們一起吃點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "李錘子"
				},
				{
					"id": 413420604,
					"content": "你怎麼知道的？",
