			"trigger": {
				"objectNames": [
					"卯師傅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413320201,
					"content": "還有幾份來著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320202
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413320202,
					"content": "在忙些什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320203
					]
				},
				{
					"id": 413320203,
					"content": "哈哈，我還能忙些什麼，當然是「萬民堂」的生意嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320204
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413320204,
					"content": "最近趕上海燈節，出來下館子的人特別多，還有不少湊熱鬧的外國遊客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320205
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413320205,
					"content": "雖然我閨女香菱也回來幫忙了，但她也是忙得腳後跟不沾地，這不，剛剛出去送菜去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320206
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413320206,
					"content": "別人家早掛上霄燈過節去了，咱家「萬民堂」可是忙得連霄燈都沒空編啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320207
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413320207,
					"content": "#對了旅行者，如果{F#妳}{M#你}願意的話，能幫我個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320208
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413320208,
					"content": "#{F#妳}{M#你}認識竺子吧？就是那個在碼頭上的小姑娘，從稻妻來的那個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320209
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413320209,
					"content": "#她在我們這裡訂了份吃的，請{F#妳}{M#你}幫我送過去吧，大過節的，我特地幫她做的份量大了些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320210
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413320210,
					"content": "還有總是在碼頭上忙的那幾位，<color=#00E1FFFF>王扳子、李錘子、觀海、志華…</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320211
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413320211,
					"content": "這幾位總是照顧我們店的生意，這大過節的他們也還在碼頭上，八成也是因為工作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320212
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413320212,
					"content": "我也想給他們幾位都準備點好吃的，也算是過個節。但我這店裡太忙了，實在是抽不開身…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320213
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413320213,
					"content": "#旅行者，{F#妳}{M#你}就順便幫我去問問他們最想吃什麼吧，我好幫他們準備菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320214
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413320214,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320215
					]
				},
				{
					"id": 413320215,
					"content": "#那就拜託{F#妳}{M#你}了，問到了之後就趕緊回來告訴我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卯師傅"
				}
			]
		},
