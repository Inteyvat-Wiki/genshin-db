			"dialogs": [
				{
					"id": 413320301,
					"content": "「萬民堂」的餐怎麼還沒送來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320302
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 413320302,
					"content": "妳的餐到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413320303
					]
				},
				{
					"id": 413320303,
					"content": "#啊！謝謝{F#妳}{M#你}，我還以為再過一下子才能送到呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320304
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 413320304,
					"content": "璃月這個海燈節的氛圍，我都有點想家了，但是…稻妻我應該暫時回不去了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413320305
					],
					"speakerTitle": "竺子"
				},
				{
					"id": 413320305,
					"content": "不知道，稻妻那邊現在是什麼情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "竺子"
				}
			]
		},
