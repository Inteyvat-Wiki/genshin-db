			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卯師傅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413321401,
					"content": "餐送到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321402
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413321402,
					"content": "送到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321403
					]
				},
				{
					"id": 413321403,
					"content": "#好，請{F#妳}{M#你}幫忙果然沒錯，王扳子、觀海還有志華想吃的菜也都問到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321404
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413321404,
					"content": "王扳子和李錘子想吃醃篤鮮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321405
					]
				},
				{
					"id": 413321405,
					"content": "哦？這哥倆口味倒一致，不過醃篤鮮可是費工夫的菜，我得早些準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321407
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413321407,
					"content": "觀海想吃松鼠魚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321408
					]
				},
				{
					"id": 413321408,
					"content": "沒問題，這菜我拿手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321409
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413321409,
					"content": "志華想吃蓮花酥。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413321410
					]
				},
				{
					"id": 413321410,
					"content": "沒想到志華喜歡吃這種小巧精緻的點心，不過蓮花酥也不難做，沒問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321411
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413321411,
					"content": "#謝謝{F#妳}{M#你}幫我去打聽了，這點薄禮{F#妳}{M#你}可得收下，我得趕快去忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413321412
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 413321412,
					"content": "你不掛霄燈嗎？",
