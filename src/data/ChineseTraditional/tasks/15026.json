			"dialogs": [
				{
					"id": 150260201,
					"content": "這裡就是那位大薩滿的住處嗎？也太偏遠了一點，幫我們指路的族民應該沒騙人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260202
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260202,
					"content": "如果是茜特菈莉的話，住在這種地方倒也不奇怪吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260203,
					"content": "這面牆上的塗鴉是那位大薩滿的創作嗎？或許和部族文化有關！如果能讓我把這些塗鴉臨摹下來的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260204
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260204,
					"content": "艾列爾，辦正事要緊。就像之前說好的那樣請兩位幫忙接洽，我和其他人就在這裡等候好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260205
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260205,
					"content": "#嗯，{NICKNAME}，我們去敲門吧！希望她沒有宿醉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260206,
					"content": "#茜特菈莉，妳在家嗎？{NICKNAME}和我有些事情要找妳幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260207,
					"content": "沒反應啊…難道她不在家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260208,
					"content": "試試看另一個稱呼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260209
					]
				},
				{
					"id": 150260209,
					"content": "哦，黑曜石奶奶，妳在家嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260210,
					"content": "房門突然被打開，一股酒氣迎面而來。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150260211
					]
				},
				{
					"id": 150260211,
					"content": "小鬼，要找我挑戰得提前預約…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260212
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260212,
					"content": "（茜特菈莉平常有這麼宅的嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260213
					]
				},
				{
					"id": 150260213,
					"content": "#…{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260214
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260214,
					"content": "房門又被猛地關閉。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150260215
					]
				},
				{
					"id": 150260215,
					"content": "…看來我們來得很不是時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260216,
					"content": "#咳咳…{F#妳}{M#你}們還在嗎？可以進來了…進來講！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260217
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260217,
					"content": "還好沒有被拒絕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
