			"dialogs": [
				{
					"id": 150260101,
					"content": "咳咳…你們在這裡做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260102,
					"content": "哈？我們拿錢辦事，有事請找僱主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260103
					],
					"speakerTitle": "格洛德克"
				},
				{
					"id": 150260103,
					"content": "什麼態度…話說愚人眾接受僱傭的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260104,
					"content": "咳咳！他是格洛德克，受我僱傭，負責在納塔保護我的安全。看來他不太擅長待人接物，讓兩位見笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260105
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260105,
					"content": "我本來想從納塔的原住民當中僱傭人手，但一位祭司向我推薦了格洛德克和他的小隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260106
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260106,
					"content": "說是他們最近正好閒著，戰鬥力也不錯，很符合我的要求…聽起來愚人眾在納塔的風評似乎還滿好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260107
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260107,
					"content": "原來是這樣啊…另外，你是楓丹人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260108,
					"content": "#在下蒙呂松，來自楓丹，主要做一些出版生意。兩位…兩位莫非就是那位旅行者和{M#他}{F#她}的精靈夥伴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260109
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260109,
					"content": "你知道我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260110,
					"content": "金髮的旅者、銀色的飛行夥伴…不會錯的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260111
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260111,
					"content": "兩位在楓丹留下的事蹟足以支撐起一個暢銷書系列，我作為書商怎麼會認不出兩位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260112
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260112,
					"content": "#我們果然很有名啊，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260113,
					"content": "我的運氣真不錯。說起來有些唐突，其實我剛剛還在發愁要去哪裡尋找兩位呢…我有個不情之請…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260114
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260114,
					"content": "怎麼有種委託人從楓丹追到納塔的感覺？又開心不起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260115,
					"content": "事成之後，必有重謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260116
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260116,
					"content": "…這位倒是乾脆，先聽他講講？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260117,
						150260118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260117,
					"content": "哪次躲得掉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260119
					]
				},
				{
					"id": 150260119,
					"content": "咳咳…請問閣下有什麼請求？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260120,
					"content": "兩位認識茜特菈莉吧？我想麻煩兩位請那位大薩滿出山助我一臂之力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260121
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260121,
					"content": "呃…讓茜特菈莉幫陌生人辦事，憑我們的交情也很難辦到吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260122,
					"content": "那種個性，很難想像…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260123
					]
				},
				{
					"id": 150260123,
					"content": "說實話，她不太喜歡和陌生人打交道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260124,
					"content": "這個我已經從煙謎主的族人那裡打聽到了。他們還告訴我，如果非要找出一個能夠請她出山的人，那就只能是「金髮的旅者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260125
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260125,
					"content": "只要兩位能幫忙，報酬可以加倍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260126
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260126,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260127,
					"content": "先問清楚是什麼事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260128
					]
				},
				{
					"id": 150260128,
					"content": "也對…請問你要找茜特菈莉幫忙做什麼？我們至少要先瞭解一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260129,
					"content": "這個說來話長，涉及到煙謎主的一些歷史…還是讓專業人士來向兩位說明吧——艾列爾，有勞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260130
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260130,
					"content": "當然可以！平時很少有人願意聽我講這些…初次見面，我是來自楓丹科學院的研究員，叫我艾列爾就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260131
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260131,
					"content": "和大部分研究員不同，我對研究古代遺蹟也很有興趣，所以才有幸受邀加入蒙呂松先生的隊伍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260132
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260132,
					"content": "不知道兩位是否聽說過傳奇薩滿維奇琳的事蹟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260133,
						150260134
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260133,
					"content": "有點耳熟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260135
					]
				},
				{
					"id": 150260135,
					"content": "按照目前能收集到的納塔史料，她生活在兩百多年前，最擅長與色彩相關的秘術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260136
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260136,
					"content": "而她的所有事蹟中，最著名的就是傳奇的「七彩之戰」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260137
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260137,
					"content": "傳說那也是一場由深淵入侵而引發的戰爭，其慘烈程度即便放到整個納塔戰爭史中也可以位居前列。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260138
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260138,
					"content": "神奇的是，納塔一方在形勢極其不利的情況下，最終扭轉了戰局。而取勝的關鍵，正是維奇琳在戰場上創造出的一種「色彩」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260139
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260139,
					"content": "在傳說中，這種「色彩」非常神奇，它虛幻縹緲卻又彷彿有實體，維奇琳就用它構築了一座絢麗的迷宮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260140
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260140,
					"content": "來勢洶洶的敵人都被困在裡面無法脫身，友軍在維奇琳的引導下趁勢反攻，並最終取得了勝利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260141
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260141,
					"content": "咳咳…把事情大概講清楚就好，旅行者也不想被耽誤太多時間，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260142
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260142,
					"content": "他剛剛講的故事就是我來納塔的原因，我喜歡收集其他國家的歷史故事編集成書，然後出版——這種書一直賣得不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260143
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260143,
					"content": "最初聽到這個故事，我就想把它也收錄到接下來要出版的故事集裡，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260144
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260144,
					"content": "納塔的史料都不太詳細，我的人甚至無法確認戰場遺址的位置，也找不到其他能證明「七彩之戰」發生過的證據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260145
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260145,
					"content": "甚至部分煙謎主的族人也不認可「七彩之戰」的真實性，覺得它更像是一個被編撰出來的傳說故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260146
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260146,
					"content": "這樣的話不好收錄啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260147
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260147,
					"content": "欸？如果只是當成一個寫進書裡的故事，有必要尋找切實的證據嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260148,
					"content": "我這個系列最大的賣點就是「復原真實的歷史」，當然要有考據啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260149
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260149,
					"content": "所以我才來到了這裡。我聽說煙謎主部族有記錄歷史的習慣，就想調查一下他們的史料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260150
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260150,
					"content": "結果那個什麼「曜石祭場」根本不讓我進。申請了半天也只拿到一些普通的織卷，能研究出什麼？明明我可以幫忙宣傳他們的歷史…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260151
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260151,
					"content": "根據我的研究，煙謎主的族民用織物來記錄歷史，這些織物在他們看來如同聖物，自然不肯輕易給外人看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260152
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260152,
					"content": "另外，那些織卷包含的資訊量其實很大，如果能讓我仔細研究一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260153
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260153,
					"content": "艾列爾，我們之前不是已經談過了嗎？有更好的路，就不必在這裡浪費時間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260154
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260154,
					"content": "更好的路？難道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260155,
					"content": "嗯，兩位想必也知道茜特菈莉是一位活了兩百多年的大薩滿，她親身經歷過「七彩之戰」發生的時代！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260156
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260156,
					"content": "能請她出山做顧問，還用得著研究史料？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260157
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260157,
					"content": "原來如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260158,
					"content": "兩位意下如何？報酬再翻一倍也可以！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260159
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260159,
					"content": "實在不是我們不想幫忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260160,
						150260161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260160,
					"content": "派蒙，我們有必要去一趟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260162
					]
				},
				{
					"id": 150260162,
					"content": "哦，對了！之前煙謎主的首領託付給我們的那個使命，和維奇琳之間的關聯很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260163,
					"content": "這個「七彩之戰」背後，可能也有我們想要調查的線索？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260164,
					"content": "我們可以幫這個忙，只是請讓我們全權負責和茜特菈莉溝通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260165
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260165,
					"content": "沒問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260161,
					"content": "我們還有一個未完成的使命。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260162
					]
				},
				{
					"id": 150260134,
					"content": "那位與色彩有關的薩滿…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260135
					]
				},
				{
					"id": 150260118,
					"content": "報酬給到位就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260119
					]
				}
			]
		},
