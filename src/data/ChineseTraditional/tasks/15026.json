			},
			"dialogs": [
				{
					"id": 150260401,
					"content": "呃…這就是茜特菈莉住的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260402,
					"content": "我就知道一時半會根本收拾不完…想要吐槽也無所謂啦。奶奶我身為煙謎主的大薩滿，從來不管這些無聊的家務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260403
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260403,
					"content": "那種總是把房間收拾得乾乾淨淨的人，在輕小說裡往往都當不上主角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260404
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260404,
					"content": "另外，我那是看透世事的不修邊幅，不是宅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260405
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260405,
					"content": "她似乎很在意自己在我們眼裡的形象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260406,
					"content": "#對了，之前用法術將部分感官分享給{F#妳}{M#你}們的時候出現了一些副作用，{F#妳}{M#你}們擺脫那種副作用了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260407
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260407,
					"content": "出於身為大薩滿的責任，我必須再確認一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260408
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260408,
					"content": "妳是指能聽到各自心聲的事？沒有沒有，已經過去那麼久了，不必再為這種事擔心了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260409,
					"content": "#那為什麼我突然能聽到{NICKNAME}的心聲了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260410
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260410,
					"content": "什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260411,
					"content": "（所以是因為聽到了我在心裡的評價嗎？茜特菈莉應該更坦然一點才對吧？畢竟是「看透世事的不修邊幅」啊…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260412
					]
				},
				{
					"id": 150260412,
					"content": "我現在還能聽到的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260413
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260413,
					"content": "如果有所冒犯，我道歉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260414
					]
				},
				{
					"id": 150260414,
					"content": "#少廢話，我會想辦法處理的。嘖，之前是{F#妳}{M#你}能聽到我的心聲，現在是我能聽到{F#妳}{M#你}的心聲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260415
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260415,
					"content": "只是一種用來分享感官的法術而已，到底是什麼樣的體質才能搞出這麼複雜的副作用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260416
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260416,
					"content": "#罷了罷了，先說說{F#妳}{M#你}們來找我有什麼事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260417
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260417,
					"content": "哦，是這樣的，有人委託我們請妳出山做顧問，他們想調查一些與納塔歷史有關的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260418,
					"content": "專門委託拯救了納塔的英雄來請我？看來這些人明白奶奶我很討厭麻煩事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260419
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260419,
					"content": "他們給的報酬很不錯呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260420,
					"content": "我拒絕，我很忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260421
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260421,
					"content": "怎麼看都不像是很忙的樣子啊…果然憑我們的交情也沒辦法請她出面幫陌生人辦事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260422,
					"content": "如果這也是我的請求呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260423
					]
				},
				{
					"id": 150260423,
					"content": "#{F#妳}{M#你}的請求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260424
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260424,
					"content": "嗯，我們不久前被賦予了一項神聖的使命——幫助煙謎主製作記錄歷史大事件的特殊織物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260425,
					"content": "#欸？這一次被選中的人是{F#妳}{M#你}們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260426
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260426,
					"content": "我們當初也很驚訝，畢竟我們根本不知道如何製作那種織物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260427,
					"content": "不過在首領庇蘭的幫助下，還是獲得了一些進展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260428,
					"content": "雖然最後沒有成功，但至少我們知道製作這種織物的關鍵是一種特殊的色彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260429,
					"content": "那些人想要調查的歷史事件就與色彩有關，如果茜特菈莉能出山，或許也能幫到我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260430,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260431
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260431,
					"content": "茜特菈莉又擺出那種表情了，是我解釋得不清楚嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260432,
					"content": "該說是超展開還是伏筆回收呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260433
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260433,
					"content": "呃…我不太懂妳在想什麼，所以還是不方便嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260434,
					"content": "我…我必須慎重地考慮一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260435
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260435,
					"content": "好像有戲欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260436
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260436,
					"content": "喂！還沒談好嗎？來不來倒是給個答覆啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260437
					],
					"speakerTitle": "格洛德克"
				},
				{
					"id": 150260437,
					"content": "這…說好了讓我們來負責溝通的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260438
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260438,
					"content": "嘖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260439
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260439,
					"content": "茜特菈莉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
