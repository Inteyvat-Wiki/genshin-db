			"dialogs": [
				{
					"id": 150260601,
					"content": "格洛德克，付錢的人是我，陪同僱主等待也是你需要提供的服務吧？退下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260602
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260602,
					"content": "明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260603
					],
					"speakerTitle": "格洛德克"
				},
				{
					"id": 150260603,
					"content": "幾百歲的大薩滿竟然如此…非常抱歉，驚擾到您了，這臨時僱傭的部下果然不好約束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260604
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260604,
					"content": "呼…沒惹得茜特菈莉動手，真是萬幸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260605,
					"content": "既然您來了，不如我們就談談…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260606
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260606,
					"content": "打聽過黑曜石奶奶是什麼人物嗎？你覺得我會被你們唱的雙簧騙到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260607
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260607,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260608
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260608,
					"content": "我根本沒打算和你談，剛剛要做一個很重要的決定，但你的人打擾到我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260609
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260609,
					"content": "我出來就是為了告訴你，如果還有下一次，你們的下場會慘到恐怖小說都寫不出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260610
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260610,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260611,
					"content": "#{NICKNAME}，我們回去繼續談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260612
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260612,
					"content": "黑曜石奶奶果然名不虛傳，是我無禮了。不過我真的很難想像，就連「七彩之戰」也吸引不了您啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260613
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260613,
					"content": "你想調查的是「七彩之戰」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260614
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260614,
					"content": "#原來{NICKNAME}還沒有將此事向您講明嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260615
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260615,
					"content": "#其實我當初認為能請您出山，除了{NICKNAME}願意幫我引薦之外，還因為我覺得查清這件事對您本身也很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260616
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260616,
					"content": "我聽說那位名為維奇琳的大薩滿曾是您的故舊，想必您十分瞭解她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260617
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260617,
					"content": "如果我能釐清與「七彩之戰」有關的爭議，證明它的真實性，就能把它收錄到出版書籍裡，讓全提瓦特都瞭解這段傳奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260618
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260618,
					"content": "故友的光輝事蹟藉您之口重新流傳於世，這也算是一段美談，您意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260619,
						150260620
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260619,
					"content": "這對我完成使命有幫助。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260621
					]
				},
				{
					"id": 150260621,
					"content": "#其實{F#妳}{M#你}想完成使命的話…好吧，我先幫{F#妳}{M#你}調查一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260622
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260622,
					"content": "非常榮幸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260623
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260623,
					"content": "#少來，我可不打算接受你的僱傭。我決定幫的是{NICKNAME}，你們就順便沾點光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260624
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260624,
					"content": "茜特菈莉總算答應下來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150260625,
					"content": "（看來我和茜特菈莉的交情還是滿管用的，她終究不是那種很絕情的人。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260626
					]
				},
				{
					"id": 150260626,
					"content": "#我什麼時候讓{F#妳}{M#你}覺得是個絕情的人了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260627
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260627,
					"content": "#無妨無妨，我本來就準備和{NICKNAME}合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260628
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260628,
					"content": "請問您親身經歷過「七彩之戰」嗎？您知道戰場的遺址在哪裡嗎？現在還能不能找到一些可以證明那場戰爭發生過的遺物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260629
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260629,
					"content": "好吵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260630
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260630,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260631
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260631,
					"content": "我也想問。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260632
					]
				},
				{
					"id": 150260632,
					"content": "沒有，不知道，不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260633
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260633,
					"content": "呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260634
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260634,
					"content": "我的確曾經和她生活在同一個時代，但這不代表我經歷過與她有關的所有事件。我只是活得久了一些，又不是歷史書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260635
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260635,
					"content": "調查方向你們自己定，如果涉及到我比較瞭解的地方，我可以替你們答疑解惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260636
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 150260636,
					"content": "這樣也好…雖然您不是「七彩之戰」的親歷者，但您畢竟曾經生活在那個時代，您的意見肯定非常有用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260637
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260637,
					"content": "艾列爾，你之前想好的調查方向是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260638
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260638,
					"content": "我的計畫嗎？我之前調查到煙謎主內部有專門負責記錄歷史的人，或許可以先向他們諮詢一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260639
					],
					"speakerTitle": "艾列爾"
				},
				{
					"id": 150260639,
					"content": "那就先按照這個方向繼續調查！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260640
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260640,
					"content": "#{NICKNAME}，我們正式合作吧。畢竟我只有透過{F#妳}{M#你}才能得到這位大薩滿的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150260641
					],
					"speakerTitle": "蒙呂松"
				},
				{
					"id": 150260641,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150260620,
					"content": "這對煙謎主也很有意義。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150260621
					]
				}
			]
		},
