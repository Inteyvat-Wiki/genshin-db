			"trigger": {
				"objectNames": [
					"茉莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510301,
					"content": "#派蒙姐姐、{NICKNAME}{M#哥哥}{F#姐姐}，我餵完娜娜了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510302
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510302,
					"content": "好，我們一起去敲門找勒魯瓦先生吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510303,
					"content": "但是我有點擔心，他會不會不出來呢？最近我來找勒魯瓦先生，他都不和我說話了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510304
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510304,
					"content": "#{F#妳}{M#你}們來之前我去敲過門，他一出來那個凶凶的女婿叔叔就把他拉回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510305
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510305,
					"content": "很凶的叔叔給了我一點糖，要我回家找爸爸媽媽，然後就把門關起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510306
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510306,
					"content": "伯努瓦明明是很和氣的人，他的家人怎麼這麼冷漠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510307,
					"content": "女婿叔叔說勒魯瓦先生生病了不方便，但是我看他很健康啊？為什麼不可以跟我說話呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510308
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510308,
					"content": "派蒙姐姐，我覺得我的作文不寫也沒有關係，我更擔心勒魯瓦先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510309
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510309,
					"content": "他生病了的話一定很不舒服，我媽媽說人生病很可憐，要多關心生病的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510310
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510310,
					"content": "#{F#妳}{M#你}們可不可以跟我一起問問女婿叔叔，勒魯瓦先生得了什麼病？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510311
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510311,
					"content": "是蛋糕吃太多還是睡覺沒有蓋好被子？我可以回家去問爸爸媽媽該怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510312,
						741510313
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510312,
					"content": "一起去敲門吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				},
				{
					"id": 741510314,
					"content": "#我只是有點怕女婿叔叔，{F#妳}{M#你}們幫我跟他說話好不好？他好凶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510315
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510315,
					"content": "別怕，小茉莉，我們幫妳問！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510313,
					"content": "本來就約好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510314
					]
				}
			]
		},
