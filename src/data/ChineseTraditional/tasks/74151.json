					},
					{
						"sceneId": 3,
						"position": [
							3590.907,
							435.092,
							4531.985
						],
						"pointId": 7520
					},
					{
						"sceneId": 3,
						"position": [
							3591.538,
							435.092,
							4530.267
						],
						"pointId": 7521
					}
				]
			},
			"dialogs": [
				{
					"id": 741510501,
					"content": "先前見過的阿托斯打開大門，走了出來。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510502
					]
				},
				{
					"id": 741510502,
					"content": "#又是{F#妳}{M#你}們？{F#妳}{M#你}們到底有什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510503
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510503,
					"content": "請問伯努瓦在家嗎？我們聽說他生病了，有點擔心他的身體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510504,
					"content": "我父親在家，但他身體不舒服，不適合出門見客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510505
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510505,
					"content": "可以告訴我他生了什麼病嗎？我可以請爸爸媽媽幫忙帶藥來給勒魯瓦先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510506
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510506,
					"content": "不用了，藥我們自己會買，更何況我父親不缺藥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510507
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510507,
					"content": "我們只是想關心一下病人，幹嘛這麼冷淡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510508,
					"content": "（這個阿托斯完全不讓我們見伯努瓦！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510509,
						741510510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510509,
					"content": "（冷淡得有點過分…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				},
				{
					"id": 741510511,
					"content": "#別人的事情{F#妳}{M#你}們關心得太多了。好了，{F#妳}{M#你}們還有別的事嗎？沒有我就回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510512
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510512,
					"content": "等一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510513
					]
				},
				{
					"id": 741510513,
					"content": "#{F#妳}{M#你}要說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510514,
						741510516
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510514,
					"content": "伯努瓦真的生病了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510515
					]
				},
				{
					"id": 741510515,
					"content": "當然生病了。他病得很嚴重，我和莫蒂西婭正在想辦法，一點都用不著別人操心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510518,
					"content": "阿托斯，外面在吵什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510519
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741510519,
					"content": "沒什麼，莫蒂西婭，有幾個孩子說要探望爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510520
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510520,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510521
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741510521,
					"content": "爸爸，你的小孩子緣真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510522
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741510522,
					"content": "既然有孩子想來看你，那你要不要出來打個招呼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510523
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741510523,
					"content": "…我去看看…可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510524
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741510524,
					"content": "當然可以，你說了算，爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510525
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741510525,
					"content": "大門打開，伯努瓦從屋內緩緩走了出來。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741510526
					]
				},
				{
					"id": 741510526,
					"content": "#小客人們，{F#妳}{M#你}們又來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510527
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741510527,
					"content": "勒魯瓦先生，你還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510528
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510528,
					"content": "#我？咳咳…我的身體狀況不是很好，但{F#妳}{M#你}們不用擔心，我正在盡力休養。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510529
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741510529,
					"content": "#我的女兒和女婿待我很好，一切都好，{F#妳}{M#你}們回家去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510530
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741510530,
					"content": "爸爸，你的身體沒問題嗎？覺得勉強的話，就回去屋子裡吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510531
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510531,
					"content": "伯努瓦看著阿托斯的眼色，默默進了門。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510532
					]
				},
				{
					"id": 741510532,
					"content": "#好了，{F#妳}{M#你}們看到了吧？我父親的確身體不舒服，這下{F#妳}{M#你}們滿意了吧？沒事我就回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510533
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510533,
					"content": "我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510534,
					"content": "#阿托斯無視了{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741510535
					]
				},
				{
					"id": 741510535,
					"content": "這次和勒魯瓦先生說了兩句話，唉…希望他的身體快點好起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510536
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510536,
					"content": "派蒙姐姐，我好像給別人帶來麻煩了，其實我不想這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510537
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510537,
					"content": "茉莉怎麼會這麼想？妳才沒有給別人帶來麻煩呢！在我看來，有問題的是那個阿托斯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510538,
					"content": "哼…什麼嘛！他從頭到尾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510539,
						741510540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510539,
					"content": "茉莉先回家去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510541,
					"content": "#欸？{NICKNAME}{F#妳}{M#你}怎麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510542
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510542,
					"content": "嗯，我是該回去了。其實爸爸媽媽很不喜歡我到這裡來，要是被他們知道我今天來這裡了，他們會生氣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510543
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510543,
					"content": "不知道還有沒有機會見到勒魯瓦先生，我其實很想告訴他點心超級超級好吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510544
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510544,
					"content": "#等他身體好了，如果{F#妳}{M#你}們有見到他，替我告訴他好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510545,
						741510546
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510545,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510547,
					"content": "我也答應妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510548
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510548,
					"content": "#好，謝謝{F#妳}{M#你}，{NICKNAME}{M#哥哥}{F#姐姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510549
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510549,
					"content": "#我回家去了，{M#哥哥姐姐}{F#姐姐們}再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510550
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510550,
					"content": "#{NICKNAME}，{F#妳}{M#你}是不是想到什麼了？從剛才開始看{F#妳}{M#你}就是一副有話要說的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510551,
						741510552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510551,
					"content": "我們到旁邊去說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510553,
					"content": "好，那我們到別的地方說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510552,
					"content": "不要在這裡大聲說這些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510553
					]
				},
				{
					"id": 741510546,
					"content": "我答應妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510547
					]
				},
				{
					"id": 741510540,
					"content": "我和派蒙也要回去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510541
					]
				},
				{
					"id": 741510516,
					"content": "為什麼阻止我們見伯努瓦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510517
					]
				},
				{
					"id": 741510517,
					"content": "我為什麼非要允許不相干的人探望父親呢？我都說了，他的身體狀況不適合見客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510518
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741510510,
					"content": "（冷淡得有點突然…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510511
					]
				}
			]
		},
