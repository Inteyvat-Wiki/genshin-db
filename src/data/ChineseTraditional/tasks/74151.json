			},
			"dialogs": [
				{
					"id": 741510901,
					"content": "這對夫婦不對勁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510902
					]
				},
				{
					"id": 741510902,
					"content": "我也覺得有點奇怪，他們一個話特別多，一個話特別少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510903,
					"content": "他們出現的時機點太剛好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510904
					]
				},
				{
					"id": 741510904,
					"content": "#{F#妳}{M#你}的意思是…就在伯努瓦想要招募看護照顧自己的時候，他們就出現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510905,
					"content": "我記得歐芙小姐說過，大半年前伯努瓦還需要招募看護照顧自己，僅僅半年時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510906,
					"content": "這對夫婦成為了他的子女。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510907
					]
				},
				{
					"id": 741510907,
					"content": "#{F#妳}{M#你}說得對。一切都好刻意，這麼一想，這對夫婦真的很有問題欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
