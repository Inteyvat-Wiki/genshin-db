			},
			"dialogs": [
				{
					"id": 741500501,
					"content": "爸爸，你最近睡得怎麼樣？還會失眠嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500502
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741500502,
					"content": "我好多了，最近幾乎不做噩夢了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741500503
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741500503,
					"content": "（勒魯瓦一家的閒聊逐漸聽不清楚了）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "敲一敲"
				}
			]
		},
		{
			"id": 7415101,
			"completionStepIds": [
				7415101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415101",
							"2"
						],
						"stepId": 7415101,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7415104",
							"3"
						],
						"stepId": 7415104,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茉莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741510101,
					"content": "#{M#哥哥姐姐}{F#大姐姐、小姐姐}，{F#妳}{M#你}們來了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510102
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510102,
					"content": "#我叫派蒙，{M#他}{F#她}叫{NICKNAME}，以後叫我們的名字就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510103,
					"content": "茉莉來找伯努瓦嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510104
					]
				},
				{
					"id": 741510104,
					"content": "對，但我和勒魯瓦先生都說不到話…唉，這下我的作文寫不成了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510105
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510105,
					"content": "作文？哦哦，我想起來了，茉莉是為了寫家庭作業才做好人好事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510106,
					"content": "才不是呢！我本來就很喜歡伯努瓦先生，他很…嗯…滑滑的！對，就是滑滑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510107
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510107,
					"content": "噗！這是什麼形容，這裡應該說擅長交際之類的才對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510108,
					"content": "善良的派蒙姐姐，可不可以幫我想想辦法？我的文章寫不出來了，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510109
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510109,
					"content": "家庭教師小姐說我幫勒魯瓦先生餵貓的文章「質噗又充滿真情實意、情真意切」，要我繼續再寫一篇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510110
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510110,
					"content": "什麼「質噗」啊？是質樸吧！哦，我懂了，難怪妳要到伯努瓦家門口來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510111,
					"content": "雖然我是為了家庭作業，但我真的也很喜歡勒魯瓦先生！他要我向爸爸媽媽問好，我也照做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510112
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510112,
					"content": "爸爸媽媽聽到伯努瓦先生的名字很不開心，不讓我來…我也不知道為什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510113
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510113,
					"content": "茉莉需要拿來寫作文的素材還不簡單？就像上次一樣幫忙餵一餵貓就好了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510114,
					"content": "這樣只夠寫一行，太少了，不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510115
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741510115,
					"content": "我們陪妳一起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741510116
					]
				},
				{
					"id": 741510116,
					"content": "對對，就像之前那樣妳餵貓，我們來把門口和屋後的髒汙清理乾淨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510117,
					"content": "好了之後我們一起敲門找伯努瓦說話，妳不就有內容可以寫了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741510118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741510118,
					"content": "對耶，可以這樣！派蒙姐姐真聰明，我現在就去餵貓貓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茉莉"
				}
			]
		},
		{
