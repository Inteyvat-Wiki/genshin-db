					"鶯兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000301,
					"content": "三千摩拉夠了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000302
					]
				},
				{
					"id": 225000302,
					"content": "#{F#妳}{M#你}可真是個急性子…好吧，就當看在我們情誼的份上，我會先做璐璐的那份香膏的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000303
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000303,
					"content": "不過，白天我還得看店，只有晚上才能做些私事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000304
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000304,
					"content": "#請{F#妳}{M#你}晚上再來找我吧，我會先把準備工作做好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鶯兒"
				}
			]
		},
		{
			"id": 2250004,
			"completionStepIds": [
				2250002
			],
