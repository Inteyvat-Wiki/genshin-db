			"dialogs": [
				{
					"id": 225000601,
					"content": "#{F#大姐姐}{M#大哥哥}，{F#妳}{M#你}拿到香膏了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000602
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000602,
					"content": "拿到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000603
					]
				},
				{
					"id": 225000603,
					"content": "#謝謝{F#大姐姐}{M#大哥哥}，鶯兒姐姐做的香膏可真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000604
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000604,
					"content": "不知道小蒙和阿飛聞到了之後會是什麼反應…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000605
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000605,
					"content": "不過，不管他們是什麼反應，應該都很好玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000606,
						225000608
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000606,
					"content": "他們會喜歡的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000607
					]
				},
				{
					"id": 225000607,
					"content": "這樣就最好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000610,
					"content": "#謝謝{F#大姐姐}{M#大哥哥}，我等會就回家試試看這盒香膏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000611
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000611,
					"content": "如果適合的話，那我就可以一直用下去啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000608,
					"content": "妳最喜歡和誰玩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000609
					]
				},
				{
					"id": 225000609,
					"content": "唔？沒有「最喜歡」喔，小蒙和阿飛，都是我最好的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000610
					],
					"speakerTitle": "璐璐"
				}
			]
		},
