				"points": []
			},
			"dialogs": [
				{
					"id": 225000501,
					"content": "香膏已經做好了，是我用薄荷精油特別製作的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000502
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000502,
					"content": "來，拿好了，帶回去給璐璐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000503,
						225000504
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000503,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 225000504,
					"content": "為什麼是薄荷精油？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000505
					]
				},
				{
					"id": 225000505,
					"content": "稀釋一些刺激性的成分…略微中和一下氣味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000506
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000506,
					"content": "話說回來，當時也真是沒想到會收到璐璐的訂單呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000507
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000507,
					"content": "情竇初開的年紀，回想一下真是令人臉紅心跳啊，要是當時懂得再多一點的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000508
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000508,
					"content": "咳…好了，快點拿回去給璐璐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鶯兒"
				}
			]
		},
