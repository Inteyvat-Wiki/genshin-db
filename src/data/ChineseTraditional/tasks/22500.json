			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鶯兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000201,
					"content": "#哎呀，又是{F#妳}{M#你}，這次來找我是想做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000202
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000202,
					"content": "來取璐璐的東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000203
					]
				},
				{
					"id": 225000203,
					"content": "那孩子的東西啊…我記起來了，她確實讓我幫她做一份香膏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000204
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000204,
					"content": "不過，你們來得有點不巧…不知道為什麼，自從那天你們來找我之後，突然有很多人來找我預訂香膏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000205
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000205,
					"content": "那麼多訂單，我還得打理店裡的生意，一個人都要處理不來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000206
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000206,
					"content": "而且璐璐還是個孩子，平常我們大人用的香膏如果直接給她用的話，未免有些不太合適。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000207
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000207,
					"content": "我之前在想怎麼調整香膏的配方，才剛剛想出個方案來，還沒開始做呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000208
					],
					"speakerTitle": "鶯兒"
				},
				{
					"id": 225000208,
					"content": "如果要加急的話，倒也不是不行，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000209
					],
					"speakerTitle": "鶯兒"
				}
			]
		},
		{
			"id": 2250003,
			"completionStepIds": [
				2250002
