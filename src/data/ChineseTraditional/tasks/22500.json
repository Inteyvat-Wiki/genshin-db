					"璐璐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 225000101,
					"content": "什麼時候才能做好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000102
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000102,
					"content": "今天沒玩遊戲嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000103
					]
				},
				{
					"id": 225000103,
					"content": "#{F#大姐姐}{M#大哥哥}，是{F#妳}{M#你}呀，最近不適合玩遊戲呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000104
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000104,
					"content": "小蒙好像有點不開心，老是一個人發呆，阿飛也時不時就找不到人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000105
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000105,
					"content": "我問小蒙怎麼了，小蒙也不和我說…總覺得，大家最近都有點奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000106,
						225000110
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000106,
					"content": "長大了就會這樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000107
					]
				},
				{
					"id": 225000107,
					"content": "人長大了，就會不開心嗎？但是小蒙和阿飛都很想長大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000108
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000108,
					"content": "如果是這樣的話，那我還是先不長大比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000109
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000109,
					"content": "#先不說這個了，我有點小事，想請{F#大姐姐}{M#大哥哥}幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000112,
					"content": "#{F#妳}{M#你}能幫我去鶯兒姐姐那裡拿點東西嗎？我和她已經說好了，那裡應該已經把東西留給我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000113,
						225000115
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000113,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000114
					]
				},
				{
					"id": 225000114,
					"content": "#那就拜託{F#大姐姐}{M#大哥哥}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000115,
					"content": "從鶯兒那裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000116
					]
				},
				{
					"id": 225000116,
					"content": "#{F#大姐姐}{M#大哥哥}可不要亂想喔，我只是拜託鶯兒姐姐幫忙做了點東西而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000117
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000117,
					"content": "#總之，就拜託{F#大姐姐}{M#大哥哥}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "璐璐"
				},
				{
					"id": 225000110,
					"content": "妳也不開心嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						225000111
					]
				},
				{
					"id": 225000111,
					"content": "#我？我還好喔，不過…還是有點小事想請{F#大姐姐}{M#大哥哥}幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						225000112
					],
					"speakerTitle": "璐璐"
				}
			]
		},
		{
			"id": 2250002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
