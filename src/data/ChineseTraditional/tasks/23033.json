					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7066502",
							"0"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330501,
					"content": "太好了，非常好！這些畫片肯定夠朝霧再畫好幾張了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330502,
						230330503
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330502,
					"content": "想玩「七聖召喚」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330504
					]
				},
				{
					"id": 230330504,
					"content": "#哈哈哈…我會把{F#妳}{M#你}的願望轉達給學者們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330505
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330505,
					"content": "不過，這群學者們的研究似乎進行得很順利，現在他們討論的時候都能打打趣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330506
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330506,
					"content": "不像最開始，咳…劍拔弩張的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230330503,
					"content": "期待「七聖召喚」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330504
					]
				}
			]
		},
