			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330601,
					"content": "壞了，這下真的被這幫須彌人給騙慘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330602
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330602,
					"content": "你被騙錢了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330603
					]
				},
				{
					"id": 230330603,
					"content": "#哎喲！{F#妳}{M#你}…你嚇我一跳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330604
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330604,
					"content": "唉，我倒是沒有被騙錢，就是被教令院裡的那群人給騙來了須彌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330605
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330605,
					"content": "還沒自我介紹…我叫福本，是一個稻妻的小說家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330606
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330606,
					"content": "你說你被騙了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330607
					]
				},
				{
					"id": 230330607,
					"content": "#這事情說來話長…{F#妳}{M#你}聽說過教令院研發出的卡牌遊戲「七聖召喚」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330608,
						230330609
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330608,
					"content": "七…七聖召喚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330610
					]
				},
				{
					"id": 230330610,
					"content": "#{F#妳}{M#你}沒聽說過？不應該啊，{F#妳}{M#你}沒看過我寫的那本《召喚王》嗎？在「八重堂」裡可是賣得很好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330611
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330611,
					"content": "呃…《召喚王》也沒看過？沒、沒關係，不用管這些！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330612
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330612,
					"content": "總之，就是須彌教令院裡的人研發了一種名為「七聖召喚」的卡牌遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330613
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330613,
					"content": "為了推廣，他們就透過「八重堂」來拜託我，以「七聖召喚」這種卡牌遊戲的規則為藍本，寫一本輕小說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330614
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330614,
					"content": "因為那群學者自己都沒把「七聖召喚」的規則梳理清楚，加上須彌和稻妻離得太遠，我們難以溝通，所以寫起來非常艱難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330615
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330615,
					"content": "不過在「八重堂」內諸位老師的幫助下，我還是完成了《召喚王》。不僅銷量不錯，而且還和計畫中一樣帶動了「七聖召喚」的銷量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330616
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330616,
					"content": "然後，重點來了…那群學者說，他們要重新梳理一遍「七聖召喚」的規則，再對外推出一版全新的「七聖召喚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330617
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330617,
					"content": "他們也再次拜託我以新版的「七聖召喚」為藍本續寫《召喚王》，並且邀請我來須彌教令院面對面溝通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330618
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330618,
					"content": "我從稻妻長途跋涉來了須彌，但學者們說…新版「七聖召喚」的規則他們還沒有確定下來，請我先在須彌暫住一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330619
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330619,
					"content": "他們說為了致歉，還會幫我介紹幾個教令院裡的名人作為我取材的對象，比如那位賽諾先生，還有提納里先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330620
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330620,
					"content": "我本來有點生氣，但是那群學者…每個人都是一副嚴重睡眠不足的樣子，接待我的那位學者簡直站都站不穩了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330621
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330621,
					"content": "唉，我想了想，本來我的大綱就還沒有確定，再等一段時間也沒什麼大問題，就答應了他們暫時住在須彌，等他們把新規則確定下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330622
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330622,
					"content": "這不，我今天就是出來取材的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330623
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330623,
					"content": "#旅行者，{F#妳}{M#你}願意幫我一個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330624,
						230330625
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330624,
					"content": "你先說是什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330626
					]
				},
				{
					"id": 230330626,
					"content": "是這樣，為了讓《召喚王》這本小說更有吸引力，我特地去拜託朝霧小姐來繪製插畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330627
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330627,
					"content": "我已經想好了幾個關鍵的情節，但除了文字描述外，我還要給朝霧小姐一點具體的姿勢參考…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330628
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330628,
					"content": "但我沒什麼戰鬥的經驗，擺出來的幾個姿勢都軟趴趴的，看起來一點精神都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330629
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330629,
					"content": "#旅行者，我看{F#妳}{M#你}肯定有豐富的戰鬥經驗，能拜託{F#妳}{M#你}來做模特兒嗎？{F#妳}{M#你}瞧，我還借了架「留影機」來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330630,
						230330631
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330630,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330633
					]
				},
				{
					"id": 230330633,
					"content": "#謝謝{F#妳}{M#你}願意幫忙，旅行者。我已經找到了一個不錯的取景地，我們去那邊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230330631,
					"content": "拍得好看點喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330632
					]
				},
				{
					"id": 230330632,
					"content": "#沒問題，{F#妳}{M#你}就放心吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330633
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330625,
					"content": "我不太會打牌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330626
					]
				},
				{
					"id": 230330609,
					"content": "卡牌遊戲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330610
					]
				}
			]
		},
