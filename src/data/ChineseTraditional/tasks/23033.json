			"dialogs": [
				{
					"id": 230330801,
					"content": "就是這裡了，讓我看看…首先，我需要一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330802
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330802,
					"content": "角色陷入困境中的姿勢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330803
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330803,
					"content": "這描述也太模糊了，完全不知道要擺出什麼樣的姿勢啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230330804,
					"content": "#這個…就按照{F#妳}{M#你}的第一反應來擺姿勢就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330805
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330805,
					"content": "#旅行者，當{F#妳}{M#你}遇見困境的時候，你會做出什麼樣的反應？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330806,
						230330812
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330806,
					"content": "那當然是戰鬥了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330807
					]
				},
				{
					"id": 230330807,
					"content": "#喔，很有氣勢的回答，面對困境的第一反應是戰鬥…那就請{F#妳}{M#你}擺出一個有力的戰鬥姿態來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330808
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330808,
					"content": "#就是那種…{F#妳}{M#你}已經陷入困境，必須要開始掙扎了的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330809
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330809,
					"content": "#這場戰鬥就是{F#妳}{M#你}為了活下去而做出的掙扎！為了活下去而不得不做出的選擇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330810
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330810,
					"content": "咳！這都是我為角色設計的臺詞…但總之，差不多就是這樣的一種感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330811
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330811,
					"content": "唔唔…真有角色會說出這種話來嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230330812,
					"content": "我不會讓自己陷入困境。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330813
					]
				},
				{
					"id": 230330813,
					"content": "#喔！{F#妳}{M#你}這個回答很有傲氣啊，很不錯，正好能和我小說裡的一個人對上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330814
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330814,
					"content": "#那就拜託{F#妳}{M#你}擺出一個，很有傲氣的姿勢吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				}
			]
		},
