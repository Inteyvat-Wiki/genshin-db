				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330101,
					"content": "#旅行者！又見面了，上次多虧{F#妳}{M#你}幫忙，朝霧小姐的插畫創作得很順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330102,
						230330103
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330102,
					"content": "能幫上忙就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330104
					]
				},
				{
					"id": 230330104,
					"content": "是啊，教令院的那幫學者還在討論一些製作細節呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330105
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330105,
					"content": "有的學者說，既然是新版，那玩法就要有創意，遊戲的資源系統也要有創意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330106
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330106,
					"content": "有的學者說，卡牌遊戲一定要有精美的卡面，所以他要求把預算撥去雇更多的畫家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330107
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330107,
					"content": "還有一位就更離譜了…他希望在所有參與製作「七聖召喚」的學者之間舉辦一場對戰比賽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330108
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330108,
					"content": "誰能贏得冠軍，誰的意見就更有份量。我看這個人就是單純地想要玩「七聖召喚」而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330109
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330109,
					"content": "他們的討論我幾乎都聽不懂，所以就藉口取材跑了出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330110
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330110,
					"content": "#旅行者，{F#妳}{M#你}能再給我當一回模特兒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330111
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330111,
					"content": "#這次我沒什麼特別的要求，只需要{F#妳}{M#你}為我展示一下{F#妳}{M#你}的戰鬥技巧就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330112,
						230330113
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330112,
					"content": "你寫的不是卡牌遊戲小說嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330114
					]
				},
				{
					"id": 230330114,
					"content": "#{F#妳}{M#你}這就有所不知了，單純地打牌已經沒有市場了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330115
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330115,
					"content": "說實話，打牌變打架我都覺得有點俗氣了，我都已經想讓角色騎著馬一邊競速一邊打牌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330116
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330116,
					"content": "不過我還沒想好他們騎馬打牌的原因…所以我決定還是先寫一段打牌變打架的戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330117
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330117,
					"content": "取景地我已經選好了，我們趕緊出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				},
				{
					"id": 230330113,
					"content": "打牌和戰鬥有什麼關係？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330114
					]
				},
				{
					"id": 230330103,
					"content": "你今天還是來取材嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330104
					]
				}
			]
		},
		{
			"id": 2303303,
			"completionStepIds": [
				2303303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2303303",
							"2"
						],
						"stepId": 2303303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"福本"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230330301,
					"content": "#就是這裡了！{F#妳}{M#你}看前面，有幾個零星的史萊姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330302
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330302,
					"content": "#旅行者，請{F#妳}{M#你}用{F#妳}{M#你}認為最帥氣的方式，一口氣打倒它們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330303
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330303,
					"content": "這真的能用在卡牌遊戲小說裡嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230330304
					]
				},
				{
					"id": 230330304,
					"content": "哎呀，放心吧，雖然我寫的小說裡大部分事情都能靠打牌解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330305
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330305,
					"content": "但總有一些不能靠打牌解決的事，需要角色們運用一些「現實」手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230330306
					],
					"speakerTitle": "福本"
				},
				{
					"id": 230330306,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者。我會在這邊看著的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "福本"
				}
			]
		},
		{
			"id": 2303305,
			"completionStepIds": [
				2303305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
