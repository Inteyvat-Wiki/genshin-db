			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3790401,
					"content": "哦呼。不出所料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790402
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790402,
					"content": "琴似乎有種…青春煥發的感覺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790403
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3790403,
					"content": "團長在誇獎自己耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790404,
					"content": "…我是說天空之琴啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790405
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3790405,
					"content": "#全靠{NICKNAME}淨化結晶，天空之琴的「風」之元素才沒有繼續枯竭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790406
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790406,
					"content": "但距離重新滿溢也還有一些距離呢。如果能再多得到一些特瓦林的淚滴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790407,
						3790409,
						3790410
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790407,
					"content": "我們會幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790408
					]
				},
				{
					"id": 3790408,
					"content": "但要怎麼收集淚水結晶呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790411,
					"content": "即使是現在，特瓦林也正在哭泣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790412
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790412,
					"content": "承受著痛苦，在人跡罕至的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790413
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790413,
					"content": "特瓦林…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790414
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3790414,
					"content": "真是個可憐的大傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790415,
					"content": "這不是榮譽騎士一個人的事，我們都會立刻開始行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790416
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3790416,
					"content": "#得到淚滴結晶以後，就再拜託{NICKNAME}來淨化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790417
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3790417,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790418
					]
				},
				{
					"id": 3790418,
					"content": "嗯…真好啊。英雄們相互託付、攜手啟程的橋段，總是那麼迷人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790419
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790419,
					"content": "就讓我用這一曲來為你們送行吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790420
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790420,
					"content": "咦？你這是想偷懶…想只出一張嘴嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790421,
					"content": "彈琴需要用到手呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790422
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790422,
					"content": "嗚啊，好生氣！我決定幫你取一個難聽的綽號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790423,
					"content": "唔…決定了，以後就叫你「<color=#00E1FFFF>賣唱的</color>」好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790409,
					"content": "要怎麼收集淚水結晶呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				},
				{
					"id": 3790410,
					"content": "要怎麼讓牠哭？打就可以了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790411
					]
				}
			]
		}
	]
}