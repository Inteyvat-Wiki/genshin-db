			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3790201,
					"content": "喲，歡迎回來，我忠實的聽眾們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790202
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790202,
					"content": "#啊，那是…天空之琴！看來{F#妳}{M#你}們搞定了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790203
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790203,
					"content": "流風紋的薔薇木、微涼的星鐵弦，真是懷念的感覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790204
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790204,
					"content": "怎麼樣，溫迪？可以用它來呼喚特瓦林了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790205
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3790205,
					"content": "嗯…雖然是如假包換的風神至寶，但現在恐怕還不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790206
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790206,
					"content": "——如你們所見，歷經千年的時光，「風」的力量早就枯竭了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790207
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790207,
					"content": "這個狀態的話，要在迪盧克家的酒館駐唱，也許還行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790208
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790208,
					"content": "酒館的演出位也是有一大堆歌手競標的，你別太想當然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790209
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3790209,
					"content": "迪盧克老爺應該批評更重要的地方吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790210,
					"content": "喂，歌手！你把天空之琴借出來，就是為了彈給醉鬼聽的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790211,
					"content": "欸嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790212
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790212,
					"content": "「欸嘿」是什麼意思啊…！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3790213,
					"content": "總而言之，想要與特瓦林溝通，這還遠遠不夠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790214
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790214,
					"content": "不過，並不是琴的問題，而是琴弦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790215
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790215,
					"content": "#到{F#妳}{M#你}出馬的時候了，異鄉人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790216,
						3790217
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790216,
					"content": "我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				},
				{
					"id": 3790218,
					"content": "#放心，我不是讓{F#妳}{M#你}去維修這珍貴的豎琴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790219
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790219,
					"content": "而是這些琴弦上附著的「風」之元素，濃度還遠遠不夠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790220
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790220,
					"content": "#{NICKNAME}，{F#妳}{M#你}有好好保存特瓦林的淚水結晶吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790221
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790221,
					"content": "（點頭）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3790217,
					"content": "我對樂器的修理沒有什麼心得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3790218
					]
				}
			]
		},
		{
			"id": 37903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
