			"dialogs": [
				{
					"id": 3790222,
					"content": "很好，試著把它滴在天空之琴上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3790302
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3790302,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 37904,
			"completionStepIds": [
				37904
