				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210220501,
					"content": "#{F#妳}{M#你}回來了，我都要等不及了，{F#妳}{M#你}找到什麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229601
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210229601,
					"content": "又找到兩座石碑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229602
					]
				},
				{
					"id": 210229602,
					"content": "快給我看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229603
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210229603,
					"content": "「…戰於『歸離原』，彼時黑塵漫天，千岩俱裂…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229604
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210229604,
					"content": "這是…好像是在說，在歸離原上發生過一場大戰，而且規模很大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229605
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210229605,
					"content": "「歸離集」應該就是毀於這次大戰。但是另外一段話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229606
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210229606,
					"content": "…似乎是一位不願意離開「歸離集」的人所留下來的，這個人一直守在這裡，而且…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229607
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210229607,
					"content": "而且還有寶藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210220502
					]
				},
				{
					"id": 210220502,
					"content": "#…{F#妳}{M#你}對這個還真是敏感，不過，光是從字面上理解。在這片「歸離原」上，確實有著一批寶藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220503
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220503,
					"content": "但是，上面還說「…引之以『歸終四誡』…」，後面還說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220504
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220504,
					"content": "「教之以智、律之以德、堅其筋骨，眾志一心，四者匯之而成『歸離集』。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220505
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220505,
					"content": "唔…根本不知道從哪裡理解起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220506
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220506,
					"content": "我們回望舒客棧去吧。在那裡稍作休整之後，我們再來解讀這個「歸終四誡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
		{
			"id": 2102295,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2102208",
							"3"
						],
						"stepId": 2102208,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
