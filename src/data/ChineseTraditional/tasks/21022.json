		},
		{
			"id": 2102203,
			"completionStepIds": [
				2102209
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2102208",
							"3"
						],
						"stepId": 2102208,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2102209",
							"2"
						],
						"stepId": 2102209,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210220301,
					"content": "#{F#妳}{M#你}從遺蹟裡找到線索了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210229501
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210229501,
					"content": "找到了五座石碑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210229502
					]
				},
				{
					"id": 210229502,
					"content": "太好了，讓我來看看…呃，這些文字，順序都亂了，我要理理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220302
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220302,
					"content": "…好像很多文字都缺失了，讀起來斷斷續續的，而且，也不知道這種順序對不對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220303
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220303,
					"content": "總之，我先大致排列了一下，這些文字連起來應該是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220304
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220304,
					"content": "「…初，因農而興，聚之為集…有神臨，名『歸終』，善揚塵，遮天不知幾千里…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220305
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220305,
					"content": "「…引誡四條，告以諸民…後又有神臨，以岩為器，遷璃月族民於集，共護諸民…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220306
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220306,
					"content": "「…取二神之名，號此集為『歸離』…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220307
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220307,
					"content": "唔，看起來，這是在講述這片「歸離集」的來歷，還有一位護佑著「歸離集」，善於操控「塵」的神明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220308
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220308,
					"content": "不過，上面還說，還有一位魔神曾經到過這裡，甚至還把自己的子民遷過來了一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220309
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220309,
					"content": "就連「歸離集」這個名字，都是從這兩位神的名字中各取了一個字，合起來之後得到的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220310
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220310,
					"content": "真是罕見，文獻記載裡，還沒有兩位魔神能這麼和平相處，而且還互相合作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220311
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220311,
					"content": "與其說是兩位魔神，不如說是兩位關係很好的朋友呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220312
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220312,
					"content": "不過，真奇怪，為什麼後面突然沒有了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220313
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220313,
					"content": "而且，「歸離集」又怎麼會變為廢墟的？有著兩位魔神共同護佑，一般的天災人禍，應該都不會毀滅整個「歸離集」才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220314
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220314,
					"content": "一定是發生了什麼連魔神都無法解決的災難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220315
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220315,
					"content": "#旅行者，{F#妳}{M#你}能再去周圍找找線索嗎？如果不出意外的話，這裡應該還有更多{F#妳}{M#你}之前發現的那種石碑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220316
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220316,
					"content": "也許，那些石碑上記載著後面的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220317
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220317,
					"content": "但這些石碑上所記載的東西，和一些文獻中所記載的好像又有所差別…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210220318
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 210220318,
					"content": "唉，這麼多傳說，這麼多說法…到底哪一個才是真的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
