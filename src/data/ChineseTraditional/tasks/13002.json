				"points": []
			},
			"dialogs": [
				{
					"id": 130020501,
					"content": "快看！有人在這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020502,
					"content": "是你在這裡抽取地脈嗎？快把那台機器停掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020503,
					"content": "你怎麼不說話，是不是心虛了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020504,
					"content": "…他的身體沒有任何溫度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020505
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020505,
					"content": "骨瘦如柴、眼袋發青，應該是長期營養不良加上過度勞累，讓他倒下後再也沒有醒來。這裡到底發生了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020506
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020506,
					"content": "咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020507
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020507,
					"content": "…差點把你忘了。給，這是最後一個了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020508
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020508,
					"content": "咕嚕！咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020509
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020509,
					"content": "它在做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020510,
					"content": "不清楚。從房間的佈局來看，這裡是實驗室，往裡走應該會有存放實驗資料的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020511
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020511,
					"content": "資料室中肯定會留下一些線索，我們去看看吧，或許能弄清楚這裡的來龍去脈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
		},
		{
			"id": 1300207,
