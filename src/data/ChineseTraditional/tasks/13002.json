			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提納里",
					"阿巴圖伊",
					"卡卡塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130020701,
					"content": "你們有找到什麼東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020702,
					"content": "實驗筆記很多，全部看完太花時間了。我找了實驗用的錄影帶，雖然看編號，應該是兩年前的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020703
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020703,
					"content": "錄影帶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020704,
					"content": "嗯。素論派曾經做過一種裝置，用來記錄實驗影像，記錄的成品就是錄影帶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020705
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020705,
					"content": "但這種裝置造價高昂，而且不太穩定，所以只在部分實驗室使用，沒有對外公開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020706
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020706,
					"content": "那我們快看一看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020707,
					"content": "稍等，我看一下怎麼播放。好了，這樣應該就可以了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020708
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020708,
					"content": "放入錄影帶後，放映機上逐漸顯示出過去的畫面…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020709
					]
				},
				{
					"id": 130020709,
					"content": "卡卡塔、卡卡塔？真是的，一下子就不見，跑到哪裡去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020710
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020710,
					"content": "咕嚕嚕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020711
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020711,
					"content": "原來你在啊！快過來看看，這裡就是我們的新家了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020712
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020712,
					"content": "我，阿巴圖伊，要在這裡大顯身手，讓教令院那些老古董們刮目相看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020713
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020713,
					"content": "咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020714
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020714,
					"content": "哦？你也很高興嘛！不過卡卡塔，你知道我們要做什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020715
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020715,
					"content": "咕嚕嚕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020716
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020716,
					"content": "哈哈哈哈…是啊，我猜你也不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020717
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020717,
					"content": "聽好了卡卡塔，我要在這裡造出可量產的機械生命，所用的技術不同於以往任何一種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020718
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020718,
					"content": "我會用機械模擬器官，讓電流如血液般流淌；鋼鐵鑄造的心臟不停跳動，元件密佈的大腦可以像我一樣思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020719
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020719,
					"content": "從遺蹟中得到的啟示、被教令院禁止的研究…我希望一切都能在這裡生根發芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020720
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020720,
					"content": "到時候，你們能聽懂人類的語言，能夠和人類一同生活。不是單調無趣的機關，而是貨真價實的生命！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020721
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020721,
					"content": "咕嚕嚕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020722
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020722,
					"content": "沒關係。你會聽懂的，總有一天會聽懂的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020723
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020723,
					"content": "錄影到這裡就結束了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020724
					]
				},
				{
					"id": 130020724,
					"content": "卡卡塔，應該就是那隻機械螃蟹吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020725,
					"content": "還有，聽那個叫阿巴圖伊的學者說，他好像要向教令院證明什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020726,
					"content": "「廢止研究」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020727
					]
				},
				{
					"id": 130020727,
					"content": "我想起來了。當初我確實有一個叫阿巴圖伊的後輩，因為研究機械生命被趕出了教令院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020728
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020728,
					"content": "「後輩」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020729,
					"content": "「後輩」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020730
					]
				},
				{
					"id": 130020730,
					"content": "怎麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020731
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020731,
					"content": "沒有沒有，只是感覺阿巴圖伊，應該比提納里的年紀要大？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020732
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020732,
					"content": "學級和年齡無關。我很早就學完了必修課，所以後入學的人通常都會稱呼我為前輩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020733
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020733,
					"content": "這樣啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020734,
					"content": "當然，年齡也確實是個問題。有一段時間我感覺自己就像什麼珍稀動物，經常被人拉去合影…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020735
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020735,
					"content": "咳。這些不重要，還是去找找看有沒有其他錄影帶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
