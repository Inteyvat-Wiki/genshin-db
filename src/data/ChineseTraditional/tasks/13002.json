			"trigger": {
				"objectNames": [
					"提納里",
					"卡卡塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130020401,
					"content": "這是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020402,
						130020403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020402,
					"content": "沒見過的機器…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020404
					]
				},
				{
					"id": 130020404,
					"content": "地脈的能量就是從這裡溢出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020405
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020405,
					"content": "這裝置…在抽取地脈，而且是無休止地抽取地脈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020406
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020406,
					"content": "到底是誰做的，幹這種事之前不考慮後果的嗎？像這樣不停地破壞地脈流動，地脈甚至無法完成自我修復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020407
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020407,
					"content": "怎麼會…必須要讓它停下來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020408,
					"content": "讓我看看…呃…找不到可以操作的地方呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020409,
					"content": "頭開始暈了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020410
					]
				},
				{
					"id": 130020410,
					"content": "站在這裡就等同於直接被地脈能量沖刷，可能會對身體產生不可逆轉的損傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020411
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020411,
					"content": "#{NICKNAME}，{F#妳}{M#你}帶著派蒙先退出去。我來研究一下怎麼把這東西關掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020412
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020412,
					"content": "可是…就算是提納里，也沒辦法避免地脈的影響吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020413,
					"content": "我們也要一起留下，不能讓提納里一個人在這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020414,
					"content": "那就一起找吧。看不見控制裝置，代表這附近應該有「暗門」才對——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020415
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020415,
					"content": "咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020416
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020416,
					"content": "咕嚕！咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020417
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020417,
					"content": "難道說你知道暗門在哪嗎？喂，等等我們呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020403,
					"content": "感覺不太舒服…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020404
					]
				}
			]
		},
