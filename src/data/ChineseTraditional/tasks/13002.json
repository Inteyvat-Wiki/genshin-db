					"content": "咕嚕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020102
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020102,
					"content": "咕嚕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020103
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020103,
					"content": "咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020104
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020104,
					"content": "它在這裡停下來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020105,
					"content": "仔細觀察的話，這裡的植物確實不太一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020106
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020106,
					"content": "地脈能量也比別處更強，看來這裡或許就是我們要找的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020107
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020107,
					"content": "做好準備，進去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
		},
		{
			"id": 1300204,
			"completionStepIds": [
				1300204
			],
