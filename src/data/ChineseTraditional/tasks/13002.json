						130020911
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020911,
					"content": "前段時間的實驗中，我成功幫你們添加了生命的「本能」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020912
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020912,
					"content": "當能量不足或零件破損的時候，你們會優先執行「求生」指令，主動地補充能源、更換零件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020913
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020913,
					"content": "這是非常危險的。而今天，我做了一件更加危險的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020914
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020914,
					"content": "咕嚕嚕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020915
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020915,
					"content": "我正式啟用了第三代地脈提取機，以地脈作為我們今後的能量來源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020916
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020916,
					"content": "研發機械生命需要大量能源，就算我省吃儉用，手上這點錢也遠遠不夠用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020917
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020917,
					"content": "我也會累啊，卡卡塔。實驗進行到現在，我已經不知道驅使我前進的動力是什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020918
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020918,
					"content": "他們說，就算模擬生物器官的運轉，機械依舊是冰冷的工具。我想證明他們是錯的，想讓你們變成能聽能說的鮮活生命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020919
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020919,
					"content": "咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020920
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020920,
					"content": "我沒有在跟你說開心的事情，卡卡塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020921
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020921,
					"content": "語言系統、情感系統、動作系統…我不停地嘗試，竭盡全力去豐富和完善你們的功能，卻從未得到任何有效的回應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020922
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020922,
					"content": "你是我所有成果中最特別的那個，但即便是你也沒辦法理解我，只會對我預先設定的指令或關鍵字做出有限的反應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020923
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020923,
					"content": "卡卡塔，哪怕一次也好，我多希望你能開口和我說說話啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020924
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020924,
					"content": "咕嚕嚕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020925
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020925,
					"content": "是啊。你聽不懂，也沒辦法回答我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020926
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020926,
					"content": "就這樣吧，過幾天我會把研發失敗的地脈提取機賣掉，換點錢來繼續實驗。路總要走下去，我沒有別的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020927
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020927,
					"content": "錄影到這裡就結束了。提納里平靜地放入了下一份錄影帶。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020928
					]
				},
				{
					"id": 130020928,
					"content": "這倒是新的發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020929
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020929,
					"content": "如果從這裡額外引入兩個控制系統，來模擬大腦結構中的「丘腦」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020930
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020930,
					"content": "嘶…偏偏是這個時候開始心臟不適。果然不該從藥錢裡省的…卡卡塔？過來幫我一把…咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020931
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020931,
					"content": "奇怪…身體使不上力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020932
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020932,
					"content": "糟了。得把裝置關掉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020933
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020933,
					"content": "咕嚕嚕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020934
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020934,
					"content": "關閉裝置…咳咳…如果讓它們不受限制地補充能源，會…失控…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020935
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020935,
					"content": "咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020936
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020936,
					"content": "也對，我沒有錄入過關閉裝置的命令，所以你聽不懂我在說什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020937
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020937,
					"content": "結果還是像教令院那些人說的一樣，機械生命帶來的只有危險。我的研究…有什麼意義嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020938
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020938,
					"content": "咕嚕嚕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020939
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020939,
					"content": "咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020940
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130020940,
					"content": "抱歉卡卡塔，直到最後還是沒辦法讓你成為…真正的機械生命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020941
					],
					"speakerTitle": "阿巴圖伊"
				},
				{
					"id": 130020941,
					"content": "最後一卷錄影到這裡就結束了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130020942
					]
				},
				{
					"id": 130020942,
					"content": "原來是這樣。看來地脈洩漏事件，更像是一個意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020943
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020943,
					"content": "阿巴圖伊意外去世，機械怪物在「本能」的驅使下不停地從地脈抽取機中獲得能源，最終導致地脈出現嚴重破損。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020944
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020944,
					"content": "那卡卡塔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130020945
					]
				},
				{
					"id": 130020945,
					"content": "對哦。為什麼卡卡塔沒有像其他機械怪物一樣失控呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020946
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020946,
					"content": "因為卡卡塔和那些機械怪物不太一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020947
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020947,
					"content": "與真實生命構造相似、會哭會笑、會自主思考…在阿巴圖伊看來，擁有這些性能的機械，才能被稱為機械生命吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020948
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020948,
					"content": "或者說，只有造出這樣的機械，才能讓教令院認可他長期以來的研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020949
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020949,
					"content": "但其實如果他能靜下心來，把卡卡塔看做朋友而非實驗品的話，他應該就能注意到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020950
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020950,
					"content": "卡卡塔確實不會說話，但它關心阿巴圖伊，勝過關心它自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020951
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020951,
					"content": "這是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020952
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130020952,
					"content": "#稍微等等，{F#妳}{M#你}們自然就明白了。在那之前，我們還有更重要的任務——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130020953
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130020953,
					"content": "先找到地脈抽取機的控制裝置，把它關閉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
		},
		{
			"id": 1300210,
			"completionStepIds": [
				1300210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300210",
							"2"
						],
						"stepId": 1300210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提納里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130021001,
					"content": "…這裡應該就是控制裝置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021002
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021002,
					"content": "關閉控制器後，地脈抽取機應該就會停止運轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021003
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021003,
					"content": "沒有了破壞地脈的「外力」，地脈應該會緩慢地自我修復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021004
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021004,
					"content": "#當然，我想{F#妳}{M#你}們此時更關心卡卡塔在做什麼。走，一起回去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
		},
		{
			"id": 1300211,
			"completionStepIds": [
				1300211
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300211",
							"2"
						],
						"stepId": 1300211,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提納里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130021101,
					"content": "所以…卡卡塔一直收集零件，是因為它覺得這樣就能「修好」自己的主人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021102,
					"content": "對卡卡塔來說，它根本無法理解什麼是「死亡」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021103
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021103,
					"content": "但是它大概記得，自己曾經也出過「故障」，那時候阿巴圖伊幫它更換了零件，成功讓它恢復了「正常」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021104
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021104,
					"content": "卡卡塔確實不具備思考能力，很多事也不懂，但它就像小孩子一樣，會模仿大人做過的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021105
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021105,
					"content": "所以它才一直搶奪機械零件…但，不管它怎麼努力，其實都是修不好的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021106,
					"content": "是啊，但重要的是它產生了「想要修好阿巴圖伊」的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021107
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021107,
					"content": "沒人知道這個想法是怎麼產生的，但這個想法本身，甚至壓制了阿巴圖伊為它設定的「本能」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021108
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021108,
					"content": "如果真如我們所推測，這確實是能夠震撼教令院的研究。古代的一些科技或許能夠做到，但還沒有人依靠現代的科學成功實現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021109
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021109,
					"content": "卡卡塔？卡卡塔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021110,
					"content": "聽得到嗎？提納里說你很厲害哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021111,
					"content": "它沒有回應…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130021112
					]
				},
				{
					"id": 130021112,
					"content": "已經到極限了吧。這段時間，它一直沒有補充能源，也沒有為自己替換掉嚴重磨損的零件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021113
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021113,
					"content": "能撐到現在，已經是一個奇蹟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021114
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021114,
					"content": "#我去確認一下地脈抽取機是否已經關閉，{F#妳}{M#你}們也跟我一起來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021115
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021115,
					"content": "讓他們…再單獨待一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提納里"
				}
			]
		},
		{
			"id": 1300213,
			"completionStepIds": [
				1300213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300213",
							"2"
						],
						"stepId": 1300213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提納里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130021301,
					"content": "地脈抽取機停止運轉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021302
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021302,
					"content": "空氣中還殘存著不少地脈能量，不過洩漏的源頭被堵住，剩下來的這些可以用淨化裝置處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021303
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021303,
					"content": "另外就是那些受到地脈影響的人，必須趁早救治。嗯，就在公告板上寫明進入汙染區的危害，讓病人統一去找柯萊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021304,
						130021305
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021304,
					"content": "卡卡塔…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130021306
					]
				},
				{
					"id": 130021306,
					"content": "按照教令院的規矩，需要把它們都帶回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021307
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021307,
					"content": "關於機械生命的研究資料統一銷毀，卡卡塔則會被拆解封存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021308
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021308,
					"content": "怎麼這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021309,
					"content": "#{F#妳}{M#你}們先回去吧，這裡的事我留下來處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021310
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021310,
					"content": "#地脈洩漏的源頭雖然堵住了，但空氣中的地脈能量還是高於正常值，繼續待下去，{F#妳}{M#你}們的身體撐不住的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021311
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021311,
					"content": "可…可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021312,
					"content": "#妳姑且不論，{NICKNAME}本來就沒有休息好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021313
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021313,
					"content": "#這裡的研究檔數量眾多，打包需要時間。{F#妳}{M#你}們對這些實驗瞭解嗎？留在這裡也幫不上什麼忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021314
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021314,
					"content": "告訴冒險家協會事情已經解決了，然後去好好睡一覺，有什麼事明天再說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021317
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021317,
					"content": "提納里在地圖上標記了他做研究時會去的禪那園。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130021315
					]
				},
				{
					"id": 130021315,
					"content": "…哦對，阿巴圖伊的事就別說了。牽扯到機械生命研究，知道的人越少越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130021316
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130021316,
					"content": "#好吧…那{NICKNAME}，我們先回去找凱瑟琳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130021305,
					"content": "阿巴圖伊的研究…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130021306
					]
				}
			]
		},
