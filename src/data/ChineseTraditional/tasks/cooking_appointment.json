	"talks": [
		{
			"id": 1100102,
			"completionStepIds": [
				1100102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100102",
							"2"
						],
						"stepId": 1100102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杜拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110010201,
					"content": "妳就是香菱，是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010202
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010202,
					"content": "對不起，杜拉夫先生，是我的不對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010203
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010203,
					"content": "妳做的那些事我都聽說了。既然妳人都來了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010204
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010204,
					"content": "好、好可怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010205,
						110010206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110010205,
					"content": "暴、暴力是不對的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				},
				{
					"id": 110010207,
					"content": "——請幫幫我們推廣我們的肉產品吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010208
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010208,
					"content": "…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010209
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010209,
					"content": "#不好意思，唐突了點，我這就跟{F#妳}{M#你}們解釋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010210
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010210,
					"content": "清泉鎮向來以高品質的肉類聞名，但它的名聲不應該只侷限在蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010211
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010211,
					"content": "正好我聽說大廚香菱來了蒙德，我就馬上叫艾倫把妳請過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010212
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010212,
					"content": "大廚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110010213,
					"content": "#{F#妳}{M#你}沒聽過嗎？在璃月港獨樹一幟，主打平民菜品的「萬民堂」，就是香菱掌廚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010214
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010214,
					"content": "她對食材有獨特的理解，做出來的菜深受當地居民喜愛，在遊客中也是好評如潮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010215
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010215,
					"content": "嘿嘿，說得太誇張啦。我只是想做出便宜又好吃的東西而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010216
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010216,
					"content": "像香菱這樣一流的大廚，用一流的肉做出一流的料理，我們清泉鎮的肉就能聲名遠揚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010217
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010217,
					"content": "可是…這個請求我覺得我做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010218
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010218,
					"content": "我只考慮過怎麼做出好吃的菜，沒限制過食材，更沒做過宣傳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010219
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010219,
					"content": "反正肉也是妳想用的食材，我覺得沒什麼區別吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010220
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010220,
					"content": "有區別，有很大的區別！比如我要加史萊姆凝液進去你會同意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010221
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010221,
					"content": "這、這確實有點…不能用稍微正常一點的食材嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010222
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010222,
					"content": "食材是沒有正常不正常的！無論是什麼只要方法得當，都能做出美味佳餚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010223
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010223,
					"content": "我不能讓材料束縛我的靈感，那樣做出來的東西註定是無聊的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010224,
						110010225
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010224,
					"content": "氣場突然變得好強…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010226,
					"content": "唉，既然態度這麼堅決，那就算了吧。但是真的很可惜啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 110010225,
					"content": "這就是大廚的執著嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010226
					]
				},
				{
					"id": 110010206,
					"content": "真要動手的話…衝著我來吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010207
					]
				}
			]
		},
		{
			"id": 1100104,
			"completionStepIds": [
				1100104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1100104",
							"2"
						],
						"stepId": 1100104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"香菱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110010401,
					"content": "妳好，妳做的這個料理我可以嚐嚐看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010402
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010402,
					"content": "不好意思，這幾天的份都預訂滿了，想吃的話要排到七天以後，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010403
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010403,
					"content": "這麼受歡迎啊…那一定很好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110010404,
					"content": "奇怪，明明有這麼受歡迎的廚師…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010405
					]
				},
				{
					"id": 110010405,
					"content": "對哦，為什麼杜拉夫先生還要找香菱啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110010406,
					"content": "唉…可能是他覺得蒙德比起璃月港那種全大陸的商業樞紐，口味不夠大眾吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010407
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010407,
					"content": "但我不服氣！我從來不覺得我做出來的肉會輸給誰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010408
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010408,
					"content": "那就破例給我露一手嘛，或許我還能提一些建議什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010409
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010409,
					"content": "普通人只會說「好吃」之類沒用的話，妳又不是呃…等等…妳就是香菱？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010410
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010410,
					"content": "嗯，對啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010411
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010411,
					"content": "原來就是妳！那妳一定也很會料理肉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010412
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010412,
					"content": "其實我這裡還留了一塊今天最好的肉，如果讓妳來做烤肉，妳會怎麼做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010413
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010413,
					"content": "那要看肉質和脂肪含量了，這塊肉我應該會岩烤，搭配海鹽，絕雲椒椒和清心花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010414
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010414,
					"content": "清心花？！它遇熱油香味會大量釋放，比生冷時濃郁好幾倍，肉的香味都會被蓋掉的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010415
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010415,
					"content": "我知道的哦，但這清心花不是肉排的香料，而是配菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010416
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010416,
					"content": "我嘗試過，只要火候得當，過了油的清心花花瓣的苦味會被去除，變成口感爽脆的點心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010417
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010417,
					"content": "再選取長在高山上的絕雲椒椒。低濕度和大溫差，使得它能夠產生特殊的乾香風味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010418
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010418,
					"content": "海鹽的鹹，絕雲椒椒的辣，肉排油脂的鮮香，匯聚在花瓣上，咬下去還有植物的清香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010419
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010419,
					"content": "花裡胡哨的，這不是喧賓奪主了嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010420
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010420,
					"content": "烤肉就是烤肉，肉香被蓋住了還吃什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010421
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010421,
					"content": "嗚哇，別吵架，不要吵架啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010422,
						110010423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110010422,
					"content": "已經聽不到其他人的聲音了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110010424
					]
				},
				{
					"id": 110010424,
					"content": "哼，既然這樣，烹飪的問題就用烹飪來解決好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010425
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010425,
					"content": "我要和妳切磋廚藝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010426
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010426,
					"content": "完全沒問題，要是連我的料理都比不過，那就證明杜拉夫是看走眼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010427
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010427,
					"content": "好啊，那這樣吧，如果我贏了，我獲勝的料理就用來宣傳清泉鎮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010428
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010428,
					"content": "妳輸了的話，就在「萬民堂」的菜單上加上我的這道菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010429
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010429,
					"content": "上面還要寫上，清泉鎮肉類大師布洛克之作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010430
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 110010430,
					"content": "一言為定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010431
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010431,
					"content": "#我先走一步去找食材了！在璃月等{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110010432
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110010432,
					"content": "喂，等等啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
