		}
	],
	"talks": [
		{
			"id": 7352901,
			"completionStepIds": [
				7352901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7352901",
							"2"
						],
						"stepId": 7352901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"勒非尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735290101,
					"content": "我感受到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290102
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290102,
					"content": "#{F#妳}{M#你}們舉手投足間滿溢而出的，「戰鬥舞步」的氣息，繽紛璨綺，令人迷醉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290103
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290103,
					"content": "#燃燒的劍鋒劃過側臉時，{F#妳}{M#你}們瞳中的倒影連成了一線熾烈的金紅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290104
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290104,
					"content": "#環繞嚴冰壁壘的軸線優雅旋轉時，{F#妳}{M#你}們的足尖踏出了錯落有致的節奏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290105
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290105,
					"content": "#面對轟然傾軋而來的古木城牆，抑或是鋼鐵巨人的軍陣時，{F#妳}{M#你}們捕捉每個瞬息的敏捷身影，甚至無法被畫筆和鏡頭捕捉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290106,
						735290107
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290106,
					"content": "聽不太懂！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290108
					]
				},
				{
					"id": 735290108,
					"content": "#這股豪氣也是我所敬畏之物，不會錯，{F#妳}{M#你}們一定能成為我的知音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290109
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290109,
					"content": "本人「輕劍舞者」勒非尼，且問兩位尊姓大名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290110
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290110,
					"content": "嗚啊，好誇張的說話風格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290111,
					"content": "#我是派蒙，這位是{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290112,
					"content": "雖然我們的確很厲害，但勒非尼先生，你說的話好複雜，完全不懂是什麼意思啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290113,
					"content": "而且你既沒有帶著劍，看穿著打扮也不像是舞者，為什麼自稱「輕劍舞者」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290114,
					"content": "犀利的提問，派蒙閣下想必在考驗我的心性！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290115
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290115,
					"content": "不以有限的武器為兵刃，而是藏劍於心，在必要之時，將銳意融入一切可用之物，讓具體的戰法擺脫桎梏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290116
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290116,
					"content": "絕不強調衣著，而是從踏上戰場舞臺的一刻起，釋放華美的身姿，以至為優雅的技法主宰一切…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290117,
						735290118,
						735290119
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290117,
					"content": "大概是說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290120
					]
				},
				{
					"id": 735290120,
					"content": "精準的概括！但請別疏忽「銳意」和「優雅」兩個定調的關鍵字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290121
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290121,
					"content": "#等等…我明白了！{F#妳}{M#你}們的境界早已遠遠超過了我，能在無意無心之中貫徹這兩個詞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290122
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290122,
					"content": "那事不宜遲，請踏入這扇門，踏上「幽思閃念旋步舞」的高臺，向我展示至高的舞姿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290123
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290123,
					"content": "#託伊迪婭小姐的福，「幽思閃念旋步舞」之中，各式勁敵都將以幻影的姿態重現，試圖將{F#妳}{M#你}徹底擊垮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290124
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290124,
					"content": "#當{F#妳}{M#你}完全釋放心中「銳意」的那一刻，{F#妳}{M#你}就能徹底拔出心底至強的那柄劍，銳不可當地擊敗強敵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290125,
						735290126
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290125,
					"content": "我好像也懂了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290127
					]
				},
				{
					"id": 735290127,
					"content": "沒錯，的確是無比合拍的交涉，痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290128
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290128,
					"content": "#那我就在此冥想，靜候佳音了！願{F#妳}{M#你}能享受這獨一無二的劍鬥之舞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290129
					],
					"speakerTitle": "勒非尼"
				},
				{
					"id": 735290129,
					"content": "#呃啊，怎麼感覺{F#妳}{M#你}好像和他慢慢達成了一種…共識！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290130,
					"content": "我剛剛才反應過來，勒非尼先生是在誇獎我們打架的本領高強嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290131,
					"content": "他管理著一個戰鬥試煉的秘境，想要再見識一下我們的打法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290132,
					"content": "不過，好像也不是壞事…勒非尼先生的思維有點奇特，會把戰鬥比作跳舞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290133,
					"content": "把很簡單的事說得特別高深，也是一種本領吧。學會了這種說話方式…不管碰見什麼人，都能第一時間唬住對方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290134,
						735290135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290134,
					"content": "其實我很會唬人啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290136
					]
				},
				{
					"id": 735290136,
					"content": "唉！誇獎是順帶的說話技巧啦，和他多聊聊，肯定都能搞懂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290137,
					"content": "那我們就在這個什麼「幽思閃念旋步舞」裡，再漂漂亮亮、痛痛快快地打一場吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735290138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290138,
					"content": "#不知道勒非尼先生又會給我們什麼樣的誇張評價…{NICKNAME}，到時候{F#妳}{M#你}要記住哦，以後也能派上用場！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735290135,
					"content": "反正他很會誇我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290136
					]
				},
				{
					"id": 735290126,
					"content": "是酣暢的戰鬥試煉吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290127
					]
				},
				{
					"id": 735290118,
					"content": "別管衣服？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290120
					]
				},
				{
					"id": 735290119,
					"content": "什麼都用？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290120
					]
				},
				{
					"id": 735290107,
					"content": "但多誇一點！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735290108
					]
				}
			]
		}
	]
}