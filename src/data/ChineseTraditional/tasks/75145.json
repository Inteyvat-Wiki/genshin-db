			"dialogs": [
				{
					"id": 751450101,
					"content": "受龍所選者…啊，受龍所選者啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450102,
					"content": "聖山就在汝之身前…如若…就須清除…陰影之敵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450103,
					"content": "啊，受龍所選者…進入…進入聖山吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450104,
					"content": "嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450105,
					"content": "剛才…火山噴發了…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450106
					]
				},
				{
					"id": 751450106,
					"content": "沒有哦，剛才火山非常安靜…你們看到火山噴發了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450107,
					"content": "#怎麼了，{NICKNAME}，還有{REALNAME[ID(2)|SHOWHOST(true)]}，怎麼一副沉思的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450108,
					"content": "簡直就像是偵探小說裡突然想到了事件真相的偵探一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450109,
						751450112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450109,
					"content": "看到的是別的「真相」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450110
					]
				},
				{
					"id": 751450110,
					"content": "（向派蒙說明了所看到的…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450111
					]
				},
				{
					"id": 751450111,
					"content": "#啊，{F#妳}{M#你}是說，看到了和剛進入納塔遇到{REALNAME[ID(2)|SHOWHOST(true)]}時看到的相同的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450118,
					"content": "還有一些奇怪的影像嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450119,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450120
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450120,
					"content": "#在那個時候{NICKNAME}就說看到了奇怪的話…唔，我沒看到所以不知道啦，感覺上，像是一個人說的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450121,
					"content": "應該是同一個人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450122
					]
				},
				{
					"id": 751450122,
					"content": "不過，這次你們還看到…巨大的遺蹟，以及深淵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450123,
					"content": "還有「聖山」…唔，納塔人好像也稱那座火山為「聖山」，難道說，你們看到的東西和那座火山有關？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450124,
					"content": "#總覺得那個把{REALNAME[ID(2)|SHOWHOST(true)]}交到我們手上的人好像很想讓我們「進入聖山」的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450125,
					"content": "#難道在那裡就可以解開{REALNAME[ID(2)|SHOWHOST(true)]}的身世之謎…說不定還能見到牠的家人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450126,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450127
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450127,
					"content": "總之…我們就留意一下火山相關的情報吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450128,
					"content": "對了，納塔六個部族中的「沃陸之邦」好像就在火山的一側，說不定可以在那裡打探消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450112,
					"content": "蛋糕殺人的凶手…就是派蒙妳！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450113
					]
				},
				{
					"id": 751450113,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751450114,
					"content": "可惡，怎麼會，明明我偷吃小蛋糕小姐的時候沒有被任何人看到…才怪啦，我偷吃的是火焰燉肉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450115,
					"content": "#所以{F#妳}{M#你}…不對，你們剛才看到了什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751450116,
					"content": "（向派蒙說明了所看到的…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751450117
					]
				},
				{
					"id": 751450117,
					"content": "又看到了奇怪的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751450118
					],
					"speakerTitle": "派蒙"
				}
			]
