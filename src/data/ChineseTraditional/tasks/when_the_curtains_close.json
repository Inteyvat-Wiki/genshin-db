			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡維"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-409.637,
							280.711,
							2742.165
						],
						"pointId": 330201500
