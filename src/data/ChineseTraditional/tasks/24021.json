					}
				]
			},
			"dialogs": [
				{
					"id": 240210101,
					"content": "痛…這個箱子怎麼這麼重…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210102
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210102,
					"content": "妳沒事吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210103
					]
				},
				{
					"id": 240210103,
					"content": "榮譽高級研究員，又見到您了。真不好意思…我…我的腰好像受傷了，好痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210104
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210104,
					"content": "我之前準備去把一個箱子搬過來，整理一下裝在裡面的資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210105
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210105,
					"content": "我…我沒想到那個箱子會那麼重，搬起來的時候一個沒站穩，所有的力量都在腰上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210106
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210106,
					"content": "我現在…覺得腰都快要斷了，哎喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210107,
						240210108
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210107,
					"content": "要我背妳去看醫生嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				},
				{
					"id": 240210109,
					"content": "不、不用…我之前也有傷到腰過，只要休息一下就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210110
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210110,
					"content": "到底是裝了多少東西，會這麼重啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240210111,
					"content": "應該是…很多很多卷宗吧？之前院內曾經推廣過「留痕式辦公」一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210112
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210112,
					"content": "簡單來說，就是院內所有的研究事務都必須留下紙本的辦理證明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210113
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210113,
					"content": "在推廣了這個辦公方式之後，整個科學院的紙張消耗直接增長了五倍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210114
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210114,
					"content": "因為卷宗太多，每一個辦公室甚至被迫設立了一個「資產整理」的職位，專門來將資料分門別類…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210115
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210115,
					"content": "也就說，所有事情都要記在紙上？聽起來就好麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240210116,
					"content": "對啊，後來這個辦公方式也只剩少部分人在用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210117
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210117,
					"content": "先不說這些…榮譽高級研究員，能請您幫我拿一下卷宗箱嗎？雖然腰很痛，但我還是必須快點整理好裡面的卷宗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240210118,
						240210119
					],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210118,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 240210119,
					"content": "妳就好好休息吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210120
					]
				},
				{
					"id": 240210120,
					"content": "不用擔心，我整理卷宗只會用到手，不會用到腰。您就放心吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沙爾梅"
				},
				{
					"id": 240210108,
					"content": "我可以叫人過來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240210109
					]
				}
			]
		},
