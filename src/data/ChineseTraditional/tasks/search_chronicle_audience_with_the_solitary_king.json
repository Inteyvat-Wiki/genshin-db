			"trigger": {
				"objectNames": [
					"蘭吉特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746820101,
					"content": "終於還是走到了今天這一步啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820102
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820102,
					"content": "兒時的夢想呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820103
					]
				},
				{
					"id": 746820103,
					"content": "長大成人之後，終於理解了當年巡林官面露難色的原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820104
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820104,
					"content": "咳…不管怎麼說，至少嘗試過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820105
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820105,
					"content": "而且也知道不該帶著未經處理的爆炎樹果實接近翠翎恐蕈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820106
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820106,
					"content": "聞到枯焦味道的時候已經晚了，差點被它散播的孢子淹沒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820107
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820107,
					"content": "常常會忘記蕈獸畢竟不是蕈豬，是完全不同的物種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820108
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820108,
					"content": "對哦，說起來，蕈獸應該算是菌類吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746820109,
					"content": "對啊，燉湯的話非常鮮美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820110
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820110,
					"content": "呃…我們還是繼續講今天的挑戰對象吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746820111,
					"content": "我還沒想好怎麼料理…哦！妳是在說「交涉」，抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820112
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820112,
					"content": "#不知道{F#妳}{M#你}們有沒有聽說過兩位原海異種霸主的故事？故事裡都是用孤傲、高潔這樣的詞形容千年珍珠駿麟的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820113
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820113,
					"content": "相比之下，鐵甲熔火帝皇聽起來就像是什麼不好惹的狠角色，強大但是暴戾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820114
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820114,
					"content": "我還以為你會選聽起來更強的那個挑戰呢。畢竟之前也說過既然要講故事，對手當然是越強越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746820115,
					"content": "鐵甲熔火帝皇的確很強，但那畢竟是重甲蟹…相比之下，千年珍珠駿麟可是會飛的海馬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820116,
						746820118
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820116,
					"content": "會飛的海馬是不是應該叫天馬？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820117
					]
				},
				{
					"id": 746820117,
					"content": "#{F#妳}{M#你}在意的居然是這個問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746820119,
					"content": "不管怎麼說，哪怕只讓我騎乘一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820120
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820120,
					"content": "好吧，看來你是要堅持到底了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746820121,
					"content": "來都來了，總不能無功而返！準備好了的話，我們這就出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746820122,
						746820123
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820122,
					"content": "準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 746820123,
					"content": "還有別的事，稍候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820124
					]
				},
				{
					"id": 746820124,
					"content": "#沒問題，我就在這裡等{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 746820118,
					"content": "對我來說都沒差…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746820119
					]
				}
			]
		}
	]
}