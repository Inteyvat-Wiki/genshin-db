			"dialogs": [
				{
					"id": 200210101,
					"content": "為什麼使用風之翼還要考飛行執照這種東西啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210102
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210102,
					"content": "哥，你考過飛行執照嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210103
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210103,
					"content": "我不用風之翼，從來沒考過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210104
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200210104,
					"content": "妳要考飛行執照？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210105
					]
				},
				{
					"id": 200210105,
					"content": "因為風之翼是冒險的必備道具嘛，所以我就想練習一下風之翼的使用方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210106
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210106,
					"content": "但我沒想到…居然還有飛行執照這種東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210107
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210107,
					"content": "雖然我已經報名考試了…但一些知識點我還是沒完全背熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210108
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210108,
					"content": "#旅行者，我聽安柏小姐說，{F#妳}{M#你}已經有飛行執照了，能請{F#妳}{M#你}輔導我一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210109,
						200210113
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210109,
					"content": "是安柏為妳監考嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210110
					]
				},
				{
					"id": 200210110,
					"content": "那倒不是，我只是在報名的時候遇見了安柏小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210111
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210111,
					"content": "#她為我介紹飛行執照考試情況的時候提到了{F#妳}{M#你}，她說{F#妳}{M#你}考得可好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210112
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210112,
					"content": "#所以，我就想來請教一下{F#妳}{M#你}有關飛行執照考試的問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210115,
					"content": "#那…我有三個問題想要問{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210116
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210116,
					"content": "唔…第一個問題是，在飛行時，最多可以同時幾人共用一架風之翼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200210113,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200210114
					]
				},
				{
					"id": 200210114,
					"content": "#太好了！那就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200210115
					],
					"speakerTitle": "安娜"
				}
			]
		},
