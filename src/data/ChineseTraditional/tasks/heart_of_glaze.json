			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10230201,
					"content": "#作為「引路人」，{F#妳}{M#你}們的使命明明已經完成，為什麼還要來自找麻煩呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230202
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230202,
					"content": "嗯？是誰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230203,
					"content": "#如果{F#妳}{M#你}們是「愚人眾」，或許能夠拿到一筆來自女皇的豐厚獎賞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230204
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230204,
					"content": "但可惜現在，就只是毫無價值的礙事者而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230205,
						10230208
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230205,
					"content": "你是怎麼知道這裡的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230206
					]
				},
				{
					"id": 10230206,
					"content": "該從何說起呢？本來繞遠路也不是我的風格，但誰知道一到璃月，岩之神就離奇死亡，「仙祖法蛻」還被藏了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230207
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230207,
					"content": "#要不是借{F#妳}{M#你}們籌辦「送仙典儀」的機會，得到了一些消息，只怕會更加麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230211
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230211,
					"content": "嘿…不惜停止摩拉的鑄造，也要隱藏「仙祖法蛻」…七星還真是下了血本呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230212
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230212,
					"content": "原、原來你真的是想要在「仙祖法蛻」裡找出「神之心」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230213,
					"content": "作為愚人眾的十一執行官，必須貫徹冰之女皇的意旨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230214
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230214,
					"content": "女皇想要，我們就來取。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230215,
						10230216
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230215,
					"content": "我不允許。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230217
					]
				},
				{
					"id": 10230217,
					"content": "問題不在於誰會允許我，而是誰能阻止我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230218
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230218,
					"content": "交易和算計的時間，終於全都過去了…其實我也很討厭那些小手段，不過為了女皇，我可以忍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230219
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230219,
					"content": "接下來，我們可以享受一些單純的、快樂的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230220
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230220,
					"content": "那就是「爭鬥」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230221
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230221,
					"content": "爭鬥？你是那種喜歡找人打架的類型？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230222,
					"content": "哈哈哈，可以這麼說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230223
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230223,
					"content": "在蒙德，「女士」在教堂外冒犯神靈，得手以後就急匆匆地離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230224
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230224,
					"content": "#她寧願靠冰雪暫時封住所有人的行動，也不想當場與{F#妳}{M#你}一戰，這是為了避免戰鬥時的動靜引來騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230225
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230225,
					"content": "面對強者，她只會優先盤算利益、考慮勝負、考慮出手以後的影響…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230226
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230226,
					"content": "但我成為「執行官」以後最大的快樂，就是可以向更多強者揮拳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230227
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230227,
					"content": "蒙德發生過的事，不會再發生一次了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230228,
					"content": "#好，那就來試試吧？我不會殺死{F#妳}{M#你}，旅行者。我只是想享受戰鬥的樂趣，所以請{F#妳}{M#你}陪我玩而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230229
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230229,
					"content": "#{F#妳}{M#你}打不贏我，所以不用贏，只要和我一樣，也享受戰鬥的樂趣就好。我這麼說，{F#妳}{M#你}應該能明白吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230230
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230230,
					"content": "我打不贏你？聽不懂你在說什麼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230231
					]
				},
				{
					"id": 10230231,
					"content": "哈哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230232
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230232,
					"content": "#好吧！既然{F#妳}{M#你}也很想玩，那可別讓我掃興啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230216,
					"content": "不會讓你靠近「仙祖法蛻」的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230217
					]
				},
				{
					"id": 10230208,
					"content": "我現在追來也不算晚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230209
					]
				},
				{
					"id": 10230209,
					"content": "#雖然感謝{F#妳}{M#你}們讓我沒怎麼費工夫，就找到了這藏匿之所…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230210
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230210,
					"content": "但現在想要阻止我？還是別白費力氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230211
					],
					"speakerTitle": "「公子」"
				}
			]
		},
		{
			"id": 102303,
			"completionStepIds": [
				102303
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
