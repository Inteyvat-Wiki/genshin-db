			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10230301,
					"content": "哇啊——這裡就是<color=#00E1FFFF>「黃金屋」</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230302,
					"content": "外面看起來就已經很氣派了，沒想到裡面更加豪華！而且…而且滿地都是摩拉！！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230303,
					"content": "既然整個提瓦特的摩拉，都是在這裡造出來的，那…是不是多一點少一點，都很不容易被發現？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230304,
						10230305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230304,
					"content": "莫伸手，伸手必被抓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				},
				{
					"id": 10230306,
					"content": "#原來是誘餌式陷阱，好險好險！幸虧有{F#妳}{M#你}提醒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230307,
					"content": "但就算不能拿，近距離看看應該沒問題吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230308,
					"content": "可以的話，我還想躺在裡面睡一覺！用摩拉當被子，做夢也會更香，嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230309,
						10230310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230309,
					"content": "還是先去確認「仙祖法蛻」的情況吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230311,
					"content": "哦，對了對了，正事要緊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230312,
					"content": "這裡…是不是太安靜了？「仙祖法蛻」這麼重要的東西，肯定不會沒人看管吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230313,
					"content": "#——欸？！{NICKNAME}，{F#妳}{M#你}看，那是什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230314,
						10230315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230314,
					"content": "是千岩軍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230315
					]
				},
				{
					"id": 10230315,
					"content": "好像都暈倒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230316
					]
				},
				{
					"id": 10230316,
					"content": "…唔，感覺情況很不妙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230317,
					"content": "我們趕緊去確認一下「仙祖法蛻」有沒有異常吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230310,
					"content": "這裡的氣氛好像…有點奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230311
					]
				},
				{
					"id": 10230305,
					"content": "如果真這麼簡單，還輪得到妳嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230306
					]
				}
			]
		},
		{
			"id": 102305,
			"completionStepIds": [
				102305
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102305",
							"2"
						],
						"stepId": 102305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10230501,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230502
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230502,
					"content": "啊，他變回了原來的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230546
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230546,
					"content": "也該…冷靜下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230503
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230503,
					"content": "剛才那身「魔王武裝」，對身體的負擔果然很大，讓我沒機會停下來思考…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230504
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230504,
					"content": "#但仔細一想，{F#妳}{M#你}們確實沒有比我搶先一步得到「神之心」的可能性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230505
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230505,
					"content": "#無論「神之心」去了哪裡…都應該與{F#妳}{M#你}們無關吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230506
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230506,
					"content": "是啊，都說了不是我們拿的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230507,
					"content": "#旅者，{F#妳}{M#你}今天展現出的實力，比「女士」在蒙德對{F#妳}{M#你}的評價更強，這是為什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230508,
						10230509
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230508,
					"content": "（是因為正在收集七種元素…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				},
				{
					"id": 10230510,
					"content": "#看{F#妳}{M#你}的樣子，心裡好像是有答案的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230511
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230511,
					"content": "唉，但如果是不能對我說的秘密，那我也只能勉強壓抑一下自己的好奇心啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230512
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230512,
					"content": "有這場戰鬥，我已經很滿足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230513
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230513,
					"content": "同樣追求變強的人，都是朋友，儘管這種友誼的形式，只能是互相爭鬥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230514
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230514,
					"content": "真是奇怪的朋友觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230515,
					"content": "但現在，也不得不暫時擱置知己間的交流，回到我的任務中去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230516
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230516,
					"content": "——既然「神之心」不是被人拿走，那會不會是…從一開始，就不在「仙祖法蛻」裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230517
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230517,
					"content": "更進一步地想，「仙祖法蛻」本身，會不會也只是一種障眼法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230518
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230518,
					"content": "啊，你是想說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230519,
						10230520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230519,
					"content": "岩王帝君沒死？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230521,
					"content": "恐怕正是如此。那可…真有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230522
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230522,
					"content": "不愧是商業之都的守護神，對「契約之外的小手段」也非常精通呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230523
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230523,
					"content": "這樣一來，就只能發動「備用方案」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230524
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230524,
					"content": "備用方案？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230525,
					"content": "本來不想用這個方案的，因為會波及弱者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230526
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230526,
					"content": "說到底，世界屬於我們這些追求變強的人。對於無聊無趣的弱者，我平常都不怎麼願意去理會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230527
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230527,
					"content": "可惜身為愚人眾執行官，是不能對「手段」挑三揀四的。這就像小孩子有時也得學著去吃自己不喜歡的胡蘿蔔一樣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230528
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230528,
					"content": "所以…你究竟想做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230529,
					"content": "我要喚醒「孤雲閣」下沉睡的魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230530
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230530,
					"content": "魔神？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230531
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230531,
					"content": "<color=#00E1FFFF>「漩渦之魔神」，奧賽爾</color>。在魔神戰爭時敗於「岩之魔神」摩拉克斯，被岩槍鎮壓在海中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230532
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230532,
					"content": "如果讓一位昔日的魔神，去進攻失去了神靈鎮守的璃月港…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230533
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230533,
					"content": "#{F#妳}{M#你}們覺得，那位把我們都耍了一通的岩王帝君大人，還能安穩地躲在一邊看戲嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230534
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230534,
					"content": "可…可是，魔神戰爭都結束了兩千年！在世上只有七神的今天，你要怎麼把遠古的魔神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230535,
					"content": "當然是，已經準備好了「喚醒」的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230536
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230536,
					"content": "啊！那是「百無禁忌籙」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230537,
					"content": "我…我想起來了！我們確實有發現「愚人眾」在研究它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230538,
						10230539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10230538,
					"content": "我親眼見過研究的現場。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230540,
					"content": "#沒錯，給{F#妳}{M#你}們的那張，只是這場研究的副產物而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230541
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230541,
					"content": "這麼多「百無禁忌籙」的力量聚集在一起，再加上女皇賜予「執行官」的力量…暫時解封岩槍鎮壓之力，也不是什麼辦不到的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230544
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230544,
					"content": "原本對我來說，走到這一步，動用遠古魔神的力量，已經很無趣了，也不符合我的信條。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10230545
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230545,
					"content": "#不過，一想到不僅是那位岩神，連{F#妳}{M#你}們也必須為此作出應對…倒也還挺有意思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10230539,
					"content": "而且你們還在嘗試「複製」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230540
					]
				},
				{
					"id": 10230520,
					"content": "死去的仙體是假的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230521
					]
				},
				{
					"id": 10230509,
					"content": "（是因為正在逐漸恢復曾經的力量…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10230510
					]
				}
			]
		}
	]
}