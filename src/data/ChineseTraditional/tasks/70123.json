		},
		{
			"id": 7012306,
			"completionStepIds": [
				7012301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7012301",
							"2"
						],
						"stepId": 7012301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"喬爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701230101,
					"content": "爸爸到底去哪了……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230102
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230103
					]
				},
				{
					"id": 701230103,
					"content": "#啊…{F#妳}{M#你}好，我…我找不到我爸爸了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230104
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230104,
					"content": "他說好了要接我來雪山看雪的，不過約定的日子到了，他卻一直沒有來接我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230105
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230105,
					"content": "我猜，他一定是發現了什麼珍貴秘寶的藏寶圖之類的，所以才沒來找我的，一定是這樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230106
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230106,
					"content": "我就一個人來雪山了。既然他沒法來找我，我就來找他好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230107
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230107,
					"content": "但是到了這裡，我也沒找到他。那位西風騎士叔叔說，他往山頂上走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230108
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230108,
					"content": "我想自己去找爸爸，但西風騎士叔叔又不讓我去，我就只能留在這裡等爸爸回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230109
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230109,
					"content": "但是…但是他一直沒回來，我還是很擔心他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230110
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230110,
					"content": "#如果{F#妳}{M#你}要進雪山的話，能幫我去找找他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230111,
						701230112
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230111,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				},
				{
					"id": 701230113,
					"content": "#{F#妳}{M#你}是答應我了吧，太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230114
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230114,
					"content": "我想想…那位西風騎士叔叔說，爸爸曾經提到過，他要先沿著<color=#00E1FFFF>「覆雪之路」一直往上走</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230115
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230115,
					"content": "然後，再去<color=#00E1FFFF>雪山西面的山坡</color>附近看看，最後爸爸說他還想試試<color=#00E1FFFF>登上山頂</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230116
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230116,
					"content": "#請{F#妳}{M#你}先去這些地方找找看吧，爸爸說不定會在附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701230117
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230117,
					"content": "他和我約好了一起看雪的，他一定會遵守約定的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "喬爾"
				},
				{
					"id": 701230112,
					"content": "去哪找呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701230113
					]
				}
			]
		}
	]
