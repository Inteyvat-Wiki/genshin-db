			"dialogs": [
				{
					"id": 721170101,
					"content": "旅行者，您來得正好。數據應該搜集得差不多了，是去回收那些信標的時候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170102,
						721170104
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721170102,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170103
					]
				},
				{
					"id": 721170103,
					"content": "那就交給您了，快去快回吧，別讓那些愚人眾發現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721170104,
					"content": "你怎麼知道的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721170105
					]
				},
				{
					"id": 721170105,
					"content": "這種信標在製作的時候，一般會附帶詳細的使用說明手冊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170106
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721170106,
					"content": "針對不同的情況，說明書上也標明了不同的推薦搜集數據時長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721170107
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721170107,
					"content": "「祟神」這種屬「未知能量」的東西，我就直接按照最長的時間來算了…總之，回收信標的事就拜託您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				}
			]
		},
