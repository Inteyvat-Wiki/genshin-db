			"dialogs": [
				{
					"id": 718050701,
					"content": "關於那兩本書…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050702
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718050702,
					"content": "這兩位是老客人了，他們訂的書我一般都會早點準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050703
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718050703,
					"content": "但突然來了那麼多客人，我一下子應付不過來，把這兩本書拖了這麼久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050704
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718050704,
					"content": "他們一定都等得不耐煩了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紀芳"
				}
