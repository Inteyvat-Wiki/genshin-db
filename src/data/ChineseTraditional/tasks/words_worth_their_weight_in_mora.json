			"trigger": {
				"objectNames": [
					"天叔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718050501,
					"content": "#年輕人，{F#妳}{M#你}有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050502
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 718050502,
					"content": "這是紀芳給你的書。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050503
					]
				},
				{
					"id": 718050503,
					"content": "我想起來了，之前我跟「萬文集舍」訂了一本《璣衡經》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050504
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 718050504,
					"content": "沒錯沒錯，這就是我要的書，總算送來了。呵呵，我還以為客人太多，紀芳把這本書的事給忘了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050505
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 718050505,
					"content": "送來就好，送來就好…哦唷，這裝幀還不錯，紀芳有心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050506
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 718050506,
					"content": "#謝謝{F#妳}{M#你}年輕人，這本書我就收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "天叔"
				}
			]
		},
