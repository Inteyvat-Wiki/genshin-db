					"德安公"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718050401,
					"content": "#年輕人，{F#妳}{M#你}有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050402
					],
					"speakerTitle": "德安公"
				},
				{
					"id": 718050402,
					"content": "這是紀芳給你的書。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050403
					]
				},
				{
					"id": 718050403,
					"content": "這是《帝君塵遊記·四》？我記得我早就訂了這本書，怎麼拖了這麼久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050404
					],
					"speakerTitle": "德安公"
				},
				{
					"id": 718050404,
					"content": "讓我看看…咦？居然是初版，難怪現在才送來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050405
					],
					"speakerTitle": "德安公"
				},
				{
					"id": 718050405,
					"content": "我還以為是因為客人太多，紀芳把這本書的事給忘了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050406
					],
					"speakerTitle": "德安公"
				},
				{
					"id": 718050406,
					"content": "#這本書我就收下了，謝謝{F#妳}{M#你}，年輕人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德安公"
				}
			]
		},
		{
			"id": 7180505,
			"completionStepIds": [
				7180503
			],
