			},
			"dialogs": [
				{
					"id": 718050601,
					"content": "關於那兩本書…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050602
					]
				},
				{
					"id": 718050602,
					"content": "書都送到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050603
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718050603,
					"content": "都送到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718050604
					]
				},
				{
					"id": 718050604,
					"content": "#謝謝{F#妳}{M#你}。「萬文集舍」能開到現在，都是多虧了這些老客人的支持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050605
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718050605,
					"content": "而且，這些老客人也都是真正愛書的人。能拿到好書，他們應該也會很開心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050606
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718050606,
					"content": "#旅行者，謝謝{F#妳}{M#你}幫我這個忙，這些報酬請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718050607
					],
					"speakerTitle": "紀芳"
				},
				{
					"id": 718050607,
					"content": "#如果{F#妳}{M#你}以後想買書的話，儘管來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "紀芳"
				}
			]
		},
