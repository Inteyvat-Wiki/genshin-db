				"objectNames": [
					"扎卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752640401,
					"content": "你們抓錯人了…你們看，我師傅叫卡內，我叫扎卡…你們應該去抓他才對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640402
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640402,
					"content": "我根本做不出我師傅那種等級的玩偶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640403
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640403,
					"content": "你是被人抓來的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752640404
					]
				},
				{
					"id": 752640404,
					"content": "#欸？{F#妳}{M#你}們和他們不是一夥的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640405
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640405,
					"content": "當然不是，你沒看見嗎？我們把他們都打跑啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752640406,
					"content": "原來是這樣？太好了！我終於自由了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640407
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640407,
					"content": "當然，你可以回家囉。不過…這裡到底是怎麼回事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752640408,
					"content": "這幫傢伙不知道是哪裡的，跑來偽造度假村的玩偶。但是他們的能力很差，所以密謀把我的師傅卡內抓來當顧問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640409
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640409,
					"content": "但是不知道哪裡出了問題，居然把我抓了過來…老天，我才跟師傅學了三天顏料的手藝…根本達不到要求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640410
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640410,
					"content": "#不管怎麼說，太感謝{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640411
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640411,
					"content": "阿扎卡，我們回家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752640412
					],
					"speakerTitle": "扎卡"
				},
				{
					"id": 752640412,
					"content": "~~~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎卡"
				}
			]
		}
	]
