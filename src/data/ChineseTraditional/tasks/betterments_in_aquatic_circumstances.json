					}
				]
			},
			"dialogs": [
				{
					"id": 747160101,
					"content": "太好了…這下，最主要的水下廢棄物基本被打撈完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160102
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160102,
					"content": "#讓{F#妳}{M#你}們受累了，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160103
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160103,
					"content": "沒有啦沒有啦，比起受累這種說法，我更願意說這次是收穫滿滿哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160104,
						747160105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160104,
					"content": "既幫助了修復水下環境。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				},
				{
					"id": 747160106,
					"content": "#謝謝{F#妳}{M#你}們…託{F#妳}{M#你}們的福，我才度過了一段愉快而又充實的時光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160107
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160107,
					"content": "不用客氣，這是大家的共同努力！而且，我覺得菲米尼也很有進步呢，水下和水上的時候都可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160108,
					"content": "別害羞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160109
					]
				},
				{
					"id": 747160109,
					"content": "好…好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160110
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160111
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160111,
					"content": "抱歉，除了感謝的話，我還是不知道這種時候應該說些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160112
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160112,
					"content": "可能…我還需要再多練習一段時間？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160113
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160113,
					"content": "慢慢來，不著急。即使是練習，也按照自己的節奏一點一點努力就行啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160114,
						747160115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160114,
					"content": "以後有機會，還可以這樣合作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160116,
					"content": "嗯，一定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160117
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160117,
					"content": "…我本來以為，在任務完成之後，我會需要回水下獨處一段時間的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160118
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160118,
					"content": "#但很神奇，和{F#妳}{M#你}們聊過天…就連天空也變得非常寧靜。我想把此刻的這種心情…告訴{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160119
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160119,
					"content": "那…我今天先回去和林尼他們會合了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160120
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160120,
					"content": "#餘下的水底勘測資訊，就交給{F#妳}{M#你}們了。祝願{F#妳}{M#你}們能夠找到滿意的收穫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160121
					],
					"speakerTitle": "菲米尼"
				},
				{
					"id": 747160121,
					"content": "喲，我在樓上就聽見你們慶祝的聲音了。看來是有好事發生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160122
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160122,
					"content": "嗯！我們把影響魚兒們生活的廢棄品基本打撈完了，還找到了鋼琴剩下的零件！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160123,
					"content": "真的嗎？我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160124
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160124,
					"content": "還真的是…有了這些，我就能修好這架鋼琴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160125
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160125,
					"content": "雖說不是復原得和當初一模一樣，但也能再次讓它流出好聽的音樂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160126
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160126,
					"content": "妳聽起來很開心嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160127,
					"content": "#有…有嗎？不管了，我現在就去修復它，花不了多少時間。{F#妳}{M#你}們幫我裝點一下這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160128
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160128,
					"content": "只有好看的舞臺，才配得上你的樂聲。哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160129
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160129,
					"content": "她果然很高興啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160130,
					"content": "哇！好漂亮的鋼琴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160131,
						747160132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160131,
					"content": "好典雅！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160133,
					"content": "哼哼，那當然——也不看看是誰修的。我還為它重新加固了一下機械聯動裝置、翻新了一下外裝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160134
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160134,
					"content": "#{F#妳}{M#你}們幹得也不賴嘛，這舞臺也配得上它了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160135
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160135,
					"content": "哎呀呀，小事小事。快別說那麼多了，妳現在不彈一首嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160136,
					"content": "…欸？現在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160137
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160137,
					"content": "不然呢？妳修好它不就是為了彈的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747160138,
					"content": "今天…就算了吧！以後有機會再彈也不遲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160139,
						747160140
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160139,
					"content": "忘譜了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160141,
					"content": "嘖…囉嗦…！我只是想先安靜地和它待一待，懷念一下過去的時光而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747160142
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160142,
					"content": "別以為隨便挑釁我兩句我就會答應，哼，回去練練再來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747160140,
					"content": "害羞了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160141
					]
				},
				{
					"id": 747160132,
					"content": "好華麗！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160133
					]
				},
				{
					"id": 747160115,
					"content": "下次有事情，還可以來找我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160116
					]
				},
				{
					"id": 747160105,
					"content": "又找到了許多漂亮寶藏。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747160106
					]
				}
			]
		}
	]
}