					"nextDialogs": [
						750640614
					],
					"speakerTitle": "馬尼菲科"
				},
				{
					"id": 750640614,
					"content": "說不定下一次，我還會麻煩你們幫忙哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750640615
					],
					"speakerTitle": "馬尼菲科"
				},
				{
