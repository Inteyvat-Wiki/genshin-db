				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"巴哈多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736930101,
					"content": "為什麼把這種事交給我，就不能拜託個經驗豐富點的學長學姐嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930102
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930102,
					"content": "咦？難道這裡也在舉辦活動？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930103
					]
				},
				{
					"id": 736930103,
					"content": "欸？！旅行者，呃…是的是的，這裡正在…那個…舉辦一個活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930104
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930104,
					"content": "哎喲，也不能說是活動，算是一個…等待探索的秘境吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930105
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930105,
					"content": "這秘境和學院遊樂會無關嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930106
					]
				},
				{
					"id": 736930106,
					"content": "唉，別提了，就是因為教令院搞的這個學院遊樂會，我才會負責這種事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930107
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930107,
					"content": "我忘了自我介紹。我是悉般多摩學院的巴哈多，我們學院就是研究煉金術啦，元素啦之類的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930108
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930108,
					"content": "總之，我就被指派了這個任務，但我想來想去，我們悉般多摩學院能舉辦個什麼小遊戲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930109
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930109,
					"content": "我總不能放個煉金台去搞煉金術大科普吧？那也太無聊了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930110
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930110,
					"content": "也不能做什麼…元素反應展示，要是出了什麼岔子，把場地給炸翻了怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930111
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930111,
					"content": "到最後，我只能去找冒險家協會幫忙，在他們的幫助下找到了這麼一處秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930112
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930112,
					"content": "我和幾位同學去這秘境裡看了看，說實話，這秘境的內部環境還滿混亂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930113
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930113,
					"content": "針對這個秘境，我們也開發了幾款煉金藥劑，用於對付某些特定的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930114
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930114,
					"content": "你看，我們學院的特長這不就展現出來了嗎？哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930115
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930115,
					"content": "#旅行者，如果{F#妳}{M#你}有興趣的話，就帶著這些藥劑，去那處秘境裡看看吧，我等會把秘境的位置標在{F#妳}{M#你}的<color=#00E1FFFF>地圖</color>上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930116,
						736930117
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930116,
					"content": "真的有人來…玩嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930118
					]
				},
				{
					"id": 736930117,
					"content": "除了我之外，還有人來玩嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736930118
					]
				},
				{
					"id": 736930118,
					"content": "還，還是有不少冒險家來挑戰秘境的嘛，他們還是很有興致的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930119
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930119,
					"content": "不過，學院裡的同學們確實沒幾個過來玩的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930120
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930120,
					"content": "#唉，總而言之，{F#妳}{M#你}要是有興趣的話，也可以去那處秘境裡看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930121
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930121,
					"content": "據那些冒險家說，這座秘境還是很有「挑戰性」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736930122,
						736930124
					],
					"speakerTitle": "巴哈多"
				},
				{
					"id": 736930126,
					"content": "#對了，如果{F#妳}{M#你}真要去的話，我還有一些特殊的藥劑給{F#妳}{M#你}…總之，探索那處秘境的時候要注意安全啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴哈多"
				}
			]
		}
	]
}