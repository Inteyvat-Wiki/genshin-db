			"dialogs": [
				{
					"id": 752500301,
					"content": "#這位客人，{F#妳}{M#你}來啦。今天真是有點忙不過來，我們的商品都脫銷了，只剩一些半成品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500302
					],
					"speakerTitle": "阿羅哈"
				},
				{
					"id": 752500302,
					"content": "您要是不介意…方不方便幫幫忙？幫那些半成品上色吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
