			"dialogs": [
				{
					"id": 752500101,
					"content": "買到玩偶的遊客們陸續離開了，這時，有幾位不速之客來到了綿馱園——",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500102
					]
				},
				{
					"id": 752500102,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500103
					]
				},
				{
					"id": 752500103,
					"content": "昨天來搶劫的愚人眾？是你們！你們…你們還想幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500104
					],
					"speakerTitle": "阿羅哈"
				},
				{
					"id": 752500104,
					"content": "有我在，別擔心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752500105
					]
				},
				{
					"id": 752500105,
					"content": "不…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500106
					]
				},
				{
					"id": 752500106,
					"content": "#為首的愚人眾擺了擺手，遞出了一張紙條。{F#妳}{M#你}攤開紙條，上面是歪歪扭扭的幾句話——",
					"roleType": "TALK_ROLE_CONSEQUENT_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500107
					]
				},
				{
					"id": 752500112,
					"content": "原來昨天伸手的時候，其實是在付錢嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500113
					],
					"speakerTitle": "阿羅哈"
				},
				{
					"id": 752500113,
					"content": "對、對不起…是我錯怪你們了…實在對不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500114
					],
					"speakerTitle": "阿羅哈"
				},
				{
					"id": 752500114,
					"content": "這些玩具請全部拿走吧！這是對你們的感謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500115
					],
					"speakerTitle": "阿羅哈"
				},
				{
					"id": 752500115,
					"content": "為首的愚人眾搖了搖頭，只擺出了一個「三」的手勢。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752500116
					]
				},
				{
					"id": 752500116,
					"content": "我明白了…你們和納塔的英雄一樣，都是值得敬佩的戰士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752500117
					],
					"speakerTitle": "阿羅哈"
				},
				{
					"id": 752500117,
					"content": "那我就準備一些色彩最適合你們的玩具吧，謝謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿羅哈"
				}
			]
		},
