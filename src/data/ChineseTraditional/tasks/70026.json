	"talks": [
		{
			"id": 7002601,
			"completionStepIds": [
				7002601
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002601",
							"2"
						],
						"stepId": 7002601,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700260101,
					"content": "#{F#妳}{M#你}好，旅行者，我們又見面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260102,
					"content": "#{F#妳}{M#你}最近的委託接取和完成紀錄都非常漂亮，說是冒險家協會的明星會員也不為過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260103,
						700260105
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260103,
					"content": "哪裡哪裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260104
					]
				},
				{
					"id": 700260104,
					"content": "#我們冒險家協會稻妻分會和其他分會平時就有交流，{F#妳}{M#你}在蒙德和璃月的事蹟我們都聽說了，{F#妳}{M#你}就不用謙虛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260107,
					"content": "#這次請{F#妳}{M#你}過來，其實是想請{F#妳}{M#你}考慮一份比較簡單的調查委託，需要調查的區域位於鶴觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260108
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260108,
					"content": "雖說鶴觀地區的天氣比較特別，經常有大霧籠罩，但只是進行調查任務的話，應該不會有太大危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260109
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260109,
					"content": "協會曾經將這份委託分派給一位比較有經驗的冒險家，但這位冒險家前往鶴觀後，很快就回來取消了委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260110
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260110,
					"content": "他也未做過多說明，只是匆忙說明自己能力有限，放棄了這個委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260111
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260111,
					"content": "可是在他之後，這份委託掛了很久也沒有人接，委託人也來問了很多次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260112
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260112,
					"content": "所以我想，如果請一位生存能力優更優秀、冒險經驗也更豐富的冒險家，應該能完美解決這份委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260113
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260113,
					"content": "#於是我想到了{F#妳}{M#你}。旅行者，{F#妳}{M#你}覺得怎麼樣呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260114,
						700260117
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260114,
					"content": "感覺有些可疑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260115
					]
				},
				{
					"id": 700260115,
					"content": "#{F#妳}{M#你}這麼想我也能夠理解，那位冒險家的放棄也在我們意料之外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260116
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260116,
					"content": "鶴觀向來人跡罕至，協會對那裡的情況瞭解的不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260120
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260120,
					"content": "嗯，既然如此，我們可以變通一下，稍微降低一下要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260121
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260121,
					"content": "#{F#妳}{M#你}在調查區域遇到難以處理的危險時，可以立即返回協會要求協助，不必執著於完整地調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260122
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260122,
					"content": "說起來，委託人是一位從須彌「教令院」來的學者，據說原本是想來研究鶴觀的氣候的，但在調查過程中遇到了一些困難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260123
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260123,
					"content": "所以才會在這裡發佈調查任務，這位學者似乎是拿出了一大半的研究經費，委託的報酬是很豐厚的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260124,
						700260125
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260124,
					"content": "我接了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260126
					]
				},
				{
					"id": 700260126,
					"content": "#{F#妳}{M#你}願意接受委託真是太好了，我現在就來幫{F#妳}{M#你}把調查地點標記出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260127
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260127,
					"content": "#調查的時候請務必注意安全，那麼，祝{F#妳}{M#你}一切順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260128
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260128,
					"content": "向著星辰與深淵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260125,
					"content": "要試試也不是不行…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260126
					]
				},
				{
					"id": 700260117,
					"content": "我想想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260118
					]
				},
				{
					"id": 700260118,
					"content": "#{F#妳}{M#你}猶豫的理由是委託有未知的危險嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260119
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260119,
					"content": "說實話，其實也有其他的冒險家以相同的原因拒絕過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260120
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260105,
					"content": "有話直說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260106
					]
				},
				{
					"id": 700260106,
					"content": "#{F#妳}{M#你}果然和傳說中的一樣，是個爽快的人呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260107
					],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
		{
			"id": 7002602,
			"completionStepIds": [
				7002603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002603",
							"2"
						],
						"stepId": 7002603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700260201,
					"content": "#旅行者，{F#妳}{M#你}回來了啊，情況怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260202
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260202,
					"content": "關於「會復活的遺蹟重機」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260203
					]
				},
				{
					"id": 700260203,
					"content": "出現在調查區域的奇怪遺蹟重機，不管打倒多少次都會重新站起來…這個情況委託人完全沒有提過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260204
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260204,
					"content": "難怪之前那位冒險家一副不想多提的樣子，應該是在那個奇怪的遺蹟重機那裡吃了虧吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260205
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260205,
					"content": "這種嚴重影響冒險家生命安全的事，應該早點跟我們說明才是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260206
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260206,
					"content": "明明在填寫委託內容說明的時候還特別講了要坦誠清晰的，胡塞尼先生怎麼能這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260207
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260207,
					"content": "語焉不詳、內容錯漏，最近越愈來愈多委託內容說明都是這樣，這樣叫協會怎麼分配任務給冒險家呢，真是的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260208,
						700260210
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260208,
					"content": "妳辛苦了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260209
					]
				},
				{
					"id": 700260209,
					"content": "我倒還好，只是希望委託人在發佈委託時，能夠跟協會溝通清楚吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260212
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260212,
					"content": "不好意思，忍不住就說了這些多餘的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260213
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260213,
					"content": "#總之，我認為合理的處理辦法是由{F#妳}{M#你}直接和委託人溝通，直接把「會復活的遺蹟重機」的情況告訴他本人，降低溝通成本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260214
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260214,
					"content": "看看他是否能接受這樣的調查結果，這樣還要繼續調查的話，委託人本人也應該一起想想解決辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260215
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260215,
					"content": "#我這裡也會做好情況登記工作，如果這個委託還要繼續的話，協會隨時都可以為{F#妳}{M#你}提供援助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260216
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260216,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260217
					]
				},
				{
					"id": 700260217,
					"content": "#那就辛苦{F#妳}{M#你}去和委託人胡塞尼先生談一談了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 700260210,
					"content": "這也是冒險的一部分吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260211
					]
				},
				{
					"id": 700260211,
					"content": "代表協會和委託人們溝通畢竟是我的工作內容之一，這也是冒險的一部分…吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260212
					],
					"speakerTitle": "凱瑟琳"
				}
			]
		},
		{
			"id": 7002603,
			"completionStepIds": [
				7002604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7002604",
							"2"
						],
						"stepId": 7002604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700260301,
					"content": "鶴觀的研究工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260302,
						700260303
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260302,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260304
					]
				},
				{
					"id": 700260304,
					"content": "#哦哦，我剛收到冒險家協會的情況說明時，就在猜接委託的是不是{F#妳}{M#你}，果然是{F#妳}{M#你}啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260305
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260305,
					"content": "這次的調查委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260306
					]
				},
				{
					"id": 700260306,
					"content": "#唉，我知道{F#妳}{M#你}要說什麼，凱瑟琳小姐剛剛跟我發了好大一頓牢騷，我已經大致明白情況了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260307
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260307,
					"content": "#在我委託{F#妳}{M#你}們調查的區域，出現了「會復活的遺蹟重機」對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260308,
						700260309
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260308,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260310
					]
				},
				{
					"id": 700260310,
					"content": "我的確是見過那台遺蹟重機，但我真的不知道它能夠「復活」呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260311
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260311,
					"content": "我來到稻妻之後，對傳聞中大霧彌漫的鶴觀產生了興趣，曾經自己去調查過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260312
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260312,
					"content": "鶴觀的迷霧誠不我欺，非常有研究價值。不過，我每次深入鶴觀的嘗試都失敗了，完全沒有取得任何進展…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260313
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260313,
					"content": "正當我這麼想的時候，我發現了這個不被霧氣籠罩的島嶼，以及那台遺蹟重機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260314
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260314,
					"content": "不過因為準備不足，我匆匆登島之後沒能停留太久就離開了，雖然看到過那台遺蹟重機，但是沒能仔細觀察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260315
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260315,
					"content": "真的不是我故意隱瞞，說實話，冒險和研究一樣，總是會有意料之外的情況出現，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260316
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260316,
					"content": "不過，我想了想，我對這次的意外情況並不是完全沒有頭緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260317
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260317,
					"content": "我的推測是：這台遺蹟重機搭載有自我修復功能模組，並且有充足的外部能源供應保證它各項功能運轉正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260318
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260318,
					"content": "它和常見的遺蹟重機相比先進了不少，應該是遺蹟重機中的特異型號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260319
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260319,
					"content": "遺蹟重機一類的自律機關是由混沌爐心提供能源的，混沌爐心一旦受損，機體動力不足自然就無法運轉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260320
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260320,
					"content": "但這台特異體不同，它的能源供應來自外部…這個外部能源我認為極有可能是地脈能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260321
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260321,
					"content": "我在古代文明對能源的應用方面還是有些研究的，據文獻記載，曾經有能夠永遠行動下去的自律機關存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260322
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260322,
					"content": "如果這個記載可靠，這台特異體很有可能就是古代文明在能源研究方面的重要產物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260323
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260323,
					"content": "我們得想辦法讓它停下來，對它進行詳細的研究才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260324
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260324,
					"content": "你有辦法嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260325
					]
				},
				{
					"id": 700260325,
					"content": "解決辦法有…嗯，至少三種，不過其中兩種效率太低。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260326
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260326,
					"content": "我想想，啊，對了，這不是正好嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260327
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260327,
					"content": "在來稻妻之前，我新開了幾個課題，從院裡申請了幾件文物作為研究材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260328
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260328,
					"content": "#剛好，{F#妳}{M#你}來之前，我的同鄉剛剛幫忙把它們送到我手上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260329
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260329,
					"content": "這其中有幾組叫做「普爾希娜光釘」的古代儀器，理論上能夠釋放擾亂地脈的力量，正好可以用來切斷這台特異體的能源供應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260330
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260330,
					"content": "不過不知道怎麼回事，這組「普爾希娜光釘」的功能好像都有點問題，不知道是不是在運輸過程中碰撞到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260331,
						700260332
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260331,
					"content": "那怎麼辦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260333
					]
				},
				{
					"id": 700260333,
					"content": "做研究就是會遇到這種意外情況嘛…哈哈，習慣就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260334
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260334,
					"content": "所以我想，既然我們都需要用「普爾希娜光釘」，我們可以嘗試合作，一起修好它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260335,
						700260338
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260335,
					"content": "感覺被利用了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260336
					]
				},
				{
					"id": 700260336,
					"content": "話可不能這麼說呀，我們這是剛好目的一致不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260337
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260337,
					"content": "而且，損人利己的事我是不會幹的，有辱「教令院」的名聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260341
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260341,
					"content": "好吧，我相信你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260342
					]
				},
				{
					"id": 700260342,
					"content": "太好了，那我們的合作就成立了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260343
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260343,
					"content": "「普爾希娜光釘」維修的困難之處在於維修所需的元件材質特殊，很難大量生產。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260344
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260344,
					"content": "一般採取的辦法都是以舊修舊，也就是說我們需要收集使用同種元件的古代遺物，利用其中的元件去修復光釘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260345
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260345,
					"content": "好在這種元件在古代遺物中非常常見，哪裡的地下埋藏有古代遺物群，哪裡就能找到這種元件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260346
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260346,
					"content": "#當然，{F#妳}{M#你}也不用擔心找不到古代遺物群，我們有現成的工具提升效率。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260347
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260347,
					"content": "#我交給{F#妳}{M#你}的這件工具叫做「阿葉夏混沌勘探器」，詳細的運作原理比較複雜，我就不一一解釋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260348
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260348,
					"content": "總之，「阿葉夏混沌勘探器」會在探測到古代遺物群或者地脈能量異常點時發出提示，勘測準確率…還是比較高的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260349
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260349,
					"content": "我們的當務之急就是藉由它來尋找埋藏於地下深處的元件，找到了足夠數量的元件我就可以開始維修校準了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260350
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260350,
					"content": "這項收集工作可能會花費幾天時間，但我們要有耐心，要有穩紮穩打的研究精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260351
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260351,
					"content": "#好了，{F#妳}{M#你}理解了的話就可以嘗試使用一下這件偉大的工具了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260338,
					"content": "真的會有用嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260339
					]
				},
				{
					"id": 700260339,
					"content": "雖然我還沒有實際使用過「普爾希娜光釘」，但驅動它運行的基本原理是經過學術界驗證的，理論上不會出錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260340
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260340,
					"content": "#{F#妳}{M#你}可以不相信我，但{F#妳}{M#你}要相信科技的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700260341
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 700260332,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260333
					]
				},
				{
					"id": 700260309,
					"content": "你完全不知情嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260310
					]
				},
				{
					"id": 700260303,
					"content": "我們又見面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700260304
					]
				}
			]
		}
	]
}