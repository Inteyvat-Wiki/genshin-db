			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小茂",
					"靈淵"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390201,
					"content": "阿藍、阿藍，妳上次講給我聽的那個故事，還沒有結尾呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390202
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390202,
					"content": "嗯。我記得，不過我改變主意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390203
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390203,
					"content": "「改變主意」是什麼意思呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390204
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390204,
					"content": "這個故事的結尾，就交給你來講吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390205
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390205,
					"content": "欸？！阿藍也太耍賴啦！明明說好我講一個故事給妳聽，妳講一個故事給我聽，怎麼現在兩個故事全都變成我來講啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390206
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390206,
					"content": "我只是愚鈍的野獸。想不出好的結局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390207
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390207,
					"content": "我想出的結局是壞結局，故事也是沒有人會歡笑的壞故事。所以，你來講故事的結局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390208
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390208,
					"content": "可這還是在耍賴嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390209
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390209,
					"content": "我不否認。作為補償，我可以帶你去看靈濛山中隱藏的絕景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390210
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390210,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390211
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390211,
					"content": "不要露出那種表情。我特別允許你…坐在我背上，五分鐘左右——十分鐘也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390212
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390212,
					"content": "那…那就這樣說好了，我想想這個故事該怎麼結尾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小茂"
				}
			]
		},
		{
			"id": 7113903,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
