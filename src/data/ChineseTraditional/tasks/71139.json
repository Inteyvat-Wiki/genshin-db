			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"靈淵"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1621.539,
							339.454,
							2412.706
						],
						"pointId": 311500191
					},
					{
						"sceneId": 3,
						"position": [
							1621.245,
							338.875,
							2414.79
						],
						"pointId": 311500192
					}
				]
			},
			"dialogs": [
				{
					"id": 711390301,
					"content": "欸，這不是靈淵嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390302,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390303
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390303,
					"content": "啊，對不起！難道說妳是在狩獵？我們不小心打擾了妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390304,
					"content": "#我沒有在狩獵。{F#妳}{M#你}們也沒有打擾我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390305
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390305,
					"content": "呃…那妳這是在…發呆？比方說…在想好吃的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390306,
					"content": "我也沒在想妳的事情。我在思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390307
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390307,
					"content": "思考…不對，妳前半句話是什麼意思啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390308,
					"content": "#我在思考{NICKNAME}之前的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390309
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390309,
					"content": "「如果人類活動也是自然法則的一部分，該如何看待人類。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390310
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390310,
					"content": "浮錦和蛇，她們離開後，我太久沒有接觸過組成聚落的人類了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390311
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390311,
					"content": "妳這話說的，小茂不也是人類嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390312,
					"content": "#小茂是屬於聚落的人類，而不是組成聚落的人類。妳和{NICKNAME}「組成」了旅行的同伴，而不「屬於」{NICKNAME}。這就是區別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390313,
						711390315
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390313,
					"content": "妳認為小茂不是社會秩序的一部分？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390314
					]
				},
				{
					"id": 711390314,
					"content": "還沒有完全成為這種秩序的一部分。人類的幼崽幾乎都是這樣，直到他們被這種秩序徹底塗抹，就像是自然那樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390317,
					"content": "我太久沒有接觸過組成聚落的人類了。或許是出於厭惡，或許是出於恐懼——或許兩者皆有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390318,
						711390319
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390318,
					"content": "因為他們侵佔了屬於自然的土地？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390320,
					"content": "我不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390321
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390321,
					"content": "也許沒有明顯的區別可以劃分「我們」和「他們」，但我無法確定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390322
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390322,
					"content": "人類的幼崽會與我同行，我也有年幼的同族，出於好奇選擇與人類同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390323
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390323,
					"content": "欸？年幼的同族？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390324,
					"content": "那孩子在山中遇到了煙火氣的人類，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390325
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390325,
					"content": "#所以，我現在依然沒辦法回答{F#妳}{M#你}的問題。我需要繼續觀察人類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390326
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390326,
					"content": "#許多事情，我不理解。我會試著理解，直到我能夠按照約定，回答{F#妳}{M#你}的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390319,
					"content": "因為浮錦為了他們選擇犧牲自己？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390320
					]
				},
				{
					"id": 711390315,
					"content": "這不太好說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390316
					]
				},
				{
					"id": 711390316,
					"content": "喂！不要說這麼奇怪的話啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390317
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7113904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7113904",
							"2"
						],
						"stepId": 7113904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小茂",
					"沃特蒙泰涅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390401,
					"content": "聽大山這麼講，我感覺楓丹的「歌劇」和我們這邊的戲好像也差不多呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390402
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390402,
					"content": "騎士呀、巫師呀、勇士呀、惡龍呀，你殺我，我殺你的，最後大家都死了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390403
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390403,
					"content": "重要的不是結局啦，而是過程，過程！不是所有悲劇都能當武打戲看的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390404
					],
					"speakerTitle": "沃特蒙泰涅"
				},
				{
					"id": 711390404,
					"content": "還有還有，大山剛才說的「累牡蠣牙魔像」，聽上去好像很有趣！不知道和阿藍比起來哪個更大呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390405
					],
					"speakerTitle": "小茂"
				},
				{
					"id": 711390405,
					"content": "欸？阿蘭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390406
					],
					"speakerTitle": "沃特蒙泰涅"
				},
				{
					"id": 711390406,
					"content": "對喔，我好像還沒跟大山講過阿藍的事情…這樣吧，你再講一講「累牡蠣牙」的魔像，我就講阿藍的故事給你聽好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小茂"
				}
			]
		},
		{
			"id": 7113905,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"浮錦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711390501,
					"content": "哇啊！不知不覺間，我們已經收集到這麼多仙力啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390502,
						711390503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390502,
					"content": "不愧是我！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390505
					]
				},
				{
					"id": 711390505,
					"content": "按照浮錦之前的說法，這些仙力都用在「祀瓏」上了。這樣一來，翹英莊明年應該也會大豐收啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390506,
					"content": "到了那時候，我要請羅叔準備好多好多好吃的給我！我想想…像是茶糕、乳鴿、紅燒肉圓、蜜汁叉燒，還有還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390507,
					"content": "對對對，還有沉玉茶露！這個一定要記下來…欸？不對，什麼人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390508,
					"content": "浮、浮錦？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390509,
					"content": "#呵呵，抱歉，嚇到{F#妳}{M#你}們了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390510
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390510,
					"content": "妳已經能變回人形啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390511,
					"content": "是呀。咳咳，小仙我不是說過嘛，又不是受了什麼嚴重的傷，只要稍微休養一段時間，就能恢復我最喜歡的模樣啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390512
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390512,
					"content": "#謝謝{F#妳}{M#你}們，在我休養的這段時間，為祀瓏收集了這麼多的仙力。來年的豐收，{NICKNAME}和派蒙是最大的功臣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390513,
						711390514
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390513,
					"content": "#哼哼，對本{M#少爺}{F#小姐}來說不過是舉手之勞！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390515,
					"content": "說到這個，既然浮錦現在已經恢復人形了，也不用再被關在這個黑漆漆的地方了，接下來有什麼想做的事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390516,
					"content": "嗯…具體的我還沒有想好呢。說不定會先在附近走走看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390517
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390517,
					"content": "品一品現在的茶、聽一聽現在的戲、見一見現在的人…呵呵，抱歉，總是強調「現在」，感覺像是什麼討人厭的老古董一樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390518
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390518,
					"content": "不過，我真的很喜歡「現在」這個詞。過去沒辦法做到的事情，「現在」也能做得到了。過去沒辦法實現的好多好多的約定，「現在」也能實現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390519
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390519,
					"content": "之後，我想要到歸離集去看一看、到璃月港去看一看，去見見她們所說的可愛的人們，也想要見見藥君…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390520
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390520,
					"content": "需要我帶妳去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390521
					]
				},
				{
					"id": 711390521,
					"content": "是呀，我記得浮錦好像說過，「沒辦法離開清水太長時間」、「需要依靠仙家的茶壺才能去很遠的地方」什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390522,
					"content": "#呵呵…謝謝{F#妳}{M#你}還記得這件事，也謝謝{F#妳}{M#你}願意幫我。不過，我還是希望先在沉玉谷停留一段時間，好好欣賞一下家中的風景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390523
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390523,
					"content": "至於遠遊，我想想…嗯，要不然等小茂長大吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390524
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390524,
					"content": "這也太久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390525,
					"content": "開玩笑的啦！總之，我還是打算先在這邊停留一段時間，也順便試試看能不能勸靈淵和我一同出遊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390526
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390526,
					"content": "#對了，{NICKNAME}！在{F#妳}{M#你}走之前，還有一件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390527
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390527,
					"content": "#無論是靈淵還是我，都給{F#妳}{M#你}們添了太多太多的麻煩。我的仙力也稍稍恢復一些了，還請讓我為{F#妳}{M#你}們獻上真正的祝福，護佑{F#妳}{M#你}們接下來的旅途吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390528
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390528,
					"content": "呵呵，好了！這樣一來，應該就沒問題啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390529,
						711390530
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390529,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390532
					]
				},
				{
					"id": 711390532,
					"content": "#那麼，再一次…謝謝{F#妳}{M#你}們，{NICKNAME}和派蒙，謝謝{F#妳}{M#你}們為我，為沉玉谷做的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390530,
					"content": "總覺得好像沒什麼變化…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390531
					]
				},
				{
					"id": 711390531,
					"content": "畢竟「福運」也不是一下子就能看出來的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390532
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390514,
					"content": "有幫上忙就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390515
					]
				},
				{
					"id": 711390503,
					"content": "#不愧是本{M#少爺}{F#小姐}！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390504
					]
				},
				{
					"id": 711390504,
					"content": "喂！都過去那麼久了，就不要再用那種奇怪的說話方式啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390505
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
