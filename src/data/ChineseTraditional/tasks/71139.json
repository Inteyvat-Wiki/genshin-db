			},
			"dialogs": [
				{
					"id": 711390601,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390602
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390602,
					"content": "怎麼了，靈淵？一直盯著我看，我身上有什麼奇怪的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390603
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390603,
					"content": "我只是在想…不，沒什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390604
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390604,
					"content": "就算妳和蛇一起要求，我也不會再化成人形了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390605
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390605,
					"content": "呵呵，我也沒要求過妳呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390606
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390606,
					"content": "算了…走吧。妳不是還要去看現在的茶園嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "靈淵"
				}
			]
		},
		{
			"id": 7113907,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7113907",
							"2"
						],
						"stepId": 7113907,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"浮錦",
					"靈淵"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1499.263,
							-45.19,
							2743.714
						],
						"pointId": 311600090
					},
					{
						"sceneId": 3,
						"position": [
							1499.039,
							-45.012,
							2744.685
						],
						"pointId": 311600091
					},
					{
						"sceneId": 3,
						"position": [
							1498.467,
							-44.813,
							2746.65
						],
						"pointId": 311600093
					}
				]
			},
			"dialogs": [
				{
					"id": 711390701,
					"content": "話說回來，這裡就是浮錦的洞天吧？總覺得和我們見過的其他洞天不太一樣，怎麼說呢…好像更…有現實感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390702,
					"content": "既沒有什麼奇奇怪怪的機關，也沒有什麼透明的浮空橋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390703,
					"content": "實在是對不起…之前覺得太丟人了，一直沒能解釋清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390704
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390704,
					"content": "我沒辦法像南方眾仙那樣創造出新的空間來。「錦落庭」不是什麼「洞天」，充其量也就只是個「洞穴」而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390705
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390705,
					"content": "「洞天」也好，「洞穴」也好，不都是仙家的「洞府」嘛！不過，也不知道浮錦什麼時候才能變回人形呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390706,
					"content": "她累積的力量已經全部逸散到了這片土地上。短時間內應該沒辦法再恢復人形了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390707
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390707,
					"content": "我耗盡力量的時候也是一樣。主人死去後，從雪落到雪融，再從雪融到雪落，如此反覆不知多少次，我才能再度化為人的模樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390708
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390708,
					"content": "原來是這樣…欸？等一下，原來靈淵也能化成人形嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390709,
					"content": "哼哼，那是當然！兩位有所不知，想當初，在藥君山的時候，靈淵的姿容可是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390710
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390710,
					"content": "浮錦。沒必要說下去。這和現在的話題沒有任何關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390711
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390711,
					"content": "欸？那化為人形以後，因為在廟會上吃了太多茶糕，哭著跑去求藥君幫自己調配減肥茶的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390712
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390712,
					"content": "或者不小心把慶典上的酒當作茶水喝了下去，拽著山間的林豬，問「藥君和我誰更美」的事情，果然還是沒必要說下去了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390713
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390713,
					"content": "…浮錦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390714
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390714,
					"content": "嗚啊，妳這麼一說，我開始好奇靈淵化成的人形到底是什麼樣的了！會是像現在一樣藍藍的嗎？還是會…呃…更白一點？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390715,
						711390717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390715,
					"content": "我也很好奇！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390716
					]
				},
				{
					"id": 711390716,
					"content": "#我不理解{F#妳}{M#你}好奇的原因。{F#妳}{M#你}也是人。對人的形態感興趣，看看自己就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390721
					],
					"speakerTitle": "靈淵"
				},
				{
					"id": 711390721,
					"content": "#呵呵…總之，謝謝{F#妳}{M#你}們，{NICKNAME}和派蒙。我也沒有想到，有朝一日，還能像這樣和其他人交流…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390722
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390722,
					"content": "咳咳——既然小仙我心情大悅，不妨就護佑兩位接下來的旅途能夠一帆風順，時通運泰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390723
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390723,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711390724,
					"content": "…對不起是我得意忘形了。我剛才想要像仙人那樣，說一下這句話試試看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711390725
					],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390725,
					"content": "#無論如何，我都會在這裡祈願，願{F#妳}{M#你}們接下來的旅途一帆風順。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浮錦"
				},
				{
					"id": 711390717,
					"content": "靈淵，可以變一下看看嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711390718
					]
				},
				{
					"id": 711390718,
					"content": "我拒絕。人類的身軀過於羸弱。沒有撕碎獵物的尖牙、沒有逐狩仇敵的利爪，除非浮錦命令，我不會做那種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
