			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲爾戈黛特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240201,
					"content": "旅行者，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240202
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718240202,
					"content": "關於小冥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240203
					]
				},
				{
					"id": 718240203,
					"content": "#{F#妳}{M#你}說她啊，自從上次那件事之後，她就安穩很多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240204
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718240204,
					"content": "不過，那孩子倒也可憐，之前逢年過節，客棧越是熱鬧，她就越落寞，所以才經常搗亂，嚇壞了客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240205
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718240205,
					"content": "但她應該也只是想有人陪著她玩吧，畢竟，她也只是個孩子而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240206,
						718240207
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718240206,
					"content": "能送盞霄燈給她嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				},
				{
					"id": 718240208,
					"content": "給她送霄燈？嗯…這個主意倒還不錯，不過那孩子很難找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240209
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718240209,
					"content": "#如果想找她的話，{F#妳}{M#你}就在晚上去旁邊的樹林裡，把霄燈掛在樹梢上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240210
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718240210,
					"content": "這樣的話，她應該就能看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718240207,
					"content": "不知道她喜不喜歡霄燈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240208
					]
				}
			]
		},
