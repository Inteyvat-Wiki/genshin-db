			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718240101,
					"content": "得再快點了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240102,
					"content": "生意這麼好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240103
					]
				},
				{
					"id": 718240103,
					"content": "沒有。這不是正過節嗎？客棧裡一堆人回去過節了，幹活的人少了一堆，工作差不多都得我自己來做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240104,
					"content": "還好，客人不算太多，我一個人還頂得住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240105
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240105,
					"content": "#咳，我還得謝謝{F#妳}{M#你}，上次幫我那個忙，要不是{F#妳}{M#你}，我看我現在也沒辦法正常開工…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240106,
						718240107
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240106,
					"content": "你最近還…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				},
				{
					"id": 718240108,
					"content": "沒有！絕對沒有，相信我，絕對沒有！要再來一次，我絕對受不了了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240109
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240109,
					"content": "#{F#妳}{M#你}要是真想打聽那件事…她的話，就去問問老闆吧，我是真…真不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				},
				{
					"id": 718240107,
					"content": "那她最近…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240108
					]
				}
			]
		},
		{
			"id": 7182402,
			"completionStepIds": [
				7182402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
