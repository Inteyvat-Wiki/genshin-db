			"dialogs": [
				{
					"id": 718240301,
					"content": "怎麼樣，你們把霄燈送過去了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240302
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718240302,
					"content": "應該…算是送過去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718240303
					]
				},
				{
					"id": 718240303,
					"content": "嗯，這樣就最好了，這樣那孩子應該也會高興一些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718240304
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 718240304,
					"content": "不知道…那孩子會許什麼願望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				}
			]
