			"dialogs": [
				{
					"id": 751790701,
					"content": "這麼說來，全靠這三位的幫助，大姐妳才安然無恙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790702
					],
					"speakerTitle": "蒂茲洛"
				},
				{
					"id": 751790702,
					"content": "哈哈，沒錯沒錯！你是沒看到這些傢伙有多厲害，兩三下就把那幾個怪物給放倒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790703
					],
					"speakerTitle": "伊扎婭"
				},
				{
					"id": 751790703,
					"content": "你們救了隊長，我無以回報。小小禮物，不成敬意，還請你們收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790704
					],
					"speakerTitle": "蒂茲洛"
				},
				{
					"id": 751790704,
					"content": "小氣，蒂茲洛你這傢伙一直都這麼小氣？對救命恩人怎麼能只給這麼一點謝禮呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊扎婭"
				}
			]
		},
