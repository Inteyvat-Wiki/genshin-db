			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蒂茲洛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751790401,
					"content": "#喂！{F#妳}{M#你}，對就是{F#妳}{M#你}，外面危險，快進來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790402
					],
					"speakerTitle": "蒂茲洛"
				},
				{
					"id": 751790402,
					"content": "#哎呀，{F#妳}{M#你}沒看見這一路的慘象嗎？這又是火山噴發，又是有怪物攔路的，可不敢再往前走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790403
					],
					"speakerTitle": "蒂茲洛"
				},
				{
					"id": 751790403,
					"content": "#{F#妳}{M#你}呀，聽我一句勸。先在這裡等等，等一下跟我們商隊的人一起走，這樣也有個照應。要不然一個人走多危險啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790404,
						751790408
					],
					"speakerTitle": "蒂茲洛"
				},
				{
					"id": 751790404,
					"content": "怪物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790405
					]
				},
				{
					"id": 751790405,
					"content": "是一群紫色的嵴鋒龍！一看就是被深淵汙染了！破壞力特別強，說實話我從來沒見過這麼嚇人的嵴鋒龍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790406
					],
					"speakerTitle": "蒂茲洛"
				},
				{
					"id": 751790406,
					"content": "#我跟{F#妳}{M#你}說，那幾個傢伙隨便掃了一下尾巴就把我們的大車給打壞了，力氣比突角龍還大，這一定不是普通人能處理的對手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790407
					],
					"speakerTitle": "蒂茲洛"
				},
				{
					"id": 751790407,
					"content": "#{F#妳}{M#你}聽我一句，{F#妳}{M#你}可千萬不要頭腦一熱跑去跟牠們打架啊，見到牠們還是繞開一點為好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂茲洛"
				},
				{
					"id": 751790408,
					"content": "沒事，我可以的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790409
					]
				},
				{
					"id": 751790409,
					"content": "#{F#妳}{M#你}，唉…好吧，那{F#妳}{M#你}路上小心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂茲洛"
				}
			]
		},
