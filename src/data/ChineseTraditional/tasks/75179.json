			},
			"dialogs": [
				{
					"id": 751790901,
					"content": "伊、伊察霍，清、清單上還差好多東西，你、你來幫忙找找！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790902
					],
					"speakerTitle": "馬索瑟"
				},
				{
					"id": 751790902,
					"content": "唉…別浪費力氣了，我都看過了。基本都是一些易損的東西，就之前又是火山又是翻車的，你覺得還會有剩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790903
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790903,
					"content": "省點力氣，好好休息一會。等大姐她們回來，還有好長的路要走呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790904
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790904,
					"content": "不、不行！算、算了，你不去我去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "馬索瑟"
				}
			]
		},
