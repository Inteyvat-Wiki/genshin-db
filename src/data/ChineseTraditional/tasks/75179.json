			"dialogs": [
				{
					"id": 751790201,
					"content": "吁吁——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790202,
						751790204
					],
					"speakerTitle": "扎什"
				},
				{
					"id": 751790202,
					"content": "還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790203
					]
				},
				{
					"id": 751790203,
					"content": "還、還好，就是剛剛跑得有點急，心、心跳得厲害，緩一緩就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎什"
				},
				{
					"id": 751790204,
					"content": "好好休息。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790205
					]
				},
				{
					"id": 751790205,
					"content": "嗯，謝、謝謝關心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎什"
				}
			]
		},
