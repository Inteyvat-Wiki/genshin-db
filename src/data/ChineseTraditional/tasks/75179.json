				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2893.348,
							257.691,
							9926.251
						],
						"pointId": 10703
					},
					{
						"sceneId": 3,
						"position": [
							-2892.566,
							257.855,
							9924.833
						],
						"pointId": 10710
					},
					{
						"sceneId": 3,
						"position": [
							-2892.844,
							257.694,
							9921.14
						],
						"pointId": 10983
					}
				]
			},
			"dialogs": [
				{
					"id": 751790101,
					"content": "#那邊的，住、住手！這些都是我們的！不許動！告訴{F#妳}{M#你}，我、我可是能參加「巡夜者戰爭」的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790102
					],
					"speakerTitle": "馬索瑟"
				},
				{
					"id": 751790102,
					"content": "#{F#妳}{M#你}、{F#妳}{M#你}要是敢搶我們的東西，我一定讓{F#妳}{M#你}吃不完兜著走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790103
					],
					"speakerTitle": "馬索瑟"
				},
				{
					"id": 751790103,
					"content": "唉…今天怎麼回事啊？又是火山噴發，又是紫色嵴鋒龍的…現在又冒出一堆劫盜的來，真是倒楣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790104
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790104,
					"content": "#馬索瑟，{M#他}{F#她}看起來蠻厲害的，打不過的，還是算了吧…而且，我們只是看比賽的，應該不算是參加了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790105
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790105,
					"content": "#伊察霍，你、你這傢伙！你怎麼能這樣，這可是大家的東西！再、再說了，我、我們兩個打{M#他}{F#她}一個，未必打不過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790106
					],
					"speakerTitle": "馬索瑟"
				},
				{
					"id": 751790106,
					"content": "誰說是兩個人？要挨打你上，可別算上我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790107
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790107,
					"content": "#這位{M#大哥}{F#大姐}，東西我們不要了，{F#妳}{M#你}想要{F#妳}{M#你}就拿去。只要別動手就行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790108,
						751790109
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790108,
					"content": "這一定是有點誤會…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790111
					]
				},
				{
					"id": 751790111,
					"content": "你們都誤會啦！我們可是樂於助人的好冒險家，才不是那種不明不白的壞人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751790112,
					"content": "#我、我憑什麼相信{F#妳}{M#你}們！啊！好痛，伊察霍你為什麼打我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790113
					],
					"speakerTitle": "馬索瑟"
				},
				{
					"id": 751790113,
					"content": "人家要不懷好意，早就揍你了，還用得著跟你在這裡浪費口舌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790114
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790114,
					"content": "兩位，實不相瞞，我們商隊剛剛被打散了，既然你們是冒險家的話，不知道能不能幫我們通知一下老大，就說我們在這裡等她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790115
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790115,
					"content": "箱子裡的東西，就當是我們給的謝禮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790116
					],
					"speakerTitle": "伊察霍"
				},
				{
					"id": 751790116,
					"content": "這個簡單，就交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751790109,
					"content": "你倒是滿上道的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751790110
					]
				},
				{
					"id": 751790110,
					"content": "#喂！{F#妳}{M#你}這說法！別搞得我們像是那種壞人一樣啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751790111
					],
					"speakerTitle": "派蒙"
				}
			]
		},
