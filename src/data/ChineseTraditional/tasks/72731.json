			},
			"dialogs": [
				{
					"id": 727310201,
					"content": "哈哈哈哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310202
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727310202,
					"content": "盡興！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310203
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727310203,
					"content": "哈哈哈哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310204
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310204,
					"content": "痛快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310205
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310205,
					"content": "儘管鬥蟲的風格與我不同，但你傾注在鬼兜蟲身上的一腔熱血，讓我找到了強烈的共鳴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310206
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727310206,
					"content": "假以時日，你必定能成為鬥蟲界的佼佼者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310207
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727310207,
					"content": "你也不賴！整整一千一百四十一場較量，居然能勉強戰勝本大爺五百七十場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310208
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310208,
					"content": "和本大爺拉鋸百場以上的對手裡，你最有毅力，不得不說，你讓本大爺刮目相看了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310209
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310209,
					"content": "是五百七十一場，我贏的次數比較多喔。考慮到客場作戰的因素，本來應該是我占上風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310210
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727310210,
					"content": "嘿？你是怎麼？這種時候還嘴硬？本大爺記得清清楚楚，阿守也可以作證！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310211
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310211,
					"content": "你說是吧，阿守？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310212
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310212,
					"content": "老大…我、我實在撐不住了…讓我睡一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310213
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 727310213,
					"content": "嗚哇，難道這段時間，他們一直在這裡鬥蟲，完全沒有休息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310214,
					"content": "他們一直在這裡鬥蟲，完全沒有休息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310215,
						727310216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310215,
					"content": "擂臺都快被震裂了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310217
					]
				},
				{
					"id": 727310217,
					"content": "好！本大爺寬宏大量，讓你一局也無所謂，反正接下來，本大爺還會贏回來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310218
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310218,
					"content": "看你不服氣的樣子，之後的較量，就去你的主場吧。本大爺要讓你明白，場地沒什麼影響，關鍵還是鬥蟲的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310219
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310219,
					"content": "正合我意，且隨我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310220
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727310220,
					"content": "#嗯？我的摯友和飛行矮堇瓜，{F#妳}{M#你}們總算來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310221
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310221,
					"content": "怎麼又變回飛行矮堇瓜了，難道我不幫你鬥蟲的時候，你就只能想起難聽的綽號嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310222,
					"content": "#這個先放一邊！說好要給{F#妳}{M#你}們的兩個月份免費拉麵優惠券，拿著吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310223
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310223,
					"content": "拉麵優惠券？對喔，拉麵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310224,
					"content": "這樣才像話嘛，還算你識相！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310225,
						727310226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310225,
					"content": "撒花慶祝！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310227,
					"content": "不對不對，這次只算是「荒瀧極意堂堂鬥蟲大試合」的預演！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310228
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310228,
					"content": "畢竟完全沒有任何觀眾，未免也太冷清了，不能就這樣草草了事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310229
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310229,
					"content": "幸運的是，「花角玉將」總算放下了他的架子，承認本大爺是難得一遇的鬥蟲強者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310230
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310230,
					"content": "我們的較量還沒結束，之後，本大爺要孤軍深入「花角玉將」的陣地，打他個心服口服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310231
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310231,
					"content": "到時候，「花角玉將」也會聽候本大爺的調遣，一起把「荒瀧極意堂堂鬥蟲大試合」辦得熱熱鬧鬧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310232
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310232,
					"content": "#這次就多謝{F#妳}{M#你}們了，等著本大爺的捷報吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310233
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310233,
					"content": "嘿嘿，這回放牛的終於是玩了個爽快，我們也賺到了整整兩個月的拉麵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310234,
						727310235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310234,
					"content": "全員大豐收！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310236,
					"content": "老大、老大！忍姐來信了，你快看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310237
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727310237,
					"content": "咦？老大跑去哪了？之前明明一直在這鬥蟲的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310238
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727310238,
					"content": "欸？有什麼要緊的事嗎？放牛的剛剛才跟著「花角玉將」走了，說是要繼續去切磋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310239,
					"content": "倒也不是什麼要緊的事，就是有點意外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310240
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727310240,
					"content": "#實際的內容，請{F#妳}{M#你}們看一下信吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310241
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 727310241,
					"content": "呃啊，結果到頭來，「花角玉將」也算是荒瀧派的自己人嗎？只不過「花角玉將」根本不好好說話，弄得放牛的如臨大敵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310242,
					"content": "和阿忍的預料一樣，放牛的確實在廢寢忘食地鬥蟲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310243,
					"content": "不過找了我們來舉辦「荒瀧極意堂堂鬥蟲大試合」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310244,
					"content": "倒也算不上安靜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310245
					]
				},
				{
					"id": 727310245,
					"content": "這樣看來，拉麵的優惠券，更應該獎勵給阿忍才對嘛！等到阿忍回來了，我們一起去吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310246,
					"content": "欸？等等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310247
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310247,
					"content": "說起來，放牛的根本還沒有告訴我們，這張優惠券到底能用在哪家拉麵店呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310248,
					"content": "難不成，還得我們自己去找嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 727310235,
					"content": "好啦，其實開心比較重要…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310236
					]
				},
				{
					"id": 727310226,
					"content": "「鬥蟲大試合」圓滿結束！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310227
					]
				},
				{
					"id": 727310216,
					"content": "鬼兜蟲都要累趴了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						727310248
					]
				}
			]
		},
		{
