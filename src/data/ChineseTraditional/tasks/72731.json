			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「花角玉將」",
					"荒瀧一斗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 727310701,
					"content": "原來如此、原來如此啊…再打一場吧，我一定能看透你鬥蟲的訣竅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310702
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727310702,
					"content": "比試的勝負似乎已經沒那麼重要了，我們就鬥個爽快，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310703
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727310703,
					"content": "難得有這麼合拍的對手，短短幾分鐘就結束，未免也太不盡興了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310704
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 727310704,
					"content": "哈！來就來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310705
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310705,
					"content": "不過…看穿本大爺鬥蟲的秘技？你可別癡心妄想啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310706
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 727310706,
					"content": "如果你肯承認，是我鬥蟲的本領更強，無論鬥多少場，我都會奉陪到底！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						727310707
					],
					"speakerTitle": "荒瀧一斗"
				},
