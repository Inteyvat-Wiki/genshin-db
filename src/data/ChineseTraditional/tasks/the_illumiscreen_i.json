			"dialogs": [
				{
					"id": 413570301,
					"content": "怎麼樣，尋寶之旅還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570302
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570302,
					"content": "已經找到全部寶藏了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570303
					]
				},
				{
					"id": 413570303,
					"content": "#全部都找到了？{F#妳}{M#你}尋寶的功夫還不錯嘛，不少人連燈都轉不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570304
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570304,
					"content": "#既然{F#妳}{M#你}找到了全部的寶藏…那這些獎勵給{F#妳}{M#你}，收下吧，祝{F#妳}{M#你}在海燈節玩得開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
			]
		},
