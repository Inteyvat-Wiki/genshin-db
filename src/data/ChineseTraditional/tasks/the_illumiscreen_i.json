			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小千"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570101,
					"content": "歡迎試玩「玲瓏霄燈圖」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570102
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570102,
					"content": "什麼…什麼圖？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570103
					]
				},
				{
					"id": 413570103,
					"content": "#「玲瓏霄燈圖」，怎麼樣，{F#妳}{M#你}想試試玩一下嗎？很簡單的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570104
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570104,
					"content": "#{F#妳}{M#你}看見後面的這幾扇畫屏了嗎？還有前面的這三盞燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570105
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570105,
					"content": "這些燈是我特意去找人訂製的，打開之後，可以映出各種不同的圖案…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570106
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570106,
					"content": "而且，如果用正確的方式轉動這三盞燈，還能把三盞燈的圖案拼在一起，形成一個完整的圖案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570107
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570107,
					"content": "啊…這麼說你應該也不太明白。這樣吧，你先去試試看轉動一盞燈吧。先熟悉一下基本操作，然後我再詳細告訴你玩法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
			]
		},
		{
			"id": 4135702,
			"completionStepIds": [
				4135704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135703",
							"3"
						],
						"stepId": 4135703,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4135704",
							"2"
						],
						"stepId": 4135704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小千"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413570201,
					"content": "#哦呀，{F#妳}{M#你}學得很快嘛，知道了基本的原理，那{F#妳}{M#你}可以試著正式開始玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570202
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570202,
					"content": "會很難嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570203
					]
				},
				{
					"id": 413570203,
					"content": "#不會不會，{F#妳}{M#你}剛才不是已經學會怎麼轉動這些燈了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570204
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570204,
					"content": "正式玩的時候，只要旋轉這三盞鐙，把它們映在屏風上的圖案組合成一個完整的正確圖案就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570212
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570212,
					"content": "#我會提前告訴{F#妳}{M#你}應該組合的圖案，但是轉動三盞燈的方式…可能就要{F#妳}{M#你}自己好好推敲一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570205
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570205,
					"content": "拼出來之後呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413570206
					]
				},
				{
					"id": 413570206,
					"content": "#唔，我不知道{F#妳}{M#你}注意到沒有，後面的這些屏風，上面畫的可都是我們璃月的「地圖」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570207
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570207,
					"content": "#當{F#妳}{M#你}把正確的圖案拼出來，並且映在地圖上之後，就可以發現我們冒險家協會特意準備好的「寶藏」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570208
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570208,
					"content": "為了設置那些藏寶處，協會可是請了很多人，花了很多時間呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570213
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570213,
					"content": "#但是那些寶箱嘛…也和我對面的那些寶箱一樣，如果{F#妳}{M#你}確定了地點，應該很好找的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570209
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570209,
					"content": "我已經把圖案調整好了。今天的圖案是<color=#00E1FFFF>「琉璃百合」</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570210
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570210,
					"content": "#哦對了，還有件事，這「玲瓏霄燈圖」上燈的圖案，只有在晚上才看得最清楚，{F#妳}{M#你}最好是等晚上再過來玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413570211
					],
					"speakerTitle": "小千"
				},
				{
					"id": 413570211,
					"content": "而且，這幾盞燈可是協會專門請人來做的，這麼漂亮的燈，不仔細看看的話，實在有些可惜了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小千"
				}
			]
		},
