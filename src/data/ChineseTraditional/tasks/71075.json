					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710750101,
					"content": "#嘿，就是{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750102
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750102,
					"content": "#那個什麼二哥，翻了半天翻不到，{F#妳}{M#你}這個對這個地方熟悉的傢伙總能找到吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750103
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750103,
					"content": "#找不到？只要等到一個能找到的人，逼{F#妳}{M#你}們把找到的東西交出來不就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750104
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750104,
					"content": "我江湖人稱「小輕策」，區區層岩巨淵這兒一群挖礦的擺不平，還怎麼在外面混？來，把東西給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750105
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750105,
					"content": "千岩軍的寶藏，我們盜寶團就收下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750106,
						710750107
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750106,
					"content": "無論你想要什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				},
				{
					"id": 710750108,
					"content": "#{F#妳}{M#你}說沒有就沒有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750109
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750109,
					"content": "#…哼，我還以為{F#妳}{M#你}們每天跑上跑下，身子看起來能結實點呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750110
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750110,
					"content": "#{F#妳}{M#你}選吧，是被我一拳撂倒搜個全身，還是自己親手把「庇佑之冠」呈上來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750111
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750111,
					"content": "我覺得你不會想和我打的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750112
					]
				},
				{
					"id": 710750112,
					"content": "呦，語氣很大嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710750113
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750113,
					"content": "#我看{F#妳}{M#你}這是敬酒不吃吃罰酒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "？？？"
				},
				{
					"id": 710750107,
					"content": "這裡都沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710750108
					]
				}
			]
		}
	]
