			},
			"dialogs": [
				{
					"id": 741830401,
					"content": "哇…和我們之前見過的發光怪魚好像！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830402,
					"content": "周圍還有奇奇怪怪的東西纏在上面…到底怎麼回事啦！搞不懂，我越來越迷糊了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830403,
						741830404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830403,
					"content": "這個聲音，之前在夢裡也有聽過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				},
				{
					"id": 741830405,
					"content": "#嗯，{F#妳}{M#你}應該在至尊的記憶裡見過他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830406
					],
					"speakerTitle": "嗚斯先生"
				},
				{
					"id": 741830406,
					"content": "「斯庫拉」——曾經侍奉至尊的惡龍，他是被波愛修斯鎮壓並封印在這裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830407
					],
					"speakerTitle": "嗚斯先生"
				},
				{
					"id": 741830407,
					"content": "欸欸？鎮壓惡龍？沒想到那個沒禮貌的傢伙還做過這麼了不起的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830408,
					"content": "說是惡龍，其實不過是稍微厲害一些的龍蜥罷了。畢竟在眾水的主人還蟄居深海之時，是不會有新的水之龍誕生的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嗚斯先生"
				},
				{
					"id": 741830404,
					"content": "不過名字…記不起來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830405
					]
				}
			]
		},
		{
			"id": 7418306,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7418306",
							"2"
						],
						"stepId": 7418306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯庫拉",
					"嗚斯先生"
				],
				"points": [
					{
						"sceneId": 11,
						"position": [
							1569,
							656.42,
							4486
						],
						"pointId": 901101005
					}
				]
			},
			"dialogs": [
				{
					"id": 741830601,
					"content": "噢噢噢噢，何等溫暖的洋流啊！老夫終於自由了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830602
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830602,
					"content": "#小東西，{F#妳}{M#你}們是從地上來的嗎？雖然不知道{F#妳}{M#你}們因何緣由才來到這深水之中的囚籠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830603
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830603,
					"content": "我們才不是什麼小東西啦，只是因為大傢伙你太大了而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830604,
					"content": "#哈哈，好！不管怎麼說，既然{F#妳}{M#你}們解除了束縛我千年的枷鎖，那就算是有恩於我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830605
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830605,
					"content": "若有什麼用得上老夫的地方就儘管說吧，就當是謝禮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830606
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830606,
					"content": "#嘿嘿，我就知道你會是個通情達理的好傢伙！對了，我是派蒙，{M#他}{F#她}是{NICKNAME}，還有這邊的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830607,
					"content": "唔…我也不知道他的哪個名字你會比較熟悉啦…不過我們都叫他「嗚斯先生」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830608,
					"content": "啊，卡西奧多，是你，好久不見了。你竟然回來了，只可惜回來得太晚了一些…晚了千年！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830609
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830609,
					"content": "哦！看來大傢伙也跟嗚斯先生相熟呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830610,
					"content": "我跟可恥的叛徒無話可說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830611
					],
					"speakerTitle": "嗚斯先生"
				},
				{
					"id": 741830611,
					"content": "小心點說話，凡人！與你們這種自大的族裔不同，我們龍裔謹守承諾，絕無可能背叛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830612
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830612,
					"content": "這套說辭比水中的蜉蝣更不值一提，你的背叛是不爭的事實，也正是因為你的背叛，我們才輸掉了那場戰爭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830613
					],
					"speakerTitle": "嗚斯先生"
				},
				{
					"id": 741830613,
					"content": "要不是我們輸掉了那場戰爭…我們的國家…至尊也不會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830614
					],
					"speakerTitle": "嗚斯先生"
				},
				{
					"id": 741830614,
					"content": "你離開太久了，卡西奧多！真相並非你所想像的那樣。不過也難怪，原本就是隱秘的計畫，那些細節又怎會傳入你的耳中？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830615
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830615,
					"content": "…隱秘的計畫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830616
					],
					"speakerTitle": "嗚斯先生"
				},
				{
					"id": 741830616,
					"content": "讓老夫率領龍蜥的大軍進攻王城，正是雷穆斯隱秘計畫最後的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830617
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830617,
					"content": "而這一切都是為了拯救他的國家和子民，他是個有著偉大氣量的傢伙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830618,
						741830619
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830618,
					"content": "聽起來多少有些離譜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				},
				{
					"id": 741830620,
					"content": "這也太奇怪了吧？怎麼會有一個國家的王拜託別人進攻自己的國家啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830621,
					"content": "小東西，雷穆斯的想法又豈是妳我所能揣測的？無論如何，只要看到這個，卡西奧多，就算是你也能理解其中的含義吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830623
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830623,
					"content": "是金蜂…引導命途的金蜂只會聽從「樂章」的召喚，為什麼至尊會將「樂章」的力量交給野蠻的龍類？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830624
					],
					"speakerTitle": "嗚斯先生"
				},
				{
					"id": 741830624,
					"content": "因為他們有過約定…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830625
					]
				},
				{
					"id": 741830625,
					"content": "#哦？小傢伙知道的不少嘛！{F#妳}{M#你}是從哪裡知道這些的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830626
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830626,
					"content": "從散落在水裡的那些記憶中…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830627
					]
				},
				{
					"id": 741830627,
					"content": "#{F#妳}{M#你}說的不錯！我們之間的確有個約定，但老夫卻辜負了他，辜負了他高貴的犧牲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830628
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830628,
					"content": "老夫終究未能及時趕到金色的宮殿！於是肆虐的波濤吞噬了整座城市，而我的族裔也未能逃脫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830629
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830629,
					"content": "…怎麼會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830630
					],
					"speakerTitle": "嗚斯先生"
				},
				{
					"id": 741830630,
					"content": "哼，要說背叛，波愛修斯才是真正的叛徒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830631
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830631,
					"content": "若非那說謊的妖鬼、欺人的鼠輩用花言巧語將我們誆騙，作為古龍之後統率龍裔的親王，我又怎會輕易落敗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830632
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830632,
					"content": "那個妖鬼先是謊稱自己奉了雷穆斯的命令，已經下令軍團放棄抵抗。等到我們抵達此地時，他卻突然發難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830633
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830633,
					"content": "如今想來，他恐怕不知從何處早就竊知了雷穆斯的計畫，才能一步步引誘我，布下如此天羅地網吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830634
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830634,
					"content": "#就這樣，老夫的血肉化為了岩石，直到千年之後的今日，為{F#妳}{M#你}們所搭救。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830635
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830635,
					"content": "波愛修斯明知他的舉動會導致巨大的災難，可是他還是…難道是為了奪取「福波斯」的控制權，他才犯下如此罪惡嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830636
					],
					"speakerTitle": "嗚斯先生"
				},
				{
					"id": 741830636,
					"content": "感覺還沒有看到事情的全貌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830637
					]
				},
				{
					"id": 741830637,
					"content": "哇，說別人是叛徒的傢伙，結果自己才是徹頭徹尾的大叛徒嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830638
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830638,
					"content": "但是他為什麼要這樣做呢…難道只能去找沒禮貌的傢伙問清楚了嗎？總覺得他不會老實交代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830639
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830639,
					"content": "哦？那可恥又執迷不悟的妖鬼竟然還未消散嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830640
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830640,
					"content": "對呀！而且他還奪走了好多楓丹人的靈魂！我們就是為了解救這些人才一路來到這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830641
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830641,
					"content": "他說會在黃金的宮殿等我們…哦不對，他只說要等嗚斯先生，我們是不請自來的勇者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830699
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830699,
					"content": "不過他連門都沒有留，真是個沒禮貌的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830642
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830642,
					"content": "雅努斯之門嗎…哼，雖然施了些障眼法，也不過就是個故弄玄虛的石頭門而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830643
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830643,
					"content": "即便老夫已經失去了肉身，但要送小東西們過去還是輕而易舉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830648
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830648,
					"content": "小東西們看好了喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830644
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830644,
					"content": "哦哦哦！大傢伙還真是可靠呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830649
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830649,
					"content": "接下來只要把這些顯形的封印一一打碎就好了，準備好的話我們就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830645
					],
					"speakerTitle": "斯庫拉"
				},
				{
					"id": 741830645,
					"content": "那嗚斯先生，你準備好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830646
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830646,
					"content": "事到如今，也只有前進一途了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741830647
					],
					"speakerTitle": "嗚斯先生"
				},
				{
					"id": 741830647,
					"content": "#好，那{NICKNAME}呢？準備好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741830619,
					"content": "他也瘋了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741830620
					]
				}
			]
		},
