			"dialogs": [
				{
					"id": 3840201,
					"content": "哦，這下人都到齊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840202
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840202,
					"content": "這個地方，風景真漂亮啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3840203,
					"content": "和「命運的再會」這個主題很配吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840204
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3840204,
					"content": "那麼，該準備開始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840205
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3840205,
					"content": "嗯，不論結果如何，至少已經看到了轉機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840206
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3840206,
					"content": "這段時間，整座蒙德城都背負了太多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840207
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3840207,
					"content": "只是到頭來，解決問題的卻是旅行者和一個歌者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840208
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840208,
					"content": "呵。騎士團勉強算是有些苦勞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840209
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840209,
					"content": "好啦好啦。大家都站開一些——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840210
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3840210,
					"content": "塵世間最好的吟遊詩人，要開始撥動他的琴弦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		},
		{
			"id": 38404,
			"completionStepIds": [
				38405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
