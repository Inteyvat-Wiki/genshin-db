			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3840401,
					"content": "巴——溫迪閣下，請注意保護好自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840402
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3840402,
					"content": "哈哈…其實妳不是現在才猜出那個身分的吧，琴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840403
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3840403,
					"content": "不過，謝謝妳繼續用這個名字叫我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840404
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3840404,
					"content": "天空之琴怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840405
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840405,
					"content": "還能彈奏嗎？…或著，還能用龍的淚滴修復嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840406
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840406,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840407
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3840407,
					"content": "壞成這副樣子的話…可能就沒辦法了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840408,
						3840410
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3840408,
					"content": "不能就這樣放過深淵法師。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840409
					]
				},
				{
					"id": 3840409,
					"content": "沒錯，如果不能擊敗腐蝕的源頭，就無法減輕特瓦林所受的痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840413,
					"content": "那麼，我召集偵察騎士來追蹤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840414
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3840414,
					"content": "不必了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840415
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840415,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840416
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3840416,
					"content": "不久前我在四風守護的神廟遺蹟，親手斬殺過它的一隻同類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840417
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840417,
					"content": "咦？！是什麼時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3840418,
					"content": "想要追蹤那些怪物的話，可以借助我的情報網和手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840419
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840419,
					"content": "迪盧克…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3840420,
					"content": "雖然討厭騎士團，但會用自己的方式來守護蒙德呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3840421,
					"content": "小派蒙的語氣，突然變得溺愛了起來…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840422
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3840422,
					"content": "哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840423
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840423,
					"content": "總之，等我消息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840424
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840424,
					"content": "我要讓它們明白，不論深淵教團再怎麼無法無天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840425
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840425,
					"content": "在蒙德，有些事也是不可以做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840410,
					"content": "特瓦林的情況很危險…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3840411
					]
				},
				{
					"id": 3840411,
					"content": "但首先要讓罪魁禍首付出代價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840412
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3840412,
					"content": "如果不能擊敗腐蝕的源頭，就無法減輕特瓦林所受的痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3840413
					],
					"speakerTitle": "迪盧克"
				}
			]
		}
