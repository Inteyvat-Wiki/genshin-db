			},
			"dialogs": [
				{
					"id": 790750201,
					"content": "我…我要打掃打掃這裡，幫肖維涅找一個最適合曬太陽的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750202
					],
					"speakerTitle": "帕紐爾"
				},
				{
					"id": 790750202,
					"content": "#說服肖維涅的事就拜託{F#妳}{M#你}們了，兩位客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750203
					],
					"speakerTitle": "帕紐爾"
				},
				{
					"id": 790750203,
					"content": "要是我去見肖維涅，說不定他又會嫌我嘮叨，開始生悶氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕紐爾"
				}
			]
		},
