							918.467
						],
						"pointId": 311
					}
				]
			},
			"dialogs": [
				{
					"id": 790750301,
					"content": "呼…風總算停下來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750302,
						790750303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790750302,
					"content": "請聽我們說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750304
					]
				},
				{
					"id": 790750304,
					"content": "#好吧。我會聽{F#妳}{M#你}們說的，但在那之前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750305
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750305,
					"content": "看看兩位震驚的模樣，想必也是想要問我：「為什麼一盆花會說話？」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750306
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750306,
					"content": "或者是：「為什麼你會變成一盆花？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750307
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750307,
					"content": "有很多人問過你嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750308
					]
				},
				{
					"id": 790750308,
					"content": "在外面的時候有很多人會這樣問，回家之後…是沒有人問了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750309
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750309,
					"content": "你說的「外面」，是指這個世界外嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790750310,
					"content": "我聽說你是遠遊後才變成這樣的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750311
					]
				},
				{
					"id": 790750311,
					"content": "#{F#妳}{M#你}消息滿齊全的嘛。應該是帕紐爾告訴{F#妳}{M#你}的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750312
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750312,
					"content": "沒錯，我在遠遊的途中變成了這樣。呵呵，用羅澤爾那傢伙的話來說…這就是我自願做出的「改變」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750313
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750313,
					"content": "改變是可以理解啦…但你為什麼要變成一盆花呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750314,
						790750315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790750314,
					"content": "該不會是太喜歡植物了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750316
					]
				},
				{
					"id": 790750316,
					"content": "不是，我只是…想要找到自己的「位置」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750317
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750317,
					"content": "我在這個世界外見到了許多人，他們有的是廚師，有的是花匠，有的是教師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750318
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750318,
					"content": "幾乎每個人都找到了一個足以讓自己安心的「位置」，如此才得以在生活中立足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750319
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750319,
					"content": "而我呢？我只擅長遠遊，也從未想過要幫自己尋找一個穩定的「位置」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750320
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750320,
					"content": "這個「花盆」就是你的「位置」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750321
					]
				},
				{
					"id": 790750321,
					"content": "#沒錯，{F#妳}{M#你}理解得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750322
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750322,
					"content": "做一棵在花盆裡的花，就可以讓我時刻擁有一個讓自己安心的「位置」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750323
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750323,
					"content": "但是…唉，我既然有了一個花盆，也有了屬於我的「位置」，那我又為什麼要出去遠遊呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750324
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750324,
					"content": "但我又是一個冒險客，沒了遠遊，我又能做什麼有價值的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750325
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750325,
					"content": "我不明白。越是見識了外面世界的事物，我就越是不明白…「位置」和「遠遊」——究竟誰更重要？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750326
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750326,
					"content": "我越是思考，就越是頭痛…帕紐爾和我聊天時，我也總是答非所問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750327
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750327,
					"content": "我害怕誤導帕紐爾，如果他原本就喜愛遠遊，看見我這副模樣後，會不會討厭遠遊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750328
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750328,
					"content": "但帕紐爾是我的朋友，永遠都是。我必須對他誠實，他問我的所有問題，我都回答一遍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750329
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750329,
					"content": "包括…我之所以會成為花，是想要一個能讓自己安心的「位置」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750330
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750330,
					"content": "或許是我的回答讓帕紐爾難過了…又或者，是他不喜歡我的這副模樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750331
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750331,
					"content": "我們逐漸分開，而我這麼一盆花，又沒辦法自己上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750332
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750332,
					"content": "但這樣也好，帕紐爾想必也不想見我，他鐵定在生我的氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750333
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750333,
					"content": "喔…原來是這樣，你們兩個都分別認為「對方在生自己的氣」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790750334,
					"content": "所以才不願意見對方。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750335
					]
				},
				{
					"id": 790750335,
					"content": "#什麼？{F#妳}{M#你}、{F#妳}{M#你}是說，帕紐爾並沒有生我的氣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750336,
						790750337
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750336,
					"content": "你們兩個的想法一模一樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750338,
					"content": "將帕紐爾的想法全部告訴了肖維涅…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						790750339
					]
				},
				{
					"id": 790750339,
					"content": "天啊，我怎會這樣想…我從來不願看到他難過，哪怕他的嘴角垂下去一點，我的心也是好像要碎掉一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750340
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750340,
					"content": "#兩位客人！請{F#妳}{M#你}們將我帶上去，求你們，我必須快點見到帕紐爾！一分一秒也等不了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790750341
					],
					"speakerTitle": "肖維涅"
				},
				{
					"id": 790750341,
					"content": "就等你這句話呢，老兄。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750342
					]
				},
				{
					"id": 790750342,
					"content": "#嘿嘿，就等你這句話呢！我們出發吧！{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790750337,
					"content": "他反而是以為你在生他的氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790750338
					]
				},
				{
					"id": 790750315,
					"content": "你夢想成為一個植物學家？",
