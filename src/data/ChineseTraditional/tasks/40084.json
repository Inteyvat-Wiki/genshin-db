			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萊依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840801,
					"content": "我有點緊張，但也很期待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840802
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400840802,
					"content": "#請{F#妳}{M#你}們不要太拘束，「轉轉悠悠獸」帶領的隊伍經歷過不少考驗，實力也是不錯的！讓{F#妳}{M#你}們的夥伴拿出全力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840803
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400840803,
					"content": "那就接招吧，萊依拉，還有「轉轉悠悠獸」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
