					"八重神子",
					"海妮耶",
					"萊依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841001,
					"content": "咦…難道比賽已經結束了？這凝重的氣氛…是神子贏了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841002,
					"content": "#{F#妳}{M#你}們的比賽也完滿落幕了？花費了這麼長的時間，看來是一場旗鼓相當的對決呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841003
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841003,
					"content": "嘿嘿，看神子這輕鬆的口吻，一定贏得很輕鬆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841004,
					"content": "啊呀呀，我們這邊的比賽確實沒有任何懸念呢，我和「百雷遮羅」只用短短幾招就——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841005
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841005,
					"content": "被海妮耶打敗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841006
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841006,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841007,
					"content": "妳那散漫的態度…是在戲弄我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841008
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841008,
					"content": "呵呵，我可不敢輕視妳，海妮耶小姐。畢竟妳的意志格外堅定，甚至想要毀滅一整個物種，我怎麼敢對妳隨便開玩笑呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841009
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841009,
					"content": "不過，要是妳沿著這條路繼續走下去，發現沿途所見的景象和想像的完全不同，妳的執著又會轉變成什麼？我很期待喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841010
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841010,
					"content": "不勞妳操心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841011
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841011,
					"content": "這就逃走了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841012
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841012,
					"content": "輸掉比賽的明明是八重小姐，反而好像是海妮耶受到的打擊更大？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841013
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400841013,
					"content": "事態變得越發有趣了，比賽剛開始，「百雷遮羅」就傷到了「火一」，海妮耶明顯有些慌亂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841014
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841014,
					"content": "我只不過是點破她還在自我欺騙的這個事實，她的心理防線就快要崩潰了，出人意料地脆弱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841015,
						400841016
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841015,
					"content": "自我欺騙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841017
					]
				},
				{
					"id": 400841017,
					"content": "莫非，海妮耶並不像她說的那樣絕情？她其實是關心「火一」的，只不過在神子面前暴露了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841018,
					"content": "答對啦，現在正是深入她內心世界的好時機。能改變她的，就只有小傢伙們啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841019
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841019,
					"content": "但現在海妮耶已經走遠了，我們要去哪裡找她呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841020,
					"content": "這種時候，她想必在懷疑，一直以來無比決絕的自己究竟受到了什麼影響，居然有些動搖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841021
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841021,
					"content": "#答案就在{F#妳}{M#你}們三位身上。{F#妳}{M#你}們很清楚，她會去什麼地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841022,
						400841023
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841022,
					"content": "我、派蒙和萊依拉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841024
					]
				},
				{
					"id": 400841024,
					"content": "#我遇見{NICKNAME}和派蒙的那個地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841025
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400841025,
					"content": "仔細想想，那天萊依拉提到要將蕈獸帶回日常的生活，當成重要的同伴，海妮耶的臉色就變了…萊依拉的感覺真的沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841026
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841026,
					"content": "我們快點追過去，和海妮耶好好談談吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841027
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841027,
					"content": "小萊依拉，妳就留下來吧？妳想幫助海妮耶的心情我理解，不過她並不是妳擅長應付的類型喔。這次就先交給小傢伙們吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841028
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841028,
					"content": "也是呢…萬一我又不小心說錯話，刺激了海妮耶，那反而更糟糕。而且大家的動作都好快，我追到一半就會累倒吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841029
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400841029,
					"content": "怎麼還不動身，小傢伙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841030,
						400841031
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841030,
					"content": "這裡是之前找到的東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841032
					]
				},
				{
					"id": 400841032,
					"content": "啊呀，收穫比我想像得還要豐富呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841033
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841033,
					"content": "#那我也為{F#妳}{M#你}加上「好運」的祝福吧，下次見面的時候，我再和{F#妳}{M#你}聊聊我的見解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400841031,
					"content": "請妳過目，稍作分析。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841032
					]
				},
				{
					"id": 400841023,
					"content": "難道說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841024
					]
				},
				{
					"id": 400841016,
					"content": "心理防線？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841017
					]
				}
			]
		},
		{
			"id": 4008412,
			"completionStepIds": [
				4008411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008411",
							"2"
						],
						"stepId": 4008411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841201,
					"content": "#嗯？{F#妳}{M#你}們是怎麼找到這裡的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841202
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841202,
					"content": "我們是追著「火一」的痕跡找過來的，看見妳剛才的狀態，我們很不安！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841203,
					"content": "等等…妳這是在安慰「火一」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841204,
					"content": "還真是諷刺…如果「火一」不是蕈獸，而是普通的動物，我大概會為此感到高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841205
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841205,
					"content": "下次見面就是決賽了，有什麼想說的，就等到打敗我以後再囉唆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841206,
						400841207
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841206,
					"content": "我們想瞭解妳的想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841208
					]
				},
				{
					"id": 400841208,
					"content": "#{F#妳}{M#你}們的說辭和那個狐狸女人預測的完全一樣…{F#妳}{M#你}們確實很單純、很善良，把一些事情想得太過美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841209
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841209,
					"content": "#只憑我簡單的轉述，是不能讓{F#妳}{M#你}們理解的。看看這個吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841210
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841210,
					"content": "這是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841212,
					"content": "這是我的祖輩們的記事簿，當年，他們在雨林中遭到了蕈獸的攻擊，許多人身受重傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841213
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841213,
					"content": "這件事在當時不值一提，甚至沒有被任何文獻記載。但我的家族成員自我小時候起，就反覆把它唸給我聽，教導我蕈獸的威脅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841214
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841214,
					"content": "原來以前發生過這樣的事，難怪妳這麼仇視蕈獸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841215,
						400841216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841215,
					"content": "我們的確不清楚妳的身世。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841217
					]
				},
				{
					"id": 400841217,
					"content": "確實，如果妳有這樣的過去，應該更能理解這場比賽的可取之處，畢竟「意智寶珠」能讓人們和蕈獸和諧相處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841218,
					"content": "#事情沒有那麼簡單，{F#妳}{M#你}們認為「意智寶珠」能讓蕈獸變得溫順。以前也有學者來到村子裡，用相似的道具做過實驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841219
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841219,
					"content": "但他們都失敗了，丟盔棄甲逃走了。如今的「意智寶珠」也只能暫時壓制蕈獸的凶惡本性，脫離了這種道具，蕈獸依然萬分危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841220
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841220,
					"content": "而且，寶珠的「理智增幅」會讓蕈獸的元素力異常活躍，影響周圍的環境，身體不夠強健的人使用寶珠後，很快就會出現不適症狀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841221
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841221,
					"content": "元素力的異常…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841222
					]
				},
				{
					"id": 400841222,
					"content": "難道說萊依拉最近老是咳嗽，就是因為「意智寶珠」的這個缺點？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841223,
					"content": "#不用我多說，{F#妳}{M#你}們應該也明白，考特里亞是個學術瘋子，他只想著擴大自己的影響力，推廣馴獸活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841224
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841224,
					"content": "那個埃爾欣根也是個見風使舵的傢伙，看中了考特里亞的研究成果，用雄厚的資金宣傳這場比賽，來使人們對蕈獸放下戒心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841225
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841225,
					"content": "不管怎麼樣，我不相信他們，不相信凶惡的蕈獸可以和人們共處。但作為一個小小的退役傭兵，我的聲音無法被任何人聽見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841226
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841226,
					"content": "我只能在他們的規則裡贏得勝利，爭取我想要的結局，不讓他們得逞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841227
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841227,
					"content": "#原本我還有一絲希望，期待{F#妳}{M#你}們能幫我，結果是我太天真了。不管{F#妳}{M#你}們怎麼想、怎麼看待我，我都會打敗{F#妳}{M#你}們，從{F#妳}{M#你}們身上踏過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841228
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841228,
					"content": "海妮耶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841229
					]
				},
				{
					"id": 400841229,
					"content": "#這本筆記就像是我的過去，{F#妳}{M#你}們想要怎麼處置它都無所謂了。反正等到決賽那天，我會宣佈處死所有蕈獸…包括「火一」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841230
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841230,
					"content": "和我的過去永別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400841216,
					"content": "但如今的情況不同了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841217
					]
				},
				{
					"id": 400841207,
					"content": "我們想消除妳的偏見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841208
					]
				}
			]
		},
		{
			"id": 4008413,
