			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鐵骨雙刀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840401,
					"content": "#是{F#妳}{M#你}們，見識淺薄的鼠輩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840402
					],
					"speakerTitle": "鐵骨雙刀"
				},
				{
					"id": 400840402,
					"content": "好大的口氣！憑什麼這麼說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840403,
					"content": "對蕈獸投入多餘的情感，何其軟弱、何其可笑！這有悖於最強的馴獸師，海妮耶大人的理念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840404
					],
					"speakerTitle": "鐵骨雙刀"
				},
				{
					"id": 400840404,
					"content": "最強的馴獸師…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840405,
					"content": "我們會糾正海妮耶的想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840406
					]
				},
				{
					"id": 400840406,
					"content": "#別妄想了！軟弱之人沒有資格和海妮耶大人對陣，{F#妳}{M#你}們會止步於此！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鐵骨雙刀"
				}
			]
		},
		{
			"id": 4008406,
			"completionStepIds": [
				4008406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008406",
							"2"
						],
						"stepId": 4008406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萊依拉",
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400840601,
					"content": "#{NICKNAME}、派蒙，我成功晉級了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840602
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400840602,
					"content": "太好了，萊依拉！妳順利完成了參賽的目標！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840603,
					"content": "可喜可賀！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840604
					]
				},
				{
					"id": 400840604,
					"content": "#我聽說{F#妳}{M#你}們打敗了那個一路過關斬將的「鐵骨雙刀」…為什麼我感覺，{F#妳}{M#你}們好像有點不開心？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840605
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400840605,
					"content": "怎麼說呢…這個對手不太友善，說了很多奇怪的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840606,
					"content": "向萊依拉講述了對決中的細節…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400840607
					]
				},
				{
					"id": 400840607,
					"content": "原來是這樣…總覺得這樣的馴獸師有點…悲哀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840608
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400840608,
					"content": "悲哀？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840609
					]
				},
				{
					"id": 400840609,
					"content": "嗯，那個人明明不瞭解海妮耶，只憑一個朦朧的印象去揣測她，甚至效仿她。海妮耶要是知道了這種事，大概也會苦惱的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840610
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400840610,
					"content": "而且，那個馴獸師對原本可以成為好朋友的蘑菇夥伴這麼嚴苛，不止自己受到了損失，還會影響其他選手的心態…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840611
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400840611,
					"content": "對啊，我覺得萊依拉的心態就很好！大家都和妳一樣的話，比賽的氣氛也會更和諧、更歡樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840612,
					"content": "只是因為我的目標不高吧…只要能把「轉轉悠悠獸」帶回去一起生活，我就很滿足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840613
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400840613,
					"content": "接下來就輪到我們較量了。我們要友好、開心地比試一場，輸贏不重要，當成朋友間的切磋就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840614
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400840614,
					"content": "一言為定！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400840615
					]
				},
				{
					"id": 400840615,
					"content": "好喔！讓我們看看「轉轉悠悠獸」和「咚咚小圓帽」誰更厲害！贏了的一邊要請輸了的吃飯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840616,
					"content": "#看{F#妳}{M#你}們開開心心地作出約定，難道我錯過了什麼關鍵的討論嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840617
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400840617,
					"content": "神子，妳總算出現了！上次妳不聲不響就走了，我們還有些線索…呃咳，還有些事想要和妳商量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840618,
					"content": "我也很苦惱呢，我抱著隨便玩玩的想法參賽，結果反而進入了準決賽，只能擠出時間陪著左右加他們取材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840619
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400840619,
					"content": "#{F#妳}{M#你}們兩個倒是不必擔心，想必會進行一場非常和諧的比賽。我倒是要稍微認真一點了，畢竟對手是那個無比偏執的傢伙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840620
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400840620,
					"content": "確實，沒想到情況會變成這樣，八重小姐居然要和海妮耶對陣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840621
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400840621,
					"content": "樂觀一點，說不定神子就幫我們把海妮耶打敗了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400840622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400840622,
					"content": "雖然那樣就不能親自說服海妮耶了，但我還是不希望神子輸掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4008408,
			"completionStepIds": [
				4008408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
