			"trigger": {
				"objectNames": [
					"萊依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841301,
					"content": "結果還是輸了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841302
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400841302,
					"content": "不過你和同伴們發揮得比平常還好，「轉轉悠悠獸」！我很盡興，很開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841303
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400841303,
					"content": "#謝謝{F#妳}{M#你}們！我和「轉轉悠悠獸」的比賽完美落幕了，如果被{F#妳}{M#你}以外的人打敗，也許我們還會有點不服氣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841304
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400841304,
					"content": "萊依拉和「轉轉悠悠獸」也很強喔，我們差一點就被你們壓倒了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841305,
					"content": "不在乎勝負，只是盡情發揮蕈獸們的本領，好好比拼一場…這種感覺真的很暢快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841306,
					"content": "也許這才是比賽該有的樣子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841307
					]
				},
				{
					"id": 400841307,
					"content": "要是每場比賽都像這樣，不用在意其他因素就好了。但是現在神子還在和海妮耶對決！我超級不安！我們趕緊去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4008414,
			"completionStepIds": [
				4008414
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008414",
							"2"
						],
						"stepId": 4008414,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鐵骨雙刀"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841401,
					"content": "不可能！這絕無可能…難道是我對蕈獸的訓練還不夠嚴格嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841402
					],
					"speakerTitle": "鐵骨雙刀"
				},
				{
					"id": 400841402,
					"content": "唔…雖然打敗了他，但總感覺高興不起來呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4008415,
			"completionStepIds": [
				4008415
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008415",
							"2"
						],
						"stepId": 4008415,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400841501,
					"content": "結果還是失敗了，只有在賽場上打敗海妮耶這一個選擇了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841502,
						400841503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841502,
					"content": "至少聽到了她的真實想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841504
					]
				},
				{
					"id": 400841504,
					"content": "海妮耶好像說過，以前也有學者嘗試遏制蕈獸造成的災害？這本筆記還有不少內容，我們再好好讀一讀吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841506,
					"content": "這是海妮耶的祖輩收集的…學者們的研究紀錄？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841507,
					"content": "唔，這部分的內容好複雜，字跡潦草，還有很多術語，怎麼想都看不懂吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841508,
					"content": "不過，有很多眼熟的詞語耶…好像在之前多莉給我們的文件上見過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841509,
						400841510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841509,
					"content": "筆記和文件有關聯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841511
					]
				},
				{
					"id": 400841511,
					"content": "嗯，我們仔細一點，對照著文件殘卷，試著解讀筆記的內容吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841512,
					"content": "捕獲裝置？枯化藥劑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841513,
						400841514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841513,
					"content": "捕獲裝置使蕈獸溫和。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841515
					]
				},
				{
					"id": 400841515,
					"content": "原來是這樣…當年襲擊海妮耶祖輩的蕈獸，是被藥劑影響後才失控的…學者們造出捕獲裝置，是為了抓住那些發狂的蕈獸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841516,
					"content": "而且，現在的「花花瓊脂」就是「枯化藥劑」的改進版，「意智寶珠」也根本不是考特里亞的發明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841517,
					"content": "考特里亞只不過是在捕獲裝置的基礎上幫自己弄了兩個新包裝，大騙子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841518,
						400841519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841518,
					"content": "大騙子！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841520
					]
				},
				{
					"id": 400841520,
					"content": "但考特里亞這麼想推廣「意智寶珠」，到底有什麼目的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841521,
						400841522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841521,
					"content": "也許是想完成前人的試驗…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841523
					]
				},
				{
					"id": 400841523,
					"content": "那我們必須早點警告埃爾欣根，不能再資助考特里亞那傢伙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841524,
					"content": "至於海妮耶…當時襲擊她祖輩的蕈獸全都受到了刺激，這件事她完全不知情，難怪會覺得蕈獸不可饒恕呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841525,
					"content": "別擔心，「咚咚小圓帽」，我相信你不會因為「花花瓊脂」變得暴躁！畢竟關閉了「意智寶珠」後，你也是個好孩子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841526,
					"content": "啊呀，你好像完全能聽懂我的話了？越來越聰明了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841527,
						400841528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841527,
					"content": "等等，派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841529
					]
				},
				{
					"id": 400841529,
					"content": "咦？什麼時候的事！完全沒有注意到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841530,
					"content": "也就是說，現在的「咚咚小圓帽」，正在憑自己本來的心性和我們共處嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841531,
						400841532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841531,
					"content": "共處的經歷影響了它。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841533
					]
				},
				{
					"id": 400841533,
					"content": "所以說嘛！我絕不同意海妮耶關於蕈獸還會失控的推測！蕈獸裡也有好蕈獸，就像「咚咚小圓帽」一樣通人性！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841534,
					"content": "可是有一點，海妮耶說得有道理呢…「意智寶珠」不是萬能的，只要那個缺點還在，蕈獸夥伴就不能一直待在普通人身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841535
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841535,
					"content": "我還以為可以和「咚咚小圓帽」一起繼續旅行下去呢…就不能想想辦法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841536,
						400841537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841536,
					"content": "先和夥伴們保持適當的距離…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841538
					]
				},
				{
					"id": 400841538,
					"content": "雖然有點可惜，但目前看來，也只能這樣了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841539,
					"content": "現在距離決賽還有一段時間，我們要向教令院報告考特里亞的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841540,
						400841541
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841540,
					"content": "我們不清楚考特里亞的勢力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841542
					]
				},
				{
					"id": 400841542,
					"content": "確實呢…考特里亞能幹出這種大事，絕對謀劃了很久。如果我們打算戳穿他的事被他提前知道了，他應該也會提防我們的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400841543
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841543,
					"content": "不管怎麼樣，決賽的那天，我們一定要拿出全力！先打敗海妮耶，讓她別再固執，然後說服埃爾欣根，一起揭露考特里亞的陰謀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400841541,
					"content": "不能貿然打草驚蛇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841542
					]
				},
				{
					"id": 400841537,
					"content": "一邊尋找改進寶珠的方法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841538
					]
				},
				{
					"id": 400841532,
					"content": "我們正在達成默契。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841533
					]
				},
				{
					"id": 400841528,
					"content": "「意智寶珠」並沒有運轉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841529
					]
				},
				{
					"id": 400841522,
					"content": "以此證明自己的能力…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841523
					]
				},
				{
					"id": 400841519,
					"content": "好啦，其實也不太意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841520
					]
				},
				{
					"id": 400841514,
					"content": "枯化藥劑使蕈獸暴躁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841515
					]
				},
				{
					"id": 400841510,
					"content": "我們結合兩邊的資訊吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841511
					]
				},
				{
					"id": 400841503,
					"content": "至少拿到了她的記事簿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400841504
					]
				}
			]
		}
	]
}