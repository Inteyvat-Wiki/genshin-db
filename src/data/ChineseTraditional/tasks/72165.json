				"points": []
			},
			"dialogs": [
				{
					"id": 721650201,
					"content": "#{F#妳}{M#你}們好呀，年輕人。今天有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650202
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650202,
					"content": "請為我占卜一下吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650203
					]
				},
				{
					"id": 721650203,
					"content": "哼哼，今天又有怎樣的運勢呢~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650204,
					"content": "嗯…根據「靈草」的預言…會有厄運啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650205
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650205,
					"content": "兩位在海祇島的南方的洞窟，賊匪的巢穴，會遭遇不期而至的厄運…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650206
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650206,
					"content": "欸，是厄運！那我們避開那種地方好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650207,
					"content": "呵呵，但是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650208
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650208,
					"content": "若克服厄運的話，說不定會有意外的收穫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650209
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650209,
					"content": "收獲…？是寶藏嗎？是寶藏嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650210,
					"content": "我沒說是喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650211
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650211,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650212,
					"content": "但我也沒說不是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650213
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650213,
					"content": "哇！這個老婆婆怎麼這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
