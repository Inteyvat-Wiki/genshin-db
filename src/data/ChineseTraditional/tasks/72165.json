						721650505
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650505,
					"content": "#不過沒關係，還能再為{F#妳}{M#你}們占卜一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650506
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650506,
					"content": "唔…從「靈草」明滅來看…是好運哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650507
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650507,
					"content": "東北方的殘跡，海上孑立的古城，哀哀佇留的舊日之靈會引導你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650508
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650508,
					"content": "但是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650509
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650509,
					"content": "#{F#妳}{M#你}要為她打開一道大門，令她返回永久美夢的睡巢…才能獲得命定的獎賞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650510
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650510,
					"content": "唔…什麼古城，什麼鳥巢的…好亂呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650511,
					"content": "呵呵，沒關係，我一直在這裡的。腦子轉不過來的話可以隨時找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650512
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650512,
					"content": "哇啊，她是在說我笨嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
