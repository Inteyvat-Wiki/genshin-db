			"trigger": {
				"objectNames": [
					"小卷",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721650101,
					"content": "#{F#妳}{M#你}們回來了，請問有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650102
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650102,
					"content": "請為我占卜一下吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721650103
					]
				},
				{
					"id": 721650103,
					"content": "#我也想知道{NICKNAME}今天會有怎樣的好運氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650104,
					"content": "嗯…從「靈草」葉片的紋理來看…是好運喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650105
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650105,
					"content": "兩位會在海祇島的最高處，供奉神的舊地，與好運相遇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650106
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650106,
					"content": "唔…怎麼我看不出來這麼多訊息呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721650107,
					"content": "呵呵，這是當地老人的智慧喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721650108
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721650108,
					"content": "這種敷衍的回答…好可疑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7216502,
			"completionStepIds": [
				7216503
			],
