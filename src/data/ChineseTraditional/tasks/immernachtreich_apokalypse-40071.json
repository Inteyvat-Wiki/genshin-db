			"dialogs": [
				{
					"id": 400711201,
					"content": "英雄們，再多話語也無法訴說我此刻的激動。感謝你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711202
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400711202,
					"content": "請記住，這是打開大門的口令：「令我的子民自由，不囿於古老法則。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊昂"
				}
			]
		},
		{
			"id": 4007113,
			"completionStepIds": [
				4007113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
