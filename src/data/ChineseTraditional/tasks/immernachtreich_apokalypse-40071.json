				"points": []
			},
			"dialogs": [
				{
					"id": 400711401,
					"content": "欸？怎麼換地方了，但又沒回到海灘上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711402
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711402,
					"content": "這裡似乎是蒙德的住宅呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711403,
					"content": "貴安，尊貴的「斷罪之皇后」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711404
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400711404,
					"content": "小艾咪親愛的，媽媽做了煎肉排和漁人吐司，快來趁熱吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711405
					],
					"speakerTitle": "菲謝爾的母親"
				},
				{
					"id": 400711405,
					"content": "咳咳！母后…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711406
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400711406,
					"content": "噢噢，瞧我，都給忘了。咳！斷罪之皇女，汝可知此刻正是午餐時分？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711407
					],
					"speakerTitle": "菲謝爾的母親"
				},
				{
					"id": 400711407,
					"content": "當然了母后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711408
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400711408,
					"content": "噢——！窗外景色如此迷人，皇女、皇后，二位可否賞光與我這「斷罪之皇帝」一同外出野餐？看看風景，享受上天恩賜的美味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711409
					],
					"speakerTitle": "菲謝爾的父親"
				},
				{
					"id": 400711409,
					"content": "是的，非常願意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711410
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400711410,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711411
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711412
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400711412,
					"content": "呃…那個，大家是不是都有話想說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711413
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711413,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711414
					]
				},
				{
					"id": 400711414,
					"content": "我直接問了，小艾咪…是菲謝爾的真名？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711415
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711415,
					"content": "應該是吧。剛才那兩個聲音，好像是她的爸爸媽媽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711416,
					"content": "…看我幹什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711417
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711417,
					"content": "可能有點冒昧，但…妳真的姓梅姬斯圖斯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711418
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400711418,
					"content": "哼，你在小看我？本占星術士的全名是：阿斯托洛吉斯·莫娜·梅姬斯圖斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711419
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711419,
					"content": "…對不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711420
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400711420,
					"content": "好長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711421
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711421,
					"content": "只有天才能擁有這個名字哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711422
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711422,
					"content": "總覺得沒有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711423,
					"content": "剛才那些，你們感覺如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711424
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711424,
					"content": "我確定了一件事，「闔上書本」也是一種引起幻境變化的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711425
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400711425,
					"content": "菲謝爾的家人居然肯配合她，厲害啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711426
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711426,
					"content": "但也不會一直如此。聽聲音，這是她小時候的回憶吧？長大可就不是這樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711427
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711427,
					"content": "莫娜知道很多嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711428,
					"content": "身為朋友知道這些很正常吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711429
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711429,
					"content": "…菲謝爾現在，會在哪裡呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711430
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711430,
					"content": "剛才那個聲音說她要出門，我們不如也出去看看，應該會有線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		},
