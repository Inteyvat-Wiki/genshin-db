						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萊昂",
					"莫娜",
					"辛焱",
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711001,
					"content": "天哪，請救救我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711002
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400711002,
					"content": "喂，這不是個雕像嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711003,
					"content": "請別這麼說！我是幽夜淨土的騎士，萊昂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711004
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400711004,
					"content": "騎士？完全看不出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711005,
					"content": "看不出嗎？好吧。就算如此，也請各位不要怪罪為夜鴉騎士們設計配發盔甲的奧茲華爾多大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711006
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400711006,
					"content": "奧茲華爾多大人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711007
					]
				},
				{
					"id": 400711007,
					"content": "#{NICKNAME}應該聽說過吧？奧茲的全名是奧茲華爾多·赫芙那梵茵斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711008,
						400711009
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711008,
					"content": "我知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				},
				{
					"id": 400711010,
					"content": "那還是梅姬斯圖斯好唸一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711011
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711011,
					"content": "嗯，我也這麼想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711012
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400711012,
					"content": "啊哈哈，大家都這麼說呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711013
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711013,
					"content": "各位朋友，打擾你們愉快的聊天時間實在非我所願，只是，你們應該還不知道前面的大門上了鎖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711014
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400711014,
					"content": "確實不知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711015
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711015,
					"content": "但願好心的你們能動動手指將我救上去，作為報答，我非常願意將打開大門的方法教給各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711016
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400711016,
					"content": "你都這麼說了…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711009,
					"content": "我現在知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711010
					]
				}
			]
		},
