				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400711301,
					"content": "前面好像沒有路了，只有一本書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711302,
					"content": "我們剛才聽到的，應該就是書裡的故事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711303
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711303,
					"content": "所以，書名中的聖國，指的就是幽夜淨土。這本書是在用國民的口吻歌頌皇女殿下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711304
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711304,
					"content": "也算是自傳的一種吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400711305
					]
				},
				{
					"id": 400711305,
					"content": "書已經翻到最後一頁了，但它們的故事聽起來還沒結束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711306
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400711306,
					"content": "後續呢？我想聽後續！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711307,
					"content": "那就得繼續探索了吧。比起這個，看完的書…還是先闔上比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		},
