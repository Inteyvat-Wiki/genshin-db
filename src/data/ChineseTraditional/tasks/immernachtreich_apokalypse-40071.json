			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱",
					"楓原萬葉",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710201,
					"content": "醒了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710202,
					"content": "唔…又是早上了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710203
					]
				},
				{
					"id": 400710203,
					"content": "怎麼樣？出現什麼了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710204
					]
				},
				{
					"id": 400710204,
					"content": "#說出來{F#妳}{M#你}可能不信，什麼事都沒發生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710205,
					"content": "#{F#妳}{M#你}醒啦？那我們直接說結論，四周都找過了，沒有可疑的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710206
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400710206,
					"content": "按照之前兩處幻境的規律，應該會有一件承擔著「入口」職責的物品才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710207
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400710207,
					"content": "這就怪了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400710208
					]
				},
				{
					"id": 400710208,
					"content": "會不會是沒到時候？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710209
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710209,
					"content": "妳的意思是，再等等？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710210
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400710210,
					"content": "嗯。而且，菲謝爾不在這裡。我想，她很可能比我們更急著找到入口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710211
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710211,
					"content": "我們等等吧。給幻境…不，給菲謝爾一點時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710212
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710212,
					"content": "大家贊同莫娜的說法，聚在一起喝茶休息。之後，又分為兩隊四處搜索。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710213
					]
				},
				{
					"id": 400710213,
					"content": "終於，在白白走了好幾個來回後，海灘上突然多出了一些東西。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400710214
					]
				},
				{
					"id": 400710214,
					"content": "有什麼東西掉在沙灘上了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710215,
					"content": "是一本書？旁邊還有隻…呃…烏鴉的雕像？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710216
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400710216,
					"content": "這尊雕像長得好像奧茲哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710217,
					"content": "一起出現是什麼意思？這本書，是它送來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710218
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710218,
					"content": "這是什麼？日記？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710219
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400710219,
					"content": "我看看…《聖國的詠唱》？我都沒見過叫這個名字的書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710220
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710220,
					"content": "看封面，難道是…菲謝爾自己寫的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710221,
					"content": "這麼一說確實像她的風格。《聖國的詠唱》，書名不錯，我喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710222
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400710222,
					"content": "這本書的名字，有種神聖感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710223
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400710223,
					"content": "怎麼樣？要碰碰它嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710224,
					"content": "…還沒回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710225
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710225,
					"content": "算了，我們先去看看吧。如果菲謝爾見到這本書，應該會來找我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710226
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710226,
					"content": "我同意哦！就像被人偷看了日記一樣，肯定要進來阻止我們的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4007103,
			"completionStepIds": [
				4007103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
