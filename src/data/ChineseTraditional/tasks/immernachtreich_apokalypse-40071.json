				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旁白",
					"莫娜",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400710301,
					"content": "「如今的國民無從憶起，但學者知道，遠在早於聖徒時代約六百年的混沌期間，皇女殿下便已君臨世間。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710302
					],
					"speakerTitle": "旁白"
				},
				{
					"id": 400710302,
					"content": "不會吧？旁白？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710303
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710303,
					"content": "不愧是書裡的世界，竟然還有旁白給我們講故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710304
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400710304,
					"content": "路斷了，走不過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710305,
					"content": "那邊有個裝置，像是等著我們靠近一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710306
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710306,
					"content": "我總覺得…這裡的一切是不是太過刻意了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710307,
					"content": "是聖國嘛。體諒一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710308
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400710308,
					"content": "也是，這麼明顯，完全就是希望被人發現嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400710309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400710309,
					"content": "不愧是菲謝爾，在這種地方坦率得可怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4007110,
			"completionStepIds": [
				4007110
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
