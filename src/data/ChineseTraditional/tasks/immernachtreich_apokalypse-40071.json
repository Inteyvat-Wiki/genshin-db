					"nextDialogs": [
						400711502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711502,
					"content": "不對不對，怎麼回來了呀！故事還沒聽完呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711503,
					"content": "這種感覺，糟透了，就像買到假冒偽劣占星教學，或是晚餐吃到一半發現忘帶錢包…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711504
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711504,
					"content": "啊——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711505,
					"content": "啊——！好難受啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711506
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711506,
					"content": "她倆很受打擊的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711507
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711507,
					"content": "實不相瞞，我也不喜歡看被腰斬的書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711508
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400711508,
					"content": "哈哈，誰會喜歡啊。各位，我們再進一次幻境吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711509
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711509,
					"content": "好主意！那我們現在就出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711510,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711511
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711511,
					"content": "沒反應，位置也沒變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711512
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400711512,
					"content": "奇怪，剛才還能進的，現在就把我們拒之門外了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711513
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400711513,
					"content": "為什麼！存心不讓人看完這本書嗎！太壞了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711514
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711514,
					"content": "唔…是因為，這本書已經「讀到最後」了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711515
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400711515,
					"content": "離開幻境前，我們見到的這本書被翻到了最後一頁，我覺得，《聖國的詠唱》可能不止一本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711516
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400711516,
					"content": "好像什麼俗套輕小說的銷售招數一樣…欲知後事如何，請購買下卷，什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711517,
					"content": "可惡，我一定要看到結局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711518
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711518,
					"content": "噢，噢是的結局，大家都愛看書的結局呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711519
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400711519,
					"content": "嗯？誰在那邊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711520
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711520,
					"content": "噢，噢天哪，她看見我了，立正立正。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711521
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400711521,
					"content": "你是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711522
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711522,
					"content": "我是「渴望被問路的阿諾德」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711523
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400711523,
					"content": "名字目的性太強了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400711524,
					"content": "阿諾德，我問你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711525
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711525,
					"content": "是「渴望被問路的阿諾德」，不是阿諾德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711526
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400711526,
					"content": "渴望被問路的阿諾德，我問你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711527
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711527,
					"content": "是的女士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711528
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400711528,
					"content": "《聖國的詠唱》有後續嗎？在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711529
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711529,
					"content": "噢，噢您可真是問對人了。《聖國的詠唱》是幽夜淨土的聖典，共有三卷，其餘兩卷分別藏在王城的兩處高地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711530
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400711530,
					"content": "如果你們想找第二卷，得去高塔頂樓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711531
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400711531,
					"content": "高塔，是那邊那座嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711532
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711532,
					"content": "沒錯，那就是存放著聖典的塔樓。有條密道能讓各位迅速抵達那裡，只要你們在那邊的山洞裡仔細找找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711533
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400711533,
					"content": "好，謝謝你阿諾德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711534
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711534,
					"content": "是「渴望被問路的阿諾德」，不是阿諾德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711535
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400711535,
					"content": "美麗的女士，您沒有其他話要問我了嗎？有沒有女朋友、每月收入情況什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711536
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400711536,
					"content": "沒有，再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711537
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711537,
					"content": "別理那隻夜鴉了。前面山洞裡有密道，能直達塔頂，我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400711538
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400711538,
					"content": "噢，噢女士！您當真對我不感興趣？我可是看您如此美麗才願意告訴您幽夜淨土的秘密！女士！…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿諾德"
				}
			]
		}
	]
}