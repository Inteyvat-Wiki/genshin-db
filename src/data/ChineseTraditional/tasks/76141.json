				]
			},
			"dialogs": [
				{
					"id": 761410101,
					"content": "歡迎回來，兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410102
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410102,
					"content": "#不過，還沒有到我們戀戀不捨告別彼此的時候，這棟小屋{F#妳}{M#你}們還沒有參觀完畢呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410103
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410103,
					"content": "房間不是都進去看過了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761410104,
					"content": "#我可沒說過沒有秘密隱藏房間。魔女嘛，都是有點小心思的，{F#妳}{M#你}們要早點開始習慣哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410105
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410105,
					"content": "這邊請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				}
			]
		},
		{
			"id": 7614102,
			"completionStepIds": [
				7614102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7614102",
							"2"
						],
						"stepId": 7614102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"尼可"
				],
				"points": [
					{
						"sceneId": 1156,
						"position": [
							17.908,
							6.364,
							76.402
						],
						"pointId": 15
					}
				]
			},
			"dialogs": [
				{
					"id": 761410201,
					"content": "作為世界變動的不動觀測點之一，我需要擁有良好的視野條件，就像雕塑家離不開鏨子、作家離不開筆墨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410202
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410202,
					"content": "我在那兩個領域取得的建樹另當別論，但對於我的本職工作，我可是很認真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410203
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410203,
					"content": "#{NICKNAME}，{F#妳}{M#你}一定有所體會，近來在提瓦特，「命運」被撼動的情況已經越來越多見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410204
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410204,
					"content": "有時我也不免會設想，如果我還具備著當年全盛之時的形態、力量與能力，我能做的事一定比現在更多吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410205
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410205,
					"content": "但我很快又會否定自己。因為那樣，我所受到來自高天的限制也會一併增多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410206
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410206,
					"content": "一想到碰都不能碰的話題變多了，就覺得不划算，那要我怎麼講故事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410207
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410207,
					"content": "所以啊，我並不後悔我付出的代價，也不後悔在這條道路上做出的每一個選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410208
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410208,
					"content": "我想成為人類，像個普通人那樣生活…但那樣的生活終歸是奢侈的，我不會忘了自己是名天使。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410209
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410209,
					"content": "就算只是沉默天使，我也依舊會完成屬於自己的那份職責——守護文明、守護地上的生靈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410210
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410210,
					"content": "哎呀，好像不小心把話題帶得太嚴肅了呢！可能是場地的關係吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410211
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410211,
					"content": "其實我對我身為天使的那部分還是很滿意的呢——甚至稱得上自豪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410212
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410212,
					"content": "對的對的，尼可很厲害！不太出手，但偶爾出手的每一次都給人很大的安心感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761410213,
					"content": "自豪是應該的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761410214
					]
				},
				{
					"id": 761410214,
					"content": "#是嗎？呵呵，{F#妳}{M#你}們記下的是我可靠的樣子，那我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410215
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410215,
					"content": "#時間不早了。去吧，帶著我的祝福，繼續{F#妳}{M#你}們的冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761410216
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761410216,
					"content": "#別害怕迷路，別忘了有一名天使會在這裡悄悄守望{F#妳}{M#你}們的旅途。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				}
			]
		},
