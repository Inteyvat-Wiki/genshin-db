			"dialogs": [
				{
					"id": 740910501,
					"content": "艾古伊先生，我…我回來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910502
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910502,
					"content": "#{F#妳}{M#你}們是…看樣子是{F#妳}{M#你}們救了巴朗，謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910503
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910503,
					"content": "你這臭小子…我早就跟你說了，危險的工作沒必要自己拼命，等艾蒂安定期聯絡的時候報告一聲，讓艾蒂安找人處理就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910504
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910504,
					"content": "我當初好心教你，可是你這小子是什麼嘴臉？還反過來指責我工作不認真，怠忽職守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910505
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910505,
					"content": "你看，我跟你說什麼？太危險了，你應付不來！你還不信，現在吃到教訓了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910506
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910506,
					"content": "我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910507
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910507,
					"content": "怎麼，你還想嘴硬？我倒是要聽聽，你還有什麼高見？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910508
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910508,
					"content": "讓我喝口水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910509
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910509,
					"content": "巴朗找到水瓶，咕嚕咕嚕地猛灌了幾口，接著又掰了一塊乾麵包嚼了起來。\\n期間不管老人說什麼，他都好像沒聽見似的，只顧著吃喝。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740910510
					]
				},
				{
					"id": 740910510,
					"content": "呼…總算是…總算是活下來了。感謝兩位相助，不然我恐怕是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910511
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910511,
					"content": "恐怕是只能留下些撫恤金給你的父母了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910512
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910512,
					"content": "哼，那也比因為怠忽職守而導致重大安全事故，最後被革職還要好得多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910513
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910513,
					"content": "臭小子…唉，跟你真是說不通！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910514
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910514,
					"content": "兩位，雖然這麼說非常厚臉皮…可是我必須說，這也是為了大家的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910515
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910515,
					"content": "兩位應該會潛水吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910516
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910516,
					"content": "會是會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910517,
					"content": "我被丘丘人抓住的時候，弄丟了潛水服，此前例行檢查時又發現備用品也損壞了，雖然已經重新申請，但還沒送到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910518
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910518,
					"content": "但是管道的維護工作不能怠慢，兩位會潛水的話，能否麻煩兩位代替我下水檢查一下梅洛彼得堡的管道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910519
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910519,
					"content": "當然，酬勞我一定會準備好，不會虧待兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910520
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910520,
					"content": "既然關係到大家的安全，這個忙我們也不是不能幫。但是檢查管道聽起來好像是很專業的工作，交給我們真的沒問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910521,
					"content": "#只是例行檢查而已，我想應該頂多會有一些小問題。上次檢查的時候就發現共四處有風險…但處理起來應該不會太難，我跟{F#妳}{M#你}們說一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910522
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910522,
					"content": "如果在水下發現管道有<color=#00E1FFFF>氣體外洩</color>的情況，應該是水下生物…或者是非生物的衝撞導致的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910523
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910523,
					"content": "#應急的處理方法是<color=#00E1FFFF>控制調節閥調整流量，暫時止住氣體外洩</color>。{F#妳}{M#你}們只需要做到這種程度就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910527
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910527,
					"content": "調節閥的操作是有技巧的，<color=#00E1FFFF>轉動手輪時需要觀察氣體流量，如果氣體流量變小了，就代表那個做法是沒有問題的</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910524
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910524,
					"content": "哦…好像聽懂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910525,
					"content": "如果還有哪裡不明白，在例行檢查完成之前，有任何問題我隨時都會為兩位解答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910526
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910526,
					"content": "好吧，總之我們先去試試看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
