			"dialogs": [
				{
					"id": 740910401,
					"content": "#兩位…好心人…謝謝{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910402
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910402,
					"content": "你沒事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910403,
					"content": "我…我…還可以…大概還可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910404
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910404,
					"content": "看起來快不行了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910405
					]
				},
				{
					"id": 740910405,
					"content": "麻…麻煩兩位帶我去那邊的碼頭…我…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910406
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740910406,
					"content": "你還是先不要說話了，我們帶你回去就是了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
