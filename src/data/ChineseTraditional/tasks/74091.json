						740911002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740911002,
					"content": "#真是太謝謝{F#妳}{M#你}們了，這些小的安全隱患如果不及時排除，等到釀成大禍就後悔也來不及了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911003
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740911003,
					"content": "…所以我無法認同艾古伊老先生的觀點，即便我知道，他是以他的方式關照我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911004
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740911009,
					"content": "不管怎麼說，真的非常感謝兩位的搭救以及工作上的協助。酬勞我已經準備好了，請收下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911010
					],
					"speakerTitle": "巴朗"
				},
				{
					"id": 740911010,
					"content": "抱歉我因為這邊的麻煩耽擱了兩位的行程，祝兩位一路順風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴朗"
				}
			]
		},
