			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"艾古伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740910101,
					"content": "那小子，該不會被丘丘人抓去煮湯了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910102,
						740910103
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910102,
					"content": "誰被抓走了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910105
					]
				},
				{
					"id": 740910105,
					"content": "#{F#妳}{M#你}們看那邊，可以看到水上的丘丘人營地吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910106
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910106,
					"content": "簡直就像一夜之間突然冒出來的，該休息的時間不休息，拼命工作。唉！和巴朗那個臭小子一模一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910107
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910107,
					"content": "依我看，他要是走運現在不在鍋子裡的話，那說不定正在跟丘丘人聊得很開心呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910108
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910108,
					"content": "欸？你的意思是說，你認識的人被那邊的丘丘人抓走了？你怎麼一點也不著急？如果是真的，就要趕緊救人呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910109,
					"content": "救人？救什麼人？我早就跟他說了，危險的工作沒必要自己拼命，等艾蒂安定期聯絡的時候報告一聲，讓艾蒂安找人處理就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910110
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910110,
					"content": "我好心教他，可是那小子什麼嘴臉？還反過來指責我工作不認真、怠忽職守！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910111
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910111,
					"content": "既然他不把老前輩的經驗和智慧當一回事，那我只好說，都是他自己選的，年輕人就該吃點苦頭，不吃點教訓怎麼能成長？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910112,
						740910113
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910112,
					"content": "只聽一面之詞難以評判。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910114,
					"content": "嗯，現在救人要緊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910115,
					"content": "#危險得很呀！{F#妳}{M#你}們這些小孩子，受傷了怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910116
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740910116,
					"content": "#那你就放心好了，{NICKNAME}很強的！老爺爺在這裡等就好，我們去去就回！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740910113,
					"content": "萬一遇到危險，命都沒了要怎麼成長？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910114
					]
				},
				{
					"id": 740910103,
					"content": "什麼湯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740910104
					]
				},
				{
					"id": 740910104,
					"content": "重點是這個嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740910105
					],
					"speakerTitle": "派蒙"
				}
			]
		},
