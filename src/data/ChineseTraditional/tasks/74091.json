					"艾古伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740911701,
					"content": "那些麻煩的檢修工作既然有人幫忙，何必要自己花那麼大的力氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911702,
						740911706
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740911702,
					"content": "關於這個碼頭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911703
					]
				},
				{
					"id": 740911703,
					"content": "梅洛彼得堡那麼多管道，總要有人維護吧？我們就是做這個的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911704
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740911704,
					"content": "不過大部分的時候都只是一些小修小補罷了，畢竟要是真的出了大問題，靠我又有什麼用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740911705
					],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740911705,
					"content": "還是做一點自己力所能及的事吧！比如趁休假時幫人帶些信去城裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾古伊"
				},
				{
					"id": 740911706,
					"content": "不打擾了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740911707
					]
				},
				{
					"id": 740911707,
					"content": "反正我閒得很，哪有什麼打擾不打擾的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾古伊"
				}
			]
		}
	]
}