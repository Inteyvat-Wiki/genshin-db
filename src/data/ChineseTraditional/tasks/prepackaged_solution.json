			},
			"dialogs": [
				{
					"id": 746880101,
					"content": "真是遠超預期的作戰結果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880102
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880102,
					"content": "#準領隊和小助手，{F#妳}{M#你}們擊敗的魔物已經達到了整編連隊的級別！目前看來，遺蹟裡的魔物完全不可能外逃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880103
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880103,
					"content": "感覺怎麼樣？辛苦嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880104,
						746880107
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880104,
					"content": "還好，只是眼睛看得有點花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746880105
					]
				},
				{
					"id": 746880105,
					"content": "嗯，炮口的閃光，雖然不至於特別亮，但看久了，還是有點頭暈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746880106,
					"content": "這個簡單！有論文提到過，可以使用炮口裝置抑制閃焰，改善長期射擊的視覺疲勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880110
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880110,
					"content": "總之，危機解決了，收集到的資料也足夠了，我肯定可以把下一代重炮改進得更完善！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880111
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880111,
					"content": "#實在感謝{F#妳}{M#你}的支援，準領隊和小助手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880112
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880112,
					"content": "還有在準領隊到來前，提供關鍵幫助的瑪因小姐，獎金都給準領隊，我這邊賣出重炮後的收益就分妳一半好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880113
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880113,
					"content": "啊，還有我的份嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880114
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 746880114,
					"content": "摩拉什麼的無所謂了，不如幫我準備一些酒釀汐藻…要小麥酒基底的，不能用果酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880115
					],
					"speakerTitle": "瑪因"
				},
				{
					"id": 746880115,
					"content": "還有這種小吃嗎？聽名字，我都有點想試試看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880116,
						746880117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746880116,
					"content": "派蒙不能喝酒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746880118
					]
				},
				{
					"id": 746880118,
					"content": "我懂！那就把酒釀換成楓達釀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746880119,
					"content": "這…完全沒聽過的特色菜…要上哪去找給妳？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880120
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880120,
					"content": "前輩，不如正好趁這個機會，發明「自動風味汐藻醃漬器」之類的新品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880121
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746880121,
					"content": "反正前輩幫我做的「早餐自動烘焙機」非常可靠，代表你在料理裝置領域，也有著驚人的才華。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880122
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746880122,
					"content": "而且，料理裝置的市場廣闊得多，不像重炮，必須做到效能最為突出，戰勝強大的對手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880123
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746880123,
					"content": "也就不必每次都前往危險地帶，搶著和魔物作戰，收集關鍵資料了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880124
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746880124,
					"content": "咦…是這樣嗎？我的確可以嘗試轉型。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880125
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880125,
					"content": "不過，如果現在轉變成料理機關發明家，豈不是前功盡棄了？而且也和警備隊的工作不搭邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880126
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880126,
					"content": "你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880127
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746880127,
					"content": "唉…也對。隨隨便便就放棄的話，也不像前輩你的性格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880128
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746880128,
					"content": "我突然想到，除了利用警衛機關的識別模組強化重炮，還可以將一些機關正式固定成重炮單位內的「護衛機關」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880129
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746880129,
					"content": "有了這些護衛機關的專職保護，就算有魔物進入射界的盲區，也不用擔心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880130
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746880130,
					"content": "然後，將這些機關作為重炮的「打包解決方案」，向買家推銷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880131
					],
					"speakerTitle": "謝妮"
				},
				{
					"id": 746880131,
					"content": "哎！還真的滿不錯的，能一下解決買家的核心問題…這個主意相當成熟，值得好好細化論證！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880132
					],
					"speakerTitle": "弗雷瑞斯"
				},
				{
					"id": 746880132,
					"content": "感覺他們隨便聊兩句，靈感就呼呼湧出來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746880133,
					"content": "如果把這兩人關在一個房間裡，幾個禮拜不許他們離開，說不定能累積一大堆新奇的發明方案？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746880117,
					"content": "派蒙不能亂吃東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746880118
					]
				},
				{
					"id": 746880107,
					"content": "哎，炮聲震得我耳朵好痛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746880108
					]
				},
				{
					"id": 746880108,
					"content": "我也一樣！耳朵嗡嗡的…好像有一千隻漁鷗在吵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746880109,
					"content": "我有辦法！有個工程廢案提到過，可以用多腔體的消音器減速燃氣，降低開火時的噪音，就是材料比較貴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746880110
					],
					"speakerTitle": "弗雷瑞斯"
				}
			]
		}
	]
}