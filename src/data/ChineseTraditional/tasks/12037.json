			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"潮哥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370501,
					"content": "嘿，你好，你知道萬葉在哪裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370502,
					"content": "#{F#妳}{M#你}們也是來找萬葉的啊，看來他真的做了很了不起的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370503
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370503,
					"content": "「也」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370504
					]
				},
				{
					"id": 120370504,
					"content": "哈哈哈，這次我們駕著小船來補充物資。結果剛進港，就來了好多好多稻妻人，和我們打聽萬葉的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370505
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370505,
					"content": "要說之前名椎灘那場戰鬥，大姐頭也出了很多風頭啊，我也沒見大姐頭有這麼高的人氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370506
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370506,
					"content": "在船隊裡，萬葉的存在感不算強。有時候他還不聽大姐頭的話，但大姐頭也不在意，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370507
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370507,
					"content": "原來你還不知道他做了什麼啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370508,
					"content": "稍微聽到了一些，比如擋下了雷電將軍「無想的一刀」之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370509
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370509,
					"content": "那個很厲害嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370510
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370510,
					"content": "就像北斗斬滅海山的那一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370511
					]
				},
				{
					"id": 120370511,
					"content": "哦，這麼解釋的話我一下子就理解了。哈哈哈，那他這麼受人追捧，也是應該的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370512
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370512,
					"content": "他早些時候被天領奉行的人叫走了，說是有重要的事情要和他談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370513
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370513,
					"content": "一開始我還以為是來抓人的呢。結果對方的態度特別友好，感覺他很受尊敬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370514
					],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370514,
					"content": "放在不久之前，根本完全無法想像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370515,
						120370516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370515,
					"content": "幕府也想表示友好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				},
				{
					"id": 120370517,
					"content": "謝謝你啦，那我們去天領奉行府看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370518,
					"content": "嗯，我就在這邊繼續應付圍觀的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "潮哥"
				},
				{
					"id": 120370516,
					"content": "畢竟雷電將軍的態度變了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370517
					]
				}
			]
		},
		{
			"id": 1203706,
			"completionStepIds": [
				1203706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203706",
							"2"
						],
						"stepId": 1203706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉",
					"九條鐮治"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370601,
					"content": "#哦？是{F#妳}{M#你}啊，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370602
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370602,
					"content": "#{F#妳}{M#你}們好。我們剛剛聊到之前廢除「眼狩令」的事，既然{F#妳}{M#你}們來了，就一起聽一聽吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370603
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370603,
					"content": "這次請楓原萬葉先生來，主要是想表達幕府這邊的友好態度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370604
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370604,
					"content": "正因有你們的努力，才促成了如今光明的局面。我也有機會糾正家族曾犯下的錯誤，對此我非常感激。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370605
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370605,
					"content": "將軍大人正在從很多方面入手，消解或柔化過去積攢的矛盾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370606
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370606,
					"content": "三奉行提議，希望藉此契機恢復楓原家的名譽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370607
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370607,
					"content": "#有關楓原家的事，{F#妳}{M#你}應該也略知一二吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370608,
						120370609
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370608,
					"content": "有所耳聞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				},
				{
					"id": 120370610,
					"content": "簡而言之，稻妻過去有一批御用刀匠，繼承了將軍大人的鍛刀技術並發揚光大，楓原家便是其中一族。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370611
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370611,
					"content": "但某個時期，有部分刀匠叛逃去了至冬國，楓原家與神里家均因管理不力被追責，經歷了劇烈的動盪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370612
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370612,
					"content": "不過後來我們得知，此事的幕後主導是愚人眾。將過錯全都歸咎於楓原與神里兩家的做法並不妥當，也很不公平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370613
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370613,
					"content": "此番楓原萬葉先生又立下重大功勞，將軍大人認為不只應給予獎勵，還要為曾經的過當處置進行補償。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370614
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370614,
					"content": "但為了避免刀匠家族再度受到愚人眾的迫害，我們並沒有公開此事的調查結果，還請見諒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370615
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370615,
					"content": "言重了，能有機會接受將軍大人和幕府的好意，我很高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370616
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370616,
					"content": "只不過，這份好意應該不是免費的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370617
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370617,
					"content": "你多慮了，這是「補償」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370618
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370618,
					"content": "恢復名譽之後，楓原家便可重興鍛刀之業，你也不用繼續四處漂泊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370619
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370619,
					"content": "在將軍大人的庇護與幕府的支持下，你可以在稻妻城過上安穩富足的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370620
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370620,
					"content": "我常年行走於風雨之中，恐怕會不習慣高宅大院中的日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370621
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370621,
					"content": "不過我的祖先們，一直都為楓原之名和他們傳承的鍛刀技術而驕傲，我的確有為他們正名的責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370622
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370622,
					"content": "聽起來你還有點猶豫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370623
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370623,
					"content": "若你能答應，我想最近流傳在市井之中很多關於你的謠言中傷也會消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370624
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370624,
					"content": "謠言中傷？一路上只聽到好話，都快把他吹到天上去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370625,
					"content": "對有些人來說，「無想的一刀」是無法戰勝的存在，他們不能接受楓原先生就這麼接下了那一刀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370626
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370626,
					"content": "那時有人目擊了他除了風還使用了雷元素力，於是「楓原萬葉使用了邪眼」的消息不脛而走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370627
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370627,
					"content": "啊？可是，使用邪眼的人會飛快地衰老，萬葉他又沒有變成那個樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370628
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370628,
					"content": "嗯，但對他們來說，還是一個人同時使用兩種元素力這件事更難以理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370629
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370629,
					"content": "與此類似的傳聞還有很多，我很不適應處於輿論的中心，被人追逐或是猜忌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370630
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370630,
					"content": "但若幕府願意支持我，這件事的風浪或許會更快平靜下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370631
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370631,
					"content": "所以你可以積極地考慮一下，對我們來說應該都是一件好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370632
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370632,
					"content": "嗯，容我考慮一番吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370633
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370633,
					"content": "#此事的討論先告一段落。{F#妳}{M#你}們兩位為什麼會找到這裡來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370634
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370634,
					"content": "啊，差點就把重要的事忘記了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370635,
					"content": "將野外襲擊者的事告訴了楓原萬葉。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						120370636
					]
				},
				{
					"id": 120370636,
					"content": "這樣危險的人物在找我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370637,
						120370638
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370637,
					"content": "你有兄弟姐妹嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370639,
					"content": "沒有，現在我也很困惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370640
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370640,
					"content": "我的武技是家人教給我的，原本用於試刀。為了在試斬的時候斬出端正的刀路，公平地驗證每一把刀的品質，我們會進行大量訓練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370641
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370641,
					"content": "久而久之，也就形成了一套家族內的試刀術，也誕生了相應的技巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370642
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370642,
					"content": "這與實用的戰場武技很不一樣，很難想像只是巧合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370643
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370643,
					"content": "那你就更要小心了，感覺這個人莫名其妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370644
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370644,
					"content": "嗯，他攻擊性如此之強，如果對他人動手，很容易引起不好的後果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370645
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370645,
					"content": "既然如此，我馬上派人去搜查一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370646
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370646,
					"content": "嗯，麻煩你了。我對這件事也比較好奇，這樣吧，關於你方才的提議，正巧我也需要一段時間考慮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370647
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370647,
					"content": "#我和{M#他們}{F#她們}先去調查襲擊者的事，之後再給你一個明確的答覆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370648
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370648,
					"content": "好的，那你們也要注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370649
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120370649,
					"content": "走吧，我們去把那個襲擊者找出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 120370638,
					"content": "你有同門師兄弟嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370639
					]
				},
				{
					"id": 120370609,
					"content": "沒印象了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370610
					]
				}
			]
		},
