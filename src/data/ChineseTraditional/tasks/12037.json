			},
			"dialogs": [
				{
					"id": 120370201,
					"content": "我們來稻妻已經有一段時間了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370202,
					"content": "前前後後發生了好多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370203,
						120370204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370203,
					"content": "彈指一揮間…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				},
				{
					"id": 120370205,
					"content": "對我們的旅途來說，也算有進展吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370206,
					"content": "現在我們要去什麼地方呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370207,
					"content": "等等。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370208
					]
				},
				{
					"id": 120370208,
					"content": "欸，怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370209,
						120370210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370209,
					"content": "小心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 120370210,
					"content": "有人來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 120370204,
					"content": "記憶猶新的事有很多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370205
					]
				}
			]
		},
		{
			"id": 1203704,
			"completionStepIds": [
				1203704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203704",
							"2"
						],
						"stepId": 1203704,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"籠釣瓶一心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120370401,
					"content": "#嗯？原來{F#妳}{M#你}沒有神之眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370402
					],
					"speakerTitle": "籠釣瓶一心"
				},
				{
					"id": 120370402,
					"content": "看來是我認錯人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370403
					],
					"speakerTitle": "籠釣瓶一心"
				},
				{
					"id": 120370403,
					"content": "至少先看清楚了再動手啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370404,
					"content": "不對…不管你要找誰，突然攻擊別人就很危險了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370405,
					"content": "#{F#妳}{M#你}們見過嗎？一個叫楓原萬葉的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370406
					],
					"speakerTitle": "籠釣瓶一心"
				},
				{
					"id": 120370406,
					"content": "#和{F#妳}{M#你}一樣，都用單手劍。我還聽說他有風元素力的神之眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370407
					],
					"speakerTitle": "籠釣瓶一心"
				},
				{
					"id": 120370407,
					"content": "你找他幹什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370408
					]
				},
				{
					"id": 120370408,
					"content": "#和{F#妳}{M#你}沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370409
					],
					"speakerTitle": "籠釣瓶一心"
				},
				{
					"id": 120370409,
					"content": "#算了，看{F#妳}{M#你}也不知道，浪費時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370410
					],
					"speakerTitle": "籠釣瓶一心"
				},
				{
					"id": 120370410,
					"content": "這個人到底怎麼回事，就知道拿怪怪的刀亂揮，還莫名其妙的，連句道歉都不講。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370411,
					"content": "怎麼可能隨便就把萬葉的消息告訴這種人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370412,
						120370414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370412,
					"content": "說得沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370413
					]
				},
				{
					"id": 120370413,
					"content": "是吧，雖然我覺得如果是堂堂正正的對決，他也不能拿萬葉怎麼樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370416,
					"content": "以防萬一，我們還是要趕快通知萬葉，讓他小心提防。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370417,
					"content": "其實我有點想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370418
					]
				},
				{
					"id": 120370418,
					"content": "嗯？什麼想法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370419,
					"content": "他可能和萬葉有特殊的關係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370420
					]
				},
				{
					"id": 120370420,
					"content": "#特殊的關係？{F#妳}{M#你}是想說他認識萬葉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370421,
						120370422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370421,
					"content": "雖然只是很模糊的感覺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370423,
					"content": "嗯，好像是有點。但大家的招數看起來都差不多吧，這也說明不了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370424,
					"content": "總之我們快去給萬葉提個醒吧，免得他遇到危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370425,
					"content": "我聽說「南十字」船隊最近在離島補充貨物，他應該就在那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120370422,
					"content": "他的招式和萬葉有點像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370423
					]
				},
				{
					"id": 120370414,
					"content": "難得機靈了一次。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120370415
					]
				},
				{
					"id": 120370415,
					"content": "喂，這我就不開心了，我一直都很機靈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120370416
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1203705,
			"completionStepIds": [
				1203705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1203705",
							"2"
						],
						"stepId": 1203705,
						"stateName": "QUEST_STATE_UNFINISHED"
