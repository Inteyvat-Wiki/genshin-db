			},
			"dialogs": [
				{
					"id": 730380201,
					"content": "這是，蘭拉娜的蘭迦拉梨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380202
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730380202,
					"content": "她就是，蘭拉娜的那菈朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380203
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730380203,
					"content": "#嗯。那麼，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380204,
					"content": "（使用惟耶之實。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7303803,
