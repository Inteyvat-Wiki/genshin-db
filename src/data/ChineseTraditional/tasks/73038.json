			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭拉娜",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730380101,
					"content": "#覺王樹…奇怪。覺王樹不應該在這裡。金色的那菈、白毛飛飛…蘭拉娜不認識。但是，有熟悉的感覺。{F#妳}{M#你}們是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380102
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730380102,
					"content": "蘭拉娜，真的忘記了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380103,
					"content": "#我叫派蒙，{M#他}{F#她}是{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380104,
					"content": "我們是蘭拉娜的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380105
					]
				},
				{
					"id": 730380105,
					"content": "#嗯。蘭拉娜相信{F#妳}{M#你}們。{F#妳}{M#你}們有善良的氣味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380106
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730380106,
					"content": "#蘭拉娜明白了。本來，心裡就像有一個洞一樣，重要的記憶都溜走了。但是，看到覺王樹、看到{F#妳}{M#你}們，又明白了很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380107
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730380107,
					"content": "#剛剛看到了，{F#妳}{M#你}們拿了「惟耶之實」嗎？為了幫助朋友，所以蘭拉娜忘記了很多，然後請覺王樹結出了果子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380108
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730380108,
					"content": "蘭拉娜很聰明呢…「朋友」的事情，你還記得嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380109,
					"content": "#不記得。不過，沒關係。既然惟耶之實在{F#妳}{M#你}們手中，{F#妳}{M#你}們一定也是蘭拉娜相信的朋友，也是覺王樹認可的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380110
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730380110,
					"content": "#拜託{F#妳}{M#你}們，把惟耶之實，帶給蘭拉娜需要幫助的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380111,
						730380113
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730380111,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380112
					]
				},
				{
					"id": 730380112,
					"content": "蘭拉娜，我們一起去吧！你的朋友，一定也想再見到你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380115
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730380115,
					"content": "蘭拉娜不要。蘭拉娜已經忘記了。如果朋友看到蘭拉娜忘記了自己，那一定會傷心，覺得蘭拉娜不愛惜朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380116
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730380116,
					"content": "蘭拉娜想要幫助的那個朋友，她是很好的人…很好的那菈。就算蘭拉娜不記得她了，她也願意重新當你的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380117,
					"content": "所以，我們一起去，好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730380118,
					"content": "…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730380119
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730380119,
					"content": "#知道了。蘭拉娜相信{F#妳}{M#你}們，{F#妳}{M#你}們是朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730380113,
					"content": "我們一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730380114
					]
				}
			]
		},
