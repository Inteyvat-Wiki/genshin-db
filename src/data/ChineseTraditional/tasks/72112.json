					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123602,
					"content": "好、好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123603
					]
				},
				{
					"id": 721123603,
					"content": "神社真是個不講情面的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123604,
					"content": "#給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123605
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123605,
					"content": "嗯，看看運勢吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123606,
					"content": "#對了。每天只能求一次籤，這點請{F#妳}{M#你}記住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123607
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123607,
					"content": "不然我會很累…不對，不然御籤掛會掛不下…也不是，應該怎麼說才好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123608
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123608,
					"content": "「御神籤是神明意志的體現。所以要尊重神明的意志，並且盡人所能及之力。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123609
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123609,
					"content": "#{F#妳}{M#你}看，寫得真好。所以每天只能求一次籤，記好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玄冬林檎"
				}
			]
		},
