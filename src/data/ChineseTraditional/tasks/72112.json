				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玄冬林檎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721123501,
					"content": "#{F#妳}{M#你}要求籤嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123502
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123502,
					"content": "嗚哇，好冷淡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123503,
					"content": "我想求籤…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123504
					]
				},
				{
					"id": 721123504,
					"content": "#明白了。流程是這樣的。首先請{F#妳}{M#你}用力搖晃這個什麼東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123505
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123505,
					"content": "記得是叫「御神籤箱」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123506
					]
				},
				{
					"id": 721123506,
					"content": "#沒錯。從裡面會掉出一根竹籤。把這根竹籤給我，我就會給{F#妳}{M#你}對應的紙片兒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123507
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123507,
					"content": "好像叫「御神籤」來著…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123508
					]
				},
				{
					"id": 721123508,
					"content": "這種事情怎樣都好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123509
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123509,
					"content": "我有問題！如果說，如果說我們抽到了凶籤，要怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123510,
					"content": "#是命運讓{F#妳}{M#你}抽到凶籤，{F#妳}{M#你}還想怎樣？啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123511
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123511,
					"content": "欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123512,
					"content": "外頭那個像架子的東西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721123513
					]
				},
				{
					"id": 721123513,
					"content": "嘖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123514
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123514,
					"content": "她很露骨地「嘖」了耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123515,
					"content": "我看看…是這樣的。「把凶籤捆到『御籤掛』上，就可以逢凶化吉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123516
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123516,
					"content": "#啊，對喔！如果{F#妳}{M#你}抽到凶籤，把它捆到那個架子上就行了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123517
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123517,
					"content": "#他們還真是…不對，我們「鳴神大社」很溫柔的。所以就算抽到了凶籤，也會給{F#妳}{M#你}們轉運的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123518
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721123518,
					"content": "雖然感覺哪裡好像怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721123519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721123519,
					"content": "#{NICKNAME}，我們來求籤吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
