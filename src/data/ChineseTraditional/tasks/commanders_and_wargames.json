					{
						"sceneId": 3,
						"position": [
							-744.533,
							222.824,
							320.688
						],
						"pointId": 310702021
					}
				]
			},
			"dialogs": [
				{
					"id": 711440301,
					"content": "#這磐石雕琢般的面相，還有卓爾不群的氣場…{F#妳}{M#你}想必就是傳聞中的將才{NICKNAME}吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440302
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440302,
					"content": "#久仰大名。我正想委託冒險家協會向{F#妳}{M#你}致信，請{F#妳}{M#你}參會，沒想到{F#妳}{M#你}有所察覺，直接來到了現場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440303,
						711440304
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440303,
					"content": "將才？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440305
					]
				},
				{
					"id": 711440305,
					"content": "#說得好正經！感覺像是把{NICKNAME}當成了…特別專業的戰士？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711440306,
					"content": "#不只是戰士，{F#妳}{M#你}們遊歷五國期間曾與不計其數的魔物和強者交手，這些情報被各國部隊記錄下來後反覆分析。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440307
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440307,
					"content": "#無論是西風騎士團、千岩軍、幕府武士、三十人團，還是執律庭，每支作戰部隊都對{F#妳}{M#你}的戰力和謀略給予了頂尖的評價——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440308
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440308,
					"content": "#「{NICKNAME}的才能足以勝任從前線作戰到後方指揮的一切事務，如有可能，定要與其積極合作。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440309
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440309,
					"content": "#因此，我蘇定代表千岩軍的參謀部門，正式邀請{F#妳}{M#你}參與我們的五方聯合推演，出任高級顧問，不知{F#妳}{M#你}意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440310
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440310,
					"content": "高級顧問的酬勞相當可觀，參會期間的綜合日薪將與千岩軍教頭同級。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440311
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440311,
					"content": "不愧是千岩軍，說話真是直截了當…教頭級別的報酬，聽起來也很誘人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440312,
						711440313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711440312,
					"content": "但我們還沒搞清狀況耶！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440314
					]
				},
				{
					"id": 711440314,
					"content": "#不必擔心，我這就為{F#妳}{M#你}們介紹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440315
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440315,
					"content": "#如{F#妳}{M#你}所見，提瓦特的荒野上依然有不少魔物在遊蕩，短時間內無法根除。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440316
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440316,
					"content": "為了高效應對魔物的威脅，友鄰諸國的部隊正在總結常見魔物的情報，仔細評估威脅，並共享部分情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440317
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440317,
					"content": "為此，千岩軍的參謀部將各種魔物製成桌上推演的兵棋，模擬魔物之間的對抗，從而盡可能分析各種魔物的戰力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440318
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440318,
					"content": "本次「聯合推演」邀請了不同作戰單位的人員，以風格迥異的方式使用兵棋探究抵抗魔物的最佳方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440319
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440319,
					"content": "#而{NICKNAME}不屬於任何部隊，又是難得的戰術天才，能為我們提供一個新的分析方向，十分寶貴，這可以大大提升推演的廣度和效能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440320
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440320,
					"content": "好像聽懂了，你們是在開會討論…用什麼辦法對付魔物最方便、最安全？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711440321,
					"content": "總算聊到我們熟悉的領域了！畢竟我們見識過各種地方的危險傢伙，之前也玩過不少棋類桌遊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711440322,
					"content": "像以前那樣下下棋，就可以幫好幾個國家整頓治安，還能夠拿到不少報酬…可以說是一舉多得吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440323,
						711440325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711440323,
					"content": "輕輕鬆鬆玩推演，幫大忙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440324
					]
				},
				{
					"id": 711440324,
					"content": "正是這種氣勢，從容應對挑戰，如呼吸般自然地施展技藝，解決危機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440327
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440327,
					"content": "棋盤已經準備好了，隨時可以開始推演。請讓我們見識一下將才特有的作戰策略吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440325,
					"content": "看來這次或許要嚴肅一點…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440326
					]
				},
				{
					"id": 711440326,
					"content": "#請別緊張，拿出平時與魔物們交鋒的心態就好。各方人士都表示波瀾不驚正是{F#妳}{M#你}的常態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711440327
					],
					"speakerTitle": "蘇定"
				},
				{
					"id": 711440313,
					"content": "我們對推演還一無所知…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440314
					]
				},
				{
					"id": 711440304,
					"content": "參會？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711440305
					]
				}
			]
		}
	]
}