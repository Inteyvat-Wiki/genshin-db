				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"科里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150201,
					"content": "#不會吧，{F#妳}{M#你}居然把大方塊撞碎了一角？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150202
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150202,
					"content": "#上一位能有這種力氣的人還是瓦雷莎前輩…看來{F#妳}{M#你}和她一樣，都是天賦型選手啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150203,
						752150204
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150203,
					"content": "還是有點費力的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				},
				{
					"id": 752150205,
					"content": "#真是人不可貌相啊，有機會的話真想請{F#妳}{M#你}來當教練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150206
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150206,
					"content": "#對了，這瓶沃陸果飲據說能提升運動效果，學員們都愛喝，{F#妳}{M#你}也拿去嚐嚐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科里"
				},
				{
					"id": 752150204,
					"content": "這種程度的話，輕輕鬆鬆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150205
					]
				}
			]
		},
		{
			"id": 7521503,
