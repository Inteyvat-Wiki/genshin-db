			},
			"dialogs": [
				{
					"id": 752150301,
					"content": "招攬新人其實不難，問題在於訓練一段時間之後，就有不少人找藉口請假，或者乾脆不來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150302
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150302,
					"content": "教練為了提高大家的積極性，想了很多辦法，那個方塊挑戰就是其中一項。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150303
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150303,
					"content": "結果有些人為了提高分數，一個勁地往大方塊上面撞，最後搞得鼻青臉腫的，請假的人更多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科里"
				}
			]
		},
