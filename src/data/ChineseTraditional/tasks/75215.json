			"trigger": {
				"objectNames": [
					"科里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 752150101,
					"content": "#怎麼了，{F#妳}{M#你}也對力量訓練營有興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150102
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150102,
					"content": "#器械可以隨意試用，但看{F#妳}{M#你}細手臂細腿的，可別把自己弄傷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150103,
						752150104
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150103,
					"content": "我每天運動量可大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				},
				{
					"id": 752150105,
					"content": "真的嗎？在和我吹牛之前，不如先和旁邊的大方塊較較勁吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752150106
					],
					"speakerTitle": "科里"
				},
				{
					"id": 752150106,
					"content": "#<color=#00E1FFFF>攻擊</color>或者<color=#00E1FFFF>撞擊</color>大方塊，根據力量的大小就能得到不同的分數。讓我看看{F#妳}{M#你}有多大能耐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "科里"
				},
				{
					"id": 752150104,
					"content": "我能一拳打飛丘丘人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752150105
					]
				}
			]
		},
		{
			"id": 7521502,
			"completionStepIds": [
				7521502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7521502",
							"2"
						],
						"stepId": 7521502,
						"stateName": "QUEST_STATE_UNFINISHED"
