					"nextDialogs": [
						210000604
					]
				},
				{
					"id": 210000604,
					"content": "#{F#大姐姐}{M#大哥哥}，我們先回城裡去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000605
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000605,
					"content": "不過，就是放了個漂流瓶，小蒙的問題真的能得到解答嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000606
					],
					"speakerTitle": "派蒙"
				},
				{
