				"points": []
			},
			"dialogs": [
				{
					"id": 210000101,
					"content": "唉，我真的能做到嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000102
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000102,
					"content": "小蒙，你怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000103
					]
				},
				{
					"id": 210000103,
					"content": "#{F#大姐姐}{M#大哥哥}，是{F#妳}{M#你}啊…{F#妳}{M#你}好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000104
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000104,
					"content": "小蒙，你怎麼看著有些不開心呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210000105,
					"content": "怎麼了？是他們不和你玩那個…海盜遊戲了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210000106,
					"content": "欸？不是，璐璐和阿飛他們是回家去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000107
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000107,
					"content": "我…是想要自己出去逛逛，所以才暫時沒回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000108
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000108,
					"content": "這樣你父母不會擔心嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210000109,
					"content": "現在這個時間，我爸媽應該還在工作沒回家呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000110
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000110,
					"content": "#不說這個，{F#大姐姐}{M#大哥哥}，我能問{F#妳}{M#你}個問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000111,
						210000112
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000111,
					"content": "什麼問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000114
					]
				},
				{
					"id": 210000114,
					"content": "#{F#大姐姐}{M#大哥哥}，我聽很多人說起過{F#妳}{M#你}的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000115
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000115,
					"content": "#我覺得，{F#妳}{M#你}去過很多地方，也經歷過很多事…說不定能告訴我這個問題的答案…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000116
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000116,
					"content": "嗚哇…小蒙突然這麼嚴肅了，到底是什麼問題呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210000117,
					"content": "#{F#大姐姐}{M#大哥哥}，我想問{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000118
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000118,
					"content": "一個人到底怎麼樣，才能變得「成熟」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000119,
						210000122
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000119,
					"content": "需要用時間來成長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000120
					]
				},
				{
					"id": 210000120,
					"content": "#{F#妳}{M#你}是說，只要長大了，人就會自然而然地變成熟嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000121
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000121,
					"content": "可是，長大了之後再成熟，會不會有點太晚了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000124,
					"content": "唔…如果你是想要出城看看的話，我們可以陪你出去逛逛呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210000125,
					"content": "#那也太麻煩{F#妳}{M#你}們了，而且…只是出城的話，我應該也不會有什麼特別的收穫吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000126
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000126,
					"content": "#{F#大姐姐}{M#大哥哥}，我想請{F#妳}{M#你}們幫我另一個忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000127
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000127,
					"content": "我聽人家說，如果有解決不了的煩惱，可以把煩惱寫下來放進漂流瓶裡，讓煩惱隨著河水飄出去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000128
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000128,
					"content": "這樣子，說不定煩惱就會得到解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000129
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000129,
					"content": "但我聽說，外面有很多魔物，我一個人去有些不太安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000130
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000130,
					"content": "#所以，我想要拜託{F#大姐姐}{M#大哥哥}保護一下我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000131,
						210000132
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000131,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000133,
					"content": "#謝謝{F#大姐姐}{M#大哥哥}。我會付{F#妳}{M#你}報酬的，都是我自己存的錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000134
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000134,
					"content": "那我們出發吧，先去碧水河邊看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000132,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000133
					]
				},
				{
					"id": 210000122,
					"content": "需要經歷特別的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000123
					]
				},
				{
					"id": 210000123,
					"content": "要經歷特別的事…可我到現在，連璃月港都沒踏出去過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000124
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000112,
					"content": "我暫時沒空陪你玩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210000113
					]
				},
				{
					"id": 210000113,
					"content": "哈哈哈，那個遊戲我也是陪著璐璐和阿飛玩啦，他們不在，我也不會特意去玩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000114
					],
					"speakerTitle": "小蒙"
				}
			]
		},
