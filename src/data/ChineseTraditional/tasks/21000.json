						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2100007",
							"2"
						],
						"stepId": 2100007,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210000301,
					"content": "居然…居然有這種東西…嚇死我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000302
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000302,
					"content": "#謝謝{F#妳}{M#你}，{F#大姐姐}{M#大哥哥}，我們繼續…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000303
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000303,
					"content": "欸？我…我的漂流瓶呢？剛剛還在我身上的，不見了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000304
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000304,
					"content": "難道是剛才被那個…那個騙騙花襲擊的時候，掉在哪裡了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210000305
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210000305,
					"content": "#{F#大姐姐}{M#大哥哥}，拜託{F#妳}{M#你}幫我找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				}
			]
		},
		{
			"id": 2100005,
			"completionStepIds": [
				2100011
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
