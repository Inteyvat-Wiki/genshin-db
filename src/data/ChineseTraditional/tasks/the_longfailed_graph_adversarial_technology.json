					}
				]
			},
			"dialogs": [
				{
					"id": 746720101,
					"content": "咦？是夏洛蒂？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720102,
					"content": "她在和樂平波琳在說什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720103,
					"content": "求求妳求求妳！夏洛蒂小姐！夏洛蒂大人！妳一定只是在開玩笑，沒錯吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720104
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720104,
					"content": "「穿著膨膨獸偽裝服，騙過了警衛機關，成功犯罪」…這個案件真的發生過，對不對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720105
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720105,
					"content": "為了「圖形對抗」的技術，我已經投入了全部存款，甚至還向銀行借了一大筆錢啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720106
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720106,
					"content": "我跟妳磕頭了！磕磕磕磕磕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720107
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720107,
					"content": "請妳冷靜一點，樂平波琳小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720108
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720108,
					"content": "我理解妳對研究的熱情，還有…呃…對大筆訂單的渴望？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720109
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720109,
					"content": "但…那真的只是一篇小說，是一位匿名作者出於個人興趣寫作，透過無署名信件投遞的紀實風小說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720110,
						746720111
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720110,
					"content": "案件？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720112
					]
				},
				{
					"id": 746720112,
					"content": "唔…我好像明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720113,
					"content": "難道說，樂平波琳之前在《蒸汽鳥報》上讀到的那一起案件，其實只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720114,
					"content": "我親耳聽見了編輯們開會討論的內容，編輯們也在擔心那篇小說會不會誤導民眾，還派人專門諮詢了執律庭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720115
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720115,
					"content": "沒想到，執律庭居然很看中那篇小說，覺得它會為潛在的罪犯提供一份假情報，引誘罪犯們穿著誇張的玩偶服行動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720116
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720116,
					"content": "警衛機關的識別能力非常可靠，與經驗豐富的警備隊員不相上下，這種措施其實根本騙不過它們，反而會使罪犯無比顯眼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720117
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720117,
					"content": "自從刊登了那篇小說，執律庭已經成功抓獲了一大群…「膨膨獸怪盜」、「巨大紅冠雀」和「飄浮靈俠」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720118
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720118,
					"content": "沒想到，那篇小說在輔助治安的同時，居然誤導了妳這樣的研究員，還讓妳白白投入了一大筆資金…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720119
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720119,
					"content": "噫…啊啊啊啊啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720120
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720120,
					"content": "呃…樂平波琳的研究，居然建立在一個虛構的故事上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720121,
					"content": "那我們豈不是也分不到那一大筆錢…不對不對，那她的投入，豈不是全都白費了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720122,
					"content": "#{NICKNAME}和派蒙，{F#妳}{M#你}們回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720123
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720123,
					"content": "#我在附近留影取材的時候，遇見了這位樂平波琳小姐，聽說了她的研究和{F#妳}{M#你}們的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720124
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720124,
					"content": "樂平波琳小姐還想讓我寫一篇文章，幫她的「圖形識別技術」打打廣告，硬塞了我一筆稿費和一個樣品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720125
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720125,
					"content": "#很遺憾，她的期待和{F#妳}{M#你}們的努力都白費了…她還要想想辦法，支付{F#妳}{M#你}們的酬勞…我說了些安慰的話，她一時也接受不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720126
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720126,
					"content": "我們也是頭一次碰到這種事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720127,
					"content": "總感覺…那篇小說的作者只是想寫個吸引人的故事，執律庭的做法也的確有助於楓丹的治安…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720128,
						746720129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720128,
					"content": "沒有人做錯了什麼事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720130
					]
				},
				{
					"id": 746720130,
					"content": "等等…樂平波琳小姐，妳要幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720131
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720131,
					"content": "去找警衛機關打一架、走一趟歐庇克萊歌劇院、拿一張梅洛彼得堡的居住許可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720132
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720132,
					"content": "這樣就不用還錢了…嗯…只有這樣才能活下去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720133
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720133,
					"content": "不至於這麼誇張吧！看妳的樣子，就算襲擊警衛機關，也打不破它們的裝甲，最多只會被執律庭拘留幾天，還是要還錢的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720134
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720134,
					"content": "啊！不對，重點是妳究竟為了這個技術投入了多少錢，絕望成這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720135
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720135,
					"content": "二…二十七萬摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720136
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720136,
					"content": "這個數目好像…也不至於要躲進梅洛彼得堡吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720137
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720137,
					"content": "作為一個前楓丹科學院外包器材供應商的工程師，這已經是我這種小角色辛辛苦苦幾年才存下來的極限存款了呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720138
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720138,
					"content": "而且，失去的不只是我的存款，還有我對「圖形對抗」大肆想像的美好未來，還有我億萬富翁的夢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720139
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720139,
					"content": "哈…哈哈…呵呵…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720140
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720140,
					"content": "我的人生完蛋了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720141
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720141,
					"content": "咳咳…樂平波琳小姐，不必這麼喪氣！我有一個提議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720142
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720142,
					"content": "剛才我發現，為了更精準地收集與分析圖像，妳給我的樣品——那個「圖形識別樣本收集留影鏡頭」，採用了一種很特別的設計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720143
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720143,
					"content": "不考慮原本的功能，這種能快速變焦的鏡頭，一定能為記者們提供許多方便，甚至加速整個楓丹新聞業的進步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720144
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720144,
					"content": "所以說，妳之前的研究沒有白費，它們能在妳意想不到的領域展現出不凡的價值！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720145
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720145,
					"content": "真…真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720146
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720146,
					"content": "那是當然！我好歹也是在《蒸汽鳥報》工作了一段時間的記者，同行們工作時遇到的難題，我再清楚不過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720147
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720147,
					"content": "妳先冷靜一下，振作起來，然後考慮一下量產鏡頭的問題，我會和同行們介紹妳的鏡頭，為妳介紹生意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720148
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720148,
					"content": "還有這種好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720149
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720149,
					"content": "那我豈不是可以…抓住「留影裝置」的發展脈絡了？我還是能拿到大筆訂單，成為億萬富翁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720150
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720150,
					"content": "我是不是應該…再去借一筆錢？盡早改進鏡頭的工藝，搶先佔領市場，為留影裝置的對抗戰爭做好準備！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720151
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720151,
					"content": "別總是想著抓住什麼脈絡了啦！樂平波琳…還是走一步看一步，不要一下子就把全部身家砸進去賺大錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720152,
						746720153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720152,
					"content": "野心越大越容易失望。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720154
					]
				},
				{
					"id": 746720154,
					"content": "嗯…要是找個熟人，把圖形識別的裝置賣給有需要的工坊，還能再籌集一筆摩拉…我應該早點想到的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720155
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720155,
					"content": "事不宜遲，我現在就要開工，不然就晚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720156
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 746720156,
					"content": "啊！居然就這麼跑掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720157,
					"content": "我們勸她的話，好像根本就沒聽進去嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720158,
					"content": "嗯…可以理解，「靈感和熱情湧上來的時候，很容易忽略別人的話，只顧著推進工作」…許多剛入行的記者也是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720159
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720159,
					"content": "#不過，{F#妳}{M#你}們不用擔心，我打算把這次的事件寫成一篇報導，還會經常去找樂平波琳小姐的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720160
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720160,
					"content": "她的研究能幫助整個記者群體，我也會為她提供建議，防止她走入誤區的，努力讓她盡早成功量產那種鏡頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720161
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720161,
					"content": "妳這樣一說，我們就放心多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720162,
						746720163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720162,
					"content": "不愧是夏洛蒂！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720164
					]
				},
				{
					"id": 746720164,
					"content": "#說起來，{F#妳}{M#你}們兩位經常四處旅行，這個樣品鏡頭就送給{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720165
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720165,
					"content": "#新奇的道具在厲害的人手裡才能發揮最大的作用，在{F#妳}{M#你}們的運用下，它想必能記錄不少精彩的景色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720166
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720166,
					"content": "謝謝妳啦！夏洛蒂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720167,
					"content": "拿不到分成也無所謂了，起碼我們沒有白白跑腿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720168
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746720168,
					"content": "別客氣，我也收獲了很特別的新聞素材！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720169
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720169,
					"content": "「即使有著特殊的需求，新聞報導和紀實類文學作品的邊界，也還是劃分得越清楚越好。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746720170
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720170,
					"content": "我會向編輯們好好回報的，希望以後不要再出現樂平波琳這種…一番好心卻倒了大楣的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 746720163,
					"content": "不愧是王牌記者！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720164
					]
				},
				{
					"id": 746720153,
					"content": "踏踏實實做事才是正道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720154
					]
				},
				{
					"id": 746720129,
					"content": "只有樂平波琳受了傷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720130
					]
				},
				{
					"id": 746720111,
					"content": "小說？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746720112
					]
				}
			]
		},
		{
			"id": 7467202,
			"completionStepIds": [
				7467202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
