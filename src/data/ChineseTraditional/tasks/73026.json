			},
			"dialogs": [
				{
					"id": 730260101,
					"content": "這裡面跟上次進去過的大機器人差不多嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260102,
					"content": "#上次？{F#妳}{M#你}們之前也有進到過其他遺蹟巨像裡面嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260103
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260103,
					"content": "嗯！之前在沙漠，有個叫阿弗拉圖的傢伙也拜託過我們調查類似的機器來著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260104,
					"content": "阿弗拉圖？可惡啊，他該不會也盯上了「遺蹟巨像研究權威」的名號吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260105
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260105,
					"content": "我想應該不是這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260106
					]
				},
				{
					"id": 730260106,
					"content": "我記得那個傢伙明明是因論派的學者，應該不會對這個感興趣才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260107
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260107,
					"content": "不過想想似乎也不是沒有可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260108
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260108,
					"content": "畢竟是那位曾經說出，「諸位，古國坎瑞亞千年的歷史在看著我們！」這番豪言的賢者伊斯坎德出身的學派。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260109
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260109,
					"content": "先不管什麼研究權威，和我們之前調查過的那台比起來，這裡看起來感覺真的很久沒有人來過了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260110,
					"content": "那是當然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260111
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260111,
					"content": "根據《古國坎瑞亞遺蹟巨像相關問題的研究綜述》，上一個進入這台遺蹟巨像進行過系統研究的學者還是迦毗鳩師呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260112
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260112,
					"content": "#{F#妳}{M#你}們一定不知道吧，迦毗鳩師可是我們妙論派歷史上最偉大的學者之一，是個不到三十歲就被稱為訶盤荼的學術天才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260113
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260113,
					"content": "本來按他的成就遲早是要成為賢者的，結果卻在一次外出考察中發生了意外，重要的學術成果也不知所蹤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260114
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260114,
					"content": "從那之後，妙論派就一蹶不振了。如果他能活得久一點，或許我現在就不用天天考慮經費的事情了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260115
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260115,
					"content": "順帶一提，繼承迦毗鳩師的事業正是本人的學術理想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260116
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260116,
					"content": "唔，總之我們接下來要做的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260117,
						730260119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260117,
					"content": "砸開封住的入口。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260118
					]
				},
				{
					"id": 730260118,
					"content": "嗯嗯，這樣的話首先要啟動這個大傢伙才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260121,
					"content": "沒錯，啟動這台遺蹟巨像取得寶貴的實驗資料也是我這次研究的突破點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260122
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260122,
					"content": "想要超越前人的話，不搞出點大動靜可是做不到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260123
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260123,
					"content": "那麼我們現在只要去駕駛艙啟動這個大傢伙就好了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260124,
					"content": "這個嘛…雖然正常來說只要進入駕駛艙打開「解離閥」，就能啟動遺蹟巨像了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260125
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260125,
					"content": "但我之前不是說過嗎，所有的遺蹟機關都是依靠爐心裡的漆黑力量驅動的。而這架遺蹟巨像的爐心…已經被封印在下面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260126
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260126,
					"content": "所以就算我們進入了駕駛艙，靠正常方法也是沒辦法啟動的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260127
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260127,
					"content": "何況現在連眼前這個升降塔也啟動不了，根本就沒辦法到達頂層的駕駛艙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260128
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260128,
					"content": "唔，那我們現在要怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260129,
						730260131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260129,
					"content": "打一下看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260130
					]
				},
				{
					"id": 730260130,
					"content": "喂！雖然我是有教令院最高許可權的研究許可，但是故意破壞就是另一回事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260132
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260132,
					"content": "俗話說「門關上了窗戶就會打開」，坎瑞亞人也考慮過這種情況吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260133
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260133,
					"content": "或許是因為對於漆黑能量的掌握尚不成熟，根據教令院的研究，早期生產的遺蹟機關還裝載了一套備用的動力系統。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260134,
						730260140
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260134,
					"content": "動力系統？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260135
					]
				},
				{
					"id": 730260135,
					"content": "不同於可以提供近乎無限能量的爐心，這套動力系統是由一系列小型的能源中繼裝置組成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260136
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260136,
					"content": "而這些裝置的動力來源則是許多儲存了從地脈中提取的純粹能量的能量塊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260137
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260137,
					"content": "根據一些因論派學者的推測這類動力系統早在古國坎瑞亞建造第一台遺蹟機關之前就已經被廣泛使用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260138
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260138,
					"content": "剛才我進來的時候已經觀察過了，這台遺蹟巨像也是早期生產的型號，所以肯定也搭載了備用的動力系統。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260139
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260139,
					"content": "核心動力室在底層，我們先想辦法去到下面吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260140,
					"content": "直接說要怎麼做就行了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260141
					]
				},
				{
					"id": 730260141,
					"content": "唔，核心動力室在底層，我們先想辦法去到下面吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260131,
					"content": "也就是說有非正統的方法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260132
					]
				},
				{
					"id": 730260119,
					"content": "展開學術研究。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260120
					]
				},
				{
					"id": 730260120,
					"content": "#唔，{F#妳}{M#你}忘記我們是來調查地下遺蹟的了嗎？雖然學術研究也很重要啦，不過我們得先想辦法啟動這個大傢伙才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260121
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7302605,
			"completionStepIds": [
				7302605
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302605",
							"2"
						],
						"stepId": 7302605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730260501,
					"content": "這裡面出乎意料的大啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260502,
					"content": "這是當然，等一下，現在終於有機會說出那句名臺詞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260503
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260503,
					"content": "「諸位，古國坎瑞亞數千年的歷史在看著我們！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260504
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260504,
					"content": "#哎呀，有些得意忘形了。這可是因論派賢者伊斯坎德的名言，{F#妳}{M#你}們不會連他的傳記也沒有讀過吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260505,
						730260506
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260505,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260508
					]
				},
				{
					"id": 730260508,
					"content": "雖然在文獻裡早就讀過無數遍了，不過第一次親眼看到還是沒辦法抑制住激動的心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260509
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260509,
					"content": "好多藤蔓，看來是真的很久沒有人來過了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260510,
					"content": "根據《古國坎瑞亞遺蹟巨像相關問題的研究綜述》，上一個進入這台遺蹟巨像進行過系統研究的學者還是迦毗鳩師呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260511
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260511,
					"content": "#{F#妳}{M#你}們一定不知道吧，迦毗鳩師可是我們妙論派歷史上最偉大的學者之一，是個不到三十歲就被稱為訶般荼的學術天才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260512
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260512,
					"content": "本來按他的成就遲早是要成為賢者的，結果卻在一次外出考察中發生了意外，重要的學術成果也不知所蹤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260513
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260513,
					"content": "從那之後，妙論派就一蹶不振了。如果他能活得久一點，或許我現在就不用天天考慮經費的事情了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260514
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260514,
					"content": "順帶一提，繼承迦毗鳩師的事業正是本人的學術理想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260515
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260515,
					"content": "先不管什麼學術理想，總之我們接下來要做的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260516,
						730260518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260516,
					"content": "砸開封住的入口。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260517
					]
				},
				{
					"id": 730260517,
					"content": "嗯嗯，這樣的話首先要啟動這個大傢伙才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260520,
					"content": "沒錯，啟動這台遺蹟巨像取得寶貴的實驗資料也是我這次研究的突破點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260521
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260521,
					"content": "想要超越前人的話，不搞出點大動靜可是做不到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260522
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260522,
					"content": "那麼快點啟動這個大傢伙吧，應該會有那種只要一按下去就會亮起來的機關什麼的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260523,
					"content": "機關…雖然確實是有啦，根據文獻記載，正常來說只要進入駕駛艙打開「解離閥」，就能啟動遺蹟巨像了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260524
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260524,
					"content": "但我之前不是說過嗎，所有的遺蹟機關都是依靠爐心裡的漆黑力量驅動的。而這架遺蹟巨像的爐心…已經被封印在下面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260525
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260525,
					"content": "所以就算我們進入了駕駛艙，靠正常方法也是沒辦法啟動的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260526
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260526,
					"content": "何況現在連眼前這個升降塔也啟動不了，根本就沒辦法到達頂層的駕駛艙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260527
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260527,
					"content": "唔，那我們現在要怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260528,
						730260530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260528,
					"content": "打一下看看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260529
					]
				},
				{
					"id": 730260529,
					"content": "喂！雖然我是有教令院最高許可權的研究許可，但是故意破壞就是另一回事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260531
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260531,
					"content": "俗話說「門關上了窗戶就會打開」，坎瑞亞人也考慮過這種情況吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260532
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260532,
					"content": "或許是因為對於漆黑能量的掌握尚不成熟，根據教令院的研究，早期生產的遺蹟機關還裝載了一套備用的動力系統。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260533,
						730260539
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260533,
					"content": "動力系統？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260534
					]
				},
				{
					"id": 730260534,
					"content": "不同於可以提供近乎無限能量的爐心，這套動力系統是由一系列小型的能源中繼裝置組成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260535
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260535,
					"content": "而這些裝置的動力來源則是許多儲存了從地脈中提取的純粹能量的能量塊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260536
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260536,
					"content": "根據一些因論派學者的推測這類動力系統早在古國坎瑞亞建造第一台遺蹟機關之前就已經被廣泛使用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260537
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260537,
					"content": "剛才我進來的時候已經觀察過了，這台遺蹟巨像也是早期生產的型號，所以肯定也搭載了備用的動力系統。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260538
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260538,
					"content": "核心動力室在底層，我們先想辦法去到下面吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260539,
					"content": "直接說要怎麼做就行了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260540
					]
				},
				{
					"id": 730260540,
					"content": "唔，核心動力室在底層，我們先想辦法去到下面吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260530,
					"content": "也就是說有非正統的方法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260531
					]
				},
				{
					"id": 730260518,
					"content": "展開學術研究。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260519
					]
				},
				{
					"id": 730260519,
					"content": "#唔，{F#妳}{M#你}忘記我們是來調查地下遺蹟的了嗎？雖然學術研究也很重要啦，不過我們得先想辦法啟動這個大傢伙才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260506,
					"content": "你不是妙論派的學者嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260507
					]
				},
				{
					"id": 730260507,
					"content": "我沒打算被學派的藩籬限制住啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260508
					],
					"speakerTitle": "加扎里"
				}
			]
		},
		{
			"id": 7302606,
			"completionStepIds": [
				7302603
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302603",
							"2"
						],
						"stepId": 7302603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 730260601,
					"content": "哇！竟然真的啟動了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260616,
					"content": "怎麼樣？這台巨像裡的機械，不管是中繼裝置還是機關門，都可以靠這種能量塊來供能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260602
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260602,
					"content": "但是怎麼好像，什麼也沒發生的樣子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260603,
					"content": "哎呀，這是因為這套備用動力系統是由一系列小型的能源中繼裝置組成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260604
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260604,
					"content": "也就是說，必須從底層開始，一點點連接所有的能源中繼裝置，這套動力系統才能運行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260605
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260605,
					"content": "所有的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260606
					]
				},
				{
					"id": 730260606,
					"content": "雖然以這架遺蹟巨像的受損情況而言，以最大功率運行確實有些困難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260607
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260607,
					"content": "#不過就在{F#妳}{M#你}們剛才啟動這個中繼裝置的時候，我在這個動力室裡發現了這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260608
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260608,
					"content": "看樣子是這台遺蹟巨像的結構藍圖，應該是負責維修的機組人員丟在這裡的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260609
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260609,
					"content": "根據這個藍圖，看來我們只要把關鍵的幾個中繼裝置連接了，就能啟動這架機械了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260610
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260610,
					"content": "…至少也能啟動這個升降塔去到駕駛艙那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260611
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260611,
					"content": "聽起來不是很可靠的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260612,
					"content": "#總之現在也沒有其他辦法，不如{F#妳}{M#你}們就先去把連接升降塔的裝置啟動看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260613
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260613,
					"content": "欸？你不跟我們一起去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730260614,
					"content": "我要留在這裡拍…啊不對是研究這台遺蹟巨像的內部構造，這也是很重要的工作啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260615
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260615,
					"content": "#況且身為學者的我也幫不上什麼忙吧。如果遇到什麼技術上的問題的話，{F#妳}{M#你}們就過來這邊找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加扎里"
				}
			]
		},
		{
			"id": 7302607,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302603",
							"3"
						],
						"stepId": 7302603,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7302614",
							"1"
