			"dialogs": [
				{
					"id": 730261301,
					"content": "我都說了要按照規範來操作了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261302
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730261302,
					"content": "我們好像也沒操作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730261303
					]
				},
				{
					"id": 730261303,
					"content": "整個手臂直接掉下去了欸，怎麼看都是這個機器人自己的問題吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730261304,
					"content": "好吧，總之我會按照實驗意外記錄的，唉…希望不會對我的報告產生什麼影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261305
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730261305,
					"content": "#不管怎麼樣，看起來這個遺蹟巨像已經沒辦法再次啟動了，{F#妳}{M#你}們繼續留在這裡也沒有意義了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261306
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730261306,
					"content": "#{F#妳}{M#你}們是為了調查地下遺蹟的汙染而來，雖然現在這個遺蹟巨像是派不上什麼用場了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261307
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730261307,
					"content": "不過剛剛忙了這麼一下，說不定已經有了什麼突破呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261308
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730261308,
					"content": "#我就不去給{F#妳}{M#你}們添麻煩了，而且我還有研究需要完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261309
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730261309,
					"content": "#{F#妳}{M#你}們的事情完成之後再回來找我吧…如果我沒有因為損壞這個遺蹟巨像而被處分的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261310
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730261310,
					"content": "#到那個時候我也能正式幫{F#妳}{M#你}們申請針對混沌爐心的研究計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261311
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730261311,
					"content": "#雖然計畫主持人只能是我啦，不過經費我會分{F#妳}{M#你}們一半的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730261312
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730261312,
					"content": "只要抱持著求索之心，不管是什麼人都是能走上學術道路的！以此為目標加油吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加扎里"
				}
			]
		}
