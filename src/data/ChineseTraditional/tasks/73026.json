				"objectNames": [
					"加扎里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730260901,
					"content": "#嗯？剛才{F#妳}{M#你}們在上面做了什麼？我在研究這個感應迴路的時候好像聽到了什麼不得了的動靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260902
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260902,
					"content": "#不管{F#妳}{M#你}們在幹什麼，麻煩稍微動作小一點。要是真搞出什麼事情來，我在給教令院的報告裡可不好交待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260903,
						730260906
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260903,
					"content": "我們遇到了駕駛員。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260904
					]
				},
				{
					"id": 730260904,
					"content": "#駕駛員？{F#妳}{M#你}們該不會當真了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260905
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260905,
					"content": "就算是坎瑞亞人也是不可能活上幾百年的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260909
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260909,
					"content": "#話說回來，總之{F#妳}{M#你}們應該已經把中層的中繼裝置全部連通了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260910
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260910,
					"content": "我在這裡的研究也進行的差不多了，接下來我們就一起去頂層的駕駛艙那裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260911
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260911,
					"content": "和剛才一樣，只要把動力系統連通到駕駛艙那邊應該就能啟動這架遺蹟巨像的控制系統了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260906,
					"content": "我們遇到了一位熟人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260907
					]
				},
				{
					"id": 730260907,
					"content": "#呃，{F#妳}{M#你}該不會也和這個孩子一樣…沒關係，到時候給教令院的推薦信我會準備兩份的，這樣{F#妳}{M#你}們也能好好相處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260908
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260908,
					"content": "不是這麼回事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260909
					],
					"speakerTitle": "派蒙"
				}
