					"加扎里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730260801,
					"content": "#這麼快就回來了嗎，我還在研究這部分機械骨架的受力結構呢。沒想到{F#妳}{M#你}們竟然成功啟動了這個升降塔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260802
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260802,
					"content": "你剛才該不會是瞎猜的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730260803
					]
				},
				{
					"id": 730260803,
					"content": "呃…畢竟我之前也只是在文獻裡讀過這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260804
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260804,
					"content": "況且就算是在教令院，能看懂這個藍圖的也不會超過三個人，就算是猜對了也是很厲害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260805
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260805,
					"content": "總之既然這個升降塔可以正常使用，接下來只要啟動中層的中繼裝置，應該就可以去到上面駕駛艙所在的空間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260806
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260806,
					"content": "我看看…中層的裝置應該都在動力室裡，得把四個中繼裝置都啟動才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260807
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260807,
					"content": "如果找不到能用的能量塊的話，把它們暫時從裝置中取出也是可以的。反正只要最後都能連通就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260808
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260808,
					"content": "#那麼我就繼續在這裡等{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加扎里"
				}
			]
		},
		{
			"id": 7302609,
			"completionStepIds": [
				7302614
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
