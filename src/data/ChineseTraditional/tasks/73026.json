			},
			"dialogs": [
				{
					"id": 730260701,
					"content": "到處都是精妙的機械，真是人類文明的傑作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730260702
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730260702,
					"content": "這麼珍貴的研究資料，得趕快記錄下來才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加扎里"
				}
			]
		},
		{
