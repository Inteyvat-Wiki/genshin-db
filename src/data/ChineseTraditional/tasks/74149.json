				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490501,
					"content": "#{F#妳}{M#你}們忙完了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490502
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490502,
					"content": "是的，勒魯瓦先生。那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490503,
					"content": "想要糖果還是想要報酬當零用錢啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490504
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490504,
					"content": "都…都想要，嘿嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490505,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490506
					]
				},
				{
					"id": 741490506,
					"content": "貪心的孩子，哈哈哈！沒關係，小孩子嘛，都是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490507
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490507,
					"content": "尤其是像派蒙這樣可愛的小女孩，就應該吃著馬卡龍、穿著漂亮的小裙子、住在漂亮的屋子裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490508
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490508,
					"content": "#我也這麼覺得！{NICKNAME}、{NICKNAME}，我可不可以買…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490509,
					"content": "不可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490510
					]
				},
				{
					"id": 741490510,
					"content": "#嗚嗚，討厭！{NICKNAME}好小氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490511,
						741490512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490511,
					"content": "派蒙，我們是冒險家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				},
				{
					"id": 741490513,
					"content": "但是這跟馬卡龍、小裙子還有漂亮的大房子有什麼關係嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490514,
					"content": "#看看{F#妳}{M#你}們兩個，怎麼鬥起嘴來了？真是孩子氣。不過可以像這樣鬥嘴也很好，證明{F#妳}{M#你}們都還是孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490515,
						741490516
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490515,
					"content": "其實我的年紀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490517,
					"content": "童年是不會長久的，要珍惜啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490518
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490518,
					"content": "#好了好了，報酬和甜點都給{F#妳}{M#你}們，就別鬧了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490519
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490519,
					"content": "好耶，有點心！謝謝勒魯瓦先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490520,
					"content": "叫我伯努瓦就可以了，勒魯瓦是我的姓氏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490521
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490521,
					"content": "整個楓丹廷現在只有我一個勒魯瓦了，特地強調姓氏只會讓我這個老人寂寞，還是叫名字吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490522
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490522,
					"content": "勒…伯努瓦的女兒難道不姓勒魯瓦嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490523,
					"content": "莫蒂西婭和我沒有血緣關係，她是我半年前收養的女兒。不過對我來說，她就和親生的女兒一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490524
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490524,
					"content": "#{F#妳}{M#你}們願意的話明天也可以來，那時候莫蒂西婭和阿托斯就會回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490525
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490525,
					"content": "請兩個可愛的孩子幫點小忙、吃些點心，我想莫蒂西婭是不會有意見的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490526
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490526,
					"content": "#偶爾也會有其他孩子到我這裡來，{F#妳}{M#你}們可以一起玩。我很喜歡小孩子，小孩子多，家裡熱鬧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490527
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490527,
					"content": "#以後{F#妳}{M#你}們來的時候，如果沒有見到我就敲門問問，阿托斯會幫{F#妳}{M#你}們開門的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490528
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490528,
					"content": "那就說好啦！明天我們會再來的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490529,
					"content": "好，好，剛好我也要進屋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490530
					],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490530,
					"content": "明天再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490531
					]
				},
				{
					"id": 741490531,
					"content": "再會，孩子們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伯努瓦·勒魯瓦"
				},
				{
					"id": 741490516,
					"content": "這是關係好的證明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490517
					]
				},
				{
					"id": 741490512,
					"content": "派蒙，不要忘記旅行的目的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490513
					]
				}
			]
		},
