			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"歐芙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741490101,
					"content": "關於新工作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490102
					]
				},
				{
					"id": 741490102,
					"content": "#哦？看來對{F#妳}{M#你}而言，〈人間百態〉的委託工作太沒有挑戰性了？還是說…{F#妳}{M#你}最近手頭緊，缺摩拉了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490103,
						741490105
					],
					"speakerTitle": "歐芙"
				},
				{
					"id": 741490103,
					"content": "摩拉永遠不嫌多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490104
					]
				},
				{
					"id": 741490104,
					"content": "嗯哼，這種心態是很常見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "歐芙"
				},
				{
					"id": 741490107,
					"content": "我這裡最不缺的就是委託工作，除了冒險家協會，蒸汽鳥報社大概算是全楓丹廷最大的僱傭資訊集散地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490108
					],
					"speakerTitle": "歐芙"
				},
				{
					"id": 741490108,
					"content": "雖然理論上來說，我們沒有必要承擔這樣的社會作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490109
					],
					"speakerTitle": "歐芙"
				},
				{
					"id": 741490109,
					"content": "#總之，既然{F#妳}{M#你}需要摩拉，那我推薦一個長期的工作給{F#妳}{M#你}好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490110
					],
					"speakerTitle": "歐芙"
				},
				{
					"id": 741490110,
					"content": "這是勒魯瓦先生大半年前在我們〈人間百態〉版塊的留言，勒魯瓦先生我們這條街的人都認識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490111
					],
					"speakerTitle": "歐芙"
				},
				{
					"id": 741490111,
					"content": "雖然他年輕的時候名聲不太好，不過這幾年我是沒有再聽說過他有什麼不好的傳聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490112
					],
					"speakerTitle": "歐芙"
				},
				{
					"id": 741490112,
					"content": "他一輩子都是自己一個人，唯一的女兒又不在身邊，身邊也沒人照顧他，的確需要一位兼職看護幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490113
					],
					"speakerTitle": "歐芙"
				},
				{
					"id": 741490113,
					"content": "據我所知，勒魯瓦先生不缺錢，所以給的報酬應該不會太低。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490114
					],
					"speakerTitle": "歐芙"
				},
				{
					"id": 741490114,
					"content": "我想這份工作沒什麼風險，報酬也不錯，不妨考慮看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490115
					],
					"speakerTitle": "歐芙"
				},
				{
					"id": 741490115,
					"content": "只要幫忙做做家務就好了嗎？我覺得這份工作很好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741490116,
					"content": "請給我他的地址。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490117
					]
				},
				{
					"id": 741490117,
					"content": "#好啊。勒魯瓦先生的房子{F#妳}{M#你}轉過兩個街角，然後再繞到…啊算了，我畫一張地圖好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490118
					],
					"speakerTitle": "歐芙"
				},
				{
					"id": 741490118,
					"content": "#記得跟他說是我介紹{F#妳}{M#你}們去的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歐芙"
				},
				{
					"id": 741490105,
					"content": "都有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741490106
					]
				},
				{
					"id": 741490106,
					"content": "還真是個努力的年輕人啊…也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741490107
					],
					"speakerTitle": "歐芙"
				}
			]
		},
		{
			"id": 7414902,
			"completionStepIds": [
				7414902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
