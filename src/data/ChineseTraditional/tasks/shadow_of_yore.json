	"talks": [
		{
			"id": 1102002,
			"completionStepIds": [
				1102002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102002",
							"2"
						],
						"stepId": 1102002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110200201,
					"content": "哦？沒想到會在這裡遇見你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200202
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200202,
					"content": "這兩位是你的朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200203
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200203,
					"content": "#嗯，前段時間有幸識得，{NICKNAME}，見多識廣，博學多才。與之相處，倍感投緣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200204
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200204,
					"content": "#剛剛我們聊到「歷史上的岩王帝君」這個話題，{F#妳}{M#你}有興趣聽一聽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200205
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200205,
					"content": "這位先生，好像輕看了岩王爺的神力。作為專業的考古學家，我想糾正他的一些觀點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200206,
						110200207
					],
					"speakerTitle": "翰學"
				},
				{
					"id": 110200206,
					"content": "他、他其實…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200208
					]
				},
				{
					"id": 110200208,
					"content": "我們正在討論，「歷史上第一枚摩拉」的下落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200209
					],
					"speakerTitle": "翰學"
				},
				{
					"id": 110200209,
					"content": "歷史上的第一枚摩拉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200210,
					"content": "眾所周知，在岩王爺的指引下，璃月先民冶煉礦石，用最初的貨物與世間諸國展開貿易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200211
					],
					"speakerTitle": "逸軒"
				},
				{
					"id": 110200211,
					"content": "如今的璃月，掌握了全大陸摩拉的唯一鑄造之權。而世上第一枚摩拉，應該就是在數千年前，岩王爺親手鑄造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200212
					],
					"speakerTitle": "逸軒"
				},
				{
					"id": 110200212,
					"content": "根據我的考證…再加上一點猜測，我認為這枚具有歷史意義的摩拉，可能是作為一種「信物」，秘密傳承了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200213
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200213,
					"content": "比如…掌管璃月的「七星」，會不會在每一代上任之前，都有什麼不為外人所知的儀式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200214
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200214,
					"content": "不不不，按照我的研究，這「第一枚摩拉」的地位，可沒這麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200215
					],
					"speakerTitle": "翰學"
				},
				{
					"id": 110200215,
					"content": "眾所周知，摩拉是一種觸媒。直到今天，也流傳著利用摩拉在神秘學中的功效，來強化武器的奇術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200216
					],
					"speakerTitle": "翰學"
				},
				{
					"id": 110200216,
					"content": "世上第一枚摩拉，一定蘊含著最強的力量。所以我的下一本歷史著作，就是要大膽論證我十年來潛心研究的最新成果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200217
					],
					"speakerTitle": "翰學"
				},
				{
					"id": 110200217,
					"content": "那就是——岩王爺用這枚摩拉作為觸媒，強化了一刀一劍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200218
					],
					"speakerTitle": "翰學"
				},
				{
					"id": 110200218,
					"content": "一刀一劍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200219,
					"content": "哼哼哼，到時就請購買著作閱讀全文了。現在我只揭秘一小部分：得到刀就可以成為璃月至尊，拔出劍就可以加冕璃月之王——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200220
					],
					"speakerTitle": "翰學"
				},
				{
					"id": 110200220,
					"content": "…不敢苟同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200221
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200221,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200222
					],
					"speakerTitle": "翰學"
				},
				{
					"id": 110200222,
					"content": "且不提這刀劍考據的真實性…所謂摩拉，所謂金錢，誕生的初衷，只是一種方便「契約」簽立的籌碼而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200223
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200223,
					"content": "引導人類利用摩拉進行交易，才是帝君本意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200224
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200224,
					"content": "想必「世上第一枚摩拉」，也只是被帝君當作普通的錢幣，簡簡單單地花掉了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200225
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200225,
					"content": "唔…我覺得翰學先生的假說很有道理，倒是這位鍾離先生，無憑無據的，就這麼看輕岩王爺的深遠謀劃？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200226
					],
					"speakerTitle": "逸軒"
				},
				{
					"id": 110200226,
					"content": "不…我的說法不含褒貶，只是在陳述一種事實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200227
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200227,
					"content": "得了吧，是你懂岩王爺還是我懂岩王爺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200228,
						110200229
					],
					"speakerTitle": "翰學"
				},
				{
					"id": 110200228,
					"content": "他、他其實…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200230
					]
				},
				{
					"id": 110200230,
					"content": "歷史之事，我只略通一二，豈敢自詡。但如果觀念沒有分歧，研討也就失去了意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200231
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200231,
					"content": "那我問你，千百年前，璃月港大興土木，岩王爺傳授人民建築技藝。他使用的示範模型，全是用摩拉熔鑄的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200232
					],
					"speakerTitle": "逸軒"
				},
				{
					"id": 110200232,
					"content": "確有此事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200233
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200233,
					"content": "好，你說，如果不是因為看重摩拉的神力特質，岩王爺又為何要做出如此奢侈的行為？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200234
					],
					"speakerTitle": "翰學"
				},
				{
					"id": 110200234,
					"content": "這很容易解釋。因為對帝君來說，摩拉是最容易獲得的，成本最低的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200235
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200235,
					"content": "唔、唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200236
					],
					"speakerTitle": "翰學"
				},
				{
					"id": 110200236,
					"content": "就像在說別人的故事一樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200237
					]
				},
				{
					"id": 110200237,
					"content": "呵呵，本來就是岩王帝君的故事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200238
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200238,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200239
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200239,
					"content": "這位先生！那個…我有些考古學方面的問題，想換一個安靜的地方，向你請教。不知會不會打擾先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200240
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200240,
					"content": "#哦，這倒無妨。不過，不知我的這位朋友方便一起來嗎？說不定{F#她}{M#他}能提供更多幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200241,
						110200242
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200241,
					"content": "我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200243
					]
				},
				{
					"id": 110200243,
					"content": "先生都這麼說了，那當然歡迎！我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200242,
					"content": "就當作來聽聽故事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200243
					]
				},
				{
					"id": 110200229,
					"content": "也許沒人比他更懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200230
					]
				},
				{
					"id": 110200207,
					"content": "也許沒人比他更懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200208
					]
				}
			]
		},
		{
			"id": 1102003,
			"completionStepIds": [
				1102003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1102003",
							"2"
						],
						"stepId": 1102003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宛煙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110200301,
					"content": "接下來說的話，對岩神有些不敬，會招來很多白眼，所以…還是安靜的地方比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200302
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200302,
					"content": "方才見先生談吐不凡，思維清晰，最關鍵的是不輕信吹噓與演繹，非常客觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200303
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200303,
					"content": "所以我想問先生一個問題，或許能得到與普通學者不同的答案…先生覺得，被岩神殺死的魔神，全都是邪惡的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200304
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200304,
					"content": "…善與惡，暫且不論。岩王帝君尊重「契約」，所以死於他手的魔神，一定是打破了某種「契約」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200305
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200305,
					"content": "嗯，至少濫殺無辜這種事，岩王爺是不會做的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200306,
					"content": "可是，我在考古的時候，瞭解到一些關於「鹽之魔神」的傳說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200307
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200307,
					"content": "「鹽之魔神」赫烏莉亞…她是一位善良的魔神，卻還是在戰爭中被摩拉克斯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200308
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200308,
					"content": "被摩拉克斯，用不光彩的手段…暗殺了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200309
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200309,
					"content": "啊？不會吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200310,
					"content": "這…確實是說來話長的一段歷史。但故事的真相，可能並不是妳想知道的那種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200311
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200311,
					"content": "沒關係，請把你知道的歷史都告訴我吧！這件事…這件事，我已經調查很久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200312,
						110200314
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200312,
					"content": "鍾離看起來有點為難。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200313
					]
				},
				{
					"id": 110200313,
					"content": "不…只是，該從哪裡說起呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200316
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200316,
					"content": "哦，在這在這！鍾離先生！哎呀，找了好久，沒想到你在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200317,
						110200318
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110200317,
					"content": "愚人眾？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200319
					]
				},
				{
					"id": 110200319,
					"content": "放下武器！保持距離！不然…不然我要報告千岩軍了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200320,
					"content": "首先我就沒有拿武器啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200321
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110200321,
					"content": "呃…反應不用這麼激烈，我是至冬國來的考古研究員，不是來找麻煩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200322
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110200322,
					"content": "愚人眾每次都這麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200323,
					"content": "這次，已經和璃月總務司報備過了。你們想看的話，我這裡有官方的許可文書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200324
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110200324,
					"content": "我會在璃月進行一段時間的考古勘探，所有的勘探結果，都會和官方共用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200325
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110200325,
					"content": "而我聽說，往生堂有位客卿，名叫鍾離，博古通今，知識淵博。我就向往生堂支付了重金，聘請他當我的顧問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200326
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110200326,
					"content": "也就是說，是往生堂的工作，對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200327,
						110200328
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200327,
					"content": "怎麼辦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200329
					]
				},
				{
					"id": 110200329,
					"content": "既然是工作，那就沒辦法了。身為往生堂的客卿，就要尊重這個身分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200330
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200330,
					"content": "果然是通情達理之人！那我們現在就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200331
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110200331,
					"content": "稍等，如果是考古的話，我也可以一起去嗎？我也是考古學家，可以提供很多幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200332
					],
					"speakerTitle": "宛煙"
				},
				{
					"id": 110200332,
					"content": "#那剛剛的話題，路上有機會再繼續講吧。對了，{NICKNAME}，{F#妳}{M#你}也一起來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200333,
						110200334
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200333,
					"content": "為什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200335
					]
				},
				{
					"id": 110200335,
					"content": "#接下來的經歷，或許會對{F#妳}{M#你}未來的旅途有所幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200336
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200336,
					"content": "#那是七神體系建立之前的故事…雖然魔神已逝，不可能是{F#妳}{M#你}的尋訪目標，但至少，也能為{F#妳}{M#你}的旅行見聞增添一些意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200337
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200337,
					"content": "等等，這是考古小隊，不是觀光團！人太多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200338
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110200338,
					"content": "可是，我這位朋友，有一項無人能及的尋寶天賦，對我們的考古之行大有裨益。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200339
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200339,
					"content": "哦？什麼天賦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200340
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110200340,
					"content": "——絕不會漏過任何一個視線之內的寶箱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200341
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 110200341,
					"content": "我也擅長這個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110200342,
					"content": "…確實有點吸引力，好吧好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200343
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110200343,
					"content": "事不宜遲，我們先去看看，不久前那位「漩渦之魔神」被群玉閣鎮壓時，會不會有什麼東西沖刷上岸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200344
					],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110200344,
					"content": "古物也好，痕跡也好，要是有一點點魔神肢體的碎片就更好了…總之，說不定能有大收穫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "克列門特"
				},
				{
					"id": 110200334,
					"content": "其實我不太懂考古。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200335
					]
				},
				{
					"id": 110200328,
					"content": "我覺得謹慎一點比較好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200329
					]
				},
				{
					"id": 110200318,
					"content": "老實點！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200319
					]
				},
				{
					"id": 110200314,
					"content": "是這麼複雜的故事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110200315
					]
				},
				{
					"id": 110200315,
					"content": "嗯，不知該從哪裡說起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110200316
					],
					"speakerTitle": "鍾離"
				}
			]
		},
