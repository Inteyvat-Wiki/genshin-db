	"talks": [
		{
			"id": 1103202,
			"completionStepIds": [
				1103203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103203",
							"2"
						],
						"stepId": 1103203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慧心",
					"甘雨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320201,
					"content": "#甘雨前輩，感謝您的賞光。還有這二位，也感謝{F#妳}{M#你}們能來捧場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320202
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320202,
					"content": "小事小事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110320203,
					"content": "辛苦慧心安排了，明明不用如此費周折的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320204
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320204,
					"content": "呵呵，其實…甘雨前輩，除了感謝您之前的幫助，還有些事情想要跟您講…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320205
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320205,
					"content": "哦？有什麼需要幫忙的，妳都可以跟我直說，不需要避諱什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320206
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320206,
					"content": "啊…不不，其實也不算是需要幫忙…嗯…您可以慢慢聽我說嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320207
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320207,
					"content": "我非常願意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320208
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320208,
					"content": "呵呵…我從很小很小的時候，就曾聽父親講過很多有關甘雨前輩的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320209
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320209,
					"content": "雖然我對父親也一直非常敬佩，但每次都還是會被甘雨前輩的溫柔可靠所吸引…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320210
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320210,
					"content": "我那時是如此嚮往著您的身影，也正是因此才決定來到月海亭工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320211
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320211,
					"content": "原來在妳眼裡的我，是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320212
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320212,
					"content": "不過事實上，作為月海亭秘書的工作還是非常辛苦的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320213
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320213,
					"content": "我沒有您那樣優秀的工作能力，因而時不時總是會懷疑自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320214
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320214,
					"content": "沒有的事，慧心已經做得很好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320215
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320215,
					"content": "呵呵，謝謝前輩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320216
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320216,
					"content": "這些年，我也有了自己的女兒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320217
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320217,
					"content": "欸！原來天叔已經當爺爺了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110320218,
					"content": "我的女兒在我的薰陶下，如今也繼承了我當年的理想——成為月海亭的秘書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320219
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320219,
					"content": "起初我會有些擔心，畢竟這份工作並不容易，目前也還看不出她是否有這樣的資質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320220
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320220,
					"content": "但經過這次的事之後…我現在很堅定，會選擇支持她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320221
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320221,
					"content": "欸，是什麼會讓妳覺得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320222
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320222,
					"content": "因為她以後也會遇上一位叫做甘雨的前輩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320223
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320223,
					"content": "甘雨前輩會溫柔地幫助她，並且跟她說，妳媽媽當年是這樣做的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320224
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320224,
					"content": "想到那副畫面，可真是美好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320225
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320225,
					"content": "所以——二十年後的事也拜託前輩您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320226
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320226,
					"content": "慧心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320227
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320227,
					"content": "…我、我從沒想過，我的存在對妳來說還有這樣的意義…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320228
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320228,
					"content": "呵呵，就像前輩您之前向我展示我父親的做法一樣，有您在「見證」，就會讓人感覺很安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320229
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320229,
					"content": "「見證」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320230
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320230,
					"content": "…我確實，在見證著璃月港這幾千年的時光。不論發展變遷，還是人情世故…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320231
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320231,
					"content": "但我曾以為，這除了帶給我孤獨之外，並沒有什麼其他的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320232
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320232,
					"content": "慧心，妳剛才的話對我來說，非常重要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320233
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320233,
					"content": "讓我真正感覺到，除了岩王帝君與我訂下的「契約」外，我與璃月港的這片人海之間的聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320234
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320234,
					"content": "體會到被依賴，被認可，被渴望見證的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320235
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320235,
					"content": "當然了，您可是我們獨一無二的甘雨前輩呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320236
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320236,
					"content": "呵呵…是啊，所以要好好回應大家才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320237
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320237,
					"content": "這才對嘛！甘雨小姐終於振作起來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110320238,
					"content": "哪怕我真的被排擠了，我也希望還能爭取一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320239
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320239,
					"content": "為了不辜負妳對我的託付，我也還想繼續履行「契約」，繼續作為「七星」的秘書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320240,
						110320241
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320240,
					"content": "唉…我從一開始就說過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				},
				{
					"id": 110320242,
					"content": "總之，我現在要回去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320243
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320243,
					"content": "沒有我在的話，那些事務的處理恐怕正亂作一團吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320244
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320244,
					"content": "工作，工作，沒時間可以這樣浪費了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320245
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320245,
					"content": "請加油！甘雨前輩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320246
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110320246,
					"content": "欸欸！就這樣要走了嗎，我還沒吃飽呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110320241,
					"content": "妳被排擠的事是場誤會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110320242
					]
				}
			]
		},
		{
			"id": 1103203,
			"completionStepIds": [
				1103204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1103204",
							"2"
						],
						"stepId": 1103204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"百曉",
					"百識",
					"百聞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110320301,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320302
					],
					"speakerTitle": "百識"
				},
				{
					"id": 110320302,
					"content": "阿識，妳還好嗎…難道說站著睡著了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320303
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110320303,
					"content": "妳們看…妳們看看是誰來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320304
					],
					"speakerTitle": "百曉"
				},
				{
					"id": 110320304,
					"content": "居然還有閒情雅致在這裡偷懶，看來妳們確實有接替我的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320305
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320305,
					"content": "沒有沒有！我們只是…真的連續工作了太久，如果不出來稍微歇歇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320306
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110320306,
					"content": "恐怕就熬不到見到甘雨小姐的這天了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320307
					],
					"speakerTitle": "百曉"
				},
				{
					"id": 110320307,
					"content": "甘雨小姐，我們好想妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320308
					],
					"speakerTitle": "百識"
				},
				{
					"id": 110320308,
					"content": "唔，我好像和各位只有過一面之緣而已，竟然說得這麼親昵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320309
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 110320309,
					"content": "因為我們最近日日夜夜都在盼著您回來，把工作重新接手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320310
					],
					"speakerTitle": "百聞"
				},
				{
					"id": 110320310,
					"content": "您的出現對我們來說，就像仙人下凡拯救蒼生一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320311
					],
					"speakerTitle": "百識"
				},
				{
					"id": 110320311,
					"content": "以往那些不服輸的心情都已經不重要了，只想快點從這繁重的工作解脫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320312
					],
					"speakerTitle": "百曉"
				},
				{
					"id": 110320312,
					"content": "好了好了，我知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110320313
