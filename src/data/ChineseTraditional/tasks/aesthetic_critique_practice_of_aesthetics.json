					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100501,
					"content": "很好！這些顏料夠我用一段時間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100502
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100502,
					"content": "你千萬別把顏料倒進水裡喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100503
					]
				},
				{
					"id": 240100503,
					"content": "倒進水裡？哈哈哈哈哈，我的畫法確實和您說的差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100504
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100504,
					"content": "但我是把顏料擠出來，直接倒在畫布上，用刮刀和鏟子畫畫，這樣才能做出讓人印象深刻的筆觸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100505
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100505,
					"content": "多謝您幫忙，有了這些顏料我就能繼續畫畫了，您要是有空的話，可以多過來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100506
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100506,
					"content": "我這次的創作之所以能順利開始，也都是多虧了您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100507
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240100507,
					"content": "等這幅畫完成的時候，我希望您是第一個來欣賞的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				}
			]
