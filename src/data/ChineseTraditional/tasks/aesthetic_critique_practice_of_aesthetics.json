			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"布希柯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240100201,
					"content": "#{F#妳}{M#你}好，想要買什麼東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100202
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 240100202,
					"content": "關於德皮耶里的顏料…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240100203
					]
				},
				{
					"id": 240100203,
					"content": "#噢，{F#妳}{M#你}是來替他拿顏料的嗎？我已經準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100204
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 240100204,
					"content": "這傢伙的顏料也用得太快了，幾乎就像是把顏料買了之後直接倒進水裡一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100205
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 240100205,
					"content": "#好了，他買的顏料都在這裡了，{F#妳}{M#你}拿給他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布希柯"
				}
			]
		},
		{
