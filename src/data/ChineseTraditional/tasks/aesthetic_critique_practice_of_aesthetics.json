			"dialogs": [
				{
					"id": 240100301,
					"content": "不能被具象的形體影響…必須得把美感抽離出來，再用象徵性的手法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240100302
					],
					"speakerTitle": "德皮耶里"
				},
				{
