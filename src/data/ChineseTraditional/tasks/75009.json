			"dialogs": [
				{
					"id": 750090201,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090202
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090202,
					"content": "這個小球…看起來像是零件之類的東西，你喜歡這個嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750090203,
					"content": "唔…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090204
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090204,
					"content": "雖然不是挖出來的東西，但畢竟還是在這裡發現的…說不定也有很高的價值呦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750090205,
					"content": "離開的時候去問問看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
