			"dialogs": [
				{
					"id": 750090101,
					"content": "…進場三百摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090102,
						750090103
					],
					"speakerTitle": "奎皮亞"
				},
				{
					"id": 750090102,
					"content": "可以算便宜一點嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090105
					]
				},
				{
					"id": 750090105,
					"content": "這是龍遺物研究協會規定的價格，沒有商量的餘地。據我所知，這裡已經是定價最低的挖掘場了，畢竟開發得早。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090106
					],
					"speakerTitle": "奎皮亞"
				},
				{
					"id": 750090106,
					"content": "#不過現在偶爾也會有像{F#妳}{M#你}們這樣的夢想家來碰碰運氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090107
					],
					"speakerTitle": "奎皮亞"
				},
				{
					"id": 750090107,
					"content": "說不定是之前的一百人——甚至一千人都沒有眼光，遺漏了那看似平平無奇，實則價值連城的珍貴龍遺物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090108
					],
					"speakerTitle": "奎皮亞"
				},
				{
					"id": 750090108,
					"content": "願意花三百摩拉做個美夢的可是大有人在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090109
					],
					"speakerTitle": "奎皮亞"
				},
				{
					"id": 750090109,
					"content": "#那麼，{F#妳}{M#你}也相信自己才是那個獨一無二的幸運兒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090110
					],
					"speakerTitle": "奎皮亞"
				},
				{
					"id": 750090110,
					"content": "嗚…呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090111,
						750090112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090111,
					"content": "我對自己的運氣有信心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090113,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}也想去碰碰運氣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750090114,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090115
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750090115,
					"content": "看樣子是很有興趣哦。哼哼，區區三百摩拉，就由我來出好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750090116,
					"content": "只要三百摩拉就可以買到三份希望，還是很划算的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750090117,
					"content": "那就祝幾位旗開得勝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奎皮亞"
				},
				{
					"id": 750090112,
					"content": "無所謂，我有幸運小龍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090113
					]
				},
				{
					"id": 750090103,
					"content": "只要打敗你就是免費對吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750090104
					]
				},
				{
					"id": 750090104,
					"content": "正常不會這樣想啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750090105
					],
					"speakerTitle": "派蒙"
				}
			]
		},
