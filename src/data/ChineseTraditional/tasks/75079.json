			"dialogs": [
				{
					"id": 750791901,
					"content": "真傷腦筋啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791902,
						750791905
					],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750791902,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791903
					]
				},
				{
					"id": 750791903,
					"content": "是這樣，我有一個年紀差得滿多的弟弟，可能正是叛逆的年紀吧？和誰都處不來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791904
					],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750791904,
					"content": "#唉呀，說給{F#妳}{M#你}聽也是徒增煩惱吧…等他再長大一點說不定就好了，嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉瓦"
				},
				{
					"id": 750791905,
					"content": "打擾了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750791906
					]
				},
				{
					"id": 750791906,
					"content": "沒關係，再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉瓦"
				}
			]
