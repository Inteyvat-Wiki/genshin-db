				"points": []
			},
			"dialogs": [
				{
					"id": 750875101,
					"content": "#我們這裡還有幾項飛行挑戰，詳細內容都寫在告示牌上了。如果{F#妳}{M#你}有興趣不妨試一試，當然也會有相應的獎勵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875102,
						750875103,
						750875104
					],
					"speakerTitle": "特馬喬"
				},
				{
					"id": 750875102,
					"content": "關於帕帕卡飛行學校…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875105
					]
				},
				{
					"id": 750875105,
					"content": "#其實我也不知道為什麼會叫這個名字，講到帕帕卡…{F#妳}{M#你}有聽過昆圖爾和壞巫師茹米的故事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875106
					],
					"speakerTitle": "特馬喬"
				},
				{
					"id": 750875106,
					"content": "部族的戰士輸給壞巫師茹米，被他變成了帕帕卡…聽起來好像不是什麼好事？可能帕帕卡真的飛得很快吧，誰知道呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特馬喬"
				},
				{
					"id": 750875103,
					"content": "關於拉密薩納…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875107
					]
				},
				{
					"id": 750875107,
					"content": "哈哈…他是個好手，但不擅長教人。當飛行競賽的對手…還算說得過去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875108
					],
					"speakerTitle": "特馬喬"
				},
				{
					"id": 750875108,
					"content": "要不是飛得不好，誰會來這裡呢？這時候如果太過嚴厲…唉…以前也不是沒發生過這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750875109
					],
					"speakerTitle": "特馬喬"
				},
				{
					"id": 750875109,
					"content": "所以現在的方針已經改成以鼓勵為主了，相信多稱讚也會進步的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特馬喬"
				},
				{
					"id": 750875104,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750875110
					]
				},
				{
					"id": 750875110,
					"content": "#再見，也歡迎{F#妳}{M#你}隨時回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特馬喬"
				}
			]
