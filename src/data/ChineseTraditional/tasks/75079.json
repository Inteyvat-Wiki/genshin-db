			"dialogs": [
				{
					"id": 750876001,
					"content": "歡迎來到帕帕卡飛行學校！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876002,
						750876003
					],
					"speakerTitle": "琪希可"
				},
				{
					"id": 750876002,
					"content": "妳在這裡做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876004
					]
				},
				{
					"id": 750876004,
					"content": "給學員必要的指引和幫助。現在和以前不一樣了，要知道以前是沒有這些貼心服務的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876005
					],
					"speakerTitle": "琪希可"
				},
				{
					"id": 750876005,
					"content": "但是有一次因為教練在指導時言辭有些…嚴厲？偏偏那個學員也是個脾氣火爆的人物…唉，當時的場面我都不願再提。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750876006
					],
					"speakerTitle": "琪希可"
				},
				{
					"id": 750876006,
					"content": "總之自那之後飛行學校就改變指導方針了——伸手不打笑臉人，誰也不會討厭被誇吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琪希可"
				},
				{
					"id": 750876003,
					"content": "先走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750876007
					]
				},
				{
					"id": 750876007,
					"content": "#祝{F#妳}{M#你}度過愉快的一天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琪希可"
				}
