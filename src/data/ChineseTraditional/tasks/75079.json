							135.002,
							9750.383
						],
						"pointId": 8791
					},
					{
						"sceneId": 3,
						"position": [
							-1789.631,
							134.809,
							9749.671
						],
						"pointId": 8792
					},
					{
						"sceneId": 3,
						"position": [
							-1789.85,
							134.993,
							9752.751
						],
						"pointId": 9648
					}
				]
			},
			"dialogs": [
				{
					"id": 750790901,
					"content": "竟然這麼輕鬆就能拿到獎品…要是冒險家協會的委託也都這麼容易就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790902,
					"content": "#{NICKNAME}{M#哥哥你}{F#姐姐妳}們是冒險家嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790903
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790903,
					"content": "我有冒險之證，派蒙沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790904
					]
				},
				{
					"id": 750790904,
					"content": "#哼哼，就算沒有文件，我也可以有冒險家之心嘛！就像我雖然沒有飛行執照，但論飛行技巧的話鐵定不會輸給{NICKNAME}哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790905,
					"content": "你這樣問是有什麼委託想要交給我們嗎？等等，你先不要說，讓我猜猜看，答案只有一個——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790906,
					"content": "#你看到我們和{REALNAME[ID(2)|SHOWHOST(true)]}關係這麼好，是想要請教和小龍融洽相處的訣竅！對不對？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790907,
					"content": "呀！呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790908
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750790908,
					"content": "唉，根本不對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790909
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790909,
					"content": "欸欸？可是剛才拉密薩納他明明就說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790910,
					"content": "問題就出在他身上。那可是個擅長籠絡人心的傢伙，就連奧伯龍也因為吃了他給的龍龍餅乾變得對他言聽計從。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790911
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790911,
					"content": "啊嗚，嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790912
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750790912,
					"content": "擺出一副委屈的樣子也沒用，一流的絨翼龍就是要嚴格控制飲食的，而且你原本就容易胖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790913
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790913,
					"content": "那傢伙還三天兩頭對莉瓦姐姐獻殷勤，絕對是別有用心…莉瓦姐姐也是，一點警戒心都沒有，還跟他有說有笑的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790914
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790914,
					"content": "嗯？怎麼聽起來感覺他人還滿好的？難道不是因為你不喜歡他，所以對他有偏見嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790915
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790915,
					"content": "不是，還不只是這樣，那傢伙最近一段時間鬼鬼祟祟的，不知道在忙些什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790916
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790916,
					"content": "大人總是有很多事要忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790917
					]
				},
				{
					"id": 750790917,
					"content": "對啊，他不是說要舉辦什麼飛行競賽嗎？說不定是在籌備那個啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790918,
					"content": "之前提過要舉辦飛行競賽…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790919
					]
				},
				{
					"id": 750790919,
					"content": "可是他又沒出多少力氣，準備工作都是帕朗在做，這陣子總能看到他和加勒弗大汪四處奔忙，辛苦的是帕朗才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790920
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790920,
					"content": "而且我昨天聽到了！他和外面來的人在小聲商量些什麼危險的事，我不敢靠太近所以沒有聽得很完整，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790921
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790921,
					"content": "「飛行競賽當天準時」、「下手…分寸」、「人命」、「事成之後再付另一半」、「細節明天深夜北部營地詳談」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790922
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790922,
					"content": "怎麼只有後半聽得格外清楚？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790923
					]
				},
				{
					"id": 750790923,
					"content": "那還不是多虧了奧伯龍，那時候不知道為什麼特別不安分，一直想往拉密薩納那邊去，最後我實在是攔不住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790924
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790924,
					"content": "啊嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790925
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750790925,
					"content": "笨蛋，我沒有在誇你啊。總之，看到我追著龍過去，另一個人很快就離開了，剩下來的拉密薩納也表現得很不自然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790926
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790926,
					"content": "他一定是擔心事情敗露，所以今天才用冠冕堂皇的藉口來找我的碴，其實只是為了監視我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790927
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790927,
					"content": "哇，你明明還是個小孩子，想的事情卻很複雜欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790928
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790928,
					"content": "我知道，妳也覺得小孩子的話不可信對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790929
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790929,
					"content": "#所以我想拜託{NICKNAME}{M#哥哥}{F#姐姐}晚上和我一起去北部營地調查看看，萬一他真的在秘密進行什麼危險的計畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790930
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790930,
					"content": "#必須想辦法阻止他！有{NICKNAME}{M#哥哥}{F#姐姐}幫我作證，其他人…莉瓦姐姐也一定會相信我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790931
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790931,
					"content": "#要是{NICKNAME}{M#哥哥}{F#姐姐}覺得我說的這些都是小孩子的胡思亂想，不值得親自去一次，那至少幫我帶個信吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790932
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790932,
					"content": "我已經寫好了一封簡短說明情況的信，如果我明天還沒有回來，就請把這封信轉交給莉瓦姐姐，之後奧伯龍也要拜託她照看了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790933
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790933,
					"content": "等一下等一下！你怎麼越說越嚇人了，應該不會真的有這樣的事吧…唔，可是萬一是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790934
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790934,
					"content": "#{NICKNAME}，不然我們還是調查看看？要是現在置之不理，結果真的出了什麼事的話之後一定會做噩夢的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790935
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790935,
					"content": "#{F#妳}{M#你}們願意幫我嗎？太好了！那{NICKNAME}{M#哥哥}{F#姐姐}，晚上我們一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790936
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790936,
					"content": "交給我們就好了，你留下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750790937
					]
				},
				{
					"id": 750790937,
					"content": "嗯，像調查這類委託，人多反而誤事哦。所以你就留在這裡等我們消息就好了。你看，我是不是很有冒險家的心得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750790938,
					"content": "妳這樣一說…的確很有道理。那我就留在這裡照看奧伯龍好了，還要勸一下莉瓦姐姐不要和拉密薩納走得太近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750790939
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750790939,
					"content": "#那就拜託{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "塔盧加"
				}
			]
		},
