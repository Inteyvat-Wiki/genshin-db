					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉密薩納",
					"塔盧加"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750791701,
					"content": "嘿，你真該改改你那臭脾氣，我這樣說也是為你好，你也過了不懂事的年紀了。就算不是為了你姐，也該為自己考慮考慮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791702
					],
					"speakerTitle": "拉密薩納"
				},
				{
					"id": 750791702,
					"content": "嗚，啊嗚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791703
					],
					"speakerTitle": "奧伯龍"
				},
				{
					"id": 750791703,
					"content": "你看，牠也覺得我說得對哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791704
					],
					"speakerTitle": "拉密薩納"
				},
				{
					"id": 750791704,
					"content": "我們之中如果有誰不懂事那也一定不會是我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750791705
					],
					"speakerTitle": "塔盧加"
				},
				{
					"id": 750791705,
					"content": "欸！你這臭小子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉密薩納"
				}
			]
		},
		{
			"id": 7507918,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_OR",
				"conditions": [
					{
