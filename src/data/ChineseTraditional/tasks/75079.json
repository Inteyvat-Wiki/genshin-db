			},
			"dialogs": [
				{
					"id": 750791601,
					"content": "#別碰，這是獎品。如果{F#妳}{M#你}對獎品有興趣，就先通過特馬喬準備的開放訓練賽道吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉密薩納"
				}
			]
		},
		{
			"id": 7507917,
