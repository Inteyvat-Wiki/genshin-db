			},
			"dialogs": [
				{
					"id": 240010301,
					"content": "果然在這裡，看來牠的情況還不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010302
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010302,
					"content": "詩黛小姐什麼時候才能意識到，小狗不喜歡歌劇，也不喜歡聽她的小說呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010303
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010303,
					"content": "我們回去吧，詩黛小姐一定很著急。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布蕾莘"
				}
			]
