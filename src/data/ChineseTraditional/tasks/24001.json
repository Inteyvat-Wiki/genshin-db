				]
			},
			"dialogs": [
				{
					"id": 240010401,
					"content": "巴里亞！我的寶貝，天哪，你去哪裡了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010402
					],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010402,
					"content": "牠只是找了個清淨的地方待了一下，讓自己稍微放了個假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010403
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010403,
					"content": "我真是擔心得要命，謝謝您布蕾莘警官，我的下一部小說一定會提到您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010404
					],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010404,
					"content": "感謝您的好意，但還是請您省下這些筆墨吧，沒人會對一名警官的日常生活感興趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010405
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010405,
					"content": "那我就將您的故事寫得跌宕起伏…保證有趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010406
					],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010406,
					"content": "您這句有趣的承諾就足夠讓我的心情跌宕起伏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010407
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010407,
					"content": "結尾還要發人深省！讓我想想，安排一個怎樣的隊友給您好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "詩黛"
				}
			]
		},
