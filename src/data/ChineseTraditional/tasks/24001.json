			"dialogs": [
				{
					"id": 240010501,
					"content": "難道是巴里亞不喜歡我新寫的小說？唉，明明其他人都給了不錯的評價…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010502
					],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010502,
					"content": "唉，下次我得挑一篇更好的唸給牠聽了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "詩黛"
