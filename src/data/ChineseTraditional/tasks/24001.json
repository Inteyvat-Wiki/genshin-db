			"dialogs": [
				{
					"id": 240010101,
					"content": "請您幫幫忙吧，我剛才正在想著小說的情節，一個不小心，巴里亞就跑丟了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010102
					],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010102,
					"content": "您確定巴里亞沒有被您留在歌劇院的席位上，或者是拴在洗手間門口嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010103
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010103,
					"content": "這些地方我都找過了。就連座位底下我也看過了，但就是沒有看到巴里亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010104
					],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010104,
					"content": "我的小巴里亞，該不會是被誰給拐走，或者是和誰一見鍾情，懵懵懂懂地就跟著走了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010105
					],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010105,
					"content": "詩黛小姐，我很確定巴里亞不會在這種事情上犯第二次錯誤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010106
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010106,
					"content": "但巴里亞還那麼小…年紀小就會不斷地犯相同的錯誤，說不定巴里亞還會以此為樂啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010107
					],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010107,
					"content": "巴里亞的年紀一定沒有您認知中的那麼小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010108,
						240010109
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010108,
					"content": "巴里亞是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				},
				{
					"id": 240010110,
					"content": "詩黛小姐的小狗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010111
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010111,
					"content": "我的家人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010112
					],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010112,
					"content": "她的家人，剛剛走失了，她正在尋求我的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010113
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010113,
					"content": "…詩黛小姐，這周圍我們已經找了很多次，巴里亞大概已經跑去了野外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010114
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010114,
					"content": "那我們就去野外吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010115
					],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010115,
					"content": "我請求您待在城裡，看看您的裙子，就算找到了巴里亞，您也追不上牠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010116
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010116,
					"content": "胡說，只要聽見我說話，巴里亞一定會馬上跑過來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010117
					],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010117,
					"content": "那我們之前圍著歌劇院喊了那麼久，看來牠是沒聽見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010118
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010118,
					"content": "讓巴里亞乖乖回到詩黛小姐身邊，不是我一個人能做到的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010119
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010119,
					"content": "考慮到我的工作職責，我不可能離開工作地點太久，也不可能讓另外一位同事和我一起暫時離開工作崗位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010120
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010120,
					"content": "旅行者，如果您願意的話，可以幫助我和詩黛小姐嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010121,
						240010122
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010121,
					"content": "是沒問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010124
					]
				},
				{
					"id": 240010124,
					"content": "那這件事就這麼決定了，請您和我一起去野外找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010125
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010125,
					"content": "考慮到巴里亞的體重和體力，想必牠沒辦法跑太遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010126
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010126,
					"content": "巴里亞是非常健康的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010127
					],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010127,
					"content": "如果您是指巴里亞的精神生活的話，我十分讚同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010128
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010128,
					"content": "那我們就出發吧，如果讓巴里亞體會到了在野外的好處，牠說不定就會跑得更遠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010129
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010129,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "詩黛"
				},
				{
					"id": 240010122,
					"content": "警官還會管這種事啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010123
					]
				},
				{
					"id": 240010123,
					"content": "楓丹廷的市民向我請求幫助，我沒有拒絕的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240010124
					],
					"speakerTitle": "布蕾莘"
				},
				{
					"id": 240010109,
					"content": "有什麼麻煩的事情嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240010110
					]
				}
			]
		},
