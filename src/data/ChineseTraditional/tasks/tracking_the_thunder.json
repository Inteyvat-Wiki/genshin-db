				"points": []
			},
			"dialogs": [
				{
					"id": 726530101,
					"content": "#旅行者，{F#妳}{M#你}回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530102
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530102,
					"content": "#{F#妳}{M#你}之前帶回的那些晶片，我在船上研究了一番。看起來它們還很…「年輕」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530103
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530103,
					"content": "這說明它們來自於新形成的元素結團…嗯，打個比方說，就像不久前才在雪地上、比較深的新腳印。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530104
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530104,
					"content": "#而現在呢，我希望{F#妳}{M#你}能幫我調查一下那些比較「淺」的腳印…逆著它們的方向，往源頭追查！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530105
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530105,
					"content": "所謂「更淺的腳印」呢，就是指那些已經凝結到一定程度，在地面附近沉積的雷元素聚合體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530106
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530106,
					"content": "如果能夠取得一定量的樣本加以分類對比，或許能夠畫出大致的路線圖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530107
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530107,
					"content": "什麼…深淺腳印、路線圖的…根本聽不懂呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726530108,
					"content": "唔…真的有點難懂呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726530109
					]
				},
				{
					"id": 726530109,
					"content": "#哈哈，我打的比方可能有點不太貼切，不過{F#妳}{M#你}到了報告地點，自然就會知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726530110
					],
					"speakerTitle": "慕珍"
				},
				{
					"id": 726530110,
					"content": "好了，閒話不多說，快點出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慕珍"
				}
			]
		}
	]
