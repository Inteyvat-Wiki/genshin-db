					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750301512
					]
				},
				{
					"id": 750301512,
					"content": "#這點小事，{F#妳}{M#你}不早說。走這裡就好，我幫{F#妳}{M#你}把草垛弄開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "睏倦的絨翼龍"
				},
				{
					"id": 750301507,
					"content": "沒關係，你睡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750301508
					]
				},
				{
					"id": 750301508,
					"content": "睡了，有事找別的龍。",
