			"dialogs": [
				{
					"id": 750300701,
					"content": "太可惜了，只差一點點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300702
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300702,
					"content": "加油啊，千萬不要放棄！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300703,
						750300706
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300703,
					"content": "怎麼變得這麼積極？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300704
					]
				},
				{
					"id": 750300704,
					"content": "#我能不能解脫就靠{F#妳}{M#你}了，當然要積極面對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300705
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300705,
					"content": "來，休息一下我們再試一次，這次一定可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300708
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300708,
					"content": "#{F#妳}{M#你}放心，我不會放棄{F#妳}{M#你}的。不管試多少次都沒問題。不要失去信心，{F#妳}{M#你}一定做得到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300709
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300709,
					"content": "趕快給我放棄！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300710
					]
				},
				{
					"id": 750300710,
					"content": "#不，我說什麼也不會放棄{F#妳}{M#你}的。我是沒辦法加油了，但是{F#妳}{M#你}可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300711
					],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300711,
					"content": "#要是{F#妳}{M#你}也幫不上忙，我就真的沒有招了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿科米蒂"
				},
				{
					"id": 750300706,
					"content": "我想休息一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750300707
					]
				},
				{
					"id": 750300707,
					"content": "#沒關係，{F#妳}{M#你}好好休息，待會我們再來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750300708
					],
					"speakerTitle": "阿科米蒂"
				}
			]
		},
