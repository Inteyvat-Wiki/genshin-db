			"dialogs": [
				{
					"id": 401730301,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730302
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730302,
					"content": "（居然被那傢伙跑了，這下糗大了…剛剛還一副自信滿滿的樣子，哦天！我的形象…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730303
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730303,
					"content": "（雖然那個谷中出人意料地擅長逃跑，但我也得想個恰當的說辭…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730304
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730304,
					"content": "茜特菈莉！妳抓住那個谷中了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730305,
					"content": "從山洞裡只有奶奶一個人來看，應該是沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730306
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730306,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730307
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730307,
					"content": "我暫時放了他一馬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730308
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730308,
					"content": "不過我在他身上留下了記號，如果他出現在附近，我就能追蹤到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730309
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730309,
					"content": "原來奶奶剛才是假裝離開山洞，實際偷偷躲了起來，準備來個甕中捉鱉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730310
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730310,
					"content": "哦！就跟一開始抓歐洛倫那樣一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730311,
					"content": "不過茜特菈莉怎麼知道那個傢伙會過來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730312,
					"content": "因為我放了誘餌啊。那張燼寂海的地圖和弓的碎片，我刻意把它們留在桌子上，因為它們可能就是谷中的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730313
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730313,
					"content": "果然我們離開沒多久後，我留下的陷阱就被觸發了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730314
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730314,
					"content": "什麼？原來洞裡真的有陷阱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730315,
					"content": "當然，只是會自動忽略你們而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730316
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730316,
					"content": "看，我之前沒亂講吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730317
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730317,
					"content": "谷中先生，原來你真的在利用我…原來你的目的是燼寂海的情報…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730318
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730318,
					"content": "沒錯，我最初就在想，那傢伙為什麼會把碎片留在營地？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730319
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730319,
					"content": "在我得到燼寂海位置的時候，我明白了，那個碎片是誘餌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730320
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730320,
					"content": "他知道勒拉一定會出問題，而部族又不會對勒拉視而不見，一定會有人來幫助勒拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730321
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730321,
					"content": "哦！他在釣魚！釣出真正有能力的人來幫他暝視這塊碎片！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730322,
					"content": "沒錯，而上鉤的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730323
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730323,
					"content": "對不起，是我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730324
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730324,
					"content": "但還有奶奶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730325
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730325,
					"content": "臭小子！我是因為你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730326
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730326,
					"content": "總之，這個谷中真狡猾，選擇了風險最低的一種辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730327
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730327,
					"content": "是啊，如果那傢伙直接去找茜特菈莉，應該一分鐘就會被識破！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730328,
					"content": "那話說回來，茜特菈莉，妳為什麼要放他一馬呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730329,
					"content": "咳…因為這裡不方便施展出全力，那傢伙又很擅長逃跑，強行留下他可能會出問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730330
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730330,
					"content": "難道是我選錯了地方…抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730331
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730331,
					"content": "一開始為了救勒拉，我想找一個靈性比較充足的區域，所以就找到了瘋賢者的地盤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730332
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730332,
					"content": "瘋賢者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730333,
					"content": "沒錯，那傢伙就在那堵牆後面，如果把他吵醒了也是個麻煩，所以我只能收手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730334
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730334,
					"content": "不過現在還有一個好消息——我把地圖和碎片都搶了回來。奶奶我也不是吃素的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730335
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730335,
					"content": "太好了！那傢伙能帶走的就只有他自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730336,
					"content": "唔…可是有一個壞的消息是——他大概已經看過了那個地圖，雖說燼寂海消失時的位置也不算什麼秘辛吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730337
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730337,
					"content": "啊？真令人擔憂，那傢伙不會要做什麼壞事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730338,
					"content": "不用太緊張，我會追蹤那傢伙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730339
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730339,
					"content": "#另外，勒拉，如果你沒意見，我想把地圖和這塊碎片送給{NICKNAME}，這或許對{M#他}{F#她}未來的旅途有幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730340
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730340,
					"content": "#當然！當然沒意見！這是{NICKNAME}應得的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730341
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730341,
					"content": "有點太貴重了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401730342
					]
				},
				{
					"id": 401730342,
					"content": "#反正我們都沒興趣。如果它真的指向了燼寂海，{F#妳}{M#你}這樣的冒險者肯定不願意錯過那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730343
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730343,
					"content": "這是黑曜石奶奶的預感喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730344
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730344,
					"content": "那個，黑曜石奶奶，還有一件事，我現在還是靈性白痴嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730345
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730345,
					"content": "什麼傻問題？你不是察覺了奶奶我的幻影術嗎？雖說是故意露的破綻，但也不是靈性白痴能識破的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730346
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730346,
					"content": "歐洛倫，之後你有空就好好教教這傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730347
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730347,
					"content": "能學多少，勒拉，就全看你自己的本事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730348
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730348,
					"content": "真好啊，人生真是奇妙，只要一直向前走，說不定就會碰到肥料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730349
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730349,
					"content": "勒拉，我為你高興。以後要一起加油啊，希望我們都能成為一顆漂亮的高麗菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "歐洛倫"
				}
			]
		},
