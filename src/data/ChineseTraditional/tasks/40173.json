			"dialogs": [
				{
					"id": 401730101,
					"content": "各位好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730102
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730102,
					"content": "茜特菈莉，妳來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730103,
					"content": "嗯，我去首領那裡請來了一把儀式劍，藉用它的力量可以完成一些事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730104
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730104,
					"content": "都沒忘記我們今天要幹什麼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730105
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730105,
					"content": "當然啦，我們都等著勒拉醒來，好問問他到底是怎麼回事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730106,
					"content": "按照奶奶說的，我也準備好了備用的物品，今天萬無一失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730107
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730107,
					"content": "真不錯，那我們就不多說了，現在就開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730108
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730108,
					"content": "茜特菈莉召出了一把名為「厄水之禍」的儀式劍。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401730109
					]
				},
				{
					"id": 401730109,
					"content": "自秘煙中獻上供奉。星星獻予無月之夜，夢的花環獻予風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730110
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730110,
					"content": "向死之主獻上供奉。褪落。褪落。褪落。往復三重又三重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730111
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730111,
					"content": "嗚哇——這是什麼咒語嗎？突然一下變得好涼！是不是有什麼東西來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730112,
					"content": "小聲一點，現在不能吵到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730113
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730113,
					"content": "我等，祭司王之嗣，要遵循亙古的盟約，撕裂夜域的織帷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730114
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730114,
					"content": "茜特菈莉在此告諭。我為阿庫烏波蒂爾，我為末地的養主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730115
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730115,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730116
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730116,
					"content": "看！勒拉的靈性回來了，正在往他的身上跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730117
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730117,
					"content": "我要用燧石刀刺入夜的斗篷，逐棄一切不屬於亡者之國的魂靈。\\n",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730118
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730118,
					"content": "勒拉！依從敕命，歸來炎日下的地土，歸來你應屬的道途！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730119
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730119,
					"content": "成…成功了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730120,
					"content": "欸…欸？這裡是…？你們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730121
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730121,
					"content": "嗚哇——黑曜石奶奶！不不…茜特菈莉大祭司！請手下留情！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730122
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730122,
					"content": "你這小鬼，看來很清楚自己幹了什麼嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730123
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730123,
					"content": "知道自己差點回不來嗎？把自己變成一具空殼很有趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730124
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730124,
					"content": "對、對不起…請懲罰我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730125
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730125,
					"content": "哦？你是真心的嗎？那就快回家和父母告個別吧，就說：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730126
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730126,
					"content": "「再見了，爸爸媽媽，我喜歡空殼的人生，所以決定去黑曜石奶奶那裡變成一塊石像，替她看家一百年。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730127
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730127,
					"content": "不要啊，我知道錯了！十分感謝茜特菈莉大祭司把我救回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730128
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730128,
					"content": "哼哼，還是謝我孫子吧。要不是他察覺到異常，我是不想管這回事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730129
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730129,
					"content": "不用客氣，勒拉，奶奶只是嘴巴不饒人，我們都不會怪你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730130
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730130,
					"content": "畢竟你受了別人的蠱惑吧？那個谷中才是罪魁禍首。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730131
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730131,
					"content": "不…跟谷中先生沒關係，是我要這樣做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730132
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730132,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730133,
					"content": "雖然是他告訴了我用強大靈物來做媒介的方法，但決定要這麼做的人是我，他並沒有蠱惑我什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730134
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730134,
					"content": "對不起，要怪也只能怪我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730135
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730135,
					"content": "呵呵，這小鬼被洗腦得不輕啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730136
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 401730136,
					"content": "呃…那，那個媒介碎片是他帶來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730137,
					"content": "沒錯，據他說是跟燼寂海相關的寶物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730138
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730138,
					"content": "那這一看就是在利用你吧！利用你幫他暝視！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730139,
					"content": "可是，我只是一個靈性白痴，什麼法術都學不會…我有什麼利用價值呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730140
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730140,
					"content": "像我這樣的傢伙，如果只是打坐冥想，一輩子都沒辦法感知到靈性的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730141
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730141,
					"content": "谷中先生說，如果用別的辦法讓我強行施展法術，把自己浸泡在大量靈性中，反而有機會抓住它們的蹤影。所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730142
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730142,
					"content": "這簡直就是破罐子破摔了啊！要不是茜特菈莉，你可真的就回不來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401730143,
					"content": "對不起…對不起…族裡的大家都是很有才華的人，可是我卻是個白痴…我只是不想再當異類…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730144
					],
					"speakerTitle": "勒拉"
				},
				{
					"id": 401730144,
					"content": "我很理解你…勒拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730145
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730145,
					"content": "有些種子可以毫不費力地長成漂亮的高麗菜，但也有些種子，怎麼努力都沒辦法發芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730146
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730146,
					"content": "我也不知道為什麼會是這樣，可能這就是人生吧？總有很多沒辦法的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730147
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730147,
					"content": "雖然我說這些也沒有用，但希望你能調整好自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401730148
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 401730148,
					"content": "總之，有什麼事之後再說吧，現在先跟我去馬塔拉那裡檢查身體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				}
			]
		},
