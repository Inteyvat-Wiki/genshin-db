			"dialogs": [
				{
					"id": 240040201,
					"content": "…這一頁我應該已經看過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040202,
						240040203
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040202,
					"content": "你在…看書？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				},
				{
					"id": 240040204,
					"content": "#沒想到{M#大哥哥}{F#大姐姐}這麼快就來了，我才剛翻開這本書呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040205
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040205,
					"content": "這本書是洛薇的爸爸特意讓她帶給我的，還說我有什麼不懂的地方可以去問他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040206
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040206,
					"content": "但是…呵呵，說實話這本書我幾乎沒有看得懂的地方啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040207
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040207,
					"content": "#先不說這些，我先回去集合點了，畢竟我已經被{F#妳}{M#你}找到了，玩遊戲就得遵守規則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040203,
					"content": "你還真是時刻不忘學習…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040204
					]
				}
			]
		},
		{
