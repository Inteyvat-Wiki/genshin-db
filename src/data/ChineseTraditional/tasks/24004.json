			"trigger": {
				"objectNames": [
					"韋呂",
					"奧雷勒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240040101,
					"content": "哥哥！我們躲到那邊，一定比她選的位置好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040102
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240040102,
					"content": "別亂跑，韋呂！你要是跑丟了，我可沒辦法馬上把你找回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040103,
						240040104
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040103,
					"content": "你怎麼在這？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				},
				{
					"id": 240040105,
					"content": "#哇！{M#大哥哥}{F#大姐姐}！{F#妳}{M#你}有空嗎？快和我們一起躲起來，洛薇大概早就躲好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040106
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240040106,
					"content": "關於洛薇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040107
					]
				},
				{
					"id": 240040107,
					"content": "來不及說了，快點快點，她超熟悉這裡的…我們得找個更好的地方躲起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040108
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240040108,
					"content": "韋呂飛快地離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						240040109
					]
				},
				{
					"id": 240040109,
					"content": "唉，韋呂這傢伙…什麼時候能聽話點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040110
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040110,
					"content": "抱歉，只能麻煩您再陪我們玩一場了，韋呂不知道為什麼，突然這麼興奮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040111,
						240040114
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040111,
					"content": "也許是因為找到新玩伴了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040112
					]
				},
				{
					"id": 240040112,
					"content": "我也是這麼想。但無論如何，只要韋呂玩得開心就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040113
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040113,
					"content": "不過…這傢伙也太興奮了，應該不會跟洛薇跑去什麼奇怪的地方躲起來吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040118,
					"content": "#{M#大哥哥}{F#大姐姐}，那就只能拜託{F#妳}{M#你}再陪我們玩一次了，麻煩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040119
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040119,
					"content": "那我也得快點去找個位置躲著，不然韋呂就要不高興了，要是他直接在街上哭起來，我就真的徹底沒辦法了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040120
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040120,
					"content": "奧雷勒離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 240040114,
					"content": "關於洛薇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040115
					]
				},
				{
					"id": 240040115,
					"content": "是我們剛認識的一個女生。看我們在玩捉迷藏，也吵著要來玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040116
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040116,
					"content": "她的性格和韋呂差不多，所以這兩個人很喜歡一起玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040117
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040117,
					"content": "而且…她的父親似乎也沒什麼時間陪她玩，這就跟我們兩個差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040118
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040104,
					"content": "你們還在玩捉迷藏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040105
					]
				}
			]
		},
		{
			"id": 2400402,
