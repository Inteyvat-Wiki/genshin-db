			},
			"dialogs": [
				{
					"id": 240040401,
					"content": "#好吧…還是被你找…咦？{M#大哥哥}{F#大姐姐}，{F#妳}{M#你}是誰呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040402
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040402,
					"content": "是奧雷勒和韋呂的朋友啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040403
					]
				},
				{
					"id": 240040403,
					"content": "#喔！我聽他們提起過你，韋呂說{F#妳}{M#你}超擅長玩捉迷藏的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040404
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040404,
					"content": "#今天我算是見識到啦，{M#大哥哥}{F#大姐姐}果然很厲害啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040405
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040405,
					"content": "認輸認輸，我去集合點等著啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "洛薇"
				}
			]
