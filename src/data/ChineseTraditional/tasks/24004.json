			"dialogs": [
				{
					"id": 240040501,
					"content": "你們兩個…為什麼這樣看著我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040502
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040502,
					"content": "哥…你該不會又是躲在哪裡偷偷看書了吧？沒有認真陪我們玩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040503
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240040503,
					"content": "對啊，好不容易玩一次遊戲，認真點啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040504
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040504,
					"content": "好位置都被你們佔著了，我又不擅長捉迷藏…那不就只能看看書打發時間了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040505
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040505,
					"content": "哼！哥哥騙人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040506
					],
					"speakerTitle": "韋呂"
				},
				{
					"id": 240040506,
					"content": "哼！就愛看書！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040507
					],
					"speakerTitle": "洛薇"
				},
				{
					"id": 240040507,
					"content": "你們就饒了我吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040508,
						240040509
					],
					"speakerTitle": "奧雷勒"
				},
				{
					"id": 240040508,
					"content": "你們就饒了他吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240040510
					]
				},
				{
					"id": 240040510,
					"content": "嘿嘿，洛薇超會玩捉迷藏的，還知道很多有趣的地方可以躲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240040517
