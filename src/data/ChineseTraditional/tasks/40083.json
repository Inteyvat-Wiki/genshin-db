			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萊依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400831301,
					"content": "#{NICKNAME}、派蒙。我在賽程上看見{F#妳}{M#你}們順利晉級了，恭喜{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831302
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400831302,
					"content": "喔喔！萊依拉，今天妳很有精神嘛，「轉轉悠悠獸」也開開心心，看來也打了個大勝仗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831303,
					"content": "這次我贏得很驚險，只是勉強贏過對手一線，還好之前有和八重小姐一起去閉關訓練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831304
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400831304,
					"content": "#剛剛「全能商人」託人把我要的東西送過來了，由衷感謝{F#妳}{M#你}們！等等我就帶著「轉轉悠悠獸」去調整狀態…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831305
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400831305,
					"content": "呃咳咳…力氣不夠了…我們還是壓低音量吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831306
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400831306,
					"content": "說起來，怎麼沒有看見神子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831307,
					"content": "八重小姐好像有什麼急事，和左右加小姐他們先走了。好像還有一位「三十人團」的傭兵在為他們領路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831308
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400831308,
					"content": "我回到賽場的時候，他們已經走遠了，追過去問話好像有點唐突…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831309,
						400831310
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400831309,
					"content": "也許她還有工作要忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				},
				{
					"id": 400831311,
					"content": "也對喔，這段時間神子一直在比賽，偶爾去處理一下主編大人的工作也很正常吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831312,
					"content": "而且神子說過，她想一邊度假一邊取材，說不定那個傭兵就是他們的導遊呢，我們也不用擔心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831313,
					"content": "嗯，接下來就是八強賽了，最關鍵的一場比賽…雖然有點害怕，但我們還是一起努力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831314
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400831314,
					"content": "好！這樣看下來，我們晉級還滿順利的嘛，萊依拉一定要加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400831315,
						400831316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831315,
					"content": "我們也不能鬆懈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831317,
					"content": "沒錯，我們要保持警惕！至於從多莉手裡拿到的東西，我們也拍幾張畫片，和今早的畫片放在一起，等到下次見面時給神子看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400831316,
					"content": "要兼顧比賽和調查。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831317
					]
				},
				{
					"id": 400831310,
					"content": "畢竟「八重堂」的事務很多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400831311
					]
				}
			]
		},
