	"talks": [
		{
			"id": 4008305,
			"completionStepIds": [
				4008305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008305",
							"2"
						],
						"stepId": 4008305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子",
					"萊依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830501,
					"content": "神子！對不起！我們沒想到「咚咚小圓帽」劈哩啪啦一頓打，就把左右加小姐給淘汰了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830502,
						400830503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830502,
					"content": "派蒙…馴獸師是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				},
				{
					"id": 400830504,
					"content": "喔？左右加是不是非常氣餒，喃喃自語著「凡人沒法企及」之類的誇張說詞？蹲在地上哀嚎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830505,
					"content": "完全一致呢，妳還真是瞭解她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830506,
					"content": "這樣反而更好，左右加會把這次打擊當成寶貴的素材，生動地描寫出主角成長過程中所受的挫折，牽動讀者們的心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830507,
					"content": "#至於展現反派的壓迫力，和精彩的奪冠過程，就要從{F#妳}{M#你}們身上取材啦。可別在我這個半吊子選手之前被淘汰喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830508,
						400830509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830508,
					"content": "糟了，我成反派了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830510,
					"content": "蹭飯的事先別計較了啦！神子妳千萬要讓左右加小姐筆下留情啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830511,
					"content": "#{NICKNAME}、派蒙，還有八重小姐…呃咳咳咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830512
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400830512,
					"content": "萊依拉，妳小心點啊，好怕妳直接昏倒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830513,
					"content": "我還好…之前我寫信給生論派的學員了，沒想到對方的迴響很熱烈，幾個小時後就回了信，附上了我需要的資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830514
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400830514,
					"content": "根據這些資料，我試著幫「轉轉悠悠獸」做了不少吃的。但可能是因為食材不準確的緣故，「轉轉悠悠獸」不是很喜歡的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830515
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400830515,
					"content": "之後我列出了一份改良版的清單，也包括了「咚咚小圓帽」可能喜歡的食材，結果弄到半夜才睡，所以今天有點呼吸不順暢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830516
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400830516,
					"content": "這麼快就有結果了？效率好高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830517,
					"content": "（只是沒睡好…會呼吸不順暢嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830518
					]
				},
				{
					"id": 400830518,
					"content": "小萊依拉那邊的情況如何？有好好招待對手嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830519
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830519,
					"content": "嗯！多虧八重小姐帶我們去修行，「轉轉悠悠獸」更聽我的話了，反應快得讓我都有些羡慕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830520
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400830520,
					"content": "但對手明顯也變強了，我的壓力有點大。為了打進八強賽，我想和「轉轉悠悠獸」再去訓練一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830521
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400830521,
					"content": "問題在於…我又想在明早七點去找「全能商人」，一次買齊計畫中的所有食材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830522
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400830522,
					"content": "#這很好辦，我陪妳去閉關訓練吧，至於買東西的工作，拜託小傢伙們就好了，{F#她}{M#他}們很擅長幫人跑腿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830523
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830523,
					"content": "#聽起來，{F#妳}{M#你}們兩位好像經常為八重小姐工作呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830524,
						400830525
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400830524,
					"content": "沒錯，我們很樂意！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830526,
					"content": "啊！對對對！請別把我們寫成凶巴巴的壞人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830527,
					"content": "#不用擔心，小萊依拉，{F#她}{M#他}們剛剛還在為打敗左右加的事向我道歉呢，妳先去買杯飲品，喘口氣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830528
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830528,
					"content": "#有勞{F#妳}{M#你}們了！實在感激不盡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830529
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400830529,
					"content": "這裡是我和「全能商人」會面的地址，食材清單也寫在上面了，請收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830530
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400830530,
					"content": "不用這麼客氣啦！妳也調查了「咚咚小圓帽」的喜好，我們這是在互相幫忙，妳就放心去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830531
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830531,
					"content": "關於上次沒有展開的討論，這場比賽背後的「不安定因素」…或許有個不錯的切入點——用來培養蕈獸的素材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830532,
						400830533
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830532,
					"content": "「花花瓊脂」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830534,
					"content": "這可是小說裡最精彩的橋段之一——秘密調查。小傢伙一直很好奇吧？「意智寶珠」和「花花瓊脂」的魔力究竟從何而來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830535
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830535,
					"content": "而且，不弄清楚這場比賽的底細，讓海妮耶只憑自己的意願莽撞行事，或許會鬧出更大亂子喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830536
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830536,
					"content": "嗚…話題突然變得好複雜，我有點聽不懂了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830537,
					"content": "#建議{F#妳}{M#你}們在臨近天亮的時候行動。那段時間，人們通常都很疲憊。也許{F#妳}{M#你}們可以找到關鍵的線索喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830538
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400830538,
					"content": "#{F#妳}{M#你}真的要按神子說的做嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830539,
						400830540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830539,
					"content": "這是最初參賽的理由。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830541,
					"content": "這麼一說也沒錯，那就等到明天凌晨，去培養蕈獸的地方看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830542
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830542,
					"content": "#我們只是在確認比賽的安全程度。我是不會懷疑「咚咚小圓帽」的，{F#妳}{M#你}放心好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830540,
					"content": "這是為了和同伴安心共處。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830541
					]
				},
				{
					"id": 400830533,
					"content": "神子聽說了什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830534
					]
				},
				{
					"id": 400830525,
					"content": "如果不答應，我們的形象就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830526
					]
				},
				{
					"id": 400830509,
					"content": "派蒙蹭反派的飯，派蒙更壞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830510
					]
				},
				{
					"id": 400830503,
					"content": "應該負全責的是我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830504
					]
				}
			]
		},
		{
			"id": 4008308,
