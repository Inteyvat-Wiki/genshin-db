			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"多莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400830901,
					"content": "根據萊依拉的紙條，應該要在這裡和「全能商人」見面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830902,
					"content": "#看{F#妳}{M#你}們東張西望的神態，大概是在找「全能商人」吧？那就歡迎光臨啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830903
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830903,
					"content": "對啊對啊，妳很懂嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830904,
					"content": "不對，怎麼是多莉？萊依拉說的「全能商人」原來就是妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830905,
					"content": "有什麼好奇怪的？「桑歌瑪哈巴依老爺的商品種類最多最神奇」，這是全大巴扎的老闆和客人都知道的事喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830906
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830906,
					"content": "「萬能」、「全能」、「大能」和不管什麼能…都是我多莉的專屬招牌。別的商人想用都免談，除非先付幾百萬授權費！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830907
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830907,
					"content": "呃，我們早該想到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830908,
					"content": "#話說回來，萊依拉居然找{F#妳}{M#你}們跑腿了？看來她真的沉迷在馴獸師大賽裡了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830909
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830909,
					"content": "原來妳和萊依拉的關係還滿好的，對她的情況很瞭解嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830910,
					"content": "嘿！這和關係好壞無關。萊依拉在我這裡買過一些東西，雖然不算特別貴重，但對於一個學員來說，也算是出手闊綽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830911
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830911,
					"content": "我當然會留意她的動向，知道她參加了可疑的比賽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830912,
						400830913
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830912,
					"content": "妳也知道些隱情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				},
				{
					"id": 400830914,
					"content": "#嗯哼，我只是隱隱覺得不對勁罷了。剛好我這裡有些賣不出去的燙手貨，囤著也是生鏽，不如交給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830915
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830915,
					"content": "唔…看起來只是一些零件和殘缺的筆記？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830916,
					"content": "聽說是大賽主辦方試圖銷毀的儀器和文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830917
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830917,
					"content": "他們太大意了，有些人拾荒發財的意願可是很強的！這些東西都被打撈上來轉手給了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830918
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830918,
					"content": "仔細看，這些文件上有些詞彙跟「花花瓊脂」的配方很像呢。儀器殘骸也和「意智寶珠」的一些地方有相似之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830919,
					"content": "說不定是用來實驗的產品。先收起來吧，到時候讓神子看看，也許她能找到不對勁的地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830920,
						400830921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830920,
					"content": "總之可以先假設…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830922,
					"content": "結果我們一開始的擔心好像快要應驗了…我還想和「咚咚小圓帽」無憂無慮地一起玩呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830923
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830923,
					"content": "#雖然不清楚{F#妳}{M#你}們在商量什麼，但看起來這些東西對{F#妳}{M#你}們還滿有用的。就幫{F#妳}{M#你}們打個折好啦，六千萬摩拉，謝謝惠顧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830924
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830924,
					"content": "欸！太狡猾了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830925
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830925,
					"content": "#嘿嘿，開玩笑的，這種東西除了{F#妳}{M#你}們和風紀官也沒人會關心了吧。就當是做了一單普通的生意，給{F#妳}{M#你}們的贈品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830926
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830926,
					"content": "#萊依拉的訂貨單交給我吧，我只需要知道萊依拉想要的究竟是什麼，備貨後就託專人送過去，不勞{F#妳}{M#你}們跑腿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830927
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830927,
					"content": "嚇死我了，我還以為我們要做白工了，算上獎金都不一定能隨便付這麼多錢吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400830928
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400830928,
					"content": "這是萊依拉的訂貨單。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830929
					]
				},
				{
					"id": 400830929,
					"content": "呃啊，摻了松茸末的麵粉、陳年果醬和墩墩桃汁…蕈獸真的會吃這些東西嗎？萊依拉究竟是怎麼知道的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				},
				{
					"id": 400830921,
					"content": "考特里亞有問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830922
					]
				},
				{
					"id": 400830913,
					"content": "妳手裡有情報嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400830914
					]
				}
			]
		},
		{
			"id": 4008313,
