			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪希雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130240301,
					"content": "看樣子就在這裡，我們先躲起來，等待時機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240302
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240302,
					"content": "到時候應該難免會有衝突，我們都要小心一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240303
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240303,
					"content": "#放心啦，{M#他}{F#她}很能打的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240304,
					"content": "哈哈哈，我當然不擔心這個。我說「小心」的意思，是下手輕一點，還得瞭解情報呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240305
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240305,
					"content": "他們好像來了，準備好了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240306
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240306,
					"content": "速戰速決，別給他們反應的時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪希雅"
				}
			]
		},
		{
			"id": 1302405,
			"completionStepIds": [
				1302405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302405",
							"2"
						],
						"stepId": 1302405,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薩塔爾",
					"迪希雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130240501,
					"content": "可…可惡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240502
					],
					"speakerTitle": "薩塔爾"
				},
				{
					"id": 130240502,
					"content": "妳…妳是？「熾鬃之獅」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240503
					],
					"speakerTitle": "薩塔爾"
				},
				{
					"id": 130240503,
					"content": "看來不用多費口舌了，快交代吧，你們和「阿赫瑪爾之鬚」是什麼關係？他們要幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240504
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240504,
					"content": "哼，傭兵拿錢辦事。保護雇主的情報是最基本的原則，妳覺得我會說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240505
					],
					"speakerTitle": "薩塔爾"
				},
				{
					"id": 130240505,
					"content": "你這種話唬外行人或許還有用，說到底這不就是為了捍衛你賺摩拉的信譽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240506
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240506,
					"content": "但做生意還需要很多其他的東西，比如你的手、你的腿、你的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240507
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240507,
					"content": "我給你五秒，仔細考慮一下，雇主的情報是不是真的這麼重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240508
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240508,
					"content": "喂、喂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240509,
						130240510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240509,
					"content": "沒關係。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240511
					]
				},
				{
					"id": 130240511,
					"content": "我沒跟你開玩笑，我很明白輕重，怎麼做才最能讓人痛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240512
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240512,
					"content": "你還有最後兩秒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240513
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240513,
					"content": "哼，不勞妳動手…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240514
					],
					"speakerTitle": "薩塔爾"
				},
				{
					"id": 130240514,
					"content": "喂？！你瘋了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240515
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240515,
					"content": "他咬了自己的舌頭！快，找找貨物裡面有沒有藥品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240516
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240516,
					"content": "迪希雅緊急處理之後，薩塔爾嘴裡的鮮血止住了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130240517
					]
				},
				{
					"id": 130240517,
					"content": "唉，真是沒想到。幸好舌頭受傷不重，他是痛暈過去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240518
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240518,
					"content": "他怎麼會做這種事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240519,
					"content": "我本來只是想和他鬥鬥狠，還以為和某些傭兵一樣，不花力氣就能撬開他的嘴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240520
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240520,
					"content": "沒想到即便選這麼痛苦的方式，他也不願意告訴我們情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240521
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240521,
					"content": "現在怎麼辦，他已經暈過去了…雖然能等他醒過來，但…還是不要繼續了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240522,
					"content": "嗯，放心好了，像他這樣再問一次也是浪費時間，還可能逼他繼續傷害自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240523
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240523,
					"content": "這裡有這麼多貨物，我們從這裡著手查查看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240524
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240524,
					"content": "——我很抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240510,
					"content": "她自有分寸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240511
					]
				}
			]
		},
