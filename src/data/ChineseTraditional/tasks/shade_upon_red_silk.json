						],
						"stepId": 1302401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪希雅",
					"迪娜澤黛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130240101,
					"content": "讓我想想，按之前的計畫，我們還需要買什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240102,
					"content": "哦，好香的味道，是「獸米香香」！我們買一點吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240103,
					"content": "應該不在計畫內？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240104
					]
				},
				{
					"id": 130240104,
					"content": "那…那現在加上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240105,
					"content": "#這不是{NICKNAME}和派蒙嗎？我們居然會在這裡碰到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240106
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240106,
					"content": "#{F#妳}{M#你}們好啊，好久不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240107
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240107,
					"content": "欸？居然又是妳們兩個人的組合，迪希雅妳不是已經回沙漠了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240108,
					"content": "哈哈，只是貼身保鏢的工作不做了而已，又不是鬧翻了。我和迪娜澤黛還是很好的朋友啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240109
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240109,
					"content": "呼瑪伊家也還會招聘，報酬優厚，我和兄弟們當然沒有拒絕的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240110
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240110,
					"content": "這幾天她接了我家的工作，我就讓她直接在家裡住下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240111
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240111,
					"content": "父親和母親都很開心，說之前迪希雅不在，就像家裡少了個人似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240112
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240112,
					"content": "他們太誇張了，總是那麼熱情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240113
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240113,
					"content": "我工作已經完成了，本來打算買點東西就回團裡，老爺卻硬要再留我一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240114
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240114,
					"content": "多待兩三天也沒什麼關係呀，我父親還沒來得及做他的拿手菜給妳呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240115
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240115,
					"content": "妳知道我安靜不下來，小姐。沒關係的，下次還有機會啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240116
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240116,
					"content": "真佩服妳，聽到「拿手菜」三個字也毫不動搖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240117,
					"content": "啊，對了，之前妳說下次再帶我去沙漠，要不然就今天出發吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240118
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240118,
					"content": "還有好多地方我沒看過呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240119
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240119,
					"content": "不好意思，這次還不行，我們團還有一些事要處理，最近沙漠那邊也不太平靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240120
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240120,
					"content": "妳都拖了多久了，上次也是，上上次也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240121
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240121,
					"content": "抱歉、抱歉，再給我一點時間，我好好地幫妳安排一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240122
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240122,
					"content": "好吧，知道了。其實我不是在任性地提要求，而是…某種直覺之類的東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240123
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240123,
					"content": "這次從妳到我們家開始，我就覺得妳行色匆匆、心神不寧的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240124
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240124,
					"content": "是不是妳遇到了什麼棘手的事，才把我們的約定一拖再拖？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240125
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240125,
					"content": "沒有啦，妳想太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240126
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240126,
					"content": "那妳能保證嗎？朋友之間不應該互相欺騙。只要妳點頭，我就不再追問了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240127
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240127,
					"content": "但如果真有什麼事，妳大可和我說實話，我會想辦法幫妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240128
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240128,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240129
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240129,
					"content": "是不是被迪娜澤黛說中了啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240130,
					"content": "唉，小姐妳真是太難纏了，什麼事都瞞不過妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240131
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240131,
					"content": "我本來覺得傭兵圈子裡的事，小姐妳沒必要知道，知道了也只有壞處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240132
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240132,
					"content": "那是個弱肉強食、趨利避害的世界，和這邊太不一樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240133
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240133,
					"content": "但還是那句話，我們是好朋友，不瞭解妳的顧慮，我又要怎麼支持和幫助妳呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240134
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240134,
					"content": "小姐…妳也沒必要這麼固執啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240135
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240135,
					"content": "好吧，實在拗不過妳。我們換個地方吧，這裡不太適合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240136
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240136,
					"content": "就在這裡吧，盡量不要引人注目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240137
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240137,
					"content": "鍍金旅團人數眾多、組成複雜，其中有很多像我一樣的傭兵，四處尋找工作，賺取摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240138
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240138,
					"content": "我的團名叫「熾光獵獸」，規模不大，但團裡接納的都是有血性、講義氣的好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240139
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240139,
					"content": "但還有另一種旅團，為了摩拉可以放棄所有的道德底線。其中最臭名昭著的，名叫「神王之遺」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240140
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240140,
					"content": "神…王？對鍍金旅團的人來說，又是神、又是王的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240141,
						130240142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240141,
					"content": "就是赤王吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240143
					]
				},
				{
					"id": 130240143,
					"content": "#沒錯，我聽說{F#妳}{M#你}們曾經和「阿赫瑪爾之眼」打過交道，他們就是「神王之遺」的附屬團之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240144
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240144,
					"content": "哦，是那個賣神明罐裝知識的團！確實感覺不像好人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240145,
					"content": "「神王之遺」由諸多類似的團組合而成，再由總部從上而下統一管理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240146
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240146,
					"content": "本來平時我對他們都敬而遠之，但這次興風作浪的那個團，名叫「阿赫瑪爾之鬚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240147
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240147,
					"content": "…鬚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240148,
					"content": "就是鬍鬚啦，大概吧。名字很蠢我知道，以前我就很嫌棄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240149
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240149,
					"content": "但重點在於——這是庫塞拉，我父親的團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240150
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240150,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240151,
					"content": "我有點理解妳的難言之隱了…不過他們到底做了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240152
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240152,
					"content": "細節我還是不描述了，小姐。總之就是大量的暴力事件，應該有上百起吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240153
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240153,
					"content": "這麼多？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240154
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240154,
					"content": "嗯，現場往往會非常慘烈，他們會把錢財洗劫一空，然後再滅口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240155
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240155,
					"content": "受害者不只是商隊和普通人，還包括了其他的傭兵團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240156
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240156,
					"content": "這已經敵我不分了，就算再沒底線也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240157
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240157,
					"content": "我不知道「神王之遺」內部對這件事是什麼態度，但近幾年他們越來越猖獗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240158
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240158,
					"content": "如果我再坐視不管的話，我現在的團，還有阿如村的人，不知道什麼時候也會被選為目標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240159
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240159,
					"content": "唉，那傢伙這幾年到底在想什麼啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240160
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240160,
					"content": "妳的父親，原來是這麼可怕的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240161,
					"content": "人都是會變的，以前的他在我的印象裡，雖然沒什麼出息，但做事還有底線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240162
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240162,
					"content": "這評價好像也不高啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240163,
					"content": "唉，不然我怎麼會離開「阿赫瑪爾之鬚」，和他一刀兩斷呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240164
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240164,
					"content": "他大剌剌的，特別吵鬧，性子也很隨便。整天不只不幹正事，而且總是酗酒，還很好色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240165
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240165,
					"content": "團員們也會跟他一起胡鬧，經常一鬧就是一整晚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240166
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240166,
					"content": "哇，就像噩夢一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240167,
					"content": "那妳的母親呢，沒有阻止他們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240168
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240168,
					"content": "…很遺憾，我不知道我的母親是誰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240169
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240169,
					"content": "啊，對不起，迪希雅，我不是故意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240170
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240170,
					"content": "沒事啦，小姐，很多傭兵都這樣。我不是說我父親很好色嗎？我就是這麼生下來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240171
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240171,
					"content": "他說他也搞不清楚我母親是誰，母親她也從來沒有來看過我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240172
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240172,
					"content": "雖然他總說「只要有爸爸在就夠了」，但基本上所有事他都丟給團員去做，只跟我講講故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240173
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240173,
					"content": "關鍵是他的品味又很差勁，會的故事沒幾個，還都是老掉牙過時的那種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240174
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240174,
					"content": "沙城的勇者戰勝了林中的巨龍、傭兵克服萬難終於救出了叛軍手中的公主什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240175
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240175,
					"content": "都是很標準的童話啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240176
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240176,
					"content": "嗯，聽一兩次可能還算新鮮，十幾二十次之後怎樣都會膩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240177
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240177,
					"content": "但他完全不覺得膩，反而越來越投入，還把團裡的兄弟們叫來一起表演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240178
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240178,
					"content": "幫我準備的玩具，也全都是故事裡的道具：盔甲、盾牌、玩具劍什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240179
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240179,
					"content": "後來我才有點明白，根本不是講給我聽，是他自己喜歡這樣玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240180
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240180,
					"content": "哇，這個人…好奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240181
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240181,
					"content": "但感覺本性並不壞？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240182
					]
				},
				{
					"id": 130240182,
					"content": "嗯，小時候我覺得他很幼稚，但這最多只能讓我無奈，還稱不上是厭惡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240183
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240183,
					"content": "——長大了之後，我偶然得知了「神王之遺」的所作所為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240184
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240184,
					"content": "擄掠、威脅、暴力、欺詐，這些邪惡的行為在組織裡竟然都是吹噓的資本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240185
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240185,
					"content": "他，還有團裡的人，根本就不是什麼英雄，而是故事裡應該被打倒的反派。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240186
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240186,
					"content": "他們不會以為不讓我看見，我就永遠不知道吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240187
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240187,
					"content": "我好像能明白妳的心情。現實讓妳感受到了落差…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240188
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240188,
					"content": "嗯，不過沒關係啦，小姐，都是過去的事了。我和他大吵一架之後就離開了，再也沒回去過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240189
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240189,
					"content": "這次我要介入調查，也不是對他有什麼多餘的感情，只是想保護我身邊的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240190,
						130240191
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240190,
					"content": "所以問題就在於…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240192
					]
				},
				{
					"id": 130240192,
					"content": "是的，我的兄弟們正在收集各路情報。絕大多數的報告都是暴力事件，此外還涉及非法貿易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240193
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240193,
					"content": "我懂了…但這絕對會很危險吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240194
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240194,
					"content": "嗯，但傭兵的一生就是不斷地跟危險博弈，我很享受這樣的生活方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240195
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240195,
					"content": "這對關心妳的人來說，是一種很沉重的負擔啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240196
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130240196,
					"content": "所以說，才沒打算告訴妳啊，小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241101
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130241101,
					"content": "怎、怎麼辦？兩個人的想法都有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130241102,
					"content": "我跟迪希雅一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241103
					]
				},
				{
					"id": 130241103,
					"content": "#欸？沒必要把{F#妳}{M#你}捲進來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241104
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130241104,
					"content": "#{M#他}{F#她}很厲害的哦，迪娜澤黛，這種事如果{M#他}{F#她}和迪希雅聯手，絕對「哐噹」一下就解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130241105,
					"content": "#這…好吧，有{M#他}{F#她}在，我確實會放心一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241106,
						130241107
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130241106,
					"content": "放心好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241108
					]
				},
				{
					"id": 130241108,
					"content": "#那我在城裡等{F#妳}{M#你}們的消息，{F#妳}{M#你}們一定要安然無恙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241109
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 130241109,
					"content": "謝謝妳，小姐，能這麼關心我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130241110
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130241110,
					"content": "那走吧，先去喀萬驛見見「熾光獵獸」，我的兄弟們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130241107,
					"content": "我…我盡量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130241108
					]
				},
				{
					"id": 130240191,
					"content": "為什麼他們突然開始大肆做壞事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240192
					]
				},
				{
					"id": 130240142,
					"content": "阿赫瑪爾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240143
					]
				}
			]
		},
		{
			"id": 1302402,
			"completionStepIds": [
				1302402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302402",
							"2"
						],
						"stepId": 1302402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈倫",
					"希沙姆",
					"哈拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130240201,
					"content": "嘿，迪希雅，妳回來了啊。這兩位是妳的朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240202,
						130240204
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240202,
					"content": "你好，幸會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240203
					]
				},
				{
					"id": 130240203,
					"content": "#哈哈，{F#妳}{M#你}好{F#妳}{M#你}好，隨意一點就好，我們沒什麼講究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240206
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240206,
					"content": "既然有新人在，「阿赫瑪爾之鬚」的事我簡單說說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240207
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240207,
					"content": "他們的做法很誇張，直接把弄錢的目標放在自己人身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240208
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240208,
					"content": "不僅是普通的傭兵團，就連同屬「神王之遺」的團都會被他們襲擊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240209
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240209,
					"content": "就算是凶猛殘暴的野獸，也會保護自己的骨肉和族群，但他們根本不管不顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240210
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240210,
					"content": "是的。從傭兵的手上搶了財物，他們會交給別的團或者黑市商人去轉賣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240211
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240211,
					"content": "一部分摩拉直接換成食物和武器，馬上投入下一場暴力行動中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240212
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240212,
					"content": "太過分了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240213,
					"content": "是啊，這也讓我們好奇，他們如此渴望摩拉的原因是什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240214
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240214,
					"content": "前兩天我和希沙姆去跟蹤，還偽裝成商人和他們交易，果然有不得了的發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240215
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240215,
					"content": "——與其說是「奪財」，不如說是「內鬥」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240216
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240216,
					"content": "等等，「內鬥」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240217
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240217,
					"content": "嗯，因為在受害者中，「神王之遺」附屬團的比例特別高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240218
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240218,
					"content": "如果只是為了摩拉，對方應該是誰都可以，不會表現出像這樣的目的性。但如果解讀成內鬥，就能說通了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240219
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240219,
					"content": "不過可惜的是，對方的口風很緊，我們沒辦法拿到更進一步的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240220
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240220,
					"content": "只是聽說「阿赫瑪爾之鬚」活躍的這幾年，「神王之遺」一直在被削弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240221,
						130240222
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240221,
					"content": "他們能有這麼大本事…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240223
					]
				},
				{
					"id": 130240223,
					"content": "確實很奇怪，接下來交給我們繼續調查吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240224
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240224,
					"content": "但我沒想到我不在的這幾天，你們就直接跑去套情報，這是不是太危險了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240225
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240225,
					"content": "哎，這有什麼，那是妳老爹的團啊，我們比妳還著急。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240226
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240226,
					"content": "是啊，再說，妳做的危險事可多得是，我們這算什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240227
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240227,
					"content": "他們去交易的時候，我去確認了一下遇難者的營地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240228
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240228,
					"content": "沒有倖存者，活下來的人都跑了，營地裡什麼值錢的東西都沒剩下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240229
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240229,
					"content": "希沙姆和哈拉夫，你們也來了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240230
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240230,
					"content": "看見妳回來，我們兩個馬上就過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240231
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240231,
					"content": "#這裡的新朋友看起來有點稚嫩，但我一下子就感覺到{M#他}{F#她}身上有種不尋常的氣場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240232
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240232,
					"content": "妳有了厲害的幫手，我們也放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240233
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240233,
					"content": "那我呢、那我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240234,
					"content": "呃，妳…妳也要一起去啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240235
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240235,
					"content": "#當然了！我是{M#他}{F#她}最重要的嚮導，{M#他}{F#她}不管去哪我都會跟著！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240236,
					"content": "那…那迪希雅妳最好照顧她一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240237
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240237,
					"content": "你是看不起我嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240238,
					"content": "哈哈哈，別看她這個樣子，她曾經也去過很多危險的地方，最後都安然無恙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240239
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240239,
					"content": "就算都是偶然，所有偶然疊加起來，也可以說很有本事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240240
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240240,
					"content": "原來如此，是我以貌取人了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240241
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240241,
					"content": "哦對了，迪希雅，等妳有空了，去和副團長說說妳的行程安排吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240242
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240242,
					"content": "前兩天我們招新人，大家都是為了「熾鬃之獅」的名號來的，結果妳正好不在，只有一群臭男人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240243
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240243,
					"content": "副團長忙裡忙外，最後效果卻很差，沒幾個人留下來，他可傷心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240244
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240244,
					"content": "抱歉抱歉，到時候我幫他帶兩瓶好酒，之前走得比較急，專門回來一趟不太順路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240245
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240245,
					"content": "不過，他們的選擇也沒錯啊。要是迪希雅不在，這裡確實沒什麼特別的吸引力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240246
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240246,
					"content": "要是副團長能想想辦法，再招幾個大帥哥或者大美人進來就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240247
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240247,
					"content": "得了吧，之前我邀請了兩個女傭兵來團裡，你們一個個像冬瓜一樣坐在那，氣都不會喘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240248
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240248,
					"content": "那種沉默很詭異的啊，本來她們都打算加入的，一頓飯之後就被嚇跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240249
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240249,
					"content": "那、那種事別再提了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240250
					],
					"speakerTitle": "希沙姆"
				},
				{
					"id": 130240250,
					"content": "還有這種事？我怎麼不知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240251
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240251,
					"content": "你當時不在吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240252
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240252,
					"content": "我不在嗎？我錯過了百年一遇的大好事？然後你們還不告訴我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240253
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240253,
					"content": "欸欸欸，好了好了，等等再跟你說，你別鬧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240254
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240254,
					"content": "不是，你可別想應付過去啊。希沙姆，還有你，快點過來，講清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240255
					],
					"speakerTitle": "哈拉夫"
				},
				{
					"id": 130240255,
					"content": "你們…一直都這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130240256,
					"content": "哈哈，是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240257
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240257,
					"content": "傭兵之間沒那麼多拐彎抹角的規矩，通常都是想到什麼就說什麼，很隨興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240258
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240258,
					"content": "#要是對方惹{F#妳}{M#你}生氣，那就罵回去，如果不夠消氣，還可以直接動手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240259
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240259,
					"content": "但大家也不會放在心上，很快就過去了，這總比把意見憋在心裡，永遠不溝通好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240260
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240260,
					"content": "所以跟他們說話我也不會留情，該笑就笑、該罵就罵，滿過癮的，在呼瑪伊家可不能這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240261
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240261,
					"content": "喂，你們幾個等等再吵，先把情報給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240262
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240262,
					"content": "聽見沒，哈拉夫，先做正事。我畫了一張路線圖，你們在這裡就能攔下幫他們銷贓的商隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240263
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240263,
					"content": "先躲起來，等到晚上，保證人贓俱獲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240264
					],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240264,
					"content": "好的，謝謝你們，順便幫我和其他人問聲好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240265
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 130240265,
					"content": "放心吧，妳也要小心哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈倫"
				},
				{
					"id": 130240222,
					"content": "好像更無法理解了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240223
					]
				},
				{
					"id": 130240204,
					"content": "是過命的交情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130240205
					]
				},
				{
					"id": 130240205,
					"content": "哦？那和我們一樣了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130240206
					],
					"speakerTitle": "哈倫"
				}
			]
		},
		{
			"id": 1302403,
			"completionStepIds": [
				1302403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
