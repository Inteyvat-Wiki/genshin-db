				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 710100201,
					"content": "師兄已獲『神之眼』，本應蕩滌世間魔物，但他卻問我，世間魔物是否生而為惡？這些魔物禍亂世間，濫害無辜，難道不是惡劣至極？我看師兄真是修煉得人都傻了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100202
					],
					"speakerTitle": "遺蹟寶藏"
				},
				{
					"id": 710100202,
					"content": "算了，就算沒有『神之眼』，我一個人也能去掃清魔物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100203
					],
					"speakerTitle": "遺蹟寶藏"
				}
			]
		},
		{
