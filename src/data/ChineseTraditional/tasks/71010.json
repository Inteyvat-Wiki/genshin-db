			"dialogs": [
				{
					"id": 710100101,
					"content": "我與師兄自幼習武，勵志除魔衛道。但想要衛道世間，沒有『神之眼』相助，又談何容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100102
					],
					"speakerTitle": "遺蹟寶藏"
				},
				{
					"id": 710100102,
					"content": "我和師兄潛修於此，欲求『神之眼』，立此碑為證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710100103
					],
					"speakerTitle": "遺蹟寶藏"
				}
			]
		},
		{
			"id": 7101002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
