			"dialogs": [
				{
					"id": 200060401,
					"content": "交付餐費",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060402
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060402,
					"content": "#{F#妳}{M#你}回來了，餐品送到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060403
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060403,
					"content": "這是餐費。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060404
					]
				},
				{
					"id": 200060404,
					"content": "我看看…沒錯，太感謝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060405
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060405,
					"content": "#還有，這份<color=#00E1FFFF>美味的蟹黃火腿焗時蔬</color>給{F#妳}{M#你}，剛剛做好的，趕緊趁熱吃了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		}
