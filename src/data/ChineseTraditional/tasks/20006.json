			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"活躍的歐琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200060201,
					"content": "#謝謝{F#妳}{M#你}，這些史萊姆真討厭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060202
					],
					"speakerTitle": "活躍的歐琳"
				},
				{
					"id": 200060202,
					"content": "要不是我餓到沒力氣了，這些傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060203
					],
					"speakerTitle": "活躍的歐琳"
				},
				{
					"id": 200060203,
					"content": "這是妳訂的餐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060204
					]
				},
				{
					"id": 200060204,
					"content": "唔——是胡蘿蔔和肉的香氣…要是能早點吃到，那些史萊姆早就被我打飛了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060205
					],
					"speakerTitle": "活躍的歐琳"
				},
				{
					"id": 200060205,
					"content": "算了不管了，這是餐費，帶回去給莎拉小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "活躍的歐琳"
				}
			]
		},
