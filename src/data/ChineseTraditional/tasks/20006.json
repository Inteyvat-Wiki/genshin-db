			},
			"dialogs": [
				{
					"id": 200060101,
					"content": "餐品外送訂單",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060102
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060102,
					"content": "#歡迎光臨獵鹿人…旅行者？{F#妳}{M#你}來得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060103
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060103,
					"content": "#抱歉啦，我知道{F#妳}{M#你}餓著肚子，但是能請{F#妳}{M#你}幫我個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060104
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060104,
					"content": "清泉鎮裡的歐琳小姐訂了一份<color=#00E1FFFF>蜜醬胡蘿蔔煎肉</color>，但是我聽說，清泉鎮最近總是有史萊姆出來搗亂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060105
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060105,
					"content": "#我自己不敢過去…能請{F#妳}{M#你}幫我把餐品送給<color=#00E1FFFF>清泉鎮的歐琳</color>嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060106,
						200060107
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060106,
					"content": "好吧，但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060108
					]
				},
				{
					"id": 200060108,
					"content": "#等{F#妳}{M#你}回來的時候，會有一頓大餐做回報的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200060109
					],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060109,
					"content": "拜託了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				},
				{
					"id": 200060107,
					"content": "太餓了，我只是來吃飯的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200060110
					]
				},
				{
					"id": 200060110,
					"content": "#等{F#妳}{M#你}幫完我的忙之後，我，我就請{F#妳}{M#你}吃獵鹿人特製料理，就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莎拉"
				}
			]
		},
