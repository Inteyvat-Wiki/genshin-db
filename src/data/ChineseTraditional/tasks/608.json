			"dialogs": [
				{
					"id": 6080101,
					"content": "呼，好久沒在風花節期間盡情電人了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080102
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 6080102,
					"content": "老師，以前難道很多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080103
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 6080103,
					"content": "你說電人？當然不多了，啊哈哈，只是偶爾啦。不過還滿抒壓的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080104
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 6080104,
					"content": "啊對了，前些日子老師寫信給我的時候還問起了這件事呢，我當時說的可是「溫柔待人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080105
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 6080105,
					"content": "學生繼承老師的風格，很合理吧？我的老師也是一個溫柔的素論派老爺子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080106
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 6080106,
					"content": "所以這次也只用了很溫柔的電法喔，就算琴看到都不方便阻止我的那種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080107
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 6080107,
					"content": "原來，可以溫柔地電人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080108
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 6080108,
					"content": "看起來麗莎小姐狀態很不錯，真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						6080109
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 6080109,
					"content": "是啊，活動一下身體，對健康也很有益處呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麗莎"
				}
			]
		},
