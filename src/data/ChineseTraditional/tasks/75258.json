			},
			"dialogs": [
				{
					"id": 752580101,
					"content": "欸？這裡怎麼有一個暈倒的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752580102,
					"content": "喂！你聽得見嗎？你怎麼啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752580103,
					"content": "#{F#妳}{M#你}們扶起了地上的人，他慢慢醒了過來…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						752580104
					]
				},
				{
					"id": 752580104,
					"content": "哎喲喲喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580105,
						752580106
					],
					"speakerTitle": "暈倒的員工"
				},
				{
					"id": 752580105,
					"content": "你好，你喝多了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				},
				{
					"id": 752580107,
					"content": "頭好暈…這是怎麼回事…讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580108
					],
					"speakerTitle": "暈倒的員工"
				},
				{
					"id": 752580108,
					"content": "#啊！想起來了！我好像是被人打暈了…但是我沒看到是誰動手的。等等…不會就是{F#妳}{M#你}們動的手吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580109
					],
					"speakerTitle": "暈倒的員工"
				},
				{
					"id": 752580109,
					"content": "喂！我們可是好心扶你起來的人啊，你可不要誣賴人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752580110,
					"content": "噢噢，對不起，呃…我是「醅蜜」酒吧的員工，本來要去北邊的港口送貨，嗯…挪德卡萊的商會跟我們採購了一些蜜釀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580111
					],
					"speakerTitle": "暈倒的員工"
				},
				{
					"id": 752580111,
					"content": "#哎呀！完了，我的貨呢？蜜釀沒了！難道是被搶走了？等等…不會就是{F#妳}{M#你}們搶走的吧？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580112
					],
					"speakerTitle": "暈倒的員工"
				},
				{
					"id": 752580112,
					"content": "都說了我們是好心扶你起來的人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752580113,
					"content": "#哦對對對，對不起，我現在有點頭暈。非常感謝{F#妳}{M#你}們，但我得立刻回酒吧報告一下情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752580114
					],
					"speakerTitle": "暈倒的員工"
				},
				{
					"id": 752580114,
					"content": "#如果真的有強盜，{F#妳}{M#你}們也不要往北邊的港口去了，可能會有危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "暈倒的員工"
				},
				{
					"id": 752580106,
					"content": "需要送你回家嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752580107
					]
				}
			]
		}
	]
}