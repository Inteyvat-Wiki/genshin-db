			"dialogs": [
				{
					"id": 207030201,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030202
					]
				},
				{
					"id": 207030202,
					"content": "#太好了，那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030303
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030303,
					"content": "#{F#妳}{M#你}能夠看見「元素」，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030304
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030304,
					"content": "我想，只要循著「風」的痕跡搜索就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030305
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030305,
					"content": "#我就在樹下等著{F#妳}{M#你}，有什麼收穫的話，就拿下來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾迪絲博士"
				}
			]
		},
