			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾迪絲博士"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030101,
					"content": "…這個也不能作為寫作素材，可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030102
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030102,
					"content": "妳在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030103
					]
				},
				{
					"id": 207030103,
					"content": "我想寫一本以「風」為主題，敘述蒙德歷史的新書，正在這裡尋找靈感呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030104
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030104,
					"content": "這裡既有代表著風的「七天神像」，又有著與大英雄溫妮莎相關的這棵樹，在這裡尋找靈感，再適合不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030105
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030105,
					"content": "不過說來好笑，因為我沒有「神之眼」，無論是想要尋找還是蒐集「風」，都實在是太費力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030106
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030106,
					"content": "所謂的尋找靈感，也只不過是在這裡發呆。僅有的一些素材，也都是從書籍裡總結出來的一些二手材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030107
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030107,
					"content": "在這片大陸上，沒有「神之眼」的人就是這樣，做事永遠事倍功半。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030108
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030108,
					"content": "沒有「神之眼」，無法使用元素的力量…無論是研究還是生活，都活像個這世界裡的局外人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030109
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030109,
					"content": "哈哈哈，也許在神看來，擁有「神之眼」的人，才是這個世界的主角吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030110
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030110,
					"content": "抱歉，我說得有些多了。雖然話是這麼說啦，但我不會放棄研究的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030111
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030111,
					"content": "我沒有「神之眼」，但絕不能在學術水準上再落下風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030112
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030112,
					"content": "#而且我聽說，{F#妳}{M#你}雖然沒有「神之眼」，但也能看到元素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030113
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030113,
					"content": "如果能親手拿到附著有「風」元素的東西，一定會對我的研究有幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030114
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030114,
					"content": "#旅行者，{F#妳}{M#你}能幫我去這棵大樹上搜索一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾迪絲博士"
				}
			]
		},
