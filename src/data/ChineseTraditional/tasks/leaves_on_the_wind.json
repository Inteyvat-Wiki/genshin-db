			},
			"dialogs": [
				{
					"id": 207030501,
					"content": "#{F#妳}{M#你}有什麼發現嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030502
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030502,
					"content": "找到了這些「樹葉」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207030503
					]
				},
				{
					"id": 207030503,
					"content": "…樹葉？請給我看看。您居然把它們裝在這個盒子裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030504
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030504,
					"content": "這些樹葉…拿在手裡的時候，確實能實實在在地感覺到「風」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030505
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030505,
					"content": "這棵樹上，居然真的有這種力量…要是我有「神之眼」的話，就不會浪費這麼多時間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030506
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030506,
					"content": "謝謝，這是很寶貴的素材，我會好好利用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030507
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030507,
					"content": "不過，對這些「樹葉」我也沒什麼保存手段，「風」也許很快就會消散，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030508
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030508,
					"content": "#這些是給{F#妳}{M#你}的報酬，說不定下次還要麻煩{F#妳}{M#你}，再來幫我搜集素材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾迪絲博士"
				}
			]
		}
	]
