				],
				"points": []
			},
			"dialogs": [
				{
					"id": 207030401,
					"content": "#不得不說，說到做研究，{F#妳}{M#你}這樣的人明顯才更加適合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030402
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030402,
					"content": "既有豐富的冒險經驗，體能也十分不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030403
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030403,
					"content": "#最重要的是，雖然{F#妳}{M#你}沒有「神之眼」，但也能夠操縱元素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030404
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030404,
					"content": "元素…在這片大地上，又有什麼研究能繞開這兩個字呢？對於學者來說，能不能操縱元素實在是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207030405
					],
					"speakerTitle": "艾迪絲博士"
				},
				{
					"id": 207030405,
					"content": "啊，我又自顧自說起來了…抱歉，請別放在心上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾迪絲博士"
				}
			]
		},
