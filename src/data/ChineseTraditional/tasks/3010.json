			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100101,
					"content": "我、我全都想起來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100102,
					"content": "#…很好，這次{F#妳}{M#你}們適應得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100103
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30100103,
					"content": "昨晚的最後…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100104
					]
				},
				{
					"id": 30100104,
					"content": "對啊，昨晚我們明明摘掉了虛空，卻還是聽到了虛空的音效，那是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100105,
						30100106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100105,
					"content": "我們被植入了其他形式的虛空終端？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				},
				{
					"id": 30100107,
					"content": "不過這下基本可以確認，我們現在被困在同一天裡出不去的狀態，是跟虛空有關聯了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100108,
					"content": "如果說是虛空要「偷取」大家的智慧的話，又到底為什麼會造成現在這種狀況呢…想不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100109,
					"content": "在實驗臺上的小白鼠，想要獲知自己為何被如此對待，的確是一件極其困難的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100110
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30100110,
					"content": "把我們兩個比作小白鼠嗎？那妳又是什麼呢？納西妲，妳一直都不告訴我們妳的身分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100111,
					"content": "嗯…我是「月亮」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100112
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30100112,
					"content": "月亮？那不是我們做過的占卜的結果嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100113,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100114
					]
				},
				{
					"id": 30100114,
					"content": "#好了，知曉我是誰並不會對{F#妳}{M#你}們瞭解真相有什麼用處的，還是把注意力放在別處吧，當心漏掉什麼線索哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100115
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30100115,
					"content": "唔…好吧。既然昨天迪希雅幫上了很多忙，不如還是先找她會合吧。這個時間的話，差不多那些綁匪快要出現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100106,
					"content": "我們只是以為自己摘掉了虛空終端？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100107
					]
				}
			]
		},
		{
			"id": 301002,
			"completionStepIds": [
				301002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301002",
							"2"
						],
						"stepId": 301002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪希雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100201,
					"content": "#{F#妳}{M#你}們在這啊，那些綁匪我已經解決了，小姐沒受傷吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100202
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100202,
					"content": "等等，好像有哪裡不對…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100203
					]
				},
				{
					"id": 30100203,
					"content": "欸…迪希雅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100204,
					"content": "#怎麼了？{F#妳}{M#你}們兩個為什麼這樣盯著我看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100205
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100205,
					"content": "妳、妳這次為什麼沒有受傷！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100206,
					"content": "啊？這次是什麼意思，還有，我為什麼一定要受傷，那只是些有三腳貓功夫的綁匪而已啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100207,
						30100208
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100207,
					"content": "妳的大劍應該用起來不順手吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				},
				{
					"id": 30100209,
					"content": "噓…妳怎麼會知道大劍的事，我應該從來沒跟別人說過，可別讓小姐知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100210
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100210,
					"content": "果然迪希雅的記憶還是沒有了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100211,
						30100212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100211,
					"content": "在這次戰鬥中…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100213,
					"content": "#奇怪的地方…硬要說的話，{F#妳}{M#你}們也知道我換了大劍的嘛，可不知為何好像新的大劍用起來很順手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100214
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100214,
					"content": "就像…就像是已經拿著它經歷過無數次戰鬥了一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100215
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100215,
					"content": "是說雖然記憶中沒有跟它一起戰鬥的經歷，但好像身體卻有…是這樣的感覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100216,
					"content": "沒錯，不論是對傭兵還是武者而言，「身體記憶」才是最重要的，一招一式靠大腦記住也只是表面工夫而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100217
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100217,
					"content": "#旅行者，{F#妳}{M#你}怎麼看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100218,
						30100219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100218,
					"content": "難道是昨晚摘掉虛空的影響？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100220,
					"content": "是呀，總感覺看到了希望一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100221,
					"content": "有沒有可能…我們已經脫困了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100222
					]
				},
				{
					"id": 30100222,
					"content": "欸！是哦，在之前的「花神誕日的輪迴」中，是不可能出現這種情況的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100223,
					"content": "等今天結束就知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100224
					]
				},
				{
					"id": 30100224,
					"content": "#雖然我聽不懂{F#妳}{M#你}們在討論什麼，但危險還…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100225
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100225,
					"content": "危險還沒有解除，所以妳想讓我們先帶迪娜澤黛去那邊休息，妳來探查一下那些綁匪還有沒有同夥，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100226,
					"content": "妳怎麼知道我想說這些…讀心術？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100227
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30100227,
					"content": "好啦，快去做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100219,
					"content": "第一次出現這樣的事件變化…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100220
					]
				},
				{
					"id": 30100212,
					"content": "妳有沒有什麼覺得奇怪的地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100213
					]
				},
				{
					"id": 30100208,
					"content": "所以原本應該會受點擦傷的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100209
					]
				}
			]
		},
		{
			"id": 301003,
			"completionStepIds": [
				301003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"301003",
							"2"
						],
						"stepId": 301003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30100301,
					"content": "…呼，終於到晚上了，除了那件事之外，今天好像也沒什麼其他變化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100302,
					"content": "納西妲，聽我說，我們今天發現，原本每次擊敗綁匪後都會受傷的迪希雅，今天沒有受傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100303,
					"content": "妳說會不會「花神誕日的輪迴」已經結束了呀？迪娜澤黛是不是要有救了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100304,
					"content": "哦？有了這樣的進展啊，不錯不錯。既然如此，今天就好好休息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100305
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30100305,
					"content": "喂，這是什麼模稜兩可的答案呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100306,
					"content": "#明天會到來，這件事對所有人來講都是常識。但其實明天是否真的會到來，只有身處明天的{F#妳}{M#你}才知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100307
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30100307,
					"content": "今天已經過了多少次？今天之後有沒有可能是昨天？明天這個詞是否從來都是被捏造出來的概念？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100308
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30100308,
					"content": "也或許，整個世界都是虛假的，這片大陸的歷史就是一場漫長的「花神誕祭」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100309
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30100309,
					"content": "好了好了，不要說下去了，我的頭腦本來就很累了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100310,
					"content": "呵呵…所以說，明天自然就會知道的事情，今天就不要耗費無意義的腦力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100311
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30100311,
					"content": "好好休息吧，比如痛痛快快去上個廁所什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100312
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30100312,
					"content": "啊？等等，妳剛才說什麼？我聽錯了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100313,
					"content": "#嗯？人們都說上完廁所會覺得神清氣爽，所以推薦{F#妳}{M#你}們去而已，很奇怪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100314
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 30100314,
					"content": "呃…太過奇怪也太過沒有常識，以至於不知道該說什麼…明明剛才好像還在講什麼大道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100315,
					"content": "那我們先回去休息了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30100316
					]
				},
				{
					"id": 30100316,
					"content": "嗯，雖然每天都是花神誕祭這樣熱鬧開心的日子，但好像我們很久都沒有放鬆過了呢。走吧，我們回房間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100317,
					"content": "「滴——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30100318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30100318,
					"content": "繼續進行「收穫」，相比結果而言，這些都是微不足道的代價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎爾"
				}
			]
		},
