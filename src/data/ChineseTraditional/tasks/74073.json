					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740732102
					]
				},
				{
					"id": 740732102,
					"content": "結果最後這裡什麼都沒有嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740732103,
					"content": "並不是，看起來是已經被人拿走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732104
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732104,
					"content": "那豈不是我們的計畫已經失敗了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740732105,
					"content": "「理性」的誕生需要四個象限合一。只要我們能拿到剩下的幾個，我們就還有機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732106
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732106,
					"content": "既然如此，我們就快點去接下來的地方吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
			]
		},
