						740732304
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732304,
					"content": "究竟是誰會…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740732305
					]
				},
				{
					"id": 740732305,
					"content": "是雅各布。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732306
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732306,
					"content": "我們之前在厄里那斯曾經與其發生衝突。補充訂正，是最近一段時間的厄里那斯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732307
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740732307,
					"content": "之前看到大門口那個悲劇的受害者我就知道是他的手筆了。他果然還在活動啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732308
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732308,
					"content": "那他拿走這裡的東西是想要幹什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740732309,
					"content": "很簡單啊。他也想要重鑄水仙十字的聖劍，因為水仙十字結社的事業還未結束呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740732310
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740732310,
					"content": "我們還是趕快去最後一個地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
				}
			]
