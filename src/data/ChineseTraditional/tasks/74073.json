			"dialogs": [
				{
					"id": 740730101,
					"content": "地上的火堆還在燃燒。話說為什麼這裡要點火呢？明明是遺蹟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740730102,
					"content": "讓我來看看這個石碑上面寫了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730103
					],
					"speakerTitle": "安"
				},
				{
					"id": 740730103,
					"content": "「此處乃記憶之象限，記憶之廳堂，記憶之間」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730104
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740730104,
					"content": "「生於一瞬」…「常與相違，伴你長眠，從不分離」…「烈火難及」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730105
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740730105,
					"content": "謎語啊？楓丹的古文明很喜歡，水仙十字結社也很喜歡。說不上來究竟是古制還是興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730106
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740730106,
					"content": "已經嘗試搜尋所有關鍵詞，並沒有答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730107
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740730107,
					"content": "不過這是一個已經解開的謎題，或許答案就和火堆有關吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730108
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740730108,
					"content": "去思考已經解開的謎真的有意義嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730109
					],
					"speakerTitle": "安"
				},
				{
					"id": 740730109,
					"content": "意義還是有的。就像是妳我變成了現在的樣子，但是仍然有必要追尋過去發生了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730110
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740730110,
					"content": "是這樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740730111
					],
					"speakerTitle": "安"
				},
				{
					"id": 740730111,
					"content": "#那{NICKNAME}騎士，{F#妳}{M#你}覺得答案是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
			]
		},
