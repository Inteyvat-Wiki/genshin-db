			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040101,
					"content": "#兩個小朋友在幹什麼，{F#妳}{M#你}們也是來看我這個「種石頭」老頭笑話的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040102
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040102,
					"content": "我非常好，用不著村裡人費心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040103
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040103,
					"content": "嗚哇，不用一上來就這麼大敵意吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040104,
					"content": "你搞錯了，我們不是阿如村的人，也不是來看笑話的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040105,
						732040107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040105,
					"content": "我們只是路過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040106
					]
				},
				{
					"id": 732040106,
					"content": "路過的人？這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040110,
					"content": "平常只有幾個舊識會來我這裡，一個勁地叫我放棄這裡的苗圃，搬回村子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040111
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040111,
					"content": "還有幾個壞小子，老是跑到我這裡來調皮搗蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040112
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040112,
					"content": "#我倒是第一次見到打扮成{F#妳}{M#你}們這樣的，兩位小朋友，{F#妳}{M#你}們是做什麼的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040113,
						732040116
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040113,
					"content": "是正在尋親的旅人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040114
					]
				},
				{
					"id": 732040114,
					"content": "是啊，為了這個目標，我們走過了很遠的路，一路冒險一路尋找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040115,
					"content": "#{NICKNAME}{M#他}{F#她}啊，是個很有正義感的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040119,
					"content": "欺負獨居老人什麼的，這種事我們才不會做呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040120,
					"content": "#所以老爺爺，{F#妳}{M#你}不用擔心啦，我們不是壞人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040121,
					"content": "咳咳，讓我向兩位小朋友道歉還真是有點不好意思，誰叫我沒看清楚就亂說呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040122
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040122,
					"content": "#兩位小朋友，老頭阿凡向{F#妳}{M#你}們道歉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040123
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040123,
					"content": "#{F#妳}{M#你}們年紀還這麼小，就自己養活自己了，挺有本事的，比我年輕時候強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040124
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040124,
					"content": "#照{F#妳}{M#你}們剛才那麼說，如果我遇上了解決不了的麻煩，是不是也能委託{F#妳}{M#你}們幫忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040125
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040125,
					"content": "哦？這是有工作要委託我們的意思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040126,
					"content": "遇到了什麼問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040127
					]
				},
				{
					"id": 732040127,
					"content": "我原本開了兩塊苗圃，這裡是一塊，另外一塊在村子的西邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040128
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040128,
					"content": "也是我年紀大了，之前一個人照看不過來，幾天沒去看，另外那塊苗圃就被黑漆漆的奇怪東西給禍害了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040129
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040129,
					"content": "非常危險，進去一次我差點就出不來了，嚇得我再也不敢往那片地裡跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040130
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040130,
					"content": "我現在最大的希望就是把苗圃的地治好，方便以後再種上花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040131
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040131,
					"content": "#聽起來不太複雜。怎麼樣？{NICKNAME}，我們要不要接受這個委託？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040132,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040133
					]
				},
				{
					"id": 732040133,
					"content": "#那塊苗圃在村子西邊，{F#妳}{M#你}們可別走錯路啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040134
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040134,
					"content": "#不會啦，{F#妳}{M#你}就放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040116,
					"content": "是探索世界的冒險家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040117
					]
				},
				{
					"id": 732040117,
					"content": "是啊，我們翻越了好多好多座高山，跨越了好大好大的水泊，來到了須彌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040118,
					"content": "那個話怎麼說，我們是…嗯…心胸寬廣的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040107,
					"content": "聽說這裡有人在種花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040108
					]
				},
				{
					"id": 732040108,
					"content": "沒錯，我種的是花，可不是什麼爛石頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040109
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040109,
					"content": "我剛才還以為…哎喲，叫我說什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040110
					],
					"speakerTitle": "阿凡"
				}
			]
		},
		{
			"id": 7320404,
			"completionStepIds": [
				7320404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7320404",
							"2"
						],
						"stepId": 7320404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿凡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732040401,
					"content": "#{F#妳}{M#你}們兩個回來了？那塊苗圃的狀態怎麼樣，{F#妳}{M#你}們覺得它還能救得回來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040402
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040402,
					"content": "已經解決了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040403
					]
				},
				{
					"id": 732040403,
					"content": "將死域的事解釋給阿凡聽。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						732040404
					]
				},
				{
					"id": 732040404,
					"content": "原來是這麼回事，我就說好好的地裡怎麼會突然冒出這麼多黑漆漆的怪東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040405
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040405,
					"content": "好好好，這下我可以安心把種子種上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040406
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040406,
					"content": "等這三顆種子發芽開花結新種子，再往那塊地裡種，以後這花就能開得到處都是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040407
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040407,
					"content": "欸，這些…形狀奇怪的石頭嗎？它們能長出花來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040408,
					"content": "#阿凡爺爺，{F#妳}{M#你}這是在哪裡買來的呀，別被人騙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040409,
					"content": "#這個小朋友心地還真不錯，{F#妳}{M#你}們放心，摩拉可買不到這些花種子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040410
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040410,
					"content": "這三顆都是鬼…咳咳…一個朋友留給我的珍貴種子，當然跟普通的果子啊花苗啊不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040411
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040411,
					"content": "越聽越奇怪呢？阿凡爺爺，你種的到底是什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040412,
					"content": "呵呵，我種的是一個朋友的囑託，是他的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040413
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040413,
					"content": "好奇怪的說法，這種東西是可以種的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040414,
					"content": "小朋友，跟妳說了妳也不會明白的，以後有機會再來看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040415
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040415,
					"content": "別看這裡現在空蕩蕩的，將來這片苗圃裡的三顆種子都會發芽開花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040416
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040416,
					"content": "以後它們會越長越多的，哈哈，那時候一定很漂亮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040417
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040417,
					"content": "#好了好了，說好了委託{F#妳}{M#你}們幫忙，報酬我是不會耍賴不給的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040418
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040418,
					"content": "#{F#妳}{M#你}們兩位拿著吧，我能給的也不多，都在這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040419
					],
					"speakerTitle": "阿凡"
				},
				{
					"id": 732040419,
					"content": "呼，委託完成，跑了這半天感覺肚子有點餓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040420,
					"content": "明明都是我在跑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040421
					]
				},
				{
					"id": 732040421,
					"content": "#我也有一路陪{F#妳}{M#你}說話嘛，說話也是會消耗能量的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040422,
					"content": "#別那麼小氣啦，{NICKNAME}，我們拿上酬金去買點好吃的犒勞自己一下，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040423,
					"content": "快看看報酬有多少，夠我們吃幾頓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040424,
					"content": "我看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732040425
					]
				},
				{
					"id": 732040425,
					"content": "欸，比起摩拉，更多的是食物…烤肉卷、米圓塔，還有好多蔬菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040426,
					"content": "這也太多了。我們…是不是拿了阿凡爺爺一天的食物啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040427,
					"content": "這個阿凡爺爺一個人住在村子外面，應該也挺不容易的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040428,
					"content": "摩拉就算了，把口糧都給我們的話，唔…感覺有點沉重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040429,
					"content": "而且，他明明種著石頭一樣的種子，卻說自己種的是…願望？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040430,
					"content": "#{F#妳}{M#你}說，他會不會是一個人住了太久，產生了幻覺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732040431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732040431,
					"content": "越想越覺得不放心，我們有空的時候就去看看他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
