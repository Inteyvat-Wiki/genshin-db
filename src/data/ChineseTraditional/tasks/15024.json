			"dialogs": [
				{
					"id": 150240101,
					"content": "欸？好像有什麼東西躲在神像後面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240102,
					"content": "這是幼年的暝視龍？還滿可愛的…不過牠為什麼要這樣盯著我們看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240103,
					"content": "#{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240104,
					"content": "（這裡是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240105
					]
				},
				{
					"id": 150240105,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240106
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150240106,
					"content": "（你是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240107
					]
				},
				{
					"id": 150240107,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240108
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150240108,
					"content": "唔…到底過去了多久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240109,
					"content": "#{NICKNAME}，剛剛我和那隻幼年暝視龍對視了一眼，就被拉進了一個奇怪的空間，還見到了好大的一隻暝視龍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240110,
					"content": "我也是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240111
					]
				},
				{
					"id": 150240111,
					"content": "怎麼會發生這種事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240112,
					"content": "#{NICKNAME}，又怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240113,
						150240114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240113,
					"content": "牠就在那邊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				},
				{
					"id": 150240115,
					"content": "看！是那隻幼年的暝視龍，牠好像也想帶我們去那邊。從冒險者的角度來說，必須一探究竟了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240116,
					"content": "我們走，派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 150240114,
					"content": "好像在呼喚我們…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240115
					]
				}
			]
		},
