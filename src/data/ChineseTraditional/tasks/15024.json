			"dialogs": [
				{
					"id": 150240201,
					"content": "不知道這裡允不允許外人進去…門怎麼自己打開了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240202,
					"content": "哇，之前看到的那隻暝視龍真的在這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240203,
					"content": "就是牠在呼喚我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240204
					]
				},
				{
					"id": 150240204,
					"content": "那我們過去打個招呼？",
