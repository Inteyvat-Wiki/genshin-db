			"dialogs": [
				{
					"id": 150240301,
					"content": "你好，請問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240302,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240303
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150240303,
					"content": "牠聽得懂我們講話嗎？看起來呆呆的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240304,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240305
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150240305,
					"content": "如果說錯了什麼，對不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240306,
					"content": "是誰在那裡？不得對長老無禮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240307
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240308
					],
					"speakerTitle": "特拉波"
				},
				{
					"id": 150240308,
					"content": "您的意思是…我明白了，剛剛是我冒昧了。兩位既然是受邀而來的客人，我本該熱情接待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240309
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240309,
					"content": "正式介紹一下，在下名為卡胡魯，煙謎主的祭司之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240310
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240310,
					"content": "這位是現任的暝視龍大長老，偉大的特拉波波克提茲特利，我們煙謎主的活圖騰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240311
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240311,
					"content": "好長的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240312,
					"content": "我們族人平時都稱呼牠為特拉波長老，兩位客人也可以使用這個稱呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240313
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240313,
					"content": "牠邀請人的方式真特別。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240314
					]
				},
				{
					"id": 150240314,
					"content": "哦，這位客人是指長老的能力吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240315
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240315,
					"content": "特拉波長老已經活過數百年的歲月，牠身上的秘密就連我這個祭司也難以說清楚，客人感到困惑自然是情有可原。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240316
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240316,
					"content": "不過有一點我可以確認，特拉波長老對兩位發出了重要的諭示，因此我希望能邀請兩位接受一項測試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240317
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240317,
					"content": "諭示？測試？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240318,
					"content": "如果可以的話，請兩位隨我去見部族首領。比起我，他更有能力來解答兩位的疑問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240319
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240319,
					"content": "嗯…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240320,
					"content": "如果兩位準備好了，就請隨我來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240401
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240401,
					"content": "使用這面織物，就可以直接抵達首領所在的「曜石祭場」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240402
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240402,
					"content": "無需驚訝，這是我們部族使用的諸多秘術之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡胡魯"
				}
			]
		},
