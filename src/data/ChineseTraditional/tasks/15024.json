					{
						"sceneId": 3,
						"position": [
							-1644.502,
							15.092,
							9709.844
						],
						"pointId": 10239
					}
				]
			},
			"dialogs": [
				{
					"id": 150240501,
					"content": "哇，剛剛那是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240502,
					"content": "那是我們祭司的日常工作之一，我們嘗試與先祖的靈魂取得聯絡，並尋求啟示。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240503
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240503,
					"content": "首領就在那邊，容我先稟報一下，請兩位在此稍候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240504
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240504,
					"content": "該怎麼說呢…煙謎主這個部族果然好神秘喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240505,
					"content": "我已向首領稟明情況，兩位請隨我去面見首領吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240506
					],
					"speakerTitle": "卡胡魯"
				},
				{
					"id": 150240506,
					"content": "兩位就是諭示所指向的人選吧？我是煙謎主的現任首領庇蘭，有失遠迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240507
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240507,
					"content": "好高…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240508,
					"content": "我生來就擁有異於常人的體型，請勿見怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240509
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240509,
					"content": "當然不會！我剛剛只是有些驚訝，抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240510,
					"content": "請問「諭示」是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240511
					]
				},
				{
					"id": 150240511,
					"content": "具體情況卡胡魯已經向我說明，我能理解兩位的疑惑。兩位是外來的客人，自然不瞭解這種「諭示」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240512
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240512,
					"content": "在之前漫長的歷史中，這項「諭示」所選擇的都是煙謎主內部的族人。外族人被選中的情況，這還是第一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240513
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240513,
					"content": "哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240514,
					"content": "請容我說明一下，我們煙謎主有一個古老的傳統，那就是製作織物來記載納塔的歷史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240515
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240515,
					"content": "並且我們不只記錄本族的歷史，其他部族的傳說故事和英雄事蹟也會被納入記錄的範圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240516
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240516,
					"content": "上千年來都是如此，我們將此視為自己的一項使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240517
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240517,
					"content": "不過，如果是那種影響了整個納塔的大事件，就需要一種極為特殊的織物來記錄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240518
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240518,
					"content": "而這種織物只有暝視龍大長老指定的人才能完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240519
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240519,
					"content": "當暝視龍大長老觀測到地脈的重大變化後，牠就會發出一種諭示，指定製作這種織物的人選。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240520
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240520,
					"content": "也就是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240521
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240521,
					"content": "現任的特拉波長老很早就察覺到了地脈的變化，但兩位到來後，牠才指定了製作織物的人選。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240522
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240522,
					"content": "#原來是這樣…但是，我和{NICKNAME}根本不知道如何製作這種織物啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240523,
					"content": "對於這一點，我並不驚訝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240524
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240524,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240525,
					"content": "特拉波長老在大約兩百年前繼任，同時也接過了這個確定人選的職責，而牠選中的人都不瞭解如何製作這種織物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240526
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240526,
					"content": "那這兩百年來的歷史大事件都沒有紀錄嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240527,
					"content": "不，那些人都按時交出了成果，只是他們大多聲稱那不是自己製作的，而是得到了「神靈的饋贈」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240528
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240528,
					"content": "這…煙謎主這個部族果然好神秘喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240529,
					"content": "不過，這正是讓我困擾的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240530
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240530,
					"content": "記錄歷史這麼重要的事情，如果只能寄希望於「神靈的饋贈」這種謎一樣的事物，實在無法令人安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240531
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240531,
					"content": "呃…聽到煙謎主的首領這麼說，真的有些意外啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240532,
					"content": "我理解兩位的想法，想必在兩位看來，煙謎主的人都充滿了神秘感，他們推崇的肯定都是難以言明的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240533
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240533,
					"content": "而我的確是個異類，雖然身為煙謎主的首領，但我主張針對這些傳統做出變革。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240534
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240534,
					"content": "我致力於解析各種神秘的事物，因為這樣就可以建立明確的規則，進而更長久地維護部族的傳承。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240535
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240535,
					"content": "哇，聽起來好厲害…那你解析了「神靈的饋贈」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240536,
					"content": "不…我調查了很久，也沒有查清「神靈的饋贈」指的是什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240537
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240537,
					"content": "需要用那種織物來記錄的大事件屈指可數，彼此之間的時間間隔都在幾十年以上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240538
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240538,
					"content": "等到下一個諭示被發出的時候，首領已經換了一代人，根本沒機會針對此事進行深入的調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240539
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240539,
					"content": "那…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240540,
					"content": "我雖然沒有查清事情的全貌，但還是獲得了一些進展。只是，我需要被選中的人配合我驗證一些猜測。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240541
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240541,
					"content": "所以我們要接受測試…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240542
					]
				},
				{
					"id": 150240542,
					"content": "正是如此。不過兩位無需擔憂，這個測試只是為了驗證我的猜測，既不會過度耗費兩位的心力，也不會帶來任何危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240543
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240543,
					"content": "那具體來說是怎樣的測試？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240544
					]
				},
				{
					"id": 150240544,
					"content": "我可以帶領兩位前往測試地點並進行說明，但請兩位稍候，容我先脫下這件「覆魂之羽」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240545
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240545,
					"content": "這是歷代首領傳承下來的聖物，只有在主持祭祀時才能穿著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240546
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240546,
					"content": "哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240547
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240547,
					"content": "庇蘭脫下了身上的羽織，小心地交予一名祭司收好。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						150240548
					]
				},
				{
					"id": 150240548,
					"content": "請隨我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240549
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240549,
					"content": "兩位看到這面織物了嗎？接觸它，兩位就可以進入一個秘密的空間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240550
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240550,
					"content": "而兩位要接受的測試，就是想辦法從那個空間中脫身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240551
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240551,
					"content": "這樣就好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150240552,
					"content": "請不要小看這個測試，如果實在找不到脫身之法，我會親自幫助兩位回到這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240553
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240553,
					"content": "只是那樣的話，這個諭示就仍舊是一道難解的謎題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150240554
					],
					"speakerTitle": "庇蘭"
				},
				{
					"id": 150240554,
					"content": "先讓我們試一試吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150240555
					]
				},
				{
					"id": 150240555,
					"content": "好，兩位可以主動接觸那面織物來開始測試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庇蘭"
				}
			]
		},
