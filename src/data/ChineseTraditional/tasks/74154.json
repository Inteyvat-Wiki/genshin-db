			},
			"dialogs": [
				{
					"id": 741540201,
					"content": "太不對勁了，太不對勁了！連我都看得出來不對勁了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540202,
					"content": "#{NICKNAME}，{F#妳}{M#你}腦袋聰明，{F#妳}{M#你}說接下來怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540203,
						741540204,
						741540205,
						741540206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540203,
					"content": "伯努瓦想求救卻又說別救他…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540207,
					"content": "那我們再去伯努瓦家附近看看？他家後窗那裡不是有一個奇怪的箱子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540208,
					"content": "#那裡面一定藏了什麼東西，說不定可以證明{F#妳}{M#你}的推測。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540204,
					"content": "這對夫妻可能來自灰河…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540205,
					"content": "看他們的反應，可能另有隱情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				},
				{
					"id": 741540206,
					"content": "我有一些推測，但是缺少證據。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540207
					]
				}
			]
		},
