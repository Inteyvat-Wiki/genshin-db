			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3583.541,
							435.073,
							4515.374
						],
						"pointId": 6413
					},
					{
						"sceneId": 3,
						"position": [
							3582.053,
							435.073,
							4515.892
						],
						"pointId": 7528
					},
					{
						"sceneId": 3,
						"position": [
							3582.002,
							435.073,
							4514.881
						],
						"pointId": 7529
					}
				]
			},
			"dialogs": [
				{
					"id": 741540701,
					"content": "#我想，按照{F#妳}{M#你}們的執著程度，應該不會就這麼回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540702
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540702,
					"content": "#我還以為{F#妳}{M#你}們會直接報告執律庭——結果沒有，看來{F#妳}{M#你}們有一些自己的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540703,
						741540704
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540703,
					"content": "你們為什麼要困住伯努瓦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				},
				{
					"id": 741540705,
					"content": "#說實話，我已經有點佩服{F#妳}{M#你}們了。如果把這股拼勁用對地方，{F#妳}{M#你}們可能會成為相當了不起的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540706
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540706,
					"content": "#只可惜這件事情上不行，唉…{F#妳}{M#你}們真的是不怕死啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540707
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540707,
					"content": "你嚇錯人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540708
					]
				},
				{
					"id": 741540708,
					"content": "哦？是因為完全沒有弄清楚自己身處的狀況，還是因為自以為在執行正義呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540709
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540709,
					"content": "說到這個，剛才那則新聞提到的溺死的商人，他叫布拉德特。嗯，是一個極其能言善道的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540710
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540710,
					"content": "#{F#妳}{M#你}知道嗎？新聞上說他其實不是溺死的，而是被人謀殺之後再丟進湖裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540711
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540711,
					"content": "逐影庭的人調查了半天，只查出來他是被人謀殺的，以及謀殺他的人罪該萬死這樣的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540712
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540712,
					"content": "於是新聞報導也就這樣寫。實際情況到底怎麼樣？是殺人者更該死，還是他本人更該死呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540713
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540713,
					"content": "嗯…這是個複雜的問題，我暫時還沒有想出答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540714
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540714,
					"content": "哦，扯遠了，這跟我們要聊的事情沒什麼關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540715
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540715,
					"content": "你到底想說什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540716,
					"content": "我想說的是，在沒有全然瞭解一件事之前就貿然行動，是既愚蠢又有可能招致惡果的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540717,
						741540718
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540717,
					"content": "對不正義的事無動於衷才愚蠢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540719,
					"content": "哈哈，如果是在不同的情況下相遇，我們說不定能夠成為朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540720
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540720,
					"content": "#雖然{F#妳}{M#你}的想法合我胃口，但我有我要做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540721
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540721,
					"content": "#這是我最後的耐心了——下一次再讓我看到{F#妳}{M#你}們在我家附近亂晃，我一定會動手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540722
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741540722,
					"content": "阿托斯撂下了一些莫名其妙的話之後就離開了這裡。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540723
					]
				},
				{
					"id": 741540723,
					"content": "#他離奇的態度讓{F#妳}{M#你}覺得意外，{F#妳}{M#你}正思索在這件事裡，自己究竟該抱持何種立場…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540724
					]
				},
				{
					"id": 741540724,
					"content": "後窗傳來輕輕的玻璃敲擊聲，隨著極輕的一聲「吱呀」，一張紙條從後窗被丟了出來…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540725
					]
				},
				{
					"id": 741540725,
					"content": "紙條上有褐色的字跡，似乎是在十分倉促的情況下，用手沾著咖啡寫出來的…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741540726
					]
				},
				{
					"id": 741540726,
					"content": "快看看，上面寫了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540727,
					"content": "是伯努瓦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741540728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540728,
					"content": "噓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540729
					]
				},
				{
					"id": 741540729,
					"content": "…對不起，總之我們小心留意貓食盆，等他的訊號吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741540718,
					"content": "面對不正義的事我會積極行動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540719
					]
				},
				{
					"id": 741540704,
					"content": "伯努瓦到底和你們有什麼關係？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741540705
					]
				}
			]
		},
		{
			"id": 7415408,
