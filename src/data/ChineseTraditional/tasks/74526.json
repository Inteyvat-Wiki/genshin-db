			"dialogs": [
				{
					"id": 745260401,
					"content": "#啊，是{NICKNAME}，{F#妳}{M#你}來了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260402,
						745260403
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 745260402,
					"content": "妮露，妳在練習嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				},
				{
					"id": 745260404,
					"content": "沒有沒有，我正在構思一支新的舞蹈，靈感來源於雨後初晴的帕蒂沙蘭，花瓣上還掛著露珠的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260405
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 745260405,
					"content": "不過現在還只有雛形，很多動作都還不夠優美，總覺得還差了點什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260406,
						745260407
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 745260406,
					"content": "聽描述就已經很美了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260408,
					"content": "為我留影嗎？可是，就像我剛才說的，這個舞步我還不是很熟練…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745260409,
						745260410
					],
					"speakerTitle": "妮露"
				},
				{
					"id": 745260409,
					"content": "舞蹈成型前的練習…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260411,
					"content": "#嗯，我明白了！那我就將心意融入舞步中…請用{F#妳}{M#你}的鏡頭，捕捉花朵綻放的剎那吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妮露"
				},
				{
					"id": 745260410,
					"content": "也是藝術的一部分。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260411
					]
				},
				{
					"id": 745260407,
					"content": "可以讓我為妳拍一張畫片嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260408
					]
				},
				{
					"id": 745260403,
					"content": "我沒有打擾到妳吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745260404
					]
				}
			]
		}
	]
