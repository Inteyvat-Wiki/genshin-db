			"dialogs": [
				{
					"id": 721300101,
					"content": "形狀奇特的石燈，似乎放射著令人不安的能量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300102
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721300102,
					"content": "這個石燈籠好邪門…散發著一種似曾相識的氣息呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721300103,
					"content": "欸，好像有人在燈柱上寫了字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721300104,
					"content": "「駐守的兵士，關於此鎮物如有疑問，請至無想刃狹間，與梶先生商談。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300105
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721300105,
					"content": "字看起來很新，但也有被雨水沖刷的痕跡。下面還有幾列更清晰的小字",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300106
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721300106,
					"content": "「陌生筆記，請勿輕信。行軍貴在神速，此必為賊人緩兵之計。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300107
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721300107,
					"content": "「私自離隊開小差者，必有重罰！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721300108
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 721300108,
					"content": "這個梶先生似乎對石燈籠很在意的樣子，我們不如去無想刃狹間問問他吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
