			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「小王子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706670201,
					"content": "#喵！「真是了不起，恭喜{F#妳}{M#你}突破了牌手等級的試煉，現在已經是專家牌手了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670202
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706670202,
					"content": "#「這樣就有資格挑戰更多的牌手了…對了，雖然之前{F#妳}{M#你}就已經可以了，但我再提醒一下，{F#妳}{M#你}可以在邀請板懸掛戰書…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670203
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706670203,
					"content": "#喵…「這樣，想要挑戰{F#妳}{M#你}的牌手都能撕下{F#妳}{M#你}的戰書。哼，不知道對手是誰的對局，有的時候也是滿有趣的事…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670204
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706670204,
					"content": "「畢竟，相約進行牌局，也是一種相遇的方式。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706680204
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706680204,
					"content": "#喵！「啊！扯遠了，那麼作為專家牌手的特權，現在的{NICKNAME}有資格購買一些牌面好看得不得了的卡…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706670205
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706670205,
					"content": "#「嗯嗯…{NICKNAME}，勿忘遊樂之心，希望{F#妳}{M#你}能感受到『七聖召喚』的樂趣！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「小王子」"
				}
			]
		},
