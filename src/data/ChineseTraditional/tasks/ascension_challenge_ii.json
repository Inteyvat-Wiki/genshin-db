			"dialogs": [
				{
					"id": 706660101,
					"content": "進行突破挑戰！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706660102
					]
				},
				{
					"id": 706660102,
					"content": "#喵…「哎呀，要來進行牌手等級突破的試煉嗎…嗯，{NICKNAME}確實已經擁有了挑戰的資格，那我這就…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706660103
					],
					"speakerTitle": "「小王子」"
				},
				{
					"id": 706660103,
					"content": "「這就讓恕筠準備突破試煉所用的牌局吧，可要小心應對呀…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「小王子」"
				}
			]
		},
		{
			"id": 7066702,
			"completionStepIds": [
				7066703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
