			"dialogs": [
				{
					"id": 751500901,
					"content": "你好，偵測到新的資料回收類目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500902
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751500902,
					"content": "…關於「秘源機關」的能源核心，條目已更新。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500903
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751500903,
					"content": "驅動秘源機關的核心能源，即是「燃素」，只不過會是濃縮過，更接近光形態的「燃素」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500904
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751500904,
					"content": "在「資料佚失」的可控反應下，可以產生穩定的「單位燃素量」，更精準控制能源的投放。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500905
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751500905,
					"content": "秘源機關所需的能源根據執行邏輯的複雜和機體大小都有關係，秘源龍僕所需的「單位燃素量」為「資料佚失」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500906
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751500906,
					"content": "而體型更大的秘源龍像所需的「單位燃素量」相較之下卻更少，需求為三。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500907
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751500907,
					"content": "「資訊即是能量，能量即是資訊」，你所回收的資料載體即為「單位燃素」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500908
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751500908,
					"content": "所以「單位燃素」就是火球…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751500909
					]
				},
				{
					"id": 751500909,
					"content": "是的，可以這麼視為，原本被深淵侵蝕的「單位燃素」被你們恢復，才能被我提取…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751500910
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751500910,
					"content": "也可作為被深淵侵蝕的秘源機關的替代能源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "秘源龍僕"
				}
			]
		},
