			"dialogs": [
				{
					"id": 751501301,
					"content": "請問，有什麼需要詢問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501302
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751501302,
					"content": "如何進入聖山之心？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501303
					]
				},
				{
					"id": 751501303,
					"content": "進入聖山之心的入口就在新開掘的入口…深入火山之底的裂隙之處，由秘源龍像看守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501304
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751501304,
					"content": "此外，任何進入聖山之心的造訪者，都需要獲得「許可」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501305
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751501305,
					"content": "如此才能獲得，守衛…聖山之心，亦即「維奇洛波奇特利」…那位秘源龍像的認可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501306
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751501306,
					"content": "在什麼地方能夠獲得許可…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501307
					]
				},
				{
					"id": 751501307,
					"content": "根據協議和修庫特爾大人制訂的諭令，想要進入…聖山之心亦即「維奇洛波奇特利」…的族裔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501308
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751501308,
					"content": "請前往「審議之庭」申請並等待許可的下達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501309
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751501309,
					"content": "秘源龍像所需的能源？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751501310
					]
				},
				{
					"id": 751501310,
					"content": "正在，檢索…沒有可響應的資料條目類型…或許由於深淵侵蝕城市所致，資料有許多佚失…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501311
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751501311,
					"content": "如果能夠清除深淵的影響，回收資料，或許能夠找到您所需的資料條目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501312
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751501312,
					"content": "為您標記可回收資料的可能存放地點，請清除該處深淵的侵蝕以恢復資料承載的區塊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501313
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751501313,
					"content": "請問，有什麼需要詢問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751501314
					],
					"speakerTitle": "秘源龍僕"
				},
				{
					"id": 751501314,
					"content": "沒什麼要問的了…",
