			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610101,
					"content": "向著星辰與深淵，歡迎來到冒險家協會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 706610102,
					"content": "我們最近接到了一份釣魚協會的委託，他們聲稱附近水域的魚類活動出現了異常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610103
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 706610103,
					"content": "不過具體情況倒沒有說明，您能幫忙去看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 706610104,
					"content": "我想是您的話，無論什麼情況，一定都能輕鬆應對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610105
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 706610105,
					"content": "釣魚協會？是那個釣魚嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610106
					]
				},
				{
					"id": 706610106,
					"content": "欸？那個釣魚？我不太明白…您說的釣魚，是哪個釣魚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 706610107,
					"content": "哎呀，釣魚協會釣魚協會，一聽就是釣上了很多好吃的魚的協會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706610108,
					"content": "不要浪費時間了啦，我們趕緊去看看吧！嘿，嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7066102,
			"completionStepIds": [
				7066102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066102",
							"2"
						],
						"stepId": 7066102,
						"stateName": "QUEST_STATE_UNFINISHED"
