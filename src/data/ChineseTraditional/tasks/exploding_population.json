		},
		{
			"id": 7066104,
			"completionStepIds": [
				7066103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7066103",
							"2"
						],
						"stepId": 7066103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楠塔克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610401,
					"content": "就這裡了！看見水裡那些小魚兒了嗎？真漂亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610402
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610402,
					"content": "#這些是幫{F#妳}{M#你}準備的工具，有魚竿、魚餌、還有魚餌的製作配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610403
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610403,
					"content": "先在魚鉤上填好魚餌，再瞄準魚群聚集的地方…拋竿！然後乖乖等魚兒上鉤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610404
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610404,
					"content": "#聽說新人身上都會有「新手好運」啊，我當年可是釣上了一條半公尺多的大鱸魚！{F#妳}{M#你}也來試試吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610405
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610405,
					"content": "希望能再釣一隻小派蒙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610406
					]
				},
				{
					"id": 706610406,
					"content": "有一個我還不夠嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706610407,
					"content": "派蒙？這個名字倒是很陌生，也是一種魚嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610408
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610408,
					"content": "是以前釣的「神奇海鮮」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610409
					]
				},
				{
					"id": 706610409,
					"content": "喂！已經從「應急食品」變成「神奇海鮮」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706610410,
					"content": "#原來如此！沒想到{F#妳}{M#你}已經是個小有經驗的釣魚家了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610411
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610411,
					"content": "#那我就更加期待{F#妳}{M#你}的收獲了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楠塔克"
				}
			]
		},
