			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楠塔克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706610201,
					"content": "最近的魚可真是活躍啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610202
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610202,
					"content": "有什麼需要幫忙的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610203
					]
				},
				{
					"id": 706610203,
					"content": "#啊，幫手終於來了，{F#妳}{M#你}們好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610204
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610204,
					"content": "我是楠塔克，蒙德魚協的資深釣魚家，咳咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610205
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610205,
					"content": "最近，附近水域突然出現了很多新魚種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610206
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610206,
					"content": "我立刻和其他地區的同好交流，果然，各地都出現了這種情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610207
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610207,
					"content": "還有人說，這是提瓦特來到了百年一見的魚類爆發期呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610208
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610208,
					"content": "其實原因還沒有完全查明，但我猜多少都跟生態環境變好有關係…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610209
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610209,
					"content": "喔——一定是這些傢伙太多，給你們帶來了麻煩吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706610210,
					"content": "別擔心，包在派蒙身上吧！只要牠們不難吃的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706610211,
					"content": "哈哈，倒也不是麻煩，對釣魚協會來說，魚群當然是越多越好，只不過前提是人手足夠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610212
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610212,
					"content": "但實話說，以我們現有的人力來看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610213
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610213,
					"content": "要在短期釣上來所有的新魚種來做研究…確實有些壓力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610214
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610214,
					"content": "不過反過來看，這不也是釣魚協會發展的絕佳機會嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610215
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610215,
					"content": "所以我就在冒險家協會掛上了委託。怎麼樣？有興趣加入我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610216
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610216,
					"content": "釣魚可是很有意思的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610217,
						706610219
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610217,
					"content": "沒問題，我很擅長釣魚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610218
					]
				},
				{
					"id": 706610218,
					"content": "好，真是充滿幹勁的年輕人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610223,
					"content": "那麼現在，先跟我去果酒湖另一邊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610224
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610224,
					"content": "#那裡有我們為新人準備的釣魚場地，我先教{F#妳}{M#你}些最基本的技巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610219,
					"content": "我可以直接下去抓嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706610220
					]
				},
				{
					"id": 706610220,
					"content": "#直接跳下去多危險呀？{F#妳}{M#你}們這些冒險家還真是勇敢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610221
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610221,
					"content": "#可惜那些魚兒沒{F#妳}{M#你}們勇敢，看見這麼大個活人跳進水裡，牠們肯定全嚇跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610222
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 706610222,
					"content": "還是不要做這種事比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706610223
					],
					"speakerTitle": "楠塔克"
				}
			]
		},
		{
