			"trigger": {
				"objectNames": [
					"娜贊",
					"愛拉尼",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050701,
					"content": "愛拉尼！妳到底出不出來！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050702
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731050702,
					"content": "就是不出來！我不做學者了！我也不想上學了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050703
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050703,
					"content": "反正我都付給妳那麼多錢了，妳就讓我一個人待著不行嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050704
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050704,
					"content": "死丫頭，軟硬不吃是吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050705,
						731050706
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731050705,
					"content": "那個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				},
				{
					"id": 731050707,
					"content": "妳、妳們好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050708,
					"content": "#嗯？{F#妳}{M#你}們是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050709
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731050709,
					"content": "旅、旅行者！嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050710
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050710,
					"content": "愛拉尼小姐，妳真的在這裡呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050711,
						731050712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050711,
					"content": "妳沒事就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050713,
					"content": "嗚…嗚…他們…他們欺負人！那篇論文明明是我先寫的！我先寫的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050714
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050714,
					"content": "要不是在稻妻耽誤那麼久，我的論文早就通過了！嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050715
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050715,
					"content": "冷靜一點啦…那妳現在還要繼續寫論文嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050716,
					"content": "呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050717
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050717,
					"content": "我、我才不寫了呢…傻子才寫論文！我不要上學了！教令院愛怎麼樣就怎麼樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050718
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050718,
					"content": "反正我付錢雇了娜贊保護我，誰也別想把我再抓回去寫論文！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050719
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050719,
					"content": "哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050720
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731050720,
					"content": "您是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050721
					]
				},
				{
					"id": 731050721,
					"content": "#我就是娜贊，我的本職工作…哼，{F#妳}{M#你}應該也已經知道了，我就不說廢話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050722
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731050722,
					"content": "#我知道{F#妳}{M#你}，最近在這周圍很活躍的「旅行者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050723
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731050723,
					"content": "#如果{F#妳}{M#你}是接到了誰的委託，要把這丫頭帶回去的話，{F#妳}{M#你}可以先試試說服她，我不會阻止{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050724
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731050724,
					"content": "喂！我可是付了錢的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050725
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050725,
					"content": "妳付的那麼點錢能夠做什麼？再買幾天吃的喝的要花光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050726
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731050726,
					"content": "反正…反正我不回去，回去了之後又要想論文的題目，又要到處去田野調查，吃不好睡不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050727
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050727,
					"content": "說不定，還會被莫名其妙的人抓起來，或者是遇見亂七八糟的魔物。最後論文一個字沒動，答辯日又過了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050728
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050728,
					"content": "嗚嗚嗚…我不要…我不要…我還不如被盜寶團抓起來…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050729
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050729,
					"content": "#旅行者，{F#妳}{M#你}…{F#妳}{M#你}幫我帶個話給妮露法老師…我…我給{F#妳}{M#你}寫個便條…我真的不想回去了，饒了我吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050738
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050738,
					"content": "愛拉尼抽泣著開始寫起了便條…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050730
					]
				},
				{
					"id": 731050730,
					"content": "#給{F#妳}{M#你}…嗚嗚嗚…嗚嗚…為什麼世界上有論文這種東西…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050731
					],
					"speakerTitle": "愛拉尼"
				},
				{
					"id": 731050731,
					"content": "#…好了，冷靜一點，沒人帶得走{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050732
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731050732,
					"content": "愛拉尼小姐…現在的情緒好像很不穩定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050733,
					"content": "就讓她先待在這裡，我們先把便條帶回去給妮露法小姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050734,
						731050735
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050734,
					"content": "但是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050736,
					"content": "不用擔心我會對愛拉尼不利，就如她所說，她已經付過錢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050737
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731050737,
					"content": "而且…哼，總算是找到了一個懂點學問的人了，我留著她可有大用處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731050735,
					"content": "盜寶團…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050736
					]
				},
				{
					"id": 731050712,
					"content": "事情我都聽妮露法說了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050713
					]
				},
				{
					"id": 731050706,
					"content": "打擾了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050707
					]
				}
			]
		},
