			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"妮露法",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050101,
					"content": "愛拉尼…妳到底跑到哪裡去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050102
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050102,
					"content": "愛拉尼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050103
					]
				},
				{
					"id": 731050103,
					"content": "欸？這名字…我記得，是那個總是在寫論文的大姐姐？我們在海祇島見過的那位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050104,
					"content": "對喔！她說過她是從教令院出去取材的，現在應該已經回去了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050105,
					"content": "不過…那個人好像很焦急的樣子…我們過去問問她發生了什麼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050106,
					"content": "如果愛拉尼真的回了教令院，我們也正好過去打個招呼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050107,
					"content": "妳好，關於愛拉尼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050108
					]
				},
				{
					"id": 731050108,
					"content": "#{F#妳}{M#你}是冒險家協會派來的冒險家嗎？！請問{F#妳}{M#你}找到愛拉尼的下落了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050109
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050109,
					"content": "我知道我催了好多次，真的很不好意思，但我真的很擔心她，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050110
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050110,
					"content": "#嗚哇，{F#妳}{M#你}冷靜點，我們不是冒險家協會派來的啦，我們只是路過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050111,
					"content": "請問您是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050112
					]
				},
				{
					"id": 731050112,
					"content": "#{F#妳}{M#你}們不是冒險家嗎？抱歉，因為協會那邊一直沒消息，我…我太著急了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050149
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050149,
					"content": "講述了至今為止與愛拉尼一起經歷的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						731050113
					]
				},
				{
					"id": 731050113,
					"content": "原來您就是愛拉尼一直提到的那位旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050114
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050114,
					"content": "#我叫妮露法，是教令院的學者…{F#妳}{M#你}們應該也能看出來，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050115
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050115,
					"content": "雖然說是學者，但我現在大部分精力都放在了帶領學生做研究上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050116
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050116,
					"content": "愛拉尼就是我的學生之一，這孩子的論文一直都寫得很艱難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050117
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050117,
					"content": "妳、妳就是愛拉尼的那位導師？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050118
					]
				},
				{
					"id": 731050118,
					"content": "愛拉尼小姐說，她的好多篇論文都被導師說不合格，不得不重寫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050119,
					"content": "不對不對，現在不是說這些的時候，愛拉尼小姐怎麼了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050120,
					"content": "這孩子…這孩子失蹤了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050121
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050121,
					"content": "前段時間，愛拉尼從稻妻帶著一篇論文興沖沖地回來，論文的內容是研究海祇島的民俗文化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050122,
						731050123
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050122,
					"content": "愛拉尼研究得很認真。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				},
				{
					"id": 731050124,
					"content": "我能看出來，這篇論文寫得很好，各方面都是高水準…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050125
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050125,
					"content": "但是…但是她回來得太晚了啊！之前我讓她把初稿提前寄給我，卻一直都沒收到回信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050126
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050126,
					"content": "等她帶著全版論文回來的時候，早就有人提交了和她研究內容一模一樣的論文，都已經通過預審了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050127
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050127,
					"content": "我雖然拼命去幫她爭取機會，但她的論文還是…還是沒通過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050128
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050128,
					"content": "不對啊，愛拉尼小姐很早就開始取材了呀？怎麼可能拖到現在才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050129,
					"content": "等等，說到稻妻…難道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050130,
					"content": "鎖，鎖國令！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050131
					]
				},
				{
					"id": 731050131,
					"content": "怎麼這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050132,
					"content": "我根本不知道怎麼告訴她這個消息…本來打算過幾天，想個委婉的方式和她溝通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050133
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050133,
					"content": "結果不知道哪個大嘴巴，直接把這個消息告訴她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050134
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050134,
					"content": "然後她就不見了，我找遍了教令院也沒有找到，只能去冒險家協會發佈了委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050135
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050135,
					"content": "但冒險家也只是在一個地方發現了愛拉尼的筆記本，沒有發現她的人影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050136
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050136,
					"content": "現在，冒險家們應該還在到處找愛拉尼的下落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050137
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050137,
					"content": "我、我真的不知道怎麼辦才好，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050138,
						731050140
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050138,
					"content": "我也去幫忙找愛拉尼。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050139
					]
				},
				{
					"id": 731050139,
					"content": "對，我們也來幫忙！先從…先從那個筆記本的位置開始找好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050142,
					"content": "您願意幫忙嗎？太感謝您了，真是太感謝您了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050143
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050143,
					"content": "我這就把發現筆記本的位置給您標在地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050144
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050144,
					"content": "對了，還有報酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050145,
						731050146
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050145,
					"content": "這個之後再說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050147,
					"content": "欸？那就拜託您了，我在這裡接著等冒險家協會的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050148
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050148,
					"content": "#愛拉尼，{F#妳}{M#你}可千萬要平安啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731050146,
					"content": "我去找愛拉尼要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050147
					]
				},
				{
					"id": 731050140,
					"content": "筆記本的位置在哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050141
					]
				},
				{
					"id": 731050141,
					"content": "我們也來幫忙找愛拉尼小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050123,
					"content": "愛拉尼研究得很拼命。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050124
					]
				}
			]
		},
		{
			"id": 7310505,
			"completionStepIds": [
				7310505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7310505",
							"2"
						],
						"stepId": 7310505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戈布利",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731050501,
					"content": "英雄！好漢！別打了、別打了！都是誤會啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050502,
						731050505
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050502,
					"content": "沒什麼誤會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050503
					]
				},
				{
					"id": 731050503,
					"content": "你們對愛拉尼小姐做了什麼？老實交代！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050504,
					"content": "不然…不然我們就揍你喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050507,
					"content": "別、別別別，英雄您聽我說完，這真的是誤會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050508
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050508,
					"content": "那位大姐頭我們哪敢惹啊，我們根本就折騰不過她啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050509,
						731050510
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050509,
					"content": "什麼意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050511,
					"content": "您聽我慢慢說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050512
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050512,
					"content": "前段時間，我們兄弟正好缺了點錢，就跟著大姐去周圍想找點發財的管道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050513
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050513,
					"content": "呸！肯定又是搶劫偷東西這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050514,
					"content": "那…那我們都做了盜寶團，日常發財還不就靠那幾樣事物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050515
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050515,
					"content": "我們正在營地裡做計畫的時候，突然看見旁邊有一個小姐背著一個大包往營地這邊走了過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050516
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050516,
					"content": "她一副失魂落魄的樣子，把我們都嚇了一跳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050517
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050517,
					"content": "我們正準備拿起武器的時候，那個小姐突然一屁股坐在篝火旁邊，一邊哭一邊劈里啪啦地把一堆書都甩進火裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050518
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050518,
					"content": "兄弟們是真的被這小姐嚇到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050519,
						731050520
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050519,
					"content": "你們還能被她嚇到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050521,
					"content": "哎喲，我們雖然是盜寶團，但我們也沒真正害過人命啊，頂多就是偷點東西，拿點寶物什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050522
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050522,
					"content": "我們還沒反應過來，她突然又丟過來一袋摩拉，讓我們把她關起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050523
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050523,
					"content": "欸、欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050524,
						731050525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 731050524,
					"content": "這都是什麼亂七八糟的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050526,
					"content": "一開始…也沒人敢上去碰她啊。但她一直不吃不喝，就一直要求被關起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050527
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050527,
					"content": "最後還是大姐讓我們去削了幾根樹枝，做了個籠子讓她坐進去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050528,
						731050529
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050528,
					"content": "你們的這位大姐還挺好的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050530,
					"content": "誰叫我們大姐一直就尊敬有學問的人呢，她一直說，要是有機會她也想上學…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050531
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050531,
					"content": "咳，您要是不信…那位小姐就在那邊，您自己去看看吧，大姐現在肯定還在勸她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050532
					],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050532,
					"content": "您要是能把那位小姐勸走，我們絕對有大禮奉上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戈布利"
				},
				{
					"id": 731050529,
					"content": "你們對愛拉尼還挺好的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050530
					]
				},
				{
					"id": 731050525,
					"content": "那你們把她關起來了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050526
					]
				},
				{
					"id": 731050520,
					"content": "你們不是盜寶團嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050521
					]
				},
				{
					"id": 731050510,
					"content": "愛拉尼果然在你們那。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050511
					]
				},
				{
					"id": 731050505,
					"content": "你們把愛拉尼怎麼了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731050506
					]
				},
				{
					"id": 731050506,
					"content": "老實交代！不然…不然我們就揍你喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731050507
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7310507,
