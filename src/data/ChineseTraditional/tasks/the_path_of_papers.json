				"points": []
			},
			"dialogs": [
				{
					"id": 731053001,
					"content": "#愛拉尼，{F#妳}{M#你}可千萬要平安啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053002,
						731053005
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731053002,
					"content": "愛拉尼在教令院怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053003
					]
				},
				{
					"id": 731053003,
					"content": "愛拉尼是一個很勤奮的孩子，雖然有時候…總是會在奇怪的地方鑽牛角尖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053004
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731053004,
					"content": "但她絕對是一個合格的學生，我也相信她絕對會成為一個合格的學者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731053005,
					"content": "教令院論文很難通過嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053006
					]
				},
				{
					"id": 731053006,
					"content": "老實說，是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053007
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731053007,
					"content": "論文的審核是一件…很複雜的事，除了考慮自己的研究方向，文獻的充足程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053008
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731053008,
					"content": "還要注意同類型論文的數量，研究課題有沒有和別人衝突。開題之後，也會遇見各式各樣的困難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053009
					],
					"speakerTitle": "妮露法"
				},
				{
					"id": 731053009,
					"content": "唉，但愛拉尼那孩子的運氣也太差了點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "妮露法"
				}
			]
		},
