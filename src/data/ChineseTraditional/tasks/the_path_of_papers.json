					"娜贊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 731053101,
					"content": "還有什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053102,
						731053108
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731053102,
					"content": "#{F#妳}{M#你}為什麼對她這麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053103
					]
				},
				{
					"id": 731053103,
					"content": "對愛拉尼這麼「好」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053104
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731053104,
					"content": "#{F#妳}{M#你}誤會了。我這麼做理由很簡單。第一，愛拉尼付過錢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053105
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731053105,
					"content": "第二，我從來只取財，不害人。如果我把她拖出來，丟到荒郊野嶺，那我在道上的名聲就要壞透了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053106
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731053106,
					"content": "第三，她是一個有知識的人，有著遠大的未來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053107
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731053107,
					"content": "能幫上她的忙，我這個在泥巴裡打滾的盜寶團，也許…算是能沾點光了？哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731053108,
					"content": "她付了妳多少錢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						731053109
					]
				},
				{
					"id": 731053109,
					"content": "不是一個小數目。她說是幫人做什麼「肥料」賺來的錢，我不明白，也懶得管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731053110
					],
					"speakerTitle": "娜贊"
				},
				{
					"id": 731053110,
					"content": "總歸她付了錢，我就會暫時幫她的忙，就這麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜贊"
				}
			]
		},
