			"dialogs": [
				{
					"id": 220000501,
					"content": "清理好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000502
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000502,
					"content": "還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000503
					]
				},
				{
					"id": 220000503,
					"content": "#快去清理吧，這可是{F#大姐姐}{M#大哥哥}改邪歸正的好機會喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000504
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000504,
					"content": "喂，我說啊，做一下清潔工作就能成好人了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000505
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220000505,
					"content": "只要願意去做好事，那就是好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000506
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000506,
					"content": "這也太簡單了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000507
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220000507,
					"content": "做了好事，就是好人，做了壞事，就是壞人，就這麼簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000508
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000508,
					"content": "哼，你說是簡單，但如果這麼簡單，那天下哪裡還有壞人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000509
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220000509,
					"content": "因為天下的所有事都是說起來容易，做起來難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000510
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000510,
					"content": "而壞事做起來，總是比好事容易的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000511
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000511,
					"content": "這也是北斗姐姐教你的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000512
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220000512,
					"content": "是我從書裡看的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				}
