				"objectNames": [
					"小蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220000201,
					"content": "準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000202
					]
				},
				{
					"id": 220000202,
					"content": "那我們直接開始吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000203
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000203,
					"content": "從哪開始呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000204
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000204,
					"content": "那個，搶劫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000205
					]
				},
				{
					"id": 220000205,
					"content": "嗚哇！是海盜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000206
					],
					"speakerTitle": "璐璐"
				},
				{
					"id": 220000206,
					"content": "璐璐快過來，我來保護妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000207
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220000207,
					"content": "#{F#妳}{M#你}是海盜吧，為什麼要來搶劫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000208,
						220000209
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000208,
					"content": "我是海盜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				},
				{
					"id": 220000210,
					"content": "海盜也分好壞，不一定都要搶劫呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000211
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000211,
					"content": "北斗姐姐也說自己是海盜，可是她是很好的人，會給我好吃的，大家都很喜歡她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000212
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000212,
					"content": "#為什麼{F#大姐姐}{M#大哥哥}要做壞海盜，不做好海盜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000213
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000213,
					"content": "明明是你說，海盜是那種「蠻不講理」的人吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000214,
						220000215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220000214,
					"content": "好吧，我錯了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000216,
					"content": "唔，願意改邪歸正是好事。這也是北斗姐姐說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000217
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000217,
					"content": "#那麼，{F#妳}{M#你}就幫忙去清理一下周圍吧，只要做好事，那就可以做好人，或者好海盜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000215,
					"content": "我想做個好人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000216
					]
				},
				{
					"id": 220000209,
					"content": "海盜就是要搶劫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000210
					]
				}
			]
		},
		{
