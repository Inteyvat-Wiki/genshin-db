			},
			"dialogs": [
				{
					"id": 220000101,
					"content": "今天我們怎麼玩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000102
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000102,
					"content": "哼，要是沒人來扮海盜，今天也玩不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000103
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220000103,
					"content": "可是，誰也不願意扮海盜，怎麼辦呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000104
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000104,
					"content": "你們在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000105
					]
				},
				{
					"id": 220000105,
					"content": "我們在玩遊戲呢，可總是缺一個人來扮海盜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000106
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000106,
					"content": "因為沒人扮海盜來搶劫，我們一直沒法開始玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000107
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000107,
					"content": "#對了，{F#大姐姐}{M#大哥哥}！{F#妳}{M#你}能來扮海盜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000108,
						220000110
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000108,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000109
					]
				},
				{
					"id": 220000109,
					"content": "好哎！那我們就去準備啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000115,
					"content": "#{F#大姐姐}{M#大哥哥}準備好了的話，就過來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000110,
					"content": "我不太瞭解這方面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000111
					]
				},
				{
					"id": 220000111,
					"content": "沒關係啦，海盜…唔，應該是那種蠻不講理，隨便搶走人家東西的壞人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000112
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000112,
					"content": "雖然我也沒有見過，只是聽北斗姐姐講過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000113
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000113,
					"content": "但我覺得…這種人，應該挺好演的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000114
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000114,
					"content": "#嘿嘿，總之就拜託{F#大姐姐}{M#大哥哥}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000115
					],
					"speakerTitle": "小蒙"
				}
			]
		},
		{
			"id": 2200002,
			"completionStepIds": [
				2200002
			],
