			"dialogs": [
				{
					"id": 220000301,
					"content": "清洗好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000302
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000302,
					"content": "清洗好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220000303
					]
				},
				{
					"id": 220000303,
					"content": "#嗯！辛苦{F#妳}{M#你}啦，這些給{F#妳}{M#你}，謝謝{F#妳}{M#你}陪我們玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000304
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000304,
					"content": "#{F#大姐姐}{M#大哥哥}以後也要做好人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000305
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000305,
					"content": "喂，什麼時候能輪到我做船長啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000306
					],
					"speakerTitle": "阿飛"
				},
				{
					"id": 220000306,
					"content": "下次吧，下次就歸你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220000307
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 220000307,
					"content": "哼，上次你就這麼說的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿飛"
				}
			]
