				},
				{
					"id": 200610402,
					"content": "這樣子，那些鴿子也許就會乖乖送信了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610403
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610403,
					"content": "但我也不能跟著看，不過總之先這樣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610404
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610404,
					"content": "#辛苦{F#妳}{M#你}了，這是答謝，以後要寄信的話就過來打個招呼吧。",
					"roleType": "TALK_ROLE_NPC",
