			"dialogs": [
				{
					"id": 200610101,
					"content": "關於鴿子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610102
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610102,
					"content": "這些鴿子，還不如做下酒菜算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610103
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610103,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610104
					]
				},
				{
					"id": 200610104,
					"content": "我本來在這裡養了一群鴿子，用來替人們送信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610105
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610105,
					"content": "但是也不知道是為什麼，最近這些鴿子們越來越不可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610106
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610106,
					"content": "不是把信送丟，就是送半天也送不到，停在地上半天不動，非要人趕不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610111
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610111,
					"content": "#如果{F#妳}{M#你}有空的話，就幫我去看看剛放出去的那批鴿子吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610107,
						200610109
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610107,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610108
					]
				},
				{
					"id": 200610108,
					"content": "#那就拜託{F#妳}{M#你}了，如果看見鴿子們在偷懶，就趕趕它們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610109,
					"content": "會被鴿子討厭的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610110
					]
				},
				{
					"id": 200610110,
					"content": "沒關係，鴿子的記憶很短，過一下就什麼都忘記了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610112
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610112,
					"content": "#看不出來，{F#妳}{M#你}這麼喜歡鴿子啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				}
			]
		},
