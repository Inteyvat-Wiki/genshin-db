						200610502
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610502,
					"content": "#喂！{F#妳}{M#你}做了什麼，這些鴿子都是用來寄信的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610503
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610503,
					"content": "#真是的，{F#妳}{M#你}到底哪根腦筋不對了…我這裡還有很多信要寄啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610504,
						200610506
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610504,
					"content": "抱歉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610505
					]
				},
				{
					"id": 200610505,
					"content": "光道歉就有用的話，那要西風騎士團做什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610508,
					"content": "#犯錯了就要有懲罰，{F#妳}{M#你}就代替鴿子們把信送過去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 200610506,
					"content": "趕鴿子太用力了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200610507
					]
				},
				{
					"id": 200610507,
					"content": "#趕鴿子？{F#妳}{M#你}是拿著鍋鏟去趕的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200610508
					],
					"speakerTitle": "杜拉夫"
				}
			]
