				]
			},
			"dialogs": [
				{
					"id": 402010101,
					"content": "不錯，非常守時。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010102,
						402010103
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010102,
					"content": "進展如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				},
				{
					"id": 402010104,
					"content": "我們潛伏觀察上次的據點一天後，犯人科德和多達馬尼便開始轉移其中的貨品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010105
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010105,
					"content": "看見那艘船了嗎？那就是多達馬尼調來轉移貨品的船隻，還找了個客貨聯運的幌子，給自己打掩護。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010106
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010106,
					"content": "唔，好一艘大傢伙！要裝的貨物都堆在棧橋上，好像還有不少外地人打算乘它去柔燈港…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010107,
						402010108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010107,
					"content": "為了確認對方沒有假動作，",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010109,
					"content": "漂亮，已經知道提防誘騙了，進步很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010110
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010110,
					"content": "倘若科德和多達馬尼足夠謹慎，懷疑自己正被調查，的確可能放一艘「空船」去柔燈港，進而觀察執法機關的動向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010111
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010111,
					"content": "但要小心，根據被捕犯人陸續供出的情報，被稱為「詐狂」的盜寶團老手也在和「黑錢領主」合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010112
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010112,
					"content": "「詐狂」是個亡命之徒，最擅長暗中進行破壞。經過之前的調查，可以肯定，在小島上觀察千岩軍燈語的眼哨就是他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010113
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010113,
					"content": "#我會在附近走動，避免「詐狂」監視現場。趁此機會，{F#妳}{M#你}們便可以調查貨物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010114
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010114,
					"content": "行動時，請保持低調。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010115,
						402010116
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010115,
					"content": "瞭解，我會小心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010117,
					"content": "#唔！我也會盡量…飛低一點！不能超過{NICKNAME}的肩膀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010116,
					"content": "我辦事，妳放心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010117
					]
				},
				{
					"id": 402010108,
					"content": "我們要提前調查貨物吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010109
					]
				},
				{
					"id": 402010103,
					"content": "有動靜了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010104
					]
				}
			]
		},
