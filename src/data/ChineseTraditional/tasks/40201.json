				]
			},
			"dialogs": [
				{
					"id": 402010201,
					"content": "不好意思，各位乘客，由於貨艙滿載，不少貨物只能堆放在甲板上，還請各位見諒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010202
					],
					"speakerTitle": "船員"
				},
				{
					"id": 402010202,
					"content": "沒關係！這說明最近生意景氣，大家一起發財！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010203
					],
					"speakerTitle": "熱情的乘客"
				},
				{
					"id": 402010203,
					"content": "看來「詐狂」標記的貨物，託運人一欄登記了科德的名字，多達馬尼在船艙內活動，應該也在確認貨品交付到位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010204
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010204,
					"content": "他們在…檢查東西？還在箱子裡翻來倒去？搞什麼名堂…完全不理解！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010205,
					"content": "#拿著這份暗語對照表，{NICKNAME}，利用這份道具，{F#妳}{M#你}就能讀出他們溝通用的黑話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010206
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010206,
					"content": "#待會，我會支開科德和多達馬尼，{F#妳}{M#你}們趁機調查「詐狂」標記過的貨箱，想必能找到什麼線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010207,
						402010208
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010207,
					"content": "如果有不妙的東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				},
				{
					"id": 402010209,
					"content": "#當然，我相信{F#妳}{M#你}的判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010210
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010210,
					"content": "欸？欸欸欸？夜蘭妳要直接去和那些傢伙對話嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010211,
					"content": "嗯？兩位先生…有些面善？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010212
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010212,
					"content": "我們是不是在遺瓏埠的九略茶館有過一面之緣？利奧奈區有名的古董收藏家科德先生，還有這位朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010213
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010213,
					"content": "啊？妳…妳？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010214
					],
					"speakerTitle": "多達馬尼"
				},
				{
					"id": 402010214,
					"content": "…「岩上茶室」的「靈骰傳說」夜蘭小姐，幸會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010215
					],
					"speakerTitle": "科德"
				},
				{
					"id": 402010215,
					"content": "居然還認識我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010216
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010216,
					"content": "我曾在「岩上茶室」喝過一盅絕品，席間，聽說了您的傳聞。現在看來，同為愛茶之人的我們，大概的確有些緣分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010217
					],
					"speakerTitle": "科德"
				},
				{
					"id": 402010217,
					"content": "既然有如此精妙的巧合…正好，我打算前往楓丹享受假期，有什麼推薦的去處嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010218
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010218,
					"content": "比如…精美茶具之類的藝術品展覽…或是拍賣會？我聽說楓丹的紅茶別有一番風味，茶具想必也很有特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010219
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010219,
					"content": "這！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010220
					],
					"speakerTitle": "多達馬尼"
				},
				{
					"id": 402010220,
					"content": "嗯？這位朋友，你似乎也對茶具很有興趣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010221
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 402010221,
					"content": "我…咳咳…沒錯，我是這艘船的船東，受科德的邀請去楓丹旅行，很榮幸能認識妳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010222
					],
					"speakerTitle": "多達馬尼"
				},
				{
					"id": 402010222,
					"content": "夜蘭真的和他們聊起來了？沒問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010223,
						402010224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010223,
					"content": "我們把握時間。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010225,
					"content": "那好！我們繞到那兩個傢伙看不見的地方，去調查他們的箱子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010226,
					"content": "咳咳，箱子裡的味道有點刺鼻，好像把好幾種東西都混合起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010227,
					"content": "還有張奇怪的紙條，寫著什麼看不懂的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010228,
						402010229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010228,
					"content": "是「黑錢領主」的密文…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010230,
					"content": "#真不愧是夜蘭，每個意外情況都預料到了！{F#妳}{M#你}{F#妳}{M#你}{F#妳}{M#你}，{F#妳}{M#你}應該知道怎麼破譯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010231,
					"content": "怎麼樣怎麼樣？那幫傢伙在偷偷說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010232,
						402010233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010232,
					"content": "沒猜錯的話，是炸彈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010234,
					"content": "炸炸炸炸…炸船？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010235,
					"content": "他們瘋了嗎！他們不是想擺脫調查嗎？這樣反而把麻煩搞得更大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010236,
						402010237,
						402010238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010236,
					"content": "「詐狂」要保住幕後黑手…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010239,
					"content": "夜蘭說得真沒錯，那傢伙完全癲狂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402010240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010240,
					"content": "船上還有好多無辜的人，我們得想辦法把炸彈都揪出來，讓它們都停下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402010237,
					"content": "選擇用更大的事態轉移焦點…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010238,
					"content": "同時斬斷我們這邊的線索…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010239
					]
				},
				{
					"id": 402010233,
					"content": "他們想要炸船銷贓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010234
					]
				},
				{
					"id": 402010229,
					"content": "我們有暗語對照表…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010230
					]
				},
				{
					"id": 402010224,
					"content": "好好利用這個時機。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010225
					]
				},
				{
					"id": 402010208,
					"content": "可以讓我自行處置嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402010209
					]
				}
			]
		},
