				]
			},
			"dialogs": [
				{
					"id": 747080101,
					"content": "#{F#妳}{M#你}們好啊，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080102
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080102,
					"content": "#聽吉約丹小姐說{F#妳}{M#你}們最近在打理水族館。我就受她邀請，來當水族館的魚類顧問啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080103,
						747080104
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080103,
					"content": "歡迎歡迎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				},
				{
					"id": 747080105,
					"content": "太好了，有希格雯護士長在，我們就不用擔心牠們生病啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747080106,
					"content": "#嘿嘿，多虧{F#妳}{M#你}們之前邀請我看管「海薇瑪映影歡樂城」的動物莊園，我也總結了一些竅門…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080107
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080107,
					"content": "照顧病人和懂事的動物客人之間，有著好多相通的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080108
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080108,
					"content": "#不過這次除了展示普通的魚類，我還有些「療養」的計畫想和{NICKNAME}商量看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080109
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080109,
					"content": "請說請說，我都好說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080110
					]
				},
				{
					"id": 747080110,
					"content": "聽希婭警官說最近有些魚兒變得格外狂躁，狠狠攻擊附近的生物，甚至是潛水員和小船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080111
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080111,
					"content": "我在想，可不可以將牠們請到水族館裡來冷靜一下，至少別再造成更大的破壞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080112
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080112,
					"content": "然後，我來找找辦法，治好牠們突然出現的壞脾氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080113
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080113,
					"content": "這樣不僅能幫助魚兒和水域恢復正常，也算是為水族館增添獨特的演員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080114
					],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080114,
					"content": "聽起來的確是個辦法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747080115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747080115,
					"content": "我也支持。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080116
					]
				},
				{
					"id": 747080116,
					"content": "#那，我就向{F#妳}{M#你}們提供一些暴躁魚兒出沒水域的消息，之後就拜託{F#妳}{M#你}們啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希格雯"
				},
				{
					"id": 747080104,
					"content": "幫大忙了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747080105
					]
				}
			]
		}
	]
}