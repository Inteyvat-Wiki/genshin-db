					}
				]
			},
			"dialogs": [
				{
					"id": 150380601,
					"content": "咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380602
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380602,
					"content": "清醒點了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380603
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380603,
					"content": "看出我的身體已達極限，將力量反過來傳導給我，從內部破壞了我的外殼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380604
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380604,
					"content": "這股力量、這種對戰鬥的敏銳嗅覺…果然，妳就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380605
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380605,
					"content": "絲柯克，蘇爾特洛奇的弟子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380606
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380606,
					"content": "現在是什麼時候，他離開提瓦特多久了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380607
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380607,
					"content": "幾百年了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380608
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380608,
					"content": "幾百年…！哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380609
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380609,
					"content": "抱歉，情緒激動，差點忘了自報家門。我名斯克弗努格，是妳師父蘇爾特洛奇的朋友，也是他的追隨者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380610
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380610,
					"content": "絲柯克…這是我第一次聽到妳的名字。但數百年前，我就知道妳的存在，知道妳會來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380611
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380611,
					"content": "數百年前？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150380612,
					"content": "可以講講嗎？你，還有師父的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380613
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380613,
					"content": "當然可以，趁我現在還能保持理智。那是很久…很久以前了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380614
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380614,
					"content": "我是坎瑞亞貴族出身，是家中長子，有資格承襲爵位。但我從小就患了不治之症，因此也沒人對我有什麼期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380615
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380615,
					"content": "我努力地練劍，打敗了所有的同齡人。但是沒有用，我看到的都是同情或幸災樂禍的目光，就連父母也在等待我嚥氣的那天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380616
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380616,
					"content": "慢慢地我的心也冷了，整日渾渾噩噩。在這時候，我遇到了妳的師父，蘇爾特洛奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380617
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380617,
					"content": "當時我們都年齡尚小。他是死囚的孩子，在牢獄內出生，從小混跡街頭，受過的批評比深秘院的鉅著還多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380618
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380618,
					"content": "但他整日臉上都帶著笑容，彷彿對一切友好與惡意都視若無睹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380619
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380619,
					"content": "我還記得初次見面他對我說的話：「人要為自己掙命。哪怕掙不到，也應該像一團火一樣燒起來，哪能就這樣麻木地死去呢？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380620
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380620,
					"content": "…這的確是師父會說的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380621
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380621,
					"content": "是他承認了我的天賦，是他鼓舞了我的精神。我與他一同切磋，那是我第一次從戰鬥中體會到快樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380622
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380622,
					"content": "十歲那年，他偷來了禁忌的研究資料，治好了我的病。世界上似乎沒有他做不到的事情…他不斷地以人類的身軀挑戰不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380623
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380623,
					"content": "我卻在這個過程中掉隊了。我的天賦與他相比不值一提，不知從什麼時候開始，他遠遠地走在我前面，我甚至無顏再找他對練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380624
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380624,
					"content": "「事變」成功後，蘇爾特洛奇找到我，對我說——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380625
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380625,
					"content": "這顆星球上已經沒有我感興趣的東西，我就要離開了。在那之前，要不要我用剛剛煉就的力量，幫你打破不死詛咒？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380626
					],
					"speakerTitle": "蘇爾特洛奇"
				},
				{
					"id": 150380626,
					"content": "雖然我們曾竭盡全力避免你的死亡，但若是陷入「不死」，那就是另一種痛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380627
					],
					"speakerTitle": "蘇爾特洛奇"
				},
				{
					"id": 150380627,
					"content": "算了，不死對我來說也滿好的。無限的生命，意味著我能不斷地變強——也許有一天，我們能再次如過去那般交手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380628
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380628,
					"content": "想好了？我這一去可不知道要多久才會回來，你的身體…或者說你的靈魂可未必吃得消。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380629
					],
					"speakerTitle": "蘇爾特洛奇"
				},
				{
					"id": 150380629,
					"content": "總要試試才行。人要為自己掙命，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380630
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380630,
					"content": "說得好。不過，如果有一天你受夠了永生帶來的痛苦，想在臨走前痛痛快快地打一架，就去找我的徒弟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380631
					],
					"speakerTitle": "蘇爾特洛奇"
				},
				{
					"id": 150380631,
					"content": "徒弟？從你嘴裡說出來，真是個新鮮的詞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380632
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380632,
					"content": "是啊，維瑟弗尼爾說我會在宇宙中收個徒弟，並且把她送來提瓦特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380633
					],
					"speakerTitle": "蘇爾特洛奇"
				},
				{
					"id": 150380633,
					"content": "你也認識維瑟弗尼爾，他的預言一向很可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380634
					],
					"speakerTitle": "蘇爾特洛奇"
				},
				{
					"id": 150380634,
					"content": "那我倒有點好奇了——什麼樣的徒弟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380635
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380635,
					"content": "維瑟弗尼爾沒說，只告訴我未來某一天「群星會向她致意」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380636
					],
					"speakerTitle": "蘇爾特洛奇"
				},
				{
					"id": 150380636,
					"content": "聽起來是個了不起的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380637
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380637,
					"content": "那當然。不是了不起的人，有資格做我的徒弟嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380638
					],
					"speakerTitle": "蘇爾特洛奇"
				},
				{
					"id": 150380638,
					"content": "你還是和以前一樣充滿自信。不過嘛，倒也的確如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380639
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380639,
					"content": "走了。另外，如果你真的執意變強，原始胎海有我留給你的禮物。還是那句話，想走什麼路隨你喜歡，惡人有惡人的自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380640
					],
					"speakerTitle": "蘇爾特洛奇"
				},
				{
					"id": 150380640,
					"content": "於是我來到原始胎海，看到了被蘇爾特洛奇打得奄奄一息的吞星之鯨。趁牠正虛弱，我切下牠部分的身體，縫進我的心臟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380641
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380641,
					"content": "心、心臟？聽起來好痛…這種事真的能辦到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380642
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150380642,
					"content": "可以，因為我身上有「不死詛咒」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380643
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380643,
					"content": "你反過來利用了不死詛咒，讓自己成為了力量的容器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380644
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380644,
					"content": "縱然有吞星之鯨的權柄，人類的身軀也無法承受吞噬而來的力量，是不死詛咒維繫了你隨時都在崩潰的肉身與靈魂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380645
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380645,
					"content": "但是這不是通向強者的路。力量應當是浸透心血與夢想的傑作，搶來的財富終歸不屬於你，所以才會出現反噬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380646
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380646,
					"content": "妳說得一點都沒錯。我本該知曉這個道理，但…我已經觸摸到了自己的極限，卻還是離他太遠，只能放手一搏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380647
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380647,
					"content": "#我很想念妳的師父，想念那些無家可歸的惡徒歡聚在一起的時光。我不後悔做這個選擇，但是——請允許我向妳、向{F#妳}{M#你}們道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380648
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380648,
					"content": "揍了你一頓，算扯平了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380649
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380649,
					"content": "#哈…{F#妳}{M#你}也是個有趣的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380650
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380650,
					"content": "「蘇爾特洛奇的弟子」…名頭滿唬人，不過當那個人的弟子應該很辛苦吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380651
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380651,
					"content": "以他的性格，一定會帶給妳絕望和恐懼，逼迫妳不斷追趕他的腳步，但他偏偏又站在很高的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380652
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380652,
					"content": "我們就像夜晚中的登山客，不知道山有多高，也不知道太陽什麼時候出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380653
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380653,
					"content": "如你所說。但我早已打定主意，無論是怎樣的絕望，我都會跨過它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380654
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380654,
					"content": "而且，聽你說完之後，我的心裡隱約有種感覺。師父他渴望的或許並不是「酣暢淋漓的戰鬥」，而是「不留遺憾的失敗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380655
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380655,
					"content": "哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380656
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380656,
					"content": "你是師父的朋友，對吧？朋友之間，一定有相似的特質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380657
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380657,
					"content": "第一次來這裡時，你在濃霧中刺傷了我，奪走了我的力量。但是從那枚尖刺上，我感受不到任何情緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380658
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380658,
					"content": "反倒是第二次，當你使出全力想要擊敗我的時候，你的劍上傳來的是熱情與喜悅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380659
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380659,
					"content": "那種喜悅，就像是執著研究的人發現了世界的真相，就像是渴求藝術的人來到了宏偉的殿堂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380660
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380660,
					"content": "有趣，我確信自己並未表露出這些情感，妳竟能從劍上讀出我的內心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380661
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380661,
					"content": "#妳的直覺是對的。和{F#妳}{M#你}們交手讓我發自內心地喜悅，甚至輸掉也沒有任何遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380662
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380662,
					"content": "所以我想，也許師父和你一樣，也盼望著這樣一場戰鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380663
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380663,
					"content": "他的對手能夠逼迫他使出渾身解數，甚至連體內的潛能都全部燃盡。他會在戰鬥中突破自我，拼上此身此心的全部力氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380664
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380664,
					"content": "然後，讓自己與這場盛大的決鬥一同落幕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380665
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380665,
					"content": "正因如此，善與惡對他來說才都不重要，他唯一要做的就是「完成自我」。這也是他強大的秘密之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380666
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380666,
					"content": "妳說得對，或許他的確有這樣的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380667
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380667,
					"content": "那會是多麼壯觀的戰鬥啊，連我都心馳神往——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380668
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380668,
					"content": "咳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380669
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380669,
					"content": "你的身體…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380670
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150380670,
					"content": "不同的力量在我的身體中橫衝直撞，不死詛咒雖然能將它們捏合，但疼痛不會消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380671
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380671,
					"content": "很快我的理智就會再次被磨掉…真是可惜，沒辦法見證那場戰鬥了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380672
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380672,
					"content": "絲柯克，能拜託妳完成蘇爾特洛奇沒有做的事，給我一個解脫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380673
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380673,
					"content": "可以，但死亡不是唯一的解脫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380674
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380674,
					"content": "你的罪不至死，我可以換個方式。將你的意識，連同你吞噬來的各種力量一同打碎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380675
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380675,
					"content": "雜質消散，而你的身心在不死詛咒的影響下重新凝聚。到那時你可以回到過去純淨的樣子，不再受失控的力量折磨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380676
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380676,
					"content": "這需要很長時間，也伴隨著很大的痛苦，一切看你的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380677
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380677,
					"content": "這樣也不錯。說不定等我醒來，還來得及目睹妳與蘇爾特洛奇之間的那場戰鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380678
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380678,
					"content": "我願意相信，有一天妳真的能和他一較高下。當然，想必那會是一條充滿艱辛的荊棘之路吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380679
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380679,
					"content": "我的夜晚結束了，而妳那漫長的征途仍要繼續。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380680
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380680,
					"content": "（好在——妳看起來並不孤獨。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380681
					],
					"speakerTitle": "斯克弗努格"
				},
				{
					"id": 150380681,
					"content": "我會爬上那座山，無論路有多難走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150380682
					],
					"speakerTitle": "絲柯克"
				},
				{
					"id": 150380682,
					"content": "斯克弗努格，你就在一切的盡頭見證吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "絲柯克"
				}
			]
		},
