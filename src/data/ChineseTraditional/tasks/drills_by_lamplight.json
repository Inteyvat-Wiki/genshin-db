			"completionStepIds": [
				7154101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7154101",
							"2"
						],
						"stepId": 7154101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"明瀾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715410101,
					"content": "不會真的是那位教頭負責吧…唉…只能祝他們好運了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410102
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410103
					]
				},
				{
					"id": 715410103,
					"content": "#啊！？是…是{F#妳}{M#你}啊，{NICKNAME}，呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410104
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410104,
					"content": "嚇我一跳，還以為是教頭過來了。要是被聽見，我可就又要被丟去訓練了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410105,
						715410106
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410105,
					"content": "你們…現在還在訓練？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410107
					]
				},
				{
					"id": 715410107,
					"content": "哎呀，節日越大，我們越忙嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410108
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410108,
					"content": "璃月港這麼大，從五湖四海來的遊客又這麼多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410109
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410109,
					"content": "為了維持秩序、保護大家的人身安全，千岩軍在城裡和野外都新設了不少移動部隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410110
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410110,
					"content": "#{F#妳}{M#你}知道移動部隊嗎？嗯…{F#妳}{M#你}就簡單理解成一隊走到哪，幫到哪的千岩軍吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410111
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410111,
					"content": "#需要幫助的話只要衝到那一隊人面前求助，他們就會幫{F#妳}{M#你}的忙啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410112
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410112,
					"content": "無論是遇到危險、弄丟東西，或甚至是迷路都可以去求助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410113
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410113,
					"content": "不過嘛…因為需要覆蓋的區域很廣，所以我們教頭把原本作為後備的預備隊伍也抓出來整訓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410114
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410114,
					"content": "但那群預備隊都是新兵，沒有受過多少訓練，所以教頭說乾脆舉辦個臨時演武會，好好提升一下他們的個人能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410115
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410115,
					"content": "我聽說…那位教頭下手可狠了，只要是被他訓練過的人，一聽到他的名字都會不由自主地哆嗦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410116
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410116,
					"content": "你…也被他訓練過？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410117
					]
				},
				{
					"id": 715410117,
					"content": "算…算是吧…那位教頭的訓練的確很有效，只是事後一想起來…腿還是會有點發軟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410118
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410118,
					"content": "#{F#妳}{M#你}想去試一試嗎？我在訓練的時候常常聽教頭提起{F#妳}{M#你}的名字，說{F#妳}{M#你}不僅精於戰陣，也很擅長搏擊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410119
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410119,
					"content": "#如果是{F#妳}{M#你}在演武場裡，成績一定比我們都好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715410120,
						715410122
					],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410120,
					"content": "我想去試試看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410121
					]
				},
				{
					"id": 715410121,
					"content": "行，這膽氣…真不愧是璃月的大英雄，那就請跟我來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410122,
					"content": "我再想想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410123
					]
				},
				{
					"id": 715410123,
					"content": "#沒問題，{F#妳}{M#你}想去試一試的話就和我說吧。放心，{F#妳}{M#你}要是想參加演武，教頭肯定高興得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "明瀾"
				},
				{
					"id": 715410106,
					"content": "現在不是海燈節嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715410107
					]
				}
			]
		}
	]
}