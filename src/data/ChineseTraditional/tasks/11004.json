			"dialogs": [
				{
					"id": 110040301,
					"content": "急凍樹，急凍樹，好吃的~急凍樹~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040302
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040302,
					"content": "急凍樹~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040303,
						110040305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110040303,
					"content": "妳太捧場了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040304
					]
				},
				{
					"id": 110040304,
					"content": "#那是{F#妳}{M#你}太拘謹了！拿到珍稀的食材，這世界上還會有比這更開心的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040307,
					"content": "啊，這邊好像還有什麼東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040308
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040308,
					"content": "這就是獵人先生說的他在追的野豬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110040309,
					"content": "但這種花紋從來沒有見過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110040310,
					"content": "我好像見過這個紋路！我想想，我想想…啊對了，是《璃月風物志》！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040311
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040311,
					"content": "這種花紋…嗯，不會錯的！這是已經滅絕了三百多年的野豬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040312
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040312,
					"content": "欸？！這麼長的時間，但為什麼還會活著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040313,
						110040315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110040313,
					"content": "因為被凍住了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040314
					]
				},
				{
					"id": 110040314,
					"content": "有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110040317,
					"content": "書裡講過，這種野豬就是因為肉質太鮮美，所以被捕殺滅絕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040318
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040318,
					"content": "急凍樹和野豬，撿到兩個寶貝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040319
					],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040319,
					"content": "這下勝券在握了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040320
					]
				},
				{
					"id": 110040320,
					"content": "嗯，我們這就回清泉鎮吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "香菱"
				},
				{
					"id": 110040315,
					"content": "因為比較長壽？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040316
					]
				},
				{
					"id": 110040316,
					"content": "那也太長壽了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110040305,
					"content": "急凍樹~",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110040306
					]
				},
				{
					"id": 110040306,
					"content": "#哈哈哈，為什麼{F#妳}{M#你}們唱出來就怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110040307
					],
					"speakerTitle": "香菱"
				}
			]
		}
	]
