			"trigger": {
				"objectNames": [
					"琳琅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722710102,
					"content": "我有寶物想要出售。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710103
					]
				},
				{
					"id": 722710103,
					"content": "您又找到了什麼稀奇東西？請讓我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710104
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710104,
					"content": "將龍骨花凝珠的故事告訴了琳琅。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722710105
					]
				},
				{
					"id": 722710105,
					"content": "聽您所說，這可是一件了不得的古物啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710106
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710106,
					"content": "只是我入手察看一番，並沒有感覺到特別明顯的異樣，或許需要長期使用才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710107
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710107,
					"content": "依我之見，您所聽來的神妙效用，可能有些誇大了，又或者…說不定只是失敗者的託辭呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710108
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710108,
					"content": "哈哈，您不用在意，我只是隨口一說，您聽聽便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710122
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710122,
					"content": "在我們古董行當裡，這種事情倒十分常見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710109
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710109,
					"content": "另外，您似乎沒有對它密封保存，粗粗看去，它的表面似乎已經有了一些耗損。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710110
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710110,
					"content": "這樣一來，價格又要小打一點折扣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710123
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710123,
					"content": "您看，80000摩拉如何？除此之外，再加5份特色料理豐年有餘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710111,
					"content": "我相信這是一個不錯的價格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710112,
						722710116,
						722710119
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710112,
					"content": "妳會拿它做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710113
					]
				},
				{
					"id": 722710113,
					"content": "其實跟它的功效相比，我倒覺得它背後的那段故事更有價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710114
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710114,
					"content": "我猜港裡的說書人、戲班子，或者玉京臺上的貴人們都會對它有興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710115
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710115,
					"content": "就算只擺在本店的櫃檯上展示，也能算上一件珍稀的古董了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710111
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710116,
					"content": "公道的價格，成交。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710117
					]
				},
				{
					"id": 722710117,
					"content": "您可真爽快，這些摩拉請收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710118
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710118,
					"content": "往後要是還有類似的寶貝，小店隨時恭候您的光臨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710119,
					"content": "我再考慮一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722710120
					]
				},
				{
					"id": 722710120,
					"content": "嗯，對於這種珍奇寶物，貨比三家…啊不是，價比三家也是應該的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722710121
					],
					"speakerTitle": "琳琅"
				},
				{
					"id": 722710121,
					"content": "如果您考慮好了，可以再來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琳琅"
				}
			]
		},
