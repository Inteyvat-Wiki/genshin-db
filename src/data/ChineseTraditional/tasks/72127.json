			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葉名山薰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270301,
					"content": "謝謝您，這些甜甜花就夠了，等會我就去做乾花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270302
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270302,
					"content": "對了，我還有一個小禮物送給您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270303
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270303,
					"content": "喏，這朵乾花請您拿好啦，雖然有點枯了…但這可是一朵很寶貴的花喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270304,
						721270305
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270304,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270307
					]
				},
				{
					"id": 721270307,
					"content": "這可是這片花海裡長出來的第一朵花，是您幫我找到的花種，所以，我想把這朵花送給您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270308
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270308,
					"content": "雖然也不是什麼很有價值的東西，但還是…非常謝謝您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270309
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270309,
					"content": "大家都會回來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270310
					]
				},
				{
					"id": 721270310,
					"content": "嗯！所以我得再多種點花，這樣大家回來的時候，就能看到更多的花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270305,
					"content": "有什麼特別的地方嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270306
					]
				},
				{
					"id": 721270306,
					"content": "當然有特別的地方啦，不然我可不會特別把它送給您呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270307
					],
					"speakerTitle": "葉名山薰"
				}
			]
		}
	]
