			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葉名山薰"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721270101,
					"content": "您來啦，您注意到周圍了吧，已經有很多花開了，怎麼樣，漂亮嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270102,
						721270104
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270102,
					"content": "很漂亮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270103
					]
				},
				{
					"id": 721270103,
					"content": "嘿嘿…那當然啦。我可是很用心在照顧它們呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270106,
					"content": "對了，能請您再幫我個忙嗎？現在花開得這麼好了，我本來想要去摘幾朵花做成乾花，和信一起寄給那些還沒有回踏鞴砂的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270107
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270107,
					"content": "但是…不知道是不是我睡太少了，剛才出去採了幾朵花就累得不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270108
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270108,
					"content": "能拜託您幫我去這周圍摘幾朵甜甜花來嗎？只要三朵就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270109,
						721270111
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270110
					]
				},
				{
					"id": 721270110,
					"content": "那就拜託您了，我在這稍微休息一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270112
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270112,
					"content": "我只是想要甜甜花那種吸引人的香氣，信件裡也會附上其他乾花的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270113
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270113,
					"content": "我想，讀信的時候被甜甜花的香氣環繞…讀信人的心情說不定也會好一些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270114
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270114,
					"content": "那就拜託您了，我在這稍微休息一下…您摘到花之後，就請拿來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721270111,
					"content": "甜甜花好像隨處都可見…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270112
					]
				},
				{
					"id": 721270104,
					"content": "妳種了多久？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721270105
					]
				},
				{
					"id": 721270105,
					"content": "也沒有太久啦，就是…就是稍微少睡了一點而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721270106
					],
					"speakerTitle": "葉名山薰"
				}
			]
		},
