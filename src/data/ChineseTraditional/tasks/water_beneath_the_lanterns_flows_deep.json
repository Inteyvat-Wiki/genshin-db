			"trigger": {
				"objectNames": [
					"嘉毅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400021501,
					"content": "請留步，前方是璃月總務司。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021502
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 400021502,
					"content": "我們是來舉報可疑人士形跡的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021503
					]
				},
				{
					"id": 400021503,
					"content": "我們在明霄燈的易燃材料堆放現場，看到了鬼鬼祟祟的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021504,
					"content": "絕對不能讓做出「中原雜碎」的小攤就這麼沒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021505,
					"content": "啊，這可是件大事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021506
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 400021506,
					"content": "對吧對吧。璃月港的美食可是城市的神髓——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021507,
					"content": "呃，我們說的應該不是同一件「大事」。不過小傢伙妳說得也沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021508
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 400021508,
					"content": "具體情況我知道了，我會向上級如實轉達的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021509
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 400021509,
					"content": "謝謝你們的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021510
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 400021510,
					"content": "一定一定，要嚴肅對待哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}