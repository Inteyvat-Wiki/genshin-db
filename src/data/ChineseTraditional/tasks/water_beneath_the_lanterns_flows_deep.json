			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慧心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020501,
					"content": "啊，這是…「嵐生石」和「霞生石」，品質都很不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020502
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020502,
					"content": "謝謝你們！這是報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020503
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020503,
					"content": "你們的每一次努力所得，都會為海燈節增光添彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020504
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020504,
					"content": "對了，既然在海燈節期間來璃月旅行，不如多關注一下「明霄燈」的變化吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020505
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020505,
					"content": "隨著進度推進，碼頭上的建設工地，會有越來越值得一看的風景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020506
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020506,
					"content": "#聽起來很有趣，{NICKNAME}，我們現在就過去看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4000214,
			"completionStepIds": [
				4000214
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
