			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慧心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400020201,
					"content": "喔，是你們啊，感謝你們來為海燈節捐贈物資。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020202
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020202,
					"content": "說起來，今天其實有一件「捐贈」以外的事…嗯，具體來說是「收購」，你們感興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020203
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020203,
					"content": "欸？這次不是無償的嗎？那我很感興趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400020204,
					"content": "哈哈，那就拜託你們了，事情是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020205
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020205,
					"content": "我們為了操辦節日事宜，需要兩種特殊的「浮生石」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020206
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020206,
					"content": "一種叫做「嵐生石」，在天衡山北部偶爾會有發現記錄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020207
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020207,
					"content": "根系下埋藏著嵐生石的普通灌木，有時會變異成「蓬蓬果」，讓種子浮空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020208
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020208,
					"content": "另一種叫做「霞生石」，它對一般人來說非常危險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020209
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020209,
					"content": "在歸離原，失去飛行動力的老舊「遺蹟獵者」，會靠「霞生石」維持自己的飛行能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020210
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020210,
					"content": "瞭解！「嵐生石」和「霞生石」是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400020211,
					"content": "（其實就是紅色和藍色的浮生石啦…好聽的名字都是寶石商人故意起的…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400020212
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 400020212,
					"content": "沒錯，就拜託你們把它們帶回來了。要加油喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "慧心"
				}
			]
		},
		{
			"id": 4000205,
			"completionStepIds": [
				4000205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
