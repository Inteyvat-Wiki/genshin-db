				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400021001,
					"content": "在海燈節的最後一天，會有很多很多人來看「明霄燈」放飛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021002,
					"content": "在這麼危險的地方出現可疑人物，我覺得一定沒有好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021003,
					"content": "如果他在堆放的易燃材料裡，做了什麼手腳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021401
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021401,
					"content": "看來必須得依靠官家的力量了！趕緊去璃月的「總務司」，彙報這件事情吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021406,
					"content": "為什麼感覺派蒙對這件事這麼在意？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021407
					]
				},
				{
					"id": 400021407,
					"content": "那，那是…璃月大家一起努力的成果啊！絕對不允許搗亂行為！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021408,
					"content": "說實話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021409
					]
				},
				{
					"id": 400021409,
					"content": "碼頭附近的「中原雜碎」是真的好，吃過一次忘不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400021410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400021410,
					"content": "你在複讀攤主的吆喝嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400021411
					]
				},
				{
					"id": 400021411,
					"content": "欸嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
