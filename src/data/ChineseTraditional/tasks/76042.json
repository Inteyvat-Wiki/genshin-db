			},
			"dialogs": [
				{
					"id": 760420101,
					"content": "寶藏獵人在搜刮海盜船殘骸時被鬼魂襲擊…聽起來像是三流娛樂小說會寫的題材呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420102
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420102,
					"content": "挨揍的那幾個傢伙向來說話不著邊際，也不知道他們的話有幾分真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420103
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420103,
					"content": "那艘海盜船，雅珂達也聽說過吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420104
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760420104,
					"content": "聽過聽過，雖然那時候我還小，但阿特拉號的大名我也是知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420105
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420105,
					"content": "「要是不聽話，就會被『盾女』洛維薩抓走，被『瘋子』格瑞蒂爾丟進海裡餵魚！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420106
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420106,
					"content": "以前還有大人拿這些話嚇唬小孩呢。當然，我是一點也不怕啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420107
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420107,
					"content": "呵呵，既然如此，那這次任務的人選也非妳莫屬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420108
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760420108,
					"content": "…欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420109
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420109,
					"content": "好吧…雖然有點遠，不過我會好好調查的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420110
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420110,
					"content": "（那片海域沉船不少，時不時有人挖到寶物，說不定這次我也…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420111
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420111,
					"content": "可別因為尋寶而耽誤了正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420112
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760420112,
					"content": "知、知道了，老闆！我一定速去速回！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂達"
				}
			]
		},
		{
			"id": 7604202,
