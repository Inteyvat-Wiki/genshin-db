			"trigger": {
				"objectNames": [
					"伊爾瑪里"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2428.906,
							200.527,
							8923.907
						],
						"pointId": 14142
					},
					{
						"sceneId": 3,
						"position": [
							2427.081,
							200.4,
							8922.118
						],
						"pointId": 14143
					},
					{
						"sceneId": 3,
						"position": [
							2427.91,
							200.376,
							8922.991
						],
						"pointId": 14144
					}
				]
			},
			"dialogs": [
				{
					"id": 760420201,
					"content": "看妳的打扮…妳也是來尋寶的寶藏獵人？你們這些人三天兩頭地來，還真是樂此不疲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420202
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420202,
					"content": "老爺子看得很準。這不是聽說之前有同行敗在這裡了嗎？還到處嚷嚷，說什麼自己是被鬼魂給襲擊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420203
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420203,
					"content": "我不信邪，偏要來看看這裡到底有沒有會打人的鬼…當然，要是能找到同行沒本事拿到手的寶物，那就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420204
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420204,
					"content": "老爺子，你就告訴我吧——他們說的會打人的鬼，到底是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420205
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420205,
					"content": "哪有什麼會打人的鬼？挨打的是人，打人的自然也是人。不過說到這個，那的確是惡鬼一樣的人，雖然活著，說不定早就死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420206
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420206,
					"content": "…啊？老爺子，你該不會是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420207
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420207,
					"content": "我可沒糊塗。阿特拉號妳聽過嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420208
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420208,
					"content": "聽過，不過它不是早就沉了嗎？而且就在這附近吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420209
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420209,
					"content": "船上最值錢的寶貝，就要數能帶人找到雷德·米勒留下的「偉大財寶」的信物了，不過到現在還沒人找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420210
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420210,
					"content": "你知道得還滿多的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420211
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420211,
					"content": "哼哼，這叫職業素養。欸？這麼說，打人的人和阿特拉號有關係？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420212
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420212,
					"content": "沒錯。當年的海難雖然慘烈，但也有不少倖存者，「裂顎」哈爾克就是其中之一。阿特拉號叫得上名號的海盜也就剩他一個了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420213
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420213,
					"content": "聽說他這些年先是去了至冬堡，近來又跟著什麼商隊做事。最近是在那夏鎮犯了什麼事吧，商隊也容不下他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420214
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420214,
					"content": "那天幾個寶藏獵人在阿特拉號的殘骸附近翻找，「裂顎」哈爾克看見了，就給他們一頓好打。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420215
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420215,
					"content": "那是他的船，哪怕沉了，也還是他的船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420216
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420216,
					"content": "是啊。聽說在海難之後他再也不敢乘船遠航，想必是不打算也做不了海盜了。但像他那樣的人要做正經的工作，可不是容易的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420217
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420217,
					"content": "過去被他…被阿特拉號「關照」過的人鐵定不會善罷甘休。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420218
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420218,
					"content": "不過這都是他自己選的，也怨不得別人。自己選的，就得自己承受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420219
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420219,
					"content": "人活著哪有不犯錯的？要緊的是及時轉舵。這哈爾克自己就是舵手，卻一錯再錯，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420220
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420220,
					"content": "看來是這個哈爾克在那夏鎮捅了婁子之後回到這裡，對他來說是結束的地方，也是開始的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420221
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420221,
					"content": "但是這一次他也做了錯誤的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420222
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420222,
					"content": "本性難移講的就是這麼一回事吧。他在這塊害了不少人，後來人就跟滑手的魚似的，一下沒了蹤影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420223
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420223,
					"content": "聽說那夏鎮的「旗艦」也開出了懸賞，那麼多人撒網去找，連根頭髮都沒撈到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420224
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420224,
					"content": "沒想到老爺子魚沒釣到幾條，消息倒是滿靈通的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420225
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420225,
					"content": "妳這伶牙俐嘴的…那我再告訴妳一個好消息吧。阿特拉號的殘骸就在那邊，妳大可以去碰碰運氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420226
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420226,
					"content": "碰碰運氣？那要是他真的不知道從哪裡蹦出來揍我，老爺子你會幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420227
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760420227,
					"content": "當然不幫。我只是個釣魚的，能幫什麼忙？最多陪妳到附近，幫妳指個路吧…反正這裡看起來是釣不到什麼魚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760420228
					],
					"speakerTitle": "伊爾瑪里"
				},
				{
					"id": 760420228,
					"content": "唉，說得也是。沒關係，打不過的話我還不能開溜嗎？逃跑我還是很擅長的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂達"
				}
			]
		},
