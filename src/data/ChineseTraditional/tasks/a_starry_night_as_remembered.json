			"dialogs": [
				{
					"id": 790540301,
					"content": "傑洛尼！我們回來啦，你看，這就是我們說的畫片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790540302,
					"content": "…真的，看起來跟真的一模一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540303
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540303,
					"content": "這張畫片，真的能給我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540304
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540304,
					"content": "本來就是為你拍的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790540305,
					"content": "#哈哈，謝謝…謝謝{F#妳}{M#你}們，沒想到我還能看到這麼厲害的技術。已經都有這樣的技術了，說不定在蜃境之外能看到飛車也不是夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540306
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540306,
					"content": "真是漂亮的星空啊，如果那個時候有這樣的技術就好了，這樣…他也可以隨時看到這片星空了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑洛尼"
				}
			]
		},
