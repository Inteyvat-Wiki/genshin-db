				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"傑洛尼"
				],
				"points": [
					{
						"sceneId": 10,
						"position": [
							-86.963,
							390.917,
							1393.968
						],
						"pointId": 69
					}
				]
			},
			"dialogs": [
				{
					"id": 790540101,
					"content": "#咦，{F#妳}{M#你}們怎麼到這裡來了？這裡沒有軌道，也很高，又在整個琉形蜃境邊緣的位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540102
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540102,
					"content": "平時很少有人會到這邊來，就連伊迪婭…哼哼，我懷疑她自己都根本不知道有這麼個地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540103
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540103,
					"content": "這裡什麼都沒有嘛，傑洛尼在這裡做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790540104,
					"content": "我只是稍微出來散散心啦…咦，別用那種「不會又和費迪南德吵架，所以離家出走了吧！」的眼神看我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540105
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540105,
					"content": "沒有，真的沒有吵架，我之所以會到處跑是出於，呃，該怎麼說，是出於個人興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540106
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540106,
					"content": "之前不是也說過嗎，「呼呼飛車」一開始的想法是我提出的，那時我的想法就是，有什麼東西能夠輕鬆爬到高處就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540107
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540107,
					"content": "所以我…所以傑洛尼才想出了飛車和軌道，那是因為喜歡天空和高處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540108
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540108,
					"content": "很像個傻瓜吧，我記得稻妻也有那種諺語，什麼只有腦子不好的人和煙喜歡往上跑之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540109,
						790540110
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540109,
					"content": "能想到飛車就很了不起。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				},
				{
					"id": 790540111,
					"content": "但是在琉形蜃境中，才能建起這樣的飛車。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540112
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540112,
					"content": "…算了，不提這個。我到這裡來的原因還有一個，那就是為了觀賞這裡的星空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540113
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540113,
					"content": "雖然琉形蜃境的星空應該也只是瓶外星空的折影，但是對我來說也足夠美麗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540114
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540114,
					"content": "每天晚上…只要看著這片星空，心中就會感受到無比的安寧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540115
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540115,
					"content": "喜歡星空的，是傑洛尼嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540116
					]
				},
				{
					"id": 790540116,
					"content": "只要看到那樣的星空，不管誰都會喜歡上的。真是可惜啊，如果白天也能看到星空就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540117
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540117,
					"content": "當然了，如果不用每天爬到這裡也能看到那就更好了，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540118
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540118,
					"content": "啊，這樣的辦法！我想到了一個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790540119,
					"content": "咦，真的有這樣的辦法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540120
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540120,
					"content": "只要拍攝畫片就好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540121
					]
				},
				{
					"id": 790540121,
					"content": "…畫、畫片？原來現在還有那麼先進的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540122
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540122,
					"content": "嗯，不如我們拍一張星空的畫片給傑洛尼看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790540123,
					"content": "真的可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540124
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540124,
					"content": "當然可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540125
					]
				},
				{
					"id": 790540125,
					"content": "不過，不知道哪裡能拍出好看的星空呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790540126,
					"content": "啊，這裡！夜晚，在這邊的平臺上，能看到最漂亮的星空，這也是為什麼我爬到這裡來的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790540127
					],
					"speakerTitle": "傑洛尼"
				},
				{
					"id": 790540127,
					"content": "這樣啊，好！傑洛尼你就等我們的畫片吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790540110,
					"content": "飛車很有趣喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790540111
					]
				}
			]
		},
