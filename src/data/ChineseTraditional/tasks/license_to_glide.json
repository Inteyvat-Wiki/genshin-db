			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4820202,
					"content": "倒是看完了，但…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820203,
					"content": "規章制度…實在熟悉不了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4820204
					]
				},
				{
					"id": 4820201,
					"content": "#啊，{F#妳}{M#你}來了。已經把飛行指南好好看過了嗎？規章制度都熟悉了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820202,
						4820203
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820204,
					"content": "唔，這個勉強的語氣，我瞭解我瞭解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820205
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820205,
					"content": "飛行指南就是這麼枯燥無趣啦，我也一點都看不下去…呀，別告訴琴團長我說過這話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820206
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820206,
					"content": "是嗎？我覺得這本「飛行指南」裡講的故事其實還蠻有趣的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4820207,
					"content": "#有趣的故事？哦——{F#妳}{M#你}是說後面附錄的案例啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820208
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820208,
					"content": "有些我也挺喜歡，最喜歡的是用風史萊姆違規起飛的那個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820209
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820209,
					"content": "借助風史萊姆被打破的時候爆發的氣流，說是能一下子飛得很高很高，真想試試看哪——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820210
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820210,
					"content": "不是這個啦！是一隻小鳥想要學會飛行的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4820211,
					"content": "咦…啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820212
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820212,
					"content": "我看看…呀！這不是我小時候最喜歡讀的寓言書嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820213
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820213,
					"content": "對不起！我昨天把它和騎士團飛行指南放在一起，肯定是出門的時候拿錯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820214
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820214,
					"content": "這兩本書…有拿錯的可能性嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4820215,
					"content": "呃…事到如今再聊這個，實在有些不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820216
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820216,
					"content": "但拿錯的原因，也許是因為在我心裡，這本書才是教會我飛行的指南吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820217
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820217,
					"content": "「重要的不是強風而是勇氣，是它讓你們成為世上最初的飛鳥」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820218
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820218,
					"content": "就是這句話給了我飛行的勇氣，讓我成為偵察騎士，和蒙德城的飛行冠軍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820219
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820219,
					"content": "好了好了，不說這些了，我們趕緊開始考試吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820220
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820220,
					"content": "#別緊張，只要發揮出{F#妳}{M#你}平時的飛行水準就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820221
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4820222,
					"content": "我準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4820221,
					"content": "#按照我給{F#妳}{M#你}<color=#00E1FFFF>標記好的路線</color>，一路平穩地飛到終點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4820222
					],
					"speakerTitle": "安柏"
				}
			]
		},
