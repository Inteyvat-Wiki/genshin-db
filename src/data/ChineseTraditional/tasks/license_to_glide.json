			"dialogs": [
				{
					"id": 4800401,
					"content": "#很好！不愧是在暴風裡也能掌握平衡的{F#妳}{M#你}，順利通過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4800402
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4800402,
					"content": "#接下來的測驗是在蒙德城，那麼我先去城裡了，{F#妳}{M#你}也快點過來吧。",
					"roleType": "TALK_ROLE_NPC",
