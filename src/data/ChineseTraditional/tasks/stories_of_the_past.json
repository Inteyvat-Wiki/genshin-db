				"points": []
			},
			"dialogs": [
				{
					"id": 742510201,
					"content": "很高興能一邊品水一邊與吉約丹小姐分享過去的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510202,
						742510203
					],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 742510202,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742510204,
					"content": "好，祝妳前路順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "那維萊特"
				},
				{
					"id": 742510203,
					"content": "茶會時間該結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742510204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
}