			"dialogs": [
				{
					"id": 120480101,
					"content": "那位客人，到這裡登記！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480102
					],
					"speakerTitle": "百日白白音"
				},
				{
					"id": 120480102,
					"content": "什麼日子啊，來這麼多人？早知道就限制人數了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480103
					],
					"speakerTitle": "柴葉紫"
				},
				{
					"id": 120480103,
					"content": "哇，那個江村一玄齋的問題被解決後生意好了很多嘛！阿紫和白音恢復得也很不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120480104,
					"content": "#早啊，{NICKNAME}、派蒙，來預約？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480105
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480105,
					"content": "對啊，就約今天！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120480106,
					"content": "那我需要再幫兩位準備一份貴賓邀請函，畢竟兩位都是本店的貴客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480107
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480107,
					"content": "好耶！這次我想先體驗美食服務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120480108,
					"content": "哎呀，前天剛給過撤股的建議，差點讓妳丟掉這麼好的生意，妳不會埋怨我吧，老朋友？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480109,
					"content": "我根本沒有考慮妳的建議，何來埋怨呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480110
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480110,
					"content": "就是這個語氣，很親切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480111,
					"content": "妳又搞突然出現這一套…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120480112,
					"content": "早啊，兩個小傢伙，昨晚的夜色還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480113
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480113,
					"content": "妳偷看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480114
					]
				},
				{
					"id": 120480114,
					"content": "偷看？那棵樹就在鳴神大社下面，難道要我把鳴神大社搬走嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480115
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480115,
					"content": "宮司大人來這裡，所為何事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480116
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480116,
					"content": "嗯…就當是隨便逛逛吧，順便帶來一個天領奉行的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480117
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480117,
					"content": "妳的族人昨晚從水裡撈上來的那個傢伙已經脫離了生命危險，但心智似乎降低到了小孩子的等級。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480118
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480118,
					"content": "這樣也好…另外，我先向宮司大人道謝了，昨天的事情能順利解決，多虧了宮司大人的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480119
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480119,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480120
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480120,
					"content": "不是我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120480121
					]
				},
				{
					"id": 120480121,
					"content": "神子，我們兩個之間藏不住心思的向來不是我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480122
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480122,
					"content": "要說面對妳時的自卑和要強這兩種情緒，我當然會有——或者說就是依靠這兩種情緒，我才有動力經營這份產業。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480123
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480123,
					"content": "自卑讓我時刻保持清醒，要強讓我能堅持下去。這是已經被妥善處理的心理問題，不需要讓妳如此顧忌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480124
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480124,
					"content": "唉…還不如早點講明呢，也不用讓這小傢伙兩頭跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480125,
					"content": "#{NICKNAME}的行動還是很有意義的，畢竟要為宮司大人考慮一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480126
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480126,
					"content": "那個「江村一玄齋」聚集了大批信徒，在他的底細被曝光之前，鳴神大社的宮司貿然介入進行打壓的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480127
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480127,
					"content": "一幫吵吵鬧鬧的信徒會對鳴神大社的名譽帶來多少影響，很難估量，所以宮司大人明面上最好沒有過問此事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480128
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480128,
					"content": "這一點我當然知道，但還是老朋友的心情更讓我顧忌一些，否則也沒必要搞那麼多彎彎繞繞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480129
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480129,
					"content": "神子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480130
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480130,
					"content": "妳還是那個有趣但不怎麼可愛的傢伙…看來擔心妳會有煩惱果然沒什麼必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480131
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120480131,
					"content": "我還是會有煩惱的…不過，每種煩惱都有各自對應的解藥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120480132
					],
					"speakerTitle": "夢見月瑞希"
				},
				{
					"id": 120480132,
					"content": "這是新的邀請函，請收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夢見月瑞希"
				}
			]
		},
