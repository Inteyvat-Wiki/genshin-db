				"points": []
			},
			"dialogs": [
				{
					"id": 200730201,
					"content": "補給都放好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730202
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730202,
					"content": "都放好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730203
					]
				},
				{
					"id": 200730203,
					"content": "太好了，這下我能放心點了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730204
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730204,
					"content": "不過，我還是希望所有上雪山的人都做好充分的準備，不要動用到這些應急食品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730205
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730205,
					"content": "#話說回來，{F#妳}{M#你}身上這些衣服也有點單薄了，難道這就是蒙德城裡最新的時尚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730206
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730206,
					"content": "請拿上這些報酬，趕快回去多添點衣服吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里瑟"
				}
			]
		},
