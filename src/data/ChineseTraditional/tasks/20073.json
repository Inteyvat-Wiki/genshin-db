	"talks": [
		{
			"id": 2007301,
			"completionStepIds": [
				2007301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2007301",
							"2"
						],
						"stepId": 2007301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里瑟"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200730101,
					"content": "#旅行者！{F#妳}{M#你}來得正好，能幫我個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730102
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730103
					]
				},
				{
					"id": 200730103,
					"content": "#{F#妳}{M#你}也看到了，雪山上的環境很惡劣，即使是經驗豐富的冒險家，也不敢說自己能完全應付裡面的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730104
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730104,
					"content": "我奉代理團長大人的命令在這裡駐守，警告蒙德的居民不要上雪山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730105
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730105,
					"content": "不過，我是勸住了不少想要上山的蒙德居民，但是那些冒險家嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730106
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730106,
					"content": "#{F#妳}{M#你}也知道的，就算是勸他們不能輕易上去，他們也不會聽，就是要往雪山裡走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730107
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730107,
					"content": "我都不知道我處理了多少件和冒險家有關的事了…但想要上雪山的冒險家數量，就是有增無減。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730108
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730108,
					"content": "想要管到每個冒險家是不可能的…所以，我們計劃在雪山的一些地點上投放些補給。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730109
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730109,
					"content": "這樣的話，那些吃到了苦頭，準備往回走的冒險家們，還能多些退出雪山的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730110
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730110,
					"content": "不過…要是有運氣好過頭的楞頭冒險家走得太裡面，那就只能靠他們自己了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730111
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730111,
					"content": "#總之，能請{F#妳}{M#你}幫忙去把這些補給放在雪山裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730112,
						200730114
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730112,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730113
					]
				},
				{
					"id": 200730113,
					"content": "#那就拜託{F#妳}{M#你}了。唉，要是那些冒險家都像{F#妳}{M#你}這樣，有實力又知道進退，那該多好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730117,
					"content": "#三個地點我已經標在{F#妳}{M#你}的地圖上了，每個地方放<color=#00E1FFFF>一份火腿</color>就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730118
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730118,
					"content": "唉，希望那些冒險家們能有些自知之明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730114,
					"content": "這樣有用嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200730115
					]
				},
				{
					"id": 200730115,
					"content": "有用沒用的…總之有總比沒有好嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730116
					],
					"speakerTitle": "里瑟"
				},
				{
					"id": 200730116,
					"content": "#在雪山這種惡劣的環境裡，能多一份補給總是好事，總之就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200730117
					],
					"speakerTitle": "里瑟"
				}
			]
		},
		{
			"id": 2007302,
			"completionStepIds": [
				2007306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
