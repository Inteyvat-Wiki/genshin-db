				]
			},
			"dialogs": [
				{
					"id": 705560101,
					"content": "#{F#妳}{M#你}們來了啊，{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560102,
					"content": "先認識一下新同事？這是第七小隊的信號官耶嘉，還有她的搭檔灰鬱香。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560103,
					"content": "#初次見面，榮譽騎士和白色小幫手，向{F#妳}{M#你}們致以敬意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560104
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560104,
					"content": "灰鬱香，來問好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560105
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560105,
					"content": "嘎啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560106,
						705560107
					],
					"speakerTitle": "灰鬱香"
				},
				{
					"id": 705560106,
					"content": "又一位信號官？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560108
					]
				},
				{
					"id": 705560108,
					"content": "這隻大大的鷹好聽話欸！居然還穿著鎧甲一樣的衣服，還揹著一個小包包？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705560109,
					"content": "等等，我有點迷糊了…安柏說的表演又是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705560110,
					"content": "和耶嘉小姐，還有這隻鷹有關嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705560111,
					"content": "啊哈哈，我來簡單解釋一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560112
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560112,
					"content": "#琴團長應該和{F#妳}{M#你}說過，我們這邊在舉辦風之翼競速射擊活動，沒錯吧？這是一種便於理解的說法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560113,
					"content": "#其實，有可能不同於{F#妳}{M#你}們的預期，這次更像是一次「飛行表演與指揮挑戰」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560114
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560114,
					"content": "核心不是傳統的風之翼滑翔，而是從地面向灰鬱香這樣的空中單位發信，引導牠做出各種複雜的行動，戰勝魔物標靶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560115
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560115,
					"content": "算是一種新奇的體驗，能為大家帶來小小的驚喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560116
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560116,
					"content": "嘎嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560117,
						705560118
					],
					"speakerTitle": "灰鬱香"
				},
				{
					"id": 705560117,
					"content": "從自己滑翔，改成指揮飛鷹？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560119
					]
				},
				{
					"id": 705560119,
					"content": "沒錯，這次飛行挑戰也是一種技術展示，目標是向同僚們展現騎士團偵察力量的發展方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560120
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560120,
					"content": "並非每位騎士都像安柏前輩這樣，能在滑翔中準確捕捉敵情，並簡明扼要地記錄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560121
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560121,
					"content": "而我和灰鬱香的使命，就是寫好條令，讓普通騎士與訓練有素的蒙德鷹順利配合，經營一雙「空中的眼睛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560122
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560122,
					"content": "這樣一來，就算沒有強勁的偵察騎士，也能長時間探明敵情，穩定地向前行軍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560123
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560123,
					"content": "甚至，透過灰鬱香裝備的前向武器，還能提前排除一些較為弱小的空中魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560124
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560124,
					"content": "好…好專業的感覺？口吻有點像工程師！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705560125,
					"content": "放輕鬆，耶嘉，不用像面對芙蕾德莉卡阿姨那樣嚴肅嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560126
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560126,
					"content": "#榮譽騎士和派蒙，{F#妳}{M#你}們就當是和新認識的動物朋友一起遊玩就好，開心最重要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560127
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560127,
					"content": "不好意思，前輩，我們只是有點…躍躍欲試，因為我和灰鬱香一直在為這次展示反覆練習。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560128
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560128,
					"content": "如果能被榮譽騎士和白色小幫手認可，代表條令已經趨於完善，稍稍潤色就能開始使用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560129
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560129,
					"content": "當然，展示過程中可能出現一些機械故障…這都是因為之前訓練的強度太高，耗盡了某些零件的使用壽命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560130
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560130,
					"content": "等到消耗性零件到位，統統替換上去，灰鬱香的背包在正式行動中就絕不會有差池，請別在意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560131
					],
					"speakerTitle": "耶嘉"
				},
				{
					"id": 705560131,
					"content": "嘎嗷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560132,
						705560133
					],
					"speakerTitle": "灰鬱香"
				},
				{
					"id": 705560132,
					"content": "我會嚴格一點，但不至於苛責。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560134
					]
				},
				{
					"id": 705560134,
					"content": "那、那我也要來好好試一試！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705560135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705560135,
					"content": "嘿嘿，聽起來，你們四位都幹勁滿滿啊，那就祝你們玩得開心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 705560133,
					"content": "不用擔心，我不會亂挑毛病的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560134
					]
				},
				{
					"id": 705560118,
					"content": "我們不上陣，坐鎮發令就好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560119
					]
				},
				{
					"id": 705560107,
					"content": "是沒聽過的職位…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705560108
					]
				}
			]
		}
	]
}