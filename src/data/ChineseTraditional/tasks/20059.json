			"trigger": {
				"objectNames": [
					"瑪喬麗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200590101,
					"content": "這下可糟糕了，怎麼辦呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590102
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200590102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590103
					]
				},
				{
					"id": 200590103,
					"content": "#旅行者！{F#妳}{M#你}來得正好！{F#妳}{M#你}知道，這裡是我家開的紀念品商店。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590104
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200590104,
					"content": "之前，我老爹會收購其他的冒險家帶回來的戰利品，然後擺在店裡賣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590105
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200590105,
					"content": "但是自從冒險家協會…不是那麼熱鬧之後，我能收購的東西也越來越少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590106
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200590106,
					"content": "而且還都是一些不怎麼值錢的東西，根本沒有客人願意買。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590107
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200590107,
					"content": "#旅行者，{F#妳}{M#你}會四處冒險對吧？能不能幫幫我，去找點好賣的戰利品回來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590108,
						200590110
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200590108,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590109
					]
				},
				{
					"id": 200590109,
					"content": "#那就拜託{F#妳}{M#你}了！找到之後，我一定把它賣個好價錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200590110,
					"content": "派蒙其實就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200590111
					]
				},
				{
					"id": 200590111,
					"content": "抱歉，應該沒人會買哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200590112
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200590112,
					"content": "因為…肯定會自己跑掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪喬麗"
				}
			]
		},
