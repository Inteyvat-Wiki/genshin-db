				],
				"points": []
			},
			"dialogs": [
				{
					"id": 2005902001,
					"content": "#唔，不過只是單單一句「好賣的東西」，{F#妳}{M#你}肯定也不知道找什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902002
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 2005902002,
					"content": "#我想想，不如{F#妳}{M#你}去找找<color=#00E1FFFF>「和丘丘人有關的戰利品」</color>吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005902003
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 2005902003,
					"content": "那些想要彰顯自己實力的冒險家們，說不定會很感興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪喬麗"
				}
			]
		},
