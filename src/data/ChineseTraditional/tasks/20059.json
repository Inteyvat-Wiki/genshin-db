			"dialogs": [
				{
					"id": 2005910001,
					"content": "這個是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910002
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 2005910002,
					"content": "#客人！{F#妳}{M#你}眼光真不錯，一眼就看中了我們店裡最好的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910003
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 2005910003,
					"content": "這是這位旅行者，剛從丘丘人首領手裡奪下來的戰利品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910004
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 2005910004,
					"content": "那個可怕的丘丘人，不知道危害了蒙德多長時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910005
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 2005910005,
					"content": "就算是這位旅行者，也是經歷了一場苦戰呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910006
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 2005910006,
					"content": "是，是這麼厲害的丘丘人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910007
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 2005910007,
					"content": "…要是我拿著這個給賽琉斯先生，或者史丹利先生看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910008
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 2005910008,
					"content": "他們說不定就會對我另眼相看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910009
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 2005910009,
					"content": "對啊客人，別擔心，本店絕對為顧客保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910010
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 2005910010,
					"content": "別猶豫了客人，這個貨物可是很搶手的喲——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						2005910011
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 2005910011,
					"content": "我要再想想…旅行者，她說的是真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑克"
				}
			]
		},
		{
			"id": 20059101,
