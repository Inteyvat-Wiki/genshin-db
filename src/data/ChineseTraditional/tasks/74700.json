			},
			"dialogs": [
				{
					"id": 747000101,
					"content": "嘿嘿，我覺得裝點水族箱明明還是很有趣的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747000102,
					"content": "既然桑多涅不介意，我們以後不如也多下去撈一點，讓這裡變得漂漂亮亮的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747000103,
					"content": "#喂，{F#妳}{M#你}們兩個，過來一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000104
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000104,
					"content": "嗯？怎麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747000105,
					"content": "#喏，這個給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000106
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000106,
					"content": "這是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747000107,
					"content": "#我幫{F#妳}{M#你}們改良的水下行動裝置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000108
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000108,
					"content": "欸？！真的嗎？謝謝妳桑多涅！妳人真好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747000109,
					"content": "#小機械裝置而已，舉手之勞。主要還是{F#妳}{M#你}們上次捕魚，怎麼說呢…很…原始…真讓人有些看不下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000110
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000110,
					"content": "有…有這麼不堪嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 747000111,
					"content": "效率低下，毫無技巧可言，而且一點都不優雅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000112
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000112,
					"content": "讓妳見笑了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000113
					]
				},
				{
					"id": 747000113,
					"content": "#算了，{F#妳}{M#你}們有{F#妳}{M#你}們的習慣，我不多說什麼。但既然{F#妳}{M#你}們想繼續裝飾這個水族館，最好帶著我給的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000114
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000114,
					"content": "#楓丹水下不只有溫和好看的小魚，還有很多具有攻擊性的危險大魚。這既是為{F#妳}{M#你}們的成功率著想，也是為了安全著想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						747000115,
						747000116
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000115,
					"content": "非常感謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				},
				{
					"id": 747000117,
					"content": "#哼，行了，要下水就快去吧。回來後記得告訴我裝置的使用感受，我可以根據{F#妳}{M#你}們的回饋進行調整。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 747000116,
					"content": "我會帶著的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						747000117
					]
				}
			]
		}
	]
}