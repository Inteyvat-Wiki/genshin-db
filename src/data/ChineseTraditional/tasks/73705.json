				]
			},
			"dialogs": [
				{
					"id": 737050201,
					"content": "…人氣真的有那麼高嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050202
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050202,
					"content": "內藏行走機構的方法還算巧妙，地形識別、遠距離控制和重量感應的模組也處理得不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050203
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050203,
					"content": "但外觀上，怎麼看都只是普通的布偶，要不然，還是改改吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050204
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050204,
					"content": "琺露珊前輩，我來告訴您一則好消息——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050205
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050205,
					"content": "#{NICKNAME}和派蒙加入了我們，「穩健知行」機構的隊伍變得更厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050206
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050206,
					"content": "嘿嘿，琺露珊前輩好！我們來幫忙啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050207,
					"content": "啊呀呀，這可不得了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050208
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050208,
					"content": "真不錯，柯萊！居然請來了兩位業內公認的頂尖專家，那不管我給出什麼評測，協會都要乖乖點頭囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050209
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050209,
					"content": "#正好，{F#妳}{M#你}們看看這個「解謎夥伴」，感覺怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050210
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050210,
					"content": "喔…居然直接用了琺露珊的形象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050211,
						737050212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050211,
					"content": "感覺舒適又愜意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050213
					]
				},
				{
					"id": 737050213,
					"content": "這就要問學院的後輩們，還有解謎協會和遺蹟機關研討會的成員了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050214
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050214,
					"content": "他們通力合作的產物，明明有著相當高的技術含量，卻要用孩子氣的外表來包裝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050215
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050215,
					"content": "尤其是後輩裡的阿尼斯，一個勁地解說採用這個外觀的優勢，比她在課題口試時還拼命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050245
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050245,
					"content": "當下的年輕人啊，是不是太過沉迷於可愛的東西了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050216
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050216,
					"content": "我可以說嗎？感覺這樣還滿不錯的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050217,
					"content": "柯萊和安柏剛剛還解釋過，可愛的夥伴能讓冒險家避免過度緊張，安安心心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050218,
					"content": "如果和琺露珊前輩的布偶一起冒險，哪怕是走進了到處烏漆抹黑的遺蹟，應該也不會緊張吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050219,
					"content": "這種考慮的確有道理，後輩們選定這個外形，也算是對我的某種尊重吧…咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050220
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050220,
					"content": "不過，也有相當多的冒險者，更重視機關的可靠性和技術能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050221
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050221,
					"content": "他們大概會認為「機關就應該表現得堅硬，要能承受落石轟擊，要表現出尖端的科技能力」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050222
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050222,
					"content": "這個「解謎夥伴」的外形太蓬鬆柔軟，反而不會給人…厲害和可靠的印象，說不定還有可能讓人分心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050223
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050223,
					"content": "如果換成磨砂金屬的厚重外殼，方方正正，並且適當展現複雜的機件，視覺上的鼓舞作用會更強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050224
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050224,
					"content": "哪怕是我，也有過因為外貌年輕而被人質疑的時候。假如我一頭白髮，他們大概就不會說閒話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050225
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050225,
					"content": "真、真的嗎？那我豈不是能讓那些人信服？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050226,
					"content": "啊？這…呃…這可不能混為一談！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050227
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050227,
					"content": "沒想到琺露珊前輩…在這方面意外地嚴格呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050228,
						737050229
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050228,
					"content": "我覺得現在的外形還不錯喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050230
					]
				},
				{
					"id": 737050230,
					"content": "#欸？連{NICKNAME}也支持？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050231
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050231,
					"content": "呃咳咳…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050232
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050232,
					"content": "#好吧！既然{NICKNAME}都這麼說了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050233
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050233,
					"content": "#我提議，之後就由{NICKNAME}來操縱「解謎夥伴」，嘗試破解幾個謎題典例。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050234
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050234,
					"content": "#我會好好評估{NICKNAME}運用這種機關的效率，然後根據{F#妳}{M#你}的表現，製作它的使用規範手冊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050235
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050235,
					"content": "至於外形的改進，還需要長期觀察，我就暫時擱置改善的建議好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050236,
						737050237
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050236,
					"content": "好耶！等等我一定好好表現！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050238
					]
				},
				{
					"id": 737050238,
					"content": "#等到{F#妳}{M#你}們準備停當，就來找我吧。我已經選擇了最適合的幾個秘境，隨時可以開始解謎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050239
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050239,
					"content": "#辛苦琺露珊前輩了，還請您稍等。接下來，我帶{NICKNAME}和派蒙去看看最後一個專案…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050240
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050240,
					"content": "哪裡哪裡，柯萊才是費神費力了，注意別累壞自己哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050241
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050241,
					"content": "#閒下來了，就叫{NICKNAME}和派蒙來前輩這裡坐一坐，歇一歇，吃些古法點心，慢慢聊聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050242
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050242,
					"content": "古法點心！我我我，我一定會來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050243,
					"content": "謝謝前輩，我也要帶幾盒上好的花茶來給您！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050244
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050244,
					"content": "去吧去吧，好好表現！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 737050237,
					"content": "我會讓解謎機關發揮最佳效能！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050238
					]
				},
				{
					"id": 737050229,
					"content": "方方正正的外形下次再說吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050230
					]
				},
				{
					"id": 737050212,
					"content": "完全看不出是探險裝備。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050213
					]
				}
			]
		},
