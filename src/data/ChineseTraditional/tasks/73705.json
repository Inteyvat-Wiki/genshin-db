			},
			"dialogs": [
				{
					"id": 737050101,
					"content": "#{NICKNAME}和派蒙！這邊這邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050102
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050102,
					"content": "歡迎來到「穩健知行」機構的主場！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050103
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050103,
					"content": "請看，幾個核心專案的設施已經搭建好了，大家隨時都可以投入工作——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050104
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050104,
					"content": "喔！這種氛圍，好像輕小說裡提過的…「年輕冒險家們的第一個據點」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050105,
					"content": "唔…又有點學園慶典的感覺，大家聚在一起，仔細研究課題後，組隊出發歷練自己…讓人躍躍欲試！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050106,
						737050107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050106,
					"content": "沒錯沒錯，充滿幹勁！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050108
					]
				},
				{
					"id": 737050108,
					"content": "雖然這個場地不像學園慶典那樣豪華，但按照提納里師父的說法，教令院會為我們調配「最有效能」的資源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050109
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050109,
					"content": "學生和學者們前往危險地帶之前，會來我們這裡仔細諮詢，甚至接受一番緊急訓練…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050110
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050110,
					"content": "如果有必要的話，我們會派遣專人加入他們的隊伍，充當可靠的嚮導和安全員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050111
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050111,
					"content": "按照時下流行的叫法，這裡是一半訓練，一半實戰的「前進基地」哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050112
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050112,
					"content": "讓新兵們意識到自己即將面對的挑戰，好好鍛煉一下拳腳，再踏入未知的領域，才不會手忙腳亂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050113,
					"content": "安柏？居然是妳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050114,
						737050115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050114,
					"content": "偵察騎士的工作範圍拓展了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050116
					]
				},
				{
					"id": 737050116,
					"content": "嘿嘿，驚喜吧？我也覺得意外！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050117
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050117,
					"content": "本來啊，我只是趁著輪班的空閒期間來須彌看望柯萊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050118
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050118,
					"content": "沒想到柯萊倒是忙了起來，那我可不能坐在一邊呆呆看著，就來扮演柯萊的副手好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050119
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050119,
					"content": "不好意思，安柏，沒能讓妳好好休假…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050120
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050120,
					"content": "沒這回事啦，充實和鬆弛對半分的假期也非常不錯嘛！這份臨時工讓我開了不少眼界哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050121,
					"content": "#而且，正是因為來幫妳的忙，我才能在意想不到的地方遇上{NICKNAME}和派蒙，更值得慶祝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050122
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050122,
					"content": "等到這邊的工作差不多穩定下來，我們一起去吃頓大餐，好好慶祝下吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050123
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050123,
					"content": "好哦！在須彌和我們冒險最初認識的夥伴碰頭，一起聚餐，肯定會像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050124,
					"content": "大份的蜜醬胡蘿蔔煎肉一樣開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050125,
						737050126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050125,
					"content": "那我們早點開工，早點收工！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050127
					]
				},
				{
					"id": 737050127,
					"content": "好呀！我們言歸正傳——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050128
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050128,
					"content": "柯萊和我負責的專案是「高速偵察夥伴」，旨在運用機關技術，快速通過危險地帶，勘測地形與魔物的詳情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050129
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050129,
					"content": "根據生論派的研究，在危險的環境中，可愛乖巧的夥伴能讓冒險者的心神安定，避免過度緊張…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050130
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050130,
					"content": "所以我們參考柯里安巴和兔兔伯爵的形象，製作了偵察機關「翠星柯里安巴」和「赤紅飛兔伯爵」，反應還不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050131
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050131,
					"content": "收集了充足的資訊後，教令院還會對偵察夥伴進行修改，推出各種不同外形的款式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050132
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050132,
					"content": "柯里安巴和兔兔伯爵快速衝刺…會是什麼樣的畫面呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050133,
						737050134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050133,
					"content": "很對！兩位是讓人安心的夥伴！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050135
					]
				},
				{
					"id": 737050135,
					"content": "#由{NICKNAME}來指引兩位偵察夥伴行動，肯定能獲得非常獨特的資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050136
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050136,
					"content": "#等{F#妳}{M#你}們瞭解整個「穩健知行」機構後，就可以來嘗試一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050137
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050137,
					"content": "接下來，請跟著我去和其他幾位顧問見個面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050138
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 737050138,
					"content": "那位青色頭髮的姐姐也有一名很可愛的夥伴機關哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050139
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050139,
					"content": "不過，用途和我們的「柯里安巴兔兔伯爵組合」不同呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050140
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050140,
					"content": "我很期待她們的表現！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050141
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 737050141,
					"content": "第二個專案…也是熟悉的面孔，太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737050142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050142,
					"content": "我們這就去和老朋友打個招呼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737050134,
					"content": "一時間還無法想像那種情景…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050135
					]
				},
				{
					"id": 737050126,
					"content": "為了開心地聚餐，先認真工作！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050127
					]
				},
				{
					"id": 737050115,
					"content": "柯萊招兵買馬的範圍這麼廣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050116
					]
				},
				{
					"id": 737050107,
					"content": "容我先看看派蒙喜歡的輕小說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737050108
					]
				}
			]
		},
		{
