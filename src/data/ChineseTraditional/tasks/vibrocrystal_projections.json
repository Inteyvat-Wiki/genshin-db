	"talks": [
		{
			"id": 7166401,
			"completionStepIds": [
				7166401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166401",
							"2"
						],
						"stepId": 7166401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716640101,
					"content": "#總算等到{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716640102,
					"content": "#最近冒險家協會接到了一份相當重要的委託，根據我的經驗，{F#妳}{M#你}是最合適的人選。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640103,
						716640104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716640103,
					"content": "相當重要的委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640105
					]
				},
				{
					"id": 716640105,
					"content": "不用這麼客氣啦，凱瑟琳小姐，我們早就習慣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640106,
					"content": "如果委託的報酬不夠豐厚，凱瑟琳小姐也不會來麻煩我們的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640107,
					"content": "#咳咳，倒也沒錯呢…不愧是{F#妳}{M#你}們，每次都這麼爽快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640108
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716640108,
					"content": "那我就直說好了，這次的委託人名叫派翠克，是一位來自楓丹的科學研究專家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640109
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716640109,
					"content": "他希望能雇傭幾位助手，幫助他進行科學研究，目前他正在層岩巨淵周邊進行考察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640110
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716640110,
					"content": "#雖然不清楚科學研究的詳細內容，但{F#妳}{M#你}們對這種委託已經是輕車熟路了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640111
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 716640111,
					"content": "確實如此…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640112
					]
				},
				{
					"id": 716640112,
					"content": "那就按照慣例辦事吧，我們先去層岩巨淵附近看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640104,
					"content": "似曾相識的對話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640105
					]
				}
			]
		},
		{
			"id": 7166402,
			"completionStepIds": [
				7166402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7166402",
							"2"
						],
						"stepId": 7166402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派翠克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 716640201,
					"content": "不能再拖延下去了，必須盡快進入驗證階段…實在不行，我就只能親自上陣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640202
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640202,
					"content": "「意外受傷，被迫中止研究。」靠這個藉口應該能多拖延一會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640203
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640203,
					"content": "反正只要不把命給搭上，就比回去接受審判要划算！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640204
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640204,
					"content": "#他在這裡自言自語什麼呢？打個招呼吧，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640205,
					"content": "你好，請問是派翠克先生嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640206
					]
				},
				{
					"id": 716640206,
					"content": "#嚇死我了！{F#妳}{M#你}們兩個是從哪冒出來的…怎麼還知道我的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640207
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640207,
					"content": "#等等，{F#妳}{M#你}們不會也是便衣的千岩軍吧？還要來驅趕我嗎？我已經出示過實地考察的許可了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640208
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640208,
					"content": "#我保證，絕對不會深入禁區的！不信{F#妳}{M#你}去問那位殺氣騰騰的、黑色短髮的小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640209
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640209,
					"content": "雖然不知道你說的人是誰，但別緊張啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640210,
					"content": "我們是友善、專業的冒險家。我們接到了協會的委託，來幫你解決麻煩啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640211,
					"content": "#原來是救兵？太好了！{F#妳}{M#你}們總算到了，我的研究專案終於有救了，要不然我早晚有一天要被它害死…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640212
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640212,
					"content": "看來你被你的研究專案給折磨得不輕啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640213,
					"content": "這是什麼話！研究這一行為本身是神聖而高潔的！折磨我的只是一些「附加因素」罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640214
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640214,
					"content": "「附加因素」？比如說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640215,
					"content": "科學研究失敗就會死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640216
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640216,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640217,
						716640218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640217,
					"content": "…像一句自暴自棄的話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640219
					]
				},
				{
					"id": 716640219,
					"content": "唉，我可沒在開玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640220
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640220,
					"content": "獨立的研究者進行科學研究需要申請資金，只要使用這筆資金，就等於承擔了楓丹的社會責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640221
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640221,
					"content": "花費了大筆資金還沒能取得成果，就無異於罪人，可是會被審判的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640222
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640222,
					"content": "要是我空手而歸，等待著我的大概不止「浪費公共財產」，還有「佔用學術資源」等好幾十項罪名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640223
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640223,
					"content": "這些罪名會給我帶來最嚴重的懲罰…財產虧空，身敗名裂還是小事，被審判的話，真的有可能會死掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640224
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640224,
					"content": "欸？這也太過分了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640225,
					"content": "所以你才那麼慌張，花一大筆錢聘請助手嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640226,
						716640228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640226,
					"content": "楓丹這個國家還真是可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640227
					]
				},
				{
					"id": 716640227,
					"content": "可怕的是「附加因素」！我美麗的故鄉是無罪的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640230
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640230,
					"content": "冷靜一點啦，我們明白情況有多嚴重了。這項科學研究關係到你的未來，你的性命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640231,
					"content": "都交給我們吧，我們會幫你搞定一切的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640232,
					"content": "#事到如今，我也只能依靠{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640233,
						716640234
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640233,
					"content": "你需要我們怎麼做呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640235
					]
				},
				{
					"id": 716640235,
					"content": "嗯，那就進入正題吧。我的研究專案名叫「振晶映射」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640236
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640236,
					"content": "簡單來說，就是激發礦藏寶石所含有的元素力，將這種元素力作為能源使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640237
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640237,
					"content": "聽起來好方便啊！也許能用來製作實用又好玩的機器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640238,
					"content": "不過，這些寶石和你說的什麼晶什麼映，又有什麼關係呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640239
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640239,
					"content": "「振晶」就屬於這種寶石吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640240
					]
				},
				{
					"id": 716640240,
					"content": "答對了！不久之前，有人在激發寶石時發現，有一類特殊寶石之間能產生奇妙的共鳴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640241
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640241,
					"content": "並將這樣的寶石統稱為「振晶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640242
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640242,
					"content": "「振晶」中的「響振晶」受到特定的刺激後，可以放出能量，激發「應振晶」的共鳴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640243
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640243,
					"content": "兩種「振晶」所放出的能量會相互疊加，成倍增幅，無比強大！我將這種共鳴命名為「映射」現象，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640244
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640244,
					"content": "目前專案已經進行到了關鍵階段——驗證我推導的「映射關係」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640245,
						716640246
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640245,
					"content": "我有一種預感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640247
					]
				},
				{
					"id": 716640247,
					"content": "我猜，你需要我們去檢驗你的理論，藉助那些「振晶」的力量打敗魔物，證明你所說的「映射關係」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640248,
					"content": "#完全正確！{F#妳}{M#你}們的悟性很高啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640249
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640249,
					"content": "我挑選了一片合適的區域，佈置了許多組「振晶」的方碑。做好了準備的話，就告訴我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640250
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640250,
					"content": "#我會向{F#妳}{M#你}們仔細說明需要驗證的內容，根據我的提示去戰鬥就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640251
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640251,
					"content": "這麼說來，還真是我們最熟悉的工作呢，甚至覺得有點無聊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640252,
						716640254
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640252,
					"content": "我倒有點興趣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640253
					]
				},
				{
					"id": 716640253,
					"content": "#{F#妳}{M#你}打敗過那麼多強大的敵人，手腳加在一起都數不過來了吧，搞定這種委託，當然是小菜一碟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640256,
					"content": "真有氣勢！璃月可真是個好地方啊，不止出產寶石的原礦，還有這麼可靠的冒險家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640257
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640257,
					"content": "不枉我跋山涉水，為了節省材料的費用趕到這裡來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640258
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640258,
					"content": "#本來我還在為預算超支苦惱，這下倒好，支付了{F#妳}{M#你}們的傭金後，資金餘下兩成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640259
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640259,
					"content": "事成之後，就用這筆錢聘僱一個報社寫手，在新聞頭版發表我的成果，好好宣傳一番吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640260
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640260,
					"content": "標題我已經想好了，就叫「震驚！派翠克對振晶的真經實論！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640261
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640261,
					"content": "正經一點啦！這個標題怎麼看都不像是學術文章吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640262
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640262,
					"content": "標題一定要奇怪，要引人矚目，這樣才能拉到投資！到時候，我們還可以商量分紅的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640263
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640263,
					"content": "分紅？不明白你在說什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640264
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640264,
					"content": "#如果「振晶映射」的理論被用來生產商品，我就能拿到不少利潤，到時可以按一定比例分給{F#妳}{M#你}們喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640265
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640265,
					"content": "當然，前提是研究的進展順利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640266
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640266,
					"content": "居然還有這種好事嗎？好呀好呀，我更有幹勁了！標題什麼的我不管了，隨你喜歡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640267,
						716640268
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640267,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640269
					]
				},
				{
					"id": 716640269,
					"content": "#總之，{NICKNAME}，我們就早早開工，快快收工吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640270
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640270,
					"content": "然後就能和派翠克先生商量分紅的事了，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640268,
					"content": "口水要流出來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640269
					]
				},
				{
					"id": 716640254,
					"content": "不如妳來試試？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640255
					]
				},
				{
					"id": 716640255,
					"content": "#我我我，我只是希望{F#妳}{M#你}能接到既有趣，又充滿挑戰的委託而已…可不是在抱怨喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716640246,
					"content": "我已經明白了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640247
					]
				},
				{
					"id": 716640234,
					"content": "請解釋一下你的科學研究專案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640235
					]
				},
				{
					"id": 716640228,
					"content": "這種「附加因素」還真是恐怖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640229
					]
				},
				{
					"id": 716640229,
					"content": "但它有利有弊，只要不淪為罪人，還是能享受到各種便利的。出身於楓丹的人都曾受益於它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716640230
					],
					"speakerTitle": "派翠克"
				},
				{
					"id": 716640218,
					"content": "喔，有點好笑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716640219
					]
				}
			]
		}
	]
}