			"dialogs": [
				{
					"id": 740850201,
					"content": "鑰匙，雕像，鑰匙，雕像，鑰匙，雕像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850202
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850202,
					"content": "嗯…妳是說把鑰匙放進雕像？這樣倒是剛剛好，三把鑰匙對三座雕像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850203,
					"content": "我們先試試吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850204,
					"content": "放好鑰匙後會發生什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850205
					]
				},
				{
					"id": 740850205,
					"content": "門開，開門…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850206
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850206,
					"content": "門？哪裡？門後面有什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850207,
					"content": "根，伊黎耶，十分很深…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850208
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850208,
					"content": "門通往伊黎耶島的根？！珀西芙，妳妳…妳知道的東西好多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850209,
					"content": "珀西芙，守護！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850210
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850210,
					"content": "還有什麼我們需要知道的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850211
					]
				},
				{
					"id": 740850211,
					"content": "…啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850212
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850212,
					"content": "就是情報啦，資訊啦，越多越好，知道得越多，我們就越有把握！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850213,
					"content": "資…訊？資…訊…珀西芙！資訊，十分很多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850214
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850214,
					"content": "太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850215,
					"content": "伊黎耶，資訊，十分很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850216
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850216,
					"content": "嗯…資訊很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850217,
					"content": "資訊，水脈，十分很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850218
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850218,
					"content": "嗯…水脈很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850219,
					"content": "水脈，那位來客，十分很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850220
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850220,
					"content": "嗯…嗯？！那位來客很多？！等等，我不懂…哪來的那麼多位來客啊？那位來客會分身魔法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850221,
					"content": "美露莘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850222
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850222,
					"content": "水脈，那位來客，品嚐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850223
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850223,
					"content": "邪惡，那位來客，感知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850224
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850224,
					"content": "品嚐水脈裡的邪惡？這是什麼奇怪的口味啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850225,
					"content": "那位來客能感知水脈裡的資訊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850226
					]
				},
				{
					"id": 740850226,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850227
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850227,
					"content": "垂柳，收集。霧道，處理。泉眼，發送。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850228
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850228,
					"content": "根，水脈，中心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850229
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 740850229,
					"content": "伊黎耶島是資訊中心？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740850230
					]
				},
				{
					"id": 740850230,
					"content": "妳是說整個伊黎耶島是那位來客的一個資訊系統？他可以透過這個感知一些不好的東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740850231,
					"content": "#聰明派蒙！聰明{NICKNAME}！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740850232
