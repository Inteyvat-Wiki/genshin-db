			},
			"dialogs": [
				{
					"id": 766840101,
					"content": "那…成交？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840102
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 766840102,
					"content": "成交。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840103
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840103,
					"content": "成交什麼？我是不是錯過了什麼重要的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766840104,
					"content": "正式的說法，應該是確定簽署一份備忘錄——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840105
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 766840105,
					"content": "《關於提升射手效能的聯合訓練備忘錄》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840106
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840106,
					"content": "想來，招募恰斯卡小姐至特巡隊，會對她的故鄉納塔造成不可估量的人才損失，不是明智之舉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840107
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840107,
					"content": "特巡隊那宛如鐘錶的穩定運轉，也離不開夏沃蕾隊長每天的指揮調度，少了夏沃蕾隊長，楓丹也會遇上不少麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840108
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 766840108,
					"content": "要想達成我們的目標…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840109
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840109,
					"content": "就需要前所未有的合作方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840110
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 766840110,
					"content": "這種驚人的默契是怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840111,
						766840112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766840111,
					"content": "兩位高手的思維對起來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766840113
					]
				},
				{
					"id": 766840113,
					"content": "總之，經過和夏沃蕾隊長的商討，我們決定在三個月內盡力開始「交換代表長期進修」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840114
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 766840114,
					"content": "這個方案能在最大程度減少負擔的前提下，加強特巡隊、「花羽會」與西風騎士團的合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840115
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 766840115,
					"content": "是我理解的…字面意思上那樣做嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766840116,
					"content": "你們兩邊互相派人，「花羽會」的勇士在楓丹住一段時間，特巡隊的戰士就去納塔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766840117,
					"content": "沒錯，只不過實踐起來，就不只是「讓兩邊的人各自去對方的國家旅居」那麼簡單了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840118
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840118,
					"content": "進修代表的人選、駐地、每天的課程、模擬訓練與實際演練的計畫、經費的安排…種種細節都需要系統性的規劃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840119
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 766840119,
					"content": "而且要盯住弱項，對症下藥，例如納塔勇士不太關心編制學、楓丹射手幾乎沒有動對動射擊的實戰經驗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840120
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840120,
					"content": "那就讓納塔勇士試著以班為單位，嚴格分工行動，讓絨翼龍抓著特巡隊射手的雙肩，低空飛行，截射標靶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840121
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840121,
					"content": "聽起來也太嚴格了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840122,
						766840123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766840122,
					"content": "真的做到的話，效果絕對拔群。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766840124
					]
				},
				{
					"id": 766840124,
					"content": "許多計劃中的課程還要用到蒙德友軍的卓越裝備，西風騎士團的代表也不可或缺，所有進修所得的結果都應與他們分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840125
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840125,
					"content": "呃咳！夏沃蕾隊長有心了，再次感謝貴方慷慨的報價！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840126
					],
					"speakerTitle": "赫得蔚格"
				},
				{
					"id": 766840126,
					"content": "這次演練中，「觀測榴彈」和一系列裝備發揮正常，我們會按照之前的採購合約定期交付貨品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840127
					],
					"speakerTitle": "赫得蔚格"
				},
				{
					"id": 766840127,
					"content": "派出代表進修一事，也請容我將消息傳回騎士團，由長官們給出正式答覆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840128
					],
					"speakerTitle": "赫得蔚格"
				},
				{
					"id": 766840128,
					"content": "我會向妳提供正式的書面文件，等著妳的好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840129
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840129,
					"content": "最後，話題該回到我們的「射擊推理」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840130
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 766840130,
					"content": "夏沃蕾隊長可是對這次的結果異常滿意啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840131
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 766840131,
					"content": "#嗯，得到了{NICKNAME}令人驚嘆的對照組後，我們最後的拼圖也補全了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840132
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840132,
					"content": "這次演練帶來了大量彈道規劃的思維樣本，涵蓋各種等級的射手——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840133
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840133,
					"content": "足以讓原本的銃槍射擊教材——甚至訓練射手的教官手冊——都進一步改良，效率成倍提升。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840134,
						766840135
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840134,
					"content": "下次推演還可以叫我哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766840136
					]
				},
				{
					"id": 766840136,
					"content": "#就等{F#妳}{M#你}這句話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840137
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 766840137,
					"content": "#到時候，一定第一時間寄信給{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840138
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 766840138,
					"content": "#以{F#妳}{M#你}目前的射擊才能，下次坐到出題者的位置上來才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840139
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 766840139,
					"content": "哈哈！能幫蒙德、楓丹和納塔的朋友們變強，真是再好不過了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766840140,
					"content": "如果哪天聽說我們幫忙編好的書教出了厲害的戰士，砰砰幾槍就擊退了魔物，保護了大家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766840141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766840141,
					"content": "那種感覺，應該會和我們親自打跑壞傢伙一樣，自豪又踏實！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766840135,
					"content": "我樂於參加這樣的演習。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766840136
					]
				},
				{
					"id": 766840123,
					"content": "專練弱項的確是最有效的方法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766840124
					]
				},
				{
					"id": 766840112,
					"content": "她們找出了彼此滿意的方案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766840113
					]
				}
			]
		}
	]
}