			"dialogs": [
				{
					"id": 716664101,
					"content": "煙緋的鬼兜蟲好強！該說不愧是萍姥姥照料過的特別鬼兜蟲嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716664102,
					"content": "#{F#妳}{M#你}看，恩人姐姐的鬼兜蟲不好惹吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664103
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 716664103,
					"content": "#就像之前，我的一些部將也對{F#妳}{M#你}造成了不少困擾，有時「裝備」和「夥伴」的性能差距，很難用指揮彌補。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664104
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 716664104,
					"content": "確確確確…確實…嗯呃咳…還好我的摯友頂住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664105
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716664105,
					"content": "原來如此…原來如此！我好像找到鬥蟲的樂趣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716664106
					],
					"speakerTitle": "「裝備碾壓型選手」"
				},
				{
					"id": 716664106,
					"content": "#我很開心！{NICKNAME}，一斗先生，還有「花角玉將」！接下來，我還想在這裡繼續玩玩這個遊戲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「裝備碾壓型選手」"
				}
			]
