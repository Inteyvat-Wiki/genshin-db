			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"蘭穆護昆達",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730480101,
					"content": "#真懷念吶。上次見到這樣的景象，距今已經有數百年了吧…能以這雙眼睛，再度看見桓那蘭那的夢鄉，也是託{F#妳}{M#你}們的福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480102
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480102,
					"content": "哇！原來你的年紀這麼大了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480103,
						730480104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730480103,
					"content": "第一次聽到蘭那羅說「年」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480105
					]
				},
				{
					"id": 730480105,
					"content": "這樣嗎？或許是因為我吸收了更多記憶與知識吧。在夢鄉中的桓那蘭那，是沒有白晝與黑夜的，一切都平穩安詳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480106
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480106,
					"content": "加上我們的壽命很長。所以，我們對「時間」的概念很淡薄。我們會以樹木的成長、花朵盛開、月亮升起、來衡量時間的流逝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480107
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480107,
					"content": "既然要過無憂節，那就應該要結出惟耶之實了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480108
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480108,
					"content": "嗯…這麼說來，惟耶之實到底是什麼東西呢？之前，蘭拉迦和蘭羅摩也沒有怎麼說過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730480109,
					"content": "#{F#妳}{M#你}們已經成為了蘭那羅的朋友，那應當也聽說過蘭迦拉梨的原理了吧。那菈{NICKNAME}、派蒙，{F#妳}{M#你}們知道嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480110
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480110,
					"content": "蘭拉娜提到過記憶的力量…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480111
					]
				},
				{
					"id": 730480111,
					"content": "#蘭拉娜嗎？真是懷念，希望一切都好。雖然那傢伙有點冒失，但想必是將{F#妳}{M#你}視為朋友，才會告訴{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480112
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480112,
					"content": "惟耶之實是將記憶與夢想抽取後，結成的果實，也就是我等蘭那羅最寶貴的事物的結晶。雖說是果實，但也是希望之種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480113
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480113,
					"content": "#只要是幫助他人的願望，惟耶之實都能實現。{F#妳}{M#你}們和這次要準備惟耶之實的蘭那羅，也有幫助他人的願望吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480114,
						730480115
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480114,
					"content": "要拯救拉娜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480116
					]
				},
				{
					"id": 730480116,
					"content": "#嗯，那就沒問題了。既然那菈{NICKNAME}是蘭那羅的朋友，收下這個吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480117,
						730480118
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480117,
					"content": "這是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480119
					]
				},
				{
					"id": 730480119,
					"content": "一朵小花…之前，蘭拉娜、蘭納真他們，也送過我們花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730480120,
					"content": "這樣啊。那看來儘管過去了許多年，這個習俗還是沒有改變。真是太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480121
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480121,
					"content": "#以前，我和蘭拉迦、蘭拉吉…還有蘭帕卡提他們一起，也為那菈法留納送過花。{M#她}{F#他}是我們無比珍視的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480122
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480122,
					"content": "這種花即是蘭那羅友情的象徵，而願意收下這朵花的人，就是許可了蘭那羅的這份友情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480123
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480123,
					"content": "我們蘭那羅不善言辭。是故，之於他們而言，人類朋友願意收下他們的花，是十分值得驕傲的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480124
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480124,
					"content": "#而聽說了許多那菈{NICKNAME}的故事，對我而言，{F#妳}{M#你}也是我所珍視的朋友。而{F#妳}{M#你}願意收下我的花，於我乃是殊榮。謝謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480125,
						730480126
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480125,
					"content": "不用客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480127
					]
				},
				{
					"id": 730480127,
					"content": "#我們一定會再見的。到時候，那菈{NICKNAME}、派蒙，希望{F#妳}{M#你}們能到我家做客。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480128
					],
					"speakerTitle": "蘭穆護昆達"
				},
				{
					"id": 730480128,
					"content": "啊，消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730480129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730480129,
					"content": "真是個奇怪的蘭那羅呢！不管了，我們去看看別的蘭那羅吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730480126,
					"content": "謝謝你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480127
					]
				},
				{
					"id": 730480118,
					"content": "我收下了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480119
					]
				},
				{
					"id": 730480115,
					"content": "蘭拉娜希望幫助朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480116
					]
				},
				{
					"id": 730480104,
					"content": "你的時間概念和別的蘭那羅不同…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730480105
					]
				}
			]
		}
	]
}