				]
			},
			"dialogs": [
				{
					"id": 745130101,
					"content": "路過的客人，生論派學者兼大巴扎與海露港的新星商人拜希麥五世懇求您，別急著離開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130102
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 745130102,
					"content": "請放鬆身體，放空思緒，聽我說一件重要的事——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130103
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 745130103,
					"content": "團雀最可愛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130104
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 745130104,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130105,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130106
					]
				},
				{
					"id": 745130106,
					"content": "團雀的確很可愛，但拜希麥小姐說自己是…學者兼商人？一句話沒有限制範圍，不是會引起很激烈的爭論嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130107,
					"content": "我的印象裡學者的發言都很謹慎，商人也不敢隨便說出很誇張的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130108,
					"content": "如果妳和別人說：「我的理論最正確」或是「我的商品最厲害」，那不是會被很多不服氣的人盯上，用力找碴嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130109,
					"content": "奇怪，怎麼感覺這段對話好像發生過，有種熟悉感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130110,
						745130111,
						745130112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130110,
					"content": "那我繼續說！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130113
					]
				},
				{
					"id": 745130113,
					"content": "#噫！{NICKNAME}，為什麼這麼突然啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130114,
					"content": "就算不是開玩笑，也不要那麼大聲嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130115,
					"content": "哈哈哈！就是這種氣勢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130116
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 745130116,
					"content": "我當然知道，世上任何東西都沒有絕對的第一。任何學術理論都有被推翻的可能，任何商品都會被新品超越。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130117
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 745130117,
					"content": "但不管客觀的世界怎麼變，每個人心裡都存在一些…自己最認可的人事物。不管別人怎麼說，這些人事物的價值都是最高的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130118
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 745130118,
					"content": "要是害怕不被認同而對自己失去信心，那就永遠不可能成為自己心裡最棒的模樣，更沒辦法找到認可自己的知音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130119
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 745130119,
					"content": "#如果{F#妳}{M#你}們有來玩過我這款桌遊「哐哐噹噹雀雀球」，也會像我這樣大聲告訴別人：「團雀最可愛！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130120
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 745130120,
					"content": "哐哐…噹噹…雀雀球？就是妳旁邊這張桌子上的東西嗎？也有點眼熟耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130121,
					"content": "#沒錯哦！玩過這個遊戲以後，{F#妳}{M#你}們就可以深刻領悟到團雀的可愛之處囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130122
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 745130122,
					"content": "我正在推廣這種桌遊，如果在遊戲裡得到高分，還可以獲得一些獎品哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130123
					],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 745130123,
					"content": "我是覺得團雀很可愛沒錯，就算獎品不多也沒關係，只要可以玩得開心就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130124,
					"content": "#{F#妳}{M#你}覺得呢，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745130125,
						745130126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745130125,
					"content": "我也想來試試看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130127
					]
				},
				{
					"id": 745130127,
					"content": "#嘿嘿嘿，看來我們的意見就快一致了！那就請{F#妳}{M#你}們盡情體驗吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拜希麥·五世"
				},
				{
					"id": 745130126,
					"content": "團雀究竟多可愛！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130127
					]
				},
				{
					"id": 745130111,
					"content": "派蒙最可愛！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130113
					]
				},
				{
					"id": 745130112,
					"content": "什麼都不管！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745130113
					]
				}
			]
		}
	]
}