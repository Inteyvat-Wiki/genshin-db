			"dialogs": [
				{
					"id": 761490101,
					"content": "是誰？是誰！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490102
					],
					"speakerTitle": "阿羅邏"
				},
				{
					"id": 761490102,
					"content": "#{NICKNAME}。如今這個時代的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490103
					]
				},
				{
					"id": 761490103,
					"content": "雖然我不知道你們的時代，但是我叫阿羅邏，本是寂靜期行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490104
					],
					"speakerTitle": "阿羅邏"
				},
				{
					"id": 761490104,
					"content": "來到這裡已經記不得時間了，甚至這裡把我的寂靜之修行破掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490105
					],
					"speakerTitle": "阿羅邏"
				},
				{
					"id": 761490105,
					"content": "果然，無念無想的修行會讓人投生無想惡天啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490106
					],
					"speakerTitle": "阿羅邏"
				},
				{
					"id": 761490106,
					"content": "舉手之勞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490107
					]
				},
				{
					"id": 761490107,
					"content": "千萬別謝謝我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761490108
					]
				},
				{
					"id": 761490108,
					"content": "謝謝啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490109
					],
					"speakerTitle": "阿羅邏"
				},
				{
					"id": 761490109,
					"content": "雖然救你是順手而為，不過我們準備找找冥想之外的辦法離開這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490110
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761490110,
					"content": "你們不擅長冥想嗎？或者你們的時代不教授這種技術？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490111
					],
					"speakerTitle": "阿羅邏"
				},
				{
					"id": 761490111,
					"content": "我第一次離開這裡花了數百年的歲月。我捨棄了我對真理的追求，捨棄了見到親朋的渴愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490112
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761490112,
					"content": "這一次我不願意再放棄這些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490113
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761490113,
					"content": "算我一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490114
					],
					"speakerTitle": "阿羅邏"
				},
				{
					"id": 761490114,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490115
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761490115,
					"content": "小右又撿到一個「念亡碎片」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490116
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761490116,
					"content": "念亡？哦，死隨念這種冥想技術我也知道。它能讓人鍛煉面對死亡之時的心境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490117
					],
					"speakerTitle": "阿羅邏"
				},
				{
					"id": 761490117,
					"content": "既然找到琳德了，我們就去找找出去的辦法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490118
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761490118,
					"content": "這裡真的可以靠實力出去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490119
					],
					"speakerTitle": "阿羅邏"
				},
				{
					"id": 761490119,
					"content": "既然梅蘭塔和尼西里塔可以自由往來，通常都還會帶人出入，那小右應該也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490120
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761490120,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490121
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761490121,
					"content": "現在收集到了三枚「念亡碎片」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490122
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761490122,
					"content": "哦，這個是暫定的名稱。因為我也不知道小右收集這個要做什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490123
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761490123,
					"content": "小右，接下來怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490124
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 761490124,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761490125
					],
					"speakerTitle": "小右"
				},
				{
					"id": 761490125,
					"content": "跟著它指示的方向走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊斯托利亞"
				}
			]
		},
