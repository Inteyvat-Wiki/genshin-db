			"dialogs": [
				{
					"id": 790550101,
					"content": "此處為短劇《斷船遺夢》片場的棄用場景",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550102
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790550102,
					"content": "原本構想的，是在一艘漂浮的斷船上，兩隻水形幻靈墜入愛河的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550103
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790550103,
					"content": "在它們互相表明心跡之後，在夕陽餘暉之中，立於船頭的場景想必相當浪漫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550104
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790550104,
					"content": "然而，之所以該片場被棄用，是因為…作為演員的兩隻水形幻靈性格過於活潑，根本無法停止行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550105
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790550105,
					"content": "唔，如果能夠捕捉到<color=#00E1FFFF>兩隻同時出現在船頭</color>的場景就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790550106
					],
					"speakerTitle": "片場備註"
				},
				{
					"id": 790550106,
					"content": "——「導演」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "片場備註"
				}
			]
		},
