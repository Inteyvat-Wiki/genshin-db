					"吉麗安娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600801,
					"content": "藥已經配好了，但是這種藥治標不治本，想要徹底根除的話，要一直服藥靜養才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600802
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200600802,
					"content": "我和他說過很多次，他似乎都沒聽進去，一直說這樣就可以了，無論是誰都勸不動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600803
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200600803,
					"content": "好了，請你們快點把藥帶給特納先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600804,
						200600806
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200600804,
					"content": "謝謝妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600805
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200600805,
					"content": "不客氣，我只是做了份內的事而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200600806,
					"content": "麻煩妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600807
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200600807,
					"content": "沒事。唉…如果有一個人能照顧特納先生的話，他也不用一直服藥了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉麗安娜"
				}
			]
		},
