			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蓋伊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600501,
					"content": "#呃，{F#妳}{M#你}好！{F#妳}{M#你}手上拿的是甜甜花吧。雖然很唐突，{F#妳}{M#你}能不能賣給我一份？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600502
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 200600502,
					"content": "我老爹一直在咳嗽，我向吉麗安娜小姐要了份止咳的藥方，但是她那邊材料已經用光了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600503,
						200600506
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 200600503,
					"content": "我也是去配藥的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600504
					]
				},
				{
					"id": 200600504,
					"content": "是，是這樣嗎？那還是算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600505
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 200600505,
					"content": "#抱歉，耽誤了{F#妳}{M#你}的時間，趕緊去教堂吧，吉麗安娜小姐還在呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 200600506,
					"content": "甜甜花應該很好找。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600507
					]
				},
				{
					"id": 200600507,
					"content": "啊？哦…我知道，但是我還要守門呢，實在是抽不開身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600508
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 200600508,
					"content": "就是去問吉麗安娜小姐，我也只能趁著午休的時候趕緊問了問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600509
					],
					"speakerTitle": "蓋伊"
				},
				{
					"id": 200600509,
					"content": "#算了，看{F#妳}{M#你}的樣子，應該也是去配藥的吧…不耽誤{F#妳}{M#你}了，快點去教堂吧，吉麗安娜小姐應該還在呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蓋伊"
				}
			]
		},
