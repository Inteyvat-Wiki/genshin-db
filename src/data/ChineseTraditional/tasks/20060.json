			},
			"dialogs": [
				{
					"id": 200600701,
					"content": "特納先生可真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600702
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200600702,
					"content": "我是來配藥的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600703
					]
				},
				{
					"id": 200600703,
					"content": "#咦？不是摩可和海莉來嗎，怎麼今天是{F#妳}{M#你}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600704
					],
					"speakerTitle": "吉麗安娜"
				},
				{
					"id": 200600704,
					"content": "材料已經搜集到了吧，我來看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉麗安娜"
				}
			]
		},
		{
			"id": 2006008,
			"completionStepIds": [
				2006009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
