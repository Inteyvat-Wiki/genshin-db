					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600301,
					"content": "這些就應該足夠了，我們去找<color=#00E1FFFF>吉麗安娜修女</color>吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 2006004,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600401,
					"content": "等等…我看看，我們帶著的甜甜花好像已經夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200600402,
					"content": "要直接拿去給<color=#00E1FFFF>吉麗安娜修女</color>嗎？還是去再找一些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
