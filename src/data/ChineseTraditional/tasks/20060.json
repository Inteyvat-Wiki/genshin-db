			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"特納"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200600101,
					"content": "#{F#妳}{M#你}好，客人，{F#妳}{M#你}知道我兒子蓋伊嗎？咳…咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600102
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200600102,
					"content": "你怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200600103
					]
				},
				{
					"id": 200600103,
					"content": "沒事沒事，老毛病了，沒什麼大問題，但就是一直好不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600104
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200600104,
					"content": "之前去<color=#00E1FFFF>教會</color>裡也看過了，修女們也不能一口氣治好，只能開藥緩解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600105
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200600105,
					"content": "唉，我年紀大了，也走不了太長的路，之前都是請摩可和海莉幫我去配藥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600106
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200600106,
					"content": "她們今天剛好有事…咳咳…我已經和<color=#00E1FFFF>吉麗安娜小姐</color>說好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600107
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200600107,
					"content": "只要帶著材料過去，她就會把藥配好。只要<color=#00E1FFFF>三份甜甜花</color>就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600108,
						200600110
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200600108,
					"content": "好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600109
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200600109,
					"content": "#咳咳，咳…那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200600112,
					"content": "就三份甜甜花，然後去教會找吉麗安娜修女配藥，<color=#00E1FFFF>千萬別讓蓋伊知道。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600113
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200600113,
					"content": "我聽說，教會和西風騎士團也有關係吧，那小子是西風騎士，可要時刻注意自己的言行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600114
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200600114,
					"content": "要是為了我這個老頭子犯了什麼錯，那就糟糕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600115
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200600115,
					"content": "#抱歉，讓{F#妳}{M#你}聽我嘮叨了半天，快點去吧，路上小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特納"
				},
				{
					"id": 200600110,
					"content": "可以讓你兒子蓋伊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600111
					],
					"speakerTitle": "特納"
				},
				{
					"id": 200600111,
					"content": "哎呀，孩子在外面奮鬥，我們老傢伙怎麼能拖後腿呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200600112
					],
					"speakerTitle": "特納"
				}
			]
		},
