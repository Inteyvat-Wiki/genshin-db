						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莉莉希"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 766690101,
					"content": "（或許<color=#FFCC33FF>菈烏瑪</color>會關心「饗月餐」…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766690102
					]
				},
				{
					"id": 766690102,
					"content": "您好，是要…嗚哇！菈烏瑪大人，您怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690103
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690103,
					"content": "辛苦了，莉莉希。今天發放「饗月餐」時，還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690104
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766690104,
					"content": "嗯！很順利哦！無論是做「饗月餐」還是發「饗月餐」，都超級超級順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690105
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690105,
					"content": "自從雅珂達小姐來陪我發了幾天餐之後，就再也沒有人來搗亂，也沒有人插隊了，大家都很聽話地排隊拿餐哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690106
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690106,
					"content": "之前一直有一個大塊頭來搗亂，不僅亂插隊，還一個人拿好幾份餐…坎托爾先生上前阻止，還被揍了好幾拳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690107
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690107,
					"content": "那一天，正好雅珂達小姐也來拿餐，看見那個大塊頭搗亂之後，她一下子跳起來，狠狠地把那傢伙踹翻了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690108
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690108,
					"content": "雅珂達小姐踹翻那傢伙之後，還穩穩地接住了那一份沒打開的「饗月餐」，然後，她就指著趴在地上的人說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690109
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690109,
					"content": "「既然對恩人和食物都沒有敬畏之心，那你今天就餓著吧。滾一邊去，別擋路，小心我再給你一腳！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690110
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690110,
					"content": "之後，雅珂達小姐就陪我一起發了好幾天餐…為了感謝她，我也做了很多好吃的送給她啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690111
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690111,
					"content": "如此說來，的確應當感謝她。或許…我也應當為妳再僱一個護衛，就和我上次說的一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690112
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766690112,
					"content": "欸？不用的不用的，本來人手就不夠，與其多僱一個護衛，不如再多開一個發放餐點的地點呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690113
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690113,
					"content": "而且，現在秩序真的已經很好了。雅珂達小姐偶爾也會過來看一眼，有她和坎托爾先生在，絕對不會再有人來搗亂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690114
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690114,
					"content": "希望如此。這樣好了，莉莉希，我會請我的幾位朋友輪流過來，如果妳需要幫助，就告訴牠們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690115
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766690115,
					"content": "朋友…？應該也是住在島上吧？我認識嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690116
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 766690116,
					"content": "呵呵，妳對牠們一定不陌生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690117
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766690117,
					"content": "那我就不打擾妳了。再見，莉莉希。願月神護佑妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766690118
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 766690118,
					"content": "再見！菈烏瑪大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉莉希"
				}
			]
		},
