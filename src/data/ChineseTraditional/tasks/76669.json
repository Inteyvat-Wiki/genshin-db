					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"600201",
							"0"
						]
					},
					{
						"type": "QUEST_COND_PLAYER_TEAM_CONTAINS_AVATAR",
						"rawParams": [
							"10000119",
							"0",
