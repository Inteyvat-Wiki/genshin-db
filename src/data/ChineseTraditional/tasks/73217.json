			},
			"dialogs": [
				{
					"id": 732170801,
					"content": "奧摩斯港最大的旅舍，為往來商旅提供最貼心的服務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170802
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170802,
					"content": "入住旅客如有教令院學籍，還有特殊折扣哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170803
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170803,
					"content": "若有商品貨物需要倉儲，請聯繫維卡拉商棧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
