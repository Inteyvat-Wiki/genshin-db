			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170401,
					"content": "特別提醒，整個須彌的傭兵行業都由「鍍金旅團」承接，絕無別家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170402
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170402,
					"content": "請勿輕信他人，以防被來頭不明的人騙取傭金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170403
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170403,
					"content": "如需僱傭保鏢、守衛，抑或其他委託，請聯繫「三十人團」駐奧摩斯港隊長費羅茲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321705,
			"completionStepIds": [
				7321705
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
