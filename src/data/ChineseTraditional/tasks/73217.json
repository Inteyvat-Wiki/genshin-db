			"dialogs": [
				{
					"id": 732170701,
					"content": "海獸出沒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170702
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170702,
					"content": "近期海獸活動頻繁，出港船隻請注意法邏斯塔發佈的預警資訊，或透過虛空提前取得海域資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170703
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170703,
					"content": "如有疑問，請諮詢守塔人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
