					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171401,
					"content": "「賢者的說教何其枯燥，不如斟滿花釀的美酒，踏上征服七海的航程。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321715,
			"completionStepIds": [
				7321715
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321715",
							"2"
						],
						"stepId": 7321715,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171501,
					"content": "水手船客、往來商旅、內外市民，本港規章均已於此公告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171502
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171502,
					"content": "如遇糾紛，可聯繫治安官夏姆尋求幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321716,
			"completionStepIds": [
				7321716
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321716",
							"2"
						],
						"stepId": 7321716,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171601,
					"content": "「與其去須彌城裡遊覽什麼大巴扎，還不如看看我們奧摩斯港的舊市街。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171602
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171602,
					"content": "「比起被教令官指手畫腳搞得面目全非的大巴扎，我們這裡保留的須彌特色可要多得多了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171603
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171603,
					"content": "「當然，要是想欣賞舞蹈的話，還是得去祖拜爾劇場的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171604
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171604,
					"content": "「鄉下人就是鄉下人，須彌城的規劃是由學者們精心設計的，分區無不遵循科學道理。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171605
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171605,
					"content": "「倒是有的人什麼也不懂就在這裡大放厥詞，拿奧摩斯港這亂七八糟的街道當寶貝了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171606
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171606,
					"content": "「不聽不聽，樹洞人念經！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321717,
			"completionStepIds": [
				7321717
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321717",
							"2"
						],
						"stepId": 7321717,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171701,
					"content": "「說起來實在難為情。我們原本是常年負責維護商船的工人，一直靠祖上傳下來的手藝吃飯。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171702
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171702,
					"content": "「但是從前段時間開始，虛空錄入了新的技術，以前的經驗完全派不上用場了。年輕人還能透過虛空申請學習，我們這些年紀大了的，就只能改行了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171703
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171703,
					"content": "「雖然書記官大人說我們可以出海碰碰運氣，不過因為實在沒錢還得再準備一段時間。大家有什麼工作的話，也請來找我們吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171704
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171704,
					"content": "「別聽那個書記官的，正巧我知道有位大主顧需要工匠，我這就把你們推薦給她。這些錢你們也先拿去吧，別考慮什麼出海了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171705
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171705,
					"content": "「真希望你少做點無謂之事。有人成功，有人落魄，本身就是世間運行的定則，何必為了自己充好人而干涉世界的運行起落？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171706
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171706,
					"content": "「我們的書記官大人又開始講他的神秘主義課程了。為什麼？我開心！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171707
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171707,
					"content": "「你可不要忽視了，追求互助與公平的本性與義怒也是人驅動世界運轉的道理，而不是什麼『優勝劣汰』的謬論！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171708
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171708,
					"content": "「你也不要搞錯了，我同樣從來沒有否認過你所說的這些，但你完全不懂我在和你說什麼，我也不想再和你解釋了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171709
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171709,
					"content": "「和血氣上腦的人辯論真是頭痛…話說回來，你自己的預算哪去了？別告訴我你把教令院的補貼都花在這種無聊的事情上了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171710
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171710,
					"content": "「『窮人窮苦於富人的富裕，所以富人應廣散善財。』佐爾菲卡爾賢者說的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171711
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171711,
					"content": "「他沒說過。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171712
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171712,
					"content": "「他說過。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171713
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171713,
					"content": "「他沒說過，這個月酒錢你自己負責。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171714
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171714,
					"content": "「我不跟你爭論這個了，但給我一個月時間，他一定說過。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
