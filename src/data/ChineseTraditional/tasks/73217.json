			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170601,
					"content": "本港現嚴查走私活動，凡經本港出入的貨物皆需登記並接受檢查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170602
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170602,
					"content": "如發現未經登記的貨品或明令禁止進出口的違禁物品，將全部沒收。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170603
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170603,
					"content": "由此造成的一切後果皆由所有人自行承擔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
