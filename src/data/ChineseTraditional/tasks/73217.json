						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321709",
							"2"
						],
						"stepId": 7321709,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732170901,
					"content": "「沙普爾旅舍的服務雖然不錯，但是房間隔音實在太差了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170902
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170902,
					"content": "「當初看奧摩斯港物價便宜才決定留在這裡備考，看來我還是得搬去須彌城裡才行。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732170903
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732170903,
					"content": "「今年要是再考不上，就只能回老家種田了。不知道到時候能不能帶點『豐沃之惠』走…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321710,
			"completionStepIds": [
				7321710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321710",
							"2"
						],
						"stepId": 7321710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171001,
					"content": "「最近派下來的教令官真是愈來愈沒用了，什麼事情都是一問三不知。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171002
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171002,
					"content": "「況且現在開放了虛空許可權，這些外行的教令官水準還不如我呢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171003
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171003,
					"content": "「也就只有那位不是經常能看見的書記官大人，上次還幫我們理清了船隻調度的時間表。看來教令院還不至於全是傻蘑菇。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321711,
			"completionStepIds": [
				7321711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321711",
							"2"
						],
						"stepId": 7321711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171101,
					"content": "「自從賽諾前輩當上大風紀官後，雖然要做的事變多了，但因為不用再牽扯進那些無聊的學派鬥爭，感覺反而輕鬆了不少。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171102
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171102,
					"content": "「不然我也不能趁著出差調查的功夫來這裡偷懶。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171103
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171103,
					"content": "「最近賽諾前輩也不知道去了哪裡，寫在這裡的話，應該不會被他看到吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171104
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171104,
					"content": "「我已經看到了。請限於明日中午之前自動報到，領受處分。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171105
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171105,
					"content": "「不要浪費我的時間。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321712,
			"completionStepIds": [
				7321712
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321712",
							"2"
						],
						"stepId": 7321712,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171201,
					"content": "本會經營璃月生產的寶石製品和名貴礦石，與多家船隊皆有長期合作，貨源充足，管道穩定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171202
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171202,
					"content": "另有少量時新絲綢及時裝出售，欲購從速。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171203
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171203,
					"content": "須彌本地毛毯、草藥、寶石首飾、織錦製品等優質商品如有好管道，亦請友商儘管前來洽談，以交良緣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321713,
			"completionStepIds": [
				7321713
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321713",
							"2"
						],
						"stepId": 7321713,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 732171301,
					"content": "「有人相信嗎？我上個月出海到了一個國家，他們的國王連馬都沒見過。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171302
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171302,
					"content": "「所以我決定販一批馱獸去，然後告訴他們這就是馬，哈哈。要是這筆做成了，我說不定也能混成個國王什麼的當當呢！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171303
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171303,
					"content": "「國王是什麼？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171304
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171304,
					"content": "「就是一種和港務官或者維齊爾差不多，但是比他們官威更大的大官，就像傳說中的二十九代伊那樣…哎呀太難跟你形容了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732171305
					],
					"speakerTitle": "公告板"
				},
				{
					"id": 732171305,
					"content": "「一看就是你編的吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "公告板"
				}
			]
		},
		{
			"id": 7321714,
			"completionStepIds": [
				7321714
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7321714",
							"2"
						],
						"stepId": 7321714,
