				"points": []
			},
			"dialogs": [
				{
					"id": 230050601,
					"content": "這就是那位富翁的蘋果釀嗎？嗯，裡面有一股不凡的香氣，令人頭腦清醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050602
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050602,
					"content": "好啊！這一定是能為市場帶來轉變的好東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050603
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050603,
					"content": "#我不會忘記{F#妳}{M#你}們的幫助的！兩位，我們回頭見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				}
			]
		},
		{
