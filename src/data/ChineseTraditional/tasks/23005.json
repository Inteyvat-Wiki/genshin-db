			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050201,
					"content": "唔…還算不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050202
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050202,
					"content": "看來你賺了不少啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050203
					]
				},
				{
					"id": 230050203,
					"content": "#哎喲，旅行者！托{F#妳}{M#你}的福，我這次小賺了幾筆，看來「吞金料理」果然有點效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050204
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050204,
					"content": "只不過，比起平常正常交易賺來的也沒差多少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050205
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050205,
					"content": "這不應該是「吞金料理」該有的表現，難道是我吃的菜不對嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050206
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050206,
					"content": "#旅行者，那我們就再來一次，請{F#妳}{M#你}再幫我挑選一次「吞金料理」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050207
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050207,
					"content": "還是老規矩，就在<color=#00E1FFFF>摩拉肉</color>、<color=#00E1FFFF>奶油雞</color>和<color=#00E1FFFF>「堆高高」</color>中選一樣就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				}
			]
		},
		{
			"id": 2300503,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300503",
							"2"
						],
						"stepId": 2300503,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"2300503"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050301,
					"content": "上次小賺，這次一定能大賺，<color=#00E1FFFF>摩拉肉</color>、<color=#00E1FFFF>奶油雞</color>和<color=#00E1FFFF>「堆高高」</color>，怎麼樣？選好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				}
			]
		},
		{
			"id": 2300504,
			"completionStepIds": [
				2300504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2300504",
							"2"
						],
						"stepId": 2300504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈特姆"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230050401,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050402
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050402,
					"content": "嗨！哈特姆，最近怎麼樣呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230050403,
					"content": "#嗯…是{F#妳}{M#你}們啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050404
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050404,
					"content": "#唉，看見我這副愁眉苦臉的樣子，{F#妳}{M#你}們應該多少也猜到些了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050405
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050405,
					"content": "我坦白了，到現在為止，我的荷包已經扁了一半了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050406
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050406,
					"content": "真奇怪…不應該這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050407
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050407,
					"content": "不過話說回來…我有一個猜想，也許這正是市場要騰飛的徵兆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050408
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050408,
					"content": "就像人們必須要先彎曲腿部，然後才能高高躍起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050409
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050409,
					"content": "換作期貨交易市場也是一樣，現在整個市場都來到了底部。接下來一定就是觸底反彈的時刻了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050410
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050410,
					"content": "也就是說，現在就是抄底的最好時機！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050411,
						230050412
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050411,
					"content": "也許只是在山腰上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				},
				{
					"id": 230050413,
					"content": "不，我很確定，這是一個難得的機會，我絕不會錯過任何獲得財富的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050414
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050414,
					"content": "這樣才能對得起我卡里米的不凡富翁哈特姆這個稱號！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050415
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050415,
					"content": "再幫我一次吧？朋友，再幫我挑選一份「吞金料理」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050416
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050416,
					"content": "那還是在原來的三樣裡選嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230050417,
					"content": "唔…不！既然是要抄底，我需要一份更加特別的料理，它能為市場帶來好的轉變！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050418
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050418,
					"content": "我聽說蒙德也有一位富翁，他的酒業生意興隆無比…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050419
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050419,
					"content": "你是說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050420
					]
				},
				{
					"id": 230050420,
					"content": "迪盧克老爺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230050421,
					"content": "但你怎麼知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230050422,
					"content": "哈哈哈，我連「堆高高」都知道，又怎麼可能不知道他呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050423
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050423,
					"content": "他的名下有一家酒館，出售一種名叫「蘋果釀」的好東西，如果能喝下它，也許我就能借來一絲那位富翁的好財運！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230050424
					],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050424,
					"content": "拜託了，請為我準備一份蘋果釀吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈特姆"
				},
				{
					"id": 230050412,
					"content": "彎曲腿部也有可能是腿痛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230050413
					]
				}
			]
		},
