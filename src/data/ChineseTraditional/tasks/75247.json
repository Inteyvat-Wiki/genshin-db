			"dialogs": [
				{
					"id": 752475001,
					"content": "怎麼樣，玩得開心嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475002
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752475002,
					"content": "噢天哪，哥們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475003
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752475003,
					"content": "看來是開心的。生日快樂，哥們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475004
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752475004,
					"content": "說到這個，你為什麼不提前告訴我這個計畫呢？不拿我當哥們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475005
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752475005,
					"content": "呵呵…實不相瞞，是想看看你是否還記得這個日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475006
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752475006,
					"content": "…伊法，你變了，變得很陰險，我以後需要提防你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475007
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752475007,
					"content": "還好我記得幫咔庫庫留了新鮮的蜜，不然接下來要被牠啄一整年的頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475008
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752475008,
					"content": "不會的哥們，還是你最好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "咔庫庫"
				}
			]
		},
		{
			"id": 7524751,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
