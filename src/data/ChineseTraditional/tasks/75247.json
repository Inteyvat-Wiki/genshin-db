			},
			"dialogs": [
				{
					"id": 752475101,
					"content": "又見面了，哥們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475102
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752475102,
					"content": "其實我剛剛是想說，我第一次認識伊法可不是在那天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752475103
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752475103,
					"content": "不過最後還是忍住了。畢竟我很成熟，說話會看場合的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "咔庫庫"
				}
			]
		}
	]
