			"dialogs": [
				{
					"id": 752470301,
					"content": "呼啊…結束了結束了，還真是滿辛苦的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470302,
					"content": "♪",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470303
					],
					"speakerTitle": "「咔阿夏」"
				},
				{
					"id": 752470303,
					"content": "是咔阿夏對吧？你和咔庫庫真的很厲害哦，這是來自對手的肯定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470304,
					"content": "厲害啊，哥們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470305
					],
					"speakerTitle": "咔庫庫"
				},
				{
					"id": 752470305,
					"content": "你看，我沒說錯吧，牠們聯起手來真的很難對付。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470306
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470306,
					"content": "咔庫庫，現在向你頒發「隱身術」畢業證書，以後你就是一位成熟的欺詐師了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470307
					],
