			"dialogs": [
				{
					"id": 752470101,
					"content": "看來畫片上的地方就是這裡了，他們都在呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470102,
					"content": "你們好——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470103,
					"content": "聽聲調是「高興」的派蒙，太好了，不用提防。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470104
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470104,
					"content": "「生氣」的派蒙也不用提防。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470105
					]
				},
				{
					"id": 752470105,
					"content": "可惡！是在瞧不起誰啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470106,
					"content": "餵她點好吃的就行了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470107
					]
				},
				{
					"id": 752470107,
					"content": "哼，這還差不多嘛…不對，怎麼說得我跟咔庫庫似的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470108,
					"content": "算了，派蒙今天是「高興」的派蒙，不跟你們計較啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470109,
					"content": "說到這個，咔庫庫呢？不會被豚獸大王吃掉了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470110,
					"content": "怎麼可能。哥們，聽聽你說的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470111
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470111,
					"content": "咔庫庫正在和敵方聯手欺負我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470112
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470112,
					"content": "哈哈哈，說是咔庫庫在「欺負」他們呢，歐洛倫又在說笑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470113,
					"content": "我不是在開玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470114
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470114,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470115,
					"content": "那麼敵方是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470116
					]
				},
				{
					"id": 752470116,
					"content": "牠說牠叫「咔阿夏」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470117
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470117,
					"content": "誰？真的嗎？阿夏會說話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470118,
					"content": "停停，你們別聽他胡謅，還是我來說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470119
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470119,
					"content": "咔庫庫呢…呃，正在和這裡遇到的阿夏一起玩捉迷藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470120
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470120,
					"content": "準確來說，是和「咔阿夏」結盟一起對付我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470121
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470121,
					"content": "咔庫庫行動很快，「咔阿夏」又很會偽裝，是棘手的敵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470122
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470122,
					"content": "你們出現前，我們已經陪這兩個小東西玩了好多好多輪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470123
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470123,
					"content": "咔庫庫的確很厲害，但我的心情已經從一開始的驕傲，變得不那麼有精神了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470124
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470124,
					"content": "只能怪你自己不去上伊安珊的健身課。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470125
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470125,
					"content": "哎呦，一直得上上下下地尋找，我腰很痛欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470126
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470126,
					"content": "對啊，這就是要怪你自己不去上伊安珊的健身課。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470127
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470127,
					"content": "…好好，結束這裡的工作我就去，好吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470128
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470128,
					"content": "停停，你們誰也別說誰了！說到底，現在是誰在負責抓咔庫庫和「咔阿夏」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470129,
					"content": "哦！這就要說到我們眼前這個完美的臺階…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470130
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470130,
					"content": "又我是吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470131
					]
				},
				{
					"id": 752470131,
					"content": "嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470132
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470132,
					"content": "好，我行我上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470133
					]
				},
				{
					"id": 752470133,
					"content": "#{M#爺爺}{F#奶奶}一定可以的！派蒙奶奶也可以！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470134
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470134,
					"content": "不用勉強哦，要幫忙的話叫我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470135
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470135,
					"content": "欸，我以為我們是要當阿夏的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470136
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470136,
					"content": "當阿夏…意思是你們也要躲起來等我們去找嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 752470137,
					"content": "嗯！從現在開始我是歐阿夏，他是伊阿夏。走囉，加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470138
					],
					"speakerTitle": "歐洛倫"
				},
				{
					"id": 752470138,
					"content": "欸你這…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470139
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470139,
					"content": "抱歉啦，就配合他們一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752470140,
						752470141
					],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470140,
					"content": "小事，還滿好玩的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				},
				{
					"id": 752470142,
					"content": "那就拜託兩位了，不勝感激。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊法"
				},
				{
					"id": 752470141,
					"content": "別擔心，我精力充沛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752470142
					]
				}
			]
		},
