					"八重神子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180201,
					"content": "八重宮司大人，我如約來了。請放心，我沒帶隨從來，這次行程也不會有人知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180202
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180202,
					"content": "知道妳會守約的，而且我猜…妳這幾天甚至會心煩意亂，夜不能寐吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180203
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180203,
					"content": "我…我不會那樣懷疑家主他們的，您過度揣測了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180204
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180204,
					"content": "那麼，我要的證據在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180205
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180205,
					"content": "在這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180206
					]
				},
				{
					"id": 20180206,
					"content": "喔~另一個守約的人也來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180207
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180207,
					"content": "為了拿到這些，可費了我們一番功夫呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180208,
					"content": "交給裟羅看看吧，讓她自己評判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180209
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180209,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180210
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180210,
					"content": "…這上面確實印有家主的官印，不像是造假…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180211
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180211,
					"content": "反抗軍，珊瑚宮，前線的事，居然隻字未提…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180212
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180212,
					"content": "前線那些陣亡的將士，人民在此間經受的困苦，全都不值一提嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180213
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180213,
					"content": "也太小看人命了吧，究竟為何要如此隱瞞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180214
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180214,
					"content": "當然是為了讓眼狩令順利推行，不然把這些寫進去的話，將軍反悔了可怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180215,
					"content": "天領奉行…果然在刻意蒙蔽將軍嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180216
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180216,
					"content": "是呢，再想想，眼狩令的推行…對誰更有利呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180217
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180217,
					"content": "這裡還有一封密信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180218
					]
				},
				{
					"id": 20180218,
					"content": "是天領奉行與愚人眾的來往書信喔，還是被九條家的家主刻意藏起來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180219,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180220
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180220,
					"content": "如何？妳想看到的東西，妳不想看到的東西，這樣一來都擺在妳面前了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180221
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180221,
					"content": "該不會…妳還想要逃避吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180222
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180222,
					"content": "我迄今為止所堅持的一切豈不是…居然…他們居然…可惡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180223
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180223,
					"content": "背叛的行為不可饒恕…我要去和家主當面對質！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180224
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180224,
					"content": "九條裟羅真的很氣憤呢，看樣子策反成功了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180225,
						20180226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180225,
					"content": "幕府軍也會暫時群龍無首了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				},
				{
					"id": 20180227,
					"content": "嗯，我們去追她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180228,
					"content": "#等一下，旅行者，我還有話想要和{F#妳}{M#你}說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180229
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180229,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180230,
					"content": "#{F#妳}{M#你}第一次進入「一心淨土」，是在千手百眼神像前吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180231
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180231,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180232
					]
				},
				{
					"id": 20180232,
					"content": "#{F#妳}{M#你}要想辦法，重現那天的情景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180233
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180233,
					"content": "在千手百眼神像前，再度讓雷電將軍「敞開心扉」的話，就一定有機會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180234
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180234,
					"content": "我會盡力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180235
					]
				},
				{
					"id": 20180235,
					"content": "把這個帶在身上吧，作為餞別的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180236
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180236,
					"content": "這是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180237,
					"content": "#鳴神大社的御守，向來都很是靈驗，我特意為{F#妳}{M#你}留了一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180238,
						20180239
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180238,
					"content": "謝謝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180240,
					"content": "呵呵，遇到難解的危機的時候，就把它拿出來看看吧，危機或許就會迎刃而解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180241
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180241,
					"content": "#當然，想我的時候也可以拿出來喔？說不定我會忽然蹦出來見{F#妳}{M#你}呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180242
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180242,
					"content": "這種關頭就別拿旅行者開玩笑啦，狐狸小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180243,
					"content": "#呵呵呵…不好意思，那麼，我那位愚鈍的朋友就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 20180239,
					"content": "我會珍惜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180240
					]
				},
				{
					"id": 20180226,
					"content": "跟上她，應該有機會見到雷電將軍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180227
					]
				}
			]
		},
		{
			"id": 201803,
			"completionStepIds": [
				201805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
