							"201805",
							"2"
						],
						"stepId": 201805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九條裟羅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180301,
					"content": "#{F#妳}{M#你}們也跟來了嗎？膽量倒是不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180302
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180302,
					"content": "#{F#妳}{M#你}們作為證人，在我向家主求證之前，姑且可以先保{F#妳}{M#你}們不被就地逮捕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180303
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180303,
					"content": "#不過…若證實{F#妳}{M#你}們之前的所言皆是誹謗，那{F#妳}{M#你}們不僅走不了，還會另有罪名加身，明白吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180304,
						20180305
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180304,
					"content": "正合我意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				},
				{
					"id": 20180306,
					"content": "哼，很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180305,
					"content": "帶路吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180306
					]
				}
			]
		},
		{
			"id": 201804,
			"completionStepIds": [
				201804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"201804",
							"2"
						],
						"stepId": 201804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九條孝行",
					"九條裟羅",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20180403,
					"content": "住手！裟羅，妳瘋了嗎！居然敢不顧我的禁令！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180404
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180404,
					"content": "家主…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180405
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180405,
					"content": "問啊，別被他的氣勢給壓制了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180406,
					"content": "哼…孝行大人，我看過奉行府的上奏公文和寫給愚人眾的信件了，請您…給我一個交待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180407
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180407,
					"content": "遺失的那些公文和信件，原來是被妳拿走了嗎？哼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180408
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180408,
					"content": "您的這句話，我可以理解為…那些果真都是出自您的手筆，而並非偽造嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180409
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180409,
					"content": "請您告訴我，家主，告訴我天領奉行…真的背叛了幕府嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180410
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180410,
					"content": "哼…我的確與愚人眾有所往來，妳所見過的公文也的確出自我之手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180411
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180411,
					"content": "居然就這麼承認了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180412,
					"content": "只需要協助眼狩令的頒佈和推行，就能拿到至冬使節承諾的那些好處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180413
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180413,
					"content": "一直以來，覬覦九條家地位的人那麼多，想把我們拉下馬的家系也數不勝數。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180414
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180414,
					"content": "既能得到他國勢力的大力支持，又可以藉眼狩令削弱那些敵人的戰力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180415
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180415,
					"content": "我認為是一筆划算的買賣，只不過沒必要知會妳而已，裟羅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180416
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180416,
					"content": "你明明…明明一直都那麼崇敬將軍，為什麼把背叛的事說得那麼輕描淡寫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180417
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180417,
					"content": "背叛？這能算得上是背叛嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180418
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180418,
					"content": "那些愚人眾不過是反過來被我利用罷了，他們又能成什麼事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180419
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180419,
					"content": "在稻妻的國土上，一旦天雷落下，他們不過是些只會瑟瑟發抖的螻蟻罷了，絕不敢造次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180420
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180420,
					"content": "畢竟——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180421
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180421,
					"content": "我們可擁有著天下無雙的雷電將軍，擁有那「無想的一刀」啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180422,
						20180423
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180422,
					"content": "並非蓄意背叛雷電將軍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				},
				{
					"id": 20180424,
					"content": "嗯…他崇拜的與其說是雷電將軍，倒不如說是雷電將軍的武藝以及「無想的一刀」吧？而且，已經近乎狂熱了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180425,
					"content": "可是，你的忠義之心呢，家主…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180426
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180426,
					"content": "自從被九條家收養以來，是你一直在教導我身為臣下的忠義之道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180427
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180427,
					"content": "如此看來，你們只是想要我忠於九條家，擔心我有朝一日會背叛而已吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180428
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180428,
					"content": "那些大道理，不過是你遮掩自己的醜惡與自私的工具！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180429
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180429,
					"content": "自私？我也是在守護著屬九條家的永恆啊，我相信將軍大人她會理解我的，前家主大人他…也一定會理解我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180430
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180430,
					"content": "雖然不想這麼說，但九條家也太自大了，愚人眾恐怕沒那麼好對付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180431,
						20180432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180431,
					"content": "繼續和他辯論也沒有意義了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180433,
					"content": "我也曾在內心懷疑過，執行眼狩令真的是正確的嗎？哪怕違背我心中的道義也在所不惜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180434
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180434,
					"content": "可是我還是下定決心，只要那是將軍所指引的道路，在走到終點之前，又有誰可論對與錯呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180435
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180435,
					"content": "但直到現在我才知道，永恆之路本就沒有終點，而且這條路…又早就因為你們的私心而沾滿汙穢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180436
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180436,
					"content": "所以，我要去糾正聖聽，至少給我迄今為止的決心一個交待！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180437
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180437,
					"content": "冥頑不靈，多此一舉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180438
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180438,
					"content": "妳要去便去吧，如今誰也別想動搖九條家的地位，時局也不會因妳而有什麼改變的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180439
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180439,
					"content": "將軍此時正在<color=#00E1FFFF>天守閣</color>，接見來自至冬的使節——那位被稱為「女士」的執行官。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180440
					],
					"speakerTitle": "九條孝行"
				},
				{
					"id": 20180440,
					"content": "「女士」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180441
					]
				},
				{
					"id": 20180441,
					"content": "稻妻幕後的始作俑者，又是「女士」嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180442
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180442,
					"content": "早在離島的時候，千里小姐似乎也提到過，勘定奉行跟一位趾高氣昂的女士見過面…那時就應該猜到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180443,
					"content": "至冬的使節…正巧，她別以為自己可以從稻妻全身而退！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180444
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180444,
					"content": "裟羅衝出去了，是準備直接去闖天守閣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180445
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180445,
					"content": "我們也有很多帳，要找「女士」清算。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180446
					]
				},
				{
					"id": 20180446,
					"content": "沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180447
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180447,
					"content": "那走吧，我們也過去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20180448
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20180448,
					"content": "我們去<color=#00E1FFFF>天守閣</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 20180432,
					"content": "還是要看九條裟羅的態度。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180433
					]
				},
				{
					"id": 20180423,
					"content": "而是過分相信雷電將軍的武藝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20180424
					]
				}
			]
		},
