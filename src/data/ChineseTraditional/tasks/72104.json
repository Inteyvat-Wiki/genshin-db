			"dialogs": [
				{
					"id": 721043801,
					"content": "玄冬小姐今天心情很好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043802
					]
				},
				{
					"id": 721043802,
					"content": "嗯？有什麼問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043803
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721043803,
					"content": "感覺和平時的氣場不太一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043804
					]
				},
				{
					"id": 721043804,
					"content": "欸，是這樣嗎？我會注意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043805
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721043805,
					"content": "可能是因為今天我抽到了「大吉」的籤吧，感覺心情很好呢！也很想把這份心情跟您分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043806
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721043806,
					"content": "不過，對於某些人來說的「大吉」，對另一些人來說卻可能意味著「大凶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043807
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721043807,
					"content": "那些抽到「大凶」的人…會有什麼樣的「御籤掛」等著他們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043808
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721043808,
					"content": "運勢真是很值得玩味呢！再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玄冬林檎"
				}
			]
		},
