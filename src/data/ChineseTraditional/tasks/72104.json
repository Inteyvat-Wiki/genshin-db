					"content": "玄冬小姐今天有什麼事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043902
					]
				},
				{
					"id": 721043902,
					"content": "我…啊？欸？您問我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043903
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721043903,
					"content": "嗯嗯嗯…最近我比較忙！但如果您、您願意的話，我看看安排…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721043904,
						721043905
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721043904,
					"content": "妳會錯意了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043906
					]
				},
				{
					"id": 721043906,
					"content": "噢。是這樣啊，還以為今天總算能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721043905,
					"content": "只是覺得妳有點心不在焉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721043906
					]
				}
			]
