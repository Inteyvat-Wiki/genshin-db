				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"長次"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721401901,
					"content": "這些晶化骨髓應該足夠了。接下來我就要啟程去冒險囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401902
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401903,
					"content": "照顧好自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401904,
					"content": "要保持聯絡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401905
					]
				},
				{
					"id": 721401902,
					"content": "還是好擔心這孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401903,
						721401904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401905,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401906
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401906,
					"content": "喂，長次你不要再油嘴滑舌啦！還好是遇上了我們…不然會被打的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401907,
					"content": "還有還有，遇到壞人想要套話，也不要對他們講實話！一定要亂胡謅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401909,
					"content": "派蒙變成老外婆了呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401910
					]
				},
				{
					"id": 721401908,
					"content": "還有還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401911,
					"content": "我相信他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401912
					]
				},
				{
					"id": 721401910,
					"content": "這麼小的孩子自己一個人出去冒險，誰會放心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401912,
					"content": "…真是的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401913,
					"content": "#哈哈哈哈！謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401914
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401914,
					"content": "希望我們以後還會見面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401915
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401915,
					"content": "一定要注意安全呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401916,
					"content": "我沒問題的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401917
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401917,
					"content": "接下來我應該會去踏鞴砂，媽媽曾在那裡工作過。或許還有人能告訴我她是否經過那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401918
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401918,
					"content": "再然後…我會想辦法去鳴神島。然後搭一艘至冬國的商船…之後的事情，隨機應變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401919
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401920,
					"content": "你知道自己在說什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401921,
					"content": "你瞭解自己面對的風險嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401922
					]
				},
				{
					"id": 721401919,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401920,
						721401921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401922,
					"content": "如果只因為不知道會面對怎樣的風險，就不去做的話…這個世界上也不會有冒險家這種職業了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401923
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401924,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401925,
					"content": "一定要小心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401926
					]
				},
				{
					"id": 721401923,
					"content": "哇…這孩子真是氣人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401924,
						721401925
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401926,
					"content": "哈哈哈，放心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401927
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401927,
					"content": "#{F#妳}{M#你}們也一路平安！順便，{NICKNAME}，希望{F#妳}{M#你}也能早日找到親人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401928
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401928,
					"content": "嗯！借你吉言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
