			},
			"dialogs": [
				{
					"id": 721971801,
					"content": "#{NICKNAME}，{F#妳}{M#你}回來啦。帶回晶石了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721971802,
						721971803
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721971802,
					"content": "帶回來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 721971803,
					"content": "正在路上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721971804
					]
				},
				{
					"id": 721971804,
					"content": "不用急，多在這裡休息一會也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長次"
				}
			]
		},
		{
			"id": 7219719,
			"completionStepIds": [
				7219721
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7219721",
							"2"
						],
						"stepId": 7219721,
