					"nextDialogs": [
						721402008
					]
				},
				{
					"id": 721402006,
					"content": "哈哈哈哈哈，當然不是啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721402007
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721402008,
