				"points": []
			},
			"dialogs": [
				{
					"id": 721401701,
					"content": "#{F#妳}{M#你}好，{NICKNAME}！最近過得如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401702
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401703,
					"content": "我要說的話被派蒙搶先啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401704
					]
				},
				{
					"id": 721401702,
					"content": "挺好的，你呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401705,
					"content": "我看派蒙是想加菜了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401706
					]
				},
				{
					"id": 721401704,
					"content": "#哈哈，只怪{F#妳}{M#你}自己反應慢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401707,
					"content": "我的意思是，妳就是「加菜」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401708
					]
				},
				{
					"id": 721401706,
					"content": "當然啦，我天天都想！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401708,
					"content": "喂——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401709,
					"content": "噗…哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401710
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401710,
					"content": "#好啦好啦，{F#妳}{M#你}們別吵啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401711
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401712,
					"content": "說吧，什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401713,
					"content": "我盡力而為。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401714
					]
				},
				{
					"id": 721401711,
					"content": "我這邊也還不錯，不過還有件事想要拜託一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401712,
						721401713
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401714,
					"content": "#嗯，也沒有別的要求啦，只是需要{NICKNAME}再幫我開採一些晶石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401715
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401716,
					"content": "我相信你，可是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401717
					]
				},
				{
					"id": 721401715,
					"content": "#請相信我，我一定會好好報答{F#妳}{M#你}的…只要{F#妳}{M#你}相信我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401716
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401718,
					"content": "為什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401719,
					"content": "你答應過給我一個解釋。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401720
					]
				},
				{
					"id": 721401717,
					"content": "可是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401718,
						721401719
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401720,
					"content": "對呀，我們還不知道你為什麼這麼需要晶化骨髓呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401722,
					"content": "可是幕府壟斷了晶礦市場。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401723,
					"content": "你知道晶礦不好賣吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401724
					]
				},
				{
					"id": 721401721,
					"content": "嗯…我需要錢旅行才能找到媽媽，所以要用礦石來換錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401722,
						721401723
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401725,
					"content": "你在做危險的事情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401726,
					"content": "我在擔心你的安危。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401727
					]
				},
				{
					"id": 721401724,
					"content": "我知道，我會自己找門路的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401725,
						721401726
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401727,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401728
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401728,
					"content": "長次，我們已經是朋友了，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401729,
					"content": "說不定這次，我們還能再幫到你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401731,
					"content": "這是什麼市儈哲學…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401732
					]
				},
				{
					"id": 721401730,
					"content": "而且，你答應要報答我們了。那麼可能危及你自己，導致我們拿不到回報的事情，我們也是有權瞭解的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401732,
					"content": "噗…派蒙說的沒錯啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401733
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401733,
					"content": "我收集晶礦也不完全是為了賺錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401734
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401734,
					"content": "我一直在想…假如爸爸媽媽也像大家一樣，得了「祟神」帶來的病…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401735
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401735,
					"content": "或許這些晶石能用來製藥也不一定。因為它們也是大蛇的骨骸上生出來的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401736
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401736,
					"content": "而且保本先生也提到過，這些晶石可能有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401737
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401737,
					"content": "可是…這也不是百分百準確的假說吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401738
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721401738,
					"content": "嗯，但我們也沒有別的假說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401739
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401739,
					"content": "等找到媽媽…或許還有爸爸，我就帶他們去須彌。聽說那裡有治療這種怪病的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401740
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401740,
					"content": "但在那之前，我也不能放棄任何一分治療的希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401741
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401742,
					"content": "你不用問也願意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401743,
					"content": "希望你能好好利用那些晶石。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721401744
					]
				},
				{
					"id": 721401741,
					"content": "好啦，我說的也夠多了，還願意幫這個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721401742,
						721401743
					],
					"speakerTitle": "長次"
				},
				{
					"id": 721401744,
					"content": "謝謝！我不會忘記的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長次"
				}
			]
		},
