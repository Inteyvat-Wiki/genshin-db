			"dialogs": [
				{
					"id": 150120401,
					"content": "嗚哇，跑得好快，也好果斷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120402,
						150120403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150120402,
					"content": "算他們識時務。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				},
				{
					"id": 150120404,
					"content": "#呼…太謝謝{F#妳}{M#你}們了。要不是{F#妳}{M#你}們幫忙，我肯定要被丟下山去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120405
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150120405,
					"content": "#能讓{NICKNAME}出手搭救，我今天的運氣也是夠好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120406
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150120406,
					"content": "抱歉，我沒做自我介紹，我是夏溫，一個倒楣透頂，剛剛才撞了好運的寶石匠人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120407
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150120407,
					"content": "是伊蜜拜託我們來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120408
					]
				},
				{
					"id": 150120408,
					"content": "那孩子…唉…讓她擔心了，我離開店鋪的時候還以為最多兩天就能回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120409
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150120409,
					"content": "我也沒想到居然能在「縫影針」附近發現一條新的「火山晶石」礦脈，裡面的晶石格外純淨，礦量也夠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120410
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150120410,
					"content": "我挖出了許多純淨的「火山晶石」，正準備回去的時候，晶石裡的燃素卻引來了魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150120403,
					"content": "名聲響亮也有好處…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120404
					]
				}
			]
		},
