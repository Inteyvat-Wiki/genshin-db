							"502901",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"夏溫"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-1439.465,
							64.598,
							8237.596
						],
						"pointId": 350100078
					}
				]
			},
			"dialogs": [
				{
					"id": 150121405,
					"content": "她為什麼不再打造「古名」了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121406
					]
				},
				{
					"id": 150121406,
					"content": "因為她的女兒…可憐的小妮赫佳患了重病，特拉佐莉幾乎拋下了一切全心照顧著她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121407
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121407,
					"content": "在小妮赫佳病情最嚴重的那段時間，特拉佐莉就像是一束陷入泥潭的火炬，拼了命地發著光和熱，底下的泥水卻越來越近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121408
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121408,
					"content": "唉呀，但是還好！多虧了醫生的藥還有大靈的保佑，小妮赫佳的生命之火還是重新燃了起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121409
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121409,
					"content": "之後小妮赫佳的病情也逐漸變好，雖然她身體還很虛弱，只能在家裡靜養，但這孩子已經有力氣寫信了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121410
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121410,
					"content": "我聽說她經常寄信給那位希諾寧，還夢想著成為一個鍛造古名的工匠，接下她母親曾經為之自豪的重任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121411
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121411,
					"content": "過幾天就是小妮赫佳的生日了，特拉佐莉也特意來拜託我幫她找一塊夠純淨的「火山晶石」，用來替妮赫佳做生日禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121412,
						150121413
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121412,
					"content": "所以妳才會一個人來這裡探礦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121414
					]
				},
				{
					"id": 150121414,
					"content": "的確是一塊意義重大的礦石，有了這麼漂亮的禮物，那個叫妮赫佳的小朋友一定能好得更快的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150121415,
					"content": "那我就替特拉佐莉和妮赫佳借妳吉言了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121416
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121416,
					"content": "我們先回去吧，不能讓伊蜜那孩子等急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121417
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121417,
					"content": "#對了，如果{F#妳}{M#你}願意的話，明天和我一起去探望特拉佐莉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121418
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121418,
					"content": "#多虧了{F#妳}{M#你}幫忙，這枚晶石才沒被那群人搶走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121419
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121419,
					"content": "#{F#妳}{M#你}保護了這枚意義重大的晶石，理應也該拿到一份意義重大的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121420,
						150121423
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121420,
					"content": "希望可以讓妮赫佳開心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121421
					]
				},
				{
					"id": 150121421,
					"content": "嗯，只要心情好，病就能好得更快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150121422,
					"content": "當然啦，那個…稍微給我們一點禮物，我們的心情也會很好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150121426,
					"content": "#哈哈哈，放心吧，這份禮物絕對能讓{F#妳}{M#你}們滿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121427
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121427,
					"content": "#至於它究竟是什麼…就等明天特拉佐莉親口告訴{F#妳}{M#你}們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150121423,
					"content": "難道是古名？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121424
					]
				},
				{
					"id": 150121424,
					"content": "#{F#妳}{M#你}不是已經有古名了嗎？這種東西拿到一個就已經夠了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150121425,
					"content": "我們…只要一點普通的好禮物就好了，嘿嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150121426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150121413,
					"content": "這枚晶石的確不能輕易讓出去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150121414
					]
				}
			]
		}
	]
}