			"dialogs": [
				{
					"id": 150120101,
					"content": "還、還沒有回來…夏溫師父難道真的出了什麼事…嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120102
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120102,
					"content": "那邊的小朋友怎麼在哭啊？是發生了什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150120103,
					"content": "#{NICKNAME}，我們過去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150120104,
					"content": "小妹妹，妳怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120105
					]
				},
				{
					"id": 150120105,
					"content": "嗚…是、是夏溫師父…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120106
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120106,
					"content": "她、她說要去那邊採「火山晶石」…但是到現在都還沒回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120107
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120107,
					"content": "我告訴了守衛叔叔，但叔叔們說現在部族裡實在抽不開來人手，而且那邊的地形很危險，還有好多魔物和壞蛋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120108
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120108,
					"content": "他們只能先盡量籌備，等準備好之後再去營救夏溫師父…但那樣就來不及了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120109,
						150120110
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120109,
					"content": "放心吧，包在我身上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				},
				{
					"id": 150120111,
					"content": "#{F#妳}{M#你}願意幫我？太好了！我現在就把守衛叔叔之前去過的地方畫給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120112
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120112,
					"content": "守衛叔叔們說這裡可能就是夏溫師父待過的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120113
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120113,
					"content": "說不定她會被迫跑到「縫影針」附近，如果…如果是那樣的話…嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120114
					],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120114,
					"content": "#拜託了，{M#大哥哥}{F#大姐姐}，救救夏溫師父吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊蜜"
				},
				{
					"id": 150120110,
					"content": "看來我的英雄事蹟又要多一筆了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120111
					]
				}
			]
		},
