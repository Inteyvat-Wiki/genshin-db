			"dialogs": [
				{
					"id": 150120501,
					"content": "#我慌不擇路，只能挑小路繞開牠們，沒想到剛出來的時候卻撞見了那些賊匪…幸好{F#妳}{M#你}們來得及時。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120502
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150120502,
					"content": "妳逃跑的時候還帶著這些晶石嗎？都那麼危險了，不能把這些石頭丟掉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150120503,
					"content": "我已經丟了很多了，只留下一塊最純淨的晶石，我無論如何都必須帶回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120504
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150120504,
					"content": "…為了特拉佐莉，也為了可憐的小妮赫佳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120505
					],
					"speakerTitle": "夏溫"
				},
				{
					"id": 150120505,
					"content": "這兩個人是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150120506
					]
				},
				{
					"id": 150120506,
					"content": "#喔，{F#妳}{M#你}不知道也正常，特拉佐莉…曾經是一位打造「古名」的工匠，妮赫佳是她的女兒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150120507
					],
					"speakerTitle": "夏溫"
