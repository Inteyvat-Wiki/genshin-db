			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040301,
					"content": "打，打倒了，完全沒有看到動作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220040302,
					"content": "你到底是誰呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220040303,
					"content": "一個釣魚的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040304
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040304,
					"content": "可疑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040305
					]
				},
				{
					"id": 220040305,
					"content": "不錯，我確實很可疑，但是這世界上有很多可疑的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040306
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040306,
					"content": "比如旁邊那家客棧裡有個廚子，之前很喜歡耍刀，現在很喜歡做菜，面頗狠，心很善。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040307
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040307,
					"content": "比如客棧裡有一位老闆，她說自己是蒙德人，卻沒有蒙德人認識她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040308
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040308,
					"content": "#還有…比如{F#妳}{M#你}能用元素的力量，卻沒有神之眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040309
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040309,
					"content": "但是有些「可疑」一看就不是「可怕」，所以不用擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040310
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040310,
					"content": "#這是給{F#妳}{M#你}的謝禮，拿好，我要繼續釣魚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "江雪"
				}
			]
		}
	]
}