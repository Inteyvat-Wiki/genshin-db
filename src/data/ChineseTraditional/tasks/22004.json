			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"江雪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220040101,
					"content": "到底什麼時候才會上鉤呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040102
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040102,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040103
					]
				},
				{
					"id": 220040103,
					"content": "我正在釣一條魚，一條有點大的魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040104
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040104,
					"content": "我的一位朋友很喜歡做菜，我釣條大魚給他，想必他會很高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040105
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040105,
					"content": "只不過，周圍總是會有怪物過來搗亂，為了解決它們，那條魚跑了又跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040106
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040106,
					"content": "#{F#妳}{M#你}身上的元素氣息不錯，願意幫我解決一下那群怪物，讓我能把那條魚釣起來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040107,
						220040109
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040108
					]
				},
				{
					"id": 220040108,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040112,
					"content": "可是，你怎麼知道什麼時候會有怪物來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220040113,
					"content": "#何須知道，抬眼一看就是，{F#妳}{M#你}看看你們後面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040114
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040114,
					"content": "後面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 220040109,
					"content": "你怎麼知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220040110
					]
				},
				{
					"id": 220040110,
					"content": "我也曾經有過神之眼，雖然懶得再用，但是元素還是勉強能感覺到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040111
					],
					"speakerTitle": "江雪"
				},
				{
					"id": 220040111,
					"content": "#既然有元素的力量傍身，那些怪物對{F#妳}{M#你}來說，想必也是小菜一碟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220040112
					],
					"speakerTitle": "江雪"
				}
			]
		},
		{
			"id": 2200403,
			"completionStepIds": [
				2200405
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
