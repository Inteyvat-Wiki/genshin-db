			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"那先朱那",
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732562301,
					"content": "#尊使大人，還有尊使的謁頌主，恐怕我只能陪{F#妳}{M#你}們到這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562302
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562302,
					"content": "又怎麼了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732562303
					]
				},
				{
					"id": 732562303,
					"content": "按照文獻中的記載，接下來的路途充滿凶險，並非本人的凡人之軀所能承受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562304
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562304,
					"content": "從這裡進去便是古時荼訶人用來試驗機關性能的試驗場，其中還有一架未完成的實驗型的巨型機關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562305
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562305,
					"content": "根據筆記中所抄錄的荼訶人的紀錄，雖然沒有發揮什麼作用，但這裡曾被改造為狙擊魔物的防禦工事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562306
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562306,
					"content": "很奇怪不是嗎，明明是引發了汙穢災厄的荼訶人，卻建造了對抗魔物的機關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562307
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562307,
					"content": "不過既然我們現在已經啟動了整座遺蹟的控制系統，想必這個試驗場裡面的防禦機關也被啟動了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562308
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562308,
					"content": "而我們要找的靈光絕唱，應該就藏在裡面的巨像當中。雖然使我望之卻步，但對於諸位來說，必定是小菜一碟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562309
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562309,
					"content": "為了能夠集齊全部的靈光絕唱，請允許我暫且在此等候諸位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562310
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562310,
					"content": "畢竟你也不過是區區人類，這樣的請求也算是合情合理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562311
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732562311,
					"content": "蒙您恩許。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732562312
					],
					"speakerTitle": "那先朱那"
				},
				{
					"id": 732562312,
					"content": "#雖然那先朱那又臨陣脫逃了，不過反正{F#妳}{M#你}們兩個不湊在一塊我也感覺輕鬆很多啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
