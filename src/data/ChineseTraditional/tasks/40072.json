			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旁白",
					"辛焱",
					"楓原萬葉",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720401,
					"content": "「然而，幽夜淨土迎來連續如噩夢的陰霾。邪龍塔斯拉克潛入地下，越過海底，游走至王城之上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720402
					],
					"speakerTitle": "旁白"
				},
				{
					"id": 400720402,
					"content": "欸？有龍嗎？我覺得只有天氣變陰了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720403
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400720403,
					"content": "龍…會不會是種比喻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720404
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400720404,
					"content": "是嗎…不認可她、反駁她幻想的一切，共同構築成了她的宿敵，「邪龍塔斯拉克」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
		{
			"id": 4007210,
			"completionStepIds": [
				4007210
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007210",
							"2"
						],
						"stepId": 4007210,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萊昂",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721001,
					"content": "太好了，有人…欸？又是你們幾位？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721002
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400721002,
					"content": "這話應該我們說吧，怎麼又是你？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
		{
			"id": 4007213,
			"completionStepIds": [
				4007213
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007213",
							"2"
						],
						"stepId": 4007213,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉",
					"辛焱",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721301,
					"content": "又回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400721302,
					"content": "剛才，我們似乎不小心窺見了邪龍的真面目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721303
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400721303,
					"content": "唉，這種事我可太有體會了，總有人覺得我們的愛好是浪費時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721304
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400721304,
					"content": "嗯？你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721305
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400721305,
					"content": "我是「渴望被問路的阿諾德」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721306
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400721306,
					"content": "我的意思是，你怎麼又來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721307
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400721307,
					"content": "噢，噢，我猜，你們應該會找《聖國的詠唱》第三卷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721308
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400721308,
					"content": "還真是讓你猜對了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721309
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400721309,
					"content": "親愛的女士，您不必為我做任何事。您的美麗，就是對我最大的褒獎。我將在此獻上您所追尋的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721310
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400721310,
					"content": "聖典第三卷，位於王城頂樓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721311
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400721311,
					"content": "有什麼保全措施嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721312
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400721312,
					"content": "噢，噢當然了先生，您在說什麼傻話？任何國家都不會將最重要的書暴露在荒野上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721313
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400721313,
					"content": "也就是說，那邊依然會有夜鴉護衛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721314
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400721314,
					"content": "看守聖典是臣民無上的榮耀。但沒關係，相信這位女士只是想閱讀聖典而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721315
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400721315,
					"content": "您的面容如此迷人，且富有智慧。您的同伴也像是英雄，如果是諸位，應該能讀懂我們聖典中的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721316
					],
					"speakerTitle": "阿諾德"
				},
				{
					"id": 400721316,
					"content": "殿下的事蹟經大書記官奧茲大人轉述，成為了幽夜淨土的珍寶。每一次我讀這本書，都盼望殿下能感到幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿諾德"
				}
			]
		},
		{
			"id": 4007218,
			"completionStepIds": [
				4007218
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
