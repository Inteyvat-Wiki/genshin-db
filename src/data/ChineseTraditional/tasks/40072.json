						],
						"stepId": 4007218,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萊昂",
					"楓原萬葉",
					"辛焱",
					"莫娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400721801,
					"content": "讓幾位反覆看見我狼狽的模樣，實在抱歉。果然，以我現在的實力，要扮演合格的夜鴉騎士還太早了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721802
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400721802,
					"content": "扮演？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721803
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400721803,
					"content": "說來慚愧，我並非真正的騎士，而是最近剛找到新工作，準備在戲團中扮演騎士一角的新人演員！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721804
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400721804,
					"content": "這種事有什麼好驕傲的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400721805,
					"content": "不不，各位有所不知。在幽夜淨土，戲劇是非常重要的文化。好的演出，是對皇女殿下最大的報答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721806
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400721806,
					"content": "哦哦，就是說，這是你們的本土文化了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721807
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400721807,
					"content": "正是！因此，我很高興自己能演出騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721808
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400721808,
					"content": "你們的皇女殿下為什麼喜歡戲劇？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721809
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400721809,
					"content": "皇女殿下曾說過，「為本皇女獻上慶典，到曠野中演出戲劇。向我叩拜，向我獻上純淨之幻夢以換取永夜榮光。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721810
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400721810,
					"content": "我想，一定是因為皇女殿下懂得真正的藝術，又能分辨人性最深處暗藏的喜怒哀樂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721811
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400721811,
					"content": "戲劇的靈魂，在於感情的凝聚與昇華。讀懂戲劇的人，都有一顆敏感又情緒豐富的美麗之心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721812
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400721812,
					"content": "…原來是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721813
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400721813,
					"content": "感謝你的回答，騎士先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721814
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400721814,
					"content": "噢、噢噢！您…您竟然願意稱我為騎士，萬分感謝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721815
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400721815,
					"content": "那麼，帶著這份榮光，我將奔赴我的戰場了。各位，有緣再會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721816
					],
					"speakerTitle": "萊昂"
				},
				{
					"id": 400721816,
					"content": "別再會了，下次注意安全！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400721817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400721817,
					"content": "啊對，請記住開門的口令：「聽我命令，振翅起航」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊昂"
				}
			]
		}
	]
