			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神情嚴肅的夜鴉",
					"眼神凜冽的夜鴉",
					"莫娜",
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400720201,
					"content": "站住，什麼人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720202
					],
					"speakerTitle": "神情嚴肅的夜鴉"
				},
				{
					"id": 400720202,
					"content": "看你們的樣子，不是幽夜淨土臣民吧？說！來這裡做什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720203
					],
					"speakerTitle": "眼神凜冽的夜鴉"
				},
				{
					"id": 400720203,
					"content": "竟然有守衛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400720204,
					"content": "不必慌張。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720205
					]
				},
				{
					"id": 400720205,
					"content": "欸？你幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400720206,
					"content": "我們是皇女殿下的家臣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720207
					]
				},
				{
					"id": 400720207,
					"content": "穿越星海而來之人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400720208
					]
				},
				{
					"id": 400720208,
					"content": "#{F#妳}{M#你}如何證明自己是殿下的家臣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720209
					],
					"speakerTitle": "神情嚴肅的夜鴉"
				},
				{
					"id": 400720209,
					"content": "哼，問出如此狂妄的問題，正說明你們眼光淺薄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720210
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400720210,
					"content": "「令我的子民自由，不囿於古老法則。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720211
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400720211,
					"content": "是、是幽夜淨土的口令！他們真的是殿下的臣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720212
					],
					"speakerTitle": "眼神凜冽的夜鴉"
				},
				{
					"id": 400720212,
					"content": "天哪，我、我僭越了！各位，請原諒我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720213
					],
					"speakerTitle": "神情嚴肅的夜鴉"
				},
				{
					"id": 400720213,
					"content": "知錯了還不快退下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400720214,
					"content": "是是，屬下這就離開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720215
					],
					"speakerTitle": "神情嚴肅的夜鴉"
				},
				{
					"id": 400720215,
					"content": "他們走啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400720216,
					"content": "這就是《聖國的詠唱》第二卷。各位，準備好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400720217
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400720217,
					"content": "出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4007204,
			"completionStepIds": [
				4007204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
