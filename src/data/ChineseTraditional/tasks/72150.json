				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500301,
					"content": "#哦哦，是{F#妳}{M#你}們呀，快來休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500302
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500302,
					"content": "小卷婆婆，我們把您說的水帶回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500303,
					"content": "這是您說的「最理想的水」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500304
					]
				},
				{
					"id": 721500304,
					"content": "#沒錯，這些就足夠了。真是辛苦{F#妳}{M#你}們了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500305
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500305,
					"content": "呵呵，精神了很多嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500306
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500306,
					"content": "從「靈草」的光彩來看…來年一定是個和平富足的好年景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500307
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500307,
					"content": "欸…這是怎麼看出來的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500308,
					"content": "「靈草」的光彩在於水的潤澤，與眾人「願望」的滋養。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500309
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500309,
					"content": "這靈光正是大家願望的宣示。願望美好，光彩也就更鮮活，未來也就更有希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500310
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500310,
					"content": "畢竟…大家的願望總是向著更好的明天吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500311
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500311,
					"content": "只要大家都有著為改善當前的生活而做點什麼的願望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500312
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500312,
					"content": "或許相比而言，戰爭造成的種種困窘就算不得什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500313
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500313,
					"content": "唔…所以這和它靈驗與否有什麼關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500314,
					"content": "當然…這就是我們老人的智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500315
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500315,
					"content": "「願望」驅使和鼓勵人行動，而行動的成果反過來驗證了人的「願望」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500316
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500316,
					"content": "只要我們又一次維護了生活的平和，只要從灰暗的日子裡保護生活的希望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500317
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500317,
					"content": "「靈草」的占卜就永遠是靈驗的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500318,
						721500319
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500318,
					"content": "像是在用敷衍解釋迷信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				},
				{
					"id": 721500320,
					"content": "呵呵，年輕人總會理解的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500321
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500321,
					"content": "順便一提，水中「願望」的效力應該還能堅持些時日，兩位願意的話，可以隨時來找我占卜喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500319,
					"content": "但也不是沒有道理…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500320
					]
				}
			]
		},
		{
			"id": 7215004,
