				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"小卷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500101,
					"content": "#{F#妳}{M#你}好，年輕人。看樣子{F#妳}{M#你}是從島外來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500102,
						721500103
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500102,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500104
					]
				},
				{
					"id": 721500104,
					"content": "#想必{F#妳}{M#你}是遊歷四方的旅人吧？那麼…不知是否有興趣稍事停留，順便占卜一下前路呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500105
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500105,
					"content": "欸，占卜前路…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500106,
						721500107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500106,
					"content": "占卜前路…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500108
					]
				},
				{
					"id": 721500108,
					"content": "哈哈，二位不必如此憂心忡忡。抱歉呀，是我唐突了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500109
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500109,
					"content": "#我的意思是，我們望瀧村的海祇神龕十分靈驗，所以才要邀請{F#妳}{M#你}們占卜一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500110
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500110,
					"content": "自然沒有說二位前路險峻的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500111
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500111,
					"content": "#啊…當然了，{F#妳}{M#你}我各自前路將會如何，又怎能靠隻言片語預料呢…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500112
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500112,
					"content": "原來只是要占卜呀…那我就放心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500113,
					"content": "需要收費嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500114
					]
				},
				{
					"id": 721500114,
					"content": "呵呵，不需要的。我們不會就這種事情收取奉納錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500115
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500115,
					"content": "維護神龕的人，若是為了「願望」而向過路的旅人收費，是會招致大御神靈魂不安的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500116
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500116,
					"content": "畢竟同樣身為凡人，我們有何資格利用別人的「願望」，為自己牟取利益呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500117
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500117,
					"content": "唔…是這個道理呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500118,
					"content": "所以二位，是否有興趣賞光占卜前路呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500119
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500119,
					"content": "可以一試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500120
					]
				},
				{
					"id": 721500120,
					"content": "呵呵，多謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500121
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500121,
					"content": "這陣子到處都不太平，村裡的年輕人大多還在外面忙活計。能看到有年輕人來，我這老婆子還是挺開心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500122
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500122,
					"content": "更難得的是，作為外國人，對於海祇島的傳統仍懷著尊敬之心，真是了不起，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500123
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500123,
					"content": "好了，不嘮叨了。說起占卜呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500124
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500124,
					"content": "在占卜之前，二位如果不介意的話，可否先幫我一個小忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500125
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500125,
					"content": "什麼嘛，還是要錢啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500126,
					"content": "呵呵，不是要錢…且聽我說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500127
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500127,
					"content": "望瀧村的神龕之所以靈驗，乃是有賴於其中供養的「海淵靈草」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500128
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500128,
					"content": "顧名思義，這種植物最初產於深深的海淵之下…也就是我們的祖先所發源之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500129
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500129,
					"content": "數千年前，我們村莊的先民將其遺株從深海帶到陸地，加以仔細撫養。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500130
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500130,
					"content": "在一代代村人的照料下…不論是戰亂或是天災，抑或大御神殉難的悲愴…都未曾摧折這長壽的「靈草」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500131
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500131,
					"content": "因為是生長在水底的植物，所以需要頻繁供應水源才能成活；",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500132
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500132,
					"content": "因為是曾生活在漆黑環境中的生物，所以永遠會泛著磷色的微光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500133
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500133,
					"content": "於是，我們透過光彩閃爍的規律來判斷願望是否可能得以實現，至於其中奧秘，就在於水源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500134
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500134,
					"content": "呵呵，年輕些的巫女總會質疑占卜儀式的可信性，覺得這樣的民間儀式不夠正式，是在散播迷信…之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500135
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500135,
					"content": "她們更喜歡明確易懂的理論，不喜歡老一輩口口相傳，慢慢衰變的傳說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500136
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500136,
					"content": "但是呢…老人的智慧，代代相傳的智慧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500137
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500137,
					"content": "或許一時間無法歸納成條目分明的理論，卻總是或多或少蘊含著不容忽視的真理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500138
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500138,
					"content": "關於水源…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500139
					]
				},
				{
					"id": 721500139,
					"content": "水源…？哦！呵呵…抱歉，上了年紀，說話總是囉哩囉嗦的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500140
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500140,
					"content": "想要供養「靈草」，需要取自島上神社奉納池中的水才行。因為那裡的水飽含著「願望」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500141
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500141,
					"content": "「願望」…水中也會含有那種東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500142,
					"content": "呵呵，是啊。每一個人託付的「願望」會沉積在奉納池中，消融在水裡。就像蜜糖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500143
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500143,
					"content": "沒人能親眼看到它…卻能透過水的濃淡與甜味感受到它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500144
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500144,
					"content": "記憶也好，信仰也好…都是這樣的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500145
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500145,
					"content": "另外，要去取水的話，一定要小心…「願望」的效力，離了奉納池便很容易就會在空氣中逸散…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500146
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500146,
					"content": "就像隨著年月流逝而不斷消散的夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500147
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500147,
					"content": "透過觸感與分量感的變化，很容易感知這種「願望」的衰減。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500148
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500148,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500149,
					"content": "哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500150
					]
				},
				{
					"id": 721500150,
					"content": "呵呵，抱歉抱歉，又岔題了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500151
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500151,
					"content": "總之，取到水之後，請不要耽擱太長時間，盡快回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500152
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500152,
					"content": "否則「願望」的效力會逸散殆盡，「靈草」也難以汲取足夠的養分了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500153
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500153,
					"content": "在那之後，還請麻煩再提醒我一下…還有一個步驟滋養「靈草」，占卜才會靈驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500154
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500154,
					"content": "好麻煩！就沒有巫女幫妳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500155,
					"content": "唉…現在的年輕巫女要不是嫌麻煩，就是對這種古老的傳統嗤之以鼻，很少有願意幫忙的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500156
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500156,
					"content": "看著「靈草」的光澤一日更比一日暗淡…老婆子我啊，比誰都要失落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500157
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500157,
					"content": "可還是感覺好麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500158
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500158,
					"content": "有點理解巫女們的意見了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500159
					]
				},
				{
					"id": 721500159,
					"content": "所以，不知兩位有沒有興趣幫忙取些水回來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500160
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500160,
					"content": "我們會幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500161
					]
				},
				{
					"id": 721500161,
					"content": "#那麼就拜託{F#妳}{M#你}們了，非常感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500107,
					"content": "前方很危險嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500108
					]
				},
				{
					"id": 721500103,
					"content": "妳好，老人家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500104
					]
				}
			]
		},
		{
			"id": 7215002,
			"completionStepIds": [
				7215004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
