			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小卷",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721500201,
					"content": "#{F#妳}{M#你}們回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500202
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500202,
					"content": "妳要的東西我們取回來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500203
					]
				},
				{
					"id": 721500203,
					"content": "是奉納池的淨水，還新鮮哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500204,
					"content": "#真是太感謝{F#妳}{M#你}們了，我這就把水給「靈草」續上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500205
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500205,
					"content": "之前說到哪裡了來著…對，還需要一個步驟，「靈草」才能更加煥發光澤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500206
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500206,
					"content": "只有在與深海水元素富集的環境中，「靈草」的莖葉才能足夠舒展，其光彩才更能展現「願望」的顏色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500207
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500207,
					"content": "簡而言之…在北方的一處洞窟裡，存在著與其生存環境的水質最為近似的水元素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500208
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500208,
					"content": "而在洞內不同的區域，其濃度也有所不同…其中呢，濃度最為理想的水元素是最為晶瑩透明的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500209
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500209,
					"content": "但假如變得渾濁了…比如被其他生物攪擾了，也是會很難辦的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500210
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500210,
					"content": "唉，我老了，不太好解釋其中道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500211
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500211,
					"content": "#到時候{F#妳}{M#你}們親眼看到就會明白了，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500212
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500212,
					"content": "那處洞窟同我們望瀧村先祖的秘密息息相關…只可惜由於近來的戰爭，已罕有年輕人去那邊取水滋養「靈草」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500213
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500213,
					"content": "唉…說起年輕人們，希望他們都能安全歸來吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500214
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500214,
					"content": "#話說回來，年輕人。如果{F#妳}{M#你}們要去那裡取水的話，請一定注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500215
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500215,
					"content": "嗯，小卷婆婆請放心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500216,
						721500217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500216,
					"content": "我們會注意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				},
				{
					"id": 721500218,
					"content": "#那就好，那就好…十分感謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500217,
					"content": "請您放心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500218
					]
				}
			]
		},
		{
			"id": 7215003,
