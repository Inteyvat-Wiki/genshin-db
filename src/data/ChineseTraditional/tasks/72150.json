	"talks": [
		{
			"id": 7215001,
			"completionStepIds": [
				7215001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7215001",
							"2"
						],
						"stepId": 7215001,
						"stateName": "QUEST_STATE_UNFINISHED"
