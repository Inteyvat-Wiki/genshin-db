				"points": []
			},
			"dialogs": [
				{
					"id": 721500401,
					"content": "#{F#妳}{M#你}好，年輕人。看樣子{F#妳}{M#你}是從島外來的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500402,
						721500403
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500402,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500404
					]
				},
				{
					"id": 721500404,
					"content": "#想必{F#妳}{M#你}是遊歷四方的旅人吧？那麼…不知是否有興趣稍事停留，順便占卜一下前路呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500405
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500405,
					"content": "欸，占卜前路…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500406,
						721500407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500406,
					"content": "占卜前路…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500408
					]
				},
				{
					"id": 721500408,
					"content": "哈哈，二位不必如此憂心忡忡。抱歉呀，是我唐突了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500409
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500409,
					"content": "#我的意思是，我們望瀧村的海祇神龕十分靈驗，所以才要邀請{F#妳}{M#你}們占卜一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500410
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500410,
					"content": "自然沒有說二位前路險峻的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500411
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500411,
					"content": "#啊…當然了，{F#妳}{M#你}我各自前路將會如何，又怎能靠隻言片語預料呢…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500412
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500412,
					"content": "原來只是要占卜呀…那我就放心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500413,
					"content": "需要收費嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500414
					]
				},
				{
					"id": 721500414,
					"content": "呵呵，不需要的。我們不會就這種事情收取奉納錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500415
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500415,
					"content": "維護神龕的人，若是為了「願望」而向過路的旅人收費，是會招致大御神靈魂不安的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500416
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500416,
					"content": "畢竟同樣身為凡人，我們有何資格利用別人的「願望」，為自己牟取利益呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500417
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500417,
					"content": "唔…是這個道理呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500418,
					"content": "所以二位，是否有興趣賞光占卜前路呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500419
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500419,
					"content": "可以一試。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500420
					]
				},
				{
					"id": 721500420,
					"content": "呵呵，多謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500421
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500421,
					"content": "這陣子到處都不太平，村裡的年輕人大多還在外面忙活計。能看到有年輕人來，我這老婆子還是挺開心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500422
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500422,
					"content": "更難得的是，作為外國人，對於海祇島的傳統仍懷著尊敬之心，真是了不起，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500423
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500423,
					"content": "好了，不嘮叨了。說起占卜呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500424
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500424,
					"content": "在占卜之前，二位如果不介意的話，可否先幫我一個小忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500425
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500425,
					"content": "什麼嘛，還是要錢啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500426,
					"content": "呵呵，不是要錢…且聽我說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500427
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500427,
					"content": "望瀧村的神龕之所以靈驗，乃是有賴於其中供養的「海淵靈草」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500428
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500428,
					"content": "顧名思義，這種植物最初產於深深的海淵之下…也就是我們的祖先所發源之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500429
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500429,
					"content": "數千年前，我們村莊的先民將其遺株從深海帶到陸地，加以仔細撫養。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500430
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500430,
					"content": "在一代代村人的照料下…不論是戰亂或是天災，抑或大御神殉難的悲愴…都未曾摧折這長壽的「靈草」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500431
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500431,
					"content": "因為是生長在水底的植物，所以需要頻繁供應水源才能成活；",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500432
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500432,
					"content": "因為是曾生活在漆黑環境中的生物，所以永遠會泛著磷色的微光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500433
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500433,
					"content": "於是，我們透過光彩閃爍的規律來判斷願望是否可能得以實現，至於其中奧秘，就在於水源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500434
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500434,
					"content": "呵呵，年輕些的巫女總會質疑占卜儀式的可信性，覺得這樣的民間儀式不夠正式，是在散播迷信…之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500435
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500435,
					"content": "她們更喜歡明確易懂的理論，不喜歡老一輩口口相傳，慢慢衰變的傳說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500436
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500436,
					"content": "但是呢…老人的智慧，代代相傳的智慧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500437
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500437,
					"content": "或許一時間無法歸納成條目分明的理論，卻總是或多或少蘊含著不容忽視的真理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500438
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500438,
					"content": "關於水源…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500439
					]
				},
				{
					"id": 721500439,
					"content": "水源…？哦！呵呵…抱歉，上了年紀，說話總是囉哩囉嗦的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500440
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500440,
					"content": "想要供養「靈草」，需要取自島上神社奉納池中的水才行。因為那裡的水飽含著「願望」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500441
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500441,
					"content": "「願望」…水中也會含有那種東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500442
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500442,
					"content": "呵呵，是啊。每一個人託付的「願望」會沉積在奉納池中，消融在水裡。就像蜜糖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500443
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500443,
					"content": "沒人能親眼看到它…卻能透過水的濃淡與甜味感受到它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500444
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500444,
					"content": "記憶也好，信仰也好…都是這樣的道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500445
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500445,
					"content": "另外，要去取水的話，一定要小心…「願望」的效力，離了奉納池便很容易就會在空氣中逸散…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500446
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500446,
					"content": "就像隨著年月流逝而不斷消散的夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500447
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500447,
					"content": "透過觸感與分量感的變化，很容易感知這種「願望」的衰減。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500448
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500448,
					"content": "哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500449
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500449,
					"content": "哦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500450
					]
				},
				{
					"id": 721500450,
					"content": "呵呵，抱歉抱歉，又岔題了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500451
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500451,
					"content": "總之，取到水之後，請不要耽擱太長時間，盡快回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500452
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500452,
					"content": "否則「願望」的效力會逸散殆盡，「靈草」也難以汲取足夠的養分了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500453
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500453,
					"content": "在那之後，還請麻煩再提醒我一下…還有一個步驟滋養「靈草」，占卜才會靈驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500454
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500454,
					"content": "好麻煩！就沒有巫女幫妳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500455
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500455,
					"content": "唉…現在的年輕巫女要不是嫌麻煩，就是對這種古老的傳統嗤之以鼻，很少有願意幫忙的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500456
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500456,
					"content": "您說的是露子嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500457
					]
				},
				{
					"id": 721500457,
					"content": "對哦，珊瑚宮邊的那個巫女小姐，總是一副看不起老人家的樣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500458
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500458,
					"content": "#哦哦，{F#妳}{M#你}們見過她呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500459
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500459,
					"content": "呵呵，她呀…挺能幹的，不過就是呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500460
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500460,
					"content": "呵呵…不多說了，年輕人嘛，總有一天能學會尊重故事傳說的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500461
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500461,
					"content": "唔…什麼呀…聽不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500462
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500462,
					"content": "看著「靈草」的光澤一日更比一日暗淡…老婆子我啊，比誰都要失落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500463
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500463,
					"content": "可還是感覺好麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500464
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721500464,
					"content": "有點理解巫女們的意見了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500465
					]
				},
				{
					"id": 721500465,
					"content": "所以，不知兩位有沒有興趣幫忙取些水回來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721500466
					],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500466,
					"content": "我們會幫忙的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500467
					]
				},
				{
					"id": 721500467,
					"content": "#那麼就拜託{F#妳}{M#你}們了，非常感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小卷"
				},
				{
					"id": 721500407,
					"content": "前方很危險嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500408
					]
				},
				{
					"id": 721500403,
					"content": "妳好，老人家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721500404
					]
				}
			]
		},
		{
			"id": 7215005,
