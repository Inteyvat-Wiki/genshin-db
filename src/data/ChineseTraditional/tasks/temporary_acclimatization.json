						],
						"pointId": 7469
					}
				]
			},
			"dialogs": [
				{
					"id": 711140401,
					"content": "…這麼調整應該沒問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140402
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140402,
					"content": "#旅行者，{F#妳}{M#你}們把儀器都安置好了？真是太感謝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140403
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140403,
					"content": "#等我把這臺儀器也安置好，就把報酬付給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140404
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140404,
					"content": "剛才直接讓我一起安置就好啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140405
					]
				},
				{
					"id": 711140405,
					"content": "#多謝{F#妳}{M#你}的好意。不過這臺儀器有些特殊，需要除錯的地方有點多，要是{F#妳}{M#你}來操作的話，實在太麻煩{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140406
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140406,
					"content": "#我們先去那邊的懸崖上把這臺儀器安置好，然後我就可以和{F#妳}{M#你}們結清報酬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140407
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140407,
					"content": "聽起來好複雜…妳一直都這樣工作的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711140408,
					"content": "現在我只用把儀器安置在陸地上…在有一次考察裡，我還不得不想辦法把儀器浸到一條大江的中央呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140409
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140409,
					"content": "不能直接坐船過去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140410
					]
				},
				{
					"id": 711140410,
					"content": "唉，如果只用把儀器沉進江水裡，那我當然可以坐著船過去把儀器丟進水裡，然後就離開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140411
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140411,
					"content": "但那次考察我要勘測的是水流強度，所以必須把勘測用的特型儀器持續置於水流的中央，不能浮到頂，也不能沉到底…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140412
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140412,
					"content": "還好那條河上面有一座吊橋，要是沒吊橋的話，我就只能求人在兩座山之間拉一條繩索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140413
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140413,
					"content": "再把這臺儀器用繩索吊起來，用另一條繩索拉著，一直送到河流中心再放下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140414
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140414,
					"content": "咳…先不說這些了，現在我們也不用處理這種情況…雖然我們等會也要路過一座吊橋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140415
					],
					"speakerTitle": "斡流"
				},
				{
					"id": 711140415,
					"content": "往這邊走吧，那座吊橋離我們不遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斡流"
				}
			]
		},
