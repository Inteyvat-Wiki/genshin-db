			},
			"dialogs": [
				{
					"id": 711140901,
					"content": "唉，還是先把翹英莊裡的景取了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140902,
						711140903
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 711140902,
					"content": "一切都還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				},
				{
					"id": 711140904,
					"content": "#{NICKNAME}，派蒙，哎喲！託了{F#妳}{M#你}們的福，裝置和畫片一點沒丟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140905
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 711140905,
					"content": "不過我們下次想要去那邊取景，看來必須得去僱幾個冒險家同行了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140906
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 711140906,
					"content": "所以，你們那部關於茶的映影，到底拍得怎麼樣了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 711140907,
					"content": "呃…這部片子處於…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140908
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 711140908,
					"content": "有一個良好的開頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140909
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 711140909,
					"content": "和一個良好的趨勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140910
					],
					"speakerTitle": "弈豐"
				},
				{
					"id": 711140910,
					"content": "這不就是才剛開始拍嗎？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140911
					]
				},
				{
					"id": 711140911,
					"content": "哎呀，我們現在的資金…有點緊張，熱塞爾先生的收費就和他的學問一樣高超…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140912
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 711140912,
					"content": "雖然我們也拍了幾部小片，賺了幾筆小錢，但這種大型記錄映影，實在是太花錢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140913
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 711140913,
					"content": "特別是老闆還拒絕了幾家過來贊助的客商。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140914
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 711140914,
					"content": "和謝絕了一堆合作邀請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140915
					],
					"speakerTitle": "弈豐"
				},
				{
					"id": 711140915,
					"content": "你們懂什麼！這是為了我們能完全依照我們自己的審美拍出一部好片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140916
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 711140916,
					"content": "但是老闆，我們最開始拍片的目的不也是為了賺錢嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140917
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 711140917,
					"content": "我…你、你們別管這麼多，先去把裝置支起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140918
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 711140918,
					"content": "#{NICKNAME}，這些報酬給{F#妳}{M#你}，多謝{F#妳}{M#你}幫我這麼多次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140919
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 711140919,
					"content": "#等我拍出了好片，一定請{F#妳}{M#你}來看，然後再請{F#妳}{M#你}喝一頓好茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140920
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 711140920,
					"content": "弈豐，興曄，找好光源角度！這次要一遍拍好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140921
					],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 711140921,
					"content": "老闆，這又不是拍人和人的對手戲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140922
					],
					"speakerTitle": "興曄"
				},
				{
					"id": 711140922,
					"content": "拍景物能不能一遍過，不都是全憑緣分嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711140923
					],
					"speakerTitle": "弈豐"
				},
				{
					"id": 711140923,
					"content": "總…總之先把裝置架起來！先…先在這等著！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "邱老闆"
				},
				{
					"id": 711140903,
					"content": "看來你們的裝置沒事嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711140904
					]
				}
			]
		},
