				"points": []
			},
			"dialogs": [
				{
					"id": 725000101,
					"content": "出事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000102
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000103
					]
				},
				{
					"id": 725000103,
					"content": "老大又進去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000104
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000104,
					"content": "就在剛才，天領奉行派人過來，在留言板上貼了一張告示，說是要暫停我們的祭典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000105
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000105,
					"content": "不知道怎麼回事，老大他好像把宣傳廣告發進了天守閣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000106
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000106,
					"content": "還說將軍大人一定想要參加荒瀧極上盛世豪鼓大祭典！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000107
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000107,
					"content": "欸？這麼說的話，我覺得老大說的沒錯呀。我也覺得將軍大人肯定想參加。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000108
					],
					"speakerTitle": "阿晃"
				},
				{
					"id": 725000108,
					"content": "對呀，難道你不是這麼認為的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000109
					],
					"speakerTitle": "元太"
				},
				{
					"id": 725000109,
					"content": "哎呀，誰會管我們怎麼覺得呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000110
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000110,
					"content": "總之老大就是被看守的奧詰眾當場抓獲，送去了天領奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000111
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000111,
					"content": "那要怎麼辦呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						725000112
					]
				},
				{
					"id": 725000112,
					"content": "忍姐應該已經在處理了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000113
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000113,
					"content": "據說奧詰眾對老大的指控是涉嫌擾亂軍事禁區。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000114
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000114,
					"content": "後來被九條裟羅大人改成了涉嫌妨礙公共秩序。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000115
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000115,
					"content": "呀呀呀呀呀，這個可惡的九條天狗，居然給老大定了這種重罪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000116
					],
					"speakerTitle": "元太"
				},
				{
					"id": 725000116,
					"content": "哎呀，你傻啦！這是變成了輕罪，一般在所裡教育教育就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000117
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000117,
					"content": "至於祭典這邊，就只能等老大出來之後再說啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000118
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000118,
					"content": "旅行者，您也不用擔心，有忍姐在那邊處理，肯定不會有大問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000119
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000119,
					"content": "#您對我們的祭典這麼支持，等老大出來，他一定會來當面感謝{F#妳}{M#你}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000120
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000120,
					"content": "希望您的旅途和我們的祭典一樣，都能愈來愈好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						725000121
					],
					"speakerTitle": "阿守"
				},
				{
					"id": 725000121,
					"content": "愈來愈好！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿守"
				}
			]
		}
	]
}