					"盜寶團老大"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300401,
					"content": "英雄住手！我們認輸了，認輸了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300402,
						718300403
					],
					"speakerTitle": "盜寶團老大"
				},
				{
					"id": 718300402,
					"content": "收拾東西，滾遠點！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				},
				{
					"id": 718300404,
					"content": "是，是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300405
					],
					"speakerTitle": "盜寶團老大"
				},
				{
					"id": 718300405,
					"content": "但不知道…我們兄弟是哪裡冒犯了英雄？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300406
					],
					"speakerTitle": "盜寶團老大"
				},
				{
					"id": 718300406,
					"content": "難不成英雄正在這周圍發財？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300407
					],
					"speakerTitle": "盜寶團老大"
				},
				{
					"id": 718300407,
					"content": "我們正在這附近修廟。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300408
					]
				},
				{
					"id": 718300408,
					"content": "修、修廟？這荒郊野嶺的，英雄怎麼會在這裡修廟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300409
					],
					"speakerTitle": "盜寶團老大"
				},
				{
					"id": 718300409,
					"content": "這…這周圍居然有供著仙師的廟？等會，難道那個破屋子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300410
					],
					"speakerTitle": "盜寶團老大"
				},
				{
					"id": 718300410,
					"content": "老大，我們上次去那邊休息的時候，我看見了一隻鳥的雕像，那不會就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300411
					],
					"speakerTitle": "盜寶團小弟"
				},
				{
					"id": 718300411,
					"content": "那就是夜叉「銅雀」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300412
					]
				},
				{
					"id": 718300412,
					"content": "啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300413
					],
					"speakerTitle": "盜寶團老大"
				},
				{
					"id": 718300413,
					"content": "老、老大！我們是不是冒犯仙師了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300414
					],
					"speakerTitle": "盜寶團小弟"
				},
				{
					"id": 718300414,
					"content": "別、別瞎說！我們之前又不知道，那算是…算是無心之過！仙師應該…應該不會怪罪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300415
					],
					"speakerTitle": "盜寶團老大"
				},
				{
					"id": 718300415,
					"content": "英雄！給仙師修廟這件事，我們知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300416
					],
					"speakerTitle": "盜寶團老大"
				},
				{
					"id": 718300416,
					"content": "之前是我們有眼無珠，對仙師不敬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300417
					],
					"speakerTitle": "盜寶團老大"
				},
				{
					"id": 718300417,
					"content": "我們這就回去，讓周圍的兄弟離那座廟遠點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300418
					],
					"speakerTitle": "盜寶團老大"
				},
				{
					"id": 718300418,
					"content": "老大，我們要不要抽個空去那邊燒幾炷香，給仙師賠個罪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300419
					],
					"speakerTitle": "盜寶團小弟"
				},
				{
					"id": 718300419,
					"content": "哪來這麼多廢話，趕緊走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "盜寶團老大"
				},
				{
					"id": 718300403,
					"content": "以後離這裡遠一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300404
					]
				}
			]
		},
