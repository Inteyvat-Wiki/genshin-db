					"content": "好，這些<color=#00E1FFFF>卻砂木</color>我就收下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300602
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300602,
					"content": "這座廟還得一段時間才能完工，這段時間我會一直待在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300603
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300603,
					"content": "您要是有空的話，也可以多來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				}
			]
		},
