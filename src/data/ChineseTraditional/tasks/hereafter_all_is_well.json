			},
			"dialogs": [
				{
					"id": 718300701,
					"content": "您回來了，周圍有盜寶團嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300702
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300702,
					"content": "走了就好，走了就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300703
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300703,
					"content": "還有什麼我們能幫上的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300704
					]
				},
				{
					"id": 718300704,
					"content": "哈哈哈，謝謝您好心，但您都幫了我那麼多忙，我可不能讓您再跑前跑後了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300705
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300705,
					"content": "但如果您願意的話，倒是可以找些<color=#00E1FFFF>卻砂木</color>給我，這樣您也算是真正參與建築這座廟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300706
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300706,
					"content": "修廟可是件積德的事，您親自參與一下，說不定也能沾點福氣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300707,
						718300709
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300707,
					"content": "我會找點卻砂木來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300708
					]
				},
				{
					"id": 718300708,
					"content": "哈哈哈，好。您找到<color=#00E1FFFF>卻砂木</color>之後，直接帶來給我就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300709,
					"content": "有其他人捐物資來修廟嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300710
					]
				},
				{
					"id": 718300710,
					"content": "嗯…老實說，其實沒多少人。畢竟這荒郊野嶺的，大部分人都不知道這裡還有一座廟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300711
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300711,
					"content": "而且，那位名為銅雀的仙師，現在也沒多少人記得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300712
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300712,
					"content": "好了，不說這些了。您找到<color=#00E1FFFF>卻砂木</color>之後，直接帶來給我就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				}
			]
		},
