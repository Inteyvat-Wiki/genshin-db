			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"王平安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718300201,
					"content": "這可真是個大工程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300202
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300202,
					"content": "你還真在修廟啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300203
					]
				},
				{
					"id": 718300203,
					"content": "是您啊。可不是，我都說了我是正經人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300204
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300204,
					"content": "不過，我還是沒想到工程量會有這麼大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300205
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300205,
					"content": "那位設計屋子的師傅一聽是供奉「夜叉」的廟，整個人都來勁了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300206
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300206,
					"content": "不僅把設計圖畫了厚厚一大疊，還抓著我到處去採購材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300207
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300207,
					"content": "我看他那架勢，要是再年輕個幾十歲，非要自己過來親自修不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300208,
						718300210
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300208,
					"content": "沒有遇見什麼危險吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300209
					]
				},
				{
					"id": 718300209,
					"content": "危險？噢，您是說魔物和盜寶團吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300212,
					"content": "這您不用擔心，聽說我要幫夜叉修廟之後，總務司那邊也派了幾位千岩軍隨行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300213
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300213,
					"content": "這附近的魔物，基本上都被那幾位千岩軍趕走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300214
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300214,
					"content": "至於盜寶團嘛…他們看見千岩軍在這，估計也不敢露頭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300215
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300215,
					"content": "不過，修這廟的工程量超乎我的想像，原本準備的材料也不夠了，我們只能從城裡再運一些材料過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300216
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300216,
					"content": "我覺得…那群盜寶團雖然不敢對工地動手，但他們也許會埋伏在路上，等著搶劫那些運過來的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300217
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300217,
					"content": "雖然千岩軍能守住工地，但要是那些運材料的人在路上被盜寶團襲擊，那千岩軍肯定也沒法及時過去援助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300218
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300218,
					"content": "英雄，我能請您幫個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300219
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300219,
					"content": "我知道您身手很好，對付那些盜寶團肯定不在話下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300220
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300220,
					"content": "能請您去附近教訓一下那群盜寶團，別讓這群傢伙搗亂嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300221,
						718300223
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300221,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300222
					]
				},
				{
					"id": 718300222,
					"content": "那就拜託英雄了，真是太感謝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300223,
					"content": "為什麼不拜託千岩軍去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300224
					]
				},
				{
					"id": 718300224,
					"content": "他們不分日夜守著工地，已經夠累了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300225
					],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300225,
					"content": "這件事就拜託您了，英雄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "王平安"
				},
				{
					"id": 718300210,
					"content": "我記得這周圍不太安全…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718300211
					]
				},
				{
					"id": 718300211,
					"content": "您是說，這周圍有魔物和盜寶團吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718300212
					],
					"speakerTitle": "王平安"
				}
			]
		},
