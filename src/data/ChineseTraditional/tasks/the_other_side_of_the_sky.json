			"dialogs": [
				{
					"id": 751360401,
					"content": "唉呀，沒想到好不容易到了天蛇船還是要到處找石頭，我還以為會是更緊張刺激的冒險呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360402
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360402,
					"content": "總之找火石的事情就拜託你們了，有什麼需要，隨時跟我說就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
