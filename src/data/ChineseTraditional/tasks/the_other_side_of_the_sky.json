						"pointId": 10150
					}
				]
			},
			"dialogs": [
				{
					"id": 751360301,
					"content": "#總算找到你們了，{NICKNAME}、派蒙還有{REALNAME[ID(2)|SHOWHOST(true)]}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360302
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360302,
					"content": "嘿嘿，玻娜，看到妳沒事真是太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360303,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360304
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360304,
					"content": "嗯？小派蒙該不會是在擔心我吧？不過放心啦，我可是花羽會的王牌冒險家，我的命很大的，才不會輕易丟掉啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360305
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360305,
					"content": "妳沒事就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360306
					]
				},
				{
					"id": 751360306,
					"content": "#嘿嘿，說不定也是託{F#妳}{M#你}的福哦。自從遇到{F#妳}{M#你}之後運氣都很好欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360307
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360307,
					"content": "剛才在雲海裡和你們失散之後，我就被吹落到了一塊浮石上面暈過去了。也不知道過了多久，醒來之後就到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360308
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360308,
					"content": "妳怎麼到這裡來的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360309
					]
				},
				{
					"id": 751360309,
					"content": "這個嘛，在雲海里和你們失散之後，我就被吹到一塊浮石上面暈過去了。也不知道過了多久，醒來之後就到這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360310
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360310,
					"content": "醒來之後我把這裡全都跑遍了，但還是一直沒找到你們，我還以為…不過果然你們的命也很大哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360311
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360311,
					"content": "哇，剛剛還想問妳是怎麼到這上面來的，明明都是互不相連的浮島，該不會是用飛的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360312,
					"content": "嘿嘿，這個之後再說，總之這裡就是我們要找的天蛇船了，可以說是大成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360313
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360313,
					"content": "唔…但是看這裡的樣子，感覺也不像傳說裡那樣到處都是寶藏啊…該不會是有人來過，把這裡的寶藏都搬光了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360314,
					"content": "那我覺得那些傳說中藏在天蛇船裡的寶藏，根本八成就是部族的敘事人編造出來的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360315
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360315,
					"content": "啊？不會吧，要是那樣的話我們豈不是白來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360316,
					"content": "不過就算財寶的事情是假的，但我們要找的「回還之玉」也不能說就一定不存在吧？還不能現在就放棄希望啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360317
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360317,
					"content": "而且，你們看那上面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360318
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360318,
					"content": "裡面看起來有什麼東西對吧？你們剛才在統律之心裡的大球中找到了火磷石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360319
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360319,
					"content": "以冒險家的經驗來說，依此類推，那裡面說不定就是我們要找的「回還之玉」喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360320
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360320,
					"content": "既然這樣的話，我們就想辦法上去把它敲碎就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360321,
					"content": "就交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360322
					]
				},
				{
					"id": 751360322,
					"content": "喂喂，才沒有你們想的那麼簡單！我剛才就已經試過了，那不是用蠻力就敲得開的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360323
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360323,
					"content": "總覺得沒這麼簡單。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360324
					]
				},
				{
					"id": 751360324,
					"content": "對啊，那似乎不是用蠻力就敲得開的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360325
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360325,
					"content": "根據我作為冒險家的經驗，就像我們之前拿到火磷石的時候一樣，附近一定是有什麼機關才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360326
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360326,
					"content": "說到機關，就是我們眼前這個了吧？和之前見過的源火祭壇一模一樣耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360327
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360327,
					"content": "真是巧了…不對，這不是巧合，一定是什麼線索吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360328
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360328,
					"content": "如果說是線索的話，那我們試試看用火磷石…呃，就算是這樣，我們也已經沒有火磷石可用了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360329,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}不是正背著一個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360330
					]
				},
				{
					"id": 751360330,
					"content": "對哦，我們剛才在路上剛好撿到了這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360331,
					"content": "這就對了，你們知道「冒險家的鑰匙」原則嗎？正所謂在冒險最後關頭需要的重要道具，一定會在冒險的開頭拿到哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360332
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360332,
					"content": "在亂七八糟講什麼…而且這中間也隔得太近了吧！雖然這個東西是真的和火磷石很像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360333,
					"content": "不如說除了一直在劈里啪啦冒火之外，根本就是一模一樣嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360334
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360334,
					"content": "真的耶，不愧是小派蒙，妳不說的話我都完全沒發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360335
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360335,
					"content": "那是妳的問題吧！真是的，照妳說的，我們只要收集那種石頭就好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360336,
					"content": "嗯，如果是這種火石的話，這艘天蛇船上一共有四顆，譬如對面的浮島上面應該就有一顆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360337
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360337,
					"content": "哦哦…等等，玻娜妳怎麼會知道這麼清楚啊？簡直就像之前來過這裡一樣，就算用冒險家的經驗也沒辦法解釋了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360338,
					"content": "呃…該怎麼說，算是冒險家的預感？不知道為什麼，一看到這個祭壇我就知道該怎麼用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360339
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360339,
					"content": "而且在遇到你們之前我也有四處調查哦。作為優秀的冒險家，充分的事先調查可是必須的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360340
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360340,
					"content": "原來是這樣，學到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360341
					]
				},
				{
					"id": 751360341,
					"content": "#哇，{NICKNAME}，{F#妳}{M#你}不會這麼久以來一直都是直接硬來的吧…能打還真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360342
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360342,
					"content": "幸好我都是硬來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360343
					]
				},
				{
					"id": 751360343,
					"content": "#哇，{NICKNAME}，{F#妳}{M#你}另當別論啦，另當別論！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360344
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360344,
					"content": "#話說回來，我們要怎麼樣才能過去呢？就算是{NICKNAME}感覺也有點困難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360345,
					"content": "嘿嘿，之前小派蒙不是問我是怎麼到這上面來的嗎？現在就是讓妳看看我的發現的時候囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360346
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360346,
					"content": "怎麼樣？只要利用這個機關，就可以在浮島間自由通行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360347
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360347,
					"content": "找火石的事情就拜託你們了，要是你們去了別的浮島過不來的話，告訴我一聲就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360348
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751360348,
					"content": "#好吧，既然這樣那拿火石的工作就拜託{REALNAME[ID(2)|SHOWHOST(true)]}了，我們一起出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360349,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
		},
