					"派蒙"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-306.442,
							1277.558,
							9810.905
						],
						"pointId": 8612
					}
				]
			},
			"dialogs": [
				{
					"id": 751360101,
					"content": "呼…總算是活、活下來了，腳踏實地的感覺真好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360102,
					"content": "妳明明一直是飄著的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360103
					]
				},
				{
					"id": 751360103,
					"content": "喂，就算是這樣說，飄在地面上和在天空上被大風颳得亂轉還是不同等級的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360104,
					"content": "這裡看起來也不太結實。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360105
					]
				},
				{
					"id": 751360105,
					"content": "#欸？{F#妳}{M#你}不要嚇我啦。等下要是真的掉下去的話，我一個人才拉不動{F#妳}{M#你}跟{REALNAME[ID(2)|SHOWHOST(true)]}兩個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360106,
					"content": "嘰咕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360107
					],
					"speakerTitle": "「綠松石」"
				},
				{
					"id": 751360107,
					"content": "那就是天蛇船嗎？我們成功啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360108,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360109
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751360109,
					"content": "雖然與其說船還不如說是個大毛線球！整個纏在一起，看起來是真的滿像蛇的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360110,
					"content": "我們想辦法到那邊去吧。至少那裡看起來比這邊安全一點…唔，也不知道玻娜去哪裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360111,
					"content": "雖然她說自己的飛行經驗很豐富啦，不過還是有點擔心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360112,
					"content": "只要風向沒錯的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360113
					]
				},
				{
					"id": 751360113,
					"content": "#唔…{F#妳}{M#你}說的也有道理，如果風向沒錯的話，她一定也會落到這附近的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360114,
					"content": "留在這裡也沒有答案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751360115
					]
				},
				{
					"id": 751360115,
					"content": "#唔…{F#妳}{M#你}說的也有道理，在這裡擔心也沒有什麼用處，說不定她現在已經在天蛇船上面等我們了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751360116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751360116,
					"content": "那我們就先過去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
