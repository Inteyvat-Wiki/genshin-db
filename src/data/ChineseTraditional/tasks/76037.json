			},
			"dialogs": [
				{
					"id": 760370101,
					"content": "四個懸賞目標的資訊都在公告板上，問我也可以，但賞金沒多少可以商量的空間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370107,
						760370102,
						760370108
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760370107,
					"content": "提供解決了懸賞目標的證據。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 760370102,
					"content": "關於懸賞目標…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370103
					]
				},
				{
					"id": 760370103,
					"content": "目前有四個目標，但只有三個有線索。被人指控詐欺而被懸賞的須彌占卜師希丁芭，常在<color=#00E1FFFF>南邊港口附近</color>出沒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370104
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760370104,
					"content": "發狂的稻妻海亂鬼，途經<color=#00E1FFFF>空寂走廊</color>的往來經商者中，已有多人死在他的手上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370105
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760370105,
					"content": "走私危險物品的幫派成員，據說盤據在<color=#00E1FFFF>城鎮北面海灘的營地</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370106
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760370106,
					"content": "窮凶惡極的海盜，「裂顎」哈爾克，暫時沒有線索，或許潛伏在什麼地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760370108,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370109
					]
				},
				{
					"id": 760370109,
					"content": "那就不送了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "勒塞克"
				}
			]
		},
