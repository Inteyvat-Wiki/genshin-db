			"dialogs": [
				{
					"id": 760370401,
					"content": "（關於海亂鬼…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760370402
					]
				},
				{
					"id": 760370402,
					"content": "「懸賞目標：權八，稻妻人，海亂鬼的裝扮。懸賞原因：無差別襲擊往來經商者，已有數人不幸身亡。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760370403
					],
					"speakerTitle": "懸賞"
				},
				{
					"id": 760370403,
					"content": "「目標曾被目睹在<color=#00E1FFFF>空寂走廊</color>附近出沒。討伐並證明其已死之人，商會將予以重賞。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "懸賞"
				}
			]
		},
