						],
						"pointId": 7417
					}
				]
			},
			"dialogs": [
				{
					"id": 716666001,
					"content": "喲！各位好呀，最近玩得還開心嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666002
					],
					"speakerTitle": "「超級強者的隨行廚神」"
				},
				{
					"id": 716666002,
					"content": "香菱、鍋巴！你們終於來了！放牛{RUBY#[D]「真劍鬥蟲大鬼王」}的現在正在興頭上呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716666003,
					"content": "總算等到這一天了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666004
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716666004,
					"content": "鍋巴兄！就讓你見識一下，經歷了「荒瀧甲光烈烈大修行」後，本大爺…哦不，是我和「赤紅一杵」的實力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666005
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716666005,
					"content": "然後，就要麻煩你教教我了——如何跟「赤紅一杵」，還有「水晶島梆梆旋風」這些甲殼生物交流！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666006
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716666006,
					"content": "等到我成為了鬥蟲界最有名望的強者，我就要…在荒瀧派的鬼兜蟲本陣，為你打造一座特大特威風的雕像！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666007
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716666007,
					"content": "♪~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666008
					],
					"speakerTitle": "「天崩石裂超級強者」"
				},
				{
					"id": 716666008,
					"content": "什麼！這就是是鍋巴兄自備的鬼兜蟲嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666009
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716666009,
					"content": "質感看起來很不同尋常！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716666010,
					"content": "不像是正常鬼兜蟲的甲殼，而是某種堅韌的木質材料，難道牠穿上了裝甲？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666011
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 716666011,
					"content": "姥姥聽說了「荒瀧甲光烈烈鬥蟲大修行」的前因後果，覺得「鍋巴可能收徒」這件事很有意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666012
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 716666012,
					"content": "正好，有位朋友給她製作了許多園藝機關，用來打理花壇裡的霓裳花，名為「花羽葉月神機」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666013
					],
					"speakerTitle": "煙緋"
				},
				{
					"id": 716666013,
					"content": "「花羽葉月神機」可以化形為各種動物，自然地融入環境。松鼠、蝴蝶、團雀都不在話下，當然也包括鬼兜蟲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666014
					],
					"speakerTitle": "「超級強者的隨行廚神」"
				},
				{
					"id": 716666014,
					"content": "所以，師父給了鍋巴一個「花羽葉月神機」，讓它化形為鬼兜蟲的模樣，且來與你一戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666015
					],
					"speakerTitle": "「超級強者的隨行廚神」"
				},
				{
					"id": 716666015,
					"content": "真的只是園藝機關而已嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716666016,
					"content": "香菱的師父是萍姥姥…萍姥姥的朋友…萍姥姥的朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666017,
						716666018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716666017,
					"content": "是誰來著？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716666019
					]
				},
				{
					"id": 716666019,
					"content": "機關怎麼可能模擬鬼兜蟲的特點嘛！難道鍋巴兄是想試探我們的實力，所以故意用了很弱的傢伙來對陣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666020
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716666020,
					"content": "還是小心為妙，鬼王，我好像感知不到那隻機關鬼兜蟲的氣息…或者說，深不見底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666021
					],
					"speakerTitle": "「花角玉將」"
				},
				{
					"id": 716666021,
					"content": "機關又不是活的，你感覺不到氣勢很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666022
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716666022,
					"content": "呃咳…雖說鍋巴兄的確強得厲害，但強者也需要趁手的武器和有默契的夥伴。我和「赤紅一杵」的組合也不是吃素的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666023
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716666023,
					"content": "開始對決吧，我會用接下來的一招一式，向鍋巴兄好好證明我們的實力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716666024
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716666024,
					"content": "♪——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「天崩石裂超級強者」"
				},
				{
					"id": 716666018,
					"content": "先別劇透…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						716666019
					]
				}
