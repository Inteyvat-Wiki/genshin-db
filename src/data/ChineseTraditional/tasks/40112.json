			"dialogs": [
				{
					"id": 401120601,
					"content": "哇，是大沙漠——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120602
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120602,
					"content": "親眼看到還是很震撼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120603
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120603,
					"content": "確實是相當壯觀的景象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120604
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120604,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120605
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120605,
					"content": "怎麼了，覺得不舒服嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120606
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120606,
					"content": "不，只是一瞬間有點難適應，這裡的空氣有點乾燥…相較於蒙德…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120607
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120607,
					"content": "這裡可不像能住人的樣子，如果真的有個秘境…附近似乎也沒看到入口？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120608
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120608,
					"content": "難道是因為我、我剛才唸錯了…應該不至於吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120609
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120609,
					"content": "沒有錯哦！絕對不是因為柯萊姐姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120610
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120610,
					"content": "之前可莉也不小心唸錯，但還是到了化城郭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120611
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120611,
					"content": "按照之前的經驗，目的地不會有錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120612
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120612,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120613
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120613,
					"content": "那是不是藏在附近沙丘下面了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120614,
					"content": "…沒有辦法，只能先尋找一下看看了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120615
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120615,
					"content": "眾人分頭尋找，可惜找了許久還是沒有頭緒。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401120616
					]
				},
				{
					"id": 401120616,
					"content": "好累，而且好渴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120617,
					"content": "不應該。難道「神奇邀請函」突然出了問題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120618
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120618,
					"content": "咦？怎麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120619
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120619,
					"content": "啊，不會是被可莉弄壞了吧？但可莉什麼都沒做呀…嘟嘟可可以作證！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120620
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120620,
					"content": "一定也不是可莉的問題，妳看，這張紙都沒有皺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120621
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120621,
					"content": "如果那個秘境在附近…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120622
					]
				},
				{
					"id": 401120622,
					"content": "#嗯？難道榮譽騎士{M#哥哥}{F#姐姐}有辦法了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120623
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120623,
					"content": "與其讓我們找秘境！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120624
					]
				},
				{
					"id": 401120624,
					"content": "#啊，我明白了{NICKNAME}的意思了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120625,
					"content": "嗯，不如讓秘境來找我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120626
					]
				},
				{
					"id": 401120626,
					"content": "這倒是個有趣的思路，既然「神奇邀請函」就在這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120627
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120627,
					"content": "送出邀請函的秘境，與它也必然有關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120628
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120628,
					"content": "噢，那可莉明白了。其實可莉也有絕招的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120629
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120629,
					"content": "什麼樣的絕招？我們能學嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120630
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120630,
					"content": "可以的！媽媽提過，需要幫助的時候就這樣大聲喊出來——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120631
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120631,
					"content": "「神奇邀請函」、「神奇邀請函」，可莉需要幫助！想想辦法吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120632
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120632,
					"content": "#快看！{NICKNAME}，有什麼東西真的飛過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120633,
					"content": "欸？那是…一個瓶子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120634
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120634,
					"content": "很有效呢，我打算把這招學起來備用。妳也學一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120635
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120635,
					"content": "不要！太不適合我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120636
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120636,
					"content": "瓶子在須彌也算是經常出現在傳說中的東西…難道這個就是秘境的入口嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120637
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120637,
					"content": "秘境在瓶子裡，聽起來也是在璃月發生過的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120638
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120638,
					"content": "#真是這樣的話，那進去的方法就只有一種了！來吧，伸出{F#妳}{M#你}的手{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120639
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120639,
					"content": "（觸碰瓶子…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
