					}
				]
			},
			"dialogs": [
				{
					"id": 401120301,
					"content": "嚇、嚇死我了，我還以為要被送到奇怪的地方去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120302,
					"content": "欸嘿嘿，可莉不是故意的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120303
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120303,
					"content": "我知道啦，不過，沒想到那個「神奇邀請函」居然真的有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120304,
					"content": "有意思，真的在一瞬間抵達了須彌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120305
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120305,
					"content": "原來這就是媽媽的朋友住的地方，有好多好大的花，還有好多會跳的蘑菇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120306
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120306,
					"content": "須彌還有好多神奇的東西呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120307,
					"content": "比如，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120308,
						401120310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120308,
					"content": "身上長蘑菇的豬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120309
					]
				},
				{
					"id": 401120309,
					"content": "對對，第一次看到的時候我都嚇了一跳呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120312,
					"content": "可莉，這種會跳的蘑菇叫蕈獸，看起來可愛，但在妳靠近的時候，它會故意用帽子把妳撞倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120313
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120313,
					"content": "真的嗎？那可莉也要用帽子和它對撞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120314
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120314,
					"content": "可莉有腦袋上的帽子和衣服後面的帽子，一定能贏的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120315
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120315,
					"content": "可莉，強！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120316
					]
				},
				{
					"id": 401120316,
					"content": "用帽子至少比用炸彈好多了…不過還好我們跟可莉熟，可以勸阻她用炸彈，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120317,
					"content": "嗯！可莉會注意，不用炸彈炸周圍的東西！呃…盡量不用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120318
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120318,
					"content": "真的？好體貼，小可莉長大了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120319,
					"content": "嗯！是很懂事的火花騎士可莉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120320
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120320,
					"content": "那麼懂事的火花騎士就跟我們去化城郭見一位名叫提納里的朋友吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120310,
					"content": "銀色的飛天飄浮靈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120311
					]
				},
				{
					"id": 401120311,
					"content": "#咦，有這樣的東西嗎…喂！{F#妳}{M#你}不會是在說我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120312
					],
					"speakerTitle": "派蒙"
				}
			]
		},
