			"dialogs": [
				{
					"id": 401120501,
					"content": "穿著那樣衣服的人，確實之前聽其他巡林員提到過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120502
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120502,
					"content": "是嘛…那看來我的推斷並沒有錯…咦？那是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120503
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120503,
					"content": "#{NICKNAME}、派蒙、凱亞先生，還有可莉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120504
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120504,
					"content": "柯萊姐姐，好久不見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120505
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120505,
					"content": "柯萊，還有優菈！妳們怎麼在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120506,
					"content": "呃，我主要是在問優菈啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120507,
					"content": "沒想到出趟遠門還能遇到外出度假的游擊小隊隊長，真巧啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120508
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120508,
					"content": "…怎麼都來了？嘖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120509
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120509,
					"content": "她剛剛是不是露出了很為難的表情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120510,
						401120511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120510,
					"content": "不要在意這些。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120512
					]
				},
				{
					"id": 401120512,
					"content": "啊對對，好的好的！我們走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120513
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120513,
					"content": "#就算要照顧我的感受也不必這樣，{F#妳}{M#你}們搞錯了，我不會覺得尷尬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120514
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120514,
					"content": "妳最好是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120515
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120515,
					"content": "那太好了！妳會不遠千里跑到須彌來，原因一定很有趣吧，快跟我們分享分享。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120516
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120516,
					"content": "（一副看熱鬧不嫌事大的表情呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120517
					]
				},
				{
					"id": 401120517,
					"content": "真要說的話也有點複雜…概括一下吧，我在找勞倫斯家的一位表親。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120518
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120518,
					"content": "不久前，那位勞倫斯突然失蹤，從他家裡調查的結果來看，他似乎是想前來須彌尋找復興家族的辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120519
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120519,
					"content": "大老遠跑到別的國家去找辦法？他難道打算在須彌讀書？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120520,
					"content": "那實在有點迂迴了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120521
					]
				},
				{
					"id": 401120521,
					"content": "那倒不會，他早就不在基礎教育的年齡段了。至於深造…以我對他的認識，他多半也沒那個心思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120522
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120522,
					"content": "他在乎家族名譽多過其他。復興這個想法不能說有錯，但我不清楚他的執念到了哪種地步，會不會惹出什麼麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120523
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120523,
					"content": "於情於理，都不能放著他不管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120524
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120524,
					"content": "如果這事屬實，妳的那位表親在勞倫斯家也算是了不起的行動派了。一路從蒙德到須彌可不容易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120525
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120525,
					"content": "而且竟然還勞煩我為他的人身安危操心，哼，好大的膽子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120526
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120526,
					"content": "嘿嘿，優菈人真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120527,
					"content": "對！優菈姐姐上次還帶了月亮派給可莉吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120528
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120528,
					"content": "咳！畢竟是同一個家族的人…總之我會找到他，在確保安全的前提下帶他回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120529,
						401120530
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120529,
					"content": "辛苦妳了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120531
					]
				},
				{
					"id": 401120531,
					"content": "你們呢？你們怎麼會突然出現在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120532
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120532,
					"content": "向優菈和柯萊說明了來意…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401120533
					]
				},
				{
					"id": 401120533,
					"content": "難辦了…提納里師父最近在禪那園出席講座…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120534
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120534,
					"content": "不過我倒是能幫上一點忙。這封邀請函裡模糊提到的位置是在沙漠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120535
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120535,
					"content": "沙漠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120536
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120536,
					"content": "咦？難道媽媽的朋友住在沙漠裡面？唔…沙漠阿姨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120537
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120537,
					"content": "我記得曾經聽賽諾大人說過，沙漠的這塊區域流傳著奇怪的傳說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120538
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120538,
					"content": "說是有一個能夠實現所有願望的秘境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120539
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120539,
					"content": "啊不對，應該是叫賽諾先生！嗯，叫先生就好了，我得習慣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120540
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120540,
					"content": "實現所有願望的秘境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120541
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120541,
					"content": "真的嗎，真的有那種地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120542
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120542,
					"content": "如果是幾年前我應該會信，還好現在見識多了點，我會保持適當的懷疑態度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120543
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120543,
					"content": "#怪不得…傳說未必是真的，但他很可能去碰運氣了。{NICKNAME}，如果你們將要前往那個區域的話，讓我同行吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120544
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120544,
					"content": "表親的書櫃裡收藏了很多與須彌沙漠有關的傳說。這麼推測…他很有可能就是奔著那個秘境去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120545
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 401120545,
					"content": "我也一起去，可以嗎？我、我覺得你們會需要我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120546
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120546,
					"content": "大家在須彌一定需要嚮導，我想我能夠勝任！勇敢伸出援手，才是一位巡林員該做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120547
					],
					"speakerTitle": "柯萊"
				},
				{
					"id": 401120547,
					"content": "柯萊的能力我們放心。這樣一來隊伍又壯大了呢，可莉隊長，妳覺得如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120548
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120548,
					"content": "可莉覺得超——棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120549
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120549,
					"content": "故事書裡說，「一個人的快樂只有一小點，一群人的快樂就會變很多」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120550
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120550,
					"content": "媽媽的朋友見到那麼多哥哥姐姐和我一起去，一定會非常開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120551
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120551,
					"content": "沒錯！那麼，事不宜遲，就再使用一次「神奇邀請函」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120552,
					"content": "可莉拿出了「神奇邀請函」，大家一起讀出了上面的目的地——",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 401120530,
					"content": "真不容易。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120531
					]
				},
				{
					"id": 401120511,
					"content": "大家一起喝個下午茶吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120512
					]
				}
			]
		},
		{
