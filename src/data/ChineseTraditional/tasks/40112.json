					}
				]
			},
			"dialogs": [
				{
					"id": 401120201,
					"content": "琴團長，我們來啦——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120202,
					"content": "#兩位好，等{F#妳}{M#你}們多時了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120203
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120203,
					"content": "哇，出現在這裡的人比我想像中要多…竟然還有小可莉和凱亞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120204,
					"content": "#原來是小派蒙和榮譽騎士{M#哥哥}{F#姐姐}！好久不見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120205
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120205,
					"content": "#哎喲，沒想到是{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120206
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120206,
					"content": "真是讓人措手不及…該怎麼說，兩位的出現總是會帶來意想不到的驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120207
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120207,
					"content": "嘿嘿，一想到能見老朋友，興奮得忘記敲門了，沒嚇到你們吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120208,
					"content": "等等，你們不會是在聊什麼我們不該聽到的機密吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120209,
						401120211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120209,
					"content": "沒有獵鹿人的訂單？是我走錯了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120210
					]
				},
				{
					"id": 401120210,
					"content": "好狡猾，居然一下子就裝成了獵鹿人餐館的外送員！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120213,
					"content": "#許久不見，派蒙和{NICKNAME}的關係還是一如既往地融洽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120214
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120214,
					"content": "請別擔心，我們沒在談什麼機密話題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120215
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120215,
					"content": "#不如說，我們正好談到{F#妳}{M#你}們幾位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120216
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120216,
					"content": "就讓事件的主角親自講講吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120217
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120217,
					"content": "嗯嗯，可莉來說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120218
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120218,
					"content": "前幾天，可莉在禁閉室裡讀《嘟嘟可故事集》的時候…從窗戶外飛來了一封信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120219
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120219,
					"content": "一封信，信要怎麼飛呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120220,
					"content": "像小鳥一樣，拍著翅膀就進來了，它還會說話呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120221
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120221,
					"content": "說了一些…嗯，說了一些聽不懂的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120222
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120222,
					"content": "聽不懂的話？我猜應該是提到什麼禁閉室之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120223
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120223,
					"content": "呃…凱亞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120224
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120224,
					"content": "適當的教育指導很有意義哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120225
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120225,
					"content": "嗚，好吧，那封信開頭說的是：「可莉呀，妳怎麼又在禁閉室了…」對不起嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120226
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120226,
					"content": "上面還寫著：「最近媽媽有事要忙，沒辦法帶妳出去玩，不過媽媽有個朋友很歡迎妳，邀請妳到她家去作客哦！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120227
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120227,
					"content": "啊，是艾莉絲女士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120228,
					"content": "這不是滿好的嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120229
					]
				},
				{
					"id": 401120229,
					"content": "按理說應該不會有什麼危險，但要去的地方…實在是有點遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120230
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120230,
					"content": "嗯，信上說，媽媽朋友的家在須彌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120231
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120231,
					"content": "騎士團當然不可能同意可莉一個人去須彌，但可莉出門拜訪那位朋友的意願也很堅定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120232
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120232,
					"content": "對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120233
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120233,
					"content": "於是我們想，誰能一起出遠門呢？假如有一位可靠的英雄，甚至一度拯救過蒙德——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120234
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120234,
					"content": "喔！原來就是因為這個把我們叫過來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120235,
					"content": "#非常抱歉{NICKNAME}，但可莉跟{F#妳}{M#你}關係比較好…我們認為{F#妳}{M#你}確實是適合的人選。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120236
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120236,
					"content": "#那當然沒關係啦，{NICKNAME}，我們就接下這個委託吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120237,
					"content": "#嘿嘿，榮譽騎士{M#哥哥}{F#姐姐}…可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120238,
						401120239
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120238,
					"content": "當然可以啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120240
					]
				},
				{
					"id": 401120240,
					"content": "#耶！！有榮譽騎士{M#哥哥}{F#姐姐}在，去哪裡都不怕啦！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120241
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120241,
					"content": "#妳看，我說{M#他}{F#她}肯定會答應的，那一切就交給可靠的{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120242
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120242,
					"content": "凱亞…你也一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120243
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120243,
					"content": "之前累積的文件已經被你偷偷完成了吧…你也該找個機會好好放鬆一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120244
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120244,
					"content": "哎呀，被妳發現了嗎？那我也沒什麼拒絕的理由了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120245
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120245,
					"content": "有凱亞在的話，我們應付麻煩就方便多啦！可是須彌很遠，要走好多路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120246,
					"content": "沒關係，媽媽的信裡還有「神奇邀請函」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120247
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120247,
					"content": "信上說，只要大家一起大聲喊出想去的地方，就能像眨個眼睛一樣，咻地到達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120248
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120248,
					"content": "哇，還有這麼方便的道具！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120249
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120249,
					"content": "但只有三次機會，所以不能亂用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120250
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120250,
					"content": "算上去和回來要用的兩次，不是明明還多出了一次嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120251
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120251,
					"content": "這麼神奇的東西，更應該省著點用吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120252
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120252,
					"content": "畢竟現在還不知道目的地的具體位置，去到那裡之後，會不會遇上別的風險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120253
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120253,
					"content": "#我有個想法，{NICKNAME}，憑{F#妳}{M#你}的人脈，應該認識熟悉須彌地理的當地朋友吧？我們傳送到對方身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120254
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120254,
					"content": "這樣，一來可以試試這「神奇邀請函」的功能，二來也能找人擔當嚮導。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120255
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120255,
					"content": "好像有那麼點道理。反正也還多一次機會，不用白不用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120256
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120256,
					"content": "那麼…聰明的派蒙，有什麼提案嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120257
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120257,
					"content": "嘿嘿…要說到熟悉須彌，又能擔當嚮導的話…聽起來很像是巡林員…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120258
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120258,
					"content": "嗯，說到巡林員經常出沒的地方，那就是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120259
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120259,
					"content": "化城郭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120260
					]
				},
				{
					"id": 401120260,
					"content": "說不定我們還能讓提納里幫忙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120261
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120261,
					"content": "好，那麼我們就先去化城郭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120262
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120262,
					"content": "#嗯，可莉去哪裡玩都很開心！而且，可莉相信凱亞哥哥和榮譽騎士{M#哥哥}{F#姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120263
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120263,
					"content": "代理團長大人，那我們就出發了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120264
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120264,
					"content": "聽憑風引，祝你們旅途愉快。以及，可莉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120265
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401120265,
					"content": "可莉知道了，一定會注意安全的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120266
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120266,
					"content": "好！出發啦，我們要去——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120267
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120267,
					"content": "化城郭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120268
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120268,
					"content": "化城郭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120269
					],
					"speakerTitle": "凱亞"
				},
				{
					"id": 401120269,
					"content": "化城郭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120270
					]
				},
				{
					"id": 401120270,
					"content": "化成鴿——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120271
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 401120271,
					"content": "欸什麼，什麼鴿，等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401120239,
					"content": "樂意之至。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120240
					]
				},
				{
					"id": 401120211,
					"content": "派蒙，我路帶到了，就先走了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401120212
					]
				},
				{
					"id": 401120212,
					"content": "#這路還需要{F#妳}{M#你}帶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401120213
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
