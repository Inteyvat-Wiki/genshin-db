			"dialogs": [
				{
					"id": 762130101,
					"content": "咦？這邊的房間好像被書給堵住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762130102,
					"content": "尋書嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130103
					],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130103,
					"content": "嗯…也不是要找書啦，只是稍微有點好奇這裡面是什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762130104,
					"content": "好像可以從旁邊繞進去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130105
					]
				},
				{
					"id": 762130105,
					"content": "那便進不去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130106
					],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130106,
					"content": "且移書，且移書。若不如是，則不曾到也。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130107,
						762130109
					],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130107,
					"content": "聽不懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130108
					]
				},
				{
					"id": 762130108,
					"content": "且移書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130109,
					"content": "如何是移書？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130110
					]
				},
				{
					"id": 762130110,
					"content": "書不在便是移書。老僧只管看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762130111
					],
					"speakerTitle": "叢沈"
				},
				{
					"id": 762130111,
					"content": "那我用小右試試看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762130112
					]
				},
				{
					"id": 762130112,
					"content": "直去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叢沈"
				}
			]
		},
