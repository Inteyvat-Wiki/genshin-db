			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"嘉毅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411260101,
					"content": "唉，這可怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260102
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260102,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260103
					]
				},
				{
					"id": 411260103,
					"content": "#那些從天而降的隕石，{F#妳}{M#你}應該也看見了吧，城裡雖然沒有被波及，但野外已經一團亂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260104
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260104,
					"content": "而且，隕石不僅堵塞著道路，周圍的魔物似乎也被隕石影響，變得格外暴躁危險，到處襲擊行人和商隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260105
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260105,
					"content": "總務司幾乎把能派出去的千岩軍全都派出去了，但璃月太大了，我們也只能保障幾條主幹道和村莊的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260106
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260106,
					"content": "我本來已經向上面申請要去輕策莊駐防的，但不知道為什麼，我還是被分到這裡待命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260107
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260107,
					"content": "#旅行者，{F#妳}{M#你}能幫我把這封信帶去輕策莊，給一個叫小六的女孩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260108
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260108,
					"content": "她是我女兒，我本來答應她會回去陪她幾天，但這次事出緊急，我肯定又回不去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260109,
						411260111
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260109,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260110
					]
				},
				{
					"id": 411260110,
					"content": "#那就拜託{F#妳}{M#你}了，唉，這到底是什麼情況啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260115,
					"content": "不過，據從那邊換防回來的人說，輕策莊附近好像也聚集了不少魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260116
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260116,
					"content": "#那個…不好意思，看{F#妳}{M#你}的裝束，{F#妳}{M#你}是冒險家，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260117
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260117,
					"content": "#在送信的時候，{F#妳}{M#你}能不能先去輕策莊周圍看看，把一些邊角裡的魔物給掃清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260118
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260118,
					"content": "千岩軍一般是駐防在大路和要道上…如果這些零星的魔物悄悄進了輕策莊，那可就糟糕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260119,
						411260121
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260119,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260120
					]
				},
				{
					"id": 411260120,
					"content": "#謝謝，那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260121,
					"content": "這算是額外委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260122
					]
				},
				{
					"id": 411260122,
					"content": "呃，這個…放心吧，我肯定會準備好合適的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260123
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260123,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260111,
					"content": "這也是沒辦法的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260112
					]
				},
				{
					"id": 411260112,
					"content": "我知道，但是…唉，我真是奇了怪了，每次我想請假的時候，總是會出點事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260113
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260113,
					"content": "這也太巧了，到底是什麼情況啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260114
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 411260114,
					"content": "#那就拜託{F#妳}{M#你}了，把這封信送去輕策莊給小六吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260115
					],
					"speakerTitle": "嘉毅"
				}
			]
		},
