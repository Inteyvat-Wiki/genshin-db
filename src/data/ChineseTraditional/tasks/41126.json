			"dialogs": [
				{
					"id": 411260801,
					"content": "在這裡，應該就能看清楚隕石了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260802
					],
					"speakerTitle": "小六"
				},
				{
					"id": 411260802,
					"content": "有封信給妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260803
					]
				},
				{
					"id": 411260803,
					"content": "爸爸寫給我的信…唔，我大概知道裡面寫了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260804
					],
					"speakerTitle": "小六"
				},
				{
					"id": 411260804,
					"content": "肯定是說，他又因為工作沒法回來陪我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260805
					],
					"speakerTitle": "小六"
				},
				{
					"id": 411260805,
					"content": "那些千岩軍叔叔過來的時候，我還以為爸爸也會一起來呢，結果他還是沒來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260806
					],
					"speakerTitle": "小六"
				},
				{
					"id": 411260806,
					"content": "不過也好，那麼多大石頭從天上掉下來，要是爸爸在野外的話，說不定會有危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260807,
						411260809
					],
					"speakerTitle": "小六"
				},
				{
					"id": 411260807,
					"content": "妳害怕嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260808
					]
				},
				{
					"id": 411260808,
					"content": "嗯…有一點點，但是有千岩軍叔叔在這裡呢，不會有問題的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260811
					],
					"speakerTitle": "小六"
				},
				{
					"id": 411260811,
					"content": "#對了，那{F#妳}{M#你}幫我把這封信送給爸爸吧，他肯定擔心我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260812
					],
					"speakerTitle": "小六"
				},
				{
					"id": 411260812,
					"content": "唉…真奇怪，爸爸每次說要請假回來陪我的時候，都會出點事讓他沒法回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小六"
				},
				{
					"id": 411260809,
					"content": "別去野外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411260810
					]
				},
				{
					"id": 411260810,
					"content": "我知道，那些千岩軍叔叔不知道說了多少遍了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411260811
					],
					"speakerTitle": "小六"
				}
			]
