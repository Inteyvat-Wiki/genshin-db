			"dialogs": [
				{
					"id": 200010901,
					"content": "#旅行者，謝謝{F#妳}{M#你}趕走了這些傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010902
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200010902,
					"content": "#多虧{F#妳}{M#你}來了，呃…但路障豎在這，我還是走不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010903
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200010903,
					"content": "這麼下去，我辛辛苦苦摘下來的水果都要爛掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010904
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200010904,
					"content": "#{F#妳}{M#你}能幫我把這個路障給處理掉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200010905,
						200010906
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200010905,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010907
					]
				},
				{
					"id": 200010907,
					"content": "#哈哈，那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200010906,
					"content": "還有別的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200010908
					]
				},
				{
					"id": 200010908,
					"content": "#啊…啊？我說，幫人幫到底嘛，無論如何，我只能指望{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昆恩"
				}
			]
		},
