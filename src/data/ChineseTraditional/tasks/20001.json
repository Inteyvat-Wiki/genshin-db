			"dialogs": [
				{
					"id": 200011001,
					"content": "太感謝了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011002
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200011002,
					"content": "我就是想來這摘點水果，帶回城裡賣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011003
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200011003,
					"content": "沒想到卻被這個路障攔住，然後那群傢伙就跳出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011004
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200011004,
					"content": "我這就回蒙德城去了，記得來城裡光顧我的生意啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200011005
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200011005,
					"content": "這些就當做謝禮吧，我的水果都是這麼新鮮的…所以貝雅特麗奇那傢伙，才會一直過來纏著我買。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "昆恩"
				}
			]
