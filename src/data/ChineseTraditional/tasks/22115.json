			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150201,
					"content": "嘿…這群怪物，真是討人嫌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150202
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150202,
					"content": "我就是來給我的新小說取個材，材沒取到，倒是撞上了這群怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150203
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150203,
					"content": "謝謝你們了啊，要不是你們，我還真不知道怎麼脫身呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150204
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150204,
					"content": "若心奶奶很擔心你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150205
					]
				},
				{
					"id": 221150205,
					"content": "擔心我？我有什麼可擔心的，我都這麼大人了，知道怎麼照顧自己。呃…這麼點意外，其實我自己也能處理，就是有點費勁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150206
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150206,
					"content": "不過，還是謝謝你們了…我就快點回去吧，免得她老人家又嘮叨個不停。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
				}
			]
		},
		{
			"id": 2211503,
			"completionStepIds": [
				2211505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211505",
							"2"
