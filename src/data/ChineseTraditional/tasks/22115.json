				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150601,
					"content": "唉，這個小常啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150602
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150602,
					"content": "常九爺已經回來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150603
					]
				},
				{
					"id": 221150603,
					"content": "哦，我已經看見他了，真是辛苦你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150604
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150604,
					"content": "他和小時候一樣，就愛到處闖禍，總是說自己長大了，其實就是長不大…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150605
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150605,
					"content": "好啦，你們也別太操心了，這是小常他自己的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150606
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150606,
					"content": "謝謝你們幫我跑了一趟。這是給你們的，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150607
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150607,
					"content": "你們還有自己的事吧，趕緊去忙吧。別和小常似的，為了所謂的「出人頭地」、「刮目相看」，耽誤了正視自己的機會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150608
					],
					"speakerTitle": "若心"
				},
				{
					"id": 221150608,
					"content": "唉…凡人不是仙，人生在世…何苦來哉，何苦來哉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
