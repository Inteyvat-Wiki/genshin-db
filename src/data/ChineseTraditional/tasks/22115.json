				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150301,
					"content": "就這麼走掉了啊…我們也回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 221150302,
					"content": "咦？地上好像有什麼東西…是常九爺掉的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 221150303,
					"content": "唔…先過去撿起來看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 2211505,
			"completionStepIds": [
				2211507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2211507",
							"2"
						],
						"stepId": 2211507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"常九爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221150501,
					"content": "唉，到底怎麼才能寫出一本好小說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150502
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150502,
					"content": "這些是你掉的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150503
					]
				},
				{
					"id": 221150503,
					"content": "什麼？哦…這確實是我的，這些都是我寫的廢稿，本來就是丟到河裡去銷毀的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150504
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150504,
					"content": "你們還把它們撿回來…這上面的字都看不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150505
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150505,
					"content": "這上面寫了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221150506
					]
				},
				{
					"id": 221150506,
					"content": "#哦，是我寫給我妹子的故事，這幾章都是廢稿了。{F#妳}{M#你}是不知道啊，小時候，這丫頭天天纏著我，要我給她講故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150507
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150507,
					"content": "可惜啊，我之前沒時間寫，就寫了個開頭給她，讓她自己先看，準備以後有時間再慢慢寫給她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150508
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150508,
					"content": "但是那丫頭突然有一天就不見了，我怎麼找都找不著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150509
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150509,
					"content": "哼，準是她家裡人不喜歡我，不想她和我在一起，就找了個機會，不聲不響地帶著她，整家從輕策莊裡搬走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150510
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150510,
					"content": "他們就瞧好吧，等我發了家，一準讓他們刮目相看！然後，我就把我寫給我妹子的那本書，給弄到全世界去賣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150511
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150511,
					"content": "這樣，無論她們現在住在哪，都能知道我老常已經混出了頭！不是當年那個我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150512
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150512,
					"content": "然後…我就一定能和她再見面…不過在那之前，我還是先得把這本書給寫完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221150513
					],
					"speakerTitle": "常九爺"
				},
				{
					"id": 221150513,
					"content": "…對不住，說著說著就嘮叨起來了。唉，我還是再想想怎麼寫好我的那本書吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "常九爺"
				}
			]
		},
		{
			"id": 2211506,
			"completionStepIds": [
				2211508
			],
