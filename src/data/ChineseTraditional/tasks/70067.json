			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊斯托利亞"
				],
				"points": [
					{
						"sceneId": 103,
						"position": [
							709.66,
							175.639,
							423.58
						],
						"pointId": 162
					},
					{
						"sceneId": 103,
						"position": [
							712.414,
							175.657,
							423.585
						],
						"pointId": 163
					},
					{
						"sceneId": 103,
						"position": [
							712.293,
							175.641,
							422.247
						],
						"pointId": 164
					}
				]
			},
			"dialogs": [
				{
					"id": 700670201,
					"content": "伊斯托利亞，你來了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670202,
					"content": "嗯，「沙上樓閣」的諸位回到主殿了，所以我就一路小跑來這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670203
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670203,
					"content": "彩特琳德，妳找回妳丟失的東西了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670204
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670204,
					"content": "勞您掛心，我已經找回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670205
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670205,
					"content": "那太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670206
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670206,
					"content": "#說來，{F#妳}{M#你}們知道梅蘭塔和尼西里塔名字的意思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670207
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670207,
					"content": "我先來，不知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670208,
					"content": "是，「憂鬱」和「虛無」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670209
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670209,
					"content": "妳看的書很多啊。我能和妳成為比和妳姐姐更要好的朋友，因為興趣一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670210
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670210,
					"content": "是的，姐姐是外向的戶外派。不過我不識字的時候，她唸過很多故事給我聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670211
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670211,
					"content": "這樣的人是怎麼被憂鬱纏上的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670212
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670212,
					"content": "當然，我說的是病理上的憂鬱，不是上面那位俯瞰著我們苦難的守望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670213
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670213,
					"content": "她…這些都和你說了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670214
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670214,
					"content": "她和我說了之後我驚得下巴都掉了。如今的人們居然敢在空之神殿離地升天的遺址上修療養院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670215
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670215,
					"content": "妳知道嗎？最早，人們認為憂鬱是生理上的病變。憂鬱這個詞的來源是黑之膽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670216
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670216,
					"content": "但隨後，憂鬱被認為是心因的心理疾病。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670217
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670217,
					"content": "正確的認知總是需要發展的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670218,
					"content": "但現在，人們再度發現了憂鬱的真實——它其實也是病變哦。藥物和陪伴都是不可或缺的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670219
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670219,
					"content": "而我那個時代早就知道了這一切，都是天使們直接告訴我們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670220
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670220,
					"content": "天使與後世風神的詩歌可以治療憂鬱，不代表普通人不痛不癢的安慰也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670221
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670221,
					"content": "您想說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670222
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670222,
					"content": "這個事情是秘密哦——我要小聲一點說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670223
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670223,
					"content": "為什麼執掌著天空與空間力量的偉大神明，會用虛無與憂鬱作為造物的名字呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670224
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670224,
					"content": "據說是因為她缺乏同理能力。她無所不能，卻對真正的無意徒勞以及人心之病束手無策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670225
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670225,
					"content": "所以她用這兩個她最不擅長對付的事物作為造物的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670226
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670226,
					"content": "好像可以理解她，不可戰勝的宿敵名字聽起來會很帥很強大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670227,
					"content": "#派蒙的宿敵叫作「沒摩拉」和「肚子餓」和「沒有{NICKNAME}」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670228,
					"content": "聽起來很弱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700670229
					]
				},
				{
					"id": 700670229,
					"content": "我跟不上您上千年的智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670230
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670230,
					"content": "哈哈哈，哪有什麼智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670231
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670231,
					"content": "我祈禱我有勇氣可以放棄這一切，去換再活一次的機會——妳明白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670232
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670232,
					"content": "如果妳需要幫助，請來找我吧。哪怕是，聊聊妳姐姐的故事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670233
					],
					"speakerTitle": "伊斯托利亞"
				},
				{
					"id": 700670233,
					"content": "我…我會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彩特琳德"
				}
			]
		},
