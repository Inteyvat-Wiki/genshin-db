			"dialogs": [
				{
					"id": 700670101,
					"content": "這裡是哪裡啊？這應該算是結束了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670102,
					"content": "沒錯，結束了。大家都恢復了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670103
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670103,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670104
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700670104,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670105
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670105,
					"content": "怎麼了，咬著嘴巴，看到我太感動了忍不住要哭了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670106
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670106,
					"content": "呵呵哈哈哈哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670107
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700670107,
					"content": "哈哈哈哈…柯…莎瑪，妳不能，不能笑啊。這不、這不是露餡了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670108
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670108,
					"content": "你們笑得再大聲，我也只是有一點尷尬而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670109
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670109,
					"content": "愛是命運，死也亦然。愛與死沒什麼好笑的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670110
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670110,
					"content": "不笑了不笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670111
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670111,
					"content": "對了，彩特琳德呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670112,
					"content": "我也不知道。我就在門外，被復原的大家也是，他們剛才還在擁抱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670113
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670113,
					"content": "#我叫小斯卡帕別抱了，趕緊帶著人回主殿區域去，然後我就一個人過來找{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670114
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670114,
					"content": "照理說，大家應該都在這附近吧？那她應該不會很遠才對啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670115
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670115,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670116
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670116,
					"content": "是一個紫水晶胸針。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670117,
					"content": "是我手提箱裡丟失的物品之一，是姐姐的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670118
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670118,
					"content": "原來是這樣啊。太好了，這樣就找到一件了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670119,
					"content": "應該是被當作現在這個時代的展品文物被放到這裡來了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670120
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670120,
					"content": "其實，我思考墓誌銘寫什麼，也是因為妳姐姐問了一句。那個墓誌銘我才沒想幾千年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670121
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670121,
					"content": "在這裡不會死嗎？那豈不是沒辦法寫那種精妙絕倫的墓誌銘了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670122
					],
					"speakerTitle": "勞姆希爾妲"
				},
				{
					"id": 700670122,
					"content": "照我以前的地位，大概是可以埋進祭司們的公墓，與銀白枝條同眠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670123
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670123,
					"content": "這是很高的榮譽，但的確沒地方寫墓誌銘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670124
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670124,
					"content": "那我絕對不要這種榮譽——因為我已經寫好墓誌銘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670125
					],
					"speakerTitle": "勞姆希爾妲"
				},
				{
					"id": 700670125,
					"content": "那就是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670126
					],
					"speakerTitle": "勞姆希爾妲"
				},
				{
					"id": 700670126,
					"content": "#實在太謝謝{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670127
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670127,
					"content": "那你的赤王硬幣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670128,
					"content": "妳就這麼惦記啊？等我唸誦完一萬次對赤王大人的懺罪經文就給妳吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670129
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670129,
					"content": "這個人聽柯莎瑪說赤王隕落的事情之後，又怒又哭——「妳騙我！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670137
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670137,
					"content": "「你騙我！騙子！不可能！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670138
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670138,
					"content": "講道理，我覺得比我墓誌銘好笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670130
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700670130,
					"content": "算了算了，這麼不情不願的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670131,
					"content": "哼，這個時候我們就要說，我們只是來幫彩特琳德找丟失的東西的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670132,
					"content": "幫你們只是順手哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670133,
					"content": "#…謝謝{F#妳}{M#你}們，派蒙、{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670134
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670134,
					"content": "唉，沒有沒有。畢竟也是因為我們妳才被捲進這些怪事裡的。我們只是在彌補過失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670135,
					"content": "毫不掩飾地差別對待啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670136
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670136,
					"content": "我的感謝是真心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "彩特琳德"
				}
			]
		},
		{
			"id": 7006702,
