				]
			},
			"dialogs": [
				{
					"id": 700671501,
					"content": "維尼皮！小右！還有勞姆希爾妲和陌生的朋友！謝謝你們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671502
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700671502,
					"content": "…我是她的妹妹，彩特琳德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671503
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700671503,
					"content": "這樣啊，妳們長得真像，都是小美人啊。我叫柯莎瑪。我來自樹…啊，我想說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671504
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700671504,
					"content": "這樣啊，妳們長得真像，都是小美人啊。我叫柯莎瑪，我來自大慈樹王的時代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671505
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700671505,
					"content": "草神大人還沒變小的時代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671506
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700671506,
					"content": "#維尼皮和柯莎瑪介紹了{F#妳}{M#你}們一行人，並且還說了維特魯威的悲慘遭遇…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700671507
					]
				},
				{
					"id": 700671507,
					"content": "以及他想了數千年或許上萬年的墓誌銘。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700671508
					]
				},
				{
					"id": 700671508,
					"content": "笑死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671509
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700671509,
					"content": "我沒和妳說過，妳什麼都不知道啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671510
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700671510,
					"content": "可能很難瞞住，以後的日子裡我看到維特魯威就會想笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671511
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700671511,
					"content": "好了，閒話不多說了。我們一路走來，好像也沒漏什麼地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671512
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700671512,
					"content": "還有其他人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671513
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700671513,
					"content": "恐怕已經沒有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671514
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700671514,
					"content": "那解除這個區域沙化的方法呢？妳有什麼頭緒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671515
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700671515,
					"content": "我們之前的探索並沒有什麼收穫，畢竟「沙上樓閣」的各位也不精通密儀與科學。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671516
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700671516,
					"content": "所以還是只有眾所皆知的第一種方法，也就是打敗「蛾摩拉的處罰者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671517
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700671517,
					"content": "#不必擔心，我們有雷穆利亞副軍團長級戰鬥力的{NICKNAME}在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671518
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700671518,
					"content": "啊，又升級了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671519
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700671519,
					"content": "但是「蛾摩拉的處罰者」隱藏了身形，我們找不到它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671520
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700671520,
					"content": "這倒是個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671521
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700671521,
					"content": "既然好不容易把你們救出來了，還是先逃離這裡，回到主殿裡吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700671522,
					"content": "那裡還有伊斯托利亞和喬瑟夫斯。他們看起來懂很多的樣子，說不定有辦法呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700671523,
					"content": "哦，伊斯托利亞沒事啊。那太好了，他可是資歷最老的人了，而且很好學。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671524
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700671524,
					"content": "他在見聞、歷史、文化方面，大概能算是全世界最博學的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671525
					],
					"speakerTitle": "柯莎瑪"
				},
				{
					"id": 700671525,
					"content": "那趕緊走吧。早點回去問清楚，早點把維特魯威和大家救出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維尼皮"
				}
			]
		}
	]
}