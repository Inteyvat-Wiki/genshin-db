					}
				]
			},
			"dialogs": [
				{
					"id": 700671001,
					"content": "維尼皮！你還活著，太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671002
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700671002,
					"content": "當然我知道這裡死不掉。我的意思是你沒有變成沙子，這實在太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671003
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700671003,
					"content": "總之，你懂我的意思就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671004
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700671004,
					"content": "我懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671005
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700671005,
					"content": "#還有{F#妳}{M#你}們幾位和小右，十分感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671006
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700671006,
					"content": "我什麼都沒做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671007
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700671007,
					"content": "#維尼皮向維特魯威介紹了一下{F#妳}{M#你}們，並且說了剛才發生的事情…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700671008
					]
				},
				{
					"id": 700671008,
					"content": "竟然是標準首席百夫長以上的實力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671009
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700671009,
					"content": "連我也開始對你戰鬥力的分級最終會是什麼結果有興趣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700671010,
					"content": "對吧對吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700671011
					]
				},
				{
					"id": 700671011,
					"content": "#那既然這樣，我來帶{F#妳}{M#你}們去找其他人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671012
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700671012,
					"content": "畢竟維尼皮只提供了赤王時代的建築紋樣與裝飾風格，這附近的大結構和路線是我負責的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700671013
					],
					"speakerTitle": "維特魯威"
				},
				{
					"id": 700671013,
					"content": "沒錯，雖然看起來像是鍍金時代的建築，其實它集結了所有人的知識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維尼皮"
				}
			]
		},
		{
			"id": 7006715,
			"completionStepIds": [
