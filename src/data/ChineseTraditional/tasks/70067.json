					},
					{
						"sceneId": 103,
						"position": [
							782.193,
							169.734,
							356.146
						],
						"pointId": 5
					},
					{
						"sceneId": 103,
						"position": [
							780.915,
							169.73,
							357.299
						],
						"pointId": 99
					}
				]
			},
			"dialogs": [
				{
					"id": 700670401,
					"content": "#{F#妳}{M#你}們…沒見過啊。這個時候還會有新人上來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670402
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670402,
					"content": "#不過小右和{F#妳}{M#你}們在一起，應該是救兵吧？我叫維尼皮，來自赤王的神軀仍在的時代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670403
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670403,
					"content": "#我叫派蒙，這位是{NICKNAME}，還有一位是彩特琳德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670404,
					"content": "我們，大概算是最近時代的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670405,
					"content": "彩特琳德…妳是不是有個姐姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670406
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670406,
					"content": "你也認識我姐姐嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670407
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670407,
					"content": "那是自然。來到了這裡，所有人和所有人都是朋友，不論之前的賢愚貴賤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670408
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670408,
					"content": "我之前只是修築赤王陵的建築工，不過是個無足輕重小人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670409
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670409,
					"content": "那天我在沙漠裡行路，突然就被提選了上來丟進無想之間裡待了…可能不到一百年？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670410
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670410,
					"content": "出來之後發現這裡都是些古代人物，有的比赤王還要古老，但是我們一樣可以交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670411
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670411,
					"content": "後來此處神明的姐妹和我說沒有提選沙漠的建築，要我憑藉記憶復原。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670412
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670412,
					"content": "還是靠大家幫忙才把這一片區域修出來的。可是如今，妳看看這斷垣殘壁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670413
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670413,
					"content": "說到這個，我想問了。外面那些人形沙雕，是你們赤王時代的…呃…藝術嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670414,
					"content": "比如用沙做成人，來警醒人物質身軀與生命之無常？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670415
					],
					"speakerTitle": "彩特琳德"
				},
				{
					"id": 700670415,
					"content": "…妳和妳姐姐真是完全不像。妳一定和其他人一樣很喜歡看書吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670416
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670416,
					"content": "那些是人，被懲罰而化成沙的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670417
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670417,
					"content": "嗚啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670418,
					"content": "妳放心，大家都還活著。這裡不存在「死亡」。只要解決了這裡的問題，他們都會復原的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670419
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670419,
					"content": "哦對了，之前聽到你說誰救了你，你就把赤王親賞的錢幣給他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670420,
					"content": "一定是值不少錢的文物吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670421,
					"content": "哈哈，不給！那是我的幸運符！還是我在地上生活的唯一紀念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670422
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670422,
					"content": "哼，既然這麼重要，我們就大發慈悲不收你這個報酬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670423,
					"content": "不對，好像它找上門來了！我們閒聊太久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670424
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670424,
					"content": "#所以現在也不是說閒話的時候了，{F#妳}{M#你}有沒有雷穆利亞入門級百夫長實力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670425
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670425,
					"content": "又聽到這個說法了，所以究竟是什麼標準啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
