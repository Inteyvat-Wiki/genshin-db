			"dialogs": [
				{
					"id": 700670701,
					"content": "呼，真厲害啊。至少頂級百夫長級實力起跳了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670702
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670702,
					"content": "你們赤王時代沒有自己的體系嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700670703
					]
				},
				{
					"id": 700670703,
					"content": "主要是因為大方廣書閣那些有文化素養的人看過的書多，排出來的戰鬥力更有理有據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670704
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670704,
					"content": "有文化就是好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670705
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670705,
					"content": "#{F#妳}{M#你}知道嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670706
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670706,
					"content": "伊黎耶手下的騎士們平均能打三個標準雷穆利亞百夫長，但是都比伊黎耶低半級。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670707
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670707,
					"content": "鱷之王手下的梅德佳都不算精銳部隊，但是擅長處理魔獸。實力大概在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670708
					],
					"speakerTitle": "維尼皮"
				},
				{
					"id": 700670708,
					"content": "好了好了，我們還是先去救你的朋友們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700670709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700670709,
					"content": "可是我還想聽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700670710
					]
				},
				{
					"id": 700670710,
					"content": "之後再說啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
