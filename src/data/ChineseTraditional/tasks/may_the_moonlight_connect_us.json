			"dialogs": [
				{
					"id": 760310301,
					"content": "…這樣就好。辛苦你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310302
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760310302,
					"content": "月光聯繫著你我，不論日夜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310303
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760310303,
					"content": "…嗯？這和我以前聽到的不一樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310304
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310304,
					"content": "啊！那個人走了！我們上吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310305,
					"content": "菈烏瑪大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310306
					],
					"speakerTitle": "馬西捷"
				},
				{
					"id": 760310306,
					"content": "怎麼沒完了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310308
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760310308,
					"content": "…辛苦了。我稍微出去一會，馬上回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310309
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760310309,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310310
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760310310,
					"content": "幾位，周圍沒人了，可以出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310311
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760310311,
					"content": "原來妳早就發現我們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310312,
					"content": "我怎麼可能遺漏「庫塔{RUBY#[S]月之少女}爾」散發出的月矩力呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310313
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760310313,
					"content": "#{F#妳}{M#你}們…怎麼一直跟著我？簡直像在…視察我的工作一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310314
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760310314,
					"content": "呃…抱…抱歉，只是有件事需要找妳，但一直找不到時機…沒給妳不必要的壓力就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310315,
					"content": "這樣嗎…知道了，我會處理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310316
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760310316,
					"content": "老實說，看完妳一天的工作，我都有點不好意思再給你添麻煩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310317
