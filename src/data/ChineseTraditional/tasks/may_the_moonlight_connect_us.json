			"dialogs": [
				{
					"id": 760310201,
					"content": "…沒錯，之後再讓庫涅貢妲拿些水果過去，這兩天她需要靜養。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310202
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760310202,
					"content": "哦，菈烏瑪好像在忙欸。我們稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310203,
					"content": "很久以前我就知道，「詠月使」是「霜月之子」中非常重要的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310204
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310204,
					"content": "我有時會覺得，她們說不定比真正的「神明」還辛苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310205,
					"content": "哦！她閒下來了！快趁現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310206,
					"content": "菈烏瑪大人，這邊有些工事需要您安排一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310207
					],
					"speakerTitle": "瓦娜莫"
				},
				{
					"id": 760310207,
					"content": "好，我馬上來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310208
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 760310208,
					"content": "又被叫走了嗎！真的一點空隙都不給欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310209,
					"content": "我們小心地跟上去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
