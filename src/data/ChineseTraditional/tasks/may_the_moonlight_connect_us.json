			"dialogs": [
				{
					"id": 760310101,
					"content": "哥倫比婭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310102,
					"content": "呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310103,
					"content": "#啊！她在睡午覺呢，{NICKNAME}，不然我們待會再來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310104,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310105
					],
					"speakerTitle": "帔髦獾"
				},
				{
					"id": 760310105,
					"content": "欸！妳別去呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310106,
					"content": "…唔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310107,
					"content": "痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310108,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310109
					],
					"speakerTitle": "帔髦獾"
				},
				{
					"id": 760310109,
					"content": "#腳滑了一下？唔，沒關係，我沒事。嗯？{F#妳}{M#你}們也來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310110,
					"content": "原來「月神」是會被動物撞痛的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310111,
					"content": "動物們散發的月矩力中沒有「惡意」，我就沒在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310112,
					"content": "你怎麼了？為什麼這麼害怕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310113
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310113,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310114
					],
					"speakerTitle": "帔髦獾"
				},
				{
					"id": 760310114,
					"content": "嗯，嗯嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310115,
					"content": "原來妳也能聽懂牠們說了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310116,
					"content": "挪德卡萊是月亮升起的地方，只要是在月矩力下長大的動物，都可以算是「月神的眷屬」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310117,
					"content": "那牠說了什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310118,
					"content": "牠生活的地方出現了魔物，本來想找菈烏瑪…但一路被魔物追到了這附近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310119,
					"content": "哦，怪不得會那麼害怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760310120,
					"content": "要送牠回去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760310121
					]
				},
				{
					"id": 760310121,
					"content": "嗯，送去菈烏瑪那裡好了。她會處理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760310122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760310122,
					"content": "好呀，看來又要出門一趟了呢。不過這次去的是「霜月之子」那邊，妳可真的要躲好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
