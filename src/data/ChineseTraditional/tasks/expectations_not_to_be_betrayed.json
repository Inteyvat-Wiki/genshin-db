			"trigger": {
				"objectNames": [
					"阿創",
					"天目十五"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120110301,
					"content": "阿創，天目先生！我來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110302
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110302,
					"content": "啊，是宵宮啊，要是我沒猜錯，是煙花材料的事對吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110303
					],
					"speakerTitle": "阿創"
				},
				{
					"id": 120110303,
					"content": "看來大家都知道宵宮妳在煙花會前會很忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110304,
					"content": "很抱歉，但能不能稍等一會，正好武器的訂單也堆了好多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110305
					],
					"speakerTitle": "阿創"
				},
				{
					"id": 120110305,
					"content": "這個沒關係，啊，不對，也不是完全沒關係…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110306
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110306,
					"content": "這樣吧！你需要幫手嗎？只要做完這些武器的訂單，就可以幫我加工礦石了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110307
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110307,
					"content": "這…得看師父是不是答應…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110308
					],
					"speakerTitle": "阿創"
				},
				{
					"id": 120110308,
					"content": "沒關係的吧，天目先生！你也知道的，「長野原煙花會」馬上要開始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110309
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110309,
					"content": "我到現在還有好多人的煙花沒有做，如果沒做好的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110310
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110310,
					"content": "還是這麼吵鬧啊，小丫頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110311
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110311,
					"content": "「天目流」的鍛造，講究耐心與全力以赴，倘若內心急躁，一定會反映在鍛出的刀劍之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110312
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110312,
					"content": "有人在旁邊等待與催促，只會亂了阿創的心神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110313
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110313,
					"content": "但、但是，這是很特殊的情況，「長野原煙花會」就在眼前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110314
					],
					"speakerTitle": "阿創"
				},
				{
					"id": 120110314,
					"content": "所以，礦石交給我吧，我來加工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110315
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110315,
					"content": "欸？！師父要親自動手嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110316
					],
					"speakerTitle": "阿創"
				},
				{
					"id": 120110316,
					"content": "不要大驚小怪，這是唯一的辦法了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110317
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110317,
					"content": "謝謝天目先生願意幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110318
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110318,
					"content": "不客氣，「長野原煙花會」是很重要的事，我也明白。再加上以前龍之介很關照我的生意，我沒有理由不幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110319
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110319,
					"content": "不過宵宮啊，以後還是要更有計畫，不要每次都搞得那麼匆忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110320
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110320,
					"content": "嘿嘿，我盡量。以後我會準備更多材料來應付突發情況的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110321
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110321,
					"content": "唉，不過對妳來說，就算準備再多，也不一定夠用吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110322
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110322,
					"content": "總之，等我一會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110323
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110323,
					"content": "不愧是天目先生，看這顆粒的形狀和粗細…不知道該怎麼形容，太漂亮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110324
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110324,
					"content": "就算很久沒有看你拿工具了，手藝還是這麼精湛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110325
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110325,
					"content": "那當然，從小學到大的東西，想忘掉都難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110326
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110326,
					"content": "很久以前，天目流就和「長野原煙花會」在合作了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110327,
					"content": "那時候是我的師父和龍之介的父親。雖然人換了一代又一代，但煙花要的東西，都差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110328
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110328,
					"content": "阿創，以後就輪到你做出這樣的東西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110329
					],
					"speakerTitle": "天目十五"
				},
				{
					"id": 120110329,
					"content": "知道了，知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110330
					],
					"speakerTitle": "阿創"
				},
				{
					"id": 120110330,
					"content": "哈哈哈，那就不多打擾你們啦，別忘了去看煙花喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110331
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110331,
					"content": "#好了，{NICKNAME}，我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110332
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110332,
					"content": "現在耕一可能還沒有回來，我們先過去等他好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
