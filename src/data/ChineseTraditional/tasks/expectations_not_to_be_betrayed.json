			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"耕一"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120110101,
					"content": "耕一！我來啦，怎麼樣，船的事情還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110102
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110102,
					"content": "嗯，還行吧，雖然免不了被人盤問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110103
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110103,
					"content": "等等，在外人面前討論這個真的沒事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110104
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110104,
					"content": "#沒關係，沒關係，{F#她}{M#他}們是我的朋友，是可以信任的！我們都是為了船的事來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110105
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110105,
					"content": "嗯，我們都是一條船上的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110106,
					"content": "請多指教。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110107
					]
				},
				{
					"id": 120110107,
					"content": "#原來如此，抱歉，不是懷疑{F#妳}{M#你}們，只是以防萬一。船我已經準備好了，但我不能大搖大擺地把它划到附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110108
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110108,
					"content": "欸？這是為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110109,
					"content": "因為鎖國令嘛，天領奉行現在對船過分敏感，就連很小的小船都要盤問用途，很麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110110
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110110,
					"content": "我明白，真的很抱歉，把你捲進來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110111
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110111,
					"content": "哈哈，客氣什麼，妳願意找我幫忙，我高興還來不及呢。這次又麻煩妳們家做煙花了，這艘船就算是我的謝禮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110112
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110112,
					"content": "#那我這就去把船弄過來，{F#妳}{M#你}們稍微等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110113
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110113,
					"content": "嗯，謝謝你！如果你順路的話，就去我家拿煙花吧，都是按紙條上的紀錄做的，非常完美，分毫不差。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110114
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110114,
					"content": "好嘞。正好煙花會很快就要開始了，也給妳的新朋友們見識見識吧，這可是稻妻的特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110115
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110115,
					"content": "#本來就是這麼打算的。哎，要不然，乾脆你跟{F#她}{M#他}們講講你的過去，就是你第一次來我們家訂做煙花的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110116
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110116,
					"content": "這個就說來話長了，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110117
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110117,
					"content": "啊！要不然，我先把船弄到附近再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110118
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110118,
					"content": "喔，對對對，哎呀，不小心聊開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110119
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110119,
					"content": "妳先去忙吧，宵宮，等會兒還在這裡見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110120
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110120,
					"content": "嘿嘿，幸好有他提醒，不然又要因為聊天耽誤事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110121
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110121,
					"content": "前幾天一直在趕工做煙花，沒什麼時間和別人聊天，都快憋死我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110122
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110122,
					"content": "老爹雖然很喜歡聽我說話，但因為耳朵不好嘛，很難給出一些讓人驚喜的反應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110123
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110123,
					"content": "——又扯遠了，我想說的是，趁耕一去準備船的時間，我們可以去找找看煙花的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110124
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110124,
					"content": "#不只是要幫{F#妳}{M#你}們做，還要幫找「大貉妖」的孩子們和朔次郎做，缺很多材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110125
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110125,
					"content": "真的麻煩的話，不用為我們費心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110126
					]
				},
				{
					"id": 120110126,
					"content": "那怎麼行呢，不用在意我。其實每年的煙花會都是這樣，會接到很多中途插進來的訂單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110127
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110127,
					"content": "會放煙花的人，都是為了紀念某件事。這種紀念錯過了說不定就沒機會了，所以就算再忙，也要全部答應下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110128
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110128,
					"content": "所以，妳是想說，妳很享受這件事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110129,
					"content": "享受是很享受啦，生在煙花世家，好像從小就迷戀了這種「砰」地炸出光來的感覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110130
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110130,
					"content": "但其實我想說的還是，不用擔心我，沒問題的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110131,
						120110132
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110131,
					"content": "原來重點在這裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110133
					]
				},
				{
					"id": 120110133,
					"content": "不好意思不好意思，只是和煙花一樣，感興趣的話題也是稍縱即逝的東西，一定要在有興致的時候說個痛快，不留遺憾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110134
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110134,
					"content": "接下來跟我去城裡轉兩圈吧，我打算去找熟人碰碰運氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110132,
					"content": "附加了好多資訊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110133
					]
				}
			]
		},
		{
			"id": 1201102,
			"completionStepIds": [
				1201102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201102",
							"2"
						],
						"stepId": 1201102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"森彦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120110201,
					"content": "你好啊，森彥，這幾天的工作還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110202
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110202,
					"content": "哈哈，宵宮，我就知道，妳果然來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110203
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110203,
					"content": "寒暄就不必了，是來找煙花材料的對吧，我專門幫妳留了一袋，數量一定夠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110204
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110204,
					"content": "欸？真的嗎？為什麼你會知道？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110205
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110205,
					"content": "每次臨近煙花會，妳就會到處打聽有沒有礦石材料，有急用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110206
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110206,
					"content": "我都習慣啦，妳總是會有計畫之外的煙花要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110207
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110207,
					"content": "抱歉，每次都麻煩你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110208
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110208,
					"content": "看妳說這什麼話，就算手上的生意不做了，妳提的要求我都不能拒絕啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110209
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110209,
					"content": "這邊的兩位，難道就是這次的委託人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110210,
						120110211
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110210,
					"content": "你好，幫大忙了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110212
					]
				},
				{
					"id": 120110212,
					"content": "哈哈，小事小事，用不著客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110213
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110213,
					"content": "之前我和我孩子吵架的時候，還是宵宮出面安慰他的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110214
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110214,
					"content": "我真是不擅長和他打交道，要不是宵宮，他說不定會離家出走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110215
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110215,
					"content": "不會的，他是個心思很細膩的孩子，很在乎你的感受，只是…他也不知道要怎麼跟你表達。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110216
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110216,
					"content": "如果你的表情不要那麼兇，他可能也不會緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110217
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110217,
					"content": "嗯，大概是我平時對他太嚴肅了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110218
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110218,
					"content": "明明和外面的人聊天，我覺得我沒什麼架子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110219
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110219,
					"content": "沒關係沒關係，人人都有不擅長的事嘛。以後要是還有類似的麻煩事，來找我就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110220
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110220,
					"content": "就算不是煙花的委託也沒關係，顧客至上嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110221
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110221,
					"content": "嘿嘿，好的好的，怪不得大家都誇妳是個好孩子，龍之介先生肯定也很欣慰吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110222
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110222,
					"content": "那礦石就儘管拿去用，摩拉就不用付了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110223
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110223,
					"content": "欸，不行不行，這絕對不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110224
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110224,
					"content": "沒關係啦，就當是我給妳的謝禮，不用客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110225
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110225,
					"content": "但人情是人情，做生意要講規矩，可不要為難我啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110226
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110226,
					"content": "有什麼關係，妳就收下吧，接下來妳還有很多其他事要忙，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110227
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110227,
					"content": "那，這樣吧，就不用付摩拉了，我記在帳簿上。以後來我這裡做煙花，都用這個抵扣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110228
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110228,
					"content": "唉呀，妳這孩子真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110229
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110229,
					"content": "行吧，這樣也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110230
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110230,
					"content": "幫我向妳老爹問個好，祝他身體健康，能一直樂樂呵呵的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110231
					],
					"speakerTitle": "森彦"
				},
				{
					"id": 120110231,
					"content": "嗯嗯，你也注意身體，別那麼拼了，當心老傷復發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110232
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110232,
					"content": "宵宮很受歡迎呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110233,
						120110237
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110233,
					"content": "像是有求必應的熱心腸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110234
					]
				},
				{
					"id": 120110234,
					"content": "以前也有人這麼說，而且真的會有人覺得我有求必應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110235
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110235,
					"content": "這時候我就會說，「喂，這不是煙花店該做的事啊！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110236
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110236,
					"content": "但是，哎呀，很多時候他們都不聽我的話。沒辦法，但也沒什麼所謂對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110240
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110240,
					"content": "總之，現在礦石材料到手了，接下來就去找人加工吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110241
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110241,
					"content": "這樣材料的問題就解決了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110237,
					"content": "煙花對稻妻人這麼重要嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110238
					]
				},
				{
					"id": 120110238,
					"content": "想要紀念什麼的時候，自然需要一些又熱鬧又漂亮的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110239
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110239,
					"content": "但我覺得，是大家的信任更重要，要是沒有客人的光顧，我家的生意就做不下去了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110240
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110211,
					"content": "給你添麻煩了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110212
					]
				}
			]
		},
		{
			"id": 1201103,
			"completionStepIds": [
				1201103
