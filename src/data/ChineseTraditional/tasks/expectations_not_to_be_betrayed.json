			},
			"dialogs": [
				{
					"id": 120110401,
					"content": "#果然他還沒回來，不過沒關係，我早就想找個機會和{F#妳}{M#你}們好好聊聊天了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110402
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110402,
					"content": "#一直都在跑這跑那的…辛苦{F#妳}{M#你}們啦。不過，這一路上還挺順利的，幸好大家都很照顧我，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110403
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110403,
					"content": "感覺一路上，好像都沒有什麼我們說話的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110404,
						120110405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110404,
					"content": "宵宮和大家的關係真的很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110406
					]
				},
				{
					"id": 120110406,
					"content": "#我也覺得冷落{F#妳}{M#你}們了，所以才想找現在這樣的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110407
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110407,
					"content": "第一次相見匆匆忙忙的，不方便坐下來聊天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110408
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110408,
					"content": "#既然{F#妳}{M#你}們是旅行者，那麼來稻妻之前，{F#妳}{M#你}們都去了哪些地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110409,
						120110414
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110409,
					"content": "自由浪漫的蒙德。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110410
					]
				},
				{
					"id": 120110410,
					"content": "真好啊，我聽說那裡幾乎沒有拘束對吧？每個人都可以按照自己的想法，快快樂樂地生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110411
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110411,
					"content": "我的老爹啊，以前收到了老顧客的禮物，是那個什麼酒莊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110412
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110412,
					"content": "「晨曦酒莊」！蒲公英酒很出名的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110413,
					"content": "對對對，就是那個。很少看到我老爹喝酒喝得那麼開心，跟我講了一晚上那酒的滋味有多好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110421
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110421,
					"content": "我聽朋友說過，有想法有意志的人才會踏上旅途，可能是為了某個風景，也可能是為了某個願望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110422
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110422,
					"content": "#{F#妳}{M#你}們又是為什麼踏上旅途，還要闖過風暴，來到我們這裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110423,
						120110425
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110423,
					"content": "要找到敵對的神明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110424
					]
				},
				{
					"id": 120110424,
					"content": "還要找到失散的親人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110427,
					"content": "因為神的原因，和家人失散了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110428
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110428,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110429
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110429,
					"content": "很難受吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110430,
						120110431
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110430,
					"content": "有時候是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110432
					]
				},
				{
					"id": 120110432,
					"content": "#我明白了，既然這樣就沒辦法了，哈哈。本來想邀請{F#妳}{M#你}留下來的，留在稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110433
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110433,
					"content": "稻妻和外面的世界很不一樣。這裡追求「永恆」，換句話說，就是風平浪靜，很少會有變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110434
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110434,
					"content": "這樣有一個好處——如果走累了的話，這裡很適合休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110435
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110435,
					"content": "#嗯…可能不太好懂，我只是擔心{F#妳}{M#你}會比較累，可能走著走著，就忘記啟程時的想法和感情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110436
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110436,
					"content": "但這也是沒辦法的事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110437,
					"content": "疲憊的時候，做事總會覺得不順手。如果太累了，就算是去玩耍，可能也高興不起來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110438
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110438,
					"content": "我的一個冒險家朋友告訴我，如果只想直奔終點，可能會浪費旅途上的機遇與感動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110439,
						120110440
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110439,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110441
					]
				},
				{
					"id": 120110441,
					"content": "#但是沒關係，我會想辦法讓{F#妳}{M#你}感覺到輕鬆，開心起來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110442
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110442,
					"content": "#{F#妳}{M#你}已經來了，就算最後還是要走，我也要讓{F#妳}{M#你}留下一個好的印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110443
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110443,
					"content": "#說不定，等{F#妳}{M#你}找到了家人，會覺得稻妻是最適合當「家」的地方呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110444,
						120110445
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110444,
					"content": "那我就列入口袋名單了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110446
					]
				},
				{
					"id": 120110446,
					"content": "#嘿嘿，要送給{F#妳}{M#你}們什麼顏色、什麼規格的煙花，我也有想法了，這裡就讓我暫且保密吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110447
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110447,
					"content": "#宵宮，我回來啦！久等了！我們去船那邊吧…還是說{F#妳}{M#你}們要再聊一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110448
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110448,
					"content": "剛剛告一段落。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110449
					]
				},
				{
					"id": 120110449,
					"content": "那好，我們走吧。不要太張揚，不過也不用顯得太鬼鬼祟祟，都容易引起懷疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110450
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110450,
					"content": "能經受住外海雷暴的船，應該很堅固吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110451
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110451,
					"content": "那是當然了，品質完全可以放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110445,
					"content": "#看{F#他}{M#她}的意見吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110446
					]
				},
				{
					"id": 120110440,
					"content": "我會注意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110441
					]
				},
				{
					"id": 120110431,
					"content": "已經慢慢習慣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110432
					]
				},
				{
					"id": 120110425,
					"content": "#要找到失散的{F#哥哥}{M#妹妹}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110426
					]
				},
				{
					"id": 120110426,
					"content": "還有向神明尋求答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110414,
					"content": "堅守契約的璃月。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110415
					]
				},
				{
					"id": 120110415,
					"content": "雖然我沒有去過璃月，但是聽北斗阿姊說，好像是個非常有意思的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110416
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110416,
					"content": "不過，好像最近出了大事對吧，他們的神突然離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110417
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110417,
					"content": "是啊，因為這個還引起了大騷動呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110418,
					"content": "不過幸好，有大家齊心協力，才阻止了毀滅性的災難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110419,
					"content": "那就好那就好，神都不在了，還有這麼多人能站出來…真是了不起的國度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110420
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110420,
					"content": "我是沒辦法想像將軍不在的稻妻啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110421
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110405,
					"content": "靜靜聽著也不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110406
					]
				}
			]
		},
		{
			"id": 1201106,
			"completionStepIds": [
				1201105
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201105",
							"2"
						],
						"stepId": 1201105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 120110601,
					"content": "這也太小了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110602,
						120110603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110602,
					"content": "堅固是堅固…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110604
					]
				},
				{
					"id": 120110604,
					"content": "沒辦法，這是我能搞定的最大最堅固的船了，用的木頭全是稻妻最好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110605
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110605,
					"content": "我明白，如果要坐這個闖進雷暴，說實話還是太危險了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110606
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110606,
					"content": "我也希望朔次郎不會用到它，這只是應急手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110607
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110607,
					"content": "不過，感覺耕一你的手藝又進步了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110608
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110608,
					"content": "哈哈，就別誇我啦，還要多虧我的兄弟們願意幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110609
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110609,
					"content": "為了不被發現，我們各自加工各自的材料，然後在晚上偷偷組裝起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110610
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110610,
					"content": "這個尺寸已經是極限了。再做大一點，絕對逃不過天領奉行的審查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110611
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110611,
					"content": "那船就暫時藏在這裡，我回去告訴朔次郎，他也需要做一些出航前的準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110612
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110612,
					"content": "我突然有點擔心，做這樣的事，你們在天領奉行的眼裡，不就是共犯了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110613,
					"content": "哈哈，那又怎麼樣，開始做這件事的時候，就有心理準備了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110614
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110614,
					"content": "我家和社奉行還算有點關係，來往很密切。要是稻妻想舉辦什麼活動，另外兩家奉行也會有委託過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110615
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110615,
					"content": "只要我檯面上客客氣氣的，不要搞得太囂張，他們通常也不會來找麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110616
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110616,
					"content": "#而且，說共犯的話，{F#妳}{M#你}們不也幫了很多忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110617
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110617,
					"content": "也是喔，感覺已經脫不了關係了…欸？欸——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110618,
						120110619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110618,
					"content": "在璃月也被千岩軍追過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110620
					]
				},
				{
					"id": 120110620,
					"content": "#原來經驗老道，還以為{F#妳}{M#你}們會有疑慮呢，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110621
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110621,
					"content": "好啦，這次真的非常謝謝你，耕一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110622
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110622,
					"content": "煙花我已經做好了，你方便的時候去我家拿就可以，順便找我老爹結算一下船的製作費。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110623
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110623,
					"content": "哎，別提什麼製作費。要是三姐看到我收了妳家的錢，肯定要罵我不懂事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110624
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110624,
					"content": "三姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110625,
					"content": "我來解釋我來解釋，這也是我老爹告訴我的，以前稻妻有個商會，人丁興旺，非常繁榮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110626
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110626,
					"content": "一起出生的孩子有十幾個，他們也是從小跟著家裡人學做生意，到處跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110627
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110627,
					"content": "大家關係都非常好，終於，到了有一天，他們都要獨自開始做生意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110628
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110628,
					"content": "那既然是做生意，難免去到天南地北，以後相見的時間就少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110629
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110629,
					"content": "對，那時候我們的大哥就提議，在分開之前，一起看場煙花吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110630
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110630,
					"content": "嘿嘿，大家都是很有志向的人，對生意都有自己的理解，留在稻妻的，慢慢就只剩下耕一一個人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110631
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110631,
					"content": "雖然很難再相聚，但只要有人回來，看煙花就少不了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110632
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110632,
					"content": "是啊，再好的朋友，分別久了難免有隔閡，但在煙花之下，一下子就能回到小時候的狀態，無話不談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110633
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110633,
					"content": "這樣的記憶，對我們來說就是永恆不變的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110634
					],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110634,
					"content": "原來是這樣，這就是宵宮之前說的「紀念」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110635,
					"content": "嗯，就是這麼一回事，所以我才不能辜負大家對煙花的期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110636
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110636,
					"content": "好啦好啦，還有朔次郎的事呢，那我們先走了，耕一，謝謝你的船！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110637
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110637,
					"content": "嗯，我也要走了。我可不想被人抓個正著啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "耕一"
				},
				{
					"id": 120110619,
					"content": "在稻妻也要當壞人了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110620
					]
				},
				{
					"id": 120110603,
					"content": "讓我想起了竺子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120110604
					]
				}
			]
		},
		{
			"id": 1201107,
			"completionStepIds": [
				1201106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201106",
							"2"
						],
						"stepId": 1201106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 120110701,
					"content": "船的問題已經解決了，位置我幫你標記在地圖上。建議你提前準備好乾糧和水，有備無患。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110702
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110702,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110703
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120110703,
					"content": "唉，好不容易回來了，真的不想再逃出去，而且只靠一艘小船就闖入外海的雷暴…凶多吉少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110704
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120110704,
					"content": "但被天領奉行抓住也是差不多的下場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110705
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110705,
					"content": "我覺得他們遲早會搜查到這裡來，時間已經不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110706
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110706,
					"content": "對不起，如果他們真的來了，我會提前逃走的，不會給妳們家添麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110707
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120110707,
					"content": "不用這麼想啦，就算出了問題，我想些辦法也是能搞定的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110708
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110708,
					"content": "但如果真的被天領奉行追到絕境，你就往船的那邊跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110709
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110709,
					"content": "嗯，我不會被他們抓住的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110710
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120110710,
					"content": "但是，唉…這最後不就變成白跑一趟了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110711
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120110711,
					"content": "你這麼想回稻妻，是有什麼事要做嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110712,
					"content": "以前我很不喜歡稻妻，就離開了這裡。但現在想想，離開不過只是在逃避責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110713
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120110713,
					"content": "我意識到這件事之後，就心神不寧，一直回想起被我扔在稻妻的人和事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110714
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120110714,
					"content": "我…算了，不說了，反正現在也晚了，本來想回來彌補心中的遺憾，卻落到了現在這般下場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110715
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120110715,
					"content": "這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110716
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110716,
					"content": "如果和我們講講的話，我們說不定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120110717,
					"content": "真是的，要是沒有什麼鎖國就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110718
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110718,
					"content": "沒關係，我們不會打擾你。在你下定決心做了斷之前，我盡量幫你再爭取點時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110719
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110719,
					"content": "天領奉行，天領奉行…只要他們不要亂搞事，就應該還有辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110720
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110720,
					"content": "喔，對了！煙花店的老顧客裡，有一對老夫妻，他們的兒子在天領奉行，好像有點地位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110721
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110721,
					"content": "去找他們，說不定能在這件事上通融一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110722
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110722,
					"content": "這，會不會反過來被舉發啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110723
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120110723,
					"content": "不會的。他們是很好的人，我知道的，沒有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110724
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110724,
					"content": "#那你再去屋子裡躲著，我和{F#她}{M#他}去去就來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110725
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110725,
					"content": "走吧，我們走，時間不等人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110726
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110726,
					"content": "不對不對，還有煙花，煙花的材料，那麼多人的訂單…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110727
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110727,
					"content": "老爹，老爹！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120110728
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120110728,
					"content": "哎呀，算了算了，老爹，我給你寫個紙條，煙花的事就交給你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		},
