	"talks": [
		{
			"id": 1201101,
			"completionStepIds": [
				1201101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201101",
							"2"
						],
						"stepId": 1201101,
						"stateName": "QUEST_STATE_UNFINISHED"
