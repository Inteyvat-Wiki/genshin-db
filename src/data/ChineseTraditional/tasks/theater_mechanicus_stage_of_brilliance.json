				"points": []
			},
			"dialogs": [
				{
					"id": 726850101,
					"content": "#{F#妳}{M#你}好啊，容彩祭的客人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850102
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850102,
					"content": "來試試全新版本的「機關棋譚」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850103,
						726850119
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850103,
					"content": "「機關棋譚」是什麼?",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850104
					]
				},
				{
					"id": 726850104,
					"content": "是一種來自璃月的桌上「遊戲」，很有意思喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850105
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850105,
					"content": "「機關棋譚」的發明者是瑞錦小姐，她給了我「海外代理」的資格，讓我在稻妻推廣這款「遊戲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850106
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850106,
					"content": "最近我一直在和瑞錦小姐書信來往，和她一起改進「機關棋譚」的玩法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850107
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850107,
					"content": "正巧，我們剛剛完成新的規劃，就收到了「光華容彩祭」即將舉辦的消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850108
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850108,
					"content": "決定參展後，過了一段時間，我聽說會有一位大人物到場，考察「機關棋譚」的商業潛力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850109
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850109,
					"content": "那我就更得加把勁了！希望大家都能喜歡有趣的「機關棋譚」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850110
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850110,
					"content": "#{F#妳}{M#你}們想體驗一下「機關棋譚·巧策之局」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850111
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850111,
					"content": "「巧策之局」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850112
					]
				},
				{
					"id": 726850112,
					"content": "簡單來說，是「機關棋譚」的最新玩法，靈感來源於璃月棋類遊戲中的「殘局」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850113
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850113,
					"content": "在「巧策之局」的棋局揭曉之時，棋盤上已經佈置了一些機關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850114
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850114,
					"content": "棋手們需要分析局勢，決定如何利用這些機關，謹慎取捨，思考取勝的對策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850115
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850115,
					"content": "相比以前的版本，「巧策之局」的節奏更快，也更考驗棋手的判斷力，相當具有挑戰性！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850116
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850116,
					"content": "那就試試看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850117
					]
				},
				{
					"id": 726850117,
					"content": "#希望「巧策之局」能為{F#妳}{M#你}帶來滿意的體驗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850118
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850118,
					"content": "遊玩「機關棋譚」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 726850119,
					"content": "又見面了，駒形小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850120
					]
				},
				{
					"id": 726850120,
					"content": "#啊呀，沒想到{F#妳}{M#你}還記得我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850121
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850121,
					"content": "#上次多虧了{F#妳}{M#你}！{F#妳}{M#你}發掘了很多奇妙的玩法，讓我意識到「機關棋譚」還有很大的改進空間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850122
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850122,
					"content": "「靈妙之局」的推廣活動結束後，我就寫信給瑞錦小姐，表達了我的看法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850123
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850123,
					"content": "沒想到瑞錦小姐的想法居然和我一樣！我果然是個合格的「海外代理」啊，嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850124
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850124,
					"content": "總之，我和瑞錦小姐多次交流後，一同推出了最新版的「機關棋譚」，就是現在這款「巧策之局」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850125
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850125,
					"content": "「巧策之局」的靈感來源於璃月棋類遊戲中的「殘局」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850126
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850126,
					"content": "在「巧策之局」的棋局揭曉之時，棋盤上已經佈置了一些機關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850127
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850127,
					"content": "棋手們需要分析局勢，決定如何利用這些機關，謹慎取捨，思考取勝的對策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850128
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850128,
					"content": "相比以前的版本，「巧策之局」的節奏更快，也更考驗棋手的判斷力，相當具有挑戰性！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850129
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850129,
					"content": "聽起來很有趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726850130
					]
				},
				{
					"id": 726850130,
					"content": "是吧是吧！我已經等不及要看客人們遊玩後的反應了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850131
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850131,
					"content": "經過一段時間的代理，我也差不多有心得了。所以我打算趁著容彩祭，讓更多人熟悉這款「遊戲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850132
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850132,
					"content": "聽說還會有大人物到場，考察「機關棋譚」的商業潛力呢！希望容彩祭能成為「機關棋譚」火爆的契機！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850133
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850133,
					"content": "怎麼樣，現在就試試「巧策之局」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726850134
					],
					"speakerTitle": "駒形"
				},
				{
					"id": 726850134,
					"content": "遊玩「機關棋譚」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
