	"talks": [
		{
			"id": 7151401,
			"completionStepIds": [
				7151401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151401",
							"2"
						],
						"stepId": 7151401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"甜甜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715140101,
					"content": "嗨嗨嗨！兩位前輩，海燈節好呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140102
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140102,
					"content": "最近玩得開心嗎？有興趣跟我來一場特別冒險嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140103
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140103,
					"content": "嗚哇，居然叫我們前輩？態度真不錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140104,
					"content": "不說最近，我們一直挺開心的啦！不過…我怎麼覺得妳有點眼熟呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140105,
					"content": "#{F#妳}{M#你}們可是冒險家協會的超級全勤王，肯定見過我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140106
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140106,
					"content": "我叫甜甜，平常總在緋雲坡附近走動，為協會招攬新人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140107
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140107,
					"content": "路過緋雲坡的人裡，十個有十個聽過我的聲音，還要加上他們抱的貓、遛的狗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140108,
						715140110
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140108,
					"content": "好像有一點印象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140109
					]
				},
				{
					"id": 715140109,
					"content": "對對對，說明我的努力被前輩們注意到了！那更要讓前輩們體驗一下我的傑作了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140112
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140112,
					"content": "話都說到這份上了，我們兩位前輩肯定要給妳面子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140113,
					"content": "請簡單介紹一下妳說的特別冒險吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140114,
					"content": "好！那我就進入正題了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140115
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140115,
					"content": "最近我在萬文集舍看到了新的小說…不對，應該說是找到了新的情報！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140116
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140116,
					"content": "我發現人們對於冒險的期望正在變高，登山和風之翼滑翔這類活動的吸引力都不如以前了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140117
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140117,
					"content": "為了讓更多人加入冒險家協會，新奇而刺激的體驗是必需品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140118
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140118,
					"content": "所以，我聯合外地的幾位宣傳員，一起花費重金，請教了幾位登山高手和煙花工匠，設計了一種全新的競速挑戰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140119
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140119,
					"content": "挑戰中佈置了很多機關，只要踩上去，就可以利用煙花和火藥爆炸的推力，一下子飛到天上，完成超厲害的加速！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140120
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140120,
					"content": "煙花？火藥？競速挑戰的過程中…把人炸到天上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140121,
						715140122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140121,
					"content": "是煙花助飛的派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140123
					]
				},
				{
					"id": 715140123,
					"content": "#{F#妳}{M#你}幹嘛這麼興奮啦？{F#妳}{M#你}也會被轟飛的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140124,
					"content": "#雖然以{F#妳}{M#你}的實力，連面前爆開的炸藥桶都不怕啦…但說不定會被炸得暈暈的喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140125,
					"content": "放心放心，爆炸是在堅韌的裝置內部發生的，我為安全措施做了重重保障，絕對沒有受傷的風險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140126
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140126,
					"content": "而且，我有和總務司正式報備，宣傳的時候多次強調，請勿擅自模仿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140127
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140127,
					"content": "還有這麼多門道？妳考慮得還挺周到嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140128,
					"content": "按照我的預期，只要玩了這個競速挑戰，哪怕是普通人，心中的冒險之魂也會被點燃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140129
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140129,
					"content": "#兩位前輩，{F#妳}{M#你}們盛名在外，如果{F#妳}{M#你}們帶頭參加這個競速挑戰，肯定能吸引很多人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140130
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140130,
					"content": "我還為挑戰準備了豐厚的獎勵，肯定能把慕名而來的人們轉化成冒險家協會的新成員！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140131,
						715140133
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140131,
					"content": "好啊好啊，煙花火藥大競速！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140132
					]
				},
				{
					"id": 715140132,
					"content": "嗯！既然還能拿到獎勵，那我們就沒有錯過它的理由！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140135,
					"content": "那就這麼說定了！事不宜遲，兩位前輩請快試試看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140136
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140136,
					"content": "#嘿嘿，這次競速挑戰的賽道還挺多的，肯定能讓{F#妳}{M#你}們玩個痛快！我也能一舉拿到好幾個月的業績，雙贏雙贏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
				},
				{
					"id": 715140133,
					"content": "好怕好怕，我和派蒙被炸飛！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140134
					]
				},
				{
					"id": 715140134,
					"content": "#噫，{F#妳}{M#你}明明在笑啦！反正甜甜小姐說過了，安全措施很完善，{F#妳}{M#你}也很想試試看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715140122,
					"content": "是火藥推進的派蒙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140123
					]
				},
				{
					"id": 715140110,
					"content": "完全沒印象…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715140111
					]
				},
				{
					"id": 715140111,
					"content": "居然沒印象？那我要用這次的傑作讓更多人記住我…不對，是招攬更多人加入協會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715140112
					],
					"speakerTitle": "甜甜"
				}
			]
		}
	]
}