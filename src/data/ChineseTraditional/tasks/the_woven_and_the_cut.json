			"dialogs": [
				{
					"id": 140220801,
					"content": "…現在怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220802
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140220802,
					"content": "再往左靠一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220803
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220803,
					"content": "…這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220804
					],
					"speakerTitle": "綺良良"
				},
				{
					"id": 140220804,
					"content": "嗯，完美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220805
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220805,
					"content": "嘿咻…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220806
					],
					"speakerTitle": "綺良良"
				},
				{
					"id": 140220806,
					"content": "哦！很適合呢！千織小姐，我能拍一張嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220807
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140220807,
					"content": "當然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220808
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220808,
					"content": "我都不知道千織姐妳還做了新招牌呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220809
					],
					"speakerTitle": "綺良良"
				},
				{
					"id": 140220809,
					"content": "時裝週前就做好了。想著等時裝秀成功之後再掛上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220810
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220810,
					"content": "想要風靡提瓦特，沒有一個自己的招牌怎麼行？在這一點上，「刺玫會」還比妳領先哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220811
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140220811,
					"content": "這麼一想的話，我們魔術團隊是不是也該考慮設計一個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220812
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140220812,
					"content": "哥哥和我的招牌圖案，分別是「怪笑帽帽貓」和「驚奇貓貓盒」。還得把佩伊加進來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220813
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140220813,
					"content": "那佩伊就是…「不笑餓餓鵝」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220814
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140220814,
					"content": "噗哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220815
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140220815,
					"content": "聽起來是需要在帽子裡塞兩隻貓和一隻企鵝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220816
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220816,
					"content": "哇，好像很暖和！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220817
					],
					"speakerTitle": "綺良良"
				},
				{
					"id": 140220817,
					"content": "畫面好擠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220818
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140220818,
					"content": "#千織小姐！我拍好了，連帶著{NICKNAME}給我的那些證據，文章明天就能登上《蒸汽鳥報》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220819
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140220819,
					"content": "謝謝妳，夏洛蒂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220820
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220820,
					"content": "沒有沒有，將真相帶給觀眾是一位記者應該做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220821
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140220821,
					"content": "以後「溫亨廷先生」的裝飾，我全都免費幫妳訂製。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220822
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220822,
					"content": "欸欸欸！真…真的可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220823
					],
					"speakerTitle": "夏洛蒂"
				},
				{
					"id": 140220823,
					"content": "當然。林尼和琳妮特也別客氣，以後有什麼想要的演出服，隨時和我說一聲就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220824
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220824,
					"content": "不是演出服也行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220825
					],
					"speakerTitle": "琳妮特"
				},
				{
					"id": 140220825,
					"content": "那就多謝千織小姐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220826
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 140220826,
					"content": "我就不要什麼好處了！妳平常多來串串門就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220827
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140220827,
					"content": "我也不需要什麼，只要千織姐以後的跨國快遞繼續指名我就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220828
					],
					"speakerTitle": "綺良良"
				},
				{
					"id": 140220828,
					"content": "哦，說到這個，綺良良妳什麼時候回去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220829
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140220829,
					"content": "欸！這個…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220830
					],
					"speakerTitle": "綺良良"
				},
				{
					"id": 140220830,
					"content": "「刺玫會」專門為妳準備了一輛車，可以讓妳坐在裡面，我們推著妳出楓丹喲！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220831
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140220831,
					"content": "那也太丟人了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220832
					],
					"speakerTitle": "綺良良"
				},
				{
					"id": 140220832,
					"content": "嘿嘿，那我們有沒有什麼好處呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220833,
					"content": "當然有，待會兒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220834
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220834,
					"content": "擾亂會場秩序、私自挪用會場燈光、公眾場合使用武器、危險演出不報備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220835
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220835,
					"content": "呃…夏沃蕾，妳聽我們說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220836
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220836,
					"content": "…要是你們看見了我所描述的那些罪人，記得來向我這個特巡隊隊長匯報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220837
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220837,
					"content": "報罪名開心嗎？嚇我一跳呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220838
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220838,
					"content": "嚇一跳的是我。會場上那齣下次能提前告訴我一聲嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220839
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220839,
					"content": "告訴妳，妳就會答應了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220840
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220840,
					"content": "不會，但至少能讓我不被嚇到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220841
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220841,
					"content": "我不是已經補償妳了嗎？灰河那處生產有害商品的黑心工坊，我人都幫妳捆好放在那裡——還不夠貼心嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220842
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220842,
					"content": "好吧，不和妳爭了。今晚我認輸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220843
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220843,
					"content": "什麼嘛，既然在這裡的大家都是朋友，不如就待會兒一起去吃一頓吧！記在「刺玫會」的帳上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220844
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140220844,
					"content": "我就免了。還有一堆手續要辦，你們玩得開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220845
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220845,
					"content": "對了，千織，我路上遇到維格爾，要我向妳帶個話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220846
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220846,
					"content": "好了好了，肯定就是些道歉什麼的，不用勞煩妳，我改天上門去嘲笑他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220847
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220847,
					"content": "妳還滿瞭解他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220848
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220848,
					"content": "這次也謝謝妳了，夏沃蕾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220849
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220849,
					"content": "應該的。另外我再說一句——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220850
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220850,
					"content": "剛才的時裝秀真是漂亮極了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220851
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 140220851,
					"content": "還用妳說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220852
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220852,
					"content": "好了好了，要參加慶功宴的朝這兒看，跟我來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220853
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140220853,
					"content": "#{NICKNAME}，派蒙，能先到風景好的地方等我一下嗎？我去和娜維婭說我們晚點到。有東西送{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220854
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220854,
					"content": "風景好的地方？哦！是那裡對吧，沒問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220855
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220855,
					"content": "嗯，我很快就來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千織"
				}
			]
		},
