			},
			"dialogs": [
				{
					"id": 140220701,
					"content": "…總算回到出口了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220702,
					"content": "#…哦？真是意外。連下面的房間都困不住{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220703
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220703,
					"content": "厄舍！你逃不掉了！我們已經掌握你工廠的犯罪證據了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220704,
					"content": "妳又憑什麼覺得我會讓證據離開這個工廠呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220705
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220705,
					"content": "又是機械警衛…你有完沒完？拿這些錢去幹點正事不好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220706
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220706,
					"content": "這就是我的正事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220707
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220707,
					"content": "搞垮「千織屋」？還是做你的臭衣服？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220708
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220708,
					"content": "是去證明「時尚」僅僅為一場可笑的鬧劇，一場無知的狂歡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220709
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220709,
					"content": "…你被「時尚」這個概念套住了，厄舍。別去迎合它，做自己的東西，去改變它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220710
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220710,
					"content": "別在這對我說教！妳遲早也會有一天對「時尚」低頭，它說到底就只是一種輿論而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220711
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220711,
					"content": "它是人們對一種理念的嚮往。而「千織屋」的理念，就是絕不低頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220712
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220712,
					"content": "哼，當人們看到時尚界推崇的「千織屋」一落千丈的時候，他們就會知道這理念有多可笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220713
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220713,
					"content": "你就為了證明自己這個無聊的念頭，才對我的品牌下手？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220715
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220715,
					"content": "…以前的你可不是這樣的，那個想做出震撼人心作品的厄舍去哪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220716
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220716,
					"content": "我只是意識到那種不切實際的夢想有多麼荒唐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220717
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220717,
					"content": "…你放棄了自己的夢想，現在又轉過頭來貶低它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220718
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220718,
					"content": "你自以為看清了一切，但…你不過是想證明自己放棄的那條路是錯的，才能心安理得地過下去罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220719
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220719,
					"content": "我就直說了，你這樣子很可悲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220720
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220720,
					"content": "可悲的是妳。像個傻子一樣做著什麼「風靡提瓦特」的白日夢，我看妳連楓丹都要待不下去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220721
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220721,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220722
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220722,
					"content": "…你說得對，或許所有追逐夢想的人都是傻子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220723
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220723,
					"content": "但更可悲的，是那些連傻子都不敢做的懦夫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220724
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220724,
					"content": "妳…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220725,
						140220726
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220725,
					"content": "…千織，妳先走。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220727
					]
				},
				{
					"id": 140220727,
					"content": "沒錯，這裡交給我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220728,
					"content": "#不，應該是{F#妳}{M#你}們先走才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220729
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220729,
					"content": "欸？可是…他還有槍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220730
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220730,
					"content": "#沒事的。{F#妳}{M#你}們去會場，告訴大家計畫照常進行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220731
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220731,
					"content": "這裡，必須由我「親自」給他一個教訓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220732,
						140220733
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220732,
					"content": "…我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220734
					]
				},
				{
					"id": 140220734,
					"content": "…千織妳一定要趕上喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220735
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220735,
					"content": "想走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220736
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220736,
					"content": "",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						140220737
					]
				},
				{
					"id": 140220737,
					"content": "看在與你合作過的份上，我一直對你手下留情，厄舍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220738
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220738,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220739
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220739,
					"content": "但「參觀」完你的工廠之後，我就不那麼想了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220740
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220740,
					"content": "哼…還在嘴硬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220741
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220741,
					"content": "不管你經歷了什麼，不管你為什麼會變成這個樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220742
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220742,
					"content": "用我朋友的話說——我一點都不同情你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220743
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220743,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220744
					],
					"speakerTitle": "厄舍"
				},
				{
					"id": 140220744,
					"content": "就讓我來告訴你，「千織」這個品牌代表了什麼吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千織"
				},
				{
					"id": 140220733,
					"content": "…千萬小心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220734
					]
				},
				{
					"id": 140220726,
					"content": "…時裝秀要緊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220727
					]
				}
			]
		},
