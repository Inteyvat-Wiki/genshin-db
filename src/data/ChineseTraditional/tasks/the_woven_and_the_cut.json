				]
			},
			"dialogs": [
				{
					"id": 140220201,
					"content": "#{F#妳}{M#你}們來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220202
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220202,
					"content": "千織！衣服的製作還順利嗎？妳看起來有點累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220203,
					"content": "還剩最後幾道工序，已經交給愛洛芙了。應該能趕上晚上的時裝秀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220204
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220204,
					"content": "這樣時間抓得好危險…妳不去沒關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220205,
					"content": "放心，我哪邊都沒打算輸。況且今晚時裝秀，厄舍工廠停業，要找證據的話這是我們唯一的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220206
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220206,
					"content": "雖然是他有錯在先，但我們這麼闖進去，是不是也算犯罪呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220207,
					"content": "他的工廠平時也開放參觀。今天說的是停業，沒說停止參觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220208
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220208,
					"content": "我們只是好奇的顧客而已，有什麼問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220209
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220209,
					"content": "妳要是這麼說的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220210,
					"content": "好了，厄舍的工廠就是那間。抓緊時間，該行動了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220211
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220211,
					"content": "呃…怎麼會開在那種地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220212,
					"content": "營銷策略不同，「千織屋」主打高級訂製，他主打便宜多銷。可能這裡租金便宜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220213
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220213,
					"content": "好吧，只是看起來陰森森的，我絕對不會去那裡買衣服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220214,
					"content": "妳說得對，待會也多加小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千織"
				}
			]
		},
