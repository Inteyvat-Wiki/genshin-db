			},
			"dialogs": [
				{
					"id": 140221401,
					"content": "看起來是類似倉庫的地方呢，嗚…這裡也臭烘烘的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140221402,
					"content": "呃！怎麼回事？進來的路被堵住了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140221403,
					"content": "是想把我們困在工廠裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140221404
					]
				},
				{
					"id": 140221404,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221405
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221405,
					"content": "看來他知道我們會來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221406
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221406,
					"content": "我記得千織妳之前好像說…厄舍那傢伙很瞭解妳？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140221407,
					"content": "嗯，其實…厄舍是我最初的合作伙伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221408
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221408,
					"content": "欸？完全看不出來！你們的關係明明這麼差！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140221409,
					"content": "剛到楓丹的時候，我和他都是嚮往步入「時尚」舞臺的設計師。為了共同的目標，我們合作過一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221410
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221410,
					"content": "原本我們都想做出與眾不同、突破傳統、讓所有人都驚嘆的服裝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221411
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221411,
					"content": "但隨著別人的一聲聲否定、投資人的一次次搖頭…厄舍漸漸失去了信心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221412
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221412,
					"content": "終於，在時裝週前夕，他斷定我們做不出理想中的衣服了，和我分道揚鑣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221413
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221413,
					"content": "我本著孤注一擲的心情，傾盡所有…在最後一天做出了滿意的服裝，懷著忐忑的心情參加了時裝秀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221414
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221414,
					"content": "結果就是千織妳一舉成名，但厄舍卻放棄了自己的夢想，轉而做起這種虧心的衣服嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140221415,
					"content": "具體怎樣我不知道，但我開了「千織屋」後，他每年都會給我找麻煩這件事是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221416
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221416,
					"content": "哼！我看他就是嫉妒妳的成就，我可是一點都不同情他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140221417,
					"content": "不管怎麼說，還是先想想怎麼逃出去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221418
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221418,
					"content": "要是趕不上時裝秀，那就真讓他得逞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221419
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221419,
					"content": "啊，那邊有幾個控制台！去看看有沒有什麼能動的按鈕吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
