			"dialogs": [
				{
					"id": 140221201,
					"content": "這裡看起來好髒啊，上面的衣服真的是在這裡做出來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140221202,
					"content": "#…{F#妳}{M#你}們看那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221203
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221203,
					"content": "嗚…好髒的水。我在這裡都聞見臭味了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140221204,
					"content": "厄舍這傢伙，還敢說我的用料有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221205
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221205,
					"content": "搞半天，是他自己開了個黑心工廠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140221206,
					"content": "我說他做的衣服怎麼摸起來怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221207
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221207,
					"content": "原來是為了削減成本，偷偷在工廠裡搞這些小動作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221208
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221208,
					"content": "這樣做出來的衣服能穿嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140221209,
					"content": "褪色和縮水都是小事了，這不正規的用料…穿多了皮膚都要出問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221210
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140221210,
					"content": "好可怕…我們快把這些證據拍下來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140221211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140221211,
					"content": "這樣他在審判庭上就無話可說了！我們繼續前進吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
