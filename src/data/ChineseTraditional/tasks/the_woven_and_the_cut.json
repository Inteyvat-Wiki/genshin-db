						],
						"pointId": 7889
					}
				]
			},
			"dialogs": [
				{
					"id": 140220901,
					"content": "久等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220902
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220902,
					"content": "不久不久，有什麼要到這裡才能送呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220903,
					"content": "#…來，給{F#妳}{M#你}這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220904
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220904,
					"content": "這是…一枚胸針？還是「千織屋」的樣式。咦？我也有份！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220905
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220905,
					"content": "#暫時只做了這兩枚，想來想去，還是決定先送給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220906,
						140220907
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220906,
					"content": "謝謝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220908
					]
				},
				{
					"id": 140220908,
					"content": "#這次{F#妳}{M#你}們幫了我很大的忙，而且幾乎一直陪著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220909
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220909,
					"content": "#我有時候覺得，就算是為了不辜負{F#妳}{M#你}們的相信，我也不能認輸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220910
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220910,
					"content": "這次更多還是千織自己的功勞啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220911,
					"content": "這我敢肯定地告訴妳，絕對不是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220912
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220912,
					"content": "在「夢想」的道路上走了這麼久，我已經感受到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220913
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220913,
					"content": "除了自己的信念與堅持之外，最不可或缺的，就是支持你的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220914
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220914,
					"content": "#一個人能做到的事情非常有限，這次如果不是{F#妳}{M#你}們相助，我可能真的會一敗塗地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220915
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220915,
					"content": "也沒有那麼誇張吧…倒是我很擔心千織妳在時裝秀上說的那些，妳就不怕之後沒人來買妳的衣服嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220916
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220916,
					"content": "或許我的說辭的確有些高傲，但那都是我最真誠的想法。我不會被這個世界牽著走，更別說被任何人牽著走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220917
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220917,
					"content": "我有自信，「千織屋」的衣服，一定是最好的那一個。好的東西，人們自然會追隨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220918
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220918,
					"content": "嘿嘿，那我就放心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220919,
					"content": "接下來，我們是不是該去參加慶功宴了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 140220920,
					"content": "嗯，當然。不過在那之前，再讓我欣賞一下今晚的夜色吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140220921
					],
					"speakerTitle": "千織"
				},
				{
					"id": 140220921,
					"content": "我敢肯定，這會是我來楓丹之後，所見過最美的一晚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "千織"
				},
				{
					"id": 140220907,
					"content": "我會好好保管…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140220908
					]
				}
			]
		},
