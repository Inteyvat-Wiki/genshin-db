			"dialogs": [
				{
					"id": 120150401,
					"content": "#{F#妳}{M#你}們是來見八重大人的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150402
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 120150402,
					"content": "她剛剛還在裡面，但八重大人的行蹤一向神秘，隨時都可能離開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150403
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 120150403,
					"content": "#總之{F#妳}{M#你}們進去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "稻城螢美"
