			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"托馬",
					"九條鐮治",
					"一平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120150201,
					"content": "如果雷暴一事，天領奉行不能相助，那可能會有很大的風險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150202
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150202,
					"content": "不是我們不願意出面，只是現在實在騰不出手來，還希望你們能理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150203
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120150203,
					"content": "對啊，所以才要多討論，多商量嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150204
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150204,
					"content": "嗨，托馬！遇到什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150205,
					"content": "#是{F#妳}{M#你}們啊，我們剛好聊到{F#妳}{M#你}們在稻妻留下的影響呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150206,
						120150207
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150206,
					"content": "真巧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150208
					]
				},
				{
					"id": 120150208,
					"content": "#{F#妳}{M#你}們好，之前很感謝{F#妳}{M#你}們將柊小姐的信件送到我手上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150209
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120150209,
					"content": "是兩位的朋友啊。我是二少爺的小跟班，叫我一平就好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150210
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150210,
					"content": "聽起來你們好像有什麼困擾？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150211
					]
				},
				{
					"id": 120150211,
					"content": "嗯，三奉行以往的工作都是為將軍大人收集資訊，並執行她指派的任務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150212
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150212,
					"content": "但最近將軍大人宣佈閉門休養，不會見任何人…如此一來，就沒有人來為我們做決定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150213
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150213,
					"content": "將軍大人需要安靜下來整理心情，這我們都理解。但另一個情況是，幾乎在同一時間，稻妻外海的雷暴紊亂了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150214
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150214,
					"content": "我聽說那是將軍鎖國意志的體現。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150215
					]
				},
				{
					"id": 120150215,
					"content": "沒錯，在漫長的時間裡，雷暴的規模和形態從來沒有變化。但現在，它好像有靠近稻妻島嶼的趨勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150216
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150216,
					"content": "欸？！她現在的意志是要摧毀稻妻嗎！還是要找我們報仇？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150217,
						120150220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150217,
					"content": "那也太小孩子氣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150218
					]
				},
				{
					"id": 120150218,
					"content": "對喔，仔細想想，要找我們報仇的話，用普通的落雷就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150219,
					"content": "——也很可怕啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150223,
					"content": "哈哈，放心吧，我們擔心的是將軍大人，因為我們從來沒見過她的意志產生動搖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150224
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150224,
					"content": "這讓我聯想到璃月的神剛剛離開，我們都不覺得這是個好兆頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150225
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120150225,
					"content": "現在很多人認為，雷暴的紊亂，是因為將軍大人的身體出了問題。不見任何人，也是擔心影響會擴大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150226,
						120150227
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120150226,
					"content": "不是完全沒道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150228
					]
				},
				{
					"id": 120150228,
					"content": "所以，在流言四起之前，我受小姐之託，來和天領奉行商量對策，以免混亂出現的時候應對不及。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150229
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150229,
					"content": "但話是這麼說，天領奉行內部現在非常不安穩，「九條家」對其他家族已經失去控制力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150230
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120150230,
					"content": "這又是怎麼回事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150231,
					"content": "九條家由於成為了愚人眾的幫兇，差點毀了稻妻，現在都在聽候將軍大人的審判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150232
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120150232,
					"content": "誰都知道天領奉行要換人了，只不過將軍大人的命令還沒下來而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150233
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120150233,
					"content": "簡單來說，就是手下已經沒人聽話了，工作卻還要照做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150234
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150234,
					"content": "如果孝行老爺的身體還健康的話，說不定還有辦法，可是現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150235
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150235,
					"content": "都怪我能力有限，當初沒能提前查明真相，也未能阻止父親，現在代替父親做家主的工作，也無法平息內亂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150236
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120150236,
					"content": "別這麼說，二少爺，你要打起精神來，至少堅持到大少爺回來…現在九條家可經不起半點變故。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150237
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150237,
					"content": "嗯，說的也是。大哥他現在也焦頭爛額，不能給他添更多麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150238
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120150238,
					"content": "那麼，托馬，剛剛的事我們改日再討論吧，現在我要去見「鷹司家」的家主鷹司進，他是現在唯一有能力主持大局的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150239
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120150239,
					"content": "嗯，去吧。早點處理好天領奉行裡面的事，對我們都有好處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150240
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150240,
					"content": "那我也跟你去，二少爺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150241
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150241,
					"content": "不用了，我一個人就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150242
					],
					"speakerTitle": "九條鐮治"
				},
				{
					"id": 120150242,
					"content": "唔，那也好…二少爺你路上小心，早點回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150243
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150243,
					"content": "其實，無論是雷暴還是天領奉行的事，都是因為將軍突然決定靜養吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150244,
					"content": "這樣下去，只怕會人心惶惶的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150245,
					"content": "那如果請她出來一趟呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150246
					]
				},
				{
					"id": 120150246,
					"content": "#欸？這種事{F#妳}{M#你}們能做到嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150247
					],
					"speakerTitle": "一平"
				},
				{
					"id": 120150247,
					"content": "不知道，但可以試試看。至於她願不願意出來，就要看她的心情了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150248,
					"content": "#聽起來{F#妳}{M#你}們好像想到辦法了，那我可以拜託{F#妳}{M#你}們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150249
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150249,
					"content": "所有人都很擔心將軍大人，如果能見到她，一切謠言都會不攻自破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150250
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150250,
					"content": "我試試看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150251
					]
				},
				{
					"id": 120150251,
					"content": "#感激不盡，{NICKNAME}，又欠{F#妳}{M#你}的人情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150252
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 120150252,
					"content": "閉關的情況下有可能見到將軍的人，只可能是她了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150253
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150253,
					"content": "那麼，出發，去鳴神大社！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150227,
					"content": "雷暴的紊亂一定事出有因。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150228
					]
				},
				{
					"id": 120150220,
					"content": "妳是不是在害怕她啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150221
					]
				},
				{
					"id": 120150221,
					"content": "不是啊，手下敗將而已，有什麼好怕的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150222,
					"content": "但有點擔心她會生氣，嗯，稍微有點擔心而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150207,
					"content": "這是調侃嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150208
					]
				}
			]
		},
		{
