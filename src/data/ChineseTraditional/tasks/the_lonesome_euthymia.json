			"dialogs": [
				{
					"id": 120150701,
					"content": "將軍大人正在靜養，不見任何人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150702
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150702,
					"content": "我們有神子給我們的通行證明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150703,
					"content": "#開什麼玩笑，宮司大人從來不會把通行證交給別人，即便{F#妳}{M#你}們是名聲顯赫的旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150704
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150704,
					"content": "正是因為將軍大人對八重宮司的信任，才會允許這張通行證明的效力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150705
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150705,
					"content": "等等，這個…居然是真的？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150706,
						120150707
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150706,
					"content": "沒辦法造假吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150708
					]
				},
				{
					"id": 120150708,
					"content": "我明白了，那按照將軍大人的意思，確實不應該阻攔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150709
					],
					"speakerTitle": "毅"
				},
				{
					"id": 120150709,
					"content": "抱歉，請進吧。面見靜養中的將軍，請更加謹慎，不要做出任何冒犯的行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "毅"
				},
				{
					"id": 120150707,
					"content": "那去找神子大人問問？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150708
					]
				}
			]
		},
