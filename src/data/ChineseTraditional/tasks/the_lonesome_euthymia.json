			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120150501,
					"content": "#沒想到在休息的時候迎來了神社的貴客，呵呵，{F#妳}{M#你}是來探望我的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150502,
						120150505
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150502,
					"content": "當然了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150503
					]
				},
				{
					"id": 120150503,
					"content": "#油嘴滑舌，{F#妳}{M#你}的雙眼不擅長說謊。{F#妳}{M#你}是有事情才來找我的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150504
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150504,
					"content": "不過嘛，這個回答，至少讓我有了好心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150508
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150508,
					"content": "那麼說吧，有什麼事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150509
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150509,
					"content": "我們聽說將軍最近在閉門休養，然後稻妻外海的雷暴就不安分起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150510,
					"content": "傳聞中雷暴和將軍的意志有關，所以大家都在猜測，是不是將軍最近的狀態很不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150511,
					"content": "天領奉行的事務也需要她決斷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150512
					]
				},
				{
					"id": 120150512,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150513
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150513,
					"content": "#算了，既然是{F#妳}{M#你}們，我也沒什麼好隱瞞的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150514
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150514,
					"content": "將軍大人，在那場戰鬥之後，心結難解，性情大變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150515
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150515,
					"content": "欸——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150516,
						120150517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150516,
					"content": "性情大變？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150518
					]
				},
				{
					"id": 120150518,
					"content": "#將軍大人的力量本就日漸衰落，{F#妳}{M#你}那時候又下手太重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150519
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150519,
					"content": "落敗對她可是無比沉重的打擊，再加上我去見她的時候，又剛好忘記帶三彩糰子和輕小說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150520
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150520,
					"content": "我的舊友啊，因為沒辦法邊吃甜點心邊看小說，氣得內心崩潰，又哭又鬧，嗚嗚嗚嗚，好可憐啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150521
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150521,
					"content": "哪有會被這種事氣得又哭又鬧的神啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150522,
						120150523
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150522,
					"content": "實在不該相信妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150524
					]
				},
				{
					"id": 120150524,
					"content": "#呵呵，這也不能都怪我。在我聽來，{F#妳}{M#你}們所謂的「擔心」，就和我的謊言一樣，都是無稽之談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150525
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150525,
					"content": "那可是追求永恆的影，凡人的生命在她看來不過須臾，又怎麼需要凡人擔心她的安危呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150526
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150526,
					"content": "也就是說，她沒事對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150527,
					"content": "實際的情況我也不知道，她說了要靜養，我又沒什麼重要的事，沒必要去自找沒趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150528
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150528,
					"content": "雷暴這件事，我也有所耳聞，單說「她的意志發生了轉變」，並非沒有可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150529,
						120150530
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150529,
					"content": "那更該看看她了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150531
					]
				},
				{
					"id": 120150531,
					"content": "在將軍靜養的時候還能見到她的，在稻妻也只有我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150532
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150532,
					"content": "#不過，我為什麼要幫{F#妳}{M#你}這個忙呢？對見慣了金山銀山、世事浮沉的我，又有什麼能讓我心動呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150533,
						120150534
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150533,
					"content": "這是為了稻妻人民。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150535
					]
				},
				{
					"id": 120150535,
					"content": "#哈哈，我很喜歡{F#妳}{M#你}的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150536
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150536,
					"content": "#這是通行證明，交給看門的奧詰眾，他就會放{F#妳}{M#你}們進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150537
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150537,
					"content": "謝謝妳！神子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150538,
					"content": "#雖然剛剛的問題是在開玩笑，但既然{F#妳}{M#你}回答了，就請不要只是說說而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150539
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150539,
					"content": "對了，通行證也要還給我喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150534,
					"content": "這是為了影。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150535
					]
				},
				{
					"id": 120150530,
					"content": "就是怕她悶壞了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150531
					]
				},
				{
					"id": 120150523,
					"content": "說不定真的有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150524
					]
				},
				{
					"id": 120150517,
					"content": "居然會這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150518
					]
				},
				{
					"id": 120150505,
					"content": "有事想和妳打聽。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150506
					]
				},
				{
					"id": 120150506,
					"content": "#太冷淡了吧，好歹我也是{F#妳}{M#你}的救命恩人，就連兩句寒暄都沒有嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150507
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120150507,
					"content": "#不過嘛，這也是{F#妳}{M#你}的魅力所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150508
					],
					"speakerTitle": "八重神子"
				}
			]
		},
