			},
			"dialogs": [
				{
					"id": 120150802,
					"content": "#{F#妳}{M#你}們是如何闖進來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150803
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120150803,
					"content": "擅闖此地者，應立刻殲滅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150804
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120150804,
					"content": "等一下，是我們啊！為什麼又是一副看到敵人的樣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150805,
					"content": "我們應該已經和好了吧，進來的手段也非常正當！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150806,
					"content": "不行，使用武力，是被禁止的事項。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150807
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120150807,
					"content": "總之，回去吧，休要干擾我的修養。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150808,
						120150809
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120150808,
					"content": "「被禁止」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150810
					]
				},
				{
					"id": 120150810,
					"content": "不必知曉，這就是我追求靜養時的狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150811
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120150811,
					"content": "#唔，{NICKNAME}，{F#妳}{M#你}有沒有感覺怪怪的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150812,
						120150813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150812,
					"content": "人偶也需要靜養嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150814
					]
				},
				{
					"id": 120150814,
					"content": "此身並不需求休憩，但我終歸是「內在」的協助者，靜養既是她的意志，那麼隨她所願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150815
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120150815,
					"content": "我懂了，「靜養」原來是裡面的影在干涉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150816,
					"content": "可是，為什麼呢？將軍就算在外面行動，應該也打擾不到「一心淨土」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150817,
					"content": "她有個那麼大的庭院，已經是最適合休養的環境了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150818,
					"content": "隨她所願，此外無可奉告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150819,
						120150820
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120150819,
					"content": "大家都很擔心將軍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150821
					]
				},
				{
					"id": 120150821,
					"content": "不可。現在的我，即便外出也無事可做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150822
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120150822,
					"content": "我不願意處理事務，亦是因為無法處理任何事務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150823
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120150823,
					"content": "嗯？這又是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150824
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150824,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150825
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120150825,
					"content": "都是被禁止的事項。唉，別再讓我說話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150826
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120150826,
					"content": "#怎麼辦，{NICKNAME}，感覺對話進行不下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150827,
						120150828
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150827,
					"content": "是不是生病了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150829
					]
				},
				{
					"id": 120150829,
					"content": "#原來是{F#妳}{M#你}們，許久不見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150830
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150830,
					"content": "將軍現在有諸多不便之處，直接進來見我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "影"
				},
				{
					"id": 120150828,
					"content": "是不是壞掉了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150829
					]
				},
				{
					"id": 120150820,
					"content": "大家想見妳一面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150821
					]
				},
				{
					"id": 120150813,
					"content": "她以前是這種態度嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150814
					]
				},
				{
					"id": 120150809,
					"content": "妳怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150810
					]
				}
			]
		},
		{
			"id": 1201509,
			"completionStepIds": [
				1201510
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201510",
							"2"
						],
						"stepId": 1201510,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"影"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120150901,
					"content": "嚇死我了，不要這麼突然就把我們拉進來啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150902,
					"content": "又不是第一次了，有什麼好慌張的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150903
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150903,
					"content": "外面的將軍是不是壞掉了啊？妳要不要找個時間修理一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150904,
					"content": "不用擔心，那是我本人所為。將軍的很多功能，都被我暫時禁止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150905
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150905,
					"content": "現在的將軍不能處理事務，也不能作為「我」出現，於是就乾脆宣佈「閉門靜養」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150906,
						120150907
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150906,
					"content": "怪不得將軍一直在說「禁止」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150908
					]
				},
				{
					"id": 120150908,
					"content": "我說過，有關稻妻的「永恆」，我需要再好好想想，思考需要時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150909
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150909,
					"content": "但將軍仍然依照原本的規則運行，在我想清楚之前，不能容許將軍繼續犯錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150910
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150910,
					"content": "將軍沒有像開關一樣的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150911
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150911,
					"content": "沒有，創造的時候就沒考慮要關閉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150912
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150912,
					"content": "而且正好相反，當時的我已經考慮到了未來的我可能會修改將軍的運行規則，這也是不利於「永恆」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150913
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150913,
					"content": "對自己同樣嚴苛啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150914
					]
				},
				{
					"id": 120150914,
					"content": "所以將軍對於法則的修改有非常完備的防禦機制，這也是應對突發情況的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150915
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150915,
					"content": "對我來說，在我想清「永恆」的形態之前，暫時禁用某些功能，比直接修改人偶的法則更加有效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150916
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150916,
					"content": "那我大概明白了，稻妻外海的雷暴紊亂，也是因為將軍的某些功能被停掉了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150917,
					"content": "雷暴紊亂？這我是第一次聽說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150918
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150918,
					"content": "欸？事情是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150919
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150919,
					"content": "#嗯，{F#妳}{M#你}們說的雷暴，原來如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150920
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150920,
					"content": "不會是很棘手的狀況吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150921,
					"content": "操作失誤啦，這種事難免的，之後我調整一下將軍就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150922,
						120150923
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150922,
					"content": "…虛驚一場。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150924
					]
				},
				{
					"id": 120150924,
					"content": "別這麼看著我，這種操作我以前也沒做過，將軍的構造是很複雜的，只要調整就難免出問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150925
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150925,
					"content": "對，我可不是找藉口，事實就是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150926
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150926,
					"content": "沒關係，不用在意啦，能解決就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150927,
					"content": "那妳對「永恆」的思考有進展嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150928
					]
				},
				{
					"id": 120150928,
					"content": "還是老樣子。雖然看到了前進的方向，但矛盾依舊存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150929
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150929,
					"content": "不過，也不用太著急。若是不夠認真謹慎，只是為了得出結論而得出結論，那就本末倒置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150930,
						120150931
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150930,
					"content": "跟我去換個心情吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150932
					]
				},
				{
					"id": 120150932,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150933
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150933,
					"content": "大家只要見到將軍還健康，外面的猜測和謠言就都會不攻自破的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150934
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150934,
					"content": "而妳如果換個地方、換個心情，也可能會有新的想法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150935
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150935,
					"content": "是要我，離開「一心淨土」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150936,
						120150938
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150936,
					"content": "或許對大家都是有利的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150937
					]
				},
				{
					"id": 120150937,
					"content": "嗯，也對，畢竟現在的將軍無法代我處理事務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150940
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150940,
					"content": "那好吧，出去轉一轉好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150941
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150941,
					"content": "#既然是轉換心情，{F#妳}{M#你}們稱呼我為「影」就好。我不喜歡太死板的稱呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150942
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150942,
					"content": "欸？不過現在在我們眼前的，是影的意識對吧？意識可以離開這個地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150943
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150943,
					"content": "這個我自有辦法，我可不會主動將自己囚禁起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150944
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150944,
					"content": "好的，那我就不擔心啦！接下來我們就是妳的導遊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150945
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150945,
					"content": "導遊？那是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150946
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150946,
					"content": "就是幫妳介紹現在的稻妻，告訴妳什麼好吃什麼好玩的人！好啦好啦，出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120150938,
					"content": "妳有很長時間沒有出去過了吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150939
					]
				},
				{
					"id": 120150939,
					"content": "#對我來說這並非必要之事，但有{F#妳}{M#你}的邀請…換個心情可能也不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120150940
					],
					"speakerTitle": "影"
				},
				{
					"id": 120150931,
					"content": "出去走走怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150932
					]
				},
				{
					"id": 120150923,
					"content": "好隨意的理由。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120150924
					]
				},
				{
					"id": 120150907,
					"content": "原來全是妳做的啊。",
					"roleType": "TALK_ROLE_PLAYER",
