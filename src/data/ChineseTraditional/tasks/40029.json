				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400290101,
					"content": "阿貝多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290102,
					"content": "旅行者，派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290103
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290103,
					"content": "#看來{F#妳}{M#你}們已經想好故事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290104
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290104,
					"content": "對呀對呀，你呢？需要再給你一些時間嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290105,
					"content": "不用。我也想好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290106
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290106,
					"content": "先來後到，我要先說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290107,
					"content": "好啊，請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290108
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290108,
					"content": "我開始了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290109,
					"content": "從前有一個邪惡的學者，抓著山上的騙騙花進行改造，這些騙騙花帶著痛苦變成了人的樣子，站在山路旁等著過往行人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290110,
					"content": "只要有人理，他們就會問對方一些問題，例如：我是誰？你是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290111,
					"content": "如果回答錯誤…就會哇的一聲被吃掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290112,
					"content": "嗯，真可怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290113
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290113,
					"content": "派蒙好可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290114
					]
				},
				{
					"id": 400290114,
					"content": "什麼呀，你們完全沒被嚇到嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290115,
					"content": "可能是我太堅強了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290116
					]
				},
				{
					"id": 400290116,
					"content": "#不許挑我的毛病啦！{F#妳}{M#你}要是不滿意就自己想一個嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290117,
					"content": "那麼，加入恐怖要素…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290118,
						400290119
					]
				},
				{
					"id": 400290118,
					"content": "騙騙花吃了人之後…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290120
					]
				},
				{
					"id": 400290120,
					"content": "也就是說，身為兇手的騙騙花完全取代了被害者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290121
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290121,
					"content": "而且還要利用這個身分。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290122
					]
				},
				{
					"id": 400290122,
					"content": "那接下來騙騙花就要進城了吧？！變成普通人的樣子回到家裡，把他們的家人統統吃掉…嗚哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290123,
					"content": "明明是我開的頭，我卻覺得好可怕呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290124,
					"content": "不錯的故事呢。我能記下來嗎？下次跟人聊天也許會用到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290125
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290125,
					"content": "你是想拿去嚇唬人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290126,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290127
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290127,
					"content": "這人好壞啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290128,
					"content": "那你編了什麼故事呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290129
					]
				},
				{
					"id": 400290129,
					"content": "#我的故事比{F#妳}{M#你}的故事要長一些。最早，要從一個煉金術士說起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290130
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290130,
					"content": "偉大的煉金術士創造了一號。一號帶著她的驕傲，完美地融入了普通人。誰也不會想到，身邊這個朋友竟然是人造人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290131
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290131,
					"content": "然而，一號並不知道，在他誕生前，煉金術師還進行過許多次試驗。有些失敗的瑕疵品遭到遺棄，可他並未死去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290132
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290132,
					"content": "失敗品二號被巨龍吞入腹中，跟隨龍一起留在了雪山上，直到許多年後，他因為某種神秘的龍之力甦醒過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290133
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290133,
					"content": "他看見雪山上各式各樣的人，以及那個…神奇地融入了他們的一號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290134
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290134,
					"content": "二號從未想過，他們這些試驗品居然能完美騙過所有人的眼睛。人們接納一號為朋友，親切地稱呼他的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290135
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290135,
					"content": "而那正是二號想要的。所以，二號想要替代一號，成為那個幸福的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290136
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290136,
					"content": "嗚…我、我突然覺得好冷，好嚇人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290137,
					"content": "二號展開了他的計畫。他偷來一號的書本與筆記，研究一號那些繼承自煉金術士的學識。他很聰明，學得很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290138
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290138,
					"content": "隨後，他改變了自己原本那張臉，變成與一號完全一樣的面孔。又找到一株能夠擬態的雪山植物，使用龍血和煉金術改造它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290139
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290139,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290140
					]
				},
				{
					"id": 400290140,
					"content": "二號將自己變成與一號完全相同的模樣，又製造出了第三個個體：三號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290141
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290141,
					"content": "哎？！三個？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290142,
					"content": "但不同的是，二號想要成為真正的完美之人。於是，他抹去了自己和三號脖子上象徵瑕疵的印記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290143
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290143,
					"content": "故意…抹去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290144
					]
				},
				{
					"id": 400290144,
					"content": "要我說的話，抹去印記可能只是下意識所為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290145
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290145,
					"content": "他太過渴望成為完美之人，以至於忘記了，人類本就因不完美而生動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290146
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290146,
					"content": "二號的計畫非常周密，三號負責吸引注意力，等一號處理掉三號之後，認為威脅已經消失的一號必然會陷入鬆懈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290147
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290147,
					"content": "一號落單的時刻，就是二號動手的最佳時機。除掉一號，他就能成為唯一的那個個體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290148
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290148,
					"content": "他會神不知鬼不覺地替換掉所有人記憶中的一號，繼承一號的身分、住所、衣物、寶劍、名字和朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290149
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290149,
					"content": "而人們並不知道，他們昨天與今天見到的竟然是兩個人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290150
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290150,
					"content": "好嚇人，好嚇人啊…我再也不要相信別人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290151,
					"content": "但就在二號實施計畫之前，有個特別的陌生人出現了。二號嘗試與他接觸，卻發現他能隱約感覺出自己和一號有所不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290152
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290152,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290153,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290154
					]
				},
				{
					"id": 400290154,
					"content": "怎麼？被嚇到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290155
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290155,
					"content": "後來呢？那個陌生人怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290156,
					"content": "當然是被二號列為了計畫中的一環。對二號來說，必須除掉的人又多了一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290157
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290157,
					"content": "就像是院子裡的三株玫瑰，外觀完全一樣。三株中只有一株是不帶毒刺的優質品，剩下兩株都是長有毒刺的劣等品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290158
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290158,
					"content": "而在這世界上，只有照顧它們的園丁能夠分辨出哪一株才是優質品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290159
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290159,
					"content": "人們不喜歡帶毒的植物，唯有完美的玫瑰可以賣出高價。劣等品想要掩蓋自己不值錢的事實，就要用毒刺除掉園丁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290160
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290160,
					"content": "二號也是這樣想的。所以他躲在暗處耐心地等待。也許再過一會，他的機會就要來了。他會成為真正的「人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290161
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290161,
					"content": "（這不只是故事…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290162
					]
				},
				{
					"id": 400290162,
					"content": "（這是真實存在於過去的事。阿貝多想告訴我的，就是這些殘酷又不可思議的真相。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290163
					]
				},
				{
					"id": 400290163,
					"content": "好壓抑的故事啊，後來怎麼樣？二號成功了嗎？我都不敢想了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290164,
					"content": "#幸好故事只是故事，不會成真，二號在這個故事裡也沒能取得成功。但在雪山，{F#妳}{M#你}們不能放鬆警惕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290165
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290165,
					"content": "#用杜林的力量和血肉變異而成的怪物，也能算是萊茵多特的造物，跟我沒什麼不同。{F#妳}{M#你}們要小心這類生物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290166
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290166,
					"content": "不是這樣的！你是我的朋友，不是怪物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290167
					]
				},
				{
					"id": 400290167,
					"content": "#很高興聽到{F#妳}{M#你}這麼說。沒關係，我知道自己的來歷。{F#妳}{M#你}我同為異類，在{F#妳}{M#你}面前我無需掩飾真實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290168
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290168,
					"content": "只不過有時想到煉金術是如此偉大的學問，會有些無奈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290169
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290169,
					"content": "作為踏足大地的生命之一，渴望掌握命運，渴求創造的我們究竟有多傲慢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290170
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290170,
					"content": "旅行者，創造是傲慢的行徑嗎？如果不是，那我們為何稱呼掌控我們、創造我們的事物為「神」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290171
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290171,
					"content": "如果是，那我們又有何資格去自居「創造者」這一身分呢。我們的敬畏和尊重，究竟要做到哪一步，要用到何處？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290172
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290172,
					"content": "處置冒牌貨的時候，你是什麼感覺？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290173
					]
				},
				{
					"id": 400290173,
					"content": "沒什麼特別的感覺。不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290174
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290174,
					"content": "…偶爾想起這件事，會感到一絲悲哀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290175
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290175,
					"content": "阿貝多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290176
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290176,
					"content": "#喂——！旅行者！{F#妳}{M#你}在這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290177
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400290177,
					"content": "咦，安柏的聲音？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290178
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290178,
					"content": "果然在這裡啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290179
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 400290179,
					"content": "#旅行者，我們是來替賽琉斯先生傳話的，山腳營地那邊有重要的事，{F#妳}{M#你}也一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290180
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400290180,
					"content": "冬令營接近尾聲，就算是掛名教官也得就位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290181
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 400290181,
					"content": "我們得走了，阿貝多，先再見啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290182
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290182,
					"content": "去忙吧。我這裡還有些事，就不陪各位下山了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290183
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290183,
					"content": "沒關係沒關係，最近上下山都很順利哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290184
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400290184,
					"content": "準備好就出發吧，別讓營地那邊久等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "優菈"
				},
				{
					"id": 400290119,
					"content": "就會變成那個人的樣子！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290120
					]
				}
			]
		},
		{
			"id": 4002902,
			"completionStepIds": [
				4002904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002904",
							"2"
						],
						"stepId": 4002904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"賽琉斯",
					"喬爾",
					"冒失的帕拉德",
					"喬瑟夫",
					"班尼特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400290201,
					"content": "咦？這個人是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290202,
						400290203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290202,
					"content": "難道是喬爾的父親？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290204
					]
				},
				{
					"id": 400290204,
					"content": "我來介紹一下，這位是喬瑟夫，是喬爾的父親。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290205
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400290205,
					"content": "爸爸！這位就是我和你說的旅行者，之前幫過我好多好多忙，這次還陪我一起堆雪人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290206
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 400290206,
					"content": "#喬爾都和我說了，哎呀，真是太感謝{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290207,
						400290208
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 400290207,
					"content": "團圓就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290209
					]
				},
				{
					"id": 400290209,
					"content": "是啊，這真是天大的好事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290210,
					"content": "等等，賽琉斯會長怎麼在偷偷抹眼淚，帕拉德怎麼也在這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290211,
					"content": "這次帕拉德可是大功臣哦！帕拉德，你還是自己說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290212
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400290212,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290213
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290213,
					"content": "我記得那時天氣不錯，我預感自己將要有好運氣，就堅信著自己的理念，往危險的地方去，因為越危險的地方越有寶藏嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290214
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290214,
					"content": "怎麼聽開頭就感覺不靠譜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290215,
					"content": "可我才稍微離隊行動了一小會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290216
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290216,
					"content": "不小心就失足從山坡上滾了下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290217
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290217,
					"content": "嗚哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290218
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290218,
					"content": "（該不會是因為和我在山上見了一面，就被我的倒楣傳染了吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290219
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290219,
					"content": "我無意中摔在一個平時不太走到的地方…還受了點輕傷，正在感慨自己運氣差到了極點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290220
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290220,
					"content": "（呃…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290221
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290221,
					"content": "然後，我就遇到了聽見聲音跑出來看的喬瑟夫先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290222
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290222,
					"content": "哎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290223
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290223,
					"content": "哇，簡直是誤打誤撞啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290224,
					"content": "我當時以為他是冒險家協會的人，也是來參加活動的。聊了幾句才發現，好多事情他都記不得了，連自己的名字都不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290225
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290225,
					"content": "我哪來得及想這些來龍去脈啊，雪山上太冷了，我趕緊催他跟我一起翻山回營地，有什麼事等回來再說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290226
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290226,
					"content": "回到營地，我們見到了喬爾，喬爾一見到他就愣住了，跟著大叫起來：「爸爸！」他就是在這個時候突然回憶起一些事情的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290227
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290227,
					"content": "直到現在我的記憶都還沒有完全恢復，但喬爾和他的媽媽…唯獨他們，我不會…不，是不能忘記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290228
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 400290228,
					"content": "爸爸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290229
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 400290229,
					"content": "喬爾，爸爸在，爸爸在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290230
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 400290230,
					"content": "喬瑟夫先生，真的想不起其他事情了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290231,
					"content": "《野豬公主》、還有雪山上你餵過的狐狸們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290232,
					"content": "很抱歉，我沒有印象了。或許是因為腦袋受了外傷？我也不清楚了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290233
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 400290233,
					"content": "當我醒來的時候，身上全是血。就連行李也丟了，沒有能夠證明身分的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290234
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 400290234,
					"content": "我只能爬進一個山洞，安頓下來慢慢養傷，在腿腳復原點之後，靠打獵的本能才活了下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290235
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 400290235,
					"content": "爸爸…我真的好擔心你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290236
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 400290236,
					"content": "沒事沒事，喬爾不哭，爸爸這次哪裡也不去了，就陪在你身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290237
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 400290237,
					"content": "嗚…太好了，太好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290238
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290238,
					"content": "這樣就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290239
					]
				},
				{
					"id": 400290239,
					"content": "說起來，我就是從在山上遇到班尼特之後才變得比之前更倒楣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290240
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290240,
					"content": "我就知道！唉…我…我真是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290241
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290241,
					"content": "不不，我是想說，要不是因為這樣，我根本就不可能在這麼大的雪山裡遇到喬瑟夫先生啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290242
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290242,
					"content": "再說，我們不都安全回來了嗎？所以你也別自責，運氣這種事，差到極點說不定就會引發奇蹟呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290243
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290243,
					"content": "…帕拉德…嘿嘿，你這傢伙，什麼時候變得這麼會說話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290244
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 400290244,
					"content": "啊？是嗎？實、實話而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290245
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290245,
					"content": "#啊，對了，我要謝謝旅行者{F#姐姐}{M#哥哥}，還有賽琉斯叔叔、優菈姐姐和安柏姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290246
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 400290246,
					"content": "大家都很照顧我，我非常珍惜這一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290247
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 400290247,
					"content": "不過，雪人離開雪山就會融化了吧。沒有辦法一起帶走，好可惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290248
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 400290248,
					"content": "…這我倒是有辦法，稍等一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290249
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 400290249,
					"content": "欸？優菈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290250
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290250,
					"content": "…好了。喬爾，收下這個。這是堅冰的粉末，只需要加在你的雪人裡，它就永遠都不會融化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290251
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 400290251,
					"content": "哇！是真的嗎？太厲害了！優菈姐姐太厲害了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290252
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 400290252,
					"content": "爸爸，我有不會融化的雪人了！太棒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290253
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 400290253,
					"content": "我實在是不知道要如何感謝各位了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290254,
						400290255
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 400290254,
					"content": "別客氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290256
					]
				},
				{
					"id": 400290256,
					"content": "謝謝各位，謝謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290257
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 400290257,
					"content": "爸爸，我們一起去搬雪人，現在就去好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290258
					],
					"speakerTitle": "喬爾"
				},
				{
					"id": 400290258,
					"content": "行，那各位，我就先陪喬爾去玩了，我們改天見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290259
					],
					"speakerTitle": "喬瑟夫"
				},
				{
					"id": 400290259,
					"content": "好，好…我和帕拉德，也該再去談一談冒險過程中的紀律問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290260
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 400290260,
					"content": "欸？賽、賽琉斯會長…我這算是將功補過，將功補過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290261
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 400290261,
					"content": "大家慢走——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290262
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290262,
					"content": "#對了，我也做了這個給{F#妳}{M#你}和安柏，拿著吧，就當是冬天的紀念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290263
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 400290263,
					"content": "真的可以嗎？對優菈來說，這是很重要的東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290264
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 400290264,
					"content": "妳這傢伙，這種時候就不要說那麼多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290265
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 400290265,
					"content": "#哇，這下我們的雪人也不會融化了吧。太好了，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290266,
						400290267
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290266,
					"content": "謝謝妳，優菈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290268
					]
				},
				{
					"id": 400290268,
					"content": "#…{F#妳}{M#你}好好收著就行，不用客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290269
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 400290269,
					"content": "那麼，我和安柏還有事要處理，先告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290270
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 400290270,
					"content": "嗯！回頭見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290271
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290271,
					"content": "她們走啦，總覺得最近大家都有自己的事要做呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290272
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290272,
					"content": "啊！說起來，我們在雪山待了那麼久，卻還是忘了找阿貝多幫忙做那個把果子變成果汁保鮮的機器…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290273
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290273,
					"content": "要不然還是讓蒂瑪烏斯想辦法吧，誰讓他看起來最好說話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290267,
					"content": "我會好好珍惜的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290268
					]
				},
				{
					"id": 400290255,
					"content": "大家都在為你們高興。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290256
					]
				},
				{
					"id": 400290208,
					"content": "沒事就好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290209
					]
				},
				{
					"id": 400290203,
					"content": "大號的喬爾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290204
					]
				}
			]
		},
		{
