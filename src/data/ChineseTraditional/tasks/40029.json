			"dialogs": [
				{
					"id": 400290301,
					"content": "蒂瑪烏斯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290302,
					"content": "是旅行者和派蒙啊。有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290303
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 400290303,
					"content": "#等等…看{F#妳}{M#你}這有所圖謀的表情，該不會還在想那個奇怪的要求吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290304
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 400290304,
					"content": "蒂瑪烏斯，你會幫我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290305,
						400290306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290305,
					"content": "是妳，不是我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290307
					]
				},
				{
					"id": 400290307,
					"content": "旅行者說不用，那就不用了吧…畢竟，這個要求怎麼聽都很奇怪啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290308
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 400290308,
					"content": "不行不行，沒有這個我的日落果就浪費了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290309,
					"content": "可是我研究這種東西的時間都夠幫妳採十次果子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290310
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 400290310,
					"content": "研究哪種東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290311
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290311,
					"content": "嗯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290312
					]
				},
				{
					"id": 400290312,
					"content": "又見面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290313
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290313,
					"content": "阿貝多先生！來得正好，是這樣的，派蒙想要一個能把果子變成果汁，同時又能為水果保鮮的機器，這也太…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290314
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 400290314,
					"content": "很重要！如果能發明這種東西的話，我們就再也不用擔心水果腐爛啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290315,
					"content": "不可能啊！…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290316,
						400290317
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 400290316,
					"content": "（……？！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290318
					]
				},
				{
					"id": 400290318,
					"content": "把果子變成果汁不難，保鮮比較難辦。如果只是希望水果不腐爛，倒是有不少辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290319
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290319,
					"content": "對吧，旅行者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290320
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290320,
					"content": "（？！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290321
					]
				},
				{
					"id": 400290321,
					"content": "你的脖子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290322
					]
				},
				{
					"id": 400290322,
					"content": "（印記又出現了…是惡作劇？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290323
					]
				},
				{
					"id": 400290323,
					"content": "脖子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290324,
					"content": "怎麼了？我脖子上有什麼東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290325
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290325,
					"content": "…不，一切正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290326
					]
				},
				{
					"id": 400290326,
					"content": "#看{F#妳}{M#你}的表情，還以為是我剛開了什麼惡劣的玩笑呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290327
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290327,
					"content": "（果然是惡作劇！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290328
					]
				},
				{
					"id": 400290328,
					"content": "阿貝多，你剛才說的防止水果腐爛的辦法都有哪些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290329,
					"content": "比如說，把水果埋到雪山上終年不化的雪堆裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290330
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290330,
					"content": "那不就吃不到了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290331,
					"content": "妳可以住在雪山上啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290332
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290332,
					"content": "不了不了，我怕冷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290333,
					"content": "或者把那些果實交給我，我幫妳帶去雪山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290334
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290334,
					"content": "不過妳怕冷，那就要派其他人來取果子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290335
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290335,
					"content": "#這份差事非{F#妳}{M#你}莫屬啊，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290336
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290336,
					"content": "如果是別人去跑腿，聽起來可行度很高呢…要不就這麼辦吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290337
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290337,
					"content": "果實埋在雪山，保鮮期是變長了，相對地，發芽長成果樹的可能性也不是沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290338
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290338,
					"content": "也許妳下次來的時候，那些日落果已經變成果園了哦。妳可以為那些樹木澆水施肥，等它們結果，妳就有新的日落果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290339
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290339,
					"content": "哎——？！不要啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290340,
					"content": "那樣一來我們不就變成園丁了嗎？本末倒置了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290341
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290341,
					"content": "是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290342
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290342,
					"content": "我倒是覺得，當個園丁，也不壞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290343
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290343,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290344
					]
				},
				{
					"id": 400290344,
					"content": "（園丁…呢。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290345
					]
				},
				{
					"id": 400290345,
					"content": "（不過，沒想到阿貝多會跟我開這種玩笑。難道…他一點都不在乎那個印記所代表的意義嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290346
					]
				},
				{
					"id": 400290346,
					"content": "阿貝多！你幹嘛老打我那些超甜日落果的主意！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290347,
					"content": "哦？妳很介意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290348
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290348,
					"content": "當然啦！那可是難得一見的超超超級甜甜日落果呀，不會分你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290349,
					"content": "嗯，只是日落果而已。應該是因為妳手上沒有多少同等級別的果實，才會對此感到介意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290350
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290350,
					"content": "如果一個人把口袋裝得滿滿的，他的心靈也得到充實，就不會輕易陷入這種情緒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290351
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400290351,
					"content": "哎？是這樣嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400290352
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400290352,
					"content": "（…原來如此，是這樣啊。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400290317,
					"content": "（等等，他的脖子？！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290318
					]
				},
				{
					"id": 400290306,
					"content": "我不是很想要那種東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400290345
					]
				}
			]
		},
