				"points": []
			},
			"dialogs": [
				{
					"id": 230170301,
					"content": "嗯…這些徽印應該足夠我試驗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170302
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230170302,
					"content": "這是報酬，請您收好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170303
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230170303,
					"content": "旅行者，您這種眼神是什麼意思？盯得我害怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170304
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230170304,
					"content": "咳！我要去工作了，我現在就要去工作了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				}
			]
		},
