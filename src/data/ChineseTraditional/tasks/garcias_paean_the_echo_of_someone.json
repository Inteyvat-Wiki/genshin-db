	"talks": [
		{
			"id": 2301701,
			"completionStepIds": [
				2301701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2301701",
							"2"
						],
						"stepId": 2301701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加爾恰",
					"路通"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230170101,
					"content": "#旅、旅行者！您來得正好，我正和迦雅喝完咖啡，準備回去繼續工作呢。我為{F#妳}{M#你}介紹…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170102
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230170102,
					"content": "這就是你之前提到的人嗎？很榮幸見到您，我是迦雅，一個…嗯…跳舞的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170104
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230170104,
					"content": "妳好，加爾恰之前提到過妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230170105
					]
				},
				{
					"id": 230170105,
					"content": "嘻嘻，是這樣嗎？那樣就最好了，我還以為他只會記得他的機器，還有路通呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170106
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230170106,
					"content": "您大可把我排除在外，小姐，我相信加爾恰先生也樂見此事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170107
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230170107,
					"content": "那可不行，要是沒了你，加爾恰一定會把最後一分錢也花光的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170108
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230170108,
					"content": "這話我不敢苟同，小姐，我相信加爾恰先生無論如何都會留出兩杯咖啡錢的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170109
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230170109,
					"content": "三杯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170110
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230170110,
					"content": "我總會為您這靈活的同情心而驚嘆，加爾恰先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170111
					],
					"speakerTitle": "路通"
				},
				{
					"id": 230170111,
					"content": "#說，說正事！旅行者，我還是在收購盜寶團所攜帶的那種徽印，如果{F#妳}{M#你}找到的話，可以直接賣給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230170112
					],
					"speakerTitle": "加爾恰"
				},
				{
					"id": 230170112,
					"content": "#我最近也…賺了點錢，{F#妳}{M#你}大可不用擔心報酬的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加爾恰"
				}
			]
		},
