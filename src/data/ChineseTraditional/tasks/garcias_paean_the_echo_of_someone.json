			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迦雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230175001,
					"content": "您好？唔…您想問什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175002
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175002,
					"content": "妳是怎麼和加爾恰認識的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230175003
					]
				},
				{
					"id": 230175003,
					"content": "問得這麼直接？真像是一位冒險家做事的風格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175004
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175004,
					"content": "我和加爾恰認識的契機…是因為他被我所在劇團的團長僱來處理帳目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175005
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175005,
					"content": "哈哈哈，說實話，我從來沒見過這樣一個完全和劇團的氛圍合不來的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175006
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175006,
					"content": "我們在奏樂、跳舞、喝酒、唱歌，而他只是和路通在一旁沉默地計算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175007
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175007,
					"content": "有一次，我發現他穿了一件很奇怪的衣服，那件衣服上好像畫著什麼圖案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175008
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175008,
					"content": "我很好奇，就問他那些圖案是什麼，他說這些是一架機器的設計圖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175009
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175009,
					"content": "之所以會畫在衣服上，是因為他有一次在外和人討論那架機器的時候，突然找不到筆和紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175010
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175010,
					"content": "所以他就直接用炭在自己的衣服上畫示意圖來講解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175011
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175011,
					"content": "然後，我們就一直在討論他這件沒洗乾淨的衣服和那架機器…當然啦，大部分時間是他在說話，我在聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230175012
					],
					"speakerTitle": "迦雅"
				},
				{
					"id": 230175012,
					"content": "嘻嘻，他是個很奇怪的人，但同時嘛…也是一個別有魅力的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迦雅"
				}
			]
		},
