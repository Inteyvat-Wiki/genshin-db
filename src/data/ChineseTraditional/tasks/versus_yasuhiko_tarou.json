			"dialogs": [
				{
					"id": 726990101,
					"content": "不知閣下的劍技到底水準如何，這一戰我非常期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990102
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726990102,
					"content": "你怎麼也…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990103
					]
				},
				{
					"id": 726990103,
					"content": "其實，我之前說有四位武者，是把自己也算在其中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990104
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726990104,
					"content": "雖說我是這場決鬥的主辦人，但無奈參與者實在太少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990105
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726990105,
					"content": "更何況，此身為戰鬥而生，既然遇到了強大的對手，就沒有不與對方一戰的道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990106
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726990106,
					"content": "哈哈，我想說這句臺詞很久了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990107
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726990107,
					"content": "喂，這人到底行不行啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726990108,
					"content": "不能輕敵。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990109
					]
				},
				{
					"id": 726990109,
					"content": "閣下這種對所有對手一視同仁的態度，讓我肅然起敬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990110
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726990110,
					"content": "之前，如果不是因為我以貌取人，看輕了第四位武者，那場戰鬥也不會輸得那麼慘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990111
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726990111,
					"content": "#不過現在，我已經不是當時的我了！那麼，{NICKNAME}，開始比試吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726990114,
						726990112
					],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726990114,
					"content": "來吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990115
					]
				},
				{
					"id": 726990115,
					"content": "來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安彥太郎"
				},
				{
					"id": 726990112,
					"content": "等等，讓我準備一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726990113
					]
				},
				{
					"id": 726990113,
					"content": "我明白了，閣下先準備就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安彥太郎"
				}
			]
		}
	]
