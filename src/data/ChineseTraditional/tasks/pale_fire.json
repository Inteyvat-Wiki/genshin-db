						733070603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070603,
					"content": "#這個先不提，看{F#妳}{M#你}們的樣子，是發現了什麼有趣的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070604
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070604,
					"content": "也不算是有趣的事啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070605,
					"content": "向祖爾宛轉述了「靈谷木」的事情…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733070606
					]
				},
				{
					"id": 733070606,
					"content": "嗯…該從哪說起呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070607
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070607,
					"content": "#{F#妳}{M#你}們遇到的確實是花靈所化的「靈谷木」沒錯，不過寄宿在其中的，與其說是殘存的魂靈，不如說是記憶的破片才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070608
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070608,
					"content": "#就像{F#妳}{M#你}們拿到的那個「淨光翎」，其中可就蘊藏著未能回歸大地的記憶呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070609,
						733070610
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070609,
					"content": "未能回歸大地…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070613
					]
				},
				{
					"id": 733070613,
					"content": "我們花靈從花海的甘露中誕生，最終也會回歸到花海當中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070614
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070614,
					"content": "與鎮護此處的神明一樣，我們是被流淌在大地中的時輪之流所拒絕的種類。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070615
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070615,
					"content": "當然這也是我們的衷心所願，不讓漆黑之物與我們一起流入大地是我們的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070616
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070616,
					"content": "在「甘露池」中，我們得以用甘露洗淨所沾染的汙穢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070617
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070617,
					"content": "#只要將{F#妳}{M#你}們手中的「淨光翎」供奉到「甘露池」中，那流散在外的花靈便能重回花海的懷抱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070618
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070618,
					"content": "哦哦，看來我們還真的是做了件好事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070619,
					"content": "哼，白飄飄一副了不起的樣子，其實還不是靠我的偉力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070620
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733070620,
					"content": "嗯嗯，斯露莎也很厲害啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070621,
					"content": "這還差不多…不對，我才不需要白飄飄的誇讚，我只要有「謁頌主」就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070622
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733070622,
					"content": "#說到「謁頌主」，既然{F#妳}{M#你}也算是接受了這一名號，那倒還真是完成這一儀式的不二人選了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070623
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070623,
					"content": "在古時，與花靈同行的人類勇士，會為流散在沙漠中的花靈舉行淨罪的儀式，將她們帶回花海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070624
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070624,
					"content": "而這些與花靈建立起了特殊連結的人，便被稱為「謁頌主」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070625
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070625,
					"content": "這跟斯露莎說得也太不一樣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070626,
					"content": "#哎呀哎呀，這樣也算是歪打正著了。作為「謁頌主」，{F#妳}{M#你}們可是肩負著救助失落花靈的責任呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070627
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070627,
					"content": "若是再遇到那樣的「靈谷木」，便拜託將其結出的「淨光翎」帶回花海來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070628
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070628,
					"content": "就算妳不這樣說，我們也是會幫助那些花靈的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070610,
					"content": "供奉到「甘露池」的也是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070611
					]
				},
				{
					"id": 733070611,
					"content": "「淨光翎」是神鳥「西摩格」的靈光所化，而我們花靈最初也是因著靈光與甘露的結合而誕生的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070612
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070612,
					"content": "也正因此我們才被稱為靈光的後嗣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070613
					],
					"speakerTitle": "祖爾宛"
				}
			]
		},
