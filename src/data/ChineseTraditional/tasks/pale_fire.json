			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖爾宛",
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733070401,
					"content": "嗯，流散在大地上的花靈，似乎都已經回到花海來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070402
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070402,
					"content": "#真是辛苦{F#妳}{M#你}們了，不愧是被斯露莎選定的「謁頌主」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070403
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070403,
					"content": "前輩這話我就當作是誇我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070404
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733070404,
					"content": "嘿嘿，花海看起來也熱鬧了很多的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070405,
					"content": "接下來只要再解決掉那個大窟窿，這裡就能恢復生機了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070406,
					"content": "不過話說回來還真是神奇，既然花靈本來都是從水裡面誕生的，那樣的話不是應該叫「水靈」才對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733070407,
					"content": "白飄飄怎麼還幫我們亂取名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070408
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733070408,
					"content": "呵呵，不過說到「水靈」，我倒是想起了一些過去的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070409,
						733070410
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070409,
					"content": "關於「水靈」的事情嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070411
					]
				},
				{
					"id": 733070411,
					"content": "很久很久以前，曾有許多來自異鄉的純水之靈穿越重重阻隔來到這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070412
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070412,
					"content": "那時花海外除了黃沙之外，尚有不少魔物肆虐。對於這些水之親眷而言，這番旅途想必也很辛苦吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070413
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070413,
					"content": "雖然她們似乎是為了那位已歿之神而來，但結果卻並沒有在這裡找到她們想要的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070414
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070414,
					"content": "在看到萬種母樹的模樣後，她們很快便四散離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070415
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070415,
					"content": "後來，純水之靈的傳說流傳開來，又有很多異國之人，沿著她們所走過的道路行進，試圖尋找她們的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070416
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070416,
					"content": "雖說最初不過是以訛傳訛，不過久而久之，這條道路本身也被賦予了捨棄自我，尋找純真之類的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070417
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070417,
					"content": "即便後來花海不再對外開放，他們的朝聖之旅也持續了相當長的一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070418
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070418,
					"content": "或許對於他們而言，比起到達終點，旅途的過程可能更有意義吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070419
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070419,
					"content": "就像是比起一勞永逸的犧牲，為了使命而努力的過程才更有意義一樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733070420
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 733070420,
					"content": "怎麼說到最後，結果又落到我頭上了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 733070410,
					"content": "希望不會太長…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733070411
					]
				}
			]
		},
