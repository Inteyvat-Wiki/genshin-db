			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3540401,
					"content": "#願風神護佑{F#妳}{M#你}，陌生人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540402
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540402,
					"content": "我是西風騎士團偵察騎士，安柏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540403
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540403,
					"content": "#{F#妳}{M#你}不是蒙德市民吧？那麼，請說明自己的身分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540404
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540404,
					"content": "冷靜一下，我們不是可疑人員——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3540405,
					"content": "可疑人員都會這麼說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540406
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540406,
					"content": "#妳好，我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540407
					]
				},
				{
					"id": 3540407,
					"content": "…聽著不像是本地人的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540408
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540408,
					"content": "還有這隻…吉祥物，又是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540409,
						3540412
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540409,
					"content": "是朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540410
					]
				},
				{
					"id": 3540410,
					"content": "嗯，雖然是認識才兩個月的旅伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3540411,
					"content": "但已經是最好的朋友了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3540414,
					"content": "總而言之，是旅行者對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540415
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540415,
					"content": "#最近蒙德周圍有巨龍出沒，{F#妳}{M#你}們還是盡快進城比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540416
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540416,
					"content": "#這裡離蒙德不遠，就由身為騎士的我來護送{F#妳}{M#你}們一程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540417
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540417,
					"content": "欸？妳出城沒有什麼別的任務嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3540418,
					"content": "#當然有，不過放心，任務路上也會保證{F#妳}{M#你}們的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540419
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540419,
					"content": "而且…我也不能放著可疑人士不管！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540420,
						3540421
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540420,
					"content": "看來妳不是很信任我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540422,
					"content": "呼…失禮了，這不是一位優秀的騎士應有的言辭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540423
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540423,
					"content": "#我向{F#妳}{M#你}們致歉，呃…陌生而可敬的旅人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540424
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540424,
					"content": "好生硬的發言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3540425,
					"content": "妳是對我們《騎士團指導手冊》裡的規範用語有什麼不滿嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 3540421,
					"content": "這種稱呼對客人不禮貌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540422
					]
				},
				{
					"id": 3540412,
					"content": "是應急食品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3540413
					]
				},
				{
					"id": 3540413,
					"content": "完全不對！怎麼還不如吉祥物啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3540414
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}