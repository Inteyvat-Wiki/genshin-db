			"dialogs": [
				{
					"id": 700160101,
					"content": "…Yaya dala?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160102
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700160102,
					"content": "Mimi tomo, mimi mosi mita, Muhe mita?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160103
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700160103,
					"content": "Mita…? Gusha… Dada ika odomu Plata mimi, mimi mosi gusha…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160104
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700160104,
					"content": "Mimi tomo, mimi plata yaya ika! Mimi mani ye!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160105
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700160105,
					"content": "Mani…? Dada! Kundala zido mi, mi dada, mimi tomo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160106
					],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700160106,
					"content": "他們兩個聊得很開心的樣子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160107,
						700160108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700160107,
					"content": "不愧是馬斯克小姐。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700160109
					]
				},
				{
					"id": 700160109,
					"content": "其實它只是不愛說話而已，不過我已經問到需要的資訊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160110
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700160110,
					"content": "#幫助它打敗敵人就好，接下來就交給{F#妳}{M#你}們啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700160111
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700160111,
					"content": "Dada, Valo!",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "丘丘人"
				},
				{
					"id": 700160108,
					"content": "對話進行得很順利呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700160109
					]
				}
			]
		},
