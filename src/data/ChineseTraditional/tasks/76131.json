			"dialogs": [
				{
					"id": 761310701,
					"content": "咦？這個東西好像還能用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310702,
					"content": "會不會有什麼情報呢？打開看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310703,
					"content": "這就是那隻星空生物傳遞給龍族的訊息嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310704,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310705
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310705,
					"content": "所以說望月者計畫，指的就是把這樣的訊息重新發送入宇宙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310706,
					"content": "只是這樣的話，用那座「伊比尼伯龍之眼」就可以辦到吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310707,
					"content": "是不是還有什麼內容我漏看了？我再檢查一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310708,
					"content": "嗚哇！末尾果然還有一段註腳！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310709,
					"content": "「給我的『女兒』，寧寧」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310710,
					"content": "寧寧？！等等…黑蛋，你是盧沙里姆的女兒？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310711,
					"content": "那你怎麼也變成了現在這個樣子？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310712,
					"content": "怎麼會…我不知道…我沒有這些記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310713
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310713,
					"content": "我們得去月心那裡看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310714
					]
				},
				{
					"id": 761310714,
					"content": "那、那哥倫比婭呢？還沒找到她消失的線索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310715,
					"content": "她的消失或許也和月心有關。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310716
					]
				},
				{
					"id": 761310716,
					"content": "對哦，她前面說的熟悉的感覺，也只可能是月心了…我們快走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
