			"dialogs": [
				{
					"id": 761310501,
					"content": "咦？重力好像變正常了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310502,
					"content": "哥倫比婭！妳回來了！是妳解決了剛才的問題嗎？真是太及時了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310503,
					"content": "我們真是好擔心，妳去了哪裡啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310504,
					"content": "妳還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310505
					]
				},
				{
					"id": 761310505,
					"content": "很抱歉，我沒想到這個基地的深處居然通向了月心。那裡凝聚了濃度極高的古月之力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310506
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310506,
					"content": "之前我用月矩力滲透這座基地的時候無意中觸碰到了，因此被那股力量捲入了月心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310507
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310507,
					"content": "果然是去了月心…我差點以為這座基地鬧鬼了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310508,
					"content": "總之妳沒事就太好了。我們剛才發現了望月者計畫的新線索，是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310509,
					"content": "派蒙，我已經在月心知曉了真相…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310510
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310510,
					"content": "寧寧，我也知道你是誰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310511
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310511,
					"content": "看來我的使命就在那裡，請帶我去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310512
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310512,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310513
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310513,
					"content": "怎麼了嗎？哥倫比婭？妳看起來不想讓寧寧這麼做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310514,
					"content": "寧寧她…無法在月心的環境中生存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310515
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310515,
					"content": "但我必須完成使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310516
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310516,
					"content": "你的使命不在那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310517
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310517,
					"content": "什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310518
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310518,
					"content": "嗯，你的使命不在月心。你的使命在最初的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310519
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310519,
					"content": "是…「伊比尼伯龍之眼」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310520,
					"content": "對，你的使命，是啟動「伊比尼伯龍之眼」的望月者計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310521
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310521,
					"content": "那需要一把由古月之力構成的資訊鑰匙。我可以再次前往月心，為你取來它，但這需要一些時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310522
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310522,
					"content": "妳是要我…回到「伊比尼伯龍之眼」等待嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310523
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310523,
					"content": "你覺得這樣可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310524
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310524,
					"content": "不，如果我不能親自去拿鑰匙…我就在這裡等妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310525
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310525,
					"content": "妳不回來…我就不會離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310526
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310526,
					"content": "我想在這裡…等著我的朋友回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310527
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310527,
					"content": "我知道了，謝謝你，寧寧。我很快就回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310528
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310528,
					"content": "哥倫比婭，我和妳一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310529
					]
				},
				{
					"id": 761310529,
					"content": "好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310530
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310530,
					"content": "那、那黑蛋怎麼辦？讓她一個人待在這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310531
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310531,
					"content": "別擔心，我呼喚了瑪歌，她正在過來的路上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310532
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310532,
					"content": "只是留在這裡的話，這座基地沒有別的危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310533
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310533,
					"content": "可是…我還是有點擔心，乾脆我留下來陪她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310534
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310534,
					"content": "嗯？派蒙不想去看看月心的樣子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310535
					],
					"speakerTitle": "哥倫比婭"
				},
				{
					"id": 761310535,
					"content": "我覺得黑蛋一個人在這裡會孤單的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310536
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310536,
					"content": "她是那個盧沙里姆的女兒哦…這件事她剛剛知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310537
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310537,
					"content": "這種消息一定需要好好消化一下吧？萬一胡思亂想，跑到危險的地方去就不好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310538
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310538,
					"content": "所以，我還是在這裡陪她等瑪歌來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310539
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310539,
					"content": "#{F#妳}{M#你}們在裡面看見了什麼，回來告訴我就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310540
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310540,
					"content": "謝謝妳，派蒙。我會再多給妳一點尊重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310541
					],
					"speakerTitle": "黑蛋"
				},
				{
					"id": 761310541,
					"content": "那我就再多給你一份零食吧，現在是你三我七了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310542
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310542,
					"content": "派蒙這次有了姐姐的樣子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761310543
					]
				},
				{
					"id": 761310543,
					"content": "嘿嘿，怎麼不是呢？我可以算看著黑蛋長大的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310544
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310544,
					"content": "#好了，{F#妳}{M#你}們快去吧，早點去就早點回來，別讓我們等太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761310545
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761310545,
					"content": "#嗯，{NICKNAME}，跟我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哥倫比婭"
				}
			]
		},
