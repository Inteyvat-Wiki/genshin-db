			"dialogs": [
				{
					"id": 710570201,
					"content": "一下子就全部解決了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570202,
					"content": "老何…好強！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570203,
					"content": "嘿嘿嘿…蘑菇肉，蘑菇肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570204
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570204,
					"content": "自從吃了蘑菇肉，我腰也不疼了，手上也有勁了，嘿嘿嘿，感覺自己年輕了好幾歲啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570205
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570205,
					"content": "蘑菇肉怪比蘑菇肉好吃，蘑菇肉，愈大愈好吃…嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570206
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570206,
					"content": "難道，老何是吃了這些蘑菇肉之後才變得那麼厲害的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570207,
					"content": "#{NICKNAME}，只要吃就能變強，我們也吃幾個吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570208,
						710570210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570208,
					"content": "妳只是想吃蘑菇肉吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570209
					]
				},
				{
					"id": 710570209,
					"content": "我只是好奇是什麼味道的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570212,
					"content": "不過這下老何應該願意跟我們一起回去了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570213,
					"content": "蘑菇肉…嘿嘿，好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570214
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570214,
					"content": "老何！我們一起回營地吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570215,
					"content": "#啊？一起？好啊，{F#妳}{M#你}們也來一起吃啊，這些蘑菇肉，嘿嘿嘿，風乾之後可以吃很久…很久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570216
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570216,
					"content": "是一起回營地啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570217,
					"content": "回陰地？陰地是什麼地方，不過好呀…嘿嘿嘿…吃了蘑菇肉，我哪都能去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570218
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570218,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570219,
					"content": "#{NICKNAME}，我們還是快點把老何帶回去見瑾武姐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570210,
					"content": "不許亂吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570211
					]
				},
				{
					"id": 710570211,
					"content": "我、我知道啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570212
					],
					"speakerTitle": "派蒙"
				}
			]
		},
