				"points": []
			},
			"dialogs": [
				{
					"id": 710570601,
					"content": "蘑菇肉…嘿嘿…好好吃了一頓蘑菇肉，小蘑菇，蘑菇怪，大蘑菇…嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570602
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570602,
					"content": "老何？你臉色怎麼這麼怪啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570603
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570603,
					"content": "唉…我就知道你這傢伙肯定還活著！你們家裡人還要我辦喪事，我那個時候就說，沒見到遺體，辦什麼喪事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570604
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570604,
					"content": "臉色看起來那麼差，肯定在礦裡吃了不少苦，不過、不過活著就好呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570605
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570605,
					"content": "活得好！活的蘑菇好吃…嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570606
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570606,
					"content": "老何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570607
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570607,
					"content": "我們發現他的時候就已經是這樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570608,
					"content": "有點瘋瘋癲癲的…總是嚷嚷著要吃蘑菇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570609,
					"content": "蘑菇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570610
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570610,
					"content": "層岩巨淵下面的環境對於普通人來說很是兇險，生長的菌類和植物說不定也對人有害，所以輝山廳是嚴禁礦工進食那些東西的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570611
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570611,
					"content": "但這幾年老何一直在礦裡，這樣也是迫於無奈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570612
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570612,
					"content": "變成這種模樣，我該怎麼和他的家裡人交待呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570613,
						710570614
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570613,
					"content": "如果是蘑菇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570615
					]
				},
				{
					"id": 710570615,
					"content": "這麼說來，海迪夫說不定有什麼辦法，畢竟是須彌的學者，對蘑菇肯定有研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570616
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570616,
					"content": "#{F#妳}{M#你}們在這稍等下，我去把海迪夫叫來看看老何的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570617
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570617,
					"content": "蘑菇肉…蘑菇肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570618
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570618,
					"content": "唉，真不知道老何這樣還能不能恢復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570619,
					"content": "要是一直這樣，就算回去了，他家人也不會高興吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570620,
					"content": "寫報告寫到一半就被強行拉過來…瑾武啊，就算妳是勘探隊的安全負責人，但是耽誤我的研究進度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570621
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710570621,
					"content": "我會認真考慮減少你們部分報酬的提案的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570622
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710570622,
					"content": "報酬的問題怎麼樣都好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570623
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570623,
					"content": "你先看一下這個人的情況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570624
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570624,
					"content": "耳朵好癢…嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570625
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570625,
					"content": "嗯？這是什麼人！他臉色怎麼那麼奇怪啊！",
