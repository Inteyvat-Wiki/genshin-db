			},
			"dialogs": [
				{
					"id": 710570133,
					"content": "背後突然傳來話語聲：\\n「嘿嘿嘿…蘑菇肉…嘿嘿嘿…」",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710570101
					]
				},
				{
					"id": 710570101,
					"content": "#{F#妳}{M#你}們，嘿嘿嘿，怎麼會出現在這裡呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570102
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570102,
					"content": "嗚哇！這人的臉色好奇怪啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570103,
					"content": "#而且，{NICKNAME}，這個人從背後靠近的時候沒發出一點聲音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570104,
					"content": "不會是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570105,
					"content": "應該不是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570106
					]
				},
				{
					"id": 710570106,
					"content": "#嘿嘿嘿…{F#妳}{M#你}們怎麼…在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570107
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570107,
					"content": "#{F#妳}{M#你}們的吃的，也吃光了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570108
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570108,
					"content": "難道你就是老何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570109
					]
				},
				{
					"id": 710570109,
					"content": "#啊…什麼呀？年輕人，{F#妳}{M#你}們說的啥呀，聽不清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570110
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570110,
					"content": "我們在問！你是老何嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570111,
					"content": "喔喔，是啊，嘿嘿嘿，我就是老何。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570112
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570112,
					"content": "#{F#妳}{M#你}們…不會是和我一樣被困在下面，把吃的吃光了吧…欸呀，{F#妳}{M#你}的運氣也不太好啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570113
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570113,
					"content": "嘿嘿嘿，不過沒關係，我這裡有吃的…餓了很久了吧…嘿嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570114
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570114,
					"content": "這麼說來確實有點餓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570115,
						710570116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570115,
					"content": "蘑菇肉可不能亂吃！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				},
				{
					"id": 710570117,
					"content": "對、對喔，他看起來精神恍惚，臉色還…那麼奇怪，不會就是因為吃蘑菇肉導致的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570118,
					"content": "蘑菇肉？嘿嘿嘿，蘑菇肉可好吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570119
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570119,
					"content": "#來，老何給{F#妳}{M#你}們一些蘑菇肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570120
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570120,
					"content": "嘿嘿嘿蘑菇肉…咦，怎麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570121
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570121,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570122,
					"content": "蘑菇肉，沒了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570123
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570123,
					"content": "那就不要管什麼蘑菇肉了，我們先一起回營地吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570124,
					"content": "不行，沒有蘑菇肉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570125
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570125,
					"content": "沒有蘑菇肉，就沒力氣走路，我哪也不去…沒了蘑菇肉…這裡其他地方都沒有吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570126
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570126,
					"content": "有了蘑菇肉，哪都能去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570127
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570127,
					"content": "那…哪裡有這種蘑菇肉呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570128,
					"content": "蘑菇肉…嘿嘿嘿…我知道哪裡有蘑菇肉，我們來弄些蘑菇肉吃，這樣就有力氣做事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570129
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570129,
					"content": "就在這附近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570130
					],
					"speakerTitle": "老何"
				},
				{
					"id": 710570130,
					"content": "#沒辦法了，{NICKNAME}，我們先找些蘑菇肉給他吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710570131,
					"content": "看來只能如此了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570132
					]
				},
				{
					"id": 710570132,
					"content": "蘑菇肉…嘿嘿嘿…大蘑菇肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "老何"
				},
				{
					"id": 710570116,
					"content": "別亂吃危險的東西啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710570117
					]
				}
			]
		},
