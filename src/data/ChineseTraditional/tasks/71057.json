					"nextDialogs": [
						710570637
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710570637,
					"content": "呃…我會想辦法籌給你的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710570638
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710570638,
					"content": "這點錢就不用給了，倒是我的報告又可以添一筆了。",
