	"talks": [
		{
			"id": 4005401,
			"completionStepIds": [
				4005401
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005401",
							"2"
						],
						"stepId": 4005401,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400540101,
					"content": "凱瑟琳，聽說有新委託需要我們出馬啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540102,
					"content": "#沒錯，這裡現在有一項委託人「指名」的工作要交給{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540103
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 400540103,
					"content": "「指名」？聽起來還有點緊張，是和什麼有關的工作呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540104,
					"content": "呵呵，請放心吧，這次的工作並不危險。二位或許已經有所耳聞，近期，稻妻將舉辦一場名為「光華容彩祭」的盛大祭典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540105
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 400540105,
					"content": "好耶，是祭典！說起來，我們之前還沒在稻妻參加過節日呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540106,
					"content": "此次祭典由社奉行與八重神子大人籌備，請求二位進行協助的，正是八重大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 400540107,
					"content": "原來是神子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540108
					]
				},
				{
					"id": 400540108,
					"content": "嘻嘻，神子的腦袋裡有許多稀奇古怪的主意，辦祭典一定會很有意思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540109,
					"content": "我們不如這就去鳴神大社找她，看看她到底想給我們什麼任務吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540110,
					"content": "#二位不必跑那麼遠，八重大人現在就在花見坂的八重堂。她之前交代過，讓我請{F#妳}{M#你}們到那裡與她會合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540111
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 400540111,
					"content": "原來她就在附近，那我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4005402,
			"completionStepIds": [
				4005402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005402",
							"2"
						],
						"stepId": 4005402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400540201,
					"content": "荒谷，黑田，妳們那邊情況如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540202
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540202,
					"content": "報告八重大人，八重堂的書籍與個人委託印刷物，昨天下午已經全部裝訂完畢發出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540203
					],
					"speakerTitle": "荒谷"
				},
				{
					"id": 400540203,
					"content": "嗯，不錯。村田呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540204
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540204,
					"content": "天頂屋與遠航之風發來了聯絡，《轉生成為雷電將軍，然後天下無敵》與《拜託了我的狐仙宮司》的相關物料都已經就位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540205
					],
					"speakerTitle": "村田"
				},
				{
					"id": 400540205,
					"content": "很好。小野寺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540206,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540207
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400540207,
					"content": "小、野、寺？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540208
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540208,
					"content": "啊，在…我在！報告八重大人，新刊發售會的準備一切正常！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540209
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400540209,
					"content": "小野寺，這次發售會的企劃是你提出的，換言之你就是我們的「大將」，你可要拿出點自信來啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540210
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540210,
					"content": "放心吧，這個企劃一定能大獲成功，我可是非常看好它的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540211
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540211,
					"content": "這兩天我特批你假期，你就抓緊時間好好休息一下吧，畢竟發售會當天可有你忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540212,
					"content": "八重大人，非常感謝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540213
					],
					"speakerTitle": "小野寺"
				},
				{
					"id": 400540213,
					"content": "好了，大家都清楚自己的任務了吧。時間緊急，立刻行動起來，解散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540215
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540215,
					"content": "#{F#妳}{M#你}們好啊，小傢伙們，看樣子是已經接到我的委託囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540216
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540216,
					"content": "好妳個神子，都要舉辦祭典了妳也不回鳴神大社，竟然還有功夫在這裡折騰妳的輕小說事業。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540217,
					"content": "妳找我們來，該不會是想把籌備祭典的事扔給我們代勞吧？哼，這種委託我是不會接的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540218,
					"content": "對，不會接的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540219
					]
				},
				{
					"id": 400540219,
					"content": "#哎呀呀，我真是好傷心啊，明明人家就正在為祭典的事操勞，卻被{F#妳}{M#你}們當成了不務正業。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540220
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540220,
					"content": "#小傢伙們，是誰告訴{F#妳}{M#你}們，祭典就一定會和鳴神大社有關呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540221
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540221,
					"content": "咦，難道不是這樣嗎？畢竟這裡可是稻妻呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540222,
					"content": "雖說這話是沒錯，不過現在，解除鎖國令的稻妻，已經不是從前那個渴望一成不變的國度了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540223
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540223,
					"content": "所以，比起循規蹈矩的傳統祭典，這次我與社奉行決定另闢蹊徑，打造一場既有稻妻風格，又與眾不同的國際化文化盛會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540224,
						400540225
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540224,
					"content": "國際化的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540226
					]
				},
				{
					"id": 400540226,
					"content": "呵呵，這件事就要從容彩祭的來歷說起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540227
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540227,
					"content": "傳說在古代稻妻，曾經活躍著五位能歌善賦的詩人，世人稱他們為「五歌仙」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540228
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540228,
					"content": "每年，五歌仙都會派出其中一位，將五人所作的詩集呈給將軍品鑑，此事一時傳為雅談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540229
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540229,
					"content": "託他們的福，稻妻的文化也在當時極為繁榮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540230
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540230,
					"content": "後來人們以他們為原型，創作了許多風格各異的五歌仙故事，還發展出了「容彩祭」，感謝創作為我們的生活增添樂趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540231
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540231,
					"content": "果然是個文化氣息濃郁的節日呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540232,
					"content": "嗯，用古話講就是「風雅」吧。只可惜隨著時間流逝，五歌仙與這一祭典已經逐漸被人們淡忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540233
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540233,
					"content": "所以這次，我決心重振容彩祭——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540234
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540234,
					"content": "舉辦一場以輕小說創作為核心的文化交流展！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540235
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540235,
					"content": "欸，等一下…輕小說？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540236,
					"content": "說好的「風雅」呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540237
					]
				},
				{
					"id": 400540237,
					"content": "不要露出這種難以置信的表情。在古代，詩歌也是一種流行的載體，只不過在今天，這種流行變成了「輕小說」而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540238
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540238,
					"content": "重要的不是形式，而是「創作」本身。如果一味盯著過去，拘泥於固定的形式或內容，是寫不出好作品的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540239
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540239,
					"content": "#說起來，{F#妳}{M#你}不覺得「關注當下」這個核心也很符合現在的稻妻嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540240
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540240,
					"content": "而且還能藉此機會，讓提瓦特透過輕小說重新認識稻妻，可謂一舉兩得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540241,
						400540242
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540241,
					"content": "這大概就是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540243
					]
				},
				{
					"id": 400540243,
					"content": "#嗚哇，好險…要不是{F#妳}{M#你}提醒，我就要被神子牽著走了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540244,
					"content": "哼，神子，妳可騙不了我們，憑我們對妳的瞭解，這絕對是妳基於個人趣味做出的決定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540245
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540245,
					"content": "呵呵，我從不否認自己的愛好。不過，無論小說還是祭典，以新穎的概念引人矚目都是必須的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540246
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540246,
					"content": "#怎麼樣，{F#妳}{M#你}們就不好奇，在容彩祭上能見到什麼有趣的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540247
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540247,
					"content": "唔…好奇！老實說非常好奇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540248,
					"content": "#呵呵，走，{F#妳}{M#你}們這就跟我到離島的會場去看看吧，保證能讓人耳目一新。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540249
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540249,
					"content": "而且在那邊，還有專人要講解這次的任務呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540242,
					"content": "一本正經地胡說八道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540243
					]
				},
				{
					"id": 400540225,
					"content": "文化盛會？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540226
					]
				}
			]
		},
		{
			"id": 4005403,
			"completionStepIds": [
				4005404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005404",
							"2"
						],
						"stepId": 4005404,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400540301,
					"content": "…在容彩祭期間，遠國監司周圍將會承擔輕小說的主展區功能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540302
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540302,
					"content": "屆時不僅有大量官方與同人作品參展，還有限定贈品、抽獎、新刊發售會等豐富的活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540303
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540303,
					"content": "萬國商會前的這個小廣場，祭典期間會被稱作「五歌仙廣場」，附近的店鋪將販售與輕小說聯動的特別商品，請一定不要錯過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540304
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540304,
					"content": "哇，該怎麼說呢，雖然和普通的祭典感覺不太一樣，但感到了另一種層面的厲害…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540305,
					"content": "嗯，「輕小說濃度過高」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540306
					]
				},
				{
					"id": 400540306,
					"content": "咦，神子，廣場中心這些空白的板子是什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540307,
					"content": "嗯，這些呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540308
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540308,
					"content": "#八重大人此前說會有可靠的幫手前來協助，果然是指{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540309
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400540309,
					"content": "#旅行者，派蒙，有段時間沒見了，{F#妳}{M#你}們最近可好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540310
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400540310,
					"content": "是綾人！這次的容彩祭，連你這個大忙人也親自出馬了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400540311,
					"content": "籌備祭典是社奉行分內之事，容彩祭又傾注了八重大人的心血，我也自當親力親為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540312
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400540312,
					"content": "呵呵，綾人，大家都是熟人了，幹嘛這麼客氣呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540313
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540313,
					"content": "我們剛好說到這裡的展板，它們跟小傢伙們的任務也有些關係，你就來仔細講講吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540314
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540314,
					"content": "#{F#妳}{M#你}們兩個應該已經知道容彩祭來源於五歌仙，這五塊展板，正是為了繪製他們的畫像設置的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540315
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400540315,
					"content": "此次容彩祭，不僅是稻妻解除鎖國令後的第一次大型祭典，並且還與文化藝術相關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540316
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400540316,
					"content": "因此社奉行出面，邀請了數位他國的文化名人前來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540317
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400540317,
					"content": "比如應邀繪製這幾幅畫像的，就是一位從蒙德遠道而來的畫家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540318
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400540318,
					"content": "各位嘉賓在稻妻的食宿社奉行會幫忙安排，但客人遠到異鄉，難免會不習慣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540319
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400540319,
					"content": "這時候如果能有一位既熟悉稻妻，又瞭解提瓦特其他國家的人作為接引嚮導，就再好不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540320,
						400540321
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400540320,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540322
					]
				},
				{
					"id": 400540322,
					"content": "正是。我們希望二位能從港口接引嘉賓們到萬國商會下榻，並提供適當的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540323
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400540323,
					"content": "這份「到港時刻表」上，寫明瞭嘉賓們乘坐船隻的詳細資訊，只要按照上面的時間到港口便可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540324
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400540324,
					"content": "好啦，時候不早了，我還要和編輯們開會，就先走一步囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540325
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540325,
					"content": "#祭典期間，八重堂的編輯大多都會待在遠國監司附近，{F#妳}{M#你}們如果有事就過去找他們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400540326
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400540326,
					"content": "#二位，這次祭典需三奉行通力合作，有許多瑣事需要處理，我也先失陪了。接引嘉賓一事，就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400540321,
					"content": "這就是我們的任務。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400540322
					]
				}
			]
		}
	]
}