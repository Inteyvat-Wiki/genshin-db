			},
			"dialogs": [
				{
					"id": 402260101,
					"content": "旗艦…這個參展方的人應該是在辦理住宿吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260102,
					"content": "搭檔！還有派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260103
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 402260103,
					"content": "是娜維婭，好久不見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260104,
						402260105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260104,
					"content": "如果我沒猜錯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				},
				{
					"id": 402260106,
					"content": "對啊，刺玫會也是參展方之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260107
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 402260107,
					"content": "哦…那位主宰地下世界的黑道老大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260108,
					"content": "哦…那位主宰地下世界的黑道老大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260109,
					"content": "哈哈，這是對我的新稱呼嗎？聽起來滿酷的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260110
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 402260110,
					"content": "我們接受了一項委託，具體就是幫忙登記參展人員還有核對參展貨物之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260111,
					"content": "是這樣啊，坐下聊吧。我正好點了一桌好吃的，克洛琳德和夏沃蕾放完東西也會出來會合。噢！剛說到她們就來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260112
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 402260112,
					"content": "在介紹我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260113
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 402260113,
					"content": "克洛琳德和夏沃蕾也來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260114,
					"content": "挪德卡萊秩序混亂，十分危險，考慮到刺玫會對於楓丹的意義，我可不希望它的現任會長在這裡出事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260115
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 402260115,
					"content": "憑我的身手，我可想像不到自己能出什麼事，不過和朋友們一起出來旅行還是很有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260116
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 402260116,
					"content": "我就說妳的心態太鬆弛了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260117
					],
					"speakerTitle": "克洛琳德"
				},
				{
					"id": 402260117,
					"content": "好吧，重新向各位介紹，我現在的保鏢是全楓丹最厲害的決鬥代理人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260118
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 402260118,
					"content": "黑道老大和她的保鏢…登記好了，夏沃蕾呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260119,
					"content": "就不用登記我了，我是來處理公務的，最近的很多大案都與挪德卡萊有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260120
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402260120,
					"content": "噢噢，那我就不多問了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260121,
					"content": "對了，刺玫會用來參展的貨物也需要登記一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260122,
					"content": "就是這個——楓丹科學院新研究出來的一種荒芒中繼系統，透過控制它，就可以使用荒芒能量進行戰鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260123
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 402260123,
					"content": "這麼說…是一種武器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260124,
					"content": "在一個沒有法律限制的市場裡，武器自然是最搶手的貨物之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260125
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 402260125,
					"content": "的確是這個道理，不過這種話當著夏沃蕾的面說，總感覺怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260126,
					"content": "無妨，我在犯罪小說裡讀到過很多有關「法外之地」的描寫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260127
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402260127,
					"content": "作為一名警探，如果想在這種地方辦事，最重要的一點就是暫時放下成規。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260128
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402260128,
					"content": "那麼，我就先告辭了，隊員們還在等我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260129
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 402260129,
					"content": "如果接下來方便的話，我們可以帶妳們去會場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260130,
					"content": "好啊，那現在就去吧，我也想看看有沒有自己想買的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 402260105,
					"content": "…妳們也是來參展的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402260106
					]
				}
			]
		},
