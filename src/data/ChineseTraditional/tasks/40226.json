			"dialogs": [
				{
					"id": 402260201,
					"content": "#娜維婭和克洛琳德在{F#妳}{M#你}們的帶領下來到展會現場。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402260202
					]
				},
				{
					"id": 402260202,
					"content": "比我想像的大多了，不過人還不多，不夠熱鬧啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260203
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 402260203,
					"content": "應該是因為展會還沒有正式開始吧，看來雅珂達那邊要幫忙的事還不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402260204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402260204,
					"content": "#那這邊就交給我和克洛琳德吧。等{F#妳}{M#你}們空閒了，也歡迎來體驗我們的展品哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜維婭"
				}
			]
		}
	]
