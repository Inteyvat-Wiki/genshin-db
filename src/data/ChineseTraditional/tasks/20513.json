			"dialogs": [
				{
					"id": 205130301,
					"content": "#{F#妳}{M#你}找到東西了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130302
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130302,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130303
					]
				},
				{
					"id": 205130303,
					"content": "咦？這株風車菊，總感覺和普通的風車菊不一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130304
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130304,
					"content": "哈哈哈，不知道為什麼，我有一種這副藥吃下去，安娜的病就會好起來的感覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130305
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130305,
					"content": "也許是因為安娜的身體突然有了起色，我樂觀過頭了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130306
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130306,
					"content": "#總之，辛苦{F#妳}{M#你}了，這些是給{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130307
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130307,
					"content": "希望安娜能好起來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130308
					]
				},
				{
					"id": 205130308,
					"content": "#謝謝{F#妳}{M#你}，她一定會好起來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130309
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130309,
					"content": "我一直這麼相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
