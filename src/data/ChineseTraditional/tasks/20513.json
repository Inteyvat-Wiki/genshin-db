			},
			"dialogs": [
				{
					"id": 205130101,
					"content": "這次的還挺正常…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130102
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130102,
					"content": "#{F#妳}{M#你}這不是挺好的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130103
					]
				},
				{
					"id": 205130103,
					"content": "是啊，哎呀，果然是我自己嚇自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130104
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130104,
					"content": "安娜的身子也逐漸有起色了，那位神醫真是有本事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130105
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130105,
					"content": "#{F#妳}{M#你}願意的話，能接著幫我找藥嗎？這次是「被風史萊姆吹拂過的風車菊」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130106,
						205130111,
						205130115
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130106,
					"content": "聽起來不像藥。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130107
					]
				},
				{
					"id": 205130107,
					"content": "嗯…風車菊倒是偶爾會被做成藥，不過都是治療一些輕症…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130108
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130108,
					"content": "難道風史萊姆才是關鍵，但風車菊和風史萊姆可不會經常湊在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130109
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130109,
					"content": "#還好傑克說他見過幾次這種情況，把大概位置也告訴了我。我把最近的一個地方標在{F#妳}{M#你}的地圖上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130110
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130110,
					"content": "#我可不會對付風史萊姆，它們會飛的…所以，只能拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130111,
					"content": "還挺…適合蒙德城的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130112
					]
				},
				{
					"id": 205130112,
					"content": "誰說不是呢。但風車菊和風史萊姆可不會經常湊在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130113
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130113,
					"content": "#還好傑克說他見過幾次這種情況，把大概位置也告訴了我。我把最近的一個地方幫{F#妳}{M#你}標上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130114
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130114,
					"content": "#我實在是不會對付風史萊姆，它們會飛的。所以，就拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130115,
					"content": "我再幫你抓個風史萊姆回來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205130116
					]
				},
				{
					"id": 205130116,
					"content": "#我說啊，{F#妳}{M#你}純粹就是想看熱鬧吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130117
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130117,
					"content": "不過，風車菊和風史萊姆確實不會經常湊在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130118
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130118,
					"content": "#還好傑克說他見過幾次這種情況，把大概位置也告訴了我。我把最近的一個地方幫{F#妳}{M#你}標上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205130119
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205130119,
					"content": "#如果實在找不到。那{F#妳}{M#你}就抓個風史萊姆回來吧！為了安娜，我什麼都會做…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				}
			]
		},
