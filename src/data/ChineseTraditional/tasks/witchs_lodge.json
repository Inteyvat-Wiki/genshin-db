						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5482.98,
							194.651,
							9710.385
						],
						"pointId": 14939
					},
					{
						"sceneId": 3,
						"position": [
							5480.907,
							194.819,
							9712.115
						],
						"pointId": 14940
					},
					{
						"sceneId": 3,
						"position": [
							5481.945,
							194.575,
							9709.521
						],
						"pointId": 14942
					}
				]
			},
			"dialogs": [
				{
					"id": 766730201,
					"content": "#年輕人驚嘆於魔女的高貴與美麗，許久的沉默過後，{M#他}{F#她}鄭重地對魔女開口——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730202
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730202,
					"content": "「悠遠的魔女、昳麗的魔女、富有智慧的魔女！一見到您，我就忍不住心旌搖盪。我願以您的願望為我的願望。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730203
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730203,
					"content": "#魔女的臉上露出不易察覺的笑容：「既然這樣，那就替我完成一些力所能及的事情吧。指引已至，獎賞在未來等候{F#妳}{M#你}的到來。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730204
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730204,
					"content": "指引…是說這個光球嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7667303,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730301,
					"content": "「秘密小屋啊，」年輕人的眼中流露出疑惑，「小屋在哪呢？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730302
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730302,
					"content": "聽到年輕人的問題，魔女的聲音少見地出現了些許慌亂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730303
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730303,
					"content": "（等下，她是這種嬌羞的角色嗎？算了先這樣設定好了，九老師會幫忙潤色的。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730304
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730304,
					"content": "#「咳咳，年輕人，不要問這麼失禮的問題。魔女小屋正在修建當中，很快{F#妳}{M#你}就會被它的華麗驚掉下巴。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730305
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730305,
					"content": "#「這是給{F#妳}{M#你}的考驗，為建設大魔女的領土貢獻{F#妳}{M#你}的力量吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "觀察"
				}
			]
		},
		{
			"id": 7667304,
			"completionStepIds": [
				7667303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7667303",
							"2"
						],
						"stepId": 7667303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730401,
					"content": "#「好了，年輕人。如今{F#妳}{M#你}已經知曉了魔女的煩惱，尼古拉·可可正在建設她神聖的領地，需要{F#妳}{M#你}的幫助。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730402
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730402,
					"content": "#魔女笑著為年輕人沏了一杯茶：「{F#妳}{M#你}的選擇是什麼？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730403,
						766730404
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730403,
					"content": "義不容辭！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730405
					]
				},
				{
					"id": 766730405,
					"content": "等一下啦！像這樣來路不明、自說自話的怪人，還是謹慎一些比較好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730406,
					"content": "咦…不過這個茶杯，總感覺看起來有點眼熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730407,
						766730408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730407,
					"content": "終於意識到了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730409,
					"content": "尼古拉·可可…啊！難道說是魔女N——尼可嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730410,
					"content": "答對了。剛剛的故事怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730411
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730411,
					"content": "怎麼樣…根本沒講完吧？後來呢？年輕人和魔女怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730412,
					"content": "還沒想好呢。剩下的等我的魔女小屋修好後再想吧，到時候也許會有新的靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730413
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730413,
					"content": "#既然{F#妳}{M#你}們聽到了我的聲音，就代表{F#妳}{M#你}們現在在挪德卡萊吧？能拜託{F#妳}{M#你}們幫我收集一點東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730414,
						766730416
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730414,
					"content": "什麼東西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730415
					]
				},
				{
					"id": 766730415,
					"content": "#我打算在修建小屋的同時，做一些新的雕像。不過暫時沒什麼靈感，想委託{F#妳}{M#你}們幫忙拍一些精彩的畫片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730418,
					"content": "真拿妳沒辦法，那就包在我們身上好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730419,
					"content": "妳等著，我們這就出去看看有什麼好東西。等雕塑完成後，記得把剛剛的故事講完啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730416,
					"content": "跟雕塑有關嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730417
					]
				},
				{
					"id": 766730417,
					"content": "對，我打算在修建小屋的同時，做一些新的雕像。不過暫時沒什麼靈感，可以幫我拍一點畫片嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730418
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730408,
					"content": "這傢伙就是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766730409
					]
				},
				{
					"id": 766730404,
					"content": "遵從偉大魔女尼古拉·可可的指引！",
					"roleType": "TALK_ROLE_PLAYER",
