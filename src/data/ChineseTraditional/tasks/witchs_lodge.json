			"dialogs": [
				{
					"id": 766730501,
					"content": "來得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730502
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730502,
					"content": "#{F#妳}{M#你}們拍的畫片我很滿意，都是我感興趣的題材。雕刻工具我也準備好了，一起來試一試？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730503
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730503,
					"content": "雕刻工具…妳是說這些方塊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730504,
					"content": "沒錯，雕像就在這些石材中，我們只需要把多餘的部分去掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730505
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730505,
					"content": "#為了方便{F#妳}{M#你}們理解，我將雕刻的方法也做了「引導」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730506
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730506,
					"content": "讓我來做個示範吧。首先是大刀闊斧地勾勒出基本的造型——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730507
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730507,
					"content": "石塊上的數字就是同一列要保留的數量。像這樣…然後這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730508
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730508,
					"content": "哦！逐漸像那麼一回事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730509,
					"content": "明白了吧？雕刻成這樣，就大概能看出來基本的形狀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730510
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730510,
					"content": "之後只需要再加入一點修飾…嘿！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730511
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730511,
					"content": "等、等一下！我只是眨了一下眼，怎麼就變成這樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730512,
					"content": "這部分看看就好，偉大的魔女可不會隨便公布術法的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730513
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730513,
					"content": "#修飾的部分交給我，雕刻的手法{F#妳}{M#你}們應該看明白了吧？就拜託{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730514
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730514,
					"content": "好吧，我們試試看——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730515,
					"content": "嗚哇！這是什麼，一上來就這麼難嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730516,
					"content": "嗯？哦，抱歉抱歉，剛剛拿錯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730517
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730517,
					"content": "#這個是我要做的，{F#妳}{M#你}們的在這邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730518
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766730518,
					"content": "嚇、嚇我一跳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
