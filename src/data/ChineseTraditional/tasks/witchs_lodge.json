			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"尼可"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5481.038,
							194.726,
							9711.116
						],
						"pointId": 15006
					},
					{
						"sceneId": 3,
						"position": [
							5480.359,
							194.706,
							9710.449
						],
						"pointId": 15007
					},
					{
						"sceneId": 3,
						"position": [
							5482.168,
							194.832,
							9712.457
						],
						"pointId": 15008
					}
				]
			},
			"dialogs": [
				{
					"id": 766731132,
					"content": "接下來，只要找尼可做一點修飾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766731133,
					"content": "敲掉多餘的石塊了？我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731134
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731134,
					"content": "嘿嘿，這樣就完成啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731101
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766731101,
					"content": "咦——魔女的小屋！什麼時候出現的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766731102,
					"content": "這就是魔女的力量嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731103
					]
				},
				{
					"id": 766731103,
					"content": "「這就是魔女的力量嗎？」年輕人的表情充滿了不可思議，「真是太了不起了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731104
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731104,
					"content": "終於要講之前的故事了嗎？魔女和年輕人後來怎麼樣了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766731105,
					"content": "#{M#他們}{F#她們}開心地生活在了一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731106
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731106,
					"content": "…就是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731107
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731107,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731108,
						766731109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766731108,
					"content": "過程呢？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				},
				{
					"id": 766731110,
					"content": "#真拿{F#妳}{M#你}們沒辦法，既然{F#妳}{M#你}們這麼想聽，那我就從頭開始講好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731111
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731111,
					"content": "#自從年輕人許下「以妳的願望為我的願望」後，{M#他}{F#她}就順利地吸引了大魔女尼古拉·可可的注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731112
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731112,
					"content": "然而就在兩個人關係升溫時，卻突然闖入了一群不速之客，強行抓走了魔女！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731113
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731113,
					"content": "年輕人大驚，這時候新的魔女艾莉娜絲出現，跟年輕人簽訂了契約，讓年輕人也擁有了魔法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731114
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731114,
					"content": "在經歷了艱苦卓絕的特訓後，卻發現這背後其實是另一個陰謀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731115
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731115,
					"content": "原來大魔女尼古拉·可可其實是外星生命，是貓星國王喵特拉斯三世的大女兒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731116
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731116,
					"content": "她們偽裝成魔女，真實目的是為了讓全世界都在不知不覺中信仰貓貓星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731117
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731117,
					"content": "「偉大的魔女啊，難道您一直在欺騙我嗎？」年輕人只覺得自己心肝寸裂，聲音不由得發顫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731118
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731118,
					"content": "#「回去吧，我們貓貓星和{F#妳}{M#你}們註定會有一場戰爭，我們從一開始其實就是敵人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731119
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731119,
					"content": "魔女背過身，不讓人看到她眼中的淚花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731120
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731120,
					"content": "年輕人卻勇敢向前抓住了魔女的手腕，發誓要和她永不分開。魔女被年輕人的執著打動，決定要掀起反旗！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731121
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731121,
					"content": "就在這個時候，當初幫助年輕人的艾莉娜絲卻站在了國王那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731122
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731122,
					"content": "原來她是喵特拉斯三世的二女兒，幫助年輕人是為了促成姐姐的實質性背叛，從而爭奪王位繼承權——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731123
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731123,
					"content": "尼可滔滔不絕地講述了曲折的過程，其中充滿了各種奇怪的情節，最後甚至連主角都脫離了人類的範疇…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						766731124
					]
				},
				{
					"id": 766731124,
					"content": "總之就是這樣啦。最後變成貓的年輕人和魔女一同粉碎了陰謀，回到了魔女小屋，過著與世隔絕的平靜生活。全劇終。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731125
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731125,
					"content": "嗚嗚…真好啊，充滿愛與反抗的旅程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766731126,
					"content": "感覺和開頭已經是兩個故事了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731127
					]
				},
				{
					"id": 766731127,
					"content": "沒辦法，任何事物一旦被創造出來，終有一天都會脫離創造者的掌控。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731128
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731128,
					"content": "就像我們「天使」，曾經被賦予引導人類的職責，卻因為部分天使選擇了「另一條路」，最終整個族群受到懲罰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731129
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731129,
					"content": "就算是天理，也無法完全掌控它創造的東西…何況我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731130
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731130,
					"content": "命運就是那麼不可言說，不過嘛…我還是希望引導我所見到的人，獲得一個美好的結局，哪怕是故事中的人也一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731131
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731131,
					"content": "#好了，這個故事講完，我的熱情也燃盡了。下次有好的故事，再分享給{F#妳}{M#你}們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731135
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731135,
					"content": "原來她是喵特拉斯三世的二女兒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731136
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731136,
					"content": "幫助年輕人是為了促成姐姐的實質性背叛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766731137
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731137,
					"content": "從而爭奪王位繼承權——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				},
				{
					"id": 766731109,
					"content": "中間省略太多了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766731110
					]
				}
			]
		},
