			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 766730901,
					"content": "尼可，我們回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730902,
					"content": "#這麼快！真不愧是{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730903
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730903,
					"content": "過獎啦，不過畫片要怎麼給妳呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766730904,
					"content": "#{F#妳}{M#你}們先帶在身上吧。大概兩天後我會到達那裡，到時候我們可以一起聊聊有關雕塑的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730905
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730905,
					"content": "好啊，那我們不見不散！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7667310,
