				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 3,
						"position": [
							5461.151,
							198.892,
							9742.186
						],
						"pointId": 14953
					}
				]
			},
			"dialogs": [
				{
					"id": 766730101,
					"content": "#年輕人繼續走著，{M#他}{F#她}留意到魔女的領土上有許多巧奪天工的雕塑。「這是什麼？」年輕人不解地詢問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730102
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730102,
					"content": "「這些都是魔女的反對者，它們覬覦魔女的力量，所以被變成了石頭。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730103
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730103,
					"content": "這個設定不錯——雖然是我現在想到的。魔女就應該是既強大又危險的存在…危險帶來神秘，沒有神秘，世間的一切都會黯淡無光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730104
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730104,
					"content": "（不過動輒把人變成石頭會不會太過分了？沒人願意跟這樣的怪人長期相處吧？還是把剛剛說的話當做警告好了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730105
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730105,
					"content": "聽完之後，年輕人冷汗直流。就在這時，魔女的笑聲再次響起：「呵呵，當真了嗎？不過是以雕塑來定格時光而已。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766730106
					],
					"speakerTitle": "觀察"
				},
				{
					"id": 766730106,
					"content": "#「雕塑——這就是我需要{F#妳}{M#你}幫我完成的事情，魔女的小屋缺少更多可愛的小傢伙。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "觀察"
				}
			]
		},
		{
			"id": 7667302,
			"completionStepIds": [
				7667302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
