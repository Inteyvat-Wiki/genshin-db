						80060504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80060503,
					"content": "我知道這是什麼花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				},
				{
					"id": 80060505,
					"content": "#欸，{F#妳}{M#你}這麼一說，我也覺得有些眼熟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80060506,
					"content": "是坎瑞亞的國花——「因提瓦特」。曾盛放在坎瑞亞大地的每一個角落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060507
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060507,
					"content": "這種花的花期原本只有兩週。可是若被人折下、帶離坎瑞亞的土地，花瓣便不再生長，而且變得十分堅硬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060508
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060508,
					"content": "直至回到故土之中，花瓣才會重新變得柔軟，最終泯於塵土…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060509
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060509,
					"content": "所以，因提瓦特也象徵「遊子」，寓意著「故鄉的溫柔」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060510
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060510,
					"content": "#{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_Twins2Male|INFO_FEMALE_PRONOUN_Twins2Female]}",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060511
					]
				},
				{
					"id": 80060511,
					"content": "啊！那這種花出現在這裡，也就是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80060512,
					"content": "#{F#王子}{M#公主}殿下，您終於同意了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060513
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80060513,
					"content": "過分專注地投入對抗「天理」之大業，反而淡忘了「復國」的使命。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060514
					]
				},
				{
					"id": 80060514,
					"content": "的確，我不該如此優柔寡斷。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060515
					]
				},
				{
					"id": 80060515,
					"content": "「裝置」即將完備，等待殿下您的吩咐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060516
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80060516,
					"content": "有多少把握？",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060517
					]
				},
				{
					"id": 80060517,
					"content": "理論上的可行性，大概…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060518
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80060518,
					"content": "算了，哪怕只有百分之一的希望…",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060519
					]
				},
				{
					"id": 80060519,
					"content": "我們不也是一樣嗎，早已身處深淵了。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060520
					]
				},
				{
					"id": 80060520,
					"content": "對「他們」而言，與其活得毫無尊嚴，還不如早日回到「循環」之中。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060521
					]
				},
				{
					"id": 80060521,
					"content": "不要讓「他們」繼續背負…那些莫須有的罪孽了。",
					"roleType": "TALK_ROLE_MATE_AVATAR",
					"nextDialogs": [
						80060522
					]
				},
				{
					"id": 80060522,
					"content": "您的決斷，是教團的幸運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060523
					],
					"speakerTitle": "深淵使徒"
				},
				{
					"id": 80060523,
					"content": "#{F#哥哥}{M#熒}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060524
					]
				},
				{
					"id": 80060524,
					"content": "#{F#妳}{M#你}似乎看到了什麼。能說給我聽聽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060525
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060525,
					"content": "#是呀，{F#妳}{M#你}好像愣神了好久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80060526,
					"content": "將剛剛看到的畫面告訴了戴因斯雷布…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						80060527
					]
				},
				{
					"id": 80060527,
					"content": "這是僅屬於「雙子」的奇妙連接嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060528
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060528,
					"content": "聽起來，他們試圖利用某些裝置淨化詛咒，可能就是之前我們看到過的那件物品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060529
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060529,
					"content": "#而且…{F#他}{M#她}還提到了「復國」，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060530,
						80060531
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060530,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060532,
					"content": "這個頑固的傢伙，果然還沒有放棄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060533
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060533,
					"content": "看來，教團計畫藉這一地點淨化丘丘人身上的詛咒，想令他們復原…從而作為坎瑞亞復國的根基。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060534
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060534,
					"content": "畢竟，沒有「國民」，便談不上「國家」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060535,
						80060536
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060535,
					"content": "你怎麼看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060537,
					"content": "哼，愚昧至極。連百分之一的可能性都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060538
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060538,
					"content": "我應該說過，作為與詛咒共處了五百年的人，沒有人比我更明白…絕不存在什麼救贖。詛咒是不可逆的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060539
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060539,
					"content": "強行祛除詛咒的話，除了痛苦，什麼都不會得到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060540
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060540,
					"content": "所以，要保持清醒，要反覆告誡自己——那些已經不是人類了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060541
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060541,
					"content": "執著於此，投入過多感情，只會愈陷愈深…最終像它們一樣，陷入名為偽善的汙泥之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060542
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060542,
					"content": "還是把心思放在更值得拯救的東西上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060543
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060543,
					"content": "我憑什麼相信你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060544
					]
				},
				{
					"id": 80060544,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060545
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060545,
					"content": "#哈哈…也對。我們之間不過是雇傭關係，而{F#他}{M#她}是{F#妳}{M#你}的血親。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060546
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060546,
					"content": "#{F#妳}{M#你}選擇站在{F#他}{M#她}身邊，於情於理，確實沒有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060547
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060547,
					"content": "#不論{F#妳}{M#你}做出何種選擇，都不會撼動我的本心。阻止深淵是我所認定的路，如果無法達成共識，那不妨就此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060548
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060548,
					"content": "我這次選擇相信你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060549,
						80060550
					]
				},
				{
					"id": 80060549,
					"content": "但不代表我完全信任你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060551,
					"content": "這樣嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060552,
						80060553
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060552,
					"content": "百分之一的機會得到救贖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060554,
					"content": "沒有任何人有資格…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060556,
					"content": "更何況那些丘丘人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060558,
					"content": "#看來，我當初問{F#妳}{M#你}的三個問題不是沒有意義的。{F#妳}{M#你}已經找到獨屬於{F#妳}{M#你}的，看待這個世界的方法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060559
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060559,
					"content": "#既然{F#妳}{M#你}吐露了真實想法，我也不打算繼續隱瞞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060560
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060560,
					"content": "目前，比起單純地阻止深淵，我更加在乎的是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060561
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060561,
					"content": "絕不能允許深淵以如此獨斷的行為，來踐踏哈夫丹他們的「遺願」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80060562,
						80060563
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060562,
					"content": "我能理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060564,
					"content": "深淵隨時可能出現，保持警惕，繼續前進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80060563,
					"content": "繼續聯手吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060564
					]
				},
				{
					"id": 80060557,
					"content": "原本已經選擇好了自己的歸宿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060558
					]
				},
				{
					"id": 80060555,
					"content": "代替其他生命做出這樣的選擇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060556,
						80060557
					]
				},
				{
					"id": 80060553,
					"content": "百分之九十九的可能痛苦死去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060554,
						80060555
					]
				},
				{
					"id": 80060550,
					"content": "#只是因為我不認同{F#哥哥}{M#熒}的做法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060551
					]
				},
				{
					"id": 80060536,
					"content": "有機會實現嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060537
					]
				},
				{
					"id": 80060531,
					"content": "#{F#他}{M#她}說這是使命。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060532
					]
				},
				{
					"id": 80060504,
					"content": "我見過這種花。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80060505
					]
				}
			]
		}
	]
}