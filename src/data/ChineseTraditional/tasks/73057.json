			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570101,
					"content": "唔，不見了…也是呢，他不記得我們曾經一起冒險了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570102,
						730570103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570102,
					"content": "不要灰心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570104
					]
				},
				{
					"id": 730570104,
					"content": "#嗯，{F#妳}{M#你}說得對…唔，對喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570105,
					"content": "上次蘭納真不是教給過我們一首曲子嗎！我們彈奏一下，說不定他能認出來呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570106,
						730570108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570106,
					"content": "妳說的很有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570107
					]
				},
				{
					"id": 730570107,
					"content": "嘿嘿，因為我是派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570108,
					"content": "難得有用的提議呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570109
					]
				},
				{
					"id": 730570109,
					"content": "#{F#妳}{M#你}也太欺負人啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570103,
					"content": "我們還可以重新交朋友的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570110
					]
				}
			]
		},
		{
			"id": 7305702,
			"completionStepIds": [
				7305707
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305707",
							"2"
						],
						"stepId": 7305707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"蘭納真"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570201,
					"content": "哈哈，他來啦！你好呀，小東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570202,
					"content": "蘭納真不是小東西！妳這個飛飛的白傢伙才是小東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570203
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570203,
					"content": "#…話說回來，金色的「沙」…那菈，{F#妳}{M#你}們為什麼會彈這首曲子呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570204
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570204,
					"content": "這個嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570205,
						730570207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570205,
					"content": "是你教給我們的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570206
					]
				},
				{
					"id": 730570206,
					"content": "對呀，這首曲子是我們上一次在一起冒險時，你教給我們的呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570209,
					"content": "#這樣…嗎？哼，蘭納真不聰明，但{F#妳}{M#你}們看起來不像「沙子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570210
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570210,
					"content": "嗯！「沙子」是「巴螺迦」，是壞蛋那菈。而我們呢，是好那菈！你告訴我們的嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570211,
					"content": "#欸！我還和{F#妳}{M#你}們說過這些嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570212
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570212,
					"content": "#哈哈，對呀！{NICKNAME}，我們把之前的故事再給他講一遍吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570213,
					"content": "#{F#妳}{M#你}們為蘭納真複述了一同冒險，最終平息「死域」的經歷。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730570214
					]
				},
				{
					"id": 730570214,
					"content": "…這樣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570215
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570215,
					"content": "#蘭納真不聰明，但{F#妳}{M#你}們說的，應該是真的。蘭納真不記得了，對不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570216
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570216,
					"content": "沒有必要對不起呀！唔，記不得事情很正常啦…況且，我們還可以重新交朋友呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570217,
						730570218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570217,
					"content": "蘭納真是個好孩子呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570220
					]
				},
				{
					"id": 730570220,
					"content": "唔…既然是好夥伴，那就請跟我來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570221
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570221,
					"content": "欸？可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570222,
					"content": "金色的那菈，白色的飛飛！來我的住處吧，跟我來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570218,
					"content": "派蒙是個好孩子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570219
					]
				},
				{
					"id": 730570219,
					"content": "嘿嘿，那還用說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570207,
					"content": "為了見到你，我特地彈了這首曲子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570208
					]
				},
				{
					"id": 730570208,
					"content": "#嘿嘿，{NICKNAME}彈得怎麼樣？我們還記得你教的曲譜喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570209
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7305703,
