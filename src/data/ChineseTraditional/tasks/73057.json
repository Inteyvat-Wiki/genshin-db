						"stepId": 7305714,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭納真",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570601,
					"content": "樓上還有那菈留下的葉子，但是…我看不懂，看不明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570602
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570602,
					"content": "那個是…那菈用來留下記憶的葉子，在這樣的葉子上面寫下文字，收攏在一起。但那菈的文字，蘭納真不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570606
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570606,
					"content": "你是不是說…「記事本」呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570603,
					"content": "「記事本」…？那就是那菈用來留下記憶的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570604
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570604,
					"content": "嗯，是呀…蘭納真介意我們上樓去，一起看看裡面寫了什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570605,
					"content": "我嗎？不介意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭納真"
				}
			]
		},
		{
			"id": 7305707,
			"completionStepIds": [
				7305706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7305706",
							"2"
						],
						"stepId": 7305706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭納真",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730570701,
					"content": "#裡面有什麼樣的記憶呢？{F#妳}{M#你}們看到什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570702
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570702,
					"content": "記事本的主人似乎認識你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570703
					]
				},
				{
					"id": 730570703,
					"content": "這樣嗎…我不記得了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570704
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570704,
					"content": "他說…他也看不見你了，是因為長大了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570705,
					"content": "唔…長大還真是會有很多苦惱呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570706,
					"content": "對了，他還在記事本裡說…這朵花留給你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570707,
					"content": "在這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730570708
					]
				},
				{
					"id": 730570708,
					"content": "#咦…？呀！這是很重要的花！{F#妳}{M#你}怎麼會…他怎麼會有的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570709
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570709,
					"content": "同樣的花，其實你也給過我們喔…只是你不記得了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570710,
					"content": "#這樣嗎…我能和{F#妳}{M#你}們重新做朋友。可是…他的話，我連他的樣子都記不得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570711
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570711,
					"content": "沒、沒關係啦…你不要傷心呀，我們還有這朵花，一定能給你更多回憶的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730570712,
					"content": "嗯，白飛飛說得對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570713
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570713,
					"content": "我要把這朵花帶回去，「無郁夷摩」應該知道怎樣才能讓她醒來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570714
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570714,
					"content": "#唔…那菈{NICKNAME}和白飛飛，我要回蘭納迦那邊了，把她種下，聽她的歌。如果{F#妳}{M#你}們有空的話，也請來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730570715
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730570715,
					"content": "嗯嗯，一定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
