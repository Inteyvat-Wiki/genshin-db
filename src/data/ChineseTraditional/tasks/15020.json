			"dialogs": [
				{
					"id": 150200401,
					"content": "#居然用這麼短的時間就清理完了…真不愧是{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200402
