			"dialogs": [
				{
					"id": 150200801,
					"content": "#嗯？恰斯卡、{NICKNAME}，{F#妳}{M#你}們也來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200802
					],
					"speakerTitle": "阿爾帕"
				},
				{
					"id": 150200802,
					"content": "阿爾帕長老？咦？他們說的絨翼龍呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150200803,
					"content": "已經先我們一步飛走了，看來是知道救兵要到，率先撤退了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200804
					],
					"speakerTitle": "阿爾帕"
				},
				{
					"id": 150200804,
					"content": "那牠突然襲擊人類的目的…是商隊運送的食物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200805
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200805,
					"content": "不，這支商隊運送的不是食物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200806
					],
					"speakerTitle": "阿爾帕"
				},
				{
					"id": 150200806,
					"content": "——哦！謝天謝地！「燃素翼」都沒事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200807
					],
					"speakerTitle": "年輕的行商"
				},
				{
					"id": 150200807,
					"content": "…「燃素翼」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200808
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200808,
					"content": "唉呀，太感謝了。這批「燃素翼」是我們最重要的貨物，萬一有什麼閃失還真不知道該怎麼辦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200809
					],
					"speakerTitle": "伊西多爾"
				},
				{
					"id": 150200809,
					"content": "你們就是之前瓦爾米說的…要來跟我們談合作的商隊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200810
					],
					"speakerTitle": "阿爾帕"
				},
				{
					"id": 150200810,
					"content": "啊，沒錯沒錯，那…您就是阿爾帕長老囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200811
					],
					"speakerTitle": "伊西多爾"
				},
				{
					"id": 150200811,
					"content": "是我。各位舟車勞頓，又受了驚嚇，就先跟我一起回花羽會好好休息吧。有什麼事可以之後再談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200812
					],
					"speakerTitle": "阿爾帕"
				},
				{
					"id": 150200812,
					"content": "阿爾帕長老，那絨翼龍襲擊的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200813
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200813,
					"content": "唔…我看這些朋友並沒有受重傷，貨物也沒什麼損失…或許只是那隻絨翼龍偶然間受到了什麼刺激吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200814
					],
					"speakerTitle": "阿爾帕"
				},
				{
					"id": 150200814,
					"content": "這附近的絨翼龍那麼多，出現一兩次意外也不奇怪，就不用費心去追查了…倒是飛行試煉那邊，修整得怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200815,
						150200816
					],
					"speakerTitle": "阿爾帕"
				},
				{
					"id": 150200815,
					"content": "修理得差不多了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				},
				{
					"id": 150200817,
					"content": "哦？飛行試煉？那還真是巧了！阿爾帕長老，我們的「燃素翼」一定能在試煉上給您一個驚喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200818
					],
					"speakerTitle": "伊西多爾"
				},
				{
					"id": 150200818,
					"content": "是嗎？…聽起來是還滿有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200819
					],
					"speakerTitle": "阿爾帕"
				},
				{
					"id": 150200819,
					"content": "嘿嘿，那絨翼龍的事就放一邊…我們快回去談談「燃素翼」的合作吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200820
					],
					"speakerTitle": "伊西多爾"
				},
				{
					"id": 150200820,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200821
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200821,
					"content": "問題好像都解決了？還怪順利的嘛…那我們也走吧…咦？恰斯卡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200822
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150200822,
					"content": "妳在看什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200823
					]
				},
				{
					"id": 150200823,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200824
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200824,
					"content": "染血的…羽毛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200825
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200825,
					"content": "這起風波最終不了了之，花羽會再次恢復了往日的平靜。\\n在波瀾不驚的日常中，大家也在緊鑼密鼓地籌備著飛行試煉…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 150200816,
					"content": "很快就能重啟了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150200817
					]
				}
			]
		},
