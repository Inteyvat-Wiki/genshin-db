				},
				{
					"id": 150200607,
					"content": "有…有一隻絨翼龍突然襲擊了我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200608
					],
					"speakerTitle": "伊西多爾"
				},
				{
					"id": 150200608,
					"content": "#我的同伴跟貨物都還在大道上…求求{F#妳}{M#你}們快去救救他們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200609
					],
					"speakerTitle": "伊西多爾"
				},
				{
					"id": 150200609,
					"content": "欸？絨翼龍…有這麼凶猛嗎？一隻直接襲擊了一群人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150200610,
					"content": "照理說應該不會…但凡事總有例外，先過去看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "恰斯卡"
				}
			]
		},
