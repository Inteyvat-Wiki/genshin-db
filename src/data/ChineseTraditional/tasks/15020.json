			"dialogs": [
				{
					"id": 150200101,
					"content": "欸，恰斯卡？是阿爾帕長老要妳來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200102
					],
					"speakerTitle": "因卡納克"
				},
				{
					"id": 150200102,
					"content": "嗯，她還有其他事要做，這邊的情況怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200103
					],
					"speakerTitle": "恰斯卡"
				},
				{
					"id": 150200103,
					"content": "唔…根據調查結果，應該是過去的幾次深淵入侵導致了地脈紊亂，在試煉場地裡形成了各式各樣的「阻塞」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200104
					],
					"speakerTitle": "因卡納克"
				},
				{
					"id": 150200104,
					"content": "理論上只要清理掉這些阻塞，就能讓氣態燃素再次充盈，但實際操作起來卻各有各的問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150200105
					],
					"speakerTitle": "因卡納克"
				},
				{
					"id": 150200105,
					"content": "#具體情況{F#妳}{M#你}們可以直接下去看看，也可以問問在場的工作人員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "因卡納克"
				}
			]
		},
