			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"愛諾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 765020101,
					"content": "#是{NICKNAME}和派蒙呀？怎麼啦怎麼啦？難道有什麼超級厲害的委託，需要本天才機械師出馬？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020102
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 765020102,
					"content": "#嘿嘿，熟人好說，可以給{F#妳}{M#你}們打個八折！只要{F#妳}{M#你}們悄悄幫我帶點零食就好——噓，千萬別讓伊涅芙知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020103,
						765020104
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 765020103,
					"content": "我們正在四處參觀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				},
				{
					"id": 765020105,
					"content": "#那{F#妳}{M#你}們算是來對地方了。我愛諾的工坊裡，到處都是閃閃發光的好東西，別的地方絕對看不到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020106
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 765020106,
					"content": "#不過，{F#妳}{M#你}們走路的時候要小心腳下哦，不要被那些零件絆倒啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020107,
						765020108
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 765020107,
					"content": "這個機器人的樣子很奇特呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020109,
					"content": "哼哼，那當然。它叫做「重拳出擊鴨」，本來我想把它做成一個垃圾分類機器人，幫我把那些廢銅爛鐵都整理好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020110
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 765020110,
					"content": "結果一不小心，我把它造得太堅固了，懸臂又非常靈活。於是我靈光一閃，就給它加入了超強的防衛機能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020111
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 765020111,
					"content": "這樣一來，要是有哪個不長眼的壞蛋想偷偷溜進我的工坊，它就會把他們全部打掃成「不可回收垃圾」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020112
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 765020112,
					"content": "愛諾的想法還是那麼天馬行空呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020113,
						765020114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 765020113,
					"content": "機會難得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020115,
					"content": "我、我嗎？和「重拳出擊鴨」一起？大家平時只對我的發明感興趣，很少有人想拍我耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020116
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 765020116,
					"content": "#不過，如果{F#妳}{M#你}們想要記錄本天才機械師和無敵小弟的工作日常，也不是不行啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020117
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 765020117,
					"content": "可是…我平時都不怎麼幫自己拍照的，也不知道要擺什麼姿勢才帥氣啦…萬一拍出來不好看怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						765020118,
						765020119
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 765020118,
					"content": "像平時一樣就可以了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020120,
					"content": "#好吧，那就交給{F#妳}{M#你}了哦。要把「重拳出擊鴨」的威猛也一起拍出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "愛諾"
				},
				{
					"id": 765020119,
					"content": "我會努力拍下最帥氣的一刻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020120
					]
				},
				{
					"id": 765020114,
					"content": "可以為妳拍攝畫片嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020115
					]
				},
				{
					"id": 765020108,
					"content": "它也是愛諾的「小弟」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020109
					]
				},
				{
					"id": 765020104,
					"content": "順便尋找拍攝素材。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						765020105
					]
				}
			]
		},
