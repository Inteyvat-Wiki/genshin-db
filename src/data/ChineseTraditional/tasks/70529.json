			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莉茲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 705290201,
					"content": "您好！歡迎來到風花節，您來得可真是時候，我這裡有一個叫做「風物之歌」的小遊戲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290202
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290202,
					"content": "在這項小遊戲裡，您能夠像蒙德城裡的吟遊詩人一樣，彈奏出動聽的曲子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290203,
						705290204
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290203,
					"content": "能跟吟遊詩人比嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				},
				{
					"id": 705290205,
					"content": "放心吧！這項小遊戲我可是…那個…找了很多人試玩過的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290206
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290206,
					"content": "就算是最不會彈奏樂器的人，也能至少彈出一首…呃…至少不難聽的曲子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290207
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290207,
					"content": "相信我！相信西風騎士團！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290208
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290208,
					"content": "只要集中注意力跟上節拍和節奏，肯定能輕鬆彈奏出一首像樣的旋律。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290209
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290209,
					"content": "在風中全神貫注地彈奏著優美動聽的旋律…這樣，您肯定能把煩心事都忘掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290210
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290210,
					"content": "那吟遊詩人肯定最沒煩心事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290211
					]
				},
				{
					"id": 705290211,
					"content": "哈哈哈，那可不一定，畢竟他們會本能地擔心，這首曲子是不是優美到讓人願意付錢呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290212
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290212,
					"content": "而您嘛…只需要彈得讓自己開心就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290213
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290213,
					"content": "咳！我…我剛才什麼都沒說！您應該瞭解這個小遊戲的玩法了吧？如果有興趣的話，請您來試試看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290214
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290214,
					"content": "您可以用自己的樂器來彈奏曲子，如果您沒帶樂器的話，我們這邊也可以借您一些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290215
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290215,
					"content": "嘿嘿…我們這裡可是有很多樂器的，每一種樂器彈奏時的手感都不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290216
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290216,
					"content": "您想先用哪一把樂器來彈奏呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290217,
						705290218,
						705290219
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290217,
					"content": "風物之詩琴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290220,
					"content": "用這把樂器啊，沒問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290221
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290221,
					"content": "對了！還有一件事，還有一件事！請您稍等一下，我看看筆記本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290222
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290222,
					"content": "嗯…那個…為了保證大家能順利彈奏出好聽的曲子，我們這次還特別準備了一個「調校樂器」的環節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290223
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290223,
					"content": "簡單來說，就是幫您把樂器調整到最佳狀態啦…很簡單的，我看看啊，第一步是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290224
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290224,
					"content": "好！這樣就可以了，樂器已經調整到最佳狀態…樂譜也準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705290225
					],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290225,
					"content": "只要您願意，隨時都可以開始彈奏啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莉茲"
				},
				{
					"id": 705290218,
					"content": "鏡花之琴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290219,
					"content": "綺筵之鼓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290220
					]
				},
				{
					"id": 705290204,
					"content": "彈出來真的好聽嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705290205
					]
				}
			]
		}
	]
}