					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050303
					]
				},
				{
					"id": 220050303,
					"content": "這個…包裹，好像不是呢…手感輕了好多，裡面裝著的東西肯定不對…",
					"roleType": "TALK_ROLE_NPC",
