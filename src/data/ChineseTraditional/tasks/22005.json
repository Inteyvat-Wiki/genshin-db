			"trigger": {
				"objectNames": [
					"寶兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220050101,
					"content": "到底在哪裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050102
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220050102,
					"content": "妳在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050103
					]
				},
				{
					"id": 220050103,
					"content": "#嗚哇！{F#妳}{M#你}是從哪冒出來的？怎麼無聲無息的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050104
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220050104,
					"content": "#我？我…是一個學者，正在研究歸離原的古代建築和遺物。{F#妳}{M#你}…就叫我寶兒吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050105
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220050105,
					"content": "不過，我研究太入神，把一個隨身的包裹給弄丟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050106
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220050106,
					"content": "#那裡面是我好不容易找到的寶…文物，{F#妳}{M#你}願意幫我找找嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050107,
						220050108,
						220050109
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220050107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050110
					]
				},
				{
					"id": 220050110,
					"content": "#太好了，應該就掉在附近了…或者再遠點，總之，請{F#妳}{M#你}仔細找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220050108,
					"content": "是什麼樣的包裹？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050111
					]
				},
				{
					"id": 220050111,
					"content": "就是…平常大家用的包裹啦，一個四四方方的盒子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050112
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220050112,
					"content": "為什麼用這個裝文物？呃，因為…這樣的盒子方便啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050113
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220050113,
					"content": "#而且，我也在盒子裡面墊了好幾層衣服，絕對不會損壞文物的，請{F#妳}{M#你}快去幫我找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220050109,
					"content": "是什麼樣的文物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220050114
					]
				},
				{
					"id": 220050114,
					"content": "#是…總之是很貴重的文物，哎呀！說了{F#妳}{M#你}也不明白啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220050115
					],
					"speakerTitle": "寶兒"
				},
				{
					"id": 220050115,
					"content": "#只有我這種專業人士，才能判斷出它的價值，拜託{F#妳}{M#你}了，快幫我找找吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寶兒"
				}
			]
		},
