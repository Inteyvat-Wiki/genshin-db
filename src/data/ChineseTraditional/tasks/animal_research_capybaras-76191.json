			"dialogs": [
				{
					"id": 761910301,
					"content": "真的是銀色的豚獸，不是染色的也不是看錯，太少見了，不可思議…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910302
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761910302,
					"content": "之前在納塔費盡心思也沒找到，原來是被走私販給抓到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910303
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761910303,
					"content": "不過看起來好像沒受傷…嘿嘿，銀色的豚獸，真沒想到能親眼見到，讓我摸摸看銀色的和普通的有沒有不一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910304
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761910304,
					"content": "…好燙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910305
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761910305,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910306
					],
					"speakerTitle": "豚獸"
				},
				{
					"id": 761910306,
					"content": "差點忘了，你還在鍋裡呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910307
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761910307,
					"content": "難道是已經習慣了納塔的液態燃素，所以這點溫度不算什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910308
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761910308,
					"content": "不管怎麼說，你先跟我回去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761910309
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761910309,
					"content": "♪～",
					"roleType": "TALK_ROLE_NPC",
