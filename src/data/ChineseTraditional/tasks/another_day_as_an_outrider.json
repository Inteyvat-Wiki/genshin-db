			"dialogs": [
				{
					"id": 4520101,
					"content": "#啊，派蒙和{NICKNAME}，找我有什麼事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520102,
					"content": "妳好啊，安柏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520103,
						4520124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520103,
					"content": "安柏，有件事情……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520104
					]
				},
				{
					"id": 4520104,
					"content": "安柏，妳認識奔狼領的男孩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520105,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520106,
					"content": "就是那個和妳關係很好的那位啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520107,
					"content": "妳在說什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520108
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520108,
					"content": "奇怪了，他說在老地方等妳。難道妳已經把他忘記了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520109,
					"content": "小派蒙妳才是，該不會吃錯了蘑菇產生幻覺了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520110
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520110,
					"content": "我完全不明白啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520111,
					"content": "呃……不能吃的蘑菇是什麼顏色的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520112,
					"content": "紫色的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520113,
					"content": "……好像前兩天真的吃過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520114,
					"content": "這不是重點！我現在沒傻——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520115,
					"content": "妳不會真的不認識那個和狼群一起生活的男孩子吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520116,
					"content": "妳在說什麼啊——不明白——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520117
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520117,
					"content": "不過，說到狼。 我最近在調查一件事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520118
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520118,
					"content": "本來只在「奔狼領」活動的狼群，最近膽子變大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520119
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520119,
					"content": "據說，襲擊了「醉漢峽」附近的車隊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520120
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520120,
					"content": "如果有空的話，來協助我調查一下，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520121,
						4520122
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520121,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520123,
					"content": "哼哼，真可靠。那我們出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520122,
					"content": "還是正事要緊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520123
					]
				},
				{
					"id": 4520124,
					"content": "妳好啊，最近怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520125
					]
				},
				{
					"id": 4520125,
					"content": "#啊，{F#妳}{M#你}看起來挺閒的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520126
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520126,
					"content": "呃，通常說了這句話之後——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520127,
					"content": "#我最近很忙哦。畢竟偵察騎士責任重大嘛——{F#妳}{M#你}要來幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520129
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520129,
					"content": "果然是這句話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520130,
						4520131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520130,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				},
				{
					"id": 4520132,
					"content": "最近狼群開始襲擊「醉漢峽」沿線的車隊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520133
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520133,
					"content": "#{F#妳}{M#你}知道吧？狼群雖然很危險，但是有自己原則的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520134
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520134,
					"content": "蒙德的狼基本上不會離開明冠山和奔狼領。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520135
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520135,
					"content": "嗯嗯，聽說雖然那裡生態很原始，但也是有獨特規則的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520136,
					"content": "沒錯。所以狼群跑到醉漢峽襲擊人，這就很奇怪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520137
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520137,
					"content": "說到狼，安柏妳認識奔狼領的男孩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520138,
					"content": "不認識啊，蒙德還有這樣的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520139
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520139,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520140,
					"content": "「紅色的，看起來很燙的女孩子」，難道不是安柏嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520141,
					"content": "妳在說什麼啊？那是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520142
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520142,
					"content": "總之，我馬上就要趕去醉漢峽調查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520143
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520143,
					"content": "#{F#妳}{M#你}們也一起來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520131,
					"content": "是什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4520132
					]
				}
			]
		},
