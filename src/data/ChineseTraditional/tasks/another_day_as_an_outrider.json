				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4520301,
					"content": "#謝、謝謝{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520302
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 4520302,
					"content": "小事一樁啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520303,
					"content": "最近借著狼群的威風，丘丘人都囂張跋扈了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520304
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520304,
					"content": "是這樣的。但是我覺得相比丘丘人，還是狼群更肆無忌憚一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520305
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 4520305,
					"content": "牠們…上午剛襲擊了清泉鎮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520306
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 4520306,
					"content": "什麼？襲擊鎮上？！這也太囂張了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520307
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520307,
					"content": "是啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520308
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 4520308,
					"content": "我心想狼群鬧夠了，也許可以上路，沒想到就遇到了丘丘人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520309
					],
					"speakerTitle": "齊格芙麗雅"
				},
				{
					"id": 4520309,
					"content": "那我們現在趕過去，說不定還能看到殘留的現場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520310
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520310,
					"content": "先走一步了！妳就趕快檢查一下損失吧。貨車還能動嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520311
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520311,
					"content": "啊，好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "齊格芙麗雅"
				}
			]
		},
