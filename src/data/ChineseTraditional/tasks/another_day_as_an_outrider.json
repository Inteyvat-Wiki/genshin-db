			"dialogs": [
				{
					"id": 4520201,
					"content": "前方有騷亂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520202
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520202,
					"content": "不是狼群，好像是丘丘人部落在襲擊貨車！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4520203,
					"content": "唔…這倒不是什麼罕見的情況呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4520204
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4520204,
					"content": "好啦，閒話少說，我們趕快去幫忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
			]
		},
		{
