	"talks": [
		{
			"id": 7213301,
			"completionStepIds": [
				7213301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7213301",
							"2"
						],
						"stepId": 7213301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"梶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721330101,
					"content": "#{F#妳}{M#你}好！抱歉打擾，外國人。希望{F#妳}{M#你}能聽我一言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330102
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330103
					]
				},
				{
					"id": 721330103,
					"content": "請不要在這座島上久留，近來「祟神」彌漫的範圍越來越廣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330104
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330104,
					"content": "「祟神」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330105
					]
				},
				{
					"id": 721330105,
					"content": "是啊，自從珊瑚宮來的人毀掉了島上的鎮壓蛇神殘魂的鎮物，「祟神」就散佈了全島…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330106
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330106,
					"content": "#如{F#妳}{M#你}所見，陰雲遮天蔽日，雨也下個不停，這都是「祟神」所為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330107
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330107,
					"content": "這段時間裡，礦工們一個接一個病倒、失去理智，流亡他島…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330108
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330108,
					"content": "大家都走了，本島已經沒剩下幾個居民了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330109
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330109,
					"content": "不過諷刺的是，多虧了「祟神」作亂，幕府和叛軍打仗也沒以前那麼拼命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330110
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330110,
					"content": "哼，話說回來，要不是他們打仗破壞了大御所殿下的鎮物，島上哪會這樣一團糟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330111
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330111,
					"content": "奉行呀、龍呀蛇的，跟我又有什麼關係！他們打仗又沒問過我的意見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330112
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330112,
					"content": "你還留在這裡做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330113
					]
				},
				{
					"id": 721330113,
					"content": "做什麼？這裡是我的家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330114
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330114,
					"content": "你的家人呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330115
					]
				},
				{
					"id": 721330115,
					"content": "#在安全的地方，謝謝{F#妳}{M#你}的關心。他們也在等我接他們回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330116
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330116,
					"content": "島上沒人是自願離開的。我們在這裡是一家人，去了別處，就只能做別人的雇工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330117
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330117,
					"content": "所以總得有人留下，想辦法把這裡打掃乾淨，讓他們有家可回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330118
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330118,
					"content": "唉，真是頭疼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330119
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330119,
					"content": "我能幫上忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721330120
					]
				},
				{
					"id": 721330120,
					"content": "如果是別的小毛頭這樣唐突地要求幫忙，我恐怕要笑出聲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330121
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330121,
					"content": "#不過{F#妳}{M#你}身為外國旅人，能深入稻妻國境如此之遠，也不像是沒本事的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330122
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330122,
					"content": "#我就直說吧，那邊的鎮物困擾我很久了，希望{F#妳}{M#你}能找到辦法將它修復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330123
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330123,
					"content": "這裡的氣氛如此糟糕，一定是因為這些鎮物遭到破壞的緣故。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330124
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330124,
					"content": "#不過在接近鎮物時一定要小心，如果注視它的話，它會向{F#妳}{M#你}釋放一股能量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330125
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330125,
					"content": "#雖然無害，但讓人感覺很不舒服，就像…它在將{F#妳}{M#你}拒之身外一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330126
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330126,
					"content": "鎮物似乎少了什麼部件，或許把它缺少的東西放回去就能修好它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330127
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330127,
					"content": "當然，這只是我的猜測，到現在我也沒搞清楚它到底是哪裡失靈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330128
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330128,
					"content": "#所以，如果{F#妳}{M#你}想幫忙的話，這座鎮物就先拜託{F#妳}{M#你}來修復了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721330129
					],
					"speakerTitle": "梶"
				},
				{
					"id": 721330129,
					"content": "#不過我還是那句話，如果{F#妳}{M#你}也沒辦法的話，還請不要在這裡久留。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梶"
				}
			]
		}
	]
}