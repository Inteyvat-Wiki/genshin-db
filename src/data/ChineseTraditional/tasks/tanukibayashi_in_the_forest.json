			},
			"dialogs": [
				{
					"id": 721081101,
					"content": "就是這裡嗎？光禿禿的石頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721081102,
					"content": "嗯？他好像在用什麼法術…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721081103,
					"content": "哇！石頭消失了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081104,
						721081105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721081104,
					"content": "好神奇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721081106
					]
				},
				{
					"id": 721081106,
					"content": "這就是妖狸的法術嗎！感覺很好玩的樣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721081107,
					"content": "謝謝你，「吉法師」！下次我們再一起玩捉迷藏吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721081108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721081108,
					"content": "呶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「吉法師」"
