					"五百藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080901,
					"content": "嗯嗯。幹得很好，他們都很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080902
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080902,
					"content": "#…嗯？喔，沒問題，吾輩幫{F#妳}{M#你}問問他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080903
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080903,
					"content": "#「刑部小判」想問{F#妳}{M#你}們：「{F#妳}{M#你}們明明是人類，為啥身上卻有狸子的氣息哩？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080904
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080904,
					"content": "#…對啊！給吾輩交待清楚！{F#妳}{M#你}們身上為什麼有吾等的氣味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080905
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080905,
					"content": "欸？現在才問嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080906,
						721080907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080906,
					"content": "面具巫女小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				},
				{
					"id": 721080908,
					"content": "對了！是有這麼回事呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080909
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080909,
					"content": "之前面具巫女小姐給我們吃了一頓好豐盛的大餐，說是用從妖狸一族那偷學來的法術，做出來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080910
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080910,
					"content": "什麼？竟然敢偷學吾等的法術…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080911
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080911,
					"content": "唔，難道說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080912
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080912,
					"content": "什麼嘛，那隻臭狐狸。如果還活著的話，那早點來跟吾輩打個招呼嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080913
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080913,
					"content": "是個戴著面具的巫女，說你是「老朋友」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080914
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080914,
					"content": "面具？吾輩不知道什麼面具，也不認識什麼巫女。狐狸倒認識一匹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080915
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080915,
					"content": "#說起來，那隻臭狐狸倒也用巫女的形象示人過。{F#妳}{M#你}說的那個巫女，長什麼樣子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080916
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080916,
					"content": "戴著白狐面具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080917
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080917,
					"content": "別的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080918,
						721080920
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080918,
					"content": "黑色短髮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080919
					]
				},
				{
					"id": 721080919,
					"content": "穿著巫女服裝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080922,
					"content": "呶…不認識。沒見過這樣的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080923
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080923,
					"content": "這樣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080924
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080924,
					"content": "…嗯？嗯，好，包在吾輩身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080925
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080925,
					"content": "#「證城」想跟{F#妳}{M#你}們說：「和{F#妳}{M#你}們玩得很開心，謝謝！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080926
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080926,
					"content": "派蒙也很開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080927
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080927,
					"content": "那關於梳子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080928
					]
				},
				{
					"id": 721080928,
					"content": "#吾輩是名震天下的妖狸五百藏，當然會信守諾言。這把梳子就交給{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080929
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080929,
					"content": "#不過，{F#妳}{M#你}們要這把梳子幹什麼？梳頭嗎？上面說不定有狐騷味呶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080930
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080930,
					"content": "是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080920,
					"content": "穿著巫女服裝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080921
					]
				},
				{
					"id": 721080921,
					"content": "黑色短髮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080922
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080907,
					"content": "吃了很奇怪的東西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080908
					]
				}
			]
		},
