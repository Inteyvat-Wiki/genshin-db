				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080101,
					"content": "終於到了，這裡就是鎮守之森了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080102,
					"content": "面具巫女小姐說，她有一個老朋友在鎮守之森的深處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080103,
					"content": "那我們就趕緊動身吧，往深處去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7210804,
			"completionStepIds": [
				7210816
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210816",
							"2"
						],
						"stepId": 7210816,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210810",
							"3"
						],
						"stepId": 7210810,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080401,
					"content": "保管鎮物的天狐雕像…的裡面是空的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080402,
					"content": "說不定是被那位面女的「老朋友」藏起來了吧。去問問看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080403,
					"content": "面…面女？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080404
					]
				},
				{
					"id": 721080404,
					"content": "剛剛幫她想的綽號。怎麼樣，是不是很好記？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080405,
						721080406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080405,
					"content": "一點也不好記。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				},
				{
					"id": 721080407,
					"content": "唔嗯，那還是算了…總之，我們先找找線索吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080406,
					"content": "不知所謂。莫名其妙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080407
					]
				}
			]
		},
		{
			"id": 7210807,
			"completionStepIds": [
				7210814
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210814",
							"2"
						],
						"stepId": 7210814,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五百藏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721080701,
					"content": "噫——我…吾吾吾輩正是五百藏，要、要殺要剮悉聽尊便！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080702
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080702,
					"content": "哇，石像在說話！還嚇得話都說不清了耶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080703,
					"content": "吾輩才不是什麼石像！只是暫時被人封印，變成了這個樣子罷了！吾輩乃是名震天下的妖狸五百藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080704,
						721080705
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080704,
					"content": "五百藏？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				},
				{
					"id": 721080706,
					"content": "什麼嘛，現在的小輩連五百藏的名號都不知道了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080707
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080707,
					"content": "《御苑狸戲畫》、《五百藏茶壺》、《隱神大囃子》、《影向山騷動狸合戰》…這些故事沒聽過嗎？嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080708
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080708,
					"content": "吾輩到底被那個混小子封印了多少年呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080709,
						721080711
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080709,
					"content": "我沒有惡意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080710
					]
				},
				{
					"id": 721080710,
					"content": "什麼嘛，不是來「收拾」吾輩的嗎，怎麼不早說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080719,
					"content": "#咳咳。說！{F#妳}{M#你}們來找貴為妖狸大王的吾輩，是來幹啥的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080720,
						721080722
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080720,
					"content": "「神櫻大祓」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080721
					]
				},
				{
					"id": 721080721,
					"content": "神鷹大斧？那是什麼？是鬼族的寶具嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080726,
					"content": "真是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080727
					]
				},
				{
					"id": 721080727,
					"content": "欸，他真的是面具巫女小姐說的老朋友嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080728,
					"content": "總之，我們在找藏在狐狸雕像裡的一件物品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080729,
					"content": "噫——找、找找那個東西幹什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080730,
						721080731
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080730,
					"content": "哇。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080732,
					"content": "就是那把梳子，害得吾輩被封印了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080733
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080733,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080734,
						721080735,
						721080736
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080734,
					"content": "一百年？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080737,
					"content": "吾輩也不知道多久！鎮守之森這裡整天看不到日月光，沒辦法算時間啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080738
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080738,
					"content": "當時呀，吾輩為了引出那隻臭狐狸，到處大鬧，也沒有什麼結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080739
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080739,
					"content": "吾輩想把那個狐狸雕像拆了洩憤時，在裡頭發現了那把梳子，就心生妙計！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080740
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080740,
					"content": "那把梳子藏在狐狸雕像裡，上面還有白辰的形象，又想到那一身白毛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080741
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080741,
					"content": "吾輩馬上就察覺到，這把梳子肯定很重要。如果要把那隻臭狐狸引出來，把梳子藏起來就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080742
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080742,
					"content": "嗯嗯，用寶藏吸引人確實很有用！結果呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080743
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080743,
					"content": "結果來了個以前「影向役者三人組」裡的人類，把吾輩和同族的小子們好生一頓修理，哇啦哇啦地全變成了石頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080744
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080744,
					"content": "這就是五百藏怕人的原因嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080745
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080745,
					"content": "哼！人這種東西，壽命又短，又不會變化，不知道那隻臭狐狸為什麼這麼偏袒他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080746
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080746,
					"content": "那個封印吾輩的傢伙尤其過分，還說著什麼「嗯嗯。封印的時候，擺出了好姿勢哪。可以做個景觀呢」之類的話，氣死了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080747
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080747,
					"content": "確實是不錯的景觀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080748
					]
				},
				{
					"id": 721080748,
					"content": "#呶？{F#妳}{M#你}這小輩，怎麼也…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080749
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080749,
					"content": "#（喂，{NICKNAME}，要是惹他生氣，拿不到鎮物怎麼辦…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080750,
						721080751
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080750,
					"content": "意思是您魁梧豪放…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080752,
					"content": "就、就是呀，在這個黑黝黝的林子裡，可是增添了不少光彩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080753
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080753,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080754
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080754,
					"content": "再仔細說說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080755,
						721080756
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080755,
					"content": "宛如一尊神像…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080757,
					"content": "哎呀，所以說…被封印也不是那麼壞的事嘛，人也沒有惡意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080758
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080758,
					"content": "#雖然{F#妳}{M#你}說得好像有點道理，但又好像不是那麼回事…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080759
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080759,
					"content": "那把梳子，能借來看看嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080760
					]
				},
				{
					"id": 721080760,
					"content": "#也不是不行，不過{F#妳}{M#你}們得陪孩子們玩玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080761
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080761,
					"content": "#嗯，這個簡單。{NICKNAME}最會陪小孩子玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080762,
						721080763
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080762,
					"content": "其實我不擅長對付小孩子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080765
					]
				},
				{
					"id": 721080765,
					"content": "「證城」、「刑部小判」和「吉法師」。在森林裡找找他們<color=#00E1FFFF>三隻小狸子</color>，陪他們玩玩吧。畢竟，吾輩也沒辦法自由行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080766
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080766,
					"content": "因為封印他們的時候，那個混小子不太認真，所以前段時間，有些小傢伙就跑出來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080767
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080767,
					"content": "…不對，應該說是吾等妖狸法力強大，能掙脫區區人類的封印是再正常不過了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080768,
						721080770
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080768,
					"content": "那你自己…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080769
					]
				},
				{
					"id": 721080769,
					"content": "咳咳！法力強大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080771
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080771,
					"content": "雖然跟吾輩五百藏的法力不能比，但他們也會一點法術，能夠隱藏自己的身形。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080772
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080772,
					"content": "好了好了，快去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080770,
					"content": "法力強大！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080771
					]
				},
				{
					"id": 721080763,
					"content": "沒錯，我經常和派蒙玩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080764
					]
				},
				{
					"id": 721080764,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080765
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080756,
					"content": "七天神像都自愧弗如…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080757
					]
				},
				{
					"id": 721080751,
					"content": "意思是您俊朗健壯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080752
					]
				},
				{
					"id": 721080735,
					"content": "一千年？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080736,
					"content": "一百萬年？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080737
					]
				},
				{
					"id": 721080731,
					"content": "有反應了耶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080732
					]
				},
				{
					"id": 721080722,
					"content": "這裡的「鎮物」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080723
					]
				},
				{
					"id": 721080723,
					"content": "蒸物？是吃的嗎？我們妖狸對料理倒是頗有心得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080724
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080724,
					"content": "不是啦，是「神櫻大祓」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080725,
					"content": "大福？啊，好久沒吃大福了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080726
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080711,
					"content": "我是來討債的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080712
					]
				},
				{
					"id": 721080712,
					"content": "咿，討債？！在哪裡，什麼時候？我想想，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080713
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080713,
					"content": "#{F#妳}{M#你}這張臉，{F#妳}{M#你}這個人…唔…吾輩欠了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080714
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080714,
					"content": "對方煞有其事地開始回憶了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080715
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080715,
					"content": "喂，不要對陌生人開這種玩笑啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080716,
					"content": "什麼嘛，別開這種玩笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080717
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080717,
					"content": "#嗯，沒有就好，沒有就好…吾輩還是確認下，真的沒欠{F#妳}{M#你}們什麼東西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080718
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 721080718,
					"content": "…你難道欠了很多債嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721080719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721080705,
					"content": "名震天下？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721080706
					]
				}
			]
		},
		{
