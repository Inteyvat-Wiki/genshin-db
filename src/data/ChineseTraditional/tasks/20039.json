			"dialogs": [
				{
					"id": 200390401,
					"content": "#{F#妳}{M#你}先試試製作一份「驚雷精油」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390402
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 200390402,
					"content": "它是最基礎的煉金產物。最適合入門練手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390403
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 200390403,
					"content": "想要煉成「驚雷精油」，需要的原料是電氣水晶和青蛙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390404
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 200390404,
					"content": "這兩種材料都能在城外找到…什麼？「水晶」聽起來和「精油」沒關係？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390405
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 200390405,
					"content": "哈哈哈，當然，因為電氣水晶負責「驚雷」，「精油」的關鍵是青蛙啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390406
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 200390406,
					"content": "#找齊材料之後，{F#妳}{M#你}就開始嘗試煉製「驚雷精油」吧。大膽地嘗試，我會在旁邊看著{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390407
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 200390407,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
