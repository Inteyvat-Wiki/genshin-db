				{
					"id": 200390101,
					"content": "想感受一下煉金術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390102
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 200390102,
					"content": "古代的煉金術真是奇妙…真希望能讓更多人瞭解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390103
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 200390103,
					"content": "#嗯？{F#妳}{M#你}也對煉金術感興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390104
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 200390104,
					"content": "很感興趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200390105
					]
				},
				{
					"id": 200390105,
					"content": "#那麼{F#妳}{M#你}就來親手嘗試一下煉金術吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200390106
					],
					"speakerTitle": "蒂瑪烏斯"
				},
				{
					"id": 200390106,
					"content": "任何偉大的成就，都是從扎實的基礎中生發而出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蒂瑪烏斯"
				}
			]
		},
