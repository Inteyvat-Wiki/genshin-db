			"dialogs": [
				{
					"id": 716665101,
					"content": "漂亮，是我輸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665102
					],
					"speakerTitle": "「花裡胡哨不如一刀」"
				},
				{
					"id": 716665102,
					"content": "#輸給{NICKNAME}，未嘗不是一種光榮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665103
					],
					"speakerTitle": "「花裡胡哨不如一刀」"
				},
				{
					"id": 716665103,
					"content": "原來是用這種辦法打贏的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665104
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716665104,
					"content": "沒錯，面對靈活的敵人，還是要多多變通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716665105,
					"content": "#一種戰術行不通的時候，就要換個想法，我和{NICKNAME}在其他地方旅行的時候，就常常靈活地思考！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716665106,
					"content": "只會用一種方法做事的話，再用力也解決不了問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 716665107,
					"content": "我記得，有時阿忍也說過差不多的話，這樣看來還滿有道理的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						716665108
					],
					"speakerTitle": "荒瀧一斗"
				},
				{
					"id": 716665108,
					"content": "不過還是以後再想吧…先考慮眼前的正事，鬥蟲要緊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "荒瀧一斗"
				}
			]
