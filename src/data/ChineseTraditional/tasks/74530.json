			},
			"dialogs": [
				{
					"id": 745300401,
					"content": "#啊，師父！{F#妳}{M#你}回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300402,
						745300403
					],
					"speakerTitle": "卡齊娜"
				},
				{
					"id": 745300402,
					"content": "卡齊娜看起來很開心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				},
				{
					"id": 745300404,
					"content": "嘿嘿，我這次挖掘，找到了很不錯的原礦哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300405
					],
					"speakerTitle": "卡齊娜"
				},
				{
					"id": 745300405,
					"content": "如果好好拋光的話，說不定可以變成閃閃發光的大寶石哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300406
					],
					"speakerTitle": "卡齊娜"
				},
				{
					"id": 745300406,
					"content": "太好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300407
					]
				},
				{
					"id": 745300407,
					"content": "嗯！本來前面都沒什麼收獲，我差點就要空手而歸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300408
					],
					"speakerTitle": "卡齊娜"
				},
				{
					"id": 745300408,
					"content": "但是我想著要再堅持一下…所以就告訴自己再往下挖一點，就再挖一點點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300409
					],
					"speakerTitle": "卡齊娜"
				},
				{
					"id": 745300409,
					"content": "不知道到底重複了多少次，終於找到了這個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300410
					],
					"speakerTitle": "卡齊娜"
				},
				{
					"id": 745300410,
					"content": "等我出來的時候，才發現太陽都快下山了…好像不小心就挖了一整天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300411,
						745300412
					],
					"speakerTitle": "卡齊娜"
				},
				{
					"id": 745300411,
					"content": "不愧是卡齊娜，真有毅力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300413,
					"content": "嗚哇，真的嗎？我、我面對鏡頭會容易害羞…不一定可以拍得好哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300414
					],
					"speakerTitle": "卡齊娜"
				},
				{
					"id": 745300414,
					"content": "不過…如果是師父的請求，我會努力的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745300415,
						745300416
					],
					"speakerTitle": "卡齊娜"
				},
				{
					"id": 745300415,
					"content": "妳已經很努力了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300417,
					"content": "#嗯！我明白了。那就交給{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡齊娜"
				},
				{
					"id": 745300416,
					"content": "卡齊娜現在這樣就很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300417
					]
				},
				{
					"id": 745300412,
					"content": "可以拍下閃閃發光的妳嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300413
					]
				},
				{
					"id": 745300403,
					"content": "發生什麼好事了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745300404
					]
				}
			]
		}
	]
