				},
				{
					"id": 210290102,
					"content": "你在做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210290103
					]
				},
				{
					"id": 210290103,
					"content": "#欸？{F#大姐姐}{M#大哥哥}，是{F#妳}{M#你}呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210290104
