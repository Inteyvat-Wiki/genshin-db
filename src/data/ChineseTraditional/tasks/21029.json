			},
			"dialogs": [
				{
					"id": 210291101,
					"content": "太好了，那我們就快點開始做菜吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291102
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210291102,
					"content": "嗚哇！好辣！水、水在哪，我要喝點水…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291103
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210291103,
					"content": "看來，絕雲椒椒是放太多了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210291104,
					"content": "呼…好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291105
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210291105,
					"content": "除了有些辣之外，我覺得這道菜的味道還不錯呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291106
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210291106,
					"content": "而且，這麼辣的味道，好像也有助於…提神？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291107,
						210291108
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210291107,
					"content": "還是少放點絕雲椒椒吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210291109
					]
				},
				{
					"id": 210291109,
					"content": "#謝謝{F#大姐姐}{M#大哥哥}，我會把這種做法記下來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291110
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210291110,
					"content": "等我和爸爸去旅行的時候，再找機會做給他吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210291111
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210291111,
					"content": "嗯…爸爸能不能吃辣的來著？應該可以吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210291108,
					"content": "味道過得去就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210291109
					]
				}
			]
