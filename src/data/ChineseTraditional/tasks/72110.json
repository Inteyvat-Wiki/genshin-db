	"talks": [
		{
			"id": 7211001,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岩藏光造"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100101,
					"content": "我究竟是為什麼而離開道館，成為九條大人的指南的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100102
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100102,
					"content": "柳葉和岡崎，還有三船…又為什麼會離開我呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岩藏光造"
				}
			]
		},
		{
			"id": 7211002,
			"completionStepIds": [
				7211015
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211007",
							"3"
						],
						"stepId": 7211007,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211015",
							"2"
						],
						"stepId": 7211015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岡崎寅衛門",
					"柳葉嵐士"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100201,
					"content": "…現在，只差岩藏光胤的刀了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100202
					],
					"speakerTitle": "岡崎寅衛門"
				},
				{
					"id": 721100202,
					"content": "岩藏家祖傳的「薄緣滿光天目」嗎。當初你和久仁彥剛被收養的時候，趁前代的永胤大人不注意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100203
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100203,
					"content": "我們已經「破門」了。不用叫大人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100204
					],
					"speakerTitle": "岡崎寅衛門"
				},
				{
					"id": 721100204,
					"content": "但是，岡崎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100205
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100205,
					"content": "「將『情』與『義』置於天平兩端，真正的劍士只有『義』之道可走。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100206
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100206,
					"content": "既然師父這麼說，那就說明他不情願將我們逐出師門，但又沒有其他的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100207
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100207,
					"content": "當然不願意了。但既然他已經決定成為將軍的刀，貫徹眼狩令，那我們也只能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100208
					],
					"speakerTitle": "岡崎寅衛門"
				},
				{
					"id": 721100208,
					"content": "我們只能選擇我們自己的道義了。畢竟，「真正的劍士只有『義』之途可走。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100209
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100209,
					"content": "但是，師父的道義，終究也被挫敗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100210
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100210,
					"content": "沒錯。不止是久仁彥的仇，其他人，還有岩藏光胤的仇，我們都要報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100211
					],
					"speakerTitle": "岡崎寅衛門"
				},
				{
					"id": 721100211,
					"content": "這就是我們這些破門弟子的道義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100212
					],
					"speakerTitle": "岡崎寅衛門"
				},
				{
					"id": 721100212,
					"content": "這也是師父的保佑吧。第一個仇家，就這樣送上門來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100213
					],
					"speakerTitle": "柳葉嵐士"
				},
				{
					"id": 721100213,
					"content": "#也對。{NICKNAME}就是{F#妳}{M#你}吧。{F#妳}{M#你}的事蹟，我已經聽說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100214
					],
					"speakerTitle": "岡崎寅衛門"
				},
				{
					"id": 721100214,
					"content": "#在劍士的世界裡，只有用血才可以洗淨「血」。面對岩藏流「免許皆傳」的準備，{F#妳}{M#你}已經準備好了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "岡崎寅衛門"
				}
			]
		},
		{
			"id": 7211003,
			"completionStepIds": [
				7211014
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7211014",
							"2"
						],
						"stepId": 7211014,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"岩藏光造"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721100301,
					"content": "我究竟是為什麼而離開道館，成為九條大人的指南的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100302
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100302,
					"content": "柳葉和岡崎，還有三船…又為什麼會離開我呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100303
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100303,
					"content": "岩藏流的門生，我已經拜會過了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100304
					]
				},
				{
					"id": 721100304,
					"content": "是嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100305
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100305,
					"content": "現在還有人，會以岩藏流的名號自居嗎。明明宗主是這麼不成器的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100306
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100306,
					"content": "我是岩藏光造，姑且在這裡擔任劍道指南。閣下是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100307
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100307,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100308
					]
				},
				{
					"id": 721100308,
					"content": "#三船、丹波…{F#妳}{M#你}見到他們了嗎？還有岡崎兄弟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100309
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100309,
					"content": "還有片山。他喜歡在一決勝負之前，給比試取名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100310
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100310,
					"content": "因為，「如果將來我成為了真正的劍豪，那這些比試都是可以寫成故事的」。哈哈哈，真是瞎胡鬧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100311
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100311,
					"content": "對了，還有從「永胤」的時代到「光胤」的時代，都無法突破「初傳」的島田。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100312
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100312,
					"content": "他們因為無法領會將軍大人「眼狩令」的氣量，似乎是落草為寇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100313
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100313,
					"content": "過去指導他們握刀揮劍的歲月，真是令人懷念。我究竟為什麼關閉了道館，來到了軍中呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100314
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100314,
					"content": "#{NICKNAME}閣下，他們的本領如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100315,
						721100316
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100315,
					"content": "很遺憾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100317
					]
				},
				{
					"id": 721100317,
					"content": "是嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100318
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100318,
					"content": "#那麼，{NICKNAME}閣下，{F#妳}{M#你}師承自誰？土門？還是說，是涉川的流派？難道是鳴神親傳？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100319
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100319,
					"content": "應該算是「我流」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100320
					]
				},
				{
					"id": 721100320,
					"content": "原來如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100321
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100321,
					"content": "看來岩藏流，終究還是在我手上沒落了。親自教出來的弟子，在真劍比試中竟然無法勝過沒有師承的野小子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100322
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100322,
					"content": "…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721100323
					]
				},
				{
					"id": 721100323,
					"content": "這樣啊，我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100324
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100324,
					"content": "#無論{F#妳}{M#你}的流派是什麼，都無所謂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100325
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100325,
					"content": "看來岩藏流，終究還是在我手上沒落了。親自教出來的弟子，在真劍比試中竟然無法勝過不願自報家門的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100326
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100326,
					"content": "我姑且是岩藏流不成器的宗主。作為劍客，名號是「岩藏光胤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100327
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100327,
					"content": "雖然秘劍的心得我已經不記得了，「神之眼」也交給了將軍大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721100328
					],
					"speakerTitle": "岩藏光造"
				},
				{
					"id": 721100328,
					"content": "…不過，若是要為那些不甘於我的墮落，而走上忤逆的惡鬼之道",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
