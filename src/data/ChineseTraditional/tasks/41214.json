					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412140101,
					"content": "又來了哦！又是我們哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140102,
					"content": "#旅行者，派蒙。{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140103
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140103,
					"content": "已經習慣像這樣和阿貝多見面了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140104,
						412140105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140104,
					"content": "我完成你的委託了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				},
				{
					"id": 412140106,
					"content": "#非常感謝，找{F#妳}{M#你}果然是正確的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140107
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140107,
					"content": "幫上你的忙了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140108
					]
				},
				{
					"id": 412140108,
					"content": "#當然，{F#妳}{M#你}對我的研究工作給予了極大幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140109
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140109,
					"content": "嘿嘿，你知道就好~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140110,
					"content": "這份恩情我會牢記在心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140111
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140111,
					"content": "這把劍還給你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140112
					]
				},
				{
					"id": 412140112,
					"content": "應該足夠強了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140113,
					"content": "#差不多了。{F#妳}{M#你}身體感覺如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140114
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140114,
					"content": "和平時一樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140115
					]
				},
				{
					"id": 412140115,
					"content": "那就行，沒有副作用，也沒有污染和毒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140116
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140116,
					"content": "看來…我的認知是正確的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140117
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140117,
					"content": "擺出了一副料事如神的表情呢，這傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140118,
					"content": "劍好用嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140119,
						412140120
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140119,
					"content": "好用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140121,
					"content": "是嗎。不管怎麼說，它也達到了我想要的狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140122
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140122,
					"content": "把劍拿起來了…阿貝多，你要用它嗎？你、你不要做傻事啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140123,
					"content": "#我要把被{F#妳}{M#你}淨化過的純粹生命之力提取出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140124
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140124,
					"content": "力量也能單獨存在嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140125,
					"content": "或許別人做不到，但我可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140126
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140126,
					"content": "…好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140127
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140127,
					"content": "哇，這種力量，好像一個光球…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140128,
					"content": "啊！放到神秘的瓶子裡了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412140129,
					"content": "雖然這把劍算不上神兵利器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140130
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140130,
					"content": "#做個紀念吧。希望以後它也能在旅途中幫助{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140131,
						412140132
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140131,
					"content": "真的可以嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140133,
					"content": "#我要的是與它有關的實驗結果，現在我得到了我要的東西，劍應該留給擅長使用它的{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140134
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140134,
					"content": "#旅行者，謝謝{F#妳}{M#你}幫我完成這次研究。那麼，再見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140135
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140135,
					"content": "能與我發生共鳴的，龍的生命之力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140136
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140136,
					"content": "並非因為它是龍，而是因為我的緣故。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140137
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140137,
					"content": "萊茵多特…師父…這就是你曾經創造的巨龍「杜林」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140138
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140138,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412140139
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140139,
					"content": "我與它的相會，真的是一件好事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412140132,
					"content": "你不需要它了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140133
					]
				},
				{
					"id": 412140120,
					"content": "難用。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140121
					]
				},
				{
					"id": 412140105,
					"content": "答應你的事，我都做完了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412140106
					]
				}
			]
		}
	]
}