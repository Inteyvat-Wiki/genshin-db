			"dialogs": [
				{
					"id": 411500301,
					"content": "聽說有特別訂單…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411500302
					]
				},
				{
					"id": 411500302,
					"content": "是這樣的。鈴官這個糊塗姑娘點了一份來來菜，說是等會回來吃。我猜她又逛到什麼地方回不來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500303
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411500303,
					"content": "#{F#妳}{M#你}把這份給她送過去吧。<color=#00E1FFFF>走路穩點，不要亂飛亂跑</color>，怕漏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500304
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411500304,
					"content": "<color=#00E1FFFF>還有就是別沾著奇怪的元素攪和了味道</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411500305
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 411500305,
					"content": "如果餐點成色壞了，你們就回來找我，我重新弄一份。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "言笑"
				}
			]
		},
