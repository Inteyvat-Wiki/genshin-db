			"dialogs": [
				{
					"id": 752400101,
					"content": "朋友，歡迎來到阿亞爾英雄盃的比賽現場，我是這裡的主持人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400102
					],
					"speakerTitle": "納瓦特拉利"
				},
				{
					"id": 752400102,
					"content": "#今天已經是賽程的最後一天，如果{F#妳}{M#你}想奪冠，{F#妳}{M#你}必須連續擊敗排名前三的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400107
					],
					"speakerTitle": "納瓦特拉利"
				},
				{
					"id": 752400107,
					"content": "阿亞爾英雄盃是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400108
					]
				},
				{
					"id": 752400108,
					"content": "#是角逐阿亞爾榮耀的戰鬥！用{F#妳}{M#你}的拳頭或者武器或者任何方式擊倒對手吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400109
					],
					"speakerTitle": "納瓦特拉利"
				},
				{
					"id": 752400109,
					"content": "阿亞爾又是什麼人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						752400110
					]
				},
				{
					"id": 752400110,
					"content": "朋友，在這裡只有冠軍才有發問的資格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						752400111
					],
					"speakerTitle": "納瓦特拉利"
				},
				{
					"id": 752400111,
					"content": "#上臺吧，讓我看看{F#妳}{M#你}有沒有實力獲得尊敬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納瓦特拉利"
				}
			]
		},
