			"dialogs": [
				{
					"id": 756730101,
					"content": "看來，調色家阿夏已經心滿意足了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730102
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730102,
					"content": "我們成功幫助神奇的阿夏，完成了又一個特別的挑戰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730103
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730103,
					"content": "好耶，收集顏料大成功~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756730104,
					"content": "這隻阿夏是馬上就來靈感了嘛，等不及要去作畫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730105,
						756730106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756730105,
					"content": "「噼喀」的那一剎轉瞬即逝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				},
				{
					"id": 756730107,
					"content": "#啊，它還留下了不少自己收集的財寶呢…都給{NICKNAME}和派蒙當辛苦費才對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730108
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730108,
					"content": "說不定，過段時間我們再來，就能看見調色家阿夏的新傑作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730109
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730109,
					"content": "普通的阿夏就能噴出很好看的色彩了，這種特別的阿夏，會有多厲害呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756730110,
					"content": "哎呀，感覺已經開始期待了，說不定真能被它們調出什麼…普通語言形容不出來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756730111,
					"content": "燃素啊，月亮啊，星空深處的顏色？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756730112,
					"content": "對嘛，在冒險過程中，只要遇見了遭遇困難的生靈，就盡可能給對方最真誠的幫助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730113
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730113,
					"content": "嗯嗯！說不定哪天，還能得到意想不到的回報呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730114,
						756730115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756730114,
					"content": "我也贊成班尼特。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730116,
					"content": "啊，不過…如果只為了回報而去幫助，有點本末倒置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730117
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730117,
					"content": "就算沒有任何酬勞，看見問題被解決，原本面露難色的朋友們開心起來，一切事情都在向著好的方向發展…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756730118
					],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730118,
					"content": "我喜歡這種感覺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "班尼特"
				},
				{
					"id": 756730115,
					"content": "這樣感覺很充實。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730116
					]
				},
				{
					"id": 756730106,
					"content": "誰也不想放過靈感最好的時候吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756730107
					]
				}
			]
		}
	]
