			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"羅蘭"
				],
				"points": [
					{
						"sceneId": 20337,
						"position": [
							529.233,
							11.86,
							435.322
						],
						"pointId": 3
					},
					{
						"sceneId": 20337,
						"position": [
							529.205,
							11.864,
							433.945
						],
						"pointId": 4
					}
				]
			},
			"dialogs": [
				{
					"id": 760690401,
					"content": "這種感覺…看來是我沒發現的「狼靈」碎片顯化成的化身啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690402
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 760690402,
					"content": "那是誰把你留在了這裡？又是為了守護什麼？現在…就告訴我答案吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690403
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 760690403,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690404
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 760690404,
					"content": "…我重複過許多次了，染血的道路，有我一人足矣，不需要他人的追隨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690405
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 760690405,
					"content": "哈，那就當我們只是剛好同路吧？剛好從蒙德同路到挪德卡萊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690406
					]
				},
				{
					"id": 760690406,
					"content": "又剛好被某位騎士救過無數次、剛好對那位騎士心懷憧憬…所以忍不住，也踏上了相近的道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690407
					]
				},
				{
					"id": 760690407,
					"content": "就算不能理解，至少也想在近旁見證…哪怕這一路下來，就只剩下我們幾個了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690408
					]
				},
				{
					"id": 760690408,
					"content": "嗷嗚——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690409
					]
				},
				{
					"id": 760690409,
					"content": "如果這就是你們認定的騎士道…我無權否認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690410
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 760690410,
					"content": "……",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760690411
					]
				},
				{
					"id": 760690411,
					"content": "那些該死的魔物…都被消滅了嗎？附近的居民…都沒事了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690412
					]
				},
				{
					"id": 760690412,
					"content": "咳…太好了…只可惜，我們沒那個力氣見證您走到最後…真不甘心啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690413
					]
				},
				{
					"id": 760690413,
					"content": "從今往後，就只有您一個人了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690414
					]
				},
				{
					"id": 760690414,
					"content": "…到最後，我的劍還是沒能守護一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690415
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 760690415,
					"content": "…到最後，這條路上終究只剩下一人…或許從一開始，就本該如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690416
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 760690416,
					"content": "至少讓這些劍，與此地的狼靈為你們守墓吧——為了不讓漆黑的孽物，驚擾你們的安眠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690417
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 760690417,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690418
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 760690418,
					"content": "原來是這樣…騎士團裡有過記載，「染血騎士」出走時曾有騎士自發追隨，卻沒有了下文。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690419
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 760690419,
					"content": "沒想到最後的結局，是為征討魔物而埋骨在這裡…不愧是西風騎士團的騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690420
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 760690420,
					"content": "但你們的「願望」，真的止步於此了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690421
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 760690421,
					"content": "至今未熄的戰火、寄宿於劍的思念…請告訴我，「騎士」們的決意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690422
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 760690422,
					"content": "我將用玻瑞亞斯遺落於此的力量封鎖這片戰場…那頭小狼也會在外為你們守靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690423
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 760690423,
					"content": "你們理應得到這樣的「守護」——永遠不被驚擾、永遠得享安寧、永遠…不必再見這世間的不公。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690424
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 760690424,
					"content": "永別了——我最後的「戰友」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690425
					],
					"speakerTitle": "羅蘭"
				},
				{
					"id": 760690425,
					"content": "…不…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690426
					]
				},
				{
					"id": 760690426,
					"content": "…不要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690427
					]
				},
				{
					"id": 760690427,
					"content": "…讓我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690428
					]
				},
				{
					"id": 760690428,
					"content": "…再一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690429
					]
				},
				{
					"id": 760690429,
					"content": "果然——你們的「願望」…不是在這種不見天日的地方默默朽去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690430
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 760690430,
					"content": "那就來吧！跟我一起，再一次——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760690431
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 760690431,
					"content": "——奔赴戰場！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				}
			]
		}
	]
}