			"trigger": {
				"objectNames": [
					"戚定"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710550201,
					"content": "在…在哪裡啊，丟在哪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550202
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550202,
					"content": "要是找不到的話…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550203
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550203,
					"content": "這人身上怎麼這麼重的火藥味…你是誰啊？為什麼出現在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550204,
					"content": "我的名字叫戚定。我、我丟了東西在這，一定要找回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550205
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550205,
					"content": "戚定？這不就是沐寧說的，那個失蹤了的礦工的名字嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550206,
					"content": "得把他帶回營地裡去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550207,
					"content": "不行！我不回營地！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550208
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550208,
					"content": "我東西沒找著，不回去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550209
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550209,
					"content": "那、那你在找什麼東西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550210,
					"content": "我、我在找一個玩具，就一個娃娃，手掌那麼大的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550211
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550211,
					"content": "下了一次礦，就不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550212,
						710550213
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550212,
					"content": "隨身帶玩具？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550214
					]
				},
				{
					"id": 710550214,
					"content": "我知道聽上去有點奇怪，但是我是怕那個娃娃丟了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550215
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550215,
					"content": "#{F#妳}{M#你}們是不知道那個娃娃有多難買到，價錢高得嚇人，而且飛雲商會每次新上一批的時候我都在礦裡…想買都買不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550216
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550216,
					"content": "但是我女兒上次看到別家小孩抱著一個就走不動路嘞。我這個女兒呀，知道家裡情況不好，想要什麼從來不說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550217
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550217,
					"content": "可是做父親的怎麼不知道孩子想要什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550218
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550218,
					"content": "這不是剛託認識的人從飛雲商會那裡買了一個，送到礦裡，貼身帶著，可不敢弄丟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550219
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550219,
					"content": "結果還是弄丟了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550220,
					"content": "唉…我們這些下礦的，本來就賺得少，大部分也都用來補貼家用了，存下來的不多，買這個娃娃還花了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550221
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550221,
					"content": "不過錢嘛，總是可以再賺，但是、但是我上次寫信跟女兒說，說爸爸已經買到了妳想要的玩偶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550222
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550222,
					"content": "這個月回家該怎麼辦呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550223
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550223,
					"content": "她從來不說，就算我兩手空空回去，她肯定也不會說啥，但是…嗚嗚，你怎麼能看那雙失望的眼睛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550224
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550224,
					"content": "聽起來好可憐啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550225,
					"content": "不如我們幫他找找那個玩偶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550226
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550226,
					"content": "只能盡力找找吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550227
					]
				},
				{
					"id": 710550227,
					"content": "不過，層岩巨淵這裡還是太危險了。先一起回營地，我們再下來幫你找找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710550228,
					"content": "#真的嗎？那真是太感謝{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550213,
					"content": "帶著娃娃下礦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550214
					]
				}
			]
		},
