			"dialogs": [
				{
					"id": 710550401,
					"content": "這不是戚定嗎，你跑到哪去了，沐寧都派人到營地來找你了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550402
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710550402,
					"content": "#怎麼{NICKNAME}也在旁邊，怎麼了，出了什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550403
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710550403,
					"content": "我、我的玩具不見了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550404
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550404,
					"content": "你的玩具？你的什麼玩具啊，你也不看看你，都這個歲數了還玩什麼玩具？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550405
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710550405,
					"content": "不是，不是我的，是給我女兒買的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550406
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550406,
					"content": "就那個，一個手掌那麼大的，飛雲商會的娃娃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550407
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550407,
					"content": "喔，就你買給你女兒的那個娃娃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550408
					],
					"speakerTitle": "瑾武"
				},
				{
					"id": 710550408,
					"content": "對，對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710550409
					],
					"speakerTitle": "戚定"
				},
				{
					"id": 710550409,
					"content": "可是那個娃娃…那個娃娃丟了…",
