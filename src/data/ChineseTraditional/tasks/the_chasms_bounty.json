			},
			"dialogs": [
				{
					"id": 710551201,
					"content": "#是{F#妳}{M#你}們幫忙找到戚定的吧，我都聽瑾武說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551202
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551202,
					"content": "他說不想下礦了？那也好，就讓他回去休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551203
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551203,
					"content": "#{F#妳}{M#你}說「許願石」作祟？哪有這種東西，不過就是礦坑下面環境太壓抑，正常人待久了都會精神失常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551204
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551204,
					"content": "#如果沒有{F#妳}{M#你}，這次戚定還不知道會怎麼樣。那些精神失常的礦工，後來都花了很久才恢復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551205
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551205,
					"content": "他們甚至都不清楚自己身上發生了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551206
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551206,
					"content": "#{F#妳}{M#你}這段時間常在層岩巨淵跑，自己也要小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551207
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551207,
					"content": "#{F#妳}{M#你}沒看到戚定剛被送上來的樣子，一邊哭，一邊還大聲叫著女兒、女兒什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551208
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551208,
					"content": "啊，說起他的女兒，我們還碰到戚楠了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551209,
					"content": "戚楠？喔，不就是戚定的女兒嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551210
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551210,
					"content": "怎麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551211
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551211,
					"content": "他的女兒，那個小女孩，之前在下面跟我們一起找那個玩具娃娃，幸好後來她平安無事從層岩巨淵裡出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551212,
					"content": "#戚定的女兒戚楠？小女孩？{F#妳}{M#你}在說什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551213
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551213,
					"content": "戚定的女兒今年都考進總務司，是個大姑娘了，而且總務司最近正在準備找專家重新查探層岩巨淵的事，怎麼可能有空到這兒來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551214
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551214,
					"content": "可是我們明明看見…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551215,
					"content": "#我不管{F#妳}{M#你}們看見了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551216
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551216,
					"content": "#這樣，{F#妳}{M#你}們就當什麼也沒看見吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551217
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710551217,
					"content": "#好了好了，戚定已經平安無事回來了，{F#妳}{M#你}們也…也好好休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "沐寧"
				}
			]
		},
