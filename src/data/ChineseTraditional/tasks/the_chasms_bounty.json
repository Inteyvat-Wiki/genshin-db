				"points": []
			},
			"dialogs": [
				{
					"id": 710551001,
					"content": "#哎呀，{F#妳}{M#你}們怎麼把牠們全都打跑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551002
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710551002,
					"content": "牠們剛才還在跟我玩呢，嘻嘻，牠們想要抓住我，但是每次都撲了個空，可好玩了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551003
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710551003,
					"content": "要是牠們撲中了，可就不好玩了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710551004,
					"content": "#沒關係的…牠們撲不中我的，對了，{F#妳}{M#你}們不是想找那個娃娃嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710551005
					],
					"speakerTitle": "戚楠"
				},
				{
					"id": 710551005,
					"content": "嘻嘻，那個娃娃就在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戚楠"
				}
			]
		},
		{
			"id": 7105511,
			"completionStepIds": [
