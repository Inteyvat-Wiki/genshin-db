					"speakerTitle": "戚定"
				},
				{
					"id": 710550424,
					"content": "當然了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710550426
					]
				},
				{
					"id": 710550426,
					"content": "我下礦的時候，就去了這麼個地方…",
