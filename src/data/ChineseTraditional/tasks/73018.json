			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭般度",
					"派蒙",
					"蘭百梨迦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730180201,
					"content": "#那菈{NICKNAME}，還有派蒙，感謝{F#妳}{M#你}們幫助了蘭那羅。可以感受到，各處堵塞溪流的小枝已經被移除了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180202
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730180202,
					"content": "喔！現在我們可以去治好法留納神機了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180203,
					"content": "很快，但是還沒有。根系在很深很深的地下，通向地下的入口在法留納法寶的中心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180204
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730180204,
					"content": "「法留納法寶」，好像蘭般度提過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180205,
					"content": "#是法留納神機的力量的顯現，它發揮力量的時候，比桓那最高的樹更高，那菈{NICKNAME}和派蒙早就見過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180206
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730180206,
					"content": "是說那個時不時噴射水柱的地方？…難道我們要從那玩意的中心進去？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180207,
						730180209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180207,
					"content": "看起來可不像是入口。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180208
					]
				},
				{
					"id": 730180208,
					"content": "對呀對呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180211,
					"content": "萬一我們準備進去的時候它正好啟動了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180212,
					"content": "那麼高的水柱，而且水勢看起來也很強的樣子…完全想不出來該怎麼進到它的中心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180213,
						730180215,
						730180217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180213,
					"content": "只能想辦法從上面進去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180214
					]
				},
				{
					"id": 730180214,
					"content": "#就算我能飛上去，{NICKNAME}也上不去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180219,
					"content": "為什麼會這樣？讓它停下就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180220
					],
					"speakerTitle": "蘭百梨迦"
				},
				{
					"id": 730180220,
					"content": "原來它還能停下的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180221,
					"content": "#之前是不行的，但是因為那菈{NICKNAME}和派蒙的幫助，法留納神機的力量恢復了一部分，現在蘭那羅可以讓它停下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180222
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730180222,
					"content": "我們居然不知不覺做了這麼了不起的事情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180223,
						730180225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180223,
					"content": "倒也不是不知不覺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180224
					]
				},
				{
					"id": 730180224,
					"content": "啊，確實，夢景林莽那裡找起來真不容易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180227,
					"content": "#那菈{NICKNAME}，派蒙，我們一起過去。綠枝已經開過花，就快要到結果的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730180225,
					"content": "派蒙真是太厲害啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180226
					]
				},
				{
					"id": 730180226,
					"content": "#{NICKNAME}也厲害，嘿嘿，我們都厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180215,
					"content": "只能正面硬闖了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180216
					]
				},
				{
					"id": 730180216,
					"content": "聽說有種修行方法是在瀑布下接受水流的沖洗…我們隨隨便便衝過去一定會被捲走的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180217,
					"content": "也許可以在旁邊挖個地道下去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180218
					]
				},
				{
					"id": 730180218,
					"content": "這是什麼嶄新的解決方法？…等等，說不定真的有一試的價值…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180209,
					"content": "進不去，怎麼想都進不去吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180210
					]
				},
				{
					"id": 730180210,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180211
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
