						730180813
					],
					"speakerTitle": "蘭貢迪"
				},
				{
					"id": 730180813,
					"content": "我們彼此彼此啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180814,
					"content": "總之，蕈獸什麼的一點也不可怕嘛！如果真的是蕈獸的巢穴…今天晚飯就吃蘑菇全餐！",
