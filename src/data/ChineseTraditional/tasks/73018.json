					"nextDialogs": [
						730180404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180404,
					"content": "那這水能喝嗎？會不會有什麼特別的效果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180405,
						730180414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180405,
					"content": "說不定會返老還童。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730180406
					]
				},
				{
					"id": 730180406,
					"content": "#欸？那會是{NICKNAME}還是我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
