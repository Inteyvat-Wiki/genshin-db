				"points": []
			},
			"dialogs": [
				{
					"id": 730180401,
					"content": "超近距離看感覺更震撼了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730180402,
					"content": "法留納神機，來自草木之王的創造，帶來生命的水，把巴螺迦變成桓那，過去的黃色用綠色替代，讓不毛的土地從此充滿生機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730180403
					],
					"speakerTitle": "蘭般度"
				},
				{
					"id": 730180403,
					"content": "聽起來好神奇喔，「帶來生命的水」…唔…",
