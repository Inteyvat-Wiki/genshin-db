			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾拉·馬斯克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070101,
					"content": "Ye ika gusha mosi！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070102,
						700070103
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700070102,
					"content": "感覺妳心情不太好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				},
				{
					"id": 700070104,
					"content": "不好意思，因為最近圖書館實在非常吵鬧，我很難安靜下來研究丘丘人語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070105
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700070105,
					"content": "風花節開始之後，有很多人到這裡來約會。他們一開始還能保持安靜地看看書，後來就聊起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070106
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700070106,
					"content": "而且…而且他們還做了各種可怕的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070107
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700070107,
					"content": "把書的書角折壞…在書頁裡塞各種奇奇怪怪的東西…甚至、甚至他們還把書倒著插進書架！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070108
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700070108,
					"content": "圖書館又不是談情說愛的地方！這樣只會打擾到真正在這裡看書做研究的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070109,
						700070111
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700070109,
					"content": "威拉格應該來維持秩序。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070110
					]
				},
				{
					"id": 700070110,
					"content": "他也沒什麼好辦法，把人趕走也只是治標不治本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700070113,
					"content": "#總之，麻煩{F#妳}{M#你}幫幫忙，讓這裡的人都安靜下來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070114,
						700070115
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700070114,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070116,
					"content": "#謝謝{F#妳}{M#你}，最吵鬧的就是那邊的三對，只要讓他們注意到影響，我就能繼續研究了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070117
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700070117,
					"content": "不過當心點，他們都沒那麼好對付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700070115,
					"content": "我試試看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070116
					]
				},
				{
					"id": 700070111,
					"content": "可以找麗莎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070112
					]
				},
				{
					"id": 700070112,
					"content": "但我聽說，她現在正在陪代理團長巡邏，暫時不在。如果她在的話，這些情侶肯定會收斂很多的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070113
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700070103,
					"content": "語氣比平常更凶了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070104
					]
				}
			]
		},
