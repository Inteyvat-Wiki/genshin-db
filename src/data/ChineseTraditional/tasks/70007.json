					"變魔術的男性",
					"陷入愛河的女性"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070301,
					"content": "嗯？請問有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070302,
						700070303
					],
					"speakerTitle": "陷入愛河的女性"
				},
				{
					"id": 700070302,
					"content": "圖書館應該保持安靜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				},
				{
					"id": 700070304,
					"content": "抱歉，我會注意的，但有時候，會有不可抗拒的因素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070305
					],
					"speakerTitle": "陷入愛河的女性"
				},
				{
					"id": 700070305,
					"content": "比如，在妳沒注意到的時候，我從書頁後取出了一朵玫瑰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070306
					],
					"speakerTitle": "變魔術的男性"
				},
				{
					"id": 700070306,
					"content": "從書中誕生的玫瑰，就像妳一樣，充滿了溫柔和知性美…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070307
					],
					"speakerTitle": "變魔術的男性"
				},
				{
					"id": 700070307,
					"content": "哇？！好厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070308
					],
					"speakerTitle": "陷入愛河的女性"
				},
				{
					"id": 700070308,
					"content": "聲音太大了！還有，不能用書本來變魔術！會折壞的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070309,
					"content": "派蒙的聲音也大起來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070310
					]
				},
				{
					"id": 700070310,
					"content": "哦，對不起，一不小心就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070311,
					"content": "#{F#妳}{M#你}也明白了吧，有時候這就是不可抗拒的因素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070312
					],
					"speakerTitle": "陷入愛河的女性"
				},
				{
					"id": 700070312,
					"content": "我會注意控制我的聲音的，實在不好意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070313
					],
					"speakerTitle": "陷入愛河的女性"
				},
				{
					"id": 700070313,
					"content": "看起來，他們完全沒聽進去呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070303,
					"content": "有人說你們太吵了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070304
					]
				}
			]
		},
