			"trigger": {
				"objectNames": [
					"看似理性的男性",
					"看似理性的女性"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070401,
					"content": "你所主張的「情感波動會影響研究分析的準確性」，還是沒有確切的論據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070402
					],
					"speakerTitle": "看似理性的女性"
				},
				{
					"id": 700070402,
					"content": "唉，我明白，我現在可能是陷入了一種奇怪的瓶頸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070403
					],
					"speakerTitle": "看似理性的男性"
				},
				{
					"id": 700070403,
					"content": "你們來得正好，我有一個困擾，需要聽聽外人的意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070404
					],
					"speakerTitle": "看似理性的男性"
				},
				{
					"id": 700070404,
					"content": "如果我要證明我理論的正確性，就要保證我沒有情感的波動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070405
					],
					"speakerTitle": "看似理性的男性"
				},
				{
					"id": 700070405,
					"content": "但我總是做不到這件事，尤其是和她在討論的時候，我總是不能冷靜下來好好思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070406
					],
					"speakerTitle": "看似理性的男性"
				},
				{
					"id": 700070406,
					"content": "我也覺得有點奇怪，難道是睡眠不足嗎？還是昨天酒精攝取過多了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070407,
						700070408
					],
					"speakerTitle": "看似理性的女性"
				},
				{
					"id": 700070407,
					"content": "總之，圖書館不可以大聲講話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070408
					]
				},
				{
					"id": 700070408,
					"content": "總之，先壓低音量吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070409
					]
				},
				{
					"id": 700070409,
					"content": "抱歉，但在弄明白這件事之前，我就是不甘心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070410
					],
					"speakerTitle": "看似理性的男性"
				},
				{
					"id": 700070410,
					"content": "完、完全聽不懂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070411,
					"content": "呃，總之，不能打擾別人，還有，看過的書不能倒著塞進書架！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070412,
					"content": "好吧…他們好像不理我們了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
