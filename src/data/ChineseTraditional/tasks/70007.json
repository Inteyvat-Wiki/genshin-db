			"dialogs": [
				{
					"id": 700070801,
					"content": "關於圖書館的吵鬧聲…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070802
					]
				},
				{
					"id": 700070802,
					"content": "原來如此，那應該可以用「那個辦法」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070803
					],
					"speakerTitle": "威拉格"
				},
				{
					"id": 700070803,
					"content": "麗莎小姐說過，如果有人違反了圖書館的規定，就必須要受到懲罰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070804
					],
					"speakerTitle": "威拉格"
				},
				{
					"id": 700070804,
					"content": "#麻煩{F#妳}{M#你}們去圖書館裡，傳達麗莎小姐的意思吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070805
					],
					"speakerTitle": "威拉格"
				},
				{
					"id": 700070805,
					"content": "折壞書頁、塞玫瑰花進書裡、把書倒著插進書架…一定算是違反圖書館規則吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070806,
					"content": "我們走，去向那些來圖書館卻不讀書的人傳達一下麗莎小姐的意思吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
