			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"熱戀中的青年",
					"熱戀中的少女"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700070201,
					"content": "真是感人的故事啊，可惜最後沒有一個圓滿的結局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070202
					],
					"speakerTitle": "熱戀中的青年"
				},
				{
					"id": 700070202,
					"content": "我們以後不會變成那樣的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070203
					],
					"speakerTitle": "熱戀中的少女"
				},
				{
					"id": 700070203,
					"content": "那是當然的，就算我們相隔天涯海角，我也會想辦法把你帶回我的身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070204,
						700070205
					],
					"speakerTitle": "熱戀中的青年"
				},
				{
					"id": 700070204,
					"content": "圖書館應該保持安靜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				},
				{
					"id": 700070206,
					"content": "欸？我應該很克制我的聲音了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070207
					],
					"speakerTitle": "熱戀中的少女"
				},
				{
					"id": 700070207,
					"content": "唉，或許這也是戀愛的阻礙吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070208
					],
					"speakerTitle": "熱戀中的青年"
				},
				{
					"id": 700070208,
					"content": "看過的書，也應該放回正確的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070209,
					"content": "像現在這樣隨便亂放，負責整理書架的人會很困擾的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070210,
					"content": "知道了，知道了，請不要再打擾我們了，正在關鍵的時候呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070211
					],
					"speakerTitle": "熱戀中的青年"
				},
				{
					"id": 700070211,
					"content": "關鍵的時候…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070212,
					"content": "不管有多少阻礙，你都會像現在這樣，永遠不變吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070213
					],
					"speakerTitle": "熱戀中的少女"
				},
				{
					"id": 700070213,
					"content": "是的，我以我的生命發誓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070214
					],
					"speakerTitle": "熱戀中的青年"
				},
				{
					"id": 700070214,
					"content": "也不用這麼誇張…生命什麼的，我會心疼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070215
					],
					"speakerTitle": "熱戀中的少女"
				},
				{
					"id": 700070215,
					"content": "啊，就是妳這樣的溫柔，令人沉醉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700070216
					],
					"speakerTitle": "熱戀中的青年"
				},
				{
					"id": 700070216,
					"content": "我覺得，他們完全沒聽進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700070205,
					"content": "有人說你們太吵了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700070206
					]
				}
			]
		},
