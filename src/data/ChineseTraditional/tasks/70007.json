					"nextDialogs": [
						700071004
					]
				},
				{
					"id": 700071004,
					"content": "要怎麼辦呢？如果現在開始收拾，還有機會補救吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700071005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700071005,
					"content": "#沒想到{F#妳}{M#你}們能想到這麼好的辦法。",
