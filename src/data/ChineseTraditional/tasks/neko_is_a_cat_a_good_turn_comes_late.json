			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"「寢子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160101,
					"content": "來了啊。石頭人類說，他馬上就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160102
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160102,
					"content": "汝等，快隨奴家去看看吧，石頭人類就在那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				}
			]
		},
		{
			"id": 7221602,
			"completionStepIds": [
				7221602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"2"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平",
					"「寢子」",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160201,
					"content": "呼，總算是要完成了，真是個大工程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160202
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160202,
					"content": "#是{F#妳}{M#你}們啊，還有代宮司大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160203
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160203,
					"content": "怎麼樣，好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160204
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160204,
					"content": "喔！那是當然了，嘿嘿，為了有點儀式感，我可是專門留了最後一個角，等著代宮司大人過來再敲掉呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160205
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160205,
					"content": "真是有心了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160206
					]
				},
				{
					"id": 722160206,
					"content": "嘿嘿，那是當然了，製作雕像這種重要的事，當然要嚴肅對待了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160207
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160207,
					"content": "喵喵…敲石頭，很重要嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160208
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160208,
					"content": "嗯…怎麼說呢，一般來說，做成雕像的東西，都是很重要的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160209
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160209,
					"content": "那派蒙應該給吃的做雕像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160210
					]
				},
				{
					"id": 722160210,
					"content": "喂！真沒禮貌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722160211,
					"content": "也就是好東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160212
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160212,
					"content": "哈哈哈，那應該…嗯…比好東西還好！畢竟雕像這種東西，可以稱得上是「永恆的留念」嘛，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160213
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160213,
					"content": "不是哦。不是「永恆的留念」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160214
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160214,
					"content": "奴家是為了，阿響回來的時候，如果找不到路，可以看到石頭奴家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160215
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160215,
					"content": "然後就知道，自己要到這裡來，而不會走錯，走到別的地方去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160216
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160216,
					"content": "是、是這樣啊。代宮司大人真是對那位「阿響」有心了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160217
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160217,
					"content": "寢子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160218
					]
				},
				{
					"id": 722160218,
					"content": "阿響隨時都會回來的。而且她和百目鬼說過，石頭奴家做好的時候，就會發生好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160219
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160219,
					"content": "話說回來，石頭人類，汝還需要奴家幹什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160220
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160220,
					"content": "倒也沒啥…那麼閒話不說了，既然代宮司大人已經在這裡了，那我可要敲掉這最後一角了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160221
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160221,
					"content": "三…二…一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160222
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160222,
					"content": "這、這雲，到底是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160223,
						722160224
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160223,
					"content": "變成貓的模樣了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				},
				{
					"id": 722160225,
					"content": "是阿響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160226
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160226,
					"content": "欸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160227
					]
				},
				{
					"id": 722160227,
					"content": "阿響？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160228
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160228,
					"content": "喵喵喵！一定是阿響！這就是阿響說的！一定會出現的好事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160229
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160229,
					"content": "她說過的，她和奴家說過的，只要敲好那塊石頭，就一定會出現好事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160230
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160230,
					"content": "太好了，太好了！阿響說的是真的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160231
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160231,
					"content": "她肯定會回來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160232
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160232,
					"content": "喔…喔！哈哈哈，雖然不知道是什麼情況，但看代宮司大人的模樣，這肯定是一件好事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160233
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160233,
					"content": "寢子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160234
					]
				},
				{
					"id": 722160234,
					"content": "有了汝等，神社也變得漂亮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160235
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160235,
					"content": "「塞錢箱」也修好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160236
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160236,
					"content": "「繪馬架」也修好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160237
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160237,
					"content": "還造了石頭奴家。這樣一來，阿響一定會回來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160238
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160238,
					"content": "還有，百目鬼、蛇目，還有好多好多阿響的朋友，都會和阿響一起回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160239
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160239,
					"content": "#汝啊，是好人！比飯還好！阿響會喜歡{F#妳}{M#你}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160240
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160240,
					"content": "奴家得去把小傢伙們叫來，跟他們交代一下，阿響的事情。然後，還有，會有很多人過來拜拜。不好好叮囑他們可不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160241
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160241,
					"content": "在那之前，奴家必須要把所有事情都打理好才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160242
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160242,
					"content": "阿響…喵喵喵！太好了，太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722160224,
					"content": "這到底是怎麼回事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160225
					]
				}
			]
		},
		{
			"id": 7221603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160301,
					"content": "代宮司大人居然這麼高興，看來那個對牠來說，真的是很重要的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160302
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722160302,
					"content": "但是，不知道她到底在哪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7221604,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221602",
							"3"
						],
						"stepId": 7221602,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"悅子",
					"大祐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722160401,
					"content": "確實，「阿響」…「淺瀨神社」和「百目鬼」，都很讓人在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160402,
						722160407
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160402,
					"content": "你們是什麼時候冒出來的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160403
					]
				},
				{
					"id": 722160403,
					"content": "島上鬧出那麼大的動靜，我們自然就過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160404
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160404,
					"content": "#不過，有些事我覺得，必須要和{F#妳}{M#你}們說一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160405
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160405,
					"content": "大祐，說明一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160406
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160406,
					"content": "啊…好的，悅子小姐。是這樣的，我要說的是一些…有關這座清籟島的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160408
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160408,
					"content": "清籟島的歷史實在是太久遠了，雖然協會已經特地搜索過了資料，但還是幾乎沒找到什麼有用的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160409
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160409,
					"content": "根據協會給的資料，幾百年前，這裡似乎曾經是一處「海賊」的聚集點，當時，是由幕府出面掃清了所有海賊，並且把島上的居民都遷移到了別處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160410
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160410,
					"content": "那個「百目鬼」，沒意外的話，也許正是當時和幕府正面衝突過的海賊頭目「赤穗百目鬼」，卷宗裡明確記錄著他的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160411
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160411,
					"content": "據協會給我們的那些資料裡記載，這位「赤穗百目鬼」指揮著海賊的船隊，和幕府在海上作戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160412
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160412,
					"content": "雖然他的船隊很快被幕府壓制了下去，被迫向清籟島逃竄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160413
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160413,
					"content": "但是，幕府的船隊在追擊他的時候，清籟島上突然爆發了一陣不知來由的雷暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160414
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160414,
					"content": "赤穗百目鬼的船隊和幕府的船隊一起被雷暴擊中…就這樣全部失去了蹤跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160415
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160415,
					"content": "雷暴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160416
					]
				},
				{
					"id": 722160416,
					"content": "接下來的我來說吧…這件事裡最大的疑點，就是那場突然出現的雷暴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160417
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160417,
					"content": "雖然赤穗百目鬼的船隊也被雷暴波及，幾乎全滅…但幕府派來清籟島的船隊也幾乎全軍覆沒，被迫退回鳴神島，過了一段時間才重整好了船隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160418
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160418,
					"content": "那場雷暴實在來得太過恰到好處，簡直就像是…有人特意操控的一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160419
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160419,
					"content": "#{F#妳}{M#你}還記得，這座島上特地被解開封印的那些「鎮石」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160420
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160420,
					"content": "還有，我們封印了這些「鎮石」之後，島上的雷暴也平息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160421
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160421,
					"content": "我不想妄下推斷，但是…我感覺這一切多多少少有些關聯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160422
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160422,
					"content": "不然，我們去問問寢子大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160423
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160423,
					"content": "…算了吧。資料記載那位百目鬼失蹤了。說是失蹤，但被那種雷暴擊中，也許已經…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160424
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160424,
					"content": "我們會繼續在這座島上探索，也繼續搜集關於這件事的線索，等過段時間，我們就會回去向協會報告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160425
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160425,
					"content": "呵呵，旅行者，說不定到時候我們還會繼續合作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160426
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160426,
					"content": "到時候請多多關照。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160427
					]
				},
				{
					"id": 722160427,
					"content": "彼此彼此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160428
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160428,
					"content": "大祐，準備一下，我們繼續制訂探索計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160429
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160429,
					"content": "呃…悅子小姐，那寢子大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160430
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160430,
					"content": "你之前怎麼和那隻貓相處，以後也怎麼和那隻貓相處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160431
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160431,
					"content": "但是記住，不要說任何不該說的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160432
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160432,
					"content": "牠…現在應該很開心，不要說任何煞風景的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160433
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160433,
					"content": "我知道了！悅子小姐，嘿嘿，妳果然還是很…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160434
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 722160434,
					"content": "…只不過是為了更好地完成委託而已，快點去工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722160435
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160435,
					"content": "清籟島…看來這座島上，還有很多秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悅子"
				},
				{
					"id": 722160407,
					"content": "你們知道什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722160408
					]
				}
			]
		}
	]
}