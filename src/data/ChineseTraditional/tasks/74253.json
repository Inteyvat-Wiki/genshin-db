			"dialogs": [
				{
					"id": 742530201,
					"content": "平靜的日子，真好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530202,
						742530203
					],
					"speakerTitle": "瑪麗安"
				},
				{
					"id": 742530202,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 742530204,
					"content": "已經這個時間了嗎？哈哈，那我們以後也多聚聚吧，桑多涅小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪麗安"
				},
				{
					"id": 742530203,
					"content": "茶會時間該結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						742530204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
