					}
				]
			},
			"dialogs": [
				{
					"id": 715310101,
					"content": "圓圓滾滾蓬蓬鬆鬆，軟軟彈彈蹦蹦跳跳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310102
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310102,
					"content": "#呀！有客人來了，{F#妳}{M#你}們好{F#妳}{M#你}們好，我文尋先祝兩位海燈節快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310103
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310103,
					"content": "海燈節快樂，文尋小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310104,
					"content": "剛才我們好像聽見妳唸唸有詞，妳在自言自語什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310105,
						715310106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310105,
					"content": "在想好吃的點心？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310107
					]
				},
				{
					"id": 715310107,
					"content": "猜得八九不離十了，我在想的是鍋巴和月桂要做的美食哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310108
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310108,
					"content": "欸？突然就聽到了熟悉的名字…妳也認識鍋巴和月桂嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310109,
					"content": "嘿嘿！那是當然了，我可是萬民堂的常客！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310110
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310110,
					"content": "只要不出門旅行，我一週至少去萬民堂吃七頓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310111
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310111,
					"content": "搭配我家常吃的菜式，一餐清淡、一餐香辣，好不爽快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310112
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310112,
					"content": "就算上火了，抓幾味清火的藥材，好好調理兩天，就能繼續大吃特吃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310113,
						715310114
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310113,
					"content": "聽起來好棒…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310115
					]
				},
				{
					"id": 715310115,
					"content": "我我我，我也有點想試試看這樣的生活了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310116,
					"content": "總之，我差不多每個禮拜都能見到鍋巴和香菱小姐，有時還會遇上瑤瑤小妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310117
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310117,
					"content": "瑤瑤帶著月桂來看望香菱小姐的時候，鍋巴就會和月桂在一邊玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310118
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310118,
					"content": "真好真好，光是看著鍋巴和月桂搖搖晃晃，工作的勞累就一掃而空了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310119
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310119,
					"content": "不能只有我被鍋巴和月桂治癒！我要讓大家都見證鍋巴和月桂的可愛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310120
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310120,
					"content": "說得好！這可是一項大事！不過，具體來說要怎麼做呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310121,
					"content": "難道妳桌上的這些東西就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310122,
					"content": "答對啦！我剛剛完成了一部以鍋巴和月桂為主角的「剪紙戲」，這個攤位上的東西，全都是「剪紙戲」的道具！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310123
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310123,
					"content": "「剪紙戲」…總覺得這個名字有點耳熟？是要在妳後面的畫板上觀看的…映影嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310124,
					"content": "#{F#妳}{M#你}們可能聽說過「紙映劇」，那是一種在璃月流傳已久的藝術。靈活運用畫片和燈具，就能讓畫面在幕布上「活」起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310125
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310125,
					"content": "我從小就非常喜歡「紙映劇」，跟著應公師傅學了一些門道。長大後，我又成了畫師，四處遊學。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310126
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310126,
					"content": "在楓丹旅行期間，我接觸了幾種新的繪畫技巧，還有映影這門技術，有了不少靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310127
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310127,
					"content": "#於是，我嘗試以「紙映劇」為基礎，製作了一種更為新穎的互動遊戲，就是{F#妳}{M#你}們面前的「剪紙戲」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310128
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310128,
					"content": "「剪紙戲」與「紙映劇」的風格不同，著重在講述簡單明快的故事，讓觀眾們會心一笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310129
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310129,
					"content": "所以說今年這第一場「剪紙戲」會和大家講一個非常親切的故事——鍋巴和月桂共同尋找食材、共同製作美食！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310130
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310130,
					"content": "鍋巴和月桂一起做飯？聽起來很有趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310131,
						715310132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715310131,
					"content": "好吃的和好玩的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310133
					]
				},
				{
					"id": 715310133,
					"content": "#嘿嘿，看見{F#妳}{M#你}們兩位興致高漲，我大受鼓舞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715310134
					],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310134,
					"content": "那事不宜遲，就請兩位放鬆心情，好好體驗一下「剪紙戲」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "文尋"
				},
				{
					"id": 715310132,
					"content": "我也要仔細看看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310133
					]
				},
				{
					"id": 715310114,
					"content": "妳小心一點…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310115
					]
				},
				{
					"id": 715310106,
					"content": "還是什麼新食譜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715310107
					]
				}
			]
		}
	]
}