			"dialogs": [
				{
					"id": 200490201,
					"content": "日落果，蘋果…到底買哪個比較好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490202
					],
					"speakerTitle": "優律"
				},
				{
					"id": 200490202,
					"content": "唉，要是寧錄在這的話，直接買他喜歡的就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490203
					],
					"speakerTitle": "優律"
				},
				{
					"id": 200490203,
					"content": "抱歉，優律小姐，日落果已經賣光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490204
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200490204,
					"content": "是這樣嗎？哎呀，那就只能買蘋果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490205
					],
					"speakerTitle": "優律"
				},
				{
					"id": 200490205,
					"content": "呃，優律小姐，這些蘋果很不新鮮了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490206
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200490206,
					"content": "咦？是這樣嗎，但是我也沒別的能選了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490207
					],
					"speakerTitle": "優律"
				},
				{
					"id": 200490207,
					"content": "我們來幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200490208,
					"content": "#咦？{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490209
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200490209,
					"content": "就交給我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490210
					]
				},
				{
					"id": 200490210,
					"content": "放心吧，我們會去找新鮮的<color=#00E1FFFF>日落果</color>回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200490211,
					"content": "是，是這樣嗎？那就拜託了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490212
					],
					"speakerTitle": "昆恩"
				},
				{
					"id": 200490212,
					"content": "那太好了，寧錄也更喜歡吃日落果一些，那我在這先等著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "優律"
				}
			]
		},
