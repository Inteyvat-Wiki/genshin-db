			"trigger": {
				"objectNames": [
					"寧錄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200490101,
					"content": "好想喝杯酒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490102
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200490102,
					"content": "但要是被優律發現我喝了酒，那就全完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490103
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200490103,
					"content": "你怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490104
					]
				},
				{
					"id": 200490104,
					"content": "嗯？哦…哦，我就是想喝點酒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490105
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200490105,
					"content": "我老婆優律最看不得我喝酒了，平時在家裡，我幾乎滴酒不能沾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490106
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200490106,
					"content": "我只能趁她上街買東西的時候，才能偷偷過來安靜地喝幾杯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490107
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200490107,
					"content": "你也太喜歡喝酒了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490108
					]
				},
				{
					"id": 200490108,
					"content": "#{F#妳}{M#你}說這什麼話！蒙德人怎麼可能不喝酒嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490109
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200490109,
					"content": "#拜託{F#妳}{M#你}，去幫我拖住優律一點時間，讓我喝個一杯兩杯就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490110
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200490110,
					"content": "買東西的時候，只要有很多選擇，優律就會一直猶豫，下不了判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490111
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200490111,
					"content": "如果能讓她一直有很多選擇，她就會一直猶豫下去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490112,
						200490114
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200490112,
					"content": "我知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490113
					]
				},
				{
					"id": 200490113,
					"content": "#哈哈哈，那就拜託{F#妳}{M#你}了，祝{F#妳}{M#你}酒運昌隆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200490114,
					"content": "你要喝多久？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200490115
					]
				},
				{
					"id": 200490115,
					"content": "#哈哈哈，那就要看{F#妳}{M#你}能夠拖多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490116
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200490116,
					"content": "不，不是，我只要能安靜地喝一杯就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200490117
					],
					"speakerTitle": "寧錄"
				},
				{
					"id": 200490117,
					"content": "#這是一位蒙德酒客的承諾，拜託{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "寧錄"
				}
			]
		},
