			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 790510101,
					"content": "這裡有一本日記，看起來保存得還不錯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510102
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790510102,
					"content": "呼…真是鬆了口氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510103
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790510103,
					"content": "這個畫家的心結完全解開了，畫技也得到了提升，肯定能幹出一番大事業來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510104
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790510104,
					"content": "不過，他最後還是離開了，沒有一直陪著這些小「小水珠」朋友，我倒是覺得有點遺憾呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510105,
						790510106
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790510105,
					"content": "也許藝術家不太能接受摹刻品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				},
				{
					"id": 790510107,
					"content": "嗯，不是不能理解啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510108
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790510108,
					"content": "還有一點我沒想通，他提到了，自己留下的這幅壁畫可能變形錯位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510109
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790510109,
					"content": "結果之前的事故那麼猛烈…壁畫錯位的問題，好像並不是特別嚴重？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510110,
						790510111
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790510110,
					"content": "關鍵在於這些「小水珠」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510112,
					"content": "原來如此！難怪「小水珠」們對「聚流映燈」和修復壁畫那麼熟悉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790510113
					],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790510113,
					"content": "嗚…我有點感動，「小水珠」雖然看起來不怎麼聰明，但真的很體貼，很忠心，好適合當成重要的朋友…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "閱讀"
				},
				{
					"id": 790510111,
					"content": "它們保護了朋友的壁畫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510112
					]
				},
				{
					"id": 790510106,
					"content": "堅守自己的獨一無二也有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790510107
					]
				}
			]
		},
