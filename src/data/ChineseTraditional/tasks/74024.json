					{
						"sceneId": 3,
						"position": [
							2408.11,
							252.736,
							4985.173
						],
						"pointId": 340300092
					},
					{
						"sceneId": 3,
						"position": [
							2408.264,
							252.729,
							4986.404
						],
						"pointId": 340300093
					}
				]
			},
			"dialogs": [
				{
					"id": 740240101,
					"content": "咦，妳一個人在這裡做什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240102,
					"content": "哇啊！不要突然從別人背後搭話呀，差一點就把磨好的粉末弄撒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240103
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240103,
					"content": "粉末？唔，這些東西是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240104,
					"content": "是寶石喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240105
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240105,
					"content": "寶、寶石？為什麼這裡會有寶石啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240106,
					"content": "沒有寶石才比較奇怪吧？畢竟，這裡是我用來處理寶石的工坊嘛，雖然還沒有正式名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240107
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240107,
					"content": "之前也想過，乾脆直接叫「希露艾工坊」之類的，但用自己的名字命名，果然還是不太適合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240108
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240108,
					"content": "處理寶石？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240109
					]
				},
				{
					"id": 740240109,
					"content": "就是把寶石變成各式各樣漂亮的飾品…之類的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240110
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240110,
					"content": "不過，最近一段時間，我應該也沒辦法再接受新的委託了，因為需要全心全意製作顏料…雖然也是用寶石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240111
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240111,
					"content": "用、用寶石來製作顏料？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240112,
					"content": "嗯？怎麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240113
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240113,
					"content": "唔，總覺得好浪費…不需要寶石的話，其實可以直接給我的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240114,
					"content": "不過，為什麼要製作顏料呢？用寶石打造飾品的過程中，應該不需要這樣的步驟才對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240115,
					"content": "之前，有個喜歡畫畫的孩子來問過我，能不能做出像寶石一樣閃耀、像太陽一樣璀璨的顏料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240116
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240116,
					"content": "而就在前段時間，村子晃得很厲害的時候，她救下了我的妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240117
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240117,
					"content": "所以，我希望能實現她的心願，做出「像太陽一樣璀璨的顏料」，作為答謝她的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240118
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240118,
					"content": "妳說的難道是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240119
					]
				},
				{
					"id": 740240119,
					"content": "…喂，妳說的那個「喜歡畫畫的孩子」，該不會是叫瑪梅赫吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240120,
					"content": "…？是的…兩位認識她嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240121
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240121,
					"content": "向希露艾講述了此前與瑪梅赫一同經歷的事情…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740240122
					]
				},
				{
					"id": 740240122,
					"content": "#難、難道說，兩位就是與瑪梅赫一起救了芙佳的{NICKNAME}大人和派蒙大人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240123
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240123,
					"content": "大、大人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240124,
						740240125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240124,
					"content": "是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				},
				{
					"id": 740240126,
					"content": "真的非常感謝兩位…！要不是兩位的話，芙佳可能就會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240127
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240127,
					"content": "如果不介意的話，請一定要收下這些…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240128,
						740240130
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240128,
					"content": "（漂亮的寶石…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240129
					]
				},
				{
					"id": 740240129,
					"content": "#可以收下嗎，{NICKNAME}？看起來好像很貴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240131,
					"content": "不過，沒想到那個瑪梅赫居然還會主動委託別人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240132,
					"content": "倒也不能算是委託吧？畢竟，她只是問我能不能做出來，我還沒回答完，她就直接跑掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240133
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240133,
					"content": "這個，的確很像是瑪梅赫會做出來的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240134,
					"content": "#說起來，{NICKNAME}大人、派蒙大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240135
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240135,
					"content": "在兩位看來，「最接近太陽色彩的東西」是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240136
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240136,
					"content": "雖然我也試著觀察過太陽的模樣，但我不太清楚，究竟要用什麼樣的素材，才能重現出那樣的色彩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240137
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240137,
					"content": "唔，「接近太陽色彩的東西」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240138,
						740240141,
						740240145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240138,
					"content": "…黃金？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240139
					]
				},
				{
					"id": 740240139,
					"content": "嗯，夏諾蒂拉之前也說過，「黃金是太陽滴落的淚水」什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240140
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240140,
					"content": "不過，用黃金做顏料，未免也有點太奢侈了吧？應該還有更普通的替代品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240148,
					"content": "總之，說到「接近太陽色彩的東西」，我們應該見過才對，而且應該是很常見的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240141,
					"content": "…太陽？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240142
					]
				},
				{
					"id": 740240142,
					"content": "…原來如此。不愧是您。最接近太陽色彩的東西，的確是太陽本身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240143
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240143,
					"content": "但是，要怎麼才能把太陽磨成粉末呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240144
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240144,
					"content": "不，別一本正經地說出這種莫名其妙的話啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240145,
					"content": "既然如此，就用我的頭髮…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240146
					]
				},
				{
					"id": 740240146,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240147
					],
					"speakerTitle": "希露艾"
				},
				{
					"id": 740240147,
					"content": "不，再怎麼說頭髮也沒辦法用來做顏料吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740240148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740240130,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240131
					]
				},
				{
					"id": 740240125,
					"content": "雖然稱不上是「大人」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740240126
					]
				}
			]
		},
