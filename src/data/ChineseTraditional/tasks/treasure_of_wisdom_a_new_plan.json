			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"德魯蘇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030101,
					"content": "唔，這個地方不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030102
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030102,
					"content": "你又在研究謎語嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030103
					]
				},
				{
					"id": 735030103,
					"content": "#旅行者！{F#妳}{M#你}來得正好，我正準備設計一段全新的連續謎題呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030104
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030104,
					"content": "#這裡的地形有點複雜。{F#妳}{M#你}看，港口的一側有一根「聖樹」的巨大根系入水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030105
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030105,
					"content": "另一側則是一片巨大的荷葉，和一堆待出港的船隻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030106
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030106,
					"content": "#旅行者，{F#妳}{M#你}覺得這段謎語以哪一邊的景物為主題最好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030107,
						735030110,
						735030113
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030107,
					"content": "還是從根系入手吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030108
					]
				},
				{
					"id": 735030108,
					"content": "是嗎？「聖樹」的巨大根系確實很顯眼，作為謎語的「切入點」也很容易被感知到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030109
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030109,
					"content": "好！那我就以根系為主題寫一道謎語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030115,
					"content": "嘿嘿嘿，我來寫一段。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030115,
						735030116
					]
				},
				{
					"id": 735030116,
					"content": "嘿嘿嘿，交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030117
					]
				},
				{
					"id": 735030117,
					"content": "#我說，{F#妳}{M#你}怎麼笑得怎麼這麼開心啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030118,
					"content": "#寫好了，給{F#妳}{M#你}看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030119
					]
				},
				{
					"id": 735030119,
					"content": "「有智歸海處，寶藏側帆間。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030120
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030120,
					"content": "讀起來真不錯！而且這道謎語也很容易讓人聯想到「港口」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030121
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030121,
					"content": "和「有智歸海」相搭配，也不難解答出這個地點和教令院或者須彌城有關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030122
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030122,
					"content": "#沒想到{F#妳}{M#你}還有這方面的才能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030123
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030123,
					"content": "稍等一下，我把這道謎語給貼在容易被發現的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030124
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030124,
					"content": "欸？就貼在這附近？可謎語所說的位置也不遠啊？說不定馬上就會被發現的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030125,
					"content": "哈哈哈，我這也是在給解謎的人劃定解謎範圍啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030126
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030126,
					"content": "要是不這麼做，那解謎的範圍可就太大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030127
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030127,
					"content": "德魯蘇開始佈置起了謎語…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030128
					]
				},
				{
					"id": 735030128,
					"content": "好了，這裡的謎語就這樣吧，我們去下一個地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030129
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030129,
					"content": "欸？還有下一個地方啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030110,
					"content": "蓮葉和船隻很有趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030111
					]
				},
				{
					"id": 735030111,
					"content": "確實…把這兩者聯繫起來的話，也許有著別樣的趣味性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030112
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030112,
					"content": "沒問題，我就以這個主題來寫一道謎語好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030113,
					"content": "這些都太簡單了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030114
					]
				},
				{
					"id": 735030114,
					"content": "#太簡單了？那{F#妳}{M#你}有什麼想法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030115,
						735030116
					],
					"speakerTitle": "德魯蘇"
				}
			]
		},
		{
			"id": 7350302,
			"completionStepIds": [
				7350302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7350302",
							"2"
						],
						"stepId": 7350302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德魯蘇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735030201,
					"content": "好！就在這裡佈置第二個謎題吧，只要解開這個謎題，就能找到最終的寶箱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030202
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030202,
					"content": "我準備把最終的寶藏設定在…那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030203
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030203,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030204,
					"content": "呃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030205
					]
				},
				{
					"id": 735030205,
					"content": "這不就是一個普普通通的小山坡，旁邊有個普普通通的小瀑布嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030206,
					"content": "沒錯！但它馬上就會因為我們的謎語而不普通了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030207
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030207,
					"content": "#好了，旅行者，{F#妳}{M#你}對這一道謎語有什麼建議呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030208,
						735030211,
						735030214
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030208,
					"content": "別折騰了，直接點吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030209
					]
				},
				{
					"id": 735030209,
					"content": "欸？是這樣嗎？唔…解謎的人翻山越嶺到這裡來，確實會感到疲憊啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030210
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030210,
					"content": "好，那就簡單一點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030219,
					"content": "不能說是特別學過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030219,
						735030220
					]
				},
				{
					"id": 735030220,
					"content": "只能說是熟能生巧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030221
					]
				},
				{
					"id": 735030221,
					"content": "#原來如此，不愧是旅行者啊，真是博聞廣識…好，我這就把{F#妳}{M#你}寫的謎語給佈置下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030222
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030222,
					"content": "德魯蘇開始佈置起了謎語…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735030223
					]
				},
				{
					"id": 735030223,
					"content": "好了！這個小告示牌應該夠顯眼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030224
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030224,
					"content": "那我們現在就去佈置最後的寶箱吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030211,
					"content": "用瀑布為主題吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030212
					]
				},
				{
					"id": 735030212,
					"content": "唔…瀑布確實是一個很明確的主題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030213
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030213,
					"content": "沒問題，就以它為主題好了。而且這最後一道謎題的難度…就稍微下調一點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030214,
					"content": "嘿嘿嘿，我來寫一段。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030215
					]
				},
				{
					"id": 735030215,
					"content": "#喂！{F#妳}{M#你}笑得越來越開心了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735030216,
					"content": "寫好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735030217
					]
				},
				{
					"id": 735030217,
					"content": "「青傘懷寶望珠簾。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030218
					],
					"speakerTitle": "德魯蘇"
				},
				{
					"id": 735030218,
					"content": "#呃…這謎語，讀起來還真是特別…{F#妳}{M#你}在哪裡專門學過這方面的學問嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735030219,
						735030220
					],
					"speakerTitle": "德魯蘇"
				}
			]
		},
		{
			"id": 7350303,
