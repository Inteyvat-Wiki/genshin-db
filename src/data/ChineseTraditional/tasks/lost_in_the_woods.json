				]
			},
			"dialogs": [
				{
					"id": 750000101,
					"content": "喂、喂…大傢伙，你還好嗎？還站得起來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000102,
					"content": "看起來好虛弱，真是的，到底發生了什麼啊…那些飄浮幽靈狗真讓人討厭，果然飄著的傢伙都不是什麼好東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000103,
					"content": "妳自己不是也飄著嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000104
					]
				},
				{
					"id": 750000104,
					"content": "我和那些傢伙怎麼會一樣啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000105,
					"content": "#不說那些了，快，{NICKNAME}，我們看看還有什麼吃的，給這個大傢伙吃一點，然後…然後讓牠好好休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000106,
					"content": "這樣牠一定可以恢復一點精神的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000107,
						750000108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000107,
					"content": "已經太晚了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000109
					]
				},
				{
					"id": 750000109,
					"content": "怎麼會這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000110,
					"content": "呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000111
					],
					"speakerTitle": "大傢伙？"
				},
				{
					"id": 750000111,
					"content": "#嗚…牠現在一定很不舒服，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000112,
						750000113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000112,
					"content": "你的敵人已經被我清理掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000114,
					"content": "呼呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000115
					],
					"speakerTitle": "大傢伙？"
				},
				{
					"id": 750000115,
					"content": "是…還有什麼放心不下的東西嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000116
					]
				},
				{
					"id": 750000116,
					"content": "你想要…告訴我什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000117
					]
				},
				{
					"id": 750000117,
					"content": "伸出…伸出手來，受龍…所選者…伸出手來…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000118
					]
				},
				{
					"id": 750000118,
					"content": "聯結…力量，然後，去見證一切，以此，解放一切…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						750000119
					]
				},
				{
					"id": 750000119,
					"content": "#{NICKNAME}，{F#妳}{M#你}怎麼了啊！快，快做點什麼啊，不是發呆的時候啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000120,
					"content": "沒有，剛才可能只是眼花了一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000121
					]
				},
				{
					"id": 750000121,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000122
					],
					"speakerTitle": "大傢伙？"
				},
				{
					"id": 750000122,
					"content": "嗚…嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000123
					],
					"speakerTitle": "大傢伙？"
				},
				{
					"id": 750000123,
					"content": "這是你的願望，還是…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000124
					]
				},
				{
					"id": 750000124,
					"content": "（向著瀕死的獸伸出手…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000125
					]
				},
				{
					"id": 750000125,
					"content": "#{F#妳}{M#你}是在做什麼啦…咦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750000126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000126,
					"content": "#{NICKNAME}，{F#妳}{M#你}…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 750000113,
					"content": "休息一下吧，了不起的大傢伙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750000114
					]
				},
				{
					"id": 750000108,
