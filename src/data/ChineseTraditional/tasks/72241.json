					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿倍良久",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410201,
					"content": "啊啊…異鄉的旅者，是汝啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410202
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410202,
					"content": "託汝之福，吾現在魂魄完全，已回想起了一切，真是不可思議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410203
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410203,
					"content": "可能汝已知曉，長久以前，白夜國僅有一片黑暗，生活在此處的諸民深受深海龍嗣侵擾之害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410204
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410204,
					"content": "那時，由吾主持建造大日御輿，從此白夜國才有了晝夜之替，也有了「白夜」這一國名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410205
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410205,
					"content": "寓示：「自大日御輿建成之後，雖此地只有常世之夜，亦可因分黑白。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410206
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410206,
					"content": "真是令人汗顏，在離魂歸位之前，竟連大日御輿建成之日，眾人雲集景從之時都已忘得一乾二淨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410207
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410207,
					"content": "可悲啊，那本來應是吾銘記於心之景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410208
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410208,
					"content": "只可惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410209
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410209,
					"content": "可惜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410210,
					"content": "大日御輿建成，不熟悉光亮的龍嗣立刻潰敗，白夜之民終於得以安養生息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410211
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410211,
					"content": "只是一旦安定下來…人心難測，鴨胗難剝，誰也不知他人會生出何等醜惡念頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410212
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410212,
					"content": "異鄉的旅者啊，貪婪小人一有可乘之機，就想攫取…比應得之物多上太多的，財富，權力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410213
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410213,
					"content": "這些人利用民眾，開始推行大日御輿崇拜。將人心寄託於虛妄死物已是愚昧至極。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410214
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410214,
					"content": "到了最後…甚至推舉「太陽{RUBY#[D]法厄同}之子」以統治白夜之國。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410215
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410215,
					"content": "太陽之子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410216
					]
				},
				{
					"id": 722410216,
					"content": "正是，每一任，都會有一位稚童被選作太陽之子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410217
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410217,
					"content": "理所當然，這些孩子尚且懵懂，根本不可能擔任一國之君，如何行事，不過是一具棚頭傀儡，順從其背後那些齷齪小人們的意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410218
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410218,
					"content": "吾想要反對，卻被他們指使的太陽之子判下謀逆大罪，終生監禁於此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410219
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410219,
					"content": "啊，太陽之子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410220,
					"content": "那豈不是總有一天，他會知道自己被人擺佈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410221,
					"content": "故，凡太陽之子，無人能長大。一旦長大，就不再那麼容易被齷齪小人們操縱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410222
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410222,
					"content": "「太陽之子，誕辰御祝，至天馬之架席，共烈日之饗…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410223,
						722410224
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410223,
					"content": "難道說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				},
				{
					"id": 722410225,
					"content": "嗯，他們全都被送至了大日御輿內部，於誕生祭禮，盛裝打扮，興高采烈之時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410226
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410226,
					"content": "…藏於此處的物件，就與他們有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410227
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410227,
					"content": "這是證明太陽之子正身的御轡，吾藏於此，想以後將之遞出，可讓世人警醒，只不過，時至今日已毫無意義了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410228
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410228,
					"content": "異鄉的旅者啊，那些孩子，這個國家，是吾無法保護完全的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410229
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410229,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410230
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410230,
					"content": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410231
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410231,
					"content": "吾主持建造大日御輿，於常夜之中高懸明亮之鏡，已自以為天縱之才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410232
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410232,
					"content": "吾有如此才能，如此才能啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410233
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410233,
					"content": "吾本以為可用大日御輿滌蕩黑暗，但誰曾想大日御輿之上，人心之欲壑難填貪婪無饜，才是足以覆過一切的陰晦永夜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410234
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410234,
					"content": "異鄉的旅客，吾現在將此御轡交至汝之手中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410235
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410235,
					"content": "這枚「神輿之轡」就是這段可笑至極的荒唐歷史的見證…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410236
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410236,
					"content": "請務必好好留存…不，就隨汝喜好處置吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410237
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410237,
					"content": "過於貴重了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410238
					]
				},
				{
					"id": 722410238,
					"content": "此物本就已無甚意義，今日能魂魄歸一，將此物交到汝手上，時也命也，對此物來說，或也算是一類善終了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410239
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410239,
					"content": "如此才能…如此才能啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410224,
					"content": "在某個生日…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410225
					]
				}
			]
		},
		{
			"id": 7224103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿倍良久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410301,
					"content": "啊…煩請汝取回位於狹間之街，靈廟之前與蛇心之地三處的供奉。這樣，吾魂魄歸一，即可打開大日御輿之上的道路…",
					"roleType": "TALK_ROLE_NPC",
