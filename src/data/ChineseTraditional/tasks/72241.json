			"dialogs": [
				{
					"id": 722410601,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410602
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410602,
					"content": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410603
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410603,
					"content": "我、我是派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410604,
						722410609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410604,
					"content": "在這裡自我介紹？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410605
					]
				},
				{
					"id": 722410605,
					"content": "#在對方報上名字的時候，{F#妳}{M#你}也要報上名字……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410606,
					"content": "據說是有這樣的禮節的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410607,
					"content": "無妨。汝等遠道而來，吾以此狼狽姿態，亦無法進行接待，也是失禮之至。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410608
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410608,
					"content": "#沒有關係，{NICKNAME}和我也不會介意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410613,
					"content": "不過，這位殘魂先生為什麼會留在這裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410614,
					"content": "吾…吾乃赫利俄斯的建造者，此處為…吾殞命之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410615
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410615,
					"content": "在黑暗冰冷之所，昏昏睡去便再無法醒來…吾怎可這樣死去，吾可是，赫利俄斯之建造者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410616
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410616,
					"content": "赫利俄斯的建造者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410617,
					"content": "赫利俄斯是什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410618,
					"content": "啊…是了，赫利俄斯只是建造時吾私下的稱謂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410619
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410619,
					"content": "雖然不知汝等是否知曉，不過，白夜國民所熟知的名字是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410620
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410620,
					"content": "大日御輿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410621
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410621,
					"content": "赫利俄斯即大日御輿，運載「許伯{RUBY#[D]白夜之光}利翁」的太陽之車。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410622,
						722410623
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410622,
					"content": "大日御輿的建造者？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410624,
					"content": "正是吾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410625
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410625,
					"content": "異鄉的旅者啊…吾雖建造大日御輿，卻被人幽禁，幽禁在了大日御輿之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410626
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410626,
					"content": "死去之後，魂魄離散於白夜國各地，甚至記憶也有所散佚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410627
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410627,
					"content": "吾記得有很重要的東西…有很重要的東西在大日御輿之上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410628
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410628,
					"content": "但吾忘記了，異鄉的旅者啊，拜託汝…取回我被供奉於三處的衣、冠與骸骨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410629
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410629,
					"content": "分別在狹間之街、靈廟之前與蛇心之地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410630
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410630,
					"content": "將之供奉於三座祭台之上…這樣，吾魂魄歸一，即可打開通向大日御輿之上的道路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410631
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410631,
					"content": "通往大日御輿之上，被隱藏於常夜帷幕的幽閉之間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410623,
					"content": "就是你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410624
					]
				},
				{
					"id": 722410609,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410610
					]
				},
				{
					"id": 722410610,
					"content": "……是嗎，竟是來自異鄉的旅客啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410611
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410611,
					"content": "汝遠道而來，吾以此狼狽姿態，亦無法進行接待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410612
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410612,
					"content": "沒關係的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410613
					],
					"speakerTitle": "派蒙"
				}
			]
		},
