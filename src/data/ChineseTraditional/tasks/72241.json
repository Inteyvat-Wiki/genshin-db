			"trigger": {
				"objectNames": [
					"阿倍良久",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722410801,
					"content": "啊啊…異鄉的旅者，是汝啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410802
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410802,
					"content": "託汝之福，吾現在魂魄完全，已回想起了一切，真是不可思議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410803
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410803,
					"content": "可能汝已知曉，長久以前，白夜國僅有一片黑暗，生活在此處的諸民深受深海龍嗣侵擾之害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410804
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410804,
					"content": "那時，由吾主持建造大日御輿，從此白夜國才有了晝夜之替，也有了「白夜」這一國名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410805
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410805,
					"content": "寓示：「自大日御輿建成之後，雖此地只有常世之夜，亦可因分黑白。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410806
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410806,
					"content": "真是令人汗顏，在離魂歸位之前，竟連大日御輿建成之日，眾人雲集景從之時都已忘得一乾二淨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410807
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410807,
					"content": "可悲啊，那本來應是吾銘記於心之景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410808
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410808,
					"content": "只可惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410809
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410809,
					"content": "可惜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410810
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410810,
					"content": "大日御輿建成，不熟悉光亮的龍嗣立刻潰敗，白夜之民終於得以安養生息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410811
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410811,
					"content": "只是一旦安定下來…人心難測，鴨胗難剝，誰也不知他人會生出何等醜惡念頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410812
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410812,
					"content": "異鄉的旅者啊，貪婪小人一有可乘之機，就想攫取…比應得之物多上太多的，財富，權力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410813
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410813,
					"content": "這些人利用民眾，開始推行大日御輿崇拜。將人心寄託於虛妄死物已是愚昧至極。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410814
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410814,
					"content": "到了最後…甚至推舉「太陽{RUBY#[D]法厄同}之子」以統治白夜之國。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410815
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410815,
					"content": "太陽之子？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410816
					]
				},
				{
					"id": 722410816,
					"content": "正是，每一任，都會有一位稚童被選作太陽之子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410817
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410817,
					"content": "理所當然，這些孩子尚且懵懂，根本不可能擔任一國之君，如何行事，不過是一具棚頭傀儡，順從其背後那些齷齪小人們的意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410818
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410818,
					"content": "吾想要反對，卻被他們指使的太陽之子判下謀逆大罪，終生監禁於此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410819
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410819,
					"content": "啊，太陽之子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410820,
					"content": "那豈不是總有一天，他會知道自己被人擺佈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722410821,
					"content": "故，凡太陽之子，無人能長大。一旦長大，就不再那麼容易被齷齪小人們操縱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410822
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410822,
					"content": "「太陽之子，誕辰御祝，至天馬之架席，共烈日之饗…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410823,
						722410824
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410823,
					"content": "難道說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				},
				{
					"id": 722410825,
					"content": "嗯，他們全都被送至了大日御輿內部，於誕生祭禮，盛裝打扮，興高采烈之時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410826
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410826,
					"content": "…藏於此處的物件，就與他們有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410827
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410827,
					"content": "這是證明太陽之子正身的御轡，吾藏於此，想以後將之遞出，可讓世人警醒，只不過，時至今日已毫無意義了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410828
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410828,
					"content": "異鄉的旅者啊，那些孩子，這個國家，是吾無法保護完全的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410829
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410829,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410830
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410830,
					"content": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410831
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410831,
					"content": "吾主持建造大日御輿，於常夜之中高懸明亮之鏡，已自以為天縱之才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410832
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410832,
					"content": "吾有如此才能，如此才能啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410833
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410833,
					"content": "吾本以為可用大日御輿滌蕩黑暗，但誰曾想大日御輿之上，人心之欲壑難填貪婪無饜，才是足以覆過一切的陰晦永夜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410834
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410834,
					"content": "異鄉的旅客，吾現在將此御轡交至汝之手中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410835
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410835,
					"content": "這枚「神輿之轡」就是這段可笑至極的荒唐歷史的見證…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410836
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410836,
					"content": "請務必好好留存…不，就隨汝喜好處置吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410837
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410837,
					"content": "過於貴重了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410838
					]
				},
				{
					"id": 722410838,
					"content": "此物本就已無甚意義，今日能魂魄歸一，將此物交到汝手上，時也命也，對此物來說，或也算是一類善終了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722410839
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410839,
					"content": "如此才能…如此才能啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722410824,
					"content": "在某個生日…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722410825
					]
				}
			]
		},
