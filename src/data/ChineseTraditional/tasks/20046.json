					"安娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200460201,
					"content": "#完成啦！謝謝{F#妳}{M#你}旅行者，這次的護送任務很順利呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460202
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200460202,
					"content": "不過，冒險家平時去執行的委託，都是這種事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460203,
						200460205
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200460203,
					"content": "會有其他委託的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460204
					]
				},
				{
					"id": 200460204,
					"content": "#{F#妳}{M#你}的語氣也太無奈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200460207,
					"content": "是這樣嗎…好嘞！那我要繼續努力了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460208
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200460208,
					"content": "等我存夠了錢，就帶著哥哥和爸爸媽媽一起出去旅行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460209
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200460209,
					"content": "哥哥他之前一直想出去旅行的，可是…因為我生病了，他必須留下來照顧我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460210
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200460210,
					"content": "現在我的病已經好了，也成為了冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460211
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200460211,
					"content": "嘿嘿，是時候幫我哥哥完成一些夢想啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200460205,
					"content": "妳慢慢就會知道了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200460206
					]
				},
				{
					"id": 200460206,
					"content": "#喂，{F#妳}{M#你}的表情不要這麼疲憊啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200460207
					],
					"speakerTitle": "安娜"
				}
			]
		},
