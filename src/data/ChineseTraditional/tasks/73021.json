			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"蘭阿帕斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730210101,
					"content": "哇，這個鍋子裡燉的是什麼呀，聞上去真香。只是聞著，口水就不停流下來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210102,
					"content": "好像是什麼湯的樣子，嗯…也看不出來是用什麼素材做的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210103,
					"content": "#哎呀，{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210104,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210105
					]
				},
				{
					"id": 730210105,
					"content": "#{F#妳}{M#你}看現在，燉湯的人也不在，這個湯這麼香，我們不如偷偷喝一口嚐一嚐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210106,
						730210108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210106,
					"content": "那我們就偷偷喝一口吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210107
					]
				},
				{
					"id": 730210107,
					"content": "好耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210112,
					"content": "鍋容量比看起來的要小。\\n裡面的內容物就這樣全部不見了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210113
					]
				},
				{
					"id": 730210113,
					"content": "噗哈…嗯？這個湯，香倒是很香，但是怎麼感覺嚐不出什麼味道呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210114,
					"content": "#蘭穆護昆達在上！{F#妳}{M#你}們這些那菈，怎麼回事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210115
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210115,
					"content": "蘭、蘭那羅？到底是從哪裡突然出現的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210116,
					"content": "#從地裡啦！不說這個，{F#妳}{M#你}們怎麼能偷喝我做的湯，那可是我蘭阿帕斯辛辛苦苦做出來的湯耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210117,
						730210120
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210117,
					"content": "對不起…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210118
					]
				},
				{
					"id": 730210118,
					"content": "對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210119,
					"content": "哼，偷喝了我做的湯，一句對不起就夠了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210123,
					"content": "#{F#妳}{M#你}們知道在這裡做湯有多難嗎？一下子，天上下雨。一下子，太陽出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210124
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210124,
					"content": "#我好不容易做了這麼一鍋，竟然在採新鮮的香辛果的時候，被{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210125
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210125,
					"content": "我們只是因為味道太香才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210126,
					"content": "不過，既然這麼困難，為什麼要在這裡做湯呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210127,
					"content": "哼，烹飪最關鍵的東西，必須每天都要取得的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210128,
						730210129
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210128,
					"content": "是身為廚師的自尊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210130,
					"content": "是水！是水啦！湯的香味，受水影響很大，當然要用最好的水來做湯啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210131
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210131,
					"content": "我一路上，在水天叢林取各個地方的水來做湯。採集了好多好多、有樹上的葉子那麼多的水樣以後，才找到了最好的「活源水」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210132
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210132,
					"content": "#那才是配得上無憂節的「至上珍饈」！就算跟{F#妳}{M#你}們說這個，{F#妳}{M#你}們一定也不明白吧…只有之前那個那菈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210133
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210133,
					"content": "說到這個，其實我們是從蘭帕卡提那來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210134,
					"content": "向蘭阿帕斯述說事情的經過。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730210135
					]
				},
				{
					"id": 730210135,
					"content": "啊，原來是「妹妹」的那菈朋友！而且，要舉辦無憂節了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210136
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210136,
					"content": "不過沒有關係，我已經取得「活源水」，我的「至上珍饈」已經完成。就在這個鍋裡…然後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210137
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210137,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210138
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210138,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210139
					]
				},
				{
					"id": 730210139,
					"content": "欸嘿嘿。你別難過，湯聞起來真的很香…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210140,
					"content": "啊，我的「活源水」！水的源頭住著「亞普修那」，好不容易等到它們離開水源，我才取了一鍋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210141
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210141,
					"content": "#不行，{F#妳}{M#你}們一定要再取一鍋「活源水」賠給我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210142
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210142,
					"content": "「亞普修那」…？那是什麼東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210143,
					"content": "哼，那菈對森林真是一點也不瞭解。就是那種住在水裡的，四條腿、有尾巴、會咬咬的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210144
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210144,
					"content": "…狗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210145,
						730210146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210145,
					"content": "狗不住在水裡吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210147,
					"content": "啊，也對。那「亞普修那」到底是什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210148,
					"content": "別管「亞普修那」了！我要水！而且要那邊的「活源水」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210149
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210149,
					"content": "#好啦好啦…{NICKNAME}，沒辦法，我們走吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210150,
						730210151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210150,
					"content": "哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210152,
					"content": "一定要「活源水」，其他的水都不行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210151,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210152
					]
				},
				{
					"id": 730210146,
					"content": "哪來的水狗。水之幻形狗嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210147
					]
				},
				{
					"id": 730210129,
					"content": "是不忘初心的意志？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210130
					]
				},
				{
					"id": 730210120,
					"content": "都、都是派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210121
					]
				},
				{
					"id": 730210121,
					"content": "#喂！{NICKNAME}，{F#妳}{M#你}居然出賣我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210122,
					"content": "我才不管是誰喝的啦，反正我的湯沒有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210123
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730210108,
					"content": "這不太好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210109
					]
				},
				{
					"id": 730210109,
					"content": "我是真的很好奇嘛，嗚，我就偷偷喝一口，就一口！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730210110,
					"content": "要是喝壞肚子就不好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730210111
					]
				},
				{
					"id": 730210111,
					"content": "哼哼，可不要小看派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730210112
					],
					"speakerTitle": "派蒙"
				}
			]
		},
