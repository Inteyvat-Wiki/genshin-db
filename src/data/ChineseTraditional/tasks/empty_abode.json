			"dialogs": [
				{
					"id": 3890301,
					"content": "堵住了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3890302,
					"content": "堵住了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890303
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3890303,
					"content": "嗯…那邊的<color=#00E1FFFF>屋頂</color>，是不是碎了個<color=#00E1FFFF>大洞</color>？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3890304,
					"content": "嗯…那邊的<color=#00E1FFFF>風場</color>，好像可以利用一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890305
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3890305,
					"content": "好，繞路吧。我們上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3890306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3890306,
					"content": "好，繞路吧。我們上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		},
		{
			"id": 38906,
