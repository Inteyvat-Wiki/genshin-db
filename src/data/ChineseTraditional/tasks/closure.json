			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"夏沃蕾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191871901,
					"content": "在警備隊趕來之前，這裡就由我們看管吧。放心，他們不會再有機會溜走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191871902,
						191871903
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 191871902,
					"content": "還有一些好奇的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191871904
					]
				},
				{
					"id": 191871904,
					"content": "嗯…涉案原料還有很多正規用途，不只是能用來製備「仿製樂斯」，所以不會直接違禁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191871905
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 191871905,
					"content": "港口一般會暫時扣留，等通過各種申報再允許過關，否則就退回原船。艾洛迪應該就是在退回之前，偷換了原料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191871906
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 191871906,
					"content": "載著原料來的海外船隻，多半也是她事先聯絡好的，所以收到了調換過的貨品後，依舊心照不宣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191871907
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 191871907,
					"content": "這些罪行我們還會繼續追查。既然抓住了艾洛迪，剩下的也只是時間問題了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 191871903,
					"content": "艾洛迪是怎麼偷換原料的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191871904
					]
				}
			]
		},
		{
			"id": 1918720,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1918705",
							"2"
						],
						"stepId": 1918705,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"林尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191872001,
					"content": "今天「認真模式」的執行時長算是破紀錄了吧…還真少見，是因為誰呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872002,
						191872003
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872002,
					"content": "還有一些好奇的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191872004
					]
				},
				{
					"id": 191872004,
					"content": "唔…按之前查到的線索，「仿製樂斯」先是在楓丹小規模流通，後來才從小買賣變成大走私。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872005
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872005,
					"content": "一開始流通的，應該是皮埃爾早期製備的存貨。但他粗劣的犯罪，很快就被身為巡警的艾洛迪發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872006
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872006,
					"content": "艾洛迪從中看到了能大量牟利，甚至改頭換面、重新生活的機會，所以一邊暗中掩飾他的早期罪行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872007
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872007,
					"content": "一邊以貝努瓦的名義寫信，用收集的罪證和鉅額的利潤，威逼利誘皮埃爾配合她的後續計畫吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872008
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872008,
					"content": "可惜，遇到了琳妮特。別看她平時不喜歡想太多，「認真模式」下的她可比誰都敏銳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191872009
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872009,
					"content": "#…不過這個模式的「耗能」也很快。我們一會兒還要做筆錄，陪她「充能」的事，可就交給{F#妳}{M#你}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林尼"
				},
				{
					"id": 191872003,
					"content": "皮埃爾是怎麼入夥的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191872004
					]
				}
			]
		}
	]
}