			"dialogs": [
				{
					"id": 722761201,
					"content": "#{F#妳}{M#你}們回來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761202
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761202,
					"content": "你好，呃…那個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761203
					]
				},
				{
					"id": 722761203,
					"content": "矢部啊矢部！我叫矢部！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761204
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761204,
					"content": "#唉，好好把我名字記住啊。我說，{F#妳}{M#你}該不會把我委託的事情忘了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761205
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761205,
					"content": "#{NICKNAME}在開玩笑啦。我們已經找到了文谷秘寶的真相了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722761206,
					"content": "和矢部講述了整個事情的經過…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722761207
					]
				},
				{
					"id": 722761207,
					"content": "所以說，陽炎幻法和寶藏密室確有其事？但是中途還發生過別的故事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761208
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761208,
					"content": "#怨靈和污穢也確有其事，還能控制人的心智。哎喲，嚇壞我了。還好沒和{F#妳}{M#你}們一起去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761209
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761209,
					"content": "害怕傷害我們？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761210
					]
				},
				{
					"id": 722761210,
					"content": "#害怕被{F#妳}{M#你}們壓在地上打。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761211
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761211,
					"content": "#總之有點滿足又有點遺憾，謝謝{F#妳}{M#你}們啦。雖然確實很神奇，但是好像也都是元素力能解釋的，有點失望啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761212
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722761212,
					"content": "文谷的謎案終於可以結掉了，我回去就讓全世界知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "矢部"
				}
			]
