					"小柳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722761001,
					"content": "怎麼…怎麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761002
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761002,
					"content": "發生了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722761003,
					"content": "我居然對我的朋友下手了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761004
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761004,
					"content": "一定是文谷佈下的怨靈上了我的身，控制了我的神智…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761005
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761005,
					"content": "這麼點秘寶，如何能比得上我和他的友誼。我、我絕對不會因為這麼點財寶就動了歹念的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761006
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761006,
					"content": "他那麼信任我，找到了文谷之寶都會約我一同前來見證…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761007
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761007,
					"content": "我不是這樣的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761008
					],
					"speakerTitle": "小柳"
				},
				{
					"id": 722761008,
					"content": "唔，所以最後一塊碎片掩蓋了這個真相嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722761009,
					"content": "讓他自己靜一靜吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722761010
					]
				},
				{
					"id": 722761010,
					"content": "說的也是呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722761011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722761011,
					"content": "我們回去和矢部說一聲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
