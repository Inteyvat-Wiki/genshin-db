			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"矢部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722760101,
					"content": "#嘿，{F#妳}{M#你}是叫{NICKNAME}對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760102
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760102,
					"content": "#不知道{F#妳}{M#你}有沒有記住我的名字。我叫做矢部。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760103
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760103,
					"content": "你好，矢部。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760104
					]
				},
				{
					"id": 722760104,
					"content": "#{F#妳}{M#你}好{F#妳}{M#你}好，嘿嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760105
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760105,
					"content": "#說來，{F#妳}{M#你}應該身手挺厲害的吧。又是直面雷電將軍又是縱橫淵下宮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760106
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760106,
					"content": "確有其事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760107
					]
				},
				{
					"id": 722760107,
					"content": "#那太好了。我這裡有個關於寶藏的線索，但是可能很危險。{F#妳}{M#你}有興趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760108
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760108,
					"content": "我雖然天生喜歡一些稀奇古怪的東西，但是終究還是愛惜這條小命的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760109
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760109,
					"content": "有興趣，講講。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760110
					]
				},
				{
					"id": 722760110,
					"content": "我在大日御輿趁著巡查之便，找到了這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760111
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760111,
					"content": "看起來只是一個石板。但是我覺得它應該就是找到「文谷秘寶」的關鍵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760112
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760112,
					"content": "文谷秘寶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760113
					]
				},
				{
					"id": 722760113,
					"content": "白夜國的詳細歷史不太在海祇島流傳。我也不是很清楚啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760114
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760114,
					"content": "有個故事說，文谷是第二任宰相，和「太陽之子」一起橫徵暴斂。然後他把財寶藏在了大日御輿的秘密房間裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760115
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760115,
					"content": "最後他利用陽炎幻法把寶藏密室藏起來了，還召喚了地脈裡的穢鬼和怨念看守財寶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760116
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760116,
					"content": "照理來說，文谷應該也有個什麼忒什麼斯的古代名字。但是小人和佞臣的故事也沒人記錄得這麼清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760117
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760117,
					"content": "說回石板吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760118
					]
				},
				{
					"id": 722760118,
					"content": "這個石板應該就是解鎖文谷藏寶室的關鍵。我對怪談傳說、神秘案件之類的事情，可是有著長年累月的研究——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760119
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760119,
					"content": "這一塊石板上面的…呃…就是那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760120
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760120,
					"content": "說實話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722760121
					]
				},
				{
					"id": 722760121,
					"content": "其實我在大日御輿儲藏間找到這塊石板的時候，旁邊就有雙語寫的說明紙條。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760122
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760122,
					"content": "過渡時期歸檔的文物好像都會用雙語進行說明登記。而說明就寫了，這個石板和「文谷案」直接相關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760123
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760123,
					"content": "說明還提到了石板的總數是八塊，目前只回收了這一個。文谷密室根據記載也就在附近的那個位置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722760124
					],
					"speakerTitle": "矢部"
				},
				{
					"id": 722760124,
					"content": "#那就麻煩{F#妳}{M#你}們過去看看了。寶藏我倒是真的無所謂，能見證「文谷案」的結局我就很開心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "矢部"
				}
			]
		},
		{
			"id": 7227602,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7227601",
							"3"
						],
						"stepId": 7227601,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"矢部"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722760201,
					"content": "#那就麻煩{F#妳}{M#你}們過去看看了。千萬別勉強自己啊，這種玄妙的事情還挺危險的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "矢部"
				}
			]
		},
