			"trigger": {
				"objectNames": [
					"清晝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090401,
					"content": "您可有收穫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090402
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718090402,
					"content": "有不少。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090403
					]
				},
				{
					"id": 718090403,
					"content": "哦？請說來聽聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090404
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718090404,
					"content": "南碼頭上有很多狗。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090405
					]
				},
				{
					"id": 718090405,
					"content": "哦，不錯不錯，頗有生活氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090406
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718090406,
					"content": "「不卜廬」附近有很多團雀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090407
					]
				},
				{
					"id": 718090407,
					"content": "團雀，唔…也能算是寧和之象，入詩正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090408
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718090408,
					"content": "有人只在意吃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090409
					]
				},
				{
					"id": 718090409,
					"content": "這樣也沒錯，吃當然是頭等要務，特別…是在這座璃月港裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090410
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718090410,
					"content": "這倒也有些趣味，我先記下，說不定也能入詩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090411
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718090411,
					"content": "有人覺得變化太快。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090412
					]
				},
				{
					"id": 718090412,
					"content": "嗯…有人這麼覺得倒也正常，如今的璃月港裡的變化可以稱得上是日新月異，有些東西就連我都有點接受不了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090413
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718090413,
					"content": "但這題目有些太大，只怕一首詩容納不下…我還是先記下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090414
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718090414,
					"content": "#這樣就可以了，拜託{F#妳}{M#你}幫忙果然不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090415
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718090415,
					"content": "如此一來，我的下一部詩集中說不定又可以多加幾首新作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090416
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718090416,
					"content": "啊對了，除了一些財帛俗物外…還有一份小小心意，還請收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090417
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 718090417,
					"content": "等我的下一本詩集出版，便可憑此簽名換得一冊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				}
			]
		},
