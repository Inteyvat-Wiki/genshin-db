			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"浩仔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090201,
					"content": "還好，還好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090202
					],
					"speakerTitle": "浩仔"
				},
				{
					"id": 718090202,
					"content": "什麼還好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090203
					]
				},
				{
					"id": 718090203,
					"content": "哦，是旅行者啊。之前城裡不是出了那麼大的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090204
					],
					"speakerTitle": "浩仔"
				},
				{
					"id": 718090204,
					"content": "還好，那件事之後也沒出什麼大亂子。最主要的是…城裡的飯館也都開得好好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090205
					],
					"speakerTitle": "浩仔"
				},
				{
					"id": 718090205,
					"content": "要不然，那麼多好菜我都吃不到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090206
					],
					"speakerTitle": "浩仔"
				},
				{
					"id": 718090206,
					"content": "原來是因為吃的啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090207
					]
				},
				{
					"id": 718090207,
					"content": "#{F#妳}{M#你}可別小看了吃啊。要判斷一個地方的好壞，最直接的方法，就是看這地方吃的東西怎麼樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090208
					],
					"speakerTitle": "浩仔"
				},
				{
					"id": 718090208,
					"content": "啊…說著說著肚子又餓了，我得再去吃點什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "浩仔"
				}
			]
		},
		{
			"id": 7180903,
			"completionStepIds": [
				7180906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180906",
							"2"
						],
						"stepId": 7180906,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"范二爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718090301,
					"content": "現在這戲啊，我真是越聽越不明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090302
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 718090302,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090303
					]
				},
				{
					"id": 718090303,
					"content": "是旅行者啊，這「和裕茶館」又有幾齣新戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090304
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 718090304,
					"content": "不過這些新戲啊…熱鬧到是熱鬧，但我都有些聽不懂了，年輕人倒是都很喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090305
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 718090305,
					"content": "您覺得這樣好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718090306
					]
				},
				{
					"id": 718090306,
					"content": "這個嘛…就我來說，當然是樂意聽那些老戲了，這麼多年也聽習慣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090307
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 718090307,
					"content": "但是，現在整座璃月港都在變，變幾場新戲出來倒也應景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718090308
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 718090308,
					"content": "唉，但這變化也太快了，老戲也好久沒開，也不知道岩王爺他…算了，不說了，不說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "范二爺"
				}
			]
		},
		{
			"id": 7180904,
			"completionStepIds": [
				7180909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
