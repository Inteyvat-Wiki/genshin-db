				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150401,
					"content": "不對、不對…要是剔除了光影，那畫面的層次怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150402
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150402,
					"content": "顏料的筆觸表現力不夠…畫面的色彩也沒有區分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150403
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150403,
					"content": "天呀，只不過剔除了幾個要素…整個畫面都變得一團糟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150404,
						240150405
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150404,
					"content": "你在這裡做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				},
				{
					"id": 240150406,
					"content": "是您啊，見到您真好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150407
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150407,
					"content": "抱歉讓您誤會了，我剛剛只是在思考畫面的問題，不由自主地到處閒逛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150408
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150408,
					"content": "您可能無法理解，但我在思考問題的時候，絕不能坐著不動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150409
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150409,
					"content": "如果我一直待在一個地方思考問題，那我會變得越來越煩躁…所以我習慣一邊散步一邊思考問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150410
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150410,
					"content": "在用頭腦思考的同時，讓我的雙腿自由行動，隨它們帶我去哪，只要不要讓我待在原地就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150411
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150411,
					"content": "所以…我經常會這樣，讓您擔心了，非常抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150412,
						240150413
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150412,
					"content": "那你思考出結果了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150414,
					"content": "毫無進展，就是…沒有一點頭緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150415
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150415,
					"content": "剔除了光影，畫面就變得毫無層次；減弱形體的塑型，物體就支撐不起畫面的結構。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150416
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150416,
					"content": "只是剔除了幾個要素，整個畫面就開始坍塌，最後變成一團糟糕的垃圾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150417
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150417,
					"content": "這都是我的自言自語，您不要在意，我要繼續想想怎麼解決這個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150418
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150418,
					"content": "我必須先回去找找我的畫架…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150413,
					"content": "那你思考的問題怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150414
					]
				},
				{
					"id": 240150405,
					"content": "我們還以為你遇見危險了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150406
					]
				}
			]
		},
		{
			"id": 2401506,
			"completionStepIds": [
				2401506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2401506",
							"2"
						],
						"stepId": 2401506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"德皮耶里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240150601,
					"content": "呼…呼…謝謝您，太謝謝您了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150602
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150602,
					"content": "真是莫名其妙，我只是好好地在這裡畫畫，突然就被這群傢伙圍住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150603
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150603,
					"content": "它們就像是要吃了我這幅畫一樣，不停地攻擊畫架。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150604
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150604,
					"content": "我當然不能讓它們破壞我的畫，於是就抱著畫拔腿就跑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150605
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150605,
					"content": "但我…我沒跑多遠，就被它們追上了。還好有您來救我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150606,
						240150607
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150606,
					"content": "這畫有問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				},
				{
					"id": 240150608,
					"content": "我、我不知道啊！我一直在用騙騙花蜜做顏料，您上次不是還幫我找了一些嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150609
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150609,
					"content": "等等，難道…這些傢伙是被含有騙騙花蜜的顏料吸引了？但這花蜜被我攪拌進顏料裡之後，根本沒什麼味道啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150610
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150610,
					"content": "這顏料的配方我也不敢隨便更改，只能想想其他辦法了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240150611
					],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150611,
					"content": "咳，我還以為連騙騙花都感受到了這幅畫裡蘊含的美感，想要過來欣賞一番的說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德皮耶里"
				},
				{
					"id": 240150607,
					"content": "你做了什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240150608
					]
				}
			]
		}
	]
}