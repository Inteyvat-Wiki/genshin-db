			"dialogs": [
				{
					"id": 715370101,
					"content": "#榮譽騎士前輩，居然能在這裡遇見{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370102
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 715370102,
					"content": "妳在做「祝柬」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715370103
					]
				},
				{
					"id": 715370103,
					"content": "嗯，好不容易趁著休假來了璃月港。我正在採購禮物，準備帶回去送給騎士團的各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370104
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 715370104,
					"content": "然後我聽說在海燈節期間，璃月人送禮物時一般會寫一封「祝柬」附在裡面…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370105
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 715370105,
					"content": "所以我就想要效仿一下，也做幾封漂亮的「祝柬」。但怎麼做似乎都不太好看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370106
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 715370106,
					"content": "#榮譽騎士前輩，{F#妳}{M#你}知道怎樣做的「祝柬」最好看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715370107
					],
					"speakerTitle": "諾艾爾"
				},
				{
					"id": 715370107,
					"content": "放心，包在我身上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
