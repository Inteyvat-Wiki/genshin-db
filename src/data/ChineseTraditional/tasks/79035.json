			},
			"dialogs": [
				{
					"id": 790350101,
					"content": "#{NICKNAME}，派蒙，{F#妳}{M#你}們見過兩隻妖狸嗎？一隻背著紫色包袱，一隻背著黃色包袱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 790350102,
					"content": "啊！一定是豆助和柴助！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790350103,
					"content": "#看來{F#妳}{M#你}們的確知道牠們，太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 790350104,
					"content": "欸？難道牠們出什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790350105,
					"content": "那倒不是。只是牠們手舞足蹈地比劃了一陣以後交給我這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350106
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 790350106,
					"content": "#聽說之前{F#妳}{M#你}們和稻妻的妖狸去過獵鹿人，我猜這兩隻妖狸或許也是{F#妳}{M#你}們的朋友，牠們大概是想讓我轉交給{F#妳}{M#你}們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 790350107,
					"content": "哇！是豆助和柴助的禮物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790350108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790350108,
					"content": "嘿嘿，看來牠們的旅途有一個順利的開始呢，不知道以後還有沒有機會見到牠們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
