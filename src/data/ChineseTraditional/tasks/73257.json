					"nextDialogs": [
						732570213
					]
				},
				{
					"id": 732570213,
					"content": "既然這樣，不如先跟我說說到底發生了什麼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "祖爾宛"
				},
				{
