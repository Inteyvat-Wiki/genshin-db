						732571705
					],
					"speakerTitle": "米希爾"
				},
				{
					"id": 732571705,
					"content": "斯露莎快點用那個想想吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732571706
					],
					"speakerTitle": "米希爾"
