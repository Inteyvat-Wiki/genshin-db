	"talks": [
		{
			"id": 7325701,
			"completionStepIds": [
				7325701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325701",
							"2"
						],
						"stepId": 7325701,
						"stateName": "QUEST_STATE_UNFINISHED"
