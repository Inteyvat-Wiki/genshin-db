			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732570101,
					"content": "說來，從遺蹟工廠出來之後，斯露莎好像一直都沒說過話的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570102,
					"content": "明明之前一路上都沒停下來過，現在這麼安靜，都有點不習慣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570103,
						732570104,
						732570105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570103,
					"content": "該不會是嚇傻了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570106,
					"content": "打起精神來呀，斯露莎，我們還有很多事情要做呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570107,
					"content": "比如完成那個…就是那個什麼很難記的儀式，然後趕緊解決掉那個大窟窿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570108,
					"content": "等所有事情都完成之後，我們去吃好吃的吧，畢竟大家都辛苦了一番呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570109,
					"content": "比如說…唔，不過我也不知道花靈會喜歡吃什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570111
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570111,
					"content": "…花靈是不用吃東西的啦，笨飄飄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570112
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570112,
					"content": "哎，沒想到我竟然有一天會淪落到被白飄飄安慰，這也實在是太丟人了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570113
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570113,
					"content": "簡直恨不得現在就被封印到「灰餘晶」裡面，要不然就找個可以一覺不醒的山洞躲起來，直到認識我的傢伙都消失好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570114
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570114,
					"content": "說了不要叫我白飄飄，不過真的有這種山洞嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570115,
						732570117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570115,
					"content": "逃避不是解決問題的辦法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570116
					]
				},
				{
					"id": 732570116,
					"content": "我已經什麼都不想管啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570119,
					"content": "一想到被那先朱那那個傢伙耍得團團轉的滑稽模樣，我就羞恥到受不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570120
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570120,
					"content": "#反正「靈光絕唱」都已經到手了，{F#妳}{M#你}們要想解決那個什麼天象的話，就去花海那邊找米希爾或者拉沙魯好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570121
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570121,
					"content": "#總之不管怎麼樣還是拜託{F#妳}{M#你}們放過我吧，{F#妳}{M#你}們之前聽到的那些話就當我從來沒說過好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570122
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570122,
					"content": "唔，雖然妳是說過很多奇怪的話啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570123,
						732570124,
						732570125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570123,
					"content": "「我的謁頌主」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570126,
					"content": "#嗚啊，求求{F#妳}{M#你}不要再說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570127
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570127,
					"content": "#{NICKNAME}，這個時候就別鬧斯露莎了啦。畢竟我們一起冒險了這麼久，要是半途而廢了可不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570128,
					"content": "而且，斯露莎也有很厲害的地方吧，比如…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570129,
					"content": "妳剛才猶豫了對吧！嗚嗚嗚…別再哄我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570130,
						732570131
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570130,
					"content": "比如行動力很強。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570132,
					"content": "嗯嗯，沒錯，而且我們不是一直都在為了解決那個天象而努力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570133,
					"content": "能走到這裡也都是多虧了斯露莎呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570134,
					"content": "不是有句話是這麼說的嗎，「只要不停下腳步繼續前進，成為一名卓越的冒險家也只是時間問題。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570135,
					"content": "#真的嗎？{F#妳}{M#你}們是在真心誠意地誇我的對吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570136
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570136,
					"content": "這是朋友的誇讚。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570137
					]
				},
				{
					"id": 732570137,
					"content": "嘿嘿，哎呀，該說果然不愧是我嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570138
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570138,
					"content": "突然就有動力起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570139
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570139,
					"content": "既然斯露莎也有幹勁了，那麼我們就趕緊去找祖爾宛吧，快點解決掉那個大窟窿拿到報酬，我都迫不及待要大吃一頓了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570131,
					"content": "比如很有責任感。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570132
					]
				},
				{
					"id": 732570124,
					"content": "「英武的身姿」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570125,
					"content": "「命定的犧牲」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570126
					]
				},
				{
					"id": 732570117,
					"content": "妳還有必須要做的事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570118
					]
				},
				{
					"id": 732570118,
					"content": "雖然好像是有這麼回事啦，不過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570119
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570104,
					"content": "畢竟經歷了這種事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				},
				{
					"id": 732570105,
					"content": "也許她只是累了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570106
					]
				}
			]
		},
		{
			"id": 7325702,
			"completionStepIds": [
				7325702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7325702",
							"2"
						],
						"stepId": 7325702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"祖爾宛"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							390.447,
							312.914,
							5703.516
						],
						"pointId": 4535
					}
				]
			},
			"dialogs": [
				{
					"id": 732570201,
					"content": "祖爾宛，我們回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570202,
					"content": "#啊呀，是{NICKNAME}、斯露莎還有派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570203
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570203,
					"content": "#看{F#妳}{M#你}們的樣子，應該是已經成功拿到所有的「靈光絕唱」了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570204,
						732570205
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570204,
					"content": "雖然經過了一些曲折。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570206
					]
				},
				{
					"id": 732570206,
					"content": "#不管怎麼樣，最終的結果是好的，拜託{F#妳}{M#你}們果然沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570207
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570207,
					"content": "#若不是有{F#妳}{M#你}們在，恐怕「靈光絕唱」早就被那些心懷叵測的傢伙奪走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570208
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570208,
					"content": "欸，祖爾宛的話，怎麼聽起來像是早就知道了什麼的樣子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570209,
					"content": "#欸嘿，還真的被我說中了啊，{F#妳}{M#你}們該不會真的遇到了那些侍奉黑淵的傢伙吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570210,
						732570212
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570210,
					"content": "妳怎麼知道的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570211
					]
				},
				{
					"id": 732570211,
					"content": "這個嘛…與其深究於此，不如先跟我說說到底發生了什麼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570214
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570214,
					"content": "跟祖爾宛講述了在地下遺蹟中的冒險，以及那先朱那背叛的事情。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						732570215
					]
				},
				{
					"id": 732570215,
					"content": "呵呵，沒想到竟然連矯論團的「識主」都投向了黑淵，雖說原本就沒對他們抱有什麼期待，但這樣聽起來也有點駭人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570216
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570216,
					"content": "#而且如果我猜的沒錯的話，他之所以會盯上「靈光絕唱」，也是受與{F#妳}{M#你}們戰鬥的黑淵之人的蠱惑，畢竟此人也算是我的舊識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570217
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570217,
					"content": "欸？祖爾宛竟然還認識深淵教團的傢伙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570218,
					"content": "哼，那傢伙原本也曾是矯論團的一員。數百年前，曾有自森林而來的調查團為了探尋荼訶人的秘密而造訪此地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570219
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570219,
					"content": "他們不顧矯論團的勸阻，執意要進入荼訶人留下的遺蹟。為了防止意外發生，當時的識主便命他一同前去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570220
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570220,
					"content": "然而不知是在遺蹟中遭遇了什麼，當我們再次見到他時，他已經接受了汙穢的「賜福」，而調查團的人也不知所蹤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570221
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570221,
					"content": "黑淵的信徒隨之聚集而來，他們盯上了「靈光絕唱」，為此還喚來了眾多的迪弗魔獸進攻花海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570222
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570222,
					"content": "雖然依靠眾多的花靈與人類勇士，花海最終得以保全。但我們卻沒能徹底消滅那些黑淵的信徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570223
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570223,
					"content": "為了不讓他們趁虛而入，我用「靈光絕唱」的力量封禁了花海與各處遺蹟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570224
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570224,
					"content": "而矯論團也因為這次背叛而元氣大傷，傳承的典籍焚失一空。在那之後便慢慢變成了現在這個樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570225
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570225,
					"content": "#之前聽{F#妳}{M#你}們說，我便懷疑背後有他們的影子，但沒想到這次就連矯論團的首領也成了被他們利用的工具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570226
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570226,
					"content": "不過那先朱那說的話還是有點令人在意，關於矯論團先輩的事情，祖爾宛應該知道點什麼吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570227,
					"content": "畢竟祖爾宛曾與他們並肩作戰。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570228
					]
				},
				{
					"id": 732570228,
					"content": "呵呵，歷史化為傳說，傳說變為故事，所謂傳承究其本質也不過是這樣，遺忘原本也是故事的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570229
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570229,
					"content": "越是執著於傳承的人，便越會去選擇記住那些自己想要的故事，最終迷失在故事的迷宮當中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570230
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570230,
					"content": "在這不斷遺忘的世界中，比起輕飄飄的頌歌，我們在大地上所鐫刻下的痕跡，才是更加可靠的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570231
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570231,
					"content": "#因此我才會相信{F#妳}{M#你}們，畢竟{F#妳}{M#你}們看起來就像是不會在意什麼評價的直率之人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570232
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570232,
					"content": "雖然好像是在誇我們，不過不知道為什麼聽起來感覺怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570233,
					"content": "感覺陰陽怪氣的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570234
					]
				},
				{
					"id": 732570234,
					"content": "前輩根本就是在暗示我吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570235
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570235,
					"content": "#至於五百年前的事情，{F#妳}{M#你}們與其再從我這裡聽到另一個故事，還不如親自去見證吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570236
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570236,
					"content": "恰好現在也有這樣的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570237
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570237,
					"content": "不過斯露莎，妳看起來也可靠了很多嘛，經歷了這些也差不多該從那些人類的囈語中清醒過來了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570238
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570238,
					"content": "前輩！過去的事情就別再提了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570239
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570239,
					"content": "#看來拜託{NICKNAME}和派蒙果然有用。這樣的話，我也能放心地把完成「祭水之儀」的工作交給{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570240
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570240,
					"content": "「祭水之儀」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732570241
					]
				},
				{
					"id": 732570241,
					"content": "好像之前也聽祖爾宛說過吧！我記得是清除什麼汙穢之類的來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570242,
					"content": "「祭水之儀」是為「萬種母樹」祓除汙穢的儀式，一般情況下只要在鎮壓黑淵的巨木下舉行就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570243
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570243,
					"content": "但現在黑淵的封印鬆動，天空中的異象也再次出現，已經不是光靠普通的儀式就能解決的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570244
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570244,
					"content": "本來這個異象之所以會出現在母樹之上，便是由於母樹吸收了大量汙穢的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570245
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570245,
					"content": "「萬種母樹」中累積了太多的汙穢，又受到異象的侵蝕，已經無法維持靈光的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570246
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570246,
					"content": "現在唯一的辦法就是進入到「萬種母樹」當中，清除掉其中的汙穢，喚醒神明大人的神識了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570247
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570247,
					"content": "原來可以進到樹的裡面嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570248
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732570248,
					"content": "#難道{F#妳}{M#你}們以為「離渡之儀」是要進到那個黑淵裡面嗎？就算是花靈也沒辦法承受那樣的汙穢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570249
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570249,
					"content": "寄宿著神識的巨蓮「伽烏迦那」就在萬種母樹當中，只要祓除了汙穢，便會重新開出聖潔之花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570250
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570250,
					"content": "#然後甘露便會潔淨整個大地。雖然有些複雜，不過既然是{F#妳}{M#你}們的話，應該能夠輕鬆解決吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570251
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570251,
					"content": "那麼，我已讓拉沙魯和米希爾提前去到「荼泥黑淵」那邊了，只要把「靈光絕唱」帶過去，便能聚集起靈光的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570252
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570252,
					"content": "靈光將會喚醒鎮壓黑淵的巨木，潔淨淵底的汙泥。然後就可以舉行「離渡之儀」，打開進入「萬種母樹」的道路了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570253
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570253,
					"content": "至於古時那些英雄們的偉業，只要進到母樹當中，花冠便會向斯露莎顯現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570254
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570254,
					"content": "畢竟所有與靈光相關的記憶，最後都回歸了「萬種母樹」。無論世間流傳的民話如何變遷，這些記憶也不會隨之褪色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570255
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570255,
					"content": "這種事情我還是第一次聽說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570256
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 732570256,
					"content": "呵呵，花冠原本便是母樹的一部分，等到時候妳就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732570257
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 732570257,
					"content": "那麼，請去熄滅那個「焚真之天象」吧。等到天空降下甘露之時，我們還會見面的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖爾宛"
				},
				{
