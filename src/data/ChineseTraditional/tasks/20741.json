			"dialogs": [
				{
					"id": 207412001,
					"content": "您把蒲公英播撒出去了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412002,
						207412003
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 207412002,
					"content": "已經播撒出去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207412005
					]
				},
				{
					"id": 207412005,
					"content": "無論如何，希望巴巴托斯大人能夠聽到我的聲音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412006
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 207412006,
					"content": "謝謝您願意幫忙，這是謝禮，請收下吧。願風神護佑您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 207412003,
					"content": "應該會隨風飄很遠的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207412004
					]
				},
				{
					"id": 207412004,
					"content": "那樣就太好了，巴巴托斯大人也會更容易注意到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207412005
