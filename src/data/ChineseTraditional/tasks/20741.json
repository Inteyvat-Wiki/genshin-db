			"dialogs": [
				{
					"id": 207411001,
					"content": "您搜集到蒲公英了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411002
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 207411002,
					"content": "搜集到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						207411003
					]
				},
				{
					"id": 207411003,
					"content": "這些就足夠了，請您在這裡稍等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411004
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 207411004,
					"content": "…巴巴托斯大人，請您聆聽我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411005
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 207411005,
					"content": "嗚哇…她好虔誠啊，說了好多話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 207411006,
					"content": "…也不知道那個「賣唱的」能不能聽到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411007
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 207411007,
					"content": "好了，這些蒲公英籽交給您，請您幫我上去播撒一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411008
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 207411008,
					"content": "其實是應該我自己去的，但是…以我的身手，就算能爬上去，應該也很難下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						207411009
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 207411009,
					"content": "所以，就拜託您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞絲"
				}
			]
		},
