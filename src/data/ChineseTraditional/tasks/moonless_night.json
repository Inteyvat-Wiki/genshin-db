			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": [
					{
						"sceneId": 20322,
						"position": [
							335.674,
							288.735,
							245.957
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 60030901,
					"content": "歡迎歡迎，我已恭候多時了。希望各位能喜歡我這間小研究所。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030902
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030902,
					"content": "喜歡？一路上都是怪物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030903
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030903,
					"content": "你竟敢以如此悠閒的姿態等候在此！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030904
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60030904,
					"content": "當然。我有什麼可著急的？一切都那麼順利，你們也如期到來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030905
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030905,
					"content": "先是桑多涅和阿蕾奇諾，然後是你們，今天客人還真多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030906
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030906,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030907
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030907,
					"content": "假如是在找那兩位女士，那我得告訴妳，阿蕾奇諾進入研究所後立刻消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030908
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030908,
					"content": "而桑多涅剛剛就站在這裡，大聲質問我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030909
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030909,
					"content": "她總是這樣，沒什麼禮貌。不過至少有一點令我意外，我實在沒想到連桑多涅都在意起他人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030910
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030910,
					"content": "和你們走得近的人難道都會變成這樣嗎？可是那對研究人員來說不是好事，不夠客觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030911
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030911,
					"content": "桑多涅在哪裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030912
					]
				},
				{
					"id": 60030912,
					"content": "關於這一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030913
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030913,
					"content": "你的夢做得還真遠，多托雷。難道你認為有了月髓就能在這世界稱神？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030914
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030914,
					"content": "稱神這個說法我不喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030915
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030915,
					"content": "不是自稱，而是事實如此。身為研究員的妳，不會不能理解二者之間的差距吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030916
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030916,
					"content": "哼！就憑你嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030917
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030917,
					"content": "噢，淑女偶爾也有出言不遜的時刻，請別介意。畢竟同事一場，你什麼作風我們都清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030918
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030918,
					"content": "同事一場，我也猜到妳會這麼說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030919
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030919,
					"content": "妳我都明白事實勝於雄辯，所以，我派人為妳送了點小禮物，幫助妳直觀理解我如今的位格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030920
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030920,
					"content": "禮物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030921
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030921,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030922
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030922,
					"content": "你手下那些人，都去哪了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030923
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030923,
					"content": "誰知道呢？也許他們已追隨著未知之神的腳步去往新世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030924
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030924,
					"content": "雖然妳缺乏教養又眼高於頂，但親愛的桑多涅，我並不會因此遷怒妳的下屬。他們也享有同等權利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030925
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030925,
					"content": "你膽敢派人去月矩力試驗設計局？那可是女皇陛下的試驗場所！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030926
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030926,
					"content": "是啊，陛下的吩咐我們自當謹記在心。但妳也知道，那跟我現在的目標並不衝突。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030927
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030927,
					"content": "既然如此，我只是做些想做的實驗，有問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030928
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030928,
					"content": "妳可以賭一把是我在撒謊，其實只想調虎離山，還是我的話句句屬實，妳的下屬正身處危險之中？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030929
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030929,
					"content": "連愚人眾自己的士兵都要下手，你喪心病狂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030930
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030930,
					"content": "如今我為自己定了一條新的規矩，要給每個人一次機會，我自然也會這樣對妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030931
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030931,
					"content": "妳若想離開，我不會阻攔。畢竟，我們大家都是好同事嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030932
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030932,
					"content": "該死的東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030933
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030933,
					"content": "不過我的確沒想到，連桑多涅都關心起這世界的人來了。真可惜啊，還以為自我中心是她身上僅存的優點呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030934
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030934,
					"content": "連一個試驗設計局都要保護，這種心性又能幹成什麼大事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030935
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030935,
					"content": "挾持人質可不是什麼上得了檯面的做法。還是說對如今的您而言，臉面已經不再重要？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030936
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030936,
					"content": "臉面？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030937
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030937,
					"content": "我手裡有兩枚月髓，缺失的那一枚也即將製造完成。對即將成為新世界神明的我談論臉面？未免風趣過頭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030938
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030938,
					"content": "你根本就不配握有那等聖物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030939
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60030939,
					"content": "而依我看，世上還有許多人不配活著呢，我不也仁慈地允許他們存在了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030940
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60030940,
					"content": "你會為你的所作所為後悔的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030941
					]
				},
				{
					"id": 60030941,
					"content": "那就得看你們有沒有讓人後悔的本事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「博士」"
				}
			]
		},
