			"dialogs": [
				{
					"id": 60030101,
					"content": "看起來人都到齊了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60030102,
					"content": "#是的，我們都已經準備好了。{NICKNAME}、派蒙，{F#妳}{M#你}們呢？狀態如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030103
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 60030103,
					"content": "我準備好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030104,
						60030106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60030104,
					"content": "我也準備好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030105
					]
				},
				{
					"id": 60030105,
					"content": "那太好了，馬上進入正題吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030113
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 60030113,
					"content": "那麼，首先…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030114
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 60030114,
					"content": "等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030115
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 60030115,
					"content": "有聲音。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030116
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030116,
					"content": "我們聽見你的腳步聲了，不過嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030117
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030117,
					"content": "#您來這裡有一會了，也許是跟著{NICKNAME}過來的？但您的氣息，似乎不帶有惡意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030118
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030118,
					"content": "進來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030119
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030119,
					"content": "各位果然如我所想，反應快得很。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030120
					],
					"speakerTitle": "格迪米納什",
					"speakerSubtitle": "「僕人」下屬"
				},
				{
					"id": 60030120,
					"content": "我奉「僕人」大人命令，前來傳達她的口信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030121
					],
					"speakerTitle": "格迪米納什",
					"speakerSubtitle": "「僕人」下屬"
				},
				{
					"id": 60030121,
					"content": "多托雷佯裝返回至冬，那顯然是藉口。但他並沒回到月矩力試驗設計局，也並未出現在那夏鎮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030122
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 60030122,
					"content": "所以他只可能在最北面的那個實驗室。哈，我說為什麼他要申請自己的場地…原來是早有計畫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030123
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 60030123,
					"content": "告訴他們，我和桑多涅先行一步。假如他們也關心此事的後續，那我們就在挪德卡萊最北方的研究所見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030124
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 60030124,
					"content": "那兩位都是哥倫比婭小姐的至交，但她們行動前仍不忘與我們分享資訊…誠摯感謝愚人眾的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030125
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 60030125,
					"content": "雖說「少女」大人已經脫離組織…但大人們對她的關心絕非虛假。何況，目前看來「博士」大人的行為充滿謎團，我們必須關注。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030126
					],
					"speakerTitle": "格迪米納什",
					"speakerSubtitle": "「僕人」下屬"
				},
				{
					"id": 60030126,
					"content": "我們常與人為敵，可那僅僅基於立場。人情與道義，我們向來都明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030127
					],
					"speakerTitle": "格迪米納什",
					"speakerSubtitle": "「僕人」下屬"
				},
				{
					"id": 60030127,
					"content": "各位是「少女」大人的朋友，有權知情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030128
					],
					"speakerTitle": "格迪米納什",
					"speakerSubtitle": "「僕人」下屬"
				},
				{
					"id": 60030128,
					"content": "到底是最懂得審時度勢的阿蕾奇諾，替我們省去了許多功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030129
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030129,
					"content": "地圖我放在這裡了。如果你們決定前往最北部的研究所，請務必注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030130
					],
					"speakerTitle": "格迪米納什",
					"speakerSubtitle": "「僕人」下屬"
				},
				{
					"id": 60030130,
					"content": "務必記得，至少在挪德卡萊，「僕人」大人的下屬可以是你們的同伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030131
					],
					"speakerTitle": "格迪米納什",
					"speakerSubtitle": "「僕人」下屬"
				},
				{
					"id": 60030131,
					"content": "感謝您的周到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030132
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030132,
					"content": "分內之事罷了。那我就先告辭了，如有需要，可以到月矩力試驗設計局找我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030133
					],
					"speakerTitle": "格迪米納什",
					"speakerSubtitle": "「僕人」下屬"
				},
				{
					"id": 60030133,
					"content": "「博士」離開了月矩力試驗設計局，去了最北方的研究所…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60030134,
					"content": "「木偶」說「博士」早有準備，難道他在來挪德卡萊之前就有這個計畫了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030135
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 60030135,
					"content": "為女皇辦事多半只是他的謊言。又或者，更簡單一些——陽奉陰違。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030136
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60030136,
					"content": "「博士」行事果斷，作風狠辣歹毒，很不好對付。我們得做好準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030137
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030137,
					"content": "現階段，「博士」的行動難以預測。我建議兵分兩路，留一些人守住那夏鎮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030138
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030138,
					"content": "唔…雖然很想幫忙啦，但我的確不是潛入研究所的最佳人選…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030152
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 60030152,
					"content": "但至少把「冷靜一下鴨」帶上吧！它應該能在戰鬥中幫到你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030139
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 60030139,
					"content": "伊涅芙小姐是否和往常一樣，決定留下保護愛諾小姐呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030140
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030140,
					"content": "偵測到行動邏輯：保護愛諾，優先級：高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030141
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 60030141,
					"content": "以防萬一，法爾伽先生也留下比較好，研究所那邊交給我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030142
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60030142,
					"content": "身為北風騎士，我不應在這種時候留守，但…好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030143
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 60030143,
					"content": "那夏鎮交給我。幾位也請務必注意安全，如果情況不可控，一定要及時撤退。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030144
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 60030144,
					"content": "雅珂達也會幫各位的。我不在的時候，情報工作就交給她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030145
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030145,
					"content": "明白了老闆，你們要安全回來哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030146
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 60030146,
					"content": "我們會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030147
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60030147,
					"content": "夜長夢多，早點出發比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030148,
						60030149
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030148,
					"content": "這次情況可能很凶險…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030150,
					"content": "潛入任務，還是研究所的話…好吧，既然你們打算狠狠打一場惡戰，那我就幫其他人忙好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60030151,
					"content": "#我們都得盡全力了。在那之前，{F#妳}{M#你}有沒有沒做完的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030401,
						60030601
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030401,
					"content": "還有一些事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030402
					]
				},
				{
					"id": 60030402,
					"content": "#那等{F#妳}{M#你}準備完畢，我們再一起出發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030601,
					"content": "我隨時可以行動！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030602
					]
				},
				{
					"id": 60030602,
					"content": "那我們現在就行動吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 60030603,
					"content": "好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030149,
					"content": "派蒙留下幫大家吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030150
					]
				},
				{
					"id": 60030106,
					"content": "好，再確認一下議題如何？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030107
					]
				},
				{
					"id": 60030107,
					"content": "#哈哈，是不是有點緊張？那也不怪{F#妳}{M#你}，我們大家都是第一次碰到這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030108
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 60030108,
					"content": "#哥倫比婭小姐不久前剛遭到「博士」襲擊…而在那短暫的瞬間，{F#妳}{M#你}看到她消失在了那個「月亮倒影」內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030109
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 60030109,
					"content": "#嗯。事件發生時，我們所有人都只看到「博士」出現並使用了某種力量。隨後哥倫比婭就消失了，{F#妳}{M#你}也從空中墜入大海。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030110
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60030110,
					"content": "必須救回哥倫比婭小姐。此外，愚人眾執行官「博士」奪取三月的權柄一定有其目的，我們必須阻止他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030111
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 60030111,
					"content": "尋回「月神」原本是我們霜月之子的職責，沒想到大家都願意幫忙…我謹代表霜月之子，向諸位送上謝意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030112
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60030112,
					"content": "（刪除）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030113
					]
				}
			]
		},
