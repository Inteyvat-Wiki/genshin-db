			},
			"dialogs": [
				{
					"id": 60031101,
					"content": "在未完成的人工月髓加持下，多托雷的力量已經達到我們無法匹敵的地步…不要戀戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031102
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 60031102,
					"content": "抓緊時機！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031103
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 60031103,
					"content": "走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031104
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60031104,
					"content": "逃跑比投降明智，我向來這樣認為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031105
					],
					"speakerTitle": "「博士」"
				},
				{
					"id": 60031105,
					"content": "這是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60031106
					]
				},
				{
					"id": 60031106,
					"content": "小心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031107
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 60031107,
					"content": "別管我，你們——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60031108
					]
				},
				{
					"id": 60031108,
					"content": "#{NICKNAME}人呢？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031109
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60031109,
					"content": "嘖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60031110
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 60031110,
					"content": "突破不了的話，只能先撤退。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				}
			]
