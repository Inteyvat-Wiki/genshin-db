			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"捷塔納什"
				],
				"points": [
					{
						"sceneId": 20322,
						"position": [
							309.422,
							310.76,
							540.634
						],
						"pointId": 3
					}
				]
			},
			"dialogs": [
				{
					"id": 60030501,
					"content": "你們…你們竟然敢到這裡來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030502
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030502,
					"content": "據我們所知，「博士」現在可能在這間研究所裡，而你正在向外逃離。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030503
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60030503,
					"content": "哼，如果是來找「博士」大人的麻煩…我不敢說你們還有多少機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030504
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030504,
					"content": "您還能活多久，很可能取決於您發言的價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030505
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030505,
					"content": "已經有兩個執行官在這裡了——可是那又怎麼樣？「博士」大人敢做這些，就絕不會毫無準備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030506
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030506,
					"content": "是嗎？依我看你好像並不樂意做他的部下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030507
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030507,
					"content": "而且，這附近有怪物的痕跡和氣息，你難道喜歡與這些東西在一起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030508
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030508,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030509
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030509,
					"content": "我們需要知道「博士」究竟在謀劃什麼，如果你知道任何資訊，請務必告訴我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030510
					]
				},
				{
					"id": 60030510,
					"content": "並不是只為我們的利益，他的行為很可能關乎整個挪德卡萊，甚至還有你們自己的至冬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030511
					]
				},
				{
					"id": 60030511,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030512
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030512,
					"content": "大人他…正在製造某件不得了的東西。我認為，大人的計畫並非一朝一夕，而是進行很久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030513
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030513,
					"content": "不久前，「博士」大人說要回至冬一趟，可是沒想到那麼快就回來了，還帶著兩顆像發光寶石一樣的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030514
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030514,
					"content": "是月髓…「博士」從哥倫比婭那裡，奪走了本屬於她的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030515
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60030515,
					"content": "妳說「少女」大人嗎？她早就脫離我們了，臨走前她說女皇陛下的囑託她已辦到，現在要去完成自己的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030516
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030516,
					"content": "我一直認為，脫離組織未必就是好事。我最敬仰的「隊長」大人就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030517
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030517,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030518
					]
				},
				{
					"id": 60030518,
					"content": "為了完成計畫，上頭派遣了三支部隊，分別隸屬於「博士」、「木偶」和「少女」三位執行官。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030519
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030519,
					"content": "當時，我是跟著「少女」大人的隊伍過來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030520
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030520,
					"content": "她很少跟我們交流。她…並不關心周圍，但並非心不在焉，而是給我一種感覺，這世界變成怎樣她都不在意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030521
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030521,
					"content": "那種感覺就像是，她沒能找到為之而活的事物，才不得不遙望很遠的地方…是的，她總是仰頭看天空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030522
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030522,
					"content": "「博士」大人常站在不遠處看著。據說他和「少女」大人一度關係不錯，後來「少女」大人卻忌憚他，不怎麼與他接觸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030523
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030523,
					"content": "「少女」大人離開後，我被合併到「博士」大人手下。他…也同樣不關心周圍，唯獨對月亮充滿期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030524
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030524,
					"content": "對現在的「博士」大人而言，三月是他最想得到的東西。他還說，少一個月亮的話，自己造就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030525
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030525,
					"content": "人造月髓？難道是靠那些「亥珀波瑞亞」的虛影提供的知識？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030526
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030526,
					"content": "很詳細，感謝您的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030527
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 60030527,
					"content": "我能感覺到，您其實更願意做哥倫比婭的部下，是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030528
					],
					"speakerTitle": "菈烏瑪"
				},
				{
					"id": 60030528,
					"content": "…不，她已經不是執行官了。何況我們愚人眾最應效忠的，永遠只有女皇陛下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030529
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030529,
					"content": "說這些是因為我無法完全相信「博士」大人。他的行為，並不符合我們來到挪德卡萊的初衷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030530
					],
					"speakerTitle": "捷塔納什",
					"speakerSubtitle": "「博士」下屬"
				},
				{
					"id": 60030530,
					"content": "我明白了，我們會盡力阻止他。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030531
					]
				},
				{
					"id": 60030531,
					"content": "「僕人」的部下在月矩力試驗設計局，你可以去那裡與他們會合。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						60030532
					]
				},
				{
					"id": 60030532,
					"content": "都聽到了吧。人造月髓，而且快完工了…多托雷的技術竟然到了這個地步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						60030533
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 60030533,
