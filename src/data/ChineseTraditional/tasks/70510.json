			"dialogs": [
				{
					"id": 705100401,
					"content": "哎呀呀…這幾天，酒館裡的人可以說是絡繹不絕啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100402
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705100402,
					"content": "#有衝著酒來的，更多是衝著{F#妳}{M#你}來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100403
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705100403,
					"content": "這話…聽起來怎麼那麼奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705100404,
					"content": "我還沒見過那麼成功的「酒保體驗週」活動，這下生意和口碑都有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100405
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705100405,
					"content": "總之…幹得漂亮，夥計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100406
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705100406,
					"content": "才幾天，怎麼就變成夥計了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100407,
						705100408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705100407,
					"content": "某種意義上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				},
				{
					"id": 705100409,
					"content": "我說，要不要留下來接著幹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100410
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705100410,
					"content": "#這可不行。雖然無限暢飲的誘惑力很大，但我可是答應過，要陪{M#他}{F#她}一直旅行下去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705100411,
					"content": "好吧，那就不勉強啦，畢竟查爾斯也跟我說過這一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100412
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705100412,
					"content": "總之，有機會的話，常來「天使的饋贈」坐坐，帶朋友一起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705100413
					],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705100413,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100414
					]
				},
				{
					"id": 705100414,
					"content": "#再見啦，祝{F#妳}{M#你}們一路順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "盧卡"
				},
				{
					"id": 705100408,
					"content": "他也沒說錯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705100409
					]
				}
			]
		}
