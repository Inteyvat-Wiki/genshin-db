			"dialogs": [
				{
					"id": 760440301,
					"content": "「旗艦」的懸賞啊…不知不覺就只剩最後一個了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440302
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440302,
					"content": "#聽聞是多虧了{NICKNAME}的活躍，不過看來就算是{M#他}{F#她}，對這最後一個懸賞也是束手無策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440303
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760440303,
					"content": "畢竟實在沒什麼線索嘛——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440304
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440304,
					"content": "啊，懸賞上沒寫，也不見得真的沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440305
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440305,
					"content": "看來妳有頭緒了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440306
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760440306,
					"content": "我去找勒塞克問問好了。憑我資深的身分，應該有辦法問出些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440307
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440307,
					"content": "那就交給妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440308
					],
					"speakerTitle": "奈芙爾"
				},
