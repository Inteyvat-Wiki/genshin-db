							10.74
						],
						"pointId": 146
					}
				]
			},
			"dialogs": [
				{
					"id": 760440201,
					"content": "懸賞目標的資訊都在告示牌上，問我也可以，但賞金多少沒有商量的餘地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440202
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440202,
					"content": "關於懸賞目標…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440203
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440203,
					"content": "板子上有四個目標，但只有三個有線索。被人指控詐欺而懸賞的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440204
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440204,
					"content": "…停一下，停一下！敷衍那些新入行的寶藏獵人也就算了，對我也這樣？你知道我要問的是哪個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440205
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440205,
					"content": "「秘聞館」要插手嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440206
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440206,
					"content": "那要看老闆的意思。欸？怎麼變成你問我了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440207
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440207,
					"content": "對了，「裂顎」哈爾克到現在還是下落不明，難道不是因為你們給的線索寫得太模糊了嗎？你自己看看，連外貌特徵都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440208
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440208,
					"content": "要是哪個寶藏獵人連這個都不知道，那肯定也不是哈爾克的對手，何必讓他們浪費時間…浪費自己的性命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440209
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440209,
					"content": "好吧，那除了他下巴上那道駭人的疤痕，還有什麼其他的特徵？最好是其他人不知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440210
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440210,
					"content": "其他人不知道的…妳是說身上的…例如說背上的印記之類？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440211
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440211,
					"content": "對，就是這種，原來真的有啊！不過你又是怎麼知道的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440212
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440212,
					"content": "我不知道。有沒有我也不知道。再說，就算真的有，妳準備要怎麼查驗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440213
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440213,
					"content": "這、這麼說來也是…唉，真的就沒什麼獨家消息？看在我們這麼熟的分上，就不能透露一點嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440214
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440214,
					"content": "哈爾克在那夏鎮暴露了本性之後逃竄去了倫波島北部一帶，在那裡繼續為非作歹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440215
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440215,
					"content": "這我都知道，之前多多少少聽過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440216
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440216,
					"content": "但他最近不是沒了消息嗎？要是去了北邊，皮拉米達城還好，但如果是去至冬堡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440217
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440217,
					"content": "（冰天雪地的，我這手臂受得了嗎…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440218
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440218,
					"content": "不會，他還在倫波島，只是不知道他在哪裡藏身。這是獨家消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440219
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440219,
					"content": "欸，這你又是怎麼確定的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440220
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440220,
					"content": "那就是商業機密了，價錢是另外算的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440221
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440221,
					"content": "呿，小氣。唉，一個下巴有疤的壯漢，哪怕只是在倫波島上，走十步也會碰到一個吧？這要怎麼找啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440222
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440222,
					"content": "那就看在我們這麼熟的份上，給妳一個建議——別光盯著下巴上的疤痕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440223
					],
					"speakerTitle": "勒塞克"
				},
				{
					"id": 760440223,
					"content": "…你是想說，他會設法把下巴上的疤痕遮住？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440224
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440224,
					"content": "有道理…他會被稱作「裂顎」就是因為那道標誌性的傷疤。反過來說，如果沒了這道疤痕，他就和其他壯漢沒什麼不同了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440225
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440225,
					"content": "這樣一來，只要找刻意遮擋下巴的壯漢就好了。算是一個新線索，好吧，之後有進展了再來找你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440226
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440226,
					"content": "等妳的好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "勒塞克"
				}
			]
		},
