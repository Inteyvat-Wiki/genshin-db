			"dialogs": [
				{
					"id": 760440101,
					"content": "「旗艦」的懸賞裡有一條很棘手的呢…幾乎沒什麼線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440102
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440102,
					"content": "前陣子還聽說他在倫波島北邊傷人，現在卻突然消失得無影無蹤，一點消息也沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440103
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440103,
					"content": "「凡走過必留下痕跡」，哪怕是抹除痕跡，也會留下新的印跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440104
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760440104,
					"content": "再者，懸賞裡沒有明文寫出來，也不代表他們沒有掌握任何資訊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440105
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760440105,
					"content": "說得也是，我去找勒塞克問問好了。憑我資深的身分，應該有辦法問出些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440106
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760440106,
					"content": "那就交給妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760440107
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 760440107,
					"content": "嗯，放心吧，老闆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂達"
				}
			]
		},
		{
