			"dialogs": [
				{
					"id": 4842201,
					"content": "居然跑到這裡來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4842202,
					"content": "前面已經沒有元素痕跡了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4842203
					]
				},
				{
					"id": 4842203,
					"content": "文物上面的元素力要耗盡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842204
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4842204,
					"content": "原來是這樣，怪鳥一夥知道自己沒辦法處理元素的痕跡，才讓手下拖住我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842205
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4842205,
					"content": "是想等元素的痕跡自然消失吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4842206
					],
					"speakerTitle": "安柏"
