				"points": []
			},
			"dialogs": [
				{
					"id": 4843101,
					"content": "太好了，是西風騎士團的人！丘丘人應該不敢追過來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843102
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843102,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4843103,
					"content": "真是倒楣…我們的車隊被丘丘人襲擊了，還好我們跑得比較快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843104
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843104,
					"content": "丘丘人襲擊？可是周圍的丘丘人營地，幾乎都已經被騎士團清理乾淨了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843105
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4843105,
					"content": "是一個很小的丘丘人營地，和鎮裡隔的不遠，我平時進貨擺攤的時候也會刻意繞開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843106
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843106,
					"content": "但是今天，突然從天上飛下來一個人，正好落在那個丘丘人營地裡面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843107
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843107,
					"content": "嗯…總感覺是某人經常做的事情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4843108,
					"content": "丘丘人一下子就暴動了，跟著那個怪人就追了出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843109
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843109,
					"content": "我是跑了，可是我運水果的車全都被砸了！明天商隊來的時候，我該怎麼開張啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843110
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843110,
					"content": "怪人？是什麼樣子的怪人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843111
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4843111,
					"content": "抱著個什麼東西，飛得歪歪扭扭的…嗯，一定是因為抱著這東西他才掉下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843112
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843112,
					"content": "真是的，沒考過飛行執照嗎？不許帶重物懂不懂？！我一定要去檢舉，吊銷他的飛行執照！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843113
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843113,
					"content": "抱著重物…說不定就是帶著文物逃跑的怪鳥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843114
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4843114,
					"content": "你看見那個怪人往哪裡跑了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843115
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4843115,
					"content": "我跑的時候就來得及看了一眼，他們好像…是往前面跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843116
					],
					"speakerTitle": "法拉"
				},
				{
					"id": 4843116,
					"content": "#總算抓住線索了，{NICKNAME}，我們快點追上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4843117
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4843117,
					"content": "哦對了，別擔心，我回去也會報告騎士團，把殘留的丘丘人營地盡快處理掉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				}
			]
