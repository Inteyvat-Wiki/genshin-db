			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大門"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722700101,
					"content": "#我乃末代地走官·大門。珊瑚宮之勇者，我認可{F#妳}{M#你}挑戰的榮譽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700102
					],
					"speakerTitle": "大門"
				},
				{
					"id": 722700102,
					"content": "#勇武即是不擇手段戰勝一切敵人的能力。{F#妳}{M#你}只要打敗所有敵人解放「高門之火」就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700103
					],
					"speakerTitle": "大門"
				},
				{
					"id": 722700103,
					"content": "#順帶一提，此處的敵人皆是虛像。乃是陽炎幻法與{F#妳}{M#你}自己內心所知曉的強敵之印象互攝而成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700104
					],
					"speakerTitle": "大門"
				},
				{
					"id": 722700104,
					"content": "儘管如此，稍有不慎還是會受傷甚至被打垮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700105
					],
					"speakerTitle": "大門"
				},
				{
					"id": 722700105,
					"content": "#我將在上方三界塔處等候{F#妳}{M#你}完成挑戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大門"
				}
			]
		},
		{
			"id": 7227002,
