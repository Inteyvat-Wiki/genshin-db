			"dialogs": [
				{
					"id": 722700201,
					"content": "珊瑚宮之勇者，已經完成了挑戰嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700202
					],
					"speakerTitle": "大門"
				},
				{
					"id": 722700202,
					"content": "追求勇武，那就用盡一切手段打倒所有擋在面前的敵人就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大門"
