			"dialogs": [
				{
					"id": 722700301,
					"content": "漂亮漂亮！把一切強敵都粉碎了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722700302
					],
					"speakerTitle": "大門"
				},
				{
					"id": 722700302,
					"content": "#如此威武，可稱「常世無雙」！我，末代地走官·大門，於此認可{F#妳}{M#你}的勇武。",
