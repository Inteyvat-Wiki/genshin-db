						],
						"pointId": 10040
					}
				]
			},
			"dialogs": [
				{
					"id": 750410201,
					"content": "啊，這裡果然是被詛咒的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410202
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750410202,
					"content": "#{F#妳}{M#你}們也不要停留太久了，快點離去吧…對，在漆黑的潮水到來之前，{F#妳}{M#你}們一定要離去才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750410203
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750410203,
					"content": "對，漆黑的潮水，那巨大的影子就要來了，必須…必須讓大家安全離開，要讓大家…安全離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誇恩因"
				}
			]
		},
