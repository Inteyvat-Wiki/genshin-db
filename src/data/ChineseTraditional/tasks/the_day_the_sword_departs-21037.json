			"trigger": {
				"objectNames": [
					"小雀兒",
					"芷若"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370401,
					"content": "芷若姐姐，妳…妳說師兄他是不是故意的！他就是…就是不想和我待在一塊！嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370402
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 210370402,
					"content": "師妹，你們朝夕相處，他又怎麼可能不明白妳的心意呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370403
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 210370403,
					"content": "他之所以要離開璃月外出遊歷，也是有自己的考量，妳就是隨他一起出行又有何妨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370404
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 210370404,
					"content": "我就是不想離開璃月！我們倆就在這裡待著不好嗎？古華派…管他古華派做什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370405
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 210370405,
					"content": "那妳為什麼不把這些話告訴他呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370406
					],
					"speakerTitle": "芷若"
				},
				{
					"id": 210370406,
					"content": "我…我…我…師兄一心都是古華派…我要是對師兄說了這話，師兄討厭我怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370407
					],
					"speakerTitle": "小雀兒"
				},
				{
					"id": 210370407,
					"content": "唉，師妹啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芷若"
				}
			]
		},
