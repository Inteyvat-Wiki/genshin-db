			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370301,
					"content": "多謝，這些就足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370302,
						210370305
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370302,
					"content": "你…看起來情緒低落。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370303
					]
				},
				{
					"id": 210370303,
					"content": "#啊？沒事沒事，哈哈哈…讓{F#妳}{M#你}見笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370304
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370304,
					"content": "只不過，突然要離開生活了這麼久的璃月，我多少還是會有些不捨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370305,
					"content": "你們什麼時候出發？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370306
					]
				},
				{
					"id": 210370306,
					"content": "等物資準備齊全之後，我們就會出發了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370307
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370307,
					"content": "哦對了，之前和我一起去層岩巨淵的那位冒險家也會和我們同行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370308
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370308,
					"content": "這位冒險家聽說我要去楓丹，說自己也很有興趣，於是就和我們一起走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370309
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370309,
					"content": "那位客商倒是很高興多了個冒險家來保護他…但老實說，我真的不擅長和這種太過熱情的人交流啊，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370310
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370310,
					"content": "真沒想到，我也會有離鄉遠行的一天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
			"id": 2103704,
