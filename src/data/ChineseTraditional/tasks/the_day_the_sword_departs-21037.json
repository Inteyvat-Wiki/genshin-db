			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210370101,
					"content": "璃月啊…璃月，不知我何時才能再回來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370102
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370102,
					"content": "你怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370103
					]
				},
				{
					"id": 210370103,
					"content": "#旅行者，是{F#妳}{M#你}啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370104
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370104,
					"content": "是這樣。我去楓丹的行程終於定下來了，過幾天我就隨著那位客商一起啟程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370105
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370105,
					"content": "現在他還得處理一些商貿事務，我也趁著這個時間，最後再收拾收拾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370106,
						210370107
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370106,
					"content": "你不回絕雲間看看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				},
				{
					"id": 210370108,
					"content": "呵呵，我要是再去周圍看看，只怕我就狠不下心離開璃月了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370109
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370109,
					"content": "我就在這裡多看幾眼城裡就行。在這裡生活了這麼久，這次離開，也不知道什麼時候才能再回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370110
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370110,
					"content": "哦對了，師妹她…最後還是沒答應和我一起走，但我已經拜託芷若照顧她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370111
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370111,
					"content": "我也把一些錢財留給了她，師妹比我聰明，她會照顧好自己的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370112
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370112,
					"content": "…也許未來有一天，她也會理解我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370113
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370113,
					"content": "#對了旅行者，我還想再拜託{F#妳}{M#你}一件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370114
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370114,
					"content": "#能不能請{F#妳}{M#你}幫我去拿一些「土」回來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370115,
						210370116
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370115,
					"content": "倒是沒問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370117,
					"content": "遊子離鄉，多少得帶點紀念走不是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370118
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370118,
					"content": "帶一撮璃月的土在身邊，我也勉強能算是沒有和這片土地斷了聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370119
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370119,
					"content": "你怎麼不自己去拿？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370120
					]
				},
				{
					"id": 210370120,
					"content": "哈哈哈…之前不是說了嗎？要是我真去周圍看一圈，再觸景生情一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370121
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370121,
					"content": "只怕我好不容易鼓起的這麼一點離鄉的勇氣，就要煙消雲散了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370122
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370122,
					"content": "#所以這件取土的事，就拜託{F#妳}{M#你}了，旅行者。我把取土的位置給{F#妳}{M#你}標在地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370123
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370123,
					"content": "這個地方有什麼特別的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370124
					]
				},
				{
					"id": 210370124,
					"content": "咳…我…我之前經常帶著師妹在那裡練劍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210370125
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370125,
					"content": "#總之！所以這件取土的事，就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210370116,
					"content": "你要土做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370117
					]
				},
				{
					"id": 210370107,
					"content": "你不再去周圍看看？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210370108
					]
				}
			]
		},
		{
