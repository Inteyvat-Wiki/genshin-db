			"completionStepIds": [
				7566201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7566201",
							"2"
						],
						"stepId": 7566201,
						"stateName": "QUEST_STATE_UNFINISHED"
