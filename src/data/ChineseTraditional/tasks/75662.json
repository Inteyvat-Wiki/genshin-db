			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"基尼奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 756620101,
					"content": "有信使告訴我戰備聯絡官找到了強大的試煉檢驗人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620102
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620102,
					"content": "#確認是{F#妳}{M#你}，我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620103
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620103,
					"content": "欸，怎麼連這傢伙都找來了？基尼奇，你這朋友跟你同一個德行，根本什麼委託都接啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620104
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 756620104,
					"content": "通訊器傳來通知了，我收到了一份讓聒噪的龍閉嘴的委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620105,
						756620107
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620105,
					"content": "我剛提的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620106
					]
				},
				{
					"id": 756620106,
					"content": "你…你們…好哇，竟敢合起夥來捉弄我偉大聖龍…你們會付出代價的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 756620109,
					"content": "#言歸正傳吧，{NICKNAME}，這次要有勞{F#妳}{M#你}檢驗這幾個關卡了。難度和平衡性應當不會讓{F#妳}{M#你}失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620110
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620110,
					"content": "難度？我是沒看出有半點難度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620111
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 756620111,
					"content": "#「讓{F#她}{M#他}們隨機抽笨蛋夥伴，埋著頭體驗山崖垂降去。」這是你對難度的理解和詮釋嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620112
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620112,
					"content": "況且，抽選的夥伴裡只有一成機率是匿葉龍，剩下的全是熔岩遊像和岩史萊姆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620113,
						756620116
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620113,
					"content": "這是玩命啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620114
					]
				},
				{
					"id": 756620114,
					"content": "#呵，{F#妳}{M#你}還不知道「懸木人」愛玩的是什麼嗎？{F#妳}{M#你}跟我的小小僕從認識也有一段時間了，我這建議可是量身訂製。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620115
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 756620115,
					"content": "那你怎麼不親自示範？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620120,
					"content": "…參加這種小打小鬧的挑戰，簡直有辱我偉大聖龍的尊嚴。你們愛怎樣玩就怎樣玩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620121
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 756620121,
					"content": "#總之，伊拉德開給我的價碼非常不錯，希望{F#妳}{M#你}既能在挑戰中享受到樂趣，也能獲得滿意的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620122,
						756620123
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620122,
					"content": "非常期待！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620124,
					"content": "一切順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620123,
					"content": "交給我吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620124
					]
				},
				{
					"id": 756620116,
					"content": "好像還滿夠勁的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620117
					]
				},
				{
					"id": 756620117,
					"content": "你看看，你聽聽？人家的眼力、見識和思維樣樣都比你這傢伙好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620118
					],
					"speakerTitle": "阿喬"
				},
				{
					"id": 756620118,
					"content": "但我想看阿喬先做榜樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620119
					]
				},
				{
					"id": 756620119,
					"content": "支持。阿喬身形袖珍，一定遠比挑戰者靈活。即使不巧被魔物揍了一擊，也不會徑直砸進地裡，摔出一個坑洞吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620120
					],
					"speakerTitle": "基尼奇"
				},
				{
					"id": 756620107,
					"content": "沒關係，那個可以晚點再完成。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756620108
					]
				},
				{
					"id": 756620108,
					"content": "#哼…別以為{F#妳}{M#你}幫偉大聖龍說了句好話，我就會對{F#妳}{M#你}感恩戴德！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756620109
					],
					"speakerTitle": "阿喬"
				}
			]
		}
	]
}