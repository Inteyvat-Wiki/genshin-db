			"dialogs": [
				{
					"id": 230430501,
					"content": "歡迎光臨！要買些常用的香料嗎？價格很實惠哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430502
					],
					"speakerTitle": "拉瑪"
				},
				{
					"id": 230430502,
					"content": "關於阿扎萊的訂單…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430503
					]
				},
				{
					"id": 230430503,
					"content": "#欸？阿扎萊拜託{F#妳}{M#你}來訂貨嗎？倒是沒問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430504
					],
					"speakerTitle": "拉瑪"
				},
				{
					"id": 230430504,
					"content": "不過之前他都是拜託鍍金旅團的人把貨款帶來，這次怎麼拜託了一個冒險家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430505
					],
					"speakerTitle": "拉瑪"
				},
				{
					"id": 230430505,
					"content": "咳！這次他有多少貨金？我看看…喔，不少啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430506
					],
					"speakerTitle": "拉瑪"
				},
				{
					"id": 230430506,
					"content": "唔，如果在我這裡進香料的話，我提供給他的貨，應該能足夠他賣很長時間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430507
					],
					"speakerTitle": "拉瑪"
				},
				{
					"id": 230430507,
					"content": "至於售價嘛…我還是建議和之前一樣定的稍微低一點。這樣才容易賣出去嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430508,
						230430510
					],
					"speakerTitle": "拉瑪"
				},
				{
					"id": 230430508,
					"content": "就在妳這裡訂貨了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430509
					]
				},
				{
					"id": 230430509,
					"content": "喔！謝謝惠顧，等我準備好之後，就雇人把貨物運過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉瑪"
				},
				{
					"id": 230430510,
					"content": "我再去別處看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430511
					]
				},
				{
					"id": 230430511,
					"content": "#好吧…如果{F#妳}{M#你}還是想在我這裡訂貨，過來和我說一聲就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉瑪"
				}
			]
		},
