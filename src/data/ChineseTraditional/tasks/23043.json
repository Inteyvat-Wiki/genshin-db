			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿扎萊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230430101,
					"content": "還是得拜託里夫幫忙找個人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430102
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430102,
					"content": "你怎麼愁眉苦臉的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430103
					]
				},
				{
					"id": 230430103,
					"content": "#旅行者，{F#妳}{M#你}是想買什麼嗎？抱歉，現在店裡可能有些缺貨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430104
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430104,
					"content": "你就是為這個煩惱嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430105
					]
				},
				{
					"id": 230430105,
					"content": "是啊…我們這村子在沙漠裡，運送貨物本來就很不方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430106
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430106,
					"content": "我如果想進貨，還得先拜託外出的人幫我去訂貨，然後再和里夫他們一起把貨接進村裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430107
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430107,
					"content": "這麼一來二去的，我做生意的成本飛速地往上漲，為了維持收支，我也只能把這些貨物稍微賣貴一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430108
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430108,
					"content": "還好村裡的人都理解我，也願意光顧我的生意，不然…我這小店鋪，大概早就倒閉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430109
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430109,
					"content": "但是…唉，我也不是隨時都能找到準備出村的人，里夫他們也不是隨時都有空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430110
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430110,
					"content": "如果運氣不好，某些存量少的貨物就會斷貨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430111,
						230430114
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430111,
					"content": "那些貨物是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430112
					]
				},
				{
					"id": 230430112,
					"content": "都是一些和日常用度有關的貨物，這些東西我進得雖然不慢，但賣得更快啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430113
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430113,
					"content": "我這裡本來就是小本生意，也不可能經常大批量進貨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430117
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430117,
					"content": "#咳，先不說這些。旅行者，{F#妳}{M#你}是準備出村子去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430118
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430118,
					"content": "#我最近想要進一批香料，需要有人幫我去下訂單…{F#妳}{M#你}能幫我這個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430119,
						230430120
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430119,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430122
					]
				},
				{
					"id": 230430122,
					"content": "我想想…<color=#00E1FFFF>拉瑪</color>賣的香料價錢很公道，品質也…還算過得去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430123
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430123,
					"content": "<color=#00E1FFFF>朱特</color>好像進了一批新型香料，品質很不錯。我想要進一點回來試著賣賣看，但就是不知道價格怎麼樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430124
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430124,
					"content": "但我這次用來進貨的錢就只有這麼一點，也不知道到底從哪家進貨最好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430125
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430125,
					"content": "#旅行者，請{F#妳}{M#你}幫我去看看這兩家售賣香料的情況，再幫我找一家訂貨吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430126
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430126,
					"content": "哦對了，之前託人訂貨的時候，我會拜託他們幫我訂一些價格相對便宜的貨品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430127
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430127,
					"content": "#{F#妳}{M#你}幫我訂貨的時候，記得也幫我找一家貨物相對便宜的店下訂單啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430128
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430128,
					"content": "在阿如村做生意嘛，還是保持著「薄利多銷」的原則比較好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430129,
						230430130
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430129,
					"content": "我先去<color=#00E1FFFF>拉瑪</color>那邊看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430131
					]
				},
				{
					"id": 230430131,
					"content": "#謝謝{F#妳}{M#你}願意幫忙，我把她的所在位置幫{F#妳}{M#你}標在地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430133
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430133,
					"content": "#那就拜託了，如果{F#妳}{M#你}有什麼問題的話，隨時都可以回來問我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430130,
					"content": "我先去<color=#00E1FFFF>朱特</color>那邊看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430132
					]
				},
				{
					"id": 230430132,
					"content": "#謝謝{F#妳}{M#你}願意幫忙，我把他的所在位置幫{F#妳}{M#你}標在地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430133
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430120,
					"content": "店裡的香料斷貨了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430121
					]
				},
				{
					"id": 230430121,
					"content": "斷貨倒是談不上…但這種銷量大的貨物，多備點總是好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430122
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430114,
					"content": "如果能找個長期夥伴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430115
					]
				},
				{
					"id": 230430115,
					"content": "#哈哈哈…我也想過，但{F#妳}{M#你}看看周圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430116
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430116,
					"content": "往這個村子裡運貨做生意，可不是一件容易的事情啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430117
					],
					"speakerTitle": "阿扎萊"
				}
			]
		},
		{
			"id": 2304302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
