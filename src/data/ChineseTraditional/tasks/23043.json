			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿扎萊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230430201,
					"content": "#怎麼樣？{F#妳}{M#你}訂到貨了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430202,
						230430203
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430202,
					"content": "關於<color=#00E1FFFF>拉瑪</color>的位置…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430204
					]
				},
				{
					"id": 230430204,
					"content": "#{F#妳}{M#你}不太清楚她具體在哪裡？好…我把她的所在位置幫{F#妳}{M#你}標在地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430206
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430206,
					"content": "#這樣就行了，拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430203,
					"content": "關於<color=#00E1FFFF>朱特</color>的位置…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430205
					]
				},
				{
					"id": 230430205,
					"content": "#{F#妳}{M#你}不太清楚他具體在哪裡？好…我把他的所在位置幫{F#妳}{M#你}標在地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430206
					],
					"speakerTitle": "阿扎萊"
				}
			]
		},
		{
			"id": 2304303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304307",
							"2"
						],
						"stepId": 2304307,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿扎萊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230430301,
					"content": "還是得拜託里夫幫忙找個人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430302
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430302,
					"content": "你怎麼愁眉苦臉的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430303
					]
				},
				{
					"id": 230430303,
					"content": "#旅行者，{F#妳}{M#你}是想買什麼嗎？抱歉，現在店裡可能有些缺貨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430304
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430304,
					"content": "你就是為這個煩惱嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430305
					]
				},
				{
					"id": 230430305,
					"content": "是啊…我們這村子在沙漠裡，運送貨物本來就很不方便。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430306
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430306,
					"content": "我如果想進貨，還得先拜託外出的人幫我去訂貨，然後再和里夫他們一起把貨接進村裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430307
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430307,
					"content": "這麼一來二去的，我做生意的成本飛速地往上漲，為了維持收支，我也只能把這些貨物稍微賣貴一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430308
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430308,
					"content": "還好村裡的人都理解我，也願意光顧我的生意，不然…我這小店鋪，大概早就倒閉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430309
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430309,
					"content": "但是…唉，我也不是隨時都能找到準備出村的人，里夫他們也不是隨時都有空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430310
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430310,
					"content": "如果運氣不好，某些存量少的貨物就會斷貨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430311,
						230430314
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430311,
					"content": "那些貨物是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430312
					]
				},
				{
					"id": 230430312,
					"content": "都是一些和日常用度有關的貨物，這些東西我進得雖然不慢，但賣得更快啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430313
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430313,
					"content": "我這裡本來就是小本生意，也不可能經常大批量進貨…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430317
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430317,
					"content": "#咳，先不說這些。旅行者，{F#妳}{M#你}是準備出村子去吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430318
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430318,
					"content": "#我最近想要進一批魚乾，需要有人幫我去下訂單…{F#妳}{M#你}能幫我這個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430319,
						230430320
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430319,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430322
					]
				},
				{
					"id": 230430322,
					"content": "我想想…<color=#00E1FFFF>布特羅斯</color>做的魚乾價錢很公道，味道也還…算是能入口吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430323
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430323,
					"content": "<color=#00E1FFFF>賈漢吉爾</color>最近好像用新方法製作了一批魚乾，據說用了很多香料，味道非常不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430324
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430324,
					"content": "我想進一些過來試著賣賣看，但就是不知道價錢怎麼樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430325
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430325,
					"content": "但我這次用來進貨的錢就只有這一點，也不知道到底從哪家進貨最好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430326
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430326,
					"content": "#旅行者，請{F#妳}{M#你}幫我去看看這兩家售賣魚乾的情況，再幫我找一家訂貨吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430327
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430327,
					"content": "哦對了，之前託人訂貨的時候，我會拜託他們幫我訂一些價格相對便宜的貨品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430328
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430328,
					"content": "#{F#妳}{M#你}幫我訂貨的時候，記得也幫我找一家貨物相對便宜的店下訂單啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430329
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430329,
					"content": "在阿如村做生意嘛，還是保持著「薄利多銷」的原則比較好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430330
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430330,
					"content": "#所以，這次就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430331,
						230430332
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430331,
					"content": "我先去<color=#00E1FFFF>布特羅斯</color>那邊看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430333
					]
				},
				{
					"id": 230430333,
					"content": "#謝謝{F#妳}{M#你}願意幫忙，我把他的所在位置幫{F#妳}{M#你}標在地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430334
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430334,
					"content": "#那就拜託了，如果{F#妳}{M#你}有什麼問題的話，隨時都可以回來問我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430332,
					"content": "我先去<color=#00E1FFFF>賈漢吉爾</color>那邊看看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430333
					]
				},
				{
					"id": 230430320,
					"content": "我還以為大家會直接曬魚乾呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430321
					]
				},
				{
					"id": 230430321,
					"content": "哈哈哈…相信我旅行者，在沙漠裡曬魚乾可不是個好主意啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430322
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430314,
					"content": "如果能找個長期夥伴…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230430315
					]
				},
				{
					"id": 230430315,
					"content": "#哈哈哈…我也想過，但{F#妳}{M#你}看看周圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430316
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230430316,
					"content": "往這個村子裡運貨做生意，可不是一件容易的事情啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230430317
					],
					"speakerTitle": "阿扎萊"
				}
			]
		},
