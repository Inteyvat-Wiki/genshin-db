			"trigger": {
				"objectNames": [
					"辛焱",
					"火熾之心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700401,
					"content": "島上有些山體失去了植物和水脈，請問妳有辦法疏通它們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700402
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400700402,
					"content": "這件事，我知道一個人能幫忙。樓上住著我的同伴冰封之心，去問問她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "火熾之心"
				}
			]
		},
		{
			"id": 4007005,
			"completionStepIds": [
				4007005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007005",
							"2"
						],
						"stepId": 4007005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"冰封之心",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400700501,
					"content": "你們是什麼人？竟然會到我這裡來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700502
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400700502,
					"content": "妳好，我們想藉助妳的力量疏通島上那幾座山。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700503
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400700503,
					"content": "山？噢，我知道了…你們也想成為大音樂家，是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700504
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400700504,
					"content": "欸？是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400700505,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700506
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400700506,
					"content": "既然如此，我們就是志同道合的夥伴了。即使我很柔弱，也要為你們獻上一份力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700507
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400700507,
					"content": "拿著我的花瓣，把它種在音律交匯的終點，沉入地下的山脈將為這樂聲升起。只要我們還有音樂，生命就會流淌在每一寸土地上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400700508
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400700508,
					"content": "…謝謝妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4007010,
			"completionStepIds": [
				4007010
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007010",
							"2"
						],
						"stepId": 4007010,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱",
					"莫娜",
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400701001,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701002
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701002,
					"content": "終於，到這個時候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701003
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701003,
					"content": "各位，我曾許下一個願望，要跟誰都想不到的人一起辦演唱會。而今天，我在海島上找到了答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701004
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701004,
					"content": "許多年前將這座島製成巨型樂器的人，沒人知道他的名字和長相，但他絕對是提瓦特最偉大的音樂家之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701005
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701005,
					"content": "我從沒想過能見到這樣一件樂器。更想不到，我們能趁著潮汐奏響它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701006
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701006,
					"content": "要演奏搖滾樂了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701007
					]
				},
				{
					"id": 400701007,
					"content": "不。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701008
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701008,
					"content": "音樂是獻給知己的禮物，所以…我會選擇更適合這位原住民的方式與他合奏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701009
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701009,
					"content": "今天就不玩搖滾樂了，給大家看點新花樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701010
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701010,
					"content": "…呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701011
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701011,
					"content": "怎麼樣？我的演奏還不錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701012
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701012,
					"content": "非常不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701013
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701013,
					"content": "從未聽過這樣的合奏，很有意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701014
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400701014,
					"content": "而且很高雅！我不知道該怎麼說…反正很不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701015,
						400701016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400701015,
					"content": "很有性格的演出。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				},
				{
					"id": 400701017,
					"content": "嘿嘿，謝謝大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701018
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701018,
					"content": "這樣一來，我的願望也算是完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701019
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701019,
					"content": "還有什麼想做的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701020
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701020,
					"content": "沒有了。今晚應該能睡個好覺吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701021
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701021,
					"content": "接下來大家都閒著對吧？那我有個提議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701022
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400701022,
					"content": "我想再去一趟愚人眾營地，確認那裡的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701023
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400701023,
					"content": "嗯？原來你們也發現愚人眾營地了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701024
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701024,
					"content": "等等，妳也知道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701025
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400701025,
					"content": "我可是天才占星術士，而且我不是說過？水占盤恢復一點了。我能透過占卜感覺到這裡的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701026
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701026,
					"content": "咦，這裡都有愚人眾？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701027
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701027,
					"content": "對。今天跟菲謝爾分開時，我也把這件事告訴她了。假如遇到愚人眾，她會隱藏起來，不會有危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701028
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701028,
					"content": "原來如此，那我們也坦白吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701029
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400701029,
					"content": "將登島那天遇到愚人眾營地和奇怪裝置的事仔細說給其他人聽…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400701030
					]
				},
				{
					"id": 400701030,
					"content": "奇怪的裝置，神志不清的愚人眾…你們的意思是，這些跟最近的幻境有關？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701031
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701031,
					"content": "不能保證。但我覺得，兩者之間不應該完全沒有關聯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701032
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400701032,
					"content": "有道理，那趕快去營地看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701016,
					"content": "很有韻味的演出。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400701017
					]
				}
			]
		},
