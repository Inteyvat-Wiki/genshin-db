			"dialogs": [
				{
					"id": 400701801,
					"content": "能做的都做了，剩下那兩座山怎麼也解決不了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400701802,
					"content": "再想想，會有辦法的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701803
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701803,
					"content": "剛才我仔細看過，島上幾座山內部多半都有水脈和植物，這種體系將它們串聯在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701804
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701804,
					"content": "但現在山體坍塌，植物和水脈無法連通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701805
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701805,
					"content": "如果所有脈絡都被打通，它們就會連接起來，形成阿貝多筆記中所說的「巨型樂器」，以島嶼為單位演奏了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701806
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400701806,
					"content": "嗯，為了我想做的事，必須做到這一點…我想去問問那朵花，她應該知道辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
