			"dialogs": [
				{
					"id": 400701701,
					"content": "到了各位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701702
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400701702,
					"content": "咦？菲謝爾？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701703
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701703,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701704
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400701704,
					"content": "真的是她！菲謝爾——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400701705,
					"content": "…哼，來了嗎，諸位愚笨的家臣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701706
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400701706,
					"content": "哦、哦呀，好久不見了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701707
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400701707,
					"content": "也沒那麼久吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701708
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701708,
					"content": "啊…小姐和我察覺到某種氣息，特意提前趕往此處，等待與諸位會合。沒想到，諸位…諸位來得比想像中更快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701709
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400701709,
					"content": "奧茲看起來有點緊張？是我的錯覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400701710,
					"content": "幽夜淨土降臨在即，本皇女還需要籌備祝聖儀典。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701711
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400701711,
					"content": "小姐，您又要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701712
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400701712,
					"content": "我一人也可行動，奧茲，你若是厭煩了夤夜的侵襲，就退回到白日熾光中去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701713
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400701713,
					"content": "小姐，如此話語可不像您該對我說的。我是您的扈從，您的眼睛，不可能丟下您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701714
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400701714,
					"content": "…少在那裡用打量的眼神看著我了！總、總之，現在還沒到解釋的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701715
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400701715,
					"content": "哎呀，小姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701716
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400701716,
					"content": "諸位，萬分抱歉，小姐心情不好，還請不要放在心上。也恕我先失陪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701717
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400701717,
					"content": "…哈，離隊這麼久，心情也沒好起來嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701718
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701718,
					"content": "看到菲謝爾，我就覺得這一帶即將成型的幻境應該跟她有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701719
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701719,
					"content": "嗯。靠近與我有關的幻境時，我隱約能感覺到某種熟悉的氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701720
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400701720,
					"content": "我也是。雖然並無道理，只是覺得有什麼有意思的東西要出現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701721
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701721,
					"content": "嗯。菲謝爾和奧茲能有所感知，說明這份預感也會成真…菲謝爾應該就是不想面對她的幻境，才這麼焦躁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701722
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701722,
					"content": "怎麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400701723,
					"content": "或許，她的幻境中隱藏著某些不希望被人知道的秘密吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701724
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400701724,
					"content": "各位，我們先在這裡休息吧。等幻境出現，謎底自然就會揭開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
