			"dialogs": [
				{
					"id": 400701901,
					"content": "我們把花瓣種下去了，妳能感覺到什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701902
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701902,
					"content": "嗯…有了。陽光不錯，海上有寶石般絢爛的光芒，浪拍打著乳白色的沙灘，那些沙粒流入海中，又被推回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701903
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400701903,
					"content": "…有海鳥落在岩石上，輕輕啄著，發出有節奏的樂曲。咚咚，咚咚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701904
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400701904,
					"content": "是音樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701905
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701905,
					"content": "是音樂啊。說起來，這座島本就是一件龐大的樂器。既然妳是音樂人，應該能理解其中的深意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701906
					],
					"speakerTitle": "冰封之心"
				},
				{
					"id": 400701906,
					"content": "用海風、浪花與潮汐演奏音樂，是這個世界上最浪漫的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400701907
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400701907,
					"content": "走吧各位，是時候請你們聽聽我的演出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		}
