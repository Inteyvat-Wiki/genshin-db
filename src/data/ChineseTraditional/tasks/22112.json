					"淮安"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 221120101,
					"content": "看來還是不修不行啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120102
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120103
					]
				},
				{
					"id": 221120103,
					"content": "哦，是您啊。瞧瞧，這上客棧的樓梯斷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120104
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120104,
					"content": "這麼大的一截斷口，路過的人太容易摔下去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120105
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120105,
					"content": "怎麼斷的？哦，之前有一群怪物想要衝進客棧，我就出去處理了一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120106
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120106,
					"content": "結果沒收住手，把一個大塊頭怪物打了過來，一下子就把樓梯給砸爛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120107
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120107,
					"content": "說要修，結果一直沒空出時間來，現在客人越來越多，這樓梯實在是不修不行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120108
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120108,
					"content": "這裡還算好修，我一個人就能修好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120109
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120109,
					"content": "如果有空的話，您能幫我去拿點木板來嗎？我在這守著，免得又有人失足…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120110,
						221120113
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120110,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120111
					]
				},
				{
					"id": 221120111,
					"content": "那就麻煩您了，我專門買了一批木板來修這裡，就放在客棧底下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120112
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120112,
					"content": "您去看看，然後拿幾塊給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120113,
					"content": "要是再被砸爛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120114
					]
				},
				{
					"id": 221120114,
					"content": "那不能，我又不是年輕的時候了…再來一次，我絕對能收住手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120115
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120115,
					"content": "不過，還是先得修好再說。為了這，我還專門買了一批木板，就放在客棧底下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120116
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120116,
					"content": "勞煩您，幫我下去拿點上來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
