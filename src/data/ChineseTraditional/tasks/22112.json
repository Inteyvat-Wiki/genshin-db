			"dialogs": [
				{
					"id": 221120501,
					"content": "行了，這樣就可以走人了，應該也不會有人摔下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120502
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120502,
					"content": "和樓梯看起來不太搭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120503
					]
				},
				{
					"id": 221120503,
					"content": "不太搭？這也沒辦法，我也不是專業的木匠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120504
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120504,
					"content": "呼…不過，這還只是第一個，還有一個斷口得修。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120505
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120505,
					"content": "不過，今天就到這吧，客棧還開著，我還得去接待客人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120506
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120506,
					"content": "樓梯得修，生意也得做啊…辛苦您了，這些您拿著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
