					"content": "您找到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120202
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120202,
					"content": "還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						221120203
					]
				},
				{
					"id": 221120203,
					"content": "木板我都放在客棧底下了，應該滿好找的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						221120204
					],
					"speakerTitle": "淮安"
				},
				{
					"id": 221120204,
					"content": "您去找找吧，我在這守著，免得又有人急匆匆地過來，一個不小心就下去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "淮安"
				}
			]
		},
