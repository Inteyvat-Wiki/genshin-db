						"pointId": 10046
					}
				]
			},
			"dialogs": [
				{
					"id": 750620301,
					"content": "#{F#妳}{M#你}們怎麼還逗留在此處呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620302
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750620302,
					"content": "冒險團的領隊，那位戴著鷹隼面具的英雄都已經…我們已經無力抵擋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750620303
					],
					"speakerTitle": "誇恩因"
				},
				{
					"id": 750620303,
					"content": "快走吧，快走吧，這裡是被詛咒之地啊，勇士，不是人該涉足的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "誇恩因"
				}
			]
		},
		{
			"id": 7506204,
