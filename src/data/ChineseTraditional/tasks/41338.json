					"甜甜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380201,
					"content": "#這裡就是這條賽道的起點了，{F#妳}{M#你}看，我還佈置好了霄燈呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380202
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380202,
					"content": "#好啊，那{F#妳}{M#你}準備好了就開始吧，一邊搜集霄燈，一邊飛到終點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
				}
			]
		},
		{
			"id": 4133803,
			"completionStepIds": [
				4133806
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
