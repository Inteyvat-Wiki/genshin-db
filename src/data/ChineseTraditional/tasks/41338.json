			"dialogs": [
				{
					"id": 413380501,
					"content": "兩條賽道體驗下來的感覺如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380502
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380502,
					"content": "還不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380503
					]
				},
				{
					"id": 413380503,
					"content": "那就太好了，這下我就可以正式去跟千岩軍申報了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380504
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380504,
					"content": "這麼有趣的冒險活動，一定會有很多人想要加入冒險家協會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380505
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380505,
					"content": "#對了，這是{F#妳}{M#你}幫我評估賽道的報酬，請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
