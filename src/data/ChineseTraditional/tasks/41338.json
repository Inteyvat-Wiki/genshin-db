			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"甜甜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380101,
					"content": "呃…怎麼都沒有人來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380102
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380103
					]
				},
				{
					"id": 413380103,
					"content": "旅行者！請、請聽我說…最近不是海燈節嗎？協會想要借著節日的氛圍宣傳一下，然後試著招募冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380104
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380104,
					"content": "我聽說小千想出了一個什麼…什麼圖的新玩法，我也不能落後！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380105
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380105,
					"content": "所以我也構想了一套活動方案，叫…「冒險行動初體驗」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380106
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380106,
					"content": "簡單來說，就是我想要以霄燈做標幟，標記出一條空中的飛行道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380107
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380107,
					"content": "然後，想要體驗這個活動的人，就可以展開「風之翼」，順著霄燈一路飛過去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380108
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380108,
					"content": "既能體驗冒險的刺激感，又能俯瞰璃月的美景，還有霄燈在旁邊，是不是感覺很不錯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380109
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380109,
					"content": "我本來設計了兩條賽道，但我跟千岩軍報備的時候，他們卻要求我事先找人評估安全性，就是先找人試飛一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380110
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380110,
					"content": "#{F#妳}{M#你}應該很有冒險經驗吧？如、如果{F#妳}{M#你}願意的話，能幫我去「評估」一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380111
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380111,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380112
					]
				},
				{
					"id": 413380112,
					"content": "#謝謝{F#妳}{M#你}願意幫忙，那我們快去天衡山吧，我佈置的第一條賽道是從那裡開始的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
				}
			]
		},
		{
			"id": 4133802,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
