			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"甜甜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413380301,
					"content": "#這裡就是終點啦。{F#妳}{M#你}飛得很熟練嘛…這條路給{F#妳}{M#你}的感覺怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380302,
						413380303
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380302,
					"content": "很有節日的氛圍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				},
				{
					"id": 413380304,
					"content": "嘿嘿，那當然了，這些可都是我特意佈置的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413380305
					],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380305,
					"content": "那我們接著去下一條賽道吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "甜甜"
				},
				{
					"id": 413380303,
					"content": "霄燈滿好看的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413380304
					]
				}
			]
		},
