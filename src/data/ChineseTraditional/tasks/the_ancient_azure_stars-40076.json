			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"楓原萬葉",
					"菲謝爾",
					"奧茲",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400760901,
					"content": "哇啊！這、這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760902
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400760902,
					"content": "又是蒙德的房屋？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760903
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400760903,
					"content": "怎麼到我家了啊——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760904
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400760904,
					"content": "妳家？這是妳家？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760905
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400760905,
					"content": "哦呀，這可真沒想到…我似乎聽說，梅姬斯圖斯卿一直過著較為拮据的生活，可這棟住宅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760906
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400760906,
					"content": "地上這幾本書有標籤呢，「孤品，僅售990000摩拉…」欸？！這麼貴嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400760907,
					"content": "這邊也有許多一看就很貴的精裝書本…這就是占星術士的房間嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760908
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400760908,
					"content": "房間佈設得十分精巧…這裡一定不便宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760909,
						400760910
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400760909,
					"content": "莫娜，原來這麼有錢嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				},
				{
					"id": 400760911,
					"content": "我說，我只是偶爾沒有現金而已，又不真是窮光蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760912
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400760912,
					"content": "妳不是嗎？我還請妳吃過飯，甚至帶妳去我家吃飯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760913
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400760913,
					"content": "小姐，措辭，措辭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760914
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400760914,
					"content": "啊咳咳！汝蒙受聖恩，隨本皇女進入幽夜淨土王城中拜謁斷罪之皇帝皇后，如此大事，汝竟敢忘卻？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760915
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400760915,
					"content": "啊對，妳媽媽做的燉肉和冷盤肉太好吃了！嗯，突然好想再吃一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760916
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400760916,
					"content": "梅姬斯圖斯卿，現在不是說這個的時候！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760917
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400760917,
					"content": "是蒙德菜嗎？我也想吃！聽說蒙德有很多美食，尤其是肉菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760918
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400760918,
					"content": "哼哼，那也賜汝榮光，下回，爾等可隨本皇女一同面見父皇母后。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760919
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400760919,
					"content": "#真的？喂{NICKNAME}，我們也去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400760920,
					"content": "這麼說來，好久沒去朋友家串門子，我也恭敬不如從命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760921
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400760921,
					"content": "唔，是不是應該提前準備伴手禮？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760922
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400760922,
					"content": "那二位為人隨和親切，並不計較這些。諸位隨意便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760923
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400760923,
					"content": "去的話一定要吃那個冷盤肉，聽說是她家的拿手好菜，非常美味！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760924
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400760924,
					"content": "比起這些，是否應該先解決眼前的謎題呢？其實，從進屋到現在，我都很介意那個擺飾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400760925
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400760925,
					"content": "啊，對哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400760910,
					"content": "一直以來是我有眼不識泰山…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400760911
					]
				}
			]
		},
		{
			"id": 4007613,
			"completionStepIds": [
				4007613
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007613",
							"2"
						],
						"stepId": 4007613,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"辛焱",
					"菲謝爾",
					"楓原萬葉",
					"奧茲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761301,
					"content": "回到這裡了呢。意思是，我們徹底離開幻境了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400761302,
					"content": "怪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761303
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761303,
					"content": "我的幻境裡並沒有那些關於愚人眾和裝置的線索…難道說，這些事與他們無關？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761304
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761304,
					"content": "或者，這些與我們有關的幻境，本就不是「過程」，而是「結果」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761305
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761305,
					"content": "呃，什麼意思啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400761306,
					"content": "就是說，這些幻境並不是引導我們解開謎團的線索，而是單純的結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761307
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761307,
					"content": "有人做了某些事，使這些幻境誕生。它是被動產物，自然就無法提示我們什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761308
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761308,
					"content": "倒不如說，這些幻境只跟我們自己有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761309
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400761309,
					"content": "純粹而自我的結晶…嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761310
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400761310,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761311
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400761311,
					"content": "各位，或許這件事應該回到原點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761312
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400761312,
					"content": "#最初登島那天，我和{NICKNAME}一起調查了愚人眾的營地。那裡有台古怪的裝置，旁邊的愚人眾神志不清。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761313
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400761313,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761314
					]
				},
				{
					"id": 400761314,
					"content": "與我們交涉的研究員聲稱，這台裝置只是他們愚人眾的工業發明，並和我們約法三章，保證不會打擾我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761315
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400761315,
					"content": "對對，那個戴帽子的胖子看起來像沒睡醒一樣，滿口胡說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400761316,
					"content": "我在想，有沒有可能，「陷入癲狂」和「產生幻境」是裝置導致的兩種不同結果？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761317
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400761317,
					"content": "而這一切，確實也跟那台損壞的裝置有關。但產生區別的不是裝置，而是受影響的人群。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761318
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400761318,
					"content": "……！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761319
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761319,
					"content": "這麼說來，夢與幻覺確實很難分辨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761320
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761320,
					"content": "你的意思是，我們跟他們在某些地方不同，所以受影響的結果也不同？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761321
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761321,
					"content": "對。而根據這幾日觀察，我認為…我們和那些人的區別在於，我們都擁有更為頑強堅定的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761322
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400761322,
					"content": "…嗯，說得通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761323
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400761323,
					"content": "意志堅定的人不會陷入瘋狂，所以只是產生幻覺，至於容易被擊潰的人，就沒辦法留下那麼穩定的幻境了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761324
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400761324,
					"content": "也就是說，我們應該即刻返回愚人眾營地，摧毀那台裝置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400761325,
					"content": "不，比起「摧毀」，更應該「修復」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761326
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400761326,
					"content": "小姐的意思是，貿然摧毀不明裝置或許會引發更嚴重的後果，不如先想辦法修復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761327
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400761327,
					"content": "嗯，小心駛得萬年船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761328
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400761328,
					"content": "如果我猜得沒錯，那台裝置很可能會對人腦產生影響，我們最好小心處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761329
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761329,
					"content": "那現在就過去吧！抓緊時間！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4007615,
			"completionStepIds": [
				4007615
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007615",
							"2"
						],
						"stepId": 4007615,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲謝爾",
					"奧茲",
					"莫娜",
					"楓原萬葉",
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400761501,
					"content": "如此輝煌的景色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761502
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400761502,
					"content": "該說不愧是天才占星術士嗎，梅姬斯圖斯卿，您真是幽夜淨土有史以來最好的大法師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761503
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400761503,
					"content": "謝謝，但幽夜淨土一共才多少年歷史啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761504
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761504,
					"content": "…星如寶鑽，月似珍珠。這是我見過最浩瀚的星空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761505
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400761505,
					"content": "真漂亮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761506
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400761506,
					"content": "能擁有這種幻境，莫娜心中一定也藏著寬闊無際的星海吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761507
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400761507,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761508
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761508,
					"content": "莫娜，怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761509
					]
				},
				{
					"id": 400761509,
					"content": "…我在想，這一定就是我們在仰望的事物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761510
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761510,
					"content": "這片星空非常美麗，甚至可以說，比我平時占卜看到的景象更絢爛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761511
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761511,
					"content": "其中每一顆星，都處在正確的位置上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761512
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761512,
					"content": "…這絕對是屬於我的幻境，只有在這裡，才能看到這樣的奇觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761513
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761513,
					"content": "奇觀？為什麼這樣說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400761514,
					"content": "你們知道嗎？提瓦特的星空非常奇妙，似乎隱藏了世間一切答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761515
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761515,
					"content": "「我失蹤的兒子什麼時候回來？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761516
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761516,
					"content": "「那個人究竟愛不愛我？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761517
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761517,
					"content": "「我能康復嗎？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761518
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761518,
					"content": "無論怎樣的事，都會被記錄在你命星的軌跡之中。而世界上那麼多人裡，有相當一部分人會偏離軌道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761519
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761519,
					"content": "代表你的星走在軌道上，意味著你將獲得健康、幸福與安寧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761520
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761520,
					"content": "反過來說，如果你的星偏離了軌道，一切就會變得糟糕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761521
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761521,
					"content": "所以，占卜結果中的星空，絕不會是這樣。星星們時而迷路，時而墜落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761522
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761522,
					"content": "…我希望大家都能獲得幸福，希望每個人都能走在軌道上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761523
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761523,
					"content": "為此，我提供建議，說出真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761524
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761524,
					"content": "我知道這些沒用，人的命運都彰顯在夜空中，我也只是其中之一，不可能改變什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761525
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761525,
					"content": "即使如此…在占星術之外，在昭示真實的話語之外，我仍抱有一絲不切實際的幻想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761526
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761526,
					"content": "人必須活在真實的道路之上，可是…就當我不自量力好了，我仍期盼並相信著「奇蹟」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761527
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761527,
					"content": "這片廣袤的星海中，有著你、我、他，乃至所有人的星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761528
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761528,
					"content": "星與星需要多巧的機率才能相遇？這些相遇，是否就是命運中最為美妙的「奇蹟」？…我不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761529
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761529,
					"content": "但提瓦特的星空裡永遠有你我的位置。哪怕占星術是絕對的理性…命運卻是無常、殘酷與浪漫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761530
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761530,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761531
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761531,
					"content": "莫娜，之前妳似乎一直在思考…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761532
					]
				},
				{
					"id": 400761532,
					"content": "現在妳找到答案了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400761533
					]
				},
				{
					"id": 400761533,
					"content": "…我想，我知道那些星中藏著什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400761534
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400761534,
					"content": "——「現在，我將抓住自己的命運。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫娜"
				}
			]
		},
