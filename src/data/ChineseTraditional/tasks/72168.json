			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680201,
					"content": "芭爾瓦涅，真的沒有別的方法了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680202
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680202,
					"content": "我手上的這本書裡就只記載了那一種方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680203
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 721680203,
					"content": "嗚…如果只是有魔物攔路的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680204
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 721680204,
					"content": "這是你們要的「緋櫻繡球」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680205
					]
				},
				{
					"id": 721680205,
					"content": "喔！沒錯，這就是我們要的那種「緋櫻繡球」，這種色澤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680206
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680206,
					"content": "太好啦！終於可以做好吃的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680207
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 721680207,
					"content": "#等一下，{F#妳}{M#你}已經進去那個屏障裡面了？用的是我們告訴{F#妳}{M#你}的那種方法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680208
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 721680208,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680209
					]
				},
				{
					"id": 721680209,
					"content": "#能告訴我{F#妳}{M#你}找到的那個「雷櫻枝條」在哪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680210
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 721680210,
					"content": "#{F#妳}{M#你}觸摸了「雷櫻枝條」之後，那個「雷種子」是怎麼附著在{F#妳}{M#你}身上的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680211
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 721680211,
					"content": "#抱歉，我先把筆記本拿出來…好了，{F#妳}{M#你}被「雷種子」附著之後，有什麼感覺嗎？還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680212
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 721680212,
					"content": "芭爾瓦涅，妳先稍等一下，這位旅行者剛幫了我們的忙，妳這個研究先緩緩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680213
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680213,
					"content": "#旅行者，多謝{F#妳}{M#你}幫忙，之前說好的報酬不會少的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680214
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680214,
					"content": "#但在那之前，請{F#妳}{M#你}再稍等一下吧。有了{F#妳}{M#你}拿來的「緋櫻繡球」，我也可以開始做菜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680215
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680215,
					"content": "我之前就聽說，稻妻有一種很有特色的菜叫「緋櫻天婦羅」，現在總算有機會試試看製作了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680216
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680216,
					"content": "#我先準備一下，應該很快就能做好了，{F#妳}{M#你}等一下再來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				}
			]
		},
		{
			"id": 7216803,
			"completionStepIds": [
				7216804
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7216804",
							"2"
						],
						"stepId": 7216804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"旭東"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721680301,
					"content": "這樣…再這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680302
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680302,
					"content": "你做好了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680303
					]
				},
				{
					"id": 721680303,
					"content": "還差最後一點…我得先把這個給裹上麵衣，然後放進去炸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680304
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680304,
					"content": "完成了！「緋櫻天婦羅」，趕緊嚐嚐看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680305
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680305,
					"content": "好、好吃，就是有點…有點燙…呼呼呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680306
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 721680306,
					"content": "旭東，書上說這種叫做「天婦羅」的東西，應該還要搭配蘸汁來著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680307
					],
					"speakerTitle": "芭爾瓦涅"
				},
				{
					"id": 721680307,
					"content": "蘸汁？這我倒是真沒準備，下次有機會我再研究看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680308
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680308,
					"content": "#這份「緋櫻天婦羅」是給{F#妳}{M#你}的，收下吧旅行者，謝謝{F#妳}{M#你}幫我們這個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680309
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680309,
					"content": "#還有這個「緋櫻天婦羅」的製作方法，我也抄了一份給{F#妳}{M#你}，{F#妳}{M#你}就拿上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680310
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680310,
					"content": "#以後有機會，{F#妳}{M#你}也自己試試製作一下吧，做菜這件事，還是挺有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680311,
						721680313
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680311,
					"content": "謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680312
					]
				},
				{
					"id": 721680312,
					"content": "別客氣，別客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680314
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680314,
					"content": "我們還會待在稻妻一段時間，過段時間，說不定會去<color=#00E1FFFF>神無塚</color>附近轉轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680316
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680316,
					"content": "而且朱莉說，她還想要去看看那棵在「鳴神大社」裡的神櫻樹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680317
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680317,
					"content": "據說，這島上所有的「緋櫻繡球」，都是從那棵大樹上飄落的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680318
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680318,
					"content": "到底是多大的樹，才能飄出那麼多花瓣呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680319
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680319,
					"content": "#如果{F#妳}{M#你}有興趣的話，也過去那邊看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721680320
					],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680320,
					"content": "#再次謝謝{F#妳}{M#你}幫忙，旅行者。我也得去吃點東西了，餓壞我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "旭東"
				},
				{
					"id": 721680313,
					"content": "你們接下來要去哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721680314
					]
				}
			]
		},
