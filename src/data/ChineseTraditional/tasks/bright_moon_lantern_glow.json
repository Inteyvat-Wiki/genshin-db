	"talks": [
		{
			"id": 7114901,
			"completionStepIds": [
				7114901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7114901",
							"2"
						],
						"stepId": 7114901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍溪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 711490101,
					"content": "今年的安排應該沒問題，呼…總算不用麻煩刻晴大人再來親自核算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490116
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490116,
					"content": "呃！不能想著這些，我是招財神我是招財神我是招財神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490103
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490103,
					"content": "請問您是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490117
					]
				},
				{
					"id": 711490117,
					"content": "我是招財神！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490118,
						711490119
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490118,
					"content": "看、看得出來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490120
					]
				},
				{
					"id": 711490120,
					"content": "#欸？這不是{NICKNAME}嗎？唉，早知道是{F#妳}{M#你}過來，我就不用背那麼多詞了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490121
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490121,
					"content": "#看{F#妳}{M#你}的樣子，也是來璃月過海燈節的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490122
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490122,
					"content": "#今年{F#妳}{M#你}算是來對了，瞧瞧周圍的氛圍，是不是比去年的海燈節更熱鬧了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490123,
						711490124
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490123,
					"content": "感覺每一年的海燈節…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490125
					]
				},
				{
					"id": 711490125,
					"content": "那是當然，俗話說「霄燈飛起節節高」，無論做什麼事都要求一個進步嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490126
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490126,
					"content": "#哎呀，大過節的不說這些，來來來，我給{F#妳}{M#你}指指哪裡有好玩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490127
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490127,
					"content": "我看看喔…嗯…有了！來海燈節，當然要先放霄燈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490128
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490128,
					"content": "#然後呢，我們今年還在璃月港的各處放了許多「吉事寶樹」，只要為它好好修剪枝幹，裡面的「吉語錢」就歸{F#妳}{M#你}啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490129
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490129,
					"content": "我們一共放了多少個來著？好像是…21，對，就是21個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490130
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490130,
					"content": "#而且…其實在這附近，就有一棵「吉事寶樹」喔。要是有興趣的話，{F#妳}{M#你}就直接去修剪一下吧，很簡單的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490131
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490131,
					"content": "#最後…嗯，要是{F#妳}{M#你}有興趣的話，也可以去旁邊的「告示板」那邊看看，喏，就在我旁邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490132
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490132,
					"content": "最近幾年的海燈節有許多外國遊客參加，我們總務司也專門為他們設置了「告示板」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490102
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490102,
					"content": "無論他們有什麼問題，或者是遇見了需要解決的麻煩，都可以寫下來掛在「告示板」上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490133
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490133,
					"content": "哼哼，我們總務司，絕對會讓所有來璃月過海燈節的人，都滿意而歸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490134,
						711490135
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490134,
					"content": "不愧是總務司。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490136
					]
				},
				{
					"id": 711490136,
					"content": "那是當然！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490137
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490137,
					"content": "#對了，{NICKNAME}，我記得{F#妳}{M#你}很擅長留影，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490138,
						711490139
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490138,
					"content": "略懂而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490140
					]
				},
				{
					"id": 711490140,
					"content": "#哈哈哈，別這麼謙虛嘛。我就是…想拜託{F#妳}{M#你}幫一個小小的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490141
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490141,
					"content": "#很簡單的，我保證！{F#妳}{M#你}只需要幫幾位遊客拍一張「紀念留影」就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490142
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490142,
					"content": "本來我們僱了幾位留影師，專門為大家拍「紀念留影」，但沒想到今年來了這麼多遊客，留影師一下子就不夠用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490143
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490143,
					"content": "#臨時僱新的留影師已經來不及了，所以，我就只能拜託{F#妳}{M#你}了，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490144
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490144,
					"content": "#拜託！為了各位遊客，為了海燈節，為了璃月！只有{F#妳}{M#你}能幫我們這個忙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490145,
						711490146
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490145,
					"content": "包在我身上！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490147
					]
				},
				{
					"id": 711490147,
					"content": "#哦！不愧是{NICKNAME}，我就把那幾位遊客的名字，還有預定的地點告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490148
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490148,
					"content": "#那就拜託{F#妳}{M#你}了，有{F#妳}{M#你}幫忙，今年的海燈節一定會完美無缺的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711490149
					],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490149,
					"content": "#這幾盞霄燈送給{F#妳}{M#你}，嘿嘿，海燈節快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍溪"
				},
				{
					"id": 711490146,
					"content": "為了海燈節！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490147
					]
				},
				{
					"id": 711490139,
					"content": "根本不懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490140
					]
				},
				{
					"id": 711490135,
					"content": "不愧是璃月…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490136
					]
				},
				{
					"id": 711490124,
					"content": "都比前一年更厲害…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490125
					]
				},
				{
					"id": 711490119,
					"content": "很吉利的服裝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711490120
					]
				}
			]
		}
	]
}