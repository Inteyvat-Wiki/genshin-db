			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220301,
					"content": "咦？有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220302
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220302,
					"content": "關於現在的情況…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220303
					]
				},
				{
					"id": 411220303,
					"content": "隕石的事，我們知道哦。不過…我們都還沒見過隕石落下來的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220304
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220304,
					"content": "小威說他知道個好位置看隕石，所以我們就來這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220305
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220305,
					"content": "在城裡也能看到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220306
					]
				},
				{
					"id": 411220306,
					"content": "可是在城裡的話，要去很高的地方才能看見吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220307
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220307,
					"content": "城裡的衛兵叔叔們肯定不會讓我們爬太高的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220308
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220308,
					"content": "旁邊的那位叔叔願意幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220309
					]
				},
				{
					"id": 411220309,
					"content": "#咦？{F#妳}{M#你}說旁邊那個奇怪的叔叔？可是他之前過來說話的時候，都好兇好兇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220310
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220310,
					"content": "也不說其他的，就是一直要我們回去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220311
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220311,
					"content": "不過，如果他能答應帶我們去很高的地方看隕石，那我覺得…回去也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220312
					],
					"speakerTitle": "小吉"
				},
				{
					"id": 411220312,
					"content": "#但還是請{F#妳}{M#你}和小威也說說吧，畢竟是他的主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小吉"
				}
			]
		},
		{
			"id": 4112204,
			"completionStepIds": [
				4112204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112204",
							"2"
						],
						"stepId": 4112204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小威"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220401,
					"content": "#咦？{F#妳}{M#你}好，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220402
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220402,
					"content": "關於現在的情況…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220403
					]
				},
				{
					"id": 411220403,
					"content": "我知道啊，我們就是出來看隕石的。只要看到了我們就回去了，不用擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220404
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220404,
					"content": "在城裡也能看到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220405
					]
				},
				{
					"id": 411220405,
					"content": "那得去個很高的地方才行啦，我試過了好幾次，都被衛兵給叫下來了，還被訓了一頓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220406
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220406,
					"content": "所以我才帶著小吉來這個地方啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220407
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220407,
					"content": "旁邊的衛兵叔叔可以幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220408
					]
				},
				{
					"id": 411220408,
					"content": "#幫忙？{F#妳}{M#你}是說，他能帶我們去城裡的高處看隕石嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220409
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220409,
					"content": "不可能吧…那個叔叔看著就很奇怪，還兇巴巴的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220410
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220410,
					"content": "我帶著命令書呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220411
					]
				},
				{
					"id": 411220411,
					"content": "真的？給我看看。哇…真的是騎士團的命令書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220412
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220412,
					"content": "有了這個命令書，那個叔叔就能帶我們去高處看隕石了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220413
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220413,
					"content": "嘿嘿，能在城裡看隕石，肯定是最好的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220414
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220414,
					"content": "#那{F#妳}{M#你}去和那個叔叔說一聲吧，我也和小吉說一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220415
					],
					"speakerTitle": "小威"
				},
				{
					"id": 411220415,
					"content": "哎呀，這麼一想…我還挺期待看到隕石落下來的場景呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小威"
