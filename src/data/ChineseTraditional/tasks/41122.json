			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"霍夫曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220101,
					"content": "唉，看來也沒什麼好辦法了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220102
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411220102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220103
					]
				},
				{
					"id": 411220103,
					"content": "#是{F#妳}{M#你}啊。是這樣…最近從天而降的隕石，{F#妳}{M#你}應該也看見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220104
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411220104,
					"content": "雖然城裡運氣好，一直沒有被降落的隕石波及到，但是城外已經很混亂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220105
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411220105,
					"content": "不少的人進城來避難，還有那些陷入莫名昏睡的人，城裡的事務就快要忙不過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220106
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411220106,
					"content": "我想把在外執行任務的西風騎士們都召回來，先把城裡的事物處理周全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220107
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411220107,
					"content": "但他們都分散在野外，騎士團現在也沒人手出去找他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220108
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 411220108,
					"content": "#{F#妳}{M#你}能幫我個忙，把這份命令書帶過去給他們看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220109
					],
					"speakerTitle": "霍夫曼"
				}
			]
		},
		{
			"id": 4112202,
			"completionStepIds": [
				4112202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112202",
							"2"
						],
						"stepId": 4112202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"麥克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220201,
					"content": "#{F#妳}{M#你}好，請問{F#妳}{M#你}找我有事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220202
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220202,
					"content": "這份命令書…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220203
					]
				},
				{
					"id": 411220203,
					"content": "命令書？還真是，我看看…要我回城裡協助處理各項事務…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220204
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220204,
					"content": "#哎呀，回城裡倒也沒問題，可是{F#妳}{M#你}看那兩個孩子，他們一直不願意回去城裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220205
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220205,
					"content": "也不知道他們家大人去哪了，我也不好把他們給強行帶回去，所以只能一直在這守著他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220206
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220206,
					"content": "現在這個情況，我要是回了城，這兩個孩子出事了可怎麼辦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220207
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220207,
					"content": "唉，我去說了好幾次，現在他們已經完全不聽我說話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220208
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220208,
					"content": "#呃，不然…{F#妳}{M#你}去幫我說說？說不定他們能聽{F#妳}{M#你}的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220209
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220209,
					"content": "要是能把他們說動了，讓他們乖乖回城去，那我也能安心回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220210
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220210,
					"content": "我去試試看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220211
					]
				},
				{
					"id": 411220211,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麥克"
				}
			]
		},
		{
			"id": 4112203,
			"completionStepIds": [
				4112203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
