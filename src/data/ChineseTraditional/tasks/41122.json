				"objectNames": [
					"麥克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411220501,
					"content": "#怎麼樣，{F#妳}{M#你}說服他們了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220502
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220502,
					"content": "感覺上像是說服了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220503
					]
				},
				{
					"id": 411220503,
					"content": "#那就好，說服了就好！實在是多虧{F#妳}{M#你}了，呃…等會，什麼叫「感覺上」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220504
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220504,
					"content": "只要你願意幫忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220505
					]
				},
				{
					"id": 411220505,
					"content": "幫忙？幫什麼忙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220506
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220506,
					"content": "啊？去蒙德城的最高處看隕石，那，那也有點危險吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220507
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220507,
					"content": "而且還是兩個孩子，這件事我還得去向騎士團打個報告…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220508
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220508,
					"content": "我可是有命令書喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220509
					]
				},
				{
					"id": 411220509,
					"content": "命令書壓根不是這麼個用法吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220510
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220510,
					"content": "算了，只要能讓那兩個孩子乖乖回城裡去，去高處的事…我來想辦法就是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220511
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220511,
					"content": "你真要帶他們…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220512
					]
				},
				{
					"id": 411220512,
					"content": "那當然，作為一名西風騎士，和一位，呃…成年人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220513
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220513,
					"content": "不管承諾的對象是誰，只要答應了的事情就要做到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220514
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220514,
					"content": "#這次就麻煩{F#妳}{M#你}了，剩下的事交給我吧，待會我就去帶他們回蒙德城。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220515
					],
					"speakerTitle": "麥克"
				},
				{
					"id": 411220515,
					"content": "然後…再想想怎麼把他們帶去蒙德城最高的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麥克"
				}
			]
		},
