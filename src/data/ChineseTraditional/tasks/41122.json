			"dialogs": [
				{
					"id": 411220601,
					"content": "#{F#妳}{M#你}好，有什麼需要幫忙的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220602
					],
					"speakerTitle": "哈利"
				},
				{
					"id": 411220602,
					"content": "這份命令書…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220603
					]
				},
				{
					"id": 411220603,
					"content": "命令書？我看看，哦…是要我回城裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220604
					],
					"speakerTitle": "哈利"
				},
				{
					"id": 411220604,
					"content": "抱歉，這份命令我得稍後再執行了，我還有更重要的事要做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220605
					],
					"speakerTitle": "哈利"
				},
				{
					"id": 411220605,
					"content": "似乎是因為隕石的關係，這附近的魔物也受到了影響，變得格外暴躁，也格外危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220606
					],
					"speakerTitle": "哈利"
				},
				{
					"id": 411220606,
					"content": "為了保障這附近地區的安全，我得去把這些魔物解決掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220607
					],
					"speakerTitle": "哈利"
				},
				{
					"id": 411220607,
					"content": "這裡跟本沒人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220608
					]
				},
				{
					"id": 411220608,
					"content": "正是因為這附近沒人，我才能放開手腳，把這群魔物徹底打倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220609
					],
					"speakerTitle": "哈利"
				},
				{
					"id": 411220609,
					"content": "這件事可是很重要的，不處理好的話，我可不能離開這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220610,
						411220611
					],
					"speakerTitle": "哈利"
				},
				{
					"id": 411220610,
					"content": "我來幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				},
				{
					"id": 411220612,
					"content": "那太好了，這片區域裡正好也有不止一個地方有魔物聚集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411220613
					],
					"speakerTitle": "哈利"
				},
				{
					"id": 411220613,
					"content": "我們分頭行事，各自去解決一個地方的魔物，處理好之後，再來這裡會合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "哈利"
				},
				{
					"id": 411220611,
					"content": "我和你一起處理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411220612
					]
				}
			]
		},
