			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"魈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020201,
					"content": "#是{F#妳}{M#你}們…我還記得{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020202
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020202,
					"content": "#我正在這一帶清理沾染了「妖邪」的生物，看來，是妨礙到{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020203
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020203,
					"content": "（咦，他的語氣是不是有點太客氣了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020204,
					"content": "你在這裡降妖除魔，怎麼能說是妨礙我們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020205,
					"content": "因為這些魔物的異變，也是由我而起——是沾染我的「業障」所致。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020206
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020206,
					"content": "異變、業障…啊，難道…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020207,
						111020208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020207,
					"content": "在《護法仙眾夜叉錄》裡提到過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				},
				{
					"id": 111020209,
					"content": "是呀，我好像還記得魈有著「護法夜叉」的稱呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020210,
					"content": "原來是這樣…嗚、嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020211,
					"content": "魈真是太可憐了哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020212,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020213,
						111020214
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020213,
					"content": "我們剛從書中瞭解了你的過去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020215,
					"content": "哦，是幾百年前那些墨客，無意義的閒言碎語嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020216
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020216,
					"content": "諸行無常，一切皆苦。夜叉的意志，從不與同情和淚水為伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020217
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020217,
					"content": "我那些已故的同僚，也不會喜歡後人如此評判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020218
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020218,
					"content": "唔，唔…真是不好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020219,
					"content": "無妨。我正要去清剿一處妖邪氣息濃厚的洞天，先就此別過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020220
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020220,
					"content": "帶、帶上我們一起去吧，我們一定可以幫上忙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020221,
					"content": "不必，我習慣獨來獨往，更何況這些異變也是以我為源頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020222
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020222,
					"content": "就當為我剛才的不禮貌賠罪！…可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020223,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020224
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020224,
					"content": "…跟上來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				},
				{
					"id": 111020214,
					"content": "我們剛讀過《護法仙眾夜叉錄》。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020215
					]
				},
				{
					"id": 111020208,
					"content": "魈就是「最後一位夜叉」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020209
					]
				}
			]
		},
		{
			"id": 1110204,
			"completionStepIds": [
				1110204
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110204",
							"2"
						],
						"stepId": 1110204,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020401,
					"content": "這裡邪惡的氣息讓人汗毛直立呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020402,
					"content": "我會用「靖妖儺舞」之儀，斷除此地的「業障」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020403
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020403,
					"content": "#{F#妳}{M#你}們要盡量平心靜氣，當心不要被魔神邪念所擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魈"
				}
			]
		},
		{
			"id": 1110206,
			"completionStepIds": [
				1110205
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1110205",
							"2"
						],
						"stepId": 1110205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 111020601,
					"content": "沾染「妖邪」的生物如此之多，實屬異常…若不是早來清剿，後果不堪設想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020602
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020602,
					"content": "#方才{F#妳}{M#你}們提到的「掇星攫辰天君」，是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020603
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020603,
					"content": "我來說給你聽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020604,
					"content": "那些人…居然會被「實現願望的仙人」這般誑語所騙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020605
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020605,
					"content": "那麼作為仙人的魈，會有實現願望的能力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020606,
					"content": "曾經的璃月，可不會對我們提出這種不勞而獲的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020607
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020607,
					"content": "數千年前璃月先民需要的，是可以守護這片棲身之地的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020608
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020608,
					"content": "可是對這個時代的人們來說，確實是實現願望的仙人更有吸引力吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020609,
					"content": "但，不論這個時代有多軟弱，都與我無關。我只會尊奉帝君最初的意旨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020610
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020610,
					"content": "派蒙好像又說錯話啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020611,
					"content": "啊…啊對了！那個假仙人身上可是帶著「百無禁忌籙」的，還用那個來驅魔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020612,
					"content": "有這種事？哼…蠢材。驅魔而不除魔，怪不得妖異都來此聚集。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020613
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020613,
					"content": "如此下去，恐怕會超出我掌控的範疇…必須從他手中回收「百無禁忌籙」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020614,
						111020615
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020614,
					"content": "只「回收」還不夠吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020616
					]
				},
				{
					"id": 111020616,
					"content": "不愧是我的好夥伴！派蒙也是這麼想的，一定要好好教訓那個騙了我們的傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020617,
					"content": "正巧我們這裡有位真正的仙人…如果魈出手的話，他一定再也不敢假冒仙人之名！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020618,
					"content": "不行。我只斬妖魔，不殺凡人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020619
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020619,
					"content": "沒有叫你殺他啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020620,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020621
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020621,
					"content": "若是能令他不再作奸為惡，確實對璃月有益。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020622
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020622,
					"content": "我有一法，曰「夢遊諸境法」，本應用於睡夢之中，使魂魄離體修行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020623
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020623,
					"content": "但也可動用此法，招來他人魂魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020624
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020624,
					"content": "哇，是真正的仙法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020625,
						111020626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020625,
					"content": "類似於「託夢」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						111020627
					]
				},
				{
					"id": 111020627,
					"content": "#此法需準備一番儀式。{F#妳}{M#你}們要去幫忙找來…一座香爐、七盞燈，還有一些能夠降溫之物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020628
					],
					"speakerTitle": "魈"
				},
				{
					"id": 111020628,
					"content": "降溫之物…冰霧花應該就可以？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						111020629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 111020629,
					"content": "可是香爐和七盞燈，好像不是隨地就能撿到的東西吧？",
					"roleType": "TALK_ROLE_NPC",
