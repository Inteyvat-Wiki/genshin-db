			"dialogs": [
				{
					"id": 220270401,
					"content": "還是供奉「三彩糰子」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270402
					]
				},
				{
					"id": 220270402,
					"content": "這樣嗎…好！我剛好帶著一個「三彩糰子」，這是媽媽做給我的，我一直捨不得吃呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270403
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270403,
					"content": "就…就供奉給神明大人吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270601
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270601,
					"content": "希望神明能保佑我，幫我實現願望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270602
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270602,
					"content": "#謝謝{F#妳}{M#你}陪我到現在，{F#大姐姐}{M#大哥哥}，這些東西給{F#妳}{M#你}，就當做是謝禮啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270603
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270603,
					"content": "明天我會再來這裡看看的，希望…神明大人會有些回覆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
