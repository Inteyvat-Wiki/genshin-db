				"objectNames": [
					"彌生七月"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270201,
					"content": "你們好，找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270202
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 220270202,
					"content": "那、那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270203
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270203,
					"content": "關於漆器的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270204
					]
				},
				{
					"id": 220270204,
					"content": "…想要向神龕供奉漆器，所以想要自己來做一個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270205
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 220270205,
					"content": "拜託了，七月姐姐，我有很想實現的願望！而且我…我一定不會把妳的秘方告訴別人的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270206
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270206,
					"content": "這不是塗料配方的問題。要製作出精美的漆器，除了塗料之外，還需要長年累月的練習。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270207
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 220270207,
					"content": "這不僅是時間問題，更是…財力問題。我家的漆器手藝傳到我這裡，已經是第四代了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270208
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 220270208,
					"content": "為了研究漆器，我甚至還去須彌遊學過。所以，你想要一下子學會製作漆器…實在是不太可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270209
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 220270209,
					"content": "是…是這樣嗎？可是，我也想不到去給神龕供奉什麼好東西了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270210
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270210,
					"content": "我覺得，向神龕供奉物品這種事，最重要的並不是物品的價值，而是這個物品所代表的「心意」才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270211
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 220270211,
					"content": "只要誠心誠意，供奉你最喜歡的東西，應該就能得到神明的回應了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270212
					],
					"speakerTitle": "彌生七月"
				},
				{
					"id": 220270212,
					"content": "誠心誠意…我最喜歡的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270213
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270213,
					"content": "唔，好像明白了…又好像不明白，但還是謝謝妳了，七月姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270214
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270214,
					"content": "#{F#大姐姐}{M#大哥哥}，我們先回神龕去吧，我還想請{F#妳}{M#你}幫我想一下，應該供奉什麼好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
		{
			"id": 2202703,
			"completionStepIds": [],
