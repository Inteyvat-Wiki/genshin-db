				"objectNames": [
					"翔太"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220270101,
					"content": "漆器…到底是怎麼做的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270102
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270102,
					"content": "你做漆器幹什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270103
					]
				},
				{
					"id": 220270103,
					"content": "#是{F#妳}{M#你}啊…{F#大姐姐}{M#大哥哥}，是這樣的，{F#妳}{M#你}聽說過神龕顯靈的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270104
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270104,
					"content": "我聽人家說，如果向神龕獻上珍貴的供品，也許就能實現自己的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270105
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270105,
					"content": "我想，漂亮的漆器特別值錢，用漆器來供奉神龕的話，肯定能得到回應吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270106
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270106,
					"content": "我沒錢買漆器，所以就想要自己做一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270107
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270107,
					"content": "我聽說，「彌生漆器」的七月姐姐很擅長做漆器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270108
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270108,
					"content": "#{F#大姐姐}{M#大哥哥}，{F#妳}{M#你}能陪我去找七月姐姐問一下漆器的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270109,
						220270111
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270109,
					"content": "沒問題，我們走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270110
					]
				},
				{
					"id": 220270110,
					"content": "#謝謝{F#大姐姐}{M#大哥哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270111,
					"content": "你怎麼不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220270112
					]
				},
				{
					"id": 220270112,
					"content": "七月姐姐她平時…很嚴肅的，我不太敢去向她請教…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220270113
					],
					"speakerTitle": "翔太"
				},
				{
					"id": 220270113,
					"content": "#有{F#大姐姐}{M#大哥哥}在旁邊的話，應該會好一些吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "翔太"
				}
			]
		},
		{
			"id": 2202702,
			"completionStepIds": [
				2202702
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
