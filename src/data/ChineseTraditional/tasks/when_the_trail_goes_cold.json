				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701430201,
					"content": "#{F#妳}{M#你}好，旅行者，最近的冒險行動還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430202
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 701430202,
					"content": "還算是順利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430203
					]
				},
				{
					"id": 701430203,
					"content": "#嗯，{F#妳}{M#你}的那些冒險事蹟我都聽說了，以這個勢頭繼續冒險的話，{F#妳}{M#你}肯定能成為一名優秀的冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430204
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 701430204,
					"content": "#然後…關於冒險行動，我這裡有一份「冒險情報」，不知道{F#妳}{M#你}有沒有興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430205
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 701430205,
					"content": "又有什麼新委託嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430206
					]
				},
				{
					"id": 701430206,
					"content": "#看來{F#妳}{M#你}對於協會裡的這些事務已經很熟練了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430207
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 701430207,
					"content": "不過，這次不是委託，而是一份「冒險情報」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430208
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 701430208,
					"content": "這份「冒險情報」，是關於蒙德旁邊那座「龍脊雪山」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430209
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 701430209,
					"content": "在那裡，協會已經設置好了營地，還駐紮了不少冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430210
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 701430210,
					"content": "#地點我幫{F#妳}{M#你}標註在地圖上了。到達那個營地之後，{F#妳}{M#你}可以先去找一位叫做「玉霞」的冒險家瞭解一下周圍的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430211
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 701430211,
					"content": "那麼，繼續冒險吧，向著星辰與深淵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				}
			]
		}
	]
