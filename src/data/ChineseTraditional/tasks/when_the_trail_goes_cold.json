				{
					"id": 701430101,
					"content": "關於進入雪山冒險…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701430102
					]
				},
				{
					"id": 701430102,
					"content": "#如果{F#妳}{M#你}真想去雪山裡冒險，那可要先做好萬全的準備再進山，絕不能掉以輕心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701430103
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701430103,
					"content": "對於粗心大意的冒險家，雪山可不會留任何情面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
		{
			"id": 7014302,
			"completionStepIds": [
				7014302
