					"優菈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745200401,
					"content": "#是{F#妳}{M#你}啊，{NICKNAME}，沒想到能在這種地方遇到{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200402,
						745200403
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 745200402,
					"content": "好久不見了，優菈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				},
				{
					"id": 745200404,
					"content": "算是例行巡視。不過，對我而言，更像是保持戰鬥狀態的必要活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200405
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 745200405,
					"content": "最近蒙德相對太平，值得游擊小隊全體出動的威脅幾乎沒有。隊裡的大家…精神上的確放鬆了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200406
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 745200406,
					"content": "適當休息也是好事嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200407
					]
				},
				{
					"id": 745200407,
					"content": "話雖如此，但我作為隊長，必須要時刻保持自己的戰鬥力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200408
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 745200408,
					"content": "畢竟，敵人的劍可不會因為和平而變得遲鈍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200409
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 745200409,
					"content": "所以，我習慣在巡視的間隙，找個僻靜的地方練習劍術，確保姿態不會生疏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200410,
						745200411
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 745200410,
					"content": "時機正好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200412,
					"content": "哦？倒是有趣的請求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200413
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 745200413,
					"content": "#不過，我的動作很快，{F#妳}{M#你}的留影機跟得上嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200414,
						745200415
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 745200414,
					"content": "按照妳平常的速度就好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200416,
					"content": "#好，既然{F#妳}{M#你}這麼有自信，那我也要全力以赴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745200417
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 745200417,
					"content": "看好了，浪花捲起的時刻可是轉瞬即逝的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "優菈"
				},
				{
					"id": 745200415,
					"content": "#我的鏡頭會盡力跟上{F#妳}{M#你}的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200416
					]
				},
				{
					"id": 745200411,
					"content": "請讓我為妳留影！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200412
					]
				},
				{
					"id": 745200403,
					"content": "妳是在這裡執勤嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745200404
					]
				}
			]
		}
	]
}