					"娜維婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 140180901,
					"content": "看來是我多慮了，我也要趕快振作起來，變得更加可靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180902
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140180902,
					"content": "回想起來，今天這副樣子真是有點丟臉，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180903,
						140180907,
						140180912
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140180903,
					"content": "關於眾人的禮物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180904
					]
				},
				{
					"id": 140180904,
					"content": "每個人應該都有對別人來說稀鬆平常，但自己無論如何都得不到的東西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180905
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140180905,
					"content": "對我來說，全家福就是這樣的東西，從小我就很羨慕別人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180906
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140180906,
					"content": "沒想到會以這樣的形式收到，看來有時候我也滿幸運的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140180907,
					"content": "關於克萊門汀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180908
					]
				},
				{
					"id": 140180908,
					"content": "我以前就在想，我母親希望我能開心地活下去，這其實也是個很高的期望…甚至不亞於我老爹施加給我的那些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180909
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140180909,
					"content": "這兩個人雖然表現出來的個性全然不同，但心底始終都認可彼此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180910
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140180910,
					"content": "巡軌船是造福整個楓丹的大工程，以「家族」的眼光去衡量與評價未免有點狹隘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180911
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140180911,
					"content": "所以她才沒有阻止我的老爹吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140180912,
					"content": "關於「我真的是妳的搭檔嗎？」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						140180913
					]
				},
				{
					"id": 140180913,
					"content": "#嗚哇，{F#妳}{M#你}學我做什麼！不要這樣，不要再說下去了！很難為情的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180914
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140180914,
					"content": "趕快忘掉，趕快忘掉！啊…不對，忘掉也不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						140180915
					],
					"speakerTitle": "娜維婭"
				},
				{
					"id": 140180915,
					"content": "總之，藏在心裡，不要再翻出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "娜維婭"
				}
			]
		}
	]
}