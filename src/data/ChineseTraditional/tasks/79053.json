	"talks": [
		{
			"id": 7905301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905301",
							"2"
						],
						"stepId": 7905301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊迪婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790530101,
					"content": "#「歡迎來到『琉形蜃境』，希望{F#妳}{M#你}們能夠在這裡稍微忘記旅途的疲憊，好好休息一番。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530102
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530102,
					"content": "本來應該在初次見面的時候說這種歡迎詞的，唉，沒想到居然發生了那麼多事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530103
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530103,
					"content": "#既然一切恢復了，那就為{F#妳}{M#你}補上這句開場…怎麼樣，聽起來還是滿正經的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530104,
						790530109,
						790530114,
						790530117
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530104,
					"content": "關於先成圖…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530105
					]
				},
				{
					"id": 790530105,
					"content": "欸，是要我解釋原理嗎，其實原理我也沒有那麼清楚啦。總之，先成圖更像是一種想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530106
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530106,
					"content": "就像植物如何生長其實早就寫入種子之中，就像鳥的翅膀如何展開早在卵中也已註定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530107
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530107,
					"content": "事物符合道理地變成現在目及的一切，而在最開始的開始或許已經奠定了萬物的藍圖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530108
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530108,
					"content": "先成圖就是那份藍圖，然後由瓶中的折光照射，進而變成了整個琉形蜃境。啊，只不過這是只能在這支魔瓶裡才能實現的招數。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530109,
					"content": "關於純水精靈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530110
					]
				},
				{
					"id": 790530110,
					"content": "#啊，{F#妳}{M#你}是說為什麼從楓丹逃離的事嗎？回想起來就像是上輩子的事一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530111
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530111,
					"content": "要說逃出來的理由的話，是因為「水」，楓丹的水變了，對於純水精靈來說，那裡的水現在充滿了…痛苦與仇恨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530112
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530112,
					"content": "對我們來說，如果要活下去，最好從故土逃離。啊，就是在那個時候慌不擇路，倒在了沙漠裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530113
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530113,
					"content": "要我說，這片沙漠也太大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530114,
					"content": "關於洛蒂婭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530115
					]
				},
				{
					"id": 790530115,
					"content": "#哦，{F#妳}{M#你}是說洛蒂婭姐姐嗎，咦，{F#妳}{M#你}見過她嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790530116
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530116,
					"content": "看來她也找到了屬於自己的棲身之所…輕策莊，在璃月嗎？那還真是，離開到了很遠的地方啊，洛蒂婭姐姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790530117,
					"content": "要好好加油哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790530118
					]
				},
				{
					"id": 790530118,
					"content": "#嗯，我會…我會努力的！也請{F#妳}{M#你}好好享受這裡濕潤的環境吧，在沙漠裡有這樣的地方還滿難得的呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪婭"
				}
			]
		},
		{
			"id": 7905313,
			"completionStepIds": [
				7905302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905302",
							"2"
						],
						"stepId": 7905302,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"120310",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊迪婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531301,
					"content": "伊迪婭小姐，緊急情況，重大事件！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531302,
					"content": "我們找到了一塊懷錶！妳快看看，這是不是傳說中的摩拉懷錶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531303,
						790531304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531303,
					"content": "外表確實金光閃閃的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				},
				{
					"id": 790531305,
					"content": "哦？我來看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531306
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531306,
					"content": "#居然、居然真的被{F#妳}{M#你}們找到了！難道說，一切都有冥冥之中的旨意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531307
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531307,
					"content": "神奇的冒險家留下了終極的彩蛋，結果被傳奇的旅行者找到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531308
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531308,
					"content": "我好像在這之中感受到了某種…精神的傳承！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531309
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531309,
					"content": "妳這麼誇獎我們，我倒是很高興啦，不過現在我更好奇，找到懷錶後會發生什麼事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531310,
						790531311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531310,
					"content": "會有額外的獎勵嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531312,
					"content": "都…都沒有哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531313
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531313,
					"content": "其實我完全沒考慮過，會有人找到這個懷錶…畢竟我自己都忘了它埋在哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531314
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531314,
					"content": "#但它本身就很有價值，對不對！不需要我這邊再給{F#妳}{M#你}們額外的獎勵了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531315
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531315,
					"content": "總之，我要把這件事記錄下來，適當添加筆墨，描寫成激動人心的故事，繪聲繪色地向之後的客人描述。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531316
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531316,
					"content": "#接下來，{F#妳}{M#你}們埋藏的寶藏，就要完全取代這塊摩拉懷錶的地位了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531317
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531317,
					"content": "說的也是，一開始我們就聊到過，重點在於寶藏中蘊藏的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531318,
					"content": "#總之，我們再研究一下這塊懷錶吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531319,
					"content": "伊迪婭小姐，拜託妳把我們的故事寫得精彩一點了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531320,
					"content": "放心吧放心吧，包在我身上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531311,
					"content": "會觸發隱藏事件嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531312
					]
				},
				{
					"id": 790531304,
					"content": "外殼畫著摩拉花紋！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531305
					]
				}
			]
		},
		{
			"id": 7905314,
			"completionStepIds": [
				7905304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7905304",
							"2"
						],
						"stepId": 7905304,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_PACK_HAVE_ITEM",
						"rawParams": [
							"120462",
							"1"
						]
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"1",
							"0",
							"79053"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊迪婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790531401,
					"content": "#啊，是{F#妳}{M#你}們兩位呀，怎麼了，看起來有什麼疑惑的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531402
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531402,
					"content": "不過如果有什麼關於「琉形蜃境」的事要問，那問我就問對人啦，對我來說，「琉形蜃境」就跟我手掌上的水紋一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531403,
						790531405
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531403,
					"content": "水、水形皺紋？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531404
					]
				},
				{
					"id": 790531404,
					"content": "那只是一種比喻啦！我才不會長皺紋呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531407
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531407,
					"content": "總之，事情是這樣的！我們在樂園裡撿到了這樣一張信紙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531408,
					"content": "伊迪婭一定知道這是怎麼來的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531409,
					"content": "那當然，這封信一看就是…咦，還是第一次看到這樣的信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531410
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531410,
					"content": "手掌上的水紋看起來很模糊的樣子呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531411,
					"content": "這、這顯然是趁我不注意的時候，有人悄悄埋下的，第一次看到也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531412
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531412,
					"content": "而且，從內容上看，比起一封信，更像是留下的遺書和紀錄，到底是誰呢，信上這個說話的語調，總覺得有點熟悉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531413
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531413,
					"content": "看起來和「蜃樓玉匣」有關？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531414
					]
				},
				{
					"id": 790531414,
					"content": "啊！這麼一說我想起來了，這是把「蜃樓玉匣」帶進來的那個老人留下來的…那還是，那還是我來瓶子裡沒多久的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531415
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531415,
					"content": "老人是位稻妻人，一進來就問，這裡是不是能夠達成別人願望的秘境，要我把他送回從前的戰場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531416
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531416,
					"content": "我設法向他解釋，但是…他進入秘境的時候身體狀況十分糟糕，看得出來由於長途跋涉，精神也到了有些油盡燈枯的程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531417
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531417,
					"content": "一股腦地說著「求妳了，把我送回那一天…」或者「把我送回那場戰爭中吧…」這種話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531418
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531418,
					"content": "所以我就用瓶中的蜃境…仿造了他想像中的戰場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531419
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531419,
					"content": "啊，所以信裡的「終於回到此處」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790531420,
					"content": "大概是恍惚間醒來，發現周圍的蜃境與化作記憶中戰場類似的樣子了吧。戰場還滿可怕的，但是他卻笑得很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531421
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531421,
					"content": "怎麼會有人在生命的最後想看到那樣可怕的場景呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531422,
						790531423
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531422,
					"content": "或許對他有不同的意義…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531424
					]
				},
				{
					"id": 790531424,
					"content": "這我就不是很清楚啦，不過他最後看起來也很滿足的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531425
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531425,
					"content": "如果有一定要在那種場景裡達成的願望，背負那個願望的歲月裡，一定也很辛苦吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531426
					],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531426,
					"content": "在讓核心輪縠重新轉起來的時候，「蜃樓玉匣」也幫了不少忙，這麼一說，還得謝謝這位秀家先生呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊迪婭"
				},
				{
					"id": 790531423,
					"content": "或許這樣比較刺激吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531424
					]
				},
				{
					"id": 790531405,
					"content": "真的嗎，讓我看看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790531406
					]
				},
				{
					"id": 790531406,
					"content": "#只、只是一種比喻啦，就跟{F#妳}{M#你}的掌紋一樣，沒什麼好看的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790531407
					],
					"speakerTitle": "伊迪婭"
				}
			]
		}
	]
}