			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290401,
					"content": "#{F#妳}{M#你}拿到禮物了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290402,
						200290406,
						200290409,
						200290412
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290402,
					"content": "你回去之後會做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290403
					]
				},
				{
					"id": 200290403,
					"content": "做什麼？那…肯定是聽上頭的調遣唄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290404
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290404,
					"content": "唉，如果運氣不好，說不定又要被丟到什麼鬼地方待著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290405
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290405,
					"content": "無論如何，別把我丟去稻妻就行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290406,
					"content": "你為什麼突然被調走了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290407
					]
				},
				{
					"id": 200290407,
					"content": "還能是因為什麼，當然是因為「女士」大人…那個…犧牲了唄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290408
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290408,
					"content": "哎呀，我這種級別的人，聽上頭的命令行事就行了，想那麼多幹啥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290409,
					"content": "莉莉去哪了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290410
					]
				},
				{
					"id": 200290410,
					"content": "我聽魯道夫和她說，要帶她去廣場上玩，還是什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290411
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290411,
					"content": "哼，估計是不想讓莉莉和我這個「愚人眾壞叔叔」說話吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290412,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290413
					]
				},
