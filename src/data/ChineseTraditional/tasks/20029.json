						200290712
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290711,
					"content": "你還寫信給莉莉了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290713,
					"content": "#沒什麼，都是一些廢話，{F#妳}{M#你}就別管了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290714
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290714,
					"content": "#行了，這禮物給{F#妳}{M#你}，幫我轉交給莉莉吧，她應該就在<color=#00E1FFFF>廣場附近</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290715
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290715,
					"content": "哼，要是我直接去把禮物送給莉莉，魯道夫估計又要瞪我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290712,
					"content": "信裡寫什麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290713
					]
				},
				{
					"id": 200290708,
					"content": "那你從至冬買禮物寄回來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290709
					]
				},
				{
					"id": 200290709,
					"content": "我倒是想啊。但是我這個愚人眾要是寄東西到蒙德城，估計騎士團的那幫人會直接把包裹給攔下來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290710
					],
					"speakerTitle": "維克多"
				}
			]
