			"dialogs": [
				{
					"id": 200292801,
					"content": "呼…總算能回去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292802
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200292802,
					"content": "你要回國了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200292803
					]
				},
				{
					"id": 200292803,
					"content": "#啊？是{F#妳}{M#你}啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292804
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200292804,
					"content": "沒錯，我最近才剛接到上頭的命令，要我回至冬去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292805
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200292805,
					"content": "說是什麼…我被調去另外一個執行官大人手下，暫時不用在蒙德這邊待命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200292806
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200292806,
					"content": "也不知道我到底被調去哪位執行官大人手下了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290107,
					"content": "你大概什麼時候離開？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "上頭沒說，只要我先把東西收拾好，到時候盡快出發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290109,
					"content": "哎呀，總算是能離開這破地方，不用天天吃修女的白眼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290110,
					"content": "#哦對了，旅行者，{F#妳}{M#你}看我們倆也合作了這麼長時間了，{F#妳}{M#你}最後再幫我個忙唄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290111,
					"content": "#和之前一樣，{F#妳}{M#你}幫我忙，我付{F#妳}{M#你}報酬，絕對不讓{F#妳}{M#你}白跑，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290112,
					"content": "你又要講什麼故事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "#哈哈哈，我這裡能告訴{F#妳}{M#你}的「愚人眾故事」已經全部講完啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290115,
					"content": "#這次{F#妳}{M#你}幫我忙，我絕對付{F#妳}{M#你}真金白銀的報酬，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290116,
					"content": "#除非，{F#妳}{M#你}想聽我給莉莉講的那些童話故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290117,
					"content": "你要我幫什麼忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "#嗯…其實我這次想請{F#妳}{M#你}幫的忙，也和莉莉有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290121,
					"content": "#除了{F#妳}{M#你}之外，整個蒙德城裡願意聽我這個「愚人眾壞叔叔」說話的，大概也就只有莉莉這孩子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290122,
					"content": "我要是走了，估計以後也不可能有機會再回蒙德城了…我就想最後送點禮物給莉莉做留念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290123,
					"content": "#但{F#妳}{M#你}也知道，我要是自己上街買東西，不知道要吃多少白眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290124,
					"content": "#所以，這件事就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290125,
					"content": "#{F#妳}{M#你}就去瑪喬麗那邊，幫我看看有什麼適合送給小孩子的禮物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290118,
					"content": "你還在陪莉莉玩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "我就是偶爾…偶爾陪她玩玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290113,
					"content": "你這裡，愚人眾的故事真是特別多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		}
	]
