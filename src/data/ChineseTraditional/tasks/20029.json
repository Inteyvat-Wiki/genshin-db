			"dialogs": [
				{
					"id": 200290501,
					"content": "#謝、謝謝{F#妳}{M#你}，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290502
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 200290502,
					"content": "這群魔物怎麼追得這麼緊，我都跑到這裡了它們還不放過我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290503
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 200290503,
					"content": "你是來採鉤鉤果的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290504
					]
				},
				{
					"id": 200290504,
					"content": "欸？是的，這是瑪喬麗小姐的委託…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290505,
						200290507
					],
					"speakerTitle": "害怕的舒特"
				},
				{
