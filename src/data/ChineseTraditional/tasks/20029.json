						200290605
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200290605,
					"content": "#對了，{F#妳}{M#你}是想要一個適合送給小孩子的禮物對吧？請稍等一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290606
					],
					"speakerTitle": "瑪喬麗"
