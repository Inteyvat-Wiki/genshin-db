					"維克多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290101,
					"content": "呼…總算能回去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290102
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290102,
					"content": "你要回國了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290103
					]
				},
				{
					"id": 200290103,
					"content": "#啊？是{F#妳}{M#你}啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290104
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290104,
					"content": "沒錯，我最近才剛接到上頭的命令，讓我回至冬去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290105
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290105,
					"content": "說是什麼…我被調去另外一個執行官大人手下，暫時不用在蒙德這邊待命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290106
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290106,
					"content": "也不知道我到底被調去哪位執行官大人手下了，可千萬別是「散兵」啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290107
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290107,
					"content": "你大概什麼時候離開？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290108
					]
				},
				{
					"id": 200290108,
					"content": "上頭沒說，只要我先把東西收拾好，到時候盡快出發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290109
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290109,
					"content": "哎呀，總算是能離開這破地方，不用天天吃修女的白眼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290110
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290110,
					"content": "#哦對了，旅行者，{F#妳}{M#你}看我們倆也合作了這麼長時間了，{F#妳}{M#你}最後再幫我個忙唄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290111
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290111,
					"content": "#和之前一樣，{F#妳}{M#你}幫我忙，我付{F#妳}{M#你}報酬，絕對不讓{F#妳}{M#你}白跑，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290112,
						200290113
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290112,
					"content": "你又要講什麼故事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				},
				{
					"id": 200290114,
					"content": "#哈哈哈，我這裡能告訴{F#妳}{M#你}的「愚人眾故事」已經全部講完啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290115
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290115,
					"content": "#這次{F#妳}{M#你}幫我忙，我絕對付{F#妳}{M#你}真金白銀的報酬，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290116
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290116,
					"content": "#除非，{F#妳}{M#你}想聽我給莉莉講的那些童話故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290117,
						200290118
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290117,
					"content": "你要我幫什麼忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290120
					]
				},
				{
					"id": 200290120,
					"content": "#嗯…其實我這次想請{F#妳}{M#你}幫的忙，也和莉莉有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290121
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290121,
					"content": "#除了{F#妳}{M#你}之外，整個蒙德城裡願意聽我這個「愚人眾壞叔叔」說話的，大概也就只有莉莉這孩子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290122
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290122,
					"content": "我要是走了，估計以後也不可能有機會再回蒙德城了…我就想最後送點禮物給莉莉做留念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290123
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290123,
					"content": "#但{F#妳}{M#你}也知道，我要是自己上街買東西，不知道要吃多少白眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290124
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290124,
					"content": "#所以，這件事就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290125
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290125,
					"content": "#{F#妳}{M#你}就去瑪喬麗那邊，幫我看看有什麼適合送給小孩子的禮物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290118,
					"content": "你還在陪莉莉玩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290119
					]
				},
				{
					"id": 200290119,
					"content": "我就是偶爾…偶爾陪她玩玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290120
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290113,
					"content": "你這裡，愚人眾的故事真是特別多…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290114
					]
				}
			]
		},
		{
			"id": 2002902,
			"completionStepIds": [
				2002902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2002902",
							"2"
						],
						"stepId": 2002902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"瑪喬麗"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200290201,
					"content": "#{F#妳}{M#你}好，有什麼事嗎？旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290202
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200290202,
					"content": "關於適合送給小朋友的禮物…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290203
					]
				},
				{
					"id": 200290203,
					"content": "送給小朋友的禮物…我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290204
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200290204,
					"content": "嗯…這麼一說，我最近確實在試著做一些小玩具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290205
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200290205,
					"content": "但做這些玩具的時候，需要用很多鉤鉤果來染色，但我手裡的鉤鉤果都用完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290206
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200290206,
					"content": "雖然我已經拜託了舒特去野外採一些鉤鉤果，但他到現在也沒有回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290207
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200290207,
					"content": "#旅行者，{F#妳}{M#你}能幫我去野外找找舒特嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290208
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200290208,
					"content": "有了足夠的鉤鉤果之後，我應該就可以把那些玩具做出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290209,
						200290210
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200290209,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				},
				{
					"id": 200290211,
					"content": "#舒特說，他要去<color=#00E1FFFF>奔狼領附近</color>採鉤鉤果，{F#妳}{M#你}可以去那邊找找他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290212
					],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200290212,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪喬麗"
				},
				{
					"id": 200290210,
					"content": "舒特去哪裡了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200290211
					]
				}
			]
		},
		{
			"id": 2002904,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
