					"nextDialogs": [
						200290705
					],
					"speakerTitle": "維克多"
				},
				{
					"id": 200290705,
					"content": "這歪歪扭扭的娃娃，還染著這種莫名其妙的顏色…不過這氣味倒是不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200290706
					],
					"speakerTitle": "維克多"
				},
