						],
						"pointId": 9402
					}
				]
			},
			"dialogs": [
				{
					"id": 706813101,
					"content": "#呼…總算得救了，謝謝{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813102
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813102,
					"content": "#我叫格茜妮，如{F#妳}{M#你}們所見，是一位冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813103
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813103,
					"content": "#{F#妳}{M#你}們身手這麼了得，一定不是普通人吧！難道是好心的騎士？或者是雲遊四方的遊俠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813104,
						706813105
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813104,
					"content": "我是路過的旅行者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813109
					]
				},
				{
					"id": 706813109,
					"content": "#我叫派蒙，{M#他}{F#她}是{NICKNAME}。其實{M#他}{F#她}也是冒險家協會的成員哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706813110,
					"content": "#原來是冒險家前輩！真是人外有人啊，這麼難纏的魔物，{F#妳}{M#你}們一下子就解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813111
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813111,
					"content": "不像我，訓練的時候明明動作都記住了，結果到了實戰，手腳就不聽使喚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813112
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813112,
					"content": "就像老師說的那樣，我還得再鍛煉個三五年嗎？但是就這樣空手回去也太丟臉了吧…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813113
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813113,
					"content": "唉呀，我覺得只是經驗的差距啦。我們也是經歷了很多場實戰才能游刃有餘的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813114,
						706813118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706813114,
					"content": "首先要保持冷靜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813115
					]
				},
				{
					"id": 706813115,
					"content": "對啊，新手在實戰時都很容易慌慌張張的，原本的實力都發揮不出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706813116,
					"content": "就算敵人看起來很強，也要冷靜觀察找到他們的弱點哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706813117,
					"content": "這樣就能咚咚咚地解決戰鬥了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706813120,
					"content": "原來是這樣…不愧是經驗豐富的前輩！看來我還得邊旅行邊磨練自己的本領…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813121
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813121,
					"content": "妳也正在旅行中嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813122
					]
				},
				{
					"id": 706813122,
					"content": "是的…我準備去<color=#00E1FFFF>璃月</color>看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813123
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813123,
					"content": "#{F#妳}{M#你}們有聽說過璃月的武學嗎？據說能讓人飛簷走壁、刀槍不入、削鐵如泥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813124
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813124,
					"content": "要是能夠向高人討教，學到一二，以後的冒險就輕鬆不少了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813125
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813125,
					"content": "但說實話，雖然加入冒險家協會有一段時間了，我還是第一次出遠門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813126
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813126,
					"content": "唉…剛出城沒多久就被魔物攔住，我真的可以順利走到璃月嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813127,
						706813128
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813127,
					"content": "我們去過璃月。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813129
					]
				},
				{
					"id": 706813129,
					"content": "嗚哇，被厲害的前輩關照了，我的旅途充滿了希望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813130
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813130,
					"content": "不過，前輩想必很忙碌吧…還要花時間照顧我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813131,
						706813132
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813131,
					"content": "見義勇為是我的日常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813133
					]
				},
				{
					"id": 706813133,
					"content": "#那我就叨擾{F#妳}{M#你}們一段時間了！我在出發之前仔細研究了地圖，我會盡量不拖後腿的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813132,
					"content": "幫助後輩也是正經事！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813133
					]
				},
				{
					"id": 706813128,
					"content": "可以帶妳一程。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813129
					]
				},
				{
					"id": 706813118,
					"content": "判斷形勢也很重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813119
					]
				},
				{
					"id": 706813119,
					"content": "對啊，如果判斷敵人的實力在自己之上，還是及時撤離比較好哦！戀戰是很危險的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706813105,
					"content": "我的身分不方便透露。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813106
					]
				},
				{
					"id": 706813106,
					"content": "#我明白的！{F#妳}{M#你}一定是身負秘密使命，只能低調行事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813107
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706813107,
					"content": "差不多就是這樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706813108
					]
				},
				{
					"id": 706813108,
					"content": "#好啦，{F#妳}{M#你}就不要賣關子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706813109
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
