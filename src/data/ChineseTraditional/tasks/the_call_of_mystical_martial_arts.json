							-142.334
						],
						"pointId": 9404
					}
				]
			},
			"dialogs": [
				{
					"id": 706810401,
					"content": "前輩！不好意思，可以在這裡稍等一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810402
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810402,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810403
					]
				},
				{
					"id": 706810403,
					"content": "難道忘記帶什麼東西了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810404,
					"content": "也不是，只是我看地圖，再往前走就要離開蒙德了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810405
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810405,
					"content": "下次回來也不知道是什麼時候…老師看到我留的信，說不定會大發雷霆吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810406,
						706810407
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810406,
					"content": "之前就聽妳提過老師…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				},
				{
					"id": 706810408,
					"content": "沒錯…他剛成為冒險家的時候在野外遇到了丘丘暴徒，結果在周旋的時候不小心被一把斧子砸暈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810409
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810409,
					"content": "好在路過的騎士把他救了回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810410
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810410,
					"content": "他覺得很沒面子，就決定在城裡將武藝鍛煉到極致再外出冒險，結果這一鍛煉就是十年…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810411
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810411,
					"content": "老師總說基礎是最重要的，可是我真的受不了每天砍木樁了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810412
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810412,
					"content": "所以我就瞞著老師一個人出門旅行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810413,
						706810414
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810413,
					"content": "等變強了再回去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810415,
					"content": "嗯！我也是這樣想的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810416
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810416,
					"content": "啊，我想到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810417
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810417,
					"content": "格茜妮翻出背包裡的蒲公英籽放在手掌上，對著它說了些什麼，然後讓種子隨風飄散…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810418
					]
				},
				{
					"id": 706810418,
					"content": "在我們的習俗裡，蒲公英能夠承載願望哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810419
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810419,
					"content": "我剛才許了願，希望這一路能夠順利實現目標，也希望老師可以理解我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810420
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810420,
					"content": "風神一定聽到妳的願望了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810421
					]
				},
				{
					"id": 706810421,
					"content": "嗯！那我們繼續前進吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810414,
					"content": "做出能夠讓他認可的成就吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810415
					]
				},
				{
					"id": 706810407,
					"content": "他也是冒險家嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810408
					]
				}
			]
