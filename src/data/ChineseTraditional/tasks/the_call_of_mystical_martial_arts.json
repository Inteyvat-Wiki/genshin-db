			},
			"dialogs": [
				{
					"id": 706810301,
					"content": "#呼…總算得救了，謝謝{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810302
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810302,
					"content": "#我叫格茜妮，如{F#妳}{M#你}們所見，是一位冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810303
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810303,
					"content": "#{F#妳}{M#你}們身手這麼了得，一定不是普通人吧！難道是好心的騎士？或者是雲遊四方的遊俠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810304,
						706810305
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810304,
					"content": "我是路過的旅行者。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810309
					]
				},
				{
					"id": 706810309,
					"content": "#我叫派蒙，{M#他}{F#她}是{NICKNAME}。其實{M#他}{F#她}也是冒險家協會的成員哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810310,
					"content": "#原來是冒險家前輩！真是人外有人啊，這麼難纏的魔物，{F#妳}{M#你}們一下子就解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810311
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810311,
					"content": "不像我，訓練的時候明明動作都記住了，結果到了實戰，手腳就不聽使喚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810312
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810312,
					"content": "就像老師說的那樣，我還得再鍛煉個三五年嗎？但是就這樣空手回去也太丟臉了吧…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810313
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810313,
					"content": "唉呀，我覺得只是經驗的差距啦。我們也是經歷了很多場實戰才能游刃有餘的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810314,
						706810318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810314,
					"content": "首先要保持冷靜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810315
					]
				},
				{
					"id": 706810315,
					"content": "對啊，新手在實戰時都很容易慌慌張張的，原本的實力都發揮不出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810316,
					"content": "就算敵人看起來很強，也要冷靜觀察找到他們的弱點哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810317,
					"content": "這樣就能咚咚咚地解決戰鬥了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810320,
					"content": "原來是這樣…不愧是經驗豐富的前輩！看來我還得邊旅行邊磨練自己的本領…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810321
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810321,
					"content": "妳也正在旅行中嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810322
					]
				},
				{
					"id": 706810322,
					"content": "是的…我準備去<color=#00E1FFFF>璃月</color>看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810323
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810323,
					"content": "#{F#妳}{M#你}們有聽說過璃月的武學嗎？據說能讓人飛簷走壁、刀槍不入、削鐵如泥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810324
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810324,
					"content": "要是能夠向高人討教，學到一二，以後的冒險就輕鬆不少了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810325
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810325,
					"content": "但說實話，雖然加入冒險家協會有一段時間了，我還是第一次出遠門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810326
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810326,
					"content": "唉…剛出城沒多久就被魔物攔住，我真的可以順利走到璃月嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810327,
						706810328
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810327,
					"content": "我們也打算去璃月。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810329,
					"content": "真的嗎？難道前輩也打算尋訪世外高人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810330
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810330,
					"content": "這倒不是啦。因為某些原因，我們正在各國旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810331,
					"content": "雖然對璃月還不是很瞭解，但是遲早也是要去看看的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810332,
					"content": "既然剛好順路，一起過去也有個照應嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810333,
					"content": "哇，居然可以跟厲害的前輩一起行動…我的旅途充滿了希望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810334
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810334,
					"content": "那讓我來帶路吧。我在出發之前仔細研究了地圖，絕對不會迷路的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810328,
					"content": "要加入我們的隊伍嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810329
					]
				},
				{
					"id": 706810318,
					"content": "判斷形勢也很重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810319
					]
				},
				{
					"id": 706810319,
					"content": "對啊，如果判斷敵人的實力在自己之上，還是及時撤離比較好哦！戀戰是很危險的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810305,
					"content": "我的身分不方便透露…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810306
					]
				},
				{
					"id": 706810306,
					"content": "#我明白的！{F#妳}{M#你}一定是身負秘密使命，只能低調行事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810307
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810307,
					"content": "差不多就是這樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810308
					]
				},
				{
					"id": 706810308,
					"content": "#好啦，{F#妳}{M#你}就不要賣關子了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810309
					],
					"speakerTitle": "派蒙"
				}
			]
		},
