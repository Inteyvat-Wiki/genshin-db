						706810807
					]
				},
				{
					"id": 706810806,
					"content": "旅途的疲憊消除了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810807
					]
				},
				{
					"id": 706810807,
					"content": "#前輩一路辛苦了，要是沒有{F#妳}{M#你}們，我一定沒辦法這麼輕鬆地來到這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810808
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810808,
					"content": "剛才聽客棧的人說，再往前走就是<color=#00E1FFFF>璃月港</color>了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810809
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810809,
					"content": "我打算在這裡休息幾天，跟其他旅客打聽一下，怎麼樣才能找到世外高人，然後再決定之後要去哪裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810810
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810810,
					"content": "#雖然跟前輩旅行真的很開心，但是不能繼續耽誤{F#妳}{M#你}們的時間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810811
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810811,
					"content": "接下來我會努力變強，成為像前輩一樣可靠的冒險家的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810812
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810812,
					"content": "嘿嘿，雖然相處時間不長，但是我們也很開心哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810813,
					"content": "希望以後還可以在別的地方相遇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810814,
						706810815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810814,
					"content": "那我們有緣再見啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810815,
					"content": "希望妳能如願以償！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706810816
					]
				},
				{
					"id": 706810816,
					"content": "#嗯嗯！前輩也是，祝{F#妳}{M#你}們旅途順利哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810817
					],
					"speakerTitle": "格茜妮"
				},
				{
					"id": 706810817,
					"content": "#格茜妮向{F#妳}{M#你}們揮手道別。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706810818
					]
				},
				{
					"id": 706810818,
					"content": "既然來到這裡了，我們也在附近逛逛吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706810819,
					"content": "說不定會有什麼奇遇哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706810820
					],
					"speakerTitle": "派蒙"
				},
				{
