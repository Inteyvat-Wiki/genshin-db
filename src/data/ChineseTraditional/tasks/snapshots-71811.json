			},
			"dialogs": [
				{
					"id": 718110412,
					"content": "關於「留影機」的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110401
					]
				},
				{
					"id": 718110401,
					"content": "#{F#妳}{M#你}把東西都送到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110402
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110402,
					"content": "都送到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110403
					]
				},
				{
					"id": 718110403,
					"content": "謝謝謝謝，真是勞煩您了，我真是要忙暈頭了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110404
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110404,
					"content": "哦對了，這架「留影機」送給您，謝謝您幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110405,
						718110406
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110405,
					"content": "這怎麼好意思…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				},
				{
					"id": 718110407,
					"content": "沒事，沒事，您不是給我們幫了忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110408
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110408,
					"content": "這也不是什麼貴重的東西，是我們去進貨的時候，楓丹那邊給我們的試用品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110409
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110409,
					"content": "雖然和正式的還是有點區別…但基本功能都有，您隨便玩玩肯定是夠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110410
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110410,
					"content": "然後…您要是覺得用起來不錯，也幫我們四處宣傳宣傳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110411
					],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110411,
					"content": "咳…總之謝謝您幫忙！這「留影機」您收好，收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿旭"
				},
				{
					"id": 718110406,
					"content": "這東西不便宜吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110407
					]
				}
			]
		},
