					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110605
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 718110605,
					"content": "#這還真不錯，謝謝{F#妳}{M#你}專門跑一趟。",
