			"dialogs": [
				{
					"id": 718110501,
					"content": "#嗯？{F#妳}{M#你}找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110502
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 718110502,
					"content": "關於「留影機」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718110503
					]
				},
				{
					"id": 718110503,
					"content": "「留影機」…哦，前幾天我是去飛雲商會，拜託他們過來給我留個影的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718110504
					],
					"speakerTitle": "阿山婆"
				},
				{
					"id": 718110504,
					"content": "#{F#妳}{M#你}是特地來把印出來的畫送過來的嗎？真是謝謝{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿山婆"
				}
