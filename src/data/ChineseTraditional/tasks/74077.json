					"nextDialogs": [
						740772103
					]
				},
				{
					"id": 740772103,
					"content": "說實話，沒有想那麼多。感覺我已經無處可去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772104
					],
					"speakerTitle": "安"
				},
				{
					"id": 740772104,
					"content": "知道真相之後，我再也回不到小高麗菜和阿爾身邊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772105
					],
					"speakerTitle": "安"
				},
				{
					"id": 740772105,
					"content": "我應該去哪裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740772106
					],
					"speakerTitle": "安"
				},
				{
					"id": 740772106,
					"content": "算了，以後的事情以後再想吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安"
				}
