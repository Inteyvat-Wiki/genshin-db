			},
			"dialogs": [
				{
					"id": 740771201,
					"content": "#{NICKNAME}，為什麼人們都喜歡沉浸在夢裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771202,
					"content": "那個「瑪麗安」編織著大家環繞的夢境，納齊森科魯茲活在拯救世界的夢想裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771203,
					"content": "明天的事情都是我在操心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740771204
					]
				},
				{
					"id": 740771204,
					"content": "…派蒙不理解很正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740771205
					]
				},
				{
					"id": 740771205,
					"content": "因、因為我是一個活在當下的類型！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771206,
					"content": "是夢總是會醒的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740771207
					]
				},
				{
					"id": 740771207,
					"content": "夢醒來的話，就只有兩個選擇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771208,
					"content": "趕快接著睡，看能不能重新做那個夢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771209,
					"content": "或者，就在清醒的世界裡，好好面對自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771210,
					"content": "既然夢醒了就該吃早餐了…那就吃個野菇雞肉串犒勞自己吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771211,
					"content": "又要清醒、勇敢地面對一天的現實了。為自己加個油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740771212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740771212,
					"content": "哇塞，真是伏筆！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740771213
					]
				},
				{
					"id": 740771213,
					"content": "伏筆？什麼伏筆？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
