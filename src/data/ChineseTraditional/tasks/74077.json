					"nextDialogs": [
						740770202
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740770202,
					"content": "卡特皮拉又變回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740770203,
					"content": "畢竟要做好戰鬥的準備。妳看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770204
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740770204,
					"content": "這些是查封這座塔的時候，留下的保全設施。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770205
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740770205,
					"content": "我們一旦試圖前往最底層，恐怕就會觸發它們的喚醒流程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770206
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740770206,
					"content": "你的猜測沒錯。剛才已經檢驗過了，這批發條機關仍有喚醒、啟動的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770207
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740770207,
					"content": "換句話說，也有喚不醒的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770208
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740770208,
					"content": "這麼多年它們就都在這裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740770209,
					"content": "這麼多年，水仙十字聖劍才第一次被修復啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770210
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740770210,
					"content": "如果當年的設計無誤，解除最終封印的鑰匙就是聖劍本身了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770211
					],
					"speakerTitle": "卡特皮拉"
				},
				{
					"id": 740770211,
					"content": "準備好了的話，就動手吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡特皮拉"
