			},
			"dialogs": [
				{
					"id": 740770801,
					"content": "#{F#妳}{M#你}好，有什麼能為{F#妳}{M#你}效勞的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770802
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740770802,
					"content": "關於警衛發條機關…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770803
					]
				},
				{
					"id": 740770803,
					"content": "請不必擔心。它們都處在非啟動狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770804
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740770804,
					"content": "而且年代久遠，加上是初期型號，它們甦醒過來的機率並不是百分之百。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770805
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740770805,
					"content": "根據我身邊這幾位的紀錄來看，開啟下層的入口就會觸發啟動喚醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770806
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740770806,
					"content": "到時候大概會有六成機關能成功啟動。剩下四成，啟動不了的機率也不是百分之百。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770807
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740770807,
					"content": "呃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770808
					]
				},
				{
					"id": 740770808,
					"content": "至少漫長的時間有機率幫我們減輕備戰壓力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740770809
					],
					"speakerTitle": "西摩爾"
				},
				{
					"id": 740770809,
					"content": "這幾句話邏輯好複雜哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740770810
					]
				},
				{
					"id": 740770810,
					"content": "#抱歉，{NICKNAME}{M#先生}{F#小姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "西摩爾"
				}
			]
		},
