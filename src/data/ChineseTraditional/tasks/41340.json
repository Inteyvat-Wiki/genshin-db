				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿桂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400101,
					"content": "#不好意思，過節還要麻煩{F#妳}{M#你}，每年海燈節「不卜廬」的患者都會變多，實在是有點忙不過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400102
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400102,
					"content": "為什麼會這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400103
					]
				},
				{
					"id": 413400103,
					"content": "海燈節的時候，大家都會放下工作陪伴家人，自然也少不了各種飯宴、香醇美酒、雞鴨魚肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400104
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400104,
					"content": "這樣一來，難免消化不良，或者鬧出這樣那樣的病症…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400105
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400105,
					"content": "雖然我總是勸人「切忌暴飲暴食」，但逢上了佳節良宵，這種勸告實在是沒什麼效用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400106
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400106,
					"content": "剛剛又有幾家人聯繫我，讓我去送治消化不良和胃病的藥。可是「不卜廬」的事也不能放下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400107
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400107,
					"content": "#旅行者，如果{F#妳}{M#你}願意的話，能幫忙去送幾份藥嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿桂"
				}
			]
		},
		{
			"id": 4134002,
			"completionStepIds": [
				4134003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134003",
							"2"
