				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"觀海"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400301,
					"content": "#唔唔，哎喲…真難受…{F#妳}{M#你}、{F#妳}{M#你}有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400302
					],
					"speakerTitle": "觀海"
				},
				{
					"id": 413400302,
					"content": "關於阿桂的藥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400303
					]
				},
				{
					"id": 413400303,
					"content": "哦哦，謝謝你們！是我訂的…來得真及時。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400304
					],
					"speakerTitle": "觀海"
				},
				{
					"id": 413400304,
					"content": "哎呀，有藥吃就好多了，我猜測我是晚上吹海風引了風寒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400305
					],
					"speakerTitle": "觀海"
				},
				{
					"id": 413400305,
					"content": "不是消化不良嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400306
					]
				},
				{
					"id": 413400306,
					"content": "#怎麼可能？我的腸胃好得很，跟{F#妳}{M#你}講，我之前一頓飯能吃下三條烤魚呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400307
					],
					"speakerTitle": "觀海"
				},
				{
					"id": 413400307,
					"content": "就算是現在，吃飯喝酒的時候，周圍的朋友也沒有誰是我的對手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400308
					],
					"speakerTitle": "觀海"
				},
				{
					"id": 413400308,
					"content": "好了，不說了，我趕快吃藥，接下來還有一場酒局呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400309,
						413400310
					],
					"speakerTitle": "觀海"
				},
				{
					"id": 413400309,
					"content": "總之要保重身體。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				},
				{
					"id": 413400311,
					"content": "哈哈哈，沒關係啦，又不是老頭子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400312
					],
					"speakerTitle": "觀海"
				},
				{
					"id": 413400312,
					"content": "#不過謝謝{F#妳}{M#你}的好意，我會注意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "觀海"
				},
				{
					"id": 413400310,
					"content": "身體垮掉再想休養就晚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400311
					]
				}
			]
		},
		{
			"id": 4134004,
