			},
			"dialogs": [
				{
					"id": 413400701,
					"content": "你們來啦，願望我已經寫在霄燈上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400702
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400702,
					"content": "現在時候也正好…我們馬上放飛霄燈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400801
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400801,
					"content": "我的願望，果然還是希望所有的璃月的居民，都能無病無災。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400802
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400802,
					"content": "那「不卜廬」的生意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400803
					]
				},
				{
					"id": 413400803,
					"content": "哈哈，所以說是我個人的願望嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400804
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400804,
					"content": "我願意為人抓藥，是因為我不想看到有人因為病痛而受折磨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400805
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400805,
					"content": "老話說得好，「但願世間人無病，何愁架上藥生塵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400806
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400806,
					"content": "哈哈，而且只要大家都健健康康的，我也不會那麼忙了，應該也是件好事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400807
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400807,
					"content": "啊，糟了！我想起來，還有一家的藥沒有送到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400808
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400808,
					"content": "抱歉，我要先走了！祝你們海燈節快樂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿桂"
				}
			]
		},
