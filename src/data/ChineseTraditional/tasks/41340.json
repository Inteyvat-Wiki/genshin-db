				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"志華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400201,
					"content": "是不是吃了什麼不乾淨的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400202
					],
					"speakerTitle": "志華"
				},
				{
					"id": 413400202,
					"content": "關於阿桂的藥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400203
					]
				},
				{
					"id": 413400203,
					"content": "哦！謝謝，這個就是我找阿桂開的胃藥吧？我確實有些消化不良…這肚子難受得不得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400204
					],
					"speakerTitle": "志華"
				},
				{
					"id": 413400204,
					"content": "我其實就在市集裡逛了一會，吃了一會，一不小心就吃多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400205
					],
					"speakerTitle": "志華"
				},
				{
					"id": 413400205,
					"content": "你都吃了些什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400206
					]
				},
				{
					"id": 413400206,
					"content": "唔…炒飯，魚生，水果，好多好多蝦，對了，還有很好喝的酒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400207,
						413400208
					],
					"speakerTitle": "志華"
				},
				{
					"id": 413400207,
					"content": "難怪會有胃病…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				},
				{
					"id": 413400209,
					"content": "#所以才需要吃藥嘛。但是{F#妳}{M#你}想，要是過節都不能想吃什麼就吃什麼，日子過得是不是就太沒意思了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400210
					],
					"speakerTitle": "志華"
				},
				{
					"id": 413400210,
					"content": "總之，謝謝你們的藥，我也趁這個機會，稍微休息一會吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "志華"
				},
				{
					"id": 413400208,
					"content": "就算是過節也不能太放縱。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400209
					]
				}
			]
		},
		{
			"id": 4134003,
			"completionStepIds": [
				4134004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
