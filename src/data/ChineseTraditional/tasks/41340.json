			},
			"dialogs": [
				{
					"id": 413400601,
					"content": "這霄燈又規整又結實，呵呵，我的手藝可比這差遠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400602
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400602,
					"content": "那等到晚上，我們就去把這盞霄燈放起來吧，我知道一個不錯的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400603
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400603,
					"content": "放燈之前的這段時間，我要好好想想，究竟許什麼願望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿桂"
