						],
						"stepId": 4134007,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4134006",
							"3"
						],
						"stepId": 4134006,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿桂"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413400401,
					"content": "#辛苦{F#妳}{M#你}們了，藥應該都送到了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400402,
						413400403
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400402,
					"content": "感覺他們很快又會生病…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400404
					]
				},
				{
					"id": 413400404,
					"content": "沒辦法，如果不注意生活習慣，腸胃病很難根治，只有再次生病的時候再對症下藥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400405
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400405,
					"content": "不過這下子，我也終於可以喘口氣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400406
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400406,
					"content": "關於霄燈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400407
					]
				},
				{
					"id": 413400407,
					"content": "放霄燈？我們…一般不會放啦，放霄燈是為了許願的，「不卜廬」能許什麼願呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400408
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400408,
					"content": "別的商家都希望生意興隆，但治病救人的藥廬總不能期待這種事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400409,
						413400410
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400409,
					"content": "阿桂先生是善良的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400411
					]
				},
				{
					"id": 413400411,
					"content": "不過就我個人來說，我還是想放盞燈的，畢竟過節嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400412
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400412,
					"content": "但霄燈我做了幾天了，因為太忙，現在也只開了個頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400413
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400413,
					"content": "趁現在短暫的休息時間，我也只能多編兩下，等到霄燈做好，海燈節怕是都結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413400414
					],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400414,
					"content": "我來幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413400415
					]
				},
				{
					"id": 413400415,
					"content": "#真、真的嗎？那就謝謝{F#妳}{M#你}了，感激不盡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿桂"
				},
				{
					"id": 413400410,
					"content": "阿桂先生很誠實啊。",
