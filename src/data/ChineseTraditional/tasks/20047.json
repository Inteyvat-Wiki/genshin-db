				},
				{
					"id": 200470302,
					"content": "有這些發現…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470303
					]
				},
				{
					"id": 200470303,
					"content": "…原來如此，原來如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470304
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 200470304,
					"content": "基本上就是這樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470305
					]
				},
				{
					"id": 200470305,
					"content": "#都是很有價值的線索，辛苦{F#妳}{M#你}了，這些就給{F#妳}{M#你}做謝禮吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470306
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 200470306,
					"content": "帕琪！冒險計畫又可以更新了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
