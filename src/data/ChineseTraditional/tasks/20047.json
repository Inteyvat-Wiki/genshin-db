					"杜蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200470101,
					"content": "冒險不可能有完美的方案！這麼拖下去，什麼時候才能有進展？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470102
					],
					"speakerTitle": "好奇的帕琪"
				},
				{
					"id": 200470102,
					"content": "就算沒有完美的方案，也要做好萬全的準備！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470103
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 200470103,
					"content": "你們在吵什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470104
					]
				},
				{
					"id": 200470104,
					"content": "哦，我們打算去<color=#00E1FFFF>千風神殿</color>內部探險，但帕琪小姐實在是沒有冒險經驗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470105
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 200470105,
					"content": "現在千風神殿裡魔物橫行，還有那個恐怖的遺蹟守衛…貿然闖進去，只會讓自己的生命安全受到威脅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470106
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 200470106,
					"content": "為了和帕琪…不是，為了保障我們的人身安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470107
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 200470107,
					"content": "我正在說服她，制訂一份萬無一失的冒險計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470108
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 200470108,
					"content": "但假如我去周圍調查，說不定帕琪就會直接衝進神殿裡去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470109
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 200470109,
					"content": "#我得在這看著她，請{F#妳}{M#你}幫我去周圍調查一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470110,
						200470113
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 200470110,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470111
					]
				},
				{
					"id": 200470111,
					"content": "太好了，要看得仔細一些啊，任何細節都會影響冒險的成敗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470112
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 200470112,
					"content": "無論發現了什麼，都帶回來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 200470113,
					"content": "那我來看著帕琪小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200470114
					]
				},
				{
					"id": 200470114,
					"content": "不，不行！舊計畫裡有很多細節，我要和她重新討論…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200470115
					],
					"speakerTitle": "杜蘭"
				},
				{
					"id": 200470115,
					"content": "#{F#妳}{M#你}快點去調查新線索吧，拜託了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜蘭"
				}
			]
		},
