			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭比洛斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746930101,
					"content": "真的不能把這套卡的卡背複製一份給我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930102
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930102,
					"content": "抱歉，不可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930103
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930103,
					"content": "真的很帥，可以再商量一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930104
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930104,
					"content": "不可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930105
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930105,
					"content": "好吧，拿到好看的卡背和使用強力的卡牌都需要付出代價，我明白的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930106,
						746930107,
						746930108
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930106,
					"content": "你根本沒明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930109,
					"content": "#喂！{F#妳}{M#你}根本什麼也沒問，直接就說出原因了嗎？說不定賽諾是來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746930110,
					"content": "沒錯。不愧是我的摯友，我們已經心意相通了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930111
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930111,
					"content": "還真的是啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746930112,
					"content": "最近楓丹這邊正在舉辦一場小型的牌友聚會，據說，聚會上會發放免費的限定款式卡套。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930113
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930113,
					"content": "教令院沒有什麼要緊事，所以我就過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930114
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930114,
					"content": "就算是有要緊事，賽諾肯定也會把它變得不太要緊的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746930115,
					"content": "是的，我只加了兩個星期的班，就把所有事務都處理得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930116
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930116,
					"content": "賽索斯也幫忙了，他很適合做文書工作，我答應為他也帶一副卡套作為補償。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930117
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930117,
					"content": "這位大風紀官，你到底抽不抽牌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930118
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930118,
					"content": "當然要抽。妳剛才說，這張牌可以用來預測我的未來，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930119
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930119,
					"content": "正確地說其實不是這樣，不過你這麼理解也沒有什麼太大的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930120
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930120,
					"content": "原來是這樣…這就是《決鬥王》裡寫的「賭上命運的下一輪抽牌」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930121
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930121,
					"content": "那麼，到我的回合了，抽牌…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930122
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930122,
					"content": "賽諾深吸一口氣，用帥氣的姿勢抽出了卡牌…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746930123
					]
				},
				{
					"id": 746930123,
					"content": "是逆位的「節制」啊，被你這位須彌教令院的「大風紀官」抽到，倒是不出所料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930124
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930124,
					"content": "妳之前聽說過賽諾？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930125
					]
				},
				{
					"id": 746930125,
					"content": "艾莉絲和我提起過幾次。說古板的教令院居然有這麼一位富有幽默感的「大風紀官」，真是有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930126
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930126,
					"content": "謝謝誇獎。我已經抽了牌，接下來該做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930127
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930127,
					"content": "既然是逆位的「節制」，或者說逆位的「技藝」，那我會建議，你最好先保持「什麼都不做」的狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930128
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930128,
					"content": "你行事過於急躁匆忙，幾乎要在命運的獨木橋上失去平衡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930129
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930129,
					"content": "是我打牌太沒有節制了嗎？賽索斯和提納里也這麼說過我，我已經調整好時間表了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930130
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930130,
					"content": "…我不是說打牌，我是說工作時間。能夠讓你這位「大風紀官」全力應對的事，應該不只是「七聖召喚」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930131
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930131,
					"content": "除打牌之外，我的時間安排，基本上沒有一絲一毫「調整」的餘地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930132
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930132,
					"content": "如此安排所帶來的壓力，你習慣了獨自承擔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930133
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930133,
					"content": "還有諸位風紀官同僚，我們會一起承擔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930134
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930134,
					"content": "但他們都指望著你——不只是風紀官、教令院的學者、須彌的民眾…許多人，都指望著你這位「大風紀官」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930135
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930135,
					"content": "沒人會提起這件事，或者，他們都沒有意識到自己內心的這份想法…畢竟他們都被你的幽默感吸引住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930136
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930136,
					"content": "但你卻每時每刻都能感受到那些目光…喔，還有那位與你同行的「影子」，他也是重擔之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930137
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930137,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930138
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930138,
					"content": "你習慣了走在最前方，接過一個又一個重擔…我想，或許這才是你「失衡」的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930139
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930139,
					"content": "我有許多朋友，還有「七聖召喚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930140
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930140,
					"content": "看來，你並不打算休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930141
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930141,
					"content": "還沒到能夠休息的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930142
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930142,
					"content": "的確，對你這樣的人來說，如果內心的鏖戰無休無止，那麼哪怕是死亡之日，亦不是職責的終結之時。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930143
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930143,
					"content": "收下這張「月諭聖牌」吧。或許它能指引你，找到那個足以讓你重拾平衡的「理由」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930144
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930144,
					"content": "在那個時候，你內心的鏖戰，應該也會走向最終的決戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930145,
						746930146
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930145,
					"content": "賽諾不會輸的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930147,
					"content": "#謝謝{F#妳}{M#你}，{NICKNAME}、派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930148
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930148,
					"content": "也謝謝您，這張牌我收下了。我保證，不會把它帶進梅洛彼得堡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930149
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930149,
					"content": "…哈？怎麼莫名其妙的，等一下，難道說——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930150,
						746930151,
						746930152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746930150,
					"content": "怎麼又來了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930153,
					"content": "…這和梅洛彼得堡有什麼關係？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930154
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746930154,
					"content": "因為這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746930155
					],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930155,
					"content": "「越獄」聖牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽諾"
				},
				{
					"id": 746930151,
					"content": "轉換得好快！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930152,
					"content": "芭比洛斯女士，您不要——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930153
					]
				},
				{
					"id": 746930146,
					"content": "賽諾是最強的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930147
					]
				},
				{
					"id": 746930107,
					"content": "我根本不明白！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				},
				{
					"id": 746930108,
					"content": "你怎麼來這裡打牌了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746930109
					]
				}
			]
		},
		{
			"id": 7469302,
			"completionStepIds": [
				7469302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
