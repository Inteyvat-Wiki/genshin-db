				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500201,
					"content": "您幫我拍完畫片了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500202
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500202,
					"content": "還沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500203
					]
				},
				{
					"id": 733500203,
					"content": "唔，您慢慢來，拍攝畫片確實不是一件簡單的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				}
			]
		},
		{
			"id": 7335003,
			"completionStepIds": [
				7335003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7335003",
							"2"
						],
						"stepId": 7335003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奧古斯都·洛夫萊斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500301,
					"content": "這畫片真不錯，您在留影方面很有天賦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500302
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500302,
					"content": "自從開始旅行以來，對於構圖與色彩把握有如此水準的人，我還是第一次見呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500303
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500303,
					"content": "你都到過什麼地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500304
					]
				},
				{
					"id": 733500304,
					"content": "這個啊，嗯…我本來可以直接從楓丹到須彌。畢竟楓丹有一條航線直達須彌的拜達港嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500312
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500312,
					"content": "但俗話說，旅行最重要的是過程嘛，所以我還是選擇了一條…更具有趣味性的旅遊路線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500313
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500313,
					"content": "首先，我先從柔燈港來到了沉玉谷，並途經輕策莊到達了分隔蒙德與璃月的石門。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500310
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500310,
					"content": "在拜訪晨曦酒莊以後，我還是決定南下到璃月港看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500305
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500305,
					"content": "在璃月港我搭上了去奧摩斯港的渡船，再經河道北上，就來到了這裡，遇到了您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500306
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500306,
					"content": "畢竟，這次旅行的動機還是散心。倘若我是個熱衷冒險的勇士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500311
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500311,
					"content": "或許我會樂意從海露港出發，走走古代的朝聖之路，向南深入沙漠吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500307
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500307,
					"content": "…誰知道呢？或許返程時，我會試試穿越大沙漠。這麼說來，現在經費還很充足，或許穿越沙漠去納塔看看也不錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500308
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500308,
					"content": "好了，不耽誤您的時間了。感謝您幫我留影，這些報酬請您收下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500309
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500309,
					"content": "我得趕緊去給澤維爾寫信了，他再不來須彌，我就要回楓丹了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				}
			]
		},
