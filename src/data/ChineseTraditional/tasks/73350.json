						],
						"stepId": 7335001,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7228724",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奧古斯都·洛夫萊斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500401,
					"content": "啊…哈啾！這些香料的味道真是太…啊…哈啾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500402
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500402,
					"content": "還是快點留個影，回去屋裡待著吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500403
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500403,
					"content": "旅行者，嗨，旅行者！請您留步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500404,
						733500405
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500404,
					"content": "你叫我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500406
					]
				},
				{
					"id": 733500406,
					"content": "我想請您幫我在這裡留個影，一張就好，不會花多長時間的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500409
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500409,
					"content": "這地方的香料味道對我來說，實在是太刺激了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500410
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500410,
					"content": "我在楓丹的時候，吃的菜裡可是連一點辣味都不能有，最多放一點鹽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500411
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500411,
					"content": "在這裡，我噴嚏打得連…哈啾！連留影機都要拿不穩了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500412
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500412,
					"content": "所以，我只能拜託…拜託其他人幫我留影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500413
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500413,
					"content": "您看起來就是個好心腸的人，所以…我就想請您來幫我這個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500414
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500414,
					"content": "你來自楓丹？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500415
					]
				},
				{
					"id": 733500415,
					"content": "沒錯，我都忘記自我介紹了，真是抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500416
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500416,
					"content": "我的名字是奧古斯都·洛夫萊斯，「楓丹動能工程科學研究院」的一名研究員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500417,
						733500418
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500417,
					"content": "「楓丹動能工程科學研究院」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500419
					]
				},
				{
					"id": 733500419,
					"content": "這串字是不是太長了？您也可以把它稱作「楓丹科學院」，楓丹人也都這麼叫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500420
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500420,
					"content": "之前，楓丹科學院可以說是楓丹科學研究者的一座聖地，大部分的機關造物都出自我們院內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500421
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500421,
					"content": "但在天才的艾德溫先生主持下，楓丹科學院的大部分建築現在已經成了一片廢墟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500422
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500422,
					"content": "而雷蒙多和舒瓦瑟爾先生接手重建工作之後，院裡的「研究精神」也正在坍塌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500423
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500423,
					"content": "我是一個愛好整潔的人，不願意在廢墟堆裡生活。所以就四處旅行，散散心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500424
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500424,
					"content": "別皺眉，這些煩心事都和您無關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500425
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500425,
					"content": "來，請您快幫我拍一張畫片吧。等澤維爾見識到須彌的風光，他肯定不會再待在稻妻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500426,
						733500436
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500426,
					"content": "我們曾經共事過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500427
					]
				},
				{
					"id": 733500427,
					"content": "您…哎呀！您難道就是澤維爾說的那位旅行者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500428
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500428,
					"content": "幸會！真是幸會啊，我早就從澤維爾的信裡聽說過您在「御影爐心」裡的英勇事蹟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500429
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500429,
					"content": "而且澤維爾每次在信裡談到「映影」的時候，都要提到您在「映影」中高超的演技！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500430
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500430,
					"content": "他說您既無畏，又高尚。最重要的是，幽默感也非常棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500431
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500431,
					"content": "唉，等會您幫我留完影，一定得幫我簽個名才行，就簽在畫片上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500432
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500432,
					"content": "澤維爾還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500433
					]
				},
				{
					"id": 733500433,
					"content": "呃…老實說，不太好。他一直在為「映影」煩惱。從信裡看，他最近找不到有趣的新題材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500434
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500434,
					"content": "我建議他和我一樣，先放下手裡的工作，來須彌散散心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500435
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500435,
					"content": "但他一直說，他必須要拍攝一部最優秀的「映影」給「社奉行」。在那之前，他不會離開稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500441
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500441,
					"content": "先不說這些了，請您來幫我拍一張畫片吧，在這裡就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500436,
					"content": "你是怎麼認識澤維爾的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500437
					]
				},
				{
					"id": 733500437,
					"content": "想必您也知道，澤維爾是楓丹科學院裡的研究員。我曾與他在同一間研究室共事，他也曾經為我提供了許多指導。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500438
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500438,
					"content": "他堅持要拍「映影」，還要做「映影導演」，在當時的楓丹科學院裡，這個想法可不受歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500439
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500439,
					"content": "即便後來被趕到了其他專案，他仍藉著記錄研究過程的名目，不斷地拍攝著「記錄映影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500442
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500442,
					"content": "就這樣，他在專案與研究室之間輾轉，直到最終他被派到稻妻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500440
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500440,
					"content": "很有想法的人，假設他誕生在研究方向更為開明、經費更加充裕的過去，或者是美好的未來，想必能大有成就吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500441
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500418,
					"content": "那是什麼地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500419
					]
				},
				{
					"id": 733500405,
					"content": "有什麼事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500406
					]
				}
			]
		}
	]
}