			"trigger": {
				"objectNames": [
					"奧古斯都·洛夫萊斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733500101,
					"content": "啊…哈啾！這些香料的味道真是太…啊…哈啾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500102
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500102,
					"content": "還是快點留個影，回去屋裡待著吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500103
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500103,
					"content": "旅行者，嗨，旅行者！請您留步！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500104,
						733500105
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500104,
					"content": "你叫我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500106
					]
				},
				{
					"id": 733500106,
					"content": "我想請您幫我在這裡留個影，一張就好，不會花多長時間的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500109
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500109,
					"content": "這地方的香料味道對我來說，實在是太刺激了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500110
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500110,
					"content": "我在楓丹的時候，吃的菜裡可是連一點辣味都不能有，最多放一點鹽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500111
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500111,
					"content": "在這裡，我噴嚏打得連…哈啾！連留影機都要拿不穩了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500112
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500112,
					"content": "所以，我只能拜託…拜託其他人幫我留影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500113
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500113,
					"content": "您看起來就是個好心腸的人，所以…我就想請您來幫我這個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500114
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500114,
					"content": "你來自楓丹？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500115
					]
				},
				{
					"id": 733500115,
					"content": "沒錯，我都忘記自我介紹了，真是抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500116
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500116,
					"content": "我的名字是奧古斯都·洛夫萊斯，「楓丹動能工程科學研究院」的一名研究員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500117,
						733500118
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500117,
					"content": "「楓丹動能工程科學研究院」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500119
					]
				},
				{
					"id": 733500119,
					"content": "這串字是不是太長了？您也可以把它稱作「楓丹科學院」，楓丹人也都這麼叫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500120
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500120,
					"content": "之前，楓丹科學院可以說是楓丹科學研究者的一座聖地，大部分的機關造物都出自我們院內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500121
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500121,
					"content": "但在天才的艾德溫先生主持下，楓丹科學院的大部分建築現在已經成了一片廢墟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500122
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500122,
					"content": "而雷蒙多和舒瓦瑟爾先生接手重建工作之後，院裡的「研究精神」也正在坍塌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500123
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500123,
					"content": "我是一個愛好整潔的人，不願意在廢墟堆裡生活。所以就四處旅行，散散心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500124
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500124,
					"content": "別皺眉，這些煩心事都和您無關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500125
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500125,
					"content": "來，請您快幫我拍一張畫片吧。等澤維爾見識到須彌的風光，他肯定不會再待在稻妻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500126
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500126,
					"content": "提到澤維爾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500127
					]
				},
				{
					"id": 733500127,
					"content": "澤維爾是楓丹科學院裡的研究員。我曾與他在同一間研究室共事，他也曾經為我提供了許多指導。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500128
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500128,
					"content": "他堅持要拍「映影」，還要做「映影導演」，在當時的楓丹科學院裡，這個想法可不受歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500129
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500129,
					"content": "即便後來被趕到了其他專案，他仍藉著記錄研究過程的名目，不斷地拍攝著「記錄映影」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500132
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500132,
					"content": "就這樣，他在專案與研究室之間輾轉，直到最終他被派到稻妻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500130
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500130,
					"content": "很有想法的人，假設他誕生在研究方向更為開明、經費更加充裕的過去，或者是美好的未來，想必能大有成就吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733500131
					],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500131,
					"content": "先不說這些了，請您來幫我拍一張畫片吧，在這裡就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧古斯都·洛夫萊斯"
				},
				{
					"id": 733500118,
					"content": "那是什麼地方？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500119
					]
				},
				{
					"id": 733500105,
					"content": "有什麼事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733500106
					]
				}
			]
		},
		{
			"id": 7335002,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
