			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維納亞克",
					"施芮婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735180101,
					"content": "充能裝置的運轉果然變得更順暢了…就像妳說的，這片區域的元素環境，正在恢復正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180102
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735180102,
					"content": "…受到影響的沙蟲，過一段時間，應該也會平息下來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180103
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735180103,
					"content": "是是是，多虧了你的寶貝「對沙蟲用殺蟲炮」，現在我們可以回去交差，然後各回各家啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180104
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735180104,
					"content": "——是我們的「對沙蟲用殺蟲炮」。施芮婭，我從沒忘記這是我們的共同作業。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180105
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735180105,
					"content": "…雖然當年是起過不少衝突，不過沒有妳的話，我也看不到它落地的一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180106
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735180106,
					"content": "這…這種時候突然說這些幹什麼？想讓我在報告裡幫你說好話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180107
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735180107,
					"content": "唔，就是突然覺得，這幾天的經歷和當年還滿像的吧，吵吵鬧鬧又跌跌撞撞的，不過好歹也還是把問題解決了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180108
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735180108,
					"content": "——而且不得不承認，最後還是妳的解決方案比較有效率。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180109
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735180109,
					"content": "我…這…我也沒那麼厲害啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180110
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735180110,
					"content": "…其實你之前說的也有道理，如果沒有實際測試過「對沙蟲用殺蟲炮」，我也拿不到這些資料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180111
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735180111,
					"content": "「修好一臺機械或許只需要更換一個齒輪，但難的卻是如何找到這枚齒輪…」我開始理解導師當初的評語了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180112
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735180112,
					"content": "有妳在真是太好了，施芮婭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180113
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735180113,
					"content": "唔…你也是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180114
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735180114,
					"content": "#怎麼回事？{NICKNAME}，這兩個人的氣氛突然變得好奇怪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180115,
						735180116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735180115,
					"content": "派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735180117
					]
				},
				{
					"id": 735180117,
					"content": "咳咳！當初為了畢業設計把關係弄得那麼僵，是我們都太不成熟了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180118
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735180118,
					"content": "是啊，回過頭來想想，明明也沒有什麼特別嚴重的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735180119
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735180119,
					"content": "那個——下次一塊去咖啡館喝一杯怎麼樣？我們可以商量一下，這次的報告要怎麼寫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735180116,
					"content": "別問了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735180117
					]
				}
			]
		}
	]
}