			},
			"dialogs": [
				{
					"id": 761960201,
					"content": "多洛妲！妳怎麼在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960202
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960202,
					"content": "莉奈婭，妳來得正好！我剛才在向大家說明月落銀的美妙之處呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960203
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960203,
					"content": "月落銀啊月落銀，月下世界還有比你更完美的寶石嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960204
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960204,
					"content": "看！無可挑剔的造型、珠圓玉潤的感觸！還有它那五彩斑斕的白、無與倫比的元素親和力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960205
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960205,
					"content": "在我心目中，只有天上的月亮能與你媲美！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960206
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960206,
					"content": "月落銀的確是很漂亮的礦石，我也收集了一些做標本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960207
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960207,
					"content": "對吧對吧！我就知道妳會懂我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960208
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960208,
					"content": "不過呢，最懂月落銀的一定還是我！就算妳是協會的顧問，這個第一的位置我也不會讓給妳的，哼哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960209
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960209,
					"content": "對了，平常都是妳來為冒險家講課，今天就讓我考考妳吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960210
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960210,
					"content": "我這裡有三顆月落銀。非常遺憾，其中兩顆有些細微的瑕疵，而另一顆則是我的珍藏，是月落銀中的月落銀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960211
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960211,
					"content": "妳可以分辨出哪一顆才是最完美的月落銀嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960212,
					"content": "讓我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960213,
						761960220,
						761960225
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960213,
					"content": "左邊這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960214
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960214,
					"content": "（咦？露米這是在…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960215,
						761960231
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960215,
					"content": "就選這個了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960216
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960216,
					"content": "莉奈婭也會有看走眼的時候啊，其實這顆在很不起眼的地方有一點點微小的瑕疵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960217
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960217,
					"content": "唔，我認輸了…不過下次，下次我可不會這麼輕易輸掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960218
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960218,
					"content": "好啊，隨時奉陪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960232,
					"content": "順勢參加了多洛妲主辦的月落銀鑑賞大會，度過了一段愉快的時光…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761960219
					]
				},
				{
					"id": 761960219,
					"content": "沒想到大家都這麼熱情，可惜像這樣美好的時光總是轉瞬即逝…差不多該收拾收拾了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960233
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960233,
					"content": "我來幫妳吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960234
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960234,
					"content": "那太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960231,
					"content": "我再想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960212
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960220,
					"content": "中間這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960221
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960221,
					"content": "（露米好像很喜歡這個呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960222,
						761960231
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960222,
					"content": "就選這個了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960223
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960223,
					"content": "啊，妳也可以感受到吧！來自完美之物那不可抵抗的魅力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960232
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960225,
					"content": "右邊這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960226
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960226,
					"content": "（咦？露米這是在…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960227,
						761960231
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960227,
					"content": "就選這個了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960228
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960228,
					"content": "莉奈婭也會有看走眼的時候啊，其實這顆在很不起眼的地方有一點點微小的瑕疵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960229
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960229,
					"content": "唔，我認輸了…不過下次，下次我可不會這麼輕易輸掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960230
