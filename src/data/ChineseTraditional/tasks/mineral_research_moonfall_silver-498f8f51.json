				]
			},
			"dialogs": [
				{
					"id": 761960301,
					"content": "妳看看，應該沒有遺漏吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960302
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960302,
					"content": "嗯——沒問題，不多也不少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960303
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960303,
					"content": "我看到妳用月落銀在地上擺出了有趣的圖案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960304
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960304,
					"content": "是啊！花費了不少心思呢，我覺得這樣更能激起大家對於月落銀的喜愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960305
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960305,
					"content": "對了，我聽說納塔的民間故事裡有這樣一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960306
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960306,
					"content": "說的是原本住在星星上的少女墜落大地後，為了重返上天而在大地之上留下了巨大的塗鴉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960307
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960307,
					"content": "之後，她在天上的太陽父親果然看到了她的請求，將她帶回了天上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960308
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960308,
					"content": "說不定他也會看到多洛妲擺出的圖案，就此成為月落銀的粉絲哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960309
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960309,
					"content": "哈哈哈！如果是這樣，那我就是最了不起的月落銀推廣大使了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960310
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960310,
					"content": "不過比起那個，我還是更擔心被天上的飛鳥盯上——妳也知道，烏鴉之類的不是很喜歡亮晶晶的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960311
					],
					"speakerTitle": "多洛妲"
				},
				{
					"id": 761960311,
					"content": "說得也是，而且除了烏鴉，也要小心地上的嗅嗅鼴鼠和盜寶鼬之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761960312
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761960312,
					"content": "還有露米！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
