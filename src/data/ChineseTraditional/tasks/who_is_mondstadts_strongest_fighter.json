				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102000401,
					"content": "琴團長！打擾妳啦，我們在收集「蒙德最強戰力」的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000402,
					"content": "有沒有…那種…西風騎士團認證過的官方排名呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000403,
					"content": "「蒙德最強戰力」…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000404
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102000404,
					"content": "抱歉，不能幫上忙了。我身邊並沒有這方面的資料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000405
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102000405,
					"content": "欸…好可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000406,
					"content": "#我還希望看{F#她}{M#他}排上前五呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000407,
					"content": "哈哈。即使沒有這方面的統計，我對這位榮譽騎士的實力也從未質疑過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000408
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102000408,
					"content": "對了，說到這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000409
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102000409,
					"content": "最近又有深淵教團的法師，在蒙德城附近鬼鬼祟祟地出沒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000410
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102000410,
					"content": "如果你們在蒙德周邊逗留，也希望能夠幫忙留意一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000411
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102000411,
					"content": "#以{F#妳}{M#你}的「戰力」，守護人們的安全，應當不成問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000412
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102000412,
					"content": "#好！如果能夠把深淵教團解決掉的話，{F#她}{M#他}的排名又會上升一點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000413,
						102000414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000413,
					"content": "沒有那樣的排名啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000415
					]
				},
				{
					"id": 102000415,
					"content": "總之，打倒他們就對了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000416,
					"content": "哈，感覺被你們的幹勁激勵了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000417
					],
					"speakerTitle": "琴"
				},
				{
					"id": 102000417,
					"content": "那麼，一路小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 102000414,
					"content": "會變成「最強」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000415
					]
				}
			]
		},
