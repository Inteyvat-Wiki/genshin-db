				"points": []
			},
			"dialogs": [
				{
					"id": 102000601,
					"content": "#唔！我，我很好！對不起，撞到了{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000602
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000602,
					"content": "妳有東西掉了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000603
					]
				},
				{
					"id": 102000603,
					"content": "嗯唔…這上面寫的是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000604,
					"content": "「城裡放炮禁閉室報到」、「炸彈傷人琴找上門」、「放火燒山可莉完蛋」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000605,
					"content": "呀？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000606
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000606,
					"content": "這…這是凱亞哥哥幫我總結出的…總結出的…唔，生存守則！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000607
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000607,
					"content": "生存守則？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000608,
					"content": "就…就是不論如何千萬不能違反的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000609
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000609,
					"content": "不然會發生很可怕、很可怕的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000610,
						102000611
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000610,
					"content": "凱亞哥哥？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000612
					]
				},
				{
					"id": 102000612,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000613
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000613,
					"content": "啊啊啊，忘記做自我介紹了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000614
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000614,
					"content": "我的名字叫作可莉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000615,
						102000616
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000615,
					"content": "妳好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000618
					]
				},
				{
					"id": 102000618,
					"content": "我知道你們的事情，是幫助了蒙德的榮譽騎士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000619
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000619,
					"content": "哇？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000620,
					"content": "好感動，又一次得到了肯定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000621,
					"content": "我是聽安柏…嗷嗚。不對不對，來不及說這些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000622
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000622,
					"content": "我，我其實有件很緊急、很緊急的事情，所以才抱著地圖跑來這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000623
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000623,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000624
					]
				},
				{
					"id": 102000624,
					"content": "我，我埋在<color=#00E1FFFF>低語森林</color>裡的寶物不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000625
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000625,
					"content": "妳是說…寶物？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000626,
						102000628
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000626,
					"content": "她看起來需要幫助…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000627
					]
				},
				{
					"id": 102000627,
					"content": "沒錯，我也是這樣想的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000631,
					"content": "寶物失蹤可是大事，要不然我們幫妳找回來吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000632
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000632,
					"content": "好耶！謝謝你們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000633
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000633,
					"content": "我看看…喏！寶物就在地圖上的這個位置。我圈出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000634
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000634,
					"content": "我在埋寶物的地方還插了一個小木牌，很好找的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000635
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000635,
					"content": "（木牌…好像能明白寶物為什麼會失蹤了。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000636,
					"content": "#榮譽騎士{F#姐姐}{M#哥哥}，我們趕快出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				},
				{
					"id": 102000628,
					"content": "紅衣服的小女孩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000629
					]
				},
				{
					"id": 102000629,
					"content": "還帶著寶物！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000630,
					"content": "（六指喬瑟先生說的「強者」，難道就是可莉嗎…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000616,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000617
					]
				},
				{
					"id": 102000617,
					"content": "叫我派蒙就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000611,
					"content": "可怕的事情？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000612
					]
				}
			]
