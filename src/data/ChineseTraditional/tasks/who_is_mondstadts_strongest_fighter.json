		{
			"id": 1020002,
			"completionStepIds": [
				1020015
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1020015",
							"2"
						],
						"stepId": 1020015,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"巴頓"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 102000201,
					"content": "唉，只能從窗外聽到大家的討論，連發言的機會都沒有，好想參加他們的話題啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000202
					],
					"speakerTitle": "巴頓"
				},
				{
					"id": 102000202,
					"content": "欸？什麼什麼？有什麼好玩的事情嗎？我也想聽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000203,
					"content": "酒館裡的客人們，最近激烈地討論起了一個話題——「誰，才是蒙德城最強戰力」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000204
					],
					"speakerTitle": "巴頓"
				},
				{
					"id": 102000204,
					"content": "「最強」…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000205,
					"content": "強到一拳能放倒幾隻丘丘人，算最強嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000206,
						102000208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000206,
					"content": "應該沒有那麼簡單吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000207
					]
				},
				{
					"id": 102000207,
					"content": "唔…看來「最強」的稱號，並不好拿啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000210,
					"content": "對了，巴頓先生，關於這個話題，大家討論出什麼共識了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000211,
					"content": "嗯…指望「自由之都」的人輕而易舉達成共識，就像期待天上掉漁人吐司一樣難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000212
					],
					"speakerTitle": "巴頓"
				},
				{
					"id": 102000212,
					"content": "每個人都有自己的想法，但誰手裡的資訊都不全面，所以討論才會變得激烈又有趣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000213
					],
					"speakerTitle": "巴頓"
				},
				{
					"id": 102000213,
					"content": "現在市面上佔據主流的提名…我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000214
					],
					"speakerTitle": "巴頓"
				},
				{
					"id": 102000214,
					"content": "應該是「蒲公英騎士派」和「暗夜英雄派」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000215,
						102000216
					],
					"speakerTitle": "巴頓"
				},
				{
					"id": 102000215,
					"content": "派蒙要把票投給誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000217
					]
				},
				{
					"id": 102000217,
					"content": "#我支持{F#妳}{M#你}哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000218,
					"content": "不過，我們還是進<color=#00E1FFFF>酒館</color>打聽看看吧。說不定會有什麼逸聞呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000219,
					"content": "哈，這份悠閒真讓人羡慕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000220
					],
					"speakerTitle": "巴頓"
				},
				{
					"id": 102000220,
					"content": "#{F#妳}{M#你}們不用管我…嗚嗚，我也得…繼續工作了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "巴頓"
				},
				{
					"id": 102000216,
					"content": "有人支持我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000217
					]
				},
				{
					"id": 102000208,
					"content": "我也可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000209
					]
				},
				{
					"id": 102000209,
					"content": "#好，那我要提名{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000210
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
