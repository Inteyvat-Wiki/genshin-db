			"dialogs": [
				{
					"id": 102000301,
					"content": "果然就跟巴頓先生說得一樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000302,
						102000303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000302,
					"content": "大家都有自己的看法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000304
					]
				},
				{
					"id": 102000304,
					"content": "但是，如果像這樣，誰都說服不了誰的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000305,
					"content": "豈不是永遠都不能知道「蒙德的最強戰力」到底是誰了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000306,
					"content": "啊，有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000307,
					"content": "我們去找<color=#00E1FFFF>琴團長</color>問問看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000308,
					"content": "說不定會有，「西風騎士團認證的官方排行榜」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000309,
						102000311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000309,
					"content": "真會有那種東西嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000310
					]
				},
				{
					"id": 102000310,
					"content": "走嘛走嘛，不試試怎麼知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000311,
					"content": "我也可以有名次嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000312
					]
				},
				{
					"id": 102000312,
					"content": "#那就要看他們有沒有算上{F#妳}{M#你}的事蹟了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						102000313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000313,
					"content": "#放心，我還是很信得過{F#妳}{M#你}的實力的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 102000303,
					"content": "還聽到了一些特別的人選。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						102000304
					]
				}
			]
		},
