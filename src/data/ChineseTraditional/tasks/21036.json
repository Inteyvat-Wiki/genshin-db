			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360601,
					"content": "旅行者，我們又見面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360602,
						210360604
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360602,
					"content": "你還在鍛煉嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360603
					]
				},
				{
					"id": 210360603,
					"content": "是的，只不過…實在是有些辛苦。也不知道我是真的實力不濟，還是用錯了鍛煉方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360608
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360608,
					"content": "#先不說這些了。上次和{F#妳}{M#你}同行時，{F#妳}{M#你}的招式和動作都給了我很大啟發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360609
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360609,
					"content": "#旅行者，請{F#妳}{M#你}今天再陪我出去鍛煉一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360610,
						210360611
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360610,
					"content": "你之前在這裡鍛煉過？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360613
					]
				},
				{
					"id": 210360613,
					"content": "還好我偶然遇見了一位好心的冒險家，她願意幫我一把，以「一同執行協會委託」為理由把我帶進這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360614
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360614,
					"content": "她還幫我規劃鍛煉計畫，給我各種建議…但同時，我也得和她一起處理各種冒險家協會的委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360615,
					"content": "咳，我們還是先說正事吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360616
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360616,
					"content": "是這樣，我初步給自己擬定了一個訓練的計畫，其中包括了「對抗敵人」和「越野訓練」兩項。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360617
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360617,
					"content": "#旅行者，{F#妳}{M#你}看{F#妳}{M#你}方便陪我進行哪一項訓練？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360611,
					"content": "你居然能到這裡鍛煉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360612
					]
				},
				{
					"id": 210360612,
					"content": "唉，說來慚愧。我聽說此處地勢頗險，魔物眾多，覺得很適合作為鍛煉的場所。但沒想到，這裡卻不是那麼容易進來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360613
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360604,
					"content": "你師妹還是不理你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360605
					]
				},
				{
					"id": 210360605,
					"content": "咳…師妹她…最近總是說城裡有事要處理，一直也沒回來過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360606
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360606,
					"content": "我去找她說過幾次，但她都只是讓芷若出來擋住我，始終也不肯見我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360607
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360607,
					"content": "唉，我也不知道怎麼勸好她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360615
					],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
