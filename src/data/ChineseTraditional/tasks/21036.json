			},
			"dialogs": [
				{
					"id": 210360901,
					"content": "越野訓練。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360902
					]
				},
				{
					"id": 210360902,
					"content": "那就太好了，我們還是按照之前的那條越野路線鍛煉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360903
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360903,
					"content": "那位冒險家說，我只要盡快到達終點就好…但我每次用的時間都實在太長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360904
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360904,
					"content": "#所以，我想拜託{F#妳}{M#你}為我示範一下如何快速「越野」，我會在後面努力跟上的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360905,
						210360906
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360905,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360908
					]
				},
				{
					"id": 210360908,
					"content": "#那就拜託{F#妳}{M#你}了，我們先去訓練地點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360906,
					"content": "你可別被我甩遠了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360907
					]
				},
				{
					"id": 210360907,
					"content": "咳…我…我努力跟上，但說實話，我的腳力實在是有限啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360908
					],
					"speakerTitle": "孫宇"
				}
			]
		}
	]
