			},
			"dialogs": [
				{
					"id": 210360101,
					"content": "旅行者，我們又見面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360102,
						210360104
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360102,
					"content": "你還在鍛煉嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360103
					]
				},
				{
					"id": 210360103,
					"content": "是的，只不過…實在是有些辛苦。也不知道我是真的實力不濟，還是用錯了鍛煉方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360108,
					"content": "#先不說這些了。上次和{F#妳}{M#你}同行時，{F#妳}{M#你}的招式和動作都給了我很大啟發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360109
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360109,
					"content": "#旅行者，請{F#妳}{M#你}今天再陪我出去鍛煉一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360110
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360110,
					"content": "#還是和上次一樣，「對抗敵人」和「越野訓練」兩項，{F#妳}{M#你}方便陪我進行哪項鍛煉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360104,
					"content": "你師妹還是不理你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360105
					]
				},
				{
					"id": 210360105,
					"content": "咳…師妹她…最近總是說城裡有事要處理，一直也沒回來過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360106
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360106,
					"content": "我去找她說過幾次，但她都只是讓芷若出來擋住我，始終也不肯見我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360107
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360107,
					"content": "唉，我也不知道怎麼勸好她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360108
					],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
