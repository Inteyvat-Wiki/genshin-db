					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360801,
					"content": "#呼…呼…呼…{F#妳}{M#你}怎麼…怎麼能跑得這麼快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360802,
						210360804
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360802,
					"content": "是你跑得太慢了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360803
					]
				},
				{
					"id": 210360803,
					"content": "甘拜下風…甘拜下風…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360806,
					"content": "呼…總算是把氣喘勻了。沒想到「越野」居然這麼累人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360807
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360807,
					"content": "#謝謝{F#妳}{M#你}給我做示範，旅行者，這些報酬請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360804,
					"content": "你還得多多鍛煉啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360805
					]
				},
				{
					"id": 210360805,
					"content": "#{F#妳}{M#你}說得…說得對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360806
					],
					"speakerTitle": "孫宇"
				}
			]
		},
