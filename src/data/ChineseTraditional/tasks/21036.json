			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360501,
					"content": "#呼…呼…呼…{F#妳}{M#你}怎麼…怎麼能跑得這麼快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360502,
						210360504
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360502,
					"content": "是你跑得太慢了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360503
					]
				},
				{
					"id": 210360503,
					"content": "甘拜下風…甘拜下風…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360506,
					"content": "#謝謝{F#妳}{M#你}給我做示範，旅行者，這些報酬請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360507,
						210360510
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360507,
					"content": "關於小雀兒…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360508
					]
				},
				{
					"id": 210360508,
					"content": "師妹她…唉，依然不肯理我。我、我也不知怎麼勸她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360509
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360509,
					"content": "唉…此事，怎麼會如此難以兩全…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360510,
					"content": "關於那位冒險家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360511
					]
				},
				{
					"id": 210360511,
					"content": "她？呃…我是在冒險家協會遇見她的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360512
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360512,
					"content": "她說自己接受了協會的委託，來層岩巨淵這裡辦事，聽說我想進來，就把我順便帶上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360513
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360513,
					"content": "不過作為交換…我得幫她一起執行委託，不過大部分都是尋物的委託，倒也不繁重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360514
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360514,
					"content": "只是她…實在太愛說話了，我實在是不擅應付啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360504,
					"content": "你還得多多鍛煉啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360505
					]
				},
				{
					"id": 210360505,
					"content": "#{F#妳}{M#你}說得…說得對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360506
					],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
			"id": 2103606,
