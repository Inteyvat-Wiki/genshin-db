					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360701,
					"content": "呼…呼…真是難以對付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360702
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360702,
					"content": "#抱歉，讓{F#妳}{M#你}見笑了。沒想到正式對敵時，我會這麼緊張…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360703
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360703,
					"content": "#總之我…我還是需要多多鍛煉。多謝了旅行者，這些報酬給{F#妳}{M#你}，請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360704
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360704,
					"content": "你真的要離開璃月？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360705
					]
				},
				{
					"id": 210360705,
					"content": "我還沒有完全想好，我還得再想想，順便…再嘗試說服一下師妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
			"id": 2103608,
			"completionStepIds": [
				2103605
			],
