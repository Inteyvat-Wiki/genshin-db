					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360301,
					"content": "越野訓練。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360302
					]
				},
				{
					"id": 210360302,
					"content": "那就太好了，那位冒險家幫我規劃了一條越野路線…唉，我能進來這裡鍛煉，也是托了她的福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360303
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360303,
					"content": "她說我只要盡快到達終點就好…但我每次用的時間都實在太長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360304
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360304,
					"content": "#所以，我想拜託{F#妳}{M#你}為我示範一下如何快速「越野」，我會在後面努力跟上的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360305,
						210360306
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360305,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360308
					]
				},
				{
					"id": 210360308,
					"content": "#那就拜託{F#妳}{M#你}了，我們先去訓練地點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360306,
					"content": "你可別被我甩遠了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360307
					]
				},
				{
					"id": 210360307,
					"content": "咳…我…我努力跟上，但說實話，我的腳力實在是有限啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360308
					],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
			"id": 2103604,
			"completionStepIds": [
				2103604
			],
			"beginWay": "TALK_BEGIN_MANUAL",
