			},
			"dialogs": [
				{
					"id": 210360201,
					"content": "對抗敵人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360202
					]
				},
				{
					"id": 210360202,
					"content": "好！我早就想要把我學習的劍術用在實處了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360203
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360203,
					"content": "只怕你看不清楚我的動作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360204
					]
				},
				{
					"id": 210360204,
					"content": "這…閣下武藝竟如此高強？哈哈哈，那就只能請閣下把動作稍稍放慢些啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360205
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360205,
					"content": "我看看…附近就有一處魔物的聚集地，咱們就先去那裡好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
			"id": 2103603,
			"completionStepIds": [
				2103601,
				2103606
			],
			"beginWay": "TALK_BEGIN_NONE",
