			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"孫宇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210360401,
					"content": "呼…呼…真是難以對付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360402
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360402,
					"content": "#抱歉，讓{F#妳}{M#你}見笑了。看來我還是沒多少長進…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360403
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360403,
					"content": "#我還是需要多多鍛煉…多謝了旅行者，這些報酬給{F#妳}{M#你}，請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360404
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360404,
					"content": "你要怎麼離開璃月？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210360405
					]
				},
				{
					"id": 210360405,
					"content": "唔…我現在打算的是，搭那位客商的船，從水路向外旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360406
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360406,
					"content": "第一站…我想先去楓丹看看，然後在那裡待一段時間，之後再做打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210360407
					],
					"speakerTitle": "孫宇"
				},
				{
					"id": 210360407,
					"content": "唉，也不知道我能不能說服師妹和我同行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "孫宇"
				}
			]
		},
		{
			"id": 2103605,
			"completionStepIds": [
				2103605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
