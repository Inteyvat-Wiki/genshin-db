			"dialogs": [
				{
					"id": 761290101,
					"content": "再次感謝您對協會的幫助，奈芙爾老闆、雅珂達小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 761290102,
					"content": "合作而已，無需這麼客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290103
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761290103,
					"content": "話是這麼說，但我還是要感謝奈芙爾老闆，願意幫助協會做一些…複雜的調查工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290104
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 761290104,
					"content": "冒險家協會也分出了不少人手來協助我們的工作，算是合作共贏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290105
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761290105,
					"content": "希望我們之後也能合作得這麼愉快，薩林先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290106
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761290106,
					"content": "請奈芙爾老闆放心，我們冒險家協會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290107
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 761290107,
					"content": "噢，我必須嚴謹一點——我們挪德卡萊冒險家協會分部，絕對是一個值得信賴的合作對象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290108
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 761290108,
					"content": "呵呵，看得出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290109
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761290109,
					"content": "（好好好，就這樣繼續聊，奈姐奈姐，親愛的奈姐，別看我別看我別看我…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290110
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761290110,
					"content": "雅珂達，妳怎麼不說話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290111
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761290111,
					"content": "（還是看我了啊！那別看委託板別看委託板別看委託板——）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290112
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761290112,
					"content": "啊？我、我沒什麼要說的啊？謝謝…給我委託…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290113
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761290113,
					"content": "噗，也要感謝雅珂達小姐的協助，要是沒有您，協會的事務怕是要堆成山了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290114
					],
					"speakerTitle": "薩林"
				},
				{
					"id": 761290114,
					"content": "不客氣不客氣…我都拿錢了，一定要好好做啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290115
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761290115,
					"content": "（唉，之前教她的話術，只怕又忘光了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290116
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761290116,
					"content": "對了，既然來都來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290117
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761290117,
					"content": "（不要啊！氣氛這麼好，老闆妳就放過我吧！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290118
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761290118,
					"content": "麻煩薩林先生，把最新的一批委託拿過來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290119
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761290119,
					"content": "雅珂達，妳來選一個，妳覺得最應該做的委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290120
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761290120,
					"content": "好好想，慢慢選，好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290121
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761290121,
					"content": "是…是，老闆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761290122
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761290122,
					"content": "（嗚哇——完！蛋！啦——）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂達"
				}
			]
		}
	]
}