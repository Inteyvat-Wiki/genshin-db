				"points": []
			},
			"dialogs": [
				{
					"id": 413430701,
					"content": "#{F#妳}{M#你}好，旅行者，{F#妳}{M#你}已經把蒲公英籽播撒出去了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430702
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430702,
					"content": "已經播撒出去了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430703
					]
				},
				{
					"id": 413430703,
					"content": "太好了，希望那些蒲公英能被風帶回蒙德城…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430704
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430704,
					"content": "不過，說是要融入璃月…結果姐姐妳也還是忘不了在蒙德的習慣嘛，不如我們今天去找點蒙德的小吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430709
					],
					"speakerTitle": "傑里"
				},
				{
					"id": 413430709,
					"content": "那可不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430710
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430710,
					"content": "欸…欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430705
					],
					"speakerTitle": "傑里"
				},
				{
					"id": 413430705,
					"content": "——忘不掉蒙德習俗和融入璃月氛圍是兩碼事嘛，我們趕緊去放飛霄燈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430706
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430706,
					"content": "你寫好願望了嗎？等放完霄燈…我們就去嘗試海燈節的特色小吃吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430707
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430707,
					"content": "寫，寫是寫好了，但還要接著吃嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430708
					],
					"speakerTitle": "傑里"
				},
				{
					"id": 413430708,
					"content": "哼哼，那當然了，璃月海燈節的特色小吃…絕對不能錯過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗萊琪"
				}
			]
		}
	]
