					"弗萊琪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430501,
					"content": "#謝謝{F#妳}{M#你}，明明離開蒙德沒多久，但我就是想家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430502
					],
					"speakerTitle": "傑里"
				},
				{
					"id": 413430502,
					"content": "也不知道家裡人現在怎麼樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430503
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430503,
					"content": "唔，那我們正好趁這個機會…姐姐，妳有什麼心願嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430504
					],
					"speakerTitle": "傑里"
				},
				{
					"id": 413430504,
					"content": "我？我想一想啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430505
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430505,
					"content": "#這樣應該就可以了，旅行者，我還有件事想拜託{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430506
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430506,
					"content": "蒲公英籽要在高處播撒才好，可是璃月的建築和蒙德區別好大，而且我和傑里也不知道怎麼去高處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430507
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430507,
					"content": "#可以請{F#妳}{M#你}幫我們去高處播撒這些蒲公英嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430508
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430508,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430509
					]
				},
				{
					"id": 413430509,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗萊琪"
				}
			]
		},
