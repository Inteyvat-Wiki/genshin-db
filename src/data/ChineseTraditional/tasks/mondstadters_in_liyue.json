			"dialogs": [
				{
					"id": 413430601,
					"content": "姐姐，我們什麼時候能回蒙德一趟啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430602
					],
					"speakerTitle": "傑里"
				},
				{
					"id": 413430602,
					"content": "嗯…再過一會吧，我們才剛出來沒多久呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗萊琪"
