			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"弗萊琪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430301,
					"content": "#謝謝{F#妳}{M#你}，接下來是不是就該把願望寫在霄燈上了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430302
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430302,
					"content": "嗯…原來如此，讓我想想該寫點什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430303
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430303,
					"content": "這樣應該就可以了。說起來，讓霄燈帶著願望飛上天空…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430304
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430304,
					"content": "我們在蒙德的時候，也會把心事說給蒲公英聽，然後把蒲公英籽撒在風中…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430305
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430305,
					"content": "這麼一說，我還挺想蒙德的，也好久都沒看見蒲公英了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430306
					],
					"speakerTitle": "傑里"
				},
				{
					"id": 413430306,
					"content": "#旅行者，能再麻煩{F#妳}{M#你}幫我們找些蒲公英籽來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430307
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430307,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430308
					]
				},
				{
					"id": 413430308,
					"content": "#那太好了，謝謝{F#妳}{M#你}願意幫忙。找到蒲公英籽直接拿給我們就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗萊琪"
				}
			]
		},
