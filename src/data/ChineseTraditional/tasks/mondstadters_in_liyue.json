			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"弗萊琪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413430101,
					"content": "可是霄燈到底怎麼做啊…姐姐，妳知道嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430102
					],
					"speakerTitle": "傑里"
				},
				{
					"id": 413430102,
					"content": "我不知道啊，唔…能不能拜託人幫我們去做呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430103
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430103,
					"content": "你們也想放霄燈嗎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430104
					]
				},
				{
					"id": 413430104,
					"content": "啊，是旅行者嗎。嗯…放霄燈嗎，我是挺好奇的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430105
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430105,
					"content": "我們本來是打算先去試試海燈節特色小吃的，但傑里說，他還是想要先放盞霄燈，感受一下海燈節的氛圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430106
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430106,
					"content": "是…是這樣！要先融入節日的氛圍，再嘗試節日的美食，這樣才能有最全面的感受嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430107
					],
					"speakerTitle": "傑里"
				},
				{
					"id": 413430107,
					"content": "而且我聽說放霄燈還可以許願什麼…可是我們倆誰都不知道怎麼做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430108
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430108,
					"content": "#旅行者，能麻煩{F#妳}{M#你}幫我們做一盞霄燈嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413430109
					],
					"speakerTitle": "弗萊琪"
				},
				{
					"id": 413430109,
					"content": "交給我了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413430110
					]
				},
				{
					"id": 413430110,
					"content": "#那就拜託{F#妳}{M#你}了，我們就在這等著{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "弗萊琪"
				}
			]
		},
