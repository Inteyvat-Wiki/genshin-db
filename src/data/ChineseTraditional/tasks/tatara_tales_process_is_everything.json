			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"澤維爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721180401,
					"content": "太好了，讓我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180402
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721180402,
					"content": "我們的運氣還不錯，「御影爐心」的狀態很穩定，而且周圍的「祟神」能量也不算太濃重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180403
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721180403,
					"content": "這種濃度的話，我的那架裝置應該還能撐得住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180404
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721180404,
					"content": "是要淨化掉所有「祟神」能量嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721180405
					]
				},
				{
					"id": 721180405,
					"content": "這台裝置如果能做到這種程度的事情的話，我早該提交專利申請了。這位新夥計頂多只能降低局部區域的能量指標而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180406
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721180406,
					"content": "不過，「御影爐心」之所以停機，連自動重啟程式也無法執行，就是因為被高濃度的「祟神」能量包裹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180407
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721180407,
					"content": "只要我們去找到「祟神」濃度最高的地方，淨化掉它，讓核心重新運轉起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180408
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721180408,
					"content": "然後，「御影爐心」應該就會重啟。再之後，就沒有我們需要操心的事情了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721180409
					],
					"speakerTitle": "澤維爾"
				},
				{
					"id": 721180409,
					"content": "這就是我全部的計畫，在那之前，我還得再做些準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "澤維爾"
				}
			]
		},
