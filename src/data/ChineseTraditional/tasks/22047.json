			},
			"dialogs": [
				{
					"id": 220470101,
					"content": "又沒射中…到底是哪裡出了問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470102
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470102,
					"content": "你還在練習射箭嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470103
					]
				},
				{
					"id": 220470103,
					"content": "您是上次的…多謝您上次為我做射箭的示範！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470104
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470104,
					"content": "多虧了您，我已經…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470105,
						220470106
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470105,
					"content": "能百發百中了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				},
				{
					"id": 220470107,
					"content": "呃，倒也沒有到這種地步…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470108
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470108,
					"content": "不過，現在我射出的十支箭裡，已經有五支能上靶了…這都是多虧了您的示範。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470109
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470109,
					"content": "雖然離教官的要求還有一段距離，但我還是會繼續努力的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470110
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470110,
					"content": "對了，既然您在這裡，能再為我示範嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470111
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470111,
					"content": "有了您的示範，我一定能進步得更快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470112,
						220470114
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470112,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470113
					]
				},
				{
					"id": 220470113,
					"content": "謝謝您，我一定會認真學習的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470120
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470120,
					"content": "示範的事情就拜託您了，我一定會認真學習的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "正二"
				},
				{
					"id": 220470114,
					"content": "上次的問題都解決了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470115
					]
				},
				{
					"id": 220470115,
					"content": "您是說…姿勢不標準、力氣不夠大、握弓的手不夠穩…那些問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470116
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470116,
					"content": "老實說，我還在一步步地解決它們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470117
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470117,
					"content": "不過除了這些問題之外，我更擔心的是…如果真的上了戰場，我還能把學習到的技藝發揮出來嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470118
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470118,
					"content": "咳，但在煩惱這些問題之前，我還是得先鍛煉好我的武藝才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470119
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470119,
					"content": "示範的事情就拜託您了，我一定會認真學習的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "正二"
				},
				{
					"id": 220470106,
					"content": "能百步穿楊了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470107
					]
				}
			]
		},
