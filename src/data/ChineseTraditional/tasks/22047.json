			"dialogs": [
				{
					"id": 220470401,
					"content": "您的射箭技藝，還是和之前一樣精湛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470402
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470402,
					"content": "看清楚了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470403
					]
				},
				{
					"id": 220470403,
					"content": "是的，無論是您握弓的姿勢，還是您拉弓的方法…我都認真看清楚了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470404
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470404,
					"content": "但是，怎麼說呢…愈是看您的示範，愈能感覺到我和您之間的差距，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470405
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470405,
					"content": "先、先不說這些了，這些東西請您收下，多謝您願意為我示範。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470406
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470406,
					"content": "我等會就回去自己接著訓練了，下次的目標，就定在…十支箭裡上靶七箭吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "正二"
				}
			]
		}
