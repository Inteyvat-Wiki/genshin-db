			"dialogs": [
				{
					"id": 220470301,
					"content": "怎麼了，您剛才射箭的時候，好像出了點失誤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220470302
					],
					"speakerTitle": "正二"
				},
				{
					"id": 220470302,
					"content": "能重新佈置一下標靶嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220470303
					]
				},
				{
					"id": 220470303,
					"content": "沒問題，我這就去佈置標靶，等會您直接過去就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "正二"
				}
