			},
			"dialogs": [
				{
					"id": 100080101,
					"content": "雷澤——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080102,
					"content": "#聞到了，熟悉的氣味，原來是{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080103
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080103,
					"content": "最近，還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080104
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080104,
					"content": "嘿嘿，一切都好。對了雷澤，怎麼王狼一見到我們就消失了？你們在討論什麼秘密呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080105,
					"content": "要開始狩獵，我在說服…領主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080106
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080106,
					"content": "打獵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080107,
					"content": "#（對了，{NICKNAME}，難道這就是雷澤的「課題」嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080108,
					"content": "雷澤，難道是狼群又沒有吃的東西，所以大家要開始打獵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080109,
						100080110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080109,
					"content": "請給我捕獸夾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				},
				{
					"id": 100080111,
					"content": "不，不是…這次的打獵，不是為了填飽肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080112
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080112,
					"content": "而是為了，殺死敵人。漆黑的狼群，侵佔的領土…發出奇怪的臭味，越來越濃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080113
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080113,
					"content": "要淨化森林…狩獵敵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080114
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080114,
					"content": "所以，王狼答應了嗎？我還記得那個時候王狼還說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080115,
					"content": "我想想，是怎麼說的…咳咳…「雷澤，你不准參與討伐。因為這是狼的問題。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080117
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080117,
					"content": "啊，我不是故意的…對不起，雷澤…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080118,
					"content": "沒關係，因為我和「盧皮卡」在一起，而且，師父告訴了我，和領主說話的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080119
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080119,
					"content": "麗莎說的…和領主說話的方法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080120,
					"content": "啊，我明白了，是說服王狼的辦法吧！所以你剛才已經說服王狼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080121,
					"content": "嗯，說話很累，可是，成功了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080122
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080122,
					"content": "居然能夠說服那個頑固的大傢伙，了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080123,
					"content": "漆黑的狼，是世界的敵人。師父說，這不是狼的問題，而是世界的問題…師父是對的，領主也承認了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080124
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080124,
					"content": "不過，因此，狼群不會參與，是「我」與「漆黑狼群」的戰爭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080125
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080125,
					"content": "嘿嘿，那就讓我們也一起幫忙吧！那些奇怪的獸境獵犬，我們也早就看不順眼啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080126,
					"content": "#謝、謝謝…如果，有{F#妳}{M#你}們的幫助，一定能順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080127
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080127,
					"content": "不過，要怎麼開始狩獵呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080128,
					"content": "我們要，像把獵物趕到陷阱，把漆黑狼群，趕到這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080129
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080129,
					"content": "領主會，困住他們，我們來…把牠們解決掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080130
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080130,
					"content": "…準備好，跟我說一聲，就開始，狩獵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080401
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080401,
					"content": "現在就出發吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 100080110,
					"content": "林豬長得夠大了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100080111
					]
				}
			]
		},
