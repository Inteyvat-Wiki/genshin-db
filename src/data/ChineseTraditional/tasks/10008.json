							2107.804,
							254.285,
							-402.662
						],
						"pointId": 6
					}
				]
			},
			"dialogs": [
				{
					"id": 100080301,
					"content": "好險！幸好有狼群的幫忙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080302,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080303
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080303,
					"content": "牠們也拖住了很多獸境獵犬…甚至，在幫我們驅趕敵人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080304,
					"content": "可是，這不是狼的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080305
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080305,
					"content": "嘿嘿，就像雷澤想要幫助「盧皮卡」，「盧皮卡」又怎麼會讓你陷入危險呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080306,
					"content": "也許牠們向北風的王狼說：「哼哼，這不是『盧皮卡』的問題，這是世界的問題！」然後就跑過來幫忙啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100080307,
					"content": "嗯，「盧皮卡」，就是，「盧皮卡」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080308
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080308,
					"content": "我是人類中的「盧皮卡」，我不用是狼，但是…只要是能夠幫到「盧皮卡」，就是好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100080309
					],
					"speakerTitle": "雷澤"
				},
				{
					"id": 100080309,
					"content": "說得對，雷澤！",
					"roleType": "TALK_ROLE_NPC",
