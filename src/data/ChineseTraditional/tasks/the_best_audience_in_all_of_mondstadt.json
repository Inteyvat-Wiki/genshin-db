					"speakerTitle": "傑克"
				},
				{
					"id": 200630317,
					"content": "我得多幹點活，總不能只指望班尼特，那傢伙也很辛苦啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑克"
				}
			]
