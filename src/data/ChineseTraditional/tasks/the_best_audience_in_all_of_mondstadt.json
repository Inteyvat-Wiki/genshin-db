				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"傑克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630301,
					"content": "真想到處去冒險啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630302
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630302,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630303
					]
				},
				{
					"id": 200630303,
					"content": "昨天史丹利先生又跟我講了個故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630304
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630304,
					"content": "但是他喝得有點多，故事講得顛三倒四，我回憶回憶…應該是在<color=#00E1FFFF>晨曦酒莊附近</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630305
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630305,
					"content": "他應該是這麼說的…「…不祥在那怪物的身上結成了冰晶，惡意讓那怪物的身軀更加碩大，很快，恐懼凍結了我的雙腿，我胡亂揮舞著武器，砍下的冰屑卻只是迷住了我的眼睛…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630306
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630306,
					"content": "到底是什麼怪物，居然能讓史丹利先生都陷入苦戰呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630307
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630307,
					"content": "真想去親眼看看…但是如果我去的話，應該只顧得上逃跑吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630308
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630308,
					"content": "#不過，如果是{F#妳}{M#你}，應該就沒問題了，{F#妳}{M#你}願意幫我去找一找嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630309,
						200630311
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630309,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630310
					]
				},
				{
					"id": 200630310,
					"content": "#那就拜託{F#妳}{M#你}了！找到之後，回來詳細和我說說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630311,
					"content": "一起去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630312
					]
				},
				{
					"id": 200630312,
					"content": "#我是很想一起去啦，但是冒險家協會的情況…{F#妳}{M#你}也看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630313
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630313,
					"content": "賽琉斯先生一副要退休的樣子，老是說要去清泉鎮悠閒度日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630314
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630314,
					"content": "赫爾曼先生自從有了女兒，連蒙德城都不出了，虧他之前還是王牌冒險家…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630315
					],
