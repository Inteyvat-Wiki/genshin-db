				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"傑克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200630201,
					"content": "我到底什麼時候才能成為偉大的冒險家啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630202
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630202,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630203
					]
				},
				{
					"id": 200630203,
					"content": "#哦，是{F#妳}{M#你}啊…賽琉斯先生昨天和我講了一個冒險故事…這回是在<color=#00E1FFFF>望風山地</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630204
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630204,
					"content": "他是這麼說的：「…那面粗糙的盾牌就像是一場我無力抵抗的噩夢，無論我的劍如何敲打，那面盾牌都不為所動，而在盾牌後面，那個怪物輕蔑地瞪著我，它咿呀的笑聲正譏諷著我的無力…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630205
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630205,
					"content": "無論是什麼攻擊都能抵抗的木盾…唉，我真想去親眼看看哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630206
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630206,
					"content": "但是這麼多雜活，怎麼想都抽不開身…到底是什麼恐怖的怪物，才會拿著這種東西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630207
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630207,
					"content": "#嗯…如果{F#妳}{M#你}願意的話，能幫我去找找那個怪物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630208,
						200630210
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630208,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630209
					]
				},
				{
					"id": 200630209,
					"content": "#太謝謝{F#妳}{M#你}了，找到之後，就回來和我具體講講吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630210,
					"content": "我和你一起去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200630211
					]
				},
				{
					"id": 200630211,
					"content": "我？不行啦，冒險家協會裡還有很多雜事等著我做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630212
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630212,
					"content": "現在冒險活動實在不怎麼賺錢，所以雖然說是冒險家協會，實際大部分時候都在到處幫人忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630213
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630213,
					"content": "比如幫杜拉夫先生趕野豬啦，幫瑪格麗特小姐找貓啦，芙蘿拉小姐今天想要幾朵新鮮的花啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200630214
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 200630214,
					"content": "哈哈哈，加入冒險家協會的時候，我可沒想到等著我的會是這些「冒險」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傑克"
				}
			]
		},
		{
			"id": 2006303,
			"completionStepIds": [
				2006301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
