						],
						"pointId": 42
					}
				]
			},
			"dialogs": [
				{
					"id": 402270101,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270102
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402270102,
					"content": "妳們好啊，愛諾、伊涅芙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270103,
					"content": "#{F#妳}{M#你}們好，{NICKNAME}、派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270104
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270104,
					"content": "我們接了奈芙爾的委託，負責與參展方接洽，叮鈴哐啷蛋捲工坊也參加了這次展會吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270105,
					"content": "是的，愛諾正在對「劈哩啪啦守衛團」進行最後一次調整。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270106
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270106,
					"content": "劈哩啪啦…哦，這就是工坊準備的參展貨物吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270107,
					"content": "總有鼴鼠之類的動物來工坊偷東西，愛諾就仿照牠們的形象製作了一套防衛機關，用來保護工坊的資產。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270108
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270108,
					"content": "愛諾之前進行過一次測試，測試結果為「非常有效」，於是愛諾將它們全面升級，準備用來參展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270109
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270109,
					"content": "愛諾準備交易自己的作品？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270110,
					"content": "除了直接來自工坊外的訂單，愛諾極少直接出售自己的作品，她準備在展會上交易的是設計圖紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270111
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270111,
					"content": "原來是這樣…對了，妳們準備好去展會那邊了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270112,
					"content": "#雅珂達專門拜託我和{NICKNAME}來催妳們，她為妳們預留了一個很好的展位，一直空著的話會出問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270113,
					"content": "不是已經跟她說過了嗎？必須全部調整好才能搬過去！再著急也沒有用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270114
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402270114,
					"content": "哇，難得見到愛諾這麼認真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270115,
					"content": "最近工坊的確遭遇了重大的資金短缺問題，愛諾希望能透過這次展會改善經濟狀況，這種謹慎是合乎邏輯的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270116
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270116,
					"content": "資金短缺？難道愛諾在搞什麼耗資巨大的研究？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270117,
					"content": "短缺的並不是「研究資金」，是「甜品資金」。在過往的紀錄中，共有47次因超額採購甜品而導致研究資金出現缺口的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270118
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270118,
					"content": "後來，從工坊經營的角度考慮，我將「研究資金」與「甜品資金」進行了區分，並禁止愛諾隨意挪用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270119
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270119,
					"content": "而就在不久前，愛諾把整整一個月份額的「甜品資金」都用完了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270120,
						402270121
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270120,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				},
				{
					"id": 402270122,
					"content": "完工！劈哩啪啦守衛團，好好表現！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270123
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402270123,
					"content": "請帶我們去會場吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270121,
					"content": "我不意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						402270122
					]
				}
			]
		},
