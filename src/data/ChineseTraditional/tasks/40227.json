			},
			"dialogs": [
				{
					"id": 402270201,
					"content": "#愛諾和伊涅芙在{F#妳}{M#你}們的帶領下來到展會現場。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						402270202
					]
				},
				{
					"id": 402270202,
					"content": "唔…演示平臺就放在這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270203
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402270203,
					"content": "愛諾新設計的防衛機關…說實話，我滿好奇的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270204,
					"content": "#{NICKNAME}和派蒙隨時都可以過來玩，我的作品絕不會讓{F#妳}{M#你}們失望的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270205
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402270205,
					"content": "#辛苦{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270206
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270206,
					"content": "不客氣！對了，工坊這邊的參展人員就登記愛諾和伊涅芙囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402270207,
					"content": "嗯…愛諾並不能被界定為參展人員，她不喜歡太熱鬧的氛圍，等展會正式開始後就會返回工坊，我會在這裡幫她盯著展位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402270208
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402270208,
					"content": "想來也是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}