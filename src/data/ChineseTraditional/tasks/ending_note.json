			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960001,
					"content": "襲擊你們的人…是「愚人眾」？真過分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960002
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960002,
					"content": "琴團長剛才回騎士團總部了，說是要想辦法找出證據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960003
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960003,
					"content": "但如果他們沒有留下痕跡，騎士團可能也很難對他們提出指控吧…琴團長是這麼說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				}
			]
		},
		{
			"id": 39602,
			"completionStepIds": [
				39602
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39602",
							"2"
						],
						"stepId": 39602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960201,
					"content": "這位就是教會方面負責回收天空之琴的專員，祈禮牧師芭芭拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960202
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3960202,
					"content": "願風神護佑你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960203
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960203,
					"content": "雖然比起代理團長，我可能沒資格說這話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960204
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960204,
					"content": "但，我還是要替蒙德感謝各位的努力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960205
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960205,
					"content": "幸虧是和平解決！如果真的調動軍力與龍開戰，很難想像要怎樣收場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960206
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960206,
					"content": "而且，「愚人眾」那邊也不能多說什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960207
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3960207,
					"content": "事情變成這樣，他們一定在暗中氣惱吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960208
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3960208,
					"content": "這一次，他們失去了向西風騎士團施壓的最佳藉口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960209
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3960209,
					"content": "只印證了至冬國使臣蠻橫無理的形象，卻沒有得到實際的外交進展呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960210
					],
					"speakerTitle": "琴"
				},
				{
					"id": 3960210,
					"content": "好啦，所以你們把天空之琴帶來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960211
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960211,
					"content": "代理團長的擔保也不是無限的，樞機大人已經催了一陣子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960212
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960212,
					"content": "倒…倒是帶來了，只不過…嗯…這個…稍微有點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960213,
					"content": "嗯？放心，不會收你們租金的，教會一直有專門的供奉撥款…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芭芭拉"
				}
			]
		},
		{
			"id": 39605,
			"completionStepIds": [
				39605
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39605",
							"2"
						],
						"stepId": 39605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭芭拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960501,
					"content": "#呀！榮譽騎士，{F#妳}{M#你}醒啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960502,
						3960505
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960502,
					"content": "溫迪…他沒事吧？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960503
					]
				},
				{
					"id": 3960503,
					"content": "唔…他的狀態，說不上是「沒事」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960504
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960504,
					"content": "#剛才我發現{F#妳}{M#你}們暈倒在教堂外，就用元素力為{F#妳}{M#你}們治療…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960510,
					"content": "那位詩人是先醒的，但奇怪的是，我的治療對他的傷幾乎沒有效果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960511
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960511,
					"content": "這種病人，我還是第一次遇見。他自己卻說著「這很正常」之類的話，想要離開教堂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960512
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960512,
					"content": "離開？他去了哪裡啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960513,
					"content": "<color=#00E1FFFF>「蒙德英雄的象徵」</color>…他是這麼說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960514
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960514,
					"content": "我想阻止他，但琴…琴團長卻說，「讓他去吧」。好奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960515,
						3960516
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960515,
					"content": "（我大概明白為什麼了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960517,
					"content": "我記得以前，溫迪也在<color=#00E1FFFF>那棵樹</color>下療過傷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960518,
					"content": "（是因為風神和風起地之間的聯繫吧，琴團長應該也猜到了，但不能和芭芭拉說呢…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960516,
					"content": "（琴大概也明白為什麼了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960517
					]
				},
				{
					"id": 3960505,
					"content": "這是…哪個星球…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960506
					]
				},
				{
					"id": 3960506,
					"content": "星球？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960507
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960507,
					"content": "#啊！芭芭拉小姐不要聽{F#她}{M#他}說胡話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960508,
					"content": "#咦？嗯…好的，總之，剛才我發現{F#妳}{M#你}們暈倒在教堂外，就用元素力為{F#妳}{M#你}們治療…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960509
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 3960509,
					"content": "#看來她應該多給{F#妳}{M#你}澆點水，幫{F#妳}{M#你}清醒一下腦子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960510
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 39606,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"39604",
							"2"
						],
						"stepId": 39604,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960601,
					"content": "樹間的風很好，有我喜歡的氣味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960602
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960602,
					"content": "哈哈，上次我也是這麼說的呢。唉，為什麼每次說這句話，都是在運氣不順的時候呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960603
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960603,
					"content": "所以…什麼是「神之心」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960604
					]
				},
				{
					"id": 3960604,
					"content": "#…{F#妳}{M#你}注意到了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960605
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960605,
					"content": "#唉…這本來不是能和普通人談論的話題。但，悄悄告訴{F#妳}{M#你}也沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960606
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960606,
					"content": "#{F#妳}{M#你}應該知道，「神之眼」是這世上極少數人才擁有的外置魔力器官。他們透過「神之眼」來引導元素力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960607
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960607,
					"content": "其實，每一位「神之眼」的擁有者，都是有資格成神的人，因此被稱作「原神」，擁有登上天空島的資格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960608
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960608,
					"content": "「原神」？以前好像從來沒聽過這個詞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960609,
					"content": "哼哼，因為這是真正神靈才知道的秘密呀。總之，我們是不需要「神之眼」這種初級器官的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960610
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960610,
					"content": "作為替代，神靈的魔力器官與天空島共鳴相連…也就是「神之心」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960611
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960611,
					"content": "那你腰上掛的這個是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960612
					]
				},
				{
					"id": 3960612,
					"content": "欸嘿。只是發光的玻璃球而已，用來避免無謂的猜疑啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960613,
						3960614
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960613,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				},
				{
					"id": 3960615,
					"content": "那麼，剛才那個見面就把我吹飛、還搶走溫迪「神之心」的壞女人，到底是誰…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960616,
					"content": "她是「女士」——愚人眾十一執行官的第八席，代號「女士」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960617
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960617,
					"content": "愚人眾的每一位執行官，都像她一樣，被至冬國的女皇賜予了神靈般的權柄，獲得超越了凡人的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960618
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960618,
					"content": "至冬國的…女皇？那不就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960619,
					"content": "嗯，七神之一，端坐於至冬宮的「冰之女皇」，全體愚人眾執行官的唯一效忠對象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960620
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960620,
					"content": "雖然七神之間的關係，並不全都非常融洽，但我也沒想到，她居然正在謀奪其他神靈的「神之心」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960621
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960621,
					"content": "冰之女皇是怎樣的神？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960622
					]
				},
				{
					"id": 3960622,
					"content": "啊…該怎麼說呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960623
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960623,
					"content": "我認識「五百年前的她」，但對「現在的她」已經很陌生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960624
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960624,
					"content": "五百年前的一場大災之後，她就斷絕了和我的一切交流…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960625
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960625,
					"content": "不過，有關冰之神和愚人眾的事，還是過一會再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960626
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960626,
					"content": "#{NICKNAME}，{F#妳}{M#你}要尋找全部七神，旅途中恐怕還有許多艱難之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960627
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960627,
					"content": "先往蒙德的鄰國去吧——那裡的「岩」之神與我不同，親自治理著「璃月」全境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960628
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960628,
					"content": "他每年只會正式降臨一次，賜下神諭，指引這一年裡經營璃月的方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960629
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960629,
					"content": "即使是這樣，聽起來工作頻率也比某位大人高多了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960630,
					"content": "欸嘿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960631
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960631,
					"content": "…總之，今年的「請仙典儀」好像就快開始了。嗯，錯過的話，就要再等一整年囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960632
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960632,
					"content": "#哇？！這麼重要的訊息怎麼不早說？那就再見了，{NICKNAME}，我們快走——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960633,
					"content": "等一等，「捕風的異鄉人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960634,
						3960636
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960634,
					"content": "是在叫我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960635
					]
				},
				{
					"id": 3960635,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960638,
					"content": "#旅行者…當{F#妳}{M#你}重新踏上旅途之後，一定要記得旅途本身的意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960639
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960639,
					"content": "#提瓦特的飛鳥、詩歌和城邦，女皇、愚人和怪物…都是{F#妳}{M#你}旅途的一部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960640
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960640,
					"content": "#終點並不意味著一切。在抵達終點之前，用{F#妳}{M#你}的眼睛，多多觀察這個世界吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960641,
						3960642
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960641,
					"content": "溫迪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960643,
					"content": "嗯！風神的告誡到此為止！接下來是溫迪時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960642,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960643
					]
				},
				{
					"id": 3960636,
					"content": "不好意思，擅自借用了七天神像的風…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960637
					]
				},
				{
					"id": 3960637,
					"content": "哈哈，心懷感激地用吧——能請我一杯蒲公英酒就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960638
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960614,
					"content": "又欺騙感情，但我已經習慣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960615
					]
				}
			]
		},
		{
			"id": 39608,
			"completionStepIds": [
				39604
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 3960701,
					"content": "想多聊些什麼的話，就趁現在聊吧。因為吟遊詩人，可不會總在同一個地方駐唱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960702,
						3960707,
						3960715,
						3960727,
						3960741
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960702,
					"content": "關於特瓦林…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960703
					]
				},
				{
					"id": 3960703,
					"content": "特瓦林…到最後也還記得「四風守護」的職責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960704
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960704,
					"content": "所以，我也並不打算強行卸下他身上的責任、把我理解的「自由」強塞給他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960705
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960705,
					"content": "——而是希望，特瓦林能自己選擇、自己理解，何為自由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960706
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960706,
					"content": "因為我在成神之前，也是這樣被一個朋友…教導了「何為自由」的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960707,
					"content": "關於深淵教團…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960708
					]
				},
				{
					"id": 3960708,
					"content": "#嗯？{F#妳}{M#你}說凱亞的情報…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960709
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960709,
					"content": "#…原來如此，深淵教團裡有一位「{F#王子}{M#公主}」，主導了腐化特瓦林的計畫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960710
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960710,
					"content": "#看來是想把特瓦林改造成深淵的戰爭兵器吧。話說回來，我可從沒聽說過，深淵教團裡有什麼「{F#王子}{M#公主}」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960711,
						3960712
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960711,
					"content": "看來那不是教團的古老傳承。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960713,
					"content": "我想也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960714
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960714,
					"content": "#但最近才出現的「{F#王子}{M#公主}」，又為什麼能走上統領深淵教團的位置呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960712,
					"content": "看來是最近才出現的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960713
					]
				},
				{
					"id": 3960715,
					"content": "關於「女士」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960716
					]
				},
				{
					"id": 3960716,
					"content": "剛才的愚人眾執行官，搶走「神之心」以後，馬上就離開了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960717
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960717,
					"content": "這是為了避免出現「騎士團的目擊證人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960718
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960718,
					"content": "畢竟這種事要是留下把柄，就等於公開毀滅與西風騎士團的外交關係了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960719
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960719,
					"content": "做出這種事來，卻還好意思繼續當蒙德的盟友嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960720,
					"content": "唉…面對深淵教團的威脅，人類的七國本該結成聯盟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960721
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960721,
					"content": "「愚人眾」擁有七國最強的武力，卻用來盜竊天空之琴、覬覦神力、借龍災對騎士團施壓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960722
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960722,
					"content": "啊，說到「天空之琴」…那時，好像聽迪盧克提過這個名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960723,
					"content": "他說，「愚人眾」能夠橫行七國、威脅西風騎士團，完全是由於這十一位執行官的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960724,
					"content": "是的，就像我剛才說的，他們被冰之神賜予了權柄，獲得了超越凡人的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960725
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960725,
					"content": "「冰之女皇」…五百年沒見了，她究竟在想什麼呢？又在計劃著什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960726
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960726,
					"content": "#這件事的答案，或許也會對{F#妳}{M#你}尋找七神的旅途，產生未知的影響吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960727,
					"content": "關於神靈…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960728
					]
				},
				{
					"id": 3960728,
					"content": "剛才說過，「神之眼」的擁有者，被世界稱作「原神」，擁有登上天空島的資格。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960729
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960729,
					"content": "「神之心」是更高位的元素控制中樞，是七神之座的象徵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960730
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960730,
					"content": "#對不起，我不知道是七神中的哪一位，帶走了{F#妳}{M#你}的{F#哥哥}{M#妹妹}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960731
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960731,
					"content": "呀，話說回來，身為七神之一，我自己的嫌疑都還沒洗清…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960732,
						3960734
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960732,
					"content": "你長得和那個神一點都不像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960733
					]
				},
				{
					"id": 3960733,
					"content": "可是，「賣唱的」只是化身形象，不能作為判斷依據——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960734,
					"content": "相處這麼久，不用繼續懷疑了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960735
					]
				},
				{
					"id": 3960735,
					"content": "#啊哈哈，我們確實是很好的搭檔呢。等{F#妳}{M#你}找回{F#哥哥}{M#妹妹}，有沒有興趣來當新的「四風守護」啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960736
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960736,
					"content": "也許…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960737
					]
				},
				{
					"id": 3960737,
					"content": "#嗯？{NICKNAME}，{F#妳}{M#你}好像不太熱衷的樣子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960738
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960738,
					"content": "那麼賣唱的！如果當了「四風守護」就有民眾供奉好吃的話，不如考慮一下…我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3960739,
					"content": "哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3960701
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3960741,
					"content": "沒別的事了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3960742
					]
				},
				{
					"id": 3960742,
					"content": "那麼，就往<color=#00E1FFFF>璃月</color>去吧。錯過今年的「請仙典儀」的話，就要再等一整年囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		}
	]
}