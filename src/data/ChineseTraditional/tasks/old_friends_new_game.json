			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶",
					"貝爾福"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735070101,
					"content": "#「黃金流星」{NICKNAME}和「白銀伴星」派蒙，好久不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070102
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070102,
					"content": "#{F#妳}{M#你}們還是這麼有精神呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070103,
						735070106
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070103,
					"content": "別來無恙！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070104
					]
				},
				{
					"id": 735070104,
					"content": "海海海…海妮耶！還有那個超負責的…貝爾福先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070105,
					"content": "真沒想到，居然又在奧摩斯港遇見你們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070114,
					"content": "話說回來，海妮耶和貝爾福在這裡做什麼呢？我記得這裡以前是「花花瓊脂」的攤位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070115,
					"content": "#兩位大英雄，聽著{F#妳}{M#你}們的聲音，我也更放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070116
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070116,
					"content": "接下來，就是我向兩位彙報工作成果的時候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070117
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070117,
					"content": "之前兩位作為「月蓮盃馴獸師大賽」的冠軍，決定讓大賽暫時休賽，先讓教令院改進「意智寶珠」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070118
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070118,
					"content": "兩位應該還在等待通知？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070119
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070119,
					"content": "對哦！等到有進展了，萊依拉、賽諾或者負責的學者應該會想辦法告訴我們的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070120,
						735070121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070120,
					"content": "派蒙不博學，聽不懂技術。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070122,
					"content": "道理的確是這樣啦，我們主動去問也幫不上什麼忙，說不定反而會干擾他們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070123,
					"content": "#{F#妳}{M#你}們還真是沉得住氣，作風謹慎！我就經常回想起上次大賽的盛況，根本按捺不住…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070124
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070124,
					"content": "所以前陣子，我設法詢問了教令院的相關人士，得到了詳細的答覆——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070125
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070125,
					"content": "目前，「意智寶珠」的改進還處於理論攻克階段，距離投入生產，還需要不少時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070126
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070126,
					"content": "但第一屆大賽的討論度正在降低，甚至慢慢被人們遺忘。不能就這樣浪費了大賽的影響力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070127
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070127,
					"content": "因此，我找到了海妮耶小姐，一起籌備了新的「話題活動」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070128
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070128,
					"content": "「話題活動」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070129
					]
				},
				{
					"id": 735070129,
					"content": "難道說的是，桌上擺著的這些…蕈獸模樣的棋子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070130,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070131
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070131,
					"content": "貝爾福先生一直在為下次大賽準備新內容的方案，到處籌措資金，還前往璃月學習了新的商業門道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070132
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070132,
					"content": "他在璃月學習商業經營時，接觸到了一種遊戲，名為「機關棋譚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070133
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070133,
					"content": "貝爾福先生買下了「機關棋譚」在須彌的代理權，請我來當顧問，一起規劃了全新的遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070134
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070134,
					"content": "它的名字是「靈蕈棋陣」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070135
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070135,
					"content": "「靈蕈棋陣」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070136,
					"content": "讓我來猜猜…難道這次是要我們指揮蕈獸，去和各種機關較量嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070137,
					"content": "不愧是「白銀伴星」，一下子就猜到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070138
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070138,
					"content": "我覺得，這種遊戲易於理解，便於推廣，有很大的潛力可供發掘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070139
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070139,
					"content": "要是讓它以「馴獸師大賽」衍生遊戲的名義流行起來，就能讓人們長期記住大賽，心懷期待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070140
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070140,
					"content": "如此一來，下一屆大賽舉辦時，就會有更多選手參賽，更多觀眾前來捧場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070141
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070141,
					"content": "#當然，這一切還要{F#妳}{M#你}們兩位點頭許可。畢竟，現在大賽的一切都由{F#妳}{M#你}們說了算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070142,
						735070143
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070142,
					"content": "我覺得值得一試！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070144,
					"content": "#對哦，我和{NICKNAME}不懂商業上的門道，聽貝爾福先生這麼一說，我覺得很有道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070145,
					"content": "這是海妮耶和貝爾福先生共同努力的結果，我相信你們的才能，請儘管去做吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070146,
					"content": "雖然還沒開始玩，但我能肯定，一定會有許多人喜歡的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070147,
					"content": "#太好了，能得到{F#妳}{M#你}們兩位的允許，我就可以放手推廣「靈蕈棋陣」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070148
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070148,
					"content": "目前「靈蕈棋陣」還處於測試階段，需要請人試玩、收集建議，不斷改良。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070149
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070149,
					"content": "精通數十種提瓦特流行遊戲的「黃金流星」玩過以後，肯定能給出最精準的建議！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070150
					],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070150,
					"content": "#那就上吧，{NICKNAME}！這可是{F#妳}{M#你}最擅長的領域之一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070151,
						735070152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070151,
					"content": "怎麼有種被妳指揮的感覺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070153,
					"content": "不過，我還有一件事想問問海妮耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070154
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070154,
					"content": "是「咚咚小圓帽」它們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070155
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070155,
					"content": "對對對！我好想念蕈獸夥伴們，它們現在怎麼樣了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070156
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070156,
					"content": "放心吧，它們都健健康康，每天生活得無憂無慮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070157
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070157,
					"content": "「轉轉悠悠獸」和「百雷遮羅」待在我在<color=#00E1FFFF>奧摩斯港北邊的臨時住處</color>，由上次的一位參賽選手暫時照顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070158
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070158,
					"content": "「咚咚小圓帽」和「歡騰之火」就在附近。妳可以去和它們一起玩哦，「白銀伴星」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070159
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 735070159,
					"content": "#就在附近！那{NICKNAME}，等等{F#妳}{M#你}試玩新遊戲的時候，我要去找「咚咚小圓帽」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070160,
						735070161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070160,
					"content": "去吧去吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070162,
					"content": "事不宜遲，就請「黃金流星」來體驗一下早期測試版的「靈蕈棋陣」吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "貝爾福"
				},
				{
					"id": 735070161,
					"content": "我等等就跟上！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070162
					]
				},
				{
					"id": 735070152,
					"content": "好吧，「黃金流星」出擊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070153
					]
				},
				{
					"id": 735070143,
					"content": "真是讓你費心了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070144
					]
				},
				{
					"id": 735070121,
					"content": "我不懂技術，不亂提建議。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070122
					]
				},
				{
					"id": 735070106,
					"content": "你們是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070107
					]
				},
				{
					"id": 735070107,
					"content": "#{NICKNAME}，{F#妳}{M#你}在說什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070108,
					"content": "之前我們參加了「月蓮盃馴獸師大賽」，和蕈獸夥伴們玩得很開心啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070109,
					"content": "海妮耶就是我們在那時候認識的好朋友，貝爾福先生則是大賽最負責的工作人員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070110,
					"content": "#難道，就連「咚咚小圓帽」、「轉轉悠悠獸」，這些蕈獸夥伴，{F#妳}{M#你}都不記得了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735070111,
						735070112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735070111,
					"content": "哦哦！我想起來了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735070113
					]
				},
				{
					"id": 735070113,
					"content": "#真是的，{F#妳}{M#你}不要嚇我啦，不然我就要去幫{F#妳}{M#你}找醫生了哦。",
					"roleType": "TALK_ROLE_NPC",
