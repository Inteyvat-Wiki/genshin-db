					"nextDialogs": [
						400110407
					]
				},
				{
					"id": 400110407,
					"content": "海上那些東西，肯定是嘟嘟大魔王放的！他是壞人哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110408
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110408,
					"content": "不過，可莉會勇敢面對他，為了嘟嘟可，可莉會努力！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110409
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110409,
					"content": "#榮譽騎士{F#姐姐}{M#哥哥}，謝謝{F#妳}{M#你}幫可莉的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
