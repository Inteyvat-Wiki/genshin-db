					"id": 400110512,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110513
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110513,
					"content": "總之，我會打起精神做好最高程度的戒備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110514
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110514,
					"content": "琴團長，雷厲風行的時候真帥氣呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110515,
					"content": "派蒙和我也會多加留心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110516
					]
				},
				{
					"id": 400110516,
					"content": "#感謝{F#妳}{M#你}們的理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110517
					],
					"speakerTitle": "琴"
				},
				{
