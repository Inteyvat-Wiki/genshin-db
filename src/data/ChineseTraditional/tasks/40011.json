					"nextDialogs": [
						400110519
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110519,
					"content": "既然要可莉來找你，那可莉就來啦！蹦蹦炸彈，預備——！我們一起跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110520
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110520,
					"content": "那是…<color=#00E1FFFF>海中央的平台</color>？",
