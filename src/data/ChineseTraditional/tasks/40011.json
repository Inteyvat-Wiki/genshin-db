					"nextDialogs": [
						400110308
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110308,
					"content": "我特地選了跟海島氣氛比較搭的裝扮，想給大家一個驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
