			"dialogs": [
				{
					"id": 400110501,
					"content": "怎麼會有這種事，這片海域實在太神秘了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110502,
					"content": "整片陸地都升了上來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110503
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110503,
					"content": "大魔王，大魔王，哇咿！我來抓你啦，嘎——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110504
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110504,
					"content": "小可莉，永遠這麼有精神啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110505,
					"content": "地面震動之前，我有聽到類似機關的聲音。依我看，這片海面下有著非常巨大的機關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110506
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110506,
					"content": "整片海島位於機關構架出的底盤上，機關啟動，將各個島嶼一併托出水面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110507
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110507,
					"content": "這樣的事情，堪稱奇蹟…難道這是風神巴巴托斯的力量嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110508
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110508,
					"content": "應該不是吧？我總覺得這更像是某個人刻意的作為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110509,
					"content": "怎麼想都不可思議…用信件把我們引來這裡，再以這樣的機關挑戰我們，所謂的嘟嘟大魔王絕非無能之輩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110510
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110510,
					"content": "我也這麼覺得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110511
					]
				},
				{
					"id": 400110511,
					"content": "唉，假日的氣氛一下就消失了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110512
					],
					"speakerTitle": "芭芭拉"
				},
