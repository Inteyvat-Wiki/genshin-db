			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110201,
					"content": "海面上的浮標到底意味著什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110202,
						400110206
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110202,
					"content": "關於群島…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110203
					]
				},
				{
					"id": 400110203,
					"content": "這片群島與世隔絕，就像一處自然形成的祕境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110204
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110204,
					"content": "我們來這裡，既有信的指引，也有溫迪和特瓦林的幫助…一切實在太過巧合，我有些擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110205
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110205,
					"content": "#不過，我之所以會在這裡，就是為了保護各位。所以請放心，不論發生什麼事，我都會與{F#妳}{M#你}們一同面對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 400110206,
					"content": "關於夏裝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110207
					]
				},
				{
					"id": 400110207,
					"content": "啊…夏、夏裝啊，那個是…是麗莎給我準備的驚喜。我猜，應該還有芭芭拉的建議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110208
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110208,
					"content": "剛才芭芭拉也說，難得來海島，一定要換上夏裝才有氣氛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110209
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110209,
					"content": "可是，我不太習慣這樣的裝扮…唉，但願這身打扮不會太過奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				}
			]
		},
