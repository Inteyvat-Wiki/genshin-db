					"nextDialogs": [
						400110521
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110521,
					"content": "確實有東西出現了。各位，可以靠近查看，但請務必保持警戒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				}
			]
