					"nextDialogs": [
						400110405
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110405,
					"content": "雖然冬天很冷，但可莉有蹦蹦炸彈，覺得冷的話，用炸彈就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				}
			]
		},
