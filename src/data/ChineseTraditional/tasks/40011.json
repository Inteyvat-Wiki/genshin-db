			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"琴",
					"芭芭拉",
					"可莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400110101,
					"content": "唔…天氣真好，我都睡迷糊了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110102,
					"content": "早安！哇，妳們這身打扮是？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110103,
					"content": "嘿嘿，好看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110104
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110104,
					"content": "我們都換了夏裝哦！雖然來這裡並不是為了玩…無論如何都不想錯過美麗的夏日海景呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110105
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110105,
					"content": "不、不會很奇怪吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110106
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110106,
					"content": "這麼飄逸輕便的服裝，肯定不適合我…咳！失禮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110107,
						400110108
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110107,
					"content": "沒有這種事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				},
				{
					"id": 400110109,
					"content": "#是嗎…謝謝{F#妳}{M#你}，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110110
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110110,
					"content": "不過琴團長會特地準備夏裝，真叫人意外呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110111,
					"content": "不不，按照姐姐的性格才不會自己準備呢，是我和麗莎小姐為她選的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110112
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110112,
					"content": "直接脫口而出「姐姐」了…而且自己完全沒有注意到，芭芭拉已經沉醉於夏日了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110113,
					"content": "夏裝…真是說來話長啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110114
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110114,
					"content": "本以為麗莎給的袋子裡是應急妙計，沒想到，裡面居然是一套夏裝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110115
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110115,
					"content": "連配飾都帶齊了，該說不愧是麗莎嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110116,
					"content": "騎士團的各位無時無刻不想著讓我休假…看來是我平時真的把自己逼得太緊了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110117
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110117,
					"content": "大家快來可莉這邊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110118
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110118,
					"content": "是可莉的聲音！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110119
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110119,
					"content": "有奇怪的東西——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110120
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110120,
					"content": "怎麼了？奇怪的東西是指什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110121,
					"content": "#{F#妳}{M#你}們看海裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110122
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110122,
					"content": "有個奇怪的東西漂在上面哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110123
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110123,
					"content": "細長的裝置，應該是浮標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110124
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110124,
					"content": "可是，昨天在海上航行的時候，我們好像沒有看到這個裝置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110125
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110125,
					"content": "一定是嘟嘟大魔王放的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110126
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110126,
					"content": "一夜之間冒出來的奇怪裝置，不簡單哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110127,
					"content": "他一直沒來找我，是不承認我嗎…還是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110128
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110128,
					"content": "他是不是在等我，要我去找他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110129
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110129,
					"content": "突然出現在海上的浮標，會有什麼用意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110130
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110130,
					"content": "靠近看看就知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110131
					]
				},
				{
					"id": 400110131,
					"content": "是啊，光在岸上猜測也解決不了問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110132,
					"content": "可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110133
					],
					"speakerTitle": "芭芭拉"
				},
				{
					"id": 400110133,
					"content": "還是主動確認一下比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110134
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110134,
					"content": "很難說海上究竟有什麼在等著我們…以防萬一，希望大家做好戰鬥的準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110135
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110135,
					"content": "各自收拾妥當後，請到我這裡集合，我們一起坐船過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110136,
						400110137
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110136,
					"content": "不愧是大家的琴團長！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110138,
					"content": "過、過獎了，這是我的職責所在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110139
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110139,
					"content": "那麼，準備工作就拜託各位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 400110137,
					"content": "即使穿著夏裝也很可靠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110138
					]
				},
				{
					"id": 400110108,
					"content": "琴穿起來非常好看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400110109
					]
				}
			]
		},
		{
			"id": 4001102,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
