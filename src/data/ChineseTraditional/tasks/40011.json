					"nextDialogs": [
						400110605
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110605,
					"content": "「審判」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110606,
					"content": "你可以「審判」可莉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110607
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110607,
					"content": "啊——！這孩子在說什麼呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400110608,
					"content": "她根本不明白那句話的意思吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110609
					],
					"speakerTitle": "琴"
				},
				{
					"id": 400110609,
					"content": "喂，大魔王——！你怎麼不理我呀？",
