					"nextDialogs": [
						400110403
					]
				},
				{
					"id": 400110403,
					"content": "可莉喜歡夏天！但也不是只喜歡夏天…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400110404
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 400110404,
					"content": "可莉還喜歡秋天，啊對了，春天和冬天也喜歡！",
