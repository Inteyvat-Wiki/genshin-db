					"nextDialogs": [
						726770704
					]
				},
				{
					"id": 726770704,
					"content": "#{NICKNAME}、派蒙，經常打嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770705
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770705,
					"content": "嗯…仔細一想，雖然我們旅行的目的是找到失散的親人，但旅途中總是在戰鬥呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770706,
						726770708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770706,
					"content": "還好。我很喜歡打架。",
