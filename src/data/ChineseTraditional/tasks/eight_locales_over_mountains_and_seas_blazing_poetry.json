					"speakerTitle": "派蒙"
				},
				{
					"id": 726771013,
					"content": "不過，這裡的景色真的很特別呢。看著有點想畫畫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726771014
					],
					"speakerTitle": "派蒙"
				},
				{
