			"dialogs": [
				{
					"id": 726770101,
					"content": "這裡的景致，很特別吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770102,
					"content": "一層一層的水，顏色很特別呶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770103,
						726770108,
						726770111
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770103,
					"content": "派蒙和吉法師的詞彙量一樣匱乏…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770104
					]
				},
				{
					"id": 726770104,
					"content": "#但是，真的很特別嘛！這個顏色，{NICKNAME}要怎麼形容呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770105,
						726770106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770105,
					"content": "像冰元素…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770107,
					"content": "什麼嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770113,
					"content": "#不過，這裡的景色真的很特別呢。{NICKNAME}還記得之前那位畫家嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770114,
						726770116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770114,
					"content": "梵米爾？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770115
					]
				},
				{
					"id": 726770115,
					"content": "嗯！就是梵米爾！當時，我們不是還幫他在那兩個大雕像上裝超級發光大珠子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770118,
					"content": "最後還送了一幅畫給我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770119,
					"content": "是這個嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770120
					]
				},
				{
					"id": 726770120,
					"content": "嗯！就是這個！吉法師，快看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770121,
					"content": "呶！好像！是拍照嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770122
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770122,
					"content": "不是哦，是人畫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770123,
					"content": "咦？但是、為什麼人能拍照，還要畫畫呶？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770124
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770124,
					"content": "#唔…是呀，{NICKNAME}，這是為什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770125,
						726770127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770125,
					"content": "因為想要創造只屬於自己的東西吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770126
					]
				},
				{
					"id": 726770126,
					"content": "好像很有道理的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770130,
					"content": "而且，自己畫的東西，有很多心意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770131
					]
				},
				{
					"id": 726770131,
					"content": "嗯，一筆一筆把自己心裡想的東西畫出來，很辛苦的事情呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770132,
					"content": "嗯…那給我拍照，是不是很容易、不辛苦，所以沒有很多心意？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770133
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770133,
					"content": "欸！不是這樣的，是因為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770134,
					"content": "畫畫要好長時間。吉法師會累。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770135
					]
				},
				{
					"id": 726770135,
					"content": "對對！畫畫要好長時間的，吉法師要是一直保持一個姿勢，會很累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770136,
					"content": "以前被封印變成石頭的時候，就一直站著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770137
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770137,
					"content": "所以，掙脫封印以後，好長時間裡，腳好難受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770138
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770138,
					"content": "嗚哇，聽起來就覺得好辛苦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770139,
					"content": "但是，派蒙可以飛飛。應該腳不會累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770140
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770140,
					"content": "喂！飛的時候，全身的幻肢都在運動，很累的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770141,
					"content": "哇！著火的花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770142
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770142,
					"content": "好好聽人說話啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770143,
					"content": "烈焰花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770144
					]
				},
				{
					"id": 726770144,
					"content": "對喔，在鎮守之森好像確實沒怎麼見過烈焰花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770145,
					"content": "吉法師想要嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770146,
					"content": "想要！看起來很暖和。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770147
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770147,
					"content": "#那要好好拜託{NICKNAME}喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770148,
					"content": "#{NICKNAME}，想要。謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770149
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770149,
					"content": "妖狸說話就是這種風格嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770127,
					"content": "因為留影機很貴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770128
					]
				},
				{
					"id": 726770128,
					"content": "欸？！留影機很貴嗎？那平時戰鬥、游泳、爬山，又從山上掉下來會不會弄壞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770129,
					"content": "嗚哇，不得了，以後要小心才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770116,
					"content": "誰啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770117
					]
				},
				{
					"id": 726770117,
					"content": "是梵米爾啦！當時，不是還幫他在那兩個大雕像上裝超級發光大珠子來著嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770106,
					"content": "像風元素？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770107
					]
				},
				{
					"id": 726770108,
					"content": "吉法師的詞彙量和派蒙一樣豐富…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770109
					]
				},
				{
					"id": 726770109,
					"content": "和派蒙一樣厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770110
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 726770110,
					"content": "#唔…{NICKNAME}可能不是那個意思，但總之…吉法師就是很聰明呢！哼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726770111,
					"content": "真的很特別呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726770112
					]
				},
				{
					"id": 726770112,
					"content": "#哎？{NICKNAME}的詞彙量是不是有點匱乏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726770113
					],
					"speakerTitle": "派蒙"
				}
			]
		},
