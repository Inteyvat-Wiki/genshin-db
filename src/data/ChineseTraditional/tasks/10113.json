				"points": []
			},
			"dialogs": [
				{
					"id": 101130211,
					"content": "史丹利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130212
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 101130212,
					"content": "這麼多年過去，束縛他的甚至已經不再是「朋友」本人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130213
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 101130213,
					"content": "但那位朋友的故事，想必不會在蒙德被人忘卻吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪盧克"
				}
			]
		},
		{
			"id": 1011303,
			"completionStepIds": [
				1011303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011303",
							"2"
						],
						"stepId": 1011303,
						"stateName": "QUEST_STATE_UNFINISHED"
