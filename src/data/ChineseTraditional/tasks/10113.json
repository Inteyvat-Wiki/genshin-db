			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"史丹利"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130301,
					"content": "史丹利…告訴我，我該怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130302
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130302,
					"content": "咦？他怎麼在喊自己的名字啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130303,
						101130305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130303,
					"content": "莫非有什麼隱情？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130304
					]
				},
				{
					"id": 101130304,
					"content": "該不會，還有其他叫史丹利的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130307,
					"content": "嗚嗚！嗚呃…史丹利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130308
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130308,
					"content": "當年在燼寂海死的…為什麼不是我啊！為什麼我冒用你的名字，你的靈魂都不來阻止我？史丹利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130309
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130309,
					"content": "要不是為了保護我這個新人，你也不會死在那個無風的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130310
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130310,
					"content": "你已經有了大冒險家的名號，可，可就為了我這種廢物，你再也不能變成傳奇了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130311
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130311,
					"content": "這…究竟是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130312,
					"content": "…我想，當年他確實找到了燼寂海。在那裡遇到的危機，也是真的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130313
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130313,
					"content": "只不過，那個和他一起探險的同伴，才是真正的「大冒險家史丹利」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130314
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130314,
					"content": "真正的史丹利，是為了救我們認識的這個「史丹利」而死的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130315
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130315,
					"content": "啊…那這個「史丹利」之所以叫史丹利，是因為他「偷」了別人的名字囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130316,
					"content": "恐怕就是這麼回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130317
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130317,
					"content": "史丹利…我害怕了這麼多年，我怕蒙德城裡的人把你忘得一乾二淨，所以到處說你的冒險故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130318
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130318,
					"content": "我要讓蒙德人都記住，史丹利抵達過燼寂海的中心…他是最偉大的冒險家，他還活著！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130319
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130319,
					"content": "史丹利不會死，因為我就是！…因為我就是…史丹利…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130320
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130320,
					"content": "對不起，史丹利…連我也老了，我也老了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130321
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130321,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130322
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130322,
					"content": "你們幾個，還想偷聽到什麼時候？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130323
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130323,
					"content": "糟了！他發現了…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130305,
					"content": "還有別人叫史丹利嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130306
					]
				},
				{
					"id": 101130306,
					"content": "不會吧，連我都沒聽說過第二個史丹利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130307
					],
					"speakerTitle": "溫迪"
				}
			]
		},
		{
			"id": 1011304,
			"completionStepIds": [
				1011304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011304",
							"2"
						],
						"stepId": 1011304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"史丹利"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130401,
					"content": "走吧，什麼都別問，讓我一個人安靜一會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130402
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130402,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130403,
					"content": "走！別讓我說第二次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130404
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130404,
					"content": "榮譽騎士、溫迪，還有派蒙！太好了，你們都在這！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130405
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101130405,
					"content": "我到處找你們！我是來道謝的，多虧你幫我找的劍和盾，我父母同意了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130406
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101130406,
					"content": "哦？真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130407
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130407,
					"content": "真的！他們還說要出錢找人把「輝煌勇氣之劍」和「光耀意志之盾」修好，讓我帶著上路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130408
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101130408,
					"content": "那真好。傑克，你要離開蒙德、啟程巡遊提瓦特大陸了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130409
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130409,
					"content": "不，暫時還不走。以我現在的能力，恐怕走不了太遠的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130410
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101130410,
					"content": "而且，我還想再聽聽史丹利先生的故事。嘿嘿…畢竟，他是我夢想的起點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130411
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101130411,
					"content": "史丹利先…啊，他又喝醉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130412
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101130412,
					"content": "明天見，先生。等你酒醒了，再跟我講點故事好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130413
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101130413,
					"content": "我認為史丹利挺喜歡這孩子，你覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130414
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130414,
					"content": "傑克？傑克！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130415
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130415,
					"content": "傑克已經回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130416
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130416,
					"content": "是嗎…那，謝謝你們沒把我的秘密說出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130417
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130417,
					"content": "欸？突然直視現實了嗎？這可不像之前的你哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130418
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130418,
					"content": "我…剛才我都不敢看他一眼。他對冒險的真心不帶一點雜質…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130419
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130419,
					"content": "我是個疲憊沒用的騙子，但那孩子還是個閃閃發亮的新人，可不能毀滅了他的夢想啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130421
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130420,
					"content": "也不能說是騙子吧？因為，「史丹利」的冒險故事和經歷，都是真的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130421,
					"content": "故事…經歷…呵，算了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130423
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130422,
					"content": "其實，事到如今，我對冒險、對史丹利的記憶…都已經模糊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130424
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130423,
					"content": "這才是我最大的秘密、最大的恐懼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130425
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130424,
					"content": "這些年，我為他的故事而活。但他的性格、他的生活，我都已經記不清了。哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130426,
					"content": "他的人生被罪惡感淹沒了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130427,
					"content": "已經只剩下「幻想朋友」了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130428
					]
				},
				{
					"id": 101130425,
					"content": "我唯一不能忘記的，是他死在了無風的燼寂海，風帶不走他的靈魂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130426,
						101130427
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130428,
					"content": "嗯，沒錯…真正的史丹利，在他的記憶裡，甚至已經不再是那個鮮活的友人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130429
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130429,
					"content": "而是永遠定格在傷痕累累的戰士模樣，束縛著他所有的人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130430
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130430,
					"content": "我老了…再怎麼不願放下，也留不住多少東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130431
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130431,
					"content": "我真沒用！沒用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130432
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130432,
					"content": "但冒險家不能以那種方式死去…不能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130433
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130433,
					"content": "真…真是不可思議…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130434
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130434,
					"content": "謝謝你們…謝謝你，巴巴托斯大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130435
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130435,
					"content": "對不起，我還需要一些時間，調整心情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130436
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130436,
					"content": "但我想，我會沒事的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130437
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101130437,
					"content": "嗯，真不錯！史丹利找到了真正的自己，傑克也成功自立了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130438
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130438,
					"content": "這麼多好事加在一起，值得喝一杯慶祝慶祝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130439
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130439,
					"content": "你要在這個酒館就地不醉不歸嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130440,
					"content": "哈哈，這裡的酒太貴了。傑克欠我的報酬還沒給，他許諾我的報酬是珍貴名酒，還記得嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130441
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130441,
					"content": "我先去找他要那瓶酒，一會就在<color=#00E1FFFF>「老地方」</color>集合吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130442
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130443,
					"content": "只能猜猜看了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130444,
					"content": "我想我可能知道…也許吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130445,
					"content": "嗯，<color=#00E1FFFF>「老地方」</color>，不見不散！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130446
					]
				},
				{
					"id": 101130442,
					"content": "哎？什麼老地方，我怎麼不知道？喂！喂，賣唱的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130443,
						101130444,
						101130445
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130446,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1011305,
			"completionStepIds": [
				1011305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011305",
							"2"
						],
						"stepId": 1011305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101130501,
					"content": "總算來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130502
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130502,
					"content": "真難找！下次別搞這種猜謎了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130503,
					"content": "對了，賣唱的，你拿到酒了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130504,
					"content": "拿到了。傑克這傢伙，說是什麼「珍藏又珍貴的好酒」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130505
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130505,
					"content": "結果只不過是半瓶蘋果釀而已嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130506
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130506,
					"content": "真懷念啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130507
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130507,
					"content": "第一次在這看風景的時候，我還不是「這副模樣」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130508
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130508,
					"content": "不是…這副模樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130509
					]
				},
				{
					"id": 101130509,
					"content": "大約兩千六百年前，塵世尚未劃歸七神所有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130510
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130510,
					"content": "那時，「舊蒙德」被暴君吹起的颶風包圍，連飛鳥也不得通行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130511
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130511,
					"content": "「舊蒙德」？啊，我想起來了，就是現在的風龍廢墟吧？你以前提過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130512,
					"content": "是的。曾經統治那座高塔的風之暴君，是「龍捲 的魔神」迭卡拉庇安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130513
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130513,
					"content": "而那時的我，只是千風中的一縷。並無神靈之格，也不成人形…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130514
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130514,
					"content": "只是風中細微的元素精靈，是一縷「能夠帶來細小的轉機與希望之風」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130515
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130515,
					"content": "只是元素精靈？不是人形？咦？溫迪，你以前不長現在這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130516,
					"content": "嗯。我現在的樣子，其實也和那位假史丹利先生一樣，是借用「朋友」的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130517
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130517,
					"content": "後來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130518,
					"content": "你說的那個朋友，他後來怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130519
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130519,
					"content": "（溫迪的朋友，和史丹利一樣…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130520
					]
				},
				{
					"id": 101130520,
					"content": "派蒙，妳想知道後面的故事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130521
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130521,
					"content": "當然當然！別吊我胃口，快說吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130522,
						101130524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130522,
					"content": "派蒙，去採兩個蘋果來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130523
					]
				},
				{
					"id": 101130523,
					"content": "為什麼現在突然想吃這個啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130526,
					"content": "#哈哈哈，{F#妳}{M#你}肚子餓了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130527
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130527,
					"content": "餓了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130528
					]
				},
				{
					"id": 101130528,
					"content": "#嗚…真是拿{F#妳}{M#你}沒辦法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130529
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101130529,
					"content": "#啊——有時我會覺得，{F#妳}{M#你}有點過於聰明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130530
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130530,
					"content": "不過，朋友之間，也許就是要心知肚明才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130531
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130531,
					"content": "美酒，微風…這樣的時刻，總會讓我忍不住想起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130532
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130532,
					"content": "想起那首，從他那裡聽來的歌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130533
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101130533,
					"content": "我會好好聽著的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 101130524,
					"content": "派蒙，能幫我找些魚肉嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101130525
					]
				},
				{
					"id": 101130525,
					"content": "咦？不是在聽故事嗎？怎麼突然要吃這種東西！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101130526
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}