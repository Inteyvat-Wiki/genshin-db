					}
				]
			},
			"dialogs": [
				{
					"id": 748000401,
					"content": "妳怎麼又躲起來了，這周圍什麼也沒有啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 748000402,
					"content": "妳沒看見那台警衛機關嗎？就在我們面前！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000403,
						748000404
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000403,
					"content": "它…怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				},
				{
					"id": 748000405,
					"content": "噓，快點離開那邊，這警衛機關要是失控了怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000406
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000406,
					"content": "或者它…它的能源核心突然發生爆炸，或者是被人遙控著攻擊我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000407
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000407,
					"content": "但它一切正常。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000408
					]
				},
				{
					"id": 748000408,
					"content": "這正是我害怕的。一個原本正常的機關突然失控，讓某個倒楣鬼丟了性命…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000409
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000409,
					"content": "這件事不會有任何人為其負責，說不定連作案主謀都找不到…實在是太危險了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000410
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000410,
					"content": "它已經走了喔，妳可以出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 748000411,
					"content": "喔，它真的沒有失控，真是出乎預料。我們又撿了一條命啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000412,
						748000413
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000412,
					"content": "根本就不可能出現這種意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000414,
					"content": "我所想要構想的，就是一場「人為營造的純粹意外」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000415
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000415,
					"content": "等等。沒有主謀…不會由任何人單獨為其負責的案件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000416
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000416,
					"content": "對！我有靈感了，快、快，我們去咖啡館，我必須得快點寫下來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000417
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000417,
					"content": "喂！跑慢一點啊，妳不怕有人突然丟塊石頭絆倒妳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 748000413,
					"content": "它從一開始就不可能失控好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000414
					]
				},
				{
					"id": 748000404,
					"content": "呃…然後呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000405
					]
				}
			]
		},
