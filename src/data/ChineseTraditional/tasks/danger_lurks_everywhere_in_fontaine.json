			},
			"dialogs": [
				{
					"id": 748000501,
					"content": "對，沒錯…就是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000502,
						748000503
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000502,
					"content": "咖啡要涼了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000503,
					"content": "我都已經喝完了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000504
					]
				},
				{
					"id": 748000504,
					"content": "#好的，謝謝{F#妳}{M#你}，{NICKNAME}。多謝{F#妳}{M#你}一路護送我過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000505
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000505,
					"content": "說是護送…其實我們只是跟著妳一直走而已，什麼也沒做啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000506,
						748000507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 748000506,
					"content": "什麼壞事也沒發生。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000507,
					"content": "妳也沒遇見什麼危險。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000508
					]
				},
				{
					"id": 748000508,
					"content": "是的。看來我的確是想太多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000509
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000509,
					"content": "這咖啡真好喝，哈哈…哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000510
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000510,
					"content": "#…{F#妳}{M#你}覺得，會不會有人在裡面下毒啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000511,
						748000512
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000511,
					"content": "…咳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000512,
					"content": "妳、妳少說兩句！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000513
					]
				},
				{
					"id": 748000513,
					"content": "胡說，我們都喝完了，完全沒事啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 748000514,
					"content": "不不不，也許是一種…特別的下毒方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000515
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000515,
					"content": "首先，下毒的人在我們喝的咖啡裡倒入了第一種藥物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000516
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000516,
					"content": "單獨服用這種藥物，不會對服用者造成任何影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000517
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000517,
					"content": "當我們全部服下了這種藥，離開這裡回家的時候，下毒者就會偷偷尾隨我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000518
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000518,
					"content": "等我們睡著，他們就潛入房裡，在我們的水壺裡倒入第二種藥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000519
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000519,
					"content": "這樣，等我們第二天帶著水壺出行，並且喝下水壺裡的水時，兩種藥物就會起反應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000520
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000520,
					"content": "我們就會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000521
					],
					"speakerTitle": "吉雅羅"
				},
				{
					"id": 748000599,
					"content": "一陣急促的腳步聲突然靠近…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 748000521,
					"content": "這位客人，妳到底在說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000522
					],
					"speakerTitle": "阿魯埃"
				},
				{
					"id": 748000522,
					"content": "咖啡？下毒？請不要在我的店裡開這種玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000523
					],
					"speakerTitle": "阿魯埃"
				},
				{
					"id": 748000523,
					"content": "如果影響到其他客人，我就要請妳出去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						748000524,
						748000525
					],
					"speakerTitle": "阿魯埃"
				},
				{
					"id": 748000524,
					"content": "店長，我來解釋…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000525,
					"content": "她是我的朋友。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						748000526
					]
				},
				{
					"id": 748000526,
