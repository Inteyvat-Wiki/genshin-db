			},
			"dialogs": [
				{
					"id": 400595301,
					"content": "#小傢伙們，{F#妳}{M#你}們好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595302
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400595302,
					"content": "你們兩個怎麼會湊在一起！而且剛才明明聊得熱火朝天，看到我們靠近，就突然不說話了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400595303,
					"content": "#哎呀，那只是{F#妳}{M#你}們的錯覺啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595304
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400595304,
					"content": "#我們只是在說下酒菜的話題，{F#妳}{M#你}們也不感興趣嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595305
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400595305,
					"content": "嗯，說到下酒菜啊，油豆腐我覺得就不錯呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595306
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400595306,
					"content": "算了算了，就算這兩個人湊在一起密謀什麼，也不會讓我們知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
