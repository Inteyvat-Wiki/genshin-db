			},
			"dialogs": [
				{
					"id": 400595201,
					"content": "#旅行者、派蒙，{F#妳}{M#你}們好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595202
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400595202,
					"content": "哇，綾人，今天總算又見到你這個大忙人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400595203,
					"content": "這些天事情太多，實在是脫不開身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595204
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400595204,
					"content": "不過所幸容彩祭一切順利，三奉行在此次祭典上也合作順暢，今天總算能稍作休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595205
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400595205,
					"content": "#二位，我和兄長都很感謝{F#妳}{M#你}們的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595206
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400595206,
					"content": "嗯，托馬還真是慢啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595207
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400595207,
					"content": "你們在等托馬？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400595208
					]
				},
				{
					"id": 400595208,
					"content": "對。難得兄長說今天不忙，要帶我去買書，但他卻把錢包忘在了家裡，於是就只好讓托馬回去取了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595209
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400595209,
					"content": "沒想到綾人也會有粗心大意的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400595210,
					"content": "呵呵，兄長平日裡總是殫精竭慮，難得能離開公務放鬆下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595211
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400595211,
					"content": "所以，這種偶爾的粗心大意，對於我和托馬來說，反而很可貴呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
