				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400590101,
					"content": "#{NICKNAME}，派蒙，{F#妳}{M#你}們好啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400590102
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400590102,
					"content": "阿貝多，說起來最後一幅黑主的畫像怎麼被蓋住了呀，我還想看看你畫的黑主究竟長什麼樣子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400590103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400590103,
					"content": "#別著急，再過一下會舉行畫像的揭幕式，到時候{F#妳}{M#你}們就能知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400590104
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400590104,
					"content": "這幅畫可是我的得意之作，為了完成它，我還專程拜訪了一個人。對方給我提供了非常寶貴的建議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400590105,
						400590106
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400590105,
					"content": "感覺愈說愈神秘了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400590107
					]
				},
				{
					"id": 400590107,
					"content": "#呵呵，有嗎？總之距離揭幕還有段時間，{F#妳}{M#你}們先在會場上逛逛吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400590106,
					"content": "聽起來有點可疑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400590107
					]
				}
			]
		},
		{
			"id": 4005910,
			"completionStepIds": [
				4005910
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005910",
							"2"
						],
						"stepId": 4005910,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"平山"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400591001,
					"content": "諸位，歡迎大家參加「光華容彩祭」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591002
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591002,
					"content": "今天，我們的祭典順利迎來了最後一個階段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591003
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591003,
					"content": "接下來，我們就將為大家揭曉由蒙德畫家白堊老師繪製的五歌仙畫像最後一幅——黑主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591004
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591004,
					"content": "好緊張啊，不知道阿貝多畫了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591005,
					"content": "讓我們一起倒數，三、二、一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591006
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591006,
					"content": "這是怎麼回事，這幅畫上面怎麼只有背景？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591007
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591007,
					"content": "白堊老師肯定不會是忘了畫角色啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591008
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591008,
					"content": "關於這幅畫像的創作理念，就讓我們來採訪一下白堊老師吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591009
					],
					"speakerTitle": "平山"
				},
				{
					"id": 400591009,
					"content": "大家好，很高興這次能夠受到邀請，繪製五歌仙的畫像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591010
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400591010,
					"content": "五歌仙是稻妻古代的傳說人物，他們曾經以詩歌聞名，同樣也被寫進詩篇，成為了許多故事的主角。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591011
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400591011,
					"content": "我從現存的資料中得知，在這些故事中，「黑主」的身分是最為豐富多樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591012
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400591012,
					"content": "而且，沒有個人篇章的他，似乎卻是五歌仙故事的「幕後主角」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591013
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400591013,
					"content": "或許我們可以認為，每個創作者對黑主的理解都各不相同，所以，我也想把這份想像留給大家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591014
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400591014,
					"content": "畢竟容彩祭，就是一個讓大家透過創作，抒發心中所想的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591015
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400591015,
					"content": "真不愧是阿貝多，他這樣一解釋，立刻就讓遊客們信服了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591016,
					"content": "嘻嘻，這樣一來，我們在這次容彩祭上的冒險，也算是圓滿結束了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591017,
						400591018
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591017,
					"content": "真的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591019
					]
				},
				{
					"id": 400591019,
					"content": "咦，忘了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591020,
					"content": "啊…啊啊啊！對啊，那個留下五歌仙故事的人，我們到現在都還沒找到呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591021
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591021,
					"content": "不過我已經有頭緒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591022
					]
				},
				{
					"id": 400591022,
					"content": "真的嗎，快說給我聽聽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591023
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591023,
					"content": "首先，對方認識我們每個人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591024
					]
				},
				{
					"id": 400591024,
					"content": "#嗯，{F#妳}{M#你}說得有道理，否則就沒辦法每次都能把信交給合適的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591025
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591025,
					"content": "而且，對方與萬葉家有關聯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591026
					]
				},
				{
					"id": 400591026,
					"content": "是喔，雖然對方一直在用故事提示我們行秋的事，可根本目的，卻是為了引導我們解開萬葉家的秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591027
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591027,
					"content": "我明白啦！留下故事的，應該就是「那個傢伙」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591028
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591028,
					"content": "走，我們現在就去揭開真相！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591018,
					"content": "妳是不是忘了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591019
					]
				}
			]
		},
		{
			"id": 4005911,
			"completionStepIds": [
				4005911
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005911",
							"2"
						],
						"stepId": 4005911,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾人"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400591101,
					"content": "綾人，留下五歌仙故事的人果然就是你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591102,
					"content": "真是太過分了，明明你跟大家都認識，卻故意把我們耍得團團轉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591103,
					"content": "#呵呵，其實我今天來這裡的一個目的，就是想跟{F#妳}{M#你}們解釋清這件事的來龍去脈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591104
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591104,
					"content": "哼，我倒要看看你怎麼解釋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591105,
					"content": "首先，這件事的起因十分偶然，是八重大人在某天晚上，偶然看見行秋和編輯將書運走，覺得有趣，就提出要作弄一下他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591106
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591106,
					"content": "什麼，原來是神子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591107,
					"content": "唔，不過這確實像是神子幹得出來的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591108,
					"content": "#正是，不過後來以五歌仙故事的形式傳遞訊息，誘導{F#妳}{M#你}們發現楓原家的秘密，就是我的順水推舟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591109
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591109,
					"content": "而我採取這種迂迴的辦法，確實也有不得已之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591110
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591110,
					"content": "不得已之處？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591111
					]
				},
				{
					"id": 400591111,
					"content": "此前因為「某件事」，我留意到了楓原義慶留下的盆栽，和裡面所藏匿的無字紙張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591112
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591112,
					"content": "我知道這些紙肯定不簡單，但還是花了一段時間，才解開上面的秘密——就是那種遇水才能顯現的墨水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591113
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591113,
					"content": "楓原義慶在信中提及之事，無論對於神里家，還是楓原家的後人都十分重要，尤其是楓原萬葉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591114
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591114,
					"content": "楓原一族曾是神里家的下屬，當年我的先祖未能保護好他們，到我這裡，仍有義務照拂他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591115
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591115,
					"content": "雖說他有權知道真相，但接觸秘密同樣意味著接近危險。我必須確認，萬葉是否有瞭解真相的「意願」與「能力」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591116
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591116,
					"content": "我當然可以將發現的事實直接告訴他，但或許他並無這種「意願」，那這個真相對於他只會成為負擔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591117
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591117,
					"content": "同時他如果缺少相應的「能力」，就無法找到真相，如果是那樣的話，還是讓他遠離危險比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591118
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591118,
					"content": "楓原義慶，也正是考慮到這一點，才一樣使用了迂迴的辦法留下了訊息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591119
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591119,
					"content": "很長一段時間，我都苦於沒有合適的契機傳達此事，直到《沉秋拾劍錄》被偷偷運走的那天晚上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591120
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591120,
					"content": "原來如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591121,
					"content": "那其他人被拉進來的意義呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591122
					]
				},
				{
					"id": 400591122,
					"content": "對喔，不僅是萬葉，你把我們都拉進了你的計畫裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591123,
					"content": "#呵呵呵，看來果然瞞不過{F#妳}{M#你}的眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591124
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591124,
					"content": "#我判斷知道這件事對{F#妳}{M#你}們也有不小的價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591125
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591125,
					"content": "當然更重要的是，我希望萬葉與綾華在找到真相的時候，身邊能有一群可靠的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591126
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591126,
					"content": "這些人願意守護他們做出冷靜的決定，同樣，也會在他們遇到困難時不遺餘力地伸出援手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591127
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591127,
					"content": "#因為{F#妳}{M#你}們很有可能，將來會面對相同的敵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591128
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591128,
					"content": "「國崩」究竟是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591129
					]
				},
				{
					"id": 400591129,
					"content": "#其實{F#妳}{M#你}心裡已經有答案了，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591130
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591130,
					"content": "而且這個答案，就埋藏在那幅「黑主」的畫像中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591131
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591131,
					"content": "#等到畫像附近沒人的時候，{F#妳}{M#你}可以用自己的眼睛去確認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591132
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591132,
					"content": "#至於讓那個真相顯露的辦法…{F#妳}{M#你}們之前也已經用過很多次了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				}
			]
		},
		{
			"id": 4005915,
			"completionStepIds": [
				4005914
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005914",
							"2"
						],
						"stepId": 4005914,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 400591501,
					"content": "夜深了，現在周圍已經沒有人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591502,
					"content": "綾人說的那個用過很多次的辦法，一定就是指把水灑在這幅畫上吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591503,
					"content": "畫面上的人…是散兵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591504,
					"content": "果然他就是當年的幕後黑手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591530
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591530,
					"content": "#…等到畫像附近沒人的時候，{F#妳}{M#你}可以用自己的眼睛去確認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591531
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591531,
					"content": "#至於讓那個真相顯露的辦法…{F#妳}{M#你}們之前也已經用過很多次了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591505
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591505,
					"content": "…最後，我們還有一件事需要談談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591506
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591506,
					"content": "我之前提到，「某件事」的發生讓我留意到盆栽的存在，現在要講的就是那件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591507
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591507,
					"content": "那是將軍剛剛宣佈廢除鎖國令之後，我聽說天領奉行那裡發生了一起案件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591508
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591508,
					"content": "保管證物與查抄得來贓物的倉庫有竊賊進入的痕跡，不過卻什麼東西都沒有丟失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591509
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591509,
					"content": "我覺得這起案件並不尋常，於是告訴天領奉行的九條裟羅，暫時當做無事發生，不要加強戒備或將倉庫換地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591510
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591510,
					"content": "而我則派終末番的人在旁邊盯梢，果然發現有個人潛入到倉庫中，翻找楓原家的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591511
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591511,
					"content": "難道說，他也是在找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591512,
					"content": "我放任他翻找了一段時間，最後他一無所獲，只得乘船離開了稻妻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591513
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591513,
					"content": "你為什麼不派人抓住他呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400591514,
					"content": "呵呵，保護一個秘密的最好辦法，就是當做這個秘密並不存在，不是嗎？而且這個人的身分也並不難猜測。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591515
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591515,
					"content": "在他離開稻妻後，我就認真逐件檢查了楓原家的物品，終於在那個花盆的夾層裡，看到了那幾張紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591516
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591516,
					"content": "我確信這些紙，就是潛入者想要尋找的「秘密」，雖然他或許也並不能確定這個「秘密」真的存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591517
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591517,
					"content": "那麼接下來，就是我的最後一個問題了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591518
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591518,
					"content": "楓原義慶所寫的那段經歷中，究竟哪一部分才是真正需要被保守的秘密呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591519,
						400591520,
						400591521
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591519,
					"content": "楓原義慶知道家族被陷害？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591522
					]
				},
				{
					"id": 400591522,
					"content": "#呵呵呵，這個問題，我現在也沒有答案，就把它留給未來的{F#妳}{M#你}好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400591523
					],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591523,
					"content": "至於現在，就好好享受容彩祭吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾人"
				},
				{
					"id": 400591520,
					"content": "楓原義慶知道犯人叫國崩？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591522
					]
				},
				{
					"id": 400591521,
					"content": "楓原義慶被對方放了一馬？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400591522
					]
				}
			]
		},
		{
			"id": 4005951,
			"completionStepIds": [
				4005903
			],
