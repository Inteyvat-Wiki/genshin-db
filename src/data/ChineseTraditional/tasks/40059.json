	"talks": [
		{
			"id": 4005901,
			"completionStepIds": [
				4005902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
