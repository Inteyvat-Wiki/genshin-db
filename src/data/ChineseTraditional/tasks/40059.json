			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"行秋"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400595101,
					"content": "#{NICKNAME}、派蒙，{F#妳}{M#你}們來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595102
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595102,
					"content": "今天的簽售順利嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400595103
					]
				},
				{
					"id": 400595103,
					"content": "#嗯，多虧了{F#妳}{M#你}們，簽售會進行得非常順利，讀者們也都很滿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595104
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595104,
					"content": "行秋，是我的錯覺嗎，我怎麼覺得你一直在東張西望啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400595105,
					"content": "並不是錯覺，說來慚愧，其實我一直在提防著有璃月遊客靠近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595106
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595106,
					"content": "我畢竟是以考察商品的名頭來了稻妻，若是被認得我的人看見我坐在這裡，我爹那邊可就瞞不住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595107
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595107,
					"content": "幸好今天來排隊買書的讀者眾多，一般遊客不會靠近這邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595108
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595108,
					"content": "#對了，其實阿旭也不知道我此行的真正目的。{F#妳}{M#你}們若是見了他，可要記得替我保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595109
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595109,
					"content": "好，放心吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400595110
					]
				},
				{
					"id": 400595110,
					"content": "#那我先謝過{F#妳}{M#你}們啦。抱歉，現在不能陪{F#妳}{M#你}們聊太久，後面還有讀者在等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400595111
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400595111,
					"content": "待會就在黑主畫像的揭幕儀式上再見吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
