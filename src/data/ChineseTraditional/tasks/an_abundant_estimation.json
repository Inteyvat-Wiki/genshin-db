	"talks": [
		{
			"id": 7351001,
			"completionStepIds": [
				7351001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7351001",
							"2"
						],
						"stepId": 7351001,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"哈賈娜德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735100101,
					"content": "哈賈娜德，大功告成啦，來聽我們的好消息吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100102,
					"content": "#稍等，讓我感受一下，{F#妳}{M#你}們身上「震沸裝置」的訊號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100103
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100103,
					"content": "啊，這熾熱的餘溫和充滿磁性的迴響，就像是煉金藥劑在火中的合奏，讓我興奮得戰慄…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100104
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100104,
					"content": "#真是無懈可擊！利用{F#妳}{M#你}們提供的資料，我一定能寫出最完美的報告！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100105
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100105,
					"content": "真的嗎？我怎麼什麼都沒感覺到？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100106,
					"content": "「白色高智慧浮游助手單元」，妳應該閱讀一些…教令院學生深夜語錄，拓展妳的語言多樣性機能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100107
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100107,
					"content": "這樣一來，妳就能理解各種精妙的比喻了，幽默力和抗壓力都能超級加倍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100108
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100108,
					"content": "#才不要！根本聽不懂啦，我哪來的什麼壓力，{NICKNAME}又不會要求我做奇怪的研究！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100109,
					"content": "妳不要岔開話題喔，我們按照約定，幫妳測試了裝置。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100110,
					"content": "現在，快樂的發薪時間到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100111,
					"content": "#給{F#妳}{M#你}們給{F#妳}{M#你}們！難道{F#妳}{M#你}們還信不過我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100112
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100112,
					"content": "咦？這就是五十人份的薪水嗎？總覺得和想像的有點出入呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100113,
					"content": "唔…倒也不是嫌太少…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100114,
						735100115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100114,
					"content": "算不上「一大筆摩拉」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100116
					]
				},
				{
					"id": 735100116,
					"content": "咦？難道我存了大半年的這筆錢還不夠誇張嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100117
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100117,
					"content": "是我低估了傭兵們的賺錢能力？我為傭兵們規劃的日薪，和導師每天給我的資金一樣多呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100118
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100118,
					"content": "我的新導師出手超闊綽，跟著她以後，我每天都能享受一份烤肉卷大餐，資金還有盈餘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100119
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100119,
					"content": "如果在商店買一袋麵粉、去野外摘些墩墩桃、打幾桶河水一起煮成麵糊…一天的資金就夠我生活兩週。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100120
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100120,
					"content": "餘下的錢都可以投入「震沸合劑」的研究，這次雇傭傭兵的預算就是這麼來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100121,
						735100122
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100121,
					"content": "妳對食物的要求好低。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100123
					]
				},
				{
					"id": 735100123,
					"content": "哈賈娜德，妳到底是怎麼撐到今天的…這種日子未免過得也太苦了，要對自己好一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100124,
					"content": "一頓大餐，至少是吃烤肉卷到撐才行吧，一份怎麼能算數！每天只吃這種麵糊的話，也會把身體搞壞的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100125,
					"content": "我明白我明白，我已經過得很好了！有的學生還要倒貼摩拉來完成學業喔，就像我以前那樣，更顧不上好好吃飯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100126
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100126,
					"content": "我現在有了導師批准的預算，每天都能填飽肚子，已經超幸福了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100127
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100127,
					"content": "完全沒聽懂吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100128
					]
				},
				{
					"id": 735100128,
					"content": "想到了！我們就帶哈賈娜德去吃頓豪華的一餐，讓她把自己的標準訂高一點，至少不要每天都應付了事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100129,
					"content": "#不用不用！哪有讓委託人請雇主吃飯的道理！感謝{F#妳}{M#你}們對我的關心啦，真的不用擔心我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100130
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100130,
					"content": "只要能取得學術進展，證明我的能力，遲早能出人頭地！老是吃大餐的生活，並不是我這個階段該想的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100131
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100131,
					"content": "不能浪費時間了，我這就回去寫報告！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100132
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100132,
					"content": "那妳也可以拿一點水果和蔬菜回去補充營養。我們經常能找到日落果和高麗菜，包包裡還有不少！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100133,
					"content": "嘿嘿…呵呵…啊哈哈哈哈哈…我已經能想像導師下巴脫臼的表情了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100134
					],
					"speakerTitle": "哈賈娜德"
				},
				{
					"id": 735100134,
					"content": "哈賈娜德根本不聽派蒙的話，傻笑著跌跌撞撞地離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						735100135
					]
				},
				{
					"id": 735100135,
					"content": "呃，自顧自地走掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100136,
					"content": "總覺得哈賈娜德這樣下去，說不定哪天就會營養不良，餓昏過去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100137,
						735100138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100137,
					"content": "她的導師應該會注意到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100139
					]
				},
				{
					"id": 735100139,
					"content": "嗯…按照哈賈娜德的說法，她的導師應該很重視她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100140,
					"content": "只能祝她能順利完成研究，賺到更多摩拉了，然後過上正常的生活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735100141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100141,
					"content": "說不定之後還會碰見她，到時候，我們從她那裡拿到再多報酬，也不用擔心她營養不良！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735100138,
					"content": "希望研究狂人別輕易倒下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100139
					]
				},
				{
					"id": 735100122,
					"content": "妳的生活標準好危險。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100123
					]
				},
				{
					"id": 735100115,
					"content": "和期待的有點出入。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735100116
					]
				}
			]
		}
	]
}