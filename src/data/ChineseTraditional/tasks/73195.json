			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951001,
					"content": "「大家知道哪裡有會講故事的說書人嗎？呃，要每個故事都能一模一樣分毫不差的那種。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951002
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951002,
					"content": "「我被一個可怕的鎮靈纏上了，他威脅說如果我不能每天給他重複講一模一樣的故事就要殺了我。已經過了一個月了，現在我頭腦都嗡嗡的，實在是太折磨人了…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951003
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951003,
					"content": "「你的經歷真是離奇，不過我聽說普斯帕咖啡館有個叫瑪達赫的說書人，說不定能幫上你的忙」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319511,
			"completionStepIds": [
				7319511
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319511",
							"2"
						],
						"stepId": 7319511,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951101,
					"content": "「我走過許多國家看過無數的表演，妮露小姐的舞蹈在我看來毫無疑問是提瓦特第一的。結果教令院的那些學究不僅無法欣賞還天天指手畫腳的，真是侮辱藝術。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951102
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951102,
					"content": "「以我在蒙德的經驗來看，還是應該為妮露小姐組織一個後援會，這樣那些不懂藝術的傢伙就不敢來說三道四了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951103
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951103,
					"content": "「後援會…是什麼蒙德人的風俗嗎？不過…完美的劇碼是劇團的大家一起努力的成果，只是把目光放在一個人身上，是做不到的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951104
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951104,
					"content": "「而且我相信，藝術本身就足以成為大家的紐帶了，您能喜歡妮露小姐的舞蹈，我真的很開心。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951105
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951105,
					"content": "「看這優雅的字跡，您應該是一位年輕的小姐吧。能遇到共賞舞劇的同好真是太好了，請問小姐有時間相約一敘嗎？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951106
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951106,
					"content": "「抱歉，我很忙，有什麼事情請和經理談吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951107
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951107,
					"content": "「看起來這小子碰壁了呢，最後一頁明顯換了個粗壯的男人來寫…大概是什麼富家小姐的沙漠人保鏢吧。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319512,
			"completionStepIds": [
				7319512
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319512",
							"2"
						],
						"stepId": 7319512,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951201,
					"content": "「出售役使鎮靈的魔瓶，請在這裡投幣。只需一摩拉，就能實現你的任何願望。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951202
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951202,
					"content": "「出售實現願望的魔瓶，任何願望都行，只要一摩拉。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951203
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951203,
					"content": "「我是鎮靈，只要給我一摩拉，想要什麼我都能幫你實現。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951204
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951204,
					"content": "「對於近期發生的連環詐騙案，聚砂廳已介入調查，請大家不要驚慌。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951205
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951205,
					"content": "「受害民眾如有疑問，盡可諮詢，諮詢費只需一摩拉。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319513,
			"completionStepIds": [
				7319513
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319513",
