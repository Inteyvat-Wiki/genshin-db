			},
			"dialogs": [
				{
					"id": 731950101,
					"content": "此乃維齊爾大人所設的告示板，須彌城內重要事務皆在此公示，如有相關問題也可在此留言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319502,
			"completionStepIds": [
				7319502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319502",
							"2"
						],
						"stepId": 7319502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950201,
					"content": "「關於延請專家處理長鬢虎的告示…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950202
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950202,
					"content": "告示的正式內容被畫筆塗抹，旁邊用歪斜而稚嫩的字跡寫著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950203
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950203,
					"content": "「羅闍只是想跟大家玩而己！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319503,
			"completionStepIds": [
				7319503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319503",
							"2"
						],
						"stepId": 7319503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950301,
					"content": "「如您在食用蕈類後看見小精靈跳舞，此為正常現象不用擔心。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950302
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950302,
					"content": "「不過倘若您發現周圍植物開始說話，那麼請立即聯繫附近的巡林員尋求幫助。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319504,
			"completionStepIds": [
				7319504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319504",
							"2"
						],
						"stepId": 7319504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950401,
					"content": "「由於不明原因，最近森林中的『死域』無論數量還是面積都有明顯擴張。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950402
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950402,
					"content": "「『死域』不僅會使植物枯萎，還可能奪走動物和人類的生命。巡林官已為此設置了『汙染區』，大家請勿靠近。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950403
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950403,
					"content": "「如在行走森林的過程中，發現新出現的死域，請就近聯繫附近的巡林員，交由專業人士處理。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319505,
			"completionStepIds": [
				7319505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319505",
							"2"
						],
						"stepId": 7319505,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950501,
					"content": "近期風紀官在對各地巴扎的日常巡查過程中，查獲多起非法罐裝知識交易案件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950502
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950502,
					"content": "罐裝知識交易為教令院所嚴禁，一經發現，必將嚴懲不貸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950503
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950503,
					"content": "如因使用罐裝知識導致任何後果，教令院亦概不負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319506,
			"completionStepIds": [
				7319506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319506",
							"2"
						],
						"stepId": 7319506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950601,
					"content": "「一年一度的『花神誕祭』就要到了，今年大巴扎也會舉辦盛大的祭典。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950602
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950602,
					"content": "「為了讓祭典更加熱鬧，今年我家小姐為各位前來參與祭典的商家提供了特別的補貼。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950603
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950603,
					"content": "「希望大家能夠一起為小吉祥草王大人慶生！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319507,
			"completionStepIds": [
				7319507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319507",
							"2"
						],
						"stepId": 7319507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950701,
					"content": "「我家小姐近日離家出走，至今未歸。如您看見一位棕色盤髮、身穿紫色上衣淡藍色長裙的年輕女孩，請與呼瑪伊家聯絡，必有重酬。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950702
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950702,
					"content": "「本人如見到啟事後，速與家人聯繫，老爺和夫人很擔心你。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319508,
			"completionStepIds": [
				7319508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319508",
							"2"
						],
						"stepId": 7319508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950801,
					"content": "「回來了！我主阿赫瑪爾回來了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950802
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950802,
					"content": "「當他重臨世界之日，你們這些腦袋上長葉子的傢伙都要遭到報應！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950803
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950803,
					"content": "此為不實消息，我們正在追查相關謠言的來源。須彌無論內外大事都會在虛空中定期投放，大家請勿輕信流言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319509,
			"completionStepIds": [
				7319509
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7319509",
							"2"
						],
						"stepId": 7319509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731950901,
					"content": "「朋友，遇到什麼困難了嗎？無所不能的桑歌瑪哈巴依老爺誠心為您提供各類解決方案。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950902
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950902,
					"content": "「只需要付出一點小小的摩拉，便能幫您解決任何問題。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950903
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950903,
					"content": "「心動不如行動，聯繫方式…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731950904
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731950904,
					"content": "此乃維齊爾大人所設的告示板，為規範市場交易行為，請大家不要在此張貼廣告。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
