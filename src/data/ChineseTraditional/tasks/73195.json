			},
			"dialogs": [
				{
					"id": 731951501,
					"content": "如在森林中偶遇目光呆滯或是喃喃自語之人，他們是正處「林居狂語期」的學者，請勿打擾他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951502
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951502,
					"content": "如對您造成困擾，請上報教令官並交由教令院解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
