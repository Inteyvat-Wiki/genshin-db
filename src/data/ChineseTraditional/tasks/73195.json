			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951601,
					"content": "「聽說以前，底萬是幫我們下城的百姓說話的機構，現在只知道對教令官言聽計從的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951602
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951602,
					"content": "「什麼維齊爾，平常說話也不算，只有教令官要推卸責任的時候才會想起來。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951603
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951603,
					"content": "教令院對各行政機構的指導乃是大慈樹王的遺教，閒雜人等不得詆毀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
