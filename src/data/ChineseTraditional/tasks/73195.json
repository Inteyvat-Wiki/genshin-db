			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 731951401,
					"content": "「說起來之前有個很不錯的傭兵，我記得是叫『熾鬃之獅』什麼的吧…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951402
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951402,
					"content": "「以前每次出海行商都會僱她幫忙護衛，不管是盜寶團還是千岩軍都沒在怕的。託她的福我可是狠賺了一筆呢。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951403
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951403,
					"content": "「不過最近似乎看不到她在接委託了，而且聽說去璃月路上的魔物又變多了…這樣下去我只能把錢放到卡里米交易所了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951404
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951404,
					"content": "「聽起來你做的也不是什麼正經生意吧…不過你說『熾鬃之獅』的話，我聽說她最近接了呼瑪伊家的大單，你可得好等一會了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951405
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951405,
					"content": "「另外奉勸一句，有錢的話寧願去買一百條毛毯，也別給卡里米交易所啊！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						731951406
					],
					"speakerTitle": "告示板"
				},
				{
					"id": 731951406,
					"content": "「這位大叔說得沒錯！請來本店買一百條毛毯吧，讓我為您細說每一條都有什麼妙用！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "告示板"
				}
			]
		},
		{
			"id": 7319515,
			"completionStepIds": [
				7319515
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
