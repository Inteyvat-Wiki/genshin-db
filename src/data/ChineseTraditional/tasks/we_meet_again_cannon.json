			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"布蕾斯特"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1819.629,
							449.792,
							4817.158
						],
						"pointId": 340500103
					}
				]
			},
			"dialogs": [
				{
					"id": 746850101,
					"content": "威力減小到這種程度應該差不多了，水球剛好可以打破標靶，兼顧了娛樂效果和安全性…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850102
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850102,
					"content": "水球？娛樂？原來只是個水炮玩具啊！那我們就可以放心了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746850103,
					"content": "不過，這門水炮好像有點眼熟？我們是不是在哪裡見過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850104,
						746850108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746850104,
					"content": "想不起來了，就當作沒見過吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746850105
					]
				},
				{
					"id": 746850105,
					"content": "可能是造型太特別了吧？就像棘冠鱷…我一看到就想幫它取個「鱷鱷炮炮」之類的外號…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746850106,
					"content": "「鱷鱷炮炮」？這個名字很不錯！「鱷鱷」聽起來就像是…炮彈飛掠而過的聲音，簡潔易懂還好記，我覺得棒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850107
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850107,
					"content": "#看來{F#妳}{M#你}們兩位對這門水炮很有興趣嘛！要不要來當我的第一批客人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850112
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850112,
					"content": "喔！我大概可以猜得到妳接下來要說什麼了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746850113,
					"content": "妳剛測試完這門水炮，正打算請人試玩，想叫人家提供改進意見給妳？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746850114,
					"content": "#完全正確！{F#妳}{M#你}們太厲害了，看來很常和別人合作，我們溝通起來應該會很暢快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850115
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850115,
					"content": "先自我介紹一下，我叫布蕾斯特，是楓丹科學院前軍械研究組的艦炮工程師，現已失業。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850116
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850116,
					"content": "為了討生活，我開始弄這種「改良版鱷型渦流聚引原理鱷式外甲海戰用重型艦炮式娛樂水球發射炮」，想開個水上樂園…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850117
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850117,
					"content": "等等，艦炮工程師…失業…水上樂園？我腦袋有點轉不過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850118,
						746850119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746850118,
					"content": "妳到底經歷了什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746850120
					]
				},
				{
					"id": 746850120,
					"content": "時代變了，沒辦法嘛。以前楓丹可是有很厲害的艦隊的，那時候艦炮屬於必需品，結果艦隊經歷了一場大戰全滅了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850121
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850121,
					"content": "現在的楓丹是發條機關的天下，沫芒宮沒有打算重建艦隊，艦炮又貴又大又重，失去了用武之地，就跟只會在旁邊弄火炮的我一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850122
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850122,
					"content": "反正軍事領域已經沒機會了，不如考慮轉型其他領域，日子總要過，怎樣都可以算過，開心最重要！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850123
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850123,
					"content": "開個水上樂園賺點門票錢，平平淡淡過日子，不是也不錯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850124
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850124,
					"content": "該、該說妳很樂觀嗎？完全不需要安慰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746850125,
					"content": "不開心的事先放到一邊，我的這種改良版鱷鱷炮炮！可是很好玩的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850126
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850126,
					"content": "我根據沙蒂永先生留下的圖紙做了一些改善，新型號不再需要裝填步驟，還有切換彈種的功能！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850127
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850127,
					"content": "而且我還豐富了標靶與關卡設計，讓整個遊樂設施更具挑戰性！我連續玩了三天都沒有感覺到審美疲勞！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850128
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850128,
					"content": "#{F#妳}{M#你}們玩了以後一定也會忘掉煩惱，快快樂樂！對了，如果滿意的話，請幫我向其他人也宣傳一下這個遊樂設施吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850129,
						746850130
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850129,
					"content": "那我們也不提工作和失業了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746850131
					]
				},
				{
					"id": 746850131,
					"content": "話都說到這裡了，我要放開玩了哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746850132,
					"content": "布蕾斯特小姐說得沒錯，我們的溝通很暢快！希望其他人遇到不順心的事…也可以學學布蕾斯特小姐的心態！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746850130,
					"content": "那我們就來玩玩新鱷鱷炮炮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746850131
					]
				},
				{
					"id": 746850119,
					"content": "從事產業差太多了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746850120
					]
				},
				{
					"id": 746850108,
					"content": "欸，這不是「鱷鱷炮炮」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746850109
					]
				},
				{
					"id": 746850109,
					"content": "對哦！我想起來了，這是我們在「琉形蜃境」裡見過的「鱷鱷炮炮」！但操縱水炮的人…好像不是沙蒂永先生？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746850110,
					"content": "#沙蒂永先生？{F#妳}{M#你}們居然知道那位傳奇火炮設計師…代表{F#妳}{M#你}們也是專家了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850111
					],
					"speakerTitle": "布蕾斯特"
				},
				{
					"id": 746850111,
					"content": "#看來{F#妳}{M#你}們和這門水炮很有緣嘛！要不要來當我的第一批客人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746850112
					],
					"speakerTitle": "布蕾斯特"
				}
			]
		}
	]
}