					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慧心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110180101,
					"content": "#{NICKNAME}、派蒙，好久不見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180102
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180102,
					"content": "咦？慧心，好久不見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180103,
					"content": "沒想到在這裡遇見妳，最近工作還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180104,
					"content": "#多虧了{F#妳}{M#你}們和甘雨前輩的幫助，我已經愈來愈得心應手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180105
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180105,
					"content": "不過最近工作的時候總會分神，感覺靜不下心來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180106
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180106,
					"content": "發生什麼事了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180107
					]
				},
				{
					"id": 110180107,
					"content": "唉，說來話長。父親他…因為身體原因，想要卸任「天樞星」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180108
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180108,
					"content": "欸——天叔出什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180109,
					"content": "按父親的說法，倒是沒什麼身體上的不適，只是感覺精力愈來愈匱乏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180110
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180110,
					"content": "「每個人都有老去的一天」…雖然父親常常這麼說，但看到他臉上的皺紋愈來愈深，我心裡還是有一種說不出的滋味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180111
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180111,
					"content": "對了，父親他現在在岩上茶室二樓。要不要一起來探望一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180112
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180112,
					"content": "#父親似乎很喜歡{F#妳}{M#你}們，能和{F#妳}{M#你}們聊聊天的話，他應該也會很開心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180113
					],
					"speakerTitle": "慧心"
				},
				{
					"id": 110180113,
					"content": "好呀！那我們過去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1101803,
			"completionStepIds": [
				1101803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101803",
							"2"
						],
						"stepId": 1101803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"天叔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110180301,
					"content": "天叔！我們來找你聊天啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180302,
					"content": "哦？這可真是稀客，歡迎。慧心，妳去找樓下的掌櫃，再加一壺新到的茶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180303
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180303,
					"content": "#聽說{F#妳}{M#你}們最近又去了不少地方，我也想聽聽{F#妳}{M#你}們的冒險故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180304,
						110180305
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180304,
					"content": "我們更擔心天叔的身體。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180306
					]
				},
				{
					"id": 110180306,
					"content": "#看來{F#妳}{M#你}們已經聽慧心說了…放心吧，我的身體沒什麼大礙，只是歲月不饒人罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180307
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180307,
					"content": "隨著年紀愈來愈大，我開始對許多事情感到力不從心。最近這段時間，更是感覺精力直線下滑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180308
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180308,
					"content": "雖然大家都說我德高望重，但我也想趁自己還沒老糊塗，把天樞星的位置交接出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180309
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180309,
					"content": "天樞星交接…會很麻煩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180310,
					"content": "在璃月七星中，天樞星的存在比較特殊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180311
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180311,
					"content": "歷代天樞星很少公開露面，大多是在背後出謀劃策，所以不適合公開選拔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180312
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180312,
					"content": "而且，我們希望天樞星的候選人盡量不要受各方勢力影響，所以考核與委任也會相對隱秘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180313
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180313,
					"content": "基於這些原因，天樞星的更替，通常是上代天樞星給出意見，其餘七星成員共同確認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180314
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180314,
					"content": "也就是說…是由天叔推薦候選人，然後由刻晴、凝光小姐還有其他七星一起任命？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180315,
					"content": "沒錯。只可惜以我現在的身體狀況，來不及對候選人一一考核了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180316
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180316,
					"content": "#不過沒關係，我特地找來了一位能力很強的考官。說起來，聽說{F#妳}{M#你}們已經和她見過面了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180317
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180317,
					"content": "咦？是誰呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180318,
					"content": "#真讓人難過…這才多久不見，{F#妳}{M#你}們就把我忘了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180319
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180319,
					"content": "是夜蘭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180320,
					"content": "沒錯，受天叔邀請，由我來對三位候選人進行調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180321
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180321,
					"content": "#{NICKNAME}，{F#妳}{M#你}跟我一起來如何？這可是能提前認識下一代天樞星的好機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180322
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180322,
					"content": "#唔…{NICKNAME}，{F#妳}{M#你}覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180323,
						110180325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180323,
					"content": "是個機會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180324
					]
				},
				{
					"id": 110180324,
					"content": "我也這麼覺得！和七星搞好關係，總不是什麼壞事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180328,
					"content": "那就這麼說定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180329
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180329,
					"content": "不過天叔，你平時喜歡在暗處謀劃，我也習慣暗中活動。不覺得我也有成為天樞星的潛質嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180330
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180330,
					"content": "欸！夜蘭也想當天樞星嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180331,
					"content": "我倒是不介意，但妳和凝光合作那麼久，她恐怕不會輕易放人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180332
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180332,
					"content": "這樣好了…如果考察的結果是無人勝任，我就推薦妳來幫我幹這個活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180333
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180333,
					"content": "沒問題。這事先不急，考察的內容我已經提前佈置下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180334
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180334,
					"content": "等下我們在一樓見面吧。在那之前…你們可以先把天聊完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180335
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180335,
					"content": "茶就不用付帳了，作為岩上茶室的「新主人」，一壺好茶還是請得起的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180336
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180336,
					"content": "向天叔講述了最近的冒險故事後，回到了茶室門口…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110180337
					]
				},
				{
					"id": 110180337,
					"content": "聊完了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180338
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180338,
					"content": "感覺天叔確實沒什麼精神，有些睏懨懨的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180339,
					"content": "嗯。雖然這麼說很殘酷，但以天叔現在的精神狀態，確實不適合再擔任繁重的工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180340
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180340,
					"content": "天叔推薦的候選人總共有三位，分別是：乾瑋、明博和知易。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180341
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180341,
					"content": "其中乾瑋是富商出身，明博在璃月總務司任職，知易正在求學遊歷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180342
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180342,
					"content": "#{F#妳}{M#你}可以大致記一下…當然，記不住也沒關係，等下我們會到月海亭考察他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180343
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180343,
					"content": "乾瑋、明博還有知易…勉強記住了，不過「考察」又是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180344
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180344,
					"content": "這個我們到月海亭再說就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180345
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180345,
					"content": "打起精神來，這可是涉及七星更迭的大事，任何蛛絲馬跡都不能放過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180346
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180346,
					"content": "#明白！{NICKNAME}，我們一定要擦亮眼睛才行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180325,
					"content": "不感興趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180326
					]
				},
				{
					"id": 110180326,
					"content": "確實，誰是下一代天樞星對我們好像沒什麼影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180327,
					"content": "不過天叔會挑選什麼樣的候選人，真讓人好奇！我們還是去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180305,
					"content": "天叔的身體不要緊嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180306
					]
				}
			]
		},
		{
			"id": 1101804,
			"completionStepIds": [
				1101804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101804",
							"2"
						],
						"stepId": 1101804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"乾瑋",
					"明博",
					"知易",
					"夜蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110180401,
					"content": "站得我腿都麻了…真不知道那考察官在想些什麼，這麼重要的場合，連張椅子都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180402
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110180402,
					"content": "我也曾和各種各樣的人打交道，還是第一次站著等別人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180403
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110180403,
					"content": "啊，我倒是…覺得還好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180404
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110180404,
					"content": "你那是習慣了。總是像這樣接受現狀的話，將來也什麼都改變不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180405
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110180405,
					"content": "你這個人，怎麼這麼…不講道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180406
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110180406,
					"content": "好了兩位，為這點小事爭吵，實在有些不值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180407
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110180407,
					"content": "乾瑋，你剛剛的話有些重了。明博，你也別太計較…站了許久，誰都有些焦躁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180408
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110180408,
					"content": "我看不如這樣：既然沒規定我們一定要站著等，那我們不如去附近商會借幾張椅子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180409
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110180409,
					"content": "也好。雖然那些椅子材質一般，但非常之時，能用就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180410
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110180410,
					"content": "跟著夜蘭進到了考察現場…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110180411
					]
				},
				{
					"id": 110180411,
					"content": "看來三位候選人都已經到齊了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180412
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180412,
					"content": "所以剛剛那三位就是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180413
					]
				},
				{
					"id": 110180413,
					"content": "#嗯，很快就會跟他們正式見面。在那之前，我先跟{F#妳}{M#你}講解一下這次的考察流程。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180414
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180414,
					"content": "這次考察，我分成了兩個環節，分別是「時事方略」與「現場問答」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180415
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180415,
					"content": "第一個環節是讓他們提交璃月發展規劃，第二個環節則是由我們進行現場詢問。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180416
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180416,
					"content": "因為書寫璃月發展規劃需要時間，所以我已經提前佈置下去了，這些就是收上來的報告書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180417
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180417,
					"content": "嗚哇，總覺得有一疊特別地厚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180418,
					"content": "順帶一提，我對他們講了一個要求：不管誰成為天樞星，都要將自己規劃的內容悉數落實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180419
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180419,
					"content": "除非發生什麼重大變故，否則不能更改規劃書上的內容。所以眼前這三份檔，其實代表著他們三個人的「立場」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180420
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180420,
					"content": "#還有點時間，{F#妳}{M#你}可以大致看一看，對他們有一個初步的印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180421
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180421,
					"content": "#我在旁邊等{F#妳}{M#你}，看完之後，就來找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				}
			]
		},
		{
			"id": 1101806,
			"completionStepIds": [
				1101806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101806",
