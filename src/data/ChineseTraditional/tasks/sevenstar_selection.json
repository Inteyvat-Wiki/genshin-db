			},
			"dialogs": [
				{
					"id": 110180901,
					"content": "（知易的規劃書，涉及到內政、外交、監察等各方各面，非常詳實。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180902
					],
					"speakerTitle": "知易的規劃書"
				},
				{
					"id": 110180902,
					"content": "（看上去以「解決問題」為核心，針對各種問題都給出了簡潔明確的解決方案。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180903
					],
					"speakerTitle": "知易的規劃書"
				},
				{
					"id": 110180903,
					"content": "（因為實在太厚，只來得及粗略翻閱…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "知易的規劃書"
				}
			]
		},
		{
			"id": 1101810,
			"completionStepIds": [
				1101810
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101810",
							"2"
						],
						"stepId": 1101810,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"夜蘭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110181001,
					"content": "這麼快就看完了？有什麼感受嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181002
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181002,
					"content": "感覺大家都好認真…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110181003,
					"content": "那當然，畢竟涉及到天樞星的選拔，所有人都卯足了力氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181004
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181004,
					"content": "更何況，一旦他們上臺，就要遵照規劃來處理事務了，誰都不想留下什麼遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181005
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181005,
					"content": "夜蘭的感受呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181006
					]
				},
				{
					"id": 110181006,
					"content": "呵呵，暫時保密。等「現場問答」結束後，我們再好好聊聊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181007
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181007,
					"content": "可以讓候選人過來了。一個一個來吧，先從乾瑋開始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181008
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181008,
					"content": "是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181009
					],
					"speakerTitle": "禮安"
				},
				{
					"id": 110181009,
					"content": "禮安將乾瑋帶了過來…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110181010
					]
				},
				{
					"id": 110181010,
					"content": "#哦？{F#妳}{M#你}們兩位就是這次的考察官嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181011
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110181011,
					"content": "本來以為像這麼重要的事情，會是凝光大人親自來考察，沒想到居然來了我不認識的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181012
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110181012,
					"content": "#我的規劃{F#妳}{M#你}們應該看過了吧。要是有理解不了的地方，可以找我講解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181013
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110181013,
					"content": "好、好大的口氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110181014,
					"content": "抱歉，我沒有特別針對誰，只是在闡述一個事實而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181015,
						110181016
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110181015,
					"content": "你的聊天水準…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181017
					]
				},
				{
					"id": 110181017,
					"content": "#留雲借風，{F#妳}{M#你}認識那位仙人嗎？哦…我想起來了，{F#妳}{M#你}應該就是人們口口相傳的那位旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181018
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110181018,
					"content": "#既然{F#妳}{M#你}聲名在外，想必有些才學，說不定能理解我的構想…哼，雖然我也沒抱太大希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181019
					],
					"speakerTitle": "乾瑋"
				},
				{
					"id": 110181019,
					"content": "夜蘭對乾瑋進行一番詢問後，讓他去叫來了明博。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110181020
					]
				},
				{
					"id": 110181020,
					"content": "啊…到我了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181021
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181021,
					"content": "嗯，簡單介紹一下你自己吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181022
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181022,
					"content": "我是明博…隸屬於總務司。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181023
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181023,
					"content": "我在總務司工作了九年…五個月…零三天。先後處理過…兩千三百四十七宗事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181024
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181024,
					"content": "還有十二起正在處理…預計大概…十六天後會全部解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181025
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181025,
					"content": "目前我的工作與城市規劃相關，也在負責帳目驗收與核對。準確來說是三部分帳目，分別是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181026
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181026,
					"content": "感覺他講話有些磕磕絆絆的，是我的錯覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181027
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110181027,
					"content": "算了，先停下自我介紹吧，我直接問問題好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181028
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181028,
					"content": "啊…好。抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181029
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181029,
					"content": "夜蘭勉強對明博進行一番詢問後，讓他去叫來了知易。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110181030
					]
				},
				{
					"id": 110181030,
					"content": "#{F#妳}{M#你}們好。呼…說實話，我還真有點緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181031
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181031,
					"content": "不知兩位想問些什麼？既然是考察，我會在我能力範圍內予以回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181032
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181032,
					"content": "我看你的規劃涉及各個領域，但你好像並未從事許多職業，你能保證自己的規劃切實可行嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181033
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181033,
					"content": "毫不留情的提問…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181034
					]
				},
				{
					"id": 110181034,
					"content": "兩位有這樣的疑問，我覺得很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181035
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181035,
					"content": "不過對於規劃，我很有信心。我曾外出考察許多地方，與當地更為專業的人進行交流，最終得出結論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181036
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181036,
					"content": "當然，不同問題之間錯綜複雜，對應的結論也有衝突。所以我想要的是「平衡」，也就是在所有問題中找到一個「最佳解」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181037
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181037,
					"content": "那你怎麼判斷自己得出的「最佳解」是真是假呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181038
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181038,
					"content": "規劃施行前，有我的同僚以及月海亭的秘書們進行評估；規劃施行後，一切以最終效果為主。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181039
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181039,
					"content": "如果真的是我判斷失誤，我會為此承擔相應責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181040
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181040,
					"content": "回答得不錯。那我們換下一個問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181041
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181041,
					"content": "夜蘭對知易進行一番詢問後，讓他離開了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110181042
					]
				},
				{
					"id": 110181042,
					"content": "感覺是一個很好相處的人呢！說話也很有條理，讓人聽著很舒服！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181043,
						110181044
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110181043,
					"content": "沒錯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181045
					]
				},
				{
					"id": 110181045,
					"content": "現在可以簡單地做個總結了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181046
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181046,
					"content": "#就像{F#妳}{M#你}看到的一樣，乾瑋見識不凡，他在規劃裡寫的許多策略都切中要害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181047
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181047,
					"content": "但他為人很有傲氣，非常固執，也不太願意體察身邊人的感受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181048
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181048,
					"content": "明博的規劃更加全面，也更加穩健。能看出他是一個很細膩的人，在細節處理上很出彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181049
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181049,
					"content": "但他與乾瑋似乎是兩個極端。明博不善言辭，在與人交流中顯得很弱勢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181050
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181050,
					"content": "總結得真好，好像的確是這樣，不愧是夜蘭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181051
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110181051,
					"content": "最後是知易。他的規劃詳實、方略可靠，涉及領域十分廣泛，頗為難得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181052
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181052,
					"content": "這可不是走馬觀花，不下苦工是做不到的。而且他性格謙和，待人接物也沒什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181053
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181053,
					"content": "不過真正讓我感興趣的，是他的許多觀點都與天叔不謀而合。如果知易順利上位，天叔應該也能放心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181054
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181054,
					"content": "太好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181055
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110181055,
					"content": "走，我們回去向天叔彙報吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110181044,
					"content": "沒什麼感覺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181045
					]
				},
				{
					"id": 110181016,
					"content": "該不會是師從留雲借風…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110181017
					]
				}
			]
		},
