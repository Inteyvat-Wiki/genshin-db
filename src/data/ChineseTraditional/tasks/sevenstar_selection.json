					"content": "（明博的規劃書，涉及到了內政民生的方方面面。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180802
					],
					"speakerTitle": "明博的規劃書"
				},
				{
					"id": 110180802,
					"content": "（「大道之行，天下為公」，這似乎是明博的理念。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
