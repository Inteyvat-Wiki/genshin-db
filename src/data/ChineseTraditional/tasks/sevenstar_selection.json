			"dialogs": [
				{
					"id": 110181701,
					"content": "說起來，你們知道這次的考察官是誰嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181702
					],
					"speakerTitle": "知易"
				},
				{
					"id": 110181702,
					"content": "不太清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110181703
					],
					"speakerTitle": "明博"
				},
				{
					"id": 110181703,
					"content": "我也不知道。不過最好是來個內行的人，我可不太想被外行考校。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
