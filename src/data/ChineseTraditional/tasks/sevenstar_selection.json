			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"天叔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110180601,
					"content": "跟天叔講述了整個考核流程…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110180602
					]
				},
				{
					"id": 110180602,
					"content": "咳咳…嗯，和我預想中的差不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180603
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180603,
					"content": "那我就直接問了，天叔。知易的規劃思路跟你很像，這裡面有什麼理由嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180604
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180604,
					"content": "#給{F#妳}{M#你}們候選人名單的時候不方便說，擔心干擾{F#妳}{M#你}們的判斷，不過現在可以聊聊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180605
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180605,
					"content": "那三位候選人，都曾跟我學習過一段時間，難免與我有些相似。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180606
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180606,
					"content": "不過乾瑋忙於經商，明博有總務司的工作要做。相比之下，知易待在我身邊的時間更久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180607
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180607,
					"content": "哇！天叔是怎麼和他們認識的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180608,
					"content": "乾瑋是一位老友推薦給我的，明博則是我在工作中注意到的。至於知易…哈哈，倒像是一個意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180609
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180609,
					"content": "剛開始我們只是偶然認識的釣友，後來慢慢熟絡，才開始聊各種話題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180610
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180610,
					"content": "知易出身寒門，父母過世很早。但他天賦出眾，學什麼都很快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180611
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180611,
					"content": "看到他，我就想到年輕時的自己。於是經常在釣魚的時候指點他幾句，他也會很快領悟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180612,
						110180613
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180612,
					"content": "感覺更像是「朋友」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180614
					]
				},
				{
					"id": 110180614,
					"content": "沒錯。不知不覺，他就成長到了這樣的高度。現在想想，真是令人既欣慰又感慨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180615
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180615,
					"content": "年輕人一個個成長起來，我也老了。時間過得可真快，生老病死果然是人人都繞不開的坎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180616
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180616,
					"content": "我怎麼覺得天叔的身體還很硬朗，能再為工作辛勞幾年？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180617
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180617,
					"content": "妳啊妳，用不著安慰我。精力不夠用也挺好的，卸下了擔子，我終於能像個普通老頭一樣，自由自在地去釣魚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180618
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180618,
					"content": "天叔很喜歡釣魚呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180619,
					"content": "想要消磨時光，釣魚絕對是不二之選。而且剛釣上的魚非常新鮮，在水邊處理一下，就能煮出一鍋鮮美的魚湯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180620
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180620,
					"content": "新鮮的魚湯！唔，聽上去就非常好喝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180621,
					"content": "是吧？而且前段時間，知易還從一位老漁夫手上買到了特別的食譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180622
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180622,
					"content": "最近每次釣魚，知易都會帶一些處理好的配料。加了配料之後，味道比以前還要鮮美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180623
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180623,
					"content": "真令人回味無窮…可惜我這把老骨頭，恐怕喝不了幾次啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180624
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180624,
					"content": "還能喝很多很多次的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180625
					]
				},
				{
					"id": 110180625,
					"content": "下次能帶上我嗎？我也想嚐嚐看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180626,
					"content": "言歸正傳，天叔。聽完彙報之後，你有結論了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180627
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180627,
					"content": "既然委託妳來考察，那我相信妳的判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180628
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180628,
					"content": "#若非{F#妳}{M#你}們問我，知易為何許多想法與我相似，我本不打算提起我與他們三位的私交。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180629
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180629,
					"content": "#舉賢講求公正，請{F#妳}{M#你}們務必刨除這些外因，將候選人的才華與能力調查清楚再下結論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180630
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180630,
					"content": "記住…一定要「調查清楚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180631
					],
					"speakerTitle": "天叔"
				},
				{
					"id": 110180631,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180632
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180632,
					"content": "#走吧，{NICKNAME}，我們換個地方說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180633
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180633,
					"content": "那天叔，我們先告辭啦，一定要注意身體呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180634,
					"content": "跟夜蘭來到了茶室外…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						110180635
					]
				},
				{
					"id": 110180635,
					"content": "嗯…果然就決定是知易了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180636,
					"content": "妳看，他規劃寫得好，說話又好聽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180637,
					"content": "不急，考察又沒有時間限制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180638
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180638,
					"content": "咦，難道夜蘭還準備了什麼測試嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180639
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180639,
					"content": "#那倒沒有，對他們本人的考察已經結束了。不過給{F#妳}{M#你}們一個忠告：眼見未必為實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180640
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180640,
					"content": "情報工作最忌諱的，就是只從當事人身上瞭解訊息。真相外面總是蒙著層層迷霧，所以需要透過各種管道去收集情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180641
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180641,
					"content": "文淵、商華。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180642
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180642,
					"content": "在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180643
					],
					"speakerTitle": "文淵"
				},
				{
					"id": 110180643,
					"content": "夜蘭大人有何吩咐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180644
					],
					"speakerTitle": "商華"
				},
				{
					"id": 110180644,
					"content": "突然就出現了不認識的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180645
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180645,
					"content": "嚇到妳了嗎？這兩位是我的手下，文淵和商華。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180646
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180646,
					"content": "作為我的得力助手，他們平時在附近警戒，必要時也會去執行各種任務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180647
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180647,
					"content": "商華精通商務，喜歡以交易換取情報；文淵則多靠遊說來獲知消息。除了他們之外，還有目前不在場的武沛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180648
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180648,
					"content": "那大塊頭在海上盯梢有一段時間了吧，沒問題嗎？印象中他不會游泳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180649
					],
					"speakerTitle": "文淵"
				},
				{
					"id": 110180649,
					"content": "嘿，那傢伙命大著呢，這點小風小浪還不算什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180650
					],
					"speakerTitle": "商華"
				},
				{
					"id": 110180650,
					"content": "商華，你去各個商會，調查乾瑋的背景；文淵，你去璃月總務司，查一下明博的工作檔案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180651
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180651,
					"content": "是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180652
					],
					"speakerTitle": "商華"
				},
				{
					"id": 110180652,
					"content": "欸？那知易呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180653
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180653,
					"content": "知易？作為最有希望的候選人，知易當然是由我們親自調查了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180654
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180654,
					"content": "先去港口看看吧，那裡人多嘴雜，是各種消息傳播的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180655
					],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180655,
					"content": "說到打聽消息，不如我們去問問「萬有鋪子」的老闆博來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180656
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180656,
					"content": "他一直在北碼頭做生意，說不定聽說過什麼消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110180657
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110180657,
					"content": "嗯，這倒是個不錯的選擇。去問問看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夜蘭"
				},
				{
					"id": 110180613,
					"content": "感覺更像是「家人」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110180614
					]
				}
			]
		},
		{
