			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"古德溫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200370101,
					"content": "…唉，真想直接回蒙德城算了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370102
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370102,
					"content": "#呃，旅行者！那個，{F#妳}{M#你}能幫我個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370103
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370103,
					"content": "#如{F#妳}{M#你}所見，我是一名西風騎士，正在野外執行巡邏任務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370104
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370104,
					"content": "我和我的女朋友說好，隔段時間就會寄封信給她報平安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370105
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370105,
					"content": "#結果我居然忙到忘記了，哈哈哈…請{F#妳}{M#你}幫我把這封<color=#00E1FFFF>信</color>送給她吧，她叫<color=#00E1FFFF>葛蘿麗</color>…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370106
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370106,
					"content": "等等，葛蘿麗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370107
					]
				},
				{
					"id": 200370107,
					"content": "那位盲眼的…收集蒲公英的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200370108,
					"content": "喂！葛蘿麗小姐說的古德溫，原來就是你嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200370109,
					"content": "咦，為什麼你們會認識葛蘿麗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370110
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370110,
					"content": "我們幫過她的忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370111
					]
				},
				{
					"id": 200370111,
					"content": "她、她找你們幫忙？是要做什麼危險的事嗎？你們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370112
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370112,
					"content": "葛蘿麗小姐只是拜託我們幫她蒐集蒲公英啦。說是撒在空中的話，可以把心願傳達給你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200370113,
					"content": "啊，蒲公英…確實像是葛蘿麗會做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370114
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370114,
					"content": "你不是離開蒙德城很久了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370115
					]
				},
				{
					"id": 200370115,
					"content": "本來應該是這樣。算了…我就說了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370116
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370116,
					"content": "#{F#妳}{M#你}有沒有聽說，大團長把五分之四騎士帶出蒙德的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370117
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370117,
					"content": "是的，我也是騎士團遠征隊的一員…但在出征之前，我因為弄丟了葛蘿麗的信物，想要尋找，卻脫了隊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370118
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370118,
					"content": "到現在也沒找到歸隊的方法，只能一直在這附近轉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370119
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370119,
					"content": "我也不好意思回蒙德城，就這麼灰溜溜地回去，西風騎士們都會怎麼看我啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370120
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370120,
					"content": "還有葛蘿麗，我答應她，會在世界各地給她寄信和禮物，把「全世界」都帶給她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370121
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370121,
					"content": "要是她知道我連蒙德都沒走出去…的…話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370122
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370122,
					"content": "原來是面子問題呀",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200370123,
					"content": "#拜託了，{F#妳}{M#你}能幫我把這封<color=#00E1FFFF>信</color>送給<color=#00E1FFFF>葛蘿麗</color>嗎？說不定，她還在為我擔心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370124,
						200370126
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370124,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370125
					]
				},
				{
					"id": 200370125,
					"content": "#那就拜託{F#妳}{M#你}了，旅行者，千萬幫我保密啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370126,
					"content": "你乾脆也用蒲公英好了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370127
					]
				},
				{
					"id": 200370127,
					"content": "我想對葛蘿麗說的話太多了，蒲公英怎麼可能載得動嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370128
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370128,
					"content": "#信就拜託{F#妳}{M#你}了，千萬幫我保密！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "古德溫"
				}
			]
		},
