			},
			"dialogs": [
				{
					"id": 200370301,
					"content": "您好…啊，這個聲音，是之前的那位旅行者吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370302
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200370302,
					"content": "請問您找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370303
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200370303,
					"content": "有人託我帶給妳一封信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370304
					]
				},
				{
					"id": 200370304,
					"content": "信？誰會給我寫信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370305
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200370305,
					"content": "難道是古德溫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370306
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200370306,
					"content": "您遇見他了嗎？他還好吧，他說過自己會什麼時候回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370307
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200370307,
					"content": "抱歉，他現在一定很忙，請您忘了我剛說的話吧，不要再給他壓力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370308
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200370308,
					"content": "能請您現在就幫我念念這封信嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370309
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200370309,
					"content": "請小聲一點，我們兩個人聽得到就好啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370310
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200370310,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370311
					]
				},
				{
					"id": 200370311,
					"content": "您念得真不錯…難道，您經常給人念信嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370312
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200370312,
					"content": "信就寫到這裡了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370313
					]
				},
				{
					"id": 200370313,
					"content": "璃月港…古德溫真的去了很遠的地方啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370314
					],
					"speakerTitle": "葛蘿麗"
				},
				{
					"id": 200370314,
					"content": "#謝謝{F#妳}{M#你}，我會珍藏這封信的，再見到<color=#00E1FFFF>古德溫</color>的時候，記得替我向他問聲好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370315
					],
					"speakerTitle": "葛蘿麗"
				}
			]
		},
