			},
			"dialogs": [
				{
					"id": 200370501,
					"content": "信送到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370502
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370502,
					"content": "葛蘿麗向你問好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200370503
					]
				},
				{
					"id": 200370503,
					"content": "呼…我這麼久沒聯絡她，還好她沒生氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370504
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370504,
					"content": "你一直在蒙德周圍，為什麼會知道璃月港的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 200370505,
					"content": "那個啊，呃…這些故事我都是聽大團長說的，他去過很多地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370506
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370506,
					"content": "#好了，謝謝{F#妳}{M#你}，幫了我這麼大的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200370507
					],
					"speakerTitle": "古德溫"
				},
				{
					"id": 200370507,
