						"stepId": 300804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"毗伽爾",
					"迪娜澤黛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30080401,
					"content": "法里斯！法里斯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080402
					],
					"speakerTitle": "帕奇"
				},
				{
					"id": 30080402,
					"content": "好了，兵士們，拿了雅爾達糖的獎賞，就要對小吉祥草王心懷忠誠，解散吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080403
					],
					"speakerTitle": "毗伽爾"
				},
				{
					"id": 30080403,
					"content": "是！法里斯騎士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080404
					],
					"speakerTitle": "帕奇"
				},
				{
					"id": 30080404,
					"content": "這是什麼情況，在演戲嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080405,
					"content": "花之騎士法里斯也是花神誕祭的一種象徵，很受孩子們歡迎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080406
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 30080406,
					"content": "要不是迪娜澤黛小姐的贊助，孩子們也沒機會見到我這個花之騎士啊，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080407
					],
					"speakerTitle": "毗伽爾"
				},
				{
					"id": 30080407,
					"content": "#哦對了，{F#妳}{M#你}們要不要也來點雅爾達糖果，都在這些盒子裡，{F#妳}{M#你}們挑挑看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080408
					],
					"speakerTitle": "毗伽爾"
				},
				{
					"id": 30080408,
					"content": "挑？這些看起來不都一樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080409,
					"content": "哈哈，可沒那麼簡單，每個盒子裡都裝著隨機的一種口味，要看運氣。糖果有堇瓜味、日落果味、香辛果味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080410
					],
					"speakerTitle": "毗伽爾"
				},
				{
					"id": 30080410,
					"content": "欸，確實感覺很好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080411,
					"content": "…然後還有蜥蜴尾巴味和鬼兜蟲味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080412
					],
					"speakerTitle": "毗伽爾"
				},
				{
					"id": 30080412,
					"content": "欸！怎麼會有這種味道的糖啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080413,
					"content": "#唔…還是{F#妳}{M#你}來幫忙選吧，我要吃日落果味的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
