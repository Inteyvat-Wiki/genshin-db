			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪娜澤黛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30080101,
					"content": "早安，迪娜澤黛，不好意思我們遲到了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080102,
					"content": "沒有，是我來得太早了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080103
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 30080103,
					"content": "妳好像有點沒精神…是沒睡好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080104,
					"content": "我很好，不用擔心。我們走吧？先去那邊的攤位上逛逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080105
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 30080105,
					"content": "#好啊…欸？旅行者，{F#妳}{M#你}在發什麼呆呢，我們快走吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 300802,
			"completionStepIds": [
				300802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"300802",
							"2"
						],
						"stepId": 300802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪娜澤黛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 30080201,
					"content": "這裡是賣「七鮮桌」菜品的攤位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080202
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 30080202,
					"content": "您可真有見識，小姐，我還以為現在沒什麼人知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080203
					],
					"speakerTitle": "阿瑪爾"
				},
				{
					"id": 30080203,
					"content": "怎麼好像都是些素的食物呀，唔，有點失望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080204,
					"content": "說起來，妳剛才說的「七鮮桌」是什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080205,
					"content": "是花神誕祭的一種習俗，人們在餐桌上擺滿這些菜品，用來象徵須彌神明的七種美德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080206,
						30080207
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 30080206,
					"content": "等等…從剛才開始…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080208
					]
				},
				{
					"id": 30080208,
					"content": "…從灰塵上看，應該是「月亮」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080209
					],
					"speakerTitle": "齊米亞"
				},
				{
					"id": 30080209,
					"content": "真的嗎，我怎麼覺得像是某種吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080210,
					"content": "嗯…「月亮」象徵著…嗯…我有點忘了，稍等下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080211
					],
					"speakerTitle": "齊米亞"
				},
				{
					"id": 30080211,
					"content": "他在偷偷翻書吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080212,
					"content": "哦，對了對了，意味著「虛幻」與「謊言」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080213
					],
					"speakerTitle": "齊米亞"
				},
				{
					"id": 30080213,
					"content": "但只要相信自己的直覺，克服心中的恐懼，太陽就一定會升起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080214,
						30080215
					],
					"speakerTitle": "齊米亞"
				},
				{
					"id": 30080214,
					"content": "似乎聽過這句話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080216
					]
				},
				{
					"id": 30080216,
					"content": "明白了，我會參考的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080217
					],
					"speakerTitle": "迪娜澤黛"
				},
				{
					"id": 30080217,
					"content": "啊…哪裡哪裡，我也不過是現學現賣而已，哈哈…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30080218
					],
					"speakerTitle": "齊米亞"
				},
				{
					"id": 30080218,
					"content": "好像也挺有趣的，走吧，我們去下一站。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30080215,
					"content": "是「既視感」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080216
					]
				},
				{
					"id": 30080207,
					"content": "總有種熟悉的感覺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						30080208
					]
				}
			]
		},
