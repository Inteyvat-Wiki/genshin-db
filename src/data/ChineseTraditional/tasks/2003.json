	"talks": [
		{
			"id": 200301,
			"completionStepIds": [
				200301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200301",
							"2"
						],
						"stepId": 200301,
						"stateName": "QUEST_STATE_UNFINISHED"
