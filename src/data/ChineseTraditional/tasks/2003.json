			"dialogs": [
				{
					"id": 20030401,
					"content": "這就是稻妻大戶人家的宅子嗎？沒有想像中那麼…誇張？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030402,
						20030403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030402,
					"content": "畢竟我們見識過群玉閣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030404
					]
				},
				{
					"id": 20030404,
					"content": "歡迎來到神里府，兩位貴客，小姐也已經等候兩位多時了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030405
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030405,
					"content": "是你一直提到的那位「白鷺公主」吧，她在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030406,
					"content": "咳…咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030407
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030407,
					"content": "屏風後面？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030408,
					"content": "呵呵，作為社奉行的大小姐，神里小姐一般都是這樣待客的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030409
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030409,
					"content": "可以說也算是社奉行百年來的習俗，請見諒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030410,
						20030411
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030410,
					"content": "似乎可以理解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030412
					]
				},
				{
					"id": 20030412,
					"content": "畢竟是高貴的「白鷺公主」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030413,
					"content": "兩位漂洋過海，旅途勞頓，到府上卻又只能這般相見，請恕禮數不周。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030414
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030414,
					"content": "我一直很期待兩位的到來，從托馬的轉述中，也確信了兩位所擁有的「改變時局」的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030415
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030415,
					"content": "如今的稻妻，在眼狩令的推行下，民眾的願望正被肆意蹂躪踐踏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030416
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030416,
					"content": "社奉行雖為將軍服務，但因職責的緣故，又是與民生最貼近的一方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030417
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030417,
					"content": "奉行的權力本就源自於民眾的信任，如果對這樣的情況坐視不理，又怎能夠心安理得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030418
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030418,
					"content": "#旅行者，請將{F#妳}{M#你}的力量借給我，我們一定能夠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030419,
						20030420
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030419,
					"content": "我來只是想見雷電將軍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030421
					]
				},
				{
					"id": 20030421,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030422
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030422,
					"content": "我說了吧，小姐…那樣行不通的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030423
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030423,
					"content": "我準備走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030424
					]
				},
				{
					"id": 20030424,
					"content": "啊、啊…等一下！請先…先別走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030425
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030425,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030426
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030426,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030427
					]
				},
				{
					"id": 20030427,
					"content": "#我會幫{F#妳}{M#你}引薦雷電將軍，但前提是…{F#妳}{M#你}要幫我完成三個小心願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030428
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030428,
					"content": "什麼心願？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030429,
					"content": "#是關於…三個失去神之眼的人…等{F#妳}{M#你}見過他們，或許就能明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030430
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030430,
					"content": "守護著村莊的武人、過去的眼狩令執行武士，還有曾以天下第一為目標的劍道家是吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030431,
					"content": "#沒錯，請盡可能地幫助他們，我會在這裡等{F#妳}{M#你}們回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030432,
						20030433
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030432,
					"content": "我答應妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030434
					]
				},
				{
					"id": 20030434,
					"content": "呵呵，那就拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030435
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 20030435,
					"content": "加油啊，夥計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
