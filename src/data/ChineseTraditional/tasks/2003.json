				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"托馬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030101,
					"content": "可算到了，托馬呢？托馬在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030102,
					"content": "欸…托馬那個傢伙難道沒有守約嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030103,
					"content": "#誰說沒有守約，我還要為{F#妳}{M#你}們忘記我的事而傷心呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030104
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030104,
					"content": "怎、怎麼回事！是狗說話了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030105,
					"content": "#哈哈哈…沒什麼好驚訝的，{F#妳}{M#你}們還是第一次見到這樣的我吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030106,
						20030107
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030106,
					"content": "托馬是…狗？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				},
				{
					"id": 20030108,
					"content": "#唔…{F#妳}{M#你}們在璃月，沒見過類似的狀況嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030109
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030109,
					"content": "這樣啊，我好像一下子就理解了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030110,
						20030111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030110,
					"content": "這有點不對勁吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030112,
					"content": "哈哈哈哈哈…好了好了，不開這種玩笑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030113
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030113,
					"content": "喂！你這個傢伙怎麼這樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030114,
					"content": "#在離島的時候也是，在茶室也是，等待{F#妳}{M#你}們的時間有點太長了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030115
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030115,
					"content": "所以想了這個特殊的接待方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030116
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030116,
					"content": "不過…還是請允許我鄭重地向兩位道個歉。之前的種種「考驗」，都是必要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030117
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030117,
					"content": "#這決定著我能否將{F#妳}{M#你}們帶到神里小姐的面前，決定著我們能否成為…敢於一同直接面對雷光的夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030118
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030118,
					"content": "別以為你突然嚴肅認真起來，我就會原諒你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030119,
					"content": "啊哈…做得太過火了嗎，抱歉抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030120,
						20030121
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030120,
					"content": "那麼…考驗的結果呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030122,
					"content": "#{F#妳}{M#你}一開始便將自己凌駕於那些「規則」之上，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030123
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030123,
					"content": "#因為{F#妳}{M#你}的「意志」從未動搖，也不曾屈服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030124
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030124,
					"content": "在很久以前，我們也認識過這樣一位夥伴，只是雷光閃過之後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030125,
						20030126
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030125,
					"content": "你是說萬葉的那個朋友…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030127,
					"content": "#噢，居然連{F#妳}{M#你}們也聽說過他的故事，看來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030128
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030128,
					"content": "…他的光芒一點也不微弱啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030129
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030129,
					"content": "於是我們可以去見「白鷺公主」了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030130
					]
				},
				{
					"id": 20030130,
					"content": "#當然沒問題，我會帶{F#妳}{M#你}們去社奉行所的神里府上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030131
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030131,
					"content": "不過…在這之前，還有個地方希望兩位可以隨我一同去看一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030132
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030132,
					"content": "嗯？什麼地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030133,
					"content": "只要居住在鳴神島便無法無視的，正在建設中的那個龐然大物——「千手百眼神像」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030126,
					"content": "你指的是在御前決鬥中喪命的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030127
					]
				},
				{
					"id": 20030121,
					"content": "直接面對雷光的夥伴指的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030122
					]
				},
				{
					"id": 20030111,
					"content": "可這完完全全是一隻狗啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030112
					]
				},
				{
					"id": 20030107,
					"content": "那個人形托馬在哪裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030108
					]
				}
			]
		},
		{
			"id": 200302,
			"completionStepIds": [
				200302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200302",
							"2"
						],
						"stepId": 200302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"托馬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20030201,
					"content": "這神像周圍有種肅殺的氣氛…一般人是不會到這裡來的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030202,
					"content": "欸，仔細看的話…這上面嵌著的都是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030203,
					"content": "神之眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030204
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030204,
					"content": "神之眼！所以眼狩令收繳來的神之眼，都會砌在這座神像上嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030206,
					"content": "將軍為何要頒佈眼狩令呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030207
					]
				},
				{
					"id": 20030205,
					"content": "#{F#妳}{M#你}們果然已經聽說過眼狩令的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030206
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030207,
					"content": "#在解釋這件事之前，{F#妳}{M#你}們應該知道的吧，正如蒙德是「自由」城邦，璃月是「契約」之都…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030208
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030208,
					"content": "而稻妻…則是「永恆」的國度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030209
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030209,
					"content": "雷電將軍既是稻妻的最高統治者，同時又是稻妻的神明。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030210
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030210,
					"content": "千世萬代不變不移的永恆，便是執掌這個國家的「她」的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030211
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030211,
					"content": "為此，她憑藉三奉行來穩固國政，依靠鎖國令來斷絕人員的流動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030212
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030212,
					"content": "將軍想讓稻妻維持一種靜態，便可以任由時間的長河從兩旁流過，唯稻妻巋然不動，直至「永恆」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030213
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030213,
					"content": "每個神明都有自己的想法呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030214,
					"content": "當然，這也是我自己的理解。至於最近眼狩令的頒佈，究其原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030215
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030215,
					"content": "或許是將軍認為神之眼能夠賦予人民「變革」的力量，而將軍眼中的「永恆」無法容許這種「不穩定」存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030216
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030216,
					"content": "於是雷電將軍便派遣「天領奉行」的手下四處收繳並一顆又一顆地，將神之眼嵌入這尊神像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030217
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030217,
					"content": "所以這尊「千手百眼神像」，便可以視為稻妻「永恆」的象徵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030218
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030218,
					"content": "這樣說的話…其實那位雷電將軍也有點自私吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030219,
					"content": "#哈哈，也只有{F#妳}{M#你}們這樣的異鄉人才敢這麼直言不諱地批評雷電將軍的作法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030220
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030220,
					"content": "不過…我也認同。眼狩令的確是不該存在的東西，神里小姐從眼狩令頒佈的第一天起，就下定了抗爭的決心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030221
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030235,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030223,
					"content": "剛才那是…什麼聲音？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030224
					]
				},
				{
					"id": 20030221,
					"content": "#欸？{NICKNAME}{F#妳}{M#你}怎麼了？看{F#妳}{M#你}的表情有些不對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030222,
					"content": "嗯？聲音？我沒聽到啊，剛才發生了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030223
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030225,
					"content": "我似乎聽到了…別人的「願望」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030226
					]
				},
				{
					"id": 20030224,
					"content": "#是呀，{F#妳}{M#你}摸了一下神像，然後呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20030226,
					"content": "「願望」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030227
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030227,
					"content": "嗯…這倒是好像印證了一種說法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030228
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030228,
					"content": "#{F#妳}{M#你}們有聽說過嗎？當一個人的願望強烈到一定程度時，神明的視線就會投射在他的身上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030229
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030229,
					"content": "那就是神之眼的由來…也可以說，神之眼便代表著那個人的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030230
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030230,
					"content": "#如果{F#妳}{M#你}剛才說的是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030231
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030232,
					"content": "神之眼象徵的不是力量，而是「願望」嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20030233
					]
				},
				{
					"id": 20030231,
					"content": "那看來…這些民眾的願望比我想像的還要執著呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030232
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030233,
					"content": "好了，鳴神島的遊客們，是時候跟我前往下一站——神里府了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20030234
					],
					"speakerTitle": "托馬"
				},
				{
					"id": 20030234,
					"content": "終於要去了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
