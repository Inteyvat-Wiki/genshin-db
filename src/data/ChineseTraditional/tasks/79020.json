			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790200101,
					"content": "我看看，嗯…這說不定是什麼寶藏的地圖！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200102,
					"content": "真的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200103
					]
				},
				{
					"id": 790200103,
					"content": "哼，我聞到了寶藏的味道，肯定是這樣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200116,
					"content": "#{F#妳}{M#你}看，留下圖的是「海盜赤穗百目鬼一眾」，總覺得是在哪裡聽到過的名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200104,
					"content": "#而且{F#妳}{M#你}看，「秘寶所藏之處…」果然有秘寶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200105,
					"content": "嗯，接下來是…「其中隱秘…一分為四…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200106,
					"content": "一分為四，是把什麼東西分成了四個的意思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200107,
						790200108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200107,
					"content": "寶藏有四份？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				},
				{
					"id": 790200109,
					"content": "不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200110,
					"content": "不過這邊說「置於四座大島礁石之處」，應該是說藏在金蘋果群島上的四座島的礁石…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200111,
					"content": "啊，這裡不就是礁石嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200112,
					"content": "看來有四份的是藏寶線索…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200113
					]
				},
				{
					"id": 790200113,
					"content": "而且還在四個島的礁石附近！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200114,
					"content": "說起金蘋果群島的四個島，那就肯定是最大的四個了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790200115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200115,
					"content": "我們就去其他三個島的礁石附近找找看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790200108,
					"content": "藏寶線索有四份？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790200109
					]
				}
			]
		},
