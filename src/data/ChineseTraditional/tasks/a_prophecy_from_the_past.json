			"dialogs": [
				{
					"id": 160010507,
					"content": "所以，這也是故事裡的世界吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010508,
					"content": "女巫的長桌忽然迎來了新的客人，莫非他們也想參加龍孩子的慶生會？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010509
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010509,
					"content": "可是，大家都在思考該為龍孩子準備什麼樣的禮物，這三位卻都兩手空空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010510
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010510,
					"content": "這樣的話，作為客人可不會受到長桌的歡迎哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010511
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010511,
					"content": "禮物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010512
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010512,
					"content": "這是怎麼回事？我們剛剛才知道啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010513,
					"content": "客人們如此抱怨。或許他們更應該思考一下要準備什麼樣的禮物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010514
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010514,
					"content": "…看來要推進故事的話，就得準備一個禮物。不過現在準備的話，禮物從哪來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010515,
					"content": "或許，他們可以在周圍找一找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010516
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010516,
					"content": "早說嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
