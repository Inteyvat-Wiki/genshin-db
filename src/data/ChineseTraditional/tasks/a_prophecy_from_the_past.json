			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杜林"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2256.417,
							230.083,
							-808.091
						],
						"pointId": 14073
					}
				]
			},
			"dialogs": [
				{
					"id": 160010201,
					"content": "你好啊，杜林，後續的提示有了嗎？我們準備好進入下一個篇章了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010202,
					"content": "準備好了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010203
					]
				},
				{
					"id": 160010203,
					"content": "#後續的提示已經有了，我正要去找{F#妳}{M#你}們，先一起看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010204
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010204,
					"content": "風兒攜著樂聲飛來，讓故事的種子得以發芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010205
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010205,
					"content": "樂聲也隨著風兒遠去，消失在遙遠的過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010206
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010206,
					"content": "去風與故事相遇的地方吧。將三個謎題寫成詩，將三段曲譜連成歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010207
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010207,
					"content": "樂聲中的詩與歌，就是這個故事最初的綠芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010208
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010208,
					"content": "這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010209
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010209,
					"content": "又是一個謎語嗎？書裡的聲音還提到了風和樂章什麼的，那謎底會是什麼啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010210,
					"content": "派蒙，該想起那個老朋友了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010211
					]
				},
				{
					"id": 160010211,
					"content": "唔…哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010212,
					"content": "所以是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010213
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010213,
					"content": "說到風啊、音樂啊、詩歌啊之類的，找那個賣唱的肯定能問出東西來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010214,
					"content": "派蒙是指巴巴托斯大人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010215
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010215,
					"content": "你知道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160010216
					]
				},
				{
					"id": 160010216,
					"content": "我剛來到蒙德時，阿貝多就把我引見給巴巴托斯大人了。我這樣的存在，肯定會吸引到他的注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010217
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010217,
					"content": "其實這樣也好…話說回來，我們現在該去哪裡找他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010218,
					"content": "巴巴托斯大人應該聽到了，我們跟著風走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010219
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010219,
					"content": "有時候我真的忘了他還是個神明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1600103,
			"completionStepIds": [
				1600103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
