				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2368.205,
							227.884,
							-843.246
						],
						"pointId": 13952
					},
					{
						"sceneId": 3,
						"position": [
							2361.06,
							223.99,
							-843.051
						],
						"pointId": 14458
					}
				]
			},
			"dialogs": [
				{
					"id": 160010301,
					"content": "#好久不見啊，{NICKNAME}和派蒙，還有童話世界來的小龍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010302
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010302,
					"content": "我從風中聽到了你們呼喚我的聲音，你們似乎被一道謎語難倒了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010303
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010303,
					"content": "抱歉打擾到您了，巴巴托斯大人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010304
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010304,
					"content": "不要這麼說，我本身對這個謎語也很感興趣，給我看一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010305
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010305,
					"content": "嗯…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010306
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010306,
					"content": "看出什麼來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010307,
					"content": "三個謎題與三段曲譜…這種說法讓我想起了一些往事，你們想要的謎底應該就藏在這些往事裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010308
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010308,
					"content": "來找賣唱的果然沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010309,
					"content": "很多年前，那幾位魔女來到蒙德，想要和我一較高下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010310
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010310,
					"content": "而我說：「不要比武，讓我們唱歌彈琴，用詩來結束紛爭。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010311
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010311,
					"content": "我撥動豎琴，向她們吟唱了這首詩——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010312
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010312,
					"content": "「風兒，風兒，請代我迎客。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010313
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010313,
					"content": "「於青蔥之間穿行吧。在那裡，來去無蹤的你也可以擁有形狀，正好為我的客人演舞一場。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010314
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010314,
					"content": "「於雲海之畔躍動吧。在那裡，好事之徒都會被你的歌聲嚇阻，正好替我的客人隔絕擾攘。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010315
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010315,
					"content": "「於星辰之下飛翔吧。在那裡，塵世的喧囂都能被你滌盪一空，正好讓我的客人傾訴暢想。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010316
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010316,
					"content": "「去那裡吧——那是我許諾給客人的地方。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010317
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010317,
					"content": "「那裡沒有爭鬥和較量，只有茶杯和愜意的時光。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010318
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010318,
					"content": "三段曲譜我已經為你們演奏了一遍，至於那三個謎題的答案，想必你們已經能猜出來了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010319
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010319,
					"content": "…樹林裡、懸崖邊、天上？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010320
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010320,
					"content": "回答正確！話說回來，當年面對這個謎語，你的母親也是最先猜出答案的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010321
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010321,
					"content": "書寫故事的人和吟唱故事的人之間，似乎存在某種默契。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010322
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010322,
					"content": "樹林裡、懸崖邊、天上…哦，是那裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010323,
					"content": "這個答案指向的地點，應該就是你們接下來要去的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010324
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010324,
					"content": "魔女們猜對了我的謎語，也接受了我的提議。之後，她們就選擇那裡作為聚會地點了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010325
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010325,
					"content": "根據這本書給出的提示，或許你們可以試試去那裡演奏我給的曲譜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010326
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010326,
					"content": "你正經的時候果然很可靠啊，風神巴巴托斯大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010327,
					"content": "謝謝您，巴巴托斯大人，我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010328
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010328,
					"content": "看起來，你還有想要我解答的問題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010329
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010329,
					"content": "嗯…您作為吟遊詩人，肯定閱讀過不計其數的故事。您覺得，一個什麼樣的故事會被它的作者認為是未完成的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010330
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010330,
					"content": "這個啊，故事裡還有尚未達成的心願，抑或是…未完待續！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010331
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010331,
					"content": "啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010332
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160010332,
					"content": "我剛剛才說過你很可靠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160010333,
					"content": "你想要的答案應該就在這個故事裡面，那是你母親留給你的故事，我不應該過問太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010334
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 160010334,
					"content": "嗯…我們出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜林"
				}
			]
		},
