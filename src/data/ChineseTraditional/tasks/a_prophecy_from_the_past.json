						160010805
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010805,
					"content": "新來的客人送上了禮物，祝福小龍成為博學多才的學者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010806
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010806,
					"content": "故事女巫接受了客人的祝福，邀請他們加入長桌上的聚會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010807
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010807,
					"content": "於是故事女巫正式向朋友們介紹自己的龍孩子，講到他的破殼、講到他的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010808
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010808,
					"content": "就在這時，擅長占卜的預言女巫從星星那裡收回了視線，向小龍投去憐憫的目光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010809
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010809,
					"content": "妳為他取了與邪龍相同的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010810
					],
					"speakerTitle": "預言女巫"
				},
				{
					"id": 160010810,
					"content": "是的，但我要送給他一個與邪龍不同的人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010811
					],
					"speakerTitle": "故事女巫"
				},
				{
					"id": 160010811,
					"content": "真是愚妄的愛。「名字」是命運的映射，正因為擁有邪龍的名字，所以他必然也將面對邪龍的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010812
					],
					"speakerTitle": "預言女巫"
				},
				{
					"id": 160010812,
					"content": "這是一個「預言」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010813
					],
					"speakerTitle": "預言女巫"
				},
				{
					"id": 160010813,
					"content": "…那我就改寫他的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010814
					],
					"speakerTitle": "故事女巫"
				},
				{
					"id": 160010814,
					"content": "席間的女巫們都陷入沉默，因為她們知道預言女巫的預言從來不會出錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010815
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010815,
					"content": "但是大家也明白故事女巫的決心，一位母親對孩子的愛容不下多少質疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010816
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010816,
					"content": "直到那位快樂女巫挺身而出，這令人煩擾的沉默才得以消解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010817
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010817,
					"content": "那就讓大家都來幫忙，我們一起改寫這個孩子的命運！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010818
					],
					"speakerTitle": "快樂女巫"
				},
				{
					"id": 160010818,
					"content": "妳想挑戰這個世界最本質的規則之一？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010819
					],
					"speakerTitle": "預言女巫"
				},
				{
					"id": 160010819,
					"content": "我才不想受限於這個世界的規則，反倒是挑戰規則這種事，更適合作為女巫聚會的議題呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010820
					],
					"speakerTitle": "快樂女巫"
				},
				{
					"id": 160010820,
					"content": "哦？聽起來會是個很有趣的實驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010821
					],
					"speakerTitle": "智慧女巫"
				},
				{
					"id": 160010821,
					"content": "…如果我們真的能成功，倒也可以為這片無聊的星空增添幾分趣味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010822
					],
					"speakerTitle": "預言女巫"
				},
				{
					"id": 160010822,
					"content": "快樂女巫最終說服了大家，就像曾經的許多次那樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010823
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010823,
					"content": "她就像太陽，強大而又溫暖，等她的光灑向你時，已容不得你拒絕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010824
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010824,
					"content": "於是女巫們準備好了各自的禮物，那是這宇宙間的三重奇蹟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010825
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010825,
					"content": "那就讓我破解高天的囈語，向他明示「命運」的詭計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010826
					],
					"speakerTitle": "預言女巫"
				},
				{
					"id": 160010826,
					"content": "那就讓我留下足以解析世界本源的算式，為他的「生命」求得另一個解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010827
					],
					"speakerTitle": "智慧女巫"
				},
				{
					"id": 160010827,
					"content": "那就讓我拿出神奇的魔法，幫他將不可能的「願望」變化為可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010828
					],
					"speakerTitle": "快樂女巫"
				},
				{
					"id": 160010828,
					"content": "而故事女巫只有手中的筆，但她準備用傾注於筆尖的愛創造另一個奇蹟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010829
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160010829,
					"content": "那就讓我把筆下的最後一個「故事」留給他，嫁接在那尚未美滿的結局之上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160010830
					],
					"speakerTitle": "故事女巫"
				},
				{
					"id": 160010830,
					"content": "接受了女巫們的祝福後，小龍的命運終於開始轉動了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "魔女M"
				}
			]
		},
