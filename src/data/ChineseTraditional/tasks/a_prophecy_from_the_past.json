						160011702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160011702,
					"content": "是故事中的杜林吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160011703
					]
				},
				{
					"id": 160011703,
					"content": "你好啊，小杜林！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011704
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160011704,
					"content": "沒有反應…是睡得太熟了嗎？這可是他的慶生會啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160011705,
					"content": "龍孩子誕生自故事女巫筆下的魔法，每當筆尖在書頁上滑動，龍孩子就會快樂地玩耍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011706
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160011706,
					"content": "但是故事女巫並非時時都有執筆書寫的閒暇，這次參加女巫之間的聚會，她不得不暫時放下手中的筆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011707
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160011707,
					"content": "「龍孩子甜甜地睡去了」——這是她停筆前在書頁上留下的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011708,
						160011709
					],
					"speakerTitle": "魔女M"
				},
				{
					"id": 160011708,
					"content": "所以，因為沒時間…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						160011710
					]
				},
				{
					"id": 160011710,
					"content": "這種解釋有些敷衍哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160011711,
					"content": "說起來有些奇怪，我印象中並沒有參加過魔女阿姨們的聚會，這個慶生會是什麼時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						160011712
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 160011712,
					"content": "恐怕你當時也在呼呼大睡，所以不記得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 160011709,
