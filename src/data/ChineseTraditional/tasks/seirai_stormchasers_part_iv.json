				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721580101,
					"content": "雷暴…平息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580102
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580102,
					"content": "看來四座「鎮石」都封印好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580103
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580103,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580104
					]
				},
				{
					"id": 721580104,
					"content": "#{F#妳}{M#你}、{F#妳}{M#你}回來了！{F#妳}{M#你}剛才是怎麼上去的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580105
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580105,
					"content": "#大祐說，{F#妳}{M#你}是穿過了一個和門一樣的東西，然後就消失了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580106
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580106,
					"content": "那個門到底是什麼東西？真是奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580107
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580107,
					"content": "不過，上面到底發生了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580108
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580108,
					"content": "我和悅子在下面的時候，聽見上面突然出現了很大的動靜，就和打雷一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580109
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580109,
					"content": "但是，明明雷暴都已經平息了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580110
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580110,
					"content": "是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580111
					]
				},
				{
					"id": 721580111,
					"content": "石頭飄在空中，拼出一個平台…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580112
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580112,
					"content": "這還真是…聞所未聞，我從來沒聽說過，清籟島有這種自然現象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580113
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580113,
					"content": "這怎麼可能是…自然現象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580114
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580114,
					"content": "無論怎麼想都是一種…呃，非自然的…現象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580115,
						721580116
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580115,
					"content": "確實。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				},
				{
					"id": 721580117,
					"content": "不過，不管這到底是什麼現象，總之現在清籟島的雷暴已經平息，協會委託給我們的任務也已經完成了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580118
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580118,
					"content": "關於奇怪的羽毛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580119
					]
				},
				{
					"id": 721580119,
					"content": "這羽毛是…大祐，你來看看這根羽毛吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580120
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580120,
					"content": "我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580121
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580121,
					"content": "抱歉，我分辨不出來這根羽毛的來歷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580122
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580122,
					"content": "這根羽毛的紋路和觸感，都和我知道的那些鳥類對不上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580123
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580123,
					"content": "而且妳看這根羽毛的尺寸，如果按照比例計算的話，這隻鳥幾乎要和天上那個石台一樣大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580124
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580124,
					"content": "#這根羽毛很重要嗎？如果{F#妳}{M#你}真想弄清楚這根羽毛的來歷，不如就去冒險家協會掛個委託吧，說不定能找到些線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580125,
						721580126
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580125,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580127,
					"content": "#嗯，那麼…再次謝謝{F#妳}{M#你}幫忙，冒險家。我和大祐這就回協會報告了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580128
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580128,
					"content": "#對了，這些東西給{F#妳}{M#你}，就當做是報酬吧。雖然不多…但怎麼也不能讓{F#妳}{M#你}白幫我們這個忙嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580129
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580129,
					"content": "大祐，準備一下，我們要回協會了喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580130
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580130,
					"content": "那個，悅子…我們還是先去那個神社，看看「寢子」大人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580131
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580131,
					"content": "我說你啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580132
					],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580132,
					"content": "那可是一隻會說話的貓啊！會說話的貓！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721580133
					],
					"speakerTitle": "大祐"
				},
				{
					"id": 721580133,
					"content": "你這傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "悅子"
				},
				{
					"id": 721580126,
					"content": "我自己再想想…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580127
					]
				},
				{
					"id": 721580116,
					"content": "妳說得對。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721580117
					]
				}
			]
		}
	]
}