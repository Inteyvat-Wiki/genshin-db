			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加扎里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730731501,
					"content": "#謝天謝地，{F#妳}{M#你}們終於回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731502
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730731502,
					"content": "剩下的兩塊碎片…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731503
					]
				},
				{
					"id": 730731503,
					"content": "#啊啊，沒錯，就是這個，真是辛苦{F#妳}{M#你}們了，剩下的事情就交給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731504
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730731504,
					"content": "加扎里修好了「阿麥塔機關」。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730731505
					]
				},
				{
					"id": 730731505,
					"content": "嗯，這樣應該就能用了，不愧是我啊。就算是教令院的訶般荼，也做不到不查閱任何資料就修好這個東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731506
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730731506,
					"content": "#多虧{F#妳}{M#你}們碰到了我，這下我們終於能進到那台遺蹟巨像裡面了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731507
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730731507,
					"content": "這話應該我們來說才對吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731508
					]
				},
				{
					"id": 730731508,
					"content": "啊，不知道都有幾百年沒有人進去過了，這下子我一定會在學術史上留名的！哎呀，不好意思，我太激動了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731509
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730731509,
					"content": "派蒙也開始激動了呢！不管是經費還是寶藏，我們可要來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
