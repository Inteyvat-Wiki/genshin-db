					"羅因賈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730730801,
					"content": "真是令人懷念的地方，好像這裡的泥土和空氣都想告訴我什麼…不過我卻什麼也想不起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730802
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730730802,
					"content": "#{F#妳}{M#你}們找到{F#妳}{M#你}們要找的機關碎片了嗎？記得把收集到的故事帶回來給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "羅因賈"
				}
			]
		},
		{
			"id": 7307309,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307307",
							"3"
						],
						"stepId": 7307307,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_NOT_RECEIVE",
						"rawParams": [
							"7307313",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"加扎里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730730901,
					"content": "沒想到還有我沒見過的巨像零件…關於那架遺蹟巨像到底還有多少我不知道的東西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730730902
					],
					"speakerTitle": "加扎里"
				},
				{
					"id": 730730902,
					"content": "#{F#妳}{M#你}們找到阿麥塔機關的碎片了嗎？為了學術事業，無論如何就拜託你們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "加扎里"
				}
			]
		},
		{
			"id": 7307310,
			"completionStepIds": [
				7307308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307308",
							"2"
						],
						"stepId": 7307308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿瑪茲亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730731001,
					"content": "#又是{F#妳}{M#你}們，拉娜帶來的小客人。拉娜沒和{F#妳}{M#你}們一起嗎？怎麼這次巡林這麼久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731002
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731002,
					"content": "#不過{F#妳}{M#你}們特意過來找我，應該是遇到什麼事了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731003
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731003,
					"content": "這個嘛，其實是因為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731004,
					"content": "和阿瑪茲亞爺爺說了羅因賈、秘密基地和冒險手冊的事情。\\n實在是很曲折。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730731005
					]
				},
				{
					"id": 730731005,
					"content": "#原來是這樣，{F#妳}{M#你}們去過那個秘密基地了啊，怎麼樣，是不是很厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731006
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731006,
					"content": "羅因賈這個傢伙，都已經跑到維摩莊來了還是不願意見我一面，真是越老越頑固了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731007
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731007,
					"content": "不過確實也是他的性格，離上次見到他已經快有十年了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731008
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731008,
					"content": "那次還是因為要去奧摩斯港處理一些事情才碰到的。聽到他還是老樣子我就放心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731009
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731009,
					"content": "你們的關係還真是奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731010
					]
				},
				{
					"id": 730731010,
					"content": "所以羅因賈爺爺為什麼不願意見你呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731011
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731011,
					"content": "#哎呀，說來話長，{F#妳}{M#你}們想聽我這個老頭子囉嗦嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731012,
						730731014
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731012,
					"content": "挺好奇的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731013
					]
				},
				{
					"id": 730731013,
					"content": "嗯！派蒙也很好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731016
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731016,
					"content": "小的時候，因為祖父的原因，羅因賈那個傢伙在維摩莊住過很長一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731017
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731017,
					"content": "因為是從繁華的奧摩斯港來的孩子，還有一個傳奇的冒險家祖父，所以理所當然的，他很快就成了孩子們的焦點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731018
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731018,
					"content": "維摩莊的孩子們都被他從祖父那裡聽來的故事吸引了，我也是那些孩子中的一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731019
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731019,
					"content": "我們一起在那邊的山洞裡建造了秘密基地，用樹枝和花朵把自己裝扮成武士與英雄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731020
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731020,
					"content": "對還是孩子的我們而言，那個秘密基地就像是幻想的異世界。光是在這個山洞裡面我們就能完成無數的傳奇與冒險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731021
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731021,
					"content": "現在想起來那些時光都彷彿是在夢裡一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731022
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731022,
					"content": "好像羅因賈爺爺也提過，這個秘密基地以前有好多好多人。不過後來為什麼會變成這樣呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731023,
						730731024
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731023,
					"content": "所有的夢都會醒。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731025
					]
				},
				{
					"id": 730731025,
					"content": "嗯，小孩子本來做什麼事情都是三分鐘熱度。傳奇也好，冒險也好，本來也不過是無數件有趣的事情中的一件罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731026
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731026,
					"content": "等到回過神來的時候，還在那個秘密基地裡幻想著那些傳奇的冒險的就只剩下我和羅因賈兩個人了…還是三個來著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731027
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731027,
					"content": "三個…羅因賈爺爺也說過那個時候是有三個人的來著，不過他已經記不起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731028
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731028,
					"content": "我也記不清了，都過去這麼多年了，我們兩個都老了。到底是誰呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731029
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731029,
					"content": "或許是「蘭那羅」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731030
					]
				},
				{
					"id": 730731030,
					"content": "「蘭那羅」…又是「蘭那羅」嗎…這倒像是講給小孩子的童話故事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731031
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731031,
					"content": "如果那個時候和他一起離開了維摩莊，現在肯定還會相信這些吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731032
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731032,
					"content": "和他一起…所以羅因賈爺爺是為什麼會離開維摩莊的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731033
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731033,
					"content": "當然是為了他的冒險呀。那個傢伙，從那個時候開始就已經這麼固執了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731034
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731034,
					"content": "那個時候我們約定要一起成為世界上最厲害的冒險家，就像他那個傳奇的祖父一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731035
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731035,
					"content": "不過我們兩個，誰都沒有當冒險家的天賦呢。在最初的熱情耗盡之後，我也有更重要的事情要去做了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731036
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731036,
					"content": "最後留下來的，就只剩下他一個人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731037
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731037,
					"content": "我們會變成這樣，也是因為這個原因，在他看來，我更有冒險家的天賦，卻比他更早放棄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731038
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731038,
					"content": "真是固執啊，不過最後他能成為奧摩斯港最厲害的古董商人，也是因為這種固執吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731039
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731039,
					"content": "#好了，麻煩{F#妳}{M#你}們聽我囉嗦了這麼久，都快忘記正事了。{F#妳}{M#你}們是為了那兩個機關碎片的位置來的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731040
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731040,
					"content": "#我年紀大了，眼睛不太好，麻煩稍微等我一會吧，我給{F#妳}{M#你}們標出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731041
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731041,
					"content": "這也算是那個傢伙的委託吧。雖然我用了維摩莊傳統的花體字，哼，明明那個時候他也是能看懂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731042
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731042,
					"content": "阿瑪茲亞爺爺對照著冒險筆記轉寫並標出了機關碎片相關的資訊。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730731043
					]
				},
				{
					"id": 730731043,
					"content": "#嘿嘿好了，{F#妳}{M#你}們按照這個去找就好了。沒想到這麼多年後那個東西還能有它的用處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731044
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731044,
					"content": "哦，對了，剛才我在筆記裡找到了這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731045
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731045,
					"content": "阿瑪茲亞爺爺從發黃的紙張中找出一朵風乾的花。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730731046
					]
				},
				{
					"id": 730731046,
					"content": "#如果{F#妳}{M#你}們再見到羅因賈就把這個交給他吧，或許他能想起些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731047
					],
					"speakerTitle": "阿瑪茲亞"
				},
				{
					"id": 730731047,
					"content": "蘭利遮，為什麼你剛才一直都沒說話呀。那個是阿瑪茲亞爺爺，是很好的那菈，蘭利遮不用害怕的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731048
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731048,
					"content": "#蘭利遮沒有害怕。{F#妳}{M#你}們說的事情，蘭利遮好像聽人說過，好熟悉，但是蘭利遮想不起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731049
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730731049,
					"content": "蘭利遮搞不懂，所以蘭利遮不說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731050
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730731050,
					"content": "蘭利遮，奇怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731051
					]
				},
				{
					"id": 730731051,
					"content": "蘭利遮，好奇怪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731052
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730731052,
					"content": "好累哦，不過總算有進展了。總之我們就按阿瑪茲亞爺爺說的，去把另外兩個碎片找出來交給加扎里先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731024,
					"content": "所有的孩子都會長大。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731025
					]
				},
				{
					"id": 730731014,
					"content": "如果不是很長的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731015
					]
				},
				{
					"id": 730731015,
					"content": "哈哈，我會長話短說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731016
					],
					"speakerTitle": "阿瑪茲亞"
				}
			]
		},
		{
			"id": 7307314,
			"completionStepIds": [
				7307312
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7307312",
							"2"
						],
						"stepId": 7307312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"羅因賈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730731401,
					"content": "羅因賈爺爺，我們回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731402,
					"content": "#喔喔，{F#妳}{M#你}們終於回來了，看{F#妳}{M#你}們的樣子，應該見過那個老頭子，也找到{F#妳}{M#你}們想要的機關碎片了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731403
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731403,
					"content": "別的先不提，雖然我也不是很關心啦，不過那個老頭子還是像以前一樣無趣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731404,
						730731405
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731404,
					"content": "你真是關心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731406
					]
				},
				{
					"id": 730731406,
					"content": "#嗯？是那個老傢伙跟{F#妳}{M#你}們說了些什麼嗎，{F#妳}{M#你}們可別相信他的話，如果不是他在出海冒險的前一天晚上偷偷溜回了這個村子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731407
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731407,
					"content": "我們現在說不定已經是歷史上最偉大的冒險家之一了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731408,
						730731409
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731408,
					"content": "感覺不太可能…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731410
					]
				},
				{
					"id": 730731410,
					"content": "嘛，開玩笑的，其實還是當古董商人適合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731411
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731411,
					"content": "就算是像祖父那樣偉大的冒險家，最後也在某次冒險中不知所蹤了，更別說是我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731412
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731412,
					"content": "#我的話，只要還有冒險故事可聽就行了。那麼{F#妳}{M#你}們收集到了什麼故事呢？按照約定，{F#妳}{M#你}們手上的機關碎片要用故事來換哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731413,
						730731416
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731413,
					"content": "關於被水淹沒的機關和死域…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731414
					]
				},
				{
					"id": 730731414,
					"content": "和羅因賈爺爺講述了尋找機關碎片的冒險故事。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730731415
					]
				},
				{
					"id": 730731415,
					"content": "#哈哈，真是了不起的冒險啊，{F#妳}{M#你}們果然是不得了的冒險家。要是那個時候的我也能完成這樣的冒險就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731419
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731419,
					"content": "#好了，算是給我帶來了不錯的故事呢。那麼按照約定，這些機關碎片就交給{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731420
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731420,
					"content": "#快去拿給那個大學者吧，在{F#妳}{M#你}們快樂冒險的時候，他都快急死了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731421
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731421,
					"content": "那麼，我也該回到我的鋪子裡去了，要是錯過了什麼大生意可就不好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731422
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731422,
					"content": "等一下，我們還有件事情要做吧。那個花花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731423,
					"content": "這是阿瑪茲亞爺爺交給你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731424
					]
				},
				{
					"id": 730731424,
					"content": "這是…一朵花？那個老頭子一把年紀還搞這種嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731425
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731425,
					"content": "不過等一下…這朵花，我好像有印象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731426
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731426,
					"content": "你終於想起什麼來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731427,
					"content": "哈哈，好像想起來了什麼，又好像什麼都沒想起來呢。不過算了，過去的事情，就留在過去好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731428
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731428,
					"content": "#不過我能感覺到，這朵花是不屬於我的，請{F#妳}{M#你}們把它交到屬於它的地方吧。看{F#妳}{M#你}們的樣子肯定能看到什麼我看不到的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731429
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731429,
					"content": "不過阿瑪茲亞那個傢伙，好像比以前有趣一點了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731430
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731430,
					"content": "那麼，就此告別，如果有機會的話，請兩位還要光臨小店呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731431
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731431,
					"content": "屬於它的地方…蘭利遮，這朵花花就交給你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731432,
					"content": "花花，好珍貴，為什麼要給蘭利遮這個呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731433
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730731433,
					"content": "因為這個本來就是屬於蘭利遮的花花哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731434,
					"content": "蘭利遮不記得，不過花花，蘭利遮喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731435
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730731435,
					"content": "蘭利遮珍惜花花，蘭利遮要把花花種到園圃裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731436
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730731436,
					"content": "好哦，那我們就在大鐵山的下面再見吧，等我們打開了那個大機器人後，再一起去對付壞東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731437
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731437,
					"content": "#嗯！蘭利遮要和{F#妳}{M#你}們一起對付壞東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731438
					],
					"speakerTitle": "蘭利遮"
				},
				{
					"id": 730731438,
					"content": "約定好了哦，蘭利遮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730731416,
					"content": "關於精靈和孩子的故事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731417
					]
				},
				{
					"id": 730731417,
					"content": "和羅因賈爺爺講述了蘭那羅和孩子們一起冒險的故事。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730731418
					]
				},
				{
					"id": 730731418,
					"content": "#森林裡的精靈嗎？雖然類似的傳說我也聽說過不少，不過{F#妳}{M#你}們說的這個格外有趣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730731419
					],
					"speakerTitle": "羅因賈"
				},
				{
					"id": 730731409,
					"content": "過去無法改變。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731410
					]
				},
				{
					"id": 730731405,
					"content": "你們還真是一樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730731406
					]
				}
			]
		},
		{
			"id": 7307315,
			"completionStepIds": [
				7307313
			],
