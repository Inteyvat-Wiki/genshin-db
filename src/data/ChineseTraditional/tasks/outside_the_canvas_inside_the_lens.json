	"talks": [
		{
			"id": 7268301,
			"completionStepIds": [
				7268302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7268302",
							"2"
						],
						"stepId": 7268302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朝霧"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726830101,
					"content": "咳、咳…這樣…還是不行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830102
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830102,
					"content": "再拖下去，這一期的稿件就交不上去了…嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830103,
						726830104
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830103,
					"content": "妳好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				},
				{
					"id": 726830105,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830106
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830106,
					"content": "對不起！對不起！我今天一定會交稿的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830107
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830107,
					"content": "嗚哇！等一下，我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726830108,
					"content": "森子小姐！請您…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830109
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830109,
					"content": "咦？原來不是森子小姐…太好…咳咳！咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830110
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830110,
					"content": "森子小姐是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830111
					]
				},
				{
					"id": 726830111,
					"content": "森子小姐是我的責任編輯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830112
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830112,
					"content": "我叫朝霧，是一個…嗯…算是一名「自由插畫師」吧。森子小姐…是負責我的責任編輯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830113
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830113,
					"content": "插畫？那是什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726830114,
					"content": "#{F#妳}{M#你}們應該也讀過「八重堂」裡的那些輕小說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830115
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830115,
					"content": "在那些小說裡，不是偶爾會有幾頁不是文字而是畫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830116
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830116,
					"content": "這種插入輕小說頁面內的畫，就是「插畫」喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830117
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830117,
					"content": "如果小說裡出現了某些重要的場景或者劇情，或者是作者想要讓主角的形象正式出現的時候，有的作者就會選擇約上一幅插畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830118
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830118,
					"content": "這樣，不僅會讓讀者讀起小說來更有感覺，整本輕小說的內容也會更加豐富呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830119
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830119,
					"content": "喔…原來是這樣，輕小說還真是複雜啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726830120,
					"content": "#我可以為{F#妳}{M#你}們推薦幾本！比如那本…咳！咳咳…咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830121
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830121,
					"content": "妳沒事吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830122
					]
				},
				{
					"id": 726830122,
					"content": "沒事，沒事，我的身體一直不太好，畫插畫的時候又總是熬夜，有時候也會忘記吃飯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830123
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830123,
					"content": "咳咳…然後身體就越來越差了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830124
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830124,
					"content": "妳身體這麼差，為什麼還要在這裡畫畫呀？不能回家畫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726830125,
					"content": "我是為了取材，才到這裡來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830126
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830126,
					"content": "我最近完全沒有畫畫的靈感，已經有好幾幅插畫稿件過了截稿期了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830127
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830127,
					"content": "森子小姐已經幫我把截稿日推遲了好多次了，我要是再交不了，森子小姐肯定會生氣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830128
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830128,
					"content": "我覺得如果能出去走走的話，說不定能得到什麼靈感，所以就想要出門旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830129
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830129,
					"content": "#結果…哈哈…如{F#妳}{M#你}們所見，沒逛多久我就有點受不了了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830130
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830130,
					"content": "唉，我還是去冒險家協會掛一個委託，拜託哪位手裡有「留影機」的冒險家幫忙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830131
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830131,
					"content": "欸？說到「留影機」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830132,
						726830134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726830132,
					"content": "我手裡倒是有「留影機」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830133
					]
				},
				{
					"id": 726830133,
					"content": "#欸？！{F#妳}{M#你}有留影機嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830135
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830135,
					"content": "我、我是拜託冒險家用「留影機」拍攝各種畫片！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830136
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830136,
					"content": "我聽說，外面有很多有趣的地方！比如蒙德附近那座很高的雪山啦，璃月的那片有很多柱子的地方啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830137
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830137,
					"content": "還有還有！璃月有一片叫做「絕雲間」的地方，據說那裡住著仙人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830138
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830138,
					"content": "仙人的居所…光是想想就覺得激動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830139
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830139,
					"content": "我因為身體原因，實在不能親身過去旅行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830140
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830140,
					"content": "#但是，如果{F#妳}{M#你}能幫我用「留影機」記錄下那邊的景致…我一定也能…咳咳！咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830141
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830141,
					"content": "嗚哇！妳冷靜點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830142,
						726830143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726830142,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830144,
					"content": "#是嗎！？太好了！我、我有很多想要看的地方，稍等一下，我找出來給{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830145
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830145,
					"content": "對了，報酬的話不用擔心，我還是有一些積蓄的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726830146
					],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830146,
					"content": "我的筆記本呢？筆記本，筆記本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝霧"
				},
				{
					"id": 726830143,
					"content": "我會想辦法的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830144
					]
				},
				{
					"id": 726830134,
					"content": "可是，「留影機」能做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830135
					]
				},
				{
					"id": 726830104,
					"content": "請問…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726830105
					]
				}
			]
		}
	]
}