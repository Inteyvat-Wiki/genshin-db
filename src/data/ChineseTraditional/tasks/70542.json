					}
				]
			},
			"dialogs": [
				{
					"id": 705420101,
					"content": "喵…喵嗚？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420102
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420102,
					"content": "貓之間是這樣打招呼的嗎？發音會不會不夠標準…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420103
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420103,
					"content": "喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420104
					],
					"speakerTitle": "「雪糕」"
				},
				{
					"id": 705420104,
					"content": "結果「雪糕」完全沒聽懂嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420105,
					"content": "莫娜在嘗試貓語嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420106,
						705420107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420106,
					"content": "莫娜老師，不是這樣唸的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420108
					]
				},
				{
					"id": 705420108,
					"content": "喂！「嗷嗷嗚嗚」聽起來像老虎獅子，完全是嚇唬貓貓的發音嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420109,
					"content": "#{NICKNAME}和派蒙！原來傳說是真的，{F#妳}{M#你}們的確在「貓茸茸城堡」打工啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420110
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420110,
					"content": "也不能說是打工啦…我們只是在幫瓦樂瑞娜和蘿莎莉亞的忙而已，更像是…顧問！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420111,
					"content": "沒錯，顧問這個稱號聽起來就很厲害，哼哼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420112,
					"content": "話說回來——「偉大的占星術士莫娜」，妳是想要領養一隻貓貓來輔佐妳觀察星象嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420113,
					"content": "憑我對星象學的理解，教會貓貓看懂星象似乎也不是難事，甚至還能…讓貓貓幫我寫稿？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420114
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420114,
					"content": "（偷瞄雪糕）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420115
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420115,
					"content": "（堂堂正正地看向雪糕）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420116,
					"content": "喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420117
					],
					"speakerTitle": "「雪糕」"
				},
				{
					"id": 705420117,
					"content": "咳咳，還是算了。只是看懂星象，而不懂深入淺出地遣辭用句，寫出的稿子就不足以傳達我的真知灼見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420118
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420118,
					"content": "需要寫稿助手的話，不如再去一趟楓丹說服某位《蒸汽鳥報》的文書處理專員，或者找一位會用打字機的美露莘來蒙德…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420119
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420119,
					"content": "要是我真的領養貓貓了，最多只是和貓貓們一起玩、好好放鬆，排解學術研究的勞累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420120
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420120,
					"content": "不能當個壞主人，自己累了，還要讓貓貓一起累。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420121
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420121,
					"content": "踏進這間屋子前，我還真的沒有想到和貓貓們交流是這麼愉快的事…大家都要一直這樣開開心心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420122
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420122,
					"content": "嘿嘿，看來莫娜還是非常有自覺的。把貓貓交給妳大家都放一萬個心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420123,
					"content": "不過我也聽說有的貓貓個性非常活潑，總是在屋裡上躥下跳，還喜歡抓撓啃咬家具…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420124
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420124,
					"content": "萬一把我的稿子或占星相關的資料咬壞，那可就麻煩了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420125
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420125,
					"content": "咬壞貴重的書…這麼恐怖的事，我也不敢想了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420126,
					"content": "「雪糕」看起來非常乖，但好像不太能理解我的意思…或許我們不太有默契。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420127
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420127,
					"content": "所以我還要再觀察一下，看看有沒有聽話的貓貓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420128
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420128,
					"content": "然後計算一下貓窩、貓糧之類的開銷。不能過分奢侈，也不可以委屈了貓貓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420129,
						705420130
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 705420129,
					"content": "沒關係沒關係，慢慢來就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420131
					]
				},
				{
					"id": 705420131,
					"content": "對呀，瓦樂瑞娜小姐有說以後還會收養更多流浪貓的，就算現在找不到適合的貓貓，也可以多來玩玩、多看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705420132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705420132,
					"content": "喵~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「雪糕」"
				},
				{
					"id": 705420130,
					"content": "城堡裡還會有更多貓的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420131
					]
				},
				{
					"id": 705420107,
					"content": "嘗試對牠嗷嗷嗚嗚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705420108
					]
				}
			]
		}
	]
}