						],
						"pointId": 360500014
					}
				]
			},
			"dialogs": [
				{
					"id": 761150301,
					"content": "只知重複昨日之我的可悲之人，和預想的一樣，不得不說也有些無趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150302
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150302,
					"content": "他明明都堅持不做壞事那麼久了，最後卻還是…還是說，他天生就是壞人，壞人是不會變好的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150303,
						761150304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761150303,
					"content": "堅持做好事顯然更難。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150305
					]
				},
				{
					"id": 761150305,
					"content": "選擇的權利始終都在，哪怕是剛才，他也可以選擇認錯懺悔。只是他又一次選錯了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150306
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150306,
					"content": "落子皆錯，方有今日這盤死局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150307
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150307,
					"content": "#不說這些了，總歸是又了結了一樁工作。懸賞的證物就依約定，由{NICKNAME}交給勒塞克吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150308
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150308,
					"content": "#有老闆和{NICKNAME}出馬就是叫人放心！這次我真的放假啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150309
					],
					"speakerTitle": "雅珂達"
				},
