					}
				]
			},
			"dialogs": [
				{
					"id": 761150101,
					"content": "欸？奈芙爾和雅珂達！妳們怎麼在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761150102,
					"content": "當然是為了工作囉。之前一直沒有線索的懸賞目標，已經被我們找到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150103
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761150103,
					"content": "聽雅珂達大致介紹了懸賞目標「裂顎」哈爾克，以及此前「秘聞館」調查到的資訊…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						761150104
					]
				},
				{
					"id": 761150104,
					"content": "先說結論吧。真正的隱者德文特多半已經遇害，而現在佔據了隱者小屋的就是懸賞目標「裂顎」哈爾克。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150105
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150105,
					"content": "雅珂達找到的日誌殘片也可以作為旁證，德文特在知道一切的情況下依然收留了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150106
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150106,
					"content": "毫不意外，哈爾克故態復萌，在了結了德文特之後又竊取了他的身分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150107
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150107,
					"content": "雖然之前去調查的時候沒見到面，但小屋裡的傢伙不管怎麼想都不可能是德文特先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150108
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761150108,
					"content": "而且只要自稱隱者，就算做些奇怪的事也不會被懷疑。那個面罩絕對不是為了修行，而是為了遮蓋下巴上的傷疤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150109
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761150109,
					"content": "至於下落不明的行商——做最壞的考慮，可能也已經遇害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150110
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150110,
					"content": "做了這麼多壞事，還兩次恩將仇報，到底是什麼樣的惡棍啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761150111,
					"content": "我推測，「流浪之環」貨品失竊案的確與哈爾克無關，作案的動機太薄弱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150112
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150112,
					"content": "他在這十年間從未逾矩，失竊貨品的價值足以讓他放棄辛苦構築的一切嗎？我看未必。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150113
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150113,
					"content": "那麼我們不妨做一些假設。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150114
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150114,
					"content": "已知在事發後，他回到阿特拉號的殘骸附近，攻擊了來尋寶的寶藏獵人。當人身處困境，回歸起點便是一種本能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150115
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150115,
					"content": "當他還在阿特拉號上當舵手時，聲名、財富，都不在話下，但加入「流浪之環」後又如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150116
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150116,
					"content": "哪怕十年間都循規蹈矩，當竊案發生時，人們依然將懷疑的目光和言語投向他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150117
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150117,
					"content": "而更讓他難以接受的，恐怕是與他出身相同，但過去只是無名之輩的朱亞尼現在反倒如魚得水。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150118
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150118,
					"content": "即使他當面指控朱亞尼，也無人採信他的說辭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150119
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150119,
					"content": "被失望和憤怒裹挾，他犯下了第一個錯。這次事件，就是他人生的轉折點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150120
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150120,
					"content": "之後在隱者小屋發生的事應該也大同小異…哪怕是微小的矛盾也會引發致命的衝突。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150121
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150121,
					"content": "#{NICKNAME}，這麼危險的傢伙，我們也不能放著不管吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150122,
						761150123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761150122,
					"content": "給我一個除害的機會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				},
				{
					"id": 761150124,
					"content": "#既然{NICKNAME}主動請纓，那就讓雅珂達休息一個回合吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150125
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150125,
					"content": "之前調查我也出了不少力嘛！就當讓我放個假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150126
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761150126,
					"content": "至於前面所說的假設是否無誤，待我們會一會他便知分曉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150123,
					"content": "就算是為了賞金，交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761150124
					]
				}
			]
		},
