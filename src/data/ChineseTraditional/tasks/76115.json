				]
			},
			"dialogs": [
				{
					"id": 761150201,
					"content": "#…我沒招惹過{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150202
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761150202,
					"content": "看來你很清楚我們為什麼來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150203
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150203,
					"content": "…那都是過去的事，現在我只想過平靜的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150204
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761150204,
					"content": "靠奪取他人的身分嗎？先是朱亞尼，但沒有成功，之後又是德文特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150205
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150205,
					"content": "不過拙劣的扮演遲早被揭穿，不會再有下一個受害者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150206
					],
					"speakerTitle": "奈芙爾"
				},
				{
					"id": 761150206,
					"content": "…朱亞尼？我想要奪取他的身分？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150207
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761150207,
					"content": "那不是他的…那憑什麼是他的？就因為他長得更討人喜歡、說話更會奉承嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150208
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761150208,
					"content": "我們明明是一樣的！…被他拿走的東西，本來就是屬於我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150209
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761150209,
					"content": "那德文特先生和行商呢？他們又對你做了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150210
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761150210,
					"content": "#…他們？他們問了不該問的問題，就像{F#妳}{M#你}們一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761150211
					],
					"speakerTitle": "德文特"
				},
				{
					"id": 761150211,
					"content": "受死吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "德文特"
				}
			]
		},
