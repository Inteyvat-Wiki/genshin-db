			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雷電將軍",
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120320101,
					"content": "接下來，稻妻一定會經歷更多挑戰，不過我已經做好準備了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320102,
						120320107,
						120320112,
						120320117,
						120320122,
						120320128
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320102,
					"content": "關於「挑戰」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320103
					]
				},
				{
					"id": 120320103,
					"content": "解除鎖國令難免牽連眾多，不能說只有積極效應而毫無損害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320104
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320104,
					"content": "比如可預見的，外界對稻妻商業造成衝擊等問題。這些都是接下來我會著手處理的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320105
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320105,
					"content": "影真是認真啊。我考慮的只有，以後鳴神大社是不是可以賣門票了之類的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320106,
					"content": "妳啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320107,
					"content": "關於神明的注視…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320108
					]
				},
				{
					"id": 120320108,
					"content": "真的視線一直在稻妻人民身上。我曾以為，這是她的責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320109
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320109,
					"content": "可是現在看來，這種注視飽含了賞識與期待。除了責任，她一定也樂在其中。她是非常愛人的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320110
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320110,
					"content": "過去的人值得注視，現在與未來的人亦如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320111
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320111,
					"content": "嗯，我不會再忽視他們的熱情與夢想了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320112,
					"content": "關於幾百年的戰鬥…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320113
					]
				},
				{
					"id": 120320113,
					"content": "坦白說，那是一場看不到盡頭的折磨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320114
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320114,
					"content": "面對無盡的戰鬥，必須時刻集中注意力。稍有鬆懈，將軍的刀就會要了我的命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320115
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320115,
					"content": "可以說，若是沒有此前的經歷與見聞，沒有刀中之力，我定會落敗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320116
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320116,
					"content": "#這之中，也有{F#妳}{M#你}的功勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320117,
					"content": "關於神櫻樹的傷痕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320118
					]
				},
				{
					"id": 120320118,
					"content": "放心吧，我沒有忘記，我會叮囑天領奉行與社奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320119
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320119,
					"content": "除了魔物的威脅，我還在擔心，神櫻樹中會不會逸散出其他東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320120
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320120,
					"content": "那可不好說，除了回憶，地脈裡的東西還多著呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320121
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320121,
					"content": "妳也清楚的話，就不要偷懶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320122,
					"content": "八重神子說她的神明就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120320123
					]
				},
				{
					"id": 120320123,
					"content": "哎呀？是誰在胡言亂語當面造謠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320124
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320124,
					"content": "有些話，是不可以隨便複述的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320125
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320125,
					"content": "#出賣我要付出什麼代價，{F#妳}{M#你}不會想知道的。把我說的話當成我和{F#妳}{M#你}的秘密就好，明白了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320126
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320126,
					"content": "#{F#妳}{M#你}們在討論什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320127
					],
					"speakerTitle": "雷電將軍"
				},
				{
					"id": 120320127,
					"content": "沒什麼，想吃油豆腐了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120320101
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 120320128,
					"content": "沒有其他想問的了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		}
	]
}