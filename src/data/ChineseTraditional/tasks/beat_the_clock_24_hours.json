						750141203
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141203,
					"content": "很有活力，看起來很健康。角上有特別的花紋…真不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141204
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750141204,
					"content": "不過你們為什麼會一起出現在這裡？是我的管教出了問題？不，這不可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141205
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750141205,
					"content": "唔？呀呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141206
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141206,
					"content": "嗯？牠怎麼了？是牠帶你來的？",
