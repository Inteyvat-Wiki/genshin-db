					"nextDialogs": [
						750141208,
						750141209
					]
				},
				{
					"id": 750141208,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141210
					]
				},
				{
					"id": 750141210,
					"content": "怎麼會發出這麼奇怪的叫聲，難道是生病了？行為也有反常的地方，看來要好好檢查一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141211
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750141211,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141212
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 750141212,
					"content": "小傢伙，別心急，待會就輪到你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141221
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750141221,
					"content": "首先是你，你必須跟我走，聽得懂指令嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141213,
						750141215,
						750141217
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750141213,
					"content": "（點頭。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141214
					]
				},
				{
					"id": 750141214,
					"content": "你這是從哪裡學會的把戲？而且…難道你聽得懂我說的話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750141219,
					"content": "#這時，從外面傳來一陣嘈雜的聲響…\\n「誰把箱子打開了…喂！別搶！你們先不要搶！待會葵莉婭會發脾氣的！」\\n來不及確認發生了什麼，先趁亂和{REALNAME[ID(2)|SHOWHOST(true)]}一起離開營地…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 750141215,
					"content": "（搖頭。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141216
					]
				},
				{
					"id": 750141216,
					"content": "你這是從哪裡學會的把戲？而且…難道你聽得懂我說的話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "葵莉婭"
				},
				{
					"id": 750141217,
					"content": "（跟她走。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750141218
					]
				},
				{
					"id": 750141218,
					"content": "怪事，我還沒說指令啊。難道你聽得懂我說的話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750141219
					],
					"speakerTitle": "葵莉婭"
