				"points": []
			},
			"dialogs": [
				{
					"id": 710480201,
					"content": "#{F#妳}{M#你}回來了，冒險家協會歡迎{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480202,
						710480206,
						710480208,
						710480211
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 710480202,
					"content": "關於層岩巨淵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480203
					]
				},
				{
					"id": 710480203,
					"content": "#{F#妳}{M#你}是想問那裡有什麼嗎？哈哈，誰知道呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480204
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 710480204,
					"content": "有人說礦工挖出了許願石，許下願望卻得到適得其反的報應；也有人說挖出了老龍王的尾巴…都是些好笑的謠言而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480205
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 710480205,
					"content": "好了，不必找我問層岩巨淵的事，我也不是很清楚那邊發生過什麼。去跟沐寧說就好。這是總務司的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 710480206,
					"content": "關於委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480207
					]
				},
				{
					"id": 710480207,
					"content": "#咳咳…大街上到處都是靠層岩巨淵吃飯的商戶，{F#妳}{M#你}不怕惹麻煩，但我可是要養活冒險家協會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 710480208,
					"content": "關於沐寧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480209
					]
				},
				{
					"id": 710480209,
					"content": "啊，他呀…哼，把他調到層岩巨淵，恐怕也是因為總務司想要磨煉一下他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710480210
					],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 710480210,
					"content": "像他這種出身優越的小子就是容易得意忘形，公務人員總這樣不踏實的可不行…層岩巨淵會讓他長大的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				},
				{
					"id": 710480211,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710480212
					]
				},
				{
					"id": 710480212,
					"content": "嗯，啊…向著星辰與深淵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嵐姐"
				}
			]
		}
	]
}