					"古爾根"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230601,
					"content": "呼…差不多了，土壤的水分暫時應該足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230602
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230230602,
					"content": "#謝謝{F#妳}{M#你}，旅行者。要是沒{F#妳}{M#你}幫忙，我們非得累趴下不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230603
					],
					"speakerTitle": "古爾根"
				},
				{
					"id": 230230603,
					"content": "真奇怪，這次怎麼澆了這麼多水才把土壤給澆透了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230604
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230230604,
					"content": "我感覺，這次澆水的量至少是平常的兩倍還多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230605
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230230605,
					"content": "是你太累了，才出現了這種錯覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230606
					],
					"speakerTitle": "古爾根"
				},
				{
					"id": 230230606,
					"content": "要是澆兩倍的水，那整片土壤都會泡在水裡了，現在土壤的濕潤程度還很正常啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230607
					],
					"speakerTitle": "古爾根"
				},
				{
					"id": 230230607,
					"content": "話是這麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230608
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230230608,
					"content": "希望薔薇能好好生長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230609
					]
				},
				{
					"id": 230230609,
					"content": "請放心吧，為了「健康之家」的病人和醫生們，我們也一定會照顧好這一株薔薇的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230610
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230230610,
					"content": "這是一些謝禮，請收下吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230611
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230230611,
					"content": "唉，可我真覺得這次澆的水格外多啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
