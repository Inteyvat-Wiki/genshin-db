					"瓦爾坦"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230230301,
					"content": "#這些應該就足夠了，實在感謝{F#妳}{M#你}，旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230302
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230230302,
					"content": "有了這種特製肥料，土壤的肥力就不成問題了，這株薔薇一定能生長得很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230303
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230230303,
					"content": "希望別和之前那些肥料一樣，灑下去之後一點作用都沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230304
					],
					"speakerTitle": "古爾根"
				},
				{
					"id": 230230304,
					"content": "你們之前用過肥料？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230230305
					]
				},
				{
					"id": 230230305,
					"content": "用過一些很普通的，但效果並不好…不如說，是一點效果都沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230306
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230230306,
					"content": "但那些肥料用在另外幾片地裡效果就非常好，也不知道這裡到底出了什麼問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230307
					],
					"speakerTitle": "古爾根"
				},
				{
					"id": 230230307,
					"content": "先不說這些了，這是一些謝禮，請收下吧，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦爾坦"
				}
			]
		},
