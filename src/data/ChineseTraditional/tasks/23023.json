				},
				{
					"id": 230230202,
					"content": "這種特製肥料的其他原料我們還有一些儲備，但「香辛果」已經用光了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230230203
					],
					"speakerTitle": "瓦爾坦"
				},
				{
					"id": 230230203,
					"content": "#旅行者，能請{F#妳}{M#你}幫我們去拿一些「香辛果」回來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦爾坦"
				}
			]
		},
		{
