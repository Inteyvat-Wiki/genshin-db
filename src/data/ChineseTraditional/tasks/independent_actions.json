			"trigger": {
				"objectNames": [
					"芊芊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 1903203101,
					"content": "唔…唔唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203102
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203102,
					"content": "#{F#大姐姐}{M#大哥哥}，芊芊有件事，需要{F#妳}{M#你}幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203103,
						1903203104
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203103,
					"content": "找我幫忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				},
				{
					"id": 1903203105,
					"content": "那個藍色頭髮的方士，很可怕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203106
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203106,
					"content": "芊芊害怕，能不能把他帶走？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203107,
						1903203108
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203107,
					"content": "妳也會受到純陽之體的影響？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203109,
					"content": "芊芊根本不敢靠近他，他的體內放出的那種力量，太可怕了，會讓我消失的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203110
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203110,
					"content": "#芊芊還不想消失，所以，求求{F#妳}{M#你}了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203111,
						1903203112
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203111,
					"content": "不知道妳在他眼裡算不算妖邪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203113,
					"content": "那這樣吧，芊芊有個主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203114
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203114,
					"content": "我剛剛在遠處，看到藍色頭髮的方士正在和人爭吵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203115
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203115,
					"content": "#芊芊能把找麻煩的人都嚇跑，但{F#妳}{M#你}要讓他放過芊芊，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203116,
						1903203118
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203116,
					"content": "妳說的是真的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203117
					]
				},
				{
					"id": 1903203117,
					"content": "千真萬確，芊芊說的都是實話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203120,
					"content": "怎麼樣，可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203121
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203121,
					"content": "我不能替他決定，只能說明情況。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203122
					]
				},
				{
					"id": 1903203122,
					"content": "#好吧，芊芊就當做{F#妳}{M#你}答應了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203123
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203123,
					"content": "希望那個藍色頭髮的方士，是個好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203124
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203124,
					"content": "#芊芊去幫他，{F#妳}{M#你}也要去幫他，然後…{F#妳}{M#你}再幫幫芊芊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203118,
					"content": "我也能幫他擺脫麻煩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203119
					]
				},
				{
					"id": 1903203119,
					"content": "#唔，但是會很麻煩，芊芊已經有好辦法了，{F#妳}{M#你}要相信芊芊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903203120
					],
					"speakerTitle": "芊芊"
				},
				{
					"id": 1903203112,
					"content": "我不能替他決定啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203113
					]
				},
				{
					"id": 1903203108,
					"content": "難怪今天沒有看見妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203109
					]
				},
				{
					"id": 1903203104,
					"content": "為什麼是我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903203105
					]
				}
			]
		}
	]
}