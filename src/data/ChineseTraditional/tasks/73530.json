					{
						"sceneId": 3,
						"position": [
							-305.218,
							275.02,
							2159.738
						],
						"pointId": 330201529
					},
					{
						"sceneId": 3,
						"position": [
							-306.286,
							274.946,
							2159.712
						],
						"pointId": 330201530
					}
				]
			},
			"dialogs": [
				{
					"id": 735300101,
					"content": "哈哈…唉…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300102
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300102,
					"content": "#{NICKNAME}，快看，這裡有個又哭又笑的傢伙…咦，好像還有點眼熟？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300103,
					"content": "#啊！好久不見，兩位，{F#妳}{M#你}們還記得我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300104,
						735300106
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300104,
					"content": "#{F#妳}{M#你}是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300105
					]
				},
				{
					"id": 735300105,
					"content": "是我啦，我！生論派學者賈米，調配出「溢神劑」的那個人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300108
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300108,
					"content": "哦哦，我好像有點印象了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300109,
					"content": "怎麼樣，最近你的研究還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300110,
					"content": "哈哈…這個嘛…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300111
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300111,
					"content": "看來不怎麼順利？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300112
					]
				},
				{
					"id": 735300112,
					"content": "不不，託各位的福，上次關於溢神劑的研究取得了相當不錯的成績。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300113
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300113,
					"content": "之前我提心吊膽，總怕對不起導師的期待。沒想到他看了我的研究之後，竟然對我大加讚賞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300114
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300114,
					"content": "「賈米，你做得好啊，不愧是我最驕傲的學生！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300115
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300115,
					"content": "這不是滿好的嗎？恭喜你啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300116,
					"content": "如果到這裡的話的確很美好…唉，只可惜後面發生的事情，對我來說卻是不折不扣的噩夢啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300117
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300117,
					"content": "發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300118
					]
				},
				{
					"id": 735300118,
					"content": "或許是上次的實驗資料過於理想，我的導師——那個笑起來滿臉褶皺的老頭，竟然產生了「親自試一試」的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300119
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300119,
					"content": "於是，我幫他重新搭好了實驗場地，並且精心調配了效果最好的溢神劑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300120
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300120,
					"content": "然後呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300121,
					"content": "然後，怎麼說呢…在無數學生的圍觀下，他在魔物面前堂而皇之地飲用溢神劑，遭到了魔物的偷襲，轉眼間敗下陣來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300122
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300122,
					"content": "幸好人沒事，只是要在床上多躺一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300123
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300123,
					"content": "噗，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300124,
					"content": "哈哈…咳。不管怎麼說，是我學藝不精，讓導師丟了面子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300125
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300125,
					"content": "事後那個臭脾氣的老頭，更是斥責我「沒有考慮使用者需求」、「無法滿足實際情況」，把我狠狠罵了一頓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300126
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300126,
					"content": "這不是強人所難嘛，明明他自己也有錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300127,
					"content": "誰說不是呢？所以我想拜託兩位，幫我——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300128,
						735300129
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300128,
					"content": "教訓教訓他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300130
					]
				},
				{
					"id": 735300130,
					"content": "不是、不是啦！我才沒有這麼可怕的想法，至少現在沒有！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300131
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300131,
					"content": "嘿嘿，也就是說「曾經」有過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300132,
					"content": "呃…有那麼一點點…這個不重要啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300133
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300133,
					"content": "我是想說…在重新審視之前的實驗後，我調配出了一種「長效溢神劑」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300134
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300134,
					"content": "長效溢神劑？那是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300135,
					"content": "我回憶起導師被偷襲時的反應，突然意識到一個問題——我們這些普通人面對危機時，通常會腦袋空空、身體僵硬、不知所措…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300136
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300136,
					"content": "如果等遇到危險時再找出溢神劑喝下，說不定就等不到溢神劑生效了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300137
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300137,
					"content": "但是長效溢神劑不同。喝下之後，每次遇到危險都會自動生效，可以為普通人提供更多反應時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300138
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300138,
					"content": "怎麼判斷是否「遇到危險」呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300139
					]
				},
				{
					"id": 735300139,
					"content": "還記得我剛剛說的嗎？普通人面對危機時會身體僵硬——喝下長效溢神劑後，只要實驗者正常行動，長效溢神劑就不會生效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300140
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300140,
					"content": "可是一旦他們停止行動、僵在原地，長效溢神劑就會發生作用，讓他們的「主觀」時間變得非常緩慢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300141
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300141,
					"content": "原來是這樣，我大概聽懂了。所以…你剛剛是想拜託我們幫你完成實驗嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300142,
					"content": "沒錯，雖然長效溢神劑是為普通人開發的，但實驗有一定的風險，還是要先找有戰鬥經驗的人幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300143
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300143,
					"content": "嗯，讓我想想…要不要幫忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300144,
					"content": "#突然有點餓了呢，好想去蘭巴德酒館大吃一頓呀…{NICKNAME}，我們的摩拉還夠用嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300145,
						735300146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300145,
					"content": "很遺憾…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300147
					]
				},
				{
					"id": 735300147,
					"content": "咳…實不相瞞，導師雖然把我罵得狗血淋頭，但過後還是特別批准了一筆不菲的實驗經費。我打算重金聘請兩位…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300148
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300148,
					"content": "既然這樣，就讓我們助你一臂之力吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735300149,
					"content": "太感謝了！嗚嗚，如果能夠挽回我那支離破碎的學術聲譽，兩位就是我的救星！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賈米"
				},
				{
					"id": 735300146,
					"content": "這個月已經超支了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300147
					]
				},
				{
					"id": 735300129,
					"content": "收買收買他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300130
					]
				},
				{
					"id": 735300106,
					"content": "一直在唉聲嘆氣的那個？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735300107
					]
				},
				{
					"id": 735300107,
					"content": "#{F#妳}{M#你}還記得那個外號啊。沒錯，是我啦…辜負導師期望、一直在唉聲嘆氣的生論派學者，時至今日已經羞於報上名字的賈米——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735300108
					],
					"speakerTitle": "賈米"
				}
			]
		}
	]
}