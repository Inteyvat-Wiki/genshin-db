					},
					{
						"sceneId": 3,
						"position": [
							1678.818,
							237.117,
							9515.617
						],
						"pointId": 360700177
					},
					{
						"sceneId": 3,
						"position": [
							1678.52,
							236.034,
							9517.342
						],
						"pointId": 360700178
					}
				]
			},
			"dialogs": [
				{
					"id": 760430201,
					"content": "庫莉艾卡、海勒姆，最近怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430202
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760430202,
					"content": "沒想到我還能聽到妳說出這種話。寒暄不是妳的習慣，幼獾。也許這就是妳來這裡的原因——為蛇吐信…或為了蛇能吐信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430203
					],
					"speakerTitle": "海勒姆"
				},
				{
					"id": 760430203,
					"content": "呃，還是別管前輩了。託妳的福，還是老樣子。怎麼了，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430204
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430204,
					"content": "嗯，想跟你們打聽一下「流浪之環」的事。當時不是鬧得滿大的嗎？說是最後也沒抓到盜走貨品的犯人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430205
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760430205,
					"content": "雖然想說那要看妳覺得誰是犯人了…當時被指控的哈爾克堅稱自己是無辜的，他大鬧一通，還失手打死了一個叫朱亞尼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430206
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430206,
					"content": "聽說他們以前都是海盜船上的，後來遇到事故，同伴大都喪生，船也沒了，他們就一起加入了「流浪之環」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430207
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430207,
					"content": "哈爾克打死朱亞尼之後就逃跑了，當時沒人想到他會下這麼狠的手，朱亞尼跟他是舊識，平日裡也很照顧他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430208
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430208,
					"content": "聽說那之後他流竄到倫波島北部繼續作惡，唉…害我每次從那邊經過都提心吊膽的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430209
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430209,
					"content": "除了妳以外，沒有信使會選擇那條穿過迴廊的孤獨之路。他們會盡自己所能地避開那些想像中的危險——儘管那沒有意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430210
					],
					"speakerTitle": "海勒姆"
				},
				{
					"id": 760430210,
					"content": "是是是，前輩你說的都對。不過話說回來，最近好像沒怎麼聽說他的消息了，不知道是不是去別處避風頭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430211
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430211,
					"content": "不過聽妳的意思，也有人覺得哈爾克不是犯人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430212
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760430212,
					"content": "是，畢竟還是有幾處疑點。當時懷疑他是貨品失竊案的犯人，是因為貨品失竊之後不久，他就在「旗艦」大手大腳請人吃喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430213
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430213,
					"content": "還吹噓自己搞定了重要的交易對象，商隊主人相當賞識他，分了不少獎金給他，前途一片光明云云。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430214
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430214,
					"content": "可是據「流浪之環」的人說，那並不是他的功勞。既然是這樣，獎金鐵定也是騙人的，這些開銷想必有別的來路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430215
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430215,
					"content": "但這也不是直接證據。唔，難道不是因為他的出身嗎？畢竟他以前是海盜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430216
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760430216,
					"content": "要說沒有這方面因素，那就是騙人了。不過別忘了，朱亞尼也曾經是海盜啊，但兩個人的口碑就非常不一樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430217
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430217,
					"content": "當時，面對眾人的懷疑，哈爾克反倒指控起朱亞尼來了，說他親眼看到朱亞尼把商隊的貨品一點點轉移走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430218
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430218,
					"content": "還大聲叫嚷說去朱亞尼在那夏鎮的住處說不定可以查到些什麼。不過朱亞尼矢口否認，其他人也都不相信這套說辭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430219
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430219,
					"content": "讓我猜猜，他們寧可相信是哈爾克栽贓陷害朱亞尼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430220
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760430220,
					"content": "沒錯。雖然後來沒找到哈爾克倒賣貨品的證據，但他失手殺了朱亞尼又逃之夭夭，這件事就成了一筆糊塗帳啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430221
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430221,
					"content": "唔，總覺得還有什麼遺漏的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430222
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760430222,
					"content": "妳看得沒錯，幼獾。生鏽的金屬拼接在一起，並非出於關懷與善意，而是出於對無意義的恐懼。恐懼不是火，不會熔鑄金屬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430223
					],
					"speakerTitle": "海勒姆"
				},
				{
					"id": 760430223,
					"content": "「流浪之環」是一個將無歸者固定住的象徵，但劣品不會成為鉚釘。它只會在必要的時刻將其撕裂，鏽蝕不是一夜間完成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430224
					],
					"speakerTitle": "海勒姆"
				},
				{
					"id": 760430224,
					"content": "雖然聽不懂前輩在說什麼，不過商隊的主人也真夠倒楣的。妳也知道，「流浪之環」過去向來是不問出身的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430225
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430225,
					"content": "那些有難言之隱的人，「流浪之環」也願意為他們提供一個機會。聽說過去十年裡，商隊對哈爾克就和對其他人一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430226
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430226,
					"content": "…對了！為什麼是現在？哈爾克在「流浪之環」的十年間都相安無事，怎麼到了現在突然重操舊業？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430227
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760430227,
					"content": "照理說，這是他好不容易才獲得的新開始，他有什麼理由要將這一切親手破壞掉呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430228
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760430228,
					"content": "（如果是我的話…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430229
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760430229,
					"content": "誰知道呢？說不定其實他這十年間一直在做壞事，只是沒被發現，又或者是他認為現在時機到了，可以藉機除掉朱亞尼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430230
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430230,
					"content": "街頭巷尾說什麼的都有，但誰也說服不了誰，畢竟關鍵的哈爾克本人音信杳然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430231
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430231,
					"content": "而且，就算貨品失竊的案子與他無關，他在那之後犯下的罪行要比盜竊嚴重多了。事到如今，也無法回頭了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430232
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430232,
					"content": "妳說的對。不管怎麼說，他都該為自己的所作所為付出代價。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430233
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760430233,
					"content": "好了，該問的也問完了，就不耽誤你們工作了。謝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430234
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 760430234,
					"content": "小意思，我們也沒少受「秘聞館」的關照，這點小忙不算什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760430235
					],
					"speakerTitle": "庫莉艾卡"
				},
				{
					"id": 760430235,
					"content": "保持警惕吧，幼獾。別讓那生鏽的金屬把妳劃傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海勒姆"
				}
			]
		}
	]
}