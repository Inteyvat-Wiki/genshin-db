					}
				]
			},
			"dialogs": [
				{
					"id": 761590101,
					"content": "這就走掉了？喂，芭比！妳是不是還有很多東西沒有交給…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590102
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590102,
					"content": "…我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590103,
						761590104
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590103,
					"content": "我們是不是來得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				},
				{
					"id": 761590105,
					"content": "#沒有，{F#妳}{M#你}們來的時間差不多符合芭比對我做出的「預言」…我還以為會再晚一點呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590106
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590106,
					"content": "#不過，在談正事之前，{F#妳}{M#你}們不如…先吃點東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590107,
						761590108
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590107,
					"content": "是、是芭比洛斯女士的預言嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590109,
					"content": "沒有啦。只是我的聽力比較好，聽見了小派蒙的肚子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590110
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590110,
					"content": "（咕嚕嚕…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590111,
					"content": "#嗚哇！我…我的肚子是替{NICKNAME}響的，我們的肚子都很餓呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590112,
						761590113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590112,
					"content": "誰知道肉排賣光了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590114,
					"content": "#放心吧，魔女可不會讓遠道而來的客人餓肚子。來，餅乾和蛋糕都為{F#妳}{M#你}們準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590115
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590115,
					"content": "#{F#妳}{M#你}和派蒙開心地吃起了蛋糕和餅乾，也咕嚕咕嚕地喝了很多茶，但奇怪的是無論{F#妳}{M#你}們怎麼吃怎麼喝，茶壺卻永遠都是半滿，盤子裡也永遠盛著一塊新的餅乾和蛋糕…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590116
					]
				},
				{
					"id": 761590116,
					"content": "我…我不能吃了，怎麼吃都吃不完，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590117,
						761590120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590117,
					"content": "這就是…魔女的茶會嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590118
					]
				},
				{
					"id": 761590118,
					"content": "是啊。開茶會嘛，桌上肯定要有充足的甜點和茶水供應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590119
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590119,
					"content": "當然，吃太多不利於大家展現魔女的優雅氣質。在大多數情況下，茶壺只是半滿，盤子裡只有一塊餅乾或一塊蛋糕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590123,
					"content": "不吃了不吃了，我真的飽了…我們還是聊正事吧。嗝…嗚哇，不好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590124,
					"content": "#嗯，{F#妳}{M#你}們這次來，是為了傳達芭比為我預知的「課業」，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590125,
						761590126
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590125,
					"content": "妳不是已經都知道了嘛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590127,
					"content": "沒有，我剛才和芭比在談另外一件事。她說因為月亮的巨大異動，導致自己的水占術出現了偏差，必須回去靜修一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590128
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590128,
					"content": "在她靜修的期間，就由我來替她看護諸位的「課業」，順便也幫她把新一輪的「課業」寫進辭典裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590129
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590129,
					"content": "欸？這種事情還能臨時換負責人的啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590130,
						761590131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590130,
					"content": "不愧是尼可。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590132,
					"content": "我一點也不想辦到！但芭比和艾莉絲在告訴我這件事之前，就已經把我的那一份特別「課業」嵌入進辭典裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590133
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590133,
					"content": "雖然我很想把它給抹去，然後繼續悠閒地觀測世界…但艾莉絲還要去維護提瓦特的邊界，芭比則要去靜修水占術…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590134
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590134,
					"content": "歐科塔維亞壓根沒回來，更別提萊茵多特了…魔女們各有各的事務，也只能暫時由我擔起監督「課業」的職責了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590135,
						761590136
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590135,
					"content": "原來魔女會這麼忙啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590137,
					"content": "是啊，我都不知道大家有多久沒有好好辦一場茶會了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590138
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590138,
					"content": "但總而言之，只要我完成那一份特別「課業」，我的故事也就會正式嵌入辭典之內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590139
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590139,
					"content": "#在那之後，我就能切實地觀測和引導大家了…所以，{NICKNAME}、派蒙，把「課業」告訴我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590140
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590140,
					"content": "#對了，因為這不算是預言，純粹是芭比和艾莉絲在十分鐘前編出來的故事，所以{F#妳}{M#你}們應該在那本辭典裡找不到什麼有效資訊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590141
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590141,
					"content": "真的欸，我們從那本辭典裡看見的，的確不是什麼超複雜的「課業」。正確來說就只有兩句話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590142,
						761590143,
						761590144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590142,
					"content": "「尼可將履行自己的職責。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590145,
					"content": "好吧，前面的話應該是芭比寫的，但後面那一句一定是艾莉絲加的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590146
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590146,
					"content": "那我們就開始履行這次的「課業」吧。讓我想想，先去哪裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590147,
						761590148
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590147,
					"content": "等等，妳已經弄清楚了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590149,
					"content": "剛才芭比已經把我要做的事都順便告訴我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590150
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590150,
					"content": "所謂的「履行職責」，就是要我去各個課業的地點看看情況，進行一下「實地考察」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590151
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590151,
					"content": "等一下！這樣也可以嗎？完全沒有「預言」的感覺了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590152,
					"content": "沒有啊，芭比對我說的話，當然也相當於「預言」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590153
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590153,
					"content": "我的這篇「課業」由芭比執筆，她只不過是提前將故事翻到了最後一頁，把結尾告訴我而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590154,
						761590156
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590154,
					"content": "聽起來完全就是劇透啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590155
					]
				},
				{
					"id": 761590155,
					"content": "哎呀，預言和劇透本來就沒什麼分別啦。走吧走吧，跟著我，我們先去…唔，先去這裡應該不要緊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590159,
					"content": "咦？現在就去？等一下，我們要怎麼去啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590160,
					"content": "#只是一眨眼的工夫，{F#妳}{M#你}們就來到了一處懸崖邊…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 761590156,
					"content": "那我不是白跑一趟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590157
					]
				},
				{
					"id": 761590157,
					"content": "#這可不算白跑！「課業」必須由{F#妳}{M#你}傳達，這種「形式」可是很重要的，如果缺了這一環，「課業」本身說不定都不成立了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590158
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590158,
					"content": "先不說這些，走吧走吧，跟著我，我們先去…唔，先去這裡應該不要緊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590159
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590148,
					"content": "我都還沒完全看懂這句…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590149
					]
				},
				{
					"id": 761590143,
					"content": "「一定不會讓妳打白工的！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590144,
					"content": "書裡是這樣寫的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590145
					]
				},
				{
					"id": 761590136,
					"content": "仔細一算還滿多人的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590137
					]
				},
				{
					"id": 761590131,
					"content": "就連這種事情也辦得到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590132
					]
				},
				{
					"id": 761590126,
					"content": "難道剛才芭比洛斯女士也是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590127
					]
				},
				{
					"id": 761590120,
					"content": "下次一定要把瓦雷莎帶來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590121
					]
				},
				{
					"id": 761590121,
					"content": "是納塔「沃陸之邦」的那位很能吃的女孩？艾莉絲倒是和我提起過她，是一位很有趣的小姑娘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590122
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590122,
					"content": "如果她來做客的話，那必須要在她面前擺上三個…哦不，七個盤子才行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590123
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590113,
					"content": "總不能吃一肚子沙拉吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590114
					]
				},
				{
					"id": 761590108,
					"content": "居然連這種事都預言得了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590109
					]
				},
				{
					"id": 761590104,
					"content": "不太是時候…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590105
					]
				}
			]
		},
