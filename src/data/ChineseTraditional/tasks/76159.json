						"position": [
							33.846,
							3.501,
							-5.815
						],
						"pointId": 4
					},
					{
						"sceneId": 20354,
						"position": [
							35.376,
							3.471,
							-6.679
						],
						"pointId": 5
					}
				]
			},
			"dialogs": [
				{
					"id": 761590601,
					"content": "又換地方了。這裡是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590602,
						761590603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590602,
					"content": "等一下，屋子裡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590604
					]
				},
				{
					"id": 761590604,
					"content": "怪不得艾莉絲那一天突然來找我要屋子的鑰匙，說什麼要佈置一間漂亮的茶話室…我都跟她說了我已經有茶話室了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590605,
						761590606
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590605,
					"content": "這是艾莉絲的禮物？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590607
					]
				},
				{
					"id": 761590607,
					"content": "在意象上，它象徵著「引導的結束」、「旅行的終點」…還有「圓滿的預言」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590608
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590608,
					"content": "#{F#妳}{M#你}們之前應該跟隨過仙靈前進，對吧？只有當仙靈們回歸「仙靈之庭」時，那一段「引導」才正式結束。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590609
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590609,
					"content": "所以，為了讓我這一段被硬造出來的「課業」有一個明確的結束點，芭比和艾莉絲才會在這裡造一個「仙靈之庭」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590610
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590610,
					"content": "只有這樣，才能在不干擾其他「課業」的同時，將我的故事嵌入進大家的故事之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590611
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590611,
					"content": "但尼可也不是仙靈啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590612
					]
				},
				{
					"id": 761590612,
					"content": "啊…呃，差一點就是了，大家之前都是天使嘛…哎呀，沒關係的，差不多是那個意思就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590613
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590613,
					"content": "就好像寫小說一樣，只要大框架是對的，中間的細節只要多想想辦法總能圓的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590614
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590614,
					"content": "總之，只要我坐上去，這一段課業應該就會正式結束…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590615
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590615,
					"content": "但話又說回來，臨時寫的故事也只能這個樣子了…要是安雅在的話，說不定能想出更簡潔巧妙的故事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590616,
						761590617
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590616,
					"content": "這樣啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590618
					]
				},
				{
					"id": 761590618,
					"content": "喔，這個環節當然也必不可少啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590619
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590619,
					"content": "出現了！寶箱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590620,
					"content": "出現了！寶箱！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590621
					]
				},
				{
					"id": 761590621,
					"content": "突、突然感覺，這一段「課業」的確很合理了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590622,
						761590623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761590622,
					"content": "這就是把細節圓好的感覺嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590624
					]
				},
				{
					"id": 761590624,
					"content": "就是這種感覺！看來我這個課業輔導工作也沒白做啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590625
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590625,
					"content": "咳…看來，我的故事也已經正式嵌入那本辭典裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590626
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590626,
					"content": "那麼，這次的課業到此為止，大家之後的「課業」，也有了一位正式的輔導老師了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590627
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590627,
					"content": "那個…之後還有寶箱嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590628
					]
				},
				{
					"id": 761590628,
					"content": "這個啊，就得看大家之後會設計出怎麼樣的「課業」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590629
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590629,
					"content": "可能的話，我也想在大家處理課業的路上埋個寶箱，沿路布下各種線索，然後看著大家一路前進挖出寶箱…那樣我最開心了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590630
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590630,
					"content": "但芭比一直瞄著我呢。唉，看來我是沒辦法抓住這個機會了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590623,
					"content": "果然大框架很重要啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590624
					]
				},
				{
					"id": 761590617,
					"content": "我還以為寶箱出現才算結束呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590618
					]
				},
				{
					"id": 761590606,
					"content": "這座「仙靈之庭」是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590607
					]
				},
				{
					"id": 761590603,
					"content": "有好大一個「仙靈之庭」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590604
					]
				}
			]
		},
