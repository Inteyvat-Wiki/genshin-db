						],
						"pointId": 300100577
					}
				]
			},
			"dialogs": [
				{
					"id": 761590201,
					"content": "#只是一眨眼的工夫，{F#妳}{M#你}們就來到了一處懸崖邊…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						761590202
					]
				},
				{
					"id": 761590202,
					"content": "#好，我們到了。這個「仙靈之庭」的位置真不錯，{F#妳}{M#你}們看對面，那裡就是「課業起始地」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590203,
						761590204
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590203,
					"content": "仙靈之庭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590205
					]
				},
				{
					"id": 761590205,
					"content": "對啊，我只是暫時借用一下「仙靈之庭」來趕路，這東西和地脈相連，平時還沒人用，很好用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590206
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590206,
					"content": "而且，我和仙靈們之前都曾經是天使，也就是「前同事」，偶爾借用一下它們肯定不會生氣的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590207
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590207,
					"content": "這裡好像沒有其他人啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590208
					]
				},
				{
					"id": 761590208,
					"content": "還沒到時候呢。再過一段時間，詩人就會唱響久遠之前的頌歌，喚回徘徊在亙古中的千風…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590209
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590209,
					"content": "要在這裡處理課業的人，難道是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590210
					]
				},
				{
					"id": 761590210,
					"content": "#別著急嘛。在不久的將來，{F#妳}{M#你}將成為那曲頌歌之中的一縷旋律，千風也會環繞{F#妳}{M#你}身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590211
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590211,
					"content": "但在那之前，我們就先讓那首頌歌安心沉眠吧…走，我們去下一個地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590212,
						761590213
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590212,
					"content": "這個地方是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590214
					]
				},
				{
					"id": 761590214,
					"content": "#我從辭典裡讀到了。從結果上來看，{F#妳}{M#你}和巴巴托斯大人合奏了一首不錯的曲子。唯一的美中不足是…沒讓芭比聽見一個音符。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761590215
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590215,
					"content": "艾莉絲聽說這件事的時候，可是差點把帽子笑掉了——咳！我們去下一個地方！去下一個地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				},
				{
					"id": 761590213,
					"content": "我和溫迪在遠處的海島合奏過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590214
					]
				},
				{
					"id": 761590204,
					"content": "難道妳是藉助它來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761590205
					]
				}
			]
		},
