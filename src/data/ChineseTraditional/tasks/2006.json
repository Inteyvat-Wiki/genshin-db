			"dialogs": [
				{
					"id": 20060501,
					"content": "什麼？妳說師父他不是中邪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060502
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060502,
					"content": "難道師父是自己瘋掉的？這怎麼可能…我不信，這裡面一定有問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060503
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060503,
					"content": "師妹，別激動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060504
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060504,
					"content": "抱歉，以我的能力，確實看不出土門先生是否被附身了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060505
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 20060505,
					"content": "不過，這世上的邪祟千奇百怪，有很多我也未曾見過，倒也確實不能妄下定論。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060506
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 20060506,
					"content": "而且，事情未必沒有轉機。剛剛我得到消息，八重大人似乎有興趣見一見你們的師父。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060507
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 20060507,
					"content": "八、八重大人？是我理解的那位八重大人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060508
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060508,
					"content": "「鳴神大社」的大巫女…八重大人？太好了，這下師父一定會沒事的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060509
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060509,
					"content": "沒錯，八重大人博古通今，親手祓除過無數災厄與邪祟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060510
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 20060510,
					"content": "你們的師父到底是不是被邪祟附身，我無法確定，但八重大人可以給出準確的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060511
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 20060511,
					"content": "請問巫女大人，我們面見八重大人，需要做什麼準備嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060512
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060512,
					"content": "不需要。唯一的要求，就是準時抵達「鳴神大社」，八重大人不喜歡無意義的等待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060513
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 20060513,
					"content": "我先走了，之後「鳴神大社」再見。祝土門先生早日恢復如常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060514
					],
					"speakerTitle": "稻城螢美"
				},
				{
					"id": 20060514,
					"content": "沒想到八重大人竟然會注意到我們的師父…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060515
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060515,
					"content": "師兄是覺得師父名氣不大，不值得八重大人關注嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060516
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060516,
					"content": "沒有沒有，絕對沒有！師妹妳誤會了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060517
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060517,
					"content": "只是，那可是八重大人啊！傳聞中跟將軍大人關係密切的大巫女…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060518
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060518,
					"content": "#咳。總之，明天{F#妳}{M#你}也一起來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060519
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060519,
					"content": "#{F#妳}{M#你}千里迢迢地跑過來拜師，不論如何，我們「明鏡止水流」也會給{F#妳}{M#你}一個結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060520
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060520,
					"content": "我會來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060521
					]
				},
				{
					"id": 20060521,
					"content": "是呀，我們也很好奇，那位「八重大人」到底是什麼人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060522,
					"content": "透過她，說不定也能打聽到一些關於雷電將軍的消息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
