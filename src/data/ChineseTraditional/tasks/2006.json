			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"純也",
					"菜菜子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060101,
					"content": "第三個失去「神之眼」的人，好像是附近很有名的劍道家呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060102,
					"content": "聽說他是「明鏡止水流」的現任掌門，感覺很厲害的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060103,
					"content": "這裡就是他的劍道館了，正好有人在那裡，我們過去問問吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060104,
					"content": "師妹，不要太傷心了，師父一定會沒事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060105
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060105,
					"content": "以前那些來踢館的傢伙，不管他們有多強，最後不是都被師父打跑了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060106
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060106,
					"content": "但我還是有點擔心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060107
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060107,
					"content": "因為以前，不管局面多麼危險，師父都不曾動搖過。但現在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060108
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060108,
					"content": "那是因為師父中邪了！等這次驅邪儀式之後，師父一定會順利康復的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060109
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060109,
					"content": "那個，發生什麼事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060110,
					"content": "#…{F#妳}{M#你}們是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060111
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060111,
					"content": "不管是閒雜人等，還是想趁師父中邪過來鬧事的傢伙，都給我閃開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060112
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060112,
					"content": "不然，別怪我手裡的劍不客氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060113
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060113,
					"content": "不是啦，其實我們是來…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060114,
					"content": "我們是來拜師的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060115
					]
				},
				{
					"id": 20060115,
					"content": "拜師？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060116
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060116,
					"content": "對對對，我們聽說「明鏡止水流」的掌門非常厲害，所以特地從很遠的地方趕過來拜師學藝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060117,
					"content": "不過剛到這裡，就聽到你們在說「中邪」什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060118,
					"content": "#看{F#妳}{M#你}們的服飾，確實不像是本地人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060119
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060119,
					"content": "非常抱歉…因為最近上門找麻煩的人太多，我們也不得不小心防備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060120
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060120,
					"content": "#{F#妳}{M#你}們來得有點不巧。師父他最近不幸中邪，身體還沒恢復，暫時不能收{F#妳}{M#你}們為徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060121,
						20060122
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060121,
					"content": "我可以等他康復。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060123
					]
				},
				{
					"id": 20060123,
					"content": "#看來{F#妳}{M#你}確實相當有誠意。這樣吧，我和師妹先介紹一下師父的情況，是走是留，之後由{F#妳}{M#你}自己決定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060124
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060124,
					"content": "#我們的師父叫做土門，這個名字{F#妳}{M#你}們應該聽說過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060125
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060125,
					"content": "自學劍有成之後，師父他曾連續擊敗許多有名的劍道家，未嘗一敗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060126
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060126,
					"content": "師父曾說過，他的目標是成為「天下第一」的劍道家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060127
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060127,
					"content": "在訓練我們的同時，他仍在不停地磨練自己的劍道，我們也被師父的熱情感染，拼命追趕著師父的腳步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060128
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060128,
					"content": "可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060129
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060129,
					"content": "可是前段時間，師父的「神之眼」被奪走，整個人也突然性情大變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060130
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060130,
					"content": "他不但經常喃喃唸著一些奇怪的事情，還不准我們練劍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060131
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060131,
					"content": "我和師兄商量了一下，感覺師父應該是被邪祟附身了。所以特地請了「鳴神大社」的巫女來幫忙驅邪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060132
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060132,
					"content": "但說實話，我也不確定師父能不能好起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060133
					],
					"speakerTitle": "菜菜子"
				},
				{
					"id": 20060133,
					"content": "「鳴神大社」，那是什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060134,
					"content": "#{F#妳}{M#你}們不知道鳴神大社嗎？那是鳴神島最大的神社，掌管神社的大巫女，據說與雷電將軍大人關係匪淺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060135
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060135,
					"content": "雖然我們沒辦法請動那位大巫女親自出手…但即便是鳴神大社中普通的巫女，對驅邪一事也有著絕對的權威。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060136
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060136,
					"content": "所以放心吧師妹，師父他一定不會有事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060137
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060137,
					"content": "驅邪儀式會在晚上舉辦，如果兩位感興趣的話，也可以過來看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060138
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060138,
					"content": "邪祟附身…被奪去神之眼還會引發這樣的問題嗎？我們晚上再來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060122,
					"content": "不拜師成功我就不回去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060123
					]
				}
			]
		},
		{
			"id": 200602,
			"completionStepIds": [
				200603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"200603",
							"2"
						],
						"stepId": 200603,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"純也",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060201,
					"content": "#噓…{F#妳}{M#你}來了？幸虧{F#妳}{M#你}來得晚，沒有見到師父剛剛發瘋的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060202
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060202,
					"content": "剛剛師妹攙扶著師父，偶然聽到師父正小聲唸著一些名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060203
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060203,
					"content": "師妹問他們是誰，師父突然就露出了驚恐的表情，一把將師妹推開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060204
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060204,
					"content": "師父他似乎很痛苦，捂著耳朵，雙眼通紅，不停地四下環顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060205
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060205,
					"content": "他一直在叫一些名字，有些我們認識，有些我們不認識，似乎都是師父曾經擊敗過的劍道家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060206
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060206,
					"content": "其中一個名叫安西的，是師父以前的師兄，不過早年被師父擊敗之後，就一直居無定所地流浪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060207
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060207,
					"content": "剛剛師父叫了好幾聲他的名字…唉，幸虧神社的巫女打昏了師父，驅邪儀式才能繼續下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060208
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060208,
					"content": "現在驅邪儀式已經開始了，我們還是安心等待結果吧。希望師父沒事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060209
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060209,
					"content": "#{F#妳}{M#你}們在這等一下，我去拿點水來，萬一師父等下醒過來，不能沒有水喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060210
					],
					"speakerTitle": "純也"
				},
				{
					"id": 20060210,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060211,
					"content": "剛剛好像有一個鬼鬼祟祟的傢伙跑過去了，難道說是打算破壞「驅邪儀式」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060212,
					"content": "不能讓他得逞。旅行者，我們趕快跟上去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 200604,
			"completionStepIds": [
				200605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
