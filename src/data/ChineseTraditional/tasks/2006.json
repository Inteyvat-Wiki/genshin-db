			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20060401,
					"content": "#{F#妳}{M#你}們…{F#妳}{M#你}們怎麼跑得這麼快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060402
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060402,
					"content": "#{F#妳}{M#你}們真的是土門的徒弟嗎？怎麼感覺速度比土門還快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060403
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060403,
					"content": "還是說幾年不見，土門的身法又精進了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060404
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060404,
					"content": "喂！現在應該我們問你吧，你到底是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060405,
					"content": "鬼鬼祟祟的，看起來就不像好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060406,
					"content": "#不像好人？哼，當初我和土門一起學劍的時候，{F#妳}{M#你}們還不知道在哪呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060407
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060407,
					"content": "雖然已經不想再提起那段往事，但真要說起來，土門還得叫我一聲師兄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060408
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060408,
					"content": "師兄？難道說你就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060409,
					"content": "沒錯，我就是安西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060410
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060410,
					"content": "那你為什麼要跑？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20060411
					]
				},
				{
					"id": 20060411,
					"content": "…因為我不想再見到土門，也不想再見到跟他有關的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060412
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060412,
					"content": "當初，我與他一同學習「明鏡止水流」，師從同一位劍道家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060413
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060413,
					"content": "我比他早五年拜入師門，是所有人眼中沉穩可靠的師兄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060414
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060414,
					"content": "明鏡止水流追求「心無雜念」，所以絕大部分弟子都淡泊名利，我也不例外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060430
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060430,
					"content": "但土門不一樣，他拜入師門第一件事，就是笑著問師父，「如何才能成為天下第一」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060415
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060415,
					"content": "師父當時訓斥了他，說劍道不是用來爭奪虛名的。練劍幾天就奢求最強之名，說明他內心浮躁，永遠也學不好劍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060416
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060416,
					"content": "當時，我也是這麼認為的…但後來，土門的劍術成長飛快，甚至逐漸追上了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060417
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060417,
					"content": "那時候，我才意識到，土門其實早就已經做到了「心無雜念」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060418
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060418,
					"content": "他的內心中只有「成為天下第一」這一件事。他追求的是劍道的極致，無論遇到多少挫折，他都能重新振作起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060419
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060419,
					"content": "感覺是一個很厲害的人…但為什麼你不想再見到他呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060420,
					"content": "因為在他到來之前，我曾對繼承「明鏡止水流」志在必得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060431
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060431,
					"content": "畢竟在師父的眾多弟子中，我天賦最好、練劍時間最長，背負著所有人的期望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060421
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060421,
					"content": "但是他的到來改變了這一切。我在與他的比試中落敗，失去了尊嚴與地位，從師門中落荒而逃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060422
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060422,
					"content": "後來聽說，他又去找師父比試，而師父年事已高，在那場比試中耗盡了最後的元氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060423
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060423,
					"content": "那之後，我再也不想跟他有任何瓜葛。但捫心自問，我還是認可他的劍術，認可他追求劍道的心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060424
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060424,
					"content": "所以聽到他瘋了的消息時，我直覺認為是假的。他怎麼可能會發瘋呢？他是將「明鏡止水」貫徹到極致的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060425
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060425,
					"content": "所以我想悄悄過來，看看他是不是真的瘋了。但我沒想到，他還會叫我的名字…我還以為他早就忘了我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060426
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060426,
					"content": "總之，我沒有害他的想法，只是想來確認一下而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060427
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060427,
					"content": "回去吧，我的話說完了，驅邪儀式…大概也要結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060428
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 20060428,
					"content": "嗯…看來他並不是想破壞「驅邪儀式」呢，是我們誤會他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20060429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20060429,
					"content": "不過，也不知道應不應該帶他回去…我們還是先去看看「驅邪儀式」進行得怎麼樣了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
