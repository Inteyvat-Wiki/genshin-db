				"points": []
			},
			"dialogs": [
				{
					"id": 710970101,
					"content": "請問兩位找到「老石」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970102
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970102,
					"content": "在這裡了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7109702,
			"completionStepIds": [
				7109702
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109702",
							"2"
						],
						"stepId": 7109702,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"沐寧",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710970201,
					"content": "算上這次的，一共是九枚「老石」，這下應該夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970202
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970202,
					"content": "#這麼快就滿足了輝山廳的需求…真不愧是{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970203
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970203,
					"content": "只不過是巨獸之勞啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970204,
					"content": "是「舉手之勞」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970205
					]
				},
				{
					"id": 710970205,
					"content": "哇！我是說…嗯…這種東西和打倒巨獸一樣，都是小意思而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970206,
					"content": "派蒙學會強詞奪理了，可喜可賀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970207
					]
				},
				{
					"id": 710970207,
					"content": "#哈哈…派蒙說的沒錯啦，兩位力搏海魔的功績，我們都看在眼裡的。相信此等壯舉對{F#妳}{M#你}們來說確實並不困難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970208,
						710970209
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970208,
					"content": "確實如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				},
				{
					"id": 710970210,
					"content": "說來，沒想到進了總務司，還要負責「在層岩巨淵找老石」這種工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970211
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970211,
					"content": "對喔，你那個時候不是還天天和自己父親吵架。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970212,
					"content": "怎麼後來去了總務司的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970213,
					"content": "之前我不是欠了一大筆錢，走投無路，更不願回家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970214
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970214,
					"content": "結果討債的人直接去盛露廳找上了我爸…我聽到這件事時心想，我爸非得把我腿打斷不可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970215
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970215,
					"content": "可是你的腿看起來還挺完整的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970216,
					"content": "是…說來慚愧，我爸幫我把錢還了，在街上找到了落魄的我，說，「你所有欠條都在我手裡，所以現在你欠我錢了」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970217
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970217,
					"content": "以此要脅我找工作…以償還欠款。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970218
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970218,
					"content": "原來你現在欠的是你爸的錢啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970219,
					"content": "是這樣沒錯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970220
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970220,
					"content": "當然，那個時候我每日逃債，惶惶不可終日，早就決定，如果有機會就一定洗心革面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970221
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970221,
					"content": "但是我沒想到這個機會竟然是那個時常跟我吵架的老爸給我的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970222
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970222,
					"content": "我爸也破天荒沒有和我吵架，反而開誠佈公地談了談，這種談話要是能早些開始就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970223
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970223,
					"content": "不過就算之前他有心跟我談，那個時候我也沒心情聽吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970224
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970224,
					"content": "看來你家老爺子對你還蠻好的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970225,
					"content": "是啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970226
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970226,
					"content": "所以無論如何，都得做好手上的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970227
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970227,
					"content": "無論是這次層岩巨淵的事，還是幫輝山廳打雜找「老石」的活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970228
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970228,
					"content": "這次活明明是我幫你做的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970229
					]
				},
				{
					"id": 710970229,
					"content": "找人幫忙完成工作，也是完成工作的一種方式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970230
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970230,
					"content": "不過這次也真是多虧了二位，能這麼快完成這件工作，出乎了我的意料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710970231
					],
					"speakerTitle": "沐寧"
				},
				{
					"id": 710970231,
					"content": "知道就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710970209,
					"content": "要說困難還是有一點啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710970210
					]
				}
			]
		}
	]
}