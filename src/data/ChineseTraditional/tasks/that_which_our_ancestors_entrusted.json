				"points": []
			},
			"dialogs": [
				{
					"id": 400610101,
					"content": "今天海祇島颳起了南來風，我就料想會有好友來拜訪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610102
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610102,
					"content": "#每次妳這麼一說話，我和{NICKNAME}就要奔波大半天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400610103,
					"content": "不要這麼說嘛。我們不是，好搭檔嗎？最好的那種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610104
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610104,
					"content": "#不過今天，我確實有件事想要拜託{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610105
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610105,
					"content": "相傳，我家先祖在珊瑚宮海祇御靈祭之事外，還追加了另一套試煉。和海祇島存亡無關，和真相有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610106
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610106,
					"content": "另一套…試煉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400610107,
					"content": "#現在海祇島的存亡危機既然已經解除了，那我就出於祖傳的義務與責任提醒{F#妳}{M#你}們一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610108
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610108,
					"content": "#{F#妳}{M#你}們可以去那個所謂的「蛇心之地」的某處，尋找第二試煉的線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610109
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610109,
					"content": "哎呀，解脫了，輕鬆了。這份沉重的責任可以傳給我未來的女兒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610110
					],
					"speakerTitle": "露子"
				},
				{
					"id": 400610110,
					"content": "祖傳的任務就是說這麼簡單的一句話嗎！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400610111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400610111,
					"content": "…我至今還是有點跟不上露子的思維…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}