			"dialogs": [
				{
					"id": 701040301,
					"content": "怎麼樣，信標都放好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040302
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040302,
					"content": "都放好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040303
					]
				},
				{
					"id": 701040303,
					"content": "#實在是幫大忙了，這些報酬給{F#妳}{M#你}，謝謝{F#妳}{M#你}幫我這麼多忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040304
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040304,
					"content": "唉，這麼點信標，也不知道能勘測到多少有用的資料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾斯特爾"
				}
			]
		},
