			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾斯特爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701040201,
					"content": "#{F#妳}{M#你}找到我的信標了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040202
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040202,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040203
					]
				},
				{
					"id": 701040203,
					"content": "給我看看，沒錯，這些是我的信標！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040204
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040204,
					"content": "這個狀態…它們一定還是被魔物破壞過，還好，總算是沒有徹底壞掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040205
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040205,
					"content": "唉，但這些信標暫時是不能用了…算了，不能完全勘測就不能完全勘測吧，能測一點是一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040206
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040206,
					"content": "#我這裡還有幾個信標，{F#妳}{M#你}能幫我把它們都放到山上去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040207,
						701040209
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040207,
					"content": "具體要放在哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040208
					]
				},
				{
					"id": 701040208,
					"content": "#{F#妳}{M#你}是答應我了吧！謝謝{F#妳}{M#你}，我這就把地點標註在{F#妳}{M#你}的地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040215,
					"content": "#好了，我已經把地點幫{F#妳}{M#你}標好了，把信標放在那附近就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040216
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040216,
					"content": "#{F#妳}{M#你}放置信標的時候，記得把信標放在高處啊，那樣勘測的效果才最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040209,
					"content": "妳怎麼不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701040210
					]
				},
				{
					"id": 701040210,
					"content": "我不敢去啦…連探險隊都被怪物襲擊成那個樣子，我一個人怎麼敢上去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040211
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040211,
					"content": "而且我暫時也找不到另一支要進山的探險隊，再這麼拖下去，不知道要拖到什麼時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040212
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040212,
					"content": "#所以我只能拜託{F#妳}{M#你}了，{F#妳}{M#你}之前那麼順利就幫我拿回了信標，身手一定不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040213
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040213,
					"content": "這件事就拜託你了，我一定會準備好報酬的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040214
					],
					"speakerTitle": "艾斯特爾"
				},
				{
					"id": 701040214,
					"content": "#對了，我把要放置信標的地點幫{F#妳}{M#你}標在地圖上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701040215
					],
					"speakerTitle": "艾斯特爾"
				}
			]
		},
