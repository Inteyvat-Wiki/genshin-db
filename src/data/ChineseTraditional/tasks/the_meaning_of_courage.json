				]
			},
			"dialogs": [
				{
					"id": 150310401,
					"content": "收穫很豐富啊，有好多遊像眼，還有這個，好像是牠用來噴火的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310402,
					"content": "嗯，這是牠的背甲，能夠噴射燃素，所以牠的動作很迅捷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310403
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310403,
					"content": "我爸爸和我講過，牠是住在火山裡的一種生物，我們能碰上，運氣真的很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310404
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310404,
					"content": "我覺得這塊背甲說不定比遊像眼製造的溫度更高，嘿嘿，這下子一定夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310405
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310405,
					"content": "剛剛妳戰鬥的表現很不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310406
					]
				},
				{
					"id": 150310406,
					"content": "唔…就算再怎麼不想戰鬥，也有不得不戰鬥的時候，為了能盡快進入狀態，我也想了很多很多辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310407
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310407,
					"content": "比如，我總是在看各種英雄的故事，而我最喜歡的英雄，就是之前提到過的「菲耶蒂娜」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310408
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310408,
					"content": "她最標誌性的道具，就是臉上的面具了，所以我也根據故事裡的描述，做了一個差不多的面具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310409
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310409,
					"content": "當戴上面具的時候，我就覺得我變成了她——因為不能讓她的名字蒙羞，我必須勇敢起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310410
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310410,
					"content": "但也可以說，這種做法是我躲在她的身後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310411
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310411,
					"content": "原來是這樣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310412,
						150310413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310412,
					"content": "可是很管用啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				},
				{
					"id": 150310414,
					"content": "真的嗎？可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310415
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310415,
					"content": "總有一天，我需要摘掉面具，面對自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310416
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310416,
					"content": "可是，越是邁不出這一步，就越是會依賴這個面具，我…很擔心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310417,
						150310418
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310417,
					"content": "但決定要調查蘑菇的是妳自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310419,
					"content": "對啊，這是妳自己的決定！冒險的真諦就在於做出勇敢的決定，戰鬥只是很片面的一個部分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310420,
					"content": "原來如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310421
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310421,
					"content": "妳已經進步很多了，不用著急啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310422,
					"content": "#謝謝{F#妳}{M#你}們，{F#妳}{M#你}們一直在鼓勵我，教了我很多東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310423
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310423,
					"content": "嗯！我會繼續成長，直到能夠面對我自己的名字！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310424
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310424,
					"content": "心情舒暢之後，好像肚子突然就餓了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310425
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310425,
					"content": "欸，又餓了？我覺得我還沒消化完呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310426,
					"content": "走吧，回「沃陸之邦」，這次一定能滿足「蕈之賢主」的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310418,
					"content": "並不是妳的面具。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310419
					]
				},
				{
					"id": 150310413,
					"content": "不用覺得這是丟人的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310414
					]
				}
			]
		}
	]
}