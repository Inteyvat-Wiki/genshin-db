							-2903.861,
							218.146,
							9845.328
						],
						"pointId": 10926
					},
					{
						"sceneId": 3,
						"position": [
							-2905.359,
							218.377,
							9846.601
						],
						"pointId": 10927
					}
				]
			},
			"dialogs": [
				{
					"id": 150310201,
					"content": "這條路我平時經常走，我記得路邊會有正在休息的熔岩遊像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310202
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310202,
					"content": "它們的核心很燙，應該能滿足我們的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310203
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310203,
					"content": "沒想到大家會這麼配合我們，看來他們其實都對這個蘑菇有所懷疑啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310204,
					"content": "#嗯，還是多虧了{F#妳}{M#你}們來到這裡，之前有很多很多人都吃過這種蘑菇，但能和蘑菇說上話，真的還是第一次…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310205
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310205,
					"content": "也是，就算想查，也不知道從哪裡開始查吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310206,
					"content": "所以這次還算是個難得的好機會，再加上那個「蕈之賢主」總是出言不遜，也點燃了大家的勝負欲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310207
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310207,
					"content": "「沃陸之邦」的人好像都熱愛競爭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310208
					]
				},
				{
					"id": 150310208,
					"content": "是哦，不過瓦雷莎看起來是個很溫和的人，可能只有運動和戰鬥的時候除外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310209,
					"content": "這個…是的，我並不喜歡戰鬥，也不爭強好勝，我覺得只要能過好每一天的日子就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310210
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310210,
					"content": "可是伊安珊老師教了我很多，比如「力量」是手段而不是目的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310211
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310211,
					"content": "在深淵攻進來的時候，要是我沒有進行平時的訓練，也不擅長掌控元素力量，就只能眼睜睜地看著魔物肆虐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310212
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310212,
					"content": "就算再怎麼害怕，我都必須鼓起勇氣，不能讓這種事發生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310213,
						150310214
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310213,
					"content": "能看出來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				},
				{
					"id": 150310215,
					"content": "謝謝，我會慢慢變得勇敢，就像菲耶蒂娜一樣勇敢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310216
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310216,
					"content": "走吧，我們邊走邊找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310214,
					"content": "妳的心裡有堅強的一面。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150310215
					]
				}
			]
		},
