			"dialogs": [
				{
					"id": 150310301,
					"content": "#順利解決！這個好像很不錯，{F#妳}{M#你}們看，裡面的燃素還很活躍呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310302
					],
					"speakerTitle": "瓦雷莎"
				},
				{
					"id": 150310302,
					"content": "我摸摸看…哇，好燙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150310303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150310303,
					"content": "像這樣的再多找幾塊應該就夠了，走，我們再往上看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦雷莎"
				}
			]
