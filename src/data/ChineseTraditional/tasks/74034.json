				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"迪福爾"
				],
				"points": [
					{
						"sceneId": 1083,
						"position": [
							-8.077,
							0,
							7.544
						],
						"pointId": 13
					},
					{
						"sceneId": 1083,
						"position": [
							-4.844,
							0,
							7.777
						],
						"pointId": 27
					},
					{
						"sceneId": 1083,
						"position": [
							-4.891,
							0,
							5.725
						],
						"pointId": 28
					},
					{
						"sceneId": 1083,
						"position": [
							-4.946,
							0,
							4.838
						],
						"pointId": 29
					}
				]
			},
			"dialogs": [
				{
					"id": 740340701,
					"content": "艾尤恩，我猜你今天沒有帶什麼好消息給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340702
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340702,
					"content": "先生，這確實不是個好消息。準確來說，這是一個「秘密」消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340703
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340703,
					"content": "確實如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340704
					]
				},
				{
					"id": 740340704,
					"content": "非常幽默，艾尤恩。那麼這個「秘密」消息到底是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340705
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340705,
					"content": "艾尤恩詳細敘述了相關事宜…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340706
					]
				},
				{
					"id": 740340706,
					"content": "這種情況的確有可能出現，畢竟複律庭裡的職員對一份文件的保密程度並不敏銳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340707,
						740340708
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340707,
					"content": "這種問題也會忽視嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340709
					]
				},
				{
					"id": 740340709,
					"content": "這都是拜加特尼奧那群人所賜。所有複律庭裡流傳的文件，都會交由他們審定機密等級，再做上標記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340710
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340710,
					"content": "這制度聽起來還算不錯。但那群審定機密等級的人為了省事，無論什麼文件，都至少會給一個「秘密」的等級。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340711
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340711,
					"content": "上週卡爾西去歐庇克萊歌劇院發表了一次演說，談了談新歌劇演出的話題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340712
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340712,
					"content": "我記得這件事，演講過程不長，但有很多人聽，而且演講稿還登上了報紙呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340713
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340713,
					"content": "既然已經在大家面前講過了，那大家也都該知道了呀。大家都知道的事，怎麼能算是秘密呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340714
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340714,
					"content": "沒錯，但就算這樣，加特尼奧也非要把它定一個「機密等級」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340715,
						740340716
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340715,
					"content": "也許裡面真有重要內容？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340717
					]
				},
				{
					"id": 740340717,
					"content": "才怪。他把這篇早就在公眾面前演講過的稿件定成了「秘密」，但卻沒管那些那份之前的原稿啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340718
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340718,
					"content": "卡爾西自己才不會寫演講稿，整篇稿件都是別人代寫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340742
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340742,
					"content": "他做的唯一一處修改，就是把自己的名字簽在上面，再改幾個無關緊要的形容詞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340719
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340719,
					"content": "但那些修改前的原稿，就堆在卡爾西的辦公室桌子上，沒有一個人去管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340720
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340720,
					"content": "如果這就是加特尼奧想要保守的秘密，他怎麼不把這些文件也定個機密等級呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340721,
						740340722
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340721,
					"content": "這也是一種保密方式。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340723
					]
				},
				{
					"id": 740340723,
					"content": "算了吧！他們只是貪圖方便而已。在加特尼奧看來，保守秘密的最佳方式，就是把所有事情都變成秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340724
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340724,
					"content": "這樣，就沒人知道到底哪一份才是真正需要保守的秘密了。就連他們自己也不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340725
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340725,
					"content": "想要把一杯水藏起來，那最好的方法的確是將它倒入一個湖泊。這樣做也沒錯呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340726
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340726,
					"content": "如果你要藏起來的是一杯楓達呢？你準備把整片湖泊都變成楓達湖嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340727
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340727,
					"content": "#一片楓達湖…嘿嘿嘿，想要去裡面游泳。楓達超好喝的，對吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340728,
						740340729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340728,
					"content": "派蒙，重點不在這裡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340731
					]
				},
				{
					"id": 740340731,
					"content": "那麼…這份文件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340732
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340732,
					"content": "艾尤恩先生，這件事有關人員事宜，你來找我的確沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340733
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340733,
					"content": "但在那之前，你必須得讓加特尼奧來審定這件事的機密等級。就像是之前說的那樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340743
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340743,
					"content": "在正式工作之前，我們首先得知道要藏起來的究竟是一杯水還是一杯楓達啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340734
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340734,
					"content": "我們是老同事，我不會為難你。我們辦公室絕對會傾力協助辦理這件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340735
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340735,
					"content": "迪福爾拖過文件，慢吞吞地在協辦方位置上簽上了名字…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340736
					]
				},
				{
					"id": 740340736,
					"content": "好了，快去找加特尼奧吧！這麼大的人員事宜，我要去提前知會幾個人才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340737
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340737,
					"content": "迪福爾先生，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340744
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340744,
					"content": "迪福爾頭也不回地離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340738,
						740340739
					]
				},
				{
					"id": 740340738,
					"content": "走掉了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340740
					]
				},
				{
					"id": 740340740,
					"content": "唉，這就是迪福爾先生，暴躁又精明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340741
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340741,
					"content": "沒辦法了，我們去找加特尼奧吧，我們往這走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340739,
					"content": "走得真快…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340740
					]
				},
				{
					"id": 740340729,
					"content": "等一下我們去喝一杯好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340730
					]
				},
				{
					"id": 740340730,
					"content": "真的？那說好了，不准反悔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340731
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340722,
					"content": "說不定是…謹慎起見？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340723
					]
				},
				{
					"id": 740340716,
					"content": "呃…也許他有這麼做的理由…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340717
					]
				},
				{
					"id": 740340708,
					"content": "沒有人告訴他們這個…「機密等級」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340744
					]
				}
			]
		},
