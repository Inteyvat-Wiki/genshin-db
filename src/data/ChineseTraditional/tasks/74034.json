							5.337,
							0,
							-3.606
						],
						"pointId": 26
					}
				]
			},
			"dialogs": [
				{
					"id": 740340501,
					"content": "艾尤恩，真是巧遇。今天下班你總有時間和我喝杯咖啡了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340502
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340502,
					"content": "感謝您的好意，但我有一件「秘密事務」來請您處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340503
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340503,
					"content": "「秘密事務」？是我知道的事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340504
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340504,
					"content": "我想您應該不知道。今天早上我才接到這份文件呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340505
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340505,
					"content": "這還真是稀奇，也許是我今天還沒來得及看《蒸汽鳥報》的原因，獲得消息的速度慢了你一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340506
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340506,
					"content": "明明是秘密事務，為什麼你會在《蒸汽鳥報》上看到呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340507,
					"content": "哈哈哈，那些記者傳遞消息的速度，真的比我們複律庭內部傳遞消息的速度快多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340508
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340508,
					"content": "不過也可以理解，畢竟他們傳遞消息是會拿到報酬的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340509
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340509,
					"content": "完、完全無法理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340510,
					"content": "先不談這些。先生，事情是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340511
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340511,
					"content": "艾尤恩詳細敘述了相關事宜…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340512
					]
				},
				{
					"id": 740340512,
					"content": "沒錯，的確有必要下發這樣的文件，之前確實出過這樣的事情。一個白癡為了炫耀自己的桌面擺設，拿留影機幫自己的桌子留影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340513
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340513,
					"content": "他是「留影機愛好協會」的一員，還把那張畫片拿去給會員們看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340534
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340534,
					"content": "但會員中的一名記者很快發現，畫片中有一份疑似複律庭內部的通訊稿的文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340514
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340514,
					"content": "然後，那份抱怨複律庭的內部晚餐除了魚就是魚的通訊，第二天就出現在了《蒸汽鳥報》上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340515
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340515,
					"content": "這也算是需要保守的秘密嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340516,
					"content": "聽起來好像不是很嚴重…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340517
					]
				},
				{
					"id": 740340517,
					"content": "無論如何，這也算得上是內部通訊，於情於理都不該對外洩露。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340518
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340518,
					"content": "楓丹廷的人們才不會放過任何一個嘲笑複律庭的機會，我們必須得謹慎行事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340519
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340519,
					"content": "即使他們其實根本不關心我們在做什麼。他們只是想…呃，笑兩聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340520
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340520,
					"content": "呃，總之…那這份文件就由您的辦公室來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340521
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340521,
					"content": "但有關人員事務規章…迪福爾所在的辦公室顯然更適合簽發這份文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340522
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340522,
					"content": "畢竟，在這份文件裡，雖然告知所有人保密原則十分重要，但更重要的是，如何告知所有人保密原則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340523
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340523,
					"content": "我覺得，必須得迪福爾來統籌，我們辦公室可以協辦。這樣既有效率，又能保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340524
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340524,
					"content": "加特尼奧飛快地在文件上的協辦方位置上簽上了名字…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340525
					]
				},
				{
					"id": 740340525,
					"content": "但是，加特尼奧先生！這件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340526
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340526,
					"content": "好啦小夥子，辦這種急事可不能拖拖拉拉的。快去找迪福爾吧，不然他的耐心馬上就要被日常工作給耗盡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340527
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340527,
					"content": "我也得去幫你們找找可用的保密原則了，等到文件正式下發，我們辦公室一定全力支持！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340535
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340535,
					"content": "快去找他吧，年輕人！我還得去…呃，處理別的事務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340536
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340536,
					"content": "加特尼奧大踏步地離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340528
					]
				},
				{
					"id": 740340528,
					"content": "什麼？加特尼奧先生，等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340529,
						740340530
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340529,
					"content": "走掉了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340531
					]
				},
				{
					"id": 740340531,
					"content": "您見識到加特尼奧先生的能力了吧？他能把所有事都辦理妥當的訣竅，就是從來不辦有風險的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340532
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340532,
					"content": "原來是這種推卸責任的能力啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340533
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340533,
					"content": "沒辦法…只能去找迪福爾先生了。我們往這走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340530,
					"content": "走得真快…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340535
					]
				}
			]
		},
