			"dialogs": [
				{
					"id": 740340601,
					"content": "艾尤恩。你找我有什麼事嗎？氣喘吁吁的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340602
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340602,
					"content": "事情是這樣的，迪福爾先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340603
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340603,
					"content": "艾尤恩詳細敘述了相關事宜…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340604
					]
				},
				{
					"id": 740340604,
					"content": "你找錯人了，艾尤恩。你難道沒意識到這份文件的重點是「保密」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340605
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340605,
					"content": "我還以為主詞是「這份文件」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340606
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340606,
					"content": "語法確實如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340607
					]
				},
				{
					"id": 740340607,
					"content": "喂，現在的重點不是這個吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340608,
					"content": "我真欣賞你們的嚴謹。但這份文件我是不會簽的，無論怎麼考慮，都應該是加特尼奧來帶領。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340609
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340609,
					"content": "加特尼奧先生說，應該由您來帶領…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340610
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340610,
					"content": "蛤！我來？該怎麼做，我要拿著大聲公，朝每一位進來上班的人大喊嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340611
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340611,
					"content": "「嘿！先生女士們，不要把留影機帶進辦公室，這樣會導致洩密！絕對不要做這樣的事！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340612
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340612,
					"content": "還是我要去印幾百份文件，放在每一位複律庭職員的桌上，讓他們拿著去喝咖啡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340613
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340613,
					"content": "我們才不像加特尼奧，能把洩密的人抓住，然後教訓他們。我們唯一能做的就是發通知，沒人會理會這些文件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340614
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340614,
					"content": "但他已經在文件上簽了字，您看這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340615
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340615,
					"content": "年輕人，你知道「協辦方」是什麼意思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340616
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340616,
					"content": "呃…聽從調遣的一方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340617
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340617,
					"content": "意思是「至少主要責任不在我」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340618
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340618,
					"content": "我絕不會在這份文件上簽字。如果非要我們辦公室來負責，那就讓馬內瓦爾親自來說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340619
					],
					"speakerTitle": "迪福爾"
				},
				{
					"id": 740340619,
					"content": "迪福爾怒氣沖沖地離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340620
					]
				},
				{
					"id": 740340620,
					"content": "他、他說話的聲音好大，根本不敢插話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740340621,
					"content": "您看，這位先生的脾氣就是這麼暴躁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340622
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340622,
					"content": "那現在怎麼辦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740340623
					]
				},
				{
					"id": 740340623,
					"content": "別擔心…我們回去找洛耶茨先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				}
			]
		},
		{
			"id": 7403407,
			"completionStepIds": [
				7403407
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
