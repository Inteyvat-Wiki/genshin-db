					}
				]
			},
			"dialogs": [
				{
					"id": 740340801,
					"content": "艾尤恩！好小子，我竟然會在這裡遇見你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340802
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340802,
					"content": "加特尼奧先生，我正在找你。有一個消息我得讓你知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340803
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340803,
					"content": "什麼消息？我剛看完了今天的《蒸汽鳥報》，上面沒有提到複律庭啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340804
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340804,
					"content": "是的，這個消息事關保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340805
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340805,
					"content": "喔，那還真是稀奇。除了記者之外，居然還有人能分辨出一件事情是否有關保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340806
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340806,
					"content": "艾尤恩詳細敘述了相關事宜…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740340807
					]
				},
				{
					"id": 740340807,
					"content": "哎喲，迪福爾先生根本就是一位勤勉的記者，他就差直接衝來我的辦公室，質問我這份文件的保密性了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340808
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340808,
					"content": "我完全同意他的觀點。這件事確實得先確定機密等級，但「留影機洩密」事關重大，可能牽涉整個複律庭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340809
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340809,
					"content": "我一個辦公室無法為其定級，必須要送去請其他幾位先生審定，讓他們全部都知悉才行。例如說…卡爾西先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340810
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340810,
					"content": "欸？但這份文件就是卡爾西先生發下來的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340811
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740340811,
					"content": "那就更應該讓他知道我們後續的處理方案了。來吧年輕人，我們先去找洛耶茨，然後再去見卡爾西先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740340812
					],
					"speakerTitle": "加特尼奧"
				},
				{
					"id": 740340812,
					"content": "什麼？等等！加特尼奧先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				}
			]
		},
