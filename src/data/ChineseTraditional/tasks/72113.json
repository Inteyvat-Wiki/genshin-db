			},
			"dialogs": [
				{
					"id": 721130201,
					"content": "我瞧瞧我瞧瞧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130202,
					"content": "哇！寫著「大吉」耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130203,
					"content": "看來今天是派蒙的幸運日！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130204,
					"content": "妳的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130205
					]
				},
				{
					"id": 721130205,
					"content": "#沒錯！{F#妳}{M#你}的幸福就是派蒙的幸福呀！所以反過來說，派蒙幸福，{F#妳}{M#你}也幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130206,
					"content": "#我吃到好吃的就會幸福。所以，為了{F#妳}{M#你}自己的幸福，請給我吃好吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
