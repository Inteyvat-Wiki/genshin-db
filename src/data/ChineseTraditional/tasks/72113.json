			},
			"dialogs": [
				{
					"id": 721131001,
					"content": "#{F#妳}{M#你}究竟是什麼人？想要幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131002
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131002,
					"content": "我們才要問呢！玄冬小姐妳想幹什麼，為什麼突然襲擊我們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131003,
					"content": "無禮。回答我的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131004
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131004,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131005
					]
				},
				{
					"id": 721131005,
					"content": "#我知道{F#妳}{M#你}的名字，給我老實說，暗號是從哪聽來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131006,
						721131008
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131006,
					"content": "是、是派蒙告訴我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131007
					]
				},
				{
					"id": 721131007,
					"content": "#喂！{F#妳}{M#你}要幹什麼呀？趕快把實情說出來呀，玄冬小姐已經在瞪我們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131010
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131010,
					"content": "#…原來如此，手記只是{F#妳}{M#你}們兩個偶然得到的。這樣看來，百華她應該已經…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131011
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131011,
					"content": "「百華」是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131012
					]
				},
				{
					"id": 721131012,
					"content": "是手記的主人，也是我的同僚。不過她現在已經無法履行自己對稻妻的職責了，真是可悲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131013
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131013,
					"content": "#哼，我知道{F#妳}{M#你}們還有很多疑問，都告訴{F#妳}{M#你}們也無妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131014
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131014,
					"content": "我和百華都是「終末番」的忍者。我們「終末番」會為稻妻掃清有害的異物，而「紙片兒」是我們溝通任務的方式之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131015
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131015,
					"content": "因此，我們也承受了很多怨恨與危險。比如說，潛伏在稻妻境內那些奇怪又危險的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131016,
						721131018
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131016,
					"content": "蒙德人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131017
					]
				},
				{
					"id": 721131017,
					"content": "哪來的蒙德人啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131020,
					"content": "如果知道暗號，就可以分辨出同伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131021
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131021,
					"content": "但是，每個人的暗號都是獨一無二的。看來百華故意寫出自己的暗號，是留了一手呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131022
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131022,
					"content": "…為了引出想要利用這一暗號的敵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131023
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131023,
					"content": "這麼說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131024
					]
				},
				{
					"id": 721131024,
					"content": "玄冬小姐看見來接頭的人不是百華，馬上就知道事情不對了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131025
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131025,
					"content": "那當然，所以我必須查明情況。但真的很奇怪。我無論如何也想不通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131026
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131026,
					"content": "#如果{F#妳}{M#你}是至冬國的探子，為什麼沒有把這件事匯報給愚人眾，反而老老實實去把任務完成了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131027
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131027,
					"content": "#…所以，我相信{F#妳}{M#你}所說的廢棄營地的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131028
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131028,
					"content": "#因為從實際行動來看，雖然一開始{F#妳}{M#你}們只是出於好奇對上了暗號，但{F#妳}{M#你}們於稻妻而言，是友非敵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131029
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131029,
					"content": "雖然還了我們清白，可是想想這麼長時間裡，玄冬小姐都把我們當免費勞動力，還是有點不高興！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131030
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131030,
					"content": "…但那個人，真的是玄冬小姐嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131031
					]
				},
				{
					"id": 721131031,
					"content": "#哼，果然意識到了嗎，後續給{F#妳}{M#你}們任務的玄冬，是冒充的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131032
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131032,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131033
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131033,
					"content": "#在我跟蹤{F#妳}{M#你}的路上，被幾個愚人眾的密探襲擊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131034
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131034,
					"content": "因為我姑且也會一兩式忍法，所以用假死蒙混過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131035
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131035,
					"content": "之後不久他們就派人喬裝成我的模樣，去頂替我的位置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131036,
						721131037
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131036,
					"content": "難怪感覺她很不對勁。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131038,
					"content": "欸？也就是說，那個比較親切的玄冬小姐是冒牌貨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131039
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131039,
					"content": "「親切」？哼，那傢伙聽起來挺受歡迎啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131040
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131040,
					"content": "#總之，他們大概以為，{F#妳}{M#你}是正牌的終末番成員，想透過這種方式來滲透我們的組織。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131041
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131041,
					"content": "#對我而言，這也是很好的機會。趁冒牌貨今天不在，我用「自己的方式」把{F#妳}{M#你}帶到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131042
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131042,
					"content": "#{F#妳}{M#你}聽好了。現在我給{F#妳}{M#你}一個選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131043
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131043,
					"content": "作為外部成員，為我們工作。現在他們不知道我還活著，所以我們佔了上風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131044,
						721131047,
						721131048
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131044,
					"content": "要是我拒絕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131045
					]
				},
				{
					"id": 721131045,
					"content": "喔，試試看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131046
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131046,
					"content": "#不管怎麼說，{NICKNAME}，愚人眾也是我們的敵人。我們不如合作吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131049
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721131049,
					"content": "#賢明的選擇。這個「安全屋」的物資，姑且也交給{F#妳}{M#你}自由支配吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131050
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131050,
					"content": "#那麼，日後有新的動向時，我會聯絡{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131051
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131051,
					"content": "希望我們能夠愉快合作。再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131047,
					"content": "有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131048,
					"content": "好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131049
					]
				},
				{
					"id": 721131037,
					"content": "難怪她知道「御神籤」這個詞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131038
					]
				},
				{
					"id": 721131018,
					"content": "愚人眾。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131019
					]
				},
				{
					"id": 721131019,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131020
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721131008,
					"content": "妳聽我解釋，事情是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721131009
					]
				},
				{
					"id": 721131009,
					"content": "我們在一座山頭上，找到了一個廢棄營地…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721131052
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}