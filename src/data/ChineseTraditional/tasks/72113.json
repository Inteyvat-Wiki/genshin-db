			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 721130101,
					"content": "#{F#妳}{M#你}要求籤嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130102
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130102,
					"content": "嗚哇，好冷淡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130103,
					"content": "我想求籤…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130104
					]
				},
				{
					"id": 721130104,
					"content": "#明白了。流程是這樣的。首先請{F#妳}{M#你}用力搖晃這個什麼東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130105
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130105,
					"content": "記得是叫「御神籤箱」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130106
					]
				},
				{
					"id": 721130106,
					"content": "#沒錯。從裡面會掉出一根竹籤。把這根竹籤給我，我就會給{F#妳}{M#你}對應的紙片兒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130107
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130107,
					"content": "好像叫「御神籤」來著…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130108
					]
				},
				{
					"id": 721130108,
					"content": "這種事情怎樣都好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130109
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130109,
					"content": "我有問題！如果說，如果說我們抽到了凶籤，要怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130110,
					"content": "#是命運讓{F#妳}{M#你}抽到凶籤，{F#妳}{M#你}還想怎樣？啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130111
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130111,
					"content": "欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130112,
					"content": "外頭那個像架子的東西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130113
					]
				},
				{
					"id": 721130113,
					"content": "嘖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130114
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130114,
					"content": "她很露骨地「嘖」了耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130115,
					"content": "我看看…是這樣的。「把凶籤捆到『御籤掛』上，就可以逢凶化吉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130116
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130116,
					"content": "#啊，對喔！如果{F#妳}{M#你}抽到凶籤，把它捆到那個架子上就行了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130117
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130117,
					"content": "#他們還真是…不對，我們「鳴神大社」很溫柔的。所以就算抽到了凶籤，也會給{F#妳}{M#你}們轉運的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130118
					],
					"speakerTitle": "玄冬林檎"
				},
				{
					"id": 721130118,
					"content": "雖然感覺哪裡好像怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130119,
					"content": "#{NICKNAME}，我們來求籤吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7211302,
			"completionStepIds": [
				7211302
