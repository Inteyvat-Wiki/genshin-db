			"dialogs": [
				{
					"id": 721130401,
					"content": "我瞧瞧我瞧瞧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130402,
					"content": "欸，是「凶」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130403,
					"content": "這種情況我記得！是說…「把兇籤捆到『御籤掛』上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130404,
					"content": "「然後請派蒙吃好吃的，就可以逢凶化吉。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130405,
					"content": "是這樣喔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721130406
					]
				},
				{
					"id": 721130406,
					"content": "#當然了！{F#妳}{M#你}要質疑古人的智慧嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721130407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721130407,
					"content": "古人的智慧真了不起哪！總之，先找找御籤掛吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
