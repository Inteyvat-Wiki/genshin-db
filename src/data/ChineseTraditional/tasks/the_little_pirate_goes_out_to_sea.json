			"dialogs": [
				{
					"id": 210270201,
					"content": "旅行者，還有小蒙？你們有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270202
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 210270202,
					"content": "#啊？呃…那個…那個…{F#大姐姐}{M#大哥哥}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270203
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270203,
					"content": "我們想要借用一下廚房。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270204
					]
				},
				{
					"id": 210270204,
					"content": "借用廚房倒是沒問題，可你們為什麼突然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270205
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 210270205,
					"content": "原來是這樣…好，你們就去用吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270206
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 210270206,
					"content": "小蒙，去外面旅行的時候，你可不能挑食了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270207
					],
					"speakerTitle": "卯師傅"
				},
				{
					"id": 210270207,
					"content": "我、我知道了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270208
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270208,
					"content": "#{F#大姐姐}{M#大哥哥}，那就拜託{F#妳}{M#你}了，教我做一道好菜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270209
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270209,
					"content": "等我和爸爸去旅行的時候，我一定要給他一個驚喜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270210
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270210,
					"content": "交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210270211,
					"content": "#{NICKNAME}，我們做什麼菜好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
