					"content": "滿足沙拉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270402
					]
				},
				{
					"id": 210270402,
					"content": "這道菜確實很簡單呢，味道也很不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
