			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 210270101,
					"content": "#{F#大姐姐}{M#大哥哥}！{F#妳}{M#你}來得正好，我正想去找{F#妳}{M#你}呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270102
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270102,
					"content": "欸？小蒙，你有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210270103,
					"content": "#我上次不是拜託{F#妳}{M#你}，陪我去放出了一個裝著我煩惱的漂流瓶嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270104
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270104,
					"content": "本來我都不抱希望了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270105
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270105,
					"content": "但是，前幾天我爸爸說，他的一個生意伙伴突然找到了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270106
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270106,
					"content": "那個叔叔說，他們正在籌劃一樁和蘑菇有關的生意，過段時間要去須彌考察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270107
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270107,
					"content": "他們問我爸爸，要不要跟他們一起去看看那邊的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270108
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270108,
					"content": "還說…可以把我一起帶上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270109
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270109,
					"content": "爸爸最開始還不同意，但是…有個叔叔突然拿出了一封信，說要和我爸爸出去單獨談談。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270110
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270110,
					"content": "他們談完了之後，爸爸就同意帶我去須彌了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270111
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270111,
					"content": "唔，雖然不知道為什麼爸爸突然改變了主意…但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270112
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270112,
					"content": "#我可以去須彌旅行了！{F#大姐姐}{M#大哥哥}！我可以去須彌旅行啦！太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270113,
						210270115
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270113,
					"content": "恭喜你！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270114
					]
				},
				{
					"id": 210270114,
					"content": "#一定是那個漂流瓶起作用了，謝謝你，{F#大姐姐}{M#大哥哥}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270117,
					"content": "爸爸說，他們去了須彌之後，還要去一個叫做「翹英莊」的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270118
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270118,
					"content": "翹英莊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270119
					]
				},
				{
					"id": 210270119,
					"content": "嗯，爸爸說那是一個茶村，種著很多茶樹，茶葉的品質也特別好。不過，這個名字可真難記…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270120
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270120,
					"content": "先不說這些了！在去那邊之前，我們還是要先去須彌的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270121
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270121,
					"content": "須彌離這裡也很遠，過去肯定要花很長時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270122
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270122,
					"content": "不過，我聽人家說外出旅行要做很多準備，因為只要旅行的時間一長，就會遇見各種情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270123
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270123,
					"content": "#{F#大姐姐}{M#大哥哥}，{F#妳}{M#你}經常在外面旅行，能不能請{F#妳}{M#你}教我一些在外旅行的訣竅呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270124
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270124,
					"content": "比如…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270125
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270125,
					"content": "在外面旅行的時候，一般會吃什麼東西呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270126
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270126,
					"content": "爸爸和我說，他們都是自己做東西吃。可我只會幾道簡單的菜，也不知道做得好不好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270127
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270127,
					"content": "#嘿嘿，烹飪可是我們的拿手好戲，對吧？{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270128,
						210270129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210270128,
					"content": "我來教你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270130,
					"content": "那我們得先去找個灶臺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210270131,
					"content": "我想想…不如，我們再去找卯師傅借一下廚房吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210270132,
					"content": "卯師傅？嗚哇，那個大叔平時好嚇人的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270133
					],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270133,
					"content": "卯師傅哪裡嚇人啦？他人很好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 210270134,
					"content": "是、是嗎？可我每次和爸爸在那邊吃飯的時候，只要我把清心挑出去不吃，他的眉頭就皺起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小蒙"
				},
				{
					"id": 210270129,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270130
					]
				},
				{
					"id": 210270115,
					"content": "我說不定也會去須彌。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						210270116
					]
				},
				{
					"id": 210270116,
					"content": "真的嗎？那我們就須彌見吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						210270117
					],
					"speakerTitle": "小蒙"
				}
			]
		},
