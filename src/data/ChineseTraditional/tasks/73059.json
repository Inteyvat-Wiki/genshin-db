			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭納真",
					"蘭迦魯",
					"蘭納迦",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730590201,
					"content": "#蘭納迦，{F#她}{M#他}來啦，{F#她}{M#他}們來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590202
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730590202,
					"content": "嗯嗯，來啦，來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590203
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730590203,
					"content": "#來啦，那菈{NICKNAME}，白色的飛飛。歡迎{F#妳}{M#你}們，我們三個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590204
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730590204,
					"content": "#到了，月亮。到啦，種下花朵的時刻。{F#妳}{M#你}們準備好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590205
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730590205,
					"content": "我準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590206
					]
				},
				{
					"id": 730590206,
					"content": "嗯，我也是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590207,
					"content": "那麼…蘭納真，蘭迦魯，我們開始儀式吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590208
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730590208,
					"content": "「歸去，歸去，花園的夢，森林的記憶…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590209
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730590209,
					"content": "「迎接吧，讓我們：」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590210
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730590210,
					"content": "「漸濃的睡夢，不散的歡欣。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590211
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730590211,
					"content": "「慶賀呀，讓我們：」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590212
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730590212,
					"content": "「石榴歌唱，蘋果鼓掌！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590213
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730590213,
					"content": "蘭那羅們種下乾癟的花朵，隨著歌謠在風中回蕩，花朵奇蹟般地重返了新生…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730590214
					]
				},
				{
					"id": 730590214,
					"content": "哇…這三朵花，又活過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590215,
					"content": "是呀，因為…是慈憫的，「無郁夷摩」。所以，她要讓記憶有重新煥發的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590216
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730590216,
					"content": "#嗯！即使我們不再記得{F#妳}{M#你}們啦，記憶也會…唔，融進葉脈和根系中間，變成綠葉，變成年輪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590217
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730590217,
					"content": "或者變成肉肉的蟲蟲，給別的蟲蟲吃，別的蟲蟲留下滋養草木的東西，讓我們全都長大大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590218
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 730590218,
					"content": "可是…你們還是不記得我們了，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590219,
					"content": "#嗯…因為，並不專屬於{F#妳}{M#你}我，記憶…過去經歷的事情，我們，已經分給了森林裡的所有草木…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590220
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 730590220,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590221
					]
				},
				{
					"id": 730590221,
					"content": "但是沒關係呀，我們已經是新的朋友了，對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590222
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 730590222,
					"content": "嗯！新朋友！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭迦魯"
				}
			]
		},
