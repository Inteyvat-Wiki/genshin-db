			},
			"dialogs": [
				{
					"id": 730590101,
					"content": "「石榴歌唱，蘋果鼓掌…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590102
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730590102,
					"content": "你好呀，海亞姆先生！你怎麼在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590103,
					"content": "#喔喔，妳好，{F#妳}{M#你}好。白色的小朋友，和…唉…抱歉，孩子，我的腦袋不太清楚了，時間稍微一長就記不住名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590104
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730590104,
					"content": "#叫我{NICKNAME}就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590105
					]
				},
				{
					"id": 730590105,
					"content": "#哈哈…好啊，{F#妳}{M#你}們就是之前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590106
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730590106,
					"content": "對！我們就是那兩個「傑萬」——勇敢的年輕人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590107,
					"content": "嗯…所以，告訴我，「蘭那羅」，他們還記得我嗎？還記得我們所有人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590108
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730590108,
					"content": "欸…這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590109,
						730590112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590109,
					"content": "他們還記得你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590110
					]
				},
				{
					"id": 730590110,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730590111,
					"content": "這樣啊…但我看不到他們了，也聽不到他們如何想念我…真是遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730590114,
					"content": "呵呵…我看不到他們了。我太老了，看不到他們的樣子，聽不到他們的聲音…錯過了，都錯過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590115
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730590115,
					"content": "咳咳…抱歉，我先離開了。或許只有期待奇蹟了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590116
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730590116,
					"content": "奇蹟不能去理解，不能去追求，只能等待呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590117
					],
					"speakerTitle": "海亞姆"
				},
				{
					"id": 730590117,
					"content": "海亞姆蹣跚著離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730590112,
					"content": "他們不記得你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730590113
					]
				},
				{
					"id": 730590113,
					"content": "但是…我們還可以和他們重新交朋友呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730590114
					],
					"speakerTitle": "派蒙"
				}
			]
		},
