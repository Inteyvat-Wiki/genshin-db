			},
			"dialogs": [
				{
					"id": 411310201,
					"content": "那裡有很多魔物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310202
					]
				},
				{
					"id": 411310202,
					"content": "#這正是我想要雇傭{F#妳}{M#你}的原因，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊凡諾維奇"
				}
			]
		},
		{
			"id": 4113103,
			"completionStepIds": [
				4113103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊凡諾維奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310301,
					"content": "別人也會想到做這個生意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310302
					]
				},
				{
					"id": 411310302,
					"content": "哦，當然，所以我們才要盡快到那邊去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310303
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310303,
					"content": "#旅行者，如果{F#妳}{M#你}願意，我們盡快出發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310304
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310304,
					"content": "我們在這裡多磨嘴皮子一秒，我說不定就會少賺一摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310305
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310305,
					"content": "…嗚哇…這樣應該沒法說服他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 411310306,
					"content": "如果能讓他知道，這筆生意賺不了錢，或者…隕石真的很危險就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4113104,
			"completionStepIds": [
				4113104
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊凡諾維奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310401,
					"content": "摸到隕石就會昏睡過去…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310402
					]
				},
				{
					"id": 411310402,
					"content": "嗯？啊…我倒是對這傳聞有所耳聞，這可是個問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310403
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310403,
					"content": "但是，我相信一定有器械能解決這個問題，呃…應該有吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310404
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310404,
					"content": "…哎，他好像有點動搖了，難道…是在權衡做這筆生意的成本嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310405
					],
					"speakerTitle": "派蒙"
				},
				{
