	"talks": [
		{
			"id": 4113101,
			"completionStepIds": [
				4113122
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4113101",
							"2"
						],
						"stepId": 4113101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"伊凡諾維奇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411310101,
					"content": "嗯…不錯，這生意準能大賺一筆。但是還有個小問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310102
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310102,
					"content": "什麼問題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310103
					]
				},
				{
					"id": 411310103,
					"content": "#嗯？哦…旅行者，是{F#妳}{M#你}啊，{F#妳}{M#你}來得正好！{F#妳}{M#你}有興趣參與一場…一場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310107
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310107,
					"content": "一場…神奇的…偉大的…前所未有，必定能大賺特賺的生意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310108
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310108,
					"content": "#只需要{F#妳}{M#你}幫我一個小小的忙。我們倆必然都能賺得盆滿缽滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310104,
						411310109
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310104,
					"content": "北國銀行守衛森嚴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310105
					]
				},
				{
					"id": 411310105,
					"content": "啊，那是當然，連守衛都是至冬國人，我…不！不，您在想什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310106,
					"content": "看來四處旅行確實讓您的思維開闊了不少，您的想法實在是頗富想像力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310112
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310112,
					"content": "但我這次的生意計畫，絕對是腳踏實地的紮實計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310113
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310113,
					"content": "您知道最近從天而降的那些隕石嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310114
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310114,
					"content": "我想要去找到一塊隕石，從上面敲下來幾塊帶回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310115
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310115,
					"content": "然後，再找個能工巧匠，將它雕刻琢磨，製成首飾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310116
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310116,
					"content": "一副由隕石製成的首飾…無論是戒指、項鍊、手環還是耳環，肯定能讓那些有錢人們爽快掏錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310117
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310117,
					"content": "#旅行者，{F#妳}{M#你}要做的事很簡單，只要保證我不受怪物干擾就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310118
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310118,
					"content": "怎麼樣，我們倆就此成交？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310119
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310119,
					"content": "絕不能接近隕石。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310120
					]
				},
				{
					"id": 411310120,
					"content": "什麼？為什麼，這筆大生意我絕不會放過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310109,
					"content": "法典裡有什麼新發現？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411310110
					]
				},
				{
					"id": 411310110,
					"content": "唔，老實說，璃月的法典頗為嚴謹，幾乎沒有漏洞，但…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310111
					],
					"speakerTitle": "伊凡諾維奇"
				},
				{
					"id": 411310111,
					"content": "呃，不！不，我做的事，絕對是在法典允許的範圍內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411310106
					],
					"speakerTitle": "伊凡諾維奇"
				}
			]
		},
		{
			"id": 4113102,
