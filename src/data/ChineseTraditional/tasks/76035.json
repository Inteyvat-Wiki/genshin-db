					}
				]
			},
			"dialogs": [
				{
					"id": 760350101,
					"content": "（哥倫比婭…不在嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350102
					]
				},
				{
					"id": 760350102,
					"content": "在找我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350103
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350103,
					"content": "嗚哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350104,
						760350105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350104,
					"content": "嚇我一跳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				},
				{
					"id": 760350106,
					"content": "#感覺到{F#妳}{M#你}來了，就想試試能不能從背後接近{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350107,
					"content": "妳好像很閒欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350108,
					"content": "唔…有嗎？和以前也差不多吧。在「愚人眾」的時候也沒什麼特別要做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350109
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350109,
					"content": "女皇需要的只是「月神」的力量，沒派我出去搶過「神之心」什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350110,
					"content": "那妳平時會做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350111
					]
				},
				{
					"id": 760350111,
					"content": "散散步、看看月亮，偶爾唱唱歌，但後來桑多涅不讓我唱，我就唱得少了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350112,
					"content": "咦？她不喜歡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350113,
					"content": "不是的。她說我唱得很好聽，但那時我加入「愚人眾」不久，她說其他人聽到我唱歌有時會緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350114,
					"content": "說在不知道的人看來，我就像要…使用什麼能力一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350115,
					"content": "原來如此…我大概能理解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350116,
					"content": "啊，還有一個原因。她說自己晚上幾乎都在做研究，白天我唱歌會碰上她補眠的時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350117
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350117,
					"content": "（這才是主要原因吧！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350118
					]
				},
				{
					"id": 760350118,
					"content": "所以，後來我就只在晚上到桑多涅門口去唱歌。但還是被她趕走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350119
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350119,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350120,
					"content": "妳和其他人相處得好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350121
					]
				},
				{
					"id": 760350121,
					"content": "「相處」嗎…唔…剛認識的時候，阿蕾奇諾似乎很想和我「相處」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350122,
					"content": "她總是悄悄出現在我後面，就像剛才那樣。說是想…「試探」一下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350123
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350123,
					"content": "我也試著和她玩一樣的遊戲，但她總在我還離很遠的時候就轉過頭來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350124
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350124,
					"content": "直到有一次我不得不利用「月亮」的力量，才總算突然到她身後嚇了她一跳。但那之後她就不和我玩這遊戲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350125
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350125,
					"content": "（「僕人」恐怕一開始就沒想過這是「遊戲」吧…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350126,
					"content": "「博士」也經常叫我去配合他做一些有關「光界力」的研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350127
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350127,
					"content": "我去過幾次，但不是用月矩力打打這個，就是用月矩力操縱那個。很無聊，後來就沒去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350128,
						760350129
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350128,
					"content": "看來妳今天心情不錯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350130,
					"content": "嗯，雖說是「離家出走」，但過去也有些愉快的回憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350131
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350131,
					"content": "阿蕾奇諾和桑多涅對我都不錯，還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350132
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350132,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350133
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350133,
					"content": "（她的表情…是想起了誰…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350134
					]
				},
				{
					"id": 760350134,
					"content": "把手給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350135,
						760350136
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350135,
					"content": "…欸？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350137,
					"content": "我想起羅莎琳教過我…要記得對別人表示感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350138
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350138,
					"content": "#謝謝{F#妳}{M#你}今天來聽我說這些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350139
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350139,
					"content": "這沒什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350140
					]
				},
				{
					"id": 760350140,
					"content": "（這是…月神的賜福？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350141
					]
				},
				{
					"id": 760350141,
					"content": "今天就聊到這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350142
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760350142,
					"content": "結束得好突然！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760350143,
						760350144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350143,
					"content": "噓…派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350145,
					"content": "好吧，你說得對，那今天就先不打擾她了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760350144,
					"content": "她可能想起了一些往事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350145
					]
				},
				{
					"id": 760350136,
					"content": "…為什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350137
					]
				},
				{
					"id": 760350129,
					"content": "聊了很多以前的話題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350130
					]
				},
				{
					"id": 760350105,
					"content": "為什麼要從背後出現…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760350106
					]
				}
			]
		}
	]
}