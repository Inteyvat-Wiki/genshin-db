			"dialogs": [
				{
					"id": 200120301,
					"content": "#太感謝{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120302
					],
					"speakerTitle": "驚慌的米拉娜"
				},
				{
					"id": 200120302,
					"content": "但請你別和人說我在這遇見麻煩了。不然我肯定又要被我丈夫嘮叨個不停了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120303
					],
					"speakerTitle": "驚慌的米拉娜"
				},
				{
					"id": 200120303,
					"content": "#別用這種眼神看著我，等{F#妳}{M#你}結了婚就知道，連獨自散步都是奢侈的娛樂，所以必須把握每分每秒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120304
					],
					"speakerTitle": "驚慌的米拉娜"
				},
				{
					"id": 200120304,
					"content": "#喏，這個給{F#妳}{M#你}，我在路上採了一些，自己做飯可比叫獵鹿人的餐便宜多了。過日子就要這樣精打細算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "驚慌的米拉娜"
				}
