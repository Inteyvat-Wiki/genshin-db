			"dialogs": [
				{
					"id": 200120201,
					"content": "#謝謝{F#妳}{M#你}，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120202
					],
					"speakerTitle": "驚慌的米拉娜"
				},
				{
					"id": 200120202,
					"content": "唉，怪物和路障…平時在家裡就忙個不停，散個步也能遇見這種倒楣事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120203
					],
					"speakerTitle": "驚慌的米拉娜"
				},
				{
					"id": 200120203,
					"content": "抱歉，能請您幫我把這個路障也一併清理了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200120204,
						200120205
					],
					"speakerTitle": "驚慌的米拉娜"
				},
				{
					"id": 200120204,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120206
					]
				},
				{
					"id": 200120206,
					"content": "謝謝您，希望我的兩個孩子能和您一樣，有個好品德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "驚慌的米拉娜"
				},
				{
					"id": 200120205,
					"content": "還有別的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200120207
					]
				},
				{
					"id": 200120207,
					"content": "哎呀，只是一點舉手之勞，不會花您太長時間的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "驚慌的米拉娜"
				}
			]
		},
