			"dialogs": [
				{
					"id": 751770101,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770102
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770102,
					"content": "#哎呀，{REALNAME[ID(2)|SHOWHOST(true)]}你是從哪裡弄來的這個留影機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770103,
					"content": "不會是趁著別人不注意…這樣可不行哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770104,
					"content": "嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770105,
					"content": "嗯…呀！呀！呱呀……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770106,
						751770108
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770106,
					"content": "很熟悉的動作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770107
					]
				},
				{
					"id": 751770107,
					"content": "哦哦，這不是「大燉肉火焰」嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770110,
					"content": "嘿嘿，是在「回聲之子」那時候，有個想要當導演卻放反了留影機的部族人…啊！留影機是從他那借來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770111,
					"content": "呀！嗯…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770112
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770112,
					"content": "你想要跟我們一起拍一張畫片，嘿嘿，是這個意思吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770113,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770114
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770114,
					"content": "是哦，一起冒險了那麼久，還沒有一起拍畫片留念呢，小傢伙身上的詛咒已經去除，可以健康長大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770115,
					"content": "#不知道長成大嵴鋒龍要多久，如果明天一下子就變成大嵴鋒龍了，那不是再也見不到{REALNAME[ID(2)|SHOWHOST(true)]}還是小龍的樣子了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770116,
						751770118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770116,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770117
					]
				},
				{
					"id": 751770117,
					"content": "嘿嘿，就來拍一張嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770119,
					"content": "調整好了，大概是這樣，檢查過了，我可沒有弄反！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770120,
					"content": "嗯，那倒數結束就喊「大燉肉火焰」！三、二、一！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770121,
					"content": "「大燉肉火焰」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770122
					]
				},
				{
					"id": 751770122,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770123
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770123,
					"content": "#這樣就拍好啦，{F#妳}{M#你}看，{REALNAME[ID(2)|SHOWHOST(true)]}也很有氣勢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770124,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770125
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770125,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}接過畫片中的其中一張，轉過身去，很小心地放在了堅硬殼下，柔軟的背中。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770126
					]
				},
				{
					"id": 751770126,
					"content": "#不過，{REALNAME[ID(2)|SHOWHOST(true)]}為什麼突然想要拍畫片呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770127,
					"content": "波嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770128
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770128,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770129
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770129,
					"content": "嗚呀…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770130
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770130,
					"content": "#咦，怎麼了，{REALNAME[ID(2)|SHOWHOST(true)]}，是哪裡不舒服嗎，看起來不太開心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770131,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770132
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770132,
					"content": "#{REALNAME[ID(2)|SHOWHOST(true)]}…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770133
					]
				},
				{
					"id": 751770133,
					"content": "想要開始屬於自己的冒險了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770134
					]
				},
				{
					"id": 751770134,
					"content": "欸，什麼，自己的冒險…是、是不想跟我們一起旅行了嗎，嗚，是不是我說了什麼話讓你生氣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770135,
					"content": "我、我以後再也不說你貪吃了，你不要離開我們，好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770136,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770137
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770137,
					"content": "…派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770138
					]
				},
				{
					"id": 751770138,
					"content": "嗚…我知道，我知道的啦…小傢伙總有一天會長大，牠也有、也有自己要去的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770139,
					"content": "可是，就算是這樣，突然說要離開，還是會感到寂寞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770140,
					"content": "沒關係，以後還會見到的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770141
					]
				},
				{
					"id": 751770141,
					"content": "#真的嗎？以後、唔，以後我們需要幫助的時候，{REALNAME[ID(2)|SHOWHOST(true)]}可要趕過來哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770142,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770143
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770143,
					"content": "#那以後，{REALNAME[ID(2)|SHOWHOST(true)]}的冒險要是遇到了難題，也得立刻來找我們，不許逞強！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770144,
					"content": "呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770145
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770145,
					"content": "…還有，平時不要吃得太多了，遇到打不過的大傢伙就要及時逃跑。雖然說不能吃太多，但是該吃的燉肉也要吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770146,
					"content": "然後，最最最最，最重要的就是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770147,
					"content": "要好好長大…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770148
					]
				},
				{
					"id": 751770148,
					"content": "對，要好好長大！起碼要長成三座山大小那麼大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770149,
					"content": "呀！呀！呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770150
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751770150,
					"content": "就是…嗚，就得有這樣的氣勢！一定、一定要記得我們呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751770151,
					"content": "#在靜謐的林中，你們一同享用了告別的火焰燉肉，而後，整理起了這片偶爾前來的營地。\\n{F#妳}{M#你}為今後將要獨自前行的夥伴整理一路上的紀念品，你們想起這段旅途上發生的所有事，堵住洞口的匿葉龍、海畔邊的膨膨獸，和在納塔遇到的許多個性各異的人們…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770152
					]
				},
				{
					"id": 751770152,
					"content": "還有…還有那個憑藉古怪金文說話的傢伙…\\n派蒙說：「那個傢伙就是在利用我們嘛，從頭到尾也沒露過面。」\\n這讓你回想起在圖蘭聖山之底時，一度成長的幼龍眼中曾流露過的複雜的情緒。\\n…現在牠仍然幼小，但總有一天會變成那樣了不起的大龍吧。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770153
					]
				},
				{
					"id": 751770153,
					"content": "#最後的最後，牠輕輕用角牴觸派蒙的額心，又蹭蹭{F#妳}{M#你}伸出的手掌。\\n然後，像是要勸自己下定決心那樣——",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						751770154
					]
				},
				{
					"id": 751770154,
					"content": "幼小的龍堅決地轉身離開了。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 751770118,
					"content": "嗯，來拍吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770119
					]
				},
				{
					"id": 751770108,
					"content": "是「大燉肉火焰」！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751770109
					]
				},
				{
					"id": 751770109,
					"content": "#哦哦，{F#妳}{M#你}這麼一說，我就有點印象了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751770110
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}