			},
			"dialogs": [
				{
					"id": 3720501,
					"content": "欸——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720502,
					"content": "#{F#妳}{M#你}，真的擁有不可思議的力量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720503
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720503,
					"content": "#像{F#妳}{M#你}這樣的人，註定要登上吟遊詩人們傳唱的詩篇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720504
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720504,
					"content": "站在向陽處必能成就英雄，站在背陰處亦可引導災禍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720505
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720505,
					"content": "#啊…但我現在沒有時間為{F#妳}{M#你}譜寫新曲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720506
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720506,
					"content": "特瓦林就算不被討伐，生命力也會飛速流逝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720507
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720508,
					"content": "我也同情特瓦林。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720509
					]
				},
				{
					"id": 3720511,
					"content": "有什麼我能幫忙的地方嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720512
					]
				},
				{
					"id": 3720514,
					"content": "作為騎士，我勸你和龍一起自首。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720515
					]
				},
				{
					"id": 3720507,
					"content": "他會在憤怒中把自己燃盡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720508,
						3720511,
						3720514
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720509,
					"content": "#謝謝{F#妳}{M#你}的心意，也謝謝{F#妳}{M#你}幫我淨化淚滴結晶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720510
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720510,
					"content": "接下來就是我行動的時間了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720512,
					"content": "淨化淚滴結晶已經是幫忙了，我很感激。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720513
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720513,
					"content": "但現在，我已經有了一個自己的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720515,
					"content": "哇，不要這麼絕情嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720516
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720516,
					"content": "自首就先不必了…我有另外的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720517
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720517,
					"content": "嗯？你的計畫是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720518,
					"content": "看到龍的淚滴，我想起了一位故人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720519
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720519,
					"content": "故人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720520,
					"content": "嘿嘿，那我就先失陪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720521
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720521,
					"content": "喂，你要去哪裡呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720522
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720522,
					"content": "——去「蒙德英雄的象徵」。再見啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720523
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720524,
					"content": "是個奇怪的人，需要觀察一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720525
					]
				},
				{
					"id": 3720523,
					"content": "#唔…{NICKNAME}，{F#妳}{M#你}怎麼看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720524
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720526,
					"content": "而且…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720527
					]
				},
				{
					"id": 3720525,
					"content": "#對他來說，{F#妳}{M#你}也是奇怪的人呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720526
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720528,
					"content": "聲音，有些熟悉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 3720527,
					"content": "而且？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720528
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}