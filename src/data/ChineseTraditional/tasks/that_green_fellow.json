			},
			"dialogs": [
				{
					"id": 3720101,
					"content": "啊，你們是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720102
					],
					"speakerTitle": "綠色的傢伙"
				},
				{
					"id": 3720102,
					"content": "喔…呀！是那個時候，把特瓦林嚇跑的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720103
					],
					"speakerTitle": "綠色的傢伙"
				},
				{
					"id": 3720103,
					"content": "特瓦林？誰啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720104,
						3720105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720104,
					"content": "是風魔龍的真名。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				},
				{
					"id": 3720106,
					"content": "唔…哦！我想起來了。可是一般人不是都叫牠「風魔龍」嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720107,
					"content": "為什麼你要這樣稱呼牠…難道你們很熟嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720108,
					"content": "妳猜~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720109
					],
					"speakerTitle": "綠色的傢伙"
				},
				{
					"id": 3720109,
					"content": "#喂，{NICKNAME}，我感覺這個人怪怪的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720110,
						3720112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720110,
					"content": "你好，打擾了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720111
					]
				},
				{
					"id": 3720111,
					"content": "#{F#妳}{M#你}好，一面之緣的異鄉人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720113
					],
					"speakerTitle": "綠色的傢伙"
				},
				{
					"id": 3720113,
					"content": "我是吟遊詩人，溫迪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720114
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720114,
					"content": "準確地說，是連續三屆「蒙德城最受喜愛吟遊詩人」的蟬聯冠軍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720115
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720115,
					"content": "#{F#妳}{M#你}們找我有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720116
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720116,
					"content": "既然你都認出我們了，那就不用多解釋了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720117,
					"content": "當然是關於風魔龍的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720118,
					"content": "嗯~~？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720119
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720119,
					"content": "喂！不用這樣突然裝失憶吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720120,
					"content": "#{NICKNAME}，可以把那個拿出來給他看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720121,
					"content": "喔！這是——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720122
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720122,
					"content": "咦？結晶被淨化了？什麼時候的事情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720123,
						3720124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720123,
					"content": "不知怎麼就變成這樣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720125,
					"content": "這是特瓦林牠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720126
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720126,
					"content": "這是風魔龍因為痛苦流出的眼淚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3720127
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3720127,
					"content": "眼…淚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3720124,
					"content": "上一次看還是充滿雜質的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720125
					]
				},
				{
					"id": 3720112,
					"content": "請問你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720113
					]
				},
				{
					"id": 3720105,
					"content": "妳忘了嗎？麗莎說的那些話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3720106
					]
				}
			]
		},
		{
			"id": 3720301,
