			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"布洛克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000701,
					"content": "#啊，{F#妳}{M#你}們來了嗎，獸肉準備得怎麼樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000702
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000702,
					"content": "已經帶來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000703
					]
				},
				{
					"id": 708000703,
					"content": "嗯，我來看看…確實很新鮮，這樣應該就可以了。主料就用這些獸肉，再準備一點有「風的味道」的佐料就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000704
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000704,
					"content": "唔，說到帶有「風的味道」的佐料…那當然就是「蒲公英籽」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000705
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000705,
					"content": "#旅行者，{F#妳}{M#你}能幫我去收集一點蒲公英籽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000706
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000706,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000707
					]
				},
				{
					"id": 708000707,
					"content": "#那就麻煩{F#妳}{M#你}了，我先去處理一下獸肉，搜集好蒲公英籽之後，就直接拿來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布洛克"
				}
			]
		},
