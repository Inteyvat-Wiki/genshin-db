			"trigger": {
				"objectNames": [
					"布洛克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000201,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000202
					]
				},
				{
					"id": 708000202,
					"content": "其實我正打算配合風花節開發一道新菜，主打「風的味道」，現在正在準備食材呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000203
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000203,
					"content": "不過，我明明拜託了艾倫幫我去明冠峽獵最新鮮的肉，怎麼這麼久了他還沒回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000204
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000204,
					"content": "#再拖下去，說不定那些食材都不新鮮了，旅行者，能拜託{F#妳}{M#你}去明冠峽那邊看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000205
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000205,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000206
					]
				},
				{
					"id": 708000206,
					"content": "#那就辛苦{F#妳}{M#你}了，晚點再請{F#妳}{M#你}嚐嚐我的最新菜品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布洛克"
				}
			]
		},
		{
			"id": 7080006,
			"completionStepIds": [
				7080006
			],
			"beginWay": "TALK_BEGIN_MANUAL",
