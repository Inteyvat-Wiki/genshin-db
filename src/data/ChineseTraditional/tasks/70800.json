			},
			"dialogs": [
				{
					"id": 708000901,
					"content": "謝謝，這下材料就都準備好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000902
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000902,
					"content": "#辛苦{F#妳}{M#你}了，這些東西請{F#妳}{M#你}收下吧，就算是報酬了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000903
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000903,
					"content": "不過要怎麼處理，才能讓整道菜都帶上「風的味道」呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000904
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708000904,
					"content": "蒸煮煎炸…唔…不然，還是以食材的原味為主，在整道菜出鍋之後再把蒲公英籽撒上去吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布洛克"
				}
			]
