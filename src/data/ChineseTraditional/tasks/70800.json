			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾倫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708000601,
					"content": "得，得救了…真是太謝謝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000602
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 708000602,
					"content": "真沒想到，就是獵個林豬也能這麼麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000603
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 708000603,
					"content": "關於布洛克要的食材…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708000604
					]
				},
				{
					"id": 708000604,
					"content": "#是布洛克派{F#妳}{M#你}來的？啊…其實她要的新鮮獸肉，我已經弄到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000605
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 708000605,
					"content": "不過我追林豬的時候太大意，一不小心就驚動了附近的魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000606
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 708000606,
					"content": "雖然林豬是獵到了，但我也被魔物們圍住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000607
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 708000607,
					"content": "#旅行者，能拜託{F#妳}{M#你}把這些肉送給布洛克嗎，我要先去城裡，拜託教會治療我的傷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708000608
					],
					"speakerTitle": "艾倫"
				},
				{
					"id": 708000608,
					"content": "唉，又搞成這個樣子，杜拉夫先生一定又要唸我了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾倫"
				}
			]
		},
		{
			"id": 7080007,
			"completionStepIds": [
				7080007
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
