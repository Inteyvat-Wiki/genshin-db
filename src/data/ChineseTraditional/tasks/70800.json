					"id": 708001101,
					"content": "冷，冷…怎麼這麼冷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001102
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001102,
					"content": "誰，誰…誰能幫忙生一下火嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "害怕的舒特"
				}
			]
		},
		{
			"id": 7080013,
