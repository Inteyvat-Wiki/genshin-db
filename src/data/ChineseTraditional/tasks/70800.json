			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"害怕的舒特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708001301,
					"content": "活，活過來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001302
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001302,
					"content": "#是{F#妳}{M#你}生的火嗎…好心的旅行者…謝謝{F#妳}{M#你}，多謝{F#妳}{M#你}了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001303
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001303,
					"content": "你還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001304
					]
				},
				{
					"id": 708001304,
					"content": "現在暖和一點了，還好…還好…我本來是接到委託，進雪山取那種「冷鮮肉」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001305
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001305,
					"content": "我一開始只是想在雪山周邊找找看就好，但是走著走著不小心弄丟了火種，又不小心迷了路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001306
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001306,
					"content": "#要是沒有{F#妳}{M#你}，我都不知道怎麼辦才好了，多謝{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001307
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001307,
					"content": "關於布洛克的委託…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001308
					]
				},
				{
					"id": 708001308,
					"content": "#是布洛克拜託{F#妳}{M#你}找我的，唉…她一定已經等到很著急了。但我實在沒體力把這份肉再大老遠送回鎮上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001309
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001309,
					"content": "#雖然很不好意思，但能請{F#妳}{M#你}幫我把這份「冷鮮肉」送過去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001310
					],
					"speakerTitle": "害怕的舒特"
				},
				{
					"id": 708001310,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001311
					]
				},
				{
					"id": 708001311,
					"content": "#多謝{F#妳}{M#你}了。我得回山下的營地去，好好喝口熱湯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "害怕的舒特"
				}
			]
		},
