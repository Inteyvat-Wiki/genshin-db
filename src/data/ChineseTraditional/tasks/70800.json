			},
			"dialogs": [
				{
					"id": 708001501,
					"content": "#{F#妳}{M#你}們回來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001502
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001502,
					"content": "肉已經帶回來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001503
					]
				},
				{
					"id": 708001503,
					"content": "那太好了！欸？舒特呢…他沒碰到危險吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001504
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001504,
					"content": "他應該已經沒事了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001505
					]
				},
				{
					"id": 708001505,
					"content": "那就好，幸好沒有出大事…等我把新菜做好了之後，也帶過去給他嚐嚐吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001506
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001506,
					"content": "話說回來，這「冷鮮肉」看起來確實和普通肉類不一樣，用這個做材料，說不定真能做出那種有「劈咔」感的菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001507
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001507,
					"content": "不過，要想讓菜帶有「風的味道」的話，還需要蒲公英籽來當佐料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001508
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001508,
					"content": "但如果只是這樣的話，感覺跟普通的肉類菜餚也沒有很大區別，還少一種決定性的佐料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001509
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001509,
					"content": "對了，對了！在那場對決之後，其實我還見過幾次香菱，還從她那裡聽到了一道叫做「史萊姆滑蘑菇」的菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001510
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001510,
					"content": "這種新奇的材料，我還從來沒用過…不過，想要做出新奇的菜，就要嘗試新奇的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001511
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001511,
					"content": "#旅行者，那就拜託{F#妳}{M#你}幫我去找一份史萊姆凝液和一份蒲公英籽吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708001512
					],
					"speakerTitle": "布洛克"
				},
				{
					"id": 708001512,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708001513
					]
				},
				{
					"id": 708001513,
					"content": "#嗯，那就拜託{F#妳}{M#你}了，我在這裡再思考一下我的那份食譜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布洛克"
				}
			]
		},
