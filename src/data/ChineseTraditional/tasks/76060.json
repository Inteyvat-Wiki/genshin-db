			"dialogs": [
				{
					"id": 760600301,
					"content": "好，就這些吧。梅拉覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600302,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600303
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760600303,
					"content": "它看起來滿滿意的。嘿嘿…這次會是怎樣的一幅畫呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600304,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600305
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760600305,
					"content": "咦？已經畫好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600307
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760600307,
					"content": "梅拉的樣子，看起來有些傷心呢…是因為畫的關係嗎？我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600308,
					"content": "啊，這次畫的也是哥倫比婭呢，這是在…月光下散步嗎？畫中的你還抬頭望著夜空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600309,
					"content": "我大概…是在看虛假之天外的那輪月亮吧。以前經常這麼在晚上散步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600310
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600310,
					"content": "以前？啊…這麼說來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600311,
					"content": "（現在的哥倫比婭幾乎只能待在這處庭園裡…明明挪德卡萊是她誕生的地方…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600312
					]
				},
				{
					"id": 760600312,
					"content": "以前散步的時候就會想，那個真實的「霜月」上究竟有些什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600313
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600313,
					"content": "會不會也像這邊一樣，有很多小動物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600314
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600314,
					"content": "還是說，其實什麼都沒有呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600315
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600315,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600316,
						760600319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600316,
					"content": "不如帶一些上去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600317
					]
				},
				{
					"id": 760600317,
					"content": "哈，你的想法很有趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600318
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600318,
					"content": "不過…月亮在虛假之天外，或許還是不要讓這裡的小動物們陪我一起去冒險比較好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600322,
					"content": "（一邊是無法自由行動的「家」…一邊是不知道有什麼的「家」…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600323
					]
				},
				{
					"id": 760600323,
					"content": "（……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600324
					]
				},
				{
					"id": 760600324,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600325
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760600325,
					"content": "梅拉一定也很捨不得你走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600326,
					"content": "我也捨不得它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600327
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600327,
					"content": "但這終究是我一個人的旅行。是需要我獨自去尋找的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600328
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600328,
					"content": "說不定，這個答案其實很美好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600329
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600329,
					"content": "那，那到時候我們就帶著梅拉一起去看望你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600330,
					"content": "好啊，辦一個月亮上的畫展。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600331
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600331,
					"content": "哇，聽起來就不錯！說好了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600332,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600333
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600333,
					"content": "希望如此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600319,
					"content": "說不定有其他可愛的生靈。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600320
					]
				},
				{
					"id": 760600320,
					"content": "唔，希望如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600321
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600321,
					"content": "也希望它們歡迎我這個突然回家的「神明」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600322
					],
					"speakerTitle": "「少女」"
				}
			]
		},
