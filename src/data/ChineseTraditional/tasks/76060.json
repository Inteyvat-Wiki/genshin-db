			"dialogs": [
				{
					"id": 760600101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600102
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760600102,
					"content": "咦？這不是梅拉嗎？它又出去取材了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600103,
					"content": "嗯，但它回來後就一直這樣，像是在思考什麼一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600104,
					"content": "說不定這次的主題比較深刻呢，就像大畫家突然頓悟了世間真理什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600105,
					"content": "說起來，梅拉已經給過我們好多幅畫了呢。要是再這麼畫下去的話，都可以為它專門辦個畫展了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600106,
					"content": "哼哼，到時候就由我來為人們講述大畫家梅拉的創作歷程。當然，真的要辦畫展的話，也得哥倫比婭同意才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600107,
					"content": "嗯？為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600108,
					"content": "梅拉畫的幾乎都是妳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760600109
					]
				},
				{
					"id": 760600109,
					"content": "哦，沒事，我不介意。聽起來滿有趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760600110,
					"content": "~！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600111
					],
					"speakerTitle": "梅拉"
				},
				{
					"id": 760600111,
					"content": "哦！梅拉好像決定要畫什麼了！快快快，看看我們有什麼適合的顏料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760600112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760600112,
					"content": "這次的話…就選一些比較深沉、靜謐的顏色吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
