				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150301,
					"content": "想不到這麼巨大，不愧是仙人留下的造物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150302,
					"content": "可是，這東西要怎麼用呀，需要多大的力氣才能操縱呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150303,
					"content": "現在是操縱不了的，因為壞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150304
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150304,
					"content": "居然…壞了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150305,
					"content": "畢竟歷經了千年的風霜，再是仙家機關，也很難維持原樣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150306
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150306,
					"content": "那我們可怎麼辦？鍾離先生，快用你那無盡的「上流社會知識」想想辦法呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150307,
					"content": "唔。怎麼把我說得像是…除了聽戲遛鳥，別的什麼都不會的紈絝子弟一樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150308
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150308,
					"content": "我想想…嗯，其實「歸終機」建設之初，為了應對戰損之類情況，是準備了備用材料的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150309
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150309,
					"content": "若沒猜錯，在這「古城垣」之中，一定可以尋到當年的戰備室。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150310
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150310,
					"content": "有了戰備室裡儲存的材料，只要知道「歸終機」的運作原理，想要修理也並非難事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150311
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150311,
					"content": "這麼說…鍾離先生是知道原理的囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150312,
					"content": "略知一二。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150313
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150313,
					"content": "只要收集了<color=#00E1FFFF>足夠的材料</color>，就可以稍稍嘗試一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鍾離"
				}
			]
		},
		{
			"id": 101506,
			"completionStepIds": [
				101515
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101506",
							"2"
						],
						"stepId": 101506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150601,
					"content": "嗯，這些備用材料應該可以派上用場了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150602
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150602,
					"content": "請二位稍等，我來嘗試修理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150603
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150603,
					"content": "完成了。「歸終機」的結構，比我預想的還要精密一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150604
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150604,
					"content": "唔哇，然後要怎麼讓它動起來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150605,
					"content": "很簡單，只要這樣…看，仙家的機關，居然還自帶「望遠」之效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150617
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150617,
					"content": "這裡…沒有…那裡也沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150606,
					"content": "喂！你們幾個在搞什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150607
					],
					"speakerTitle": "黃麻子"
				},
				{
					"id": 10150607,
					"content": "這是…這大弩槍，被你們給收拾好了？你們亂動這東西幹什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150608
					],
					"speakerTitle": "黃麻子"
				},
				{
					"id": 10150608,
					"content": "不是什麼弩槍，是「歸終機」。還有——在提問前，先報上自家姓名。這是禮儀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150609
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150609,
					"content": "看不出來嗎？哼，我們可是盜寶團的大佬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150610
					],
					"speakerTitle": "黃麻子"
				},
				{
					"id": 10150610,
					"content": "傳說這一帶埋藏著各種寶貝，但這大弩槍雖然是個機器，卻又好像是這一帶的看守一樣，非常難搞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150611
					],
					"speakerTitle": "黃麻子"
				},
				{
					"id": 10150611,
					"content": "上次我們進山，有個兄弟差點被它穿成了串…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150612
					],
					"speakerTitle": "黃麻子"
				},
				{
					"id": 10150612,
					"content": "後來是我們幾個冒著性命危險，才把這大傢伙弄壞了的——可一轉頭，你們居然又把它修好了！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150613
					],
					"speakerTitle": "黃麻子"
				},
				{
					"id": 10150613,
					"content": "我看今天，真得把你們好好修理修理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150614
					],
					"speakerTitle": "黃麻子"
				},
				{
					"id": 10150614,
					"content": "哼。為了一己私欲，玷汙仙人智慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150615
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150615,
					"content": "你們，更應該得到些教訓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150616
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150616,
					"content": "#說得對！{NICKNAME}，我們上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 101507,
			"completionStepIds": [
				101507
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101507",
							"2"
						],
						"stepId": 101507,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"七七"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150701,
					"content": "抱歉，恕我們未能完成「契約」。名為「椰羊」的半仙之獸…我們實在沒有頭緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150702
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150702,
					"content": "啊。很失望。雖然沒關係，但是很失望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150703
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150703,
					"content": "嗚——看到七七這樣，為什麼我突然有一種超級強烈的愧疚感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150704,
						10150705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150704,
					"content": "七七，還有什麼別的線索嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				},
				{
					"id": 10150706,
					"content": "嗯…「椰羊」的奶，好喝。比一般的羊奶，好喝。所以它們，一定是半仙之獸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150707
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150707,
					"content": "對不起。我的記憶力，不好。所以我，把那種奶的名字，寫下來…我，找找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150708
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150708,
					"content": "啊，對了，就是這個，好喝的奶……叫「椰奶」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150709
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150709,
					"content": "嗯？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150710,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150711
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150711,
					"content": "對不起，二位。此前為與七七公平對等，我不經思考，答應得太過輕易…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150712
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150712,
					"content": "嗯，沒關係，鍾離。用璃月的話說「世事無常，悲喜難料」，誰又知道結局會這麼荒唐呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150713
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150713,
					"content": "咦…七七，說了什麼，錯誤的話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150714
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150714,
					"content": "#{NICKNAME}，不好意思，打破小孩子幻想的事可以交給{F#妳}{M#你}來做嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150715,
						10150716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150715,
					"content": "椰奶，不是椰羊產的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150717,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150718
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150718,
					"content": "七七好像陷入了思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150719,
						10150720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150719,
					"content": "我們不要打擾她了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150721,
					"content": "哈哈，真是有意義的一堂人生課啊，多謝你們照顧我家的七七了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150722
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150722,
					"content": "閣下是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150723
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150723,
					"content": "失禮失禮。我是這家「不卜廬」的老闆，白朮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150724
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150724,
					"content": "原來老闆不是七七啊——而且是個在脖子上掛了藥材的怪人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150725
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150725,
					"content": "真可憐。七七已經夠單純了，但居然還有比七七更單純的受騙者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150726
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150726,
					"content": "啊！那個藥材…那條蛇，說、說說說說話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150727,
						10150728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150727,
					"content": "蛇說話了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150729,
					"content": "哼，我本不想開口。熟客還行，生客的話就難免會受些驚嚇。可再不說話，就要被你們拿來跟抽屜裡的那些蛇乾相提並論了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150730
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150730,
					"content": "哈哈哈…這位是「長生」，她沒有惡意。請問幾位，撇開陪七七胡鬧不談…原本來此，有何貴幹呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150731
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150731,
					"content": "請問貴店，有沒有「永生香」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150732
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150732,
					"content": "哦，「永生香」啊，當然有，當然有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150733
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150733,
					"content": "呼…太好了，總算是沒有白忙活半天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150734
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150734,
					"content": "三百萬摩拉，品質上等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150735,
						10150737
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150735,
					"content": "三百萬？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150736
					]
				},
				{
					"id": 10150736,
					"content": "你去搶「黃金屋」吧！嗯…不過「黃金屋」現在被七星徵用，大概會比平常更難搶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150739,
					"content": "嗯…三百萬…乍一聽也沒什麼，但以普遍理性而論，確實有些難辦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150740
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150740,
					"content": "這麼多摩拉！我們是不可能付得起的！——鍾離先生就更不用說了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150741
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150741,
					"content": "確實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150742
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150742,
					"content": "真乾脆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150743
					]
				},
				{
					"id": 10150743,
					"content": "怎麼辦…唉，這次，也只能再找公子求助了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150744
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150744,
					"content": "哈哈哈哈哈哈哈哈哈——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150745
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150745,
					"content": "椰羊…椰羊！太好玩了，你們居然被這種東西耍了一通！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150746
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150746,
					"content": "別幸災樂禍！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150747
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150747,
					"content": "哎，真是眼淚都要笑出來了。好吧，為了感謝你們讓我這麼開心，我來解決所有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150748
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150748,
					"content": "這位…白朮老闆，對吧？我是「愚人眾」的執行官，「公子」。不嫌棄的話，我們未來可以多多合作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150749
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150749,
					"content": "若「不卜廬」有需要，愚人眾可以幫忙建立椰奶的快速供貨管道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150750
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150750,
					"content": "嗯？早就聽說愚人眾會拉攏「道上朋友」，但「不卜廬」是只用椰奶就能收買的嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150751
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150751,
					"content": "椰奶，椰奶。白先生，椰奶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150752
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150752,
					"content": "好好好…那就多謝「公子」先生了，祝我們未來合作愉快。這「永生香」也打個折，算你們兩百九十九萬吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150753
					],
					"speakerTitle": "白朮"
				},
				{
					"id": 10150753,
					"content": "三百萬和兩百九十九萬有什麼區別嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150754
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150754,
					"content": "嗯…兩百九十九萬…乍一聽也沒什麼，但以普遍理性而論，確實比三百萬少了一萬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150755
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150755,
					"content": "好了，既然事情都解決了，我們也該回玉京臺了。「公子」先生、白朮老闆、七七小朋友，後會有期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150756
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150756,
					"content": "真是一群有趣的人，好久沒這麼笑過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150757
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150757,
					"content": "那麼，在我來這裡之前…早已潛伏的妳，有「聽見」什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150758
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150758,
					"content": "是，「公子」大人。他們提到，「黃金屋」被七星…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150759
					],
					"speakerTitle": "葉卡捷琳娜"
				},
				{
					"id": 10150759,
					"content": "原來如此，原來如此。呵，凝光，還有七星。你們想要隱匿在黃金屋的…除了「仙祖法蛻」，還能是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150760
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150760,
					"content": "#對不起了，{NICKNAME}。但我早就告誡過{F#妳}{M#你}吧？須知璃月古諺：「隔牆有耳」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 10150737,
					"content": "你去搶「黃金屋」吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150738
					]
				},
				{
					"id": 10150738,
					"content": "不過「黃金屋」現在被七星徵用，大概會比平常更難搶吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150739
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150728,
					"content": "這裡是璃月，沒什麼奇怪的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150729
					]
				},
				{
					"id": 10150720,
					"content": "孩子的成長就是在這種時刻吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150721
					]
				},
				{
					"id": 10150716,
					"content": "椰奶的來源，是椰樹。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150717
					]
				},
				{
					"id": 10150705,
					"content": "七七想要「椰羊」做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150706
					]
				}
			]
		},
		{
			"id": 101509,
			"completionStepIds": [
				101509
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"101509",
							"2"
						],
						"stepId": 101509,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"七七"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10150901,
					"content": "原來在這！還沒有櫃檯高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150902,
						10150904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150902,
					"content": "她是…「殭屍」嗎！？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150903
					]
				},
				{
					"id": 10150903,
					"content": "啊…好像是真的！額頭上還貼著符咒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150908,
					"content": "歡迎光臨「不卜廬」，我是七七。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150909
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150909,
					"content": "七七已經，死過一次。後來，被仙人救了。所以是，殭屍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150910,
						10150911
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150910,
					"content": "平淡地說出了不可思議的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150912,
					"content": "在蒙德，這種事就完全無法想像呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150913
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150913,
					"content": "這位…小朋友。敢問店內是否有賣「永生香」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150914
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150914,
					"content": "請問…藥方。有沒有，拿藥方來呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150915
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150915,
					"content": "這…買「永生香」的話，是不需要藥方的吧？和治病沒有關係…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150916
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150916,
					"content": "有藥方的話，七七可以，幫忙抓藥。這是，七七給自己的，「敕令」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150917,
						10150918
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150917,
					"content": "「敕令」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150920
					]
				},
				{
					"id": 10150920,
					"content": "殭屍行動，需要敕令。但這位小朋友，不知為何，是自己給自己下敕令的狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150921
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150921,
					"content": "七七小朋友，我們沒有藥方，但我們希望妳幫忙找來「永生香」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150922
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150922,
					"content": "可以哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150923
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150923,
					"content": "咦？怎麼突然就可以了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150924
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150924,
					"content": "但是，你們也要幫七七的忙，這樣才公平。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150925
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150925,
					"content": "店員給顧客幫忙，原來是不公平的事嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150926
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150926,
					"content": "呵…無妨，這樣對等的關係也不錯。在璃月，交易的藝術就是換位思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150927
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150927,
					"content": "那請你們，到天衡山。用「歸終機」，幫我狩獵「椰羊」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150928,
						10150930
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150928,
					"content": "我聽不太懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150929
					]
				},
				{
					"id": 10150929,
					"content": "歸終機…她剛剛提到的東西，我有所耳聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150932,
					"content": "「歸終機」是遠古仙人在天衡山上架設的一種弩炮，屬於機關術產物的一種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150933
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150933,
					"content": "位置坐落在「天衡古城垣」之間，能夠自行迎擊體格巨大的魔物，防備來自外界的威脅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150934
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150934,
					"content": "鍾離先生真是對璃月瞭若指掌呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150935
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150935,
					"content": "也並非完全如此吧…比如這個「椰羊」，我就確實沒有聽說過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150936
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150936,
					"content": "「椰羊」，是傳說中的，半仙之獸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150937
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150937,
					"content": "欸？就這些嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150938
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150938,
					"content": "嗯。「椰羊」，是傳說中的，半仙之獸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150939
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150939,
					"content": "長什麼樣子，不知道。哪裡最多，不知道。什麼由來，不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150940,
						10150941
					],
					"speakerTitle": "七七"
				},
				{
					"id": 10150940,
					"content": "這就是「一問三不知」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150942,
					"content": "罷了…先去<color=#00E1FFFF>「歸終機」</color>附近看看吧，或許到了那邊就有線索了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150943
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150943,
					"content": "「椰羊」…究竟是什麼樣的生物呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150941,
					"content": "這就麻煩了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150942
					]
				},
				{
					"id": 10150930,
					"content": "該不會是在耍我們…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150931
					]
				},
				{
					"id": 10150931,
					"content": "不是的，她剛提到的東西，我有所耳聞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150932
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150918,
					"content": "感覺很難交流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150919
					]
				},
				{
					"id": 10150919,
					"content": "恐怕如她自己所說，是因為「敕令」的關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150920
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10150911,
					"content": "不愧是「有神之地」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150912
					]
				},
				{
					"id": 10150904,
					"content": "其實論身高的話，派蒙更…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10150905
					]
				},
				{
					"id": 10150905,
					"content": "喂！我是飛著的，所以身高不重要啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150906
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150906,
					"content": "話說回來，她看上去是不是有些奇怪，額頭上還貼著符咒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10150907,
					"content": "莫非是…「殭屍」嗎！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10150908
					],
					"speakerTitle": "派蒙"
				}
			]
		},
