					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10151405,
					"content": "況且，如果是「半仙之獸」的話，憑藉仙人的機關術，應該不難察覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10151406
					],
					"speakerTitle": "鍾離"
