				"points": []
			},
			"dialogs": [
				{
					"id": 414010101,
					"content": "奇了怪了，這架「留影機」是怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010102
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010102,
					"content": "這架「留影機」怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010103
					]
				},
				{
					"id": 414010103,
					"content": "好像是壞了…還是什麼，總之就是不靈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010104
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010104,
					"content": "我之前在楓丹那邊訂了一批「留影機」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010105
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010105,
					"content": "賣「留影機」的人說，這批「留影機」是他們楓丹的最新技術。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010106
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010106,
					"content": "說是可以讓印出來的畫有特殊的色調，帶有特殊的效果什麼的，我就買了一台過來想要試試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010107
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010107,
					"content": "結果不知道是我操作有問題，還是這台「留影機」本身就有問題，怎麼弄都印不出來正常的畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010108
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010108,
					"content": "難道，真是我用這機器的方法有問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010109
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010109,
					"content": "#對了，{F#妳}{M#你}瞭解「留影機」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010110,
						414010112
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010110,
					"content": "還算是瞭解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010111
					]
				},
				{
					"id": 414010111,
					"content": "#那太好了，能請{F#妳}{M#你}幫我個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010114,
					"content": "#看{F#妳}{M#你}的樣子，是旅行者對吧？一定去過很地方，見識也很廣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010115
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010115,
					"content": "#我想請{F#妳}{M#你}幫我用這台「留影機」去拍點「顏色」很強烈的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010116
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010116,
					"content": "拍好了之後，請再把印出來的畫拿給我，我想看看，這「留影機」到底是哪裡出了問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010117
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010117,
					"content": "實在不行，我就拿著這些畫去找那個人問問去。有這些畫做證據，我也不怕他不認帳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010118,
						414010120
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010118,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010119
					]
				},
				{
					"id": 414010119,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414010120,
					"content": "什麼叫做「顏色」很強烈的東西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010121
					]
				},
				{
					"id": 414010121,
					"content": "唔，就是那種…色調特別明顯的，比如紅色的絕雲椒椒啦，藍色的冰霧花啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010122
					],
					"speakerTitle": "季同"
				},
				{
					"id": 414010122,
					"content": "拍好了之後，就請把印出來的畫拿來給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "季同"
				},
				{
					"id": 414010112,
					"content": "沒接觸過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414010113
					]
				},
				{
					"id": 414010113,
					"content": "#唔…倒也沒關係，這東西的操作還算簡單…能請{F#妳}{M#你}幫我個忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414010114
					],
					"speakerTitle": "季同"
				}
			]
		}
	]
}