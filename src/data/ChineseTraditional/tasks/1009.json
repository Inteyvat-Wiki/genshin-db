			"dialogs": [
				{
					"id": 10091501,
					"content": "咦？這裡怎麼有張石桌，上面還擺著這麼多餐具，還有酒壺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091502,
					"content": "這旁邊的椅子上還刻著字呢，「此處居留雲」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091510,
					"content": "「此處坐歸終」，還有「此處借帝君」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091503,
					"content": "「帝君」難道說的是「岩王帝君」？「歸終」…不知道是什麼意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091504,
					"content": "「留雲」…對了，那位削月築陽真君提到的仙人裡，有一位就叫「留雲借風真君」來著！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091505,
					"content": "這麼說來，這裡說不定就是那位「留雲借風真君」和其他仙人聚餐的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091506,
					"content": "嘿嘿，假如真是這樣，那我們做點仙人喜歡的美食，是不是就能引起這位「留雲借風真君」的注意了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091507,
					"content": "不過，仙人到底會想要吃什麼好吃的呢？完全沒有頭緒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091508,
					"content": "沒辦法了，我們去周圍看看吧，希望之前來這裡供奉的人，能留下一點痕跡，當作參考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091509,
					"content": "#對了，{F#妳}{M#你}說…仙人會喜歡吃蜜醬胡蘿蔔煎肉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
