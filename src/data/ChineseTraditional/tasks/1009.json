			},
			"dialogs": [
				{
					"id": 10090201,
					"content": "好像是有人在這裡做過菜，是用來供奉仙人的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090202,
					"content": "這旁邊還有沒用完的食材呢。金魚草…蓮蓬…還有豆腐，這道菜可真複雜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090203,
					"content": "哎，看那裡，好像是…筆記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090204,
					"content": "這麼複雜的菜，也難怪要把做菜的方法用紙記下來…我們仔細看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 100903,
			"completionStepIds": [
				100903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100903",
