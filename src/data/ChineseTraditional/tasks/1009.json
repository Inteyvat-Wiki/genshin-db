			},
			"dialogs": [
				{
					"id": 10090401,
					"content": "這裡好乾淨，應該是在這裡做菜的人細心收拾過了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090402,
					"content": "說不定，正是為了供奉仙人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090403,
					"content": "這些材料是…「松茸」和「獸肉」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090404,
					"content": "菜譜就攤在旁邊，在這裡做菜的人，真的很有條理啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
