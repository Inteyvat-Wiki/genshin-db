			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10090301,
					"content": "嗚哇，好多麵粉都撒在地上了，在這裡做菜的人真馬虎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090302,
					"content": "鍋裡的東西好像是肉…但具體是什麼肉就不知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090303,
					"content": "這道菜，會不會是為了供奉仙人才做的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090304,
					"content": "嗯…要用到「肉類」和「麵粉」的菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090305,
					"content": "咦？地上怎麼丟著一頁紙…呃，還有個佔了半頁的腳印…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10090306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10090306,
					"content": "不過，說不定它和這道菜有關…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 100904,
			"completionStepIds": [
				100904
