			"trigger": {
				"objectNames": [
					"留雲借風真君"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10091401,
					"content": "#居然能闖過洞府，{F#妳}{M#你}們倒是有幾分本事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091402
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091402,
					"content": "#本仙乃是留雲借風真君，{F#妳}{M#你}們所為何事，速速報來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091403,
						10091405
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091403,
					"content": "這個洞府是您自己建的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091404
					]
				},
				{
					"id": 10091404,
					"content": "那是自然，除了洞府之外，那些機關也是本仙自己所建。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091407,
					"content": "本仙的「機關術」，就是連「歸終」和岩王帝君見了，也是要稱讚的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091408
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091408,
					"content": "這麼大的洞府，您就一個人住嗎？而且還有這麼多機關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091409,
					"content": "您是不是為了研究「機關術」，才獨自住在這的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091410,
					"content": "就和傳說裡的一樣，仙人們離開凡世，在什麼地方隱居，自己研究著很多厲害的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091411,
					"content": "本仙…只是覺著交際太過煩瑣，想尋個清靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091412
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091412,
					"content": "#但清淨了沒多久，{F#妳}{M#你}們就拿著這「百無禁忌籙」來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091413
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091413,
					"content": "#算了，算了！{F#妳}{M#你}們所為何事，速速報來，莫要打擾了本仙休憩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091414
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091414,
					"content": "帝君…帝君遇刺了！？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091415
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091415,
					"content": "怎…怎會如此！居然有人敢犯下如此滔天大罪！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091416
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091416,
					"content": "如此荒誕，難以相信，本仙要去查證…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091417
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091417,
					"content": "不…不如本仙這就去先鎮壓了璃月港，再等群仙並至——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091418
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091418,
					"content": "…咦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091419
					]
				},
				{
					"id": 10091419,
					"content": "咦？！等，等一下！什麼叫「鎮壓」璃月港？您是要把整座璃月港給毀掉嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091420,
					"content": "只是要使些雷霆手段，免得再多生事端。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091421,
						10091423
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091421,
					"content": "您可是守護璃月港的仙人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091422
					]
				},
				{
					"id": 10091422,
					"content": "正是，承帝君律令，我等守護璃月港三千七百餘年。但如今惡徒當道，也不得不用一些非常手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091425,
					"content": "本仙正是不願看見生靈塗炭，才在此非常關頭，使出非常手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091426
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091426,
					"content": "嗚啊！快想想辦法，這位仙人是認真的！她真要去鎮壓整座璃月港了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091427,
					"content": "我奉上了貢品，按照「契約」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091428
					]
				},
				{
					"id": 10091428,
					"content": "對啊！我們做了那麼多好吃的，全都給您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091429,
					"content": "我們是來請您去保護璃月港的，不是請您去「鎮壓」的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091430
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091430,
					"content": "至少…您也應該，先聽聽大家的想法吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10091431,
					"content": "…「契約」。契約之神都已遇刺，這兩個字聽來真是諷刺至極。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091432
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091432,
					"content": "璃月港裡的凡人，時常會將「契約」拋之腦後，又極善混淆黑白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091433
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091433,
					"content": "#不過…{F#妳}{M#你}們既然是以「契約」之名前來請我，本仙也不能視「契約」於無物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091434
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091434,
					"content": "#而且{F#妳}{M#你}們還拿著這「百無禁忌籙」…唉，帝君鑄此神籙時，曾經封入仙力，助凡人征戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091435
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091435,
					"content": "然而如今此籙仙力少存，只餘信物之效…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091436
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091436,
					"content": "#不過，信物可證明不了{F#妳}{M#你}們本身的可信…剛才我聽到的那些話，我也都會查證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091437
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091437,
					"content": "想必削月築陽真君延請我等，也是為此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091438
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091438,
					"content": "#好了，{F#妳}{M#你}們速速離去吧，莫要再滋擾本仙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091423,
					"content": "您不是應該守護凡人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091424
					]
				},
				{
					"id": 10091424,
					"content": "正是。但如今帝君遇害，璃月港也處在危急關頭，假若不盡快鎮壓，只怕災厄會再進一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091425
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10091405,
					"content": "洞府裡的機關是您建的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10091406
					]
				},
				{
					"id": 10091406,
					"content": "那是自然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10091407
					],
					"speakerTitle": "留雲借風真君"
				}
			]
		},
