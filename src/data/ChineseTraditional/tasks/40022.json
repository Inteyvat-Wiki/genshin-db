			"dialogs": [
				{
					"id": 400221101,
					"content": "#三位，{F#妳}{M#你}們回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221102
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400221102,
					"content": "人到齊，就該去找最後的答案了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221103
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221103,
					"content": "你們好像惡戰了一場啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221104
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400221104,
					"content": "一場？哼…已經不知多少場了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221105
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221105,
					"content": "我打得還不錯吧，「式大將」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221106
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221106,
					"content": "達達利亞先生對這類秘境很是熟悉，無論多強的魔物，他都能完美應對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221107
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400221107,
					"content": "我認為，我們有望突入秘境最深處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221108
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400221108,
					"content": "哦？一起待了幾天，關係親近了不少嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400221109,
					"content": "哈哈，已經是戰友了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221110
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221110,
					"content": "重組期間，我聽「式大將」說，它感到最關鍵的「拓本」出現了，就在那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221111
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400221111,
					"content": "那枚「拓本」中蘊含的符法之力遠超其他拓本。只要回收順利，我應該就能回想起這座秘境的真相了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221112
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400221112,
					"content": "不是就在那裡嗎？你們怎麼不過去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400221113,
					"content": "「式大將」…你是在等我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221114
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400221114,
					"content": "多虧各位陪伴，我才能走到這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400221115
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400221115,
					"content": "我的記憶是靠著你們一點點找回的，至於這最後也最重要的時刻…我想請大家一起為我見證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「式大將」"
				}
			]
		},
