	"talks": [
		{
			"id": 4002201,
			"completionStepIds": [
				4002201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002201",
							"2"
						],
						"stepId": 4002201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400220101,
					"content": "旅行者，這段時間我從駐兵們那裡打聽到一個好消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220102
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220102,
					"content": "聽說九條裟羅被城中事務困住了，她的部下暫時沒有動靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220103
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220103,
					"content": "說到底，這個秘境已經很久沒有放出魔物了，他們小心地把守著重要關口，沒必要急著向秘境內進軍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220104
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220104,
					"content": "為我們爭取了不少時間呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220105
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220105,
					"content": "那我們趕快進去吧，那兩個傢伙一定等得不耐煩了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4002203,
			"completionStepIds": [
				4002203
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002203",
							"2"
						],
						"stepId": 4002203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400220301,
					"content": "一直以來零散破碎的記憶，總算匯聚成型了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220302
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220302,
					"content": "我全都想起來了…這座「訣籙陰陽寮」的過去…它的本質。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220303
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220303,
					"content": "它不是用來試驗「陰陽術」的場所，也不是滋生邪祟之物的巢穴。晴之介創造我和這座秘境的目的…是為了「守護」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220304
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220304,
					"content": "「守護」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220305,
					"content": "我們的國度曾遭到某種災害的侵襲。那次變故奪去了晴之介最珍視的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220306
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220306,
					"content": "晴之介十分悔恨，因此，他開始渴求能夠抵禦邪祟的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220307
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220307,
					"content": "他渡海前往璃月，尋訪仙人，修習仙法，將這種奧妙之術與自身研習多年的「神通」相結合，締造出了最早的「陰陽術」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220308
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220308,
					"content": "隨後，他召集有志報國的武士，又創造出我和這座陰陽寮，以我為原型製作眾多「拓本」，將它們分發給武士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220309
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220309,
					"content": "武士和「式神」組成搭檔，用符法配合武藝，更為穩妥地對抗魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220310
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220310,
					"content": "他們兩兩成組，外出與魔物戰鬥。戰敗魔物的資訊會被「式神」拓寫下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220356
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220356,
					"content": "返回秘境後，這些資訊借由「鏡返魔物」的姿態重現於世，充當武士訓練的對手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220311
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220311,
					"content": "我作為「式神」的統籌者，會不斷吸收「拓本」們的見聞與經驗，調整秘境的架構，為武士們提供更有效的訓練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220312
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220312,
					"content": "長此以往，這些志向高遠的武士都能鍛煉出傲人武藝。等他們離開，下一批新人又會到來。新的見聞、新的對手…循環不息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220313
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220313,
					"content": "演武的秘境？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220314
					]
				},
				{
					"id": 400220314,
					"content": "難怪能無止境地戰鬥下去…這裡本就是一座訓練場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220315
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220315,
					"content": "也就是說，惟神晴之介建立這座陰陽寮是為了訓練武士，讓他們更好地對抗魔物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220316,
					"content": "那他不就是個徹徹底底的大好人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220317,
					"content": "如果是這樣的話，他為什麼要躲在秘境深處呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220318
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220318,
					"content": "不，晴之介早已不在寮內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220319
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220319,
					"content": "不知為何，晴之介遣散了所有武士，廢棄了整座秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220320
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220320,
					"content": "這段記憶，這最後的碎片，還沒能補全…我甚至想不起晴之介離去前對我說過什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220321
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220321,
					"content": "離開的意思是…他還活著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220322
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220322,
					"content": "也許吧。至少…我希望是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220323
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220323,
					"content": "我是被晴之介創造出來的一種「兵器」。我與陰陽寮的使命，是不斷創造戰鬥，錘煉自己也錘煉他人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220324
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220324,
					"content": "可是如今這座秘境已經沒用了。除了你們，沒有人會來這裡…被主人拋棄的兵器，還有什麼價值可言呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220325
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220325,
					"content": "他好難過的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220326,
					"content": "被主人拋棄的兵器…哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220327
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220327,
					"content": "做一把兵器也沒什麼不好的吧？每個在戰鬥中沉淪的人，都渴求著自身的意義與價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220328
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220328,
					"content": "是這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220329
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220329,
					"content": "你不是對我的秘密很好奇嗎？為什麼我能堅持抵抗秘境的排斥，為什麼我能從容面對複雜無比的戰局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220330
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220330,
					"content": "我不過是在「樹根」的縫隙中戰鬥過而已。無止境的險境、奪命的危險…只有得到這些養分，我才能更快地變強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220331
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220331,
					"content": "我要的不是勝利，而是磨煉。我想要的，就只是讓自己變得鋒利，變得讓人畏懼。我和你一樣，也是「兵器」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220332
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220332,
					"content": "若是如此…你所追逐的戰鬥，它的終點在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220333
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220333,
					"content": "渴望結束的人才會尋找終點。我不一樣，我根本不在乎這些虛無縹緲的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220334
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220334,
					"content": "我是為戰鬥而生的，只要我還活著，終點就不會出現…我選擇的路，每一步都是極限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220335
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220335,
					"content": "捨棄困惑吧。帶著憂愁和猶豫，可沒法成為無情的兵器啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220336
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220336,
					"content": "我要怎麼做才能捨棄？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220337
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220337,
					"content": "我倒覺得，捨棄只是一種形容，不是真的要你丟棄什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220338
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220338,
					"content": "「式大將」，你不需要丟棄任何東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220355
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220355,
					"content": "你才剛找回記憶，現在正是撿起過去的大好機會，只要找回那件對你來說正確又重要的事就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220339
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220339,
					"content": "正確又重要…的事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220340
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220340,
					"content": "我有哦。我喜歡搖滾樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220341
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220341,
					"content": "很少有人喜歡搖滾樂對吧？確實是冷門了些，但沒關係，我高興就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220342
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220342,
					"content": "別人喜不喜歡，與我何干？我只做自己想做的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220343
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220343,
					"content": "假如有誰愛給白眼，那就給吧！我的音樂，本來也不是給外行的人聽的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220344
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220344,
					"content": "曲子…我記得妳彈給我的那個「測試」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220345
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220345,
					"content": "你說你孤獨地走在路上，偶爾與人在篝火旁相遇，大夥還會一起吃些烤魚什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220346
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220346,
					"content": "能理解這一點，說明你已經很瞭解人的情感了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220347
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220347,
					"content": "我們每個人或多或少都走過這條孤獨的路，你也在那裡，自然是我們的同伴。所以我們會在篝火旁相遇，然後，成為朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220348
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220348,
					"content": "路很難走，但我們並不孤單。「式大將」，這是我音樂中的語言，是我堅持正確之事的收穫。你呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220349
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220349,
					"content": "一定也有必須去做的事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220350
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220350,
					"content": "辛焱小姐…也許我現在還拿不出妳那樣的豁達。但我知道，我不能停留在此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220351
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220351,
					"content": "前進吧，各位！我想…不，我要找回最後的「拓本」，重新掌控這座秘境。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220352
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220352,
					"content": "一定…一定還存在著只有我能做到的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220353
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220353,
					"content": "沒錯，振作起來，我們還要戰鬥呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220354
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220354,
					"content": "大家一起前進，就沒問題啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4002206,
			"completionStepIds": [
				4002206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002206",
							"2"
						],
						"stepId": 4002206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「式大將」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400220601,
					"content": "並不是晴之介拋棄了我，而是我開導了他，讓他放下背負了太久的重擔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220602
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220602,
					"content": "對於我和「訣籙陰陽寮」，晴之介有著美好的祝願。非要說的話，可能是我們都有些生不逢時吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220603
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220603,
					"content": "武士們竭盡全力鍛煉，這種鍛煉也被證明是小有成效的，然而，凡人的力量終究有著極限，我們所創造的進步…太慢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220604
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220604,
					"content": "就在我們苦修時，那位掌握著「無想的一刀」的神明，帶領著其他勤奮又強大的戰士，拔除了埋藏在這片土地上的隱患。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220605
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220605,
					"content": "畢生的心血突然成了不被需要之物…想必，任何人都無法輕易接受這種結果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220606
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220606,
					"content": "神明的力量有時很殘忍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220607
					]
				},
				{
					"id": 400220607,
					"content": "根本沒法想像那種事，但好像又聽說過相似的例子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220608,
					"content": "我迷茫過，消沉過，懷疑一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220609
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220609,
					"content": "可是我們創造的結果，我們付出的代價，即使再怎麼渺小，也是真實存在過的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220610
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220610,
					"content": "不管怎麼說，晴之介和武士們渴望的「目標」已經達成了，武士們不用再埋頭苦練了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220611
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220611,
					"content": "這本該是一件值得慶賀的事。晴之介是因為太有感情，太過在乎世間的一切，才會拘泥於自己失去的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220612
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220612,
					"content": "「守護」是我們共同的心願。晴之介想要「守護」大家…那麼，我就「守護」晴之介吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220613
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220613,
					"content": "作為晴之介最得意的造物，也是他在這「訣籙陰陽寮」中唯一的摯友，我勸導了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220614
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220614,
					"content": "他告訴我，他要去尋找新的「意義」，也許需要一個月，一年，或是幾百年。無論多久，我都期盼著有朝一日他能完成心願回到這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220615
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220615,
					"content": "日復一日的等待中，我陷入了沉睡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220616
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220616,
					"content": "晴之介啊…你應該是不會回來了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220617
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220617,
					"content": "別太難過，「式大將」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220618
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220618,
					"content": "惟神晴之介學到了那麼強大的仙法，又會「神通」，也許他能長生不老吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220619,
					"content": "各位，我想明白了一件事。無論晴之介是否還在世上，我都不該只為他而活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220620
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220620,
					"content": "遇見你們之後，我學會了一件事，那就是相信。相信晴之介正走在他自己的路上…相信我也會擁有這樣一條路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220621
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220621,
					"content": "自從誕生於世，我們便開始向著孤獨的盡頭行走，但迷霧之中會有火光，夜空之下會有新的夥伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220667
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220667,
					"content": "我們的使命，從不因遠行而告終。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220622
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220622,
					"content": "晴之介所做的一切都有價值。而我的「意義」，正是我的使命。這一點從未改變，更不會被剝奪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220623
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220623,
					"content": "我是輔佐武人的「式神」之首「式大將」，這座「訣籙陰陽寮」不變的「寮司」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220624
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220624,
					"content": "我的職責是輔佐武人，幫助他們錘煉極致的武藝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220625
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220625,
					"content": "世間一定還有正在攀登高山的人，我很樂意成為山間的繩索，成為他們的兵器，陪伴他們走向山頂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220626
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220626,
					"content": "好極了，就是這種態度！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220627,
						400220628
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220627,
					"content": "你已經找到答案了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220629
					]
				},
				{
					"id": 400220629,
					"content": "記憶完全恢復的「式大將」…給人一種堅定又可靠的印象呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220630,
					"content": "我已重新掌控「訣籙陰陽寮」，今後不會再有任何「鏡返魔物」外逃。本次風波，就到此為止了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220631
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220631,
					"content": "只需幾日時間，我就能理清符法之力的脈絡，將「訣籙陰陽寮」恢復成原貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220632
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220632,
					"content": "這裡是變幻莫測卻安全可靠的試煉之地。今後我會一直守在這裡，為渴求極致武藝的人提供最為有效的試煉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220633
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220633,
					"content": "天領奉行那邊應該也準備好進入秘境了吧。等他們過來，我會和他們詳細說明這次事件。交涉方面，幾位大可放心交給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220634
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220634,
					"content": "好好好，意思是我們都不用善後了對吧？嗯~我就喜歡這種一身輕的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220635,
					"content": "多虧你們，我才能找回真正的自己…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220636
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220636,
					"content": "我準備了一點薄禮。雖說無法與各位的恩情相比，應該也能派上些用場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220637
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220637,
					"content": "「拓本」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220638
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220638,
					"content": "你們可以稱呼他為「式小將」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220639
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220639,
					"content": "「式小將」與其他「拓本」不同，不管在大陸哪一處，它都能與我保持聯繫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220640
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220640,
					"content": "離開「訣籙陰陽寮」後，他無法再運用「式札」和符法，不過，也還是能帶給你們加護。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220641
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220641,
					"content": "帶著他遊歷各地，就相當於把我帶在身邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220642
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220642,
					"content": "（「式大將」的口吻有些悲傷…是擔心我們不會再見面嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220643
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220643,
					"content": "喂！別說喪氣話，我們不是還在嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220644
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220644,
					"content": "而且託旅行者、九條裟羅和北斗姐的福，我來稻妻也不是那麼困難。說不定三不五時就到這裡來看你了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220645
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220645,
					"content": "辛焱小姐…這樣不會太耽擱妳的時間嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220646
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220646,
					"content": "我問你，搖滾怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220647
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220647,
					"content": "搖滾…對我來說，是非常好的音樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220648
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400220648,
					"content": "那就夠了。我一直只為懂得欣賞的人演奏音樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220649
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220649,
					"content": "大家，準備好耳朵，我要露一手！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220650
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400220650,
					"content": "哦？！居然要彈曲子嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220651
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220651,
					"content": "原來這首曲子還有這麼振奮人心的部分啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220652
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220652,
					"content": "達達利亞不是會跳舞嗎？讓他跟著…哎？達達利亞人呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220653
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220653,
					"content": "喂——！達達利亞！你要去哪啊，不會是想偷偷溜走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220654
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400220654,
					"content": "溜走？我只是找個地方休息一下，想想問題而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220655
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220655,
					"content": "#旅行者，是時候告訴{F#妳}{M#你}我在調查的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220656,
						400220657
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220656,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220658
					]
				},
				{
					"id": 400220658,
					"content": "#還是那麼敏銳啊。有時候真懷疑{F#妳}{M#你}的眼睛能看透人心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220659
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220659,
					"content": "這次我玩得很開心，說真的，我挺喜歡稻妻的呢。只要不去想那些小小的麻煩…和它們帶來的後患就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220660
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220660,
					"content": "本以為這座秘境與「散兵」有瓜葛，我才會來這裡。沒想到，他根本不在裡面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220661
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220661,
					"content": "帶著「神之心」的「散兵」與我們失去了聯絡…這背後恐怕還有故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220662
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220662,
					"content": "不過「散兵」會做出這種事，我一點都不覺得意外。倒不如說，就像我當執行官只是為了尋求爭鬥，愚人眾大部分執行官也有自己的打算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220663
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220663,
					"content": "#就讓那顆「心」再逃一下吧。{F#妳}{M#你}遲早會知道它去了哪裡。屆時，{F#妳}{M#你}會怎麼選擇呢？旅行者，{F#妳}{M#你}的終點又是哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220664
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220664,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220665
					]
				},
				{
					"id": 400220665,
					"content": "真想再多停留一陣子啊。駐足越久，下一次見面時喜悅就越大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400220666
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220666,
					"content": "#就像晚星一般…{F#妳}{M#你}總是令人倍感驚喜，我的夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400220657,
					"content": "和我之前的經歷有關嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220658
					]
				},
				{
					"id": 400220628,
					"content": "我也很受啟發哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400220629
					]
				}
			]
		},
