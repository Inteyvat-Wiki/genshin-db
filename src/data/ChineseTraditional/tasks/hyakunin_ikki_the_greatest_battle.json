				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茅葺一慶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600101,
					"content": "嗨！那邊那位異鄉人，有興趣戰鬥嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600102,
						726600104
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600102,
					"content": "我是身經百戰的戰士。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600103
					]
				},
				{
					"id": 726600103,
					"content": "太好了，我果然沒看錯人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600106,
					"content": "事情是這樣的，最近似乎又有人在秘密舉辦「百人一揆」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600107,
						726600109
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600107,
					"content": "百人一首？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600108
					]
				},
				{
					"id": 726600108,
					"content": "不不不，是百人一揆。百人一首是什麼呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600110
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600110,
					"content": "過去模仿天狗的「天狗黨人」當中，曾經流傳過某種傳統儀式。簡單來說，是這樣的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600111
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600111,
					"content": "時令不景氣時、心情低落時；或是有值得慶賀的喜事發生時；或者只是單純感到無聊的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600112
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600112,
					"content": "就是透過酣暢淋漓的打鬥，來進行慶祝、或者消除晦氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600113
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600113,
					"content": "好像什麼時候都能舉辦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600114
					]
				},
				{
					"id": 726600114,
					"content": "…仔細一想，似乎確實是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600115
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600115,
					"content": "總之，我們換個地方說話吧。城裡人多嘴雜，不太方便…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600109,
					"content": "願聞其詳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600110
					]
				},
				{
					"id": 726600104,
					"content": "有什麼委託嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600105
					]
				},
				{
					"id": 726600105,
					"content": "也不算是委託吧。總之…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600106
					],
					"speakerTitle": "茅葺一慶"
				}
			]
		},
		{
			"id": 7266002,
			"completionStepIds": [
				7266002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266002",
							"2"
						],
						"stepId": 7266002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茅葺一慶"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726600201,
					"content": "我們到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600202
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600202,
					"content": "只要踏入這扇看起來十分可疑的大門，就能進入百人一揆的場館。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600203,
						726600204
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600203,
					"content": "好興奮。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				},
				{
					"id": 726600205,
					"content": "雖然「天狗黨」早已因為妨礙公共良俗而被取締，但不時還會有人秘密舉辦百人一揆的亂鬥大會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600206
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600206,
					"content": "而來自世界各地渴求爭鬥的魔物、冒險者、戰士，冥冥之中也會被它吸引，在它的舞臺上酣暢淋漓地大打出手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600207
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600207,
					"content": "#{F#妳}{M#你}可以和志同道合的同伴、戰友一起去參戰。畢竟，所謂「百人」，自然是人數越多越好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600208
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600208,
					"content": "#{F#妳}{M#你}看起來是雲遊四海的冒險家，想必有願意與{F#妳}{M#你}一同參加的朋友吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600209
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600209,
					"content": "你不參加嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600210
					]
				},
				{
					"id": 726600210,
					"content": "#我嗎？我會以旁觀者的身分參與，為{F#妳}{M#你}喝彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600211
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600211,
					"content": "其實，我的目的是寫出最精彩的格鬥小說，斬獲八重堂的「這本小說真厲害」大獎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600212
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600212,
					"content": "#而我的直覺告訴我，{F#妳}{M#你}一定會是格鬥場上最耀眼的明星。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600213,
						726600214
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600213,
					"content": "我會盡力。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600215,
					"content": "#小說的名字我已經想好了，就叫《百人一揆～最強武鬥大會篇～》。如果有朝一日{F#妳}{M#你}在八重堂書店裡看見這本書，那其中一定會有金髮的異邦戰士登場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726600216
					],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600216,
					"content": "#我很期待{F#妳}{M#你}的表現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茅葺一慶"
				},
				{
					"id": 726600214,
					"content": "那當然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600215
					]
				},
				{
					"id": 726600204,
					"content": "好可疑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726600205
					]
				}
			]
		}
	]
}