			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"史丹利",
					"傑克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110401,
					"content": "呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110402
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101110402,
					"content": "我剛才以為自己會死！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110403
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110403,
					"content": "確實只差一點點了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110404
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110404,
					"content": "對了，你就是冒險家傑克吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110405
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110405,
					"content": "對，請問你是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110406
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110406,
					"content": "我們是來找你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101110407,
					"content": "艾琳托我們帶個口信給你：今天她沒法跟你商量冒險計畫了，得改天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110408
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110408,
					"content": "呃…原來是這樣，真不好意思，還麻煩你們到這裡來找我…還救了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110409
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110409,
					"content": "哈！多管閒事！根本就不用救，難道我史丹利還搞不定這種簡單的情況嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110410
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101110410,
					"content": "哇，你就是那個名震蒙德、曾經抵達「燼寂海」的傳說級大冒險家啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101110411,
					"content": "沒錯，我就是史丹利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110412
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101110412,
					"content": "哈哈，很榮幸見到這種傳說級的人物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110413
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110413,
					"content": "那麼各位，現在怎麼打算？往前？還是回頭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110414,
						101110417
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110414,
					"content": "史丹利先生怎麼想？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110415
					]
				},
				{
					"id": 101110415,
					"content": "#哈哈，{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BOYE|INFO_FEMALE_PRONOUN_GIRLE]}，跟你們在一起的，可是名震蒙德的大探險家史丹利啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110416
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101110416,
					"content": "難道還有走回頭路的必要嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101110419,
					"content": "全票通過，那就繼續前進囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110417,
					"content": "傑克怎麼想？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110418
					]
				},
				{
					"id": 101110418,
					"content": "我們還是繼續向前走吧，有史丹利先生在，一定沒問題的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110419
					],
					"speakerTitle": "傑克"
				}
			]
		},
		{
			"id": 1011106,
			"completionStepIds": [
				1011106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1011106",
							"2"
						],
						"stepId": 1011106,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101110601,
					"content": "旅行者，我有一個小小的發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110602
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110602,
					"content": "#可以請{F#妳}{M#你}打開探測儀嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110603
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110603,
					"content": "哎？史丹利居然也有「幻想朋友」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101110604,
					"content": "看起來，他的朋友是一位久經沙場的戰士…渾身都是傷痕，表情也十分堅毅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110605,
						101110608
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110605,
					"content": "像是史丹利描述裡的自己。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110606
					]
				},
				{
					"id": 101110606,
					"content": "他的幻想朋友，難道是理想化的自己？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110607
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110607,
					"content": "有意思。但，真的是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110611,
					"content": "那麼，我先走囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110612
					],
					"speakerTitle": "史丹利"
				},
				{
					"id": 101110612,
					"content": "史丹利先生再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110613
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110613,
					"content": "二位，請問有空嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110614
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110614,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110615
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110615,
					"content": "其實，前幾天史丹利先生喝醉酒，說了一些不為人知的秘密給我聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110616
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110616,
					"content": "他當年冒險時用的武器，是大英雄溫妮莎的遺物，<color=#00E1FFFF>「輝煌勇氣之劍」</color>和<color=#00E1FFFF>「光耀意志之盾」</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110617
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110617,
					"content": "說出來怕你們不信，這兩件武器現在都還藏在蒙德境內，就在<color=#00E1FFFF>達達烏帕谷</color>哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110618
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110618,
					"content": "你們這麼厲害，能不能陪我去找這兩件神器？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110619,
						101110621
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110619,
					"content": "竟然有這麼厲害的武器？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110620
					]
				},
				{
					"id": 101110620,
					"content": "當然有啊！畢竟那可是史丹利先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110623,
					"content": "如果能找到足夠厲害的東西證明自己，家裡說不定就會支持我做冒險家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110624
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110624,
					"content": "現在我還是能力不足的新人，而且父親和母親對我的理想非常反對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110625
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110625,
					"content": "#所以求求{F#妳}{M#你}了，幫幫我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110626
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110626,
					"content": "我不敢把這個自私的念頭說給史丹利先生聽…但我保證，用完馬上就還給他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110627
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110627,
					"content": "好可憐…喂，我們就幫幫他吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110628,
						101110629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101110628,
					"content": "好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110630,
					"content": "溫迪，你來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101110631,
					"content": "這個嘛…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110632
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110632,
					"content": "前年我託人搞來一瓶珍貴名酒，只要幫我找到神器，酒就歸你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110633
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110633,
					"content": "<color=#00E1FFFF>達達烏帕谷</color>對吧？！事不宜遲，我們現在就動身！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110629,
					"content": "不能視而不見吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110630
					]
				},
				{
					"id": 101110621,
					"content": "他把神器隨便丟在野外？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110622
					]
				},
				{
					"id": 101110622,
					"content": "厲害的人總是有些怪癖嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110623
					],
					"speakerTitle": "傑克"
				},
				{
					"id": 101110608,
					"content": "說起來，他的故事也有點奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101110609
					]
				},
				{
					"id": 101110609,
					"content": "#哦？{F#妳}{M#你}也覺得有問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110610
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 101110610,
					"content": "看來，史丹利的故事還有隱情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101110611
					],
					"speakerTitle": "溫迪"
				}
			]
		}
	]
}