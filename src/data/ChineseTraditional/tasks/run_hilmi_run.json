				"points": []
			},
			"dialogs": [
				{
					"id": 230390101,
					"content": "#{M#大哥哥}{F#大姐姐}！請等一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390102
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390102,
					"content": "#請問…{F#妳}{M#你}是冒險家嗎？就是那種去過很多地方冒險，很擅長戰鬥的冒險家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390103,
						230390104
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390103,
					"content": "算是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				},
				{
					"id": 230390105,
					"content": "#你看！希爾米，我就說這位{M#大哥哥}{F#大姐姐}一定是冒險家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390106
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390106,
					"content": "但是冒險家不都是穿那種綠綠的衣服嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390107,
						230390108
					],
					"speakerTitle": "希爾米"
				},
				{
					"id": 230390107,
					"content": "我比較厲害，不用那麼穿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390109,
					"content": "喔——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390110
					],
					"speakerTitle": "希爾米"
				},
				{
					"id": 230390110,
					"content": "喔——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390111
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390111,
					"content": "#那{M#大哥哥}{F#大姐姐}！{F#妳}{M#你}一定能幫我們這個忙啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390112
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390112,
					"content": "#{F#妳}{M#你}看見村子裡那個大大的倉庫了嗎？哈巴奇哥哥說，裡面裝著很重要的東西，必須要好好防守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390113
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390113,
					"content": "他還和我們說，如果有壞蛋來攻擊村子，他就要先去把升降梯停掉，然後切斷吊橋…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390114
					],
					"speakerTitle": "希爾米"
				},
				{
					"id": 230390114,
					"content": "可是那個倉庫離升降梯還有好一段距離呢，哈巴奇哥哥要是想停掉升降梯，還得拼命跑過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390115
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390115,
					"content": "我們就提出，我們可以陪他練習，但哈巴奇哥哥都不搭理我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390116
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390116,
					"content": "明明每次我們想去打水漂的時候，他都反應那麼大，嘖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390117
					],
					"speakerTitle": "希爾米"
				},
				{
					"id": 230390117,
					"content": "咳，總之！如果壞人來攻擊村裡，哈巴奇哥哥又跑不動了，那就只能由我們去停掉升降梯啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390118
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390118,
					"content": "#{M#大哥哥}{F#大姐姐}，{F#妳}{M#你}是個冒險家，一定很擅長跑步吧，就請{F#妳}{M#你}陪我們訓練一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390119,
						230390121
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390119,
					"content": "那我就陪你們跑一段。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390120
					]
				},
				{
					"id": 230390120,
					"content": "#好耶！謝謝{M#大哥哥}{F#大姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390126,
					"content": "#我們已經選好起點了，我們去那邊吧，{M#大哥哥}{F#大姐姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390127
					],
					"speakerTitle": "希爾米"
				},
				{
					"id": 230390127,
					"content": "#嘿嘿，這次就由我來和{F#妳}{M#你}對決。先說好，我可是很擅長跑步的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "希爾米"
				},
				{
					"id": 230390121,
					"content": "可以相信哈巴奇的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390122
					]
				},
				{
					"id": 230390122,
					"content": "欸…就陪我們玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390123
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390123,
					"content": "#陪、陪我們訓練一下吧，{M#大哥哥}{F#大姐姐}，拜託啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390124
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390124,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390125
					]
				},
				{
					"id": 230390125,
					"content": "#好耶！謝謝{M#大哥哥}{F#大姐姐}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230390126
					],
					"speakerTitle": "奧貝德"
				},
				{
					"id": 230390108,
					"content": "我比較特別，不用那麼穿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390109
					]
				},
				{
					"id": 230390104,
					"content": "這麼說也沒什麼問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230390105
					]
				}
			]
