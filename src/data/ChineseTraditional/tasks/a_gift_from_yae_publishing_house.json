			"dialogs": [
				{
					"id": 706960101,
					"content": "好久不見了，小傢伙。最近去哪旅行了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960102
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960102,
					"content": "將雪山的見聞告訴了神子。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706960103
					]
				},
				{
					"id": 706960103,
					"content": "嗯，真是群可愛的孩子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960104
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960104,
					"content": "為了共同的愛好，不管相隔多遠也要相聚…哎呀，青春的氣息真是撲面而來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960105
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960105,
					"content": "看來《熾魂鬥士戰記》的魅力不小呢，是時候把再版計畫放進規劃裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960106
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960106,
					"content": "讀者們這麼真誠，我也必須表示一下心意才行呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960107
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960107,
					"content": "為你們贈送一些漫畫如何？嗯…人不少，得多送幾本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706960108,
						706960109
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960108,
					"content": "謝謝妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				},
				{
					"id": 706960110,
					"content": "都是初版印刷品，外面可買不到，好好珍惜哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 706960109,
					"content": "會和大家分享的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706960110
					]
				}
			]
		},
