			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡塔琳娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710591101,
					"content": "怎麼？專門來打擾我休息嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591102
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591102,
					"content": "沒有啦，我們就是看妳一個人在這裡怪孤單的，想跟妳聊聊天而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591103,
						710591104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710591103,
					"content": "一個人喝酒很無聊吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				},
				{
					"id": 710591105,
					"content": "#…這樣嗎？謝謝{F#妳}{M#你}們。{F#妳}{M#你}們這副樣子呀…讓我想起柳達希卡那傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591106
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591106,
					"content": "她也是個熱心人…那時候總是纏在我身邊，什麼話都願意和我說…很多時候只願意和我說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591107
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591107,
					"content": "#唉，如果柳達希卡也在就好囉…她是個很有趣的人，{F#妳}{M#你}一定會喜歡她的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591108,
						710591113
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591108,
					"content": "柳達希卡？那是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591109
					]
				},
				{
					"id": 710591109,
					"content": "她呀…我的一個朋友，看起來很嚴肅的樣子，其實是個有趣的笨蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591110
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591110,
					"content": "曾經在「壁爐之家」的時候我們就像姐妹一樣要好…可能更勝姐妹吧。她很喜歡我的捉弄…我也很受她照顧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591111
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591111,
					"content": "哈哈，總之，我預感她在外面過得還不錯。每每想到這點，我在這個鬼地方受的傷就都不算什麼啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591112
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591112,
					"content": "希望她也有在好好執行任務吧…希望她不要想起我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591113,
					"content": "柳達希卡…妳是說稻妻的那個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591114
					]
				},
				{
					"id": 710591114,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591115
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591115,
					"content": "這麼說，她暴露了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591116
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591116,
					"content": "欸…妳怎麼知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591117,
						710591118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710591117,
					"content": "她…設法逃出生天了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591119,
					"content": "是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591120
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591120,
					"content": "哈哈…那就好，希望她也在好好執行任務吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591121
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591121,
					"content": "但假如她為了苟且偷生，違背了女皇陛下的意志…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710591122
					],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591122,
					"content": "…希望她不要想起我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡塔琳娜"
				},
				{
					"id": 710591118,
					"content": "她還活著，過得很好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591119
					]
				},
				{
					"id": 710591104,
					"content": "我們特地來陪妳說說話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710591105
					]
				}
			]
		},
