			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于連"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960201,
					"content": "#派蒙，還有{NICKNAME}，{F#妳}{M#你}們果然來了！出門在外還是得靠朋友啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960202
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960202,
					"content": "因為答應了幫你帶路嘛，而且帶路也不是什麼難事！舉手之勞…這時候該說是舉足之勞嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960203,
					"content": "不過，你真的這麼快就回楓丹嗎？難得到了須彌，其實須彌可看的風景還是很多的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960204,
						732960206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960204,
					"content": "雨林的風景很不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960205
					]
				},
				{
					"id": 732960205,
					"content": "有很多樹，很多河！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960208,
					"content": "聽起來的確很誘人，但是我想…我其實還沒有做好遠遊的準備。這次雖然是一次失敗的旅行，但是也算是收穫了一些教訓吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960209
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960209,
					"content": "唔…那…那這附近也有很值得一看的景觀呢！要是錯過就太可惜啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960210,
					"content": "派蒙推薦的地方準沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960211
					]
				},
				{
					"id": 732960211,
					"content": "既然兩位堅持，我再推辭就顯得對好朋友失禮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960212
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960212,
					"content": "嘿嘿，我可是提瓦特的最佳嚮導，帶路就交給我吧！你們千萬不要掉隊啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960206,
					"content": "沙漠的景觀很特別。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960207
					]
				},
				{
					"id": 732960207,
					"content": "有很多沙、很多遺蹟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960208
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7329603,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329612",
							"2"
