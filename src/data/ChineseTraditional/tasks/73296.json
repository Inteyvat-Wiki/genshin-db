					"于連"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960801,
					"content": "怎麼樣，風景很不錯吧？「胡椒」剛才也很高興呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960802,
					"content": "面對這樣的景色，語言已經顯得多餘了。卡特皮拉說得對，鐵格子之外還有廣闊的世界…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960803
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960803,
					"content": "鐵格子…于連之前說自己在楓丹的住處很小…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960804,
					"content": "咳，須彌的自然環境特色滿多的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960805
					]
				},
				{
					"id": 732960805,
					"content": "…啊，對對！他已經決定要當個堂堂正正的畫家了，換個環境也滿好的，人家不是常常說要…要拓寬視野！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960806,
					"content": "雖然于連自己說想要放棄…但我覺得沒必要那麼快就下結論嘛！可以再多考慮考慮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960807,
					"content": "想一想，還有很多和眼前的景色一樣，或者比這還要壯美的絕景，你都還沒見識過呢，說不定…說不定看過之後就有靈感了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960808,
					"content": "至於辨別顏色…于連自己也說了，「只是看到了不同的景色」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960809
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960809,
					"content": "「但是美是共通的。」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960810
					]
				},
				{
					"id": 732960810,
					"content": "對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960811,
					"content": "#的確…{F#妳}{M#你}們的話很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960812
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960812,
					"content": "是你自己的話啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960813,
					"content": "我…哈哈，原來這道理我是知道的，只是…只是我總是走上錯誤的路…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960814
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960814,
					"content": "「胡椒」帶你走了這條路，我們才能相識呢，所以這也不完全是「錯誤的路」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960815,
					"content": "雖然沒能幫你找到純水精靈的朝聖之路滿遺憾的…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960816
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960816,
					"content": "這種東西真的存在嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960817
					]
				},
				{
					"id": 732960817,
					"content": "我到現在也相信朝聖之路的確存在，不過…對我來說，能否找到它的終點已經不再重要了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960818
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960818,
					"content": "因為我已經找到我想要的答案了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960819
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960819,
					"content": "#謝謝兩位好朋友，唉，我該怎麼感謝{F#妳}{M#你}們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960820
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960820,
					"content": "#要是之前買下了那顆神奇鳥蛋就好了…能夠抵消掉一天厄運的神奇道具，送給{F#妳}{M#你}們這樣的冒險家剛剛好呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960821,
						732960823
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960821,
					"content": "是啊，真可惜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960822
					]
				},
				{
					"id": 732960822,
					"content": "#{NICKNAME}居然真的相信有這麼方便的神奇道具嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960825,
					"content": "我打算在這裡多留一下，這裡讓人心緒寧靜，很適合思考。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960826
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960826,
					"content": "有種能夠畫出點什麼不一樣的東西的預感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960827
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960827,
					"content": "謝謝兩位的幫助，也祝好朋友旅途順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "于連"
				},
				{
					"id": 732960823,
					"content": "謝謝你，不過還是不用了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960824
					]
				},
				{
					"id": 732960824,
					"content": "為什麼呀！就算不能抵消厄運…說不定…說不定它是比普通鳥蛋好吃一百倍的鳥蛋呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960825
					],
					"speakerTitle": "派蒙"
				}
			]
		},
