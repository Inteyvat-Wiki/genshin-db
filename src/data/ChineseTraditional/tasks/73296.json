			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于連"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960401,
					"content": "充滿了大自然的氣息…是不是很適合寫生和尋找靈感？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960402,
					"content": "這是刻板印象啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960403
					]
				},
				{
					"id": 732960403,
					"content": "唔…可是如果是我就會很想提起畫筆呢，這裡的景物都有種充滿生命力的美，而且色彩也都很絢麗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960404,
					"content": "咳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960405
					]
				},
				{
					"id": 732960405,
					"content": "啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960406,
					"content": "對不起…我不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960407,
					"content": "哈哈，沒關係，我只是看到了不同的景色。但是美是共通的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960408
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960408,
					"content": "嗯！我很喜歡這裡的景色呢，感覺心靈都被淨化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960409,
					"content": "派蒙的心靈應該不需要淨化吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732960410
					]
				},
				{
					"id": 732960410,
					"content": "兩位好朋友，把這麼多的善意，給了我這樣一個一開始都沒有說實話的陌生人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960411
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960411,
					"content": "兩位都是有著純潔心靈的好人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960412
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960412,
					"content": "嘿嘿…倒也不用這麼誇獎啦。對了，其實還有更特別的景色呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960413,
					"content": "#{NICKNAME}，{F#妳}{M#你}一定知道我在說什麼，也讓于連見識一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
