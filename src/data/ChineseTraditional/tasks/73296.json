				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"于連"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732960301,
					"content": "聽說畫家在動筆之前都會從不同角度觀察…這應該不是什麼「刻板印象」吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960302,
					"content": "我們一起在附近繞繞？還可以去視野更好的高處觀察一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732960303,
					"content": "聽起來是個不錯的主意，我已經準備好出發了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732960304
					],
					"speakerTitle": "于連"
				},
				{
					"id": 732960304,
					"content": "#對了，不如我們比誰先到終點？{NICKNAME}，準備好出發了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7329604,
			"completionStepIds": [
				7329604
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7329604",
