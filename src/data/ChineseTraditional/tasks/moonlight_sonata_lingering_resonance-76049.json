			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7604901",
							"2"
						],
						"stepId": 7604901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「少女」"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2130.918,
							108.955,
							11206.71
						],
						"pointId": 360300003
					}
				]
			},
			"dialogs": [
				{
					"id": 760490101,
					"content": "…好像調高了一些，再試試看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490102,
					"content": "哥倫比婭！妳好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490103,
					"content": "咦？妳今天是在…教月靈彈琴嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490104,
					"content": "嗯，之前修好琴後，月靈們很開心，每天都纏著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490105
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490105,
					"content": "但我其實不是很會彈琴，之前都是聽別人彈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490106
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490106,
					"content": "唔…可以理解，感覺如果組樂隊的話，哥倫比婭是專門負責唱歌的角色呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490107,
					"content": "#不過，說到樂器，這傢伙可是特別擅長呢！從蒙德的「詩琴」到納塔的「聚聚鼓」，{M#他}{F#她}都十分精通呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490108,
						760490109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490108,
					"content": "普普通通，普普通通…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				},
				{
					"id": 760490110,
					"content": "#是嗎？那…不如{F#妳}{M#你}來教它們彈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490111,
						760490112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490111,
					"content": "那就露一手…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490113,
					"content": "#月靈們最近都在練習我平時唱的那首歌，{F#妳}{M#你}記得旋律吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490114
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490114,
					"content": "#或者…彈些{F#妳}{M#你}拿手的旋律也行。月靈們很少聽到其他國家的音樂，我也想聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490115
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490115,
					"content": "（彈什麼好呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490202,
						760490801
					]
				},
				{
					"id": 760490202,
					"content": "演奏哥倫比婭常哼的歌…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490201
					]
				},
				{
					"id": 760490201,
					"content": "（以什麼樣的情緒演奏呢…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490603,
						760490701
					]
				},
				{
					"id": 760490603,
					"content": "平和的樂調…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490604
					]
				},
				{
					"id": 760490604,
					"content": "#好聽。我平時哼的旋律，原來{F#妳}{M#你}都記下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490605
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490605,
					"content": "嘿嘿，因為妳唱歌很好聽嘛，我們有時會悄悄在旁邊聽上一會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490606,
					"content": "月靈們也聽得入迷了，不知道它們有沒有學會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490607
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490607,
					"content": "#說不定，以後還得多請{F#妳}{M#你}們教幾次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490608
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490608,
					"content": "來吧，把手給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490609
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490609,
					"content": "欸？我們這是無償演出，不用收學費的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490610,
					"content": "嗯？學費？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490611
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490611,
					"content": "我只是覺得，好聽的旋律應該有美麗的月光相伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490701,
					"content": "愉快的樂調…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490702
					]
				},
				{
					"id": 760490702,
					"content": "結束了？感覺都還沒聽夠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490703
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490703,
					"content": "我曾說過這是我唯一記得的「搖籃曲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490704
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490704,
					"content": "#儘管還沒找到其中的意義，但聽{F#妳}{M#你}彈過之後，我開始覺得在月亮上等待著我的那個答案，至少是美好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490705
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490705,
					"content": "來，把手給我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490706
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490706,
					"content": "這次就不用回報啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490707,
					"content": "不，我只是想為這旋律添上一束美好的月光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490801,
					"content": "演奏他國的音樂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490802
					]
				},
				{
					"id": 760490802,
					"content": "#奇妙的感覺。以前偶爾也聽過類似的旋律，但聽{F#妳}{M#你}彈的感受很不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490803
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490803,
					"content": "#可能其中包含了{M#他}{F#她}對那個國家的感情吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490804,
					"content": "奇妙的是，我能夠從樂調中想像出風景…不知道現實和我的想像會有多少分別呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490805
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490805,
					"content": "想看還不簡單？到時候就讓我們來當妳的導遊吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760490806
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760490806,
					"content": "嗯…如果能有那麼一天的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760490112,
					"content": "彈什麼好呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490113
					]
				},
				{
					"id": 760490109,
					"content": "略懂，略懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760490110
					]
				}
			]
		},
