				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240201,
					"content": "#哎呀，{F#妳}{M#你}總算來了，我都等{F#妳}{M#你}好久了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240202
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240202,
					"content": "妳等我做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240203
					]
				},
				{
					"id": 411240203,
					"content": "#不要這麼冷冰冰的嘛，我可是有很重要的事情想要拜託{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240204
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240204,
					"content": "#那些隕石{F#妳}{M#你}也看到了，雖然沒有隕石砸進蒙德城，但現在蒙德城內外為了處理和隕石相關的事，已經全都亂成一團了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240205
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240205,
					"content": "既然蒙德城的這池子水已經被攪渾了，那麼某些想要渾水摸魚的傢伙，一定也不會放過這次機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240206,
						411240208
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240206,
					"content": "妳說的是…盜寶團？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240207
					]
				},
				{
					"id": 411240207,
					"content": "哦呀，果然是身經百戰的冒險家，很敏銳嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240212,
					"content": "雖然西風騎士們已經提高了警惕，但為了支援周圍，蒙德城的城防多多少少還是有一些漏洞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240213
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240213,
					"content": "那群為了錢什麼都願意做的盜寶團，一定已經開始做打算，準備趁隙進城來「大撈一筆」了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240214,
						411240217
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240214,
					"content": "那我能做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240215
					]
				},
				{
					"id": 411240215,
					"content": "#哎呀，{F#妳}{M#你}居然這麼爽快就答應了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240216
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240216,
					"content": "哈哈哈，看樣子，那位先生告訴我的應對方法完全用不上了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240222,
					"content": "好了，簡單來說…之前來蒙德城周圍偵察的盜寶團成員，已經被那位先生親自拿下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240223
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240223,
					"content": "據他們說，有大概三支盜寶團在打渾水摸魚的主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240224
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240224,
					"content": "所以我們就將計就計，幫盜寶團們設計好了「最佳入侵地點」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240225,
						411240226
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240225,
					"content": "我要怎麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240231
					]
				},
				{
					"id": 411240231,
					"content": "#{F#妳}{M#你}要做的事很簡單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240232
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240232,
					"content": "為了保證不被一網打盡，前來偵察的盜寶團並不會直接回去報告。而是會把偵察到的情報用信的方式放在特定的接頭點上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240233
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240233,
					"content": "而且為了防止出問題，他們還專門派了三個人來偵察，並且在三個不同的地點分別交付情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240234
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240234,
					"content": "不過，他們肯定沒想到，這三個人全被那位先生拿下了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240235
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240235,
					"content": "在接到情報後，盜寶團的其他成員才會開始制訂計畫，選定最佳的入侵地點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240236
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240236,
					"content": "但是這次不勞他們費心，那位先生已經幫他們把計畫全部詳細地制訂好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240237
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240237,
					"content": "#這三封信給{F#妳}{M#你}，{F#妳}{M#你}去把它們分別放在盜寶團的三個接頭點上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240238
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240238,
					"content": "放好之後，就回來告訴我吧，剩下的事…唔，我們之後再說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240226,
					"content": "盜寶團說的話能信嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240227
					]
				},
				{
					"id": 411240227,
					"content": "#哈哈哈，{F#妳}{M#你}想得還挺周全嘛。放心啦，盜寶團的人可不會有什麼骨氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240228
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240228,
					"content": "那群傢伙，說到底只是一群只為求財的毛賊而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240229
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240229,
					"content": "「和我們合作會有更多的賺頭，耍花樣的話就會賠到傾家蕩產。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240230
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240230,
					"content": "只要讓他們意識到這一點，他們就會乖乖和我們合作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240231
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240217,
					"content": "西風騎士們會處理好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240218
					]
				},
				{
					"id": 411240218,
					"content": "#哈哈哈，{F#妳}{M#你}果然這麼說了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240219
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240219,
					"content": "#放心啦，那位先生這次給了我不少預算，報酬不會少{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240220
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240220,
					"content": "#{F#妳}{M#你}在幫忙的途中要是有什麼收穫，也可以自己收著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240221
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240221,
					"content": "#而且，這件事非{F#妳}{M#你}不可哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240222
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240208,
					"content": "妳說的是…丘丘人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240209
					]
				},
				{
					"id": 411240209,
					"content": "#哈哈哈，{F#妳}{M#你}想到哪裡去了，丘丘人可沒機會渾水摸魚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240210
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240210,
					"content": "只要它們靠近城邊，西風騎士們就會馬上把它們擊退啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240211
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240211,
					"content": "我說的那群想要渾水摸魚的傢伙，是盜寶團哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240212
					],
					"speakerTitle": "薇爾"
				}
			]
		},
		{
			"id": 4112406,
			"completionStepIds": [
				4112406
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4112406",
							"2"
						],
						"stepId": 4112406,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 411240601,
					"content": "放好信件了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240602
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240602,
					"content": "都放好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240603
					]
				},
				{
					"id": 411240603,
					"content": "這樣就可以了，那群盜寶團一定會根據那三份情報制訂入侵計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240604
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240604,
					"content": "而他們那份計畫中的「最佳入侵時間」，一定是從入夜到凌晨之間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240605
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240605,
					"content": "#還有「最佳入侵地點」…當然也只有一個啦。唔，我來標註在{F#妳}{M#你}的地圖上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240606
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240606,
					"content": "這樣就可以了，我們就等著那群盜寶團來自投羅網吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240607,
						411240610
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240607,
					"content": "如果被西風騎士發現…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						411240608
					]
				},
				{
					"id": 411240608,
					"content": "#嗯…{F#妳}{M#你}的擔心也有點道理。畢竟我們使用這種非正規的手段，要是被西風騎士們發現，免不了會帶來一堆麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240609
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240609,
					"content": "不過，那位先生向我保證不會出現這樣的問題，我們就…相信他吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						411240612
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 411240612,
					"content": "好了，等到入夜之後，你就去把那群自投羅網的盜寶團們全都打倒吧。",
					"roleType": "TALK_ROLE_NPC",
