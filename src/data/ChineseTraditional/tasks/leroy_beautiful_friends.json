			"dialogs": [
				{
					"id": 741570201,
					"content": "此屋待售。價格實惠，欲購從速。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570202
					],
					"speakerTitle": "房屋出售資訊"
				},
				{
					"id": 741570202,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}，還有派蒙姐姐，勒魯瓦先生好像不住在這裡了…{F#妳}{M#你}們後來有見過他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570203
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570203,
					"content": "（喂，要說實話嗎？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570204,
						741570210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741570204,
					"content": "見過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570205
					]
				},
				{
					"id": 741570205,
					"content": "#原來{F#妳}{M#你}們見過！那{F#妳}{M#你}幫我告訴他點心很好吃了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570206,
						741570208
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570206,
					"content": "說了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570207
					]
				},
				{
					"id": 741570207,
					"content": "#我就知道{NICKNAME}{M#哥哥}{F#姐姐}會守信用，{F#妳}{M#你}們人真好，我帶了泡泡桔過來請{F#妳}{M#你}們一起吃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570214,
					"content": "#茉莉嘆了口氣，向{F#妳}{M#你}們揮手作別，正打算離開這條街道…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570215
					]
				},
				{
					"id": 741570215,
					"content": "大門打開，秋和阿托斯從屋內走了出來。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						741570216
					]
				},
				{
					"id": 741570216,
					"content": "#果然外面的聲音是{F#妳}{M#你}們，還有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570217,
						741570219,
						741570222
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570217,
					"content": "只是正好路過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570218
					]
				},
				{
					"id": 741570218,
					"content": "是嗎？世界真小，剛好我和秋也打算離開了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570219
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570219,
					"content": "伯努瓦呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570220
					]
				},
				{
					"id": 741570220,
					"content": "#哦，他已經去別的地方了，那個地方我們幾十年後才會去，{F#妳}{M#你}們短期內應該見不到他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570221
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570221,
					"content": "不過這也難說，明天和意外究竟哪個先來——誰知道呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570225,
					"content": "這不是那個總來找伯努瓦的小鬼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570226
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570226,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570227
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570227,
					"content": "阿姨妳好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570228
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570228,
					"content": "太像了…還有紫色的眼睛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570229
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570229,
					"content": "阿…阿姨有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570230
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570230,
					"content": "妳幾歲了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570231
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570231,
					"content": "我九歲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570232
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570232,
					"content": "妳爸爸媽媽叫什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570233
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570233,
					"content": "唔…阿姨怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570234
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570234,
					"content": "妳的表情…這個小孩怎麼了？…該不會這麼巧吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570235
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570235,
					"content": "告訴我妳是不是被收養的，快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570236
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570236,
					"content": "#…{NICKNAME}{M#哥哥}{F#姐姐}，這個阿姨{F#妳}{M#你}認識嗎？她要幹什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570237
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570237,
					"content": "哪有人像妳這樣問的，我來問問看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570238
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570238,
					"content": "小妹妹，我記得妳和爸爸關係很好，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570239
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570239,
					"content": "對，勒魯瓦先生對我很好。女婿叔叔，他是不住在這裡了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570240
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570240,
					"content": "沒錯，他去了很遠的地方，以後不回來住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570241
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570241,
					"content": "爸爸他平常都和妳聊些什麼呀？可以告訴我嗎？回去之後，我可以告訴爸爸妳很想念他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570242
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570242,
					"content": "勒魯瓦先生請我吃點心、讓我摸娜娜，還會誇我眼睛好看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570243
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570243,
					"content": "還有呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570244
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570244,
					"content": "他常常要我代替他向爸爸媽媽問好，雖然爸爸媽媽非常不喜歡這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570245
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570245,
					"content": "每次爸爸都會很生氣，說勒魯瓦先生是壞人，是「勒索」他們的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570246
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570246,
					"content": "雖然爸爸媽媽不准我過來，但是我和勒魯瓦先生約好了，所以我還是會偷偷過來，叔叔你不要告訴我爸爸哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570247
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570247,
					"content": "他就是會做這種事的人，不把最後一點價值榨乾絕對不停手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570248
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570248,
					"content": "混帳…不好意思，剛才我們在說別的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570249
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570249,
					"content": "叔、叔叔阿姨還有別的事情嗎？沒有的話，我…我先回家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570250
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570250,
					"content": "…妳的爸爸和媽媽愛妳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570251
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570251,
					"content": "他們是世界上最好的爸爸和媽媽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570252
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570252,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570253
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570253,
					"content": "那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570254
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570254,
					"content": "我要回家了，叔叔阿姨再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570255
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570255,
					"content": "再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570256,
						741570257
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570256,
					"content": "這樣就好了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570258,
					"content": "這個場景我想像過很多次…沒有一個比知道她過得幸福更好，這樣就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570259
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570259,
					"content": "我…不是我父親，我不打算找她現在的家庭麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570260
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570260,
					"content": "不是我故意掃興，妳不是買了一個音樂盒給她嗎？也不送了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570261
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570261,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570262
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570262,
					"content": "沒有必要了，她…看起來不缺這種東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570263
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570263,
					"content": "以後我會經常想辦法來看她的，她需要什麼我會想辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570264
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570264,
					"content": "這個盒子我送給別人吧…好歹挑了那麼久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570265
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570265,
					"content": "白頭髮的小女孩，妳喜歡禮物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570266
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570266,
					"content": "我嗎？妳要送給我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570267
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741570267,
					"content": "是的，就送給妳。讓它發揮最後一點價值吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570268
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570268,
					"content": "阿托斯，抱歉，我們還要在楓丹廷逗留一陣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570269
					],
					"speakerTitle": "莫蒂西婭"
				},
				{
					"id": 741570269,
					"content": "沒關係，去哪裡對我來說都一樣。走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570270
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570270,
					"content": "#{F#妳}{M#你}們目送他們兩人走出這條街，勒魯瓦一家的故事就此結束。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570257,
					"content": "不打算讓她知道？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570258
					]
				},
				{
					"id": 741570222,
					"content": "伯努瓦怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570223
					]
				},
				{
					"id": 741570223,
					"content": "這個世界上充滿了不均衡——過度的貧乏和過度的貪婪——楓丹的律法沒能施予的懲罰，就由我們自己施予吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570224
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570224,
					"content": "我的意思是，他去他該去的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570225
					],
					"speakerTitle": "阿托斯"
				},
				{
					"id": 741570208,
					"content": "忘記了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570209
					]
				},
				{
					"id": 741570209,
					"content": "#喔，好吧…那太遺憾了，唉…看來我再也沒有機會讓勒魯瓦先生知道了。那我帶過來的泡泡桔…還是送給{F#妳}{M#你}們好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570210,
					"content": "沒見過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570211
					]
				},
				{
					"id": 741570211,
					"content": "喔…那太可惜了，我應該再也見不到勒魯瓦先生了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570212
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570212,
					"content": "#我帶了泡泡桔過來，本來覺得說不定可以見到勒魯瓦先生，但既然他不住在這裡了，這些桔子就給{M#哥哥姐姐}{F#姐姐們}好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570213
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570213,
					"content": "不管怎麼說，我想我會一直記得勒魯瓦先生的。再見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570214
					],
					"speakerTitle": "茉莉"
				}
			]
		},
		{
