			"dialogs": [
				{
					"id": 741570301,
					"content": "此屋待售。價格實惠，欲購從速。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570302
					],
					"speakerTitle": "房屋出售資訊"
				},
				{
					"id": 741570302,
					"content": "#{NICKNAME}{M#哥哥}{F#姐姐}，還有派蒙姐姐，{F#妳}{M#你}們是來找勒魯瓦先生的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570303,
						741570305
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570303,
					"content": "伯努瓦在家嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570304
					]
				},
				{
					"id": 741570304,
					"content": "不在這裡，爸爸說勒魯瓦先生不會再住在這裡了，他住到地下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570308,
					"content": "灰河？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570309
					]
				},
				{
					"id": 741570309,
					"content": "是我們之前去過的那個灰河嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741570310,
					"content": "那個的話，不是的，爸爸是說更地下的地下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570311
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570311,
					"content": "《蒸汽鳥報》上說，勒魯瓦先生爬山的時候從很高的地方摔下來，摔了一個大跤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570312
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570312,
					"content": "其實我不是很懂摔了個大跤和搬家之間有什麼關係…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570313
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570313,
					"content": "對了，我剛剛來的時候見到女婿叔叔了，還有一個非常好心的大姐姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570314
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570314,
					"content": "大姐姐很喜歡我，她的眼睛和我一樣，都是紫色的呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570315
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570315,
					"content": "她還問了我家住在哪裡，說有空會去看望我、做我的好朋友——果然勒魯瓦先生一家都是很好的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570316
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570316,
					"content": "唉…本來帶了泡泡桔過來想送給勒魯瓦先生的，現在他不在這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570317
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570317,
					"content": "#{M#哥哥姐姐}{F#姐姐們}，我送給{F#妳}{M#你}們好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570318
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570318,
					"content": "謝謝妳，小茉莉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741570319,
					"content": "不用客氣！爸爸媽媽說對待朋友要慷慨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570320
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570320,
					"content": "今天我又做了一件好事，回家之後我就把它寫到日記裡面去，開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570321
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570321,
					"content": "#{F#妳}{M#你}目送快樂的茉莉走出這條街，勒魯瓦一家的故事就此結束。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 741570305,
					"content": "只是正好路過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741570306
					]
				},
				{
					"id": 741570306,
					"content": "#我剛才在想要不要告訴{M#哥哥姐姐}{F#姐姐們}勒魯瓦先生搬家了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570307
					],
					"speakerTitle": "茉莉"
				},
				{
					"id": 741570307,
					"content": "爸爸說勒魯瓦先生不會再住在這裡了，他住到地下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741570308
					],
					"speakerTitle": "茉莉"
				}
			]
