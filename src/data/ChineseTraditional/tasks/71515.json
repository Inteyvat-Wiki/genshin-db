			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151501",
							"2"
						],
						"stepId": 7151501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"和聲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715150101,
					"content": "「港內北碼頭現有演出。」唔，這個通知也寫得太模糊了吧，既沒說是什麼演出，也沒說是誰演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150102,
					"content": "我們還是自己找找演出的地方吧，實在不行，還可以問路人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150103,
					"content": "那裡有好多人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150104
					]
				},
				{
					"id": 715150104,
					"content": "啊，我看到了。這麼多人都聚集在這裡，說不定就是來看演出的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150105,
					"content": "我們去問問看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 7151502,
			"completionStepIds": [
				7151502
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7151502",
							"2"
						],
						"stepId": 7151502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"慶興"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715150201,
					"content": "「如意康寧，平安吉慶…♪」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150202
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150202,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150203
					]
				},
				{
					"id": 715150203,
					"content": "請問這裡是不是馬上要有演出啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150204,
					"content": "#對呀，馬上就要演紙映劇了，{F#妳}{M#你}們也是來看紙映劇的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150205,
						715150206
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150205,
					"content": "原來這場戲叫《紙映劇》。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150207
					]
				},
				{
					"id": 715150207,
					"content": "不是啦，紙映劇和璃月戲不是一回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150208
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150208,
					"content": "慶興慶興，戲快開場了，你們別說話了，會影響大叔表演的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150209
					],
					"speakerTitle": "和聲"
				},
				{
					"id": 715150209,
					"content": "#哦哦，紙映劇什麼樣，反正{F#妳}{M#你}們兩個看了就知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150210
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150210,
					"content": "…列位小看官們，咱們今天演的是虯髯公的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150211
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150211,
					"content": "話說在前頭，有想上廁所的，要買糖水的，大可先去。待到角兒們出場，戲就不等人囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150212
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150212,
					"content": "（所以這齣戲叫《虯髯公》，是完全沒聽說過的故事欸。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150213,
					"content": "噓，就算小聲說話，我們還是聽得到，妳安安靜靜聽啦，後面點戲的時候才可以說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150214
					],
					"speakerTitle": "和聲"
				},
				{
					"id": 715150214,
					"content": "唔…對不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150215,
					"content": "點戲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150216
					]
				},
				{
					"id": 715150216,
					"content": "虯髯公的故事特別長，全都演完就太長了，所以每次大叔都會讓大家選想看哪個部分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150217
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150217,
					"content": "慶興！我聽不清大叔念戲文了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150218
					],
					"speakerTitle": "和聲"
				},
				{
					"id": 715150218,
					"content": "哦哦，這次我真的不插嘴了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150219
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150219,
					"content": "看官們，今天大家想品鑑《全本虯髯公》裡的哪段故事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150220
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150220,
					"content": "是想看《投山》呢？還是《拜仙》？是《縛鬼》還是《登天》？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150221
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150221,
					"content": "只有小看官們報不出名兒的，沒有我不會演的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150222
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150222,
					"content": "我想看虯髯公和妖魔打架，他特別帥，每次都能贏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150223
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150223,
					"content": "《拜仙》和《縛鬼》都看了好多遍了，你不膩嗎？我選虯髯公回家看妹妹那段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150224
					],
					"speakerTitle": "和聲"
				},
				{
					"id": 715150224,
					"content": "虯髯公還有妹妹嗎？我怎麼不知道，這個我沒看過欸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150225
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150225,
					"content": "這位小看官是行家啊，《奔鄉》這段啊點的人不多，不是老劇迷都不知道有這出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150226
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150226,
					"content": "好，恰逢海燈佳節，咱們不演什麼妖魔鬼怪，來看看有情人怎麼終成眷屬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150227
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150227,
					"content": "這一場上要出現的角兒有三人，除了咱們的熟面孔虯髯公，還有一位伶仃孤女，名叫意冰，一位志誠君子，喚作南風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150228
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150228,
					"content": "#{NICKNAME}，{F#妳}{M#你}聽明白了嗎？我怎麼還是雲裡霧裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150229,
					"content": "現在要演的，好像是一個叫虯髯公的人的事？但聽起來，除了男主角，還有其他配角啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150230,
					"content": "可我們面前只有一個演員…呃，還有一架…屏風？這怎麼演戲啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150231,
					"content": "哎呀，這兒有個人沒看過紙映劇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150232
					],
					"speakerTitle": "和聲"
				},
				{
					"id": 715150232,
					"content": "哦？後面一位小看官問了，我應公只有人一個，又沒有分身化形的本事，這戲怎麼演呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150233
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150233,
					"content": "您有所不知，我們這紙映劇雖不及璃月戲講究，也自有一番特色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150234
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150234,
					"content": "演璃月戲的那些個角兒們都是血肉之軀，但咱們紙映劇的演員卻是紙糊絹裱的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150235
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150235,
					"content": "人家的戲臺是木頭搭的，咱們的戲臺是一張薄紙蒙在木架子上，說來說去都是紙，所以叫做紙映劇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150236
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150236,
					"content": "旁白是我，演戲的卻不是我，您一會兒就能見到那三位紙演員啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150237
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150237,
					"content": "#大叔，他們應該也不認識虯髯公，給{M#他們}{F#她們}說說虯髯公的事行不行，就是每次開頭都有的那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150238
					],
					"speakerTitle": "和聲"
				},
				{
					"id": 715150238,
					"content": "那個叫定場話，我也喜歡聽，大叔給我們念念吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150239
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150239,
					"content": "定場話！定場話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150240
					],
					"speakerTitle": "和聲"
				},
				{
					"id": 715150240,
					"content": "如此聽了，雄心欲把天綱正，無奈人間鬼氣高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150241
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150241,
					"content": "只說一位公子桓光，受盡人間不平氣，投入山川蒼莽間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150242
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150242,
					"content": "機緣巧合，他拜入一位仙人座下，便改換了形貌，蓄起一部烏黑鬍鬚，號稱虯髯公。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150243
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150243,
					"content": "他奉仙人之命，一劍東來，把那魑魅蕩平，唬得魍魎屏跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150244
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150244,
					"content": "虯髯公輾轉修行多年，終於得悟大道，正待要返歸仙家洞府時，才由仙人點撥，憶起前塵往事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150245
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150245,
					"content": "原來他塵緣未盡，家中尚有一妹。可憐妹子意冰如今孤苦伶仃，無可依靠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150246
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150246,
					"content": "她本以為兄長這一生襟抱送淒涼，如何能想到不日舊人返歸鄉。欲知後事如何…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150247
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150247,
					"content": "馬上為您分解！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150248
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150248,
					"content": "好欸！別愣著啊，這裡該鼓掌了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150249,
						715150250
					],
					"speakerTitle": "和聲"
				},
				{
					"id": 715150249,
					"content": "好！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715150251
					]
				},
				{
					"id": 715150251,
					"content": "什麼時候鼓掌也有規定嗎？好、好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 715150252,
					"content": "多謝捧場。話說到這裡，本該請出演員開戲，但我看這兩位還有些疑惑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150253
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150253,
					"content": "我看不如請兩位看官上前來，與我做個幫手，指揮佈景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150254
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150254,
					"content": "#既能讓您兩位看個清楚明白，也能幫助演員在這方寸舞臺上前行。{F#妳}{M#你}們意下如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150255
					],
					"speakerTitle": "應公"
				},
				{
					"id": 715150255,
					"content": "哇，怎麼不叫我，我很熟悉紙映劇的，叫我叫我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715150256
					],
					"speakerTitle": "慶興"
				},
				{
					"id": 715150256,
					"content": "你都上去過多少回了，別起哄了，好好看。",
