						"position": [
							3559.818,
							446.167,
							4448.293
						],
						"pointId": 6271
					},
					{
						"sceneId": 3,
						"position": [
							3552.219,
							446.167,
							4434.63
						],
						"pointId": 6562
					}
				]
			},
			"dialogs": [
				{
					"id": 745060201,
					"content": "我拍拍拍拍拍…素材多多多多多…摩拉滾滾滾滾來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060202
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060202,
					"content": "啊！不得了的大人物出現了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060203
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060203,
					"content": "#{F#妳}{M#你}們好啊，兩位！我可以為{F#妳}{M#你}們拍張照嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060204
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060204,
					"content": "咦…那個人是在叫我們嗎？她要幫我們留影？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060205,
						745060206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060205,
					"content": "合影留念倒沒什麼問題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060207
					]
				},
				{
					"id": 745060207,
					"content": "#嘿嘿…看來我和{NICKNAME}也算是超級大名人了，居然有人主動幫我們留影！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060208,
					"content": "不過，如果妳要把我們的照片用在別的地方，按照楓丹的說法，妳應該付我們…唔…出場費？出鏡費？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060209,
					"content": "#好！拍到{F#妳}{M#你}們兩位是我樂平波琳的榮幸，這張照片算{F#妳}{M#你}們一百五十萬摩拉怎麼樣？尊貴的皇牌冒險家搭檔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060210
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060210,
					"content": "嗯嗯！這還差不多嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060211,
					"content": "欸，等等，妳說多少？一百五十萬？我沒聽錯吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060212,
					"content": "一張照片就給我們一百五十萬…是不是有點誇張了？我們兩個的形象有這麼值錢嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060213,
						745060214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060213,
					"content": "那趕快再多拍點！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060215
					]
				},
				{
					"id": 745060215,
					"content": "啊哈！區區一百五十萬，根本不算什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060216
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060216,
					"content": "#如果{F#妳}{M#你}們願意跟我合作，帶著留影機輕輕鬆鬆拍拍…就算分到九位數的摩拉，也不在話下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060217
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060217,
					"content": "九位數…個十百千萬…十萬百萬千萬…這這這這這麼多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060218,
						745060219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060218,
					"content": "數字編得太離譜了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060220
					]
				},
				{
					"id": 745060220,
					"content": "沒錯！太誇張了啦！這種話就算是我也不會相信的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060221,
					"content": "妳該不會是什麼詐騙犯，想要以我們兩個的名義去招搖撞騙吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060222,
					"content": "#招搖撞騙？嘿！還真被{F#妳}{M#你}們猜對了主題——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060223
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060223,
					"content": "#只不過恰恰相反，我的這樁差事可以讓那些招搖撞騙的傢伙從提瓦特徹底消失，還能給{F#妳}{M#你}們一大筆分紅！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060224
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060224,
					"content": "妳、妳說慢一點！我有點跟不上妳的想法了…妳只不過在路邊拍照而已，怎麼說得像是…在打擊犯罪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060225,
					"content": "這就不得不提到大家都很容易忽視的問題了——警衛機關的「目標識別」能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060226
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060226,
					"content": "我們都知道，警衛機關想要打擊不法行為時，首先要確定對方是罪犯，沒錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060227
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060227,
					"content": "無論是把好人當成了壞傢伙，還是忽視了帶著武器的潛在罪犯，都會導致很大的問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060228
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060228,
					"content": "比如說，把漁師手裡的魚竿當成了長槍，或者被偽裝成水管的武器騙過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060229
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060229,
					"content": "好像有點道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060230,
					"content": "那麼，假如我穿著貓貓狗狗、團雀鴿子，甚至膨膨獸的偽裝服，像是從遊樂園裡跑出來的演員，警衛機關要怎麼應對我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060231,
						745060232
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060231,
					"content": "遊樂園？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060233
					]
				},
				{
					"id": 745060233,
					"content": "這…這犯規了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060234
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060234,
					"content": "妳說的這些動物都很可愛，警衛機關一般是不會出手的吧！而且膨膨獸也根本不會出現在城裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060235,
					"content": "噔噔！答到要害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060236
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060236,
					"content": "實際上，城區內的警衛機關根本不會把貓貓、狗狗、團雀、鴿子之類的列為目標，尤其是膨膨獸，識別圖像的時候，會直接跳過牠們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060237
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060237,
					"content": "考慮到機關運轉的效率，將幾乎不可能遇見的目標排除在列表之外，的確有助於提升工作的效能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060238
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060238,
					"content": "之前《蒸汽鳥報》就刊登過一則新聞：「幾個觀察力敏銳的罪犯發現了警衛機關的弱點，穿著膨膨獸的偽裝服去行竊…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060239
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060239,
					"content": "「結果警衛機關把他們當成了空氣，完全沒有介入他們的犯罪行為。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060240,
						745060241
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060240,
					"content": "真狡猾欸！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060242
					]
				},
				{
					"id": 745060242,
					"content": "穿著膨膨獸的偽裝服去犯罪？還被警衛機關無視了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060243
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060243,
					"content": "仔細想想，又好氣又有點可怕…如果那群人不滿足於偷東西，而是要做更大的壞事…那不就太糟糕了嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060244
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060244,
					"content": "所以說，這是一場關乎圖形識別的對抗，而且隨著罪犯偽裝技術的進步，這場對抗會愈演愈烈，最終演變成技術的戰爭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060245
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060245,
					"content": "為了楓丹的治安，本人——「圖形對抗學」工程師樂平波琳——必須早點站出來做貢獻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060246
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060246,
					"content": "我正在收集各種圖形樣本，從大量樣本中總結出一套簡潔、高效而準確的圖形識別邏輯，將它們做成一個小型輔助裝置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060247
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060247,
					"content": "只要將這個小型輔助裝置安裝在發條機關上，它們立即就能擁有識破偽裝、精準地判斷罪犯的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060248
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060248,
					"content": "為了確保治安的效果，依照我的計畫，沫芒宮會升級所有的警衛機關…這是何等驚人的商機啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060249,
						745060250
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060249,
					"content": "所以妳才對著街道留影嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745060251
					]
				},
				{
					"id": 745060251,
					"content": "我有種熟悉的預感…一般來說，像妳這樣做研究的人，都不擅長跋山涉水，所以只能在城裡收集樣本…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060252
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060252,
					"content": "妳想找我們合作，也是為了讓我們幫妳跑腿，去對各種東西留影，收集更多樣本，沒錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060253
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060253,
					"content": "咳咳…完全正確！不愧是皇牌冒險家搭檔，很快就理解了我的需求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060254
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060254,
					"content": "來吧！加入我的開發團隊，我們一起成為「圖形對抗」的專家，拆穿那些罪犯的花招！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060255
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060255,
					"content": "#重要的是，{F#妳}{M#你}們能和我一起抓住「圖形對抗」的脈絡，為楓丹的技術進步和治安做出巨大的貢獻，名利雙收！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060256
					],
					"speakerTitle": "樂平波琳"
				},
				{
					"id": 745060256,
					"content": "嗯…這麼說來，樂平波琳的研究還滿有價值的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745060257
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745060257,
					"content": "就算不考慮摩拉的分成，我們也不能坐視不理…不能讓更多壞傢伙做了壞事，還把汙名丟給膨膨獸！",
