				"objectNames": [
					"梵米爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060601,
					"content": "#{F#妳}{M#你}找到了畫材了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060602
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060602,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060603
					]
				},
				{
					"id": 710060603,
					"content": "果然是我忘在取景的地方了，我每次畫畫的時候都習慣把用過的東西放在地上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060604
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060604,
					"content": "#有時候走得太急，就會落下很多東西，謝謝{F#妳}{M#你}，不然我肯定又要回去城裡重新買畫材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060605
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060605,
					"content": "你還要在這畫畫嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060606
					]
				},
				{
					"id": 710060606,
					"content": "別提了，我聽人家說，這兩尊雕像的雙眼本來是可以發光的，在很遠的地方都能看見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060607
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060607,
					"content": "雙目炯炯的巨像，佇立在山崖旁…這絕對是一幅好畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060608
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060608,
					"content": "結果我到這裡來了之後，雕像是看見了，但是壓根沒什麼發光的眼睛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060609
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060609,
					"content": "我以為是我錯過了什麼特殊的時機，或者角度不對，所以才一直在這裡四處取景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060610
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060610,
					"content": "但是…唉，無論我怎麼取景，都沒有一點頭緒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060611
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060611,
					"content": "我唯一的收穫，就是從下面的池子裡找到了這個東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060612
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060612,
					"content": "呃…我也找到了一個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060613
					]
				},
				{
					"id": 710060613,
					"content": "咦？我看看，還真是，看上去一模一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060614
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060614,
					"content": "真奇怪，這後面還刻著字呢，連起來讀應該是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060615
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060615,
					"content": "「石官掩柴門，欲入需點睛」…點睛？什麼意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060616
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060616,
					"content": "#這塊石頭我拿著也沒什麼用，就送給{F#妳}{M#你}吧，算是{F#妳}{M#你}幫我找畫材的謝禮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060617
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060617,
					"content": "#對了，我有個小想法啊，我瞎說的，{F#妳}{M#你}覺不覺得，這兩塊石頭像是眼睛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060618
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060618,
					"content": "如果真是眼睛的話，那句謎語裡說的「點睛」，會不會也和這兩塊石頭有關？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060619
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060619,
					"content": "#哈哈哈，這也就是我瞎說的，{F#妳}{M#你}別在意啊。我要接著去取景了，謝謝{F#妳}{M#你}幫我找畫材。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米爾"
				}
			]
		},
