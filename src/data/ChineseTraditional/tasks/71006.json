			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"梵米爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060101,
					"content": "糟糕了，這還怎麼畫畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060102
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060103
					]
				},
				{
					"id": 710060103,
					"content": "你…哦，是旅行者啊。是這樣，我一直在這個淥華池周圍取材，想要畫幾幅好畫帶回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060104
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060104,
					"content": "但是我一直找不到好角度，所以一直沒畫出什麼滿意的畫來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060105
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060105,
					"content": "而且因為我太專心取景，走到這裡才發現，我的畫筆和顏料都不見了一大半。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060106
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060106,
					"content": "#我想這些東西一定是落在了我之前畫畫的地方，能請{F#妳}{M#你}幫我找找看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060107,
						710060110
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060107,
					"content": "你在哪裡畫過畫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060108
					]
				},
				{
					"id": 710060108,
					"content": "呃，其實…我也記不太清楚了，因為我每次都太專注於畫畫，不會怎麼留意周圍，具體的位置是記不清了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060109
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060109,
					"content": "不過，我在這周圍只畫了兩幅畫，我想應該也只可能在那兩個地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060113,
					"content": "#這兩幅畫給{F#妳}{M#你}，我的畫材應該就在畫這兩幅畫時的<color=#00E1FFFF>取景位</color>上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060114
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060114,
					"content": "找到了之後，就拿回來給我吧，我還要在這裡再看看…一定有更好的角度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060110,
					"content": "可是，去哪裡找…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060111
					]
				},
				{
					"id": 710060111,
					"content": "我每次都太專注於畫畫，不會怎麼留意周圍，具體的位置是記不清了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060112
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060112,
					"content": "但我在這周圍只畫了兩幅畫，我想應該也只可能在那兩個地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060113
					],
					"speakerTitle": "梵米爾"
				}
			]
		},
