					"nextDialogs": [
						710060704
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060704,
					"content": "我是在<color=#00E1FFFF>淥華池裡</color>取景的時候撿到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060705
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060705,
					"content": "#怎麼，{F#妳}{M#你}也要去<color=#00E1FFFF>淥華池裡</color>找找嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060706
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060706,
					"content": "#那{F#妳}{M#你}可得找仔細一點了，那個池子裡亂七八糟的東西可多了，也不知道是誰丟在裡面的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米爾"
				}
			]
