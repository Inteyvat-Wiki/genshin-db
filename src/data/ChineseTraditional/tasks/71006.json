			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梵米爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710060201,
					"content": "#{F#妳}{M#你}找到了畫材了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060202
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060202,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060203
					]
				},
				{
					"id": 710060203,
					"content": "果然是我忘在取景的地方了，我每次畫畫的時候都習慣把用過的東西放在地上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060204
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060204,
					"content": "#有時候走得太急，就會落下很多東西，謝謝{F#妳}{M#你}，不然我肯定又要回去城裡重新買畫材了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060205
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060205,
					"content": "你還要在這畫畫嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710060206
					]
				},
				{
					"id": 710060206,
					"content": "別提了，我聽人家說，這兩尊雕像的眼睛本來是可以發光的，在很遠的地方都能看見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060207
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060207,
					"content": "目光炯炯的巨像，佇立在山崖旁…這絕對是一幅好畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060208
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060208,
					"content": "結果我到這裡來了之後，雕像是看見了，但是壓根沒什麼發光的眼睛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060209
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060209,
					"content": "我以為是我錯過了什麼特殊的時機，或者角度不對，所以才一直在這裡四處取景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060210
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060210,
					"content": "但是…唉，無論我怎麼取景，都沒有一點頭緒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060211
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060211,
					"content": "我唯一的收穫，就是從下面的池子裡找到了這個東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060212
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060212,
					"content": "雖然弄不懂是做什麼的，但我越看這塊石頭，就越覺得像是眼睛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060213
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060213,
					"content": "不過如果真是眼睛的話，說不定還有一塊類似的石頭，畢竟，人是有兩隻眼睛的嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060214
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060214,
					"content": "#哎呀，這也就是我瞎想的，{F#妳}{M#你}別在意。這塊石頭我拿著也沒什麼用，就送給{F#妳}{M#你}吧，就算是{F#妳}{M#你}幫我找畫材的謝禮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710060215
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710060215,
					"content": "唉，眼睛會發光的雕像…這片淥華池裡，到底會有什麼秘密呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米爾"
				}
			]
		},
