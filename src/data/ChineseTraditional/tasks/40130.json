			"dialogs": [
				{
					"id": 401300501,
					"content": "又到了這裡，已經是「特爾克西」旅程的最後一段了，卻少了最重要的人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401300502
					],
