			},
			"dialogs": [
				{
					"id": 741930101,
					"content": "#派蒙！{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930102
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930102,
					"content": "哇！居然是珀西芙！又見到妳了，真高興！妳在這裡做什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930103,
					"content": "珀西芙…工作！珀西芙…累累！珀西芙…躺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930104
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930104,
					"content": "呃…？妳在工作？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930105,
					"content": "幽林枝…幽林枝…十分很丟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930106
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930106,
					"content": "幽林枝？那是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930107,
					"content": "幽林枝…資訊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930108
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930108,
					"content": "垂柳，收集。霧道，處理。泉眼，發送。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930109
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930109,
					"content": "幽林枝，霧道資訊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930110
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930110,
					"content": "那是幽林霧道的資訊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930111
					]
				},
				{
					"id": 741930111,
					"content": "珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930112
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930112,
					"content": "幽林枝…十分很丟！十分很多地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930113
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930113,
					"content": "珀西芙…找！珀西芙…累累！珀西芙…吃！珀西芙…躺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930114
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930114,
					"content": "幽林枝…十分很不多！但是箱子，十分很多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930115
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930115,
					"content": "#啊…謝謝派蒙，謝謝{NICKNAME}，來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930116
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930116,
					"content": "妳又幫我們找到寶箱了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930117
					]
				},
				{
					"id": 741930117,
					"content": "珀西芙！箱子，寶貝，花花，閃閃，甜甜，十分很多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930118
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930118,
					"content": "哇！還有別的東西嗎？珀西芙，妳真善良，但如果白白拿妳的東西就太不好意思了，不如我們來交換吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930119,
					"content": "交…換？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930120
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930120,
					"content": "因為我們是朋友，朋友就是用真心交換真心的那種！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930121,
					"content": "所以我們去幫妳找那個幽林枝，然後來跟妳交換東西，妳覺得好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930122,
					"content": "還可以找一點吃的給妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930123
					]
				},
				{
					"id": 741930123,
					"content": "對哦！珀西芙一個人在外面應該很辛苦，我們可以幫她找吃的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930124,
					"content": "吃的！汐藻！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930125
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930125,
					"content": "妳喜歡吃汐藻？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930126
					]
				},
				{
					"id": 741930126,
					"content": "汐藻！汐藻！汐藻汐藻汐藻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930127
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930127,
					"content": "一天吃五頓？還是一頓吃五個？嗚哇…感覺比我還能吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930128,
					"content": "那幽林枝呢？珀西芙，是不是去幽林霧道就可以找到了呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930129,
					"content": "美露莘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930130
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930130,
					"content": "幽林枝…十分很丟！十分很多地方！十分伊黎耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930131
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930131,
					"content": "幽林枝在整個伊黎耶？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741930132
					]
				},
				{
					"id": 741930132,
					"content": "#聰明{NICKNAME}！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930133
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930133,
					"content": "霧道，有花花，幽林枝，也花花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930134
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930134,
					"content": "幽林枝…幽林枝…幽林枝…幽林枝…幽林枝…幽林枝…數量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930135
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930135,
					"content": "啊…這次我一下就聽懂了！幽林枝在的地方，長著和幽林霧道一樣的花，一共有六個地方，是這樣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930136,
					"content": "聰明派蒙！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930137
					],
					"speakerTitle": "珀西芙"
				},
				{
					"id": 741930137,
					"content": "嘿嘿，這下子我們就都清楚了！珀西芙，那妳就先好好休息，這件事包在我們身上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741930138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741930138,
					"content": "#派蒙，{NICKNAME}，好東西！所以，慢慢…慢慢！珀西芙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珀西芙"
				}
			]
