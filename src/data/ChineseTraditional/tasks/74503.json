				"points": []
			},
			"dialogs": [
				{
					"id": 745030101,
					"content": "#兩位貴客，又見面了。雖然才分開一下子，但我都開始有點想{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030102
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745030102,
					"content": "你真的是很油嘴滑舌耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745030103,
					"content": "真傷心，被討厭了。我看我還是好好工作吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030104
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745030104,
					"content": "我先說明，這次的資料收集分為兩大部分，我和阿爾貝分別負責其中之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030105
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745030105,
					"content": "我這裡的資料收集，是為了模擬決鬥代理人的靈敏度，所以需要貴客完成一些水下的模擬衝刺活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030106
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745030106,
					"content": "原來決鬥代理人是要在水下訓練的啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745030107,
					"content": "誰知道呢？反正我也不認識決鬥代理人，老闆大概也不認識，但他覺得這樣比較酷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030108
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745030108,
					"content": "他本來還想在玩具的手臂內設置十種噴水機關，噴起水來咻咻咻的，不過因為成本太高放棄了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030109,
						745030110
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745030109,
					"content": "真的很酷。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030111
					]
				},
				{
					"id": 745030111,
					"content": "楓丹畢竟是水的國度，要想遠銷異國，呈現一點楓丹特色還是比較好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030112
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745030112,
					"content": "總之，具體的注意事項，我們準備了一份手冊，兩位貴客稍後可以看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030113
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745030113,
					"content": "怎麼樣？是不是已經躍躍欲試了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745030114
					],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745030114,
					"content": "我準備一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030115
					]
				},
				{
					"id": 745030115,
					"content": "沒問題，場地那邊已經佈置好了資料收集的儀器，所以這些就不用兩位貴客費心了，只要專注地完成挑戰就可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿爾邦"
				},
				{
					"id": 745030110,
					"content": "小孩子才覺得酷吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745030111
					]
				}
			]
		}
	]
}