			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210101,
					"content": "旅行者，派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210102
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210102,
					"content": "剛才九條裟羅來了，就在那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210103
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210103,
					"content": "她這去而復返的樣子，是真的對我們放心不下吧…警惕心很重呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210104,
					"content": "是認真負責的表現啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210105
					]
				},
				{
					"id": 400210105,
					"content": "情況有些複雜，我們先去跟她溝通吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				}
			]
		},
		{
			"id": 4002102,
			"completionStepIds": [
				4002102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002102",
							"2"
						],
						"stepId": 4002102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"九條裟羅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210201,
					"content": "#三位，這段時間有勞{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210202
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 400210202,
					"content": "我帶人手過來了，可以說，最危急的時刻已然過去。之後，我們只需扼守這條要道就能有效防備魔物，如有逃竄者，也可將它們封堵在荒海一帶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210203
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 400210203,
					"content": "先前我聽見秘境內有巨大的響聲，恐怕這裡面有大量機關…我們正在籌備，打算等一個合適的時機舉兵攻入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210204
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 400210204,
					"content": "你們不打算駐紮在離秘境更近的地方嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210205,
					"content": "上次行動時，武士們沒想到要跟秘境保持足夠的距離。魔物突襲，他們只能倉皇後撤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210206
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 400210206,
					"content": "一次是意外，兩次是失誤。我不會允許這種事再次發生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210207
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 400210207,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210208,
					"content": "（正好，給了我們機會。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210209
					]
				},
				{
					"id": 400210209,
					"content": "稍後我將返回九條陣屋，統籌其他地區的防務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210210
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 400210210,
					"content": "雖然來得晚了些，但天領奉行已接手這裡，感謝三位鼎力相助。承諾的報酬，我也記著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210211
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 400210211,
					"content": "辛焱小姐，請拿著這封信，裡面有我親自為妳開具的「通行憑證」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210223
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 400210223,
					"content": "我為妳申請了最長的停留時限，希望妳能利用這段時間在稻妻好好遊覽一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210212
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 400210212,
					"content": "此外我還為妳安排了食宿，等回到城裡，妳直接照信中指示前往下榻處即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210213
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 400210213,
					"content": "天哪！這得算天降橫財了吧？食宿全免，暢遊稻妻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210214
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210214,
					"content": "不必客氣，理應如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210215
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 400210215,
					"content": "謝謝妳啦。看妳最近這麼忙，也不知道什麼時候才能閒下來…要是妳休假時我還在稻妻，請來看看我的街頭演出吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210216
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210216,
					"content": "實不相瞞，我對詩歌音律興趣不大。但妳幫了天領奉行許多，我想…有機會的話，我會去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210217
					],
					"speakerTitle": "九條裟羅"
				},
				{
					"id": 400210217,
					"content": "這麼一來，辛焱最操心的事就解決啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210218,
					"content": "不不，最讓人操心的是「式大將」才對吧！接下來就無關我的個人利益了…作為朋友，我還得回去幫它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210219
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210219,
					"content": "還有那位小哥，旅行者，我們肯定得去救他吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210220,
						400210221
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210220,
					"content": "雖然他應該不會有事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210222
					]
				},
				{
					"id": 400210222,
					"content": "那走吧，我們偷偷去找「式大將」會合！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210221,
					"content": "但也不能放著不管。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210222
					]
				}
			]
		},
		{
			"id": 4002103,
			"completionStepIds": [
				4002113
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002113",
							"2"
						],
						"stepId": 4002113,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「式大將」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210301,
					"content": "辛焱，旅行者，派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210302
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210302,
					"content": "剛才有位女將領帶著一些人手到這附近偵察。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210303
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210303,
					"content": "她是天領奉行的人，九條裟羅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210304,
					"content": "九條裟羅…天領奉行有這麼一號人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210305
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210305,
					"content": "我似乎聽說過天領奉行主將的名字，是一位男性，叫九條…呃，什麼來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210306
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210306,
					"content": "有些記不清了，但我想起了一些瑣事。我記得，晴之介和那位天領奉行的主將下過棋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210307
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210307,
					"content": "這個晴之介，莫非還是個有頭有臉的人物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210308,
					"content": "閒話稍後再說吧，趁沒人發現，我們趕緊溜到陰陽寮裡去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210309
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210309,
					"content": "對哦，還要找那個走失的傢伙呢！快走快走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210310,
					"content": "好，各位，請隨我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「式大將」"
				}
			]
		},
		{
			"id": 4002105,
			"completionStepIds": [
				4002105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002105",
							"2"
						],
						"stepId": 4002105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210501,
					"content": "哇！你在這裡啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210502,
					"content": "喲，都來了嗎。讓我等了好久啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210503
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210503,
					"content": "你們錯過了一場好戲，實在可惜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210504
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210504,
					"content": "這傢伙，狀態看起來還不錯嘛，看來沒受傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210505,
					"content": "嗯？你們擔心我了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210506,
						400210508
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210506,
					"content": "並沒有。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210507
					]
				},
				{
					"id": 400210507,
					"content": "看來你很信得過我的實力啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210510
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210510,
					"content": "#作為夥伴兼老對手，{F#妳}{M#你}一定知道的，這種出其不意的戰鬥場合最合我胃口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210511
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210511,
					"content": "秘境重組期間，房間會上下移動，魔物也被帶著四處亂竄。嗯！這幾天，我打得很盡興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210512
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210512,
					"content": "還找到一些「拓本」，就是「式大將」需要的那種。裡面應該藏有它的記憶和力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210513
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210513,
					"content": "正所謂來得早不如來得巧，趕快回收它們吧，「式大將」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210508,
					"content": "只有一點點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210509
					]
				},
				{
					"id": 400210509,
					"content": "#真的？能讓{F#妳}{M#你}操一點心，我還是挺有面子的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210510
					],
					"speakerTitle": "「公子」"
				}
			]
		},
		{
			"id": 4002108,
			"completionStepIds": [
				4002108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002108",
							"2"
						],
						"stepId": 4002108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「式大將」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210801,
					"content": "這座房間已經非常接近陰陽寮的最深處了。我記得…我和晴之介在這裡停留了很久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210802
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210802,
					"content": "我們一直在觀察那些來自稻妻各地的武人。他們喝酒慶祝時，總是高聲呼喊著：「我們也擁有戰勝強大魔物的力量了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210803
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210803,
					"content": "莫非，你和惟神晴之介，是帶著那些武士前來剷除魔物的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210804
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210804,
					"content": "有這種可能，但也不止一種可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210805
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210805,
					"content": "換句話說，那樣的景象也有可能是晴之介故意安排的。為了重新掌握失控的陰陽寮，他徵召這些武士，命令他們進入秘境剷除魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210806
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210806,
					"content": "「式大將」是在猜測達達利亞的想法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210807,
					"content": "什麼嘛，我也不是每次都往壞處想的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210808
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210808,
					"content": "只是合理全面的猜測而已，並不是要冒犯幾位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210809
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210809,
					"content": "我的記憶還不完整，但缺失的部分越來越少，應該就快要全部復原了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210810
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210810,
					"content": "而且，我有種感覺…繼續向前的話，我們說不定真會遇見晴之介。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210811
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210811,
					"content": "這座陰陽寮也不是最近才建成的吧？那他一直在裡面嗎？嗚哇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210812,
						400210813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210812,
					"content": "「式大將」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210814
					]
				},
				{
					"id": 400210814,
					"content": "#旅行者？等一下，{F#妳}{M#你}該不會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210815
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210815,
					"content": "有些話，需要由我來說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210816
					]
				},
				{
					"id": 400210816,
					"content": "看幾位嚴肅的神情…應該是有很重要的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210817
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210817,
					"content": "我說，太嚴肅也不好吧？這裡本來就有點陰森了，再這麼一來，像在內鬥一樣！還是我來說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210818,
					"content": "是這樣的，最開始，我們聽說秘境裡有魔物逃出來，就和天領奉行的武士們一起趕到這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210819,
					"content": "我們遇到你的時候，你完全不知道秘境的來歷，也不知道自己是為何而生…但我們相信那時你真的一無所知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210820
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210820,
					"content": "就算不相信你，我們也要相信辛焱。辛焱認可了你，我們就和你一起行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210821,
					"content": "嗯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210822
					]
				},
				{
					"id": 400210822,
					"content": "隨著探索，我們不斷深入秘境，眼看就要找到真相了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210873
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210873,
					"content": "可是直到現在，我們也無法確定這座秘境是不是為了某種…邪惡的目的…而被製造出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210823,
					"content": "一個箱子裡可能藏著寶藏也可能藏著災難，那我們就是到了開箱前的最後時刻呀！總不能毫無準備地打開它吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210824,
						400210825,
						400210826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210824,
					"content": "如果惟神包藏禍心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210827
					]
				},
				{
					"id": 400210827,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210828
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210828,
					"content": "我不喜歡看別人做沒有退路的選擇，但…就像旅行者說的那樣，我們確實應該做好準備，我們要對彼此負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210829
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210829,
					"content": "我明白…到我做決定的時候了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210830
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210830,
					"content": "迄今為止，我始終是帶著謎團來承受你們的幫助。即使只並肩戰鬥了短短幾天，我們之間也不該有隱瞞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210831
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210831,
					"content": "單憑目前的資訊，我不能給出保證。我想去相信晴之介，可是我不知道這些年他是不是變了，又或者我的記憶是假的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210832
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210832,
					"content": "我是「陰陽師」創造出來的「式神」，記憶殘缺不全。對如今的我而言，你們四位朋友是我能夠完全信賴、託付一切的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210833
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210833,
					"content": "我對你們是信任，對晴之介…是責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210834
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210834,
					"content": "他創造了我，我有義務跟隨他。要是如你們所說，他是個壞人，那被他所掌控，也是我的命運…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210835
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210835,
					"content": "要是可能，我想保持這顆善良的心直到最後一刻。但武器不能違背主人的意志，他能創造我，就能控制我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210836
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210836,
					"content": "如果之後我和晴之介做出了傷天害理之事，我也相信…你們會為我們安排一個合適的結局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210837
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210837,
					"content": "嗚…竟然反過來把難題拋給我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210838,
					"content": "但它意想不到地誠實呢，還說了那麼大義凜然的話！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210839
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210839,
					"content": "#{NICKNAME}，這個回答完全符合{F#妳}{M#你}的期待吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210840,
						400210841
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210840,
					"content": "嗯。「式大將」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210842
					]
				},
				{
					"id": 400210842,
					"content": "你們倆…該不會早就串通好了吧？一個扮白臉，一個扮黑臉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210843
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210843,
					"content": "#哈哈哈，不錯的手法。用這種方式「試探」「式大將」的記憶是否還有缺損…旅行者，{F#妳}{M#你}成長了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210844
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210844,
					"content": "什麼叫「試探」！我們這是有預謀的一搭一唱，一次成功的智取！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210845
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210845,
					"content": "辛焱不是說過嗎？她會用她的方式確認同伴是否可信，我們也有我們的辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210846
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210846,
					"content": "而且，趁著現在說，還能幫「式大將」打打氣呢！讓它知道，就算它還很迷茫，我們也願意信任它，願意跟它一起前進！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210847
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210847,
					"content": "假如「式大將」真是夥伴，就不會太快就選擇陣營。只有老實說出自身存在的威脅，才是對同伴負責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210848
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210848,
					"content": "我能感知到真誠。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210849
					]
				},
				{
					"id": 400210849,
					"content": "#我不擅長撒謊…謝謝{F#妳}{M#你}能感受到我的真心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210850
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210850,
					"content": "好人也會有欺騙他人、利用他人的時候，反之，壞人也會有顧慮和牽掛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210851
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210851,
					"content": "能說出對自己而言無比殘忍的答案…你確實做好了覺悟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210852
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210852,
					"content": "就像辛焱說的，呃…怎麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210853
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210853,
					"content": "哪句啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210854
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210854,
					"content": "想起來了想起來了！「這種語言非常誠實，只會觸動人心底最真誠的部分」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210855
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210855,
					"content": "隻字不差，真虧妳記得這麼牢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210856
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210856,
					"content": "所以，我們的戰前動員會開完了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210857
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210857,
					"content": "開完了就走吧，速戰速決！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210858
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210858,
					"content": "「式大將」，別太擔心，我們都在你身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210859
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210859,
					"content": "我明白。我會全力以赴，不給你們添麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210860
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210860,
					"content": "添一點也沒關係啦！只要我們能贏就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210861
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210861,
					"content": "只要打贏關鍵的一戰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210862
					]
				},
				{
					"id": 400210862,
					"content": "不，也要做好最壞的打算。假如這扇門並不通向秘境深處，而是一道機關…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210863
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210863,
					"content": "不會吧？你不要烏鴉嘴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210864
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210864,
					"content": "萬一嘛。誰也不能保證這件事絕對不會發生，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210865
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210865,
					"content": "遺憾的是，就算真是如此，憑目前的我大概也無法阻止…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210866
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210866,
					"content": "我還沒能完全掌控這裡。抱歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210867
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400210867,
					"content": "我倒覺得沒什麼。像這樣機會難得的挑戰聖地，再重組十次都行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210868
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210868,
					"content": "嗚嗚…我才不要，你自己一個人去享受吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210869
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210869,
					"content": "總之，如果觸發重組，你們就在確保自身安全的前提下盡量集體行動吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210870
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210870,
					"content": "那你呢？又要去戰鬥了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210871
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210871,
					"content": "不用擔心，我啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210872
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210872,
					"content": "當然是要好好享受一切危險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400210841,
					"content": "現在我完全信任你了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210842
					]
				},
				{
					"id": 400210825,
					"content": "如果他想要危害稻妻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210827
					]
				},
				{
					"id": 400210826,
					"content": "你會站在我們這邊嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210827
					]
				},
				{
					"id": 400210813,
					"content": "我有事要坦白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210814
					]
				}
			]
		},
		{
			"id": 4002109,
			"completionStepIds": [
				4002109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002109",
							"2"
						],
						"stepId": 4002109,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"辛焱"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400210901,
					"content": "可惡，我們又被彈出來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210902
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210902,
					"content": "下次別讓小哥開口了，這烏鴉嘴…未免太過靈驗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210903
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210903,
					"content": "我受不了這個秘境啦——！惟神晴之介是不是不敢面對我們，他是不是膽小鬼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400210904,
					"content": "不過，考慮到附近還有天領奉行的武士駐紮，小哥和「式大將」待在裡面，也算是避開了一些麻煩吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210905
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210905,
					"content": "（惟神…究竟在哪裡呢？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400210906
					]
				},
				{
					"id": 400210906,
					"content": "老規矩，等秘境重組完進去找他們會合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210907
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210907,
					"content": "在此之前我們得隱藏好自己，別被天領奉行的人發現我們還在這一帶徘徊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400210908
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400210908,
					"content": "下次進去，一定要把罪魁禍首揪出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4002114,
			"completionStepIds": [
				4002114
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4002114",
							"2"
						],
						"stepId": 4002114,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「式大將」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400211401,
					"content": "「拓本」裡殘留的符法之力有限，我能找回的記憶也有限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211402
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400211402,
					"content": "還不夠嗎？那就按計畫，繼續朝秘境深處前進吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211403
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211403,
					"content": "不對不對，秘境重組過，我們好不容易找到的路線早就沒用啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211404,
					"content": "關於這一點，請不必擔心，秘境的重組也是有規律的，我隱約記得方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211405
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400211405,
					"content": "朝那邊走，應該不會有錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211406
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400211406,
					"content": "等一下，我有問題！「式大將」，你剛才說「拓本」裡殘留的力量不夠，記憶恢復得也很有限。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211407,
					"content": "那你怎麼知道自己走的路就是正確的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211408,
					"content": "上次跟著你穿過那道門之後，我們就被送出了秘境…說明這個地方的門並不一定都是真門！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211409,
					"content": "要是你分辨不清把我們帶到了危險的地方，豈不是完蛋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211410,
					"content": "妳有這樣的擔心並不奇怪，可惜我還給不出令人信服的答案…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211411
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400211411,
					"content": "如果我說，這是作為「寮司」的直覺，妳能接受嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211412
					],
					"speakerTitle": "「式大將」"
				},
				{
					"id": 400211412,
					"content": "總感覺好不安啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211413,
					"content": "派蒙的問題不無道理，但我們也只能相信「式大將」這個領路人，否則，難道要一直在這裡等著嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211414
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400211414,
					"content": "而且，萬一秘境再次動起來…到那時，說不定我們就更沒方向了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211415
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400211415,
					"content": "嗯，出去一趟回來，變得心急了些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211416
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211416,
					"content": "我猜猜…是遇到什麼麻煩了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211417
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211417,
					"content": "據我所知，現階段稻妻的局勢還沒完全穩定下來。像這樣的秘境應該歸天領奉行處理，可是天領奉行人手短缺，不足以控住全局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211418
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211418,
					"content": "#所以，{F#妳}{M#你}們來這裡是受人所託，而且很有可能就是受天領奉行所託。{F#妳}{M#你}們領了他們的命令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211419
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211419,
					"content": "以那些人的作風，恐怕會直接殺入秘境，碾碎一切。要是在那之前找不回「式大將」的記憶，它就沒有機會了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211420
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211420,
					"content": "#所以{F#妳}{M#你}變得有些心急，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211421
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211421,
					"content": "你果然在調查稻妻。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400211422
					]
				},
				{
					"id": 400211422,
					"content": "這一切還是你們的陰謀嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400211423,
					"content": "#我確實在調查一些事，不過不是{F#妳}{M#你}想的那些。這件事稍後再說，現在先解決眼前的問題吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211424
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211424,
					"content": "#旅行者，我跟{F#妳}{M#你}有交情，沒必要在這些地方故意撒謊。抵達稻妻之後，我在周邊地區發現了魔物的蹤跡，自然就追到這座秘境裡來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211425
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211425,
					"content": "這裡就像是一座為鬥士而設的訓練場…只有戰鬥，只有廝殺。在這裡，我能盡情釋放自己，盡情享受！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211426
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211426,
					"content": "這話可能不太好聽，但除了旅行者和派蒙，我跟另外兩位是第一次見。你們應該不知道，我並不是那麼在乎立場的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211427
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211427,
					"content": "善惡、正邪、使命…這些事真有那麼重要嗎？能比極致的戰鬥，酣暢的廝殺更吸引人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211428
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211428,
					"content": "果然是好戰之人。小哥，那你的意思是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211429
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400211429,
					"content": "我沒什麼特別的想法，只是告訴你們，儘管前進吧，別畏懼路上的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400211430
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 400211430,
