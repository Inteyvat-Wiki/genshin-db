			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鯨井椛",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610601,
					"content": "#{F#妳}{M#你}們終於回來了，欸？嘉瑋沒來嗎?",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610602
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610602,
					"content": "他掉進了溫柔鄉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610603
					]
				},
				{
					"id": 726610603,
					"content": "啊？他成家了？哈哈！確實像他會做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610604
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610604,
					"content": "畢竟之前他的願望就是這個…好吧，既然是這個理由就原諒他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610605
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610605,
					"content": "#那楠塔克呢？{F#妳}{M#你}們找到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610606
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610606,
					"content": "他寫了本暢銷書。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610607
					]
				},
				{
					"id": 726610607,
					"content": "欸？沒想到他真的成了作家啊？還挺厲害的啊這老小子，寫了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610608
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610608,
					"content": "我知道我知道！書名叫作《關於「海中月」的真身其實是大海龜這件事》。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610609,
					"content": "哦，挺長的名字啊，是輕小說嗎？不錯…我也去買一本看看…嗯？等等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610610
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610610,
					"content": "關於「海中月」的真身…「海中月」的真身？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610611
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610611,
					"content": "嗯…其實是大海龜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610612
					]
				},
				{
					"id": 726610612,
					"content": "這傢伙在說什麼呢？怎麼可能是大海龜？他忘了我們當年親眼看到了「海中月」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610613
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610613,
					"content": "我們開始也不相信啦…然後就去雪山上找來了「海中月」的化石…這本書，還有化石，喏，給妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610614,
					"content": "不，我不相信，這不是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610615
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610615,
					"content": "#{F#妳}{M#你}們不知道，我們「鯨井」家是漁師世家，我的父親也是稻妻聞名的漁師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610616
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610616,
					"content": "他曾花費了數十年在大海上追捕「海中月」，有一次，他差點就成功了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610617
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610617,
					"content": "雖然最後還是功虧一簣，但我父親沒有放棄，如果能夠捕上傳說中的「海中月」，對漁師來說是無上的榮耀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610618
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610618,
					"content": "但就在下一次出海後…他就再沒有回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610619
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610619,
					"content": "…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610620
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610620,
					"content": "#所以，我不會輕易相信這種話的，請{F#妳}{M#你}幫我一把！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610621
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610621,
					"content": "那妳打算怎麼辦？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610622
					]
				},
				{
					"id": 726610622,
					"content": "我現在回去找父親留下的物品，他追逐「海中月」一生，留下了很多資料。一定能在裡面找到辦法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610623
					],
					"speakerTitle": "鯨井椛"
				},
				{
					"id": 726610623,
					"content": "#我為{F#妳}{M#你}準備了一些釣魚訓練，請等我的好消息吧，到時候還要拜託{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "鯨井椛"
				}
			]
		},
