					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610501,
					"content": "怎麼都是些都是礦渣，感覺裡面有東西被人取走了一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610502,
					"content": "咦？！那個人是…盜寶團？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610503,
					"content": "不會是他們拿走了礦石裡的東西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610504,
					"content": "快跟上他們，周圍肯定有他們的營地，礦石裡的東西一定都在那裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610505,
					"content": "我們走。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610506
					]
				},
				{
					"id": 726610506,
					"content": "我們要偷偷的，偷偷的，別被發現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7266106,
			"completionStepIds": [
				7266109
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7266109",
