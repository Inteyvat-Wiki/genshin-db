				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楠塔克",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 726610101,
					"content": "#哦，年輕的釣魚家，見到{F#妳}{M#你}可真高興啊。怎麼，遇上了麻煩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610102
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610102,
					"content": "#來來來，我可是{F#妳}{M#你}的釣魚領路人了，有什麼事說給我聽聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610103
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610103,
					"content": "居然是「海中月」啊，鯨井還在執著這件事，也難怪，畢竟她的願望是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610104
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610104,
					"content": "唉，她要是知道了「海中月」的真相，一定會很失望吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610105
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610105,
					"content": "什麼真相？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610106
					]
				},
				{
					"id": 726610106,
					"content": "其實當年返航之後，我也沒有停止關於「海中月」的調查，後來終於在一本古籍中找到了線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610107
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610107,
					"content": "根據那些線索，我又去實地調查，終於發現了一些驚人的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610108
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610108,
					"content": "我把這些發現都寫進了我的作品裡，最近似乎銷路還不錯呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610109
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610109,
					"content": "#來，剛好手邊有編輯留下的贈本，給{F#妳}{M#你}們看看，關於「海中月」的真相全在裡面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610110
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610110,
					"content": "我也要看，讓我也看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610111,
					"content": "《關於「海中月」的真身其實是大海龜這件事》…好長的書名啊… 欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610112,
					"content": "大海龜？「海中月」是大海龜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610113,
					"content": "沒錯，「海中月」就是一隻大海龜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610114
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610114,
					"content": "當年那個晚上，我們看見的，就是一隻背後長滿了類似小燈草這種發光植物的大海龜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610115
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610115,
					"content": "牠是一位懷孕的母親，正在上岸產卵的路上，因此我們才得以找到回家的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610116
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610116,
					"content": "所以，請回去把我的話轉告鯨井吧。不論如何，人終究要面對現實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610117
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610117,
					"content": "可是，雖然這也能說通…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						726610118
					]
				},
				{
					"id": 726610118,
					"content": "#看{F#妳}{M#你}的表情，還有點不相信吧？但我的研究是有證據的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610119
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610119,
					"content": "古籍中提到，「海中月」是一種古老的生物，在很久很久以前，很多生物還在陸地上生活的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610120
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610120,
					"content": "牠們的祖先，就活躍在如今的龍脊雪山地區，現在還能夠找到一些化石。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610121
					],
					"speakerTitle": "楠塔克"
				},
				{
					"id": 726610121,
					"content": "#我上次就在<color=#00E1FFFF>眠龍谷</color>西側的礦堆裡發現了一些，{F#妳}{M#你}們如果還不相信，可以去找找看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楠塔克"
				}
			]
		},
