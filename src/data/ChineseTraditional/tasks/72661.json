			"dialogs": [
				{
					"id": 726610701,
					"content": "嘿，你們說，這破石頭值錢嗎？居然藏在礦石裡，真稀罕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610702
					],
					"speakerTitle": "老黑七"
				},
				{
					"id": 726610702,
					"content": "笑死了，什麼叫破石頭，你讀過書嗎？這叫化石，化石懂嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610703
					],
					"speakerTitle": "林逃山"
				},
				{
					"id": 726610703,
					"content": "值錢死了，光這一顆就能買下半個璃月港！快回去多讀點書吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610704
					],
					"speakerTitle": "林逃山"
				},
				{
					"id": 726610704,
					"content": "真的嗎？有這麼值錢嗎？那加上營地裡的這些，我們豈不是要平步烏雲了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610705
					],
					"speakerTitle": "巴子"
				},
				{
					"id": 726610705,
					"content": "是平步青雲！你也回去多讀點書吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610706
					],
					"speakerTitle": "林逃山"
				},
				{
					"id": 726610706,
					"content": "喂！那邊的傢伙，把化石交出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						726610707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 726610707,
					"content": "啊！是誰？！該死…被發現了，兄弟們上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "林逃山"
