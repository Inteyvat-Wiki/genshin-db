			"dialogs": [
				{
					"id": 3880101,
					"content": "是暴風的<color=#00E1FFFF>障壁</color>！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3880102,
					"content": "哇…真是看起來非常危險的景觀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3880103,
					"content": "交給我吧。",
