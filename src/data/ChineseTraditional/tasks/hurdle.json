					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3880302,
					"content": "丘丘人…通常，他們不太會在元素濃度過高的區域活動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880303
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3880303,
					"content": "在這裡，他們的身體要承擔更大的負擔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880304
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3880304,
					"content": "想必就是深淵教團在背後操控吧，但它們應該不能確定我們會來這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880305
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3880305,
					"content": "為了阻止我們的行動，教團恐怕正在向四處投放兵力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880306
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 3880306,
					"content": "那麼，事不宜遲——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3880307
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 3880307,
					"content": "這次的聽眾只是「風」而已，撥弦的速度加快一點也無所謂吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
