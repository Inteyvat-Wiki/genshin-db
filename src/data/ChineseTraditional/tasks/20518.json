				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180401,
					"content": "#{F#妳}{M#你}回來了，哎呀，效率可真快，我也算是知道，為什麼那位先生這麼喜歡把事情交給{F#妳}{M#你}辦了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180402
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180402,
					"content": "這件事已經交給西風騎士團了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180403
					]
				},
				{
					"id": 205180403,
					"content": "交給西風騎士…喂，我剛才說過，把這件事交給西風騎士團也許會很麻煩的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180404
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180404,
					"content": "#{F#妳}{M#你}還真是會偷懶啊，呼…還好那位先生和我說過{F#妳}{M#你}也許會這麼做，讓我早早做好了預案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180405
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180405,
					"content": "#接下來的事{F#妳}{M#你}就別操心了，我馬上又要去跑腿了，唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180406
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180406,
					"content": "#不過按照那位先生的說法，{F#妳}{M#你}的這種行為，說不定也能把事導向另外一個有趣的方向。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180407
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180407,
					"content": "畢竟，如果是我去報告盜寶團的動向就太過明顯了，而且那位先生的身分也不太好直接調度西風騎士…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180408
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180408,
					"content": "#唔…這些給{F#妳}{M#你}，收下吧。用那位先生的話說，這算是{F#妳}{M#你}「讓風向轉變」的小小報酬啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇爾"
				}
			]
		},
