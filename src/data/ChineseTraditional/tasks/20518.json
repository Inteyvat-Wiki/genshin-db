				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180101,
					"content": "又見面了，怎麼樣，最近過得還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180102
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180102,
					"content": "哦，順便說一句，吉麗安娜小姐到目前為止，過得不好不壞。不那麼壞的是，她暫時沒有離開蒙德城…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180103
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180103,
					"content": "但不那麼好的是，她已經向維多利亞修女坦白了自己的事，而維多利亞修女到現在也沒動靜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180104
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180104,
					"content": "這件事到底會怎麼收場，我們也只能拭目以待囉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180105
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180105,
					"content": "…妳又想要做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180106
					]
				},
				{
					"id": 205180106,
					"content": "#別用這麼可怕的目光盯著我啦，我又不是什麼壞心眼的人，我可是好心給{F#妳}{M#你}指過幫助吉麗安娜小姐的路呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180107
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180107,
					"content": "#好了，說正事。這次找{F#妳}{M#你}來，還是因為之前那件事遺留下來的「小問題」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180108
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180108,
					"content": "#簡單來說，{F#妳}{M#你}擊退了盜寶團，但同時也把「吉麗安娜就在蒙德城」這件事給挑明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180109
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180109,
					"content": "盜寶團對於叛徒可從來不會心慈手軟，據我所知，蒙德城周圍已經出現了好幾股盜寶團的蹤跡，而且都是沒有見過的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180110
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180110,
					"content": "#恐怕是想要來找吉麗安娜小姐的麻煩，順便為自己人報仇呢。這麼危險的傢伙們，就只能拜託{F#妳}{M#你}去擊退啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180111,
						205180113,
						205180115
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180111,
					"content": "這都是妳幹的好事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180112
					]
				},
				{
					"id": 205180112,
					"content": "#哎呀，我也是奉命行事啦，要不是那位先生這麼堅持，一定要{F#妳}{M#你}來做這件事，我也不會繼續找{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180121,
					"content": "#哎呀，{F#妳}{M#你}就放心啦，這次我還給{F#妳}{M#你}準備好了扎實的報酬呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180122
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180122,
					"content": "#畢竟那位先生這次給我撥了不少摩拉，不像上次，還要我自己掏錢墊上…對了，我把那些盜寶團的位置也幫{F#妳}{M#你}標上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180123
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180123,
					"content": "#那麼，不管怎麼說，看在摩拉的面子上，保護吉麗安娜小姐、魯道夫先生，莉莉和蒙德城的任務，就交給{F#妳}{M#你}了，要加油啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180113,
					"content": "妳給我自己去處理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180114
					]
				},
				{
					"id": 205180114,
					"content": "#別說這種無情的話嘛，我可沒有{F#妳}{M#你}這種實力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180115,
					"content": "這是西風騎士團的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180116
					]
				},
				{
					"id": 205180116,
					"content": "話是這麼說沒錯，不過那位先生判斷，在現在的情況下，吉麗安娜小姐的事越少人知道越好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180117
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180117,
					"content": "另外，那位先生也不太希望西風騎士團參與這件事。畢竟…西風騎士們行事已經習慣了大開大合，總會把事情做得太過頭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180118
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180118,
					"content": "比如那位可靠的霍夫曼先生，如果他聽說有盜寶團在蒙德城附近出沒，一定會第一時間報告騎士團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180119
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180119,
					"content": "如果騎士團真的浩浩蕩蕩地出動了，盜寶團大概也馬上會化整為零跑掉，將盜寶團完全擊退的計畫又會再次打水漂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180120
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180120,
					"content": "#所以，這次就只能拜託{F#妳}{M#你}去「單兵作戰」，迅速地解決掉他們啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180121
					],
					"speakerTitle": "薇爾"
				}
			]
		},
		{
			"id": 2051802,
			"completionStepIds": [
				2051804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
