						],
						"stepId": 2051804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"薇爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180201,
					"content": "#{F#妳}{M#你}回來了，哎呀，效率可真高，我也算是知道為什麼那位先生這麼喜歡{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180202,
						205180204
					],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180202,
					"content": "報酬拿來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180203
					]
				},
				{
					"id": 205180203,
					"content": "#冷冰冰的…好啦，我這就把報酬給{F#妳}{M#你}。{F#妳}{M#你}就理解我一下嘛，我也只是個跑腿的人而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇爾"
				},
				{
					"id": 205180204,
					"content": "那真是謝謝厚愛了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180205
					]
				},
				{
					"id": 205180205,
					"content": "不客氣，不客氣，這些報酬請拿好，還有…合作愉快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "薇爾"
				}
			]
		},
		{
			"id": 2051803,
			"completionStepIds": [
				2051805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2051805",
							"2"
						],
						"stepId": 2051805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"霍夫曼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205180301,
					"content": "這幫盜寶團…繼續藏吧，千萬別讓我知道…你們到底藏在哪了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180302
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205180302,
					"content": "我知道盜寶團藏在哪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205180303
					]
				},
				{
					"id": 205180303,
					"content": "您？您怎麼…咦，這份地圖上的標記真詳細…你是從哪拿到的？薇爾？居然是她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180304
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205180304,
					"content": "…居然和我們之前確定的地點相距這麼遠，這群盜寶團的目標到底是什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180305
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205180305,
					"content": "抱歉，請讓我記一下…好了，我知道了，我們會馬上派人去查證，如果情況屬實的話，我們馬上就會前往擊退他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205180306
					],
					"speakerTitle": "霍夫曼"
				},
				{
					"id": 205180306,
					"content": "再次感謝您！謝謝您為蒙德城做出的貢獻！這些盜寶團，這次絕對跑不了了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霍夫曼"
				}
			]
		},
		{
			"id": 2051804,
			"completionStepIds": [
				2051806
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
