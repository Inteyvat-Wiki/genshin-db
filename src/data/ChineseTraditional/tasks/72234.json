	"talks": [
		{
			"id": 7223401,
			"completionStepIds": [
				7223402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
