			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"樺山"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340101,
					"content": "怎麼樣，坐起來舒服嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340102
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340102,
					"content": "突然出現，嚇我一跳！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340103
					]
				},
				{
					"id": 722340103,
					"content": "抱歉抱歉，沒打算這樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340104
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340104,
					"content": "#我叫樺山，{F#妳}{M#你}現在坐的位置我也經常坐。很安靜，適合思考人生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340105
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340105,
					"content": "那我讓、讓給你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340106
					]
				},
				{
					"id": 722340106,
					"content": "#唉，謝謝，可是不必了。話說，{F#妳}{M#你}是從別處來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340107
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340107,
					"content": "是的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340108
					]
				},
				{
					"id": 722340108,
					"content": "#那{F#妳}{M#你}一定見識很廣吧。我從來沒出去過，雖然四處搬家的經歷倒是很豐富。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340109
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340109,
					"content": "唉，說起這搬家的經歷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340110
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340110,
					"content": "因為年少時頻頻搬家，幾乎沒結識幾個相熟的夥伴。獨自四處遊蕩時發現了不錯的景致也無人可分享…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340111
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340111,
					"content": "#唉，如果能讓{F#妳}{M#你}看看那些景致，那倒也好。{F#妳}{M#你}在旅途中經過這些地方，不妨坐下看看，要是能回來和我談談{F#妳}{M#你}的感受那就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340112
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340112,
					"content": "一處在狹間之街最高處的石門下，一處在常夜靈廟旁珊瑚環繞的空闊地，一處在蛇心之地的高聳殘垣旁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340113
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340113,
					"content": "#我在這些地方都留下了標記，在高處掛了燈盞，給自己照亮。{F#妳}{M#你}應該能很容易找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "樺山"
				}
			]
		},
		{
			"id": 7223402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
