			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"樺山"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340201,
					"content": "#{F#妳}{M#你}回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340202
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340202,
					"content": "#{F#妳}{M#你}還沒有找到所有的地方嗎？那太可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340203
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340203,
					"content": "我再說一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340204
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340204,
					"content": "一處在狹間之街最高處的石門下，一處在常夜靈廟旁珊瑚環繞的空闊地，一處在蛇心之地的高聳殘垣旁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340205
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340205,
					"content": "#我在這些地方都留下了標記，在高處掛了燈盞，給自己照亮。{F#妳}{M#你}應該能很容易找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "樺山"
				}
			]
		},
		{
			"id": 7223403,
			"completionStepIds": [
				7223411
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7223411",
							"2"
						],
						"stepId": 7223411,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"樺山"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722340301,
					"content": "#{F#妳}{M#你}回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340302
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340302,
					"content": "#{F#妳}{M#你}已經去過所有的地方了嗎？見多識廣的{F#妳}{M#你}或許會覺得這些地方的景色都不值一提吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340303,
						722340304
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340303,
					"content": "我覺得挺不錯的，很獨特。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				},
				{
					"id": 722340305,
					"content": "#唉，想想我還從來沒跟人分享過這些。能知道{F#妳}{M#你}的感想就足夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340306
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340306,
					"content": "也許別處有比這裡好得多的地方吧。畢竟這裡黑黢黢的，飯食也沒什麼選擇的餘地，還得提防龍蜥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340307
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340307,
					"content": "但是生活得久了，竟還是有些不捨的感覺。在那幾處看過的風景，現在想起來，也還是覺得懷念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340308
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340308,
					"content": "#{F#妳}{M#你}也會有這樣的感覺嗎？即使是這樣的地方，住得久了，也會有家的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340309,
						722340310
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340309,
					"content": "也許吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340311,
					"content": "是這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722340312
					],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340312,
					"content": "#…總之謝謝{F#妳}{M#你}聽我說這些無用的閒話。雖然不是什麼貴重的東西，但我只有這些了，請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "樺山"
				},
				{
					"id": 722340310,
					"content": "不會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340311
					]
				},
				{
					"id": 722340304,
					"content": "普普通通，我見過更壯麗的景色。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722340305
					]
				}
			]
		}
	]
}