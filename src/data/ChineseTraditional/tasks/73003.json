					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030101,
					"content": "#和{F#妳}{M#你}們一起來，真是太好了。不過這附近死域擴張的情況，還是要向提納里前輩報告才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030102
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030102,
					"content": "欸？那是…是維摩莊的小孩子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030103,
					"content": "咦？優丹！等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				}
			]
		},
		{
