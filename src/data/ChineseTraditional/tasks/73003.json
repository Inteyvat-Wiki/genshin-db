			},
			"dialogs": [
				{
					"id": 730030801,
					"content": "#抱歉…{NICKNAME}，派蒙，我想休息一下…優丹，等一下姐姐喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030802
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030802,
					"content": "拉娜，真的不要緊嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030803,
					"content": "我們去找人幫忙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030804
					]
				},
				{
					"id": 730030804,
					"content": "沒關係、沒關係…我稍微，歇一下就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030805
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030805,
					"content": "對不起，拉娜姐姐…對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030806
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030806,
					"content": "真是的…都說了，沒事的啦！不過，拉娜姐姐很生氣喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030807
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030807,
					"content": "明明答應了姐姐…不要到森林裡來…都說好了的。等拉娜姐姐，休息好了，一定要好好教訓你這個不聽話的…壞傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030808
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030808,
					"content": "嗚嗚…我只是之前聽艾方索哥哥說，這邊有很大的蘑菇！我想給姐姐採一些新鮮的蘑菇，姐姐吃了，就會很有精神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030809
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030809,
					"content": "笨蛋…真是多此一舉，拉娜姐姐只要想著大家，就會很有精神…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030810
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030810,
					"content": "不過，哈哈哈…這裡的蘑菇，真的好大…如果拿去煮咖哩，一定很好吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030811
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030811,
					"content": "是艾方索要你來的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030812
					]
				},
				{
					"id": 730030812,
					"content": "不是…艾方索哥哥也說，不要隨便跑到外面去。不過，優丹就是想要拉娜姐姐吃好吃的…所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030813
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030813,
					"content": "艾方索才不會做這種事情，他可是優丹的哥哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030814
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030814,
					"content": "也是…不過，優丹又怎麼會困在死域裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030815
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030815,
					"content": "在林子裡，我覺得好像有人跟著我…我好害怕，我覺得是「無留陀的化身」…我就一直跑…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030816
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030816,
					"content": "結果，就跑到了「無留陀」裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030817
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030817,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030818,
						730030823
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030818,
					"content": "「無留陀」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030819
					]
				},
				{
					"id": 730030819,
					"content": "也就是…死域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030820
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030820,
					"content": "啊…對，就是死域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030821
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030821,
					"content": "「無留陀的化身」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030822
					]
				},
				{
					"id": 730030822,
					"content": "嗯。也就是替代無留陀在大地上，做壞事的…黑黑的、高高的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030828
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030828,
					"content": "無留陀…好奇怪的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030829
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030829,
					"content": "嗯，為什麼我會知道無留陀就是死域…？可惡…頭好暈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030830
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030830,
					"content": "剛剛，優丹，那個綠色的是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030831
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030831,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030832
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030832,
					"content": "是「蘭迦拉梨」…可以保護人，不被無留陀侵蝕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030833
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030833,
					"content": "搞不明白的東西愈來愈多了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030834
					]
				},
				{
					"id": 730030834,
					"content": "這個是…一種森林的「法術」，也是一種「音樂」…這是蘭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030835,
						730030837
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030835,
					"content": "是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030836
					]
				},
				{
					"id": 730030836,
					"content": "別想這些有的沒的，拉娜你好好休息一會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030838,
					"content": "就快要想起來了，但就是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030839
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030839,
					"content": "對不起，拉娜姐姐，對不起…以後我不會亂跑的，會好好待在家裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030840
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030840,
					"content": "嗯，姐姐知道啦。你要變得聰明、健康，知道什麼是好的，什麼是不好的…就像，你知道什麼蘑菇能吃、什麼不能吃一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030841
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030841,
					"content": "我知道…我知道了啦…對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030842
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030842,
					"content": "#知道「無留陀」不好，然後…森林是好的…變成強壯、正直的人，幫助需要幫助的人…像{NICKNAME}和派蒙那樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030843
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030843,
					"content": "然後，不要忘記…森林會記住一切…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030844
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030844,
					"content": "嗚哇，不行，我覺得拉娜狀態愈來愈差了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030845,
						730030846
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030845,
					"content": "我們去找人幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030847,
					"content": "哎？啊…沒關係，沒關係…我休息一下就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030848
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030848,
					"content": "#{NICKNAME}，拜託{F#妳}{M#你}…替我把優丹送回去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030849
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030849,
					"content": "嗯，我們走吧，優丹。拉娜，妳別亂跑！我們馬上回來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030846,
					"content": "拉娜，等我們一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030847
					]
				},
				{
					"id": 730030837,
					"content": "別想這些了，休息一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030838
					]
				},
				{
