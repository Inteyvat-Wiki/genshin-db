					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030201,
					"content": "優丹…怎麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030202
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030202,
					"content": "#嗚嗚，拉娜姐姐…還有{M#大哥哥}{F#大姐姐}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030203
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030203,
					"content": "欸？優丹為什麼會在…死域裡…而且，魔物好多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030204,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030205,
						730030206
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030205,
					"content": "這裡就交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				},
				{
					"id": 730030207,
					"content": "不行…沒時間了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030208
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030208,
					"content": "#可惡，{NICKNAME}，拜託{F#妳}{M#你}了！我們一起上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030209
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030209,
					"content": "優丹你乖乖待著別動！我們來救你了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030206,
					"content": "那個綠色的是什麼…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030207
					]
				}
			]
		},
		{
			"id": 7300303,
			"completionStepIds": [
				7300306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
