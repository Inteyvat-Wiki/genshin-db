					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730030301,
					"content": "呼…呼…總算好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030302
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030302,
					"content": "拉娜姐姐…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030303
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030303,
					"content": "優丹…你是男子漢，不要哭哦。你看……姐姐可以把在死域裡的感覺…告訴他們…教令院的學者，然後，他們就能解決死域…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030304
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030304,
					"content": "#而且…你看到了嗎…拉娜姐姐戰鬥的樣子，不…{NICKNAME}{M#哥哥}{F#姐姐}戰鬥的樣子，你要謝謝{M#他}{F#她}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030305
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030305,
					"content": "拉娜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030306,
						730030308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030306,
					"content": "別說了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030307
					]
				},
				{
					"id": 730030307,
					"content": "拉娜，妳先休息一下吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030309,
					"content": "哈…哈哈…沒關係，我只是覺得有點頭暈，有點累…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030310
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030310,
					"content": "拉娜姐姐…對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030311
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030311,
					"content": "說…說什麼呢，你可是我的小老虎呀，別哭！倒是你沒事吧？優丹…有沒有不舒服…？會不會覺得頭暈、沒力氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030312
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030312,
					"content": "我沒事，但是拉娜姐姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030313
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030313,
					"content": "嗯！沒事…拉娜姐姐沒事的，畢竟我是身經百戰的巡林官！我們走吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030308,
					"content": "我去找人來幫忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030309
					]
				}
			]
		},
