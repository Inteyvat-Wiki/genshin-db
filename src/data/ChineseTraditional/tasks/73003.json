			},
			"dialogs": [
				{
					"id": 730030501,
					"content": "#優丹？為什麼你會…還有{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030502
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730030502,
					"content": "事情緊急，我們長話短說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030503,
					"content": "簡要說明了事情原委。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730030504
					]
				},
				{
					"id": 730030504,
					"content": "…我明白了。優丹，你好好休息一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030505
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730030505,
					"content": "嗯。對不起，艾方索哥哥…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030506
					],
					"speakerTitle": "優丹"
				},
				{
					"id": 730030506,
					"content": "#沒關係，你沒事就好…{NICKNAME}，{F#妳}{M#你}等我一下。我準備一些藥物，馬上跟{F#妳}{M#你}們去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030507
					],
					"speakerTitle": "艾方索"
				},
				{
					"id": 730030507,
					"content": "沒時間了。位置在這，你自己去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030508
					]
				},
				{
					"id": 730030508,
					"content": "嗯，我們得趕快回去看著拉娜才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030509,
					"content": "哎，等等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾方索"
				}
			]
		},
