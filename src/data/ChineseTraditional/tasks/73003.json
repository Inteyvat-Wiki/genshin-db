			"dialogs": [
				{
					"id": 730030701,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030702
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030702,
					"content": "喂！拉娜！妳聽得到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030703,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030704
					],
					"speakerTitle": "拉娜"
				},
				{
					"id": 730030704,
					"content": "到底是怎麼回事…這個，是不是之前優丹和拉娜說的蘭…什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030705,
						730030708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030705,
					"content": "「蘭迦拉梨」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030706
					]
				},
				{
					"id": 730030706,
					"content": "啊，對對對！就是這個！好像是說能抵抗無留陀侵蝕什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030707,
					"content": "嗯。那菈聰明。蘭迦拉梨，能抵禦無留陀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030711
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030711,
					"content": "哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030712
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030712,
					"content": "哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030713,
						730030715
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030713,
					"content": "是不是之前看到的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030714
					]
				},
				{
					"id": 730030714,
					"content": "呼…嚇死我了！我還以為蔬菜在說話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030716,
					"content": "才不是蔬菜，是蘭拉娜。蘭拉娜是朋友，是蘭那羅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030717,
						730030722
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030717,
					"content": "「蘭那羅」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030718
					]
				},
				{
					"id": 730030718,
					"content": "欸？是說蘭那羅嗎？這麼一看，確實是之前我們看到的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030719
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030719,
					"content": "「蘭拉娜」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030720
					]
				},
				{
					"id": 730030720,
					"content": "之前跟優丹講故事的時候，好像聽過這個名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030721
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030721,
					"content": "嗯。那菈優丹是蘭拉娜的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030727
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030727,
					"content": "#蘭那羅是森林的孩子，和樹生活在一起。和{F#妳}{M#你}，那菈{NICKNAME}不一樣。{F#妳}{M#你}像是蒲公英的孩子，一直在旅行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030728
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030728,
					"content": "#為什麼你知道{NICKNAME}的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030729
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030729,
					"content": "蘭拉娜為什麼知道，不重要。但是，蘭拉娜要幫助那菈拉娜，很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030730,
						730030732
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030730,
					"content": "那菈拉娜…好拗口…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030731
					]
				},
				{
					"id": 730030731,
					"content": "是要幫助拉娜嗎？你需要我們做什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030733,
					"content": "#謝謝{F#妳}{M#你}們。{F#妳}{M#你}們是好那菈。她是蘭拉娜的，很重要的好朋友。所以，蘭拉娜會保護她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030734
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030734,
					"content": "#但是，只是這樣不夠。要治好那菈拉娜，需要「惟耶之實」。那菈{NICKNAME}去「桓那蘭那」，叫大家幫忙弄「惟耶之實」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030735,
						730030736
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030735,
					"content": "「惟耶之實」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030737,
					"content": "那菈拉娜被無留陀侵蝕，很重。有壞蟲噬咬樹木的根。樹會枯死、果實會腐敗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030738
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030738,
					"content": "那菈的生命就像樹木，壞蟲就像無留陀。只有「惟耶之實」，能夠讓那菈拉娜恢復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030739
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030739,
					"content": "呃…總之，我們是要去一個叫「桓那蘭那」的地方，想辦法弄「惟耶之實」來是吧。然後，我們就能治好拉娜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030740
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730030740,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030741,
						730030744
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030741,
					"content": "那拉娜現在的狀況…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030742
					]
				},
				{
					"id": 730030742,
					"content": "不用擔心。蘭拉娜會在這裡，抵抗無留陀的侵蝕。所以，不會變壞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030743
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030743,
					"content": "但是，沒有「惟耶之實」，也不會變好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030745
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030745,
					"content": "順著「森林的軌跡」，順著水來的地方一直走，就能到達「桓那蘭那」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030746
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030746,
					"content": "然後，唱歌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030747,
						730030748
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030747,
					"content": "唱歌？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030750
					]
				},
				{
					"id": 730030750,
					"content": "（腦海中浮現出了一段旋律…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030751
					]
				},
				{
					"id": 730030751,
					"content": "這是「大夢的曲調」。只要唱大夢的曲調，就能進入「桓那蘭那」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030752
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030752,
					"content": "進入我們的夢、我們的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030748,
					"content": "會招來騙騙花…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030749
					]
				},
				{
					"id": 730030749,
					"content": "#那菈{NICKNAME}，真風趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730030750
					],
					"speakerTitle": "蘭拉娜"
				},
				{
					"id": 730030744,
					"content": "我明白了。要怎麼走？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030745
					]
				},
				{
					"id": 730030736,
					"content": "那是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730030737
					]
				},
				{
					"id": 730030732,
					"content": "需要我做什麼？",
