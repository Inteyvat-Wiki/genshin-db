					{
						"sceneId": 3,
						"position": [
							3558.252,
							427.355,
							4469.95
						],
						"pointId": 340100766
					}
				]
			},
			"dialogs": [
				{
					"id": 756510101,
					"content": "#{NICKNAME}最近做委託很辛苦吧？我都看在眼裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510102,
					"content": "#作為一個貼心稱職的嚮導，我有責任幫{F#妳}{M#你}放鬆一下，噹噹——快看這是什麼地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510103,
						756510105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510103,
					"content": "招牌上寫了，達莫維百貨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510104
					]
				},
				{
					"id": 756510105,
					"content": "摩拉小偷的住所，錢包墳場。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510106
					]
				},
				{
					"id": 756510104,
					"content": "#{F#妳}{M#你}們好，歡迎來到達莫維百貨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 756510106,
					"content": "#顧客，這樣說就不妥了。達莫維百貨主打的一直是物美價廉，{F#妳}{M#你}們可以看看價格嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510107
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 756510107,
					"content": "這裡不是一家普通的商店哦，這裡是辛苦的勞動者透過消費獲得精神放鬆的好地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510108,
					"content": "說的沒錯，我們最近還推出了買一送一的促銷活動！歡迎所有顧客參加！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510109
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 756510109,
					"content": "#買了我吃虧，不買{F#妳}{M#你}吃虧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510110
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 756510110,
					"content": "之前路過看到達莫維百貨的活動海報，我就記住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510111,
					"content": "花一份錢可以買兩份貨，怎麼看怎麼划算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510112,
					"content": "#總有種不在這裡消費，我的人生就有點缺憾的感覺…我今天就要帶著{NICKNAME}一起彌補這份缺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510113,
						756510114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510113,
					"content": "派蒙想買什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510114,
					"content": "派蒙想怎麼彌補缺憾？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510115
					]
				},
				{
					"id": 756510115,
					"content": "#嘿嘿，這個先不告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510116,
					"content": "那我不付錢哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510117
					]
				},
				{
					"id": 756510117,
					"content": "#哼哼，今天不需要{F#妳}{M#你}來付，我自己帶錢來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510118,
					"content": "#老闆，預訂商品到貨了嗎？預訂人的姓名是派蒙和{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510119,
					"content": "有的，稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510120
					],
					"speakerTitle": "布希柯"
				},
				{
					"id": 756510120,
					"content": "店主布希柯取出了一件被過度包裝得看不出是什麼的商品。一旁的派蒙掏出一大堆零錢，眼看這一大堆零錢就這樣離開了自己，派蒙的臉上流露出一絲不捨。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						756510121
					]
				},
				{
					"id": 756510121,
					"content": "#和派蒙一起拆開厚厚的包裝後，{F#妳}{M#你}意識到這是兩本留影冊。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 756510122,
					"content": "終於拿到了，我等了好久哦，心願達成！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510123,
					"content": "平常拍了那麼多畫片，這下有地方放了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510124,
					"content": "沒看到派蒙有在用留影機啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510125
					]
				},
				{
					"id": 756510125,
					"content": "#沒在{F#妳}{M#你}面前拿出來而已啦，趁{F#妳}{M#你}不注意我可是拍了不少{F#妳}{M#你}的糗照，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510126,
						756510127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510126,
					"content": "竟然有點想看…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510127,
					"content": "快給我看看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510128
					]
				},
				{
					"id": 756510128,
					"content": "現在不行，等我拍滿一整本再說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510129,
						756510130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510129,
					"content": "小氣派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510130,
					"content": "壞心眼派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510131
					]
				},
				{
					"id": 756510131,
					"content": "#我才不是{F#妳}{M#你}說的那樣呢。喏，這本留影冊給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510132,
					"content": "雖然這一本有點薄，但也放得下不少畫片了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510133,
					"content": "我們去過那麼多地方，常常幫別人留影，自己留下的畫片卻不多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510134,
					"content": "要是可以多留下一些自己的回憶就好了，所以我買了這兩本留影冊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510135,
					"content": "這是禮物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510136,
					"content": "#對啊，買一送一，{F#妳}{M#你}一本我一本，預訂的時候我就想好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510137,
					"content": "要立刻用起來哦，可以去拍一拍我們一起走過的地方，找一找過去的回憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510138
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510138,
					"content": "#對了，要不要用我的留影機來拍？{F#妳}{M#你}好像還沒用過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510139,
					"content": "那時候費了那麼大的力氣找百貨訂製，不多用用就可惜了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510140,
						756510141
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510140,
					"content": "我來試試看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510141,
					"content": "謝謝妳，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						756510142
					]
				},
				{
					"id": 756510142,
					"content": "#{F#妳}{M#你}喜歡就最好了，這都是一個貼心稱職的嚮導該做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						756510143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 756510143,
					"content": "#走，我陪{F#妳}{M#你}一起去留影。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}