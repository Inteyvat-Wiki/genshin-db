			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大雨",
					"茶博士劉蘇",
					"范二爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710990701,
					"content": "什麼意思？鬧了半天，你們沒商量好啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990702
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990702,
					"content": "哦我懂了，劉蘇劉先生想造新戲臺，但他說話不算數，得聽范二爺的，范二爺又不想造，得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990703
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990703,
					"content": "你倆商量好了再給我個准話吧，我也趕了老久的路，先到邊上候著去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990704
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990704,
					"content": "唉，這叫什麼事兒啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990705,
						710990706
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990705,
					"content": "所以我白跑了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990707
					]
				},
				{
					"id": 710990707,
					"content": "別急別急，我再說說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990708
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990708,
					"content": "二爺啊，我們今天要是心疼造戲臺這點小錢，以後就要虧大錢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990709
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990709,
					"content": "你想啊，每次雲老闆在我們這兒登臺，人家耍花槍那麼一亮相，還沒等觀眾叫好，戲臺子先響起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990710
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990710,
					"content": "你說尷尬不尷尬？本來雲翰社就是掛靠在我們這兒，到時候人家一不高興去了別處，我們就虧大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990711
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990711,
					"content": "憑雲老闆跟我的交情，她是不會這麼幹的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990712
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990712,
					"content": "您還以為我們高枕無憂呢？我可聽說最近大家都愛去三碗不過港，不愛上我們這兒來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990713
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990713,
					"content": "那田鐵嘴名頭都比我大了，您倒是有點憂患意識啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990714
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990714,
					"content": "雲老闆給茶館掙了這麼多錢，我們造個戲臺這點錢出不起？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990715
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990715,
					"content": "誰叫我呀？哦，是劉蘇先生，今天是怎麼了，生這麼大氣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990716
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990716,
					"content": "沒有沒有，說不上生氣。雲老闆今天過來，是安排了戲嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990717
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990717,
					"content": "倒不是，只是想來茶館喝喝茶，順便來看望看望二爺和劉蘇先生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990718
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990718,
					"content": "#啊，巧得很，原來{NICKNAME}也來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990719,
						710990721
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990719,
					"content": "沒想到妳來了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990720
					]
				},
				{
					"id": 710990720,
					"content": "有緣自然能相會，我可不覺得意外呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990723
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990723,
					"content": "哈哈哈，還是雲老闆說話中聽，來來來，我託人從翹英莊捎了新茶，我們泡它一壺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990724
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990724,
					"content": "二爺，我剛在樓下聽到茶館的戲臺要修了，您終於肯動這個老物件了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990725
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990725,
					"content": "咳咳…這個不著急，我還要從長計議…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990726
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990726,
					"content": "哦？從長計議…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990727
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990727,
					"content": "說起來，您知道我去輕策莊，是在哪家吃的飯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990728
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990728,
					"content": "別賣關子了，妳又去看若心了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990729
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990729,
					"content": "您一猜就準！若心前輩還問起今天的和裕茶館什麼樣呢，我說一切都跟她年輕時一樣，然後她說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990730
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990730,
					"content": "她說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990731
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990731,
					"content": "哎呀我忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990732
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990732,
					"content": "妳這個雲丫頭，平時記性挺好，怎麼今天這麼重要的事還能忘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990733
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990733,
					"content": "算了，一切保持原樣，她也會開心的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990734
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990734,
					"content": "你們年輕人就喜歡新東西，一點不念舊，說多了你們也不懂，就知道催我，哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990735
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990735,
					"content": "#別生氣嘛二爺，先喝茶先喝茶，我來給大家泡。{NICKNAME}和劉蘇先生來幫我取點茶葉吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990721,
					"content": "才想到雲堇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990722
					]
				},
				{
					"id": 710990722,
					"content": "#{F#妳}{M#你}真是的，就愛開玩笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990723
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990706,
					"content": "說好的酬金呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990707
					]
				}
			]
		},
		{
			"id": 7109908,
