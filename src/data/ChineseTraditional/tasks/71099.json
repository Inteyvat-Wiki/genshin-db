			},
			"dialogs": [
				{
					"id": 710990601,
					"content": "您瞧好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990602
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990602,
					"content": "大雨忙活了一陣。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710990603
					]
				},
				{
					"id": 710990603,
					"content": "最後一把椅子也打好了，村長奶奶拿好，這下我該去和裕茶館幹活啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990604
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990604,
					"content": "師父您等著啊，我大概幾天就回了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990605
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990605,
					"content": "嗯，去吧去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990606
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 710990606,
					"content": "成，那我現在出發，差不多明天晚上就能趕到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990607
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990607,
					"content": "我們和裕茶館見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大雨"
				}
			]
