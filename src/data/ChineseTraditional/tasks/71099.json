			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"路爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710990301,
					"content": "這年輕人，風塵僕僕的，急什麼，坐下來喝杯茶嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990302,
						710990303
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 710990302,
					"content": "路爺…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990304
					]
				},
				{
					"id": 710990304,
					"content": "向路爺解釋了劉蘇的委託…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710990305
					]
				},
				{
					"id": 710990305,
					"content": "哦哦，造新戲臺不難，但找我是找錯人嘍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990306
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 710990306,
					"content": "輕策莊到璃月港那麼遠呢，我去璃月港了誰來照看「范木堂」呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990307
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 710990307,
					"content": "更何況我這老胳膊老腿，哪兒走得動那麼遠的路，年紀大啦，經不起折騰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990308,
						710990309
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 710990308,
					"content": "那不麻煩范木堂了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990310
					]
				},
				{
					"id": 710990310,
					"content": "#哎別急啊，{F#妳}{M#你}都大老遠來一趟了，我給{F#妳}{M#你}推薦個能幹又利索的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990311
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 710990311,
					"content": "他雖然還不是我的徒弟，但我有心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990312
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 710990312,
					"content": "路爺，村長要的椅子一套四把，除了最後一把木頭不夠，其他我都打好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990313
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990313,
					"content": "辛苦大雨幫村子裡幹活了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990314
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990314,
					"content": "#正好，說到他他就到。我剛才是想說，{F#妳}{M#你}找大雨也是一樣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990315
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 710990315,
					"content": "找我？路爺還沒收我當徒弟呢，我可不能代表范木堂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990316
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990316,
					"content": "就你話多，人家是代璃月港的和裕茶館來的，要請我們上門去造個新戲臺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990317
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 710990317,
					"content": "哦，請「我們」去造戲臺？我跟路爺合起來算是「我們」，村長奶奶您聽見了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990318
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990318,
					"content": "聽見了，呵呵老路啊，大雨這孩子放著別的木匠師傅不跟，跑到范木堂跟著你學。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990319
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990319,
					"content": "他做事又快又好心還誠，你也差不多得了，收了人家當徒弟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990320
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990320,
					"content": "知道了知道了，我都讓他代我上門給人家幹活了，我這什麼意思你們還不明白嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990321
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 710990321,
					"content": "謝謝師父！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990322
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990322,
					"content": "大雨，師父給你派的第一件活就是給和裕茶館造戲臺，好好幹，不要丟了我的臉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990323
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 710990323,
					"content": "小意思，在群玉閣上建戲臺的木匠我給他打過下手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990324
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990324,
					"content": "少吹點牛吧，和裕茶館的老戲臺用了幾十年都沒換，你這次去也得給人家造一個結實的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990325
					],
					"speakerTitle": "路爺"
				},
				{
					"id": 710990325,
					"content": "哦，鬧了半天原來是范二哥要換戲臺，他怎麼拖到今天還在用那個小戲臺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990326
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990326,
					"content": "行，我把手上這最後一把椅子打完就出發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990327
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990327,
					"content": "#這位{M#小哥}{F#姑娘}，不好意思{F#妳}{M#你}還要等等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990328
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990328,
					"content": "這最後一把椅子還缺三根松木，我去砍點松木。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990329,
						710990330
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990329,
					"content": "還要等等？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990331
					]
				},
				{
					"id": 710990331,
					"content": "那要不然您原地掏三根松木出來也行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990332
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990332,
					"content": "明白了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990333
					]
				},
				{
					"id": 710990333,
					"content": "真掏啊？那要不然您受點累，再給一份紅染料吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990334
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990334,
					"content": "你等著！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990335
					]
				},
				{
					"id": 710990335,
					"content": "嘿嘿，您大人有大量，別跟我計較。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990330,
					"content": "等不了了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990331
					]
				},
				{
					"id": 710990309,
					"content": "傭金只能給別人了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990310
					]
				},
				{
					"id": 710990303,
					"content": "有件事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990304
					]
				}
			]
		},
