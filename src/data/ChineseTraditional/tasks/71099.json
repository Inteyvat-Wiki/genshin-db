			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"茶博士劉蘇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710990101,
					"content": "嘿呀，晦氣！不講了，我今天絕對不講了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990102
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990103
					]
				},
				{
					"id": 710990103,
					"content": "這個小戲臺子太氣人，幾十年了都沒修過，臺上的人稍微一動彈，它就要嘎吱嘎吱響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990104
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990104,
					"content": "老早就跟我們東家范二爺說了這戲臺得換新的，他總找藉口說沒有好木匠，不樂意換。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990105
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990105,
					"content": "今天我正在臺上講《海山履雲記》呢，我這擺個架勢它就要嘎吱一聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990106
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990106,
					"content": "別提多破壞氣氛了，台下觀眾都樂了，還有幾個壞東西給我喝倒彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990107
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990107,
					"content": "我今天不忍了，一定得找個好木匠，直接帶到二爺跟前，看他還有什麼理由不換。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990108
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990108,
					"content": "#我記得{F#妳}{M#你}是冒險家協會的對吧，我直接委託{F#妳}{M#你}也是一樣的，{F#妳}{M#你}幫我找個木匠行不行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990109,
						710990110
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990109,
					"content": "怎麼找？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990111
					]
				},
				{
					"id": 710990111,
					"content": "#也是，一看{F#妳}{M#你}就不是璃月人，{F#妳}{M#你}哪兒認識好木匠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990112
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990112,
					"content": "#這樣吧，輕策莊「范木堂」路爺的手藝特別出名，請{F#妳}{M#你}代我問問他老人家願不願意來幫這個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990113
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990113,
					"content": "要是他沒有空，派個徒弟來也行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990114
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990114,
					"content": "讓范木堂的木匠給我們造戲臺肯定是夠了，要是造得好，以後雲老闆來登臺我們也有面子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990115
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990115,
					"content": "哎呀絕了，我這個理由想得可太好了，不由得二爺不答應哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990116
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990116,
					"content": "#{F#妳}{M#你}放心，要是能把木匠帶回來，酬金肯定不會拖欠{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990117
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990117,
					"content": "明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990118
					]
				},
				{
					"id": 710990118,
					"content": "#那就靠{F#妳}{M#你}了，我每天都在茶館，有結果了回來找我就成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990110,
					"content": "找哪個木匠？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990111
					]
				}
			]
		},
		{
