			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109908",
							"2"
						],
						"stepId": 7109908,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"雲堇"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710990801,
					"content": "雲先生，我還在想二爺怎麼就不願意造戲臺呢，明明是百利無一害的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990802
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990802,
					"content": "妳一試探我才明白，還是妳聰慧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990803
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990803,
					"content": "二爺念舊我是能明白，就是沒想到，這都幾十年了，他還惦記著以前的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990804
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990804,
					"content": "這下就都明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990805
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990805,
					"content": "我沒明白。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990806
					]
				},
				{
					"id": 710990806,
					"content": "#這是以前的舊事，既然{F#妳}{M#你}也被捲進來了，那告訴{F#妳}{M#你}也無妨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990807
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990807,
					"content": "范二爺年輕的時候也能唱，和若心前輩常年搭戲，他們兩個總在臺上扮一對，大概二爺心裡當了真吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990808
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990808,
					"content": "不過，若心前輩其實另有心上人，後來她逐漸厭倦了舞臺生活，就和她那位一道去了輕策莊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990809
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990809,
					"content": "不知道中間出了什麼變故，那位沒能和若心前輩在輕策莊團聚，她就孤身留在了那裡，直到現在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990810
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990810,
					"content": "二爺知道我常去輕策莊看望若心前輩，總跟我打聽她的近況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990811
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990811,
					"content": "可見他還是念著若心前輩，不願意造新戲臺也是想給過去留個念想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990812
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990812,
					"content": "唉，既然這個戲臺對二爺這麼重要，那新戲臺肯定是修不了了，木匠也白請了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990813
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990813,
					"content": "這也未必，我有辦法，劉蘇先生等著看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990814
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990814,
					"content": "妳當真有好辦法？只要能修成，我事後一定好好謝謝雲老闆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990815
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990815,
					"content": "#多了我也不需要，劉蘇先生單給我講一場《裁雨聲》吧，這回我想聽完，{NICKNAME}也可以一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990816
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990816,
					"content": "感覺雲堇和平時不太一樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990817
					]
				},
				{
					"id": 710990817,
					"content": "我們茶館和雲翰社的交情多厚哪，雲老闆跟我們當然比跟別人親近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990818
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990818,
					"content": "#您放心，以後一定單獨給{F#妳}{M#你}們開一場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990819
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990819,
					"content": "好了，我們「茶」也喝完了，該去跟二爺說道說道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雲堇"
				}
			]
		},
		{
			"id": 7109909,
			"completionStepIds": [
				7109909
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109909",
							"2"
						],
						"stepId": 7109909,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"范二爺"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710990901,
					"content": "二爺，我們剛剛正喝著茶，我突然想起來若心前輩跟我說什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990902
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990902,
					"content": "哦，她說什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990903
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990903,
					"content": "她說：「二哥總愛跟自己過不去，聽著讓人難過。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990904
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990904,
					"content": "唉，還是她明白我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990905
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990905,
					"content": "不過，她好像也不怎麼懷念這個舊物件啊，只有我還在自己跟自己較勁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990906
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990906,
					"content": "我堅持不讓別人動這個戲臺不是自討沒趣嗎？算了算了，你們修吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990907
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990907,
					"content": "二爺這是有情有義，怎麼能說是自討沒趣呢？您這麼說我可不愛聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990908
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990908,
					"content": "戲臺還是要修的，但也不能破壞了二爺的念想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990909
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990909,
					"content": "你們終於肯動工了啊？好，我這就安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990910
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990910,
					"content": "我準備的圖紙你們可以看看，群玉閣上那座大戲臺就是照著這份圖紙打造的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990911
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990911,
					"content": "按照這個設計，這兩邊的牆都要打掉哈，還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990912
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990912,
					"content": "不著急，這個戲臺我想還是得修舊如舊，既然是木地板響動影響演出，那就先修修地板。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990913
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990913,
					"content": "其餘的往後再說，劉蘇先生，這樣可以嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990914
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710990914,
					"content": "只要這戲臺修完了不再影響平時演出，具體怎麼修都聽雲老闆和二爺安排。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990915
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710990915,
					"content": "啊，就這樣？不造新戲臺了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990916
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710990916,
					"content": "我看這樣好，還是雲老闆的主意妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990917
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990917,
					"content": "正巧修戲臺用的木板也不用額外採購，碼頭上就有現成的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990918
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990918,
					"content": "#這位…{NICKNAME}還得麻煩{F#妳}{M#你}走一遭，這次跑腿的酬金稍後一起給{F#妳}{M#你}結算好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990919
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710990919,
					"content": "可以。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710990920
					]
				},
				{
					"id": 710990920,
					"content": "…好吧，一起交給我好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大雨"
				}
			]
		},
		{
			"id": 7109911,
			"completionStepIds": [
				7109911
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7109911",
							"2"
						],
						"stepId": 7109911,
						"stateName": "QUEST_STATE_UNFINISHED"
