					"nextDialogs": [
						710990405
					]
				},
				{
					"id": 710990405,
					"content": "哎呀我還不知道他啊，二哥都多大年紀了，還跟自己過不去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710990406
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710990406,
					"content": "算了不提了，待會兒雲家的小姑娘要來做客，我過會兒得回去收拾收拾。",
					"roleType": "TALK_ROLE_NPC",
