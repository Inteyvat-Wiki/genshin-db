	"talks": [
		{
			"id": 7109901,
			"completionStepIds": [
				7109901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
