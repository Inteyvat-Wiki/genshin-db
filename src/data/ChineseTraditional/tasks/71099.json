				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大雨"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710991101,
					"content": "行吧，這幾塊木板應該夠用了，我這就開工。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991102
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991102,
					"content": "",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710991103
					]
				},
				{
					"id": 710991103,
					"content": "不錯不錯，果然修舊如舊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991104
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710991104,
					"content": "什麼都沒變啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710991105
					]
				},
				{
					"id": 710991105,
					"content": "這位年輕師傅，麻煩你從輕策莊走了這麼遠的路，工錢方面，你出個價吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991106
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710991106,
					"content": "我還以為接了個大活，結果只要修補幾塊木板，那就簡單了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991107
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991107,
					"content": "我是個新人，也不跟你多要，兩頓飯錢就差不多了，你給八千吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991108
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991108,
					"content": "這個價格真是公道，很好很好，不過我只能出兩千。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991109
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710991109,
					"content": "什麼？你不如直接叫我打白工算了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991110
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991110,
					"content": "我們二爺是這樣的，砍價講究一個對截攔腰砍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991111
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710991111,
					"content": "每逢講價都是先砍一半，再削一半，比較…嗯…「精打細算」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991112
					],
					"speakerTitle": "茶博士劉蘇"
				},
				{
					"id": 710991112,
					"content": "好傢伙，你這個老闆真夠摳門的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991113
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991113,
					"content": "就補了幾塊木板嘛，兩千兩千，多一摩拉我也給不出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991114
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710991114,
					"content": "算了，這也是我第一件委託，這個啞巴虧我吃了，回頭老闆你給多宣傳宣傳我們范木堂啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991115
					],
					"speakerTitle": "大雨"
				},
				{
					"id": 710991115,
					"content": "當然當然，那是一定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991116
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710991116,
					"content": "#這位年輕朋友，{F#妳}{M#你}也辛苦了，酬金我不會虧{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991117
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710991117,
					"content": "#{F#妳}{M#你}覺得這份圖紙怎麼樣，我看畫得很仔細啊，應該值不少錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991118,
						710991119
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710991118,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710991120
					]
				},
				{
					"id": 710991120,
					"content": "啊哈哈，不精打細算怎麼做生意呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991121
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710991121,
					"content": "還有雲老闆，妳一上門就幫我解決了一個小麻煩，我該怎麼謝妳呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991122
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710991122,
					"content": "二爺說笑了，這有什麼謝不謝的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991123
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710991123,
					"content": "我今天到茶館來，本來是想看看您家「星燕」姑娘，請她陪我一起去看搖滾演出。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991124
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710991124,
					"content": "哦哦，這個雲丫頭，又想聽那個什麼搖滾演出了啊？來跟我串供了是吧，呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991125
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710991125,
					"content": "這怎麼是串供呢，我只是好久沒見「星燕」了，很想念她這個好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991126
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710991126,
					"content": "要是我們戲社的人問起來，您知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991127
					],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710991127,
					"content": "我知道了，「你問雲老闆啊？雲老闆來找我家『星燕』一起繡了半天的花。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991128
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710991128,
					"content": "我到時候就這麼說，妳滿意不滿意呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710991129
					],
					"speakerTitle": "范二爺"
				},
				{
					"id": 710991129,
					"content": "那就說定了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雲堇"
				},
				{
					"id": 710991119,
					"content": "真摳門。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710991120
					]
				}
			]
		},
