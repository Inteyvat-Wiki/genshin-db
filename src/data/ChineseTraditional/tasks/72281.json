			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"五郎",
					"村田"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722811301,
					"content": "五郎，你剛才好勇敢啊，明明不擅長對付神子，卻不僅答應了參加頒獎，還提出了自己的要求。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722811302,
					"content": "真的嗎？當時我只是一想到珊瑚宮大人的囑託，還有海祇島的居民，就一下子有了勇氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811303
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811303,
					"content": "我可是海祇島的大將，怎麼能輸在這種地方？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811304
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811304,
					"content": "現在，我已經找到領兵作戰時候的感覺了，接下來，就算是八重神子親自來談判，我也不會被她的壓迫力影響了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811305
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811305,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811306
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811306,
					"content": "五郎，你看起來好像還是有點緊張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722811307,
					"content": "哈哈，大概是因為想到，那個女人說不定會提出什麼捉弄我的要求吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811308
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811308,
					"content": "幾位，抱歉讓你們久等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811309
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811309,
					"content": "情況怎麼樣，八重宮司她說了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811310
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811310,
					"content": "八重大人說，可以答應客人您的要求，把獎品的輕小說都換成農業科學類書籍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811311
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811311,
					"content": "太好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722811312,
					"content": "而且八重大人說，考慮到客人您使用書籍的目的，還可以額外多贈送您一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811313
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811313,
					"content": "您現在就可以跟我去八重堂的倉庫選書。客人乘坐的船是明天晚上，選好的書籍會由我們打包直接送上船。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811314
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811314,
					"content": "直接打包？那頒獎儀式該怎麼辦呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811315
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811315,
					"content": "八重大人說，選書會耗費不少時間精力，為了讓您能在容彩祭上有一段美好的回憶，頒獎儀式就取消了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811316
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811316,
					"content": "不過，她給您留下了一封信，您可以在有時間的時候再讀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811317
					],
					"speakerTitle": "村田"
				},
				{
					"id": 722811317,
					"content": "沒想到八重神子竟然會取消頒獎儀式…唉，我之前一直認定了會被她狠狠作弄，現在看來，是我太狹隘了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811318
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811318,
					"content": "#那先跟這位編輯小姐去選書了，就不麻煩{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722811319,
						722811320
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811319,
					"content": "五郎，明天晚上再見吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811321
					]
				},
				{
					"id": 722811321,
					"content": "好，那就明天晚上再見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五郎"
				},
				{
					"id": 722811320,
					"content": "我們兩個去碼頭送你們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722811321
					]
				}
			]
		},
