	"talks": [
		{
			"id": 7228102,
			"completionStepIds": [
				7228102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228102",
							"2"
						],
						"stepId": 7228102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海",
					"五郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810201,
					"content": "#{NICKNAME}，派蒙，好久不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810202
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810202,
					"content": "哇，是心海和五郎，沒想到海祇島的現人神巫女和大將，也來參加容彩祭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810203,
					"content": "對，不過我們並不是以海祇島管理者的身分，而是以個人身分受到了邀請。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810204
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810204,
					"content": "最近難得海祇島事務不多，我又想買些書，於是就決定來一趟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810205
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810205,
					"content": "五郎其實對容彩祭興趣不大，但聽說我要來離島，就也跟著一起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810206
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810206,
					"content": "畢竟珊瑚宮大人要離開海祇島，而且今天還要去見「筆友」，我身為大將，當然要確保大人的安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810207
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810207,
					"content": "「筆友」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810208,
					"content": "對，我們是最近才認識，然後開始聯絡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810209
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810209,
					"content": "我和筆友對輕小說的口味很接近，經常能聊到不少有趣的想法。當然了，我們也有針鋒相對、互不相讓的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810210
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810210,
					"content": "因為我們這次都會來容彩祭，所以決定趁機開一場「小說鑒賞會」，聊聊彼此對小說的看法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810211
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810211,
					"content": "聽起來好專業的樣子！對了，你們兩個既然都喜歡小說，要不要試著一起創作？說不定還能改變當今稻妻的文壇局勢呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810212,
					"content": "呵呵，這倒是個很有趣的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810213
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810213,
					"content": "#快到見面的時間了，{NICKNAME}，我和五郎要準備去約定地點和對方會合了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810214
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810214,
					"content": "心海，其實我有點好奇妳的筆友，我能不能也跟過去看看？妳放心，我就遠遠看一下，不會打擾你們聚會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810215,
					"content": "#讓我想想…{F#妳}{M#你}們二位應該沒有問題，那就一起去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				}
			]
		},
		{
			"id": 7228104,
			"completionStepIds": [
				7228104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228104",
							"2"
						],
						"stepId": 7228104,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海",
					"五郎",
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722810401,
					"content": "約定的地點就在這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810402
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810402,
					"content": "周圍沒有其他人，看樣子是我們來得比較早…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810403
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810403,
					"content": "哎呀呀，讓我看看是誰來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810404
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810404,
					"content": "神、神子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810405,
					"content": "（糟糕了，沒想到竟然碰到了神子！神子和心海不僅分屬兩個陣營，信仰的神明也不同。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810406,
					"content": "（她們兩個之間…不會發生什麼衝突吧？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810407,
					"content": "不愧是鳴神大社的宮司大人，果然是一副高高在上的態度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810408
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810408,
					"content": "呵呵，不愧是海祇島的領袖，雖說看起來就像水母一樣柔弱，但就連說出的話都是有毒的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810409
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810409,
					"content": "啊…這、這可怎麼辦才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810410,
					"content": "妳好，初次見面，「玲瓏油豆腐」小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810411
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810411,
					"content": "請多關照囉，「深海舌鮃魚」小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810412
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810412,
					"content": "呵呵呵呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810413
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810413,
					"content": "欸…這到底是怎麼回事？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810414,
					"content": "原來心海的筆友，竟然是神子嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810415,
					"content": "不對不對，看她們兩個的樣子，根本就是早知道彼此的身分！這麼說的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810416,
						722810417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810416,
					"content": "所謂的筆友見面…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				},
				{
					"id": 722810418,
					"content": "#嗯？{F#妳}{M#你}在說什麼呀，我怎麼聽不懂？我明明只是來和「深海舌鮃魚」小姐開「小說鑒賞會」的呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810419
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810419,
					"content": "我們走吧，鑒賞會的地點就在上面的勘定奉行府裡，那兒風景很好，特別適合喝喝茶，聊聊創作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810420
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810420,
					"content": "什麼樣的「小說鑒賞會」能開到勘定奉行府裡去啊，會相信才怪呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810421,
					"content": "我看妳們這次聊起來，就不是改變稻妻的文壇，而是要連整個稻妻的局勢都改變了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810422,
					"content": "呵呵，海祇島不久後會與幕府針對稻妻未來的發展進行正式會談，在會談前，這樣的非正式會晤也是必要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810423
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810423,
					"content": "對，尤其是我這種幕府之外的人出面，會更方便幫大家摸清彼此的底線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810424
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810424,
					"content": "只不過這才是我們第一次會面，對一般民眾來說，公佈消息還是略早了一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810425
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810425,
					"content": "原來是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810426,
					"content": "說起來，怎麼沒看見你們的大將？妳不是說他也會一起來的嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810427
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810427,
					"content": "咦，對喔，五郎他怎麼突然不見了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810428,
					"content": "五郎他幫我去採購書籍了，所以這次鑒賞會就不來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810429
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810429,
					"content": "哎呀，真可惜，我還以為又能看到他那雙毛茸茸的耳朵了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810430
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 722810430,
					"content": "#{NICKNAME}，借一步說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810431
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810431,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810432
					]
				},
				{
					"id": 722810432,
					"content": "我之前就隱約感覺到五郎不擅應對八重宮司，所以這次一開始，我才不想讓他跟我來離島。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810433
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810433,
					"content": "剛才他一看見八重宮司就躲了起來，恐怕是本能反應，但五郎責任心又很強，今後見到我，肯定會羞愧得無地自容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810434
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810434,
					"content": "所以我想把採購書籍的任務交給他，也能讓他心裡好受些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810435
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810435,
					"content": "#但五郎之前很少買東西，所以我想拜託{F#妳}{M#你}們跟他一起去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810436
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810436,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810437
					]
				},
				{
					"id": 722810437,
					"content": "心海，妳就放心和神子開會，買書的事就交給我們和五郎吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810438
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810438,
					"content": "#那就拜託{F#妳}{M#你}們了。這張紙上我列出了要買書籍的清單，{F#妳}{M#你}把它交給五郎吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 722810417,
					"content": "只是掩人耳目的托詞吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722810418
					]
				}
			]
		},
