					"nextDialogs": [
						722810708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810708,
					"content": "這是贈送您的狐狸玩偶，請您收好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810709
					],
					"speakerTitle": "福本"
				},
				{
					"id": 722810709,
					"content": "什麼，狐狸玩偶？",
