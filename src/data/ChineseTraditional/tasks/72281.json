					"nextDialogs": [
						722810710
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810710,
					"content": "這位客人，您怎麼了？好像尾巴上的毛都豎起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810711
					],
					"speakerTitle": "福本"
				},
				{
					"id": 722810711,
					"content": "不，我沒事，謝謝您的贈品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810712
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810712,
					"content": "#{NICKNAME}，這個狐…呃，玩偶，如果可以的話，還是請{F#妳}{M#你}收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810713
					],
					"speakerTitle": "五郎"
				},
