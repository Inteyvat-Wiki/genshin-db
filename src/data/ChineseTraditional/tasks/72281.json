			"dialogs": [
				{
					"id": 722810501,
					"content": "五郎，你還好吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810502,
					"content": "#啊！是{F#妳}{M#你}們…唉，沒想到那個女人竟然會突然出現，我實在是不知道該跟她說什麼。等我回過神來，就已經躲在這附近了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810503
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810503,
					"content": "我明明是為了保護珊瑚宮大人的安全才跟來的，結果卻什麼都做不到，反而成了她的負擔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810504
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810504,
					"content": "五郎，你不要太自責了，其實心海她託我們來告訴你，有個重要的任務交給你呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810505,
					"content": "把心海的書單交給五郎。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722810506
					]
				},
				{
					"id": 722810506,
					"content": "這是珊瑚宮大人的採購列表，我明白了，大人是希望我能將功補過！好，接下來就交給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810507
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 722810507,
					"content": "五郎，我們也陪你一起去吧，我們剛好可以作為嚮導，陪你在容彩祭上轉轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722810508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722810508,
					"content": "太感謝了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五郎"
				}
			]
