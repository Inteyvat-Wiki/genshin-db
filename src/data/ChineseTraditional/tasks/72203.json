			"dialogs": [
				{
					"id": 722030501,
					"content": "#哈哈，又被{F#妳}{M#你}發現了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030502
					],
					"speakerTitle": "音乃"
				},
				{
					"id": 722030502,
					"content": "那個，雖然有點捨不得，不過…這次我是來告別的。金色的叔叔說我們要走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030503
					],
					"speakerTitle": "音乃"
				},
				{
					"id": 722030503,
					"content": "#不過請不要擔心，我要去的地方會有好多人和我一起玩的！真希望{F#妳}{M#你}也能來呀…但是金色的叔叔說，還不到時候呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030504
					],
					"speakerTitle": "音乃"
				},
				{
					"id": 722030504,
					"content": "#不過沒關係的，沒關係的！我會等著{F#妳}{M#你}的。要是等不及了，我就會變成點點的光，落進{F#妳}{M#你}的夢裡找{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030505
					],
					"speakerTitle": "音乃"
				},
				{
					"id": 722030505,
					"content": "一路走好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722030506
					]
				},
				{
					"id": 722030506,
					"content": "#嗯，我會的。和{F#妳}{M#你}一起玩很開心，謝謝{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722030507
					],
					"speakerTitle": "音乃"
				},
				{
					"id": 722030507,
					"content": "再也不會孤單一個人了，真好呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "音乃"
