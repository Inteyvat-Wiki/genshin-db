			"dialogs": [
				{
					"id": 230181601,
					"content": "#{F#妳}{M#你}回來了。一切順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181602
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230181602,
					"content": "他已經有好幾天沒吃肉了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181603
					]
				},
				{
					"id": 230181603,
					"content": "什麼？我只是叮囑他吃得相對清淡一點，也沒要他完全不吃肉啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181604
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230181604,
					"content": "為了更確實地承接草神大人的恩惠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181605
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230181605,
					"content": "好吧…我回頭得把說法再變一變…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181606
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230181606,
					"content": "#{F#妳}{M#你}也辛苦了，這些報酬就請收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎卡里亞"
				}
			]
