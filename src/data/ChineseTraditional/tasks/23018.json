			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"扎卡里亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180101,
					"content": "唉，真不讓人省心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180102,
						230180103
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180102,
					"content": "有什麼要幫忙的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180119
					]
				},
				{
					"id": 230180119,
					"content": "最近我們的人手實在是不夠，我已經連續幾天沒休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180120
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180120,
					"content": "#旅行者，{F#妳}{M#你}如果有空的話，可以幫我送藥給附近的病人嗎？也請一併看看他們的狀況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180121,
						230180124
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180121,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180122
					]
				},
				{
					"id": 230180122,
					"content": "#那就拜託{F#妳}{M#你}了。看在草神的份上，我真的很需要一個不會整天唸叨草神保祐的人幫忙我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180123
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180123,
					"content": "哈，看在草神的份上…我唸得真熟練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180124,
					"content": "你還是休息一下吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180125
					]
				},
				{
					"id": 230180125,
					"content": "我可休息不得，還有一些更重的病人被我安置在別處了，我還得為他們配藥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180126
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180126,
					"content": "唉，那些病人肯定又要問我，他們該用什麼方法承接草神的恩澤了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180127
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180127,
					"content": "#拜託{F#妳}{M#你}了，旅行者，我真的很需要一個不會整天唸叨草神保佑的人給我幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180103,
					"content": "這裡發生什麼事了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180104
					]
				},
				{
					"id": 230180104,
					"content": "#{F#妳}{M#你}是旅行者吧，這裡是「健康之家」，是一家為普羅大眾…嗯…廣布草神恩澤的醫院。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180105
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180105,
					"content": "無論貧富，我們都會為需要的人提供醫療幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180106
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180106,
					"content": "不過也拜此所賜…最近來就診的病人太多，實在有些忙不過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180107
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180107,
					"content": "唉，就算草神對我們的仁慈是無限的…但醫院的預算和人力卻是有限的啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180108
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180108,
					"content": "有一些病人根本不聽醫囑，只是一個勁地問我，他該怎麼樣才能確實地承接草神恩澤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180109
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180109,
					"content": "哈哈，草神恩澤…看在老天的份上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180110
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180110,
					"content": "要是草神真的能直接降下恩澤，他們根本就不會得病了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180111
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180111,
					"content": "#…呼，抱歉，我不該說這樣的話，{F#妳}{M#你}可別告訴戈爾珊，不然她又要開始嘮叨了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180112,
						230180115
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180112,
					"content": "你不是一個虔誠的草神信徒嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180113
					]
				},
				{
					"id": 230180113,
					"content": "我確實是，這須彌城裡還有誰不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180114
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180114,
					"content": "#但{F#妳}{M#你}可以把虔誠這兩個字換掉，我是一個…相對理性的草神信徒，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180118,
					"content": "呃…抱歉，我一定是太累了，這是我個人的一點情緒，你別當真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180119
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180115,
					"content": "有人說治療本身就是草神恩澤…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180116
					]
				},
				{
					"id": 230180116,
					"content": "#唉，這些話{F#妳}{M#你}聽聽就行了，別和那些病人一樣把這件事當真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180117
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180117,
					"content": "如果草神真有這麼全能，那我就直接給病人吃點蘑菇，他們就能痊癒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180118
					],
					"speakerTitle": "扎卡里亞"
				}
			]
		},
		{
			"id": 2301802,
			"completionStepIds": [
				2301802
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
