			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"扎卡里亞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230180201,
					"content": "這次的藥是要送給藥田的古爾根。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180202
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180202,
					"content": "這位老兄前幾天工作得太用力，拉傷了自己的手臂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180203
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180203,
					"content": "#{F#妳}{M#你}就把這副藥送給他，順便告訴他，今天在家裡向草神大人默禱，不要下地工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180204,
						230180205
					],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180204,
					"content": "好的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180207
					]
				},
				{
					"id": 230180207,
					"content": "送完藥就回來找我吧，我會準備好報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "扎卡里亞"
				},
				{
					"id": 230180205,
					"content": "向草神大人默禱？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230180206
					]
				},
				{
					"id": 230180206,
					"content": "#我不這麼說，他怎麼可能會聽？好了，{F#妳}{M#你}就按我說的做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230180207
					],
					"speakerTitle": "扎卡里亞"
				}
			]
		},
		{
			"id": 2301803,
			"completionStepIds": [
				2301803
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
