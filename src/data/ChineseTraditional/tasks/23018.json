			},
			"dialogs": [
				{
					"id": 230181501,
					"content": "嗯？這個藥是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181502
					],
					"speakerTitle": "阿夫塔"
				},
				{
					"id": 230181502,
					"content": "這是你的藥。注意保持飲食清淡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230181503
					]
				},
				{
					"id": 230181503,
					"content": "唉…好，放心吧。我已經好幾天<color=#00E1FFFF>沒碰過肉</color>了，這樣一定能好好地承接草神大人的恩惠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230181504
					],
					"speakerTitle": "阿夫塔"
				},
				{
					"id": 230181504,
					"content": "不過怎麼感覺身體還不如以前了呢？唉，一定是時間還不夠久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿夫塔"
				}
			]
		},
