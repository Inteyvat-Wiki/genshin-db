			},
			"dialogs": [
				{
					"id": 746780101,
					"content": "私鬥私鬥！抓起來抓起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780102
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780102,
					"content": "發現危險的秘境後，不盡快報告給執律庭，還擅自進行調查並使用武力…你這傢伙是不是瘋了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780103
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780103,
					"content": "大大大大人！我人不在楓丹廷，打的也是魔物，這也要被抓嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780104
					],
					"speakerTitle": "科斯唐坦"
				},
				{
					"id": 746780104,
					"content": "那你是冒險家協會的註冊成員嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780105
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780105,
					"content": "不是…我體能未達標準，沒通過測試…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780106
					],
					"speakerTitle": "科斯唐坦"
				},
				{
					"id": 746780106,
					"content": "那你有提前向執律庭報備自己需要在楓丹境內使用武器嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780107
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780107,
					"content": "還有這種事？原來使用武器還要報備的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780108
					],
					"speakerTitle": "科斯唐坦"
				},
				{
					"id": 746780108,
					"content": "當然啊！不然隨便什麼人都可以在楓丹打架的話，執律庭不就變成裝飾了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780109
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780109,
					"content": "沒有報備過的話，小心警衛機關把你這種喜歡拿著武器亂揮的傢伙當成入侵者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780110
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780110,
					"content": "你看看你，簡直就像個假楓丹人，被抓不冤枉吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780111
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780111,
					"content": "失算了失算了！身為作家取材卻不夠仔細，忽略了重要的基本設定…我真是失職！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780112,
						746780113
					],
					"speakerTitle": "科斯唐坦"
				},
				{
					"id": 746780112,
					"content": "我們常常隨意調查秘境吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746780114
					]
				},
				{
					"id": 746780114,
					"content": "不過我們兩個早就成為冒險家了，應該沒什麼問題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746780115,
					"content": "#哦？{F#妳}{M#你}們兩位大名人來了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780116
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780116,
					"content": "咳咳，我是昂吉安妮，常年在野外執勤的老牌警備隊員。不久前，我在附近巡邏的時候發現了這個冒失的傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780117
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780117,
					"content": "#他向我交待了他在這裡鬼混的前因後果，又介紹了這個奇怪的秘境，還說{F#妳}{M#你}們兩位也參與了這場「劍舞」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780118
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780118,
					"content": "噫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780119,
						746780120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746780119,
					"content": "我們在秘境裡玩得還滿開心的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746780121
					]
				},
				{
					"id": 746780121,
					"content": "#那當然不可能了！相反地，{F#妳}{M#你}們是見義勇為的優秀冒險家，我還要給{F#妳}{M#你}們一筆獎金！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780122
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780122,
					"content": "這次我們針對的只是「未經報備就隨意使用武力」這一件事，把這傢伙抓回去以後，也只是對他進行口頭教育。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780123
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780123,
					"content": "基本上他也沒犯什麼大錯，當然不可能被重重懲罰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780124
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780124,
					"content": "就算要繳納罰金，我可能也拿不出幾個摩拉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780125
					],
					"speakerTitle": "科斯唐坦"
				},
				{
					"id": 746780125,
					"content": "還好還好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746780126,
					"content": "科斯唐坦雖然說話很誇張，但一定不是什麼壞人…他只是沉迷於華麗戰鬥的表現，想要寫好小說而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746780127,
					"content": "聽到沒？兩位大名人都在幫你講話了…下次不要再犯這種錯了，冒失的好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780128
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780128,
					"content": "下次我一定會把前置作業做好再來實地取材的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780129
					],
					"speakerTitle": "科斯唐坦"
				},
				{
					"id": 746780129,
					"content": "那我就照規章辦事了，先帶他回執律庭，好好教育他一番。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780130
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780130,
					"content": "再過一段時間，其他警備隊員就會趕過來控制住這座秘境…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780131
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780131,
					"content": "#不過有{F#妳}{M#你}們兩位在，這座秘境也構成不了什麼威脅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780132
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780132,
					"content": "#如果{F#妳}{M#你}們還有興趣繼續在裡面戰鬥一番、擊敗更多魔物…也可以讓之後的警備隊員輕鬆一點，算是幫大忙了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746780133
					],
					"speakerTitle": "昂吉安妮"
				},
				{
					"id": 746780133,
					"content": "結果我們不知不覺就成了見義勇為的好人，拿到了劍舞作家和執律庭的雙份獎勵…也不算是白忙一場吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746780120,
					"content": "妳要把我們兩個也一起抓走嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746780121
					]
				},
				{
					"id": 746780113,
					"content": "我們好像也沒有報備吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746780114
					]
				}
			]
		}
	]
}