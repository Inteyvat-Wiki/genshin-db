					"朝倉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310401,
					"content": "呼、呼…閣下的武藝真是遠超於我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310402
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310402,
					"content": "我下次輕點…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310403
					]
				},
				{
					"id": 220310403,
					"content": "不！請閣下還是使出全力吧，不經歷磨礪，我就不會成長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310404
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310404,
					"content": "您之所以如此強大，應該也是經歷了無數鍛煉吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310405
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310405,
					"content": "恕我唐突，我真的很好奇，您是…怎麼鍛煉自己的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310406,
						220310408
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310406,
					"content": "有一隻巨龍幫我訓練飛行。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310407
					]
				},
				{
					"id": 220310407,
					"content": "居、居然能和巨龍一起飛行，真是難以想像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310410,
					"content": "就是…順便而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310411
					]
				},
				{
					"id": 220310411,
					"content": "哈哈哈，是這樣嗎？那您可絕對算得上是天賦異稟了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310412
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310412,
					"content": "謝謝您和我對練，這場比試，在下銘記在心。這些報酬，請您收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310408,
					"content": "有一匹巨狼幫我磨礪武藝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220310409
					]
				},
				{
					"id": 220310409,
					"content": "聽起來真是…勇武無匹。真想見識一下您和那匹巨狼戰鬥的場景啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310410
					],
					"speakerTitle": "朝倉"
				}
			]
		},
