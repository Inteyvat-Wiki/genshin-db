					"朝倉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220310301,
					"content": "您剛才似乎走神了？步伐很混亂，攻擊時的力道也時強時弱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220310302
					],
					"speakerTitle": "朝倉"
				},
				{
					"id": 220310302,
					"content": "這樣可不行啊，請您再準備準備，我們等會再來一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				}
			]
		},
		{
			"id": 2203104,
			"completionStepIds": [
				2203104
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
