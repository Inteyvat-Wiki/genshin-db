			},
			"dialogs": [
				{
					"id": 220310201,
					"content": "哎呀，閒話就不說了，我可不能浪費您的時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朝倉"
				}
			]
		},
		{
			"id": 2203103,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
