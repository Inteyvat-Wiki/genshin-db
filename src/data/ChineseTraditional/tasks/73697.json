	"talks": [
		{
			"id": 7369701,
			"completionStepIds": [
				7369701
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369701",
							"2"
						],
						"stepId": 7369701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736970101,
					"content": "說起來，看習慣了斯露莎現在的樣子，都快想不起來沒有花冠時的斯露莎是什麼模樣了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970102,
					"content": "唔…印象裡好像是頭頂光溜溜，說話還總是一副了不起的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970103,
					"content": "沒想到能這麼順利地獲得花冠…雖然都是多虧了我們幫忙，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970104,
					"content": "咳！過去的瑣事就不必再提了。白飄飄，妳可別弄錯了重點，之所以能順利地獲得花冠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970105
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970105,
					"content": "那是因為我是配得上「雙角的花冠」的花靈，所以一切都順理成章，就好像我從誕生之日起就擁有它…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970106
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970106,
					"content": "身後傳來了熟悉的聲音…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736970107
					]
				},
				{
					"id": 736970107,
					"content": "呵呵，語氣倒是不小嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970108
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970108,
					"content": "前、前輩？！妳怎麼會在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970109
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970109,
					"content": "當然是關心新任的花靈勇者有沒有履行勇者的職責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970110
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970110,
					"content": "勇、勇者的職責…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970111
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970111,
					"content": "啊呀，斯露莎該不會以為只要拿到名號就萬事大吉了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970112
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970112,
					"content": "怎麼會！我可不是那麼天真的花靈。勇者的職責…並沒有怠慢，那些值得稱頌的偉業我也是有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970113
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970113,
					"content": "一瞬的光焰固然奪目，如涓涓細流的持久奉獻也未必不值得稱頌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970114
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970114,
					"content": "唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970115
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970115,
					"content": "在斯露莎疏遠我們反而親近人類的這些年月裡，可是有不少花靈即便與勇者之名無緣，卻也默默做著奉獻呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970116
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970116,
					"content": "唔唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970117
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970117,
					"content": "原本以為斯露莎當然會做些「名副其實」的符合「勇者」身分的事呢，原來只是在無所事事地閒逛呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970118
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970118,
					"content": "#說什麼無所事事也太過分了，斯露莎還是很了不起的！對吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970119,
						736970120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970119,
					"content": "確實。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970122
					]
				},
				{
					"id": 736970122,
					"content": "我也不是有意怠慢，只是勇者的職責具體指什麼…矯論團也沒有這方面的記載…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970123
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970123,
					"content": "畢竟是花靈的傳統，想從人類那裡瞭解未免捨近求遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970124
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970124,
					"content": "雖說得到了靈光的認可，但畢竟還是年輕的花靈。這種時候就該率直一點，向我請教便好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970125
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970125,
					"content": "直接向前輩請教？可是…不，花冠包蘊了許多智慧，只要我稍後思忖一陣應該就能獲得答案吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970126
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970126,
					"content": "可是祖爾宛就在眼前，而且都說了只要問她她就會回答…居然不用自己去找答案了欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970127,
					"content": "#以我和{NICKNAME}豐富的旅行經驗來看，這樣的機會一旦錯過，之後一定會後悔的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970128,
					"content": "我可不是擔心前輩會編些話來打發我，只是，唔…我聽矯論團的人類說過，只有自己找到的答案才是有意義的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970129,
						736970131
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970129,
					"content": "那這句話不也是別人告訴妳的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970130
					]
				},
				{
					"id": 736970130,
					"content": "對啊，難道矯論團的人說的話比祖爾宛的話更可信嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970133,
					"content": "…嗯，「謁頌主」和白飄飄的話的確有幾分道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970134
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970134,
					"content": "我已經不是從前的斯露莎了，既然獲得了靈光的認可，行事也該更成熟一些，至少要不愧對勇者的名號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970135
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970135,
					"content": "咳，祖爾宛…前輩。關於勇者的職責具體指什麼內容，還望您不吝賜教。雖然過去疏忽了，但今後我一定會盡力補救的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970136
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970136,
					"content": "哇，斯露莎居然會乖乖說出這些話，怎麼回事，我居然覺得有點感動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970137,
					"content": "噗嗤…既然妳這樣說了，那我就放心了。勇者的職責細說起來可能幾天幾夜都說不完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970138
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970138,
					"content": "不過考慮到斯露莎這些年來與人類在一起的時間可是要遠遠超過與同族相伴的時間，還是先從簡單的內容說起吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970139
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970139,
					"content": "對於稱職的花靈勇者來說，出眾的行動力和敏銳的洞察力都是必須的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970140
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970140,
					"content": "我已經準備好了六項訓練內容，其中三項考驗飛行能力，另外三項嘛，需要斯露莎清除一些安全隱患。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970141
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970141,
					"content": "訓練內容聽起來有點熟悉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970142
					]
				},
				{
					"id": 736970142,
					"content": "哪裡是有點熟悉，簡直太熟悉啦，這不就是雜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970143
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970143,
					"content": "白飄飄不要多話，只要我順利完成這些任務，前輩就會認可我是獨當一面的花靈勇者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970144
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970144,
					"content": "雖然聽起來都很簡單，但這可是前輩給我的考驗，這時候就該拿出獅子搏兔的精神來應對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970145
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970145,
					"content": "呵呵，很好很好。正巧「謁頌主」與同伴也在，有一項任務希望兩位能協助斯露莎完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970146
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970146,
					"content": "並不是什麼難事，只是正如兩位所知，近年來斯露莎與矯論團的人類走得很近，對於我們花靈的傳統反而疏遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970147
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970147,
					"content": "此次想拜託兩位扮演聽眾，見證斯露莎回顧過往。能夠正確講述歷史對於無愧勇者之名的花靈來說也是理所當然的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970148
					],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970148,
					"content": "當然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970149
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970149,
					"content": "只是聽斯露莎講故事的話，好像還滿簡單的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970150
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970150,
					"content": "那麼，見證的工作，就交給兩位了。關於需要由斯露莎自行完成的訓練，我稍後講與她聽，兩位只要跟隨她便好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖爾宛"
				},
				{
					"id": 736970131,
					"content": "那可是文獻典籍都會出錯的矯論團…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970132
					]
				},
				{
					"id": 736970132,
					"content": "對啊，去找拉沙魯的時候，實際情況跟他們的文獻典籍上的記載根本不一樣嘛，而且就連他們自己也搞不清到底是怎麼回事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970120,
					"content": "該如何評價呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970121
					]
				},
				{
					"id": 736970121,
					"content": "#{NICKNAME}不要那麼嚴格嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970122
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7369706,
			"completionStepIds": [
				7369706
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7369706",
							"2"
						],
						"stepId": 7369706,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_GLOBAL_VAR_EQUAL",
						"rawParams": [
							"7303201",
							"1"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"斯露莎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 736970601,
					"content": "第一天的終點就是這裡嗎？這裡我們已經很熟悉了，畢竟都來過好多次了嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970602,
					"content": "哦？既然白飄飄這麼有自信，那不如我們身分對調，我來扮演聽眾，由妳來講述。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970603
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970603,
					"content": "好啊，試試就試試，瞧我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970604,
					"content": "我們眼前這片有花有水的地方就是甘露花海，這裡沒有…對了，沒有「迪弗諸魔」的侵擾，是花靈的家鄉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970605,
					"content": "在這裡有很多花靈，其中最了不起的那一個叫祖爾宛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970606,
					"content": "斯露莎也是在這裡誕生的吧？不過斯露莎跟其他的花靈不一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970607,
					"content": "如果說其他花靈說話只是有五分怪，那我們一開始見到的斯露莎說話有十分怪！唉，明明是一樣的水，為什麼只有斯露莎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970608,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970609
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970609,
					"content": "我可不是亂說的，一開始斯露莎跟矯論團的人說話的時候的確很怪嘛，唔，雖然矯論團的人說話也很怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970610,
					"content": "本來還以為其他花靈也和斯露莎一樣，到甘露花海來找祖爾宛之前還很擔心呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970611,
					"content": "最後發現只有斯露莎是這樣…應該說，斯露莎跟矯論團的人說話的時候才會這樣，欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970612,
					"content": "看來是受矯論團的人影響太深了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970613
					]
				},
				{
					"id": 736970613,
					"content": "唔…這一點我不否認。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970614
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970614,
					"content": "既然斯露莎沒問題，那我接著講。甘露花海裡的大樹樁子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970615,
					"content": "白飄飄，妳這傢伙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970616
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970616,
					"content": "是甘露花海裡的「萬種母樹」！花靈的詞彙都好難記，而且，它本來就是大樹樁子嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970617
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970617,
					"content": "我記得斯露莎說過，大樹樁子其實是神明大人，而花靈一族也和這位神明大人有著不淺的關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970618,
					"content": "雖然事實是這樣沒錯…但總覺得繼續讓白飄飄講下去就太不敬了，還是由我來講吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970619
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970619,
					"content": "好吧…虧我還覺得自己講得很簡單易懂呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970620
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970620,
					"content": "哼…總之，五百年前，神明大人為了鎮壓此處的災厄而犧牲了全部，此處的甘露活水便是神明大人最後的遺贈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970621
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970621,
					"content": "受甘露活水的滋養，誕生了萬種母樹與吾輩花靈。而花靈之中的最古者，便是前輩…也就是祖爾宛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970622
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970622,
					"content": "我的誕生要晚許多，因此未能親歷那些事件。過去聽前輩說過一些，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970623
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970623,
					"content": "明明矯論團建立之初，前輩也是有參與的，但是在我誕生之後，他們之間已經沒什麼往來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970624
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970624,
					"content": "雖然前輩也說花靈的傳承是很重要的，但卻不常對我說起過去的細節。反倒是矯論團的人類…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970625
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970625,
					"content": "不僅非常熱心地和我分享他們對歷史的研究，還認同我效法神鳥的願望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970626
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970626,
					"content": "欸？所以之後斯露莎就漸漸疏遠花靈同族，還跟矯論團的人學會了那些怪話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970627,
					"content": "唔…從事實上來說，是這樣沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970628
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970628,
					"content": "聽起來像叛逆期…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970629
					]
				},
				{
					"id": 736970629,
					"content": "「叛逆期」…以前聽矯論團的人類說起過，森林裡的學者有什麼「林居狂語期」之類的階段，「叛逆期」也是類似的階段嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970630,
						736970632
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970630,
					"content": "對，和那個差不多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970631
					]
				},
				{
					"id": 736970631,
					"content": "不對，根本不是一回事吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970634,
					"content": "簡單說，叛逆期的人類小孩會反抗平日照顧自己的大人，並且提出一些自己的主張。我是這麼聽說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970635
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970635,
					"content": "嘿嘿，就跟之前的斯露莎一樣嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970636,
					"content": "哼，過去的我和現在的我可不一樣。不管怎麼說，現在的我已經回歸花海，並且得到了靈光的認可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970637
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970637,
					"content": "斯露莎可真了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970638
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970638,
					"content": "明明白飄飄也只是個小不點而已…罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970639
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970639,
					"content": "今日要講的就是這些了，「謁頌主」和白飄飄還有什麼想問的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970640
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970640,
					"content": "說起來，花靈和蘭那羅有關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970641
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970641,
					"content": "…為什麼會有這樣的疑問？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970642
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970642,
					"content": "因為花靈和蘭那羅都小小的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970643
					]
				},
				{
					"id": 736970643,
					"content": "但是做的事情卻很偉大呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970644
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970644,
					"content": "為斯露莎講述了與蘭羅摩等許多蘭那羅一同冒險的經歷…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						736970645
					]
				},
				{
					"id": 736970645,
					"content": "唔…無憂節居然是這麼重要的節日。聽前輩提起的時候，還以為只是蘭那羅聚在一起玩鬧而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970646
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970646,
					"content": "不過，既然蘭那羅都有自己的節日，為什麼我們花靈卻沒有呢？應該去跟前輩提一下這件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970647
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970647,
					"content": "那斯露莎為什麼想要花靈的節日呢？是因為節日可以吃好吃的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970648
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970648,
					"content": "當然不是！花靈的節日…應該讓人類來唱頌詩，由我來選出其中唱得最好的那一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970649
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970649,
					"content": "這聽起來一點都不像是節日…對來參加的人類來說，根本就是壓力十足的競賽吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970650
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970650,
					"content": "可是對我來說就是很快樂的節日呀？我想前輩一定也會喜歡這樣的節日的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970651
					],
					"speakerTitle": "斯露莎"
				},
				{
					"id": 736970651,
					"content": "唔…也許祖爾宛說得對，斯露莎要成為稱職的花靈勇者還需要一些磨練…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 736970632,
					"content": "該說是成長途中的必經之路嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						736970633
					]
				},
				{
					"id": 736970633,
					"content": "和學者才會有的林居狂語期不一樣，的確，聽說很多人類小孩都會有這個階段呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						736970634
					],
					"speakerTitle": "派蒙"
				}
			]
		},
