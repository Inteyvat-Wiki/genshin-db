			},
			"dialogs": [
				{
					"id": 715350201,
					"content": "#{NICKNAME}，真巧，{F#妳}{M#你}也來海燈節玩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350202
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350202,
					"content": "妳正在做「祝柬」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350203
					]
				},
				{
					"id": 715350203,
					"content": "是啊，我想要做一張「祝柬」送給坎蒂絲，可是一直沒做出滿意的，正打算再做一張新的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350204
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350204,
					"content": "坎蒂絲沒來嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715350205
					]
				},
				{
					"id": 715350205,
					"content": "她要來，不過…還要過一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350206
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350206,
					"content": "本來她都沒答應和我一起來璃月，說自己還要守著村子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350207
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350207,
					"content": "我和她說一年到頭了，就讓自己輕鬆一下，我正好要護送一支商隊來璃月，乾脆就和我一起來璃月過海燈節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350208
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350208,
					"content": "要是她不放心村子，我就叫團裡的弟兄們幫她守著村子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350209
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350209,
					"content": "可是坎蒂絲就是不答應，最後還是村裡的人勸了她好久，她才答應給自己放放假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350210
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350210,
					"content": "不過，她還要親自安排一些事情，等一切安排妥當後她才會過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350211
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350211,
					"content": "沒辦法，商隊也不會等我們…所以我就先來了璃月，在這裡等著她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350212
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350212,
					"content": "我想說先幫她買點禮物，可是璃月的好東西太多，我都快挑到眼花了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350213
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350213,
					"content": "最後，我挑了一條項鍊，又聽說璃月人在海燈節的時候，送禮都要附上一張特別的「祝柬」，所以我就打算幫自己設計一張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350214
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350214,
					"content": "結果…就和之前說的一樣，做來做去都不滿意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350215
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350215,
					"content": "#正好{F#妳}{M#你}來了，{NICKNAME}，{F#妳}{M#你}懂得多，能給我一點做「祝柬」的建議嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350216
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350216,
					"content": "沒問題，讓我研究一下…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
