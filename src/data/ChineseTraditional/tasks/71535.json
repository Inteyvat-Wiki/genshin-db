			"dialogs": [
				{
					"id": 715350401,
					"content": "#喔？{F#妳}{M#你}果然心靈手巧啊。這張「祝柬」真好看，謝啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350402
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350402,
					"content": "#這封「祝柬」就算是{F#妳}{M#你}送我的。現在我手頭沒帶寶貝，等回了須彌之後再寄回禮給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350403
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350403,
					"content": "我還要再做一封。等坎蒂絲來了再把項鍊和「祝柬」一起送出去，她一定會很高興的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715350404
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 715350404,
					"content": "不過話說回來，都過這麼久時間了，坎蒂絲怎麼還沒來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪希雅"
				}
			]
