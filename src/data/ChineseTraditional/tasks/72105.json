			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721050101,
					"content": "「噫！」…欸？我還以為花散里小姐會突然出現在我們身後呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050102,
					"content": "這麼說來，這是最後的第五處樹根了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050103,
					"content": "我還以為，這最後一處處理完了，她會像之前那樣「咻啪！」一下，出現在我們身後，給我們寶藏呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050104,
					"content": "「咻啪！」那樣是怎樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050105
					]
				},
				{
					"id": 721050105,
					"content": "就是「咻啪！」那樣呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050106,
					"content": "無論如何，「神櫻大祓」算是完成了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050107,
						721050108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050107,
					"content": "輕輕鬆鬆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050109
					]
				},
				{
					"id": 721050109,
					"content": "確實呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050110,
					"content": "我們幾乎走遍了整個鳴神島，甚至還到了海底。好累呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050111,
						721050113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050111,
					"content": "累的是我才對…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050112
					]
				},
				{
					"id": 721050112,
					"content": "#喂！派蒙可是一直在很用力很用力地為{F#妳}{M#你}加油的喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050114,
					"content": "之前，面具巫女小姐不是說，要我們淨化了所有五處樹根以後，就回去找她來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050115,
					"content": "#哼哼，肯定是要給我們獎勵了。{NICKNAME}，我們去紺田村井下的結界那找她吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050116,
					"content": "只要不是再給我們吃頓狸貓飯就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050113,
					"content": "還好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050114
					]
				},
				{
					"id": 721050108,
					"content": "經歷了很多呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050109
					]
				}
			]
		},
		{
			"id": 7210502,
			"completionStepIds": [
				7210502
