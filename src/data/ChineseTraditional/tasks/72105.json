			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721050201,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050202
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050202,
					"content": "面具巫女小姐，我們回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050203,
					"content": "幹得太漂亮了。雷櫻的根枝，一直在向我傳頌二位的功業。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050204
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050204,
					"content": "實在惶恐，我有一事應當向您坦白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050205
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050205,
					"content": "但言無妨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050206
					]
				},
				{
					"id": 721050206,
					"content": "是什麼事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050207,
					"content": "您在紺田村最初取得鎮物時，我稱您為「命定之人」。但在當時，我對您的品德與勇武並未毫無保留地完全相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050208
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050208,
					"content": "但隨著「大祓」的進展，您不但證明了我的淺薄與愚拙，還遠遠超出我的預想。以至於…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050209
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050209,
					"content": "我不禁感到遺憾。倘若當初，在「狐齋宮」的身邊，也有像您這樣的人，那或許…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050210
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050210,
					"content": "或許？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050211
					]
				},
				{
					"id": 721050211,
					"content": "不，沒什麼。是我多言了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050212
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050212,
					"content": "那麼，事情也告一段落了。獎勵呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050213,
						721050215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050213,
					"content": "獎勵呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050214
					]
				},
				{
					"id": 721050214,
					"content": "在此之前，還有一事未了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050217
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050217,
					"content": "「神櫻大祓」最終仍有一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050218
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050218,
					"content": "怎麼還有啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050219,
					"content": "作為守護土地、吸收汙穢的代價，瘴晦會積聚在根枝當中。您解除結界，擊敗了汙穢幻造的妖物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050220
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050220,
					"content": "正如社有枝社，所有雷櫻皆是影向山的「神櫻」之旁枝，那五條樹根更是其中為大者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050221
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050221,
					"content": "它們所吸收的汙穢，其實有很大一部分都傳到了影向山深處的神櫻當中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050222
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050222,
					"content": "所以最關鍵的是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050223
					]
				},
				{
					"id": 721050223,
					"content": "沒錯。「神櫻大祓」最關鍵的是在解除最後一步，也就是解除神櫻的結界，祓除神櫻之根多年積聚的瘴晦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050224
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050224,
					"content": "欸！神櫻是在鳴神大社吧？如果在鳴神大社痛毆妖怪，會引起騷動的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050225,
					"content": "呵呵，您多慮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050226
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050226,
					"content": "神櫻之根位於影向山的深處，在封印之下，與大社有著相當的距離。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050227
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050227,
					"content": "真的沒問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050228,
					"content": "毋須擔心。請您相信我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050229
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050229,
					"content": "既然面具巫女小姐都這麼說了，那就沒辦法啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050230,
					"content": "謝謝。那麼，我們盡快行動吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050215,
					"content": "事情還沒結束吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050216
					]
				},
				{
					"id": 721050216,
					"content": "確實如此。不愧是輕易解除了五處結界的人呢，有著如同穿過雲靄的月光般，看透事物的眼力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050217
					],
					"speakerTitle": "花散里"
				}
			]
		},
