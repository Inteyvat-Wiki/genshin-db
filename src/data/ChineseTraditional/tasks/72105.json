			},
			"dialogs": [
				{
					"id": 721050401,
					"content": "封印解除了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050402
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050402,
					"content": "接下來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050403,
					"content": "這下面好深…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050404
					]
				},
				{
					"id": 721050404,
					"content": "接下來，還請您允許我冒昧斗膽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050405
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050405,
					"content": "請您跳進去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050406,
						721050407
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050406,
					"content": "不、不太好辦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050409
					]
				},
				{
					"id": 721050409,
					"content": "這下面看起來好可怕，跳進去會出事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050410,
					"content": "二位不必擔心，雖然神櫻之根多有積穢，卻也識得行本回「大祓」之人的氣息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050411
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050411,
					"content": "她會保佑您安全著陸，以祛除最後的瘴晦的。我保證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050412
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050412,
					"content": "真的沒問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050413,
					"content": "請您相信我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050414
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050414,
					"content": "下去以後，我們要做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050415,
					"content": "一言以蔽之的話，施展您的勇武即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050416
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050416,
					"content": "積累的邪穢在影向山的最深處凝結成了碩大的「瘤」，現在由神櫻之根緊緊纏繞壓制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050417
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050417,
					"content": "抓緊時機，攻擊瘴晦瘤。但它受到攻擊時，必定會奮力掙扎，甚至會有妖物滋生，以此阻撓您的行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050418
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050418,
					"content": "期間，也需要您如同解除此前的五處封印那般，使周邊的機關運作，以此鞏固神櫻之根的壓制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050419
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050419,
					"content": "如此一來，神櫻就會配合您的行動，為您創造攻擊的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050420
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050420,
					"content": "聽起來好可怕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050421,
						721050422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050421,
					"content": "我打過更麻煩的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050423
					]
				},
				{
					"id": 721050423,
					"content": "我相信您的實力。那麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050424
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050424,
					"content": "妳不能一起去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050425
					]
				},
				{
					"id": 721050425,
					"content": "戰鬥結束後，我在下面與您會合，完成「大祓」的收尾之事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050426
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050426,
					"content": "真的非常抱歉。如我此前所說，以我的…身體狀況，無法完成這樣的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050427
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050427,
					"content": "還望您多多海涵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050428
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050428,
					"content": "那也沒辦法了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050429,
					"content": "那麼…請問您準備得如何了呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050430,
						721050432
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050430,
					"content": "我準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050431
					]
				},
				{
					"id": 721050431,
					"content": "那麼，還請您向前邁步，實行「神櫻大祓」最後的步驟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050434
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050434,
					"content": "無論如何，如果關於淨化之事，有任何想問的，還請您隨時來問我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050435
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050435,
					"content": "那麼…這就是最後的最後了。祝您一切順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050432,
					"content": "我還沒有準備好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050433
					]
				},
				{
					"id": 721050433,
					"content": "這樣啊…無論如何，禁錮此間邪穢的結界已經解除，如果可以的話，希望您能盡快解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050434
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050422,
					"content": "好可怕！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050423
					]
				},
				{
					"id": 721050407,
					"content": "派、派蒙會飛…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050408
					]
				},
				{
					"id": 721050408,
					"content": "#喂！{F#妳}{M#你}在說什麼呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050409
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7210505,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
