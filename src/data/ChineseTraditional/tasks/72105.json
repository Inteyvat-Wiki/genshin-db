				"points": []
			},
			"dialogs": [
				{
					"id": 721050501,
					"content": "關於淨化之事，您有什麼疑問嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050502,
						721050507,
						721050522
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050502,
					"content": "我要做什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050503
					]
				},
				{
					"id": 721050503,
					"content": "到達底部之後，您應當能見到被樹根緊緊纏繞鎮壓的「瘤」。那是穢物長年積累的結核，想辦法消滅它就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050504
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050504,
					"content": "它受到攻擊時，必定會奮力掙扎，滋生妖物阻撓您的行動。但我相信，對您而言不會是什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050505
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050505,
					"content": "期間，也需要您如同解除此前的五處封印那般，使周邊的機關運作，以此鞏固神櫻之根的壓制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050506
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050506,
					"content": "如此一來，神櫻就會配合您的行動，為您創造攻擊的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050507,
					"content": "「瘤」是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050508
					]
				},
				{
					"id": 721050508,
					"content": "簡單來說，就是積累在土地中的穢物的集合體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050509,
						721050512
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050509,
					"content": "就像愚人眾？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050510
					]
				},
				{
					"id": 721050510,
					"content": "魚人…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050511
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050511,
					"content": "如果說的是「人魚」之事的話，我倒是略有耳聞呢。但人魚不是穢物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050515
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050515,
					"content": "無論如何，在這片大地上總有傷病、苦痛、惡念。雖然難以想像，但戰爭或許有朝一日…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050516
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050516,
					"content": "發生戰爭的話，那就會帶來更多的傷病、苦痛與惡念。而這些事物帶來的汙穢就會累積，對大地造成傷害，一切事物都會惡化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050517
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050517,
					"content": "（看來她不知道…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050518
					]
				},
				{
					"id": 721050518,
					"content": "任由汙穢累積的話…菑癘橫行、凶將跋扈、百鬼跳樑…因為實在太過可怕，請您允許我按下不表。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050519
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050519,
					"content": "為了清除這些「穢物」，以前也聽說過，不同的地方有不同的做法。譬如說，璃月就有仙家、方士等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050520
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050520,
					"content": "為此，雷櫻的根系施展「離穢」的力量，吸收汙穢。而其中的部分汙穢，會透過根系，匯聚在影向之底。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050521
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050521,
					"content": "經年累月，就會結成那樣的「瘤」。而清除這樣的瘤，就是「神櫻大祓」的目標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050512,
					"content": "就像深淵教團？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050513
					]
				},
				{
					"id": 721050513,
					"content": "深淵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050514
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050514,
					"content": "雖然對您所說的事物不甚瞭解，但恐怕那也是即為黑暗汙穢之物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050515
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050522,
					"content": "那麼，我走了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050523
					]
				},
				{
					"id": 721050523,
					"content": "我明白了。如果關於淨化之事，有任何想問的，還請您隨時來問我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050524
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050524,
					"content": "這就是最後的最後了。祝您一切順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				}
			]
		},
		{
			"id": 7210506,
			"completionStepIds": [
				7210506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210505",
							"3"
						],
						"stepId": 7210505,
						"stateName": "QUEST_STATE_FINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7210506",
							"2"
						],
						"stepId": 7210506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"花散里"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721050601,
					"content": "那麼，一切都結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050602
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050602,
					"content": "這麼一來，神櫻承受的痛苦也終於消解了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050603
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050603,
					"content": "人之子…做得太漂亮了。您果真是「命定之人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050604
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050604,
					"content": "#呼，真是一場惡戰！還好平時我有在鍛煉{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050605,
						721050607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050605,
					"content": "謝謝，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050606
					]
				},
				{
					"id": 721050606,
					"content": "什麼嘛，不用這麼認真謝我啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050608
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050608,
					"content": "至於在最初約定好的報酬，稍後我會留下來，請二位稍安勿躁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050609
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050609,
					"content": "等一等等一等！之前不是說好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050610,
					"content": "「神櫻大祓」完成之後，面具巫女小姐妳會將自己的事情告訴我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050611
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050611,
					"content": "但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050612,
						721050613,
						721050614
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050612,
					"content": "我也想知道。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050615
					]
				},
				{
					"id": 721050615,
					"content": "就是就是。要不然，也太對不起我們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050616
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050616,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050617
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050617,
					"content": "我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050618
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050618,
					"content": "在那之前，有一事實在不勝惶恐。這麼一路上，我尚未有機會正式請教二位的名諱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050619
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050619,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050620
					]
				},
				{
					"id": 721050620,
					"content": "我叫派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050621
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050621,
					"content": "#{NICKNAME}大人，派蒙大人…真是好名字呢。我會銘記於心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050622
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050622,
					"content": "嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050623
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050623,
					"content": "如我先前所說，我確實繼承了「狐齋宮」的記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050624
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050624,
					"content": "這部分我很好奇呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050625
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050625,
					"content": "「狐齋宮」原本是白辰的血脈，曾與雷神同行，守護稻妻的子民。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050626
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050626,
					"content": "直到最終，在…我也無從得知多久之前的災厄中，「狐齋宮」為了保護鳴神島，而與漆黑的災厄作戰，最終被災厄吞沒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050627
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050627,
					"content": "但受她在各處布下的結界保護的人們有許多。雖然單純繼承了「記憶」的我實在不應有此僭越之意，但我也為這份記憶感到驕傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050628
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050628,
					"content": "妳是她的眷屬嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050629
					]
				},
				{
					"id": 721050629,
					"content": "像之前說的「天狐」、「地狐」那樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050630
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050630,
					"content": "這麼說來，此前我的確察覺到山頂的鳴神大社有相似的仙狐氣息…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050631
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050631,
					"content": "但不是這樣的。我並不是她的眷屬，倒不如說與此相反…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050632
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050632,
					"content": "吞食她的災厄最終被斬落，而她的思念與記憶也回到了鳴神島的大地中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050633
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050633,
					"content": "您在施行「神櫻大祓」的過程中，斬落了不少「落武者」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050634
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050634,
					"content": "唔…是說那些，像幽靈一樣的武士嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050635,
						721050636
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050635,
					"content": "輕輕鬆鬆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050637
					]
				},
				{
					"id": 721050637,
					"content": "那些妖物是汙穢凝聚而成的。而這些妖物的形態，通常都會由時代的思念、記憶左右。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050638
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050638,
					"content": "如果可以的話，希望二位能坦誠告訴我。如今的稻妻，難道說，籠罩在戰火之中嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050639
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050639,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050640
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050640,
					"content": "#（…怎麼辦，{NICKNAME}？）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050641,
						721050643
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050641,
					"content": "（老實說吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050642
					]
				},
				{
					"id": 721050642,
					"content": "好、好像確實是這樣呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050644
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050644,
					"content": "這樣啊。果真如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050645
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050645,
					"content": "當您告訴我，淨化雷櫻樹根時，被逼出來的妖物是「落武者」時，我就隱隱察覺到了。只要她走在自己堅信的路途上就好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050646
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050646,
					"content": "…言歸正傳。我…我「花散里」，是「狐齋宮」大人的記憶，凝聚而成的汙穢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050647
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050647,
					"content": "怎麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050648,
						721050649
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050648,
					"content": "我也隱約察覺了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050650
					]
				},
				{
					"id": 721050650,
					"content": "此前無法與二位一同行動、戰鬥，真的非常抱歉。因為我本身即是汙物，所以無法淨化其餘的邪穢妖物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050651
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050651,
					"content": "因為她的記憶非常強大，所以即使是漆黑的災厄，也沒能將其完全消解。災厄被擊敗後，它本身作為熾烈的汙穢，流入了大地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050652
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050652,
					"content": "於是，我誕生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050653
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050653,
					"content": "之前說，如果「狐齋宮」身邊有我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050654
					]
				},
				{
					"id": 721050654,
					"content": "是的。是有這麼一回事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050655
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050655,
					"content": "如果「狐齋宮」的身邊曾經有您這樣的人，或許她就能活下來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050656
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050656,
					"content": "倘若她有機會與您相識，那該是多麼美好的事情呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050657
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050657,
					"content": "但念及此，我又不禁自私地想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050658
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050658,
					"content": "「如果，如果真是那樣，那我也不會以這種方式，繼承她的記憶而誕生，並在最後與您相遇了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050659
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050659,
					"content": "透過「留念鏡」看到的妳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050660
					]
				},
				{
					"id": 721050660,
					"content": "沒錯，那是過去的我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050661
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050661,
					"content": "一開始，我相當不知所措。但隨著記憶復甦，我已經掌握了自己的身世，也明白自己的職責了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050662,
						721050663
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050662,
					"content": "也就是說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050665
					]
				},
				{
					"id": 721050665,
					"content": "我的職責就是守護鳴神島，祓除瘴癘，實行「神櫻大祓」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050666
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050666,
					"content": "面具巫女…花散里小姐本身就是「汙穢」，而「神櫻大祓」的目標是清除汙穢，也就是說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050667
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050667,
					"content": "妳也會被消滅掉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050668
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050668,
					"content": "嗯…消滅這個詞，或許稍微有點過分了吧？但從結果而言，確實是這樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050669
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050669,
					"content": "怎麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050670
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050670,
					"content": "呵呵，原本當我意識到這件事的時候，也感到很不安呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050671
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050671,
					"content": "#但是，自從認識了{F#妳}{M#你}們，透過你們瞭解到了如今稻妻的許多事情，我也漸漸釋然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050672
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050672,
					"content": "五百藏活了下來。雖然被惟神封印在了石頭裡，卻沒有一絲消沉的意思，對「狐齋宮」似乎也沒有怨恨…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050673
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050673,
					"content": "雖然不如過往，但紺田村的紺田、柴門的家系一直延續到了現在；大社的稻城彌里過去也曾是她的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050674
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050674,
					"content": "這些人，可是當年她在災難發生時，保護過的人的後代呢。倘若知道他們安好，並讓血脈一直傳承下去，她一定會很驕傲吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050675
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050675,
					"content": "雖然…雖然當時為「狐齋宮」贈給柊弘嗣的法器被破壞，而稍微有點焦躁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050676
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050676,
					"content": "已經不是稍微的程度了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050677
					]
				},
				{
					"id": 721050677,
					"content": "呵呵，您說得對。實在是太失態了。無論如何，見它以如此曲折的方式，輾轉到您的手上，我也很高興呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050678
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050678,
					"content": "…不知道這是「花散里」的心情，還是「狐齋宮」的心情呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050679
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050679,
					"content": "此前，因為她的心意與我的心意混雜，而我又身為她必須清除之物，而時常感到苦惱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050680
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050680,
					"content": "但是…如今我已經釋然了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050681
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050681,
					"content": "有幸與您同行，我真的很高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050682
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050682,
					"content": "不，不如說，正因為是您，我才能來到這裡，毫無牽絆地履行我最後的職責吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050683
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050683,
					"content": "花散里小姐，真的要走嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050684
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721050684,
					"content": "嗯。謝謝妳，派蒙大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050685
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050685,
					"content": "#那麼，請原諒我的僭越…{NICKNAME}大人，派蒙大人，請聽我一言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050686
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050686,
					"content": "請說吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050687
					]
				},
				{
					"id": 721050687,
					"content": "#「不被蒙蔽、不受動搖，一直走在{F#妳}{M#你}們所堅信的道路上。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050688
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050688,
					"content": "這是「狐齋宮」在最終分別前，向她道出的最後的箴言。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050689
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050689,
					"content": "雖然我自覺沒有這份資格，以「白辰血脈」自居。但我相信，倘若「狐齋宮」本人還在，對您一定不會吝於祝福吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050690
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050690,
					"content": "希望，她的箴言——不，我的箴言，能為未來的您，多少抵擋幾句謊言、幾分惡念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050691
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050691,
					"content": "謝謝妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050692
					]
				},
				{
					"id": 721050692,
					"content": "呵呵，不必客氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050693
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050693,
					"content": "那麼，作為交換…就請您讓我最後再任性一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050694
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050694,
					"content": "雖然我繼承了她的記憶，也繼承了她所知的那一千一百一十一首，卻沒有她那般自如應用的風雅情趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050695
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050695,
					"content": "但偏偏此時此刻，我想起一首應景的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050696
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050696,
					"content": "「與君相別離，不知何日是歸期，我如朝露轉瞬晞。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050697,
						721050698
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050697,
					"content": "花散里小姐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050699
					]
				},
				{
					"id": 721050699,
					"content": "#謝謝。再見了，很高興能認識兩位…{NICKNAME}大人，派蒙大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050700
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050700,
					"content": "「千枝萬脈，請除禍災。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050701
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050701,
					"content": "「…於此，宣其祓卻。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050698,
					"content": "再見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050699
					]
				},
				{
					"id": 721050663,
					"content": "有必要嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050664
					]
				},
				{
					"id": 721050664,
					"content": "有必要的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721050665
					],
					"speakerTitle": "花散里"
				},
				{
					"id": 721050649,
					"content": "原來如此…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050650
					]
				},
				{
					"id": 721050643,
					"content": "似乎確實如此。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050644
					]
				},
				{
					"id": 721050636,
					"content": "非常可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050637
					]
				},
				{
					"id": 721050613,
					"content": "我也很辛苦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050615
					]
				},
				{
					"id": 721050614,
					"content": "我們一起經歷了很多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050615
					]
				},
				{
					"id": 721050607,
					"content": "喔。謝謝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721050608
					]
				}
			]
		}
	]
}