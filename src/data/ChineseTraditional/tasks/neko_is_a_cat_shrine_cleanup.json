			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"「寢子」",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721640101,
					"content": "唔喵…那個箱子果然很管用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640102
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640102,
					"content": "是汝啊。那個「塞錢箱」，確實很管用呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640103
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640103,
					"content": "汝等修好之後不久，就有兩個綠綠的人類過來神社了，喵喵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640104
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640104,
					"content": "不僅往裡面塞了錢，那個高高的，綠綠的人類聽見奴家說話之後，還很激動。人類真是大驚小怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640105
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640105,
					"content": "「塞錢箱」真是好東西哪。如果再修一個，那就有更多人了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640106
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640106,
					"content": "事情不是這樣的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640107
					]
				},
				{
					"id": 721640107,
					"content": "是嗎。人類的事情，還真是麻煩呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640108
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640108,
					"content": "這個問題，應、應該和神社的環境有關吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721640109,
					"content": "奴家的神社怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640110,
						721640111
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640110,
					"content": "稍微有點亂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640112
					]
				},
				{
					"id": 721640112,
					"content": "哎呀，是這樣嗎？不過，那些小傢伙們都很喜歡在落葉堆裡玩啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640113
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640113,
					"content": "啊，不過仔細一想，阿響也經常用那個一頭刺刺的長棍子，把樹葉弄到一起。既然阿響會這麼做，那一定是對的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640114,
						721640115
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640114,
					"content": "要打掃哪裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640116
					]
				},
				{
					"id": 721640116,
					"content": "奴家怎麼會懂汝等人類的講究嘛。唔…阿響的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640117
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640117,
					"content": "太陽還沒出來的時候，阿響經常拿著那個長棍子在地上擺來擺去。奴家喜歡追著長棍子玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640118
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640118,
					"content": "但現在奴家可是「代宮司」，這種舉動不合適。奴家可不是一般的小傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640119
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640119,
					"content": "但是，阿響也會對地上用水。水可是壞東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640120
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640120,
					"content": "百目鬼有時候也會來，用交叉的鐵片咔嚓咔嚓。然後樹枝和樹葉就會掉下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640121,
						721640123
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640121,
					"content": "「百目鬼」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640122
					]
				},
				{
					"id": 721640122,
					"content": "是一個好高好高，聲音好大好大的人類。經常和阿響一起玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640125
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640125,
					"content": "哼！每次他都會把奴家最喜歡的那幾根樹枝剪掉，是個討厭的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640126
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640126,
					"content": "聽起來…真的就是「打掃」，或者說「整理」呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721640127,
					"content": "掃地，灑水，還有修剪樹枝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721640128,
					"content": "都是很熟悉的工作啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640129
					]
				},
				{
					"id": 721640129,
					"content": "這就是「打掃」嗎？奴家明白了，那就拜託汝等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640130
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640130,
					"content": "對了，咔嚓咔嚓就不必了。現在的樹枝，奴家很喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640131
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640131,
					"content": "長棍子落葉和水行了。汝等明白了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640132,
						721640133
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640132,
					"content": "交給我們吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640144
					]
				},
				{
					"id": 721640144,
					"content": "喵喵，這項工作可是阿響專門交付給奴家，只有奴家才能完成的重要工作呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640133,
					"content": "對了，「阿響」是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640134
					]
				},
				{
					"id": 721640134,
					"content": "阿響就是阿響，是淺瀨神社的宮司。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640135
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640135,
					"content": "那妳的名字…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721640136
					]
				},
				{
					"id": 721640136,
					"content": "奴家叫「寢子」，名字是阿響起的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640137
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640137,
					"content": "平常都是由阿響出面招待來神社的人，不用奴家來照顧神社。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640138
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640138,
					"content": "奴家以前沒有名字，也不用當「代宮司」，想睡就睡，想找誰玩就找誰玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721640139
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 721640139,
					"content": "然後阿響說，因為奴家經常睡覺，所以就叫「寢子」吧。",
					"roleType": "TALK_ROLE_NPC",
