				"objectNames": [
					"呼嚕克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750470301,
					"content": "好睏，好想睡覺…但是，要一起站著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470302
					],
					"speakerTitle": "呼嚕克"
				},
				{
					"id": 750470302,
					"content": "為什麼，人，要在這裡站一整天？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "呼嚕克"
				}
			]
		},
		{
			"id": 7504704,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"庫西"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 750470401,
					"content": "唔…體重是控制住了，不過…嗯？怎麼了，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470402,
						750470405,
						750470409
					],
					"speakerTitle": "庫西"
				},
				{
					"id": 750470402,
					"content": "請問你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470403
					]
				},
				{
					"id": 750470403,
					"content": "啊，我是這邊哨站的看守之一，不過現在處於休假狀態…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470404
					],
					"speakerTitle": "庫西"
				},
				{
					"id": 750470404,
					"content": "如果有事的話就找旁邊的尤考姆吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫西"
				},
				{
					"id": 750470405,
					"content": "在煩惱什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470406
					]
				},
				{
					"id": 750470406,
					"content": "唉呀，其實是因為最近體重稍微變重了一點，所以在平常吃的顆粒果裡面加了很多健康的蔬菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470407
					],
					"speakerTitle": "庫西"
				},
				{
					"id": 750470407,
					"content": "但是不知道為什麼，我的夥伴烏爾最近也學我吃了很多草…雖然龍都是雜食動物，可是吃太多草，營養大概跟不上吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						750470408
					],
					"speakerTitle": "庫西"
				},
				{
					"id": 750470408,
					"content": "還是找機會好好和牠聊一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫西"
				},
				{
					"id": 750470409,
					"content": "沒什麼事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						750470410
					]
				},
				{
					"id": 750470410,
					"content": "#好吧，那就祝{F#妳}{M#你}旅途順利了，異邦人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "庫西"
				}
			]
		}
	]
