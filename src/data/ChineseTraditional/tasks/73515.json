			"trigger": {
				"objectNames": [
					"維納亞克",
					"施芮婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735150101,
					"content": "#{F#妳}{M#你}來了啊，冒險家。我們正打算安裝呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150102
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735150102,
					"content": "要是一切順利的話，今天就能給那傢伙來一記狠的了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150103
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735150103,
					"content": "在正式的充能過程中，可能也會有魔物過來侵擾。到時候就得麻煩您多留意裝置充能跟破損的情況了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150104,
						735150105
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735150104,
					"content": "交給我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				},
				{
					"id": 735150106,
					"content": "#多謝{F#妳}{M#你}了，冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150107
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735150107,
					"content": "#啊——我想到一個好主意！{F#妳}{M#你}都為「對沙蟲用殺蟲炮」忙前忙後了這麼久，這首次試射的榮耀…乾脆就交給{F#妳}{M#你}吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150108,
						735150110
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735150108,
					"content": "你不打算自己來嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150109
					]
				},
				{
					"id": 735150109,
					"content": "我只要看著它落地就已經心滿意足啦！何況讓別人去點火，我們才能欣賞到它開火時的全貌嘛…咳！總之！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735150112,
					"content": "#{F#妳}{M#你}只需要從魔物手裡保護好充能裝置，等待能量蓄滿之後，看準沙蟲露出破綻的瞬間——再狠狠地往炮臺上敲上一記就好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150113
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735150113,
					"content": "#剩下的事情，點火裝置和自動修正機關會幫{F#妳}{M#你}搞定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150114
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735150114,
					"content": "#聽起來好厲害…{NICKNAME}！我也想看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735150115,
					"content": "好吧，我來操作。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150116
					]
				},
				{
					"id": 735150116,
					"content": "#嘿嘿，那就這麼說定了！我來告訴{F#妳}{M#你}具體的操作流程…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735150110,
					"content": "我不知道怎麼操作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150111
					]
				},
				{
					"id": 735150111,
					"content": "#{F#妳}{M#你}放心！我設計它的時候可是完美遵循了簡單易用的互動原則。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735150112
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735150105,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735150106
					]
				}
			]
		}
	]
