				]
			},
			"dialogs": [
				{
					"id": 762050101,
					"content": "#怎麼辦…這要怎麼辦…算算時間{M#他們}{F#她們}就快來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050102
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050102,
					"content": "我們來啦！欸欸尼可，別把我們推出去啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050103,
					"content": "咳咳…不好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050104
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050104,
					"content": "是還沒準備好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050105
					]
				},
				{
					"id": 762050105,
					"content": "該怎麼解釋呢…不行，說不清楚，只好從頭說明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050106
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050106,
					"content": "具體就要從魔女們第一次挑戰風神時說起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050107
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050107,
					"content": "這也太早了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050108,
					"content": "唔，太過分了，要我親口說出來真的好丟人…算了，沒辦法了，事實就是事實…只要艾莉絲不知道的話應該不會被取笑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050109
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050109,
					"content": "她心裡面想的話好像又漏出來了，而且，她也沒辦法親「口」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050110,
					"content": "噓。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050111
					]
				},
				{
					"id": 762050111,
					"content": "我臨時把羽毛藏去了書房最高的地方，想著增加難度的話，完成挑戰的成就感也會變強…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050112
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050112,
					"content": "但我實在不擅長控制那些隨性的風，好像到了一定高度之後，無論如何都飛不上去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050113
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050113,
					"content": "不能用魔法把羽毛重新挪下來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050114,
					"content": "那就沒有遊玩的意義了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050115
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050115,
					"content": "好吧，也對…那還真是個死局…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762050116,
					"content": "尼可，可以再說一句話嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050117
					]
				},
				{
					"id": 762050117,
					"content": "什麼話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050118,
						762050119
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050118,
					"content": "在希穆蘭卡，語言就是魔法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				},
				{
					"id": 762050120,
					"content": "啊！我明白了——！讓我們試試吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762050121
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762050121,
					"content": "唔，太過分了，要我親口說出來真的好丟人…",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050122
					]
				},
				{
					"id": 762050122,
					"content": "算了，沒辦法了，事實就是事實…",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": [
						762050123
					]
				},
				{
					"id": 762050123,
					"content": "只要艾莉絲不知道的話應該不會被取笑…",
					"roleType": "TALK_ROLE_NONE",
					"nextDialogs": []
				},
				{
					"id": 762050119,
					"content": "如果能夠讓妳的語句成為階梯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762050120
					]
				}
			]
		},
