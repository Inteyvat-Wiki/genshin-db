			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"詔勤"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715120101,
					"content": "真是…這個地區清理過了嗎？呃…應該清理過了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120102
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120102,
					"content": "哎喲，真是頭疼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120103
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120103,
					"content": "#呃…{F#妳}{M#你}是…旅行者！抱歉抱歉，我忙昏頭了，沒看見{F#妳}{M#你}來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120104
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120104,
					"content": "你這是在忙什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120105
					]
				},
				{
					"id": 715120105,
					"content": "咳，是這樣，今年海燈節，我們璃月港冒險家協會將在總務司的調度下，做一些協助工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120106
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120106,
					"content": "千岩軍主要負責城內和一些重點區域的巡邏，而咱們嘛，就負責去野外清掃一些流竄的魔物…還有驅趕那些沒事找事的賊匪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120107
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120107,
					"content": "#對了…說起來，{F#妳}{M#你}也是在協會裡註冊過的冒險家啊，我可是聽說過不少{F#妳}{M#你}的冒險事蹟啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120108
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120108,
					"content": "#如果願意的話，{F#妳}{M#你}也來幫我們一把，怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120109,
						715120110
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120109,
					"content": "大過節的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120111
					]
				},
				{
					"id": 715120111,
					"content": "咳，這個…因為是在節日期間協助總務司勤務，所以總務司也撥給了我們一批特別款項。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120112
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120112,
					"content": "願意接受此類委託的冒險家，在完成委託後可以拿到更多的報酬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120113,
						715120115
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120113,
					"content": "具體…有多少？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120114
					]
				},
				{
					"id": 715120114,
					"content": "#相信我，絕對虧待不了{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120123
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120123,
					"content": "那…我得先看看有多少工作要做…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120116
					]
				},
				{
					"id": 715120116,
					"content": "#哈哈哈！好！我就知道{F#妳}{M#你}不會袖手旁觀的，我先把協會確定下來的地點給{F#妳}{M#你}標記下來，還有這個小型煙花筒{F#妳}{M#你}拿好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120117
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120117,
					"content": "#如果{F#妳}{M#你}真的願意接受委託的話…清掃完一片區域後，記得用這個煙花筒發射一枚煙花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120118
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120118,
					"content": "#{F#妳}{M#你}發射煙花之後，我們派出去的記錄員就會把那塊區域標注為「已掃除」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120119
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120119,
					"content": "然後，我們會根據整個地塊內各個區域的掃除情況來即時調整計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120120
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120120,
					"content": "還挺有計劃的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120121
					]
				},
				{
					"id": 715120121,
					"content": "唉…這可是海燈節，可千萬不能出問題啊。咱們啊…人人都繃緊著弦呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715120122
					],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120122,
					"content": "先不說這些了，我得再去看看情況。等會還要去給嵐姐報告呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "詔勤"
				},
				{
					"id": 715120115,
					"content": "你…你先給我看看有多少工作要做…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120116
					]
				},
				{
					"id": 715120110,
					"content": "海燈節呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715120111
					]
				}
			]
		}
	]
}