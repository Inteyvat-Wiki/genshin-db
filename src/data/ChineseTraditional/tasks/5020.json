				"points": []
			},
			"dialogs": [
				{
					"id": 50202001,
					"content": "阿伽婭…對我來說也是一位可敬的長輩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202002
					],
					"speakerTitle": "阿米娜"
				},
				{
					"id": 50202002,
					"content": "祖父過世後，我被許多長輩們推舉著成為了「部族首領」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202003
					],
					"speakerTitle": "阿米娜"
				},
				{
					"id": 50202003,
					"content": "因為我總是有許多新奇的想法，大家相信我能夠將「流泉之眾」帶向「不一樣的未來」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202004
					],
					"speakerTitle": "阿米娜"
				},
				{
					"id": 50202004,
					"content": "但是，在很長一段時間裡，我也不知道自己該做什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202005
					],
					"speakerTitle": "阿米娜"
				},
				{
					"id": 50202005,
					"content": "阿伽婭阿姨經常勉勵我，哪怕我犯了錯，她也從不會跟我說：「怎麼做成這個樣子？」她會很認真地陪我分析問題出在哪裡，讓我做得更好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						50202006
					],
					"speakerTitle": "阿米娜"
				},
				{
					"id": 50202006,
					"content": "我很尊敬她，所以…我會記住她教給我的一切，努力做好我該做的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿米娜"
				}
			]
		}
	]
}