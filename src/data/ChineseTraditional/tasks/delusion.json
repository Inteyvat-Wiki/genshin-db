			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「散兵」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20150401,
					"content": "#沒想到{F#妳}{M#你}們能找到這裡來，做得不錯嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150402
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150402,
					"content": "有趣。才見面，就是一副要找我拼命的樣子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150403,
						20150404
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150403,
					"content": "你們製造邪眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150405
					]
				},
				{
					"id": 20150405,
					"content": "噢，原來是說這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150406
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150406,
					"content": "#{F#妳}{M#你}們似乎搞錯了一點。我雖然站在這裡，但也只是代為執行計畫而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150407
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150407,
					"content": "主謀當然另有其人了。不是很能幹嗎？盡情去找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150408
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150408,
					"content": "#才這點「小事」就被激怒了？{F#妳}{M#你}好像變了嘛…變得不堪一擊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150409
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150409,
					"content": "你竟然說這是小事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20150410,
					"content": "難道不是嗎？在這浮世之中，人命如同草芥一般。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150411
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150411,
					"content": "沒有邪眼，他們也一樣會死。至少，邪眼還給了他們實現「願望」的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150412
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150412,
					"content": "#眼狩令的價值，{F#妳}{M#你}們真的瞭解嗎？當初促成這件事花了不小的力氣，當然是因為它有利於我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150413
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150413,
					"content": "不過現在看來，一切都很值得。製造紛爭，為推廣邪眼鋪路，讓力量自行吸引追尋它的弱者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150414
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150414,
					"content": "只需要一點點代價，就能得到掌握世界的感覺。用性命換取無上之力，挺划算的不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150415
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150415,
					"content": "眼狩令是你們促成的？難道說，你們從一開始就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20150416,
					"content": "稻妻的外側看起來十分穩固，但內側…充滿了留給我們的機會。稍微施力，就能從內部攻破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150417
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150417,
					"content": "永恆可以把時間拉得很長，然而，其間每一個環節都會變得無比脆弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150418
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150418,
					"content": "#就像{F#妳}{M#你}在反抗軍的朋友一樣，無論怎麼努力，都不過是徒勞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150419
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150419,
					"content": "如同水中泡影，絢爛的同時，便會迎來毀滅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150420
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150420,
					"content": "越是失去就越想得到，越是無能就越要掙扎！哈哈哈，這種鬧劇真讓人開心啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150421,
						20150422
					],
					"speakerTitle": "「散兵」"
				},
				{
					"id": 20150421,
					"content": "哲平他…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150423
					]
				},
				{
					"id": 20150423,
					"content": "#喂！{NICKNAME}，快冷靜下來——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20150422,
					"content": "他才不是無能之人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150423
					]
				},
				{
					"id": 20150404,
					"content": "你們把邪眼分發給反抗軍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150405
					]
				}
			]
		},
