			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚宮心海",
					"五郎"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 20150101,
					"content": "#{NICKNAME}，哲平的情況還好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150102,
						20150103
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150102,
					"content": "我們都沒有注意到…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150104
					]
				},
				{
					"id": 20150104,
					"content": "…我已經下令，收繳所有軍隊中的邪眼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150105
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150105,
					"content": "絕大部分的人雖然出現了生命力流失的現象，但情況還不嚴重。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150106
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150106,
					"content": "但也有少部分人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150107
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150107,
					"content": "珊瑚宮大人，我打算單獨開一個傷兵營，觀察他們的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150108
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20150108,
					"content": "將士們鬧得很厲害，明知是邪眼，他們也打算用下去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150109
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20150109,
					"content": "此事交給你來負責，我必須要去一趟前線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150110
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150110,
					"content": "出了這麼大的事情，軍心一定會有所動搖。如果幕府軍趁亂進攻，就功虧一簣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150111
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150111,
					"content": "#{NICKNAME}，{F#妳}{M#你}有什麼打算嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150112
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150112,
					"content": "去阻止愚人眾的計畫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150113
					]
				},
				{
					"id": 20150113,
					"content": "不行，太危險了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150114
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150114,
					"content": "鎖國令還在繼續，他們的邪眼應該是在稻妻生產的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150115
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150115,
					"content": "能夠調動如此龐大的人力物力，背後必有本土勢力支持。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150116
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150116,
					"content": "想要阻止他們，就只能搗毀他們生產邪眼的工廠。但那裡一定有重兵把守…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150117
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150117,
					"content": "#不能讓{F#妳}{M#你}冒這樣的風險，至少帶著軍隊一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150118
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150118,
					"content": "沒時間了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150119
					]
				},
				{
					"id": 20150119,
					"content": "珊瑚宮大人，我們收繳邪眼的時候很匆忙，應該瞞不過愚人眾的眼線。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150120
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20150120,
					"content": "如果我們再花時間整頓軍隊，他們聽到風聲，一定會提前逃走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150121
					],
					"speakerTitle": "五郎"
				},
				{
					"id": 20150121,
					"content": "我知道…讓我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150122
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150122,
					"content": "在收繳邪眼的時候，我確實想過。工廠既要龐大，又必須隱蔽，還要鄰近交通要道，保證原材料供應…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150123
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150123,
					"content": "符合這些條件的地方不多，再結合士兵們收到邪眼的地點推斷，工廠很可能是在<color=#00E1FFFF>八醞島</color>西南部的臨海山崖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150124
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150124,
					"content": "#我不會阻止{F#妳}{M#你}，但{F#妳}{M#你}一定要小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150125
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150125,
					"content": "#我們失去了很多曾並肩作戰的人，不想再失去{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150126
					],
					"speakerTitle": "珊瑚宮心海"
				},
				{
					"id": 20150126,
					"content": "我們也走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150127
					]
				},
				{
					"id": 20150127,
					"content": "欸？要去那個<color=#00E1FFFF>邪眼工廠</color>嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						20150128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20150128,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150129
					]
				},
				{
					"id": 20150129,
					"content": "真的嗎？真的不再考慮一下嗎？好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 20150103,
					"content": "情況是突然惡化的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						20150104
					]
				}
			]
		},
		{
			"id": 201504,
			"completionStepIds": [
				201505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
