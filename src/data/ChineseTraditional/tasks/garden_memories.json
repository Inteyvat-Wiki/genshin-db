	"talks": [
		{
			"id": 1300301,
			"completionStepIds": [
				1300301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300301",
							"2"
						],
						"stepId": 1300301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030101,
					"content": "…總之，汙染區其實就是森林深處的地脈發生了洩漏，現在已經恢復正常了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030102,
					"content": "#原來是這樣，真是辛苦{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030103
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 130030103,
					"content": "等空氣中殘留的地脈能量散去，應該就可以對外張貼公告，讓居民可以像以前一樣自由出入了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 130030104,
					"content": "這是說好的獎勵，兩位請收好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030105
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 130030105,
					"content": "從冒險家協會出來後，被派蒙帶到了一個安靜的地方…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130030106
					]
				},
				{
					"id": 130030106,
					"content": "卡卡塔…要被送回教令院了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030107,
					"content": "雖然它已經損壞了，可一想到它要被拆掉，我還是覺得有點難過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030108,
					"content": "我也有一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030109
					]
				},
				{
					"id": 130030109,
					"content": "那！要不明天我們一起去找提納里求求情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030110,
					"content": "雖然很想現在就去，但提納里說了「有什麼事明天再說」，我們現在去找他反而會惹他生氣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030111,
					"content": "好像確實是這樣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030112
					]
				},
				{
					"id": 130030112,
					"content": "那就說好啦！明天我們一起去找提納里，讓他不要拆掉卡卡塔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1300303,
			"completionStepIds": [
				1300303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1300303",
							"2"
						],
						"stepId": 1300303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"提納里",
					"卡卡塔"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130030301,
					"content": "提納里——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030302,
					"content": "噓，小聲點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030303
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030303,
					"content": "芫花，瑞香科瑞香屬，有明顯抗驚厥作用，可做麻醉粉使用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030304
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030304,
					"content": "從兩組實驗資料來看，對魚類的毒性尤其大…認真記錄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030305
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030305,
					"content": "咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030306
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130030306,
					"content": "卡卡塔？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030307,
					"content": "咕嚕！咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030308
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130030308,
					"content": "#不是說了要{F#妳}{M#你}們小聲點，雖然植物不怕吵，但聲音震得我耳朵嗡嗡響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030309
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030309,
					"content": "你、你沒有拆掉卡卡塔嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030310,
					"content": "我拆它幹什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030311
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030311,
					"content": "可是你不是說，「按照教令院的規矩」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030312,
					"content": "#原來{F#妳}{M#你}們一大早過來攪得我不得安生，是為了這個啊。好吧，也怪我昨天沒說清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030313
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030313,
					"content": "我的意思是，按照教令院的規矩，所有研究成果都要被銷毀，所以不能讓教令院發現那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030314
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030314,
					"content": "提納里留在那裡其實是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130030315
					]
				},
				{
					"id": 130030315,
					"content": "總之先把卡卡塔修好了。以前在教令院的時候選修過素論派的課，沒想到有朝一日還能派上用場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030316
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030316,
					"content": "然後我跟它一起安葬了阿巴圖伊。至於那些實驗資料我整理了一下，一部分帶出來留作紀念，大部分焚燒後深埋，清理掉證據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030317
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030317,
					"content": "我又不在教令院，那些規矩關我什麼事？恰恰相反，現在我是道成林的巡林官，我有義務保護好林中的生命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030318
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030318,
					"content": "任何生命誕生在世上都有意義，它也不例外。既然存在，就不該被隨意拋棄或銷毀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030319
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030319,
					"content": "嘿嘿！太好啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030320,
					"content": "咕嚕嚕？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030321
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130030321,
					"content": "不過，提納里剛剛說「任何生命」，難道你已經認可卡卡塔是「真正的生命」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130030322,
					"content": "只是有這個可能性而已，畢竟它嘗試「修復」阿巴圖伊的事很難解釋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030323
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030323,
					"content": "但阿巴圖伊留下的實驗紀錄也只是一小部分，誰也不知道他到底設置了多少指令。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030324
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030324,
					"content": "也許只是指令之間的衝突，導致卡卡塔做出了這樣的舉動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030325
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030325,
					"content": "從嚴謹的角度，無法得出「卡卡塔是真正的生命」這個結論。但既然存在這樣的可能性，我就願意去相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030326
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030326,
					"content": "咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030327
					],
					"speakerTitle": "卡卡塔"
				},
				{
					"id": 130030327,
					"content": "順帶一提，我對繼續研究這個課題沒什麼興趣，讓它待在這裡，只是因為這裡比較隱蔽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030328
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030328,
					"content": "不過目前來看，把它當做實驗助手似乎也不錯，至少實驗紀錄可以讓它來完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030329
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030329,
					"content": "#{F#妳}{M#你}覺得呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130030330
					],
					"speakerTitle": "提納里"
				},
				{
					"id": 130030330,
					"content": "咕嚕！咕嚕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡卡塔"
				}
			]
		},
