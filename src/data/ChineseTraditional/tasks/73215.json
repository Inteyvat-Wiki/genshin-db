			"dialogs": [
				{
					"id": 732150401,
					"content": "#{F#妳}{M#你}好呀，金色的那菈和白飛飛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150402
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 732150402,
					"content": "你好！最近怎麼樣呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150403,
					"content": "#很好，不過為什麼來這裡，{F#妳}{M#你}們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150404
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 732150404,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150405,
					"content": "#唔…很困擾，我們。雖然一定有理由，但{F#妳}{M#你}們為什麼來，不知道…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150406
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 732150406,
					"content": "畢竟我們對這裡很熟悉嘛，和你們一起經歷了那麼多冒險！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150407,
					"content": "…？唔…是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150408
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 732150408,
					"content": "我們之前的經歷，他不記得了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
