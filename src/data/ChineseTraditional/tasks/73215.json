			},
			"dialogs": [
				{
					"id": 732150301,
					"content": "#{F#妳}{M#你}好，謝謝{F#妳}{M#你}們！金色的那菈和白飛飛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150302
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 732150302,
					"content": "#{F#妳}{M#你}們來做什麼呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150303
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 732150303,
					"content": "你說要記得回來一起玩呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150304,
					"content": "唔，我這麼說過嗎…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150305,
						732150307
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 732150305,
					"content": "你說過的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150306
					]
				},
				{
					"id": 732150306,
					"content": "這樣呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 732150309,
					"content": "#不管怎樣，謝謝{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭迦魯"
				},
				{
					"id": 732150307,
					"content": "怎麼，不開心嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150308
					]
				},
				{
					"id": 732150308,
					"content": "唔…沒有哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150309
					],
					"speakerTitle": "蘭迦魯"
				}
			]
