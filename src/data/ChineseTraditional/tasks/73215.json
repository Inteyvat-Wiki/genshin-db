			"dialogs": [
				{
					"id": 732150501,
					"content": "#{F#妳}{M#你}好！金色的那菈！還有{F#妳}{M#你}，小小白飛飛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150502
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 732150502,
					"content": "哼，我不小！也不看看你自己啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150503,
					"content": "#哼哼，我也不小！唔…對了，{F#妳}{M#你}們來做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150504
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 732150504,
					"content": "只是回來看看你們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150505
					]
				},
				{
					"id": 732150505,
					"content": "對呀，畢竟我們之前打敗了好多壞東西，一起唱歌，一起救了「嗚咿呀」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150506,
					"content": "「無郁夷摩」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150507
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 732150507,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150508,
					"content": "#唔…對不起…{F#妳}{M#你}們說的應該是真的。但我不記得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150509
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 732150509,
					"content": "#唔…！沒、沒關係啦！請{F#妳}{M#你}不要傷心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150510
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150510,
					"content": "（他真的不記得了呢…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
