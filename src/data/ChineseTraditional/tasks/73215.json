					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732150201,
					"content": "#{F#妳}{M#你}好，{F#妳}{M#你}好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150202
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 732150202,
					"content": "你好呀，小不點！還記得我們嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150203,
					"content": "#可惡的白飛飛，我不是小不點！{F#妳}{M#你}們還記得我教的歌嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150204
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 732150204,
					"content": "當然。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150205
					]
				},
				{
					"id": 732150205,
					"content": "好哇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150206
					],
					"speakerTitle": "蘭納真"
				},
				{
					"id": 732150206,
					"content": "#那{F#妳}{M#你}們要答應我，即使我忘記了自己的歌…{F#妳}{M#你}們也要記得！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭納真"
				}
			]
		},
