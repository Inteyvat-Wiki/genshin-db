			"trigger": {
				"objectNames": [
					"蘭納迦",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 732150101,
					"content": "#{F#妳}{M#你}好呀，朋友那菈！唔…好像要對{F#妳}{M#你}說什麼，想不起了，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150102
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 732150102,
					"content": "#沒關係的，又看見{F#妳}{M#你}們就讓我們很開心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 732150103,
					"content": "嗯，謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						732150104,
						732150106
					],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 732150104,
					"content": "關於「無郁夷摩」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150105
					]
				},
				{
					"id": 732150105,
					"content": "#他不再說話了，但是他很好。也正在恢復，森林…謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭納迦"
				},
				{
					"id": 732150106,
					"content": "關於遺忘…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						732150107
					]
				},
				{
					"id": 732150107,
					"content": "遺忘…？嗯，因為力量耗盡了，「苦舍桓」。所以也會流走，記憶。一點一點，就像露珠一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭納迦"
				}
			]
		},
		{
			"id": 7321502,
			"completionStepIds": [
				7321502
