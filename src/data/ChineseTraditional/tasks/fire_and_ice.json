			"dialogs": [
				{
					"id": 761830201,
					"content": "這樣偶爾的放鬆很有必要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830202,
						761830203
					],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 761830202,
					"content": "（再這樣坐一下吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "「木偶」"
				},
				{
					"id": 761830204,
					"content": "好，我們至冬見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「僕人」"
				},
				{
					"id": 761830203,
					"content": "茶會時間該結束了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761830204
					],
					"speakerTitle": "「木偶」"
				}
			]
		}
	]
