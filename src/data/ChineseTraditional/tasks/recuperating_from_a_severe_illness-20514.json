				"points": []
			},
			"dialogs": [
				{
					"id": 205140401,
					"content": "#唔？真是稀奇，{F#妳}{M#你}怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140402
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 205140402,
					"content": "妳有沒有見過一個女孩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140403
					]
				},
				{
					"id": 205140403,
					"content": "#女孩？哦，{F#妳}{M#你}是說安娜嗎？我看見了，她剛才往那邊的風車跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140404
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 205140404,
					"content": "我還在奇怪呢，那孩子不是身體不好嗎，怎麼突然這麼有活力了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140405
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 205140405,
					"content": "跟我打了聲招呼之後，就跑過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140406
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 205140406,
					"content": "#這孩子，病是什麼時候好的…{F#妳}{M#你}有頭緒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽琉斯"
				}
			]
		},
