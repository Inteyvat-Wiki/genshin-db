			"dialogs": [
				{
					"id": 205140201,
					"content": "好高…這裡哥哥應該找不到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140202
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205140202,
					"content": "妳在這做什麼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140203
					]
				},
				{
					"id": 205140203,
					"content": "#哇！{F#妳}{M#你}是怎麼上來的，怎麼一點動靜都沒有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140204
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205140204,
					"content": "#還有{F#妳}{M#你}是怎麼找到我的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140205
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205140205,
					"content": "我？我就是，爬著爬著就上來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140206
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205140206,
					"content": "哥哥在找我？咦，怎麼都這個時間了，完全沒有注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140207
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 205140207,
					"content": "我知道啦，我馬上就回去啦，再在這裡待一會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				}
			]
		},
		{
