			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安東尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205140101,
					"content": "這叫什麼事啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140102
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140103
					]
				},
				{
					"id": 205140103,
					"content": "#是{F#妳}{M#你}啊，來得正好…自從吃了那位神醫的藥，安娜的病逐漸好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140104
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140104,
					"content": "她之前身體不好，必須要靜養，在家裡憋了太久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140105
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140105,
					"content": "現在她身體好起來了，每天都和我鬧著要出去玩，我拗不過她，就答應了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140106
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140106,
					"content": "#但是…現在我壓根就找不到她了。這丫頭到底跑到哪去玩了，{F#妳}{M#你}快點幫我找找吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140107,
						205140110,
						205140113
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140107,
					"content": "我，我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140108
					]
				},
				{
					"id": 205140108,
					"content": "#我在這裡等著，{F#妳}{M#你}快點去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140109
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140109,
					"content": "這丫頭，身體剛有點起色就亂跑，要是再出什麼事怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140116,
					"content": "我已經在城裡找了很久…就差冒險家協會那一片沒找過，但是我實在是沒力氣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140117
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140117,
					"content": "#{F#妳}{M#你}就先去冒險家協會那一片找找看吧。還有，說不定賽琉斯先生會注意到什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140118
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140118,
					"content": "希望能找到，不然我還得接著去找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140110,
					"content": "你好像挺高興的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140111
					]
				},
				{
					"id": 205140111,
					"content": "高興？別，別開玩笑了，這丫頭身體剛好一點，就開始這樣亂跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140112
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140112,
					"content": "等她回來了，有她好看的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140113,
					"content": "肚子餓了就會回來的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140114
					]
				},
				{
					"id": 205140114,
					"content": "#{F#妳}{M#你}當我妹妹是貓嗎…再說她病剛好，怎麼能餓肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140115
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140115,
					"content": "#好了好了，{F#妳}{M#你}快幫我找找吧，我就在這等{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140116
					],
					"speakerTitle": "安東尼"
				}
			]
		},
		{
