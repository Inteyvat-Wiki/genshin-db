			"dialogs": [
				{
					"id": 205140301,
					"content": "#{F#妳}{M#你}找到安娜了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140302
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140302,
					"content": "安娜在一架風車上。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140303
					]
				},
				{
					"id": 205140303,
					"content": "風車？！這丫頭是怎麼上去的！我馬上就去找西風騎士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140304
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140304,
					"content": "她說她等會就回來…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205140305
					]
				},
				{
					"id": 205140305,
					"content": "是，是這樣嗎，沒事就好，嚇死我了，我還以為她被困在風車上下不來了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140306
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140306,
					"content": "#謝謝{F#妳}{M#你}，我馬上就去找她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205140307
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205140307,
					"content": "病剛好就開始亂跑，我非要好好訓訓她不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				}
			]
		},
