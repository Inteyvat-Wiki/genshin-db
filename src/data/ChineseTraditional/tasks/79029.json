			},
			"dialogs": [
				{
					"id": 790290101,
					"content": "這裡有一座雕像？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790290102,
					"content": "唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290103
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290103,
					"content": "你好，為什麼在這個山洞口唉聲嘆氣的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790290112,
					"content": "我呀，最近住在這個山洞裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290113
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290113,
					"content": "居然住在這種山洞裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790290114,
					"content": "我也沒辦法！誰讓島上突然來了群什麼劇團演員，每天敲敲打打的，吵得人根本沒法睡覺…所以才找到這裡，稍微安靜一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290104
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290104,
					"content": "但是不知道從哪裡來了一群丘丘人佔領了我的歇息之處，我只能在外面吹冷風啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290105
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290105,
					"content": "唉…我在心中暗自發誓，如果有人能幫我，我就告訴他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290106
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290106,
					"content": "告訴他什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790290107,
					"content": "告訴那個幫助我的人尋找到傳說中海盜秘寶的線索！雖然我也只知道四分之一啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290108
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290108,
					"content": "四分之一的線索？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790290109,
					"content": "#看起來{F#妳}{M#你}們也是尋求秘寶之人，怎麼樣，幫我解決裡面的丘丘人，我就把線索的位置告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290110
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290110,
					"content": "據說得到四份線索，就能找到曾經流落在此的海盜留下的寶藏呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790290111
					],
					"speakerTitle": "夜鴉船長"
				},
				{
					"id": 790290111,
					"content": "一言為定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
