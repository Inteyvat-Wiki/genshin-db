			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奧格勞",
					"基肖恩"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							1729.47,
							441.44,
							4935.436
						],
						"pointId": 6224
					},
					{
						"sceneId": 3,
						"position": [
							1730.136,
							441.44,
							4933.521
						],
						"pointId": 6226
					}
				]
			},
			"dialogs": [
				{
					"id": 741370101,
					"content": "「…經專家組核實認定，被告人販售的商品『螢光紫水母』已經對本地生態造成影響，嚴重擾亂水下生物的正常活動。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370102
					],
					"speakerTitle": "奧格勞"
				},
				{
					"id": 741370102,
					"content": "「…『破壞生態罪』證據確鑿，罪名成立。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370103
					],
					"speakerTitle": "奧格勞"
				},
				{
					"id": 741370103,
					"content": "等、等等…我真的什麼都不知道哇！牠們真的不是我放的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370104
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370104,
					"content": "「…有鑑於被告無主觀犯罪意識，今特許被告將功補過。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370105
					],
					"speakerTitle": "奧格勞"
				},
				{
					"id": 741370105,
					"content": "「若能在時限內將指定水域中的『螢光紫水母』回收，將酌情免除部分處分…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370106
					],
					"speakerTitle": "奧格勞"
				},
				{
					"id": 741370106,
					"content": "回收！這怎麼回收啊？能、能不能再商量商量？多罰點錢也可以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370107
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370107,
					"content": "「…時限詳情參見附錄說明。」——先生，跟我討價還價也沒用啊，再說討價還價也算時間，你還是多想想怎麼回收吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370108
					],
					"speakerTitle": "奧格勞"
				},
				{
					"id": 741370108,
					"content": "唉，那些人買了水母就到處放生，我的水性又不行…這該怎麼回收啊…早知道就不該賣給他們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370109
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370109,
					"content": "私自放生的那群人，警備隊還會繼續追查，不過不管怎麼說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370110
					],
					"speakerTitle": "奧格勞"
				},
				{
					"id": 741370110,
					"content": "培育了這些水母的人是你，不經報備就逕行販售的人也是你，忘了提醒買家不能放生的人還是你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370111
					],
					"speakerTitle": "奧格勞"
				},
				{
					"id": 741370111,
					"content": "老實說，現在這個處理已經算從寬啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370112
					],
					"speakerTitle": "奧格勞"
				},
				{
					"id": 741370112,
					"content": "嗚…早知道這樣，我就該在和這群人做生意的時候跟他們簽一份免責聲明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370113
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370113,
					"content": "總而言之，希望你能把握機會，好好補救——也希望我們下次見面，不是在梅洛彼得堡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370114
					],
					"speakerTitle": "奧格勞"
				},
				{
					"id": 741370114,
					"content": "基肖恩頹喪地目送奧格勞離開…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						741370115
					]
				},
				{
					"id": 741370115,
					"content": "嗚哇！你還好嗎？臉色看起來一片灰欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370116,
						741370117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370116,
					"content": "「螢光紫水母」是什麼東西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370118
					]
				},
				{
					"id": 741370118,
					"content": "#…{F#妳}{M#你}們剛剛都聽到了嗎？很抱歉，我現在沒時間聊天，得趕快去冒險家協會掛個委託，或者雇一位潛水員…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370119
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370119,
					"content": "…可是找協會要走流程，潛水員又不知道怎麼請——啊啊，難不成我真得進梅洛彼得堡了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370120
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370120,
					"content": "#{NICKNAME}，我有生意上門…不對，出手助人的預感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370121,
						741370122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370121,
					"content": "要找冒險家是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370123
					]
				},
				{
					"id": 741370123,
					"content": "#對啊…等等，{F#妳}{M#你}…您不會剛好就是吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370124
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370124,
					"content": "#嘿嘿，你算是問對人了，{NICKNAME}可是冒險家裡最會潛水的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370125,
					"content": "潛水員裡最能冒險的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370126
					]
				},
				{
					"id": 741370126,
					"content": "#謝天謝地！倒了那麼久的楣，總算是讓我撞上一回好運了！冒險家{M#先生}{F#小姐}，請您幫幫我吧！報酬絕對不成問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370127
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370127,
					"content": "先說說是怎麼回事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370128
					]
				},
				{
					"id": 741370128,
					"content": "對哦，剛剛看你還被定了罪…該不會是什麼壞事吧？那我們可不幫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370129,
					"content": "不會的不會的…其實我是個生物學者，在做實驗的時候，湊巧培育出了一批會發光的水母。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370130
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370130,
					"content": "原本這些水母在實驗結束後就得處理掉，可是我看牠們的賣相還滿漂亮的，就想當成寵物來賣一筆錢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370131
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370131,
					"content": "畢竟學生物的，平時也沒啥賺錢的機會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370132
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370132,
					"content": "欸…結果你賺到錢了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370133,
					"content": "這個嘛，當商人確實比研究生物好賺錢…不過錢是賺到了，麻煩也上門了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370134
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370134,
					"content": "我頭一次做寵物生意，也沒想那麼多，更沒想到買家裡，還有一群買了不養，專門拿去放生的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370135
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370135,
					"content": "他們大概是覺得這些出生在實驗室裡的小生命太可憐了吧，一回頭就把牠們放生到了野外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370136
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370136,
					"content": "但這些經我特殊培育過的水母，跟本地的生態系統並不相容。尤其是牠們喜好聚集又會發光的特徵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370137
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370137,
					"content": "…很容易改變水下的光照條件，干擾其他物種的正常活動，進而影響生態平衡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370138
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370138,
					"content": "等、等等，又是聚集自發光又是水下光照的…能不能說得簡單一點？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370139,
					"content": "#呃，不好意思，老毛病犯了…舉例來說，{F#妳}{M#你}們應該看過那種只有白天或者晚上才會出來活動的魚種吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370140
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370140,
					"content": "一些水下生物的習性，跟所處水域中的光照息息相關，一旦引入非自然的光源，牠們的行為就容易被干擾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370141
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370141,
					"content": "…以前也有同行研究過用燈光來釣魚的原理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370142,
						741370143
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370142,
					"content": "又扯遠了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370144
					]
				},
				{
					"id": 741370144,
					"content": "啊…抱歉抱歉，總而言之，最近警備隊發現各地水域都出現了反常的發光現象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370145
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370145,
					"content": "仔細調查後，發現那些光源都是聚集成團一起發光的「螢光紫水母」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370146
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370146,
					"content": "雖然不是我直接放生的，但也是從我手上賣出去的。現在他們責令我收拾這個爛攤子，至少也得把數量控制到安全線以內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370147
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370147,
					"content": "#可是我一個學者，哪有這身手下水？還好現在遇上了{F#妳}{M#你}們，要不然我還真的是倒楣到家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370148
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370148,
					"content": "聽起來真的是滿倒楣的…不過你也不算無辜吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370149,
					"content": "#——冒險家{M#先生}{F#小姐}，我願意出一大筆報酬，請您幫幫我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370150
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370150,
					"content": "#一大筆報酬…{NICKNAME}，我覺得他知錯能改，是個好人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370151,
						741370152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741370151,
					"content": "…好吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370153
					]
				},
				{
					"id": 741370153,
					"content": "哦哦，太感謝了！警備隊正在調查這些「螢光紫水母」放生的位置。只要去那些區域，盡可能把牠們都抓回來就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370154
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370154,
					"content": "牠們的活動範圍不大，移動速度也不快…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370155
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370155,
					"content": "對您這樣的潛水好手來說，應該還滿好抓的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370156
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370156,
					"content": "「螢光紫水母」在水裡都滿醒目的，您循著光源游上一圈就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741370157
					],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370157,
					"content": "我會一直留在這裡，如果還有什麼不明白的，歡迎隨時來問…呃，只要我還沒被抓去梅洛彼得堡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "基肖恩"
				},
				{
					"id": 741370152,
					"content": "實際上要怎麼做？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370153
					]
				},
				{
					"id": 741370143,
					"content": "說重點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370144
					]
				},
				{
					"id": 741370122,
					"content": "要找潛水員是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370123
					]
				},
				{
					"id": 741370117,
					"content": "「破壞生態罪」是怎麼回事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741370118
					]
				}
			]
		}
	]
}