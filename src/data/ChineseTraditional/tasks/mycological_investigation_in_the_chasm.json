			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海迪夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710500701,
					"content": "蘑菇採回來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500702
					]
				},
				{
					"id": 710500702,
					"content": "嗯嗯，多謝多謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500703
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500703,
					"content": "#有了{F#妳}{M#你}的幫助，我的調查就像是…有句璃月話是怎麼說的，「就像猛虎插上了翅膀一樣順利」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500704
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500704,
					"content": "如虎添翼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500705
					]
				},
				{
					"id": 710500705,
					"content": "對，簡直就是如虎添翼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500706
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500706,
					"content": "這些菌類，怎麼會這樣呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500707
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500707,
					"content": "這可奇怪了，這種菌類和須彌的一種菌類簡直就是一模一樣，但怎麼會發光呢，在黑暗中生長所以長出了螢光素？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500708
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500708,
					"content": "但是既然已經進化出螢光素，為什麼菌類的本體什麼變化都沒有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500709,
						710500710
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500709,
					"content": "完全聽不懂…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				},
				{
					"id": 710500711,
					"content": "嗯…簡單來說，菌類會適應環境進化，但是這種真菌的本體，顯然是更適合生長在森林環境的品種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500712
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500712,
					"content": "所以，這種真菌本來是生長在須彌的，這點毋庸置疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500713
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500713,
					"content": "那發光是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500714
					]
				},
				{
					"id": 710500714,
					"content": "真菌不是層岩巨淵的原生種，就說明發光不是進化產物，而是非正常生態影響導致的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500715
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500715,
					"content": "大概因為那個天上掉下來的碎塊吧，吸收了它的能量…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500716,
						710500717
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500716,
					"content": "碎塊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500718,
					"content": "#咳咳…嗯？{F#妳}{M#你}剛才說什麼，碎塊？啊，我是說，肯定是因為真菌的碎塊從天上飄下來的時候產生了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500719
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500719,
					"content": "產生了偶發性的變異。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500720
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500720,
					"content": "一定是這樣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500721
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500721,
					"content": "#嗯，能採集這些真菌真是感謝{F#妳}{M#你}，辛苦了辛苦了，先去好好休息一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500722
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500722,
					"content": "我要對這些真菌再做些研究，旁邊有人會打擾到我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500717,
					"content": "什麼碎塊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500718
					]
				},
				{
					"id": 710500710,
					"content": "有什麼問題嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500711
					]
				}
			]
		}
	]
}