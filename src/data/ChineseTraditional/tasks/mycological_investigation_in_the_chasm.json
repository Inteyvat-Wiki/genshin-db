			},
			"dialogs": [
				{
					"id": 710500401,
					"content": "關於這種蘑菇…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500402
					]
				},
				{
					"id": 710500402,
					"content": "該說真不愧是經驗豐富的冒險家嗎，這麼快就有所發現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500403
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500403,
					"content": "嗯？這確定是在這裡採摘的菌類嗎，這可有點奇怪啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500404
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500404,
					"content": "地下不能長蘑菇嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500405
					]
				},
				{
					"id": 710500405,
					"content": "也不是不能長的問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500406
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500406,
					"content": "只是因為這個菌和生長在須彌的一種菌很像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500407
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500407,
					"content": "只有一種不太夠啊…如果有足夠多的樣本，說不定就能看出些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500408
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500408,
					"content": "#足夠多的樣本啊…這個既然也是{F#妳}{M#你}拿回來的，肯定知道在哪裡還有…不如{F#妳}{M#你}幫我採點吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500409
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500409,
					"content": "#{F#妳}{M#你}幫我採足夠多的蘑菇，我給採足夠多的錢作為報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500410
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500410,
					"content": "足夠多是多少蘑菇？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710500411
					]
				},
				{
					"id": 710500411,
					"content": "嗯…我想想，那就先採8個吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710500412
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710500412,
					"content": "#沒關係，只要{F#妳}{M#你}帶過來，錢不會少{F#妳}{M#你}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				}
			]
		},
		{
			"id": 7105007,
			"completionStepIds": [
				7105003
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7105003",
