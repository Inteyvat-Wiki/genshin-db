			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"內爾敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420101,
					"content": "這樣一定可以給里夫一個驚喜…嘿嘿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420102
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420102,
					"content": "什麼驚喜？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420103
					]
				},
				{
					"id": 230420103,
					"content": "嗚哇！別嚇我啊旅行者！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420104
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420104,
					"content": "我是從妳正面走過來的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420105
					]
				},
				{
					"id": 230420105,
					"content": "#我在想事情嘛，完全沒有注意到{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420106
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420106,
					"content": "#旅行者，我問{F#妳}{M#你}啊…{F#妳}{M#你}聽說過「香水」這種東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420107
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420107,
					"content": "賈瓦希爾奶奶告訴我，她年輕的時候經常自製「香水」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420108
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420108,
					"content": "「香水」的氣味不僅能夠遮蓋住人身上的汗味，而且某些特別的「香水」還有著提神的功效…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420109
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420109,
					"content": "里夫一直在村口做守衛，每天熱得滿身大汗，回來的時候也總是說自己被曬得頭暈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420110
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420110,
					"content": "所以，我就想做一瓶「薄荷香水」送給他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420111
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420111,
					"content": "賈瓦希爾奶奶把製作香水的方法寫給了我，還幫我去買了很多材料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420112
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420112,
					"content": "但製作香水真是出乎意料的麻煩…光是偷偷處理材料我就花了好長時間，還做出了不少失敗品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420113
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420113,
					"content": "再這麼拖下去，里夫就要發現我做香水的事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420114
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420114,
					"content": "#所以旅行者，能請{F#妳}{M#你}幫我去置辦一些材料嗎？一定要偷偷地，不能讓里夫發現！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420115,
						230420117
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420115,
					"content": "告訴他也沒問題吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420116
					]
				},
				{
					"id": 230420116,
					"content": "不行不行，這可是我準備了好久的驚喜，絕對不能這麼輕易就告訴他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420119,
					"content": "#其實我想拜託{F#妳}{M#你}準備的東西也不多啦，{F#妳}{M#你}先去找阿扎萊先生，拿到我訂的貨，然後再幫我取一小桶水來就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420120
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420120,
					"content": "記住，一定要偷偷的喔，絕對不能讓里夫察覺到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420117,
					"content": "唉…交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420118
					]
				},
				{
					"id": 230420118,
					"content": "#那就拜託{F#妳}{M#你}啦，放心，我一定會準備好報酬的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420119
					],
					"speakerTitle": "內爾敏"
				}
			]
		},
		{
