			"dialogs": [
				{
					"id": 230420301,
					"content": "歡迎，客人需要點什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420302
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230420302,
					"content": "關於內爾敏的「貨物」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420303
					]
				},
				{
					"id": 230420303,
					"content": "#{F#妳}{M#你}說那個啊…已經準備好了。這些都是品質很不錯的香料，價格也不貴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420304
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230420304,
					"content": "內爾敏是準備拿這些香料製作「香水」，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420305
					],
					"speakerTitle": "阿扎萊"
				},
				{
					"id": 230420305,
					"content": "唉，雖然有活力是件好事，但內爾敏也得注意一下自己的身體啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿扎萊"
				}
			]
		},
		{
			"id": 2304205,
			"completionStepIds": [
				2304205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2304205",
							"2"
						],
						"stepId": 2304205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"內爾敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420501,
					"content": "#太好了，之前的材料還剩下一點，加上{F#妳}{M#你}帶來的這些，我可以再試做幾次了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420502
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420502,
					"content": "呼…我再多看看筆記，這次一定要成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420503
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420503,
					"content": "對了，我還得去摘幾片花瓣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420504
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420504,
					"content": "內爾敏開始緊張地製作起了「香水」…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230420505
					]
				},
				{
					"id": 230420505,
					"content": "完成了！氣味聞起來還不錯…也沒有變得黏黏的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420506
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420506,
					"content": "這樣應該就算是成功了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420507,
						230420508
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420507,
					"content": "感覺上算是成功了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				},
				{
					"id": 230420509,
					"content": "嗯！我還特地買了一個瓶子呢，先讓我把香水裝進去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420510
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420510,
					"content": "旅行者，我們一起去把香水送給里夫吧，希望他會喜歡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420508,
					"content": "至少不算是失敗嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420509
					]
				}
			]
		},
		{
			"id": 2304206,
			"completionStepIds": [
				2304206
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
