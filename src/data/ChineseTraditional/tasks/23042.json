			"dialogs": [
				{
					"id": 230420801,
					"content": "#旅行者，{F#妳}{M#你}又在忙什麼呢？跑來跑去的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420802
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420802,
					"content": "#對了，{F#妳}{M#你}最近有沒有幫內爾敏辦過什麼事？或者…是聽過什麼和她有關的傳聞？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420803
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420803,
					"content": "總感覺她最近忙忙碌碌的，但我又不知道她在忙什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420804,
						230420806
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420804,
					"content": "她…她忙著種花啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420805
					]
				},
				{
					"id": 230420805,
					"content": "是這樣嗎？但是我也沒看見她屋子裡多幾盆花啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420806,
					"content": "她…她忙著做菜啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420807
					]
				},
				{
					"id": 230420807,
					"content": "哈？難道是希爾米他們又纏著內爾敏做「薄荷豆湯」了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420808
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420808,
					"content": "這群孩子…我有空一定要去說說他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "里夫"
				}
			]
