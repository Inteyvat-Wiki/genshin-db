				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"里夫",
					"內爾敏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230420601,
					"content": "#內爾敏，還有旅行者…{F#妳}{M#你}們怎麼來了？是遇見什麼麻煩了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420602
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420602,
					"content": "不會是那盆花有什麼問題吧？我還在值班呢，等我值完班之後，再…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420603
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420603,
					"content": "內爾敏有東西送給你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420604
					]
				},
				{
					"id": 230420604,
					"content": "這瓶「香水」送給你！是薄荷味的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420605
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420605,
					"content": "我本來想做「墩墩桃」味的，但不知道為什麼，我只要加入墩墩桃，香水就會變得黏黏的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420606
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420606,
					"content": "謝…謝謝，但「香水」是用來做什麼的？驅蟲？還是做標記…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420607
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420607,
					"content": "是幫你提神啦，還有蓋住你身上的汗味，你每天聞著那麼重的汗味不會頭暈嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420608
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420608,
					"content": "這個，聞習慣了倒也還好，突然聞不到了反而有些不自在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420609
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420609,
					"content": "那「香水」我拿走了，你別用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420610
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420610,
					"content": "欸！不要啊，我開玩笑的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420611
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420611,
					"content": "快、快把「香水」給我，我頭現在就開始暈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420612
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420612,
					"content": "給你，塗在手臂上就行了，賈瓦希爾奶奶是這麼說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420613
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420613,
					"content": "這味道聞起來還不錯，確實很提神。塗上去還感覺涼冰冰的，滿舒服的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420614
					],
					"speakerTitle": "里夫"
				},
				{
					"id": 230420614,
					"content": "哼哼，這可是賈瓦希爾奶奶的秘方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420615
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420615,
					"content": "多虧了旅行者幫忙，我才能做出這麼好的「香水」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230420616
					],
					"speakerTitle": "內爾敏"
				},
				{
					"id": 230420616,
					"content": "就是幫了點小忙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230420617
					]
				},
				{
					"id": 230420617,
