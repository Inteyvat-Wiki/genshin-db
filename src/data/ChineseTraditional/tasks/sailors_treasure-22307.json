			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"張順"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070101,
					"content": "這可怎麼辦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070102
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070103
					]
				},
				{
					"id": 223070103,
					"content": "我之前是南十字船隊的水手，但是有次運氣不好，受了傷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070104
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070104,
					"content": "退出船隊之後，為了籌錢生活，我把幾張藏寶圖押給了一個叫博來的生意人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070105
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070105,
					"content": "如果真有寶藏，他也會分我一份，但是一直沒什麼消息，我覺得他壓根沒有去找…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070106
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070106,
					"content": "#老是這樣也不是個辦法，{F#妳}{M#你}願意幫我去找找寶藏嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070109,
						223070116
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070107,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070108
					]
				},
				{
					"id": 223070108,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070120,
					"content": "#{F#妳}{M#你}先去<color=#00E1FFFF>博來</color>那拿<color=#00E1FFFF>藏寶圖</color>吧，然後把<color=#00E1FFFF>寶藏</color>直接帶回去<color=#00E1FFFF>給他</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070121
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070121,
					"content": "我已經和他說好了，他會把我的那一份留著的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "張順"
				},
				{
					"id": 223070109,
					"content": "為什麼退出船隊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070110
					]
				},
				{
					"id": 223070110,
					"content": "我這個身體的情況我自己知道，隨時可能舊傷復發，我可不想拖累船隊，就自己退出了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070111
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070111,
					"content": "然後，我用自己之前搜集的一些零碎，在這裡做點小生意謀生。但是這生意也不好做啊，東西也快賣光了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070112
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070112,
					"content": "我本來還有幾張藏寶圖，也是之前跟船的時候拿到的戰利品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070113
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070113,
					"content": "但是我這個破身體，走路都吃力，哪還能去探險呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070114
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070114,
					"content": "我就把那幾張藏寶圖押給了那個叫博來的，換了幾個錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070115
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070115,
					"content": "#不過他大概也沒辦法親自去尋寶吧，畢竟也就是個普通商人…所以，寶藏的事就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070107,
						223070116
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070116,
					"content": "真有大寶藏嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070117
					]
				},
				{
					"id": 223070117,
					"content": "哈哈哈，這應該是不可能的，這些藏寶圖也是船隊裡分發的戰利品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070118
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070118,
					"content": "要是真有大寶藏，船隊裡的好手早就解開線索，把寶藏拿回船了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070119
					],
					"speakerTitle": "張順"
				},
				{
					"id": 223070119,
					"content": "#但是，就算不是大寶藏，應該也多少能值點錢，至少三個人分是夠了…所以，寶藏就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070120
					],
					"speakerTitle": "張順"
				}
			]
		},
		{
			"id": 2230702,
