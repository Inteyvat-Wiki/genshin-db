			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"博來"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 223070201,
					"content": "喂，朋友，貨要不要？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070202
					],
					"speakerTitle": "博來"
				},
				{
					"id": 223070202,
					"content": "要藏寶圖。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						223070203
					]
				},
				{
					"id": 223070203,
					"content": "#藏寶圖？哦…{F#妳}{M#你}是說張順押在我這的那些是吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070204
					],
					"speakerTitle": "博來"
				},
				{
					"id": 223070204,
					"content": "#嘿，{F#妳}{M#你}還真想去看看藏著什麼寶貝？我還是姑且收著玩玩呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070205
					],
					"speakerTitle": "博來"
				},
				{
					"id": 223070205,
					"content": "#一看{F#妳}{M#你}就是個實實在在的冒險家，聽見寶藏兩個字眼睛都在放光。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070206
					],
					"speakerTitle": "博來"
				},
				{
					"id": 223070206,
					"content": "#反正這些藏寶圖我要了也沒用，給{F#妳}{M#你}也沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070207
					],
					"speakerTitle": "博來"
				},
				{
					"id": 223070207,
					"content": "#不過，{F#妳}{M#你}要是真找到了寶貝，咱們得分一分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						223070208
					],
					"speakerTitle": "博來"
				},
				{
					"id": 223070208,
					"content": "畢竟這藏寶圖在我這放了這麼久，倉儲費那也得付點不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "博來"
				}
			]
		},
		{
			"id": 2230703,
			"completionStepIds": [
				2230703,
				2230721,
