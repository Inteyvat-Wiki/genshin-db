			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭丘",
					"皮雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200101,
					"content": "妳那個課題，最近還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200102
					],
					"speakerTitle": "蘭丘"
				},
				{
					"id": 130200102,
					"content": "下個月應該就能發表了。呼…前幾天還以為要被喊停了，好在是虛驚一場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200103
					],
					"speakerTitle": "皮雅"
				},
				{
					"id": 130200103,
					"content": "畢竟妳課題的導師中有阿扎爾掛名，本來還以為會被牽連。後來是怎麼解決的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200104
					],
					"speakerTitle": "蘭丘"
				},
				{
					"id": 130200104,
					"content": "不是新來了一位代理賢者嗎？他重新審閱了我們的計畫，允許我們繼續研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200105
					],
					"speakerTitle": "皮雅"
				},
				{
					"id": 130200105,
					"content": "代理賢者？以前有過這種職位嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200106
					],
					"speakerTitle": "蘭丘"
				},
				{
					"id": 130200106,
					"content": "我聽人說，其實是因為新賢者還在選拔，但暫時沒有結果…就讓那個人暫代一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200107
					],
					"speakerTitle": "皮雅"
				},
				{
					"id": 130200107,
					"content": "也多虧他幫我們說了話，大家的研究成果才能保住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200108
					],
					"speakerTitle": "皮雅"
				},
				{
					"id": 130200108,
					"content": "等論文發表後，我一定要讓自己放個長假，好好休息一下。到時候我想去蒙德旅遊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200109
					],
					"speakerTitle": "皮雅"
				},
				{
					"id": 130200109,
					"content": "那些人真是昏了頭，竟然會請艾爾海森做代理賢者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200110
					],
					"speakerTitle": "拉庫馬爾"
				},
				{
					"id": 130200110,
					"content": "消消氣，老師。我也納悶，按資歷您才是學術泰斗，怎麼輪得到他一個毛頭小子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200111
					],
					"speakerTitle": "雷漢"
				},
				{
					"id": 130200111,
					"content": "愚蠢！你以為我是氣自己沒當上賢者？我是不理解為何偏偏是艾爾海森。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200112
					],
					"speakerTitle": "拉庫馬爾"
				},
				{
					"id": 130200112,
					"content": "當初他選修我的課，一學期我就沒見過他幾次。問他，他居然敢頂撞我，說聽我講課還不如自己在家看書——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200113
					],
					"speakerTitle": "拉庫馬爾"
				},
				{
					"id": 130200113,
					"content": "狂妄！沒分寸！這樣的人竟然成了代理賢者，根本就是教令院的不幸！咳咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200114
					],
					"speakerTitle": "拉庫馬爾"
				},
				{
					"id": 130200114,
					"content": "冷靜啊老師，我、我去幫您裝杯水！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200115
					],
					"speakerTitle": "雷漢"
				},
				{
					"id": 130200115,
					"content": "噓…告訴你們一個秘密。聽說新的代理賢者，是我們知論派的學長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200116
					],
					"speakerTitle": "雷薩哈尼"
				},
				{
					"id": 130200116,
					"content": "真的嗎？是誰啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200117
					],
					"speakerTitle": "法莉巴"
				},
				{
					"id": 130200117,
					"content": "他叫艾爾海森，我是沒見過啦，最近有關他的說法不少，也不知道哪些是真的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200118
					],
					"speakerTitle": "羅珊"
				},
				{
					"id": 130200118,
					"content": "比起這個，最近因論派有個風頭正盛的學者，聽別人說他很可能是下任賢者之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200119
					],
					"speakerTitle": "羅珊"
				},
				{
					"id": 130200119,
					"content": "喔？他有開課嗎？我們要不要早點去拜訪一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200120
					],
					"speakerTitle": "法莉巴"
				},
				{
					"id": 130200120,
					"content": "唔…看來艾爾海森要當代理賢者這件事傳得很廣呢。不過居然也有人不認識他，他似乎不是那麼有名？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200121,
					"content": "關於他的評價也是有好有壞，特別是剛剛那個老人，看起來對他很不滿…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200122,
					"content": "咦，你怎麼了，身體不舒服嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200123,
					"content": "風紀官…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200124
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200124,
					"content": "風紀官？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200125,
					"content": "我是伊利亞斯。我要見風紀官，我有很重要的事情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200126
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200126,
					"content": "嗚哇，你都這樣了，還是不要勉強自己了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200127,
					"content": "不然你把事情告訴我們，我們幫你轉告風紀官怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200128,
					"content": "不行。我必須親自見到風紀官，只有風紀官可以信任…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200129
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200129,
					"content": "#拜託{F#妳}{M#你}們扶我一把，這件事很重要，絕對不能出差錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200130
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200130,
					"content": "既然你都這麼說了…好吧，我們帶你去找風紀官！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1302003,
			"completionStepIds": [
				1302003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302003",
							"2"
						],
						"stepId": 1302003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200301,
					"content": "你好！我們想打聽一下，賽諾在教令院嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200302,
					"content": "兩位看起來很眼熟，莫非是賽諾大人的朋友？賽諾大人正在外面執行任務。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200303
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200303,
					"content": "#有什麼事可以先和我說，我會幫{F#妳}{M#你}們轉告賽諾大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200304
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200304,
					"content": "我們在教令院門口遇到了這個傢伙，他吵著要見風紀官，好像有什麼要緊的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200305,
					"content": "喔？不介意的話，可否先跟我聊一聊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200306
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200306,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200307
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200307,
					"content": "西拉傑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200308
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200308,
					"content": "西拉傑？這個名字聽起來很耳熟，是因論派那位學者嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200309
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200309,
					"content": "因論派的學者？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200310,
					"content": "嗯。因論派風頭鼎盛的學者，聽說是一位敢想敢做的天才。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200311
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200311,
					"content": "也有消息說他可能會代表因論派成為下任賢者之一…你接著說，西拉傑怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200312
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200312,
					"content": "我要揭發…西拉傑正在做一個危險的實驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200313
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200313,
					"content": "他綁架了我。把我綁到那個可怕的山洞裡…到處都是實驗器材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200314
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200314,
					"content": "我拼命地跑…只差一點，我就被他抓住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200315
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200315,
					"content": "別緊張，慢慢說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200316
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200316,
					"content": "他在做什麼實驗？那個山洞在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200317
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200317,
					"content": "我不記得了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200318
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200318,
					"content": "欸？這麼重要的事，你竟然不記得了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200319,
					"content": "我只記得西拉傑朝我走來，之後我的腦袋就開始變得不正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200320
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200320,
					"content": "我忘了很多東西，就像做了一場噩夢。但我知道那裡很危險，必須立刻阻止他們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200321
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200321,
					"content": "對了，我還聽說他們會在酒館做交易，得快一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200322
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200322,
					"content": "就算你這麼說…好吧，我會讓我的同事去查西拉傑的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200323
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200323,
					"content": "不過在那之前，我希望你接受風紀官的「測謊」調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200324
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200324,
					"content": "你在懷疑我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200325
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200325,
					"content": "不要誤會，只是慣例而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200326
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200326,
					"content": "勞煩兩位在這裡稍等一下，我們很快就會回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200327
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200327,
					"content": "等待的時間似乎比預期中更長一些…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130200328
					]
				},
				{
					"id": 130200328,
					"content": "咦，艾爾海森？你怎麼在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200329,
					"content": "我來解釋一下吧，剛剛我帶伊利亞斯去測謊，他順利通過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200330
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200330,
					"content": "這表示他說的話有很高的可信度，我們決定圍繞他提供的線索展開調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200331
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200331,
					"content": "這件事按慣例呈報給了艾爾海森大人，他聽完之後先是留了封信給賽諾大人，然後提出要和我們一起行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200332
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200332,
					"content": "奇怪，艾爾海森居然會和風紀官一起行動，莫非有什麼特別的原因？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200333,
					"content": "想多了，只是有點興趣而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200334
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200334,
					"content": "是嗎？你還有這種閒暇呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200335,
					"content": "#{NICKNAME}，不如我們也一起去看看吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200336,
					"content": "#艾爾海森大人參與我們的行動已經是違規情況了，{F#妳}{M#你}們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200337
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200337,
					"content": "#算了，畢竟伊利亞斯是{F#妳}{M#你}們帶來的。我可以允許{F#妳}{M#你}們一起來，前提是{F#妳}{M#你}們必須對一切計畫保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200338
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200338,
					"content": "放心，我們的口風可是很緊的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200339,
					"content": "那我先說一下目前掌握的線索吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200340
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200340,
					"content": "伊利亞斯聲稱西拉傑會與某位妙論派學者在酒館進行交易。這是他為數不多的清醒回憶，似乎是在逃跑的時候偶然聽到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200341
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200341,
					"content": "順便一提，西拉傑目前並不在教令院，他在一個月前就申請了長期外出調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200342
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200342,
					"content": "距離伊利亞斯提供的交易時間很近了，我們決定立刻趕往酒館，搜查可疑人員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200343
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200343,
					"content": "#就是這樣。準備出發，{F#妳}{M#你}們隨意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200344
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200344,
					"content": "都說了我們要一起去啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 1302005,
			"completionStepIds": [
				1302005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302005",
							"2"
						],
						"stepId": 1302005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾爾海森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130200501,
					"content": "我們到了，艾爾海森大人。接下來該怎麼做？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200502
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200502,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200503
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200503,
					"content": "艾爾海森大人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200504
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200504,
					"content": "看來你最近沒有看任何文書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200505
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200505,
					"content": "新頒佈的教令明確提出，對於已經確立的調查案，即便是賢者出面也無權干預風紀官行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200506
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200506,
					"content": "如果你們的上司在，他不會問我該做什麼，反而會警告我「不要指手畫腳」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200507
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200507,
					"content": "…您說得沒錯，我明白了。那請您在這裡稍等，我們立刻封鎖周邊區域，搜查可疑人員！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200508
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200508,
					"content": "伊利亞斯就留在這裡吧，也勞煩艾爾海森大人保護主要證人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200509
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200509,
					"content": "可以。他要是能保護好自己就更好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200510
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200510,
					"content": "果然還是老樣子…之前在阿如村的時候就是這樣，動不動就不理人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200511,
					"content": "回答水準不足的問題，是對發問者的縱容，而且我需要讓他清楚地明白我的態度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200512
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200512,
					"content": "什麼意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130200513
					]
				},
				{
					"id": 130200513,
					"content": "#和{F#妳}{M#你}們一樣，阿拉夫也疑惑我為什麼會跟來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200514
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200514,
					"content": "#但和{F#妳}{M#你}們不同的是，他把這個問題想得更複雜，比如「代理賢者想要染指風紀官的權力 」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200515
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200515,
					"content": "他向我提問，明顯是在試探。風紀官之前受到賢者影響，難免被捲入這種官僚陷阱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200516
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200516,
					"content": "但他根本不需要那樣說，我希望他瞭解，這一次我不會插手他們的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200517
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200517,
					"content": "好複雜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130200518,
					"content": "所以我起初一直反對當什麼代理賢者。頭銜會讓很多事變得麻煩，在所難免。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200519
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200519,
					"content": "打擾一下…艾爾海森大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200520
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200520,
					"content": "我有個問題，無論如何都想問——我們以前，見過面嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200521
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200521,
					"content": "沒有，我對你毫無印象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200522
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200522,
					"content": "哈哈…我想也是，我跟您這樣的人應該沒什麼交集才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200523
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200523,
					"content": "那又為什麼要問？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200524
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200524,
					"content": "因為第一次見到您時，不知道為什麼總有一種…熟悉的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200525
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130200525,
					"content": "是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200526
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200526,
					"content": "錯覺？或者是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200527
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200527,
					"content": "艾爾海森大人，我們抓到嫌疑人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200528
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200528,
					"content": "西拉傑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200529
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200529,
					"content": "不，是和他做交易的妙論派學者，名叫納蘭德拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200530
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200530,
					"content": "艾、艾爾海森大人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200531
					],
					"speakerTitle": "納蘭德拉"
				},
				{
					"id": 130200531,
					"content": "等等，有人能跟我解釋一下嗎？我承認我確實從實驗室偷了些機械零件往外賣，這是需要代理賢者親自過問的案件嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200532
					],
					"speakerTitle": "納蘭德拉"
				},
				{
					"id": 130200532,
					"content": "我的天，我該不會捲入什麼大麻煩裡了吧？我、我只是一時利慾薰心，還請各位手下留情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200533
					],
					"speakerTitle": "納蘭德拉"
				},
				{
					"id": 130200533,
					"content": "我想問他幾個問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200534
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200534,
					"content": "當然可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200535
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200535,
					"content": "你認識西拉傑？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200536
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200536,
					"content": "聽過，是買家的名字。他約我在酒館做交易，不過遲遲未到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200537
					],
					"speakerTitle": "納蘭德拉"
				},
				{
					"id": 130200537,
					"content": "交易的內容是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200538
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200538,
					"content": "他不知道在做什麼實驗，好像需要很多能源與電路元件，只有我們的計畫有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200539
					],
					"speakerTitle": "納蘭德拉"
				},
				{
					"id": 130200539,
					"content": "他私下聯絡我，要我假藉「淘汰損毀」之名昧下一些，他會高價收購。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200540
					],
					"speakerTitle": "納蘭德拉"
				},
				{
					"id": 130200540,
					"content": "本來我們約好今天在酒館交易，誰想到我先是被放了鴿子，又遇到了你們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200541
					],
					"speakerTitle": "納蘭德拉"
				},
				{
					"id": 130200541,
					"content": "也許是西拉傑察覺到伊利亞斯有可能會透露消息，所以故意沒來赴約？不管怎麼說，線索到這裡似乎就斷掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200542
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200542,
					"content": "好消息是不管西拉傑想做什麼，沒有這批能源與電路，他的進度肯定會受到阻礙。我們還有時間慢慢調查。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200543
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200543,
					"content": "您還有什麼問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200544
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200544,
					"content": "沒有了，納蘭德拉交給你們帶走。另外，我還想再「借」伊利亞斯一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200545
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200545,
					"content": "喔，這個沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200546
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200546,
					"content": "我們對伊利亞斯進行了全方位的測謊，他確實不記得更多事情，我們也不打算從他這裡尋找突破。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200547
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200547,
					"content": "不過順便問一下，您留下他的理由是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200548
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200548,
					"content": "我以前看過一些關於失憶的論文，想嘗試引導他恢復記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200549
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130200549,
					"content": "原來如此…那我們先回教令院，伊利亞斯就拜託您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130200550
					],
					"speakerTitle": "阿拉夫"
				},
				{
					"id": 130200550,
					"content": "跟我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾爾海森"
				}
			]
		},
