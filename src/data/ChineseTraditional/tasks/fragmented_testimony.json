		{
			"id": 1302012,
			"completionStepIds": [
				1302012
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1302012",
							"2"
						],
						"stepId": 1302012,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾爾海森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130201201,
					"content": "結果西拉傑根本沒來酒館，納蘭德拉也沒有什麼線索…好像陷入僵局了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201202,
					"content": "艾爾海森，你真的打算管到底嗎？總覺得你對這件事特別有興趣，我都有點意外了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201203,
					"content": "我還以為妳已經猜到原因了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201204
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201204,
					"content": "#欸？我沒猜到呀，{NICKNAME}，{F#妳}{M#你}猜到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201205,
					"content": "你認識西拉傑？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130201206
					]
				},
				{
					"id": 130201206,
					"content": "嗯，同屆的同學。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201207
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201207,
					"content": "原來是這樣！所以阿拉夫跟你通報的時候，你才提出要跟來看看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201208,
					"content": "你對這個案子感興趣不是因為內容，而是因為嫌疑犯是認識的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201209,
					"content": "妳的描述跟事實相差甚遠，不過我並沒有冀望妳能得出更準確的答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201210
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201210,
					"content": "妳暫時這麼理解就可以了。我跟他是同屆入學，後來我當了書記官，而他繼續在學術上深造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201211
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201211,
					"content": "一年前，他提出了一份研究申請。當時的大賢者看後問我意見，我並不怎麼看好，因為從結果來說，它觸及了六宗根源之罪中的「人類進化之事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201212
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201212,
					"content": "從「人類進化之事」到「慢言奧秘而心無懼怕之事」，六宗根源之罪是此世萬般罪責的開端，也是賢者們制定和修正教令的參照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201213
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201213,
					"content": "西拉傑的研究在我看來過於天真，但結果上他確實觸犯了底線。大賢者參考了各種意見，那份報告最終被駁回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201214
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201214,
					"content": "所以他購買能源和電路元件…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201215,
					"content": "大概是想在不被允許的情況下，私自進行實驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201216
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201216,
					"content": "聽起來好可疑，還是阻止他比較好吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201217,
					"content": "伊利亞斯，你再努力想想，看看會不會有什麼新發現？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201218,
					"content": "抱歉。我試過很多次，但無論我怎麼回憶，那些事都像是隔著厚厚的迷霧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201219
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130201219,
					"content": "人在受到強烈的刺激後，可能會下意識割捨部分記憶，以此達到自我保護的目的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201220
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201220,
					"content": "但這些記憶並不是真的消失，只是暫時被封存了。給予適當刺激，仍然有恢復的可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201221
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201221,
					"content": "試著回憶一下你在意的事情吧，不必非要和案件有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201222
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201222,
					"content": "其實，我感覺我忘掉的事情有很多，不僅僅只有被抓去做實驗的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201223
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130201223,
					"content": "我是一個怎樣的人、做過哪些事，有些我能記起來，有些不管怎麼想都沒有頭緒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201224
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130201224,
					"content": "不過我隱約記得，自己有兩件「不得不做的事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201225
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130201225,
					"content": "說來聽聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201226
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201226,
					"content": "第一件事是「從教令院領取薪水，送給在化城郭的妹妹」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201227
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130201227,
					"content": "我不清楚詳情…只記得以前我似乎每個月都會把錢給妹妹，讓她補貼家用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201228
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130201228,
					"content": "那第二件呢？第二件事是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201229,
					"content": "想不起來。抱歉，我真的忘了太多東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201230
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130201230,
					"content": "不意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201231
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201231,
					"content": "目前只有你見過西拉傑，只有你知道那個山洞的具體位置。所以，我們會提供一切必要支持，幫助你恢復記憶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201232
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130201232,
					"content": "失去記憶…一定很痛苦吧，不過我們會幫你想起來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201233
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130201233,
					"content": "多謝。不僅僅是「痛苦」，我不知道該如何形容這種感覺…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201234
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130201234,
					"content": "遺失了太多記憶，讓我對自己的認知都變得模糊。腦袋嗡嗡作響，好像下一刻就要失去意識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201235
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130201235,
					"content": "但在這種令人作嘔的感覺中，我又像是得到了解脫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201236
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130201236,
					"content": "不管怎麼說，多虧了你們，我變得稍微清醒一些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201237
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130201237,
					"content": "我記得我在教令院中一個叫做「調查籌備處」的地方兼職，每個月也是在那裡領取薪水的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130201238
					],
					"speakerTitle": "伊利亞斯"
				},
				{
					"id": 130201238,
					"content": "我明白了。那就先去找那邊的負責人，走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾爾海森"
				}
			]
		},
