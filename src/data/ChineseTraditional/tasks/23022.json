			"trigger": {
				"objectNames": [
					"拉菲克",
					"綺珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230220101,
					"content": "這裡的強度要是再增加的話，就必須把這裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220102
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220102,
					"content": "如果你採用這種設計，就和之前沒什麼本質區別了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220103
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230220103,
					"content": "你們還在設計船嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220104
					]
				},
				{
					"id": 230220104,
					"content": "#是{F#妳}{M#你}啊，旅行者。沒錯，在上次試航結束之後，我和綺珊又討論了一些…嗯…關鍵節點上的設計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220105
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220105,
					"content": "在我們…充分地交流後，正準備嘗試一種新的設計方案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220106
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220106,
					"content": "但是在材料使用上，我們又產生了一些分歧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220107
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220107,
					"content": "不過這一次！我可是聽了綺珊的意見，花大價錢買了一批好材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220108
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220108,
					"content": "#旅行者，{F#妳}{M#你}看，我一個人搬不完，綺珊的力氣也不大，{F#妳}{M#你}就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220109,
						230220110
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220109,
					"content": "我們一起去搬。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				},
				{
					"id": 230220111,
					"content": "真是可靠，那我們快點出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220112
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220112,
					"content": "這次的材料可是綺珊親自選的，應該不會出什麼問題了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220113
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220113,
					"content": "#而且這次，我也給{F#妳}{M#你}準備了更多的報酬，真是謝謝{F#妳}{M#你}幫忙了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220110,
					"content": "別說了，走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230220111
					]
				}
			]
		},
