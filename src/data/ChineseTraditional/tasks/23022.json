			},
			"dialogs": [
				{
					"id": 230220501,
					"content": "#好…嘞！這些材料應該就夠用了。這是{F#妳}{M#你}的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220502
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220502,
					"content": "不過，這些材料還真是輕啊…綺珊選的這些材料真的可靠嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220503
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220503,
					"content": "#相信我，這些材料比{F#妳}{M#你}之前選的那些都好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220504
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230220504,
					"content": "#那這次，{F#妳}{M#你}要幫我準備好救生用具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230220505
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230220505,
					"content": "#…沒問題的，{F#妳}{M#你}就相信我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "綺珊"
				}
			]
		},
