					"布里科勒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741700401,
					"content": "#{F#妳}{M#你}成功了！看來這並不是無法完成的挑戰，我可以安心把方案提交給院裡了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700402
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741700402,
					"content": "可惜這裡的資產還沒有清點完畢，之後我多半還得回來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741700403
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741700403,
					"content": "#不管怎麼說，感謝{F#妳}{M#你}的協助，對了，還有報酬。祝{F#妳}{M#你}旅途順利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布里科勒"
				}
			]
		},
