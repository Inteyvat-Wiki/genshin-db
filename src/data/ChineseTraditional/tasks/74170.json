					"布里科勒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741701701,
					"content": "#哦！{F#妳}{M#你}又回來了。我也回來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701702
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741701702,
					"content": "院裡聽完簡報之後要我在回收資產的時候，也評估一下這裡是否有可能改造成素質拓展訓練場地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701703
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741701703,
					"content": "唉，總覺得這種工作似曾相識。以前也有這麼一段時期，事務官格外熱衷於帶大家進行潛水訓練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701704
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741701704,
					"content": "我是覺得沒什麼用，不過工作就是工作，任務就是任務…而且這裡的確結構很奇怪…我是說奇特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701705
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741701705,
					"content": "所以我在各處放了一些樁錨複製品，簡單說就是樁錨的模型啦，是完全沒有風險的安全道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701706
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741701706,
					"content": "我目前設想的訓練內容是，<color=#00E1FFFF>在規定時間內回收建築內的所有樁錨複製品。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741701707
					],
					"speakerTitle": "布里科勒"
				},
				{
					"id": 741701707,
					"content": "#{F#妳}{M#你}想試試看嗎？挑戰成功的話我也會提供一些報酬，畢竟也是協助研究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "布里科勒"
				}
			]
		},
		{
			"id": 7417004,
			"completionStepIds": [
				7417004
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
