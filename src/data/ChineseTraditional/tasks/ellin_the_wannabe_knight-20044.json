			},
			"dialogs": [
				{
					"id": 200440101,
					"content": "傷腦筋…這裡要怎麼解決啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440102
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440102,
					"content": "妳在做什麼呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440103
					]
				},
				{
					"id": 200440103,
					"content": "為了下一次的騎士選拔，我正在訓練呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440104
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440104,
					"content": "唔…不過，我可沒有琴大人那樣的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440105
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440105,
					"content": "比起鍛煉「力量」，我覺得學習「技巧」更適合我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440106
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440106,
					"content": "比如，一口氣把這些木樁全部破壞掉的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440107
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440107,
					"content": "#{F#妳}{M#你}有空的話，也和我一起來想一想吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440108,
						200440109
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440108,
					"content": "我想一想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440110
					]
				},
				{
					"id": 200440110,
					"content": "沒關係，好好想喔，木樁不會自己跑掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440111
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440111,
					"content": "唯一會自己跑掉的只有被消耗的時間和生命，唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440114,
					"content": "要是能用更大一些的武器，或者和琴大人一樣，使用元素的力量，也許就能輕鬆破壞掉全部木樁了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440109,
					"content": "我們兩個一起上…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200440112
					]
				},
				{
					"id": 200440112,
					"content": "#{F#妳}{M#你}習慣團體作戰嗎？真羡慕啊…隨時都能叫到幫手的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440113
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 200440113,
					"content": "像我這樣的，只能學習獨自作戰啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200440114
					],
					"speakerTitle": "艾琳"
				}
			]
		},
