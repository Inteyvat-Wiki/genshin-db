	"talks": [
		{
			"id": 7451501,
			"completionStepIds": [
				7451501
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7451501",
							"2"
						],
						"stepId": 7451501,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"胡塞尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 745150101,
					"content": "#欸？是{NICKNAME}和派蒙？太好了，{F#妳}{M#你}們出現得正是時候！我正準備去冒險家協會發布委託！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150102
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150102,
					"content": "#竟然有送上門來的委託？好耶，{NICKNAME}今晚我們可以吃大餐了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150103,
					"content": "咳咳，派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150104
					]
				},
				{
					"id": 745150104,
					"content": "啊…我是說，作為知名冒險家，我們對出場費可是有一定要求的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150105,
					"content": "#報酬的事情{F#妳}{M#你}們不必擔心。只要{F#妳}{M#你}們像以前那樣負責好被分配到的實驗，報酬絕對夠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150106
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150106,
					"content": "像、像以前那樣？唔——那個…這位先生，我們以前見過嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150107,
					"content": "#唉…{F#妳}{M#你}們又把我忘了嗎？是我啊，須彌的教令院學者胡塞尼，我們明明都合作過那麼多次了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150108
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150108,
					"content": "對、對不起，完全沒有印象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150109,
					"content": "那「導能原盤」呢？總該有點印象吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150110,
						745150111
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150110,
					"content": "難道是「圓盤人」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150113
					]
				},
				{
					"id": 745150113,
					"content": "「圓盤人」——？哦，我想起來了，是之前在離島和層岩巨淵見過的那位！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150114,
					"content": "你變化好大，唔——感覺變陽光了不少，怪不得一下子都認不出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150115,
					"content": "呵呵，有嗎？那應該是因為我現在太開心了吧？說實話，我已經好久沒這麼走運過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150116
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150116,
					"content": "哇！發生了什麼好事啊？也告訴我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150117,
					"content": "這就說來話長了，在上次分別之後我直接就回到「教令院」，並根據收集到的資料提出了人造導能原盤的想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150118
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150118,
					"content": "在看到提案書的第一刻導師他神情十分激動，當場給予提案書「高度的讚揚」，然後就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150119
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150119,
					"content": "然後就…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150120,
					"content": "然後他就把我趕出了須彌，要我在楓丹替他跑腿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150121
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150121,
					"content": "啊？為什麼？不是誇獎嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150122,
					"content": "他誇我十分勇敢，竟然敢把幻想文學當做提案書交給他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150123
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150123,
					"content": "這怎麼看都不是誇獎吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745150124,
					"content": "沒錯，我也因此心灰意冷了一陣子。不過幸運的是我在楓丹遇到了不錯的合夥人和投資者，他們一眼就看上了我的專案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150125
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150125,
					"content": "在他們的協助下，我成功地將之前的研究與楓丹的技術互相融合，製造出了人造導能原盤的原型——也就是「胡塞尼原盤」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150126
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150126,
					"content": "只要「胡塞尼原盤」按照我計算的那樣通過實驗，別說智慧之神的考驗，就連成為賢者都不是沒有可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150127
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150127,
					"content": "你竟然還沒有畢業喔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150128
					]
				},
				{
					"id": 745150128,
					"content": "咳咳，不要在意這種沒有意義的混淆變量，這不過是我通往成功之路的一點小波折而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150129
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150129,
					"content": "現在最重要的就是驗證「胡塞尼原盤」的實際表現，為此我需要召集志願者在秘境中使用、驗證。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150130
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150130,
					"content": "#那麼{NICKNAME}，我想請問…{F#妳}{M#你}願不願以志願者的身分參加這次「胡塞尼原盤」的實驗工作呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150131,
						745150133
					],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150131,
					"content": "簡單來說，就是用那個原盤去戰鬥吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150132
					]
				},
				{
					"id": 745150132,
					"content": "#嗯，沒錯。我相信{F#妳}{M#你}的戰鬥能力，但現在的「胡塞尼原盤」還尚未達到預期的標準，請注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150133,
					"content": "好的，交給我吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150134
					]
				},
				{
					"id": 745150134,
					"content": "#{NICKNAME}，我相信{F#妳}{M#你}的戰鬥能力，但現在的「胡塞尼原盤」還尚未達到預期的標準，請注意安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "胡塞尼"
				},
				{
					"id": 745150111,
					"content": "好像也沒有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745150112
					]
				},
				{
					"id": 745150112,
					"content": "#那「圓盤人」呢？這個稱號{F#妳}{M#你}們總該有印象了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745150113
					],
					"speakerTitle": "胡塞尼"
				}
			]
		}
	]
}