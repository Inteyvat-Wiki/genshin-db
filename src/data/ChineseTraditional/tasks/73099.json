						"stepId": 7309905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭彌那離",
					"派蒙",
					"蘭甯巴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990301,
					"content": "咿！是金色的那菈！而且，有風的味道，土的味道，還有蘭那羅的味道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990302
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990302,
					"content": "金色的那菈，也破解了蘭雅瑪的蘭迦拉梨？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990303
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990303,
					"content": "可怕，可怕！阻礙，沒了用處，任誰都能闖進來，蘭彌那離的「快樂小窩」，要被「踏破」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990304
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990304,
					"content": "哇，你不要著急嘛，我們沒有惡意的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990305,
					"content": "沒有「惡意」是什麼意思？是說不「貪婪」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990306
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990306,
					"content": "#唔…算是吧！我和{NICKNAME}可是站在蘭那羅那邊的，我們想當蘭那羅的好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990307,
					"content": "派蒙雖然貪吃，但本質不壞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990308
					]
				},
				{
					"id": 730990308,
					"content": "喂！雖然是這樣沒錯啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990309,
					"content": "蘭那羅的好朋友…金色的那菈身上，有蘭那羅的味道，熟悉的味道，但是很久沒有聞到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990310
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990310,
					"content": "#啊，對了，那顆怪怪的種子！{NICKNAME}，把種子給蘭彌那離看看吧，說不定他知道些什麼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990311,
					"content": "唔！好渴！他要喝很多水，才能變回原來的樣子…快，這邊有很多水，讓他喝飽，才能恢復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990312
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990312,
					"content": "將種子放進了水裡…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730990313
					]
				},
				{
					"id": 730990313,
					"content": "…噗！回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990314
					],
					"speakerTitle": "蘭甯巴"
				},
				{
					"id": 730990314,
					"content": "#哇！種子變成蘭那羅了！真的找到了，「受困的蘭那羅」！{F#妳}{M#你}看，我說的沒錯吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990315,
						730990316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990315,
					"content": "居然真的有「受困的蘭那羅」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				},
				{
					"id": 730990317,
					"content": "是蘭甯巴！和蘭彌那離不一樣，蘭甯巴喜歡四處周遊，之前，會把在遠方看到的景色畫下來，送回桓那蘭那，但是後來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990318
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990318,
					"content": "後來到了很硬、很暗的地方，很少泥土，但是很多石頭…泥土之下，很少草，很少樹，不過有很多蘑菇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990319
					],
					"speakerTitle": "蘭甯巴"
				},
				{
					"id": 730990319,
					"content": "唔…說的應該就是層岩巨淵吧？不過，蘭甯巴一個蘭那羅居然跑到那麼遠的地方去啦，甚至離開了須彌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990320,
					"content": "嗯！路途很遠，而且危險，遇到黑色的那菈，好險！不過，蘭甯巴有蘭穆護昆達看顧，變成種子，「逃過一劫」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990321
					],
					"speakerTitle": "蘭甯巴"
				},
				{
					"id": 730990321,
					"content": "現在蘭甯巴又安全回來，多虧了金色的那菈，還有白色飛飛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990322
					],
					"speakerTitle": "蘭甯巴"
				},
				{
					"id": 730990322,
					"content": "#是{NICKNAME}和派蒙啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990323,
					"content": "#對，那菈{NICKNAME}還有派蒙，是蘭那羅的好朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990324
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990324,
					"content": "#蘭彌那離是蘭甯巴的「好朋友」，所以，那菈{NICKNAME}和派蒙也是蘭甯巴的「好朋友」，唔，懂了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990325
					],
					"speakerTitle": "蘭甯巴"
				},
				{
					"id": 730990325,
					"content": "蘭甯巴要出發了，這次，不光是畫，蘭甯巴會送回「禮物」，給蘭彌那離，裝進「寶箱」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990326
					],
					"speakerTitle": "蘭甯巴"
				},
				{
					"id": 730990326,
					"content": "這裡的「寶箱」，都是蘭彌那離的，蘭彌那離是「寶箱」的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990327
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990327,
					"content": "如果真的是蘭那羅的好朋友，幫助過很多蘭那羅的話…蘭那羅「知恩圖報」，會把「寶」放進「箱」裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990328
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990328,
					"content": "原來箱子原本是空的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990329,
					"content": "蘭那羅誕生之時就知道有關桓那的一切，但「箱」誕生之時，卻是肚裡空空的！蘭彌那離也不懂為什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990330
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990330,
					"content": "派蒙也搞不懂欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990331,
					"content": "#…等蘭彌那離放好了，那菈{NICKNAME}可以打開「寶箱」，然後像綠綠的那菈那樣，有時「好呀！」有時「唉…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990332
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990332,
					"content": "為什麼要多此一舉呢？蘭彌那離和蘭甯巴也可以直接把要放進寶箱裡的東西當作報酬交給我們嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990333
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990333,
					"content": "#蘭彌那離知道，綠綠的那菈，都喜歡進到洞裡，或者屋子裡，打開「寶箱」。那菈{NICKNAME}，還有派蒙，不喜歡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990334
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990334,
					"content": "哦…很難說不喜歡呢…感覺有種…莫名的吸引力？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990335,
					"content": "嗯，那菈喜歡「寶箱」，蘭彌那離也喜歡，所以允許幫助過蘭那羅的好那菈打開「寶箱」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990336
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990336,
					"content": "桓那有很多蘭那羅，有的需要幫助，有的想和那菈玩耍，實現他們願望的那菈，才是蘭那羅的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990337
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990337,
					"content": "這樣的那菈，可以打開蘭彌那離準備好的「寶箱」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990338
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990338,
					"content": "所以蘭甯巴應該現在就出發，為了把「寶箱」填滿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990339
					],
					"speakerTitle": "蘭甯巴"
				},
				{
					"id": 730990339,
					"content": "欸？可是蘭甯巴不是剛回來沒多久嗎？這麼快就要離開了嗎？真是風風火火呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990340
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990340,
					"content": "咿！有風很好，但不要火，離火太近，蘭甯巴就又會很渴很渴了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990341
					],
					"speakerTitle": "蘭甯巴"
				},
				{
					"id": 730990341,
					"content": "啊，我的意思是說，蘭甯巴怎麼走得這麼急，明明可以多留一下，和蘭彌那離敘敘舊嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990342,
					"content": "蘭彌那離也是，很久不見蘭甯巴，不會有很多話想說嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990343,
					"content": "蘭甯巴是停不下來的蘭那羅，所以當不了「寶箱」的主人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990344
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990344,
					"content": "蘭甯巴四處周遊的消息，只要桓那知道，風知道，花跟草知道，蘭彌那離就知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990345
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990345,
					"content": "所以，沒關係，不需要太多話。蘭甯巴想說，蘭彌那離就聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990346
					],
					"speakerTitle": "蘭彌那離"
				},
				{
					"id": 730990346,
					"content": "#唔…這就是蘭那羅的友誼嗎？如果是我的話，一定有說不完的話要和{NICKNAME}分享呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990316,
					"content": "妳還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990317
					]
				}
			]
		},
