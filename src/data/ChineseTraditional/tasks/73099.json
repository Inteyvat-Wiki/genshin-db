			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730990101,
					"content": "哎呀，蘭那羅的世界可真奇妙…看看圖畫就能找到寶藏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990102,
					"content": "這麼一來，就找到了所有圖畫的地點了呢！不知道畫這些藏寶圖的蘭那羅在什麼地方呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990103,
						730990104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990103,
					"content": "並不是所有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990105
					]
				},
				{
					"id": 730990105,
					"content": "對喔，這麼說來，還有那幅有好幾個蘭那羅一起的畫，我們在那邊沒有找到寶藏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990106,
					"content": "（行囊中似乎有什麼東西發出了輕微的震顫。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990107,
					"content": "（找到震顫的物品。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990108
					]
				},
				{
					"id": 730990108,
					"content": "咦？這是…之前我們在層岩巨淵地下，找到的種子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990109,
						730990111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990109,
					"content": "好像在指引我們去什麼地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990110
					]
				},
				{
					"id": 730990110,
					"content": "嗯…說不定真是這樣呢！之後如果種子再發出震動的話，我們就留意一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990113,
					"content": "說不定真的有「受困的蘭那羅」呢！或者是什麼，「蘭那羅寶庫」之類的…而種子就是鑰匙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990111,
					"content": "真是莫名其妙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990112
					]
				},
				{
					"id": 730990112,
					"content": "唔…我覺得可能這個種子是想要去什麼地方！之後如果種子再發出震動的話，我們就留意一下吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730990113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730990104,
					"content": "還有一個地方…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730990105
					]
				}
			]
		},
