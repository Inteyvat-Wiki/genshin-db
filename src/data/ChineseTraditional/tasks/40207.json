			"dialogs": [
				{
					"id": 402070201,
					"content": "妳好啊，伊涅芙——雅珂達這次又在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070202,
					"content": "辛苦了這麼多天，至少應該讓我分一塊蛋糕吃吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070203
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402070203,
					"content": "有蛋糕吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070204,
					"content": "#嗯，{NICKNAME}和派蒙來得剛好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070205
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070205,
					"content": "愛諾一直想感謝大家，正好鐺鐺七分甜也被救回來了，所以就想讓大家嚐嚐它的廚藝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070206
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070206,
					"content": "嘎吱…嘎吱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070207
					],
					"speakerTitle": "鐺鐺七分甜"
				},
				{
					"id": 402070207,
					"content": "哇，這就是鐺鐺七分甜原本的樣子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070208,
					"content": "好在核心相對完整，愛諾為它重新製作了一副身軀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070209
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070209,
					"content": "哼哧…哼哧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070210
					],
					"speakerTitle": "鐺鐺七分甜"
				},
				{
					"id": 402070210,
					"content": "新鮮的甜品要出爐了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070211,
					"content": "嘎吱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070212
					],
					"speakerTitle": "鐺鐺七分甜"
				},
				{
					"id": 402070212,
					"content": "自己吃下去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070213,
					"content": "廚師上菜之前總會偷吃兩口的，很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070214
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 402070214,
					"content": "不用擔心，鐺鐺七分甜吃完後就可以為大家烤製甜點了，稍等片刻就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070215
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070215,
					"content": "好吧…話說要吃甜點的時候，愛諾怎麼不在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070216,
					"content": "愛諾剛剛想到一個製作機器人的新點子，就立刻鑽進工作室了。從我來到工坊起，她就一直這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070217
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070217,
					"content": "愛諾為什麼這麼喜歡製作機器人啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070218,
					"content": "嗯…要回答這個問題的話，需要從資料庫中檢索許多歷史紀錄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070219
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070219,
					"content": "最初，愛諾可能只是驚訝於這世界上還存在一種比甜食更吸引她的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070220
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070220,
					"content": "愛諾是幸運的，她對這種事物的愛好得到了同伴們的尊重，即便維持生計本身就快要耗光他們每天的活動時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070221
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070221,
					"content": "直到一位優秀的老師出現之後，愛諾的愛好才被定義成天賦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070222
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070222,
					"content": "正如愛諾過去的那些夥伴那樣，她終於找到了自己最想做，也最擅長做的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070223
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070223,
					"content": "而當一位天才找到了自己真正想做的事，她就很難再停下自己的腳步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070224
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070224,
					"content": "所以愛諾最終還是離開了兒時的夥伴，建立了最初的叮鈴哐啷蛋捲工坊，開始製作各式各樣的機器人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070225
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070225,
					"content": "這一切對於那時的愛諾來說，或許都是身為天才的「本能」，她渴望將自己的奇思妙想化為現實。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070226
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070226,
					"content": "哦…所以才那麼喜歡製作機器人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070227,
					"content": "不過，結合我自身的經歷，我並不認為那就是答案的全部。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070228
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070228,
					"content": "早在收留我之前，愛諾就開始窮盡她的技術手段，嘗試為每個機器人賦予獨特的個性，把它們當成夥伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070229
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070229,
					"content": "我並沒有因為自己的出身，而成為工坊中的特例。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070230
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070230,
					"content": "分析原因，或許是她在這條名為天才的道路上走得太遠，回望空無一人的身側，不由得感受到孤獨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070231
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070231,
					"content": "所以，我、鐺鐺七分甜、還有其他所有經愛諾之手得以加入工坊的機器人，都不單單是一種「天才的證明」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070232
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070232,
					"content": "我們還是愛諾的家人，是她渴求的陪伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070233
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070233,
					"content": "這就是我所理解的，愛諾和機器人之間的關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070234
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070234,
					"content": "原來是這樣啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070235,
					"content": "正因如此，愛諾並不關心鐺鐺七分甜是否擁有令各方勢力忌憚的威能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070236
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070236,
					"content": "它已經被確定為工坊的一員，這就夠讓愛諾做出那一切了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070237
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070237,
					"content": "嗯嗯，我也這麼覺得！所以我也很奇怪愛諾這樣的人竟然會留在挪德卡萊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070238,
					"content": "…派蒙的這句發言，我的邏輯單元無法理解呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070239
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070239,
					"content": "我的意思是，在我看來，挪德卡萊這個地方，魚龍混雜，到處都是算計，能在這裡立足的一定都是很不好惹的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070240
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070240,
					"content": "如果其他人得到了愛諾那樣的技術，絕對會把機器人都改造成強大的兵器，驅使它們，用來威脅別人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070241
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070241,
					"content": "但愛諾…她是能把大殺器造成烤蛋糕機的人，把她放到挪德卡萊，完全格格不入啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 402070242,
					"content": "不，我的邏輯單元持完全相反的看法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070243
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070243,
					"content": "我在挪德卡萊接觸過很多人，但其中的絕大多數都不能被定義為「挪德卡萊人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070244
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070244,
					"content": "偏偏是讓派蒙感到驚訝的愛諾，最符合我的邏輯單元對「挪德卡萊人」的定義呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070245
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070245,
					"content": "叮鈴…叮鈴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070246
					],
					"speakerTitle": "鐺鐺七分甜"
				},
				{
					"id": 402070246,
					"content": "甜點烤好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070247
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402070247,
					"content": "嗯，不要急，先讓我來分一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070248
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070248,
					"content": "我要鮮奶油最多的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070249
					],
					"speakerTitle": "愛諾"
				},
				{
					"id": 402070249,
					"content": "好了，大家品嚐一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						402070250
					],
					"speakerTitle": "伊涅芙"
				},
				{
					"id": 402070250,
					"content": "…真好吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}