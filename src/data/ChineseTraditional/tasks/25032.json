					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
							"1",
							"25032"
						]
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"子澄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250321001,
					"content": "對了！我聽人家說「流泉之眾」那邊的店鋪招牌很有特色，其中一家好像叫做「金貝樂棚」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
