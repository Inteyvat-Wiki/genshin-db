	"talks": [
		{
			"id": 2503201,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2503201",
							"2"
						],
						"stepId": 2503201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"子澄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320101,
					"content": "唔…以畫引詩…不對不對，應該是以詩入畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320102
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320102,
					"content": "呃…好像也不對，這兩句話好像是同樣的意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320103,
						250320104
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320103,
					"content": "你在說什麼啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				},
				{
					"id": 250320105,
					"content": "您好啊。沒錯，我正在試著以納塔的風光為主題寫詩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320106
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320106,
					"content": "但是…說實話，這裡的風景和璃月大不相同，我也不瞭解納塔的歷史故事，完全沒辦法下手寫啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320107
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320107,
					"content": "而且我不是專業的詩人，韻也用得不好，打油詩也寫不來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320108
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320108,
					"content": "唉…但這樣出來一趟總不能空著手回去吧？那總務司的同事一定要說我「采風采風，採了個空」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320109
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320109,
					"content": "你在總務司工作？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320110
					]
				},
				{
					"id": 250320110,
					"content": "算是吧。我前段時間剛被總務司僱去丈量土地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320111
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320111,
					"content": "唉…其實就是帶著人在璃月到處轉，看看各處的水土是否有變化、是否需要修正地圖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320112
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320112,
					"content": "轉完一趟，真是累個半死，鞋子也不知道磨破了幾雙…所以我就請了個假出來散散心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320113
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320113,
					"content": "只是…不知道我那時腦子裡到底在想什麼，在請假單上寫「偶有詩興，欲出采風」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320114
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320114,
					"content": "沒想到，總務司負責批假的人居然認真地回覆我，說什麼「祝詩運亨通」…然後批了半個月的假…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320115,
						250320117
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320115,
					"content": "這樣不是滿好的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320116
					]
				},
				{
					"id": 250320116,
					"content": "好？好就好在，我的假單…整個總務司都知道了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320119,
					"content": "唉…雖然納塔真的滿好玩的，風景不錯，吃的也不錯，還有各種有趣的生物，特別是那些龍寶寶也很可愛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320120
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320120,
					"content": "但是我到現在一句詩都還沒寫出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320121
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320121,
					"content": "虧我還特意借了一臺留影機來取材，結果根本不好用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320122
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320122,
					"content": "拍一些自然風光倒是還過得去，但只要一拍店鋪或人群，拍出來的畫片就壓根沒辦法看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320123,
						250320124
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320123,
					"content": "那個…我來幫你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320125,
					"content": "真的？！謝天謝地，總算有人可以幫我了…無論如何，我都得先收集好寫詩的素材啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320126
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320126,
					"content": "我想想喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320124,
					"content": "我最擅長拍畫片了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320125
					]
				},
				{
					"id": 250320117,
					"content": "那你的詩運亨通了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320118
					]
				},
				{
					"id": 250320118,
					"content": "沒有，但是…我的假單非常地「亨通」，整個總務司都知道我要去納塔采風寫詩了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320119
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320104,
					"content": "你在寫詩嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320105
					]
				}
			]
		},
		{
			"id": 2503206,
			"completionStepIds": [
				2503206,
