			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"子澄"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 250320601,
					"content": "#{F#妳}{M#你}回來了，畫片拍好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320602
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320602,
					"content": "拍好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320603
					]
				},
				{
					"id": 250320603,
					"content": "#哇…{F#妳}{M#你}拍得真好，比我的那個助手拍得好多了，他每次在勘測地點拍畫片留證的時候都要拍好幾次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320604
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320604,
					"content": "#要是{F#妳}{M#你}可以和我一起去丈量土地，我絕對可以少用壞幾臺留影機。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320605
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320605,
					"content": "這些畫片真的有辦法用來寫詩嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250320606
					]
				},
				{
					"id": 250320606,
					"content": "應該…可以吧？唉呀，如果我真的寫不出來，就把這些畫片當成明信片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320607
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320607,
					"content": "然後在背面寫上一些祝福的話寄回總務司，那群傢伙收到禮物之後，鐵定也沒什麼話好說了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320608
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320608,
					"content": "咳…但是，這是沒辦法的辦法。在那之前，我還是先想想怎麼寫一首好詩吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250320609
					],
					"speakerTitle": "子澄"
				},
				{
					"id": 250320609,
					"content": "激盪…不對，鼓盪五部風雲…唉喲，等等，納塔總共有幾個部族啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "子澄"
				}
			]
		},
		{
			"id": 2503210,
