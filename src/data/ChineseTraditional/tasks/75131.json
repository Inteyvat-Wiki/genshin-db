				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310401,
					"content": "——唔，像是活物一樣的火、詭異的殘影、能自動留影的留影機…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751310402,
					"content": "我的直覺告訴我，這其中一定蘊含著某個複雜且難以解釋的謎團的！說不定還跟寶藏相關！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751310403,
					"content": "派蒙看出什麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751310404
					]
				},
				{
					"id": 751310404,
					"content": "說實話…完全沒有頭緒！不過…留影機的主人把它放在這裡，一定是為了拍到地面發生震動時的畫片。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751310405,
					"content": "所以我們只需要把留影機復原，然後等待地面發生震動就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751310406,
					"content": "嘿嘿，我相信到那個時候，寶藏的線索就會像是那道殘影一樣，轟隆轟隆地鑽出來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
