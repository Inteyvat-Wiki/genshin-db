			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 751310301,
					"content": "生、生物火雨！難道說火會像活物那樣朝人的頭頂飛過來嗎？嗚哇，納塔的火山也太可怕了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751310302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751310302,
					"content": "#{NICKNAME}，我有一點點好奇。嘿嘿，要不我們現在就去前面的區域探索一下吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7513104,
			"completionStepIds": [
				7513102
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7513102",
							"2"
						],
						"stepId": 7513102,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_QUEST_VAR_EQUAL",
						"rawParams": [
							"0",
