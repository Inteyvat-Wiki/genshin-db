				]
			},
			"dialogs": [
				{
					"id": 191851101,
					"content": "這些袋子的材質，相當少見啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851102
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191851102,
					"content": "[知識]（協助林尼判斷材質…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851103
					]
				},
				{
					"id": 191851103,
					"content": "是不是跟你的「魔術口袋」很像？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851104
					]
				},
				{
					"id": 191851104,
					"content": "嗯…都是海露花纖維做的，不過做了更加細緻的處理，不僅能防水，還能防酸蝕、防洩漏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851105
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191851105,
					"content": "連繫繩都是特製的，可以緊緊扎住袋口。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851106
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191851106,
					"content": "我剛剛還發現了一些材質相同的口袋，不過個頭都很小，厚度也很薄，看起來要容易壞得多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191851107
					],
					"speakerTitle": "林尼"
				},
				{
					"id": 191851107,
					"content": "有點像…密封袋？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191851108
					]
				},
				{
					"id": 191851108,
					"content": "…的確有點像。「仿製樂斯」會被衛兵犬聞出來，密封起來說不定能躲過一時。",
