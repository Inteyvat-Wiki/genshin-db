			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"坦吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733380101,
					"content": "#{F#妳}{M#你}好！陌生的朋友！{F#妳}{M#你}是路過這裡的旅人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380102
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380102,
					"content": "#抱歉半途攔下{F#妳}{M#你}…但…呃，這裡發生過什麼事…{F#妳}{M#你}能告訴我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380103
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380103,
					"content": "#我叫{NICKNAME}，幸會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380104
					]
				},
				{
					"id": 733380104,
					"content": "因論派陀裟多，坦吉。我是來…嗯，對，塔尼特部族…支援教育工作的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380105
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380105,
					"content": "真是奇怪，按說就是這裡才對…但為什麼會變成這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380106,
						733380108
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380106,
					"content": "這個…說來話長…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380107
					]
				},
				{
					"id": 733380107,
					"content": "部落爭鬥或者內訌，嗯？有意思，沙漠裡幾百年沒有發生過能毀滅一整個部落的衝突了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380110,
					"content": "#而且…我也發現了不祥的痕跡…咳咳，我建議{F#妳}{M#你}還是不要去看比較好。呃…對腸胃不太好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380111
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380111,
					"content": "或許是他們中有的倖存者回來，歸攏了大部分…遺留下來的東西。我不確定…太讓人不安了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380112
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380112,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380113
					]
				},
				{
					"id": 733380113,
					"content": "唉…怎麼會撞上這種事。感覺就像…見證了一次歷史事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380114
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380114,
					"content": "#啊，對了，順便…呃，{F#妳}{M#你}要打牌嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380115
					],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380115,
					"content": "#我從那些帳篷裡找到了幾幅牌組，稍加清理還是滿乾淨的。如果{F#妳}{M#你}有興趣的話，我們或許可以…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "坦吉"
				},
				{
					"id": 733380108,
					"content": "也許他們…已經遷徙離開了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733380109
					]
				},
				{
					"id": 733380109,
					"content": "#遷徙？不…{F#妳}{M#你}看，貨物和帳篷都還在原處。柴灰和居所還有生活過的痕跡…哼，更像是一場突然的大災難，中斷了所有人的生活…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733380110
					],
					"speakerTitle": "坦吉"
				}
			]
		},
