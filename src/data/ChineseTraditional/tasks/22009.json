	"talks": [
		{
			"id": 2200901,
			"completionStepIds": [
				2200901
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2200901",
							"2"
						],
						"stepId": 2200901,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220090101,
					"content": "盜寶團真是越來越猖獗了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090102
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090102,
					"content": "妳找我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090103
					]
				},
				{
					"id": 220090103,
					"content": "#對，我有事要拜託{F#妳}{M#你}。上次{F#妳}{M#你}說的「寶兒」，詳細調查之後，我確定她就是盜寶團的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090104
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090104,
					"content": "單獨行動的原因…也許是想要獨吞寶物，或者是給後面的盜寶團大部隊做先遣隊吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090105
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090105,
					"content": "#她一個人也很好偽裝自己，畢竟，連{F#妳}{M#你}這個經驗豐富的旅行者都被她騙過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090106
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090106,
					"content": "如果再放任她，還有另外的盜寶團這樣到處刮地三尺，周圍的文物一定都會遭殃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090107
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090107,
					"content": "#所以，我想請{F#妳}{M#你}去阻止他們，就算不能完全遏制，搶救一些文物回來也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090108,
						220090110,
						220090117
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090108,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090109
					]
				},
				{
					"id": 220090109,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090110,
					"content": "怎麼知道他們的位置？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090111
					]
				},
				{
					"id": 220090111,
					"content": "哼，如果我沒猜錯，這群盜寶團一直都在跟蹤我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090112
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090112,
					"content": "除了直接從我這裡「撿現成」之外，這些貪心不足的傢伙肯定還不滿足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090113
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090113,
					"content": "只要是我駐足過的地方，他們一定也會掘地三尺，想從裡面挖出點東西來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090114
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090114,
					"content": "稍微想一想，我就知道他們會在哪裡。但我只是個學者，推理判斷之類的工作不在話下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090115
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090115,
					"content": "#但要論起戰鬥，就只能拜託{F#妳}{M#你}這位經驗豐富的旅行者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090116
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090116,
					"content": "#拜託{F#妳}{M#你}了，快去把那些文物拿回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090117,
					"content": "我馬上去打垮他們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090118
					]
				},
				{
					"id": 220090118,
					"content": "#請等一下，雖然說是「阻止」，但我並不想{F#妳}{M#你}馬上和那個寶兒攤牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090119
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090119,
					"content": "#盜寶團組織鬆散，同時也很難抓住蹤跡，現在{F#妳}{M#你}和他們掛上了鉤，是千載難逢的好機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090120
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090120,
					"content": "#我覺得，他們在這片「歸離原」上出現，一定是有所圖謀。{F#妳}{M#你}留在寶兒身邊，說不定能打探到他們的計畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090121
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090121,
					"content": "#所以，{F#妳}{M#你}暫時還不能暴露，我相信{F#妳}{M#你}的實力，挑一個隱蔽的攻擊點，然後…速戰速決吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090122
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090122,
					"content": "記住，拿到文物後馬上離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		},
