					"索拉雅"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220090301,
					"content": "怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090302
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090302,
					"content": "這是文物。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220090303
					]
				},
				{
					"id": 220090303,
					"content": "呼…沒錯，和我想的一樣，他們果然是在循著我考察的路線挖掘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090304
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090304,
					"content": "雖然沒什麼技術含量，但是這群烏合之眾有著「人數」的優勢，浩浩蕩蕩一擁而上，總能從邊角裡摸出點東西來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220090305
					],
					"speakerTitle": "索拉雅"
				},
				{
					"id": 220090305,
					"content": "#幸好有{F#妳}{M#你}，不然這些文物就要遭殃了，實在是太感謝了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "索拉雅"
				}
			]
		}
	]
