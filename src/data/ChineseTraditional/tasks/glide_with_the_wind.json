			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4810102,
					"content": "感覺還不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810103,
					"content": "總是不自覺飛太高。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810104
					]
				},
				{
					"id": 4810101,
					"content": "#{NICKNAME}！找{F#妳}{M#你}好久了，上次給{F#妳}{M#你}的風之翼，用起來怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810102,
						4810103
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810104,
					"content": "#看來{F#妳}{M#你}用風之翼玩得很開心的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810105
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810105,
					"content": "#不過話說回來，{F#妳}{M#你}現在肯定還沒有飛行執照吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810106
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810106,
					"content": "飛行執照？那是什麼東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810107,
					"content": "從名字看也已經很明顯了吧？只有拿到飛行執照，才能在蒙德城合法飛行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810108
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810108,
					"content": "#唔…{NICKNAME}都飛了這麼久了，之前都沒有聽說這種東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810109,
					"content": "#就是因為{F#妳}{M#你}們成天在城裡飛來飛去，弄得大家都注意到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810110
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810110,
					"content": "欸嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810111,
					"content": "所以，妳今天是特別來把飛行執照送來的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810112,
					"content": "怎麼可能！騎士是很有原則的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810113
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810113,
					"content": "飛行執照先要考試合格，然後再由騎士團統一簽發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810114
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810114,
					"content": "#我今天是專門來當{F#妳}{M#你}的考官，監督{NICKNAME}進行飛行執照考試的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810115
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810115,
					"content": "#畢竟是我把風之翼給{F#妳}{M#你}的嘛，要負起責任來——琴團長一定會這麼說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810116
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810117,
					"content": "能不能稍微通融…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810118
					]
				},
				{
					"id": 4810119,
					"content": "我靠自己考就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810120
					]
				},
				{
					"id": 4810116,
					"content": "考試…聽起來就很麻煩。但既然是安柏監考，那麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810117,
						4810119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810118,
					"content": "別這麼看著人家，絕·對·不·行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810120,
					"content": "#{NICKNAME}肯定能順利通過啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810121,
					"content": "#只是一點小小的測驗，{F#妳}{M#你}擊退風魔龍時的飛行能力全蒙德有目共睹，肯定沒問題的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810122
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810122,
					"content": "不過，規章制度和飛行標準還是需要遵守的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810123
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810123,
					"content": "#這本飛行指南給{F#妳}{M#你}，雖然不用背下來，但還是要熟悉一遍才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810124
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810124,
					"content": "比如不允許雙人共用一架風之翼，不允許攜帶超規格重物起飛，不允許使用風史萊姆起飛什麼什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810125
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810125,
					"content": "#總之，{F#妳}{M#你}就好好讀一下吧，麗莎姐姐教我魔法的時候，也是要我先看很多厚厚的書的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810126
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810126,
					"content": "看起來好厚…沒辦法了，總之先讀讀看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810127,
					"content": "嗯！讀完以後就來風起地找我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4810401,
					"content": "西風騎士團的飛行指南，聽起來就很難讀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810402,
					"content": "總之先讀讀看吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 4810602,
					"content": "完全是一本寓言。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810603,
					"content": "蒙德人學習飛行的方式真浪漫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4810604
					]
				},
				{
					"id": 4810601,
					"content": "是個很好的故事呢…但是騎士團的飛行指南…是這種風格的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4810602,
						4810603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4810604,
					"content": "不管了，我們還是快去找安柏吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}