			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梅洛·郎勃羅梭",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 741810101,
					"content": "梅洛夫人！妳在這裡做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810102,
					"content": "#咦？是{F#妳}{M#你}們啊…我聽說我那不成器的丈夫在這裡有個小窩，就想來看看他過得怎麼樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810103
					],
					"speakerTitle": "梅洛·郎勃羅梭"
				},
				{
					"id": 741810103,
					"content": "沒想到，我找到了這個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810104
					],
					"speakerTitle": "梅洛·郎勃羅梭"
				},
				{
					"id": 741810104,
					"content": "他居然還把這張畫片帶在了身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810105
					],
					"speakerTitle": "梅洛·郎勃羅梭"
				},
				{
					"id": 741810105,
					"content": "嘿嘿！羅謝大叔還是很在意夫人的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810106,
					"content": "之前我們懷疑夫人的時候，只有羅謝大叔非常堅定地說：「夫人絕不會是犯人！」雖然不知道他那時怎會如此硬氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810107,
					"content": "可能是他全部的男子氣概。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810108
					]
				},
				{
					"id": 741810108,
					"content": "哦？真的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810109
					],
					"speakerTitle": "梅洛·郎勃羅梭"
				},
				{
					"id": 741810109,
					"content": "真的真的！還有哦，之前他是不是說，因為賭錢輸掉了夫人的吊墜？其實他在騙人哦！他只是不好意思說實話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810110,
					"content": "那個啊…其實那個我早就知道了，我從來沒有相信過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810111
					],
					"speakerTitle": "梅洛·郎勃羅梭"
				},
				{
					"id": 741810111,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810112,
					"content": "我的丈夫有很多缺點，有點膽小，有點懦弱，又有點彆扭，但我知道他是踏實的人，也許會被人騙，但他絕不會是個賭徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810113
					],
					"speakerTitle": "梅洛·郎勃羅梭"
				},
				{
					"id": 741810113,
					"content": "我沒有當面戳破，只是想等著他主動跟我坦白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810114
					],
					"speakerTitle": "梅洛·郎勃羅梭"
				},
				{
					"id": 741810114,
					"content": "哇…真好…可惜他現在不知道去哪了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810115,
					"content": "#（噓…{F#妳}{M#你}們看那邊，我有十成的把握，他就躲在那邊的箱子裡。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810116
					],
					"speakerTitle": "梅洛·郎勃羅梭"
				},
				{
					"id": 741810116,
					"content": "（欸？！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810117,
					"content": "（咳咳…跟以前一樣，我們爭吵的時候，他也會悄悄藏進衣櫃，還以為我不知道。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810118
					],
					"speakerTitle": "梅洛·郎勃羅梭"
				},
				{
					"id": 741810118,
					"content": "（需要幫忙叫他出來嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810119
					]
				},
				{
					"id": 741810119,
					"content": "（不用麻煩了，我今天一定要看看，他想藏到什麼時候。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810120
					],
					"speakerTitle": "梅洛·郎勃羅梭"
				},
				{
					"id": 741810120,
					"content": "#對了，倒是另有件事，的確想麻煩兩位，如果{F#妳}{M#你}們遇見曲線和托蘿莎探員，請幫我轉告他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810121
					],
					"speakerTitle": "梅洛·郎勃羅梭"
				},
				{
					"id": 741810121,
					"content": "#我已經整理了好幾間房間，隨時歡迎他們過來小住。當然，郎勃羅梭家也歡迎{F#妳}{M#你}們兩位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810122
					],
					"speakerTitle": "梅洛·郎勃羅梭"
				},
				{
					"id": 741810122,
					"content": "#{NICKNAME}，可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810123,
					"content": "好的夫人，我們知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741810124
					]
				},
				{
					"id": 741810124,
					"content": "嗯…好吧，那我們就不打擾夫人啦！希望羅謝大叔能早點出來面對自己！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741810125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741810125,
					"content": "#謝謝，也祝{F#妳}{M#你}們今後無論遇到什麼問題，都能順利找到答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅洛·郎勃羅梭"
				}
			]
		},
