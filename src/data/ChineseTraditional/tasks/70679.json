			"trigger": {
				"objectNames": [
					"吉蓋克斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 706790101,
					"content": "您好，您好！哎呀，真巧，我們又見面了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790102,
						706790104
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790102,
					"content": "抱歉，你是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790103
					]
				},
				{
					"id": 706790103,
					"content": "我是吉蓋克斯！風行迷蹤，您想起來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790106,
					"content": "原來是你呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 706790107,
					"content": "完全想起來了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790108
					]
				},
				{
					"id": 706790108,
					"content": "您這副表情，完全是沒有想起來嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790109
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790109,
					"content": "無論如何，請您看這邊。這一副「風行迷蹤」您一定記得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790110
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790110,
					"content": "您上次幫我試玩了之後，不是也提了很多意見給我嗎？那都是好主意，我基本上都採納了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790111
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790111,
					"content": "我把遊戲規則和玩法又一次…呃，正確來說是改進好幾次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790112,
						706790113
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790112,
					"content": "不會很難理解嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790114,
					"content": "您放心，這些新玩法您一定會喜歡的，容我為您簡單解釋一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790115
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790115,
					"content": "首先，在這副全新的「風行迷蹤」裡，我首次加入了名為「發信機」的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790116
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790116,
					"content": "遊俠只要成功啟動四個「發信機」，就可以擊敗獵手取得勝利！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790117
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790117,
					"content": "而獵手要做的事嘛…還是不變，只要把所有遊俠抓住，就算他們贏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790118
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790118,
					"content": "但在這次的「風行迷蹤」裡，遊俠被獵手抓住後不會直接出局，而是會被投進一個叫做「監控地」的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790119
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790119,
					"content": "只要過一段時間或有其他遊俠幫忙，被抓住的人就可以從「監控地」逃脫，繼續和獵手周旋了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790120
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790120,
					"content": "不過，如果被抓過的人再次被抓住…那就不得不被判出局了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790121,
						706790122
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790121,
					"content": "聽起來有點複雜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790123,
					"content": "放心，也只是聽起來複雜，只要多玩幾局，您就會完全明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790124,
						706790126
					],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790124,
					"content": "那我來試試看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790125
					]
				},
				{
					"id": 706790125,
					"content": "好！您來這邊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790126,
					"content": "還有別的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790127
					]
				},
				{
					"id": 706790127,
					"content": "沒關係，您有空的時候再來也可以，我還會在這裡待一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "吉蓋克斯"
				},
				{
					"id": 706790122,
					"content": "這麼多新規則啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790123
					]
				},
				{
					"id": 706790113,
					"content": "你沒有加入奇怪的玩法吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790114
					]
				},
				{
					"id": 706790104,
					"content": "你是…風行迷蹤！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						706790105
					]
				},
				{
					"id": 706790105,
					"content": "我是吉蓋克斯！好吧，您說的也沒錯，我倒也情願風行迷蹤比我更出名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706790106
					],
					"speakerTitle": "吉蓋克斯"
				}
			]
		}
	]
}