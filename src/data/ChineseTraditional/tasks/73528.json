			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拜希麥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735280101,
					"content": "路過的客人，生論派的學者拜希麥懇求您，別急著離開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280102
					],
					"speakerTitle": "拜希麥"
				},
				{
					"id": 735280102,
					"content": "請放鬆身體，放空思緒，聽我說一件重要的事——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280103
					],
					"speakerTitle": "拜希麥"
				},
				{
					"id": 735280103,
					"content": "團雀最可愛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280104
					],
					"speakerTitle": "拜希麥"
				},
				{
					"id": 735280104,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280105,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280106
					]
				},
				{
					"id": 735280106,
					"content": "團雀確實很可愛，但拜希麥小姐是學者吧？一句話沒有限制範疇，不是會引發很激烈的爭論嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280107,
					"content": "我的印象裡，學者的發言都很謹慎的，如果我是學者，那我也不敢隨便說…唔…「金絲蝦球最好吃！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280108,
					"content": "只能加一些限定詞，例如：「最近，在璃月料理中，我最想吃這道菜」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280109,
						735280110,
						735280111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280109,
					"content": "那我就敢說！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280112,
					"content": "#欸！{NICKNAME}，為什麼這麼突然啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280113,
					"content": "就算不是開玩笑，也不要那麼大聲嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280114,
					"content": "哈哈哈！就是這種狀態！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280115
					],
					"speakerTitle": "拜希麥"
				},
				{
					"id": 735280115,
					"content": "正因為我是學者，我才不想把生活的每時每刻都變成辯論場，覺得自己一句話都不能說錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280116
					],
					"speakerTitle": "拜希麥"
				},
				{
					"id": 735280116,
					"content": "反正不會有人時時刻刻盯著我，說錯話又不會少塊肉，沒必要一直心驚膽戰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280117
					],
					"speakerTitle": "拜希麥"
				},
				{
					"id": 735280117,
					"content": "但最重要的想法，一定要用力喊出來，大膽地直抒胸臆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280118
					],
					"speakerTitle": "拜希麥"
				},
				{
					"id": 735280118,
					"content": "#如果{F#妳}{M#你}們來玩過我這款桌遊「哐哐噹噹雀雀球」，也會像我這樣大聲告訴別人，團雀最可愛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280119
					],
					"speakerTitle": "拜希麥"
				},
				{
					"id": 735280119,
					"content": "哐哐…噹噹…雀雀球？就是妳背後這張桌子上的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280120,
					"content": "#沒錯哦，玩過這個遊戲以後，{F#妳}{M#你}們就能深刻領會到團雀的可愛之處啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280121
					],
					"speakerTitle": "拜希麥"
				},
				{
					"id": 735280121,
					"content": "而且，作為「琉形蜃境」的正式遊樂設施之一，如果在遊戲裡得到高分，還可以獲得一些獎勵哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280122
					],
					"speakerTitle": "拜希麥"
				},
				{
					"id": 735280122,
					"content": "說得這麼誇張，我也有點好奇了，而且表現不錯，還能拿到獎品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280123,
					"content": "#{F#妳}{M#你}覺得呢，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735280124,
						735280125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735280124,
					"content": "那我們就試試看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280126,
					"content": "#哈哈哈哈，好乾脆！那就請{F#妳}{M#你}們盡情體驗吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拜希麥"
				},
				{
					"id": 735280125,
					"content": "團雀究竟多可愛！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280126
					]
				},
				{
					"id": 735280110,
					"content": "派蒙最可愛！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				},
				{
					"id": 735280111,
					"content": "什麼都不管！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735280112
					]
				}
			]
		}
	]
}