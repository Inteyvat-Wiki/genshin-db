					}
				]
			},
			"dialogs": [
				{
					"id": 745020101,
					"content": "卡隆，生意不錯啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020102
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020102,
					"content": "大、大哥？！你怎麼來了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020103
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020103,
					"content": "這麼久沒見，結果第一句話就問這個嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020104
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020104,
					"content": "我、我只是沒想到大哥會來見我，畢竟店就開在不遠的地方，卻一次都沒有來過。我以為你還在生氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020105
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020105,
					"content": "我不是來和你說以前的事的，今天我就開門見山了。我問你，你那個冒險家玩具，是因為我才做的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020106
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020106,
					"content": "啊？唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020107
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020107,
					"content": "我就知道什麼都瞞不過大哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020108
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020108,
					"content": "等、等一下，我有點搞不懂了，那個玩具不是因為班尼特而製作的嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020109,
					"content": "原來兩位客人也來了啊…說來慚愧，之前沒有說清楚，是因為總覺得有點難以啟齒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020110
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020110,
					"content": "雖然那位冒險家朋友給了我最重要的靈感，但讓我堅定要做出這個玩具的人，其實是大哥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020111,
						745020170
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020111,
					"content": "瞭解，確實滿難開口的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020112
					]
				},
				{
					"id": 745020112,
					"content": "卡隆，你這扭扭捏捏的樣子真是一點都沒變。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020113
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020113,
					"content": "大哥也沒變啊。我越來越覺得大哥和那位冒險家是同樣的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020114
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020114,
					"content": "我才沒有神之眼，也不是冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020115
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020115,
					"content": "但你們擁有同樣的冒險精神，區別只是班尼特在冒險裡生活，大哥是在生活中冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020116
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020116,
					"content": "說好聽的話的本事是跟我學的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020117
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020117,
					"content": "怎麼可能，大哥說話就沒好聽過，總是說我缺乏拼搏的精神，雖然很煩人，但其實也沒什麼錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020118
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020118,
					"content": "到今天為止，大哥都在為了成為最好的玩具商而打拼，我卻早就聽從家裡的安排，過上了一格一格循環的鐘錶生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020119
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020119,
					"content": "只有大哥和班尼特這樣的人才敢把熱愛的東西當做事業吧？是我的話我絕對做不到，大哥的勇氣足夠一百個我用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020120
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020120,
					"content": "卡隆老闆，你也不用把自己說成這樣嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020121,
					"content": "#有件事不怕{F#妳}{M#你}們笑話，最初大哥打算把他的店開在我隔壁，我得知消息後的第一個念頭居然是搬店，真是愧對父親。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020122
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020122,
					"content": "還好最後是北國銀行拿下了那個店址，把我和大哥隔開，我才鬆了一口氣，真是救命得剛好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020123
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020123,
					"content": "哦哦我知道這個，阿爾邦他們說過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020124,
					"content": "哼，你也不想想，世上真有那麼多的剛好？北國銀行偏偏這麼巧，不早不晚剛好插在我們中間？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020125
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020125,
					"content": "利弗老闆的意思是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020126
					]
				},
				{
					"id": 745020126,
					"content": "那個店址我早預定在手了，只是後來有了新的想法，才低價轉讓給了北國銀行，他們才不是天上掉下來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020127
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020127,
					"content": "嗚哇，原來北國銀行是利弗老闆找來的！沒想到會是這樣…看來利弗老闆也覺得自己的想法太衝動了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020128,
					"content": "從離家到現在，我的目標都是「成為最好的玩具商」，如果變成了「和家裡嘔氣，把弟弟嚇到搬店」，那算什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020129
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020129,
					"content": "嘿嘿嘿，我聽出了一些關心的味道喔！那我猜，之前說要讓卡隆老闆道歉也是場面話吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020130,
					"content": "道、道歉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020131
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020131,
					"content": "什麼道歉？我有說過嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020132
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020132,
					"content": "怎麼會有人這麼理直氣壯地否認自己說過的話啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020133,
					"content": "哼，卡隆，其實我今天是來恭喜你的，你那個玩具…做得不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020134
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020134,
					"content": "上一次聽到大哥的稱讚已經是很久以前了，沒想到現在還能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020135
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020135,
					"content": "不光是這個，我還帶了賀禮給你，是這陣子我拜託這兩位冒險家收集的資料。有了這些，你能做出更有趣的東西吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020136
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020136,
					"content": "啊？但大哥不是在做「決鬥代理人」的玩具企劃嗎？這些數據很重要啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020137
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020137,
					"content": "不，那個企劃我決定暫停了。市場的變動比我想的還要快，我要及時調整方向了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020138
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020138,
					"content": "但…這些資料…這怎麼可以…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020139
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020139,
					"content": "給你你就拿著，廢話少說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020140
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020140,
					"content": "唉…那、那我就先幫大哥保管，如果有需要，可以隨時拿回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020141
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020141,
					"content": "原來利弗老闆說的另有打算，其實是送給弟弟呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020142,
					"content": "#兩位貴客，事先沒有徵求{F#妳}{M#你}們的意見，擅自做主，其實有點過意不去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020143
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020143,
					"content": "#沒關係啦，利弗老闆本來就付了報酬，怎麼用那是老闆的事。而且如果能讓你們關係變好，也很值得哦！對吧？{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020144,
						745020145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020144,
					"content": "派蒙的意思就是我的意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020146
					]
				},
				{
					"id": 745020146,
					"content": "嘿嘿，好像我們也當了一次成功的第三人呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020147,
					"content": "對了，卡隆老闆、利弗老闆，既然都到這裡了，我還有個想法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020148
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020148,
					"content": "不如你們就趁熱打鐵，以後一起合作怎麼樣？卡隆老闆擅長製作、利弗老闆擅長推廣，你們一起做事一定能成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020149
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020149,
					"content": "…多謝好意，但我覺得不必了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020150
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020150,
					"content": "嗯…我和大哥的想法一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020151
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020151,
					"content": "哎呀，你們就非得在這種時候意見一致嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020152,
					"content": "那位叫做班尼特的冒險家說過這樣的話吧？「世上就是有各式各樣的人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020153
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020153,
					"content": "大哥果然也記住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020154
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020154,
					"content": "「世上就是有各式各樣的人，所以就有獨屬於各種人的風景。」如果說我從他身上學到了什麼，那就是這個了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020155
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020155,
					"content": "我和卡隆就是不一樣的人，所以才走上了不同的路。也許他認為我的路太冒險，但他選擇的平淡生活，在我眼裡卻難以應付。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020156
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020156,
					"content": "沒錯，如果讓時針來做分針的工作，第二天就會被開除，還拿不到補償金。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020157
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020157,
					"content": "面對激烈的挑戰是冒險，甘於平淡的生活其實也是吧？在各自的路上大家都在冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020158
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020158,
					"content": "所以，既然已經選好了方向，就好好走下去，各自尋找各自的風景吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020159
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020159,
					"content": "嗯，我會偶爾去找大哥碰面的，畢竟你的路比較難走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020160
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020160,
					"content": "臭小子，少擔心我，至少我知道遇到難題找第三人幫忙，北國銀行和這兩位冒險家都不是我坐在店裡等來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020161
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020161,
					"content": "那要是遇到第三人都解決不了的難題怎麼辦？大哥知道吧，齒輪的硬度越高，韌度就越差，我擔心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020162
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020162,
					"content": "真的遇到了就遇到吧，還能怎麼辦？生活有時候就是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020163
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020163,
					"content": "不行，不管怎麼說，大哥絕不能被生活打倒，就像班尼特那樣。不然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020164
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020164,
					"content": "不然？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020165
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020165,
					"content": "不然我就一拳把大哥打飛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020166
					],
					"speakerTitle": "卡隆"
				},
				{
					"id": 745020166,
					"content": "臭小子，翅膀硬了是吧，當弟弟的人可以這樣跟大哥說話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020167
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020167,
					"content": "唔…既然審判桌都可以給芙寧娜大人坐坐，那哥哥的臺詞應該也可以給弟弟說說吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020168
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 745020168,
					"content": "#哈哈哈，兩位貴客，沒想到短短幾天{F#妳}{M#你}們就很瞭解楓丹人了啊。我剛好還有點事想要請教，方便的話等等來店門口見吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020169
					],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020169,
					"content": "卡隆，那今天就這樣，我要說的都說完了，先回去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "利弗"
				},
				{
					"id": 745020145,
					"content": "對，我們做生意也講究誠信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020146
					]
				},
				{
					"id": 745020170,
					"content": "不太懂這有什麼好難為情的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745020171
					]
				},
				{
					"id": 745020171,
					"content": "因為我這弟弟從小就是這麼扭扭捏捏的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745020113
					],
					"speakerTitle": "利弗"
				}
			]
		},
