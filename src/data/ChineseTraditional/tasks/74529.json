			"dialogs": [
				{
					"id": 745290401,
					"content": "#喲，{NICKNAME}，{F#妳}{M#你}來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290402,
						745290403
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290402,
					"content": "茜特菈莉，好久不見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				},
				{
					"id": 745290404,
					"content": "#看{F#妳}{M#你}說的，奶奶我偶爾也是會出門散散步的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290405
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290405,
					"content": "而且，昨晚我卜算運勢，預測今天如果出門，會遇到好事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290406
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290406,
					"content": "現在不就剛走出家門，好事就送上門來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290407,
						745290408
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290407,
					"content": "那就讓好事成雙吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290409,
					"content": "也不是不行啦…不過，我前兩天為了看完最新卷的輕小說，大大熬了個夜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290410
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290410,
					"content": "快幫我看看，我現在看起來怎麼樣？黑眼圈應該消下去了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290411,
						745290412
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290411,
					"content": "和平常一樣有精神。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290413,
					"content": "#真的嗎？{F#妳}{M#你}不許騙我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						745290414
					],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290414,
					"content": "#先說好，要是拍出來不好看，那畫片就歸我了哦…要留的話，只許留給{F#妳}{M#你}最好看的那張。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "茜特菈莉"
				},
				{
					"id": 745290412,
					"content": "簡直是容光煥發！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290413
					]
				},
				{
					"id": 745290408,
					"content": "請讓我為妳拍一張畫片！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290409
					]
				},
				{
					"id": 745290403,
					"content": "居然沒在家裡睡大覺，真難得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						745290404
					]
				}
			]
		}
	]
