				"points": []
			},
			"dialogs": [
				{
					"id": 755100101,
					"content": "要我說，雖然「面具鬥士」不能像「調停人」那樣自由地飛來飛去，但只要找準機會，埋頭衝刺，肯定能贏下對局！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100102
					],
					"speakerTitle": "「小松果」"
				},
				{
					"id": 755100102,
					"content": "呆子，不能太依賴直線行動的速度啊，轉不過彎沒撞到，不就沒有意義了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100103
					],
					"speakerTitle": "「燃爆木頭人」"
				},
				{
					"id": 755100103,
					"content": "好啦好啦，孩子們，可以認真討論，但不能動氣吵架喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100104
					],
					"speakerTitle": "維熱"
				},
				{
					"id": 755100104,
					"content": "沒有啦，沒有啦，我們只是…聊到強大的戰士，都非常興奮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100105
					],
					"speakerTitle": "「燃爆木頭人」"
				},
				{
					"id": 755100105,
					"content": "妳可以放心的，維熱姐姐！就算要比出個高低，我們也會講道理，擺證據！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100106
					],
					"speakerTitle": "「小松果」"
				},
				{
					"id": 755100106,
					"content": "還有個方法，再來一局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100107
					],
					"speakerTitle": "「燃爆木頭人」"
				},
				{
					"id": 755100107,
					"content": "那就再來一局！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100108,
						755100109
					],
					"speakerTitle": "「小松果」"
				},
				{
					"id": 755100108,
					"content": "真熱鬧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100110
					]
				},
				{
					"id": 755100110,
					"content": "#新的客人，{F#妳}{M#你}好啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100111
					],
					"speakerTitle": "維熱"
				},
				{
					"id": 755100111,
					"content": "#看{F#妳}{M#你}的裝束，應該是一位旅者吧？那我們是同行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100112
					],
					"speakerTitle": "維熱"
				},
				{
					"id": 755100112,
					"content": "要不要和孩子們一起，來試試我最近創作的這個「互動織卷」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100113,
						755100114
					],
					"speakerTitle": "維熱"
				},
				{
					"id": 755100113,
					"content": "「互動織卷」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100115
					]
				},
				{
					"id": 755100115,
					"content": "簡單來說，就是結合了璃月剪紙戲、稻妻漫畫和楓丹映影三種技術的幕布遊戲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100116
					],
					"speakerTitle": "維熱"
				},
				{
					"id": 755100116,
					"content": "以當地著名的戰士為原型，加入一些「跨界挑戰」的設想，組合成新奇的故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100117
					],
					"speakerTitle": "維熱"
				},
				{
					"id": 755100117,
					"content": "#說不定能為{F#妳}{M#你}帶來非常新奇的體驗喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755100118
					],
					"speakerTitle": "維熱"
				},
				{
					"id": 755100118,
					"content": "那我來試試看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755100119
					]
				},
				{
					"id": 755100119,
					"content": "#好呀好呀，祝{F#妳}{M#你}玩得開心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維熱"
				},
				{
					"id": 755100114,
					"content": "會動的畫卷？",
