			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"卡維",
					"艾爾海森"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130230101,
					"content": "「西拉傑」這個名字，我都沒印象了。你們那屆還有這種人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230102
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230102,
					"content": "不是什麼讓人印象深刻的人，不記得也很正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230103
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130230103,
					"content": "教令院就是喜歡對人施加壓力，還動不動對別人扣上天才奇才之類的帽子，這點我一直很難欣賞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230104
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230104,
					"content": "不過就算是這樣，教令院也不能交給你來領導。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230105
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230105,
					"content": "應該說，我很高興你還有最基本的自我認知。院裡那些人如果沒瘋，就該明白與其讓你當賢者還不如讓我來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230106
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230106,
					"content": "然後讓人知道你的賢者生涯就像那幅掛畫一樣搖搖欲墜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230107
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130230107,
					"content": "你這個馬上就要辭職的傢伙在說什麼啊？過幾天就又去管檔案了，人生跌回谷底啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230108
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230108,
					"content": "但院裡發給我的津貼應該不會減。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230109
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130230109,
					"content": "憑什麼？！憑什麼啊！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230110
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230110,
					"content": "也不用像做建築設計的人那樣，累死累活只為博取委託人一個微笑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230111
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130230111,
					"content": "你…你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230126
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230126,
					"content": "今天就不該好心幫你打掃客廳！我自己還有設計圖沒畫完呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230112
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230112,
					"content": "記得補繳你欠的房租，我打算拿那筆錢添置一些家具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230113
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130230113,
					"content": "什…你是想氣死我嗎？你買的那些擺飾一個比一個沒有美感，放塊乾巴巴的木雕在家裡有什麼好的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230114
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230114,
					"content": "誰叫我財富自由呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230115
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130230115,
					"content": "我說，總拿自己的優勢跟別人比也是一種逃避吧？去掉庸俗的金錢，在更有價值的地方比一比。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230116
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230116,
					"content": "很難想到有什麼是你占上風的。你自己能想到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230117
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130230117,
					"content": "藝術性不是嗎！都說了你根本不懂室內裝潢，不准亂買那些家具，除非帶我一起去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230118
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230118,
					"content": "帶你去還得請你喝酒是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230119
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130230119,
					"content": "當然啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230120
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230120,
					"content": "但我為什麼要這樣做？這只會構成另一種形式的借款而已，你過不了多久就得還我錢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230121
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130230121,
					"content": "你也可以當一個善良的好人，不向我討債，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230122
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230122,
					"content": "假裝自己沒有負債，就像假裝自己沒有住在別人家裡一樣可笑。其他人遲早會知道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230123
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130230123,
					"content": "#說到這個，今天來的傢伙應該不會說出去吧？記得叫{M#他}{F#她}們幫我保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230124
					],
					"speakerTitle": "卡維"
				},
				{
					"id": 130230124,
					"content": "我倒覺得你早就暴露了，沒必要費心掩飾。憑你那幾杯倒的酒量，去幾次酒館自然就把秘密全說出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130230125
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 130230125,
					"content": "不會吧？…不對，應該不會吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "卡維"
				}
			]
		}
	]
}