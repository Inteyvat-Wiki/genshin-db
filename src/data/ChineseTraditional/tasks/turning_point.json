				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"步雲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10210301,
					"content": "（按照刻晴教的，現在應該這樣說…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210302,
					"content": "您好，這裡賣月亮嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210303,
					"content": "是的，要幾個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210304
					],
					"speakerTitle": "步雲"
				},
				{
					"id": 10210304,
					"content": "數量不方便透露。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210305,
					"content": "答得好，二位請由此登閣。對了，二位就是凝光大人今天安排的客人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210306
					],
					"speakerTitle": "步雲"
				},
				{
					"id": 10210306,
					"content": "沒錯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10210307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10210307,
					"content": "（但這不是「客人」的暗號，而是「玉衡特許」的暗號。這又是怎麼回事呢…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "步雲"
				}
			]
		}
	]
}