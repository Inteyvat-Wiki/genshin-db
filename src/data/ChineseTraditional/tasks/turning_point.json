	"talks": [
		{
			"id": 102402,
			"completionStepIds": [
				102402
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102402",
							"2"
						],
						"stepId": 102402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10240201,
					"content": "呼…呼…趕路趕得好累…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240202,
					"content": "要不是出「黃金屋」的時候剛好看到「群玉閣」在天上飛，現在還根本不知道該往哪跑呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240203,
					"content": "我們趕上了嗎？「漩渦之魔神」還在海裡、還沒登陸璃月港吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240204,
					"content": "#{F#妳}{M#你}們…怎麼來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240205
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10240205,
					"content": "咦？…啊！是仙人們！為什麼你們會在「群玉閣」上？之前聽說你們在和七星吵架…已經吵完了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240206,
					"content": "諸位仙家的意思是，當此危難之時，仙人與七星也該暫時放下不和，共同對敵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240207
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10240207,
					"content": "哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240208
					],
					"speakerTitle": "削月築陽真君"
				},
				{
					"id": 10240208,
					"content": "原來是這樣。那麼，現在大家的防禦方案是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240209,
					"content": "嗚…那個「漩渦之魔神」，只是從這麼遠的距離稍微看一眼，就覺得呼吸都有點不順暢了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240210,
					"content": "千岩軍裡有些新兵，已經連站都站不穩了。遠古魔神的威壓，看來對普通人的身體非常有害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240211
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10240211,
					"content": "——但正因如此，更不能讓那怪物接近璃月港的平民！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240212
					],
					"speakerTitle": "刻晴"
				},
				{
					"id": 10240212,
					"content": "好可怕…兩千年前的魔神戰爭，就是在與這樣的敵人戰鬥嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240213,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240214
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10240214,
					"content": "所以，靠現在在場的七星、千岩軍，加上幾位仙人的戰力，能解決海裡的那個魔神嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240215,
					"content": "眾仙家已經討論過了，答案是…未必。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240216
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10240216,
					"content": "不會吧？！可…可是你們是守護璃月的仙人，和守護璃月的七星啊！不能想想辦法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240217,
					"content": "那倒是可以的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240218
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10240218,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10240219,
					"content": "此前「歸終機」一事，讓七星動了心思、前去探究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240220
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10240220,
					"content": "而今身為「歸終機」製造者的本仙，又恰好在此…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240221
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10240221,
					"content": "仙家機關，你們凡人能研究出什麼？但只要本仙對這老舊弩炮稍加改進，那就是你們難以想像的進化了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240222
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 10240222,
					"content": "呵呵…也算是一種「仙緣」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240223
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10240223,
					"content": "如此一來，我們就能用「新歸終機」對抗魔神。在場的諸位仙家，也都能夠為它注入仙力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10240224
					],
					"speakerTitle": "凝光"
				},
				{
					"id": 10240224,
					"content": "事不宜遲，決戰就在此時——開！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凝光"
				}
			]
		},
		{
			"id": 102408,
			"completionStepIds": [
				102408
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
