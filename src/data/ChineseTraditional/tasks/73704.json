			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭吉特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 737040101,
					"content": "今天也是充滿全新希望的一天！兩位，我們這就出發？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040102
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040102,
					"content": "全新希望…這麼說來，和古岩龍蜥的交流算是失敗了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737040103,
					"content": "怎麼能說是失敗呢？搏鬥也算是一種交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040104
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040104,
					"content": "從這個角度來說，我們算是做了坦率而深入的交流，並且在此過程中充分瞭解了彼此的立場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040105
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040105,
					"content": "那句話是什麼…「不打不相識」嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040106,
						737040108
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040106,
					"content": "早就料到會這樣了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040107
					]
				},
				{
					"id": 737040107,
					"content": "但我還是要說，凡事總是要試試看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040110
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040110,
					"content": "所以你還不打算放棄嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737040111,
					"content": "實不相瞞，我小時候的夢想之一就是騎著翠翎恐蕈遊遍須彌…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040112
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040112,
					"content": "但是那時大人們只會跟我說不要傻了，去問巡林官，他們也是面露難色，叫我不要冒險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040113
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040113,
					"content": "於是我就放棄了不切實際的夢想，和其他孩子一樣普通地長大了，唯一的小小冒險也只是在食材的選擇上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040114
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040114,
					"content": "偶爾想起自己兒時原來還有過這種夢想，就有種遙遠又陌生的感覺——就像傳說中的蘭那羅一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040115
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040115,
					"content": "如果他們真的存在，我也曾經見過他們，那我是從何時起不再能看到他們，也不再記得他們的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040116
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040116,
					"content": "在納塔的時候我聽說了一個故事，裡面在講一個叫昆圖爾的倒楣傢伙，他因為父親犯的過錯甚至被太陽厭棄了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040117
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040117,
					"content": "「不受太陽喜愛的昆圖爾」在部族裡也不受待見，當然也沒有龍願意當他的夥伴。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040118
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040118,
					"content": "但他沒有氣餒、沒有埋怨父親，也沒有埋怨命運，而是用努力證明了自己不輸一族裡最強悍的戰士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040119
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040119,
					"content": "最後，他憑藉勇氣和智慧做了一件了不起的事，不僅獲得了暝視龍夥伴的認可，也成了一族的英雄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040120
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040120,
					"content": "聽完他的故事之後，我也有勇氣重拾兒時的夢想了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040121
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040121,
					"content": "還有這樣的原因啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737040122,
					"content": "所以跟翠翎恐蕈正面「交涉」的事就拜託兩位了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040123
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040123,
					"content": "結果還是要交給我們啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 737040124,
					"content": "以我現在的實力，實在不是翠翎恐蕈的對手…但我會做好輔助工作的，有需要隨時叫我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040125
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040125,
					"content": "話不多說，我們現在就走吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040126,
						737040127
					],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040126,
					"content": "走吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 737040127,
					"content": "還有別的事，稍候。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040128
					]
				},
				{
					"id": 737040128,
					"content": "#沒問題，我就在這裡等{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭吉特"
				},
				{
					"id": 737040108,
					"content": "在搏鬥的根本就是我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						737040109
					]
				},
				{
					"id": 737040109,
					"content": "不愧是正牌的冒險家，哪怕是我也看得出來，搏鬥的經驗相當豐富！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						737040110
					],
					"speakerTitle": "蘭吉特"
				}
			]
		}
	]
}