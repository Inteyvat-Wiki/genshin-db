			"dialogs": [
				{
					"id": 700740201,
					"content": "…說起「騎士擊碎的木屑」，果然就是這裡了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740202,
					"content": "啊！大團長！榮譽騎士！你們今天也是來訓練的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740203
					],
					"speakerTitle": "艾琳"
				},
				{
					"id": 700740203,
					"content": "為了追求「目標」而奮進…嗯，的確是一種訓練呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740204
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740204,
					"content": "明明都已經這麼強了，卻還在精益求精嗎…兩位請隨意訓練吧！我會在旁邊做筆記的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾琳"
				}
			]
		},
