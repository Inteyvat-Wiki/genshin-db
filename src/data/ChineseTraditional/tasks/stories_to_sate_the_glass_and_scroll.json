			"dialogs": [
				{
					"id": 700740901,
					"content": "難以置信…丘丘人居然這麼好說話了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740902
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700740902,
					"content": "艾拉！妳有看到法爾伽嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740903
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740903,
					"content": "嗯，他剛剛說是要去向丘丘人借鍋子用…然後丘丘人一見到他，就連忙把鍋子給讓出來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740904
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700740904,
					"content": "明明也沒有交流幾句，怎麼會這麼順利？難道大團長還掌握了我不知道的丘丘人肢體語言？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740905,
						700740906
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700740905,
					"content": "我覺得那不算交流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				},
				{
					"id": 700740907,
					"content": "重點不在這裡吧？喂！法爾伽他現在人呢？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740908,
					"content": "喏——就在那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740909
					],
					"speakerTitle": "艾拉·馬斯克"
				},
				{
					"id": 700740909,
					"content": "終於…完成了！全提瓦特最棒的美酒！此時此刻，就在我的手中！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740910
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740910,
					"content": "法爾伽——",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740911
					]
				},
				{
					"id": 700740911,
					"content": "#哦？{F#妳}{M#你}們總算來了啊？那些丘丘人意外地很通情達理嘛。調酒的進度比想像的要快一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740912
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740912,
					"content": "現在，就是品鑑之時！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740913
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740913,
					"content": "你先別喝——！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740914
					]
				},
				{
					"id": 700740914,
					"content": "#嗯？{F#妳}{M#你}們是想喝第一杯？哼哼…這第一杯的榮耀我是絕對不會讓出去的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740915
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740915,
					"content": "不是這個問題！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740916
					]
				},
				{
					"id": 700740916,
					"content": "#放心吧！我會為{F#妳}{M#你}們留一點的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740917
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740917,
					"content": "咕…咕…哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740918
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740918,
					"content": "嗯？怎麼感覺…有點…壞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740919
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740919,
					"content": "法爾伽！你還好嗎？法爾伽？法——爾——伽——！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740920,
						700740921
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740920,
					"content": "——團長！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740922,
					"content": "喂！都從魔神嘴裡頭凱旋了，倒在這種地方算什麼啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740923
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740923,
					"content": "唔…啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740924
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740924,
					"content": "感覺剛剛有一瞬間…好像看到了歷代北風騎士啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740925,
						700740926
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740925,
					"content": "該說你怎麼能倒在這裡好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740927,
					"content": "讓我再消化一下吧…不管是剛才那杯酒也好，還是這個慘痛的教訓也好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740928
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740928,
					"content": "向法爾伽說明了迪奧娜「百分百調出美酒」的祝福…\\n只有經過她的手，奇怪的材料才會變成美酒…",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						700740929
					]
				},
				{
					"id": 700740929,
					"content": "原來是這樣啊…缺的那份材料，其實是泉水精靈的祝福嗎…哈哈，還真是沒想到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740930
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740930,
					"content": "喂，不要一臉清爽得好像什麼事都沒了！你騙我們的帳都還沒算呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740931
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740931,
					"content": "#抱歉抱歉…我是真的以為這個酒方沒問題，還想說調完之後，一邊跟{F#妳}{M#你}們喝一邊解釋呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740932
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740932,
					"content": "#現在嘛…{F#妳}{M#你}們應該不會想喝了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740933,
						700740934
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740933,
					"content": "算了算了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740935,
					"content": "#嗯…那這次的酒就當是我欠{F#妳}{M#你}們吧。回頭去獵鹿人餐館再請{F#妳}{M#你}們一頓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740936
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740936,
					"content": "——請客？這還差不多！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740937
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740937,
					"content": "妳也太好收買了吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740938
					]
				},
				{
					"id": 700740938,
					"content": "#呃…{F#妳}{M#你}看他喝了那杯酒痛苦這麼久，也算是嚐到教訓了嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740939
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740939,
					"content": "唉，自作自受啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740940,
						700740941
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740940,
					"content": "不過你的空白課題…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740942,
					"content": "哈哈，本來還想拿來當下酒故事的，現在也只能配西北風講了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740943
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740943,
					"content": "…為蒙德的大家訂製一套「課題」？滿好的點子，能不能我也來一份？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740944
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740944,
					"content": "呵，你的課題——「改變水占盤裡倒映的命運」——在你決定開啟遠征的時候，就已經完成了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾莉絲"
				},
				{
					"id": 700740941,
					"content": "究竟是什麼情況？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740942
					]
				},
				{
					"id": 700740934,
					"content": "怕了怕了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740935
					]
				},
				{
					"id": 700740926,
					"content": "還是說你這樣都站得起來好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740927
					]
				},
				{
					"id": 700740921,
					"content": "你在幹什麼啊團長！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740922
					]
				},
				{
					"id": 700740906,
					"content": "起碼不是用語言…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740907
					]
				}
			]
		},
