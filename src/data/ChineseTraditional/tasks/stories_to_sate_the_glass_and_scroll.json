			},
			"dialogs": [
				{
					"id": 700740501,
					"content": "喂！你們把鴿子全都…嚇跑…了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740502
					],
					"speakerTitle": "提米"
				},
				{
					"id": 700740502,
					"content": "…大…大團長？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740503
					],
					"speakerTitle": "提米"
				},
				{
					"id": 700740503,
					"content": "哦？這不是小提米嗎？看起來個子長高了不少啊？有在好好吃飯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740504
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740504,
					"content": "有…有的！我一直記得您說的！想成為頂天立地的男子漢，就要好好吃飯！好好鍛煉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740505,
						700740506
					],
					"speakerTitle": "提米"
				},
				{
					"id": 700740505,
					"content": "這小子的態度…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				},
				{
					"id": 700740507,
					"content": "沒辦法…我猜這座城裡沒有哪個小孩子不崇拜西風騎士團的當代傳奇吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740508,
					"content": "抱歉啊，把你的鴿子全嚇跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740509
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740509,
					"content": "我剛好也想問一下，有什麼方法能接近鴿子卻不驚動牠們…還能讓牠們保持心情愉悅嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740510
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740510,
					"content": "呃…我平常，會靜靜地走到牠們身邊，再撒下飼料…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740511
					],
					"speakerTitle": "提米"
				},
				{
					"id": 700740511,
					"content": "——對了！就是這個！你身上還有多的飼料嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740512
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740512,
					"content": "飼料是有不少…不過…大團長…那個…你們是要…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740513
					],
					"speakerTitle": "提米"
				},
				{
					"id": 700740513,
					"content": "放心吧，我向你保證——只是跟牠們借點羽毛而已，這是大人之間的約定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740514
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740514,
					"content": "啊…好的！謝謝大團長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				},
				{
					"id": 700740506,
					"content": "跟以前完全不一樣！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740507
					]
				}
			]
		},
