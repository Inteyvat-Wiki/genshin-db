			},
			"dialogs": [
				{
					"id": 700740801,
					"content": "咕咕——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740802
					],
					"speakerTitle": "鴿子"
				},
				{
					"id": 700740802,
					"content": "羽毛！我拿到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740803
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740803,
					"content": "總算拿到了，這個課題的確比想像的要艱難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740804,
					"content": "只差一步了…「大鍋烹煮的藥湯」，沒記錯的話是在達達烏帕谷吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740805
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740805,
					"content": "#我這就過去，{F#妳}{M#你}們快點跟上來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740806
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740806,
					"content": "喂——這傢伙，興致也太高了吧？跑得比飛得還快？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740807,
						700740808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740807,
					"content": "不愧是像風一樣自由的人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				},
				{
					"id": 700740809,
					"content": "…那個酒鬼大叔…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740810
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740810,
					"content": "嗯？誰在那裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740811
					]
				},
				{
					"id": 700740811,
					"content": "…呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740812
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740812,
					"content": "迪奧娜？妳怎麼在這裡？還特地藏起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740813,
					"content": "我…我就只是出門採點果子，沒想到突然就碰到那個大叔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740814
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740814,
					"content": "他最近老是纏著我不放，想要我再幫他調一次上次的酒…我被煩到不行，就只好到處躲著他了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740815
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740815,
					"content": "上次的酒…是什麼情況？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740816
					]
				},
				{
					"id": 700740816,
					"content": "他前陣子不是和一些遠征軍一起回來了嗎？就到貓尾酒館裡喝慶功酒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740817
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740817,
					"content": "貓尾酒館？我還以為會在騎士團裡開…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740818
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740818,
					"content": "我還以為會去「天使的饋贈」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740819
					]
				},
				{
					"id": 700740819,
					"content": "呃…他們全都去了。貓尾酒館已經是第三輪了——城裡所有酒館他們都打算喝一輪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740820
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740820,
					"content": "…我強烈懷疑等下一波遠征軍回來，他們還會用這個藉口再喝一輪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740821
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740821,
					"content": "我毫不懷疑。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740822
					]
				},
				{
					"id": 700740822,
					"content": "…總之！那幫酒鬼大叔的樣子，我實在是看不下去了！就想調一杯最難喝、最反胃的飲料讓他們醒一醒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740823,
						700740824
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740823,
					"content": "但妳的體質不是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740825,
					"content": "對啊，所以我一開始是找小王子去幫我調的…誰知道那群傢伙一喝醉就想逗小王子玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740826
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740826,
					"content": "…所以小王子沒調到最後就跑了——哦，順便還抓了那個酒鬼大叔一爪子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740827
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740827,
					"content": "（法爾伽說的那道疤…該不會就是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740828
					]
				},
				{
					"id": 700740828,
					"content": "我為它深入了一片混沌的秘{RUBY#[D]酒館}境，跟最凶最狠的魔{RUBY#[D]小王子}物搏鬥…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740829
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 700740829,
					"content": "…我看著差不多調完的飲料，想著就只差那麼一點了，是不是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740830
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740830,
					"content": "結果還是親手完成最後一步了嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740831
					]
				},
				{
					"id": 700740831,
					"content": "是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740832,
						700740833
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740832,
					"content": "我再好奇一問…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740834,
					"content": "呃，有騎士們身上沾的木屑、從林子裡撿的鴿子羽毛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740835
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740835,
					"content": "還有最後一種——原本打算拿來醒酒的…丘丘人的草藥湯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740836
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 700740836,
					"content": "#{NICKNAME}…{F#妳}{M#你}覺得法爾伽他剛回來沒多久…會不會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700740837,
						700740838
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740837,
					"content": "還沒有人告訴過他這些材料…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740839,
					"content": "這傢伙…要出大事了！快去阻止他！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 700740838,
					"content": "只有迪奧娜自己可以這樣調！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740839
					]
				},
				{
					"id": 700740833,
					"content": "妳在裡面加了什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740834
					]
				},
				{
					"id": 700740824,
					"content": "調什麼都會變成美味？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740825
					]
				},
				{
					"id": 700740808,
					"content": "想喝酒的心情都溢出來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700740809
					]
				}
			]
		},
