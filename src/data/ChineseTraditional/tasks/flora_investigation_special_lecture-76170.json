			},
			"dialogs": [
				{
					"id": 761700101,
					"content": "沒想到不光是月螢蟲，就連小貓也會被吃掉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700102
					],
					"speakerTitle": "米科"
				},
				{
					"id": 761700102,
					"content": "嗚…尤爾瓦哥哥，下次帶巴甫洛夫散步的時候，千萬要保護好牠啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700174
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 761700174,
					"content": "別擔心啦，巴甫洛夫要比普通的小貓大多了，而且不過是植物而已嘛，不會有事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700103
					],
					"speakerTitle": "尤爾瓦"
				},
				{
					"id": 761700103,
					"content": "我記得哪個剛入行的新人冒險家在遇到十六倍曼陀草之前也說過類似的話呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700104
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700104,
					"content": "欸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700105
					],
					"speakerTitle": "尤爾瓦"
				},
				{
					"id": 761700105,
					"content": "十六倍曼陀草…好酷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700106
					],
					"speakerTitle": "米科"
				},
				{
					"id": 761700106,
					"content": "呀吼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700107
					],
					"speakerTitle": "露米"
				},
				{
					"id": 761700107,
					"content": "遠遠就看到這邊熱鬧的樣子啦！你們在說什麼有趣的…欸？是在上課嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700108,
					"content": "嗯，莉奈婭姐姐在跟我們講她最近的調查發現呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700109
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 761700109,
					"content": "聽起來很好玩，我們也可以參加嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700110
					]
				},
				{
					"id": 761700110,
					"content": "當然可以，請坐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700111
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700111,
					"content": "既然說到了十六倍曼陀草，在虛海望，還有一種特色植物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700112
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700112,
					"content": "是冬凌草吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700113
					],
					"speakerTitle": "尤爾瓦"
				},
				{
					"id": 761700113,
					"content": "嗯嗯！沒錯，就是冬凌草。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700114
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700114,
					"content": "欸——尤爾瓦哥哥作弊！莉奈婭還沒問呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700115
					],
					"speakerTitle": "米科"
				},
				{
					"id": 761700115,
					"content": "啊，抱歉抱歉，一不留神就搶答了。你別著急，後面還有回答的機會，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700116
					],
					"speakerTitle": "尤爾瓦"
				},
				{
					"id": 761700116,
					"content": "我準備了好多問題呢！只要積極回答，就有機會拿到糖雕的獎勵哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700117
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700117,
					"content": "#原來還有獎勵！{NICKNAME}，那我們也要加油啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700118,
						761700119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700118,
					"content": "就算對手是小孩我也不會手下留情。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700122
					]
				},
				{
					"id": 761700122,
					"content": "說回正題——關於冬凌草，其實有一個很有趣的故事呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700123
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700123,
					"content": "傳說，冬凌草與「冬凌王」有關，而這位「冬凌王」有一位兄弟，他的象徵植物是你們都很熟悉的…是什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700124,
						761700127,
						761700130
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700124,
					"content": "…甜甜花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700125
					]
				},
				{
					"id": 761700125,
					"content": "要說熟悉的確是很熟悉！不過應該不是正確答案吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700126,
					"content": "答錯了！正確答案是：夏槲果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700132
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700132,
					"content": "夏槲果！我只知道卡嘉和愛諾做的夏槲蛋糕都很好吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700133
					],
					"speakerTitle": "米科"
				},
				{
					"id": 761700133,
					"content": "夏槲果正是「冬凌王」的兄弟「夏槲王」的象徵，傳說這對孿生兄弟自出生起就爭鬥不休…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700134
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700134,
					"content": "他們交替殺死對方，又交替復活，統治屬於他們各自的季節，就這麼循環往復，直到世界的終結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700135
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700135,
					"content": "好可憐…明明是有血緣的親兄弟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700136
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 761700136,
					"content": "這個我知道，卡嘉說過，關係好不好和有沒有血緣沒關係，而且有時候就是因為有血緣關係才會有爭鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700137
					],
					"speakerTitle": "米科"
				},
				{
					"id": 761700137,
					"content": "這個故事其實講的是季節更替吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700138
					]
				},
				{
					"id": 761700138,
					"content": "#{F#妳}{M#你}很敏銳呢！沒錯，至冬的學者們也是這麼認為的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700139
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700139,
					"content": "不過，因為冬凌草耐寒的特性，在這個故事之外，也常被認為是執燈人的象徵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700140
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700140,
					"content": "「縱然花朵敗落…」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700141
					]
				},
				{
					"id": 761700141,
					"content": "「葉片也會信守承諾」！之前聽說過呢，關於冬凌草的諺語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700142
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700142,
					"content": "#這是一句很古老的諺語呢，現在很少有人提起了，沒想到{F#妳}{M#你}們連這個都知道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700143
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700143,
					"content": "嘿嘿，我們可是資深冒險家，就是所謂的…「見多識廣」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700144,
					"content": "執燈人，就是那些穿著黑色衣服的人吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700145
					],
					"speakerTitle": "米科"
				},
				{
					"id": 761700145,
					"content": "他們也耐寒？可是他們的衣服看起來都好暖和，難道不是穿得越少才越能證明自己耐寒嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700146
					],
					"speakerTitle": "米科"
				},
				{
					"id": 761700146,
					"content": "不對不對，莉奈婭姐姐的意思應該是執燈人就像冬凌草，面對寒風一樣的困難也不屈服。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700147
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 761700147,
					"content": "哦！的確是這樣，不過玫熙是怎麼想到這一點的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700148
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700148,
					"content": "嘿嘿，因為之前收到赫卡從楓丹寄回來的畫冊，上面說楓丹的花都有花語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700149
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 761700149,
					"content": "我想，如果冬凌草也有花語的話，「不屈」和「堅持到底的勇氣」就很適合呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700150
					],
					"speakerTitle": "玫熙"
				},
				{
					"id": 761700150,
					"content": "玫熙已經學會舉一反三了，真了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700151
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700151,
					"content": "米科的想法雖然和一般的見解不太一樣，不過也很有趣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700152
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700152,
					"content": "老師老師，那我和派蒙呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700153
					]
				},
				{
					"id": 761700153,
					"content": "唔，如果兩位能答出接下來的難題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700154
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700154,
					"content": "#不管是什麼難題妳儘管問好了，肯定難不倒{NICKNAME}的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700155,
					"content": "這麼有自信啊？那我就要拿出壓箱底的問題了哦——宿影花的花朵為什麼是一紅一藍呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700156,
						761700158
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700156,
					"content": "因為「玫瑰殷紅，堇花湛藍」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700157
					]
				},
				{
					"id": 761700157,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700160
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700160,
					"content": "唔…到底為什麼呢？不光是宿影花，我們在挪德卡萊也見過其他紅色和藍色的東西吧？欸，這麼一想，好像還滿多的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700161,
					"content": "要說挪德卡萊和其他地方有什麼不同的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700162
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700162,
					"content": "原來是神奇的月矩力啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700163
					]
				},
				{
					"id": 761700163,
					"content": "#我說{F#妳}{M#你}啊，別什麼都想著用月矩力來解釋啦。既然是壓箱底的難題，肯定有更複雜的原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700164
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700164,
					"content": "答對了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700165
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700165,
					"content": "呀吼吼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700166
					],
					"speakerTitle": "露米"
				},
				{
					"id": 761700166,
					"content": "原來還真的是啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700167
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700167,
					"content": "對生活在挪德卡萊的人來說是常識，但對遠道而來的冒險家而言卻並非如此，所以也可以稱得上是難題？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700168
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700168,
					"content": "#不過{NICKNAME}完全沒有被問題的表象矇蔽呢，真的太適合當冒險家了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700169
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700169,
					"content": "好啦，今天就差不多到這裡吧。剛才回答過問題的同學都有糖雕哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700170
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700170,
					"content": "欸？等一下，該不會只有我沒有糖雕吧？！早知道哪怕答錯也應該多試試…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700171
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700171,
					"content": "#沒關係沒關係，派蒙也有份！妳和{NICKNAME}是一隊嘛，就像我和露米一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700172
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700172,
					"content": "真是太好了，派蒙同學。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700173
					]
				},
				{
					"id": 761700173,
					"content": "哇，莉奈婭老師最好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700158,
					"content": "難道是人工培育的品種？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700159
					]
				},
				{
					"id": 761700159,
					"content": "是個好著眼點！不過真可惜，不是正確答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700160
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700127,
					"content": "一定是薄荷吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700128
					]
				},
				{
					"id": 761700128,
					"content": "畢竟薄荷跟冬凌草一樣都是綠色的…那高麗菜也可以是冬凌草的親戚啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761700129,
					"content": "答錯了！正確答案是：夏槲果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700132
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700130,
					"content": "難道是夏槲果。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700131
					]
				},
				{
					"id": 761700131,
					"content": "答對了！就是夏槲果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700132
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700119,
					"content": "和小孩搶糖吃啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761700120
					]
				},
				{
					"id": 761700120,
					"content": "#沒關係的，偷偷告訴{F#妳}{M#你}們，卡嘉為每個人都準備了糖雕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700121
					],
					"speakerTitle": "莉奈婭"
				},
				{
					"id": 761700121,
					"content": "哦！既然是這樣，那我們要拿出真本領了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761700122
					],
					"speakerTitle": "派蒙"
				}
			]
		},
