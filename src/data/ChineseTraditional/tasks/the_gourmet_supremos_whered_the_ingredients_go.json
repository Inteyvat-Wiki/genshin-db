			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"朱莉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220260301,
					"content": "#好了，這些就夠了，謝謝{F#妳}{M#你}。要是沒有{F#妳}{M#你}幫忙，我就真的要一個人衝進去解決那些魔物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260302
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260302,
					"content": "要是這樣的話，我就不知道什麼時候才會想起蒐集「緋櫻繡球」這件事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260303
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260303,
					"content": "#對了，謝謝{F#妳}{M#你}幫忙，這些「野菇雞肉串」給{F#妳}{M#你}，這可是琳小姐教我的經典冒險家美食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220260304
					],
					"speakerTitle": "朱莉"
				},
				{
					"id": 220260304,
					"content": "我等會就把這些「緋櫻繡球」帶回去給旭東啦。不知道他會做什麼好吃的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "朱莉"
				}
			]
		}
	]
