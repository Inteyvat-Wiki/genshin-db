			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萊依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860101,
					"content": "#{NICKNAME}、派蒙，還有「咚咚小圓帽」，我們在這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860102
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400860102,
					"content": "萊依拉！這幾天和「轉轉悠悠獸」玩得還開心嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860103,
					"content": "當然了！有「轉轉悠悠獸」幫我拖行李，我們去了很遠的地方露營，見識到了不一樣的星空美景，還推進了論文！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860104
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400860104,
					"content": "不過，清單上提到的東西都快做完了，麵粉這樣的食材經常嗆得我不停咳嗽…我還是沒有找到「轉轉悠悠獸」的最愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860105
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400860105,
					"content": "如果改進後的「意智寶珠」能讓我們和蕈獸直接對話就好了…嗯！我把這件事也寫進信裡，託人問問生論派的資深學者吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860106
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400860106,
					"content": "萊依拉好像拿出了前所未有的幹勁！說了這麼多話還很有精神…為了夥伴居然能做到這種程度！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860107,
					"content": "呃啊，力氣消耗過度了，我們趕快去見八重小姐吧…不然我又撐不住了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萊依拉"
				}
			]
		},
		{
			"id": 4008602,
			"completionStepIds": [
				4008602
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4008602",
							"2"
						],
						"stepId": 4008602,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"八重神子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860201,
					"content": "嗯？來得還滿早啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860202
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860202,
					"content": "神子，妳這就要走了嗎？總感覺妳都沒好好在須彌玩玩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860203,
					"content": "#我早就盡興了喔。託{F#妳}{M#你}們的福，這次的取材很順利，不止得到了寶貴的參賽體驗，還有破壞陰謀的精彩戲碼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860204
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860204,
					"content": "#嗯，不如直接讓左右加放棄自己原創的人物，以{F#妳}{M#你}們為主角創作下一部小說好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860205,
						400860206
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860205,
					"content": "其實妳也在暗中行動。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860207
					]
				},
				{
					"id": 400860207,
					"content": "對喔！現在我終於明白了，原來妳之前給過我們好多次暗示！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860208,
					"content": "明明早點揭穿埃爾欣根就可以了，為什麼要繞這麼大一圈啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860209,
					"content": "#一開始就點破真相，豈不是太無聊了？我很想見識一下，{F#妳}{M#你}們會如何應對這種局面呢。結果{F#妳}{M#你}們給了我一個莫大的驚喜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860210
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860210,
					"content": "#我原以為，{F#妳}{M#你}們和蕈獸之間的故事，會是「主人」與「僕從」的展開，但{F#妳}{M#你}們有了在這之上的答案…平等默契的「夥伴」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860211
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860211,
					"content": "#從另一個角度考慮，總是念及「主人」的埃爾欣根，會栽在{F#妳}{M#你}們手裡，也是情理之中。當然，以他的手腕，也許還會不安寧一陣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860212
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860212,
					"content": "我又開始聽不懂了…下次還是把神子的話寫下來，拿回去好好研究吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860213,
					"content": "#閒聊到此為止，「百雷遮羅」就交給{F#妳}{M#你}們了。記得照顧好它喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860214
					],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860214,
					"content": "#{F#妳}{M#你}們和海妮耶都要加油啊，這樣有趣的大賽能否繼續舉辦下去，全都取決於{F#妳}{M#你}們今後的作為了，我還有點期待呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "八重神子"
				},
				{
					"id": 400860206,
					"content": "妳知道埃爾欣根有蹊蹺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860207
					]
				}
			]
		},
		{
			"id": 4008603,
			"completionStepIds": [
				4008603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
