			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"海妮耶",
					"萊依拉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400860301,
					"content": "#{F#妳}{M#你}們來了，時間正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860302
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860302,
					"content": "我收集了其他參賽選手的「意智寶珠」，選好了適合蕈獸夥伴生活的地點，絕不會對周圍的生態環境造成惡劣影響。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860303
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860303,
					"content": "向大家打招呼吧，「歡騰之火」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860304
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860304,
					"content": "「歡騰之火」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860305
					]
				},
				{
					"id": 400860305,
					"content": "這是「火一」的新名字。最初和它相遇時，我發現它如此乖巧，其實也有過歡騰的心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860306
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860306,
					"content": "要是早點破除那種固有的偏見，不再壓制自己的真情實意、不去憎恨蕈獸…或許這種心情會一直持續下去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860307
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860307,
					"content": "海妮耶總算徹底解開心結了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860308
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400860308,
					"content": "這樣才對嘛！雖然我也有點習慣「火一」這個名字了，可是這個新名字的意義無比重大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860309,
						400860310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860309,
					"content": "恭喜妳，海妮耶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860311
					]
				},
				{
					"id": 400860311,
					"content": "我決定以最嚴格的標準要求自己，務必照顧好這些性情溫和的蕈獸。請放心將夥伴們交給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860312
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860312,
					"content": "這樣一來，就到了分別的時候了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860313
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400860313,
					"content": "去吧，「轉轉悠悠獸」，要好好聽海妮耶的話喔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860314
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 400860314,
					"content": "「百雷遮羅」，等到下次舉辦「馴獸師大賽」，神子還會來看你的喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860315,
					"content": "「咚咚小圓帽」…我們再來擊掌吧！這段時間我很開心，你也要高高興興地生活，期待著和我們重逢的那天啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400860316,
					"content": "一定會再見的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860317
					]
				},
				{
					"id": 400860317,
					"content": "希望人和蕈獸和諧共處的那天能盡早到來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400860318
					],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860318,
					"content": "#我相信{F#妳}{M#你}們！等著{F#妳}{M#你}們的好消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海妮耶"
				},
				{
					"id": 400860310,
					"content": "也恭喜「歡騰之火」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400860311
					]
				}
			]
		}
	]
}