			"trigger": {
				"objectNames": [
					"安東尼",
					"安娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 200140101,
					"content": "安娜，妳再好好想想，這件事我認為要從長計議才好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140102
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200140102,
					"content": "哎呀，你就別擔心我了，我肯定沒問題的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140103,
						200140104
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140103,
					"content": "安娜，妳的身體還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				},
				{
					"id": 200140105,
					"content": "#旅行者！{F#妳}{M#你}來得正好，快幫我勸勸安娜吧，她要去做冒險家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140106
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200140106,
					"content": "我為什麼不能做冒險家？我現在身體很健康，賽琉斯叔叔也說我腦子很靈活，很適合做冒險家！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140107
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140107,
					"content": "妳病才好了多久？如果妳去做冒險家，又折騰出病來怎麼辦？而且，爸媽也不會同意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140108
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200140108,
					"content": "我和爸爸媽媽已經說過了，他們說，只要我能通過冒險家協會的考試，他們就同意我做冒險家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140109
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140109,
					"content": "啊…啊？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140110,
						200140111
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200140110,
					"content": "冷靜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140112,
					"content": "賽琉斯叔叔前幾天剛幫我制訂好了訓練計畫，我已經訓練了好幾天了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140113
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140113,
					"content": "不過，那些計畫上都是一些偵察啦，尋找應急食物啦，野外求生啦之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140114
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140114,
					"content": "但我聽說，冒險家也經常和野外的那些魔物搏鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140115
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140115,
					"content": "我很想學習這方面的事，但又找不到人教我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140116
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140116,
					"content": "而且，我哥哥他也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140117
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140117,
					"content": "當然不行！那些魔物都很危險，就算要去，妳也要找一個經驗豐富的冒險家和妳同行！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140118
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200140118,
					"content": "我之前不是找過傑克嗎？他都答應我啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140119
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140119,
					"content": "傑克那傢伙我又不是不認識…他在野外連自己都照顧不好，怎麼可能照顧得了妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140120
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200140120,
					"content": "那協會裡一時半會也找不到有經驗的冒險家，我也沒錢掛委託…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140121,
						200140122
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140121,
					"content": "不如我陪妳去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140123,
					"content": "#欸？{F#妳}{M#你}願意幫我嗎？太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140124
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140124,
					"content": "哥！這下你總可以放心了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140125
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140125,
					"content": "這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140126
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200140126,
					"content": "#呼…好吧，旅行者的實力我是知道的，有{F#她}{M#他}陪著，我可以稍微放心點了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140127
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200140127,
					"content": "不過！妳去野外的時候也要注意安全…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140128
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200140128,
					"content": "…就是這些，妳記住了沒有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140129
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 200140129,
					"content": "記住了，記住了…哥，你說得我頭都要暈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140130
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140130,
					"content": "旅行者，我們快點出發吧，那個營地的位置我已經找傑克打聽好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140122,
					"content": "我對戰鬥也算有些心得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140123
					]
				},
				{
					"id": 200140111,
					"content": "那妳訓練得怎麼樣了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140112
					]
				},
				{
					"id": 200140104,
					"content": "安東尼，你們在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140105
					]
				}
			]
		},
