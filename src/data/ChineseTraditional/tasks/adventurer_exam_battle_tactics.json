			"dialogs": [
				{
					"id": 200140201,
					"content": "#魔物全都被打倒啦，{F#妳}{M#你}可真厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140202
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140202,
					"content": "冒險手冊上面寫的果然沒錯，可以使用各種方式來打倒魔物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140203
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140203,
					"content": "#不過…說實話，離這些魔物這麼近，我還是有些害怕…幸好有{F#妳}{M#你}陪著我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140204
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140204,
					"content": "妳還得多多訓練。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200140205
					]
				},
				{
					"id": 200140205,
					"content": "嗯，我知道。要成為冒險家可不是一件容易的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140206
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140206,
					"content": "#謝謝{F#妳}{M#你}旅行者，我先回去城裡啦。出來這麼長時間，我哥哥又要著急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200140207
					],
					"speakerTitle": "安娜"
				},
				{
					"id": 200140207,
					"content": "今後的訓練，我得再努力一點才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安娜"
				}
			]
		},
