				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"明石"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830101,
					"content": "罷了罷了，一定是因為今天運勢不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830102
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830103
					]
				},
				{
					"id": 722830103,
					"content": "射擊訓練的成果一天差過一天，再這麼下去總有一天我這箭能插到自己膝蓋上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830104
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830104,
					"content": "你為什麼在這種地方練習射箭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830105
					]
				},
				{
					"id": 722830105,
					"content": "唉，還不是聽了地走官的建議，雖然我現在懷疑他們是不是有看人受苦的癖好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830106
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830106,
					"content": "#話說{F#妳}{M#你}懂陸鰻鰻養殖嗎？我感覺繼續練習射箭也沒什麼前途，不如想點別的出路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830107
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830107,
					"content": "陸鰻鰻養殖和射箭有什麼關係嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830108
					]
				},
				{
					"id": 722830108,
					"content": "#哎呀，抱歉了，看來{F#妳}{M#你}對陸鰻鰻養殖是一竅不通啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830109
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830109,
					"content": "想從事陸鰻鰻養殖首先得去捕撈魚苗，可是陸鰻鰻的魚苗實在太小啦，肉眼很難分辨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830110
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830110,
					"content": "我想弓箭手既然都能射中很遠的目標，那視力想必是很好的。於是去問相熟的地走官該怎麼鍛煉視力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830111
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830111,
					"content": "「明石啊，鍛煉這種事都是要循序漸進的，只有基礎打得牢靠，進階的時候才能得心應手。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830112
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830112,
					"content": "#「魚苗又小又會亂動，{F#妳}{M#你}當然得從靜止的靶子開始，太近的靶子嘛，沒什麼意義，要練就得動真格的。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830113
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830113,
					"content": "我就是聽了他的話，在這苦練射箭，可是到現在一次都沒成功過。真的有人能射中那麼遠的靶子嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830114
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830114,
					"content": "#對了，{F#妳}{M#你}要不要來試試？只要站到前面那個石板上就能看到目標了，全都射中就算成功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830115
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830115,
					"content": "好啊，看我的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830116
					]
				},
				{
					"id": 722830116,
					"content": "#那就讓我見識一下{F#妳}{M#你}的本領吧！成功了記得來找我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "明石"
				}
			]
		},
		{
			"id": 7228302,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228302",
							"2"
						],
						"stepId": 7228302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"明石"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830201,
					"content": "#{F#妳}{M#你}也沒能射中目標呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830202
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830202,
					"content": "#看來今天的運勢是真的不行。一定是有什麼不好的東西影響了{F#妳}{M#你}的發揮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830203,
					"content": "要不再多試幾次？反正靶子也不會像陸鰻鰻的魚苗那樣游走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830203
					],
					"speakerTitle": "明石"
				}
			]
		},
		{
			"id": 7228303,
			"completionStepIds": [
				7228303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7228303",
							"2"
						],
						"stepId": 7228303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"明石"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722830301,
					"content": "#哦！{F#妳}{M#你}成功了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830302
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830302,
					"content": "#唉，不過我看{F#妳}{M#你}射箭有模有樣的，想來是老手了。像我這樣半道出家的再練幾年也未必能有{F#妳}{M#你}的水準。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830303
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830303,
					"content": "而且因為天天在這鬼地方練習射箭，我都好久沒見過活蹦亂跳的陸鰻鰻了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830304
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830304,
					"content": "#話說{F#妳}{M#你}也喜歡陸鰻鰻嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830305,
						722830306
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830305,
					"content": "喜歡。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				},
				{
					"id": 722830307,
					"content": "#是這樣嗎。我就是因為太喜歡陸鰻鰻了，所以才想自己養殖試試。{F#妳}{M#你}不覺得牠們長得很可愛嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830308
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830308,
					"content": "當然，在餐盤裡的陸鰻鰻就更漂亮了。好看又好吃，真不錯啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830309
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830309,
					"content": "話說回來，因為喜歡陸鰻鰻而想要養殖陸鰻鰻，為了養殖陸鰻鰻而練習射箭，這不是捨本逐末了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830310
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830310,
					"content": "說到底，我還是喜歡自由自在的陸鰻鰻，養殖什麼的還是算了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722830311
					],
					"speakerTitle": "明石"
				},
				{
					"id": 722830311,
					"content": "#對了，謝謝{F#妳}{M#你}幫忙演示，這些就送給{F#妳}{M#你}了。祝{F#妳}{M#你}好運！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "明石"
				},
				{
					"id": 722830306,
					"content": "不太能接受。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722830307
					]
				}
			]
		}
	]
}