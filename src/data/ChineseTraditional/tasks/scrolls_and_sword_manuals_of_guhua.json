		{
			"id": 7110803,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7110802",
							"2"
						],
						"stepId": 7110802,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 711080301,
					"content": "「…修習刺明之法。木人不慎盡毀…無錢資…自思一良策，何不束草為人…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080302
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080302,
					"content": "「收攬稻草。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080303
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080303,
					"content": "「束草。甚疲。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080304
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080304,
					"content": "「…修習刺明之法。草人不慎盡毀…不妨先習劍。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080305,
						711080306
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080305,
					"content": "繼續閱讀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080307
					]
				},
				{
					"id": 711080307,
					"content": "「…無事。閒坐庭前觀雨，腹中稍飢…思悟前日所見，忽得啟感，若以劍…（模糊不清）自名『裁雨』，改日當試。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080308
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080308,
					"content": "「…修習裁雨之法，不慎跌墜，所幸傷不甚重…自思一良策，不妨鑿地浚池於樁下，既可使不復跌傷，又可養魚以為食…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080309
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080309,
					"content": "「…往見漁者，市數十魚…試烹之，甚肥美，眾魚莫可與比…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080310
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080310,
					"content": "（此後十餘頁均為魚肉的各種烹飪方法，記載無比詳細，有些甚至還搭配了插圖。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080311
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080311,
					"content": "「…修習裁雨之法，不慎跌墜。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080312
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080312,
					"content": "「…成。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080313,
						711080314
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080313,
					"content": "繼續閱讀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080315
					]
				},
				{
					"id": 711080315,
					"content": "「…使槍劍當如使（模糊不清，旁有第三代掌門批註：當如使指）…所止，即是妙理之相…然彼無…何以予之？何以告之？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080316
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080316,
					"content": "「…改修藏書閣。設…於內，待…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080317
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080317,
					"content": "「…以<color=#00E1FFFF>目</color>視之，使<color=#00E1FFFF>四方之卷</color>合於<color=#00E1FFFF>四方之閣</color>，便可…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080318
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080318,
					"content": "（此後數頁均被塗抹，無法閱讀。旁有第三代掌門批註：此為勸誡後世之人博覽四方書卷。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080319,
						711080320
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080319,
					"content": "繼續閱讀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						711080321
					]
				},
				{
					"id": 711080321,
					"content": "「…傷癒。白小三烹羊膾鯉來見。肥美無羶，遂問其術…傳以生剋之法…於此記之。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						711080322
					],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080322,
					"content": "（此後數頁詳細記錄了羊肉的各種烹飪方法。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "《古華手記》"
				},
				{
					"id": 711080320,
					"content": "不讀了，塗得亂七八糟的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080314,
					"content": "不讀了，完全沒寫練習過程…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 711080306,
					"content": "不讀了，什麼亂七八糟的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
