			"dialogs": [
				{
					"id": 100100101,
					"content": "嗯…嘟嘟可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100102
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100102,
					"content": "哎呀，可莉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100103,
					"content": "#榮譽騎士{M#哥哥}{F#姐姐}！小派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100104
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100104,
					"content": "#媽媽說，榮譽騎士{M#哥哥}{F#姐姐}和小派蒙，會和可莉一起幫助嘟嘟可，沒想到這麼快就來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100105
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100105,
					"content": "幫助嘟嘟可？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100106,
					"content": "咦…「課題」，是這個嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100107,
					"content": "可莉不知道…但是可莉是可莉，不是可提？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100108
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100108,
					"content": "啊，我沒有唸錯可莉的名字啦，可莉是可莉，課題是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100109,
						100100113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100109,
					"content": "課題是課題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100110
					]
				},
				{
					"id": 100100110,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100111
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100111,
					"content": "#唉…謝謝{F#妳}{M#你}沒什麼用的說明啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100112,
					"content": "嗯…課題就是，唔…好難直接解釋哦。總之，課題就是，可莉想要做的，要幫助嘟嘟可完成的事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100119,
					"content": "哦！謝謝小派蒙，可莉雖然不明白，但好像又有點明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100120
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100120,
					"content": "那麼我們這就出發吧，去幫助嘟嘟可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100121
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100121,
					"content": "等等，所以可莉啊，妳說要幫助嘟嘟可，具體是要做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100122,
					"content": "嗯，每一個嘟嘟可都要找到紅色的四葉草，這樣才能變成與眾不同的嘟嘟可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100123
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100123,
					"content": "然後，然後嘟嘟可要與很多人成為朋友，經歷「嘟嘟大魔王」的試煉，才能成為了不起的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100124
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100124,
					"content": "「嘟嘟大魔法師」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100125
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100125,
					"content": "…至少媽媽是這樣說的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100126
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100126,
					"content": "哇，「大魔王」管著「大魔法師」…聽起來還滿合理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100127,
					"content": "那麼我們具體要做什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100128,
					"content": "可莉不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100129
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100129,
					"content": "#但是媽媽說，榮譽騎士{M#哥哥}{F#姐姐}和小派蒙會告訴可莉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100130
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100130,
					"content": "對、對哦，可莉，看看這本書…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100131,
					"content": "啊，裡面夾著一張紙條。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100132
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100132,
					"content": "那就讓我們一起來看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100133,
					"content": "「…試煉的第一站，嘟嘟可來到了樹葉呢喃的森林。在那裡，要找到埋藏的秘密，在重重的障礙之下…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100134,
					"content": "聽起來像是什麼嘟嘟可故事的一部分呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100135,
					"content": "啊，可莉知道在哪裡了，一定是在可莉經常炸…經常與嘟嘟可玩耍的森林裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100136
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100136,
					"content": "#可莉、嘟嘟可、榮譽騎士{M#哥哥}{F#姐姐}、小派蒙，出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100137
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100137,
					"content": "好哦！出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100113,
					"content": "是要去做的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100114
					]
				},
				{
					"id": 100100114,
					"content": "對，就是要完成的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100115,
					"content": "哦，那…可莉用蹦蹦炸彈炸魚也是「課題」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100116
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100116,
					"content": "不，那應該不是吧…也不是所有的事都能被稱之為「課題」啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100117,
					"content": "可莉有點弄不明白了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100118
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100118,
					"content": "唔…總之就是艾莉絲說的，要讓可莉完成的事，就是「課題」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100119
					],
					"speakerTitle": "派蒙"
				}
			]
		},
