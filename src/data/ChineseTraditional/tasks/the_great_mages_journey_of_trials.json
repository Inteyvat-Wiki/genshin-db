					"nextDialogs": [
						100100604
					]
				},
				{
					"id": 100100604,
					"content": "嗯嗯，可莉就和嘟嘟可一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100605
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100605,
					"content": "咦？等等，周圍怎麼突然聚集了一堆怪物？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100606,
					"content": "看來並沒有那麼簡單呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100607
					]
				},
				{
					"id": 100100607,
					"content": "哼哼，肯定是看到嘟嘟可找到了通過試煉得到的寶藏，那些壞傢伙要來搶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100608
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100608,
					"content": "那我們就先把那些壞傢伙趕跑，再打開箱子吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				}
			]
