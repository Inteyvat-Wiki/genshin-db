					"nextDialogs": [
						100100602
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100602,
					"content": "看來最終的寶藏就藏在這個了不起的箱子裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100603
					],
					"speakerTitle": "派蒙"
