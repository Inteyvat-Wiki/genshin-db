			"dialogs": [
				{
					"id": 100100801,
					"content": "終於把那些傢伙趕跑了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100802,
					"content": "仔細一想，之前的紙條上寫的「事情不會如此簡單」…其實就是指會有魔物跑過來吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100803,
					"content": "嗯！嘟嘟可試煉大成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100804
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100804,
					"content": "嘿嘿，那現在試煉結束了，我們看看箱子裡的是什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100805
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100805,
					"content": "啊，這個是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100806
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100806,
					"content": "是一頂小小的帽子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100807,
					"content": "是給嘟嘟可的帽子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100808
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100808,
					"content": "在嘟嘟一族之中，只有更加特別、更加了不起的嘟嘟可，才能被「嘟嘟大魔王」承認！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100809
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100809,
					"content": "這些了不起的嘟嘟可肩負著幫助和保護別的嘟嘟可的職責，所以「嘟嘟大魔王」賜予他們特殊的帽子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100810
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100810,
					"content": "這樣，別的嘟嘟可就能認出他們，然後遇到沒辦法解決的困難，就找到他們尋求幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100811
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100811,
					"content": "哦，那嘟嘟可就會變成戴帽子的嘟嘟可啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100812
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100812,
					"content": "嗯！成為戴帽子的嘟嘟可就是「嘟嘟大魔法師」…就能用大魔法師的火花力量幫助更多的人了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100813
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100813,
					"content": "可莉——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100814
					],
					"speakerTitle": "琴"
				},
				{
					"id": 100100814,
					"content": "騎士團的人說，城外的森林裡又傳來了特別大的爆炸聲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100815
					],
					"speakerTitle": "琴"
				},
				{
					"id": 100100815,
					"content": "#榮譽騎士{M#哥哥}{F#姐姐}、小派蒙，現在是可莉需要幫助…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100816
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100816,
					"content": "啊，我可以作證，我們和可莉一起清除了聚集的丘丘人，還有史萊姆，而且我們是為了完成「課題」才來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100817
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100817,
					"content": "小派蒙說得一點也沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100818
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100818,
					"content": "那這裡的魚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100819
					],
					"speakerTitle": "琴"
				},
				{
					"id": 100100819,
					"content": "那是剛才對付湖上的壞傢伙的時候，可莉不小心炸到的…跟以前可不一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100820
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100820,
					"content": "也就是說，以前都是故意炸的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100821
					],
					"speakerTitle": "琴"
				},
				{
					"id": 100100821,
					"content": "可莉因為以前炸的魚無話可說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100822
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100822,
					"content": "唉…我來的路上已經看到了，被摧毀的魔物營地，以及剛才從星落湖邊跑走的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100823
					],
					"speakerTitle": "琴"
				},
				{
					"id": 100100823,
					"content": "#沒有造成其他的破壞吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100824,
						100100826
					],
					"speakerTitle": "琴"
				},
				{
					"id": 100100824,
					"content": "其他的破壞都是派蒙造成的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100825
					]
				},
				{
					"id": 100100825,
					"content": "…對對，都是我一口氣吹出來的，我了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100827
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100827,
					"content": "可莉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100828
					],
					"speakerTitle": "琴"
				},
				{
					"id": 100100828,
					"content": "走吧，我們回去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100829
					],
					"speakerTitle": "琴"
				},
				{
					"id": 100100829,
					"content": "嗚…又要進禁閉室了嘛？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100830
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100830,
					"content": "#這次因為有{NICKNAME}為妳作擔保，所以就罰妳…跟我去獵鹿人好好吃一頓吧！",
