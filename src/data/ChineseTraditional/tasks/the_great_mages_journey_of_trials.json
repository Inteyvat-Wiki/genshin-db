					}
				]
			},
			"dialogs": [
				{
					"id": 100100301,
					"content": "這裡…怎麼、怎麼有這麼多奇怪的東西…還有好多丘丘人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100302,
					"content": "不如說，感覺就是丘丘人把這些奇怪的東西搬到這裡來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100303,
					"content": "唔…原來這就是試煉裡的「叢叢障礙」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100304
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100304,
					"content": "雖然讀音很相近，但其實是「重重障礙」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100305,
					"content": "不過，按照紙條的提示，我們要找的東西應該在這些「重重障礙」下面…有什麼別的提示嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100306,
					"content": "這個時候難道沒有什麼「嘟嘟可的指引」之類的東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100307,
					"content": "沒有哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100308
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100308,
					"content": "啊…那要怎麼辦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100309,
					"content": "嗯…媽媽曾經說過，遇到困難就要解決困難！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100310
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100310,
					"content": "那就讓「重重障礙」消失吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100100311
					]
				},
				{
					"id": 100100311,
					"content": "嗯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "可莉"
				}
			]
		},
