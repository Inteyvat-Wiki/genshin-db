			"dialogs": [
				{
					"id": 100100501,
					"content": "好耶，全都清理掉了，不管是障礙還是丘丘人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100502,
					"content": "而且也沒有引發大火什麼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100503,
					"content": "可莉有好好控制蹦蹦炸彈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100504
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100504,
					"content": "現在可莉進禁閉室的次數，已經越來越少啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100505
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100505,
					"content": "可莉，了不起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100506,
					"content": "但是什麼時候可莉能夠不進禁閉室呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100507,
					"content": "要是琴團長同意可莉炸掉禁閉室的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100508
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100508,
					"content": "不是在說用這種方法實現啦！啊對了，嘟嘟可的試煉呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100509,
					"content": "啊，可莉拿到了，就在剛才蹦蹦炸彈炸出的土坑裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100510
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100510,
					"content": "是新的紙條呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100511,
					"content": "嗯，上面的是媽媽寫的字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100512
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100512,
					"content": "「嘟嘟可有沒有把所有的障礙炸飛呢？有的時候直接才是最具有美學的做法呢。然後，嘟嘟可到了試煉的第二站…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100513,
					"content": "「其實也就是最後一站，即使是再有活力的孩子，也要好好控制每日活動的時間，那麼…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100514,
					"content": "「在星星墜入的湖水之畔，嘟嘟可經過了試煉，得到了最終的褒獎——但是事情真的會如此簡單嗎…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100515
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100515,
					"content": "說起星星和湖的話，那就是星落湖了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100516,
					"content": "那我們就去湖邊看看吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100517
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100100517,
					"content": "好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100100518
					],
					"speakerTitle": "可莉"
				},
				{
					"id": 100100518,
					"content": "真好奇這個最終的褒獎是什麼…說不定是了不起的寶藏呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
