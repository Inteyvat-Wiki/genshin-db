			"dialogs": [
				{
					"id": 705450101,
					"content": "喵，喵喵——喵——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450102
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450102,
					"content": "喵！喵喵喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450103
					],
					"speakerTitle": "「兔嘰」"
				},
				{
					"id": 705450103,
					"content": "嗯…「兔嘰」和安柏說的都很有道理…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450104,
					"content": "喔，原來如此啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450105,
						705450106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450105,
					"content": "的確，說得對呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				},
				{
					"id": 705450107,
					"content": "其實我也不太明白啦，但我明顯感覺到安柏和「兔嘰」達成了共識！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450108,
					"content": "#{NICKNAME}和派蒙啊！{F#妳}{M#你}們來啦，我剛想著去找{F#妳}{M#你}們呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450109
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450109,
					"content": "#我已經聽瓦樂瑞娜小姐說{F#妳}{M#你}們協助這家「貓茸茸城堡」經營的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450110
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450110,
					"content": "#不愧是{NICKNAME}，一回蒙德就幫了這麼大的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450111,
						705450112
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450111,
					"content": "畢竟我是什麼任務都接的榮譽騎士。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450113,
					"content": "話說回來，剛才安柏和「兔嘰」正在聊什麼呀？好像聊得很開心的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450114,
					"content": "喵，喵喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450115
					],
					"speakerTitle": "「兔嘰」"
				},
				{
					"id": 705450115,
					"content": "嗯…我正在問「兔嘰」今天的天氣怎麼樣，會不會下雨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450116
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450116,
					"content": "欸？小貓還擅長做這種事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450117,
					"content": "嘿嘿，我也是聽麗莎小姐說的啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450118
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450118,
					"content": "麗莎小姐看過的一本書中說小貓們對濕氣很敏感，而且也不太喜歡濕漉漉的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450119
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450119,
					"content": "所以如果感覺到空氣中的濕氣突然增加，就會焦躁不安地開始不斷揉臉和舔毛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450120
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450120,
					"content": "小貓們一旦作出這樣的舉動，就代表有可能會有大雨來到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450121
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450121,
					"content": "原來還有這種神奇的道理…無意中學到了很特別的知識！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450122,
					"content": "#{NICKNAME}，以後我們旅行的時候可以多多觀察貓貓，這樣就不至於…老是被烏雲倒下來的大雨淋得全身濕透了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450123,
						705450124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 705450123,
					"content": "那以後還真的要多注意注意了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450125,
					"content": "本來我今天是來向瓦樂瑞娜小姐打聽一件事的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450126
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450126,
					"content": "我正在和她聊天時這隻小貓就湊過來，趴在我旁邊打了一個大大的哈欠，太可愛了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450127
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450127,
					"content": "她都對我這麼親近了，那…那我也得表示一下友好呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450128
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450128,
					"content": "然後，我就想起了麗莎小姐告訴我的事，就順便向「兔嘰」問問天氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450129
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450129,
					"content": "但是「兔嘰」一下揉臉，一下搖尾巴，一下又趴在地上蹭我的手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						705450130
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450130,
					"content": "唔…未來幾天到底會不會下雨呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 705450124,
					"content": "我本來就會很注意路邊的貓貓！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450125
					]
				},
				{
					"id": 705450112,
					"content": "守護蒙德城的小貓也是職責之一嘛。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450113
					]
				},
				{
					"id": 705450106,
					"content": "慢著，我還沒懂！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						705450107
					]
				}
			]
		}
	]
}