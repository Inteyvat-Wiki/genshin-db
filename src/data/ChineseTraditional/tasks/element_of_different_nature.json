			"dialogs": [
				{
					"id": 3180201,
					"content": "#咦？{F#妳}{M#你}這是…感受到「岩」的元素力了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3180202,
					"content": "#果然{F#妳}{M#你}和「神之眼」的使用者很不一樣呢！居然可以改變體內的元素形態…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3180203,
					"content": "這樣看來，和在蒙德的時候一樣，只需要向七天神像祈願，就會得到回應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3180204,
					"content": "——嗯，這裡是璃月，「岩」之神統治的國度，所以神像的造型不同。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3180205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3180205,
					"content": "#如果{F#妳}{M#你}又想使用「風」的元素力，就回一趟蒙德，去找那裡的七天神像吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		}
