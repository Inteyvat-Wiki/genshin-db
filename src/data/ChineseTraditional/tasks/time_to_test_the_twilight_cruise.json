					"nextDialogs": [
						150470504
					]
				},
				{
					"id": 150470504,
					"content": "#噢！你好你好，你看起來好乖哦，{NICKNAME}沒有跟你一起來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
