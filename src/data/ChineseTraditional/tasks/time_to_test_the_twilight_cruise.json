				]
			},
			"dialogs": [
				{
					"id": 150470101,
					"content": "#{F#妳}{M#你}們來了！這裡的工作人員好像臨時有事走開了，不過我已經弄清楚要怎麼玩…我是說，完成測試了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470102
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470102,
					"content": "好呀，那妳教教我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150470103,
					"content": "簡單來說，需要一方登上遊船，另一方向龍員工發送信號。透過默契十足的雙人合作，將遊船安全送到目的地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470104
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470104,
					"content": "#要說考驗默契，我對我和{NICKNAME}的配合可是很有信心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470105
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470105,
					"content": "是嗎？通常說完大話就離翻船不遠了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150470106,
					"content": "喂喂，派蒙，不吉利的話可不要亂說噢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470107
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470107,
					"content": "#好吧，那…那祝{F#妳}{M#你}們一帆風順。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150470108,
					"content": "哼哼，一定會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470109
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470109,
					"content": "其實我滿想坐船的，平時高難度的衝浪挑戰慣了，換個口味也很新鮮！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470110,
						150470111
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470110,
					"content": "我也開膩浪船了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				},
				{
					"id": 150470112,
					"content": "哇！一拍即合？！這就是我們牽絆的證明吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470113
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470113,
					"content": "我已經等不及想要把豚豚泳裝充足氣，一個彈跳飛到遊船上去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470111,
					"content": "我來發信號吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470112
					]
				}
			]
		},
