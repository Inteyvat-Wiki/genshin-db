			"dialogs": [
				{
					"id": 150470401,
					"content": "…噢，原來這裡的設施還沒有建造完成啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470402
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470402,
					"content": "有隻暝視龍員工在這裡！是不是應該拜託牠幫忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150470403,
					"content": "可以請你把它們建造出來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470404
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470404,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470405
					],
					"speakerTitle": "幼暝視龍"
				},
				{
					"id": 150470405,
					"content": "把它…放到這裡…造出來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470406
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470406,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470407
					],
					"speakerTitle": "幼暝視龍"
				},
				{
					"id": 150470407,
					"content": "牠好像看不懂妳的動作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150470408,
					"content": "是啊…怎麼辦呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470409
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470409,
					"content": "慢著慢著慢著，我突然想到新辦法了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470410
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470410,
					"content": "「咿——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470411
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470411,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470412
					],
					"speakerTitle": "幼暝視龍"
				},
				{
					"id": 150470412,
					"content": "「咿——」、「咿——」、「咿——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470413
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470413,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470414
					],
					"speakerTitle": "幼暝視龍"
				},
				{
					"id": 150470414,
					"content": "哈…不行…牠根本聽不懂鰭游龍的叫聲啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470415
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470415,
					"content": "要不然…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470416
					]
				},
				{
					"id": 150470416,
					"content": "…我又想起來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470417
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470417,
					"content": "又想起什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150470418,
					"content": "我聽伊法說過，暝視龍最喜歡吃的就是微光角菌，正好我隨身帶著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470419
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470419,
					"content": "太好了太好了，這下有救了！給牠吃完一定就能互通心意了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470420
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470420,
					"content": "！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470421
					],
					"speakerTitle": "幼暝視龍"
				},
				{
					"id": 150470421,
					"content": "出遠門的物資就是要多準備一些才行…卡齊娜提醒得一點沒錯。謝謝妳呀，卡齊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470422
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470422,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470423
					],
					"speakerTitle": "幼暝視龍"
				},
				{
					"id": 150470423,
					"content": "這…並沒有互通心意的徵兆…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 150470424,
					"content": "完蛋了…征服浪浪灣所有設施的夢想在出航的第一日就翻船了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470425
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470425,
					"content": "#{NICKNAME}，大英雄{NICKNAME}，{F#妳}{M#你}有什麼辦法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						150470426,
						150470427
					],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470426,
					"content": "辦法的確有…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				},
				{
					"id": 150470428,
					"content": "#嗯，好吧…那就麻煩{F#妳}{M#你}了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪拉妮"
				},
				{
					"id": 150470427,
					"content": "幫妳再叫一隻暝視龍來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						150470428
					]
				}
