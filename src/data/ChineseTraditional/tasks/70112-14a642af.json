			"dialogs": [
				{
					"id": 701120101,
					"content": "對了，德克斯特，今時不同往日。你也應該迎接童年的終結了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120102
					],
					"speakerTitle": "喬瑟夫斯"
				},
				{
					"id": 701120102,
					"content": "你也要接受成年的洗禮，學習大人才知道的事情。看好了，小右，我只教這一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120103
					],
					"speakerTitle": "喬瑟夫斯"
				},
				{
					"id": 701120103,
					"content": "聽起來像是在交代後事一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701120104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 701120104,
					"content": "最後一課，先和我一起讀：「元素的分類」。你來試試吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "喬瑟夫斯"
				}
