			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"萍姥姥"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718000301,
					"content": "",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000302,
						718000305
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 718000302,
					"content": "婆婆，我衣服都濕透了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000303
					]
				},
				{
					"id": 718000303,
					"content": "對不住啊孩子們，是我考慮少了，唉，我還以為沒蓄多少水呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000304
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 718000304,
					"content": "不過，這壺大體上應該也弄乾淨了，剩下的那些邊邊角角，就慢慢打掃吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 718000307,
					"content": "婆婆，您是把整條碧水河的水都裝進去了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718000308,
					"content": "妳這孩子，怎麼可能，這城裡的人還得用水呢…我就只裝了半條河的水而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000309
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 718000309,
					"content": "好了孩子們，這次讓你們遭罪了。這些東西拿著，辛苦你們啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000310
					],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 718000310,
					"content": "對了，我還得找個時間，把這壺裡的水倒回河裡去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "萍姥姥"
				},
				{
					"id": 718000305,
					"content": "裡面應該也打掃乾淨了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718000306
					]
				},
				{
					"id": 718000306,
					"content": "唔，但還有些邊邊角角，得進去仔細打掃啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718000307
					],
					"speakerTitle": "萍姥姥"
				}
			]
		},
