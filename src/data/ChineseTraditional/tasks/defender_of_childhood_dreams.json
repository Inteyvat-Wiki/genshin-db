			},
			"dialogs": [
				{
					"id": 110120801,
					"content": "哥哥…好像有人說，「獨眼小寶」是殺人用的機器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120802
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110120802,
					"content": "怎麼會呢？唔…你還小，別把打打殺殺掛在嘴上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120803
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120803,
					"content": "嗯，我早知道他們是騙子了，「獨眼小寶」是用來打敗壞人、保護世界的，是托克最喜歡的玩具！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120804
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110120804,
					"content": "對，有它在，壞人就傷害不了托克。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120805
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120805,
					"content": "嘿嘿，果然沒錯，我現在就去找「獨眼小寶」玩了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120806
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110120806,
					"content": "喂，托克，慢一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120807
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120807,
					"content": "門、門關上了！托克會不會遇上危險…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120808,
					"content": "那邊有另一條路，我們快走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
