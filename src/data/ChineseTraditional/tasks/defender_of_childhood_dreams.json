						110121102
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121102,
					"content": "「公子」？原來你在啊。剛才為什麼不出來呀，非要躲在那裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110121103,
					"content": "臨別的場面，是很重要的。我現在的狀態…這麼虛弱的模樣，要是留在了托克的記憶裡，可就不好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121104
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121104,
					"content": "雖然，不能親口跟弟弟道別，確實有些可惜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121105
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121105,
					"content": "唉…本來應該由我親自護送他到家裡的。雖說有手下跟著，但還是有些惴惴不安啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121106
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121106,
					"content": "你到底有多寵著他啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110121107,
					"content": "#哈哈…但不知為何，把托克交給{F#妳}{M#你}們的時候，我都感覺很放心，明明不久之前我們還…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121108
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121108,
					"content": "#哦對了，謝禮謝禮，我差點忘了。這次的事真是多虧{F#妳}{M#你}們一直幫忙打圓場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121109
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121109,
					"content": "哇，你還算有點良心嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110121110,
					"content": "還有，別忘記我們的約定，有機會一定要再好好較量一次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121111
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121111,
					"content": "——賭上執行官的榮譽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121112,
						110121113
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121112,
					"content": "我很期待。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				},
				{
					"id": 110121114,
					"content": "你先養好自己的身體吧！到時候別說我們欺負你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110121115,
					"content": "#哈哈哈…下次較量之後，不論輸贏，都請{F#妳}{M#你}們來我家做客吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121116
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121116,
					"content": "#我會把冬妮婭和安東也介紹給{F#妳}{M#你}們，都是我引以為豪的弟弟妹妹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121117
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121117,
					"content": "好吧，就當兌現和托克的約定！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110121118,
					"content": "#哈哈，托克也一定很期待再見到{F#妳}{M#你}們吧，那就這麼定了。我很期待…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121119
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121119,
					"content": "期待與你們在至冬見面的那一天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121113,
					"content": "不會輸給你的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110121114
					]
				}
			]
		}
