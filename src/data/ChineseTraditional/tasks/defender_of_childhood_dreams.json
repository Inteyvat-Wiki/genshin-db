						110121003
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110121003,
					"content": "只有你一個人覺得好玩，我們都快嚇死了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110121004,
					"content": "前面是…好大的房間！是「獨眼小寶」們的會客廳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121005
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110121005,
					"content": "是啊，很寬闊的場地，不如我們來玩捉迷藏吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121006
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110121006,
					"content": "欸…現在嗎？可是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121007
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110121007,
					"content": "哥哥要給你準備一些…嗯，驚喜。",
