					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120709
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110120709,
					"content": "你們剛才不是在捉迷藏嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120710
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120710,
					"content": "哦對呀！托克太高興了，把捉迷藏的事都給忘了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120711
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110120711,
					"content": "#那{F#姐姐}{M#哥哥}，我們一起找吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "托克"
				},
				{
					"id": 110120703,
					"content": "「獨眼小寶」最酷了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
