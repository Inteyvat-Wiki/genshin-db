			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120101,
					"content": "就是這裡了，璃月的「玩具研究所」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120102
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120102,
					"content": "到了到了！我已經聽到裡面機器的聲音了，好酷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120103
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110120103,
					"content": "這裡究竟是什麼地方，你為什麼會知道這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120104,
					"content": "我之前略有瞭解，這裡應該算是「博士」的「玩具研究所」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120105
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120105,
					"content": "「博士」是愚人眾的另一位「執行官」，平時偶爾有些鼓搗舊東西的…癖好。這處遺蹟是被他改造了，用來研究遺蹟守衛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120106
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120106,
					"content": "欸？遺蹟守衛難道是你們愚人眾製造的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120107,
					"content": "不，那種怪物和「深淵」的關係更近些，嚴格來說也算我們的敵人…我們只是單純地做研究而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120108
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120108,
					"content": "至於最近為什麼會有遺蹟守衛跑出來…大概只是因為他玩膩了，對這裡失去興趣了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120109
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120109,
					"content": "又是一個性格惡劣的執行官呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120110,
					"content": "這麼說，怪不得你敢帶托克來這裡，原來是早就做過功課了呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120111,
					"content": "其實…也不算做過功課吧，這座「研究所」的內部究竟是什麼樣，我還完全不瞭解。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120112
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120112,
					"content": "那、那你難道不在乎弟弟的安危嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120113,
					"content": "怎麼會…不論有什麼危險，我都會替他全部接下——「哥哥」不就是這樣的角色嗎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120114
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120114,
					"content": "而且連托克也能理解戰鬥的意義，再怎麼說，這意義也在我心裡沉澱了這麼多年…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120115
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120115,
					"content": "哥哥，你們還在聊什麼？快帶路呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120116
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110120116,
					"content": "哈哈，好，交給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「公子」"
				}
			]
		},
		{
			"id": 1101202,
			"completionStepIds": [
				1101205
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1101205",
							"2"
						],
						"stepId": 1101205,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「公子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 110120201,
					"content": "#好在被{F#妳}{M#你}們先找到了…帶傷發動「魔王武裝」，原來比想像中更費勁些…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120202
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120202,
					"content": "不然讓托克看到我這副提不起勁的樣子，可就太難堪了…呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120203,
						110120207
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120203,
					"content": "你不怕我趁現在解決掉你？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120204
					]
				},
				{
					"id": 110120204,
					"content": "#哈哈，我記得{F#妳}{M#你}也有兄弟姐妹吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120205
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120205,
					"content": "#我瞭解{F#妳}{M#你}，所以我知道，不論如何…{F#妳}{M#你}也不會在我弟弟面前對我出手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120206
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120206,
					"content": "可是，沒想到你居然會做到這種程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120208,
					"content": "我只是…不會放棄任何一個鍛煉自己的機會而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120209
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120209,
					"content": "這就是我達達利亞不斷變強的理由啊，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120210
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120210,
					"content": "而且，孩童時期的夢是最易碎的東西。哪怕放著不管，也總有一天會自己碎掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120211
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120211,
					"content": "所以，一定要有人來保護才行吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120212
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120212,
					"content": "許下的承諾就該好好遵守，做錯了事就該好好道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120213
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120213,
					"content": "給予他的夢，就該好好呵護到最後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120214
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120214,
					"content": "這才是身為家人該有的樣子，就是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120215
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120215,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						110120216
					]
				},
				{
					"id": 110120216,
					"content": "#莫非…引起{F#妳}{M#你}的什麼回憶了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120217
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120217,
					"content": "咳咳…唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120218
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120218,
					"content": "你這副樣子居然還要耍帥，趕緊去看醫生吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120219,
					"content": "#呵…不錯的提議，不過在這之前…有件東西，要請{F#妳}{M#你}轉交給托克。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120220
					],
					"speakerTitle": "「公子」"
				},
				{
					"id": 110120220,
					"content": "欸，這是…「獨眼小寶」的玩偶嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110120221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 110120221,
					"content": "沒錯，是很久之前我專門找鐵匠定製的。本想帶回至冬國送給他，但現在看來，作為旅行的紀念品更好。",
					"roleType": "TALK_ROLE_NPC",
