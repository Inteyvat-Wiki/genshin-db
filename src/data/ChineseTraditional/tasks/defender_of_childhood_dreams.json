					"nextDialogs": [
						110121009
					],
					"speakerTitle": "托克"
				},
				{
					"id": 110121009,
					"content": "等會托克自己去找吧？不過在這之前，你要乖乖閉上眼睛，轉過身去倒數六十個數。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						110121010
					],
					"speakerTitle": "「公子」"
