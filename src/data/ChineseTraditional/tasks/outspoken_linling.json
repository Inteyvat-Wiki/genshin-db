			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梟總管"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360501,
					"content": "是霖鈴啊，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360502
					],
					"speakerTitle": "梟總管"
				},
				{
					"id": 413360502,
					"content": "上次你拜託我寫的那副字，我已經和這位旅行者一起寫好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360503
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360503,
					"content": "喏，我已經幫你寫在霄燈上了，給你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360504
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360504,
					"content": "那真是謝謝了，我看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360505
					],
					"speakerTitle": "梟總管"
				},
				{
					"id": 413360505,
					"content": "「晚輩來，怒目金剛八面威風」，「千帆去，無憂安眠鼾響震山」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360506
					],
					"speakerTitle": "梟總管"
				},
				{
					"id": 413360506,
					"content": "「久安如山」…呵呵，倒是還不錯，多謝妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360507
					],
					"speakerTitle": "梟總管"
				},
				{
					"id": 413360507,
					"content": "不用謝，我這裡還有一副我自己寫的呢，我唸給…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360508,
						413360509
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360508,
					"content": "我們快去找下一個人吧！",
