			"trigger": {
				"objectNames": [
					"霖鈴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360101,
					"content": "唔…還是去現場取材一下吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360102
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360102,
					"content": "妳在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360103
					]
				},
				{
					"id": 413360103,
					"content": "我正在幫人想一些適合寫在霄燈上的話呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360104
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360104,
					"content": "海燈節期間，大家不是都要放霄燈嗎，也會在上面寫一些願望啦，祝福語啦之類的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360105
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360105,
					"content": "為了顯得有些節日的氛圍，有的人就想要把那些願望和祝福語，寫得…嗯…怎麼說呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360106
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360106,
					"content": "有「文采」一些…這樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360107
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360107,
					"content": "碧波，梟總管和德貴就拜託我，幫他們想一些有「文采」的祝福語，然後寫在霄燈上送給他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360108
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360108,
					"content": "但如果我只是在這閉門造車的話，肯定也想不出什麼好詞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360109
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360109,
					"content": "所以，我想要先把霄燈準備好，然後再去觀察一下那些拜託我的人，再為他們量身訂做一份祝福語。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360110
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360110,
					"content": "但我可不怎麼會編霄燈啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360111,
						413360112
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360111,
					"content": "我來幫忙吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				},
				{
					"id": 413360113,
					"content": "#是嗎？那就拜託{F#妳}{M#你}了，拜託{F#妳}{M#你}幫我做三盞霄燈吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360114
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360114,
					"content": "然後我們再去實地取取材，看看該寫什麼祝福語好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360115
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360115,
					"content": "嘿嘿，我差不多有思路了，只要再找到一點點靈感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360112,
					"content": "我還滿會編霄燈的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360113
					]
				}
			]
		},
