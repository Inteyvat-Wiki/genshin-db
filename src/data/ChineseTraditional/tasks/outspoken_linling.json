			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"霖鈴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 413360401,
					"content": "梟總管在那邊，我們先在這裡觀察一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360402
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360402,
					"content": "我想想啊，我對梟總管印象很深，給他的那副字很快就寫好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360403
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360403,
					"content": "#我唸給{F#妳}{M#你}聽啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360404
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360404,
					"content": "「臭臉老頭沒半點好脾氣」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360405,
						413360406
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360405,
					"content": "啊？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				},
				{
					"id": 413360407,
					"content": "「雖如此卻有一副熱心腸」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360408,
						413360409
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360408,
					"content": "嗯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360410,
					"content": "還有個橫披呢。橫披是…「確是好人」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360411
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360411,
					"content": "怎麼樣，是不是很貼切，梟總管雖然看上去很兇，但實際上人挺好的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360412
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360412,
					"content": "還有其他備選方案嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360413
					]
				},
				{
					"id": 413360413,
					"content": "啊，倒是還有一個，主要是我想不到怎麼接下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360414
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360414,
					"content": "#不然，{F#妳}{M#你}再幫我想想？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360415
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360415,
					"content": "前面那一句是「晚輩來，怒目金剛八面威風」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360416
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360416,
					"content": "「千帆去，無憂安眠鼾響震山」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360417
					]
				},
				{
					"id": 413360417,
					"content": "感覺還不錯…還差個橫披…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360418
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360418,
					"content": "呃…「久安如山」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360419
					]
				},
				{
					"id": 413360419,
					"content": "#欸！看不出來，{F#妳}{M#你}還挺有天賦的嘛，這一幅真不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360420
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360420,
					"content": "#那我就把這幅字寫在霄燈上了，{F#妳}{M#你}等等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						413360421
					],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360421,
					"content": "好了，寫好了，我們把霄燈送去給梟總管吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "霖鈴"
				},
				{
					"id": 413360409,
					"content": "先別唸了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360410
					]
				},
				{
					"id": 413360406,
					"content": "妳，妳先不要！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						413360407
					]
				}
			]
		},
		{
			"id": 4133605,
			"completionStepIds": [
				4133605
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
