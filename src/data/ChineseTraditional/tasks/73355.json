			"dialogs": [
				{
					"id": 733550101,
					"content": "咦，那邊有隻蕈獸飄過去了欸？沒問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733550102,
					"content": "正常來說，蕈獸在城區活動還是有點危險的吧！除非是非常聽話還受過訓練的特例…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733550103,
					"content": "不對啊，怎麼好像有點熟悉，以前我們是不是經歷過類似的情景？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550104,
						733550107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733550104,
					"content": "等等，是「咚咚小圓帽」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550105
					]
				},
				{
					"id": 733550105,
					"content": "對！「咚咚小圓帽」！我們在須彌結識的蕈獸夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733550106,
					"content": "嗚啊啊啊啊啊，上次見面都好久好久了！我們快過去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733550107,
					"content": "是什麼特例？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733550108
					]
				},
				{
					"id": 733550108,
					"content": "好像是…「咚咚小圓帽」？我們在須彌結識的蕈獸夥伴！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733550109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733550109,
					"content": "嗚啊啊啊啊啊，上次見面都好久好久了！我們快過去看看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
