			},
			"dialogs": [
				{
					"id": 412120501,
					"content": "你們看到了嗎？那隻丘丘人抓著一本書一樣的東西跑掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120502,
					"content": "麻煩了…是我的素描本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120503,
						412120504
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120503,
					"content": "它也想當繪畫大師嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				},
				{
					"id": 412120505,
					"content": "我倒覺得它只是個普通的小偷啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120506,
					"content": "竟敢偷我的素描本，哼，膽子不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120507
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120507,
					"content": "阿貝多，以一種很平靜的方式生氣了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120508,
					"content": "我會幫忙的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120504,
					"content": "它也想學習煉金術嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120505
					]
				}
			]
		},
