			},
			"dialogs": [
				{
					"id": 412120301,
					"content": "嗯？似乎不在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120302
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120302,
					"content": "怪物也會出去串門子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120303,
					"content": "#那麼，在怪物出現之前，{F#妳}{M#你}想四處走走，還是休息一會？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120304,
						412120306
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120304,
					"content": "休息一會，聊聊天怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120305
					]
				},
				{
					"id": 412120305,
					"content": "我也這麼想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120309,
					"content": "要聊天了嗎？我也要聽，給我留個位置！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120310,
					"content": "#我知道{F#妳}{M#你}對我、對這整件事都有不少問題。如先前所說，我會回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120311
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120311,
					"content": "#不過我也不打算欺騙{F#妳}{M#你}。有些還不能挑明的事，現階段請容我略過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120312
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120312,
					"content": "嗚哇…意外地是個很坦率的人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120313,
						412120314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120313,
					"content": "比我想的還要真誠呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120315,
					"content": "Tiga plata！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120316
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 412120316,
					"content": "嗯嗯！…咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120317,
					"content": "Odomu Movo！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120318,
						412120320
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 412120318,
					"content": "是阿貝多在亂叫嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120319
					]
				},
				{
					"id": 412120319,
					"content": "#{F#妳}{M#你}覺得可能嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120322,
					"content": "啊！是丘丘人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120320,
					"content": "是派蒙在亂叫嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120321
					]
				},
				{
					"id": 412120321,
					"content": "#才不是！{F#妳}{M#你}怎麼不說是阿貝多在怪叫呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120314,
					"content": "比我想的還要瀟灑呢！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120315
					]
				},
				{
					"id": 412120306,
					"content": "正好，我有話想問你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120307
					]
				},
				{
					"id": 412120307,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120308
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120308,
					"content": "#好吧，{F#妳}{M#你}想問什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120309
					],
					"speakerTitle": "阿貝多"
				}
			]
		},
