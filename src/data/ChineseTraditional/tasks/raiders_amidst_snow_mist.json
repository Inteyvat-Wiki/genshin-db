			"dialogs": [
				{
					"id": 412120701,
					"content": "阿貝多，應急工作做得還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120702,
					"content": "還行。有幾頁遭到破壞，但大部分完好無損。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120703
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120703,
					"content": "雪山氣溫太低，尤其是那個山洞，附近的氣溫已經達到了極限…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120704
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120704,
					"content": "何況丘丘人還把口水弄在了本子上。結冰的紙落在那樣的低溫裡，真是不堪設想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120705
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120705,
					"content": "結冰的紙那麼脆，一碰就碎了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120706,
					"content": "真虧你有辦法把素描本救回來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120707
					]
				},
				{
					"id": 412120707,
					"content": "不愧是煉金術士，心靈手巧呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120708,
					"content": "要是本子損壞嚴重的話，阿貝多一定會大發雷霆吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120709
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120709,
					"content": "為什麼會這樣想？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120710
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120710,
					"content": "因為你說過上面有很多圖畫和筆記。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120711,
					"content": "確實如此，這本素描本一直被我帶在身邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120712
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120712,
					"content": "不過，也不至於為這種事太過生氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120713
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120713,
					"content": "如果真的搶救不回來，重新畫過就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120714
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120714,
					"content": "咦…這種時候倒很現實了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120715,
						412120716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120715,
					"content": "我不這麼想。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				},
				{
					"id": 412120717,
					"content": "是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120718
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120718,
					"content": "不管怎麼說，那都是你用心繪製的畫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120719
					]
				},
				{
					"id": 412120719,
					"content": "對呀對呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120720,
					"content": "畫作承載的是記憶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120721
					]
				},
				{
					"id": 412120721,
					"content": "是的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120722
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120722,
					"content": "別輕易放棄與回憶有關的東西。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120723
					]
				},
				{
					"id": 412120723,
					"content": "#正是如此！哎呀，{NICKNAME}說得真不錯，其實我想說的也是這些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120724
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120724,
					"content": "…也是。重畫很麻煩，我不喜歡這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120725
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120725,
					"content": "我猜是因為阿貝多很天才吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120726
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120726,
					"content": "你看，你會那麼多別人不會的技藝，懂得那麼多別人不懂的道理！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120727,
					"content": "這樣的人有時反而會忽略細節呢。難道說這就是聰明的弊端嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120728
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120728,
					"content": "阿貝多也說過派蒙聰明哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120729
					]
				},
				{
					"id": 412120729,
					"content": "是的，派蒙是個很有趣的生物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120730,
						412120731
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120730,
					"content": "派蒙也會忽略細節嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120732,
					"content": "啊——不要在我說大道理的時候扯上我自己啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120733
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120733,
					"content": "那麼，換個話題。之前賽琉斯說，雪山丘丘人會襲擊冒險家，搶奪物資。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120734
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120734,
					"content": "我們去的，應該就是這群丘丘人的據點之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120735
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120735,
					"content": "這裡的丘丘人很強。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120736
					]
				},
				{
					"id": 412120736,
					"content": "對，這一帶的丘丘人，比山腳下那些丘丘人強不少呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120737
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120737,
					"content": "我也有同樣的感覺。我想…這仍然是與「龍」有關吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120738
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120738,
					"content": "杜林亡骸中的污穢之力會強化怪物。再加上嚴寒氣候，一些雪山區域便成了無人區。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120739
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120739,
					"content": "旅行者，能把劍拿出來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120740
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120740,
					"content": "在雪山的每一次戰鬥，這把劍都會吸收力量，儲存在劍身之內。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120741
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120741,
					"content": "#並且，由於{F#妳}{M#你}的淨化，那些原本被龍血污染的力量，似乎都被精煉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120742
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120742,
					"content": "這是很有意思的現象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120743
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120743,
					"content": "這種事我們可熟悉了，非常拿手的哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120744
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120744,
					"content": "#雖然知道{F#妳}{M#你}有這種力量，但…原來這就是淨化，真是百聞不如一見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120745
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120745,
					"content": "能儲存力量的劍，很危險吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120746
					]
				},
				{
					"id": 412120746,
					"content": "的確不能說是非常安全的武器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120747
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120747,
					"content": "幸好沒被那些丘丘人搶走，否則我們就完了！那群雪山丘丘人會變得多強啊……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120748,
						412120749
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120748,
					"content": "愚人眾更危險吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120750,
					"content": "丘丘人也很危險呀！萬一它們得到能量，變成…超級，不，究極丘丘人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120751
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120751,
					"content": "丘丘魔人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120752
					]
				},
				{
					"id": 412120752,
					"content": "丘丘惡魔人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120753
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120753,
					"content": "丘丘惡魔雪人！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120754
					]
				},
				{
					"id": 412120754,
					"content": "為什麼加了雪字，感覺一下就變得好弱…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120755
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120755,
					"content": "說起來，這把劍這麼厲害的話，是不是也能吸收阿貝多的力量？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120756
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120756,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120757
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120757,
					"content": "想試試嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120758
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120758,
					"content": "嗚哇！眼神一下變得冰涼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120759,
						412120760
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120759,
					"content": "派蒙是開玩笑…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120761,
					"content": "#不，我沒有生氣。總之，希望{F#妳}{M#你}能繼續使用這把劍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120762
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120762,
					"content": "就算這把劍那麼危險，你仍然信任我們嗎？好意外呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120763
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120763,
					"content": "阿貝多，看起來是這樣，心裡卻好像是那樣的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120764
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120764,
					"content": "這樣、那樣…是怎麼樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120765
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120765,
					"content": "說起我信任你們的原因…那或許是因為…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120766
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120766,
					"content": "「異類」之間的，某種共識吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120767
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120767,
					"content": "異類？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120768
					]
				},
				{
					"id": 412120768,
					"content": "#孤獨的個體…與普通人不同的個體，就像…{F#妳}{M#你}和我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120769,
						412120770
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120769,
					"content": "（……？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120770,
					"content": "（這句話，有特別的含義嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 412120760,
					"content": "派蒙沒有惡意…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120761
					]
				},
				{
					"id": 412120749,
					"content": "盜寶團更危險吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120750
					]
				},
				{
					"id": 412120731,
					"content": "派蒙該不會也有弊端吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120732
					]
				},
				{
					"id": 412120716,
					"content": "這種時候應該生氣一點哦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120717
					]
				}
			]
		},
