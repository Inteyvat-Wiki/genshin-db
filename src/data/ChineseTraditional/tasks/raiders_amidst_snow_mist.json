			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿貝多"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412120101,
					"content": "阿貝多！我們回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120102,
					"content": "哎呀，是有客人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120103,
						412120104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120103,
					"content": "有點眼熟的客人呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				},
				{
					"id": 412120105,
					"content": "讓新人來雪山冒險，或許還是太心急了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120106
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120106,
					"content": "可是，冒險不就是挑戰自我極限嗎？沒有磨難、沒有刺激的旅途還有什麼意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120107
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120107,
					"content": "哪怕這一帶到處都有兇惡的丘丘人土匪與淹沒到膝蓋的積雪，冒險家們也絕不能停下腳步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120108
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120108,
					"content": "賽琉斯，說重點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120109
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120109,
					"content": "哈哈哈，瞧你說的！聊天就跟探險一樣，重在過程，哪有什麼重點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120110
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120110,
					"content": "嗯！被打劫到放棄據點，在冰冷的雪堆裡生火做飯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120111
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120111,
					"content": "雪山之旅對冒險家協會各位新人來說，一定是永生難忘的經歷，哈哈哈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120112
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120112,
					"content": "嗯，對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120113
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120113,
					"content": "哪怕此刻他們在心中埋怨我、憎恨我，未來也會為這份回憶感謝我，這就是冒險的傳承啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120114
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120114,
					"content": "嗯，你接著說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120115
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120115,
					"content": "嗚哇…阿貝多老毛病又犯了，對不感興趣的東西好冷淡呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120116,
					"content": "看來他對冒險家的興趣實在不怎麼大。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120117
					]
				},
				{
					"id": 412120117,
					"content": "#是嗎？我看他對{F#妳}{M#你}就很有興趣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120118,
					"content": "不過，該說是新人太弱，還是雪山太強呢？這次可真是損失慘重啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120119
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120119,
					"content": "為什麼損失慘重？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120120,
					"content": "#哦…！{F#妳}{M#你}是…！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120121
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120121,
					"content": "你好，賽琉斯先生。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120122
					]
				},
				{
					"id": 412120122,
					"content": "好久不見啦——！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120123,
					"content": "#啊~年輕的冒險家和{F#她}{M#他}的好夥伴，真高興在這裡見到你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120124
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120124,
					"content": "希望這片嚴寒的山脈沒有給你們造成太多麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120125
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120125,
					"content": "能應付的都不是麻煩！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120126,
					"content": "哈哈哈，沒錯！我喜歡妳自信的發言！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120127
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120127,
					"content": "特意頂著風雪到這裡來，是有不得不辦的工作嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120128
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120128,
					"content": "#我來這裡採集丘丘人的最新數據，委託{F#她}{M#他}做我的助手。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120129,
						412120130
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120129,
					"content": "（嗯？是這樣嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120131,
					"content": "原來如此，都是為了理想匯聚在此的追夢者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120132
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120132,
					"content": "那就祝各位順利完成計畫。我得先去看看那幫新人，告辭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120201
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 412120201,
					"content": "哼哼，我好像發現了什麼哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120202,
					"content": "阿貝多瞞著賽琉斯呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120203
					]
				},
				{
					"id": 412120203,
					"content": "畢竟是把魔劍嘛，不想讓其他蒙德人知情也算是情有可原。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120204,
					"content": "我都聽見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120205
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120205,
					"content": "我是不是不該問？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120206
					]
				},
				{
					"id": 412120206,
					"content": "#沒有「應該」與「不該」之分。{F#妳}{M#你}想知道的事，我都可以說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120207
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120207,
					"content": "——但不是現在。現在我手上還有些重要的事要辦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120208
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120208,
					"content": "辦事？唔，說是辦你自己的事，但我猜…也不會放過我們，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120209,
					"content": "派蒙，妳似乎越來越聰明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120210
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120210,
					"content": "什麼話！我一直都很聰明啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412120211,
					"content": "我在附近發現了一些新棲息地。不同屬性的怪物，能為我們提供不同的數據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120212
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120212,
					"content": "你對實驗的興趣還真強大。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120213
					]
				},
				{
					"id": 412120213,
					"content": "實驗本就是需要毅力才能做成的事。對煉金術士而言，堅持是最基礎的素養。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412120214
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120214,
					"content": "準備好了嗎？那就走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412120130,
					"content": "（他似乎不想讓別人知道劍的事呢。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120131
					]
				},
				{
					"id": 412120104,
					"content": "我是不是見過這張臉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412120105
					]
				}
			]
		},
