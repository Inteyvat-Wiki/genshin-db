			},
			"dialogs": [
				{
					"id": 721250501,
					"content": "這些花種可以用嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250502
					]
				},
				{
					"id": 721250502,
					"content": "這是…可以！當然可以，有了這些種子，我肯定能種出很多花來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250503
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721250503,
					"content": "那、那個，抱歉，請稍等…我得給您點報酬才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250504
					],
					"speakerTitle": "葉名山薰"
				},
				{
					"id": 721250504,
					"content": "這些給您，謝謝您的花種。您過段時間來，肯定能看見很漂亮的花海！",
					"roleType": "TALK_ROLE_NPC",
