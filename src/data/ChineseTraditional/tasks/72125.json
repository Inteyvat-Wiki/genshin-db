			"dialogs": [
				{
					"id": 721250301,
					"content": "妳在這裡做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721250302
					]
				},
				{
					"id": 721250302,
					"content": "我正在想，從哪裡才能找到花種，把周圍再種上花呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721250303
					],
