				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722640601,
					"content": "#呶！{F#妳}{M#你}們回來了！有沒有受傷？有沒有著涼？肚子餓不餓？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640602
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640602,
					"content": "嘿嘿，如果有吃的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640603,
					"content": "一切順利，不用擔心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640604
					]
				},
				{
					"id": 722640604,
					"content": "呶！雪好冷。但是，很好玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640605
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640605,
					"content": "啊，對了！還有紀念品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640606,
					"content": "向五百藏展示吉法師在雪山的相片。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722640607
					]
				},
				{
					"id": 722640607,
					"content": "咿——吉法師！吉法師怎麼被封印在紙裡面了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640608
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640608,
					"content": "#這是、這是「地獄繪」？怎麼會在{F#妳}{M#你}的手裡？為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640609,
						722640612
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640609,
					"content": "人類的法術很厲害吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640610
					]
				},
				{
					"id": 722640610,
					"content": "嗚呶呶，怎麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640611
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640611,
					"content": "好啦好啦，別欺負五百藏啦。那是「相片」，是一種畫。你看，吉法師不是好好的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640614,
					"content": "耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640615
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640615,
					"content": "咦？兩個吉法師…？欸？欸？這是什麼法術？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640616
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640616,
					"content": "…哦，原來如此，是法術嘛！哈哈哈，吉法師，進步很快嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640617
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640617,
					"content": "呶哈哈。笨蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640618
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640618,
					"content": "真是的，好好聽人說話啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640619,
					"content": "多花費了一番口舌，向五百藏解釋。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722640620
					]
				},
				{
					"id": 722640620,
					"content": "…呶，吾輩可是大名鼎鼎的妖狸大王！怎麼會不知道「樓影雞」是什麼。吾輩只是考考吉法師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640621
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640621,
					"content": "好不知所謂喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640622,
					"content": "強詞奪理。呶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640623
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640623,
					"content": "咳咳。不管怎麼說，看來吉法師的修行很順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640624,
						722640625
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640624,
					"content": "和吉法師旅行很有趣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640627
					]
				},
				{
					"id": 722640627,
					"content": "#呶，很好。那接下來也交給{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640628
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640628,
					"content": "當年吾輩還是幼狸的時候，曾經遊歷了十八所聖跡，不偏不倚地走在狸道上，才變成了偉大的妖狸大王。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640629
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640629,
					"content": "吉法師現在只有吾輩當初一半偉大。所以，修行就去八個地方就行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640630
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640630,
					"content": "雖然很想說「按照一半算，應該是九個地方」，不過不管了…接下來，我們要帶吉法師去什麼地方呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640631
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640631,
					"content": "#{F#妳}{M#你}們和別的人類不同，對吾等妖狸一族很好，是好人。而且，作為人類也很有能耐。只要跟著{F#妳}{M#你}們一起，對吉法師肯定是好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640632
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640632,
					"content": "#所以，就由{F#妳}{M#你}們決定吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640633
					],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640633,
					"content": "喔，說得很好嘛！放心交給我們吧！我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640634
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640634,
					"content": "加油！加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640635
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640635,
					"content": "唔…有什麼好地方…有什麼好去處呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640636,
						722640637
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640636,
					"content": "慢慢想吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640638
					]
				},
				{
					"id": 722640638,
					"content": "…嗯，等想到了再說吧！現在肚子好餓，腦子轉不動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640639
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640639,
					"content": "吉法師就放心交給我們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640640
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640640,
					"content": "#就交給們{F#妳}{M#你}了呶。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "五百藏"
				},
				{
					"id": 722640637,
					"content": "可別想破頭了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640638
					]
				},
				{
					"id": 722640625,
					"content": "還挺累的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640626
					]
				},
				{
					"id": 722640626,
					"content": "不過，還挺有趣的！正好也可以一起看看以前曾經去過的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640612,
					"content": "這是相片，是一種「畫像」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640613
					]
				},
				{
					"id": 722640613,
					"content": "嗯，別擔心！你看，吉法師不是好好的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640614
					],
					"speakerTitle": "派蒙"
				}
			]
