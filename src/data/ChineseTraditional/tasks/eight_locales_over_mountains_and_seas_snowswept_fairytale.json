			},
			"dialogs": [
				{
					"id": 722640101,
					"content": "嗚嗚…雖然之前把山頂那個「大柱子」升起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640102,
					"content": "不過，不管來多少次，龍脊雪山都這麼冷…好難受…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640103,
					"content": "呶哈哈，白毛弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640104
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640104,
					"content": "欸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640105,
					"content": "吉法師不怕冷？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640106
					]
				},
				{
					"id": 722640106,
					"content": "呶嗚嗚，好冷好冷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640107
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640107,
					"content": "什麼嘛！氣死我了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640108,
					"content": "不過，好好玩。白色的到處都是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640109
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640109,
					"content": "白色的…啊，那些是「雪」喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640110,
					"content": "「雪」…「櫻吹雪」的雪？神櫻樹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640111
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640111,
					"content": "不是啦，雪就是龍脊雪山這些很冷很冷的白色東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640112,
					"content": "不過，吉法師竟然知道櫻吹雪這樣的詞，應該說不愧是稻妻的妖狸嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640113,
					"content": "呶！是雪！好冷好冷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640114
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640114,
					"content": "吉法師看起來好高興。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640115
					]
				},
				{
					"id": 722640115,
					"content": "山有雪所以冷，還是山很冷所以雪？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640116
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640116,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640117,
					"content": "#欸，這個問題問得好。{NICKNAME}，{F#妳}{M#你}覺得雪是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640118,
						722640121,
						722640124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640118,
					"content": "是水元素吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640119
					]
				},
				{
					"id": 722640119,
					"content": "唔…如果是這樣的話，那就是因為這裡很冷，所以水元素結冰了，變成了雪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640120,
					"content": "好冷好冷。好多雪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640128
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640128,
					"content": "不管怎麼說，這種事情，以後有機會問問麗莎這樣知識淵博的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640129,
					"content": "龍脊雪山真的好冷。之前，向山頂前進的時候，感覺有幾次都冷得意識模糊了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640130,
					"content": "不過，風景也很不錯！既然從影向山上能看到這裡，那從山頂上也能看到影向山吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640131,
					"content": "而且星熒洞窟很深，裡面可能還有什麼沒發現的寶藏…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640132
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640132,
					"content": "寶藏！寶藏好東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640133
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640133,
					"content": "吉法師和派蒙說不定很合得來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640134
					]
				},
				{
					"id": 722640134,
					"content": "哼哼，沒有寶藏，怎麼過好日子、吃好東西。吉法師挺懂的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640135,
					"content": "吉法師想在雪裡玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640136
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640136,
					"content": "嗯，別著涼哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640137,
					"content": "如果遇到危險的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640138
					]
				},
				{
					"id": 722640138,
					"content": "大喊「有寶藏」就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640139
					]
				},
				{
					"id": 722640139,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640121,
					"content": "是冰元素吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640122
					]
				},
				{
					"id": 722640122,
					"content": "欸？是這樣嗎？這樣的話，就是因為雪是冰元素，所以讓這裡變得很冷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640123,
					"content": "好冷好冷。好多雪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640128
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640124,
					"content": "是凱亞幹的吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722640125
					]
				},
				{
					"id": 722640125,
					"content": "「小心著涼！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640126,
					"content": "不對！再怎麼說，凱亞也沒這麼厲害吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640127,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640128
					],
					"speakerTitle": "「吉法師」"
				}
			]
		},
