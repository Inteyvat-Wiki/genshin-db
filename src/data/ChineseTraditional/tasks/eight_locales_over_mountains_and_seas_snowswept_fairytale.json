					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						722640507
					]
				},
				{
					"id": 722640507,
					"content": "噗噗，好像吉法師喔這個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640508
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640508,
					"content": "這就是吉法師喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640509,
					"content": "呶？但是，吉法師是我。只有一個。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640510
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640510,
					"content": "嗯，這個不是吉法師啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640511,
					"content": "雪山有妖狸？但是，沒聞到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640512
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640512,
					"content": "啊，不是的，龍脊雪山沒有妖狸。這個就是吉法師啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640513,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640514
					],
					"speakerTitle": "「吉法師」"
