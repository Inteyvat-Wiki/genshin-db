						722640907
					],
					"speakerTitle": "「吉法師」"
				},
				{
					"id": 722640907,
					"content": "唔…不過這前面是斷崖，要我們帶你過去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640908
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722640908,
					"content": "吉法師，飛飛。砰砰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722640909
					],
					"speakerTitle": "「吉法師」"
