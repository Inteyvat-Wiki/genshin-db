					"蘭帕卡提"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130201,
					"content": "…和那菈說話，好困難。而且，好高喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130202
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130202,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130203
					]
				},
				{
					"id": 730130203,
					"content": "#噫！是那菈{NICKNAME}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130204
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130204,
					"content": "蘭帕卡提不害怕。而且，哥哥們膽子大，一定也不害怕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130205
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130205,
					"content": "只要跟著<color=#00E1FFFF>煙柱</color>，應該就能找到他們。如果變得奇怪，就用<color=#00E1FFFF>草元素的力量</color>「啪嘰」他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭帕卡提"
				}
			]
		},
		{
			"id": 7301303,
			"completionStepIds": [
				7301303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301303",
							"2"
						],
						"stepId": 7301303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"蘭帕卡提",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130301,
					"content": "蘭帕卡提現在可是非常生氣，哎呀呀，比非常生氣還要生氣一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130302
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130302,
					"content": "森林裡面多危險呀，「無留陀」在森林裡肆虐。出發的時候，蘭帕卡提還特地叮囑幾位哥哥要團結一心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130303
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130303,
					"content": "結果剛出門就大吵了一架，蘭茶荼，你自己還吃了奇怪的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130304
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130304,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130305
					],
					"speakerTitle": "蘭茶荼"
				},
				{
					"id": 730130305,
					"content": "蘭帕卡提決定，在十次日落果成熟的時間裡，蘭茶荼都不准採蘑菇了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130306
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130306,
					"content": "怎麼這樣…嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130307
					],
					"speakerTitle": "蘭茶荼"
				},
				{
					"id": 730130307,
					"content": "就是，要是把壞孢子帶進來了，讓蘑菇怪物長出來，那怎麼行嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130308
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730130308,
					"content": "蘭非拉哥哥也是，跑到離桓那蘭那那麼遠的地方去採果子。那邊有好壞好壞的東西！蘭拉迦也特地說過的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130309
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130309,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130310
					],
					"speakerTitle": "蘭非拉"
				},
				{
					"id": 730130310,
					"content": "就是就是。果實也要喝水，蘭那羅也要喝水。所以，水是最好的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130311
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730130311,
					"content": "蘭阿帕斯哥哥，你非得去「法留納神機」找水。難道不知道，就連那菈法留納也說過，桓那蘭那的水是最好喝的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130312
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130312,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130313
					],
					"speakerTitle": "蘭阿帕斯"
				},
				{
					"id": 730130313,
					"content": "現、現在你們看見了吧，只有「開心的味道」，才能給妹妹帶來幸福。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130314
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730130314,
					"content": "#蘭薩卡哥哥，我聽說，你為了你的「開心的味道」，給那菈{NICKNAME}增添了許多麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130315
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130315,
					"content": "那、那都是為了「至上珍饈」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130316
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730130316,
					"content": "完成「至上珍饈」是為了得到「烹飪修行」的結果，哎呀呀，依靠他人的力量完成的修行，又有什麼意義可言？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130317
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130317,
					"content": "蘭帕卡提覺得，蘭薩卡哥哥最需要好好反省。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130318
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130318,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130319
					],
					"speakerTitle": "蘭薩卡"
				},
				{
					"id": 730130319,
					"content": "蘭帕卡提！我們來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130320,
					"content": "#哎呀呀，是{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130321
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130321,
					"content": "#那菈{NICKNAME}和派蒙分享了蘭帕卡提的煩惱，解決了煩惱的根源…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130322
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130322,
					"content": "#蘭帕卡提終於不再為哥哥們錯過無憂節，是否在外涉險而感到煩惱了。多虧{F#妳}{M#你}們了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130323
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130323,
					"content": "蘭帕卡提和哥哥們，都很感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130324
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130324,
					"content": "那就最好不過了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130325,
					"content": "不過，有件事情，我一直很好奇…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130326,
					"content": "「那菈法留納」到底是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130327
					]
				},
				{
					"id": 730130327,
					"content": "#{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}是我們的朋友。是桓那蘭那的朋友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130328
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130328,
					"content": "#在好久好久好久以前，蘭那羅的朋友。和那菈{NICKNAME}很像，是個金燦燦的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130329
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130329,
					"content": "原來如此。不過，我還有別的問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130330,
					"content": "關於「兄妹」的事情嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130331
					]
				},
				{
					"id": 730130331,
					"content": "嗯。蘭帕卡提的哥哥們，究竟誰最大、誰最小呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130332,
					"content": "嗯？大小？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130333,
						730130334
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130333,
					"content": "指年齡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130336
					]
				},
				{
					"id": 730130336,
					"content": "「年齡」…啊。蘭帕卡提知道了，就像樹的年輪。嗯，森林的孩子們，是不分「年齡」大小的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130337
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130337,
					"content": "欸？那「哥哥」和「妹妹」又是怎麼回事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130338,
					"content": "#這個啊。以前，我們有一個那菈朋友。那菈法留納。{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}說，{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}有一個「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130339
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130339,
					"content": "#蘭帕卡提和哥哥們聽{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_HE|INFO_FEMALE_PRONOUN_SHE]}說到那個「{PLAYERAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}」的時候，看起來都很幸福，又很難過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130340
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130340,
					"content": "所以，我們知道了。對「哥哥」來說，「妹妹」是很重要的那菈。對「妹妹」來說，「哥哥」是很重要的那菈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130341
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130341,
					"content": "我們覺得很好。所以，蘭帕卡提和哥哥們也決定，要變成「哥哥」和「妹妹」。那菈法留納說，這樣很好。要珍惜親人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130342
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130342,
					"content": "沒錯，一定要珍惜自己的親人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130343
					]
				},
				{
					"id": 730130343,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130344
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130344,
					"content": "我還有一件事情很在意…蘭那羅需要吃飯嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130345,
					"content": "人類會把食材做成菜餚，森林的孩子也可以把食材做成菜餚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130346
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130346,
					"content": "因為那菈法留納以前，教過我們，那菈吃東西的方法。蘭帕卡提和哥哥們，才會開始「烹飪修行」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130347
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130347,
					"content": "唔，還真是奇怪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130348,
						730130349
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130348,
					"content": "就像是在玩什麼遊戲一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130350,
					"content": "蘭帕卡提和哥哥們可是很認真的。因為，那菈法留納說過，能夠一起分享食物，是很幸福的事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130351
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130351,
					"content": "#對了，聽蘭阿帕斯哥哥說，那菈{NICKNAME}也會烹飪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130352
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130352,
					"content": "#嗯，{NICKNAME}的技術也是久經考驗的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130353
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130353,
					"content": "#這樣呀…無憂節的時候，那菈{NICKNAME}一定要來。陪不才的哥哥們烹飪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130354
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130354,
					"content": "讓他們再一次見到，只有那菈才明白、蘭那羅永遠不能明白的，真正的烹飪與菜餚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130355,
						730130356
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130355,
					"content": "到時候可別驚訝…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130357,
					"content": "蘭帕卡提會滿心期待的。這次無憂節，一定會很好、很厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130356,
					"content": "等我露一手給你看吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130357
					]
				},
				{
					"id": 730130349,
					"content": "就像是在扮家家酒一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130350
					]
				},
				{
					"id": 730130334,
					"content": "指尺寸…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130335
					]
				},
				{
					"id": 730130335,
					"content": "喂！才不是啦，是問年齡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130336
					],
					"speakerTitle": "派蒙"
				}
			]
		},
