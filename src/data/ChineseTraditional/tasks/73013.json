	"talks": [
		{
			"id": 7301301,
			"completionStepIds": [
				7301301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7301301",
							"2"
						],
						"stepId": 7301301,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"蘭帕卡提",
					"蘭羅摩",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730130101,
					"content": "呀！是金色的那菈。噫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130102
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130102,
					"content": "#蘭帕卡提不害怕。那菈{NICKNAME}是好那菈，和故事裡的那個那菈一樣。那菈{NICKNAME}和派蒙，幫助了大家許多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130103
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730130103,
					"content": "#嗯，不害怕了。蘭羅摩，蘭帕卡提相信{F#妳}{M#你}，也相信草、葉子和種子說的話，明白是好那菈。{F#妳}{M#你}們好，那菈{NICKNAME}和派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130104
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130104,
					"content": "蘭帕卡提，你好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130105,
						730130114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130105,
					"content": "其實我是壞人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130106
					]
				},
				{
					"id": 730130106,
					"content": "喂！別開這種玩笑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130107,
					"content": "不是的。蘭帕卡提知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130108
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130108,
					"content": "#很多風的地方，有小小的種子。它們和那菈一起來到桓那蘭那。它們說，那菈{NICKNAME}很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130109
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130109,
					"content": "之前蘭羅摩也說過類似的話呢！這麼說來，很多風的地方來的種子…是指蒲公英嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130110,
						730130111,
						730130112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130110,
					"content": "也可能是風車菊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130115,
					"content": "#那菈{NICKNAME}要幫助蘭拉娜，結出惟耶之實。所以，我們要一起為無憂節做準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130116
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730130116,
					"content": "哎呀呀…無憂節…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130117
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130117,
					"content": "蘭帕卡提的樣子好奇怪。有什麼煩惱的事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130118
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730130118,
					"content": "蘭帕卡提的「哥哥」們，一直沒有回到桓那蘭那。如果他們不回來，我們「兄妹」就不能一起過無憂節…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130119
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130119,
					"content": "我也很久沒在桓那蘭那遇到蘭茶荼、蘭薩卡、蘭阿帕斯和蘭非拉了。自從上次那次事情以後，就一直沒見到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130120
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730130120,
					"content": "很久…是有多久呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130121,
					"content": "那是很多很多個月亮以前。幼苗才剛剛鑽出土。到現在，幼苗已經長成了能為蘭那羅遮雨的大樹，有七個蘭帕卡提那麼高。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130122
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130122,
					"content": "從種子長成大樹…哇！那豈不是已經過去好久好久了！蘭帕卡提的哥哥們失蹤了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130123,
					"content": "「失蹤」？是一種種子嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130124
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130124,
					"content": "喔喔！原來那菈的種子，叫失蹤。好厲害！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130125
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730130125,
					"content": "#那菈好厲害！那菈{NICKNAME}一定有好多好多的失蹤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130126
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130126,
					"content": "不是這個意思啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130127,
						730130130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130127,
					"content": "「不知道到哪去了」的意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130128
					]
				},
				{
					"id": 730130128,
					"content": "噢。不是這樣的。蘭帕卡提知道蘭茶荼、蘭薩卡、蘭阿帕斯和蘭非拉在哪裡。所以，哥哥沒有失蹤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130129
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130129,
					"content": "他們到桓那蘭那外修行了好久好久。「烹飪修行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130136,
					"content": "原來如此，是「烹飪修行」嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130137,
					"content": "聽起來像是派蒙會感興趣的東西…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130138
					]
				},
				{
					"id": 730130138,
					"content": "#哼哼！派蒙對「{NICKNAME}的烹飪修行」更感興趣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130139,
					"content": "所以，「烹飪修行」究竟是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130140,
					"content": "那是上次無憂節的故事。那時候，那菈做了很多很多「菜餚」，給蘭那羅們品嚐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130141
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730130141,
					"content": "所以，蘭茶荼他們為了這次無憂節，能夠給那菈做「菜餚」，就一直在「烹飪修行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130142
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130142,
					"content": "…突然期待起無憂節了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130143,
						730130145
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130143,
					"content": "但那是蘭那羅的飯菜…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130144
					]
				},
				{
					"id": 730130144,
					"content": "美食是所有生物共同的語言！沒問題的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130146
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130146,
					"content": "不過，既然蘭帕卡提知道他們在哪，為什麼不自己去找呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130147
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130147,
					"content": "盛大的無憂節即將舉辦，蘭帕卡提也要做很多、很多的準備。沒有時間去找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130148
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130148,
					"content": "為了無憂節離開桓那蘭那烹飪修行。但是不知道無憂節快要到來。蘭茶荼、蘭薩卡、蘭阿帕斯、蘭非拉，笨蛋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130149
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130149,
					"content": "#那就交給我們吧！反正我們和蘭羅摩也要為無憂節做準備，找回森林裡的蘭那羅。對吧，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130150,
						730130151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130150,
					"content": "交給我們吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130152,
					"content": "可是我們要怎麼找到蘭茶荼、蘭…蘭什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130153
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130153,
					"content": "蘭茶荼、蘭薩卡、蘭阿帕斯、蘭非拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130154
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130154,
					"content": "嗚哇，一想到還有蘭拉娜、蘭羅摩、蘭拉迦、蘭帕卡提…蘭那羅的名字怎麼這麼難記！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130155,
					"content": "派蒙，不要說蘭那羅的名字不好。不然，蘭那羅會傷心的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130156
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730130156,
					"content": "好啦，我知道了。所以說，我們要怎麼找到他們呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130157
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130157,
					"content": "他們以前在桓那蘭那烹飪修行。結果，弄出好多好多煙。所以，蘭帕卡提把他們趕出去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130158
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730130158,
					"content": "當時，大家都好害怕，還有的蘭那羅嚇得休眠了。幸好蘭羅摩勇敢，懲罰了煙。蘭帕卡提很生氣，所以讓他們出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130159
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130159,
					"content": "在林子裡，看到<color=#00E1FFFF>嫋嫋升起的煙柱</color>，就能找到他們。應該吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130160
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130160,
					"content": "原來是你把他們攆走的喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130161
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130161,
					"content": "嗯。不對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130162
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130162,
					"content": "#倒也沒有啦…總之，{NICKNAME}，我們出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130163
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130163,
					"content": "啊。對了。還有一件事。如果哥哥們變得奇怪，就用<color=#00E1FFFF>草元素的力量</color>「啪嘰」他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130164
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130164,
					"content": "以前，他們弄出好多好多煙。整個桓那蘭那都是煙。他們也害怕，到處亂跑。有時候，如果碰到奇怪的蘑菇，也會變成那樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130165
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130165,
					"content": "但是，蘭那羅是草木的精靈。所以，只要吸收<color=#00E1FFFF>草元素的力量</color>，就能恢復、清醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130166
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130166,
					"content": "#我明白了。{NICKNAME}只要吃甜甜花釀雞，就能恢復。所以是甜甜花釀雞的精靈。嗯！很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130167,
						730130171
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130167,
					"content": "？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130168
					]
				},
				{
					"id": 730130168,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130169
					],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730130169,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130170
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130170,
					"content": "…總之，我們出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130172
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130172,
					"content": "#那菈{NICKNAME}和派蒙加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "蘭羅摩"
				},
				{
					"id": 730130171,
					"content": "總之，出發吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130172
					]
				},
				{
					"id": 730130151,
					"content": "哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130152
					]
				},
				{
					"id": 730130145,
					"content": "好期待！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130146
					]
				},
				{
					"id": 730130130,
					"content": "我明白你的心情…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130131
					]
				},
				{
					"id": 730130131,
					"content": "#那菈{NICKNAME}也明白我的心情？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130132
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130132,
					"content": "#嗯，{NICKNAME}也有失散的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130133,
					"content": "#噢。那菈{NICKNAME}的{MATEAVATAR#SEXPRO[INFO_MALE_PRONOUN_BROTHER|INFO_FEMALE_PRONOUN_SISTER]}也去「烹飪修行」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130134
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130134,
					"content": "欸？感覺有些地方搞錯了…失蹤就是，「不知道到哪去了」的意思！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130135,
					"content": "噢。不是這樣的。蘭帕卡提知道哥哥們沒有失蹤。他們到桓那蘭那外修行了好久好久。「烹飪修行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130136
					],
					"speakerTitle": "蘭帕卡提"
				},
				{
					"id": 730130111,
					"content": "也可能是松果。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				},
				{
					"id": 730130112,
					"content": "難道是風帶來了故事的種子…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130113
					]
				},
				{
					"id": 730130113,
					"content": "？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730130115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730130114,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730130115
					]
				}
			]
		},
		{
			"id": 7301302,
