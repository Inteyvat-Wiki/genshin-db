				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲利特",
					"帕慕克",
					"派蒙",
					"奧爾罕",
					"謝夫凱特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231601,
					"content": "#{F#妳}{M#你}們乾淨俐落地解決了盜寶團。\\n菲利特和帕慕克也趕到了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231602
					]
				},
				{
					"id": 730231602,
					"content": "老大！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231603
					],
					"speakerTitle": "菲利特"
				},
				{
					"id": 730231603,
					"content": "不好意思，我們稍微來遲了一點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231604
					],
					"speakerTitle": "帕慕克"
				},
				{
					"id": 730231604,
					"content": "什麼叫來遲了一點啊，事情都結束了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231605,
					"content": "哎呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231606
					],
					"speakerTitle": "菲利特"
				},
				{
					"id": 730231606,
					"content": "你們到底跑到哪裡去了！找也找不到…哇，怎麼還滿身酒氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231607
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231607,
					"content": "嘿嘿，這個，傳播消息最好的方法，不就是假裝喝醉酒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231608
					],
					"speakerTitle": "菲利特"
				},
				{
					"id": 730231608,
					"content": "然後再說出假消息嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231609
					],
					"speakerTitle": "帕慕克"
				},
				{
					"id": 730231609,
					"content": "根本就是真的喝醉了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231610
					]
				},
				{
					"id": 730231610,
					"content": "#你們兩個…要不是有{NICKNAME}在，說不定我就得被盜寶團痛毆一頓了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231611
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231611,
					"content": "#不過沒想到，{NICKNAME}居然這麼輕鬆就把盜寶團的人全都打倒了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231612
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231612,
					"content": "#那是當然了，{NICKNAME}可是很厲害的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231613,
					"content": "#難怪，雖然之前想要阻止{F#妳}{M#你}們的時候也被{F#妳}{M#你}們輕鬆撂倒，但是這…可有點超出我的想像了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231614,
						730231615
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231614,
					"content": "過獎了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231616
					]
				},
				{
					"id": 730231616,
					"content": "#好了，謝夫凱特，現在你倚仗的盜寶團已經被我們…被{NICKNAME}打趴下了，你現在還有什麼話說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231617
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231617,
					"content": "我、我…其實我現在盜獵這麼多的動物，都是因為一次兒時的心理創傷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231618
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231618,
					"content": "你們聽我說…那是在我還是個小男孩的時候…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231619,
						730231620
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231619,
					"content": "誰要聽你說啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231621
					]
				},
				{
					"id": 730231621,
					"content": "#好了，把這傢伙抓住，{F#妳}{M#你}們被蠱惑狩獵暝彩鳥的事就一筆勾銷啦。下次啊，還是好好選擇聽信的對象吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231622
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231622,
					"content": "要是當時一開始能聽我說話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231623
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231623,
					"content": "什麼呀，你當時直接就打過來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231624
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231624,
					"content": "說的也是…我一著急就會那樣，看來下次還是得冷靜一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231625
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231625,
					"content": "#不過我可不希望還有下次了，{F#妳}{M#你}們也得小心一些，也不能誰說的話都相信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231626
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231626,
					"content": "知道啦！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231627
					]
				},
				{
					"id": 730231627,
					"content": "我們以後會注意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231628
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231628,
					"content": "奧爾罕押著謝夫凱特離開了…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				},
				{
					"id": 730231620,
					"content": "別編故事了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231621
					]
				},
				{
					"id": 730231615,
					"content": "再誇我就要得意忘形了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231616
					]
				}
			]
