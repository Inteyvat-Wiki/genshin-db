	"talks": [
		{
			"id": 7302301,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": []
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"謝夫凱特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230101,
					"content": "#啊，剛剛狩獵了那隻背上長蘑菇的山豬的那位…能過來一下嗎，我有件事和{F#妳}{M#你}商量！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "謝夫凱特"
				}
			]
		},
		{
			"id": 7302303,
			"completionStepIds": [
				7302303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302303",
							"2"
						],
						"stepId": 7302303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"謝夫凱特",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230301,
					"content": "#哎呀，兩位啊，打擾{F#妳}{M#你}們真是不好意思，但是在下有一事相商…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230302
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230302,
					"content": "#不知道{F#妳}{M#你}們剛才狩獵蕈豬之後得到的豬肉，能不能給我一份啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230303
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230303,
					"content": "蕈豬…你是說剛才那種背上長蘑菇的山豬嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730230304,
					"content": "對對對，就是這種背上長蘑菇的山豬。這種山豬經常在須彌的泥塘中打滾，就會有孢子黏在它們的毛髮上，長成蘑菇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230305
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230305,
					"content": "哈哈，也有傳言說蘑菇在生長的過程中逐漸掏空了山豬的身體…而蕈豬的豬肉因此有了特殊的蘑菇香氣，價格高昂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230306,
						730230307
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230306,
					"content": "有點嚇人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230308
					]
				},
				{
					"id": 730230308,
					"content": "哈哈，不過只是一種傳言而已啦，蕈豬背上的蘑菇可供它們在冬天或者無食物時互相啃食充飢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230309
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230309,
					"content": "而蘑菇則可以透過移動的山豬，將孢子傳到更多的地方…其實是這樣健康的共生關係…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230310
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230310,
					"content": "啊啊，不好意思，我好像還沒有自我介紹，我叫謝夫凱特，兩位是？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230311
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230311,
					"content": "我叫派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730230312,
					"content": "#我叫{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230313
					]
				},
				{
					"id": 730230313,
					"content": "#原來如此，{NICKNAME}和派蒙，我記住了。剛才看到兩位狩獵蕈豬的身姿那般矯捷，我就知道並非常人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230314
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230314,
					"content": "實不相瞞，我正在做一些野外生物相關的研究，但是呢，唉，我根本抓不到那些蕈豬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230315
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230315,
					"content": "我只要一靠近，這些傢伙要不就是立刻跑遠，要不就是把我一頭撞倒在地…這樣下去，研究還沒開始，我的腰就要先報銷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230316
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230316,
					"content": "所以，看到兩位如此輕鬆就解決了蕈豬，我就斗膽打擾，能不能收購被打倒的蕈豬的肉呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230317
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230317,
					"content": "這個肉有什麼特殊嗎？看起來和普通的山豬肉也沒什麼差別…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730230318,
					"content": "哎呀，有沒有差別，肯定得要進行調查之後才能知道！賣給我吧，我一定能給出足夠的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230319
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230319,
					"content": "（將蕈豬的肉交出…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230320
					]
				},
				{
					"id": 730230320,
					"content": "#啊，這真是太感謝{F#妳}{M#你}了，這樣我就能繼續我的調查了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230321
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230321,
					"content": "謝夫凱特在進行的，究竟是什麼樣的調查啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730230322,
					"content": "只是些普通的生態調查，有的時候會捕獵一些動物，調查那些動物的生長狀況…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230323
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230323,
					"content": "有時候僅僅一個個體，就能夠看出一段時間內整個群體的生長狀態，是非常神奇的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230324
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230324,
					"content": "看出來了，謝夫凱特真的很喜歡動物呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730230325,
					"content": "對，我…我一直都很喜歡牠們，我花了很長時間研究牠們呢，須彌森林裡的生態，是非常令人著迷的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230326
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230326,
					"content": "好，蕈豬的肉解決了，接下來就是「暝彩鳥」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230327
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230327,
					"content": "#{NICKNAME}，{F#妳}{M#你}們見過暝彩鳥嗎？那是一種經常出沒在<color=#00E1FFFF>水天叢林南部</color>的非常漂亮的鳥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230328
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230328,
					"content": "那也是須彌特有的鳥類，就連教令院的學者也經常用牠們傳遞資訊…雖然能長途飛行，卻討厭雨水，下雨天的時候就會躲起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230329
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230329,
					"content": "好了，我也該走了。暝彩鳥啊，希望我自己一個人就能抓住一隻吧…哈哈，總是依賴別人也不行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230330
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230330,
					"content": "#不過，如果{F#妳}{M#你}們願意的話，咳咳，也希望能幫我留意一下吧，如果能捉到暝彩鳥，我也願意收購。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230307,
					"content": "有點可怕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230308
					]
				}
			]
		},
		{
			"id": 7302308,
			"completionStepIds": [
				7302308
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302308",
							"2"
						],
						"stepId": 7302308,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"謝夫凱特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730230801,
					"content": "咦，你是那個，「調查人」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730230802,
					"content": "#調查人是什麼呀…哈哈，我的名字是謝夫凱特，之前不是見過一面嗎，{F#妳}{M#你}還把蕈豬的肉賣給我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230803,
						730230805
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230803,
					"content": "是嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230804
					]
				},
				{
					"id": 730230804,
					"content": "對！他還給了我們比普通山豬肉多了很多的報酬呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230807
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730230807,
					"content": "說起來，謝夫凱特，你怎麼在這裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230808
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730230808,
					"content": "哈哈哈說來慚愧，我這不是還在繼續我的調查嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230809
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230809,
					"content": "我的調查需要暝彩鳥，但是一隻都沒有抓住…調查進度真是堪憂。抓不住鳥也就算了，沒想到還…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230810
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230810,
					"content": "沒想到還？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230811
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730230811,
					"content": "還遇到了鍍金旅團，那些人二話不說就拿著武器向我招呼過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230812
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230812,
					"content": "是嗎？這麼說來之前鍍金旅團的傢伙好像把我們認成你…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230813
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730230813,
					"content": "欸？是嗎…哈哈，還有這種事，想必是因為…對，肯定是因為我保護暝彩鳥的行為不被他們理解…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230814
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230814,
					"content": "哎呀，鍍金旅團那些人肯定將這片森林裡的暝彩鳥視作他們自己的財富了吧，才會敵視我這樣採集樣本的調查行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230815
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230815,
					"content": "畢竟暝彩鳥的羽毛也是價格相當昂貴的商品…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230816
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230816,
					"content": "#對了，{F#妳}{M#你}們知道嗎？暝彩鳥啊，是為了能夠在森林中潛藏起自己的身形，所以才會生長出這樣斑斕的顏色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230817
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230817,
					"content": "結果，很多人都為了這絢爛多彩的羽毛捕獵牠，真是可悲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230818
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230818,
					"content": "真是可憐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730230819,
					"content": "#面對鍍金旅團的時候，我可沒辦法像{F#妳}{M#你}們那麼勇敢…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230820
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230820,
					"content": "#對了，關於{F#妳}{M#你}們打下來的暝彩鳥的羽毛，能夠賣給我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230821
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230821,
					"content": "跟上次一樣，我會給出足夠豐厚的報償的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230822
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230822,
					"content": "（將暝彩鳥的羽毛交出……）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230823
					]
				},
				{
					"id": 730230823,
					"content": "哈哈，暝彩鳥的羽毛也到手了…這下子，這下子我的調查已經完成了大半了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230824
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230824,
					"content": "不過，這羽毛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230825
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230825,
					"content": "怎麼了，難道這羽毛有什麼問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230826
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730230826,
					"content": "不，這羽毛沒有問題，只是品相有點差…喔我是說，能夠看得出來，在這個區域的暝彩鳥生長狀況似乎不是很好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230827
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230827,
					"content": "看來得去不同的地方，多收集一些暝彩鳥的羽毛，這樣才能知道暝彩鳥整體的種群到底發生了什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230828
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230828,
					"content": "聽說<color=#00E1FFFF>水天叢林北部</color>有不同的暝彩鳥族群，看來還得去那裡看看有沒有暝彩鳥的蹤跡啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230829
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230829,
					"content": "#嗯，看來我又得出發了！有緣再見吧，{NICKNAME}和派蒙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730230805,
					"content": "好像確實有這麼回事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730230806
					]
				},
				{
					"id": 730230806,
					"content": "嗯，想起來了，喜歡動物的謝夫凱特！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730230807
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7302312,
			"completionStepIds": [
				7302312
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302312",
							"2"
						],
						"stepId": 7302312,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奧爾罕",
					"派蒙",
					"帕慕克"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231201,
					"content": "#住手！住手！{F#妳}{M#你}們怎麼又在這裡隨意狩獵暝彩鳥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231202
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231202,
					"content": "#好啊，果然！{F#妳}{M#你}們就是最近流竄作案的盜獵者！{F#妳}{M#你}們又狩獵我的暝彩鳥！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231203
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231203,
					"content": "哼，暝彩鳥才不是你的呢！難道是你飼養了這些暝彩鳥嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231204,
					"content": "倒也不是，但是，我的暝彩鳥，那就是我的暝彩鳥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231205
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231205,
					"content": "那是我負責看守的暝彩鳥啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231206
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231206,
					"content": "負責看守？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231207,
					"content": "是啊，我叫奧爾罕，可是奉三十人團之命，在這裡看守暝彩鳥的聚集地免受偷獵者侵擾的看守！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231208
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231208,
					"content": "不信？不信就看看這個三十人團治安官簽署的命令書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231209
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231209,
					"content": "奧爾罕展示了書信，確實由三十人團所簽署。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231210
					]
				},
				{
					"id": 730231210,
					"content": "咦，這和聽說的不一樣…最近不是有捕獲暝彩鳥進行生態調查的活動嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231211,
					"content": "哪有這種活動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231212
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231212,
					"content": "…難道謝夫凱特騙了我們嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231213,
					"content": "#謝夫凱特…怎麼又是謝夫凱特。小草神在上，{F#妳}{M#你}們啊，完完全全被這傢伙騙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231214
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231214,
					"content": "這傢伙，經常穿成巡林員的樣子騙人，實際上是個和盜寶團合作的混蛋，聯手轉賣珍稀動物身上的素材…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231215
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231215,
					"content": "怎麼會這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231216,
						730231217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231216,
					"content": "事到如今不得不承認…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231218
					]
				},
				{
					"id": 730231218,
					"content": "被他騙的冒險家也不是一個兩個了。這傢伙一直唆使冒險家出手，自己卻躲在他們身後，就跟陸鰻鰻一樣難抓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231219
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231219,
					"content": "#怎麼辦，{NICKNAME}，我們好像已經狩獵了好幾隻暝彩鳥了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231220,
						730231223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231220,
					"content": "希望牢飯營養均衡…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231221
					]
				},
				{
					"id": 730231221,
					"content": "不要啊，我才不要被三十人團關起來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231222
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231222,
					"content": "#…沒那麼嚴重啦。畢竟暝彩鳥族群還是很龐大，不是什麼特別的稀有種，{F#妳}{M#你}們也不知情，所以不會嚴重到會被關起來的程度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231228
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231228,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231229,
					"content": "「不過該有的罰款可是一分也不能少」…雖然本來想這麼說，但是，咳咳，眼下正有一個給兩位的戴罪立功的機會！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231230
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231230,
					"content": "戴罪立功的機會？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231231
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231231,
					"content": "對，雖然不知道為什麼，但是謝夫凱特似乎需要大量的暝彩鳥羽毛…我們可以把他引出來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231232
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231232,
					"content": "比如我們散佈…「在<color=#00E1FFFF>水天叢林東邊</color>的山上，有大量暝彩鳥棲息」的消息，他一定會上鉤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231233
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231233,
					"content": "但是這人極其狡猾，我們稍有行動就容易打草驚蛇，這個時候就需要兩位啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231234
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231234,
					"content": "#嗯…剛才好像聽到，金髮的叫{NICKNAME}吧，小飛人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231235
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231235,
					"content": "我叫派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231236,
					"content": "#嗯，{NICKNAME}和派蒙，我需要{F#妳}{M#你}們幫忙，去接觸謝夫凱特。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231237
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231237,
					"content": "我懂了，他看見我們以後就會稍微放鬆警惕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231238,
					"content": "#正是如此。我們會提前埋伏好，就靠{F#妳}{M#你}來把他拖住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231239
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231239,
					"content": "#{F#妳}{M#你}遇到他以後…這樣，就大聲說「你做的一切我們都知道了！」就以這個為暗號，我們就出來把他抓住！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231240
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231240,
					"content": "怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231241
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231241,
					"content": "沒有問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231242
					]
				},
				{
					"id": 730231242,
					"content": "說幹就幹，我們這就去傳播消息。須彌城就交給我，菲利特，你去化城郭，正好可以試探一下那邊是不是有人和盜寶團勾結。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231243
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231243,
					"content": "帕慕克，維摩莊附近…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231244
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231244,
					"content": "我知道了，老大，我散佈假消息，您放心！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231245
					],
					"speakerTitle": "帕慕克"
				},
				{
					"id": 730231245,
					"content": "好啊，這次，一定能把那個偷獵的混蛋繩之以法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231246
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231246,
					"content": "#拜託{F#妳}{M#你}了，{NICKNAME}，我們一定要把那個傢伙給引出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231223,
					"content": "現在逃出須彌還來得及？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231224
					]
				},
				{
					"id": 730231224,
					"content": "沒辦法了，還沒有探索的須彌的區域，只能以後再來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231225,
					"content": "我可不能眼睜睜看著兩位從我面前逃走，更何況，為了應對最近變得愈加猖狂的盜獵行為，這附近已經全是三十人團的人啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231226
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231226,
					"content": "不要啊，我才不要被三十人團關起來！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231227
					]
				},
				{
					"id": 730231227,
					"content": "#…沒必要那麼緊張。畢竟暝彩鳥族群還是很龐大，不是什麼特別的稀有種，{F#妳}{M#你}們也不知情，所以不會嚴重到會被關起來的程度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231228
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231217,
					"content": "果然被謝夫凱特騙了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231218
					]
				}
			]
		},
		{
			"id": 7302314,
			"completionStepIds": [
				7302314
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7302314",
							"2"
						],
						"stepId": 7302314,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"謝夫凱特",
					"派蒙",
					"奧爾罕"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 730231401,
					"content": "#哎呀，這不是{NICKNAME}和派蒙嘛…{F#妳}{M#你}們出現在了這裡，一定也聽說了附近有暝彩鳥棲息地的消息吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231402
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231402,
					"content": "這並不是常見的暝彩鳥會喜歡的環境，到底為什麼會在這裡棲息…這說不定是值得研究的課題呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231403
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231403,
					"content": "謝夫凱特…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231404,
					"content": "#哈哈，怎麼了？對了，{F#妳}{M#你}們肯定是想問我還收不收暝彩鳥的羽毛吧，當然了，暝彩鳥的羽毛可是很珍貴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231405
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231405,
					"content": "「你做的一切我們都知道了！」",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231406
					]
				},
				{
					"id": 730231406,
					"content": "……？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231407
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231407,
					"content": "為什麼突然說這個，怎麼了，是為我進行這些調查感到辛苦嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231408
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231408,
					"content": "#（咦怎麼回事，怎麼鍍金旅團的人沒出來，之前明明跟奧爾罕說好了…{NICKNAME}，不如我來試一試吧。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231409,
					"content": "「你做的一切我們都知道了！」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231410,
					"content": "#怎麼連派蒙也…欸呀，沒關係，這都是我應該做的，更何況，過程中，{F#妳}{M#你}們也幫助了我許多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231411
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231411,
					"content": "雖然調查的過程確實很艱難，但是這一切都是有意義的，這都是為了森林裡的動物們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231412
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231412,
					"content": "這才不是為了森林裡的動物們，是為了你自己吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231413,
					"content": "你做的一切我們都已經知道了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231414
					]
				},
				{
					"id": 730231414,
					"content": "話音剛落，奧爾罕便從林間匆忙走出…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						730231415
					]
				},
				{
					"id": 730231415,
					"content": "對，謝夫凱特，三十人團正式以假冒巡林員，唆使不明情況冒險家盜獵，與盜寶團勾結等等罪名，將你逮捕！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231416
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231416,
					"content": "什麼呀，奧爾罕，你怎麼才來，剛才我們暗號喊得嗓子都啞了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231417,
					"content": "這個，出了點意外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231418
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231418,
					"content": "鍍金旅團的人怎麼會出現在這？暗號？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231419
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231419,
					"content": "「我做的一切你們都知道了！」原來是這個意思，虧我剛才還有點感動呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231420
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231420,
					"content": "大騙子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231421,
					"content": "束手就擒吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231422
					]
				},
				{
					"id": 730231422,
					"content": "#啊，我該想到的，{F#妳}{M#你}們早就和鍍金旅團…哼，這裡有暝彩鳥的消息，也是你們放出來的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231423
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231423,
					"content": "正是如此，你中計了謝夫凱特，整天騙人的你沒想到會有被騙的一天吧！三十人團會好好懲罰你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231424
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231424,
					"content": "…唉，事到如今，也沒什麼好狡辯的了。我很喜歡須彌的動物，但是有的時候只有喜歡是沒有什麼用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231425
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231425,
					"content": "我沒能進入教令院，每天做些不入流的調查。到最後，在旁人眼裡，也只不過是個總在森林裡遊蕩的怪人罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231426
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231426,
					"content": "我需要摩拉…不管是為了調查，還是為了封住那些背後說我閒話的人的嘴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231427
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231427,
					"content": "所以就對自己最瞭解的這些動物下手了？哼，因為瞭解這些動物，反而造成了更大的損傷，還真是了不起啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231428
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231428,
					"content": "這些都是不得已而為之…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231429
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231429,
					"content": "你就不用在這裡賣弄你的口舌了！我是不會相信你的鬼話的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231430
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231430,
					"content": "大騙子終於落入法網啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231431,
					"content": "說起來，奧爾罕，你之前為什麼來得那麼晚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231432,
					"content": "啊，這個…菲利特和帕慕克一直沒有回來，我去找也找不到，思前想後，我就一個人先到這裡來了，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231433
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231433,
					"content": "這時機不是很剛好嗎？這就是所謂的來得早不如來得巧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231434,
						730231435
					],
					"speakerTitle": "奧爾罕"
				},
				{
					"id": 730231434,
					"content": "聽起來真不可靠…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231436
					]
				},
				{
					"id": 730231436,
					"content": "哼哼…什麼呀，我還以為有很多鍍金旅團的人埋伏在附近呢。原來就只來了一個人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231437
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231437,
					"content": "本來還想佯裝被捕，再伺機逃走，呵，現在看來根本沒有這個必要嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231438
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231438,
					"content": "咦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231439
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 730231439,
					"content": "#不會吧，{F#妳}{M#你}們不會以為就靠{F#妳}{M#你}們和…這麼一個鍍金旅團的小卒子，就能抓住我？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231440
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231440,
					"content": "#算{F#妳}{M#你}們運氣不好，今天正好是我和盜寶團約定交貨的日子，所以他們就埋伏在旁邊。可不只有{F#妳}{M#你}們會喊人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						730231441
					],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231441,
					"content": "快，把這些人給解決了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "謝夫凱特"
				},
				{
					"id": 730231435,
					"content": "再晚一點就不用你登場了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						730231436
					]
				}
			]
		},
		{
			"id": 7302316,
			"completionStepIds": [
				7302316
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
