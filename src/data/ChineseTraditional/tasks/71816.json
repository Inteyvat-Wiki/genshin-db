						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_ITEM_GIVING_ACTIVED",
						"rawParams": [
							"7181606"
						]
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181610",
							"2"
						],
						"stepId": 7181610,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"黃衫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160501,
					"content": "#我和弗朗西斯聯絡過了，那批貨物他已經收到，多虧了{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160502
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160502,
					"content": "什麼時候聯絡的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160503
					]
				},
				{
					"id": 718160503,
					"content": "哈哈，不用在意，我們鏢師的腳程比一般人快不少，交接事務嘛…自然也快不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160504
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160504,
					"content": "#這趟多虧{F#妳}{M#你}幫忙，幹活拿報酬是天經地義，我也不會虧待{F#妳}{M#你}的。{F#妳}{M#你}稍等一下啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160505
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160505,
					"content": "海燈節也不休息嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160506
					]
				},
				{
					"id": 718160506,
					"content": "幹我們這行的，生意一時有一時無，海燈節也回不了家，沒辦法嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160507
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160507,
					"content": "#{F#妳}{M#你}是在四處旅行吧，大家在海燈節的時候都會放霄燈，{F#妳}{M#你}也可以體驗體驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160508,
						718160510
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160508,
					"content": "那你呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160509
					]
				},
				{
					"id": 718160509,
					"content": "每年都在外面跑，我倒幾乎沒什麼閒工夫放過霄燈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160512
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160512,
					"content": "要是有現成的，放一盞博個好彩頭也不錯，可惜我是沒空自己編霄燈了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160513
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160513,
					"content": "雖然少了點節日氣氛，但也無所謂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160514,
						718160515
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160514,
					"content": "我來幫你準備一盞吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160516
					]
				},
				{
					"id": 718160516,
					"content": "#咦？{F#妳}{M#你}要幫我準備霄燈嗎？{F#妳}{M#你}倒是個熱心的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160515,
