			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"黃衫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160101,
					"content": "這叫我怎麼送得過來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160102
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160103
					]
				},
				{
					"id": 718160103,
					"content": "#是旅行者吧，這時候來璃月正好能趕上海燈節，{F#妳}{M#你}運氣不錯，但是我就沒法開心了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160104
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160104,
					"content": "我們璃月人有海燈節放霄燈的傳統，所以每年這時候霄燈材料的貨運量都很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160105
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160105,
					"content": "不知道是不是我的錯覺，今年貨運量好像比往年還多了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160106
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160106,
					"content": "我一個人還真有些忙不過來，這個客商還是個不瞭解璃月路況的楓丹客商，一直在催…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160107
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160107,
					"content": "#我有心請人幫把手，又一直找不到合適的人選，{F#妳}{M#你}願不願意來幫忙走一趟鏢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160108,
						718160111
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160108,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160109
					]
				},
				{
					"id": 718160109,
					"content": "#好！我就喜歡爽快的人，要是接鏢的那位也能像{F#妳}{M#你}這麼爽利就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160110
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160110,
					"content": "那位的名字叫什麼來著，好像是弗朗…弗朗西斯來著，外國人的名字我實在念不來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160115,
					"content": "#{F#妳}{M#你}願意幫忙的話，就請{F#妳}{M#你}到存放貨物的地方和我碰面吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160116
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160116,
					"content": "#具體地點我已經幫{F#妳}{M#你}標在地圖上了，那我先行一步，我們稍後見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160111,
					"content": "楓丹客商？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718160112
					]
				},
				{
					"id": 718160112,
					"content": "沒錯，叫什麼…弗郎…弗朗西斯，外國人名字真是難念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160113
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160113,
					"content": "也不知道他訂這麼大一批霄燈材料要幹嘛，不過…人家出錢，我出力嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160114
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160114,
					"content": "#放心，{F#妳}{M#你}幫了忙之後，報酬肯定也少不了{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160115
					],
					"speakerTitle": "黃衫"
				}
			]
		},
		{
			"id": 7181602,
			"completionStepIds": [
				7181603
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181603",
							"2"
						],
						"stepId": 7181603,
						"stateName": "QUEST_STATE_UNFINISHED"
