				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7181605",
							"2"
						],
						"stepId": 7181605,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"法蘭西斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160401,
					"content": "這是…我訂的貨物，噢天哪，終於送到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160402
					],
					"speakerTitle": "法蘭西斯"
				},
				{
					"id": 718160402,
					"content": "#看{F#妳}{M#你}的裝束，運貨的這位朋友，{F#妳}{M#你}也不是璃月本地人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160403
					],
					"speakerTitle": "法蘭西斯"
				},
				{
					"id": 718160403,
					"content": "#親愛的朋友，不知道{F#妳}{M#你}有沒有嘗試過璃月美食，那簡直是太美妙了，相信我，{F#妳}{M#你}真該去試試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160404
					],
					"speakerTitle": "法蘭西斯"
				},
				{
					"id": 718160404,
					"content": "好了，現在這批貨也到了，我可以先放心去享受美食了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法蘭西斯"
				}
			]
		},
		{
			"id": 7181605,
			"completionStepIds": [
				7181610
			],
			"beginWay": "TALK_BEGIN_MANUAL",
