				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"黃衫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718160201,
					"content": "#這裡就是存放貨物的地方了，畢竟是麻煩{F#妳}{M#你}幫忙，{F#妳}{M#你}只要押送這一輛貨運熱氣球就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160202
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160202,
					"content": "#不過我得提醒{F#妳}{M#你}，這些貨都是製作霄燈的原材料，相當脆弱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160203
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160203,
					"content": "絕對不能弄壞或者燒到了，路上務必小心謹慎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160204
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160204,
					"content": "#這條道路上，時不時有魔物和盜寶團的傢伙經過，{F#妳}{M#你}得多防備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718160205
					],
					"speakerTitle": "黃衫"
				},
				{
					"id": 718160205,
					"content": "#那就由{F#妳}{M#你}押這趟鏢了，一路安全送到弗朗西斯手上就好，事畢之後，我們在吃虎岩西南邊的橋外見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "黃衫"
				}
			]
		},
