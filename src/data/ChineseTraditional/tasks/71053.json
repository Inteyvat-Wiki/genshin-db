			"dialogs": [
				{
					"id": 710501401,
					"content": "先不說其他的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501402
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501402,
					"content": "#在層岩巨淵的這幾天，{F#妳}{M#你}做了很多，我都不知道應該怎麼感謝{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501403
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501403,
					"content": "#如果再給{F#妳}{M#你}錢，也實在是太過生分了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501404
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501404,
					"content": "其實你一定要給的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710501405
					]
				},
				{
					"id": 710501405,
					"content": "#別開玩笑了，我怎麼能做出給{F#妳}{M#你}一筆錢了事，這種不解風情的行為。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501406
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501406,
					"content": "#那不是在汙辱{F#妳}{M#你}嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501407
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501407,
					"content": "#來，收好這封信吧，如果{F#妳}{M#你}以後有機會去須彌，遇到了什麼麻煩，或有什麼需要幫助的，那就拿著這封信找普爾比魯尼一門的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501408
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501408,
					"content": "#我們一定會盡全力幫助{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501409
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501409,
					"content": "「往來的人情，比黃金還寶貴。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710501410
					],
					"speakerTitle": "海迪夫"
				},
				{
					"id": 710501410,
					"content": "這句須彌諺語，說的就是這樣的情形吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "海迪夫"
				}
			]
		}
	]
