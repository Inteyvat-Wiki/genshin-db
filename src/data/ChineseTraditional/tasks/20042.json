				{
					"id": 200420101,
					"content": "…真是麻煩，到底躲哪去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420102
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200420102,
					"content": "妳在找什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200420103
					]
				},
				{
					"id": 200420103,
					"content": "找？哦…我正在找一個可疑的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420104
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200420104,
					"content": "那個叫艾伯特的男人，白天一直鬼鬼祟祟地在教堂附近打轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420105
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200420105,
					"content": "看起來就不懷好意，我擔心他在預謀什麼可怕的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200420106
					],
					"speakerTitle": "維多利亞"
				},
				{
					"id": 200420106,
					"content": "#{F#妳}{M#你}能去把艾伯特趕走嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "維多利亞"
				}
			]
		},
