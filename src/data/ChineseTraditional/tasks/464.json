				"points": []
			},
			"dialogs": [
				{
					"id": 4640101,
					"content": "#原來{F#妳}{M#你}也是那種愛湊熱鬧的性格啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640102
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640102,
					"content": "不得不說，最近來光顧的客人確實都在談論…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640103
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640103,
					"content": "與其說是「熱門話題」，不如說是「都市傳說」一類的東西吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640104
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640104,
					"content": "即使我沒有刻意去聽，耳朵也快聽出繭來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640105
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640105,
					"content": "不會…不會是什麼可怕的傳說吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640106,
					"content": "先、先給我一點心理準備！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640107,
					"content": "可怕倒沒什麼可怕的，至少對絕大部分的人來說是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640108
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640108,
					"content": "…是被稱為「暗夜英雄」的人的傳說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640109
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640109,
					"content": "哇！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640110,
						4640113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640110,
					"content": "派蒙，這好像並不可怕吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640111
					]
				},
				{
					"id": 4640111,
					"content": "唔嗯，剛才酒保先生說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640112,
					"content": "原來妳根本沒在聽啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640116
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640116,
					"content": "我在說「暗夜英雄」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640117
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640117,
					"content": "傳聞中只有在午夜時分才會出現，懲惡揚善的神秘人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640118
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640118,
					"content": "不過老實說，這種傳說我沒什麼興趣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640119
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640119,
					"content": "除非他能幫忙治理一下半夜醉酒鬧事的酒客…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640120
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640120,
					"content": "那我還是很願意承認他存在的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640121,
						4640125
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640121,
					"content": "有人見過「暗夜英雄」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640122
					]
				},
				{
					"id": 4640122,
					"content": "據說是有過幾個目擊者的，可是在夜裡沒辦法看清楚他的樣貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640123
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640123,
					"content": "可能這就是他只在夜裡現身的理由吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640124
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640124,
					"content": "但至少證明「暗夜英雄」的傳說不是空穴來風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640129
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640129,
					"content": "和酒館裡常見的一些伎倆差不多？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640130
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640130,
					"content": "總而言之，我知道的大概就是這些了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640131
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640131,
					"content": "感興趣的話不如去廣場上再打聽打聽，別耽誤了其他客人點單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640132
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640132,
					"content": "「暗夜英雄」呀，像是每個城市都會流傳的那種故事呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640133,
					"content": "只是他稍微顯得有些…陰暗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640134,
					"content": "到底會是個怎麼樣的人呢，有空去<color=#00E1FFFF>廣場</color>上再問問看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640125,
					"content": "為什麼他要隱藏身分呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640126
					]
				},
				{
					"id": 4640126,
					"content": "這個問題可能只有他自己知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640127
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640127,
					"content": "或許單純只是喜歡保持這份神秘感也說不定…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640128
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640128,
					"content": "畢竟那樣的人比較討女人歡心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640129
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640113,
					"content": "哇哇！！！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640114
					]
				},
				{
					"id": 4640114,
					"content": "喂，妳們啊，到底有沒有在聽我說什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640115
					],
					"speakerTitle": "查爾斯"
				},
				{
					"id": 4640115,
					"content": "唔嗯，剛才酒保先生說什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640116
					],
					"speakerTitle": "派蒙"
				}
			]
		},
