			},
			"dialogs": [
				{
					"id": 4640501,
					"content": "#儘管繞開了衛兵的巡邏路線…卻沒想到，會在這裡撞上{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640502,
						4640503
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640502,
					"content": "我早猜到了，你就是暗夜英雄！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640504
					]
				},
				{
					"id": 4640504,
					"content": "#「暗夜英雄」？…這種俗套到不行的名字，難道是{F#妳}{M#你}起的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640505
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640505,
					"content": "咦？你自己居然沒聽說過嗎？整個蒙德都在談論「暗夜英雄」呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640506
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640506,
					"content": "無聊的傳言…也罷，算是和平的證明吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640507
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640507,
					"content": "嘿嘿~這下「暗夜英雄」之謎終於解開啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640508,
					"content": "所以說，「暗夜英雄」先生…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640509
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640509,
					"content": "…好了，別用那個名字叫我了，感覺很不自在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640510
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640510,
					"content": "沒錯。「暗夜英雄」太土了！應該換一個更充滿羅曼蒂克氣息的稱號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640552
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640552,
					"content": "嗯…嗯……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640553
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640553,
					"content": "正…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640554
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640554,
					"content": "正？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640555
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640555,
					"content": "正？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640556
					]
				},
				{
					"id": 4640556,
					"content": "「正，義，人」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640557
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640557,
					"content": "「正義人」先生，剛才究竟發生了什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640511,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640512
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640512,
					"content": "…是深淵教團。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640513
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640513,
					"content": "又是他們？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640514,
					"content": "不知最近又在盤算些什麼鬼主意，像是在做前期偵察的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640515
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640515,
					"content": "明明這段時間，他們的小動作已經被我識破很多次了…居然還不放棄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640516,
						4640518
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640516,
					"content": "一直是你一個人在對付他們嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640517
					]
				},
				{
					"id": 4640517,
					"content": "算是吧，如果沒有另一個什麼「暗夜英雄」的話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640520
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640520,
					"content": "畢竟騎士團裡大多是些派不上用場的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640521
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640521,
					"content": "怎麼可能放心把背後交給他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640522,
						4640524
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640522,
					"content": "迪盧克真是厲害呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640523
					]
				},
				{
					"id": 4640523,
					"content": "我可不是為了獲得稱讚才做這些的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640526
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640526,
					"content": "#陪{F#妳}{M#你}們聊了這麼久，不如{F#妳}{M#你}們也幫我個忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640527
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640527,
					"content": "咦？迪盧克老爺需要幫什麼忙呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640528
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640528,
					"content": "對我的身分保密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640529
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640529,
					"content": "尤其是<color=#00E1FFFF>別讓騎士團的人知道了我的行動。</color>",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640530
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640530,
					"content": "噠噠噠……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640531
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640531,
					"content": "咦，什麼聲音？是深淵教團的援兵嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640532
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640532,
					"content": "#幾個小角色而已，{F#妳}{M#你}應該也可以輕鬆解決。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640533
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640533,
					"content": "#我可不能被這些雜碎拖住了腳步，就麻煩{F#妳}{M#你}處理一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640534
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640534,
					"content": "別忘了幫我保密的事，回頭見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640535
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640535,
					"content": "喂喂！你就這麼走啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640524,
					"content": "莫非你和騎士團有什麼過節？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640525
					]
				},
				{
					"id": 4640525,
					"content": "只是些陳年舊事，沒必要再提起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640526
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640518,
					"content": "為什麼不請騎士團幫忙呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640519
					]
				},
				{
					"id": 4640519,
					"content": "哼，那樣的話，就不知是誰幫誰的忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640520
					],
					"speakerTitle": "迪盧克"
				},
				{
					"id": 4640503,
					"content": "暗夜英雄居然就是迪盧克嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640504
					]
				}
			]
		},
