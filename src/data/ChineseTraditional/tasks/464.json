			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"勞倫斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4640301,
					"content": "#{F#妳}{M#你}們也對「他」感興趣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640302
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640302,
					"content": "#嘿嘿，不瞞{F#妳}{M#你}們說，我可是「暗夜英雄」的目擊者之一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640303
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640303,
					"content": "嗚哇，這下找對人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640304,
					"content": "那麼「暗夜英雄」到底是誰呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640305,
					"content": "欸~別急，等我慢慢講。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640306
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640306,
					"content": "那晚我正在巡邏，被一點響動吸引，我趕忙過去查看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640307
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640307,
					"content": "只見一夥人鬼鬼祟祟像是在密謀些什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640308
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640308,
					"content": "於是我趕忙躲了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640309
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640309,
					"content": "喂，你不是守衛嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640310,
					"content": "而就在此時，「那個人」出現了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640311
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640311,
					"content": "他一身黑袍，完美地隱藏在夜色裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640312
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640312,
					"content": "對那些惡人來說，就像悄悄襲來的噩夢一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640313
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640313,
					"content": "哇……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640314,
					"content": "#{F#妳}{M#你}們猜我這時候做了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640315,
						4640318
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640315,
					"content": "趕快逃跑？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640316
					]
				},
				{
					"id": 4640316,
					"content": "我又沒做什麼壞事，為什麼要逃跑啊喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640317
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640317,
					"content": "不過…我確實從現場離開了，畢竟在「暗夜英雄」面前，我可能只是個累贅。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640320
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640320,
					"content": "於是…我去了騎士團宿舍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640321
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640321,
					"content": "你認為「暗夜英雄」會是騎士團的人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640322
					]
				},
				{
					"id": 4640322,
					"content": "沒錯，像他這樣有正義感，自願守護蒙德的人，加入騎士團是理所應當的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640323
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640323,
					"content": "可事實上…好像是我自作聰明了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640324
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640324,
					"content": "在宿舍檢查一番以後，並沒發現有人出門的跡象…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640325
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640325,
					"content": "那就是騎士團成員以外的人囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640326,
					"content": "是的。可是我想不通…這樣的人為何沒有加入騎士團呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640327
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640327,
					"content": "以他的實力，應該很容易在騎士團有所作為的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640328
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640328,
					"content": "到頭來你還是不知道「暗夜英雄」的身分呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640329,
					"content": "別那麼失望，至少縮小了範圍嘛，哈哈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640330
					],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640330,
					"content": "#不如{F#妳}{M#你}再去<color=#00E1FFFF>花店</color>問問看，聽說有位姑娘曾經受過他的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "勞倫斯"
				},
				{
					"id": 4640318,
					"content": "上去幫忙？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640319
					]
				},
				{
					"id": 4640319,
					"content": "嗯…在「暗夜英雄」面前，我可能只是個累贅，這點我還是有自知之明的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640320
					],
					"speakerTitle": "勞倫斯"
				}
			]
		},
		{
