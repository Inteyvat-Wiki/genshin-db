			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"唐娜"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4640401,
					"content": "唉…我真是個壞女人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640402
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640402,
					"content": "怎麼可以這樣花心呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640403
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640403,
					"content": "喂喂？我們想問一下「暗~夜~英~雄」的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640404,
					"content": "#「暗夜英雄」！？啊啊、不好意思，我剛才有些恍神…不過{F#妳}{M#你}們怎麼知道我在想誰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640405
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640405,
					"content": "啊…難道說…都寫在臉上了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640406
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640406,
					"content": "唔…怎麼辦，萬一被迪盧克大人看到了，豈不是就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640407
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640407,
					"content": "#嗯？{F#妳}{M#你}說迪盧克大人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640408,
					"content": "#唔！…好吧，既然如此就全都告訴{F#妳}{M#你}們好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640409
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640409,
					"content": "本來我仰慕的人只有…嗯…迪盧克大人一個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640410
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640410,
					"content": "可是自從那晚，我被「暗夜英雄」所救…就好像再也不能確定自己的心意了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640411
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640411,
					"content": "真的嗎？那麼「暗夜英雄」長什麼樣子呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640412,
					"content": "我當時太害怕了，沒怎麼看清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640413
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640413,
					"content": "就只記得…令人感到安心的火光，莫名有些親切的背影…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640414,
						4640417
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640414,
					"content": "火光？難道是神之眼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640415
					]
				},
				{
					"id": 4640415,
					"content": "#或許吧，{F#妳}{M#你}這麼一說，確實很可能是火元素的「神之眼」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640416
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640416,
					"content": "一下子照亮了四周的黑暗，所以印象很深刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640421
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640421,
					"content": "唔，好吧，謝謝妳的情報，唐娜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640422,
					"content": "整理一下現在所知的情報的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640423,
					"content": "「並非西風騎士，擁有神之眼的有錢人」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640424
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640424,
					"content": "啊——還是想不明白啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640425
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640425,
					"content": "問了這麼多，果然還是想親眼見識一下呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640426
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640426,
					"content": "不如在夜晚的城裡轉轉，運氣好的話說不定會遇上「他」呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640417,
					"content": "親切？難道是熟悉的人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640418
					]
				},
				{
					"id": 4640418,
					"content": "嗯…這個我也不能確定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640419
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640419,
					"content": "又或者…是命中註定的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640420
					],
					"speakerTitle": "唐娜"
				},
				{
					"id": 4640420,
					"content": "就像那種…命中註定的兩人一見如故…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640421
					],
					"speakerTitle": "唐娜"
				}
			]
		},
