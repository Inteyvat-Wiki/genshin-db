			"dialogs": [
				{
					"id": 4640201,
					"content": "#哦~{F#妳}{M#你}是來問「暗夜英雄」的事啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640202
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4640202,
					"content": "「暗夜英雄」就是我哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640203,
						4640205
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4640203,
					"content": "您是在開玩笑吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640204
					]
				},
				{
					"id": 4640204,
					"content": "是的，我是在開玩笑哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640207
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4640207,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640208
					]
				},
				{
					"id": 4640208,
					"content": "嗯……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640209,
					"content": "呵呵，其實我想說的是，在他身上我感覺到一種和我相似的氣息哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640210
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4640210,
					"content": "相似的氣息？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640211,
					"content": "在數之不盡的夜晚裡守護著蒙德，貫徹自己的正義，堅守自己的信念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640212
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4640212,
					"content": "原來瑪格麗特小姐也是這樣了不起的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640213,
					"content": "不不，我的意思是，他一定很有錢吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640214
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4640214,
					"content": "嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640215,
					"content": "往往在物質富裕的基礎上才會追求精神的富有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640216
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4640216,
					"content": "很多英雄故事也都是這樣寫的，不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640217
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4640217,
					"content": "…原來妳只是在炫富而已。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640218
					]
				},
				{
					"id": 4640218,
					"content": "呵呵，沒有的事，我只是每天都很閒罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640219
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4640219,
					"content": "都差不多啦，畢竟是「貓尾酒館」的老闆娘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4640220,
					"content": "#不如{F#妳}{M#你}們再去<color=#00E1FFFF>城門</color>的守衛那邊問問看？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640221
					],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4640221,
					"content": "經常值夜班的他們很可能見過些什麼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瑪格麗特"
				},
				{
					"id": 4640205,
					"content": "果然，我早就猜到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4640206
					]
				},
				{
					"id": 4640206,
					"content": "嗯…抱歉我是在開玩笑的，請不要這麼認真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4640207
					],
					"speakerTitle": "瑪格麗特"
				}
			]
		},
