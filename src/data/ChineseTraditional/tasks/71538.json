				]
			},
			"dialogs": [
				{
					"id": 715380301,
					"content": "#唔…果然好看，但…也不能讓{F#妳}{M#你}白白送我這封「祝柬」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380302
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380302,
					"content": "#對了，這些點心拿著，多謝{F#妳}{M#你}了。有了{F#妳}{M#你}這份禮物，我也算是不虛此行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380303
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380303,
					"content": "不過…我離開楓丹這麼久，隊裡的人也不知道有沒有按時訓練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380304
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380304,
					"content": "總之，還是先做個體能測試計畫吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "夏沃蕾"
				}
