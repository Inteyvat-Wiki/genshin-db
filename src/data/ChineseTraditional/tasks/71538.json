				]
			},
			"dialogs": [
				{
					"id": 715380101,
					"content": "#{NICKNAME}，{F#妳}{M#你}好。海燈節快樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380102,
						715380103
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380102,
					"content": "妳…是來辦案的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				},
				{
					"id": 715380104,
					"content": "我正在被強制休假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380105
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380105,
					"content": "強制…休假？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380106
					]
				},
				{
					"id": 715380106,
					"content": "按照執律庭的規定，到每年年底前，每一個人的公假都必須休完。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380107
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380107,
					"content": "但是今年的年終核算結束之後，隊裡發現我沒有休過一天公假，所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380108,
						715380109
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380108,
					"content": "特巡隊真辛苦啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380110,
					"content": "不是，特巡隊裡本來有輪班休假制，但我身為特巡隊隊長，必須常駐值守。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380111
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380111,
					"content": "再加上時不時有些突發情況必須要我去處理，久而久之…我就忘記休假了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380112
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380112,
					"content": "雖然這些公假對我來說沒什麼所謂，但我一說不如就不休假了，隊裡的人一下子都激動了起來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380113
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380113,
					"content": "這群傢伙嚷著什麼：「這可是白紙黑字的規定啊隊長，我們特巡隊怎麼能違規！」一定要我出去休假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380114
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380114,
					"content": "還有一個總是來我們隊辦事的複律官在旁邊幫腔，甚至他還突然掏出了一張船票，說璃月正好在舉辦海燈節，還向我保證這裡絕對是休假的最佳地點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380115
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380115,
					"content": "但不得不說，璃月的確不錯。我剛從翹英莊回來，那邊用茶葉做的點心味道都非常好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380116
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380116,
					"content": "我買了不少點心，準備帶回去給隊裡的人吃吃看，還想按照璃月的習俗做幾封「祝柬」附在裡面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380117
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380117,
					"content": "只是…我並不是很會做這種東西，怎麼做都感覺怪怪的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380118
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380118,
					"content": "#{NICKNAME}，{F#妳}{M#你}知道這種東西的做法嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715380119
					],
					"speakerTitle": "夏沃蕾"
				},
				{
					"id": 715380119,
					"content": "我是有一些建議…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 715380109,
					"content": "特巡隊每個人都這樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380110
					]
				},
				{
					"id": 715380103,
					"content": "妳…看起來不像是來工作的…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715380104
					]
				}
			]
		},
