			"dialogs": [
				{
					"id": 710610401,
					"content": "#讚美{NICKNAME}，讚美派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610402
					],
					"speakerTitle": "贊瑪蘭"
				},
				{
					"id": 710610402,
					"content": "雖於心不安，但且容贊瑪蘭直言，正如兩腳的有言：「幫人幫到底」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610403,
						710610405
					],
					"speakerTitle": "贊瑪蘭"
				},
				{
					"id": 710610403,
					"content": "你該不會還有事情想讓我們跑腿吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610404
					]
				},
				{
					"id": 710610405,
					"content": "可是你不是人而是蘑菇啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610406
					]
				},
				{
					"id": 710610404,
					"content": "兩腳的這等遠見卓識的確配得上有智慧者的稱號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "贊瑪蘭"
				},
				{
					"id": 710610406,
					"content": "同為安享大地恩惠的有生之物，彼此扶助才順應道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610407
					],
					"speakerTitle": "贊瑪蘭"
				},
				{
					"id": 710610407,
					"content": "還請不要推辭，收下這份「才慧之瑞佑」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610408
					],
					"speakerTitle": "贊瑪蘭"
				},
				{
					"id": 710610408,
					"content": "獲得了「才慧之瑞佑」。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						710610409
					]
				},
				{
					"id": 710610409,
					"content": "嗚啊…這是什麼東西，看起來好可疑的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610410,
					"content": "此處仍有不少邪氣在空中遊蕩，贊瑪蘭能夠感知，卻無法分辨源頭的所在。沿水流探索，必定會有所發現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610411
					],
					"speakerTitle": "贊瑪蘭"
				},
				{
					"id": 710610411,
					"content": "#{NICKNAME}只要對邪氣的源頭使用「才慧之瑞佑」，贊瑪蘭的同族自會把問題處理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610412,
						710610413
					],
					"speakerTitle": "贊瑪蘭"
				},
				{
					"id": 710610412,
					"content": "邪氣的源頭…的確不能放著不管。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610413,
					"content": "…說真的，你怎麼不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610414
					]
				},
				{
					"id": 710610414,
					"content": "#{NICKNAME}比派蒙更懂幽默。贊瑪蘭無腳而{NICKNAME}有腳，有腳的事情自然由有腳的完成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610415
					],
					"speakerTitle": "贊瑪蘭"
				},
				{
					"id": 710610415,
					"content": "況且贊瑪蘭身負更重要的使命。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610416
					],
					"speakerTitle": "贊瑪蘭"
				},
				{
					"id": 710610416,
					"content": "更重要的使命指？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710610417
					]
				},
				{
					"id": 710610417,
					"content": "#此番消耗了太多氣力，和{NICKNAME}、派蒙交談非常愉快，但贊瑪蘭需要休眠，積蓄力量抵禦邪氣，蔭蔽同族，繁衍生息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610418
					],
					"speakerTitle": "贊瑪蘭"
				},
				{
					"id": 710610418,
					"content": "#祝福{NICKNAME}，祝福派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610419
					],
					"speakerTitle": "贊瑪蘭"
				},
				{
					"id": 710610419,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610420
					],
					"speakerTitle": "贊瑪蘭"
				},
				{
					"id": 710610420,
					"content": "喂，大蘑頭，喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710610421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610421,
					"content": "#{NICKNAME}，看來大蘑頭已經睡著啦，我們走吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 710610207,
					"content": "嗚啊，哪裡冒出來的這些黑泥？這就是大蘑頭說的「邪氣」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
