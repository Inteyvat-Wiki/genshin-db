					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330202,
					"content": "有些失誤…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330204
					]
				},
				{
					"id": 250330204,
					"content": "#這種爬山的速度已經很厲害了，我和奇卡都比不上{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330205
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330205,
					"content": "#唉…想要趕上{M#大哥哥}{F#大姐姐}，應該還要訓練很久吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330206
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330206,
					"content": "嗚，嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330207,
						250330208
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330207,
					"content": "加油，奇卡！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330209,
					"content": "嗚？！嗚嗚，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330210
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330210,
					"content": "乖乖喔，奇卡。亞瓦爾叔叔說了，只要我們努力，一定會變得更厲害的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330211
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330211,
					"content": "嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330212
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330212,
					"content": "#{M#大哥哥}{F#大姐姐}，謝謝{F#妳}{M#你}幫忙，這枚果子給{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330213
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330213,
					"content": "這是奇卡剛剛摘到的，它的動作比之前快了很多哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330214
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330214,
					"content": "#嘿嘿，都是因為有{M#大哥哥}{F#大姐姐}給奇卡做榜樣，奇卡才能變得這麼厲害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330215
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330215,
					"content": "嗚嗚，嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330216
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330216,
					"content": "好了，那我們就先回部族去找馬伊塔了。唔…他現在應該在部族裡吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330208,
					"content": "你們可以做到的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330209
					]
				},
				{
					"id": 250330203,
					"content": "不是最佳成績。",
					"roleType": "TALK_ROLE_PLAYER",
