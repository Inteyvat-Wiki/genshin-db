			"dialogs": [
				{
					"id": 250330101,
					"content": "乖乖喔，今天吃飽了嗎？有沒有力氣訓練啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330102
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330102,
					"content": "嗚，嗚嗚，嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330103
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330103,
					"content": "嗚哇，這麼有活力？好！那今天可要加把勁了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330104
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330104,
					"content": "一起加把勁吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330106
					]
				},
				{
					"id": 250330106,
					"content": "#欸？您好啊，{M#大哥哥}{F#大姐姐}！我們正在做爬山訓練哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330107
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330107,
					"content": "嗚嗚！嗚嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330108
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330108,
					"content": "嗚嗚，嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330109,
						250330112
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330109,
					"content": "訓練得怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330110
					]
				},
				{
					"id": 250330110,
					"content": "那個…至少「有進步」吧？這次奇卡爬得比上次高多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330111
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330111,
					"content": "就是在爬山的時候，奇卡的攀爬動作有點不熟練…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330116,
					"content": "#{M#大哥哥}{F#大姐姐}，{F#妳}{M#你}可以再示範一遍嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330117,
						250330121
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330117,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330118
					]
				},
				{
					"id": 250330118,
					"content": "#謝謝{F#妳}{M#你}！這次我一定可以看得清{M#大哥哥}{F#大姐姐}的動作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330119
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330119,
					"content": "奇卡，你也要睜大眼睛喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330120
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330120,
					"content": "嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330123,
					"content": "#那就拜託{F#妳}{M#你}了，{M#大哥哥}{F#大姐姐}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330124
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330124,
					"content": "#我們會在地上看著{M#大哥哥}{F#大姐姐}，算好時間的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330125
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330125,
					"content": "嗚，嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "奇卡"
				},
				{
					"id": 250330121,
					"content": "這次要看清我的動作了喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330122
					]
				},
				{
					"id": 250330122,
					"content": "當然囉，我和奇卡都會睜大眼睛仔細看的，這次一定可以看得清！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330123
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330112,
					"content": "看起來牠恢復得不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						250330113
					]
				},
				{
					"id": 250330113,
					"content": "當然了，媽媽也說我很擅長照顧奇卡哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330114
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330114,
					"content": "奇卡進步了很多，爬的高度也比上次高很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330115
					],
					"speakerTitle": "特拉忒"
				},
				{
					"id": 250330115,
					"content": "就是在爬山的時候，奇卡的動作有點不熟練…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						250330116
					],
					"speakerTitle": "特拉忒"
				}
			]
