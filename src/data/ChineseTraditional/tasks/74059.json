			},
			"dialogs": [
				{
					"id": 740590201,
					"content": "#是{NICKNAME}{M#哥哥}{F#姐姐}和派蒙，好久不見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590202
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590202,
					"content": "#{F#妳}{M#你}們是還想要收集上次那種奇怪的石頭嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590203
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590203,
					"content": "唔，雖然也沒錯啦，不過這個說來話長…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590204,
					"content": "#{F#妳}{M#你}們將從切瑟爾那裡得來的鐘錶交給了芙佳，並且把切瑟爾想要利用奇異礦石製作鐘錶的事情告訴了她。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590205
					]
				},
				{
					"id": 740590205,
					"content": "好、好厲害，原來這樣的石頭還能用來做成這種東西嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590206
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590206,
					"content": "欸？不過只有機芯裡的寶石是用那個石頭做的啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590207,
					"content": "竟然在水下也能滴滴答答地響，這樣的鐘錶還是第一次看到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590208
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590208,
					"content": "唔，我記得切瑟爾是說採用了什麼蠔式結構？還是蚌式結構？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590209,
					"content": "嘿嘿，光是聽到鐘錶裡面的聲音就開心起來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590210
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590210,
					"content": "沒想到就算是這種普通的石頭，也會有適合它自己的用途…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590211
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590211,
					"content": "以前我一直覺得只有像姐姐那樣，用稀有的寶石才能做出了不起的作品，沒想到普通的石頭也能做成這麼厲害的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590212
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590212,
					"content": "無論是什麼都有其用處。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590213
					]
				},
				{
					"id": 740590213,
					"content": "嗯嗯，芙佳對自己也突然有自信了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590214
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590214,
					"content": "芙佳小心翼翼地把鐘錶擺在了好看的地方。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590215
					]
				},
				{
					"id": 740590215,
					"content": "既然如此，芙佳就準備好礦石，到時候賣給切瑟爾就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590216,
					"content": "這樣的話，芙佳也能像姐姐一樣，擁有一個自己的寶石工坊了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590217,
					"content": "芙佳這裡有這麼多各式各樣的石頭，說不定也都能找到各自的用處唷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590218,
					"content": "#嗯嗯，我會好好準備的，謝謝{F#妳}{M#你}們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590219
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590219,
					"content": "#之後如果{F#妳}{M#你}們想要找什麼石頭的話，也請隨時來找我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590220
					],
					"speakerTitle": "芙佳"
				},
				{
					"id": 740590220,
					"content": "嘿嘿，不用這麼客氣啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
