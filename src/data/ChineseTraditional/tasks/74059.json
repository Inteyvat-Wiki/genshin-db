							4572.377
						],
						"pointId": 340300142
					}
				]
			},
			"dialogs": [
				{
					"id": 740590101,
					"content": "#啊，是{F#妳}{M#你}們，之前賣我寶石的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590102
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590102,
					"content": "嗯嗯，我記得你上次說，要用我們賣給你的寶石製作成好看的首飾，不知道做出來了沒呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590103,
					"content": "我們一直很期待唷！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590104,
					"content": "#這個嘛…那恐怕要讓{F#妳}{M#你}們失望了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590105
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590105,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590106,
					"content": "雖然我是想要把那個做成鑲嵌在首飾上的寶石啦。但是這種礦石的硬度實在太高，要進行精細的手工打磨也很困難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590107
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590107,
					"content": "而且最要命的是，沒想到在切割打磨後，礦石就失去了一開始的光澤。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590108
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590108,
					"content": "總的來說，就是完全不適合製作成什麼工藝品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590109
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590109,
					"content": "唔，沒想到會這樣，我們還以為這種石頭真的能有什麼用處耶…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590110,
					"content": "用處嘛，也不能說完全沒有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590126
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590126,
					"content": "一邊說著，切瑟爾一邊將一臺機械鐘錶擺到了櫃台上。",
					"roleType": "TALK_ROLE_NEED_CLICK_BLACK_SCREEN",
					"nextDialogs": [
						740590111
					]
				},
				{
					"id": 740590111,
					"content": "#{F#妳}{M#你}們看這次新做的機械鐘錶，就用到了那種礦石喔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590112
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590112,
					"content": "本來我都覺得是自己看走了眼，準備把這些石頭處理掉了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590113
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590113,
					"content": "結果有些鐘錶匠看到了那些加工失敗的礦石，由於礦石硬度很高的緣故，他們就拿來做鐘錶裡面的機芯零件了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590114
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590114,
					"content": "沒想到因為硬度高抗磨損，作為機芯零件，這種礦石與之前用的原料相比，使用效果要好多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590115
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590115,
					"content": "但是如果用來製作鐘錶的話，對貨源穩定的要求就更高了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590116,
						740590117
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590116,
					"content": "這個倒是好說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				},
				{
					"id": 740590118,
					"content": "#{F#妳}{M#你}們將芙佳和礦脈的事情告訴了切瑟爾。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						740590119
					]
				},
				{
					"id": 740590119,
					"content": "原來如此，那還真是巧了！這款試作型的鐘錶採用了新發明的防水蚌式結構，原本就有打算讓美露莘也能方便使用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590120
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590120,
					"content": "#既然這樣的話，能拜託{F#妳}{M#你}們把這個鐘錶帶給那位芙佳小姐，順便幫我提前說明一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590121
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590121,
					"content": "畢竟我也沒有和美露莘做生意的經驗…如果芙佳小姐能夠提供穩定的貨源的話，就能建立一條新的生產線了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590122
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590122,
					"content": "之後我也會親自上門拜訪的！在以後的鐘錶設計上，也可以加入美露莘的風格…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590123
					],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590123,
					"content": "嘿嘿，聽起來如果能成功的話，對芙佳也很有好處耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590124,
					"content": "說不定藉此機會，芙佳也能擁有自己的寶石工坊了，我們就回去找芙佳說說看吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740590125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740590125,
					"content": "#那就拜託{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "切瑟爾"
				},
				{
					"id": 740590117,
					"content": "直接聯絡芙佳的話…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740590118
					]
				}
			]
		},
