				"points": []
			},
			"dialogs": [
				{
					"id": 412130101,
					"content": "阿貝多！我們又——來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130102,
					"content": "嗯？阿貝多好像不在？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130103,
					"content": "是出去調查了嗎，還是又去畫神秘寫生了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130104,
					"content": "啊！是你們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130105
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130105,
					"content": "這不是砂糖嗎，妳怎麼在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130106,
					"content": "我的研究剛告一段落，今天有五小時二十六分左右的空閒時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130107
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130107,
					"content": "所以，就來找你們打聽之前委託的事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130108
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130108,
					"content": "好精確的時間，妳是人型鐘錶嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130109,
					"content": "不不不，這沒什麼值得誇獎的，妳太客氣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130110
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130110,
					"content": "人家沒有在誇妳啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130111,
					"content": "#旅行者，我、我可以問嗎？之前拜託{F#妳}{M#你}去調查阿貝多先生隱瞞的事，進展得還順利嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130112
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130112,
					"content": "如果我的感官沒有出問題，那已經是一個多星期前的事了哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130113,
					"content": "還以為妳已經忘了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130114
					]
				},
				{
					"id": 412130114,
					"content": "什麼…！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130115
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130115,
					"content": "一、一個多星期？！我明明…啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130116
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130116,
					"content": "嗚，我太沉迷實驗，完全忽略了這件事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130117
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130117,
					"content": "該說她的時間觀念太強呢，還是太弱呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130118,
					"content": "#所、所以！{F#妳}{M#你}已經知道答案了對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130119,
						412130120
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130119,
					"content": "嗯，可以這麼說哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				},
				{
					"id": 412130121,
					"content": "太好了，能說給我聽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130122
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130122,
					"content": "派蒙，妳覺得呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130123
					]
				},
				{
					"id": 412130123,
					"content": "唔…告訴她應該不要緊吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130124,
					"content": "看看也行，只要不是觸摸…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130125,
					"content": "等一下，你們在說什麼呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130126
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130126,
					"content": "這是…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130127,
						412130128
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130127,
					"content": "這就是阿貝多隱瞞的事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130129,
					"content": "是一把非常厲害的劍哦，不能用手碰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130130,
					"content": "嗯…這是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130131
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130131,
					"content": "！！這、這是！！我從未見過的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130132
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130132,
					"content": "哼哼，盡情欣賞吧！不知為什麼，連我都有一種奇怪的成就感！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130133,
					"content": "太厲害了，我還是第一次見到這麼神奇的武器。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130134
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130134,
					"content": "我能隱約感到有力量在劍的內部徐徐流動…它就像活著的生物一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130135
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130135,
					"content": "這麼具體的感覺嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130136
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130136,
					"content": "也許是我學習過煉金術的緣故吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130137
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130137,
					"content": "我不敢用太絕對的說辭，但確實有「流動」的感覺。雖然這說法很不嚴謹…本、本來我是不會用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130138
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130138,
					"content": "請相信我，我平時絕不會用這麼模棱兩可的說法！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130139
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130139,
					"content": "好好好，知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130140,
					"content": "#旅行者，請問…{F#妳}{M#你}可以使用這把劍戰鬥嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130141
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130141,
					"content": "#我想多瞭解一些，但我不能使用它，只能拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130142,
						412130143
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130142,
					"content": "偷偷地，別讓阿貝多知道哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130144,
					"content": "那就到附近找合適的地點吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130143,
					"content": "找個不容易被發現的地方比較好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130144
					]
				},
				{
					"id": 412130128,
					"content": "這就是妳想知道的答案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130129
					]
				},
				{
					"id": 412130120,
					"content": "完全調查清楚了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130121
					]
				}
			]
		},
