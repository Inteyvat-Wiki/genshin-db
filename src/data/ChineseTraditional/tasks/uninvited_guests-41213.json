					"砂糖"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130201,
					"content": "太厲害了，這樣的武器我還是第一次看到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130202
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130202,
					"content": "#{F#妳}{M#你}也好厲害，無論是戰鬥的姿勢還是揮劍的氣勢都非常完美。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130203
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130203,
					"content": "妳過獎了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130204
					]
				},
				{
					"id": 412130204,
					"content": "這把劍好特別，明明沒有想要深入研究，眼神卻不知不覺就被吸引了過去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130205
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130205,
					"content": "我倒覺得比起劍的屬性，這個更像是妳自己的屬性呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130206,
					"content": "危險誘人的神秘單手劍，嗯，不會錯的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130207
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130207,
					"content": "#把這麼重要的東西交給{F#妳}{M#你}，阿貝多先生果然非常信任{F#妳}{M#你}呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130208,
						412130209
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130208,
					"content": "對於這件事，我也很驚訝。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				},
				{
					"id": 412130210,
					"content": "哼哼，這也是憑本事換來的信任吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130211,
					"content": "我也這麼覺得。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130212
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130212,
					"content": "#不過在交給{F#妳}{M#你}之前，劍還沒有吸收多少能量…阿貝多先生是怎麼從一堆雜物中發覺它與眾不同的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130213
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130213,
					"content": "靈光一閃通常是沒有道理的。比如我想吃蜜醬胡蘿蔔煎肉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130214,
					"content": "啊…這麼一說，我今天還沒吃過多少東西呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130215
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130215,
					"content": "忙完實驗趕來找你們，卻在路上遇到被困在雪地裡的冒險家，為了救他又花了不少時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130216
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130216,
					"content": "（咕…咕…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130217
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130217,
					"content": "剛才那是肚子餓了的聲音嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130218
					]
				},
				{
					"id": 412130218,
					"content": "啊、啊啊啊！不、不是這樣的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130219
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130219,
					"content": "別害羞別害羞，大膽地說出妳的想法嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130220,
					"content": "呃、呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130221
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130221,
					"content": "那我先說：肚子餓了！我想吃飯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130222,
						412130223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130222,
					"content": "肚子餓了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130224,
					"content": "肚子…肚子餓了，要吃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130225
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130225,
					"content": "嗚啊啊！！果然還是好丟臉啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130226
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130226,
					"content": "才沒有這種事呢，承認饑餓會讓食物更美味哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130227,
					"content": "咦，是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130228
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130228,
					"content": "是這樣哦！所以打起精神來，去休息地找食物吧~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130229,
					"content": "可以的話，真想在這冰天雪地裡享用美味的蜜醬胡蘿蔔煎肉呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130223,
					"content": "我想吃飯！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130224
					]
				},
				{
					"id": 412130209,
					"content": "很感謝他能這麼相信我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130210
					]
				}
			]
		},
