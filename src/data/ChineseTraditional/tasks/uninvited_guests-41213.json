				"objectNames": [
					"冒失的帕拉德"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 412130301,
					"content": "嗚嗚…嗚啊啊嗷嗷嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130302
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 412130302,
					"content": "帕拉德先生？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130303
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130303,
					"content": "你、你還沒回去嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130304
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130304,
					"content": "這不是蒙德那個冒失鬼冒險家嗎？他也跟著賽琉斯來雪山探險啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130305,
					"content": "冷冷冷死我了，阿嚏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130306
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 412130306,
					"content": "我把你從雪坑裡救出來以後，你就一直在這裡嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130307
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130307,
					"content": "我也不想的，可是、可是我迷路了！抱歉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130308
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 412130308,
					"content": "嗚噗噗噗…冷死了，一步也走不動啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130309
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 412130309,
					"content": "唉，帕拉德先生，你對雪山之旅太掉以輕心啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130310
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130310,
					"content": "我們帶他一起回去吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130311
					]
				},
				{
					"id": 412130311,
					"content": "可以嗎？他現在這樣，恐怕要我們扶著才能走路了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130312
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130312,
					"content": "就算不可以，也不能把他丟在這裡吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130313,
					"content": "#說得也是…抱歉呀旅行者，我、我替他向{F#妳}{M#你}道歉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130314
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130314,
					"content": "還有心思考慮別人？先擔心自己吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130315
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 412130315,
					"content": "啊！又是愚人眾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130316,
					"content": "我們的來意，你們想必已經知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130317
					],
					"speakerTitle": "瓦京"
				},
				{
					"id": 412130317,
					"content": "交出那把劍，否則誰也別想離開這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130318
					],
					"speakerTitle": "瓦京"
				},
				{
					"id": 412130318,
					"content": "不行，請不要把劍交給他們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130319,
						412130320
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130319,
					"content": "當然不會交給他們了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				},
				{
					"id": 412130321,
					"content": "好有氣勢！一鼓作氣把他們打翻！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130322,
					"content": "帕拉德先生，我帶你到安全的地方去！快來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130323
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130323,
					"content": "天真，所有知情人一個都別想跑！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130324
					],
					"speakerTitle": "瓦京"
				},
				{
					"id": 412130324,
					"content": "這把劍將被作為禮物，獻給尊貴的執行官「女士」大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瓦京"
				},
				{
					"id": 412130320,
					"content": "誰都別想從我這裡奪走東西！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130321
					]
				}
			]
		},
