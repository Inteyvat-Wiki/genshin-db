				"points": []
			},
			"dialogs": [
				{
					"id": 412130601,
					"content": "龍的力量…龍的生命力，能讓枯死的植物復活到這種地步…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130602
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412130602,
					"content": "不可思議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130603
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412130603,
					"content": "還以為是一截枯樹樁，沒想到是這種怪物呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130604
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130604,
					"content": "差一點就被吞下去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130605,
					"content": "不過，為什麼只有今天發生了這種情況呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130606,
					"content": "多半是因為劍落到地上遭受了撞擊，導致力量外洩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130607
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412130607,
					"content": "我錯了，不要趕我走，千萬不要趕我走啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130608
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 412130608,
					"content": "我保證絕不亂動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130609
					],
					"speakerTitle": "冒失的帕拉德"
				},
				{
					"id": 412130609,
					"content": "啊，帕拉德先生…也不用抱著膝蓋蹲到地上變成蘑菇呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130610
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130610,
					"content": "唉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130611
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412130611,
					"content": "這棵急凍樹會枯死在這種地方，難道是因為它無法吸收被污染過的力量？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130612
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412130612,
					"content": "旅行者能夠淨化污穢，淨化後的純淨元素力不僅能讓它復活，甚至強化了它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130613
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412130613,
					"content": "純粹的生命之力會迫使它不斷重生…看來，之後還會有持續不斷的戰鬥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130614,
						412130615
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412130614,
					"content": "發生了比想像中還麻煩的事呀…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				},
				{
					"id": 412130616,
					"content": "我也從沒遇到過類似事件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130617
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412130617,
					"content": "如此罕見的情況，不得不說，也是一種意外收穫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130618
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412130618,
					"content": "砂糖。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130619
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412130619,
					"content": "啊、是！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130620
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130620,
					"content": "看好那個冒險家，把他送回營地去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130621
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412130621,
					"content": "好的先生！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130622
					],
					"speakerTitle": "砂糖"
				},
				{
					"id": 412130622,
					"content": "#至於這裡，雖然很不好意思…但還是要麻煩{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						412130623
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 412130623,
					"content": "我會盡力解決它。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130624
					]
				},
				{
					"id": 412130624,
					"content": "預料之外的麻煩事，卻只有我們能解決。果然還是因為我們越來越厲害了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 412130615,
					"content": "真沒想到，是我太厲害了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						412130616
					]
				}
			]
		}
	]
