			},
			"dialogs": [
				{
					"id": 3710101,
					"content": "#剛才…有一件事{F#妳}{M#你}沒說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710102,
					"content": "那時我們看到的東西，除了龍和結晶，明明還有一樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710103,
						3710104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710103,
					"content": "我想自己先調查一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710105
					]
				},
				{
					"id": 3710105,
					"content": "#嗯，{F#妳}{M#你}果然還記得他，那個綠色的傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710106,
					"content": "——就和樓下那個路人穿得一樣綠呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710107,
						3710111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710107,
					"content": "真的是同一種顏色呢，好巧啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710108
					]
				},
				{
					"id": 3710108,
					"content": "是吧？是吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710109,
					"content": "不過…怎麼總覺得那個人…越看越像…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						3710110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710110,
					"content": "同一個人——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710111,
					"content": "那個…好像就是他本人啊…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710112
					]
				},
				{
					"id": 3710112,
					"content": "咿——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 3710104,
					"content": "我覺得他看起來不是壞人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						3710105
					]
				}
			]
		},
