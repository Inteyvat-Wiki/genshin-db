				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090101,
					"content": "凱瑟琳，我們來了，有什麼事找我們幫忙嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090102,
					"content": "#不好意思，又要麻煩{F#妳}{M#你}們了。這次是天領奉行直接交給冒險家協會的委託，很重要，也很危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090103
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 120090103,
					"content": "#協會在評估後認為，這份委託只能交給最資深的冒險家，於是我就想到了{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090104
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 120090104,
					"content": "嘿嘿，也沒有那麼厲害啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090105,
						120090106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090105,
					"content": "聽上去有點危險？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090107
					]
				},
				{
					"id": 120090107,
					"content": "先由我來說明一下吧。天領奉行近日下達了通緝令，他們想要找一個名叫「荒瀧一斗」的鬼族青年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090108
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 120090108,
					"content": "鬼族？我好像聽說過，就是頭上長角，看起來很兇的人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090109,
					"content": "是的，這個人很張揚很吵鬧，所以在町街有點名氣。但話雖如此，他以前也沒有闖過什麼大禍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090110
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 120090110,
					"content": "沒想到，最近他竟然做起了搶劫和擄掠的勾當…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090111
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 120090111,
					"content": "不只是做了壞事，在天領奉行眾打算逮捕他的時候，他還襲擊了執行抓捕的同心，帶著身邊的人逃走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090112
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 120090112,
					"content": "感覺很惡劣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090113
					]
				},
				{
					"id": 120090113,
					"content": "總而言之，就是想讓我們去把壞人抓回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090114,
					"content": "#放心放心，{NICKNAME}{F#她}{M#他}可厲害了，什麼對手都不是問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090115,
					"content": "嗯，不過還是不要魯莽行動的好。這個人是神之眼的持有者，手下還管理著一個名為「荒瀧派」的組織。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090116,
						120090118
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 120090116,
					"content": "我不那麼擅長打群架…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090117
					]
				},
				{
					"id": 120090117,
					"content": "也對，畢竟我們完全不瞭解他。聽妳的吧，還是謹慎一點好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090120,
					"content": "有關荒瀧一斗這個人，他為什麼要做這樣的事，現在又逃到了什麼地方去，這些資訊我們都還沒有掌握。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090121
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 120090121,
					"content": "#町街的各位應該比我更熟悉他，{F#妳}{M#你}們應該能從他們那裡獲得有用的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090122
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 120090122,
					"content": "嗯，我會去打聽看看。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090123
					]
				},
				{
					"id": 120090123,
					"content": "#感謝{F#妳}{M#你}的協助，我在這裡等待{F#妳}{M#你}的好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 120090118,
					"content": "我手下有派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090119
					]
				},
				{
					"id": 120090119,
					"content": "對不起，對不起啦！別讓我去打架，我不該誇下海口的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090106,
					"content": "天領奉行自己解決不了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090107
					]
				}
			]
		},
		{
			"id": 1200902,
			"completionStepIds": [
				1200902
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200902",
							"2"
						],
						"stepId": 1200902,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小倉澪",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090201,
					"content": "荒瀧一斗？啊，他的事我知道，我一直覺得是天領奉行的人搞錯了，他不可能為惡啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090202
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090202,
					"content": "欸？為什麼這麼肯定，妳很信任他嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090203,
					"content": "#{F#妳}{M#你}誤會了，我的意思是，他可能並沒有為惡的「能力」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090204,
						120090205
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090204,
					"content": "是指…力氣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090206
					]
				},
				{
					"id": 120090206,
					"content": "#聽我講一個他的故事{F#妳}{M#你}們就明白了，他以前經常和町街的小孩子玩猜拳和捉迷藏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090207
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090207,
					"content": "#小孩子單純又好懂，{F#妳}{M#你}們肯定明白。但就算是和他們做遊戲，荒瀧一斗有時候也輸得很慘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090208
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090208,
					"content": "是他故意的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090209,
					"content": "不不不，有一次我親眼見到他贏了一個小孩子，他開心地跳了起來，喊著什麼「終於贏了！」…「本大爺無敵！」之類的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090210
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090210,
					"content": "還贏走了這個孩子手裡的硬糖，當著他的面吃掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090211
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090211,
					"content": "嗚哇，好差勁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090212,
					"content": "那次確實有點過分了，所以我幫那個快哭出來的小孩子教訓了他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090213
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090213,
					"content": "他認錯的速度很快，態度也很坦率，所以孩子馬上又笑了出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090214
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090214,
					"content": "因為他「願賭服輸，從不放水」，有些孩子還挺喜歡找他玩的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090215
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090215,
					"content": "但這樣一個經常輸給小孩子的人…要怎麼去作惡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090216,
						120090217
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090216,
					"content": "我懂妳的意思了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090218
					]
				},
				{
					"id": 120090218,
					"content": "這麼聽起來，他好像不是個壞人啊，而且是個有原則的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090219
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090219,
					"content": "嗯，原本我也這樣想，但聽說天領奉行的人已經掌握了確鑿的證據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090220
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090220,
					"content": "我不想為他辯解，他如果真的犯了錯，那就該乖乖受罰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090221
					],
					"speakerTitle": "小倉澪"
				},
				{
					"id": 120090221,
					"content": "嗯，謝謝妳！我們再去打聽一下！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090217,
					"content": "挺意外的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090218
					]
				},
				{
					"id": 120090205,
					"content": "是指…心智？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090206
					]
				}
			]
		},
		{
			"id": 1200903,
			"completionStepIds": [
				1200903
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200903",
							"2"
						],
						"stepId": 1200903,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"古谷升",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090301,
					"content": "#{F#妳}{M#你}想問荒瀧一斗？嗯，我聽說他最近犯了事，已經逃走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090302
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090302,
					"content": "剛聽說的時候，我有點意外，但…也不算非常意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090303
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090303,
					"content": "是因為他以前名聲就不好嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090304,
					"content": "不，怎麼說呢…咳咳，他無論幹什麼事都聲勢浩大，給人一種血氣方剛，又有點聒噪的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090305
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090305,
					"content": "這樣的人，說好聽一點叫爽朗，說不好聽的話，就是情緒不安定，開心的時候很開心，憤怒的時候很憤怒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090306
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090306,
					"content": "我對荒瀧一斗這個人的印象並不差，但他衝動起來會不會失控，我也說不好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090307,
						120090308
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090307,
					"content": "他平時是做什麼的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090309
					]
				},
				{
					"id": 120090309,
					"content": "這個我也不清楚，咳咳…我平時還算比較注意城裡發生的事，但荒瀧一斗好像就只是在混日子而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090310
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090310,
					"content": "有人需要幫忙的話，他會幫忙，其他時候，就是在和手下或者小孩子胡鬧了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090311
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090311,
					"content": "唉，是不是因為沒有收入，日子過不下去了，才想要做壞事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090312
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090312,
					"content": "好奇怪的人啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090313,
					"content": "抱歉了，其他的情況我也不清楚，他更喜歡和精神好一點的人待在一起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090314
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090314,
					"content": "#或許{F#妳}{M#你}們可以找其他人再打聽一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090315
					],
					"speakerTitle": "古谷升"
				},
				{
					"id": 120090315,
					"content": "好的，謝謝你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090308,
					"content": "他有什麼穩定的工作嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090309
					]
				}
			]
		},
		{
			"id": 1200904,
			"completionStepIds": [
				1200904
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200904",
							"2"
						],
						"stepId": 1200904,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"上杉",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090401,
					"content": "荒瀧一斗？啊，我知道，我們正在追捕他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090402
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090402,
					"content": "他已經逃離稻妻城了，因為沒有進一步的線索，我們才會委託其他人協同搜尋，包括冒險家們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090403
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090403,
					"content": "凱瑟琳和我們說，荒瀧一斗以前沒有闖過大禍，這次好像事出突然…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090404,
					"content": "所謂的擄掠和搶劫，這些都是有證據的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090405,
					"content": "那是當然，不然也不會因為他，動用這麼多人手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090406
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090406,
					"content": "雖然搶劫的人都會想辦法隱藏自己的身分，但是鬼族的角太顯眼了，一下就能認出來是他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090407
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090407,
					"content": "不可能是別的鬼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090408
					]
				},
				{
					"id": 120090408,
					"content": "起初我們只是懷疑他，但去調查的時候，他直接親口承認了罪行，還挑釁了我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090409
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090409,
					"content": "最可氣的是，最後居然還讓他帶著身邊的人逃掉了…這傢伙一定是早有準備！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090410
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090410,
					"content": "他有作惡動機嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090411
					]
				},
				{
					"id": 120090411,
					"content": "當然，無論是現實動機還是心理動機，都很充足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090412
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090412,
					"content": "他的生活一直都很拮据，也沒做什麼正經工作，聽說他還要照顧一個幫派的人，負擔相當大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090413
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090413,
					"content": "與其一直受苦，他可能覺得，作惡能讓他過得更輕鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090414
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090414,
					"content": "至於心理上的動機，雖然現在有點難以啟齒，在實施「眼狩令」的時候，他的神之眼被我們奪走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090415
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090415,
					"content": "原來是想報復天領奉行啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090416
					]
				},
				{
					"id": 120090416,
					"content": "那個時候，荒瀧一斗反抗得很厲害，我們費了非常大的力氣，還求助了九條裟羅大人，這才成功。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090417
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090417,
					"content": "…這件事確實是我們的錯，但沒想到他為了報復，採取了如此過激的手段。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090418
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090418,
					"content": "聽起來，好像確實是個情緒很不穩定的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090419,
						120090420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090419,
					"content": "動機上也能夠說通。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090421
					]
				},
				{
					"id": 120090421,
					"content": "#嗯，如果{F#妳}{M#你}們能制伏荒瀧一斗，就直接把他帶到我這裡來，我們會依規處置他的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090422
					],
					"speakerTitle": "上杉"
				},
				{
					"id": 120090422,
					"content": "好的，謝謝你的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090420,
					"content": "看來證據確鑿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090421
					]
				}
			]
		},
		{
			"id": 1200905,
			"completionStepIds": [
				1200905
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1200905",
							"2"
						],
						"stepId": 1200905,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙",
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120090501,
					"content": "妳好，我們想打聽關於荒瀧一斗的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090502,
					"content": "#又是他啊…當然沒問題，之前我已經幫天領奉行做過一些調查了。不過更重要的，{F#妳}{M#你}們的諮詢費帶夠了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090503
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090503,
					"content": "#{F#妳}{M#你}們的名號我也聽過。見過那麼多大風大浪，自然每一行每一路的規矩都是明白的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090504
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090504,
					"content": "這、這個…要多少錢啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090505,
					"content": "三十九萬七千摩拉，先行一次性支付。若成功將荒瀧一斗捉拿歸案，我還要收取協會報酬的百分之五作為提成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090506
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090506,
					"content": "太貴了！這個數字是怎麼算出來的啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090507
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090507,
					"content": "#呵呵，聽我說完嘛——這筆諮詢費之前天領奉行已經付過了，所以{F#妳}{M#你}們只需要支付提成就行啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090508
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090508,
					"content": "#而提成的部分，到時候我會直接和冒險家協會結算的。{F#妳}{M#你}們可是撿了個大便宜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090509
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090509,
					"content": "那麼，要瞭解這件事的原委，就不得不提到，在稻妻很有名的童話故事——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090510
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090510,
					"content": "青鬼呢？青鬼後來怎麼樣了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090511
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090511,
					"content": "後來青鬼就消失了吧，再也沒有見過了，現在留下來的也只有赤鬼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090512
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090512,
					"content": "嗚嗚嗚，怎麼這樣…青鬼真是個好孩子啊——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090513
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090513,
					"content": "童話故事和現實有關係嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090514
					]
				},
				{
					"id": 120090514,
					"content": "當然，不然我也不會講了。有一種說法是…這個童話就是由歷史改編而來，而荒瀧一斗就是故事裡赤鬼的後代。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090515
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090515,
					"content": "#我想告訴{F#妳}{M#你}們的是，鬼族當年犧牲了很多，最後才能融入人類，但鬼族的性格裡仍然有不安定的要素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090516
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090516,
					"content": "這種不安定是從血脈中傳承下來的，荒瀧一斗以前並沒有做過什麼壞事，但說不定有一天會性情大變呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090517
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090517,
					"content": "但這樣的話，赤鬼不就背叛了青鬼的願望嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090518,
					"content": "那都是很久遠的事了。青鬼已經不知道多久沒有出現過，估計早就消亡了，背叛自然也無從談起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090519
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090519,
					"content": "而且…既然當事人都已經承認了，那還有什麼可懷疑的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090520
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090520,
					"content": "根據我的調查，他一直朝著西南方向走，很有可能已經到了<color=#00E1FFFF>八醞島</color>。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090521
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090521,
					"content": "天領奉行眾沒辦法到珊瑚宮軍的控制範圍去抓人，所以荒瀧一斗逃去那裡也有足夠的理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090522
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090522,
					"content": "我明白了，謝謝妳的情報。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090523
					]
				},
				{
					"id": 120090523,
					"content": "沒關係，這是我應該做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090524
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090524,
					"content": "等等，我還有個問題，如果這個叫荒瀧一斗的人性情大變，那是不是就會很兇惡，很暴躁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090525
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090525,
					"content": "#應該是吧，從他之前和別人交手的情況看，他很擅長打架，有一股蠻力，光憑{F#妳}{M#你}們不知道能不能制伏他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090526
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090526,
					"content": "那…故事裡面說對鬼族撒豆子的事，也是有用的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090527
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120090527,
					"content": "#喔，{F#妳}{M#你}這麼一說我想起來了，荒瀧一斗他好像對豆子過敏。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090528
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090528,
					"content": "鬼族都有點害怕豆子，他尤其害怕，據說連碰一下都不行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090529
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090529,
					"content": "能讓他過敏，變得虛弱的話，就能很順利地把他帶回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120090530,
						120090532
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 120090530,
					"content": "只能這樣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120090531
					]
				},
				{
					"id": 120090531,
