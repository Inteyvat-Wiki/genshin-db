			"dialogs": [
				{
					"id": 401540101,
					"content": "經過這段時間的努力經營，煉金店鋪的營業額達到了比預期中更高…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401540102
					]
				},
				{
					"id": 401540102,
					"content": "哎呀，想不到短短一段時間，小可愛居然能把營業額提升到這個程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540103
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540103,
					"content": "#莫非{F#妳}{M#你}是商業天才嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540104,
						401540107
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540104,
					"content": "多虧了麗莎的幫助。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540105
					]
				},
				{
					"id": 401540105,
					"content": "#呵呵，{F#妳}{M#你}還是那麼謙虛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540106
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540106,
					"content": "得到這麼厲害的成果，可以再自豪一點的哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540109,
					"content": "#要是能把{F#妳}{M#你}留在身邊當助手，我的假期應該能再增加一倍吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540110
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540110,
					"content": "#現階段收集到的銷售資料已經足夠了。這段時間辛苦{F#妳}{M#你}們啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540111
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540111,
					"content": "#當然，如果{F#妳}{M#你}願意繼續幫忙照看店鋪，姐姐也會很高興哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540112
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540112,
					"content": "這下，我也能跟琴交差了，呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540113
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540113,
					"content": "#{NICKNAME}，派蒙，好久不見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540114
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401540114,
					"content": "琴團長！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540115
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401540115,
					"content": "妳來了，我正想著跟小可愛交接完工作，就回騎士團找妳呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540116
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540116,
					"content": "嗯，我已經從其他騎士那裡瞭解了大致情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540117
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401540117,
					"content": "#想不到，這次妳也讓{NICKNAME}來幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540118
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401540118,
					"content": "哎呀，這種重要的工作要想取得突破，精明能幹的合作伙伴是不可或缺的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540119
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540119,
					"content": "妳看，只有我的話可達不到這樣的效率呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540120
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540120,
					"content": "#的確，{F#妳}{M#你}們的成績非常驚人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540121
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401540121,
					"content": "#本想將其他事務安排妥當之後就過來看看{F#妳}{M#你}們的情況，卻一直抽不出時間…至少我想親口表達對{F#妳}{M#你}們的感謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540122,
						401540123
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401540122,
					"content": "琴團長一直在背後支持我們。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540124,
					"content": "#嗯，有{F#妳}{M#你}們這樣優秀的同伴，實在是令人安心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540125
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401540125,
					"content": "呵呵，等事情告一段落，我是不是可以好好休個假了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540126
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540126,
					"content": "最近似乎頭髮都多掉了幾根呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540127
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540127,
					"content": "沒問題。這段時間辛苦妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540128
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401540128,
					"content": "之前我看妳每天待在圖書館，時間長了或許會感到無聊，所以想安排一些更能發揮妳才能的工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540129
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401540129,
					"content": "是不是一下子給妳增加太多壓力了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540130
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401540130,
					"content": "#其實也還好啦，畢竟有騎士團各位的支援，還有得力的同伴{NICKNAME}幫我分擔工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540131
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540131,
					"content": "偶爾幹回老本行，搞搞研究，也還滿有意思的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540132
					],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540132,
					"content": "嗯，妳能這麼想就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540133
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401540133,
					"content": "#{NICKNAME}，再次感謝{F#妳}{M#你}的付出。請收下這些報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540134
					],
					"speakerTitle": "琴"
				},
				{
					"id": 401540134,
					"content": "#說到這個，姐姐我也為{F#妳}{M#你}做了個紀念品，希望{F#妳}{M#你}能喜歡哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "麗莎"
				},
				{
					"id": 401540123,
					"content": "這是所有人一起努力的成果。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540124
					]
				},
				{
					"id": 401540107,
					"content": "不知不覺就找到訣竅了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401540108
					]
				},
				{
					"id": 401540108,
					"content": "#嗯，{F#妳}{M#你}的學習能力果然非常強呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401540109
					],
					"speakerTitle": "麗莎"
				}
			]
		}
	]
}