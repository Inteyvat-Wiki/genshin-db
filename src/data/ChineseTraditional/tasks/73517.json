			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"維納亞克",
					"施芮婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735170101,
					"content": "…所以就結論來說，還是要靠「對沙蟲用殺蟲炮」來消滅它們對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170102
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735170102,
					"content": "這根本就不能同日而語！不要擺出那副「早聽我的不就得了」的表情！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170103,
						735170104
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170103,
					"content": "你們怎麼又開始了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170105
					]
				},
				{
					"id": 735170105,
					"content": "#啊，冒險家{M#先生}{F#小姐}！您聽我說，我已經找出這起事件的原因了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170106
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170106,
					"content": "——是沙蟲在地下的活動頻繁，導致了這片區域內元素能量的紊亂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170107
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170107,
					"content": "而龐雜的能量又反過來影響了沙蟲的習性，使得牠們開始在地表上四處作亂，進一步加劇了環境的失衡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170108
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170108,
					"content": "「對沙蟲用殺蟲炮」充能裝置的效率異常，也是環境中的元素能量紊亂導致的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170109
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170109,
					"content": "我就知道，我設計的機械，絕對不會這麼輕易故障！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170110
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735170110,
					"content": "沒考慮到使用環境的問題，難道就不算設計問題嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170111,
						735170112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735170111,
					"content": "既然原因是沙蟲過度活躍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170113
					]
				},
				{
					"id": 735170113,
					"content": "所以，我們繞了那麼多圈子，最後還是得出了一開始的結論？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170114
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735170114,
					"content": "知道要做什麼和知道為什麼要做可是兩碼事。身為一名學者，你不會連這都不懂吧？而且我的推論可還沒結束呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170115
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170115,
					"content": "正常來說，大自然會自行限制種群的生態及行為，以維持周遭環境的穩定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170116
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170116,
					"content": "但這次紊亂的元素能量打破了這種平衡機制，也使得沙蟲們異常活躍…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170117
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170117,
					"content": "只要想辦法讓元素環境回歸到正常狀態，就可以減弱沙蟲的活動。一段時間以後，這種平衡也就能自行恢復了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170118
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170118,
					"content": "調理元素能量？這要怎麼做啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735170119,
					"content": "唔，只要推算出元素能量淤積最嚴重的「節點」，在那裡用一些可以引導能量流動的裝置…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170120
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170120,
					"content": "…把淤塞的能量給激發出來，剩下的就可以交給大自然去自我調節了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170121
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170121,
					"content": "「節點」的位置我已經計算出來了，就在這附近。可以引導能量流動的裝置，我們也已經有了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170122
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170122,
					"content": "難道是…「對沙蟲用殺蟲炮」？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170123
					]
				},
				{
					"id": 735170123,
					"content": "沒錯，「對沙蟲用殺蟲炮」可以抽調周遭的元素能量，然後一口氣迸發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170124
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170124,
					"content": "接下來我們只要在那裡架設「對沙蟲用殺蟲炮」，像昨天一樣進行一遍流程就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170125
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170125,
					"content": "這期間可能也會有魔物和沙蟲被吸引來…嗯，適當削減一下牠們的數量，也能加快自然調節的進程吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170126
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170126,
					"content": "——所以就結論來說，還是要靠「對沙蟲用殺蟲炮」給牠們來一發對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735170127
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735170127,
					"content": "你…！不要擺出那副「早聽我的不就得了」的表情！！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735170112,
					"content": "解決方案就還是多打沙蟲？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170113
					]
				},
				{
					"id": 735170104,
					"content": "這次是為什麼吵起來？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735170105
					]
				}
			]
		}
	]
}