			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270401,
					"content": "#看來{F#妳}{M#你}已經掌握了用風之翼飛行的訣竅，那麼我們就開始最後一環吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270402
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270402,
					"content": "畢竟這條路已經飛過一次了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4270403,
					"content": "那麼，這是最後一項測試，通過了之後就可以等著飛行執照簽發啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270404
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270404,
					"content": "朝著飛行執照，預備…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270405
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270405,
					"content": "…開始！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42708,
			"completionStepIds": [
				42708
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"42708",
							"2"
