			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"奧特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4270801,
					"content": "您好，我是西風騎士團的騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270802
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270802,
					"content": "哇，發生什麼事了？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270803
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4270803,
					"content": "#請出示一下{F#妳}{M#你}的飛行執照。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270804,
						4270805
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270804,
					"content": "飛，飛行執照…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				},
				{
					"id": 4270806,
					"content": "無證非法飛行，依據蒙德城治安管理法第七條第十二款，請跟我走一趟！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270807
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270807,
					"content": "#{F#妳}{M#你}有權保持沉默，但是風會牢記{F#妳}{M#你}所說的每一句話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270808
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270808,
					"content": "等等！我們正在進行飛行執照考試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270809
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270809,
					"content": "啊，是這樣嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270810
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270810,
					"content": "但在這個時候進行飛行執照考試，真是不巧啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270811
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270811,
					"content": "發生什麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270812
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270812,
					"content": "騎士團剛收到教堂修女的報案，「怪鳥」又用風之翼逃走了，所以剛才我還以為妳的考生是那傢伙的同夥。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270813
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270813,
					"content": "怪鳥？那是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270814
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4270814,
					"content": "是蒙德城裡的一個慣犯。他總是用風之翼做案，所以得到了「怪鳥」這種外號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270815
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270815,
					"content": "唔，那傢伙飛得很快嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270816
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270816,
					"content": "目前…我們一次都沒能追上過他，這一次本來是想用教堂裡的文物做誘餌，把這傢伙抓住的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270817
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270817,
					"content": "可是還是讓他帶著文物跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270818
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270818,
					"content": "不過，這次修女們已經提前用元素魔法在文物上做好標記了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270819
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270819,
					"content": "但那傢伙飛行的速度太快了，跟著元素痕跡也追不上他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270820
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270820,
					"content": "居然是個飛行高手，那就擺明了非我安柏出馬不可了——嗯，那傢伙往哪邊逃了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270821
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270821,
					"content": "據我所知，他最後出現的地點是清泉鎮附近，但現在已經過去了這麼長時間…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270822
					],
					"speakerTitle": "奧特"
				},
				{
					"id": 4270822,
					"content": "#就放心交給我吧，正好{NICKNAME}也在，我們一起追上去，把這隻怪鳥抓捕歸案吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270823,
						4270824
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270823,
					"content": "沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270825,
					"content": "別擔心啦，等抓到怪鳥之後，我就直接…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270826
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270826,
					"content": "#…去幫{F#妳}{M#你}向琴團長說明情況，咳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270824,
					"content": "那飛行執照的考試是不是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270825
					]
				},
				{
					"id": 4270805,
					"content": "被，被兔兔伯爵吃掉…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4270806
					]
				}
			]
		},
