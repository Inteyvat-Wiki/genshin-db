			"dialogs": [
				{
					"id": 4270201,
					"content": "喂——我在這我在這。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270202
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270202,
					"content": "我已經布置好了，我們繼續考試。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270203
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270203,
					"content": "還是和之前的考試形式一樣，穿過標記一口氣飛到終點吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4270204
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4270204,
					"content": "我準備好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 42704,
			"completionStepIds": [
				42704
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
