			"dialogs": [
				{
					"id": 718230701,
					"content": "等一下，現在採蓮蓬的時間好像不太對呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718230702,
					"content": "我想想…阿芷小姐要我們午夜時分至清晨六點採蓮蓬，現在的時間不太對呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
