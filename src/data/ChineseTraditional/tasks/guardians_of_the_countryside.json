			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿芷"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718230901,
					"content": "#{F#妳}{M#你}回來啦，藥材都採到了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718230902
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718230902,
					"content": "都採到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718230903
					]
				},
				{
					"id": 718230903,
					"content": "#謝謝{F#妳}{M#你}幫忙，我也請了小白來幫我處理藥材，我們去磨坊那邊，把這幾份藥材也送過去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿芷"
				}
			]
		},
		{
			"id": 7182310,
			"completionStepIds": [
				7182310
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7182310",
							"2"
						],
						"stepId": 7182310,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小白"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 718231001,
					"content": "…唔，這些藥材我就一起處理了吧，處理好了之後，妳也能快點拿去做藥了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231002
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718231002,
					"content": "嗯，謝謝妳啦，我得再想想辦法把藥做得甜一點，不然那些孩子一定又不肯吃了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231003
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231003,
					"content": "妳們每年這時候都這麼忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231004
					]
				},
				{
					"id": 718231004,
					"content": "嗯…差不多吧，畢竟輕策莊裡的年輕人實在沒多少，那些能幫忙的事，我們還是盡量幫忙比較好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231005
					],
					"speakerTitle": "小白"
				},
				{
					"id": 718231005,
					"content": "#其實每年也就忙這麼幾天，沒什麼關係的，而且今年有{F#妳}{M#你}幫忙，我們也輕鬆了不少。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231006
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231006,
					"content": "之前幾年，我每次採藥都要花很多天，更別提做藥了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231007
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231007,
					"content": "#好啦，謝謝{F#妳}{M#你}們幫忙，我們也要快點把藥材處理好，然後去準備霄燈了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231008
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231008,
					"content": "去年我就差點忘了放霄燈，今年可不能忘了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231009
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231009,
					"content": "妳想許什麼願望？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718231010
					]
				},
				{
					"id": 718231010,
					"content": "唔…輕策莊裡的人都身體健康？嘿嘿，差不多是類似的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231011
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231011,
					"content": "#不過，願望說出來就不靈了，就不說給{F#妳}{M#你}聽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718231012
					],
					"speakerTitle": "阿芷"
				},
				{
					"id": 718231012,
					"content": "#這些東西給{F#妳}{M#你}，今天謝謝{F#妳}{M#你}幫忙啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿芷"
				}
			]
		},
