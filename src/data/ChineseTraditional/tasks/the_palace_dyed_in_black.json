			"dialogs": [
				{
					"id": 400580701,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580702
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580702,
					"content": "萬葉，怎麼樣，那些紙應該不是普通的白紙吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580703
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400580703,
					"content": "和大家猜測的一樣，灑上水後，紙上確實浮現出了筆跡，那是一封我曾祖父寫的信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580704
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580704,
					"content": "信上說了什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400580705,
					"content": "是我們可以知道的事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400580706
					]
				},
				{
					"id": 400580706,
					"content": "嗯，我會把曾祖父知道的真相也告訴大家，不過在那之前，我想先帶大家去一個地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580707
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580707,
					"content": "大家跟我來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				}
			]
		},
		{
			"id": 4005808,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005821",
							"2"
						],
						"stepId": 4005821,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400580801,
					"content": "楓原，為什麼要帶我們來這片海邊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580802
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400580802,
					"content": "這裡與信的內容有關嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400580803
					]
				},
				{
					"id": 400580803,
					"content": "嗯。這片海岸，就是我曾祖父當年與神里家主追蹤逃亡刀匠的蹤跡，最後到達的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580804
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580804,
					"content": "我們之前的推測沒有錯，曾祖父的確知道鍛刀失敗的真相。而且也就在這裡，找到了陷害楓原家與雷電五傳的真兇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580805
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580805,
					"content": "那封信上是這樣寫的：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580806
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580806,
					"content": "「致讀信之人：吾楓原義慶終其一生，始終受困於某一『秘密』，而今吾已時日無多，思前想後，最終決定將此事和盤托出。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580807
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580807,
					"content": "「當年，吾與社奉行神里大人追捕叛逃刀匠之時，並非為叛逃者所傷。事實上……」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580901,
					"content": "…是夜，我等循著線索來到岸邊時，未見任何刀匠蹤影，卻僅有一名傾奇者現身。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580902
					],
					"speakerTitle": "楓原義慶"
				},
				{
					"id": 400580902,
					"content": "傾奇者自居幕後主使，聲稱已等候我等多時，揚言絕滅雷電五傳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580903
					],
					"speakerTitle": "楓原義慶"
				},
				{
					"id": 400580903,
					"content": "此人身手遠非常人能敵，僅須臾之間，我等隨行武士便被盡數擊倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580904
					],
					"speakerTitle": "楓原義慶"
				},
				{
					"id": 400580904,
					"content": "神里大人身受重傷，吾則因為被劈中了頭頂斗笠，才僥倖逃過一死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580905
					],
					"speakerTitle": "楓原義慶"
				},
				{
					"id": 400580905,
					"content": "傾奇者再有一擊便可取吾性命，但見吾長相，卻不再攻擊，而是厲聲逼問吾與「丹羽」有何瓜葛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580906
					],
					"speakerTitle": "楓原義慶"
				},
				{
					"id": 400580906,
					"content": "吾只得作答此為家父舊姓，家父失蹤後，吾便被楓原主家收養。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580907
					],
					"speakerTitle": "楓原義慶"
				},
				{
					"id": 400580907,
					"content": "傾奇者聽後不再言語。沉默許久，忽道：「告知她，吾名『國崩』。」隨即轉身離去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "楓原義慶"
				}
			]
		},
