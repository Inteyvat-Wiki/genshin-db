			},
			"dialogs": [
				{
					"id": 400585501,
					"content": "#喔，是{F#妳}{M#你}們啊。我這裡目前沒發現什麼有價值的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585502
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400585502,
					"content": "是嗎，不過這扇屏風看起來好像挺有年頭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400585503,
					"content": "嗯，如果保養狀態好一點的話，說不定還能賣出價錢，現在這樣是肯定不行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585504
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400585504,
					"content": "我剛才檢查了一下，背面有一大塊沒清理乾淨的泥土卡在布料纖維裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585505
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400585505,
					"content": "泥土能和布料結合得這麼緊，粘上去的時候力量很大，很有可能就是萬葉的爺爺扔出去的花盆砸在了這上面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585506,
						400585507
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400585506,
					"content": "這不算是重要發現嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400585508
					]
				},
				{
					"id": 400585508,
					"content": "因為它並不是我們現在要找的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585509
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400585509,
					"content": "讓我想想，如果是我想要留下訊息的話，一定會留在一個更特殊的東西上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585510
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400585510,
					"content": "阿貝多陷入思考了，我們還是不要打擾他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400585507,
					"content": "怎麼說沒有價值呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400585508
					]
				}
			]
