			"dialogs": [
				{
					"id": 400585601,
					"content": "不好意思，這裡的東西是最近才搬進來的，所以放得有點亂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585602
					],
					"speakerTitle": "淺川"
				},
				{
					"id": 400585602,
					"content": "之前的倉庫雖然大，但門鎖都老了，還差點發生盜竊案，所以九條大人就下令把倉庫搬來了這裡。",
					"roleType": "TALK_ROLE_NPC",
