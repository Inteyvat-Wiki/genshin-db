	"talks": [
		{
			"id": 4005801,
			"completionStepIds": [
				4005803
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005803",
							"2"
						],
						"stepId": 4005803,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400580101,
					"content": "你們來了，這樣人就都到齊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580102
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580102,
					"content": "萬葉，你調查得怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400580103
					]
				},
				{
					"id": 400580103,
					"content": "昨天晚上，我拜訪了曾在我家工作的一位老僕人，從他那裡知道了當年整個事情的始末。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580104
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580104,
					"content": "「一心傳」在我曾祖父那一代，曾經奉命依照一份古老的鍛造圖譜，製作一把重要的御神刀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580105
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580105,
					"content": "雖然參與鍛刀的都是很有經驗的匠人，可過程卻一直很不順利，做出的刀全都是殘次品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580106
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580106,
					"content": "眼看到了最後期限，刀卻依舊無法鍛好，負責的刀匠們因此畏罪潛逃了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580107
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580107,
					"content": "楓原家與社奉行展開了調查，曾祖父與神里家家主總算在海邊追上了那些匠人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580108
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580108,
					"content": "然而他們卻遭到了對方的激烈抵抗，最終，沒能阻止叛逃者們乘船離開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580109
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580109,
					"content": "楓原家由於門下刀匠叛逃而受到重罰，從此便一蹶不振了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580110
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580110,
					"content": "不僅如此，我聽說神里家家主也被叛逃者所傷，再加上年事已高，不久後就過世了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580111
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580111,
					"content": "是的…因為家主過世得突然，神里家一時群龍無首，又有奸人趁機作梗，在社奉行的地位也變得岌岌可危。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580112
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400580112,
					"content": "此事影響深遠，直至家主之位傳到我父親手上，神里家也依舊沒能恢復當初的名望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580113
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400580113,
					"content": "原來是這樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400580114
					]
				},
				{
					"id": 400580114,
					"content": "不過幸虧有兄長在，現在一切總算是好了起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580115
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400580115,
					"content": "當年的鍛刀失敗，最終被歸因為「技藝不精」，楓原家和社奉行也一直是這麼認為的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580116
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580116,
					"content": "但五歌仙的故事卻似乎在暗示，失敗並非因為技藝，而是因為那份圖譜被人篡改過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580117
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580117,
					"content": "神里小姐，我昨天聽說，當年鍛刀失敗後，那份圖譜就一直保存在社奉行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580118
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580118,
					"content": "不知道妳是否願意幫這個忙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580119
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580119,
					"content": "我明白了，既然這樣我先回去尋找圖譜，大家稍後到神里屋敷與我會合即可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
		{
			"id": 4005802,
			"completionStepIds": [
				4005805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4005805",
							"2"
						],
						"stepId": 4005805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"神里綾華"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400580201,
					"content": "各位，當年那份圖譜我已經找到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580202
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400580202,
					"content": "嗯，雖然圖譜保存得不錯，不過看樣子至少有三、四百年歷史了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580203
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400580203,
					"content": "這麼古老的圖譜，還能夠找出被篡改過的證據嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400580204,
					"content": "事到如今，我們也只能碰碰運氣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580205
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400580205,
					"content": "把鍛造圖譜浸入了水盆中，幾分鐘後…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400580206
					]
				},
				{
					"id": 400580206,
					"content": "雖然效果不太明顯，但能看出有一些字變得模糊了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580207
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400580207,
					"content": "萬葉，這份圖譜的確被篡改過，當年有人陷害了楓原家。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580208
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400580208,
					"content": "呼…不知道現在發現這個秘密，會不會已經太晚了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580209
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580209,
					"content": "其實，我爺爺年輕時多次對曾祖父提出要重振「一心傳」，結果卻被曾祖父大罵不自量力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580210
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580210,
					"content": "昨天那位老僕人說，曾祖父甚至還到社奉行，請神里家主把這份圖譜拿給爺爺看，讓他帶手下鍛成這把刀再說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580211
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580211,
					"content": "毫無疑問爺爺也失敗了，於是曾祖父便說：「你找不出其中的秘密，一心傳在世上消失也是活該。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580212
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580212,
					"content": "聽了這些話，爺爺一氣之下便離開了稻妻，結果就連曾祖父的最後一面都沒有見到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580213
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580213,
					"content": "現在看來，他們父子二人的爭執，其實根本就沒有意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580214
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580214,
					"content": "萬葉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400580215,
					"content": "我聽說你曾祖父楓原義慶年輕時十分勤勉，可後來卻不再過問鍛造技藝。看來，當年的失敗對他打擊很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580216
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400580216,
					"content": "萬葉，你曾祖父當年所說的話，真的是「你找不出其中的秘密」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580217
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400580217,
					"content": "對，那位老僕人說，那些話都是他親耳聽見，記得很清楚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580218
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580218,
					"content": "當時我爺爺還一氣之下，把曾祖父珍愛的盆栽摔壞了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580219
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580219,
					"content": "阿貝多，你難道是想說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400580220
					]
				},
				{
					"id": 400580220,
					"content": "#{NICKNAME}，看來{F#妳}{M#你}已經明白了我的意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580221
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400580221,
					"content": "萬葉，如果你的曾祖父認為是一心傳技藝不精，看到兒子失敗，應該會說「你能力不夠」這樣的話吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580222
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400580222,
					"content": "但他說的卻是「你找不出其中的秘密」，這不是很奇怪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580223
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400580223,
					"content": "…啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580224
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580224,
					"content": "所以，你的意思是…我曾祖父或許早就知道，失敗是因為有人從中作梗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580225
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580225,
					"content": "現有的證據顯示，這種可能性很大。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580226
					],
					"speakerTitle": "阿貝多"
				},
				{
					"id": 400580226,
					"content": "不知道各位能否跟我去一趟天領奉行？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580227
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580227,
					"content": "我之前被通緝後，家裡最後剩下的那間古屋被天領奉行查抄了，那裡面存放的都是我家的舊物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580228
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580228,
					"content": "我想去詢問一下那些東西的去向，如果能找到的話，說不定能發現什麼線索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580229
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400580229,
					"content": "那我們馬上出發吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
