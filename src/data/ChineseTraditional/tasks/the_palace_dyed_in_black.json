				},
				{
					"id": 400580502,
					"content": "不過相應的物品上我都做好了標記，應該不會太難找。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580503
					],
					"speakerTitle": "淺川"
				},
				{
					"id": 400580503,
					"content": "我就在門口等待各位，如果需要幫助請來找我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400580504
					],
