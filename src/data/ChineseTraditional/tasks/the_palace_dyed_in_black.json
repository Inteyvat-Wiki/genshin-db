				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400585701,
					"content": "嗯，有沒有呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585702
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400585702,
					"content": "溫迪，你在找什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400585703
					]
				},
				{
					"id": 400585703,
					"content": "#{F#妳}{M#你}看，這裡有這麼多罐子，肯定會有一兩個裝酒的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585704
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400585704,
					"content": "喂！其他人都在幫忙，你竟然還在找酒喝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585705
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400585705,
					"content": "哈哈哈，開個玩笑。我們已經快要找到真相了，為什麼你們看起來卻顧慮重重的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585706
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400585706,
					"content": "因為我不是很明白，萬葉為什麼今天就跟裟羅說要把這些東西處理掉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585707
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400585707,
					"content": "萬一我們今天什麼都沒有找到…我是說萬一！萬葉今後不就再也沒有機會尋找當年的真相了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585708
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400585708,
					"content": "#我知道{F#妳}{M#你}們很擔心萬葉，但我覺得，他比{F#妳}{M#你}們想像中要堅強。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585709
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400585709,
					"content": "萬葉既然這樣做了，就說明他已經做好了準備——無論我們今天能否找到答案，無論答案是什麼，他都會坦然接受。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585710
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400585710,
					"content": "這是你身為神的直覺嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400585711
					]
				},
				{
					"id": 400585711,
					"content": "與其說是直覺，不如說是因為活得比較久，所以總結出了一些識人的經驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585712
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400585712,
					"content": "#這邊就交給我，{F#妳}{M#你}們去其他地方搜查吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		}
	]
