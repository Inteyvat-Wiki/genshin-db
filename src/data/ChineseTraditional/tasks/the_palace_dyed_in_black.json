				"points": []
			},
			"dialogs": [
				{
					"id": 400585301,
					"content": "行秋，你找到什麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400585302,
					"content": "我找到了不少舊書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585303
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400585303,
					"content": "這一堆都是和鋼鐵冶煉有關的，這一堆是講刀具鍛造流程的，這一堆都是植物花藝類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585304
					],
					"speakerTitle": "行秋"
				},
				{
					"id": 400585304,
					"content": "植物花藝類的書，肯定是萬葉曾祖父的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400585305,
					"content": "上面會不會有線索？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400585306
					]
				},
				{
					"id": 400585306,
					"content": "#剛才我大致翻了一遍，沒找到值得注意的東西。不過我會再仔細看看，如果有線索就馬上告訴{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "行秋"
				}
			]
		},
