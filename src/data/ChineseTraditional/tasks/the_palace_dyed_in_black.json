			"dialogs": [
				{
					"id": 400585201,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585202
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400585202,
					"content": "綾華，情況怎麼樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400585203
					]
				},
				{
					"id": 400585203,
					"content": "#{NICKNAME}，是{F#妳}{M#你}啊，我正在調查這具刀座。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585204
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400585204,
					"content": "楓原家既然是鍛刀名家，這把刀應該會很值錢吧？比如說是「一心傳」的傑作什麼的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400585205,
					"content": "不，刀座雖然是上好的木料，但擺在上面的卻是一把很普通的刀。按照楓原家最後的經濟狀況，值錢的收藏肯定已經拿去變賣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585206
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400585206,
					"content": "這把刀沒有開刃，但刀柄上倒有不少使用痕跡，說不定是楓原小時候學習劍術的時候用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585207
					],
					"speakerTitle": "神里綾華"
				},
				{
					"id": 400585207,
					"content": "讓我看看…啊，刀鞘上好像刻有一些歪歪扭扭的字！「萬」…「葉」，哈，真的是萬葉小時候用過的刀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400585208,
					"content": "好像都能想像出萬葉小時候的樣子了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400585209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400585209,
					"content": "#我再在附近調查一下其他東西，如果有發現的話就喊{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "神里綾華"
				}
			]
		},
