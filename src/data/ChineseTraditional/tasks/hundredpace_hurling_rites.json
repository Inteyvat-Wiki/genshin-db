				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"廷稚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 715230101,
					"content": "唔，這樣應該就不會太困難了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230102
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230102,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230103
					]
				},
				{
					"id": 715230103,
					"content": "我正在佈置我所負責的這種遊戲呢…您聽說過「百步禮擲」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230104
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230104,
					"content": "我是要隔著很遠，禮貌地丟東西嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230105
					]
				},
				{
					"id": 715230105,
					"content": "您…非常敏銳，已經說對了大半，這種遊戲的核心正是「丟擲」。但「禮」字可不是如此解法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230106
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230106,
					"content": "這種玩法我也是從一本古書裡看來的，讓我為您簡單介紹一下…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230107
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230107,
					"content": "按照最傳統的遊戲規則，玩這種名為「禮擲」的遊戲時，所有參與者都需要靜坐下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230108
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230108,
					"content": "呃，靜坐的時候還需要保持一個特別的姿勢，我就不為您示範了，這裡沒墊子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230109
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230109,
					"content": "靜坐之後，遊玩者需要遵循著某種特定音樂的節奏，將手裡的「擲箭」投向遠處的「容壺」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230110
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230110,
					"content": "「擲箭」入壺的各種方式，也有著各自的特別命名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230111
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230111,
					"content": "比如第一支被投入壺中的箭，被叫做「有初」，如果第二箭也投進去了，那就叫做「連中」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230112
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230112,
					"content": "投出去的箭擊中了壺耳，那就被稱為「貫耳」。一支箭本來已經投入壺中，卻又跳出來，則被叫做「驍箭」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230113,
						715230116
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230113,
					"content": "太、太複雜了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230114
					]
				},
				{
					"id": 715230114,
					"content": "您別擔心啊，我剛才不都說了，這只是「最傳統的遊戲規則」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230115
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230115,
					"content": "為了方便大家遊玩，我已經將規則簡化了許多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230118
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230118,
					"content": "咳！總之，您只需要記住，在一定的時間內，往那個壺裡投入越多的「擲箭」越好，其餘的…就交給我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230119
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230119,
					"content": "規則說明就這樣簡化了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230120
					]
				},
				{
					"id": 715230120,
					"content": "哎呀…那本書上寫的遊戲規則中，本來也寫著誰投入壺中的箭越多，誰就獲勝嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230121
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230121,
					"content": "至於輸的人要飲酒作詩之類的…我總不能真讓玩遊戲的人輸了就作詩吧，那多少有些難為人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230122
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230122,
					"content": "總之！場地我差不多已經佈置好了，「容壺」就在那邊，我等會再把「擲箭」拿過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230123
					],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230123,
					"content": "有興趣的話，您現在就可以去試玩一下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "廷稚"
				},
				{
					"id": 715230116,
					"content": "記、記不住！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						715230117
					]
				},
				{
					"id": 715230117,
					"content": "別擔心，您不需要記住這麼多名詞，這是…呃…這是我應該記住的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						715230118
					],
					"speakerTitle": "廷稚"
				}
			]
		}
	]
}