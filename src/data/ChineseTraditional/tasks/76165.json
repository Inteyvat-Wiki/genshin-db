			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650101,
					"content": "唔…看起來是執燈人的墓碑呢。難道是我們在峽谷裡見到的那群執燈士們的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761650102,
					"content": "他們一閃一閃的，突然出現又消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761650103,
					"content": "唔，真是搞不懂。下次去皮拉米達城問問吧！說不定那邊有人知道這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7616502,
			"completionStepIds": [
				7616502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7616502",
							"2"
						],
						"stepId": 7616502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"帕托利切夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 761650201,
					"content": "哦，您好，我是帕托利切夫，執燈人物資事務官。您有何貴幹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650202
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650202,
					"content": "「凜風之馬」的帕托利切夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650203
					]
				},
				{
					"id": 761650203,
					"content": "「凜風之馬」…啊，就是之前我們看到那些奇怪的影子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761650204,
					"content": "#是的，{M#先生}{F#小姐}，那是我從前隸屬的分隊。「凜風之馬」，真是讓人懷念的名字，沒想到居然會從您口中說出…您是怎麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650205,
						761650208
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650205,
					"content": "我們之前去過苦壑崖下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650206
					]
				},
				{
					"id": 761650206,
					"content": "沒錯沒錯，我們清理了那邊出現的狂獵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761650207,
					"content": "而且我們還看到了「凜風之馬」的執燈士，和狂獵戰鬥留下的影子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761650210,
					"content": "沒想到居然是真的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650211
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650211,
					"content": "當然是真的，我們可是親眼看到的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 761650212,
					"content": "啊…這些年，時不時有人告訴我，在苦壑崖看到過我已然犧牲的那些同僚的身影。所以直到現在，我也經常會到那去…順便給他們掃掃墓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650213
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650213,
					"content": "但是我一次也沒有…我一次也沒有看到過他們，已經很久了，我以為那些不過是為了寬慰我而編造的謊話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650214
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650214,
					"content": "#沒想到{F#妳}{M#你}們真的見到了他們…但為什麼我去的時候，他們都不願意出來見我呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650215,
						761650217
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650215,
					"content": "或許還未到相見的時刻…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650216
					]
				},
				{
					"id": 761650216,
					"content": "也許吧…但我知道他們真的在那，哪怕只是一絲回憶，一抹虛影，對我來說也已經足夠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650219,
					"content": "#總之，感謝您，{M#先生}{F#小姐}，感謝您願意告訴我，這對我來說真的很重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650220
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650220,
					"content": "托他們的福，我現在才能站在此處，但我無比希望我能再次跟他們一同站在苦壑崖下，並肩作戰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650221
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650221,
					"content": "…總有一日，總有一日我會與他們再會的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650217,
					"content": "也許並不想讓你回憶起痛苦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650218
					]
				},
				{
					"id": 761650218,
					"content": "唉…與他們並肩作戰直到最後的那段時間，怎麼會是痛苦的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650219
					],
					"speakerTitle": "帕托利切夫"
				},
				{
					"id": 761650208,
					"content": "我們看到了「凜風之馬」的執燈士…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						761650209
					]
				},
				{
					"id": 761650209,
					"content": "沒錯，雖然他們只留下了一些影子…不過那些影子也保留著他們和狂獵作戰的樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761650210
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}