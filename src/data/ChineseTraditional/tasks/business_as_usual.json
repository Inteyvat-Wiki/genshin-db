			"trigger": {
				"objectNames": [
					"瀾陽"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 191320401,
					"content": "#{F#妳}{M#你}好，請問有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320402
					],
					"speakerTitle": "瀾陽"
				},
				{
					"id": 191320402,
					"content": "我是來幫凝光拿衣服的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320403
					]
				},
				{
					"id": 191320403,
					"content": "#哦，我之前聽說了，那請{M#你}{F#妳}稍等片刻，我進去取一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320404
					],
					"speakerTitle": "瀾陽"
				},
				{
					"id": 191320404,
					"content": "在等待了很長時間之後，瀾陽終於回來了。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						191320405
					]
				},
				{
					"id": 191320405,
					"content": "#就是這個，麻煩{M#你}{F#妳}將這個交給凝光大人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320406
					],
					"speakerTitle": "瀾陽"
				},
				{
					"id": 191320406,
					"content": "妳好像花了挺長時間。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320407
					]
				},
				{
					"id": 191320407,
					"content": "嗯，因為這個房間裡放了很多凝光大人的收藏品，不只是衣服，還有各種文玩，玉器…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320408
					],
					"speakerTitle": "瀾陽"
				},
				{
					"id": 191320408,
					"content": "最近正在按照凝光大人的意思調整佈局，所以房間比較雜亂，目前並不方便隨意出入。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						191320409,
						191320410
					],
					"speakerTitle": "瀾陽"
				},
				{
					"id": 191320409,
					"content": "（聽起來收藏品確實很多…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				},
				{
					"id": 191320411,
					"content": "#總之謝謝{M#你}{F#妳}，這衣服就交給{M#你}{F#妳}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "瀾陽"
				},
				{
					"id": 191320410,
					"content": "（這也算有錢人的煩惱吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						191320411
					]
				}
			]
		},
