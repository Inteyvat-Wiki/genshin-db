			},
			"dialogs": [
				{
					"id": 760710301,
					"content": "#太好了，謝謝{F#妳}{M#你}。有了這些新鮮的麥子，就能做出溫暖的麵包了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760710302
					],
					"speakerTitle": "別蕾娜",
					"speakerSubtitle": "執燈士"
				},
				{
					"id": 760710302,
					"content": "#那麼作為回報，我就教{F#妳}{M#你}烤製「蘑幻之菇」的方法吧，要記住哦…",
					"roleType": "TALK_ROLE_NPC",
