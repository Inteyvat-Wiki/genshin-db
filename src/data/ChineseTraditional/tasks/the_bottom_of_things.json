				"points": []
			},
			"dialogs": [
				{
					"id": 1903201201,
					"content": "唉，好累，終於可以休息了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201202
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201202,
					"content": "是不是有點過火了呢，好像有幾個人被嚇破膽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201203
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201203,
					"content": "請問你是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201204
					]
				},
				{
					"id": 1903201204,
					"content": "啊啊，這裡不應該靠近！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201205
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201205,
					"content": "#唉，算了，被{F#妳}{M#你}聽到了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201206
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201206,
					"content": "我就是在這裡扮演鬼怪的工作人員，現在輪到我休息，所以又熱又不透氣的衣服被我脫掉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201207,
						1903201208
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201207,
					"content": "果然這裡沒有鬼吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				},
				{
					"id": 1903201209,
					"content": "是啊，怎麼可能會有真正的鬼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201210
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201210,
					"content": "無論是我們，還是來參加試膽大會的人，都不希望看到真正的鬼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201211
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201211,
					"content": "他們想要的，只是一種氛圍，或者說，契機。最重要的是刺激的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201212
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201212,
					"content": "在提心吊膽中，遭遇一些意外，順勢說出平時不敢說的話，這就是試膽大會的作用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903201213,
						1903201214
					],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201213,
					"content": "我也這樣覺得。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201215,
					"content": "#好了，我差不多該繼續工作了，{F#妳}{M#你}和{F#妳}{M#你}的朋友也要玩得開心哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "周良"
				},
				{
					"id": 1903201214,
					"content": "（重雲應該很失望。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201215
					]
				},
				{
					"id": 1903201208,
					"content": "都只是嚇唬人的對吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903201209
					]
				}
			]
		}
	]
}