			},
			"dialogs": [
				{
					"id": 708150401,
					"content": "唉，本來我算著日子，再值個兩三天班就能回去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150402
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 708150402,
					"content": "加上我之前積的假，這次回去少說能陪小六一個多星期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150403
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 708150403,
					"content": "結果一聲命令全體千岩軍取消休假，正在休假的也全部召回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150404
					],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 708150404,
					"content": "按照我的經驗，至少一個月內我都別想回輕策莊。這都叫什麼事嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉毅"
				}
			]
		},
		{
			"id": 7081505,
			"completionStepIds": [
				7081502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
