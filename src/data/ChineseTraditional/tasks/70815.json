					"小六"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150701,
					"content": "#{F#妳}{M#你}們是來抓我回輕策莊的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150702,
						708150704
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150702,
					"content": "若心奶奶很擔心你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150703
					]
				},
				{
					"id": 708150703,
					"content": "哼，果然是來抓我回去的，我才不回去呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150706,
					"content": "#{F#妳}{M#你}們回去告訴村裡的人，我要去璃月港找我爸爸去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150707
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150707,
					"content": "找到了之後，我和我爸爸說一下話就回去，讓他們別操心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小六"
				},
				{
					"id": 708150704,
					"content": "我們有東西給妳…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150705
					]
				},
				{
					"id": 708150705,
					"content": "#我才不要{F#妳}{M#你}們的東西，又是那些哄小孩的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150706
					],
					"speakerTitle": "小六"
				}
			]
		},
		{
			"id": 7081508,
			"completionStepIds": [
				7081508
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7081508",
							"2"
						],
						"stepId": 7081508,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"小六"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150801,
					"content": "#{F#妳}{M#你}們跟著我到底有什麼事？我說了我要去璃月港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150802
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150802,
					"content": "這些魔物我自己會繞著走，它們發現不了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150803
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150803,
					"content": "別老是把我當小孩子，我已經長大了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150804
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150804,
					"content": "這是妳爸爸給妳的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150805
					]
				},
				{
					"id": 708150805,
					"content": "#我爸爸給我的？是他要{F#妳}{M#你}們送過來的嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150806
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150806,
					"content": "準又是些小孩子玩的東西…不是風箏就是娃娃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150807
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150807,
					"content": "妳不喜歡這些？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150808
					]
				},
				{
					"id": 708150808,
					"content": "…喜歡啊，我爸爸送給我的東西，我怎麼可能不喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150809
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150809,
					"content": "但我要是一直只喜歡這些東西的話，不就一直是小孩子了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150810
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150810,
					"content": "老是玩這些，我什麼時候能成為冒險家，拿到「神之眼」啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150811
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150811,
					"content": "妳要「神之眼」做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150812
					]
				},
				{
					"id": 708150812,
					"content": "有了「神之眼」，我就能做到很多事了啊，無論是賺錢還是其他什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150813
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150813,
					"content": "然後，爸爸就不用天天在璃月港裡工作，可以回來陪我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150814
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150814,
					"content": "#{F#妳}{M#你}看，現在我沒有「神之眼」…連自己去璃月港都做不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150815
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150815,
					"content": "#不過，爸爸都讓{F#妳}{M#你}們把禮物送過來了，我去找他，說不定還會給他添麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150816
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150816,
					"content": "<color=#00E1FFFF>我本來也給他準備了禮物</color>，想要給他個驚喜的…但現在我自己是送不過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150817
					],
					"speakerTitle": "小六"
				},
				{
					"id": 708150817,
					"content": "#<color=#00E1FFFF>要是有人願意幫我送過去</color>…算了，我回去了。{F#妳}{M#你}們別跟著我了，我自己知道回去的路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小六"
				}
			]
		},
