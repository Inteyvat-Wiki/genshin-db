			"dialogs": [
				{
					"id": 708150601,
					"content": "嘉毅也是，怎麼說不回來就不回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150602
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150602,
					"content": "這孩子一年都見不到他幾次，這天下哪裡有這麼當爸爸的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150603,
						708150605
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150603,
					"content": "他也是為了璃月港…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150604
					]
				},
				{
					"id": 708150604,
					"content": "嘉毅年年也都這麼說，我都記不清他說了多少次了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 708150605,
					"content": "這也是為了工作…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150606
					]
				},
				{
					"id": 708150606,
					"content": "那他也要顧顧自己的女兒吧，小六可是看著看著要長大了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150607
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150607,
					"content": "可別到時候，他是不工作了回莊裡住著了，結果小六又要去工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150608
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150608,
					"content": "這父女倆啊，反正就湊不到一塊去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
		{
			"id": 7081507,
			"completionStepIds": [
				7081505
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
