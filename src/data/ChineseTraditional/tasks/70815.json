					"nextDialogs": [
						708151103
					]
				},
				{
					"id": 708151103,
					"content": "#那就好，那都是她最喜歡的玩具。謝謝{F#妳}{M#你}們，這些拿著吧，算是謝禮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "嘉毅"
				},
				{
					"id": 708151104,
