			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"若心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 708150501,
					"content": "這孩子，跑到哪裡去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150502
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150502,
					"content": "關於小六…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150503
					]
				},
				{
					"id": 708150503,
					"content": "#{F#妳}{M#你}們是來找小六的？唉，{F#妳}{M#你}們來得不巧，那孩子不知道跑到哪裡去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150504
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150504,
					"content": "前幾天，她爸爸從璃月港裡託人帶了封信回來，說很快就能回來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150505
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150505,
					"content": "小六很開心，說要給她爸爸準備禮物，拉著幾個孩子到處採花採野果…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150506
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150506,
					"content": "結果前幾天，她爸爸又說臨時要執勤，回不來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150507
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150507,
					"content": "這孩子就賭了氣，怎麼勸也不好，非說她爸爸不回來，她就自己去璃月港。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150508
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150508,
					"content": "我們還當她是開玩笑，結果今天一起來，小六人就不見了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150509
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150509,
					"content": "#唉，能去找她的人已經都出去找她了，要是{F#妳}{M#你}們願意的話，就也去找找她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						708150510,
						708150512
					],
					"speakerTitle": "若心"
				},
				{
					"id": 708150510,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150511
					]
				},
				{
					"id": 708150511,
					"content": "#那就麻煩{F#妳}{M#你}了，唉，這孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 708150512,
					"content": "她會去哪？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						708150513
					]
				},
				{
					"id": 708150513,
					"content": "#這孩子也跑不太遠，應該就在附近，但荒郊野外的太危險了…{F#妳}{M#你}們快去找找她吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				}
			]
		},
		{
			"id": 7081506,
