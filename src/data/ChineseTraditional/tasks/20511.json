			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安東尼"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 205110101,
					"content": "這藥方，真會管用嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110102
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110103
					]
				},
				{
					"id": 205110103,
					"content": "#旅行者！{F#妳}{M#你}來得正好，我正煩惱著呢，",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110104
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110104,
					"content": "#是這樣，{F#妳}{M#你}還記得我妹妹安娜吧，她一直生著病，之前怎麼治也沒起色…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110105
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110105,
					"content": "但是我聽說璃月港裡有一位神醫，很擅長解決疑難雜症，就託人去求他開藥方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110106
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110106,
					"content": "雖然藥方裡的材料都很奇怪…但也只有試一試了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110107
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110107,
					"content": "#呃，我看看…{F#妳}{M#你}能幫我去找一份「被草史萊姆吞下去過的樹莓」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110108,
						205110112,
						205110116
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110108,
					"content": "真的有這種東西嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110109
					]
				},
				{
					"id": 205110109,
					"content": "我也不知道啊！草史萊姆真的會吃樹莓嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110110
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110110,
					"content": "#就，就拜託{F#妳}{M#你}了！我知道一個地方有草史萊姆出沒，也長著樹莓。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110111
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110111,
					"content": "#拜託{F#妳}{M#你}去看看吧，希望能找到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110112,
					"content": "庸醫誤事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110113
					]
				},
				{
					"id": 205110113,
					"content": "#果然{F#妳}{M#你}也這麼覺得嗎？但是，我也是真的沒辦法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110114
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110114,
					"content": "#我知道一個地方有很多草史萊姆，也長著樹莓，拜託{F#妳}{M#你}去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110115
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110115,
					"content": "然後，做出來的藥我會先吃下去試試。無論如何，不能讓安娜的身體再壞下去了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110116,
					"content": "找不到的話，我就抓個草史萊姆給你。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						205110117
					]
				},
				{
					"id": 205110117,
					"content": "#咦…咦？{F#妳}{M#你}是要我親手把樹莓塞給草史萊姆吃嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110118
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110118,
					"content": "#{F#妳}{M#你}就饒了我吧，我上次給安娜採藥的時候，被一群草史萊姆一直追到了清泉鎮裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110119
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110119,
					"content": "#我知道一個地方有很多草史萊姆，也長著樹莓，拜託{F#妳}{M#你}去看看吧，希望會有發現…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						205110120
					],
					"speakerTitle": "安東尼"
				},
				{
					"id": 205110120,
					"content": "#但是…如，如果實在不行，為了安娜…{F#妳}{M#你}，{F#妳}{M#你}就抓個草史萊姆回來吧！我能行！我一定能行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安東尼"
				}
			]
		},
