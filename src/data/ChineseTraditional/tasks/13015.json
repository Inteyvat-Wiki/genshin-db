			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"皮特",
					"納西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150101,
					"content": "#太好了，{F#妳}{M#你}們也醒過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150102
					],
					"speakerTitle": "皮特"
				},
				{
					"id": 130150102,
					"content": "大家都陸續醒來，城裡也好消息不斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150103
					],
					"speakerTitle": "皮特"
				},
				{
					"id": 130150103,
					"content": "看來事情已經順利解決了對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150104
					],
					"speakerTitle": "皮特"
				},
				{
					"id": 130150104,
					"content": "嗯，雖然費了一些周折。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150105
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150105,
					"content": "等等應該會有很多人聚過來，麻煩你維持一下現場的秩序。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150106
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150106,
					"content": "#我和{M#他}{F#她}們去一趟教令院，馬上就回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納西妲"
				}
			]
		},
		{
			"id": 1301502,
			"completionStepIds": [
				1301502
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301502",
							"2"
						],
						"stepId": 1301502,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"希忒",
					"納西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150201,
					"content": "是草神大人，請問有什麼事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150202
					],
					"speakerTitle": "希忒"
				},
				{
					"id": 130150202,
					"content": "我想查詢一下學籍資料，是否有一位剎訶伐羅學院的學者，現在處於昏迷不醒的狀態。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150203
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150203,
					"content": "好的，請稍等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150204
					],
					"speakerTitle": "希忒"
				},
				{
					"id": 130150204,
					"content": "過了一段時間。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						130150205
					]
				},
				{
					"id": 130150205,
					"content": "久等了，草神大人，的確是有這樣一位學者，名叫貝諾尼，因為違規操作虛空而陷入昏迷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150206
					],
					"speakerTitle": "希忒"
				},
				{
					"id": 130150206,
					"content": "直到現在他還沒有恢復意識，仍在接受「健康之家」的治療。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150207
					],
					"speakerTitle": "希忒"
				},
				{
					"id": 130150207,
					"content": "欸？他不是叫莫塞伊思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150208,
					"content": "應該是不想被認出來吧，他不願意被任何人打擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150209
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150209,
					"content": "這裡面儲存的知識，麻煩轉交給風紀官，請他們引入貝諾尼的大腦中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150210
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150210,
					"content": "好的，不過出於安全性考慮，我還需要瞭解一下理由。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150211
					],
					"speakerTitle": "希忒"
				},
				{
					"id": 130150211,
					"content": "很簡單，這裡面是他的意識，之前被困在某個夢境裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150212
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150212,
					"content": "他在夢境中做了一些影響須彌治安的事，在他醒來之後，我會和大風紀官概述情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150213
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150213,
					"content": "明白了，我這就去做，感謝草神大人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150214
					],
					"speakerTitle": "希忒"
				},
				{
					"id": 130150214,
					"content": "嗯，沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150215
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150215,
					"content": "「品夢一刻」那邊的人應該也聚集起來了，我們回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納西妲"
				}
			]
		},
		{
			"id": 1301503,
			"completionStepIds": [
				1301503
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301503",
							"2"
						],
						"stepId": 1301503,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150301,
					"content": "我們就安靜當聽眾就好了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150302,
					"content": "不知道她打算說什麼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150303,
					"content": "各位剛剛甦醒的人們，你們好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150304
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150304,
					"content": "打擾到你們的美夢，我非常抱歉，在夢境中的處理或許有些冰冷，我也表達我的歉意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150305
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150305,
					"content": "夢境擁有非常奇妙的力量，對心志堅定之人，它能鼓舞人心，為理想插上翅膀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150306
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150306,
					"content": "但它也有可能乘虛而入，混淆認知、顛倒是非——很不幸，你們被選為獵物了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150307
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150307,
					"content": "就像我之前所說，我還在不斷學習，不敢說能感同身受那些離別之苦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150308
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150308,
					"content": "但看看四周就知道，有過類似遭遇的人並不少見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150309
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150309,
					"content": "你們能相聚並站在這裡，一同望向遠方，你們應該為此自豪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150310
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150310,
					"content": "生命的道路非常漫長，我們都很難看到終點。由此我們可能會產生很多問題——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150311
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150311,
					"content": "「我活著的意義是什麼？我的目標是什麼？我為什麼要不斷經歷痛苦？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150312
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150312,
					"content": "誠然，停下腳步、放棄思考、重複熟悉的做法，這是最輕鬆的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150313
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150313,
					"content": "每當產生這樣的念頭的時候，就看看身邊存在的人和事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150314
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150314,
					"content": "有人終日辛勤勞作，為的是一家人能在夜晚吃上熱騰騰的飯菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150315
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150315,
					"content": "有人走遍大江南北，為的是創作出讓整個提瓦特都能產生共鳴的藝術品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150316
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150316,
					"content": "有人探尋世界的秘密，為的是預防逐漸逼近而又不可名狀的災難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150317
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150317,
					"content": "——自我並非生命意義的全部，每一次行動都是對自我與世界的塑造。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150318
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150318,
					"content": "親朋好友會銘記你們的所作所為，陌生人也可能因為你們的行動而受惠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150319
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150319,
					"content": "為此，有許多人哪怕承受痛苦，也要開拓全新道路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150320
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150320,
					"content": "而當你們走上同樣的道路，那些終極問題的答案就會慢慢浮現，也變得不再重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150321
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150321,
					"content": "但如果你們覺得生命就是虛無，那它就會逐漸走向虛無。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150322
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150322,
					"content": "你們有選擇生存方式的自由，但身為神，我需要先叫醒你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150323
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150323,
					"content": "還要不要以放棄現實為代價擁抱美夢，取決於你們自己。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納西妲"
				}
			]
		},
		{
			"id": 1301504,
			"completionStepIds": [
				1301504
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1301504",
							"2"
						],
						"stepId": 1301504,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"納西妲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 130150401,
					"content": "妳好厲害，在夢境裡，我都覺得有點說不過那個學者了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150402,
					"content": "他利用人性弱點的方式確實很巧妙，或許他自己也早就深陷其中了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150403
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150403,
					"content": "那個夢境有難以言喻的誘惑力，甜蜜得讓人上癮，而普通人很難有清晰的判斷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150404
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150404,
					"content": "但只要能醒過來，什麼時候都不算晚。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150405
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150405,
					"content": "妳也進步了很多啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150406
					]
				},
				{
					"id": 130150406,
					"content": "欸？怎麼突然這麼說？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150407
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150407,
					"content": "妳其實滿能同理的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150408
					]
				},
				{
					"id": 130150408,
					"content": "就是，雖然妳說妳不太懂人類的感情，但妳的猶豫我們都看在眼裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150409,
					"content": "剛剛那段演講，也是站在他們的立場上說的，這不是做得很好嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150410,
					"content": "#謝謝{F#妳}{M#你}們。這一路上我聽到了很多悲傷的故事，內心不只一次受到觸動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150411
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150411,
					"content": "受害者們的行為並不算錯，他們想要的東西也不過分…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150412
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150412,
					"content": "所以在他們試圖對抗我們，保護夢境的時候，我可以理解他們的選擇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150413
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150413,
					"content": "但我的理解與觸動，和他們真實經歷的痛苦相比，可能連百分之一都不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150414
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150414,
					"content": "這「百分之一」，我不敢認為它是所謂的同理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150415
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150415,
					"content": "妳要求真高，當然是啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150416,
						130150417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150416,
					"content": "做不到絕對的同理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				},
				{
					"id": 130150418,
					"content": "嘿嘿，好的，果然出來逛逛才會成長呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150419
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150419,
					"content": "感情和知識完全不同，我很難用清晰的言語描述它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150420
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150420,
					"content": "貝諾尼…或者「莫塞伊思」說我沒有經歷過生離死別，可是我有種特別模糊的感覺，告訴我並不是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150421
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150421,
					"content": "我剛進入夢境，就感覺我被一股特別溫暖的熱流包裹。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150422
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150422,
					"content": "溫暖到感覺自己回到了生命的原初狀態，再也不願意醒來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150423
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150423,
					"content": "（難道說她也看到了什麼？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150424
					]
				},
				{
					"id": 130150424,
					"content": "可是我睜開眼睛之後，那種感覺就消失了，一點痕跡都沒留下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150425
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150425,
					"content": "打比方的話，就像是一張白紙擦除了上面的筆跡，我看不見文字，但是能看到淺淺的凹痕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150426
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150426,
					"content": "但經歷了這場夢境之後，我想得很清楚了，無論那股暖流意味著什麼，都不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150427
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150427,
					"content": "我能確定的是，我曾經被那股很溫暖的力量支撐，才能一路走到今天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150428
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150428,
					"content": "要是過分在意溫暖來自於哪裡，那就本末倒置了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150429
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150429,
					"content": "剛剛和人民講了那麼多理想的話，到頭來自己卻做不到，那是不是太丟人了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150430
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150430,
					"content": "（大慈樹王已經用她的行動塑造了納西妲。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150431
					]
				},
				{
					"id": 130150431,
					"content": "（哪怕世界遺忘了她，納西妲的思想與意志也是她「存在過」的證明。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150432
					]
				},
				{
					"id": 130150432,
					"content": "（比起訴說真相，我更應該尊重她們的想法。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150433
					]
				},
				{
					"id": 130150433,
					"content": "怎麼了？突然一臉沉重的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 130150434,
					"content": "#看{F#妳}{M#你}好幾次欲言又止了，是有什麼話想告訴我嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150435,
						130150436
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150435,
					"content": "我忘了要說什麼了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150437,
					"content": "呵呵，這樣啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150438
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150438,
					"content": "那麼睡醒之後，不如伸個懶腰吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						130150439
					],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150439,
					"content": "新的一天要開始了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "納西妲"
				},
				{
					"id": 130150436,
					"content": "不重要吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150437
					]
				},
				{
					"id": 130150417,
					"content": "妳大可有自信一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						130150418
					]
				}
			]
		},
