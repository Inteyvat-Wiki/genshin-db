					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140301,
					"content": "#怎麼樣，{F#妳}{M#你}們拿到獸肉了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				}
			]
		},
		{
			"id": 7221404,
			"completionStepIds": [
				7221403
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221403",
							"2"
						],
						"stepId": 7221403,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140401,
					"content": "#喔！這獸肉的品質…太感謝{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140402
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140402,
					"content": "我等會就去好好做幾道好菜！吃了這些肉，我肯定能雕得更快一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140403
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140403,
					"content": "這兩件事之間有關係嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140404
					]
				},
				{
					"id": 722140404,
					"content": "吃了好肉，就有力氣幹活了嘛！之前總是吃魚，我都感覺提錘子的手沒什麼力氣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140405
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140405,
					"content": "#我還在擔心，一直這樣的話，說不定整個雕像的工期都會延長…還好{F#妳}{M#你}幫我找了這些肉過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140406
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140406,
					"content": "畢竟是為人…呃，為貓工作嘛，延期這種事，能避免最好還是避免吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140407
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140407,
					"content": "總之，我會盡快做好這尊雕像的，代宮司大人說，那尊雕像做好了之後，一定會有什麼好事發生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140408
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140408,
					"content": "雖然不知道是什麼好事，不過…嘿嘿，我還是挺期待的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140409
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140409,
					"content": "#過段時間，{F#妳}{M#你}們也要來神社看看我的作品啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				}
			]
		}
	]
}