			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"「寢子」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140101,
					"content": "還真是…不可思議哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140102
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722140102,
					"content": "雕像雕好了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140103
					]
				},
				{
					"id": 722140103,
					"content": "那個石頭，一開始的時候，一點也不像奴家。但是，每次看到，都變得更像了一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140104
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722140104,
					"content": "汝等人類真是不可思議呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140105
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722140105,
					"content": "雖然很吵，但是奴家是代宮司大人，所以不會在意這種小事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140106
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722140106,
					"content": "汝等幫奴家把這些魚帶過去給那個高高的人類吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140107
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722140107,
					"content": "這是好東西。就當做給他的…「抱愁」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140108,
						722140111
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722140108,
					"content": "只有魚嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140109
					]
				},
				{
					"id": 722140109,
					"content": "唔喵，奴家也讓「昆布丸」帶著那群孩子們試著抓抓團雀什麼的，但總是抓不到太多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140110
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722140110,
					"content": "對那群孩子來說，還是抓魚比較簡單呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722140111,
					"content": "是「報酬」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140112
					]
				},
				{
					"id": 722140112,
					"content": "喵喵喵，好煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140113
					],
					"speakerTitle": "「寢子」"
				},
				{
					"id": 722140113,
					"content": "快去交給他吧。這可是好東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「寢子」"
				}
			]
		},
		{
			"id": 7221402,
			"completionStepIds": [
				7221402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7221402",
							"2"
						],
						"stepId": 7221402,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"大島純平"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722140201,
					"content": "總算是有點樣子了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140202
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140202,
					"content": "#哈哈，是{F#妳}{M#你}們啊，快看看這雕像，是不是有點代宮司大人的模樣了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140203,
						722140205
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140203,
					"content": "確實有點模樣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140204
					]
				},
				{
					"id": 722140204,
					"content": "對吧？哈哈哈，不枉我連續好幾天熬夜工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140207,
					"content": "哎呀，肚子也餓了…我得自己再去找點吃的了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140208
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140208,
					"content": "這是寢子給你的魚肉。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140209
					]
				},
				{
					"id": 722140209,
					"content": "唔…呃，謝謝代宮司大人的好意，但我還是…我還是自己去找吃的吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140210
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140210,
					"content": "我已經連續吃了好幾天魚肉了，實在是受不了了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140211
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140211,
					"content": "我只能每天出去自己找吃的，運氣好的時候能打到點團雀或者鴿子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140212
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140212,
					"content": "唉，但是我還是想吃點獸肉啊，那種緊緻的，多汁的獸肉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140213
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140213,
					"content": "呃…旅行者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140214
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140214,
					"content": "#如果{F#妳}{M#你}們願意的話，能請{F#妳}{M#你}幫我去找三份…獸肉來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140215
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140215,
					"content": "#我對捕獵實在是不在行，這麼多天了也沒弄到一份獸肉…只能拜託{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140216,
						722140217
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140216,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140220
					]
				},
				{
					"id": 722140220,
					"content": "#那就拜託{F#妳}{M#你}們了，只要三份獸肉就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140217,
					"content": "你為什麼不回鳴神島吃一頓？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140218
					]
				},
				{
					"id": 722140218,
					"content": "一方面是太遠了，另一方面…我雕刻的手感正好，要是去鳴神島的話…這一來一回的，手感說不定就沒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140219
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140219,
					"content": "我還是就在這裡迅速吃一頓，然後繼續回去雕刻吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140220
					],
					"speakerTitle": "大島純平"
				},
				{
					"id": 722140205,
					"content": "雕像比寢子大很多。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722140206
					]
				},
				{
					"id": 722140206,
					"content": "那是當然啦，雖然代宮司大人比一般的貓也大很多…但是想要有氣勢的話，雕像的尺寸還得再進一步放大，畢竟是擺在神社裡的雕像嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722140207
					],
					"speakerTitle": "大島純平"
				}
			]
		},
		{
			"id": 7221403,
