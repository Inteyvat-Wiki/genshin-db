			"dialogs": [
				{
					"id": 100060101,
					"content": "你好啊，杜林，原來你在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100060102,
					"content": "#是{NICKNAME}和派蒙，{F#妳}{M#你}們怎麼來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060103
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060103,
					"content": "嘿嘿，外面天氣這麼好，你怎麼一個人在這裡看書啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100060104,
					"content": "是這樣的，自從在蒙德和大家「社交」的機會變多了之後，我就經常會把大家說的玩笑話當真。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060105
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060105,
					"content": "比如上次我在花店看到了一束非常美麗的花，告訴店主之後，她說：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060106
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060106,
					"content": "「呼呼，你要是看上了這些雜草，那不如拿薄荷和甜甜花跟它一起插個花束好了。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060107
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060107,
					"content": "結果，等我按照她的說法，把做好的花束拿去給她看的時候，她卻露出了非常可怕的表情…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060108,
						100060109
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060108,
					"content": "杜林的眼光很獨特呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				},
				{
					"id": 100060110,
					"content": "後來阿貝多說，這是因為我還沒辦法聽懂大家話語中的「言外之意」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060111
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060111,
					"content": "在學會蒙德的文字後，他就跟我說可以多看看這裡的書。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060112
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060112,
					"content": "因為我是從故事書裡誕生的，所以應該也能從這些書中學到這個世界的「規則」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060113
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060113,
					"content": "#結果我不知不覺就看到了現在…對了，還沒問{F#妳}{M#你}們找我有什麼事情呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060114,
						100060117
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060114,
					"content": "朋友之間應該經常互相拜訪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060115
					]
				},
				{
					"id": 100060115,
					"content": "原來是這樣，這也是「規則」的一部分吧？又學到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060116
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060116,
					"content": "雖然是這樣沒錯，不過我們還有正事要說吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100060118,
					"content": "是這樣的，其實我們帶來了萊茵多特要交給你的「口信」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100060119,
					"content": "居然是…萊茵多特阿姨嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060120,
						100060121
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060120,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060122,
					"content": "嗯，我只是有些意外…萊茵多特是媽媽的朋友，也是曾經存在於這個世界的「魔龍」的母親。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060123
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060123,
					"content": "而我取代了原本屬於牠的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060124
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060124,
					"content": "所以如果她討厭我的話…我也不知道該怎麼辦才好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060125,
						100060126
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060125,
					"content": "她應該沒那麼小氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060127,
					"content": "嗯嗯，杜林你別擔心，一定不會是什麼壞事的，而且還有我們在呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 100060128,
					"content": "#聽到{F#妳}{M#你}們這樣說，我就安心多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						100060129
					],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060129,
					"content": "既然如此，那我就拆開來看看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜林"
				},
				{
					"id": 100060126,
					"content": "有我們在。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060127
					]
				},
				{
					"id": 100060121,
					"content": "別緊張。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060122
					]
				},
				{
					"id": 100060117,
					"content": "我們是為了魔女…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060118
					]
				},
				{
					"id": 100060109,
					"content": "總感覺是她的問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						100060110
					]
				}
			]
		},
