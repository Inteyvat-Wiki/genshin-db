						766750705
					]
				},
				{
					"id": 766750705,
					"content": "關於「火花騎士」需不需要參與這些基礎訓練，琴和阿貝多曾經認真找我討論過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750706
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766750706,
					"content": "基本的騎士訓練有助於培養品性…但「火花騎士」畢竟年紀尚小…所以我決定聽取她本人的意見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750707
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766750707,
					"content": "…於是她開開心心地帶著炸彈去了訓練場。結果我們一致同意，在她稍微再長大一點之前，不再討論這個議題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				}
			]
