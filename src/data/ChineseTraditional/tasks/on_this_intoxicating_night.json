					}
				]
			},
			"dialogs": [
				{
					"id": 766751001,
					"content": "為大家帶回美酒的「主角」，怎麼跑到這個角落裡來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751002,
						766751003
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751002,
					"content": "我還想問你呢。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				},
				{
					"id": 766751004,
					"content": "嗯…其實我杯子裡的是「特製品」中的「特製品」，只能一個人喝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751005
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751005,
					"content": "#——不過被{F#妳}{M#你}發現就沒辦法了，就分{F#妳}{M#你}一杯吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751006,
						766751007
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751006,
					"content": "我就知道…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751008,
					"content": "#抱歉啦，開個玩笑！我身邊現在是一滴酒都沒有。{F#妳}{M#你}要是想喝的話，回頭可以去找歐蜜涅，她那邊一定夠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751009
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751009,
					"content": "一個營地裡總得留下一個沒醉的人，來看住喝醉的同伴跟夜裡的危險——這是我在遠征之初就立下的規矩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751010
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751010,
					"content": "真不湊巧啊，今天剛剛好輪到我來當這個不能醉的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751011
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751011,
					"content": "…所以在他們都喝醉的夜裡，我是不能醉的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751012,
						766751013
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751012,
					"content": "真的就剛剛好這麼巧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751014,
					"content": "誰知道呢？搞不好命運就是這麼喜歡捉弄人？要是晚個一天到，說不定就輪到我在下面暢飲了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751015
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751015,
					"content": "#但要是晚個一天，搞不好{F#妳}{M#你}就不會湊巧來到這個營地，也不會湊巧趕上我們的酒會，更沒機會像現在這樣對話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751016
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751016,
					"content": "什麼樣的選擇會引向什麼樣的結果，在時候到來之前，誰都無法確定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751017
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751017,
					"content": "就像我決定從蒙德出發遠征的時候，也沒想到會一路走到今天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751018
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751018,
					"content": "發起遠征的目的…是狂獵嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751019
					]
				},
				{
					"id": 766751019,
					"content": "嗯…從結果來說，的確如此。但在出發的時候，我只「知道」會有一場席捲提瓦特的深淵災厄正在北方醞釀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751020
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751020,
					"content": "我們也用了一些時間來動員籌備…但敵人會在哪裡、以什麼形式出現？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751021
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751021,
					"content": "…這些對出發時的我們而言依舊是未知。只能一路收集情報，做好任何可能用得上的準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751022,
						766751023
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751022,
					"content": "只有這點情報就發起遠征了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751024,
					"content": "呵，學得很快嘛！但很可惜，敵人可不會乖乖等著我們準備萬全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751025
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751025,
					"content": "在我們猶猶豫豫的時候，深淵也正戕害無數人的性命。早一刻出征，就能早一刻改變他們的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751026
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751026,
					"content": "光是知道這則情報，就足以支撐我們發起這場「遠征」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751027,
						766751028
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751027,
					"content": "不愧是「北風騎士」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751029,
					"content": "#別那麼見外，「榮譽騎士」！{F#妳}{M#你}不是也一樣嗎？{F#妳}{M#你}的旅途同樣改變了許多人的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751030
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751030,
					"content": "無論是從前的蒙德、特瓦林…還是如今的挪德卡萊、遠征軍…還有我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751031
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751031,
					"content": "#現在能圍著篝火唱著詩歌，喝著美酒暢想未來…都離不開{NICKNAME}，{F#妳}{M#你}的出現。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751032
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751032,
					"content": "…我真的有那麼厲害嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751033
					]
				},
				{
					"id": 766751033,
					"content": "哈哈…誰又能說得清呢？畢竟命運就是這麼捉摸不定的東西。但只要還活著，就總還有希望。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751034
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751034,
					"content": "今晚喝不到的酒，明天也能喝——他們會記得幫我留一杯的。只要還活著，就有美酒和朋友在明天等著！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766751035
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751035,
					"content": "#所以，{NICKNAME}，乾了這一杯！敬明天！敬希望！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766751028,
					"content": "不愧是「西風騎士團」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751029
					]
				},
				{
					"id": 766751023,
					"content": "不是說情報是行軍的基礎嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751024
					]
				},
				{
					"id": 766751013,
					"content": "在蒲公英酒送到的這天？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751014
					]
				},
				{
					"id": 766751007,
					"content": "果然是蘋果釀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751008
					]
				},
				{
					"id": 766751003,
					"content": "怎麼一個人喝酒？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766751004
					]
				}
			]
		},
