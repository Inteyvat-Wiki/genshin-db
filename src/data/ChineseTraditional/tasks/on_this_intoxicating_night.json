			"dialogs": [
				{
					"id": 766750901,
					"content": "啊！大團長！榮譽騎士！他們回來了——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750902
					],
					"speakerTitle": "溫弗里德"
				},
				{
					"id": 766750902,
					"content": "回來了——他們回來了——大家！快來迎接！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750903
					],
					"speakerTitle": "艾克貝特"
				},
				{
					"id": 766750903,
					"content": "哇嗚，居然這麼受歡迎…還真有點不好意思呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750904
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750904,
					"content": "——我隔著幾百公尺就從風裡聞出來了！是蒲公英酒的味道！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750905
					],
					"speakerTitle": "萊夫赫姆"
				},
				{
					"id": 766750905,
					"content": "還是晨曦酒莊出產的特製品！回來了…我的回憶…全都回來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750906
					],
					"speakerTitle": "溫弗里德"
				},
				{
					"id": 766750906,
					"content": "呃…所以你們迎接的對象不是我們吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750907
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750907,
					"content": "嗯…就是這個味道…跟記憶裡的一模一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750908
					],
					"speakerTitle": "艾克貝特"
				},
				{
					"id": 766750908,
					"content": "真好啊，這麼多年了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750909
					],
					"speakerTitle": "萊夫赫姆"
				},
				{
					"id": 766750909,
					"content": "我還以為，自己已經忘記晨曦酒莊的酒是什麼味道的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750910
					],
					"speakerTitle": "溫弗里德"
				},
				{
					"id": 766750910,
					"content": "酒的味道沒變…那清泉鎮的老家，應該也什麼都沒變吧？應該…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750911,
						766750912
					],
					"speakerTitle": "艾克貝特"
				},
				{
					"id": 766750911,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				},
				{
					"id": 766750913,
					"content": "#…謝謝{F#妳}{M#你}，榮譽騎士！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750914
					],
					"speakerTitle": "艾克貝特"
				},
				{
					"id": 766750914,
					"content": "好了…別那麼激動，還有人沒回營吧？等人齊了再開封，你們先去做酒會的準備吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750915
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766750915,
					"content": "是！我們這就去準備！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750916
					],
					"speakerTitle": "溫弗里德"
				},
				{
					"id": 766750916,
					"content": "看，我說過的吧——喝酒可是一等一的正經事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750917
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766750917,
					"content": "嗚嗚…蜜醬胡蘿蔔煎肉…甜甜花釀雞…居然能在這裡吃到這麼正宗的蒙德菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750918
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750918,
					"content": "咦…法爾伽呢？好像沒看到他？該不會是在哪個角落裡喝到醉了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750919,
						766750920
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750919,
					"content": "以他的酒量沒可能吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750921,
					"content": "#好…我再吃完一盤就去找{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 766750920,
					"content": "我去找找，妳繼續吃。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750921
					]
				},
				{
					"id": 766750912,
					"content": "是的，我去過。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750913
					]
				}
			]
		},
		{
