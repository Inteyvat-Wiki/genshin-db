						766750503
					]
				},
				{
					"id": 766750503,
					"content": "好，別放棄，再來一次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766750504,
					"content": "想聊一下天…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						766750505
					]
				},
				{
					"id": 766750505,
					"content": "之前教導諾艾爾的時候，她一緊張就會把木桶打碎一地，然後說什麼也要獨自打掃乾淨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750506
					],
					"speakerTitle": "法爾伽"
				},
				{
					"id": 766750506,
					"content": "時間一久…她打掃清理的本領，就冠絕整個騎士團了。呵，雖然她本人也沒意識到這其實也是一種「進步」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "法爾伽"
				}
			]
		},
