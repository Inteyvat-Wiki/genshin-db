					"content": "#嗯？需要我幫{F#妳}{M#你}把酒桶復位嗎？還是想要閒聊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						766750502,
						766750504
					],
					"speakerTitle": "法爾伽"
