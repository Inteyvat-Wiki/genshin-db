						],
						"pointId": 310400534
					},
					{
						"sceneId": 3,
						"position": [
							924.154,
							258.972,
							367.775
						],
						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401470101,
					"content": "#早啊，{NICKNAME}！掌櫃的跟我說了，上回來的新、老顧客，對{F#妳}{M#你}的評價都非常好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470102
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470102,
					"content": "#我之前還擔心{F#妳}{M#你}適應不了呢，現在看起來以{F#妳}{M#你}的本事，日常工作是足夠應付了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470103
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470103,
					"content": "#除非來位口味又挑剔，要求又嚴苛的客人，否則還真難不倒{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470104
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470104,
					"content": "哇，還會有這種客人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470105,
					"content": "那可不，尤其是那些菜沒做幾道，書讀了一堆的老學究！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470106
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470106,
					"content": "沒事就來挑你哪裡做得不合古法、哪裡做得跟幾百年前的老味道有區別…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470107
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470107,
					"content": "——這裡就是望舒客棧？也算是一家老字號了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470108
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470108,
					"content": "這聲音是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470109
					]
				},
				{
					"id": 401470109,
					"content": "店家！有什麼招牌名菜，就快點招待上來吧！要最貴的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470110
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470110,
					"content": "琺露珊！…前…前輩好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470111,
					"content": "#呀！{NICKNAME}、派蒙？{F#妳}{M#你}們怎麼在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470112
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470112,
					"content": "我們還想問呢！妳怎麼突然就有經費來旅遊了？還直接點了最貴的菜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470113,
					"content": "哼哼，這可不是旅遊哦。像我這樣的學者，受邀成為「隨船顧問」全世界出差，也只是家常便飯而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470114
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470114,
					"content": "琺露珊前輩…請…請慢一點…呼…明明昨晚大家都在熬夜，怎麼只有前輩還這麼有精神？她真的有一百來歲了嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470115
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 401470115,
					"content": "哈…哈…從我說要請客開始，她就一直這樣了…真是失策…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470116
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470116,
					"content": "萊依拉！還有多莉？真是少見的組合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470117,
					"content": "總之先休息一下吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470118
					]
				},
				{
					"id": 401470118,
					"content": "#{F#妳}{M#你}們招待三人入座，並說明了自己正在望舒客棧幫忙的事情…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401470119
					]
				},
				{
					"id": 401470119,
					"content": "#原來是這樣…{F#妳}{M#你}還真是個大忙人呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470120
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470120,
					"content": "#不過既然連這裡的主廚都認可{F#妳}{M#你}的話，也不用擔心吃不到正宗的招牌菜了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470121
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470121,
					"content": "所以妳們又是為什麼來璃月的啊？剛才好像聽到了什麼「隨船顧問」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470122,
					"content": "哈哈，我前陣子從楓丹弄了一艘新船，上面裝了最先進的導航機關！如果能夠推廣出去，那可是大大的商機！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470123
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470123,
					"content": "最近幾天正在試行呢——從奧摩斯港到離島，從離島到璃月港，之後還打算去荊夫港…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470124
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470124,
					"content": "我跟前輩就是受僱來幫忙測試羅盤、調整機關的。昨晚為了壓力測試，還在雲來海上漂了一整夜…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470125
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 401470125,
					"content": "這是非法加班嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470126
					]
				},
				{
					"id": 401470126,
					"content": "會…會有加班補貼的！兩位也都是自願的，簽合約的時候特意提過的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470127
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470127,
					"content": "妳還真是滴水不漏…所以「請客」也算是補貼之一嗎？難怪一上來就點貴的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470128,
					"content": "哼哼…「想吃什麼就吃什麼！」——這種機會可不多見！那就先來一份…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470129
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470129,
					"content": "咳！琺露珊…前輩，我當然也很想用最~貴的菜慰勞妳們啦！但貴，不一定就是好嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470130
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470130,
					"content": "我聽說璃月菜裡最貴的幾樣，不是要用很多海鮮，就是要費很長的工夫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470131
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470131,
					"content": "可是我們都在海上晃了這麼多天，再吃什麼魚啊、蝦啊，也嚐不出好味道來吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470132
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470132,
					"content": "呃…妳這麼一說，還真是這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470133
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470133,
					"content": "——而且萊依拉小姐，看起來都快餓暈了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470134
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470134,
					"content": "欸？我不是因為餓…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470135
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 401470135,
					"content": "…想必年高德劭的琺露珊前輩，一定不忍心讓後輩繼續餓著肚子等吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470136
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470136,
					"content": "唔…要照顧後輩的話，我是沒意見…不過怎麼總覺得上當了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470137
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470137,
					"content": "#所以，需要花大把時間來熬的菜也別上了！除此以外，有什麼貴就上什麼。交給{F#妳}{M#你}囉，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				}
			]
		},
		{
			"id": 4014702,
			"completionStepIds": [
				4014703
			],
