			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							888.421,
							255.563,
							329.875
						],
						"pointId": 310400533
					}
				]
			},
			"dialogs": [
				{
					"id": 401470401,
					"content": "…既要貴，又不能見海鮮，還不能花時間…這大半的老菜就都被排除了吧？究竟是誰提的要求，居然這麼刁鑽？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470402
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470402,
					"content": "多莉這傢伙！該不會是故意的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470403,
					"content": "應該就是故意的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470404
					]
				},
				{
					"id": 401470404,
					"content": "我們客棧跟琉璃亭、新月軒也不一樣，不會常備什麼名貴的食材，一般都是有客人預定才會去準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470405
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470405,
					"content": "要用尋常食材在短時間內做一道貨真價實的高價菜…那貴的就只能是廚師的「功夫」跟菜餚的「創意」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470406
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470406,
					"content": "#{NICKNAME}，我知道一道叫做「繁弦急管」的菜，用現成的食材就能做，出菜也不費時，一盤售價…三萬摩拉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470407
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470407,
					"content": "——三萬！不是說用料普通，也不花時間嗎？為什麼會那麼貴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470408,
					"content": "這道菜的「功夫」不在於時間，而在於廚師對刀工跟火候的掌握。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470409
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470409,
					"content": "要用多種不同的肉類切作細絲，揉製成條，最後再下鍋煎炒，主打口味多變，層層遞進。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470410
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470410,
					"content": "如何令幾種不同的肉凝而不散，一起達到各自合適的熟度，味道又不相互衝突，才是這道菜真正可貴的地方！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470411
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470411,
					"content": "做好了，就是一等一的名菜；做糟了，可就成一盤肉末了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470412
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470412,
					"content": "#哦——我懂了，所以這道菜貴的不是菜，而是{F#妳}{M#你}的出場費啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470413,
					"content": "說得我都不太有自信了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470414
					]
				},
				{
					"id": 401470414,
					"content": "#沒事，揉成條之類的瑣碎工序，我可以幫{F#妳}{M#你}搞定。{F#妳}{M#你}專心對付最緊要的環節就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470415
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470415,
					"content": "#放心大膽地去試吧！就算做糟了，{F#妳}{M#你}做的肉末我也喜歡吃！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
