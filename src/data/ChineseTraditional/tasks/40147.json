					},
					{
						"sceneId": 3,
						"position": [
							924.154,
							258.972,
							367.775
						],
						"pointId": 310400535
					},
					{
						"sceneId": 3,
						"position": [
							924.166,
							258.971,
							362.661
						],
						"pointId": 310400536
					}
				]
			},
			"dialogs": [
				{
					"id": 401470201,
					"content": "菜來囉！各位慢用——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470202,
					"content": "哦哦，聞起來很香呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470203
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470203,
					"content": "#…啊，對了對了，派蒙跟{NICKNAME}也沒吃早餐吧？乾脆一起坐下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470204
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470204,
					"content": "咦？多莉什麼時候這麼好心了…居然會有免費的早餐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470205,
					"content": "哈哈，大生意都是在宴席上談成的嘛…來來來坐坐坐！大家都不用客氣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470206
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470206,
					"content": "（這道菜看起來平平無奇，我又事先做過調查，應該不會花很多摩拉吧！不怕一萬，就怕三萬…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470207
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470207,
					"content": "#（這道菜，能抵得過一個晚上的熬夜嗎？…能不能吃回本，可就看你了啊，{NICKNAME}！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470208
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470208,
					"content": "（好累…好睏…好想睡…快點吃完回去睡…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470209
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 401470209,
					"content": "幾人各懷心事，各自動筷…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						401470210
					]
				},
				{
					"id": 401470210,
					"content": "這是…雞腿肉？不對，又好像是蕈豬的口感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470211
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 401470211,
					"content": "每嚼一口都是不同的滋味…仔細嚐起來，還有點煙燻的風味…真是不可思議，到底是怎麼做出來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470212
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470212,
					"content": "是火腿，我加了火腿。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470213
					]
				},
				{
					"id": 401470213,
					"content": "火腿？可是這盤菜裡哪裡有——啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470214
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470214,
					"content": "嘿嘿，已經有人發現了？沒錯，每根肉條都是用不同的肉絲揉成的！費了我跟言笑好大的力氣呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470215,
					"content": "可是雖然我也不太清楚…不同的肉類，熟透的時間應該也不一樣吧？但這道菜搭配得卻很和諧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470216
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 401470216,
					"content": "#呃…呃…這就是{NICKNAME}的商業機密了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470217,
						401470218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470217,
					"content": "沒有別的，只是熟練。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470219
					]
				},
				{
					"id": 401470219,
					"content": "#沒想到這是{F#妳}{M#你}的獨門菜式呢，算是沒有白來一趟。對了，這道菜有名字嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470220
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470220,
					"content": "啊，我都忘了介紹了，這道菜的名字叫「繁弦急管」——既是在描述絲條交錯的外觀，也是在…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470221,
					"content": "…描述複雜多變的口感？是從璃月的俗語取的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470222
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470222,
					"content": "原意應該是多種樂器同時演奏，熱鬧紛呈…嗯，放到這裡也算貼切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470223
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470223,
					"content": "欸…原來妳知道啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470224
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470224,
					"content": "每個年輕人在畢業前都該學會至少二十種語言吧？咦…難道現在沒這個要求了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470225
					],
					"speakerTitle": "琺露珊"
				},
				{
					"id": 401470225,
					"content": "——欸？以前有過的嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470226
					],
					"speakerTitle": "萊依拉"
				},
				{
					"id": 401470226,
					"content": "差點忘了妳也是知論派的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470227
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470227,
					"content": "那…那個…這道菜的價格是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470228
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470228,
					"content": "嘿嘿——不多不多，承惠摩拉三萬！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470229,
					"content": "三…三萬！哈…哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470230
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470230,
					"content": "#話說回來…派蒙、{NICKNAME}，我之前是叫{F#妳}{M#你}們「一起坐下」…沒說要連{F#妳}{M#你}們一起請客吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470231
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470231,
					"content": "…所以這是不是要算…併桌？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470232
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470232,
					"content": "——果然沒有免費的早餐啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470233,
						401470236
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470233,
					"content": "三萬而已，對妳來說不算破費吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470234
					]
				},
				{
					"id": 401470234,
					"content": "就是就是！商人要重信譽！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470235,
					"content": "嗚…一枚摩拉也是錢啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470239
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470239,
					"content": "唉，成吧…就當作交學費了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470240
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470240,
					"content": "…等回了須彌，我一定要請人把這道菜再現出來，再狠狠地賺一筆！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470236,
					"content": "打八折好了，等一下我跟掌櫃說一聲。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470237
					]
				},
				{
					"id": 401470237,
					"content": "#{F#妳}{M#你}啊…好吧，反正貴的也是{F#妳}{M#你}的出場費。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 401470238,
					"content": "三萬打八折…嗚，還是有點心痛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470239
					],
					"speakerTitle": "多莉"
				},
				{
					"id": 401470218,
					"content": "我有獨特的烹飪手法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						401470219
					]
				}
			]
		},
