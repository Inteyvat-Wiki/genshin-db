			},
			"dialogs": [
				{
					"id": 401470301,
					"content": "#今早算是開了個好頭啊，接下來也拜託{F#妳}{M#你}們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						401470302
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 401470302,
					"content": "#{F#妳}{M#你}與派蒙忙進忙出直到打烊。來客紛紜，口味眾多，留下的好評卻出奇一致。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 4014704,
			"completionStepIds": [
				4014706
			],
