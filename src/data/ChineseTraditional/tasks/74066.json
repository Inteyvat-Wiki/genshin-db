			"dialogs": [
				{
					"id": 740660301,
					"content": "櫃檯登記處…就是這裡了！我們去碰碰運氣吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660302,
					"content": "莫萊妮小姐，妳好~",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660304
					],
					"speakerTitle": "莫萊妮"
				},
				{
					"id": 740660304,
					"content": "（嗚哇——感覺好難相處的樣子。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660305,
					"content": "（要不要試試看「交涉的藝術」？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740660306
					]
				},
				{
					"id": 740660306,
					"content": "（對哦，還有這個耶！沒想到這本書還可以在這裡派上用場。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660307,
					"content": "我看看…找到了！「如果你先聲奪人在氣勢上壓倒了對手…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660308,
					"content": "就是這個！氣勢上壓倒對手！我知道了！總而言之聲音大一點就好了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660309,
					"content": "喂喂——莫萊妮小姐，妳好——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660310,
					"content": "…聽見了，請問您需要幫助嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660311
					],
					"speakerTitle": "莫萊妮"
				},
				{
					"id": 740660311,
					"content": "欸？居然真的有用！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660312,
					"content": "#嘿嘿，莫萊妮小姐，我們是來接受滿意度調查的！啊，不對，我是陪{M#他}{F#她}來的啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660313,
					"content": "#（{NICKNAME}別擔心，我們有這本書，我會偷偷看書提醒{F#妳}{M#你}的！總之…嗯！總之{F#妳}{M#你}聽我的指示就好。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660314,
					"content": "又是看到書裡的通知來的啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660315
					],
					"speakerTitle": "莫萊妮"
				},
				{
					"id": 740660315,
					"content": "嗯！對呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740660316,
					"content": "到底放了多少張啊…其實…唉，算了，沒事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660317
					],
					"speakerTitle": "莫萊妮"
				},
				{
					"id": 740660317,
					"content": "咳咳，請您稍等…我先解釋一下規則。本次問卷共有5題，請根據直覺快速回答。請注意，快速回答。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740660318
					],
					"speakerTitle": "莫萊妮"
				},
				{
					"id": 740660318,
					"content": "明白了嗎？等您準備好了我們就開始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "莫萊妮"
				}
			]
		},
