			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"柚子"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130301,
					"content": "你們好啊，有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130302
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 220130302,
					"content": "請問您看過《鬼武道》嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130303
					]
				},
				{
					"id": 220130303,
					"content": "咦？看過倒是看過，之前我還滿喜歡的呢，不過…怎麼說呢，最近的劇情好像變得有點奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130304
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 220130304,
					"content": "無論是面對什麼敵人，主角都會突然覺醒出剛好可以剋制這個敵人的能力，一下子就把敵人擊敗了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130305
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 220130305,
					"content": "之前我喜歡《鬼武道》的原因，主要是欣賞主角擊敗敵人的巧妙方式，但是現在…總感覺有一種偷懶的感覺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130306
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 220130306,
					"content": "而且主角後來覺醒的很多能力，大多數都就只用那一次，實在是有一種說不出的隨便感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130307
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 220130307,
					"content": "不知道寫這本小說的作者到底是怎麼設計的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130308
					],
					"speakerTitle": "柚子"
				},
				{
					"id": 220130308,
					"content": "咳咳…這…這…我們再去問幾個人吧，這應該只是個例而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
		{
			"id": 2201304,
			"completionStepIds": [
				2201303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
