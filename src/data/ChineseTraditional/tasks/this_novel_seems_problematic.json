				"objectNames": [
					"梨繪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130501,
					"content": "貴安，兩位，你們這是要找我聊天嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130502
					],
					"speakerTitle": "梨繪"
				},
				{
					"id": 220130502,
					"content": "請問您看過《鬼武道》嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130503
					]
				},
				{
					"id": 220130503,
					"content": "我看過呀，而且我還很喜歡書裡的主角呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130504
					],
					"speakerTitle": "梨繪"
				},
				{
					"id": 220130504,
					"content": "不過，這本小說最近讓我看得很吃力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130505
					],
					"speakerTitle": "梨繪"
				},
				{
					"id": 220130505,
					"content": "吃力？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130506
					]
				},
				{
					"id": 220130506,
					"content": "最近的幾章裡，主角不是覺醒了很多新能力嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130507
					],
					"speakerTitle": "梨繪"
				},
				{
					"id": 220130507,
					"content": "書裡花了很大的篇幅介紹那些能力的覺醒方式，還有可能的使用方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130508
					],
					"speakerTitle": "梨繪"
				},
				{
					"id": 220130508,
					"content": "而且那些能力的名字也愈來愈難唸，我每次都沒法完全記住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130509
					],
					"speakerTitle": "梨繪"
				},
				{
					"id": 220130509,
					"content": "但如果勉強往後看的話，那些看不懂的能力又會讓我沒法理解劇情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130510
					],
					"speakerTitle": "梨繪"
				},
				{
					"id": 220130510,
					"content": "唉，我開始想要暫時先不看這本小說，換一本稍微比較容易理解的書了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130511
					],
					"speakerTitle": "梨繪"
				},
				{
					"id": 220130511,
					"content": "呃…我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130512
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130512,
