					"長谷川"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130401,
					"content": "你們好，請問找我有事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130402
					],
					"speakerTitle": "長谷川"
				},
				{
					"id": 220130402,
					"content": "請問您看過《鬼武道》嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130403
					]
				},
				{
					"id": 220130403,
					"content": "看過的，是一本很有趣的小說啊，無論是角色的描寫還是情節的設計，都很精彩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130404
					],
					"speakerTitle": "長谷川"
				},
				{
					"id": 220130404,
					"content": "不過最近…感覺作者有點偷懶了啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130405
					],
					"speakerTitle": "長谷川"
				},
				{
					"id": 220130405,
					"content": "呃…呃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130406
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130406,
					"content": "有好幾次，在前文沒有伏筆的情況下突然為角色增加設定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130407
					],
					"speakerTitle": "長谷川"
				},
				{
					"id": 220130407,
					"content": "雖然說是「覺醒」，但這種獲得能力的方式實在太過廉價，沒有任何價值感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130408
					],
					"speakerTitle": "長谷川"
				},
				{
					"id": 220130408,
					"content": "我覺得，這樣廉價的情節，也會連帶著讓角色同樣變得廉價，真希望那位作家再好好想想啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130409
					],
					"speakerTitle": "長谷川"
				},
				{
					"id": 220130409,
					"content": "…旅行者，我們…我們去問下一個人吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
