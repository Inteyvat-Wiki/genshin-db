			"trigger": {
				"objectNames": [
					"阿茂",
					"順吉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220130101,
					"content": "你到底看了讀者回饋沒有？最近的評價可是一路暴跌啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130102
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220130102,
					"content": "慌什麼，這只是高潮爆發點前的沉寂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130103
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130103,
					"content": "等我寫到關鍵劇情，風評就會徹底扭轉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130104
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130104,
					"content": "在那一天之前，你的這本小說就要被腰斬了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130105
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220130105,
					"content": "發生了什麼事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130106
					]
				},
				{
					"id": 220130106,
					"content": "#旅行者，{F#妳}{M#你}可算是來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130107
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220130107,
					"content": "自從上次取材了之後，順吉又接連給《鬼武道》的主角增加了好幾項過分的能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130108
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220130108,
					"content": "「八重堂」收到了大量負評，讀者們都說，完全不理解這些能力出現的原因，覺得作者純粹是想到哪寫到哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130109
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220130109,
					"content": "那些都是片面之詞，只要我按照目前的節奏寫下去，他們就會明白的——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130110
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130110,
					"content": "所以說，在讀者們明白之前，你的小說就會被腰斬了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130111
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220130111,
					"content": "真是夠了…我記得，這周圍應該就有幾個讀過《鬼武道》的讀者…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130112
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220130112,
					"content": "如果你真覺得自己的想法會被讀者們喜歡，那就直接去問問你的讀者們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130113
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220130113,
					"content": "#去就去！他們一定會瞭解的我想法的。旅行者，能拜託{F#妳}{M#你}和我同行，當個見證嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130114
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130114,
					"content": "這樣也好，有旅行者同行的話，也免得你到時候又不認帳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130115
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220130115,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130116
					]
				},
				{
					"id": 220130116,
					"content": "好，那我們現在就出發吧，我相信，讀者們肯定會理解我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130117
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130117,
					"content": "你到底加了多少設定…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220130118
					]
				},
				{
					"id": 220130118,
					"content": "就…就一點點，只加了一點點而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130119
					],
					"speakerTitle": "順吉"
				},
				{
					"id": 220130119,
					"content": "一點點？你再這麼加下去，主角的能力馬上就要比露過臉的角色還多了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220130120
					],
					"speakerTitle": "阿茂"
				},
				{
					"id": 220130120,
					"content": "咳…咳！我們快點出發吧，我相信，讀者們肯定能懂我！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "順吉"
				}
			]
		},
