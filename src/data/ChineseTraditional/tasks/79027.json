	"talks": [
		{
			"id": 7902701,
			"completionStepIds": [
				7902701
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902701",
							"2"
						],
						"stepId": 7902701,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「大肉丸」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270101,
					"content": "#欸呀，{F#妳}{M#你}們來啦，我還以為{F#妳}{M#你}們每天用那個什麼翅膀，在海島間飛來飛去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270102
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270102,
					"content": "早就忘了泡在水裡的老夥計「大肉丸」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270103
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270103,
					"content": "我們這不就想起你了嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270104,
					"content": "對了，你之前說要幫忙的，是什麼事呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270105,
					"content": "#其實也不是什麼重要的事…上次{F#妳}{M#你}們不是幫我找到了我身軀的碎片嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270106
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270106,
					"content": "該怎麼說呢，不知道是因為達成了一些心願…還是這片海域讓我能開口說話的力量在逐漸消退…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270107
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270107,
					"content": "最近清醒的時候少，睡著的時候倒是愈來愈多啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270108,
						790270109
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270108,
					"content": "難道和那個裝置有關？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				},
				{
					"id": 790270110,
					"content": "#原來如此，是因為什麼裝置，我才能夠變成{NICKNAME}{F#妳}{M#你}的浪船，也可以開口與{F#妳}{M#你}交流…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270111
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270111,
					"content": "啊…那等裝置的影響結束以後，「大肉丸」豈不是不能再開口說話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270112,
					"content": "#{NICKNAME}，不如我們快想些辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270113,
					"content": "#哈哈，不用啦，派蒙…能夠像現在這樣與{F#妳}{M#你}們說話，我已經感到十分滿足了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270114
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270114,
					"content": "#呀…這麼一想，我身為一艘船卻能在過去幾日和{F#妳}{M#你}們那樣暢快交流，本身就是如夢幻一般的美好之事呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270115
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270115,
					"content": "不過我現在還有一事相求…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270116
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270116,
					"content": "但說無妨…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270117
					]
				},
				{
					"id": 790270117,
					"content": "#之前不是一直說，等找到我的身體以後，就帶著{F#妳}{M#你}們在這裡兜風嘛，只不過我的身體早就變成了那個樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270125
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270125,
					"content": "寶藏大部分也被帶走，沒留下什麼好東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270118
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270118,
					"content": "但是這次，我以大海盜船之名起誓，一定會有了不起的大寶藏的！就當是再被我騙一次，跟我一起去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270119
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270119,
					"content": "#{NICKNAME}，「大肉丸」說不定馬上就沒辦法說話了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270120,
					"content": "#而且…那可是有寶藏呢！我們就一起去吧，{NICKNAME}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270121,
						790270122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270121,
					"content": "真拿妳沒辦法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270123,
					"content": "那我們現在就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270124,
					"content": "好欸，那就請兩位立刻上船吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270122,
					"content": "既然都這麼說了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270123
					]
				},
				{
					"id": 790270109,
					"content": "被裝置的關閉影響了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270110
					]
				}
			]
		},
		{
			"id": 7902706,
			"completionStepIds": [
				7902706
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902706",
							"2"
						],
						"stepId": 7902706,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「大肉丸」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790270601,
					"content": "真是好險呀，感覺剛才差點就要被擊沉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270602,
					"content": "「越石丸」，了不起！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270603,
					"content": "#哈哈，會說話的船也不過是船罷了，能夠穿越雷暴，{NICKNAME}精湛的駕駛技術才是真的功不可沒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270604,
						790270605
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270604,
					"content": "要再來一次嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270606
					]
				},
				{
					"id": 790270606,
					"content": "哈哈，那還是別了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270607
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270607,
					"content": "唉，剛才的雷暴，恐怕是因為受到了我的影響，這麼看來，這片海域的環境已經變得沒那麼穩定啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270608
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270608,
					"content": "#不過，也是正好…{NICKNAME}，派蒙，寶藏就在上面哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270609
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270609,
					"content": "這不是我們第一次找寶藏的地方嗎，上面只有「越石丸」你的半截斷船而已吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270610,
					"content": "這次上面肯定有寶藏啦，這可是…怎麼說的，這可是「大海盜船的直覺」啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270611
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270611,
					"content": "是嗎…對了，之前「越石丸」說有兩件事要告訴我們，一件事是你記起了你的名字，另一件事是什麼呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790270612
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790270612,
					"content": "#哈哈哈，我還以為妳忘記了呢，剩下的一件事，就等{F#妳}{M#你}們回來再告訴{F#妳}{M#你}們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790270605,
					"content": "謝謝誇獎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						790270607
					]
				}
			]
		},
		{
			"id": 7902710,
			"completionStepIds": [
				7902708,
				7902710
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7902710",
							"2"
						],
						"stepId": 7902710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"「大肉丸」"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 790271001,
					"content": "「越石丸」、「越石丸」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271002
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790271002,
					"content": "我們找到寶藏啦，你看，是一艘海盜船的模型呢！這次你的直覺終於準了一次！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790271003,
					"content": "對了對了，你之前說，要告訴我們的第二件事到底是什麼呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271004
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790271004,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271005
					],
					"speakerTitle": "「大肉丸」"
				},
				{
					"id": 790271005,
					"content": "「越石丸」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						790271006
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 790271006,
