				]
			},
			"dialogs": [
				{
					"id": 741850301,
					"content": "嘿嘿，「小嗚斯」，以後這裡就是你的家啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850302,
					"content": "嗚喵？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850303
					],
					"speakerTitle": "小嗚斯"
				},
				{
					"id": 741850303,
					"content": "不過還是感覺有點奇怪…卡西奧多應該已經離開這裡了沒錯吧？那現在的「小嗚斯」又是誰呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850304,
					"content": "是原來那隻沒被卡西奧多憑依的貓，還是和我們一起經歷了冒險的嗚斯先生呢…唔…腦子亂亂的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850305,
						741850307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850305,
					"content": "派蒙不適合思考這種問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850306
					]
				},
				{
					"id": 741850306,
					"content": "我是完全搞不懂啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850309,
					"content": "總之，也幫小嗚斯找到了新家。以後有時間的話，我們也可以經常來找小嗚斯一起玩呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850310,
					"content": "喵嗚！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "小嗚斯"
				},
				{
					"id": 741850307,
					"content": "「小嗚斯」就是「小嗚斯」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850308
					]
				},
				{
					"id": 741850308,
					"content": "雖然搞不懂，但是也很有道理呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850309
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
