				]
			},
			"dialogs": [
				{
					"id": 741850101,
					"content": "埃斯特先生，我們回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850102,
					"content": "#哦哦，原來是…等等，不對，{F#妳}{M#你}們是誰？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850103
					],
					"speakerTitle": "埃斯特"
				},
				{
					"id": 741850103,
					"content": "#欸？你該不會不認識我們了吧？我們是{NICKNAME}和派蒙啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850104,
					"content": "#{NICKNAME}和派蒙…我的確聽過這兩個名字，但那應該是在夢中才對啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850105
					],
					"speakerTitle": "埃斯特"
				},
				{
					"id": 741850105,
					"content": "唔…不過那個時候埃斯特先生明明是很清醒的啊，而且我們不是還在下面見到了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850106,
					"content": "唉，我夢見鎮上的大家都被變成了石像，只剩下我一個人待在鎮上束手無策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850107
					],
					"speakerTitle": "埃斯特"
				},
				{
					"id": 741850107,
					"content": "直到兩位勇士來到了鎮上，才承擔起解救大家的重任…該不會，那其實不是夢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850108,
						741850109
					],
					"speakerTitle": "埃斯特"
				},
				{
					"id": 741850108,
					"content": "可能是也可能不是吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				},
				{
					"id": 741850110,
					"content": "嗯，反正現在大家都恢復正常了不是嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850111,
					"content": "不過大家好像都做了些奇怪的夢。到底發生了什麼，難道我們是被集體催眠了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850112
					],
					"speakerTitle": "埃斯特"
				},
				{
					"id": 741850112,
					"content": "要說清楚怕是一天一夜也說不完…還是先不要提催眠的事情吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850113,
					"content": "#哦？說到催眠，{F#妳}{M#你}們還帶了一隻貓過來耶，看起來很有靈性的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850114,
						741850116
					],
					"speakerTitle": "埃斯特"
				},
				{
					"id": 741850114,
					"content": "的確很有靈性。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850115
					]
				},
				{
					"id": 741850115,
					"content": "牠可是我們的夥伴哦，不過我們也沒辦法帶著牠一起旅行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850118,
					"content": "那真是太巧了，正好我們俱樂部裡還有一間貓舍。自從某個研究催眠術的傢伙帶著他的貓一起去旅行之後，那裡就一直空著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850119
					],
					"speakerTitle": "埃斯特"
				},
				{
					"id": 741850119,
					"content": "#如果{F#妳}{M#你}們不嫌棄的話，就把牠寄養在這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850120
					],
					"speakerTitle": "埃斯特"
				},
				{
					"id": 741850120,
					"content": "#雖然不知道為什麼，但我們好像有特殊的緣分，我會幫{F#妳}{M#你}們好好照顧牠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850121
					],
					"speakerTitle": "埃斯特"
				},
				{
					"id": 741850121,
					"content": "#貓舍的話就在這棟的另一邊，{F#妳}{M#你}們過去就可以看到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "埃斯特"
				},
				{
					"id": 741850116,
					"content": "牠是我們的夥伴。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850117
					]
				},
				{
					"id": 741850117,
					"content": "雖然是這樣啦…不過我們也沒辦法帶著牠一起旅行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						741850118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 741850109,
					"content": "這個不重要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						741850110
					]
				}
			]
		},
