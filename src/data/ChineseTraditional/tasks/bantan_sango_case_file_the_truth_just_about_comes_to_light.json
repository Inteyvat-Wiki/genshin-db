	"talks": [
		{
			"id": 4003301,
			"completionStepIds": [
				4003301
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
