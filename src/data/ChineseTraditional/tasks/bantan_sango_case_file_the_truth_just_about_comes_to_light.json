					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400335201,
					"content": "#放心，我已經有初步推斷了，龍二會繼續調查「黑影」的，{F#妳}{M#你}們也快去救小動物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
