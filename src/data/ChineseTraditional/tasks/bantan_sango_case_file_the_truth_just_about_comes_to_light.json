				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330101,
					"content": "#是{F#妳}{M#你}們啊。來得正好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330102
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330102,
					"content": "我剛剛考察完幾處可疑的地點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330103
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330103,
					"content": "其中有一處營地是由那隻帽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330104
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330104,
					"content": "咳咳，是由那隻「黑影」看守的。如果沒有什麼別的問題的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330105
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330105,
					"content": "昨天說的「調查」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330106
					]
				},
				{
					"id": 400330106,
					"content": "那個的話，我現在還什麼都不知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330107
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330107,
					"content": "咦？不是珊瑚讓你去調查的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400330108,
					"content": "沒錯，但是…該怎麼說呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330109
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330109,
					"content": "比如說，「熟透了的堇瓜」和「門簾上的泥手印」，對我而言，是毫無關聯的事物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330110
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330110,
					"content": "但在珊瑚社長的腦海中就能成為解開「寄木細工」的關鍵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330111
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330111,
					"content": "「熟透了的堇瓜」和「門簾上的泥手印」…它們之間有什麼關係呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400330112,
					"content": "只是打個比方。我依照她的指示，在八醞島和鎮守之森調查了一些地點，將我的見聞報告給她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330113
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330113,
					"content": "而她能從我報告的現象中得到什麼結論，就只有她自己知道了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330114
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330114,
					"content": "只有鹿野院先生能和她的思維並駕齊驅…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330115
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330115,
					"content": "鹿野院？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330116
					]
				},
				{
					"id": 400330116,
					"content": "天領奉行的人。之前查案的時候，有幸和他見過面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330117
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330117,
					"content": "#是個…氣質獨特的人。如果見到了，{F#妳}{M#你}一定能一眼認出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330118
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330118,
					"content": "#總之，小動物就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330119
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330119,
					"content": "我還是好在意「熟透了的堇瓜」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4003303,
			"completionStepIds": [
				4003303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003303",
							"2"
						],
						"stepId": 4003303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400330301,
					"content": "#辛苦{F#妳}{M#你}們了！太好了！這下子應該對上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330302
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330302,
					"content": "嗯？怎麼還少了幾隻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330303
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330303,
					"content": "嗚哇，怎麼會這樣。感覺沒完沒了的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400330304,
					"content": "確實，有時候查案需要很大的耐心。如果不湊巧走錯了方向的話，可能也會竹籃打水一場空。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330305
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330305,
					"content": "至少我們目前已經找回了很多小動物了，所以大方向應該是對的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330306
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330306,
					"content": "只是，可能我們遺漏了什麼線索，或者沒想到什麼地方而已，所以陷入了僵局。不過我相信這是暫時的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330307
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330307,
					"content": "我懂了！你是說，我們缺了一點噼咔的感覺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400330308,
					"content": "噼咔的感覺…也可以這麼說吧。而且我們進展並不算慢，這都是多虧了旅行者和派蒙，所以不用沮喪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330309,
						400330310
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330309,
					"content": "（居然聽懂了派蒙的話…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				},
				{
					"id": 400330311,
					"content": "嘿嘿，我總感覺你說得很有道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400330312,
					"content": "過獎了，不過是探案累積下來的經驗罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330313
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330313,
					"content": "埋得越深的謎題，越有探究的價值。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330314
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330314,
					"content": "只可惜目前也沒有其他資訊了，嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330315
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330315,
					"content": "這樣好了，我先回去和珊瑚社長報告一下現在的情況。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330316
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330316,
					"content": "珊瑚社長一定能想到些什麼我們沒想到的地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330317
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330317,
					"content": "嗯！你說話很有道理，所以聽你的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400330318,
					"content": "那就這麼說定了。老樣子，到時候我們老地方見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400330319
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330319,
					"content": "#萬一我被什麼事情纏住脫不開身，{F#妳}{M#你}們直接找珊瑚社長就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 400330310,
					"content": "（龍二已經很瞭解派蒙了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400330311
					]
				}
			]
		},
		{
