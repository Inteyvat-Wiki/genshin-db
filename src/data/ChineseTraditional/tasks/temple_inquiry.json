			"completionStepIds": [
				7224804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224804",
							"2"
						],
						"stepId": 7224804,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"阿倍良久",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480201,
					"content": "啊…若是當時白夜國有如汝這般的勇士，也不會…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480202
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480202,
					"content": "唉，此事若成，那吾也可了卻心願。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480203
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480203,
					"content": "一定要、一定要將這些寄託吾念的貢品拿去供奉，供奉在我幽禁之所。如此才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480204
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480204,
					"content": "如此才能什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480205,
					"content": "如此才能…如此才能…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480206
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480206,
					"content": "唔，這位殘魂先生看上去失魂落魄，說什麼都沒反應了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480207,
					"content": "#{NICKNAME}，那就先帶上貢品吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480208
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480208,
					"content": "不過殘魂先生被幽禁在的高處，到底是什麼地方呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 7224803,
			"completionStepIds": [
				7224805
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7224805",
							"2"
						],
						"stepId": 7224805,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"派蒙",
					"阿倍良久"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722480301,
					"content": "好像出現了一個殘魂……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480302,
					"content": "吾乃…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480303
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480303,
					"content": "吾乃赫利俄斯之建造者，名曰：阿倍良久！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480304
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480304,
					"content": "吾怎麼可能被你們這些妄語讒言所擊倒，吾怎麼會被你們操縱的稚童幽禁！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480305
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480305,
					"content": "吾…不對，吾…吾在幽禁之所度過了無盡歲月，此時已是…生後之身？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480306
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480306,
					"content": "生後之身？是說自己已經死去的意思嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480307,
					"content": "能夠意識到這點的殘魂很少見啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480308
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480308,
					"content": "說來慚愧，但為何而死，吾已回想不出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480309
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480309,
					"content": "只是記憶之中，吾被一個孩子下令關押至死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480310
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480310,
					"content": "一個孩子？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480311,
					"content": "正是，不過，時至今日，提起那個孩子吾也不覺得怨恨，只是覺得可憐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480312
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480312,
					"content": "有錯的，並不是他，有錯的是將他視為掌中傀儡的…算了，不提也罷。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480313
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480313,
					"content": "那之後，吾就被幽禁…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480314
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480314,
					"content": "幽禁於一處…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480315
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480315,
					"content": "一處？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480316,
					"content": "一處很高的地方…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480317
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480317,
					"content": "雖然很高，但該處卻黯淡無光，冷若冰窟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480318
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480318,
					"content": "…咦，奇怪，為何呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480319
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480319,
					"content": "為何吾會覺得，高處本應是讓人溫暖舒暢的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480320
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480320,
					"content": "為何…為何吾什麼都想不起來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480321
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480321,
					"content": "難道是因為肚子餓了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480322,
					"content": "我肚子餓的時候，別說動腦想什麼了，連話都說不順。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480323,
						722480325
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480323,
					"content": "我覺得不是因為這個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480324
					]
				},
				{
					"id": 722480324,
					"content": "#肯定就是嘛！{F#妳}{M#你}看他也話都說不清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480327,
					"content": "#啊，{NICKNAME}，{F#妳}{M#你}可以找找看，萬一貢品裡面有能吃的東西呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480328,
					"content": "是了！貢品！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480329
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480329,
					"content": "怎麼樣，是想吃貢品了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480330,
					"content": "不，吾只是想起了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480331
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480331,
					"content": "吾在幽禁至死後，因鑄造赫利俄斯之功，殘軀與衣冠在各處享有供奉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480332
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480332,
					"content": "也是因此而魂魄分離，致使靈魂難安。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480333
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480333,
					"content": "此處本應供奉吾之聖冠，但是早已朽壞…恐怕這也是為何吾念頭滯澀的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480334
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480334,
					"content": "長此以往，恐怕連保持現在的狀態都相當困難…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480335
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480335,
					"content": "但好在這些供奉品——這些貢品能代替殘軀與衣冠，承載吾一絲念想。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480336
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480336,
					"content": "勞煩汝將之取走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480337
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480337,
					"content": "不過供奉之路上有多重險阻，雖有冒犯之嫌，但也希望汝能接受一次考驗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480338
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480338,
					"content": "考驗？什麼考驗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480339
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 722480339,
					"content": "就請汝擊敗周圍這些困守吾殘魂的怪物吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480340
					],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480340,
					"content": "此事兇險，旅者啊，若汝準備好了，再與吾說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿倍良久"
				},
				{
					"id": 722480325,
					"content": "我這裡有應急食…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722480326
					]
				},
				{
					"id": 722480326,
					"content": "喂！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722480327
					],
					"speakerTitle": "派蒙"
				}
			]
		},
