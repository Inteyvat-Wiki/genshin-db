			"dialogs": [
				{
					"id": 735310101,
					"content": "#呼。多虧了{F#妳}{M#你}們，我又拿到了寶貴的實驗資料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735310102
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735310102,
					"content": "得在導師康復前熬夜把報告寫完，希望他看了之後不要再產生試一試的想法…如果他想再和怪物過幾招，我豁出性命也要攔下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735310103
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735310103,
					"content": "到時候就讓我親自上陣好了！就算失敗，也可以把「為研究犧牲自己的學者賈米」寫到墓碑上，哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735310104
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735310104,
					"content": "前兩天和師弟喝酒，他想研究長效溢神劑在其他環境中的應用。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735310105
					],
					"speakerTitle": "賈米"
				},
				{
					"id": 735310105,
					"content": "這樣就算是普通人外出遊歷，面對長鬢虎、棘冠鱷這樣的野獸也不至於束手無策。",
					"roleType": "TALK_ROLE_NPC",
