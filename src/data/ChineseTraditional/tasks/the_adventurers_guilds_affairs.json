					"nextDialogs": [
						718030403
					]
				},
				{
					"id": 718030403,
					"content": "#辛苦{F#妳}{M#你}了，完成了這項委託，應該就能證明協會的實力…",
					"roleType": "TALK_ROLE_NPC",
