			"dialogs": [
				{
					"id": 718030301,
					"content": "喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030302
					],
					"speakerTitle": "灰灰"
				},
				{
					"id": 718030302,
					"content": "咦？怎麼有隻小貓在這裡，難道剛才的叫聲是牠發出來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030303,
					"content": "喵…喵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030304,
						718030308
					],
					"speakerTitle": "灰灰"
				},
				{
					"id": 718030304,
					"content": "灰色的小貓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030305
					]
				},
				{
					"id": 718030305,
					"content": "灰色的小貓…走失在野外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030306,
					"content": "啊！嵐姐之前提到了一個找貓的委託…難道牠就是那隻貓？好像是叫灰灰還是什麼的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030307,
					"content": "沒想到會在這裡找到牠…牠難道一直躲在這附近嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030311,
					"content": "因為丘丘岩盔王在這裡的原因，也沒有人敢過來找牠…牠也不敢出去，只能一直躲在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030312,
					"content": "還好我們過來了，不然牠不知道還要在這裡待到什麼時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030313,
					"content": "喵…喵喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030314,
						718030317
					],
					"speakerTitle": "灰灰"
				},
				{
					"id": 718030314,
					"content": "喵…喵…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030315
					]
				},
				{
					"id": 718030315,
					"content": "#喂，{F#妳}{M#你}在做什麼啊，這樣子牠也聽不懂的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030316,
					"content": "我們把牠帶回去給嵐姐好了，讓她把灰灰還給委託人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030319,
					"content": "喵…喵！喵！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030320,
						718030322
					],
					"speakerTitle": "灰灰"
				},
				{
					"id": 718030320,
					"content": "喵…喵！喵！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030321
					]
				},
				{
					"id": 718030321,
					"content": "#{F#妳}{M#你}再怎麼學它，牠也聽不懂啦！我們快點把牠帶回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030322,
					"content": "牠好像也答應了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030323
					]
				},
				{
					"id": 718030323,
					"content": "#{F#妳}{M#你}是怎麼聽懂的啦…算了，那我們快點把牠帶回去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030317,
					"content": "帶回去給嵐姐吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030318
					]
				},
				{
					"id": 718030318,
					"content": "嗯，也只有這樣了。把灰灰帶回去給嵐姐，讓嵐姐把牠還給委託人吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030308,
					"content": "難道牠就是灰灰…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718030309
					]
				},
				{
					"id": 718030309,
					"content": "灰色的小貓…走失在野外…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030310
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718030310,
					"content": "啊！是嵐姐之前提到的那個委託，居然會在這裡發現牠…難道牠一直躲在這附近？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718030311
					],
					"speakerTitle": "派蒙"
				}
