			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010101,
					"content": "重逢…比我想像的來得更早些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010102
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010102,
					"content": "啊，是戴因！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010103,
					"content": "#看{F#妳}{M#你}們的表情，好像剛經歷過什麼怪異的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010104
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010104,
					"content": "難道是在那座遺蹟裡，和「深淵使徒」打過照面了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010105
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010105,
					"content": "欸，戴因怎麼會知道？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010106,
					"content": "#我仍在繼續追獵「深淵使徒」，也沒料到會在這裡遇上{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010107,
						80010108
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010107,
					"content": "其實，我們經歷的不止是使徒…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				},
				{
					"id": 80010109,
					"content": "倒掛的神像…手中的深淵能量？不，我在與深淵對抗時，也沒見過類似的事物。但…我有所猜測。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010110
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010110,
					"content": "#先把{F#妳}{M#你}們的經歷說完吧。{F#妳}{M#你}們逃離了深淵能量彌漫的遺蹟底層，然後呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010111
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010111,
					"content": "然後我們在接近遺蹟出口的時候，被突然出現的「深淵使徒」攔截了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010112,
					"content": "我們和那傢伙大戰了一番，說不定它現在還沒走遠？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010113,
					"content": "嗯，機會難得，隨我一起追上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010114,
						80010115
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010114,
					"content": "好的！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010116,
					"content": "走吧！機會難得，還有戴因幫忙，說不定這次能解開很多謎題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010115,
					"content": "不，我記得好像我才是雇主…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010116
					]
				},
				{
					"id": 80010108,
					"content": "遺蹟裡還有更深層的怪異。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010109
					]
				}
			]
		},
		{
			"id": 800102,
			"completionStepIds": [
				800103
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800103",
							"2"
						],
						"stepId": 800103,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010201,
					"content": "剛才那些深淵法師…是準備埋伏我們的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010202,
					"content": "不，他們只是在那些遺蹟守衛的遺骸裡，翻找著什麼東西而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010203
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010203,
					"content": "是這樣嗎…旅行者好像也經常這麼做呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010204,
					"content": "什麼「混沌裝置」、「混沌迴路」之類的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010205,
						80010206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010205,
					"content": "對，那都是很重要的素材！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				},
				{
					"id": 80010207,
					"content": "不會是這麼普通的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010208
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010208,
					"content": "我之所以在附近調查，就是因為從那座遺蹟裡，時不時會有深淵法師外出探索。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010209
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010209,
					"content": "它們似乎是想要從遺蹟守衛的遺骸中，找到一件「特定的珍貴之物」，帶回遺蹟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010210
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010210,
					"content": "不過，看它們失望的樣子，至少目前應該還沒找到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010211
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010211,
					"content": "那麼剛才怎麼不抓住它們好好問問呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010212,
						80010213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010212,
					"content": "迪盧克老爺好像這麼做過…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010214,
					"content": "我當然沒打算對這些傢伙仁慈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010215
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010215,
					"content": "只是冥冥中感覺到，這件事對整個深淵教團來說，意義非凡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010216
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010216,
					"content": "它的真相，不是透過拷問就能得到的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010217
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010217,
					"content": "或者說，這些深淵法師，原本就面對著比任何拷問都更深的恐懼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010218,
						80010219
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010218,
					"content": "恐懼…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010220,
					"content": "欸…欸…這種汗毛直立的感覺是怎麼回事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010221,
					"content": "好了，別在這裡耽擱太久，我們繼續追跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010219,
					"content": "會與遺蹟裡的事物有關嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010220
					]
				},
				{
					"id": 80010213,
					"content": "對它們可以殘酷一點。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010214
					]
				},
				{
					"id": 80010206,
					"content": "深淵法師應該不是在找那些…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010207
					]
				}
			]
		},
		{
			"id": 800103,
			"completionStepIds": [
				800105
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800105",
							"2"
						],
						"stepId": 800105,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010301,
					"content": "呼…除了深淵教團，遺蹟守衛在這一帶也很活躍呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010302,
					"content": "感覺深淵法師蟄伏的地方，也經常會有遺蹟守衛遊蕩，這是什麼巧合嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010303,
					"content": "世上沒有什麼巧合，一切都是在久遠的過去埋下的種子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010304
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010304,
					"content": "#就像那間酒館裡{F#妳}{M#你}的出現一樣…時間只是等它發芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010305,
						80010306
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010305,
					"content": "可是我只是偶然聽說了你…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				},
				{
					"id": 80010307,
					"content": "沒事，一些不必要的感慨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010308
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010308,
					"content": "深淵教團和遺蹟守衛的聯繫，當然不是巧合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010309
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010309,
					"content": "應該說，是同一根系延展而出的枝杈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010310
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010310,
					"content": "根系？枝杈？你的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010311,
					"content": "它們都源自五百年前覆滅的古國——「坎瑞亞」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010312
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010312,
					"content": "欸？坎瑞亞？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010313,
					"content": "居然是這樣…深淵教團和遺蹟守衛，居然是坎瑞亞滅國之後的殘餘嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010314,
					"content": "說到坎瑞亞，那真是一個非常久遠的名字了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010315,
					"content": "哦，對了。作為嚮導，我還是跟旅行者解釋一下吧。「坎瑞亞」這個國度，是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010316
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010316,
					"content": "我知道「坎瑞亞」這個名字。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010317
					]
				},
				{
					"id": 80010317,
					"content": "欸…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010318,
					"content": "因為，我有在坎瑞亞的記憶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010319
					]
				},
				{
					"id": 80010319,
					"content": "#{F#妳}{M#你}有記憶？可是那是五百年前就已經覆滅的國度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010320
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010320,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010321
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010321,
					"content": "#是嗎，人皆有秘密，{F#妳}{M#你}沒有追問過我時間的事，我也不會追問{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010322
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010322,
					"content": "#但若{F#妳}{M#你}願意對我說，我也會聽。那麼——{F#妳}{M#你}所見到的坎瑞亞，是怎樣的一副景象？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010323,
						80010324,
						80010325,
						80010362
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010323,
					"content": "（已經不是能繼續隱瞞的時候了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010326,
					"content": "#原來那時發生的事，完整順序是這樣的呀…我還以為，{F#妳}{M#你}一開始就遇見了那位陌生的神靈呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010327
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010327,
					"content": "#嗯…降臨此世之後，{F#妳}{M#你}最初的復甦，就是被{F#哥哥}{M#妹妹}從隕星中喚醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010328
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010328,
					"content": "#看來{F#妳}{M#你}的{F#哥哥}{M#妹妹}比{F#妳}{M#你}先醒呢，只是不知道比{F#妳}{M#你}早了多久？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010329
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010329,
					"content": "#然後，{F#妳}{M#你}的{F#哥哥}{M#妹妹}告訴{F#妳}{M#你}，坎瑞亞的滅亡導致天變地異，要{F#妳}{M#你}一起離開這個名為提瓦特的世界。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010330
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010330,
					"content": "#「坎瑞亞的滅亡」？{F#他}{M#她}是這樣說的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010331,
						80010332
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010331,
					"content": "沒錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010333,
					"content": "你們經歷了那次災變，那是…五百年前的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010334
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010334,
					"content": "#看來{F#妳}{M#你}在這個世界的第一次甦醒，也是在那個時期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010335
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010335,
					"content": "#嗯…這樣說來，{F#妳}{M#你}的{F#哥哥}{M#妹妹}，因為先醒的關係，當時比{F#妳}{M#你}更瞭解這個世界吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010336,
					"content": "而此事的後續，就是你們很快就遇到了一位攔住去路的陌生神靈，未能逃離…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010337
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010337,
					"content": "唔，這件事是我聽得最熟的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010338
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010338,
					"content": "…我明白了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010339
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010339,
					"content": "#當時{F#妳}{M#你}剛甦醒，又匆忙想要離開這個世界，完全不知道「坎瑞亞」這個地名的任何背景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010340
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010340,
					"content": "但現在對提瓦特有了一些瞭解以後，就猜想當年經歷的那一戰，正是「坎瑞亞覆滅之戰」，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010341
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010341,
					"content": "#啊，這麼說來，我們一起旅行的這幾個月裡，{F#妳}{M#你}好像查過不少古籍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010342
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010342,
					"content": "#去蒙德前，只看過一些模糊的資料，後來又在蒙德、璃月各地收集過一些舊書，{F#妳}{M#你}都說「用處不大」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010343,
					"content": "#原來{F#妳}{M#你}其實是想知道更多關於坎瑞亞的事，而且是為了尋找{F#哥哥}{M#妹妹}嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010344,
						80010345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010344,
					"content": "那是僅次於「七神」的線索。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010346,
					"content": "嗯，也是。要尋找七神，可以踏遍七國。但五百年前毀滅的坎瑞亞，現在已經找不到了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010347
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010347,
					"content": "關於坎瑞亞的事，我知道的應該比你們多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010348
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010348,
					"content": "坎瑞亞是沒有神明的國度——神明並非死亡或離開，而是從一開始就不存在於坎瑞亞的歷史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010349
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010349,
					"content": "這是單純由人類建起的強大國度，人類以它空前的繁榮與輝煌文明而自傲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010350
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010350,
					"content": "神…不存在的…國度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010351
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010351,
					"content": "#而之後的事，也正如{F#妳}{M#你}留下的記憶——所有一切，都毀於神靈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010352
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010352,
					"content": "你的意思是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010353
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010353,
					"content": "五百年前，是眾神一同降臨，覆滅了坎瑞亞。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010354
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010354,
					"content": "將所謂「人類的驕傲」，如同雜草一般，從神明的花園中剷除…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010355
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010355,
					"content": "怎麼會這樣…歷史書上都沒有提過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010356,
						80010357
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010356,
					"content": "非常過分…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010358,
					"content": "嗯，繼續在這裡談論舊事，會消磨人的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010359,
						80010360
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010359,
					"content": "（但，下次見到溫迪和鍾離的時候…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010361,
					"content": "#先繼續前進吧。關於{F#妳}{M#你}想知道的那些事，我就在這一路上繼續告訴{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010360,
					"content": "（恐怕有必要聽聽他們的解釋。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010361
					]
				},
				{
					"id": 80010357,
					"content": "#危險的世界…更想盡快找到{F#哥哥}{M#妹妹}了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010358
					]
				},
				{
					"id": 80010345,
					"content": "雖然是只有「一個地名」的線索。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010346
					]
				},
				{
					"id": 80010332,
					"content": "當時聽到的，就是這句話。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010333
					]
				},
				{
					"id": 80010324,
					"content": "（戴因與坎瑞亞…就當作賭一次吧。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010325,
					"content": "（叫醒我的人…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010362,
					"content": "（還有，我剛醒來就看見的那片火海…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010326
					]
				},
				{
					"id": 80010306,
					"content": "有點…聽不太懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010307
					]
				}
			]
		},
		{
			"id": 800104,
			"completionStepIds": [
				800107
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800107",
							"2"
						],
						"stepId": 800107,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010401,
					"content": "欸，從這個深淵法師身上冒出的這段符咒是…難道會是「信」嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010402,
					"content": "嗯，這股氣息，無疑與「深淵使徒」有關。既然帶在深淵法師身上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010403
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010403,
					"content": "或許，真的會有關於它們行動的訊息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010404
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010404,
					"content": "可是，上面的文字好像讀不懂欸，是坎瑞亞的文字嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010405,
					"content": "#「…將敵人的信仰作為薪柴，為高貴的{F#王子}{M#公主}殿下獻上榮光…」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010406
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010406,
					"content": "啊，這是…信裡的內容？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010407
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010407,
					"content": "「——『命運的織機』，原動計畫。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010408
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010408,
					"content": "它們…「深淵」，似乎正在執行一個計畫。計畫的關鍵詞是…「命運的織機」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010409
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010409,
					"content": "目前似乎還在啟動階段，或者說，還在進行最初的試驗…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010410
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010410,
					"content": "「命運的織機」？那是什麼？字面意思感覺是…「紡織命運的機器」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010411,
						80010412
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010411,
					"content": "深淵法師是從那座遺蹟…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				},
				{
					"id": 80010413,
					"content": "欸，這麼一說，從氣氛來看，那座詭異的遺蹟，和這個計畫有關聯的可能性很大呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010414,
					"content": "所以戴因，信裡面究竟是怎麼說的呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010415,
					"content": "我正在讀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010416
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010416,
					"content": "嗯…天馬行空的計畫，也有些難以理解的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010417
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010417,
					"content": "什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010418
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010418,
					"content": "一言以概之，初步的計畫，與「漩渦之魔神」奧賽爾有關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010419
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010419,
					"content": "「漩渦之魔神」！是海裡的那個魔神嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010420,
						80010421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010420,
					"content": "上次，沒能消滅它…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010422,
					"content": "不過說起來，他們想要對奧賽爾做什麼？唔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010423,
					"content": "難道，和特瓦林一樣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010424
					]
				},
				{
					"id": 80010424,
					"content": "嗯，我瞭解過你們的事蹟，也很清楚深淵教團對「龍災」的涉足。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010425
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010425,
					"content": "雖然並非有意為之，但你們確實已經阻止過一次深淵教團的類似計畫了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010426
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010426,
					"content": "之前是「神的眷屬」，現在是「舊日魔神」嗎…目標越來越大了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010427
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010427,
					"content": "這一次，「深淵」也和對特瓦林一樣，想要用謊言和咒術來腐蝕奧賽爾嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010428,
					"content": "不…從「信」的內容來看，這一次的計畫，是更進一步的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010429
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010429,
					"content": "不僅是意志層面的改造——它們準備用製造「耕地機」的技術，徹底改造奧賽爾的肉體。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010430
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010430,
					"content": "這…這種事也做得到嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010431
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010431,
					"content": "難道深淵教團想要製造…「終極殺人機器，機械魔神烏賊」？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010432,
						80010433
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010432,
					"content": "聽起來大概是這個意思。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010434,
					"content": "如今這世上，已經很少有人真正瞭解坎瑞亞的文明程度，當然也難以去做評判。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010435
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010435,
					"content": "只有深淵教團一直在追尋坎瑞亞遺落的文明——雖然他們已經連人類都不是了，但執念仍存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010436
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010436,
					"content": "信中說，它們要用那座「污穢逆位神像」作為基底，接合奧賽爾的肢體，製造機械魔神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010437
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010437,
					"content": "而用來替換神像手中寶珠的「新的核心」，是…「世上第一座耕地機的眼睛」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010438
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010438,
					"content": "世上第一座耕地機的眼睛？…哦！我明白了，那些深淵法師一直在搜索的，就是這個吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010439
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010439,
					"content": "想必如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010440,
						80010441
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010440,
					"content": "它們還沒找到，我們還有時間。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010442,
					"content": "越說越複雜了啊。不過果然還是和那座…詭異的七天神像有關吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010443
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010443,
					"content": "是的。根據信上所說，將「眼」置於「污穢逆位神像」之手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010444
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010444,
					"content": "就能為新誕生的污穢魔神，賦予「動搖天空島上神座」的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010445,
						80010446
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010445,
					"content": "（天空島…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010447,
					"content": "嗚…這個計畫想要對抗的東西，真是巨大到不可思議呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010448
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010448,
					"content": "說起來，既然現在沒人知道「世上第一座耕地機」在哪裡，那不如…先從「神像」這個線索著手調查？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010449,
						80010450
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010449,
					"content": "那座神像，是風神像的模樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010451,
					"content": "嗯，那個到處賣唱的詩人太難找了，不如先去<color=#00E1FFFF>西風大教堂</color>瞭解一下情況吧，說不定會有什麼眉目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010452
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010452,
					"content": "教堂…哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010453
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010453,
					"content": "嗯？戴因，怎麼了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010454
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010454,
					"content": "沒什麼，先過去再說吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010450,
					"content": "去問問西風教會的人？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010451
					]
				},
				{
					"id": 80010446,
					"content": "（動搖神座…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010447
					]
				},
				{
					"id": 80010441,
					"content": "搶先一步，找到它吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010442
					]
				},
				{
					"id": 80010433,
					"content": "綽號的長度增加了！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010434
					]
				},
				{
					"id": 80010421,
					"content": "只是被群玉閣再次鎮壓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010422
					]
				},
				{
					"id": 80010412,
					"content": "會與逆位的神像有關嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010413
					]
				}
			]
		},
		{
			"id": 800105,
			"completionStepIds": [
				800108
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"800108",
							"2"
						],
						"stepId": 800108,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"戴因斯雷布"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 80010501,
					"content": "看那邊，又是遺蹟守衛和深淵法師。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010502
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010502,
					"content": "戴因剛才說，這些古代機器也是源於坎瑞亞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010503,
					"content": "莫非，坎瑞亞有很多遺蹟需要保護？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010504
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010504,
					"content": "不。「遺蹟守衛」這個名字，是現代人根據現代的「印象」取的。五百年前沒有人這樣稱呼它們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010505
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010505,
					"content": "現在被稱作遺蹟守衛的這些機器，當年在坎瑞亞的代號是，「耕地機」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010506
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010506,
					"content": "耕地機？好奇怪的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010507,
						80010508
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010507,
					"content": "原來是農具嗎？！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				},
				{
					"id": 80010509,
					"content": "#並不是{F#妳}{M#你}們想的那樣。所謂「耕地機」，其實是一種代號。當年的坎瑞亞人會為兵器創造代號。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010510
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010510,
					"content": "「土地不是用農具去犁的，而是用鐵與血去爭奪的。」——基於這樣的理念，「耕地機」誕生了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010511
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010511,
					"content": "用鐵與血去爭奪土地？坎瑞亞人居然這樣理解「耕地」…感覺不是什麼好的含義呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010512
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010512,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010513
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010513,
					"content": "在坎瑞亞覆滅以後，這些失去主人的「耕地機」便紛紛脫離了控制。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010514
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010514,
					"content": "在漫長的時光中不斷遊蕩，逐漸散落在了提瓦特大陸的各個角落。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010515
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010515,
					"content": "可能是與同樣覆滅了的其它古文明，同病相憐的緣故，它們才常常駐留在各類遺蹟中，休眠假寐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010516
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010516,
					"content": "聽上去…感覺很可憐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010517,
						80010518
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010517,
					"content": "五百年漫無目的的遊蕩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010520
					]
				},
				{
					"id": 80010520,
					"content": "#好了，再深入瞭解下去，那些細節對{F#妳}{M#你}們就沒有什麼意義了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010521
					],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010521,
					"content": "但不論過去如何，至少現在它們只餘下「威脅」的部分了。把它們全都解決了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "戴因斯雷布"
				},
				{
					"id": 80010518,
					"content": "看來…要多多終結它們的痛苦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010519
					]
				},
				{
					"id": 80010519,
					"content": "#嗯…怎麼說呢？{F#妳}{M#你}做得一直都不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						80010520
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 80010508,
					"content": "可是那些殺傷性的武器是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						80010509
					]
				}
			]
		}
	]
}