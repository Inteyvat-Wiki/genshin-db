			},
			"dialogs": [
				{
					"id": 201020601,
					"content": "#{F#妳}{M#你}找到蒲公英了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020602
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020602,
					"content": "找到了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020603
					]
				},
				{
					"id": 201020603,
					"content": "太好了，這些就夠了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020604
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020604,
					"content": "把蒲公英籽放進信裡面…然後封好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020605
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020605,
					"content": "好啦！嘿嘿，爸爸收到這封信肯定很高興。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020606
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020606,
					"content": "不過…我聽說送信要用專業的信鴿才行…而且，我也不知道爸爸的收信地址…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020607
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020607,
					"content": "對了！我聽葛瑞絲媽媽說，清泉鎮的杜拉夫先生養了一批信鴿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020608
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020608,
					"content": "而且她說，杜拉夫先生還認識我爸爸，他一定知道怎麼把這封信寄出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020609
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020609,
					"content": "#那…就拜託{F#妳}{M#你}再幫我跑一趟，把這封信給杜拉夫先生，拜託他寄出去給我爸爸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020610
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020610,
					"content": "還有，不許偷看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				}
			]
		},
