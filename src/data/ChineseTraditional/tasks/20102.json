			},
			"dialogs": [
				{
					"id": 201020701,
					"content": "#嗯？{F#妳}{M#你}把信送過去了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020702
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020702,
					"content": "這是提米要寄給他爸爸的信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020703
					]
				},
				{
					"id": 201020703,
					"content": "#提米寄給他爸爸的信…{F#妳}{M#你}也應該從葛瑞絲修女那聽說了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020704
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020704,
					"content": "這封信是…寄不出去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020705,
						201020708,
						201020712
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020705,
					"content": "那就不寄了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020706
					]
				},
				{
					"id": 201020706,
					"content": "怎麼想都沒法寄出去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020707
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020707,
					"content": "沒辦法，還是暫且由我保管起來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020717,
					"content": "好了，這封信就放在我這裡…就權當它已經寄出去了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020718
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020718,
					"content": "我的那位老朋友一定也會理解我的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020719
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020719,
					"content": "#謝謝{F#妳}{M#你}，請務必向提米保密，{F#妳}{M#你}一定做得到，對吧？至少…看在這些謝禮的份上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020708,
					"content": "燒掉吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020709
					]
				},
				{
					"id": 201020709,
					"content": "#哈哈哈，{F#妳}{M#你}已經很有冒險家的作風了，做起事果決高效…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020710
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020710,
					"content": "不過，我可不是冒險家，我只是個普通的獵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020711
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020711,
					"content": "我不會把這封信燒掉的，也不會打開，我會把它好好保管起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020712,
					"content": "我來保管。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020713
					]
				},
				{
					"id": 201020713,
					"content": "#{F#妳}{M#你}保管來做什麼？{F#妳}{M#你}不會是想，也許我的那位老朋友沒死…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020714
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020714,
					"content": "#…只要{F#妳}{M#你}遊歷的地方夠多，也許還是會遇見他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020715
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020715,
					"content": "#我也曾經和{F#妳}{M#你}想的一樣，甚至還付諸了行動，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020716
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020716,
					"content": "最終我還是認清了現實，那就是我的老朋友已經永遠離我而去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020717
					],
					"speakerTitle": "杜拉夫"
				}
			]
		},
