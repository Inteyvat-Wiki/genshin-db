	"talks": [
		{
			"id": 2010201,
			"completionStepIds": [
				2010201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010201",
							"2"
						],
						"stepId": 2010201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杜拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020101,
					"content": "唉，也不知道那孩子怎麼樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020102
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020102,
					"content": "怎麼了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020103
					]
				},
				{
					"id": 201020103,
					"content": "#嗯？哦，{F#妳}{M#你}來得正好，還記得上次那封信嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020104
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020104,
					"content": "#如果{F#妳}{M#你}有空的話，就幫我把這封信帶給葛瑞絲修女吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020105,
						201020107
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020105,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020106
					]
				},
				{
					"id": 201020106,
					"content": "#那就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020107,
					"content": "為什麼要我去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020108
					]
				},
				{
					"id": 201020108,
					"content": "出了上次那種意外，我怎麼敢繼續用鴿子送信嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020109
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020109,
					"content": "而且，如果我自己送這封信去蒙德城，一定會遇見那孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020110
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020110,
					"content": "#唉…{F#妳}{M#你}也別追問了，這封信就拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				}
			]
		},
		{
			"id": 2010202,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"杜拉夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020201,
					"content": "#嗯？{F#妳}{M#你}怎麼還沒有去？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020202,
						201020205
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020202,
					"content": "關於那封信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020203
					]
				},
				{
					"id": 201020203,
					"content": "#…裡面就寫了些陳年舊事，{F#妳}{M#你}上次沒有看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020204
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020204,
					"content": "沒看的話也別看了，都是些無聊的囉嗦話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020205,
					"content": "那孩子是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020206
					]
				},
				{
					"id": 201020206,
					"content": "#{F#妳}{M#你}關心這個做什麼，那個一直在橋上餵鴿子的孩子，{F#妳}{M#你}還記得吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020207
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020207,
					"content": "就是他，提米。因為…一些原因，我不太好現在去見他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020208
					],
					"speakerTitle": "杜拉夫"
				},
				{
					"id": 201020208,
					"content": "滿意了嗎？快點去把信送過去吧，不然葛瑞絲修女又要想東想西了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "杜拉夫"
				}
			]
		},
		{
			"id": 2010203,
			"completionStepIds": [
				2010202
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2010202",
							"2"
						],
						"stepId": 2010202,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"葛瑞絲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020301,
					"content": "奇怪，怎麼還沒有來，難道是出什麼事了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020302
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020302,
					"content": "這是杜拉夫給妳的信。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020303
					]
				},
				{
					"id": 201020303,
					"content": "#咦？怎麼是{F#妳}{M#你}送來的，平時不都是鴿子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020304
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020304,
					"content": "鴿子出了意外？清泉鎮真是…天天都在發生「意外」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020305
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020305,
					"content": "謝謝你們把信送來，請稍等一下，我去準備謝禮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020306
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020306,
					"content": "關於這封信…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020307
					]
				},
				{
					"id": 201020307,
					"content": "您看過了嗎？沒關係，不是什麼重大的秘密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020308
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020308,
					"content": "用杜拉夫先生的話來說，這是些「陳年舊事」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020309
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020309,
					"content": "只不過，這些「陳年舊事」，我們永遠也忘不掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020310
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020310,
					"content": "這些「陳年舊事」到底是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020311
					]
				},
				{
					"id": 201020311,
					"content": "您想聽嗎？好吧，您是值得信賴的人…但是您也得保證，絕不能把這件事說出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020312,
						201020313
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020312,
					"content": "我保證。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020316
					]
				},
				{
					"id": 201020316,
					"content": "…提米的父親，和杜拉夫先生是很好的朋友，他們一起狩獵，一起喝酒，一起到處惹麻煩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020317
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020317,
					"content": "不知道被騎士團警告了多少次，也不知道被維多利亞修女訓誡了多少次。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020318
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020318,
					"content": "直到提米出生，提米的父親才收斂了起來。他甚至還戒了酒，開始認真工作賺錢，說「老爹要給兒子做榜樣才行」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020319
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020319,
					"content": "然後，他嚷嚷著不要給提米做壞榜樣，磨得杜拉夫先生也把酒給戒了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020320
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020320,
					"content": "實在忍不住的時候，他們就一個勁地給自己灌蘋果釀，偶爾我會去和他們一起喝一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020321
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020321,
					"content": "但是，他們的一次狩獵出了意外，提米的父親受了很重的傷…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020322
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020322,
					"content": "雖然馬上就送了過來，我們也全力治療，但是…很不幸，他還是去世了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020323
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020323,
					"content": "那之後，杜拉夫先生就拜託我照顧提米，他回去清泉鎮繼續做獵人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020324
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020324,
					"content": "他每個月都會寄信和錢過來，但卻一直不肯見提米。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020325
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020325,
					"content": "不過，最近他一直在說，要把真相告訴提米，唉，到底他經歷了什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020326,
						201020332,
						201020336
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020326,
					"content": "您不想告訴提米真相？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020327
					]
				},
				{
					"id": 201020327,
					"content": "是的，我不想告訴提米真相，他還是個孩子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020328
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020328,
					"content": "雖然他一直說自己已經是男子漢，還幫我照顧諾拉和葛蘿麗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020329
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020329,
					"content": "但是…這種殘酷的真相，他怎麼可能承受得住呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020330
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020330,
					"content": "在他足夠成熟，能夠承受真相之前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020331
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020331,
					"content": "就算是欺騙也好，我想要給他一個幸福的童年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020341,
					"content": "不過提米也在長大，想的事，問的問題也越來越多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020342
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020342,
					"content": "我已經越來越難面對這孩子了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020343
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020343,
					"content": "諾拉說，之前提米一直拉著她到處跑，說是要給自己的父親籌備禮物，還要寄信過去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020344
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020344,
					"content": "但最近，提米總是悶悶不樂的，還總是在發呆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020345
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020345,
					"content": "如果您有空的話，能幫我去看看提米嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020346,
						201020348
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020346,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020347
					]
				},
				{
					"id": 201020347,
					"content": "那就拜託您了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020348,
					"content": "為什麼妳不自己去？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020349
					]
				},
				{
					"id": 201020349,
					"content": "實在不好意思…雖然嘴上說我已經想清楚了，不會告訴提米真相。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020350
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020350,
					"content": "但每次聽見那孩子說要給父親寫信的時候，我都會突然心軟。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020351
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020351,
					"content": "我真怕我哪一天忍耐不住，把真相全部告訴他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020352
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020352,
					"content": "…但這樣是絕對不行的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020353
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020353,
					"content": "所以，請您幫我去看看提米吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020332,
					"content": "不可能瞞一輩子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020333
					]
				},
				{
					"id": 201020333,
					"content": "…是啊，我知道的。但提米還是個孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020334
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020334,
					"content": "但是我希望…我堅持，他應該有一個快樂的童年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020335
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020335,
					"content": "這樣的話，無論他以後會遭受怎樣的痛苦折磨，至少還有美好的回憶能給他安慰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020336,
					"content": "知道真相有什麼不好的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020337
					]
				},
				{
					"id": 201020337,
					"content": "呼…您這麼想也正常，因為您經歷了太多，已經足夠勇敢，足夠堅強了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020338
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020338,
					"content": "那些將您塑造得如此不凡的經歷，想必也是十分痛苦的吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020339
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020339,
					"content": "但提米還小，即使是出於我的私心，我也不希望他承受太多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020340
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020340,
					"content": "…至少，我想給他一個能夠回憶的幸福童年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020341
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020313,
					"content": "我盡量。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020314
					]
				},
				{
					"id": 201020314,
					"content": "唉，您這個人哪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020315
					],
					"speakerTitle": "葛瑞絲"
				},
				{
					"id": 201020315,
					"content": "…不過，我相信您的品德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020316
					],
					"speakerTitle": "葛瑞絲"
				}
			]
		},
