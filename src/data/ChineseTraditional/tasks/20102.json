				"objectNames": [
					"提米"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 201020401,
					"content": "…一點消息也沒有。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020402,
						201020405
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020402,
					"content": "你在餵鴿子嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020403
					]
				},
				{
					"id": 201020403,
					"content": "#今天我餵過了，而且已經讓牠們趕緊飛走，免得又被{F#妳}{M#你}禍害。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020404
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020404,
					"content": "現在我就只是在寫信而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020407,
					"content": "葛瑞絲媽媽說，如果爸爸有空的話，就會用鴿子寄信過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020408
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020408,
					"content": "但是我等到現在也沒收到一封信…也許爸爸工作真的太忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020409
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020409,
					"content": "我就想，既然爸爸太忙，那我就寫一封信給他吧，裡面再帶上點禮物…可是，帶什麼禮物好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020410
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020410,
					"content": "對了，用<color=#00E1FFFF>蒲公英</color>吧，葛瑞絲媽媽說蒙德人都喜歡蒲公英。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020411
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020411,
					"content": "#如果{F#妳}{M#你}有空的話，就去幫我找點<color=#00E1FFFF>蒲公英</color>來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020412,
						201020414
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020412,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020413
					]
				},
				{
					"id": 201020413,
					"content": "#哦！謝謝{F#妳}{M#你}啦…{F#妳}{M#你}偶爾還是挺好心的嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				},
				{
					"id": 201020414,
					"content": "不送點別的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020415
					]
				},
				{
					"id": 201020415,
					"content": "我倒是想送，可是太重的話，鴿子就飛不起來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020416
					],
					"speakerTitle": "提米"
				},
				{
					"id": 201020416,
					"content": "而且爸爸在很遠的地方工作，鴿子應該也要飛很久吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "提米"
				},
				{
					"id": 201020405,
					"content": "你在做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						201020406
					]
				},
				{
					"id": 201020406,
					"content": "我在給我爸寫信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						201020407
					],
					"speakerTitle": "提米"
				}
			]
		},
