					"nextDialogs": [
						751010103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751010103,
					"content": "雖然和火元素共鳴的力量也不是你給的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751010104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751010104,
					"content": "嗯，是和火神共同戰鬥時候…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751010105
					]
				},
				{
