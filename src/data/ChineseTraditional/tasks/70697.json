			"dialogs": [
				{
					"id": 706970101,
					"content": "#{NICKNAME}！沒想到在蒙德碰上了{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970102
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970102,
					"content": "這還是我第一次來這麼冷的地方呢。所有的體驗都很新奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970103
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970103,
					"content": "打雪仗啊、堆雪人啊——哦對了，還有漫畫！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970104
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970104,
					"content": "沒想到，稻妻流行的作品《熾魂鬥士戰記》，在這裡也有讀者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970105
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970105,
					"content": "我和幾個納塔來的朋友聊漫畫聊得很開心，一時手癢，還做了一塊漫畫角色立牌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970106
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970106,
					"content": "#對了，{F#妳}{M#你}聽說過《熾魂鬥士戰記》嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970107
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970107,
					"content": "和宵宮聊了聊「熾魂鬥士特攻隊」的事…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						706970108
					]
				},
				{
					"id": 706970108,
					"content": "#竟然這麼巧，{F#妳}{M#你}的朋友也喜歡這部漫畫，好奇妙的緣分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						706970109
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 706970109,
					"content": "#那這塊立牌就送給{F#妳}{M#你}們吧——熾魂鬥士菲耶蒂娜，正好配「熾魂鬥士特戰隊」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				}
			]
		}
	]
