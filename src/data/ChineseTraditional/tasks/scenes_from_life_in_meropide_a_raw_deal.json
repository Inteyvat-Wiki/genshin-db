			"dialogs": [
				{
					"id": 740610401,
					"content": "唉…兩位兩位。呼——趕上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610402
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740610402,
					"content": "你怎麼氣喘吁吁的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740610403,
					"content": "我剛把廢棄生產區那邊的事情辦完，就趕緊跑過來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610404
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740610404,
					"content": "怎麼樣事情辦好了嗎？信是不是已經送出去了？太好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610405,
						740610406
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740610405,
					"content": "信上的署名是純白鈴蘭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610407
					]
				},
				{
					"id": 740610407,
					"content": "啊？原來那小女孩幫自己取了這樣的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610408
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740610408,
					"content": "#好吧，說實話，這封信是一個小女孩託我來寄的，我看她病得厲害就答應了，甚至分文未取！給{F#妳}{M#你}們的報酬可是我自掏腰包…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610409
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740610409,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610410,
						740610411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740610410,
					"content": "看信的內容，的確病得不輕。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610412
					]
				},
				{
					"id": 740610412,
					"content": "一定是我出門的時候拿錯信了。不好了，這下要趕不上我兒子他的生日了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610413
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740610413,
					"content": "啊？今天居然是拿錯了信？德瑟布爾先生就和傳說中一樣倒楣呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740610414,
					"content": "#可能這就是我的命運吧。唉，不跟{F#妳}{M#你}們說了，我要趕快回去拿信。希望還來得及。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610415
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740610415,
					"content": "#兩位這是{F#妳}{M#你}們的報酬，合作愉快。我還要送信給兒子，下次再見！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610416
					],
					"speakerTitle": "德瑟布爾"
				},
				{
					"id": 740610416,
					"content": "啊啊怎麼這就走了！明明還有一堆問題想問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740610417,
					"content": "算了，反正有特許券就沒問題。欸？！怎麼才這麼一點？連吃一頓飯都不夠！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740610418,
						740610420
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740610418,
					"content": "看來今晚要挨餓了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610419
					]
				},
				{
					"id": 740610419,
					"content": "不要啦！我好餓，嗚嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740610420,
					"content": "還是我們再接一次排隊的委託？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610421
					]
				},
				{
					"id": 740610421,
					"content": "那我寧願餓肚子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740610411,
					"content": "真的假的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740610412
					]
				},
				{
					"id": 740610406,
					"content": "你就是純白鈴蘭？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
