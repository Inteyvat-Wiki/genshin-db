				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2155.005,
							109.349,
							11195.66
						],
						"pointId": 360300006
					}
				]
			},
			"dialogs": [
				{
					"id": 760520201,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520202
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520202,
					"content": "怎麼樣怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520203,
					"content": "它讓我回想起了非常久遠的過去，那時我和「霜月之子」生活在一起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520204
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520204,
					"content": "他們習慣將新鮮的薄荷葉、香料和漿果乾共同沖泡，製成具有混合風味的飲品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520205
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520205,
					"content": "每次經過窗邊的時候，我總會聞見小屋裡飄出淡淡的草木清香…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520206
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520206,
					"content": "後來呢？妳嚐了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520207,
					"content": "試過，但沒喝成。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520208
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520208,
					"content": "欸？為什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520209,
					"content": "「神明大人」突然說出「能嚐嚐你家的茶嗎？」這種話之後…沒人敢真的將家中的「粗茶」獻上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520210
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520210,
					"content": "啊，也是呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520211,
					"content": "最後到我手中，就變成了在華美包裝下「獻予神明」的「貢品」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520212
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520212,
					"content": "不是說它難喝——但…它少了某種我路過窗邊時聞到的…溫馨的味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520213
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520213,
					"content": "現在可以喝個夠了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520214
					]
				},
				{
					"id": 760520214,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520215
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520215,
					"content": "很美味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520216
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520216,
					"content": "…不過，倒是很少見到加入牛奶的做法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520217
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520217,
					"content": "畢竟是從蒙德帶來的配方嘛，他們喝茶還滿喜歡加牛奶、鮮奶油和糖的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520218
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520218,
					"content": "很新奇，感覺還不錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520219
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520219,
					"content": "呼，妳喜歡就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520220
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520220,
					"content": "#嗯，謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520221
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520221,
					"content": "原來不只月光能映照往事，飲品的芳香，也能喚起深藏於過去的風景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				}
			]
		},
