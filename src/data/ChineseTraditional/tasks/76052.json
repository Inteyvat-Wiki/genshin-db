			"dialogs": [
				{
					"id": 760520501,
					"content": "咕嘟…咕嘟…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520502
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520502,
					"content": "一口氣全喝完了！太好了，她看起來是很喜歡的樣子呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520503
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520503,
					"content": "沒什麼味道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520504
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520504,
					"content": "沒…沒什麼味道？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520505
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520505,
					"content": "嗯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520506,
						760520507
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520506,
					"content": "是不是喝太快了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				},
				{
					"id": 760520508,
					"content": "噢，不用了，謝謝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520509
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520509,
					"content": "曾經，我無法理解人們所說的那種豐收的喜悅，直到有天，我親手觸碰了枝頭成熟的果實…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520510
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520510,
					"content": "我能從果皮的紋理中感受到它的生命力，它將來自陽光、水土和空氣的養分轉化成了這種形式。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520511
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520511,
					"content": "伴隨著咀嚼時的脆響，鮮甜的滋味像沁涼白浪一般層層翻湧而來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520512
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520512,
					"content": "於是我明白了，香氣是一種誰也逃不開的引力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520513
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520513,
					"content": "哦！不錯的感想呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520514
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520514,
					"content": "我們以奪走這種生命力的方式完成了自然的轉化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520515
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520515,
					"content": "突然就變得殘酷了起來？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520516
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520516,
					"content": "所以我更喜歡新鮮的水果，它讓我知道我從這個世界原原本本地取走了什麼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520517
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520517,
					"content": "這也是我應當回報這個世界的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520507,
					"content": "不然我再調一杯？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520508
					]
				}
			]
		},
