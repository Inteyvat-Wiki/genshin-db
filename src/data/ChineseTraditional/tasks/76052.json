						],
						"pointId": 360300006
					}
				]
			},
			"dialogs": [
				{
					"id": 760520101,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520102
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520102,
					"content": "哥倫比婭，妳還好嗎？看起來有點無精打采呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520103,
					"content": "#是{F#妳}{M#你}們啊。我沒事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520104
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520104,
					"content": "（是又在思考關於「月亮」的問題了嗎…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520105
					]
				},
				{
					"id": 760520105,
					"content": "有什麼能為妳做的嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520106
					]
				},
				{
					"id": 760520106,
					"content": "我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520107
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520107,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520108
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520108,
					"content": "沒關係，就算只是些小煩惱，說出來也會好一些哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520109,
					"content": "我有點…想喝酒館裡的飲品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520110
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520110,
					"content": "欸？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520111,
					"content": "…唔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520112
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520112,
					"content": "抱歉！剛才我有點驚訝。因為妳很少會提妳自己想要什麼東西嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520113,
					"content": "而且，居然只是…飲品。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520114,
					"content": "是覺得太簡單了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520115
					]
				},
				{
					"id": 760520115,
					"content": "可能我以為至少也要是「為我摘下月亮吧」這種等級的願望…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520116,
					"content": "啊，不過我似乎可以理解。現在哥倫比婭無法隨心所欲地行動，去酒館說不定和摘月亮差不多難呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520117,
					"content": "不只是現在。以前在「愚人眾」的時候沒人要抓我，但出門散步的時候，大家還是躲得遠遠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520118
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520118,
					"content": "（執行官第三席…這個名號的確會讓不瞭解她的人害怕吧…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520119
					]
				},
				{
					"id": 760520119,
					"content": "咦？不過…我突然覺得這個願望也不是那麼難！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520120,
					"content": "#只要求酒館等級的飲品的話，{NICKNAME}，{F#妳}{M#你}不是就會做嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520121
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520121,
					"content": "…真的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520122
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520122,
					"content": "看妳那麼期待的樣子，我反倒要緊張起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520123,
					"content": "口味上有要求嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520124
					]
				},
				{
					"id": 760520124,
					"content": "口味…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520125
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520125,
					"content": "我沒怎麼嘗試過外面的飲品，反而給不出具體的方向…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520126
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520126,
					"content": "不要太厚重的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520127
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520127,
					"content": "厚重是什麼意思？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520128
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520128,
					"content": "像「愚人眾」的大衣一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520129
					],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520129,
					"content": "怎麼越比喻還越模糊了啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760520130,
						760520131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760520130,
					"content": "大概是想要清香淡雅的飲品…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				},
				{
					"id": 760520132,
					"content": "#好啊。交給{F#妳}{M#你}定。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "「少女」"
				},
				{
					"id": 760520131,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						760520132
					]
				}
			]
		},
		{
			"id": 7605202,
