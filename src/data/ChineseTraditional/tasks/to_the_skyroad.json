			"dialogs": [
				{
					"id": 751350201,
					"content": "哇，玻娜妳飛得也太快了，我們差點就要跟不上了啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350202,
					"content": "嘿嘿，抱歉抱歉，看到源火祭壇在前面，不知不覺就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350203
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751350203,
					"content": "只要用這個祭壇就可以去天蛇船了嗎？不過就算等等出現了什麼超級大風場把我們吹起來，也不知道要飛多久…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350204,
					"content": "哇，光想就開始擔心了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350205,
						751350207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350205,
					"content": "不用害怕，派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350206
					]
				},
				{
					"id": 751350206,
					"content": "#好吧，既然{F#妳}{M#你}都這樣說了，等一下{F#妳}{M#你}絕對不要離我太遠哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350209,
					"content": "總之現在是要把火磷石供奉到那個上面，不過我們手上有兩顆火磷石，呃…保險起見就兩個都一起放上去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751350207,
					"content": "哇，好刺激。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350208
					]
				},
				{
					"id": 751350208,
					"content": "對吧對吧？我也開始興奮起來了，作為冒險家才不能錯過這樣的挑戰！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350209
					],
					"speakerTitle": "玻娜"
				}
			]
