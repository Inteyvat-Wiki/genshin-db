			"dialogs": [
				{
					"id": 751350101,
					"content": "那就是源火祭壇了嗎…呃，感覺想要過去的話還有點困難。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350102,
					"content": "#怎麼辦？我們是可以用飛的啦，但是{REALNAME[ID(2)|SHOWHOST(true)]}和玻娜要怎麼辦啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350103,
					"content": "派蒙不會是在小看我吧？我可是花羽會的冒險家，飛行經驗很豐富的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350104
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751350104,
					"content": "#就算是帶著{REALNAME[ID(2)|SHOWHOST(true)]}飛到那邊也是輕輕鬆鬆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350105
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751350105,
					"content": "我也有飛行執照。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350106
					]
				},
				{
					"id": 751350106,
					"content": "那就好，我會在前面幫你們指路，你們只要跟上我就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350107
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751350107,
					"content": "接下來是飛行競速挑戰嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751350108
					]
				},
				{
					"id": 751350108,
					"content": "哇，這種時候就不要有這種好勝之心啦。我會在前面幫你們指路，你們只要跟上我就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350109
					],
					"speakerTitle": "玻娜"
				},
				{
					"id": 751350109,
					"content": "#總感覺很危險的樣子，也不知道會發生什麼，{REALNAME[ID(2)|SHOWHOST(true)]}你一定要抓緊我們哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751350110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751350110,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				}
			]
