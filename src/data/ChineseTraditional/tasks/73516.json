			"trigger": {
				"objectNames": [
					"維納亞克",
					"施芮婭"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 735160101,
					"content": "——施芮婭，妳剛剛看到了嗎！我們的「對沙蟲用殺蟲炮」，果然是劃時代的設計！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160102
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735160102,
					"content": "真希望當年聽我們口試的導師都過來看看，治治他們陳腐守舊的眼界！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160103
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735160103,
					"content": "居然真的沒出什麼問題…我還以為八成會落到三號機的下場…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160104
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735160104,
					"content": "咳…經一事長一智嘛，我也不是當初那個我了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160105
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735160105,
					"content": "當年究竟出了多少事故啊…無、無論如何，實驗成功了就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735160106,
					"content": "嗯，趁著現在勢頭不錯，我們換個地方再來一次吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160107
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735160107,
					"content": "——目擊情報說，這附近至少還有兩位數的沙蟲呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160108
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735160108,
					"content": "等等——兩位數？！你不會打算就這麼一隻一隻幹掉吧？這得打到什麼時候啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735160109,
					"content": "嗯？有什麼問題嗎？如果是「對沙蟲用殺蟲炮」的保養情況，應該不用擔心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160110
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735160110,
					"content": "慢著慢著！要重複那麼久望不到頭的工作，機械沒垮我們也要累垮了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 735160111,
					"content": "維納亞克，可不是每個人都像你一樣，只要聞到機油味就能恢復精神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160112
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735160112,
					"content": "是嗎？看來下次得把軟體性能也納入考量了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160113
					],
					"speakerTitle": "維納亞克"
				},
				{
					"id": 735160113,
					"content": "總之，今天就先到這裡吧。有了這次完整運作的資料和戰鬥後採集到的樣本，我離解開謎題也更近了一步。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160114
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735160114,
					"content": "什麼謎題？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						735160115
					]
				},
				{
					"id": 735160115,
					"content": "沙蟲作亂的原因、環境參數的異常…只要能搞清楚這些，說不定就能從根本上解決這次動亂了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						735160116
					],
					"speakerTitle": "施芮婭"
				},
				{
					"id": 735160116,
					"content": "請再給我一天時間做點調查吧，等到明天這個時候，應該就會有結果了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "施芮婭"
				}
			]
		}
	]
}