			"dialogs": [
				{
					"id": 722040901,
					"content": "#{F#妳}{M#你}來了呀…呵呵，真是的，木戶，木奈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040902
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040902,
					"content": "他們又跑去不知哪裡玩了吧，真是的…不好意思呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040903
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040903,
					"content": "#對了…{F#妳}{M#你}叫…什麼來著？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040904,
						722040905
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040904,
					"content": "#{NICKNAME}，您好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
					]
				},
				{
					"id": 722040906,
					"content": "唉…我…快要離開了，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040907
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040907,
					"content": "離開…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040908
					]
				},
				{
					"id": 722040908,
					"content": "那個撐船的人，最近一直來催我呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040909
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040909,
					"content": "每次都會靜靜地過來，穿著金的毛皮衣服，金的長褲子，頭上戴著金絲的冠…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040910
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040910,
					"content": "就像媽媽告訴我的，就像我告訴木戶和木奈的那樣…帶我們登上銀璨璨的船喲…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040911
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040911,
					"content": "在閃亮亮的河上蕩呀蕩呀…就到了夢中。夢的土地沒有迷霧，那裡有一座金色的大屋子…有七十個，又七十個的搖籃…搖啊搖，搖啊搖…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040912
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040912,
					"content": "我們安眠在那裡，就化成了點點的光…然後呀，就化成了大地上小孩子的夢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040913,
						722040914
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040913,
					"content": "哇……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040915,
					"content": "撐船的人說…他替木戶和木奈轉交了這些給我。呵呵…這兩個孩子呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040916
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040916,
					"content": "還不是時候喲…還不是時候呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040914,
					"content": "您的意思是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040915
					]
				},
				{
					"id": 722040905,
					"content": "#我是{NICKNAME}呀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040906
					]
				}
			]
		},
