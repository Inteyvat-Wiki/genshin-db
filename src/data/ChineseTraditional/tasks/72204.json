				"points": []
			},
			"dialogs": [
				{
					"id": 722040601,
					"content": "這樣嗎…你說他的手裡握著…這些？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040602
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040602,
					"content": "究竟在想什麼呀…你究竟在想些什麼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				}
			]
		},
		{
			"id": 7220407,
			"completionStepIds": [
				7220404
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220404",
							"2"
						],
						"stepId": 7220404,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220410",
							"3"
						],
						"stepId": 7220410,
						"stateName": "QUEST_STATE_FINISHED"
