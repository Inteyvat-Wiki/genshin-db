					"宇奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040401,
					"content": "去玩吧，去玩吧…奶奶不會離開的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040402
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040402,
					"content": "花瓣呀…花瓣喲…你的故鄉，是什麼樣子呢…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				}
			]
		},
		{
			"id": 7220405,
			"completionStepIds": [
				7220403
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220403",
							"2"
						],
						"stepId": 7220403,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220409",
							"3"
						],
						"stepId": 7220409,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宇奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040501,
					"content": "是阿部呀。家裡蘑菇收成如何？呵呵…你可不要再去打擾祭司大人囉，他再勸我也是不會同意的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040502
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040502,
					"content": "呵呵，對不起啦！一個人養家而已，我怎麼就忙不過來了？呵呵，對不起啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040503
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040503,
					"content": "對不起啦…唉…對不起啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040504,
						722040505
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040504,
					"content": "您好，老婆婆。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				},
				{
					"id": 722040506,
					"content": "啊…！是你呀！真是的…羞不羞人！快進來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040507,
						722040508
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040507,
					"content": "呃…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040509,
					"content": "在外面的漁獲如何…？沒有打到魚嗎…沒關係，沒關係，靠家裡的園壟也足夠了。只是給雷鳥大人的奉獻沒辦法足額了…嗯，怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040510
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040510,
					"content": "你在犯什麼傻！今年的祭典明明很順利，接下來的年景一定都不錯…祭司大人也說我們會有個強壯的孩子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040511
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040511,
					"content": "可為什麼突然跟我說這種事！你忘了釜氏的下場嗎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040512,
						722040513
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040512,
					"content": "請您冷靜一點！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040514,
					"content": "如果你也想要離棄雷鳥大人，被狂怒的海浪吞噬的話，那就隨便你去吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040515
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040515,
					"content": "我的孩子…可憐的孩子…唉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040513,
					"content": "「釜」…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040514
					]
				},
				{
					"id": 722040508,
					"content": "唔……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040509
					]
				},
				{
					"id": 722040505,
					"content": "請問您還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040506
					]
				}
			]
		},
		{
			"id": 7220406,
