			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宇奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040701,
					"content": "#{F#妳}{M#你}好，{F#妳}{M#你}好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040702
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040702,
					"content": "#唉，對不起呀，年紀大了頭腦難免不清楚…請問{F#妳}{M#你}是誰呀…？我曾認識{F#妳}{M#你}嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040703,
						722040704
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040703,
					"content": "#我是{NICKNAME}。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				},
				{
					"id": 722040705,
					"content": "沒聽說過的名字呢…是外面來的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040706
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040706,
					"content": "奇怪，奇怪…沒有雷鳥大人的准許，應該沒有人能隨隨便便來到島上呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040707,
						722040708
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040707,
					"content": "雷鳥早已不在了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040709,
					"content": "#唉…看見{F#妳}{M#你}，就讓我想起我可憐的丈夫…可現在，我卻連他的樣子都記不起來了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040710
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040710,
					"content": "那時候我們都還年輕，腦子裡都是些不切實際的幻想…但有些人，即使在一起過日子久了，也不會長大半點…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040711
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040711,
					"content": "他離我而去，紮了一條木筏想要渡海去另一邊，外人的島上…他說他想要在那裡自由地捕獵，採摘沒見過的花…好看的花…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040712
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040712,
					"content": "從小時候他就這樣說…但他從來沒有長大過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040713
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040713,
					"content": "後來，祭司大人的孩子在海灘上看見了他…臥在那裡，貝殼一樣安靜，比海砂還要白…這些花瓣，就握在他的手裡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040714
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040714,
					"content": "祭司大人哭了，和我說…先祖的船拒絕了他。他的「靈」此後只能徘徊在外人的土地上了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040715
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040715,
					"content": "那時我才剛剛生下我們的孩子…這種事情，我要怎麼跟他說才好呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040716
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040716,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040717
					]
				},
				{
					"id": 722040717,
					"content": "後來呀…我的孩子也有了孩子，再後來，我也送孩子們登上了銀璨璨的船…但我依然在這個大地上活著…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040718
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040718,
					"content": "我的牽掛呀…也就只有了木戶與木奈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040708,
					"content": "很難和您解釋其中原因…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040709
					]
				},
				{
					"id": 722040704,
					"content": "#您好，叫我{NICKNAME}就好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040705
					]
				}
			]
		},
