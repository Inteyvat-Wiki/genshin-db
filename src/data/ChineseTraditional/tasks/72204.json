				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宇奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040101,
					"content": "木戶，木奈，你們來啦…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040102
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040102,
					"content": "真是的…又到處亂跑，我的腿腳可跟不上你們啦…要是遇到危險該怎麼辦呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040103,
						722040104
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040103,
					"content": "您好…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				},
				{
					"id": 722040105,
					"content": "欸喲！你們真是…你們還小，可不要說這種話呀，這樣太傷老人家的心了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040106
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040106,
					"content": "既然來了，就先別亂跑亂玩啦…也來陪陪奶奶，好不好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040107,
						722040108
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040107,
					"content": "抱歉，我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040109,
					"content": "上次那個故事講到哪裡了…？啊，對了…那是你們的爺爺的爺爺年紀還小的時候囉…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040110
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040110,
					"content": "在霧海之外、外人的島嶼上，有一支氏族叫做夷摩美氏…他們的主母，是一個狐狸樣的女人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040111
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040111,
					"content": "他們說，那邊的土地上，生滿了雷色的花朵…夷摩美氏的族人們，就在那樣的高山與田野間築屋生活，相愛相樂…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040112
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040112,
					"content": "然後呀…哈…他們的花呀…哈…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040113
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040113,
					"content": "呼…呼…霧海的外面呀…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040114,
						722040115
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040114,
					"content": "老婆婆…？您還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040116,
					"content": "欸…木戶？木奈？哦…你們要走了？唉…真不好意思，奶奶又自顧自地睡著了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040117
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040117,
					"content": "臨走之前，別忘了這個呀…奶奶一直為你們珍藏著呢…這是霧海之外另一邊來的好看的花…可不要丟了喲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040115,
					"content": "（還是不要打擾她了…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040116
					]
				},
				{
					"id": 722040108,
					"content": "好吧…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040109
					]
				},
				{
					"id": 722040104,
					"content": "可能您認錯人了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040105
					]
				}
			]
		},
		{
			"id": 7220402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
