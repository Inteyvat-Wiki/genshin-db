			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宇奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040201,
					"content": "好啦…好啦…也讓奶奶睡一下吧…嗯…呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040202
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040202,
					"content": "你們可小心點…別跑太遠了…呼…呼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				}
			]
		},
		{
			"id": 7220403,
			"completionStepIds": [
				7220402
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_AND",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220402",
							"2"
						],
						"stepId": 7220402,
						"stateName": "QUEST_STATE_UNFINISHED"
					},
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7220408",
							"3"
						],
						"stepId": 7220408,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宇奈"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 722040301,
					"content": "唉…愈來愈不清楚了…愈來愈記不清事情了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040302,
						722040303
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040302,
					"content": "您好？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				},
				{
					"id": 722040304,
					"content": "唉…記性越來越差了。人老了，越來越多的事情，記不住了呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040305
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040305,
					"content": "這樣怎麼可好呀…也不知道木戶和木奈有沒有餓著，在外面玩安不安全…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040306,
						722040307
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040306,
					"content": "他們不會有事的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040308,
					"content": "木戶，木奈！你們怎麼才來呀…在路上有沒有摔著碰著？沒有又去爬樹吧…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040309
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040309,
					"content": "真是讓奶奶擔心壞了…唉，最近不知發生了什麼，島上的人愈來愈少了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040310
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040310,
					"content": "我還記得名字的人呢，更少了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040311
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040311,
					"content": "唉，要是什麼時候，奶奶把你們也忘記了…那該怎麼辦呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040312
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040312,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040313
					]
				},
				{
					"id": 722040313,
					"content": "唉…這些花瓣給你們，什麼時候呀，要是奶奶把你們忘了，就給我看這個吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						722040314
					],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040314,
					"content": "奶奶還有好多故事要講給你們聽呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宇奈"
				},
				{
					"id": 722040307,
					"content": "我能幫得上忙嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040308
					]
				},
				{
					"id": 722040303,
					"content": "發生什麼事了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						722040304
					]
				}
			]
		},
