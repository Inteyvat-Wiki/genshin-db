							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"摩答伐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730201,
					"content": "吾主摩訶婆蘇{RUBY#[D]賜生世尊之嗣}提婆耶弗啊，願汝的耆婆{RUBY#[D]命根}提耶深入這岩地的基石，願汝的美味勝過世間一切神明…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "摩答伐"
				}
			]
		},
		{
			"id": 7007303,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7007302",
							"2"
						],
						"stepId": 7007302,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"摩答伐"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 700730301,
					"content": "這是什麼東西…？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						700730302
					]
				},
				{
					"id": 700730302,
					"content": "善哉斯問！此為吾等所供奉的賜生世{RUBY#[S]比夫蘢}尊神之嗣，道成正味之蕈子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730303
					],
					"speakerTitle": "摩答伐"
				},
				{
					"id": 700730303,
					"content": "龍呼常念草木之主與花{RUBY#[D]浮槃婆梨袈}圃之主，瑪卡尼哈岡總向赤砂之神禱告——汝可問問他們，那三位尊神，有哪一位比吾主更美味？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730304
					],
					"speakerTitle": "摩答伐"
				},
				{
					"id": 700730304,
					"content": "須知不害即是正業。若非吾主的神軀，吾等亦要取鳥獸草木之命以維生…嗚呼，何等可哀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						700730305
					],
					"speakerTitle": "摩答伐"
				},
				{
					"id": 700730305,
					"content": "所幸，空之主將吾帶離大地時，吾主的耆{RUBY#[D]孢子}婆亦與吾同行。如是汝觀，今已生長至此，賜吾等無上妙味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "摩答伐"
				}
			]
		},
		{
