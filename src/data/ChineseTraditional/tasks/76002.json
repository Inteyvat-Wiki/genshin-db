				]
			},
			"dialogs": [
				{
					"id": 760020301,
					"content": "呼…還是讓他們跑了。這群小鬼也真不識相，竟然敢動我們的主意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020302
					],
					"speakerTitle": "巴蘇"
				},
				{
					"id": 760020302,
					"content": "多謝相幫。待弟兄們把這位「貝勒維爾小姐」送到那夏鎮，兩位的報酬絕對少不了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020303
					],
					"speakerTitle": "巴蘇"
				},
				{
					"id": 760020303,
					"content": "嗯嗯，記得酬勞就…咦，等等，你們難道是人口販子嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760020304,
					"content": "哈哈，別誤會，小妹妹，綁票的生意我們可不做。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020305
					],
					"speakerTitle": "巴蘇"
				},
				{
					"id": 760020305,
					"content": "「貝勒維爾小姐」是這個鐵皮玩意的名字。從灰河一路運過來的，花了不少功夫。要是讓人別了，弟兄們可就賠大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020306
					],
					"speakerTitle": "巴蘇"
				},
				{
					"id": 760020306,
					"content": "哦哦，原來是楓丹的發條機關…不過，這麼看看的話，楓丹的技術還真厲害啊，運到這裡還能動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 760020307,
					"content": "小妹子又在開玩笑了。這鐵皮玩意的能源系統早就拆掉了，哪有可能——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020308
					],
					"speakerTitle": "巴蘇"
				},
				{
					"id": 760020308,
					"content": "「警告。啟動模式<color=#FF5E41FF>異常</color>。能源模組<color=#FF5E41FF>異x5F02&#5E38常</color>。驗證失敗。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020309
					],
					"speakerTitle": "「貝勒維爾小姐」"
				},
				{
					"id": 760020309,
					"content": "「驗證失敗。<color=#FF5E41FF>驗證失敗</color>。<color=#FF5E41FF>驗證失敗</color>。<color=#FF5E41FF>殲滅</color>。<color=#FF5E41FF>殲滅</color>。<color=#FF5E41FF>殲滅</color>。<color=#FF5E41FF>殲滅殲滅殲滅殲</color>——」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760020310
					],
					"speakerTitle": "「貝勒維爾小姐」"
				},
				{
					"id": 760020310,
					"content": "#噫——！{NICKNAME}，小心呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
