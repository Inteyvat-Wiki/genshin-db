			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751480101,
					"content": "受龍所選者，啊，受龍所選者啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480102,
					"content": "登上冠冕之頂，躍入聖山之火吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480103,
					"content": "去揭開吧，去揭開金印，揭開億萬餘火的焰光！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480104,
					"content": "唔嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480105
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480105,
					"content": "怎麼了，難道又看到什麼奇怪的話？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480106,
						751480107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480106,
					"content": "感覺…更加清晰了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				},
				{
					"id": 751480108,
					"content": "咦，是因為靠近了火山的關係嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480109,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480110
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480110,
					"content": "…看起來就像是，那個一直跟你們說話的人就在火山裡一樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480111,
					"content": "不過既然靠近火山的時候又能看到那些東西，就說明我們沒有走錯路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480112,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480107,
					"content": "感覺…距離更近了一些…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480108
					]
				}
			]
		},
		{
			"id": 7514802,
			"completionStepIds": [
				7514807
			],
			"beginWay": "TALK_BEGIN_MANUAL",
