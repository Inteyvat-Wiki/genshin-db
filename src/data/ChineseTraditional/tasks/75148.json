			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"#{REALNAME[ID(2)|SHOWHOST(true)]}"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							-2887.504,
