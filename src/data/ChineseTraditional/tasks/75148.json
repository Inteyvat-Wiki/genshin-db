						],
						"pointId": 351700005
					}
				]
			},
			"dialogs": [
				{
					"id": 751480201,
					"content": "咦，剛才那是，絨、絨翼龍？還真的是絨翼龍把雕像偷到這個地方來的呀…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480202,
					"content": "等等，牠是不是直接抓著那個雕像跳下去了，跳進了，火山口裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480203,
					"content": "那裡就是火山口…還滿壯觀的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480204,
					"content": "唔，之前問路的時候，不是說火山口聚集了海量的氣態燃素…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480205,
					"content": "對哦！<color=#00E1FFFF>穿越氣態燃素的辦法</color>，就像…剛才的絨翼龍那樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480206,
					"content": "不過，嗚，這麼高！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480207,
						751480210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480207,
					"content": "沒關係，我會抱住派蒙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480208
					]
				},
				{
					"id": 751480208,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480209
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480209,
					"content": "咦，你也願意嗎？真的嗎…好、好吧，既然這樣好像也沒有那麼害怕了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480214,
					"content": "而且，不僅僅是高，別忘了那些氣態燃素呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480215,
					"content": "唔，等、等準備好，我們就出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480210,
					"content": "只要落地瞬間派蒙能拉住…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751480211
					]
				},
				{
					"id": 751480211,
					"content": "拉不住啦，先不說我有沒有那麼大的力氣，什麼叫落地的瞬間嘛，這個時機的把握也太難了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 751480212,
					"content": "呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480213
					],
					"speakerTitle": "#{REALNAME[ID(2)|SHOWHOST(true)]}"
				},
				{
					"id": 751480213,
					"content": "你也是，不許跟著瞎起鬨。唉…被你們這麼一鬧，一點緊張感都沒有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751480214
					],
					"speakerTitle": "派蒙"
				}
			]
		},
