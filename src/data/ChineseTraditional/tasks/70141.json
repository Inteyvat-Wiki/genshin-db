			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701410101,
					"content": "關於雪山的情況…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701410102
					]
				},
				{
					"id": 701410102,
					"content": "雪山的情況？我只能說，這裡的環境比蒙德任何地方都要兇險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410103
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410103,
					"content": "除了惡劣的環境之外，這座山裡還有一些奇怪的…冰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410104
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410104,
					"content": "那些冰難以擊碎，用火烤也不會融化…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410105
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410105,
					"content": "最主要的是，有幾條道路被這些冰堵住了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410106
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410106,
					"content": "我們的好幾支探險隊都被那些冰攔住，用盡方法也繞不過去，只能折返回來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410107
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410107,
					"content": "唉，不知道什麼時候才能找到解決那些冰的方法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410108
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410108,
					"content": "我想去看看那些冰。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701410109
					]
				},
				{
					"id": 701410109,
					"content": "#{F#妳}{M#你}只是想去看看那些冰吧？我記得雪山的外圍也有一大塊類似的冰，不知道裡面凍著什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701410110
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701410110,
					"content": "#{F#妳}{M#你}可以去那附近看一看，不過記住，千萬不要再往裡走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
