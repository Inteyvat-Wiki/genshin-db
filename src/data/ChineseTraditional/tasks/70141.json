					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701411201,
					"content": "這座雪山可真危險…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701411202
					]
				},
				{
					"id": 701411202,
					"content": "#嗯？{F#妳}{M#你}回來了，怎麼樣，看到那些冰了吧，呃…{F#妳}{M#你}怎麼這麼一副樣子…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411203
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411203,
					"content": "關於洞窟中的氣流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701411204
					]
				},
				{
					"id": 701411204,
					"content": "#{F#妳}{M#你}已經到那麼高的地方了？{F#妳}{M#你}還真是厲害啊。不過…被奇怪氣流封堵的洞窟？唔，我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411205
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411205,
					"content": "哦…我想起來了，之前有一支冒險隊運氣好，一直探索到了山頂附近。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411206
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411206,
					"content": "雖然他們還是沒能靠太近，但是據他們說，山頂附近的一個洞窟裡確實有一股奇怪的強氣流湧出…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411207
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411207,
					"content": "但按道理來說，那種地方即使有氣流，也不該那麼強才對，到現在也沒人能找出原因…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411208
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411208,
					"content": "而且除了那股奇怪的氣流之外，雪山中還有一些奇怪的冰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411209
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411209,
					"content": "那些冰難以擊碎，用火烤也不會融化，對我們的探索造成了很大的阻礙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411210
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411210,
					"content": "我們也一直找不到對付那些冰的辦法，只能盡量繞開走…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411211
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411211,
					"content": "而且在一些冰旁邊，還生長著許多藍色的植物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411212
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411212,
					"content": "雖然我能隱約看見那些冰裡似乎凍著什麼，但我也沒辦法讓那些冰解凍，也只能看看罷了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411213
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411213,
					"content": "#{F#妳}{M#你}有興趣的話，可以循著那種藍色植物，去看看那些冰。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411214
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411214,
					"content": "#嗯…我想想，<color=#00E1FFFF>「雪葬之都·近郊」</color>和<color=#00E1FFFF>「星熒洞窟」</color>周圍就長著很多那種植物，{F#妳}{M#你}可以去那裡看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411215
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411215,
					"content": "奇怪的強氣流、和奇怪的冰，還有奇怪的植物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411216
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411216,
					"content": "哈哈哈，要是在一般的探險故事裡，這三者之間說不定會有什麼關聯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701411217
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701411217,
					"content": "#但在現實裡，探險還是要腳踏實地…{F#妳}{M#你}要進雪山的話，記得也要做好充足的準備啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
