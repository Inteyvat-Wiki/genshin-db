				]
			},
			"dialogs": [
				{
					"id": 740350401,
					"content": "您好，艾尤恩先生，有什麼可以幫您的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350402
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350402,
					"content": "柯妮莉婭小姐，您也好。請問我們有備用的打字機鍵帽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350403
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350403,
					"content": "什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350404
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350404,
					"content": "我的打字機少了一個鍵帽，我想申請一個備用鍵帽換上。要是沒有的話…幫我報銷一個也可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350405
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350405,
					"content": "報銷鍵帽…從原則上來說，是沒有問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350406
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350406,
					"content": "您在這簽個字吧。就寫「因打字機故障，需報銷鍵帽一枚」，然後簽上您的名字，還有辦公室名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350407
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350407,
					"content": "好了，我今天應該能拿到這枚鍵帽吧，我還急著去工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350408
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350408,
					"content": "艾尤恩先生，您之前報銷過公物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350409
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350409,
					"content": "公物報銷並不是您想像的那樣…來一件就報銷一件，我們需要先以月為統計時間匯總報銷單據，然後在月底統一交給樞律庭審批。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350410
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350410,
					"content": "這審批事關整個複律庭的薪資發放，如果報銷的數額過大，樞律庭甚至需要呈給那維萊特大人審閱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350427
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350427,
					"content": "等他整體審閱完畢再簽字後，才能正式開始撥款。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350411
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350411,
					"content": "如果那維萊特大人對某個報銷條例有疑問，對應的人員還需要提交一份書面說明…我們正準備這幾天就把第一批交上去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350412
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350412,
					"content": "妳的意思是，如果我運氣不好的話，想報銷這枚鍵帽還得那維萊特大人點頭？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350413
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350413,
					"content": "規定如此，艾尤恩先生。而且這個月要報銷的數額不小，很可能確實需要那維萊特大人審閱。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350414
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350414,
					"content": "那維萊特大人…不就是那位「最高審判官」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350415
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740350415,
					"content": "只不過是一個鍵帽，還要讓他來簽字…總覺得哪裡不太對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350416,
						740350417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740350416,
					"content": "有沒有別的方法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350418
					]
				},
				{
					"id": 740350418,
					"content": "我也這麼想，只是一枚鍵帽而已，不用驚動那維萊特大人的大駕，真的不用了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350419
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350419,
					"content": "其他方法是有。嗯…你可以先自己去買一枚鍵帽，然後我會在公帳裡為您打一張臨時單據。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350420
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350420,
					"content": "在報銷流程走完，款項撥下來之後，再將對應的費用從公帳裡撥付給您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350421
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350421,
					"content": "好極了！就這樣吧，一枚鍵帽也不會花多少錢，我付得起。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350422
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350422,
					"content": "那您在這裡簽個字，還是寫「因打字機故障，需報銷鍵帽一枚」…您是去伊絲黛萊小姐那裡買鍵帽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350423
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350423,
					"content": "是的，怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350424
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350424,
					"content": "我稍後會拿著這張臨時單據去找洛耶茨先生簽字，然後再去找伊絲黛萊小姐核對帳單。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350425
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350425,
					"content": "您就不用管這些事了，快點去買鍵帽吧，其他的事交給我處理就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350426
					],
					"speakerTitle": "柯妮莉婭"
				},
				{
					"id": 740350426,
					"content": "謝謝您。您真是太好了，柯妮莉婭小姐，我這就去買鍵帽…走吧旅行者，我們快出發。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350417,
					"content": "不然還是換個方法吧！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350427
					]
				}
			]
		},
