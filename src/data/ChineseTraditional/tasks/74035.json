			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740350101,
					"content": "#啊…旅行者，很高興見到{F#妳}{M#你}…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350102,
						740350103
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350102,
					"content": "你還好嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				},
				{
					"id": 740350104,
					"content": "你的黑眼圈好重，說話也沒力氣了，不然還是去休息一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 740350105,
					"content": "我…我不能休息，昨天晚上熬了一夜，寫了好幾稿都不行。現在我又開始重寫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350106
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350106,
					"content": "如果您想找我辦什麼事情的話，請再等等吧…您可以去洛耶茨先生那邊搬張椅子坐下，說不定他那邊還有咖啡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350107
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350107,
					"content": "我…我得繼續寫了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740350108
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350108,
					"content": "不行，用「各位親愛的同僚」總顯得不夠正式…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 740350103,
					"content": "你看起來很不好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740350104
					]
				}
			]
		},
		{
			"id": 7403502,
			"completionStepIds": [
				7403504
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
