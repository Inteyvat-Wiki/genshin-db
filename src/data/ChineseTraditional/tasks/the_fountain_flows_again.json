			"dialogs": [
				{
					"id": 740370501,
					"content": "#{F#妳}{M#你}好，請問有什麼…欸，厄代爾？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370502
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 740370502,
					"content": "我來拿閥門和噴口了，再不修好那個噴泉，勒莫迪埃那小子一定會急死。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370503
					],
					"speakerTitle": "厄代爾"
				},
				{
					"id": 740370503,
					"content": "閥…閥門啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370504
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 740370504,
					"content": "妳…怎麼支支吾吾的？伊絲黛萊…妳該不會根本就沒做吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370505
					],
					"speakerTitle": "厄代爾"
				},
				{
					"id": 740370505,
					"content": "不是！我已經做好了，只不過…因為之前一位客人需要緊急維修另外一些東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370506
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 740370506,
					"content": "我就…我就把一些通用的附屬零件給了她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370507
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 740370507,
					"content": "別急！我現在正在做新的，馬上就好！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370508
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 740370508,
					"content": "伊絲黛萊小姐，我可是提前了很久訂做的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370509
					],
					"speakerTitle": "厄代爾"
				},
				{
					"id": 740370509,
					"content": "我知道啦！但是那位客人也很急，說是要拿去修汙水閥門什麼的，我也拿她沒辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370510
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 740370510,
					"content": "沒關係，等我…等我買的鐵塊到了，就能做好！應該馬上就到了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370511
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 740370511,
					"content": "妳什麼時候訂的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370512
					],
					"speakerTitle": "厄代爾"
				},
				{
					"id": 740370512,
					"content": "今…今天早上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370513,
						740370514
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 740370513,
					"content": "鐵塊的事交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				},
				{
					"id": 740370515,
					"content": "#真的嗎？太好了！那就拜託{F#妳}{M#你}了，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370516
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 740370516,
					"content": "對不起、對不起！真的非常不好意思，只要三塊鐵塊就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370517
					],
					"speakerTitle": "伊絲黛萊"
				},
				{
					"id": 740370517,
					"content": "#唉，也只能交給{F#妳}{M#你}了，旅行者。放心吧，我會付報酬給{F#妳}{M#你}的，不會讓{F#妳}{M#你}白跑一躺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "厄代爾"
				},
				{
					"id": 740370514,
					"content": "還是由我去拿點鐵塊來吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370515
					]
				}
			]
		},
