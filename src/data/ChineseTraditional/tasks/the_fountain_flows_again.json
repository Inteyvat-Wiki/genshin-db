		},
		{
			"id": 7403703,
			"completionStepIds": [
				7403703
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7403703",
							"2"
						],
						"stepId": 7403703,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"厄代爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 740370301,
					"content": "這裡的管道需要更換…閥門…還有清潔問題…真是問題一大堆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370302
					],
					"speakerTitle": "厄代爾"
				},
				{
					"id": 740370302,
					"content": "#咦？{F#妳}{M#你}們找我有事嗎？看起來…{F#妳}{M#你}們也不像伊絲黛萊派過來修噴泉的人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370303
					],
					"speakerTitle": "厄代爾"
				},
				{
					"id": 740370303,
					"content": "關於勒莫迪埃的事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						740370304
					]
				},
				{
					"id": 740370304,
					"content": "#{F#妳}{M#你}說他啊。嘿…他的魔術真是太厲害啦，直接把那座噴泉底層管道的一個閥門給弄廢了，還順便把噴口給弄壞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370305
					],
					"speakerTitle": "厄代爾"
				},
				{
					"id": 740370305,
					"content": "哈哈哈，開個玩笑。其實是那個變形的閥門卡住了整個出水系統，為了安全起見，我們只能暫時把整座噴泉給關上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370306
					],
					"speakerTitle": "厄代爾"
				},
				{
					"id": 740370306,
					"content": "不過噴口為什麼會壞掉，我還真不清楚…真奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370307
					],
					"speakerTitle": "厄代爾"
				},
				{
					"id": 740370307,
					"content": "勒莫迪埃一直說，如果噴泉修不好，他就要被罵…但我之前真的是太忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370308
					],
					"speakerTitle": "厄代爾"
				},
				{
					"id": 740370308,
					"content": "今天我總算有空，找伊絲黛萊訂了一個新閥門和新噴口，正準備去城裡拿過來的說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						740370309
					],
					"speakerTitle": "厄代爾"
				},
				{
					"id": 740370309,
					"content": "#要是{F#妳}{M#你}願意的話，就和我一起去吧，東西還滿多的，我都有點擔心我一個人拿不動了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "厄代爾"
				}
			]
		},
