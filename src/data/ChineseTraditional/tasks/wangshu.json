						10031013
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10031013,
					"content": "#客棧裡有一幅字畫，描摹了璃月通行千年的「降魔印」，{F#妳}{M#你}們可以去看看它的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031014
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10031014,
					"content": "——然後，就在這間客棧附近，尋找「能夠見到完整降魔印的地方」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
