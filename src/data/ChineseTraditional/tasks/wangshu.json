			"dialogs": [
				{
					"id": 10039301,
					"content": "關於妳丈夫？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039302
					]
				},
				{
					"id": 10039302,
					"content": "他就在那邊，是客棧的掌櫃。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039303
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10039303,
					"content": "別看他笑嘻嘻的，其實拳腳功夫很厲害的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039304
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10039304,
					"content": "我也是，我們的廚子也是，都是這麼招進來的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039305
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10039305,
					"content": "#不會功夫還怎麼招待好客人呢，{F#妳}{M#你}說是不是這個道理。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				}
			]
		},
