			"dialogs": [
				{
					"id": 10039401,
					"content": "請問妳是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039402
					]
				},
				{
					"id": 10039402,
					"content": "我叫戈黛特，來自蒙德。是望舒客棧的老闆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039403
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10039403,
					"content": "不是老闆娘。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039404
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10039404,
					"content": "是、老、闆。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039405,
						10039410
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10039405,
					"content": "有些傳聞…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039406
					]
				},
				{
					"id": 10039406,
					"content": "哈哈哈，能在這裡開店，怎麼可能和七星沒有關係呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039407
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10039407,
					"content": "我意思是，肯定需要他們同意嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039408
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10039408,
					"content": "其他一些有的沒的，那當然都是謠言啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039409
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10039409,
					"content": "這麼說來，您聽到過什麼有意思的事情嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10039410,
					"content": "關於這貓…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10039411
					]
				},
				{
					"id": 10039411,
					"content": "唉…這貓是自己跟來的，不過看著挺可愛的就留下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039412
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10039412,
					"content": "名字嗎，叫阿偉，隨便取的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10039413
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10039413,
					"content": "牠可能會搗蛋一下，貓嘛，是這樣的。您可千萬別和牠一般見識。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲爾戈黛特"
				}
			]
