					"nextDialogs": [
						10031008
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10031008,
					"content": "#這可不是差使{F#妳}{M#你}們——正如那位仙人所說，人的靈魂不如仙人強韌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031009
					],
					"speakerTitle": "菲爾戈黛特"
				},
