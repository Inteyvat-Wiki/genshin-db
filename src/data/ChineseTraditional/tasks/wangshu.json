			"trigger": {
				"objectNames": [
					"菲爾戈黛特"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10030401,
					"content": "關於那位仙人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030402
					]
				},
				{
					"id": 10030402,
					"content": "#哦？{F#妳}{M#你}們已經見過魈了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030403
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030403,
					"content": "不錯嘛，難得他心情好，居然願意出來見人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030404
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030404,
					"content": "原來這樣的態度就已經是「心情好」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030405
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030405,
					"content": "是啊，仙緣難得，許多人一心訪仙，卻終生未見仙人一面呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030406
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030406,
					"content": "岩神建立璃月時，借助了仙人的力量。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030407
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030407,
					"content": "但因為仙人中的大多數，都只懂得以戰鬥來守護璃月…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030408
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030408,
					"content": "所以數千年來，終究還是人類掌握了貿易之都的運作，而仙人隱居在外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030409
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030409,
					"content": "老闆娘懂得真多啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030410
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030410,
					"content": "不是「老闆娘」，是「老闆」——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030411
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030411,
					"content": "#總之，既然{F#妳}{M#你}們這麼有仙緣，那事情就好辦多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030412
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030412,
					"content": "要問我的建議嘛…嗯，其實只要試著去哄魈開心就好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030413
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030413,
					"content": "開心…？那位「護法夜叉」大人，很難想像他開心起來是什麼樣子的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030414
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030414,
					"content": "哼哼，很期待吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030415
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030415,
					"content": "（其實我也從沒見他笑過…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030416
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030416,
					"content": "#這樣吧，先去找大廚要一份杏仁豆腐，再加上一道{F#妳}{M#你}拿手的菜。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030417
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030417,
					"content": "#杏仁豆腐是魈難得喜歡的人間食物，拿手的菜就靠{F#妳}{M#你}自由發揮了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030418
					],
					"speakerTitle": "菲爾戈黛特"
				},
				{
					"id": 10030418,
					"content": "#唔，自由發揮…{NICKNAME}，{F#妳}{M#你}最擅長做什麼菜呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030419,
						10030421
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030419,
					"content": "「滿足沙拉」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030420
					]
				},
				{
					"id": 10030420,
					"content": "是那種很難出錯的食物呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030423,
					"content": "不過，送給仙人的禮物還是保守一點，就用「滿足沙拉」好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030421,
					"content": "「大紅蓮麻辣火史萊姆」吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030422
					]
				},
				{
					"id": 10030422,
					"content": "哇，聽起來很新奇，想吃吃看！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030423
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 100306,
			"completionStepIds": [
				100306
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"100306",
							"2"
						],
						"stepId": 100306,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"言笑"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10030601,
					"content": "大爺我正在休息，閒人勿擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030602
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030602,
					"content": "請問，杏仁豆腐…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030603
					]
				},
				{
					"id": 10030603,
					"content": "閒人勿擾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030604
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030604,
					"content": "嗚…這位大廚的服務熱情，和蒙德的鐵匠瓦格納先生不相上下呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030605
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030605,
					"content": "菜是戈黛特老闆點的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10030606
					]
				},
				{
					"id": 10030606,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030607
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030607,
					"content": "原來如此。老闆吩咐下來的事，那就沒辦法了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030608
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030608,
					"content": "但很可惜，我現在有心無力，沒法做出杏仁豆腐這種細緻甜食。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030609
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030609,
					"content": "這是為什麼呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030610,
					"content": "劍客的手必須穩定，咱當廚子的自然也是如此。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030611
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030611,
					"content": "但現在我的手，不好意思…有點不太穩…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030612
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030612,
					"content": "原因嘛…是因為有客人傳言，這客棧裡…鬧鬼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030613
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030613,
					"content": "而且就在剛才！剛才…我在廚房…也看見了…不太對勁的東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030614
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030614,
					"content": "（這位大廚看起來這麼兇惡，說起靈異話題來，語氣就變得很虛弱呢。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10030615,
					"content": "總之…一想到連望舒客棧都不安全了，我磨甜杏仁的手就穩定不下來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10030616
					],
					"speakerTitle": "言笑"
				},
				{
					"id": 10030616,
