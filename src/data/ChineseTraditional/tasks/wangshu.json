					"nextDialogs": [
						10031711,
						10031712
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10031711,
					"content": "仙人會來接管璃月嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10031713
					]
				},
				{
					"id": 10031713,
					"content": "仙人不會逃避責任。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031714
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10031714,
					"content": "雖然…我有不願沾染凡塵的理由，但職責終歸是職責。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031715
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10031715,
					"content": "因為我們的神，乃是「契約」之神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10031716
					],
					"speakerTitle": "魈"
				},
				{
					"id": 10031716,
					"content": "等一下！我還有最後一個問題。",
