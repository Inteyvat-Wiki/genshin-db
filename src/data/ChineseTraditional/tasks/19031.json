			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"傅三兒"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 1903102101,
					"content": "一個人走在這裡，很危險的哦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102102
					],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102102,
					"content": "#因為，{F#妳}{M#你}根本不知道會遇到什麼人，或者說，是不是人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102103,
						1903102104
					],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102103,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				},
				{
					"id": 1903102105,
					"content": "#哼哼，沒想到{F#妳}{M#你}還挺冷靜的。有句俗話說，常在河邊走，哪有不濕鞋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102106
					],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102106,
					"content": "行走在這種陰森詭異的地方，說不定就會看到什麼不該看到的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102107
					],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102107,
					"content": "#只要看到了，它就會化作惡夢，糾纏{F#妳}{M#你}一生一世！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102108,
						1903102109
					],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102108,
					"content": "哦，這樣啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102110,
					"content": "不對啊，你也太冷靜了，一般人的話，我說到一半就已經嚇得逃跑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102111,
						1903102114
					],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102111,
					"content": "因為你看起來就是個普通人啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102112
					]
				},
				{
					"id": 1903102112,
					"content": "雖然這麼說，但真正高明的扮鬼方法，是利用對方的恐懼心理，製造恐怖的氣氛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102113
					],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102113,
					"content": "至於我的外觀，其實不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102117,
					"content": "#所以像{F#妳}{M#你}這樣不相信鬼的人，我用什麼辦法嚇唬都沒用啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102118
					],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102118,
					"content": "我覺得你只是在找理由偷懶。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102119
					]
				},
				{
					"id": 1903102119,
					"content": "別這麼說嘛，好了，我要去找其他的膽小鬼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102120
					],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102120,
					"content": "#{F#妳}{M#你}也趕快回去找你的同伴吧，說不定他已經被嚇得不行了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102114,
					"content": "你們沒有戲服之類的東西嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102115
					]
				},
				{
					"id": 1903102115,
					"content": "有是有，但是穿著太熱了…而且真正高明的扮鬼方法，是利用對方的恐懼心理，製造恐怖的氣氛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102116
					],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102116,
					"content": "至於我的外觀，其實不重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						1903102117
					],
					"speakerTitle": "傅三兒"
				},
				{
					"id": 1903102109,
					"content": "聽不太懂，請問你有什麼事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102110
					]
				},
				{
					"id": 1903102104,
					"content": "你好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						1903102105
					]
				}
			]
		}
	]
}