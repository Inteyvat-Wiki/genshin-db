			"dialogs": [
				{
					"id": 721280501,
					"content": "#{F#妳}{M#你}已經打開寶箱了吧，哈哈哈，希望{F#妳}{M#你}的手氣夠好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280502
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280502,
					"content": "你是在搜集那種海螺嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280503
					]
				},
				{
					"id": 721280503,
					"content": "#{F#妳}{M#你}倒是很敏銳嘛，沒錯，我就是在搜集這種海螺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280504
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280504,
					"content": "#但搜集這些海螺的原因我暫時不能和{F#妳}{M#你}說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280505,
						721280509
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280505,
					"content": "是有什麼特別之處嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280506
					]
				},
				{
					"id": 721280506,
					"content": "從做生意的角度來說，當然有特別之處了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280507
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280507,
					"content": "「曾經被祟神影響的海螺」…哈哈哈，肯定能賣出一個好價錢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
