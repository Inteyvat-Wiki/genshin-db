			"trigger": {
				"objectNames": [
					"阿敬"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721280102,
					"content": "欸，等一會，這些箱子可不能隨便打開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280103,
						721280105
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280103,
					"content": "這是你的箱子嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280104
					]
				},
				{
					"id": 721280104,
					"content": "那當然，這些箱子都是我特地放在這裡的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280106
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280106,
					"content": "這裡面裝著的，都是我特意搜集來的各種寶貝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280107
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280107,
					"content": "#{F#妳}{M#你}想打開那些寶箱的話，倒也不是不行。不過嘛…你得給我點東西做交換。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280108,
						721280110
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280108,
					"content": "是要摩拉嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280109
					]
				},
				{
					"id": 721280109,
					"content": "哈哈哈，倒也不用摩拉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280111
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280111,
					"content": "我想要的東西，是一種「海螺」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280112
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280112,
					"content": "在海灘周圍，應該能夠找到很多這種海螺。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280113
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280113,
					"content": "#如果{F#妳}{M#你}想要打開寶箱，把裡面的寶貝拿到手的話，就用那種海螺來和我交換吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280114
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280114,
					"content": "#不過嘛…我不會告訴{F#妳}{M#你}這些寶箱裡究竟有什麼，到底能拿到什麼寶貝，主要還是得看{F#妳}{M#你}的運氣啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280115
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280115,
					"content": "#怎麼樣，如果{F#妳}{M#你}想打開這些寶箱的話，就把那種海螺拿給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280110,
					"content": "你要什麼東西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280111
					]
				},
				{
					"id": 721280105,
					"content": "這裡面有什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721280106
					]
				}
			]
		},
