					"nextDialogs": [
						721280404
					]
				},
				{
					"id": 721280404,
					"content": "抱歉啦，這些寶箱，每次只能挑一個打開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721280405
					],
					"speakerTitle": "阿敬"
				},
				{
					"id": 721280405,
					"content": "#好了，快去挑一個寶箱打開吧，嘿嘿，祝{F#妳}{M#你}有個好手氣。",
