			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130401,
					"content": "#感謝{F#妳}{M#你}，風花節之星。我們已向風神巴巴托斯獻上飽含敬愛的「風之花」，願風護佑蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130402
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130402,
					"content": "不錯的選擇哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130403
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130403,
					"content": "你喜歡嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130404
					]
				},
				{
					"id": 414130404,
					"content": "#嗯——{F#妳}{M#你}猜？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130405
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130405,
					"content": "又要人猜，這個壞傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130406,
					"content": "#啊哈哈哈哈！會告訴{F#妳}{M#你}的啦，不過不是在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130407
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130407,
					"content": "人來人往的廣場不方便聊這些，換個地方吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130408
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130408,
					"content": "去哪好呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130409
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130409,
					"content": "#我想邀請{F#妳}{M#你}和我一起到「風龍廢墟」去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				}
			]
		},
		{
			"id": 4141307,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
