				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"溫迪"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130701,
					"content": "嗯！還是這裡的景色最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130702,
						414130703
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130702,
					"content": "好漂亮的風景。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				},
				{
					"id": 414130704,
					"content": "是啊，我很喜歡這個地方，閒暇時總會過來坐一會，看看風景。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130705
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130705,
					"content": "是來偷懶的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130706
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130706,
					"content": "哈哈哈，被發現了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130707
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130707,
					"content": "如此美景，手裡要是有杯蘋果酒該多好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130708
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130708,
					"content": "#旅行者，蒙德的風花節，{F#妳}{M#你}喜歡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130709,
						414130710
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130709,
					"content": "充滿人情味，又很熱鬧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130711,
					"content": "但還是有所疑問，對不對？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130712
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130712,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130713
					]
				},
				{
					"id": 414130713,
					"content": "#我知道{F#妳}{M#你}想問什麼。究竟什麼是「風之花」？風神巴巴托斯眼中的「風之花」與「風花節」又意味著什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130714
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130714,
					"content": "#如{F#妳}{M#你}所見，蒙德人民各有選擇。有人從千萬種花朵裡選擇了蒲公英，有人則挑選了風車菊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130715
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130715,
					"content": "每個人心中的「風之花」，好像都不一樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130716
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130716,
					"content": "是啊，本該如此。沒有唯一的答案，也沒有真實存在過的「風之花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130717
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130717,
					"content": "咦…不存在嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130718,
					"content": "「風之花」這個詞語，最初只是舊蒙德時代，人民之間相互聯絡、共約反抗的暗號罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130719
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130719,
					"content": "那時人們常說，風越大，「風之花」的根基就越穩固，花朵也綻放得越鮮豔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130720
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130720,
					"content": "要我說的話，它並不存在，也無處不在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130721
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130721,
					"content": "它是嚮往自由的靈魂、是追逐風向的勇氣…一切美好、值得被祝福的事物，都可以是「風之花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130722
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130722,
					"content": "看似不存在，卻又無處不在的東西，就像風一樣！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130723
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130723,
					"content": "哈哈，妳說得沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130724
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130724,
					"content": "所以，風神巴巴托斯不會定義何為「風之花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130725
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130725,
					"content": "祝福之花、敬愛之花、深愛之花。每個人都會有屬於自己的「風之花」，每個人都有自由定義它的權利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130726
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130726,
					"content": "自由之都蒙德獻給風神的花，果然非常自由呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130727
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130727,
					"content": "我也喜歡自由的感覺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130728
					]
				},
				{
					"id": 414130728,
					"content": "我知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130729
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130729,
					"content": "#人們會因為共同的意志走到一起，牽引{F#妳}{M#你}我相遇的，想必是自由之風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130730
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130730,
					"content": "#它來自旅途的盡頭、世界的邊緣。來自{F#妳}{M#你}我心中，永不停歇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130731
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130731,
					"content": "#「是誰輕撫{F#妳}{M#你}帶傷卻堅毅的面容\\n在小溪邊\\n在巨岩旁」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130732
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130732,
					"content": "#「是誰緊擁{F#妳}{M#你}疲憊而高貴的靈魂\\n在深夢裡\\n在高天之上」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130733
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130733,
					"content": "#「親愛的朋友\\n我牽著{F#妳}{M#你}的手\\n帶{F#妳}{M#你}走進夜晚華燈」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130734
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130734,
					"content": "#「為{F#妳}{M#你}從頭講述\\n節日裡那自由與夢的樂章」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130710,
					"content": "跟大家在一起，非常開心。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130711
					]
				},
				{
					"id": 414130703,
					"content": "氣氛真不錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130704
					]
				}
			]
		},
