			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 414130201,
					"content": "琴團長，我們來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130202,
					"content": "#旅行者！啊，不，這裡或許該稱呼{F#妳}{M#你}為榮譽騎士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130203
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130203,
					"content": "#想必{F#妳}{M#你}已經聽說了，{F#妳}{M#你}是本屆的「風花節之星」，將代表全蒙德人向風神巴巴托斯獻上「風之花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130204
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130204,
					"content": "不過…這次似乎略有不同呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130205
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130205,
					"content": "有我們，還有賣唱的，這次風花節是不是格外熱鬧呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130206,
					"content": "#是的。感謝{F#妳}{M#你}們常駐蒙德，也希望{F#妳}{M#你}們今後繼續享受在蒙德的生活。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130207
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130207,
					"content": "#風花典禮快要開始了。風花節之星，選好屬於{F#妳}{M#你}的「風之花」了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130208
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130208,
					"content": "我們必須選出一種花，把它獻給風神，對嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130209,
					"content": "#沒錯，請{F#妳}{M#你}慎重考慮之後做出選擇。別忘了，{F#妳}{M#你}的選擇代表著全蒙德。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130210
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130210,
					"content": "溫迪，你喜歡什麼花？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130211
					]
				},
				{
					"id": 414130211,
					"content": "嗯？好狡猾呀，居然直接問我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130212
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130212,
					"content": "咳咳…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130213
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130213,
					"content": "不要在這種場合說悄悄話啦你們兩個！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130214,
					"content": "哈哈，被訓了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130215
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130215,
					"content": "#不用在意我，選喜歡的就好。我相信{F#妳}{M#你}的品味。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130216
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 414130216,
					"content": "#那麼，榮譽騎士，{F#妳}{M#你}的選擇是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130217,
						414130219,
						414130221,
						414130223,
						414130225,
						414130227
					],
					"speakerTitle": "琴"
				},
				{
					"id": 414130217,
					"content": "蒲公英",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130218
					]
				},
				{
					"id": 414130218,
					"content": "哦！支持者眾多的熱門選擇，「風之花」一定就是蒲公英啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130229,
					"content": "#請代表蒙德人，向神像獻上{F#妳}{M#你}的「風之花」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 414130219,
					"content": "風車菊",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130220
					]
				},
				{
					"id": 414130220,
					"content": "哦！支持者眾多的熱門選擇，「風之花」一定就是風車菊啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130221,
					"content": "塞西莉亞花",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130222
					]
				},
				{
					"id": 414130222,
					"content": "哦！與貝雅特麗奇意見一致，「風之花」是較為冷門卻有著堅定擁護者的塞西莉亞花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130223,
					"content": "小燈草",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130224
					]
				},
				{
					"id": 414130224,
					"content": "哦！與寧錄意見一致，「風之花」是能照亮黑暗的小燈草！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130225,
					"content": "甜甜花",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130226
					]
				},
				{
					"id": 414130226,
					"content": "哦！與砂糖意見一致，「風之花」是從古到今生生不息的甜甜花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 414130227,
					"content": "鉤鉤果",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						414130228
					]
				},
				{
					"id": 414130228,
					"content": "哦！與雷澤意見一致，「風之花」是刺刺的麻麻的鉤鉤果！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						414130229
					],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4141304,
			"completionStepIds": [
				4141304
