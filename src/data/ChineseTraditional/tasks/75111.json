			"dialogs": [
				{
					"id": 751110401,
					"content": "「穆胡魯寶石鋪」…伊蜜？糟糕，不會是寄出去的貨單吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110402
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 751110402,
					"content": "要是這份快捷郵件弄丟了，那孩子八成要被夏溫小姐唸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110403
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 751110403,
					"content": "#我還要整理店裡的快捷郵件，可以請{F#妳}{M#你}幫我把這份快捷郵件送回去給伊蜜嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110404
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 751110404,
					"content": "她們的「穆胡魯寶石鋪」在「回聲之子」那邊，很容易就可以找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米齊卡"
				}
			]
		},
