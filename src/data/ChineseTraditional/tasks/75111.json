			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"米齊卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110301,
					"content": "這封信…像是夏安卡的筆跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110302
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 751110302,
					"content": "…一定又是寄出去訂貨的貨單。外面的包裝都已經破了，這封信不能繼續送，必須要原件退回才可以。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110303
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 751110303,
					"content": "#我還要整理店裡的快捷郵件，可以請{F#妳}{M#你}幫我把這封信送回去給夏安卡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110304
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 751110304,
					"content": "她是聖火競技場裡「倦意之屋」的店主，那間店很好找的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米齊卡"
				}
			]
		},
