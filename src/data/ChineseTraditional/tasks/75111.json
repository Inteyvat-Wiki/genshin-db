			"dialogs": [
				{
					"id": 751110101,
					"content": "我之前撿到了這個…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						751110102
					]
				},
				{
					"id": 751110102,
					"content": "啊？難道又是哪個笨蛋弄丟的？快給我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米齊卡"
				}
			]
		},
		{
			"id": 7511102,
			"completionStepIds": [
				7511102
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7511102",
							"2"
						],
						"stepId": 7511102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"米齊卡"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 751110201,
					"content": "這看起來…像是寄給愛雅的快捷郵件。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110202
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 751110202,
					"content": "…外包裝都破了，再寄出去的話，說不定整個快捷郵件都會壞掉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110203
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 751110203,
					"content": "#我還要整理店裡的快捷郵件，可以請{F#妳}{M#你}幫我把這份快捷郵件送給愛雅嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						751110204
					],
					"speakerTitle": "米齊卡"
				},
				{
					"id": 751110204,
					"content": "她是聖火競技場裡「弗里達的色盤」的店主，那間店的招牌很顯眼的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "米齊卡"
				}
			]
		},
		{
			"id": 7511103,
			"completionStepIds": [
				7511103
			],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7511103",
