			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"左右加"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							2206.687,
							230.089,
							-800.541
						],
						"pointId": 8529
					},
					{
						"sceneId": 3,
						"position": [
							2206.934,
							230.089,
							-799.25
						],
						"pointId": 8530
					},
					{
						"sceneId": 3,
						"position": [
							2207.723,
							230.089,
							-799.45
						],
						"pointId": 8531
					}
				]
			},
			"dialogs": [
				{
					"id": 746760101,
					"content": "嗯哼哼，我有一種預感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760102
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760102,
					"content": "我歷經千辛萬苦，來到了兩位傳奇人物故事開始的地方，看在我這麼努力的份上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760103
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760103,
					"content": "#命運也一定會眷顧我！用不了多久，{M#他們}{F#她們}一定會和我再次相遇！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760104
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760104,
					"content": "這個人在嘀咕什麼啊？看她的衣服，好像不是蒙德這裡的人…難道是從稻妻來的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760105,
					"content": "#果不其然，{F#妳}{M#你}們這麼快就出現了。來一個重逢的歡呼吧——「智巧勇武雙連星」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760106,
						746760108
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760106,
					"content": "好久不見，老朋友！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760107
					]
				},
				{
					"id": 746760107,
					"content": "居然是左右加小姐？沒想到能在蒙德遇見妳，真是個超大的驚喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760111,
					"content": "不過，左右加之前不是一直陪海妮耶籌辦之後的賽事嗎？怎麼一個人跑到蒙德來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760112,
					"content": "妳前面還擺了好多好多書，看起來…好像是要推薦小說給路過的人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760113,
					"content": "啊呀，這主要是因為——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760114
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760114,
					"content": "八重堂的編輯們在追殺我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760115
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760115,
					"content": "追殺？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760116,
					"content": "放心放心，不是真的要幹掉我，只是在用一切手段要求我交出稿子而已，編輯們也是為了我著想啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760117
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760117,
					"content": "作為曾經的熱門輕小說作者，我需要不斷產出作品來滿足讀者的需求，才能維持我本人的熱度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760118
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760118,
					"content": "讀者讀書的速度是無限快的，如果我寫得不夠拼命，用不了多久就會被海量新作淹沒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760119
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760119,
					"content": "但我又不願意把蕈獸夥伴們的故事草草寫完，畢竟一部好的小說需要時間來構思，去精雕細琢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760120
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760120,
					"content": "可以的話，我希望能把蕈獸夥伴們的故事整本寫完，反覆修改後再公開，而不是匆忙連載，趕著每一期的截稿日去發表。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760121
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760121,
					"content": "所以我只能新開一部本階段的主力作品，寫個還算簡單好掌握的故事，讓讀者們暫且不要忘了我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760122,
						746760123
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760122,
					"content": "這也太累了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760124
					]
				},
				{
					"id": 746760124,
					"content": "原來還有這種事…我以前都以為輕小說作者很輕鬆耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760125,
					"content": "到處玩一玩、取個材、找找靈感，靈感來了就一鼓作氣寫完稿子，然後咻咻咻賺稿費，快快樂樂過日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760126,
					"content": "妳想的那種只有天才型作者才能做到啦…大部分作者光是構思今天要寫的章節和取材，就已經精疲力竭了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760127
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760127,
					"content": "只要寫的章節夠多都會陷入瓶頸，我也好不到哪裡去，要不然也不會根據一則民間傳說，大老遠跑來蒙德…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760128,
						746760129
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760128,
					"content": "看來這個民間傳說很關鍵囉？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760130
					]
				},
				{
					"id": 746760130,
					"content": "完全正確！而且我要結合圖片和播音機關，打造出一本可以帶來立體閱讀體驗的視覺和聽覺二重奏小說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760131
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760131,
					"content": "這本新概念作品的主題則是「超凡強者的迷宮冒險」——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760132
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760132,
					"content": "擁有絕妙能力的強者誤入邪惡法師構築的迷宮，不斷破除複雜的機關和陷阱，發掘迷宮深處的秘密…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760133
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760133,
					"content": "然後還沒想好要怎麼編。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760134
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760134,
					"content": "喂！我的興趣才剛被妳勾起來耶！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760135
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760135,
					"content": "故事的核心矛盾、敘事節奏之類的問題，我會仔細考慮的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760136
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760136,
					"content": "作為連載作品，最重要的是抓住讀者們的心弦，迷宮中遇見的各種難題才是關鍵要素。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760137
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760137,
					"content": "正巧我打探到一個消息，說是蒙德境內有個遍布奇妙機關的複雜秘境，就第一時間趕過來找，仔細在裡面探查了一番…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760138
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760138,
					"content": "妳做事還是那麼急急忙忙…那妳有在裡面找到迷宮難題的靈感嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760139,
					"content": "靈感是找到了，但還沒有精彩的解法，這樣也沒辦法構成像樣的情節…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760140
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760140,
					"content": "我被普通的陷阱機關揍得鼻青臉腫，海妮耶小姐的衣服都破了，才勉強收集到足夠情報來寫幾個重要段落的腳本。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760141
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760141,
					"content": "歸根究柢，我不是什麼超凡強者，沒有任何奇妙的能力，當然想不出具體的對策。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760142
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760142,
					"content": "#如果換成{F#妳}{M#你}們兩位大名鼎鼎的「智巧勇武雙連星」就完全不成問題了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760143
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760143,
					"content": "雖然不意外，但我們明顯也不會飛天遁地啊…妳怎麼一下就想到我們了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760144,
					"content": "這個嘛…說到取材，就絕對不可能把各種能人志士請過來，而是需要一位熟知各種強者的中間人協助我在秘境中推演。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760145
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760145,
					"content": "#{NICKNAME}是我認識的人裡，見識最多、人脈最廣、提瓦特最受歡迎的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760146
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760146,
					"content": "#順著我提供給{F#妳}{M#你}的腳本，沉浸在文字、映影畫片和想像世界裡，找到最佳狀態以後…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760147
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760147,
					"content": "#{F#妳}{M#你}一定有辦法根據大概會需要的能力，回想起適合的強者，去推測這些強者在險惡迷宮中會採取的對策！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760148,
						746760149
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760148,
					"content": "咦？我嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760150
					]
				},
				{
					"id": 746760150,
					"content": "聽起來滿新奇的！根據小說文字和畫片想像…我們好像也變成作者了，我們以前都沒有做過這種事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760151
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760151,
					"content": "假設我們認識的各種人都來面對遍布機關的秘境，的確有可能發展出許多…普通人想不到的情節？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760152
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760152,
					"content": "沒錯吧？果然很適合！這樣一來，我們就可以一起設計新書了，一定有辦法寫出大賣的輕小說！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760153
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760153,
					"content": "到時候我一定會把你列作聯合作者，稿費我們一起分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760154
					],
					"speakerTitle": "左右加"
				},
				{
					"id": 746760154,
					"content": "不愧是我們的老朋友，這方面完全不吝嗇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760155
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760155,
					"content": "那我們也要拿出幹勁，好好表現一番了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760149,
					"content": "好像是還滿適合的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760150
					]
				},
				{
					"id": 746760129,
					"content": "是不是和桌上的書有關係？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760130
					]
				},
				{
					"id": 746760123,
					"content": "這也沒辦法…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760124
					]
				},
				{
					"id": 746760108,
					"content": "等等，您是哪位？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746760109
					]
				},
				{
					"id": 746760109,
					"content": "等等，妳好像有點眼熟…難道是左右加小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746760110,
					"content": "#{NICKNAME}，{F#妳}{M#你}可能有點不記得了，左右加小姐是我們在蕈獸大賽認識的作家，她一直在幫海妮耶和我們照顧蕈獸夥伴…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746760111
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}