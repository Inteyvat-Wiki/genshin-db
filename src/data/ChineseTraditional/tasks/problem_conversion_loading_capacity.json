			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"拉菲克",
					"綺珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210614,
					"content": "好…嘞！這樣就可以了，讓我們來看看會發生什…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210601
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210601,
					"content": "嗚哇！那邊漏水了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210615
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230210615,
					"content": "什麼？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210602
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210602,
					"content": "船，船都歪了！怎麼回事呀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210603
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 230210603,
					"content": "快，快把東西搬下去，肯定是出問題了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210604
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210604,
					"content": "和拉菲克匆匆忙忙地把所有東西都搬下了船…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						230210605
					]
				},
				{
					"id": 230210605,
					"content": "呼…呼…還好東西不多…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210606
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210606,
					"content": "這到底…到底是哪裡出問題了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210607
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210607,
					"content": "我當初說什麼來著？你計算的那些理論資料都太極限了，這樣是不可靠的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210608
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210608,
					"content": "呼…我…我…好吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210609
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210609,
					"content": "不應該啊，我都算得那麼精確了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210610
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210610,
					"content": "#旅行者，謝謝{F#妳}{M#你}幫忙，這些是報酬，請{F#妳}{M#你}收下吧 。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210611
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210611,
					"content": "我要回去重新計算一遍…綺珊，能再幫我一下嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210612
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210612,
					"content": "…說得好像我都沒幫忙似的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210613
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210613,
					"content": "交給我吧，計算完了之後記得請我喝咖啡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "綺珊"
				}
			]
		},
		{
