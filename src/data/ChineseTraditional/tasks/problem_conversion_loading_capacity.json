			"trigger": {
				"objectNames": [
					"拉菲克",
					"綺珊"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 230210101,
					"content": "#旅行者！{F#妳}{M#你}來得正好，船剛剛下水，十分平穩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210102
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210102,
					"content": "我的計算果然沒有任何問題！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210103
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210103,
					"content": "所以，我們說好的負載試驗什麼時候開始？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210104
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210104,
					"content": "別著急嘛，旅行者都來了，我們馬上開始。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210105
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210105,
					"content": "負載試驗是什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210106
					]
				},
				{
					"id": 230210106,
					"content": "簡單來說，就是用重物來測試船的負載能力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210107
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210107,
					"content": "嗯…也就是說，需要有人和我一起把重物都搬到船上去…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210108
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210108,
					"content": "#旅行者，我上次就發現{F#妳}{M#你}身強體壯、力量充沛，非常擅長這種工作…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210109,
						230210110
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210109,
					"content": "原來這才是讓我來的原因。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				},
				{
					"id": 230210111,
					"content": "#沒、沒有啦，我是真的沒辦法一個人搞定這件事，只能拜託{F#妳}{M#你}來幫忙了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210112
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210112,
					"content": "而且報酬絕對不會少！放心吧，我前幾天剛幫人去修好了一艘大船，拿了不少錢呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210113
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210113,
					"content": "哦…不少錢啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210114
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210114,
					"content": "欸？那個，我幾乎把錢都投入造船裡了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210115
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210115,
					"content": "全部？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210116
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210116,
					"content": "還留著一點！哎呀，我會請妳喝咖啡的啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210117
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210117,
					"content": "旅行者，我們快點開始吧，快快快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210110,
					"content": "生氣。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						230210111
					]
				}
			]
		},
		{
			"id": 2302106,
			"completionStepIds": [
				2302106
			],
			"beginWay": "TALK_BEGIN_MANUAL",
