			},
			"dialogs": [
				{
					"id": 230210801,
					"content": "太棒了，非常成功！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210802
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210802,
					"content": "船體的結構沒有問題…吃水線也很穩定，也沒有傾倒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210803
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210803,
					"content": "綺珊，妳看看，我的設計和計算完美無缺！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210804
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210804,
					"content": "這才是負載試驗的第一階段，別高興太早了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210805
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210805,
					"content": "而且你還沒有考慮到天氣因素和航行時貨物挪移導致的船體重心問題…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210806
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210806,
					"content": "呃…呃，我會考慮的，妳就先讓我高興一下嘛…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210807
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210807,
					"content": "#對了旅行者，這是{F#妳}{M#你}的報酬，請先收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210808
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210808,
					"content": "綺珊啊，妳就不能給我打打氣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210809
					],
					"speakerTitle": "拉菲克"
				},
				{
					"id": 230210809,
					"content": "可是在造船這件事上，給人加油打氣沒用啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						230210810
					],
					"speakerTitle": "綺珊"
				},
				{
					"id": 230210810,
					"content": "你還是好好想想，怎麼給自己的錢包加油打氣吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "綺珊"
				}
			]
		},
