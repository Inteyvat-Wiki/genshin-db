	"talks": [
		{
			"id": 4003101,
			"completionStepIds": [
				4003101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003101",
							"2"
						],
						"stepId": 4003101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"凱瑟琳"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310101,
					"content": "#旅行者，{F#妳}{M#你}來得正好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310102
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 400310102,
					"content": "這個熟悉的開頭…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310103,
						400310104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310103,
					"content": "下一句肯定是…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				},
				{
					"id": 400310105,
					"content": "#不愧是熟練的冒險家呢。如{F#妳}{M#你}所說，有適合{F#妳}{M#你}的委託。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310106
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 400310106,
					"content": "#萬端珊瑚偵探社那邊需要人手，指明希望{F#妳}{M#你}能幫忙調查「小動物大量失蹤奇案」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310107
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 400310107,
					"content": "欸？只是找小動物嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310108,
					"content": "#哼哼，這麼簡單的事情，還需要{NICKNAME}出馬嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310109,
						400310110,
						400310111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310109,
					"content": "沒關係，我也送過外賣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310113,
					"content": "而且，「萬端珊瑚」不應該是解決案件的偵探社嗎？怎麼反而委託冒險家了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310114,
					"content": "是這樣的，珊瑚小姐需要一名經驗豐富的冒險家，與龍二先生一同外出行動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310115
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 400310115,
					"content": "另外，我看看…珊瑚小姐拜託我這麼說：",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310116
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 400310116,
					"content": "「有很多人的寵物都在這次事件中失蹤了，所以敝社一口氣接到了很多委託。如果能解決，能收到非常豐厚的報酬。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310117
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 400310117,
					"content": "#非常豐厚…！嗯嗯，這樣啊，{NICKNAME}，我覺得…不能回到主人身邊的小動物很可憐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310118
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310118,
					"content": "而且委託無論大小，都是能讓人成長進步的好事，對吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310119
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310119,
					"content": "派蒙真好懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310120
					]
				},
				{
					"id": 400310120,
					"content": "總之，我們去找珊瑚他們吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310110,
					"content": "沒關係，我也修過車…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310113
					]
				},
				{
					"id": 400310111,
					"content": "沒關係，我也擊敗過風魔龍…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310112
					]
				},
				{
					"id": 400310112,
					"content": "#擊敗風魔龍算是「簡單的事情」嗎…？真不愧是{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310113
					],
					"speakerTitle": "凱瑟琳"
				},
				{
					"id": 400310104,
					"content": "有新的委託喔？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310105
					]
				}
			]
		},
		{
			"id": 4003102,
			"completionStepIds": [
				4003102
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4003102",
							"2"
						],
						"stepId": 4003102,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚",
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400310202,
					"content": "#不錯，{F#妳}{M#你}們來得比我預想中還要快。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310203
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310203,
					"content": "那是當然！我們一聽到有豐厚的報…報告小動物失蹤的案件，就馬上趕來了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310204,
					"content": "#說吧，怎麼回事？只要有我和{NICKNAME}在，不管是什麼難題，都會順利解決的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310205,
					"content": "工作的可是我…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310206
					]
				},
				{
					"id": 400310206,
					"content": "#派蒙也會努力幫{F#妳}{M#你}加油的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310207,
					"content": "很有精神。那麼，事情是這樣的。最近突然出現了許多委託，請我們尋找走失的小動物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310208
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310208,
					"content": "這些小動物大多是一些家養的寵物，原本不會自己亂跑才對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310209
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310209,
					"content": "雖然稻妻確實有一些怪力亂神的故事，但萬事皆有其因果，不存在邏輯無法解開的謎團。這幾天我們的現場調查也證明了這一點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310210
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310210,
					"content": "工作的可是我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310211
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310211,
					"content": "派蒙也會努力幫你加油的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310212
					]
				},
				{
					"id": 400310212,
					"content": "欸？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310213,
					"content": "…謝謝，不必了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310214
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310214,
					"content": "這幾天，我循著動物失蹤的痕跡，找到了幾個野外的營地。有一些是由魔物駐守的，倒沒有太大問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310215
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310215,
					"content": "但是，在其中一個營地裡，想要放走被困的小動物時…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310216
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310216,
					"content": "…但卻「被一團突然出現的黑影給解決了」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310217
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310217,
					"content": "等我醒來時，營地裡已經什麼都沒有了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310218
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310218,
					"content": "真是難看哪，龍二喲。在「三本刀金八」事件中，你像傳說中的惡鬼虎千代一樣，咆哮著打倒犯人的氣勢到哪去了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310219
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310219,
					"content": "還抱著裝死的我，大喊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310220
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310220,
					"content": "社長，停一停！停！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310221
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310221,
					"content": "後、後來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310222,
						400310223
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310222,
					"content": "先解決手頭的事件吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310227
					]
				},
				{
					"id": 400310227,
					"content": "#總之，我們「萬端珊瑚」需要{F#妳}{M#你}們這樣經驗老到的冒險家，一起去拯救小動物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310228
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310228,
					"content": "#有{F#妳}{M#你}們在的話，就算龍二被打暈，多少也有個照應呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310229
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310229,
					"content": "那珊瑚妳自己為什麼不去試試看呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310230
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310230,
					"content": "我嗎？我是頭腦派，最重要的是動腦子。對我來說，身體只是一個附件而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310231
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310231,
					"content": "（嗚哇，她懶得好理直氣壯。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310232
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310232,
					"content": "當然也不會讓你們白打工的，說好的報酬是不會少的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310233
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310233,
					"content": "報酬！！那我們現在就出發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310234,
						400310235
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310234,
					"content": "這個派蒙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310236,
					"content": "等等。走之前，帶上這個吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310237
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310237,
					"content": "咦？這是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310238
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310238,
					"content": "<color=#00E1FFFF>「四方之網」</color>，是我請友人依照書中記載的「惟神陰陽術」製作的方便道具。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310239
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310239,
					"content": "雖然力量不足以降伏罪犯，但只要瞄得準，小動物還是可以輕鬆捕獲的，大概。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310240
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310240,
					"content": "有了這個，應該就能輕鬆把失蹤的小動物帶回來了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310241
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310241,
					"content": "哇，那有了這個就輕鬆多了！珊瑚社長人真好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310242,
					"content": "#不用那麼誇我，我只是不希望看到{F#妳}{M#你}們搞砸罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310243
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310243,
					"content": "#還有龍二，你也跟著{F#她}{M#他}們跑一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310244
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310244,
					"content": "好的，珊瑚社長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310245
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310245,
					"content": "這幾天我又發現了失蹤動物的痕跡。隨我來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310246,
						400310247
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310246,
					"content": "那就出發了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310248,
					"content": "嗯。慢走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310247,
					"content": "謝謝珊瑚社長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310248
					]
				},
				{
					"id": 400310235,
					"content": "派蒙的行動力真強。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310236
					]
				},
				{
					"id": 400310223,
					"content": "後來呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310224
					]
				},
				{
					"id": 400310224,
					"content": "哎呀，對我們解決的事件有興趣嗎？當時，事情是這樣的。平時和藹的捕快金八，他…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310225
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 400310225,
					"content": "先、先解決手頭的事件吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310226
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310226,
					"content": "也對。不好意思呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310227
					],
					"speakerTitle": "珊瑚"
				}
			]
		},
