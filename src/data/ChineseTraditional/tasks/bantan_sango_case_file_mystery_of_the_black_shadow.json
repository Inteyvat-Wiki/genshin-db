			"dialogs": [
				{
					"id": 400310301,
					"content": "根據目前的調查，就是這裡了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310302
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310302,
					"content": "哦——確實有很多小動物在這裡呢！牠們都是走丟的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310303,
					"content": "不過這是…狗狗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310304,
					"content": "守在這裡的居然是狗狗？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310305,
					"content": "原來是這樣啊。這可真是難堪哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310306
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310306,
					"content": "欸？龍二怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310307,
					"content": "…當時，一瞬就把我解決的「黑影」，就是牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310308,
						400310310
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310308,
					"content": "對方好強大。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310309
					]
				},
				{
					"id": 400310309,
					"content": "不不不，不必安慰我…是我龍二實力太弱了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310312,
					"content": "不管怎麼說，看那挺拔的姿勢，目中無人的傲氣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310313,
					"content": "嗯…這個模樣，是讓人聯想到…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310314,
						400310315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310314,
					"content": "木漏茶室的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310316,
					"content": "沒錯！我也想到了牠，一開始我們還以為牠真的會說話呢！牠不會說話真是遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310317,
					"content": "是那位木漏茶室的老闆嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310318
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310318,
					"content": "咦，龍二知道嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310319,
					"content": "略有耳聞罷了。確實有點像，但是不能掉以輕心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310320
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310320,
					"content": "畢竟，太郎丸和人類社會有很多接觸，對大家也很友好。而這隻狗狗，我們並不知道對方的底細，還是小心為上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310321
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310321,
					"content": "哦——龍二說得很有道理呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310322,
					"content": "不過是查案跑腿跑出來的經驗罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310323
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310323,
					"content": "但是真想不通…為什麼狗狗會把小動物給收集起來，還要守在這裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400310324,
					"content": "這個可能需要更多的線索了。目前當務之急還是先救出小動物們吧，牠們的主人已經十分焦急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310325
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310325,
					"content": "#{NICKNAME}，接下來就拜託{F#妳}{M#你}了。找到小動物之後的事情，交給我就行。我會盡快把牠們送回家去的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310326
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310326,
					"content": "不一起上嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310327
					]
				},
				{
					"id": 400310327,
					"content": "那可不是一起上就能應付的對手。對方的實力難以預測。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310328
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310328,
					"content": "#這麼說來，{F#妳}{M#你}有「潛行」的經驗嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310329,
						400310330,
						400310331
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310329,
					"content": "有嘗試偷過「天空之琴」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310332,
					"content": "…真是不可思議的經歷呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310333
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310333,
					"content": "無論如何，如果能安全地避開牠，就能順利把裡面的小動物救出來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310334
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310334,
					"content": "#我事先佈置了一些能吸引牠注意力的東西。希望能幫上{F#妳}{M#你}的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310335
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310335,
					"content": "#那麼，交給{F#妳}{M#你}了。我在原地把風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 400310330,
					"content": "在請仙儀式上逃脫過追捕…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310331,
					"content": "在離島跟蹤過瀆職官僚…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310332
					]
				},
				{
					"id": 400310315,
					"content": "太郎丸。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310316
					]
				},
				{
					"id": 400310310,
					"content": "龍二好弱喔。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400310311
					]
				},
				{
					"id": 400310311,
					"content": "喂！應該是對方太強了吧。派蒙一定也打不過牠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400310312
					],
					"speakerTitle": "派蒙"
				}
			]
