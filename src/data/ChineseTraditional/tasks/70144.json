			},
			"dialogs": [
				{
					"id": 701440101,
					"content": "關於那股寒流…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440102
					]
				},
				{
					"id": 701440102,
					"content": "怎麼樣，調查出什麼結果了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440103
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440103,
					"content": "有這些發現。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440104
					]
				},
				{
					"id": 701440104,
					"content": "這種東西是什麼時候出現在雪山裡的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440105
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440105,
					"content": "#謝謝{F#妳}{M#你}幫忙調查，我會向協會報告這件事的，這些報酬給{F#妳}{M#你}，辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				}
			]
		},
		{
			"id": 7014402,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_NONE",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"99902",
							"3"
						],
						"stepId": 99902,
						"stateName": "QUEST_STATE_FINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"玉霞"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 701440201,
					"content": "有什麼委託嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440202
					]
				},
				{
					"id": 701440202,
					"content": "#委託？唔，{F#妳}{M#你}來得正好，我正好想要找一位經驗豐富的冒險家，幫我去調查一股奇怪的寒流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440203
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440203,
					"content": "寒流？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440204
					]
				},
				{
					"id": 701440204,
					"content": "是這樣的。之前有一支小隊進山考察，有幾位經驗豐富的冒險家同行。走的路線也是最安全的，繞開了一切危險的區域。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440205
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440205,
					"content": "但是，不知道發生了什麼，他們在考察的途中突然遭到了一陣猛烈的寒流，被迫撤回了營地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440206
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440206,
					"content": "據回來的冒險家說，他們走的那條路根本不可能出現那種強度的寒流，而且，那股寒流來得毫無徵兆，感覺根本不像什麼自然現象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440207
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440207,
					"content": "之後，又有好幾個在山裡考察或者勘探的人報告了這種情況，在組織了幾次調查行動後，我們總算確定了那股寒流的來源。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440208
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440208,
					"content": "但是，在那麼多次調查後，調查隊裡的冒險家們不是凍傷，就是脫力，必須在營地裡休息，我們暫時也抽調不出能繼續深入調查的人手…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440209
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440209,
					"content": "#旅行者，如果{F#妳}{M#你}願意幫忙的話，可以代我們去那股嚴寒的源頭看一看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440210,
						701440212
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440210,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440211
					]
				},
				{
					"id": 701440211,
					"content": "#那就拜託{F#妳}{M#你}了，那股嚴寒十分詭異，請一定要做好準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440215,
					"content": "#那麼，就請{F#妳}{M#你}快去那裡調查一下吧，拜託{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440212,
					"content": "關於報酬…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						701440213
					]
				},
				{
					"id": 701440213,
					"content": "#喔？{F#妳}{M#你}倒是很直接嘛。放心吧，協會可不會虧待冒險家，我會準備好報酬，在營地等著{F#妳}{M#你}的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440214
					],
					"speakerTitle": "玉霞"
				},
				{
					"id": 701440214,
					"content": "#至於具體的數目…那就要視{F#妳}{M#你}帶回來的調查結果而定了，規矩{F#妳}{M#你}懂的，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						701440215
					],
					"speakerTitle": "玉霞"
				}
			]
		},
