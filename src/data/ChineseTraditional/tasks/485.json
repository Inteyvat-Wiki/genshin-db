					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850301,
					"content": "前面看起來沒路走了…那傢夥到底會躲在哪呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850302
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850302,
					"content": "安柏，看對面！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850303,
					"content": "你果然還是追上來了，沒辦法…咦？怎麼是個小姑娘…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850304
					],
					"speakerTitle": "「怪鳥」"
				},
				{
					"id": 4850304,
					"content": "你就是「怪鳥」吧！現在你已經逃不掉了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850305
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850305,
					"content": "哈哈哈，我也不用逃，因為妳壓根過不來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850306
					],
					"speakerTitle": "「怪鳥」"
				},
				{
					"id": 4850306,
					"content": "唔——這斷崖，確實很高…也很遠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850307
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850307,
					"content": "小姑娘，不如妳現在回去，把團長叫來，說不定我就會馬上投降呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850308
					],
					"speakerTitle": "「怪鳥」"
				},
				{
					"id": 4850308,
					"content": "你這是在挑釁西風騎士團的偵察騎士嗎？看我現在就飛過去抓住你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850309,
						4850310
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850309,
					"content": "先冷靜一下。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				},
				{
					"id": 4850311,
					"content": "#唔…{F#妳}{M#你}說得對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850312
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850312,
					"content": "可惡，明明就在對面了，要是可以直接飛過去就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850313
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850313,
					"content": "但這個怪鳥是怎麼過去的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850314,
						4850317,
						4850319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850314,
					"content": "難道有可以來回的機關？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850315
					]
				},
				{
					"id": 4850315,
					"content": "以我的眼力，也看不出這種機關的痕跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850316
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850316,
					"content": "而且周圍也沒有能建機關的岩壁。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850322,
					"content": "再見了，小姑娘——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850323
					],
					"speakerTitle": "「怪鳥」"
				},
				{
					"id": 4850323,
					"content": "呀，這傢伙要逃了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850324,
					"content": "不能再猶豫下去了，除了「飛行」以外，沒有第二種越過斷崖的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850325
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850325,
					"content": "但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850326
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850326,
					"content": "別擔心，我可是蒙德城的飛行冠軍，如果怪鳥可以飛過去，我也肯定可以做到！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850327
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850327,
					"content": "喂，偵察騎士，想要送死的話，不帶風之翼從蒙德城的風神像上跳下去才更適合妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850328,
						4850329
					],
					"speakerTitle": "「怪鳥」"
				},
				{
					"id": 4850328,
					"content": "我明白安柏的意思了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850330,
					"content": "#說得沒錯…除了「飛行」以外的答案，{NICKNAME}也認為都已經排除了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850331,
					"content": "#{NICKNAME}，還記得我拿錯的那本…不是指南的指南嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850332
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850332,
					"content": "「最初的鳥兒是不會飛翔的，飛翔是牠們勇敢躍入峽谷的獎勵」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850333
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850333,
					"content": "#接下來，請{F#妳}{M#你}見證我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850334
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850334,
					"content": "加油！偵察騎士！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850335
					]
				},
				{
					"id": 4850335,
					"content": "收到！就讓那傢伙見識一下偵察騎士的勇氣吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850336
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850336,
					"content": "別，別開玩笑了，這裡是飛不過來的！快點乖乖回去吧，小姑娘！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850337
					],
					"speakerTitle": "「怪鳥」"
				},
				{
					"id": 4850337,
					"content": "怪鳥，你是這麼覺得的嗎？可是你仔細聽聽，周圍微小的聲音…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850338
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850338,
					"content": "風說——可以飛了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850329,
					"content": "雖然需要勇氣，但這不是自殺。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850330
					]
				},
				{
					"id": 4850317,
					"content": "活用了某種元素魔法？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850318
					]
				},
				{
					"id": 4850318,
					"content": "#在{NICKNAME}的元素視野裡有痕跡嗎？…唔，果然也沒有？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850319,
					"content": "用了抓鉤或者刺釘之類的？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850320
					]
				},
				{
					"id": 4850320,
					"content": "連飛都飛不過去，這種東西也不可能丟過去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850321,
					"content": "地面上也沒有釘樁的痕跡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850322
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850310,
					"content": "觀察一下周圍…這是妳教我的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850311
					]
				}
			]
		},
		{
			"id": 48506,
			"completionStepIds": [
				48506
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"48506",
							"2"
						],
						"stepId": 48506,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 4850601,
					"content": "成功抓住怪鳥了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850602
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850602,
					"content": "其實，只有在空中才能發現，那就是唯一的風場。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850603
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850603,
					"content": "怪鳥所要逃跑的方向，盡頭根本是徹徹底底的死路。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850604
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850604,
					"content": "換句話說，如果怪鳥想要逃出去，就必須從我們這邊經過才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850605
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850605,
					"content": "喔——所以他才一直這麼裝模作樣，原來是想騙我們放棄，然後自己再飛回來逃走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850606
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850606,
					"content": "不過，我們這邊也不是那麼好騙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850607,
					"content": "#幸虧有{NICKNAME}的分析，這就是所謂的「排除所有錯誤答案以後，剩下的那個，無論多反常都是正確的」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850608
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850608,
					"content": "總之，想要掌握飛行這種事情，七分靠技術，三分靠直覺，剩下的九十分全都是靠勇氣來補足啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850609
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850609,
					"content": "我看妳剛才是九十九分都是勇氣了吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850610
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850610,
					"content": "哎呀，這就和我第一次考飛行執照的時候一樣吧…雖然很緊張，但還是有驚無險地把執照考到手了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850611
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850611,
					"content": "可惜之後的幾次考試我都再沒有這種緊張感了，總覺得少了點什麼呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850612
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850612,
					"content": "妳…等一下，飛行執照都考到手了，之後的考試是考什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850613
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850613,
					"content": "這個啊…因為蒙德城裡這裡不准飛那裡也不准飛，這裡不准降落那裡也不准降落…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850614
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850614,
					"content": "我考到手的飛行執照總是被吊銷，前前後後重新考過十五次飛行執照吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850615
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850615,
					"content": "但是每次補考我可都是一次考過，果然我的那本指南才是最棒的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850616
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850616,
					"content": "#…{NICKNAME}，之後有空的話，我們去琴團長那裡拿一份正經的飛行指南吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850617,
						4850618
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 4850617,
					"content": "好的…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				},
				{
					"id": 4850619,
					"content": "總之，我還要把怪鳥押回蒙德城，就先走一步了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						4850620
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850620,
					"content": "#{F#妳}{M#你}回蒙德城之後，記得來大教堂找我，飛行執照還要在那裡頒發給{F#妳}{M#你}呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 4850618,
					"content": "琴團長真是辛苦了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						4850619
					]
				}
			]
		},
