			},
			"dialogs": [
				{
					"id": 206030501,
					"content": "你們這麼快就回來了，看來確實沒什麼大事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030502
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206030502,
					"content": "還有不少魔物在活躍。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						206030503
					]
				},
				{
					"id": 206030503,
					"content": "什麼？還有魔物在遊蕩，數量比原來的還多了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030504
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206030504,
					"content": "奇怪，先前來攻擊蒙德城的大部隊都已經被擊退了，為什麼它們還在蒙德城附近遊蕩？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030505
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206030505,
					"content": "難道它們還有什麼計畫…不行，我得把冒險家們都召集回來，重新發佈委託，不能對這些魔物掉以輕心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030506
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206030506,
					"content": "對野外遊蕩的魔物進行秘密調查，這可是冒險家協會的專業範圍…是時候展現冒險家協會的力量了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						206030507
					],
					"speakerTitle": "賽琉斯"
				},
				{
					"id": 206030507,
					"content": "#對了，這是給{F#妳}{M#你}的謝禮，收下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "賽琉斯"
				}
			]
		}
	]
