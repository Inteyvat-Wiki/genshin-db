				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331201,
					"content": "#嗯？{F#妳}{M#你}們有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331202
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331202,
					"content": "關於清晝和梵米爾的比試…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331203
					]
				},
				{
					"id": 710331203,
					"content": "#{F#妳}{M#你}說那兩位啊，沒事，沒事，他們願意陪孩子們玩就最好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331204
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331204,
					"content": "這大過節的，還是要熱熱鬧鬧的才好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331205
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331205,
					"content": "#倒是{F#妳}{M#你}，孩子，一直為我們這輕策莊東奔西跑的，辛苦{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331206,
						710331207
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331206,
					"content": "沒關係的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				},
				{
					"id": 710331208,
					"content": "#{F#妳}{M#你}這孩子倒是熱心…這些東西請{F#妳}{M#你}收下吧，謝謝{F#妳}{M#你}啦，{F#妳}{M#你}也要過個好節啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331209
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710331209,
					"content": "希望之後的海燈節，這裡也能這麼熱鬧啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "若心"
				},
				{
					"id": 710331207,
					"content": "您客氣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331208
					]
				}
			]
		},
		{
