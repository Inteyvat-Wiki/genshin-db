					"清晝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331401,
					"content": "孩子們，看這霄燈，這是射一這海燈節裡的「事物」，你們猜一猜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331402
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331402,
					"content": "#我要和這位{F#大姐姐}{M#大哥哥}去辦件事，辦完了再回來陪你們接著玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331403
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331403,
					"content": "咦，清晝叔叔，你要去辦什麼事呀？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331404
					],
					"speakerTitle": "小六"
				},
				{
					"id": 710331404,
					"content": "我和一位畫家定下了個…比試，要寫一首最好的詩，和他畫的畫做比試，看看誰最好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331405
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331405,
					"content": "哎呀，那肯定是清晝叔叔贏啦，那麼多燈謎，哪一首都是很好很好的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331406
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331406,
					"content": "是嗎，謝謝你們的誇獎。你們先拿著這盞霄燈回輕策莊去慢慢猜吧，野外可不太安全。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331407
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331407,
					"content": "放心吧叔叔，這裡我們可熟了，我們自己就能回去，你快去把那個畫家打敗吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331408
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331408,
					"content": "那…叔叔，你和那個畫家比試完了之後，要快點過來呀。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331409
					],
					"speakerTitle": "阿佑"
				},
				{
					"id": 710331409,
					"content": "那是當然，等事情結束了，我就去找你們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331410,
						710331411
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331410,
					"content": "這確實是一首好詩。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331411
					]
				},
				{
					"id": 710331411,
					"content": "這首詩是可以贏的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331412
					]
				},
				{
					"id": 710331412,
					"content": "呵呵，什麼詩，這只是一首燈謎而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331413
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331413,
					"content": "好了，我們去找那個畫家吧，他肯定等急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				}
			]
