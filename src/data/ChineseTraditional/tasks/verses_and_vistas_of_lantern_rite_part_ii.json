			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梵米爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330101,
					"content": "旅行者，旅行者，這裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330102
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330102,
					"content": "你是上次和清晝定了約定的畫家…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330103
					]
				},
				{
					"id": 710330103,
					"content": "就是我，我和那個詩人約定好，要各自創作一份藝術品概括海燈節。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330104
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330104,
					"content": "#{F#妳}{M#你}上次還幫我去拿了材料呢，{F#妳}{M#你}應該還記得吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330105,
						710330106
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330105,
					"content": "還記得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				},
				{
					"id": 710330107,
					"content": "我的畫…咳，這個嘛…我其實已經畫了很多了，場景、人物，甚至是動物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330108
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330108,
					"content": "我有自信這些畫都精確表達了應該表達的內容，但是…這些畫裡沒有一幅能稱得上可以概括海燈節的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330109
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330109,
					"content": "唉，我這幾天吃不下睡不著，畫材也都要用完了，還是沒有畫出那幅畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330110
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330110,
					"content": "所以，我就想去找找那詩人，看看他的詩寫得怎麼樣了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330111
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330111,
					"content": "#旅行者，{F#妳}{M#你}知道那個詩人去哪了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330112
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330112,
					"content": "他去輕策莊了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330113
					]
				},
				{
					"id": 710330113,
					"content": "輕策莊？他去那幹嘛…難道，是他找到取材點了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330114
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330114,
					"content": "快，旅行者，我們快去輕策莊找他去！要是那個地方合適，說不定我也能找到點靈感…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330115
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330115,
					"content": "咳！總之，我們快出發吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330106,
					"content": "那你的畫…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330107
					]
				}
			]
		},
		{
			"id": 7103303,
			"completionStepIds": [
				7103303
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103303",
							"2"
						],
						"stepId": 7103303,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梵米爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330301,
					"content": "這就是輕策莊了吧…那個詩人呢？跑去哪取材了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330302
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330302,
					"content": "上次他正在和孩子們玩猜燈謎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330303
					]
				},
				{
					"id": 710330303,
					"content": "猜、猜燈謎？這都什麼…事情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330304
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330304,
					"content": "他是不是因為找不到靈感，準備自己認輸了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330305
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330305,
					"content": "算了，不管他是在幹什麼，這海燈節眼看著沒剩幾天了，可不能再拖下去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330306
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330306,
					"content": "我們去找這裡管事的問問吧，今天我非要和他分出個高下來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米爾"
				}
			]
		},
		{
			"id": 7103304,
			"completionStepIds": [
				7103304
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103304",
							"2"
						],
						"stepId": 7103304,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"若心"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330401,
					"content": "#哎呀，{F#妳}{M#你}好啊旅行者，多謝{F#妳}{M#你}，現在這輕策莊裡總算有了些過節的氛圍啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330402
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330402,
					"content": "#咦？{F#妳}{M#你}身邊的這位我沒見過，請問是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330403
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330403,
					"content": "這是位畫家，來找清晝的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330404
					]
				},
				{
					"id": 710330404,
					"content": "來找清晝先生的？唔，那正好…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330405
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330405,
					"content": "望雅小姐前幾天離開的時候，清晝先生說還要在這裡待一段時間。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330406
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330406,
					"content": "他現在應該還在和孩子們玩猜燈謎呢，我想想，他帶著孩子們去外面了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330407
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330407,
					"content": "要是想要找他的話，大概得去外面找找了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330408
					],
					"speakerTitle": "若心"
				},
				{
					"id": 710330408,
					"content": "#他還真的在玩燈謎…旅行者，那就麻煩{F#妳}{M#你}幫我跑一趟吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330409
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330409,
					"content": "#{F#妳}{M#你}去告訴那個詩人我過來了，我在這裡再準備準備。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330410
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710330410,
					"content": "無論如何，今天一定要和他分出個勝負…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梵米爾"
				}
			]
		},
		{
			"id": 7103305,
			"completionStepIds": [
				7103305
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103305",
							"2"
						],
						"stepId": 7103305,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"清晝"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710330501,
					"content": "#哈哈哈，{F#妳}{M#你}們也逐漸摸到竅門了，猜得越來越快了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330502,
						710330503
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710330502,
					"content": "梵米爾來了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				},
				{
					"id": 710330504,
					"content": "梵米爾…啊，那個畫家，我算算日子，也確實該是履行約定的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330505
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710330505,
					"content": "可惜了，我的詩最後還是沒有寫好，這群孩子們的燈謎也還沒玩盡興…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330506
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710330506,
					"content": "#呵呵，也許真是我詩材有限吧…這樣，{F#妳}{M#你}再陪我去找找靈感吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330507
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710330507,
					"content": "嗯…也不能說是找靈感，再陪我去散散步吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330508
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710330508,
					"content": "清晝叔叔！不猜燈謎了嗎？？我還想猜猜看…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330509
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710330509,
					"content": "我也想猜燈謎，清晝叔叔…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330510
					],
					"speakerTitle": "小六"
				},
				{
					"id": 710330510,
					"content": "唔，我也想再猜幾個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330511
					],
					"speakerTitle": "阿佑"
				},
				{
					"id": 710330511,
					"content": "#哈哈哈，莫急，等我和這位{F#大姐姐}{M#大哥哥}去旁邊轉一圈，回來就有新燈謎了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330512
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710330512,
					"content": "#{F#妳}{M#你}們先回輕策莊裡去吧，到時候我再找{F#妳}{M#你}們，這樣可好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330513
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710330513,
					"content": "好哎！清晝叔叔真厲害，能想出這麼多燈謎！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330514
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710330514,
					"content": "清晝叔叔肯定讀了好多好多書吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330515
					],
					"speakerTitle": "小六"
				},
				{
					"id": 710330515,
					"content": "我要是以後也能像清晝叔叔這麼厲害就好了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330516
					],
					"speakerTitle": "阿佑"
				},
				{
					"id": 710330516,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710330517
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710330517,
					"content": "旅行者，我們快出發吧，快把那些瑣事解決了，別讓這群孩子們等急了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				},
				{
					"id": 710330503,
					"content": "你還記得和梵米爾的約定嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710330504
					]
				}
			]
		},
