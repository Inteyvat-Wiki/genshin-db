				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331001,
					"content": "清晝叔叔回來啦！清晝叔叔，你寫好新的燈謎了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331002
					],
					"speakerTitle": "小六"
				},
				{
					"id": 710331002,
					"content": "這次我大概…肯定能猜對！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331003
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331003,
					"content": "我這次要好好想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331004
					],
					"speakerTitle": "阿佑"
				},
				{
					"id": 710331004,
					"content": "哈哈哈，我已經把這次的燈謎寫好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331005
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331005,
					"content": "旅行者，請幫我個忙吧，把這霄燈掛起來，掛高點。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				}
			]
		},
		{
			"id": 7103311,
			"completionStepIds": [
				7103311
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7103311",
							"2"
						],
						"stepId": 7103311,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梵米爾"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 710331101,
					"content": "你總算是來了，你做好詩了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331102
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331102,
					"content": "我沒有寫出一首合適的詩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331103
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331103,
					"content": "你、你也…咳，你怎麼沒寫出來？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331104
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331104,
					"content": "璃月大地，萬家霄燈，我想來想去，都沒能用一首詩概括，你畫好了畫嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331105
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331105,
					"content": "我…我也沒有…璃月那麼大！怎麼畫得下，我要是想畫下來，就得用天來做畫紙…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331106
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331106,
					"content": "如此說來，我們兩個倒是都沒有創作出能概括璃月港和海燈節的詩和畫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331107
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331107,
					"content": "那麼，就該算是「平手」了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331108
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331108,
					"content": "嗯…好吧，那就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331109
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331109,
					"content": "清晝叔叔！清晝叔叔！你給我們出的燈謎，我們猜出來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331110
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331110,
					"content": "燈、燈謎？什麼燈謎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331111
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331111,
					"content": "不須在意，是我陪著這群孩子們玩，給他們出的燈謎。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331112
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331112,
					"content": "噢？是什麼燈謎，能說給我聽聽嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331113
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331113,
					"content": "「萬千扁舟拂波去，燭映孤雲峭岩間。身負流光浮滄海，終與龍宮彩魚眠。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331114
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331114,
					"content": "這是你給這群孩子們寫的燈謎？這…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331115
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331115,
					"content": "清晝叔叔，這個叔叔又是誰啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331116,
						710331117
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331116,
					"content": "他就是那位畫家。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				},
				{
					"id": 710331118,
					"content": "你這詩人，要真不想與我比試，那和我約定個什麼勁？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331119
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331119,
					"content": "你誤會了，我最開始確實抱著和你…一決勝負的心思，四處取材，殫精竭力…想要寫出一首好詩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331120
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331120,
					"content": "但你應該也感到了吧，只憑隻言片語，是無法概括璃月港和海燈節的。所以…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331121
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331121,
					"content": "所以，你就跑到這裡來陪孩子們玩？給他們出燈謎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331122
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331122,
					"content": "正是這樣，所以我來這裡陪孩子們，給他們出燈謎，想再找到寫那首詩的靈感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331123
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331123,
					"content": "呵呵，但是靈感沒找到，燈謎倒是出了不少，孩子們也很開心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331124
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331124,
					"content": "或許…這就是我在找的那首「詩」了。可惜，我沒辦法把它寫下來，也無法和你分出勝負來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331125
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331125,
					"content": "你…你們璃月人，真是奇怪！那你我之間的比試，到底怎麼算？誰輸誰贏？我可不接受平局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331126
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331126,
					"content": "這個叔叔怎麼這麼囉嗦…肯定是清晝叔叔贏啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331127
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331127,
					"content": "他可厲害了，出了好多好多燈謎，你肯定都猜不到謎底！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331128
					],
					"speakerTitle": "阿佐"
				},
				{
					"id": 710331128,
					"content": "你這詩人…嗯？等等，我有個主意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331129
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331129,
					"content": "那，這樣！你我之間，重新比過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331130
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331130,
					"content": "哦？那你想要怎麼重新比過？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331131
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331131,
					"content": "你不是給這群孩子們出燈謎嗎？我在取材的時候，也看到了許多霄燈的紋樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331132
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331132,
					"content": "我們倆，一個出燈謎，一個畫霄燈，讓這群孩子們當評審，看他們更喜歡誰，你看怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331133
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331133,
					"content": "好！正合我意，也合了這海燈節之意，如此再好不過了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331134
					],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331134,
					"content": "那就這樣，等我收拾收拾畫具，我們就在這裡，重新比過！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331135,
						710331136
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331135,
					"content": "你們兩個竟然這麼興致勃勃…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331137,
					"content": "來，孩子們，把這個詩人寫的燈謎給我看看，我幫你們畫個漂漂亮亮的霄燈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						710331138
					],
					"speakerTitle": "梵米爾"
				},
				{
					"id": 710331138,
					"content": "呵呵，只怕你畫霄燈的速度，跟不上我出燈謎的速度。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "清晝"
				},
				{
					"id": 710331136,
					"content": "你們兩個繼續加油…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331137
					]
				},
				{
					"id": 710331117,
					"content": "想和清晝比試的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						710331118
					]
				}
			]
		},
		{
			"id": 7103312,
			"completionStepIds": [
				7103312
			],
