	"talks": [
		{
			"id": 7469201,
			"completionStepIds": [
				7469201
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7469201",
							"2"
						],
						"stepId": 7469201,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"芭比洛斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 746920101,
					"content": "…也就是說，妳也不能幫我解決這個麻煩的體質？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920102
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920102,
					"content": "是的，這份擾動已經和妳的命運牽連太深。打比方的話，它就像是從妳的命運之樹上生出的新芽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920103
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920103,
					"content": "它一直幫助著妳吸收陽光雨露，也早已開始協助「塑造」妳的命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920104
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920104,
					"content": "如果貿然把它剪除，留下的傷口說不定會被什麼髒東西侵入，從而讓整棵樹都生病呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920105
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920105,
					"content": "呿…說得好像這個體質是什麼好東西似的。明明就是它妨礙我，讓我始終調不出想要的酒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920106
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920106,
					"content": "比起幼苗，我覺得它反而像是那種纏繞在大樹上，從一開始就打算勒死大樹的藤蔓勒！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920107
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920107,
					"content": "唔，如果是那樣的話，只要順著命運的排斥反應，就可以輕鬆剪除掉了…但很可惜，它並不是這種東西啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920108
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920108,
					"content": "好了，閒話就說到這裡。現在妳應該相信我是一個正派占卜師了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920109
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920109,
					"content": "喏，就和之前說的一樣，過來隨便抽一張牌吧——讓我對妳的未來做一些小建議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920110
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920110,
					"content": "唔…呃，那就隨便抽一張？這一張…不對不對，這一張…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920111
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920111,
					"content": "安心吧，無論妳怎麼選，都只能抽到命中註定的那一張，呵呵呵呵呵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920112
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920112,
					"content": "（嗚…這個占卜師笑得好可怕！就像是童話書裡說的老巫婆一樣！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920113
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920113,
					"content": "（但她既然是這麼厲害的占卜師，那她的建議，說不定真的能幫上我…必須認真選才行！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920114,
						746920115
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920114,
					"content": "別嚇小孩了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920116
					]
				},
				{
					"id": 746920116,
					"content": "#咦？{NICKNAME}、小派蒙？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920117
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920117,
					"content": "#不愧是{F#妳}{M#你}，每次都出現得恰到好處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920118,
						746920119,
						746920120
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920118,
					"content": "謝謝誇獎。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920121
					]
				},
				{
					"id": 746920121,
					"content": "呵呵呵呵呵，的確如此，比起捉摸不透的「命運」，還是實打實的委託更能直觀地塑造人的言行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920122
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920122,
					"content": "#好了，既然{F#妳}{M#你}來了，就和這位小朋友聊聊吧，她似乎不太信任我這位魔女啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920123
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920123,
					"content": "在這種偏僻地方擺攤的奇怪占卜師，怎麼想都很難信任得起來吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920124
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746920124,
					"content": "#（{NICKNAME}好像和這個占卜師很熟悉的樣子？太好了，總算可以找個可靠的人打聽了…！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920125
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920125,
					"content": "#…{NICKNAME}、小派蒙，過來過來，我悄悄問{F#妳}{M#你}們一點事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920126,
						746920127
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920126,
					"content": "我正好也想問問…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920128
					]
				},
				{
					"id": 746920128,
					"content": "當然是為了尋找新的調酒材料啦。哼，我之前的調酒方式還是太狹窄了，總是找食材用來調酒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920129
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920129,
					"content": "哈哈…哈…迪奧娜找的那些調酒材料，也不能全都算是「食材」啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746920130,
					"content": "總、總之，都是一些能入口的東西嘛！只要咬著牙、閉著眼，怎麼樣都能吃下肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920131,
						746920132
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920131,
					"content": "所以，妳打算找一些…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920133
					]
				},
				{
					"id": 746920133,
					"content": "是啊，比如…我已經拿到了好多鏽蝕的螺絲、廢棄的線纜、凝結的油汙塊，還有…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920134
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920134,
					"content": "還是多虧了楓丹科學院那個做楓達的大叔幫忙，我才能順利找到這麼多好東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920135,
						746920136
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920135,
					"content": "安里？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920137
					]
				},
				{
					"id": 746920137,
					"content": "嗯…我之前就聽說那種很好喝的氣泡飲料是楓丹科學院做的，所以一開始就打算過去看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920138
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920138,
					"content": "我去了之後，安里大叔很爽快地請我喝了好幾瓶新口味的楓達呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920139
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920139,
					"content": "安里大叔身上都沒有酒味喔，只有甜甜酸酸的楓達味，一聞就感覺他是一個可靠的大人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920140
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920140,
					"content": "而且，就是安里大叔建議我來這裡看看的。他說，我這種「特殊體質」恐怕不能用科學院的技術解析。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920141
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920141,
					"content": "但他聽說最近楓丹廷附近有一個奇怪的占卜攤，去占卜過的人都說非常靈驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920142
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920142,
					"content": "「去占卜的話，說不定就能弄清原理。只要弄清了原理，也許就能找到解決方法。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920143
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920143,
					"content": "聽起來還滿有道理的，邏輯也很清晰，該說不愧是楓丹科學院的研究員嗎…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920144
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746920144,
					"content": "之後，我就來了這個占卜攤…我一過來，她就叫住了我，說我身上有著奇異的擾動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920145
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920145,
					"content": "我還沒來得及接話呢，她就把我的體質問題全都說了出來，但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920146
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920146,
					"content": "但是，楓丹科學院的研究邏輯，並不能直接用在占卜上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920147
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920147,
					"content": "即便是知道了「原理」，之後的事情也並不好辦…就像是之前我說的那樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920148
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920148,
					"content": "神秘學可不是實在的軸承與螺絲，我也無法為妳直接「檢修」命運。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920149
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920149,
					"content": "那不就是…什麼都改變不了的意思嗎？那我抽牌也沒用…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920150
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920150,
					"content": "那可不一定啊。說不定妳抽了牌，就能找到妳命運中缺失的某一片小小齒輪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920151
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920151,
					"content": "雖然看起來微不足道，但只要安裝進機關裡，反而能驅動某一個巨大的系統呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920152
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920152,
					"content": "#妳…妳不會騙我吧？{NICKNAME}，{F#妳}{M#你}覺得…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920153,
						746920154
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920153,
					"content": "芭比洛斯女士很可靠的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920155
					]
				},
				{
					"id": 746920155,
					"content": "#…好吧，既然{NICKNAME}都這麼說了，那我就抽一張…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920156
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920156,
					"content": "在芭比洛斯的注視下，迪奧娜伸出手，緩緩抽出了一張「月諭聖牌」…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						746920157
					]
				},
				{
					"id": 746920157,
					"content": "我、我抽好了。這張牌是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920158
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920158,
					"content": "…哦呀，真是奇了…沒想到妳身上的那團「擾動」居然成長地如此茁壯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920159
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920159,
					"content": "它已經不再是「新苗」，而是一根健壯的枝幹了。真是奇了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920160
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920160,
					"content": "啊？什麼意思？是…是我以後調酒會越來越好喝的意思嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920161,
						746920162
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920161,
					"content": "聽起來不像是壞事…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920163
					]
				},
				{
					"id": 746920163,
					"content": "如果單從妳的體質上來說，的確會如此。而且，妳抽到的牌是逆位的「女祭司」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920164
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920164,
					"content": "這意味著妳曾經過於在意帷幕前的表象，也正是因為如此，才久久無法穿過帷幕。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920165
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920165,
					"content": "聽起來和調酒沒什麼關係嘛…我還以為這張牌會告訴我需要去找什麼食材呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920166
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920166,
					"content": "呵…「月諭聖牌」的確做不到這件事，至少目前不能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920167
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920167,
					"content": "但是，妳也不一定非要用「調酒」這個行為，來尋找妳人生中那個真正的答案啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920168
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920168,
					"content": "我人生的真正答案，就是把所有酒鬼大叔都教訓一遍，讓他們再也不能醉醺醺地發酒瘋。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920169
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920169,
					"content": "很有行動力。不過，雖然妳的身體在行動，但妳的「內心」卻一直停滯不前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920170
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920170,
					"content": "才不是呢！我…我發自內心最討厭喝酒的怪大叔了！特別是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920171
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920171,
					"content": "原來如此，那麼…妳和妳心裡所想著的那個人談過嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920172
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920172,
					"content": "我…唔，妳、妳怎麼知道我想的是誰？我都沒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920173
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920173,
					"content": "當然是占卜啊。呵呵呵，或許妳可以拋去那些焦躁的行動、混亂的情緒，用妳真正的內心和他對話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920174
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920174,
					"content": "這樣做的效果，說不定會比調出一瓶世界上最難喝的酒更有效。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920175
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920175,
					"content": "…他肯定不會聽的。只要喝了酒，他就什麼都不會聽的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920176
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920176,
					"content": "或許之前是這樣。但現在，妳已經找到了一枚小小的齒輪。在它的推動下，事情或許會發生一些…微妙的變化。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920177
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920177,
					"content": "妳是說這張牌？但它只是一張牌而已…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920178
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920178,
					"content": "當然不是。我說的是，妳已經開始產生變化的「內心」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920179
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920179,
					"content": "我、我的內心一點變化都沒有！現在…現在我要去找調酒材料了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920180
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920180,
					"content": "…那個，占卜費是多少，我會如數照付的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920181
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920181,
					"content": "哦呀，真是個禮貌的孩子，比那丫頭討喜多了。但占卜費就不必了，就當做是魔女贈予妳的小禮物吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920182
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920182,
					"content": "謝…謝謝妳。要是妳來蒙德…我可以請妳喝飲料的，保證好喝。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920183
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920183,
					"content": "我去蒙德？嗯…如果有機會的話，去一趟倒也未嘗不可…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920184
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920184,
					"content": "#也謝謝{F#妳}{M#你}們陪我，{NICKNAME}，還有小派蒙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920185,
						746920186
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920185,
					"content": "不會。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920187
					]
				},
				{
					"id": 746920187,
					"content": "#沒錯。無論是什麼麻煩事，我和{NICKNAME}都會馬上趕過去幫妳的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920188
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746920188,
					"content": "不過嘛…嘿嘿嘿，幫完忙之後，迪奧娜要請我們喝好喝的才行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920189
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746920189,
					"content": "#…嗯！等{F#妳}{M#你}們來蒙德城玩，我一定請{F#妳}{M#你}們喝最好喝的飲料，一點酒都不含的那種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920190
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920190,
					"content": "對了，要是妳之後對卡牌還有什麼疑問，可以去找一個叫莫娜的小丫頭——妳應該認識她吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920191
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920191,
					"content": "莫娜姐姐？我認識啊，她經常來店裡點那種最便宜的飲料喝，她也是很厲害的占卜師嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920192
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920192,
					"content": "哈，比我差遠了。不過，要是連解讀「月諭聖牌」都做不到，那乾脆也別自稱占卜師了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920193
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920193,
					"content": "妳只要和她說，替偉大的亞斯妥曼瑟·芭比洛斯·崔斯梅姬斯圖斯帶來了預言，作為給她的考驗。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920194
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920194,
					"content": "放心，只要這麼說了，她肯定會拼盡全力為妳解讀的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920195
					],
					"speakerTitle": "芭比洛斯"
				},
				{
					"id": 746920195,
					"content": "嗯，我記住了！亞斯妥…妥曼瑟·芭比洛斯·崔斯梅姬斯圖斯…好長的名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746920196
					],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920196,
					"content": "這麼說來，莫娜姐姐的名字是不是也很長？好像是叫阿斯托洛吉…什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪奧娜"
				},
				{
					"id": 746920186,
					"content": "之後要幫忙的話，隨時叫我。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920187
					]
				},
				{
					"id": 746920162,
					"content": "但從氣勢上來說也不算好事呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920163
					]
				},
				{
					"id": 746920154,
					"content": "放輕鬆抽一張牌吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920155
					]
				},
				{
					"id": 746920136,
					"content": "妳怎麼會遇到他？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920137
					]
				},
				{
					"id": 746920132,
					"content": "壓根不能入口的東西？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920133
					]
				},
				{
					"id": 746920127,
					"content": "迪奧娜怎麼來楓丹了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920128
					]
				},
				{
					"id": 746920119,
					"content": "我很擅長及時出現。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920121
					]
				},
				{
					"id": 746920120,
					"content": "不然怎麼處理那麼多委託。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920121
					]
				},
				{
					"id": 746920115,
					"content": "好久不見，迪奧娜。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746920116
					]
				}
			]
		},
