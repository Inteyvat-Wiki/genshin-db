			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190401,
					"content": "…安藤和天野應該已經帶著犯人回奉行所了。事情就是這樣，社長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190402
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190402,
					"content": "嗯，知道了，這樣解決了就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190403
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190403,
					"content": "#旅行者，{F#妳}{M#你}也回來了啊，這次辛苦{F#妳}{M#你}了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190404,
						220190405
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190404,
					"content": "這樣…就結束了？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				},
				{
					"id": 220190406,
					"content": "#畢竟人是天野和安藤帶走的，有這種感覺也正常。拿著這些報酬吧，這樣{F#妳}{M#你}多少會有點「實感」吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190407,
						220190409
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190407,
					"content": "那妳的報酬呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190408
					]
				},
				{
					"id": 220190408,
					"content": "我？能夠幫助奉行所的大人們偵破案件，讓這條街恢復平靜，對我來說就是最大的報酬。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190412,
					"content": "但老實說，這次我確實能算是「一無所獲」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190413
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190413,
					"content": "既沒有見識到新奇的犯罪手法，也沒有聽見新奇的犯罪理念。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190414
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190414,
					"content": "只不過是毫無趣味的一般犯罪而已，還好沒有費太大的功夫。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190415,
						220190417
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190415,
					"content": "珊瑚社長…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190416
					]
				},
				{
					"id": 220190416,
					"content": "怎麼？第一次見到我這種對「犯罪」感興趣的人嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190419,
					"content": "這種對於「犯罪」的興趣，也是我成為偵探的原因。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190420
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190420,
					"content": "…妳也想「犯罪」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190421
					]
				},
				{
					"id": 220190421,
					"content": "對啊。我可是很想「犯罪」的。我想執行一場完美、毫無破綻的「犯罪」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190422
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190422,
					"content": "但可惜的是…人在犯下罪案的時候，幾乎都會留下痕跡。只要留下了痕跡，這樁罪案被偵破也是早晚的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190423,
						220190424,
						220190425
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190423,
					"content": "如果不是人犯的罪呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190426,
					"content": "#{F#妳}{M#你}看，{F#妳}{M#你}也不由自主地開始思考起「犯罪」了，對不？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190427
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190427,
					"content": "#沒什麼好不安的，{F#妳}{M#你}也只不過是思考一下而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190428
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190428,
					"content": "我也經常在思考「犯罪」，例如犯罪的手法、犯罪的理由等等…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190429
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190429,
					"content": "妳思考這些做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190430
					]
				},
				{
					"id": 220190430,
					"content": "當然是為了能更有效辦案啦。最近我接手的案件愈來愈複雜，不思考可不行啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190431
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190431,
					"content": "不過，那些案件裡倒是也沒有一樁能稱得上是「完美犯罪」啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190432
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190432,
					"content": "那妳見過「完美犯罪」嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190433
					]
				},
				{
					"id": 220190433,
					"content": "見過喔。那樁「完美犯罪」…我到現在也沒能找出真正的犯人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190434
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190434,
					"content": "不過，我還是相信，只要是人犯下的案件，就一定會留下痕跡，我只不過是…還沒有發現那些痕跡而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190435
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190435,
					"content": "#好了，這些報酬給{F#妳}{M#你}，謝謝{F#妳}{M#你}幫我的忙，旅行者。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190436
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190436,
					"content": "以後有空了記得多來看看，沒空的話…嗯…也沒關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190437
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190437,
					"content": "我的直覺告訴我，我們還會有機會再一起聯手的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190424,
					"content": "如果犯人不存在呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190425,
					"content": "怎麼清除全部痕跡呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190426
					]
				},
				{
					"id": 220190417,
					"content": "這就是「偵探」嗎…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190418
					]
				},
				{
					"id": 220190418,
					"content": "也不能這麼一概而論。但就我個人而言，是對「犯罪」很感興趣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190419
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190409,
					"content": "妳什麼都不要嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190410
					]
				},
				{
					"id": 220190410,
					"content": "我已經得到了「正義」，除此之外，我也不需要什麼了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190411
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190411,
					"content": "…我是不是應該這麼說比較好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190412
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190405,
					"content": "沒什麼結束的實感…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190406
					]
				}
			]
		},
