				"points": []
			},
			"dialogs": [
				{
					"id": 220190201,
					"content": "發現那傢伙了，果然正在埋贓物…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190202,
						220190204
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190202,
					"content": "我們上！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190203
					]
				},
				{
					"id": 220190203,
					"content": "等一下，旅行者，現在…還不是我們該上的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190206,
					"content": "再等一下…嗯…應該差不多了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190207
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190207,
					"content": "你這傢伙，在做什麼！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190208
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190208,
					"content": "放下手裡的東西，別動！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190209
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190209,
					"content": "你、你們是怎麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190210
					],
					"speakerTitle": "石川八郎"
				},
				{
					"id": 220190210,
					"content": "可惡…別看著了！一起上！解決掉這兩個傢伙，我們就遠走高飛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190211
					],
					"speakerTitle": "石川八郎"
				},
				{
					"id": 220190211,
					"content": "幾個盜寶團，居然敢這麼囂張…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190212
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190212,
					"content": "安藤先生，天野先生，我們來幫你！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190213
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190213,
					"content": "喔！就拜託你們了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190214
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190214,
					"content": "旅行者，現在我們可以上場了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190215
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190215,
					"content": "搞這麼麻煩…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190216
					]
				},
				{
					"id": 220190216,
					"content": "這都是社長的囑咐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190217
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190217,
					"content": "好了，我們上吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190204,
					"content": "要上嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190205
					]
				},
				{
					"id": 220190205,
					"content": "稍等一下，現在還不是我們該上的時候。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190206
					],
					"speakerTitle": "龍二"
				}
			]
		},
		{
			"id": 2201903,
			"completionStepIds": [
				2201905
			],
