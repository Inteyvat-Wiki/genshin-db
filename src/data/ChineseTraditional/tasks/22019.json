				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"龍二"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190301,
					"content": "#這下子可算是人贓俱獲了，多謝了龍二，還有旅行者，{F#妳}{M#你}也辛苦了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190302
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190302,
					"content": "我和天野現在就把這些盜寶團帶回奉行所，剩下的事就交給我們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190303
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190303,
					"content": "不過，珊瑚還真是神，居然能這麼準確地找到犯人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190304
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190304,
					"content": "畢竟是珊瑚嘛，這種案件，怎麼想也難不倒她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190305
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190305,
					"content": "龍二，那我們就先回奉行所了。等處理好了這傢伙，我們會再登門拜謝的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190306
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190306,
					"content": "客氣了，請慢走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190307
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190307,
					"content": "好了，旅行者，我們也回去向社長報告一下吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "龍二"
				}
			]
		},
		{
			"id": 2201904,
			"completionStepIds": [
				2201906
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
