					"珊瑚"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 220190101,
					"content": "…那麼，就拜託兩位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190102
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190102,
					"content": "就交給我們了，放心吧，珊瑚小姐。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190103
					],
					"speakerTitle": "安藤"
				},
				{
					"id": 220190103,
					"content": "居然在我們眼皮底下藏了這麼久，真是膽大包天的傢伙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190104
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190104,
					"content": "而且，還用…那種身分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190105
					],
					"speakerTitle": "天野"
				},
				{
					"id": 220190105,
					"content": "不管怎麼樣，他犯案的日子今天就要到盡頭了。龍二，我交代你的事你記住了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190106
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190106,
					"content": "是，社長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190107
					],
					"speakerTitle": "龍二"
				},
				{
					"id": 220190107,
					"content": "#那就好…旅行者，{F#妳}{M#你}也來了啊，那太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190108,
						220190109
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190108,
					"content": "是要去抓犯人了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190111
					]
				},
				{
					"id": 220190111,
					"content": "證據已經蒐集充分，犯人的行為我也已經摸清了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190112
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190112,
					"content": "#旅行者，{F#妳}{M#你}就和龍二，還有安藤先生和天野先生同行，讓那個犯人伏法吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190113
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190113,
					"content": "#那傢伙應該有不少同夥。有{F#妳}{M#你}在的話，行動成功的把握就更大了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190114,
						220190117
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190114,
					"content": "我要做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190115
					]
				},
				{
					"id": 220190115,
					"content": "#用{F#妳}{M#你}那無敵的氣勢震懾住犯人就好，免得他做出什麼…不明智的舉動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190116
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190116,
					"content": "不過，我想這種只會偷偷摸摸的盜賊，應該也沒有做出什麼激烈舉動的氣魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190121,
					"content": "如果我估計得沒錯，現在那傢伙應該已經去了野外，準備把新一批的贓物埋起來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190122
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190122,
					"content": "你們現在過去，應該剛好可以人贓俱獲。快出發吧，我在這裡等你們的好消息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190117,
					"content": "妳不一起去嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190118
					]
				},
				{
					"id": 220190118,
					"content": "對我來說，這樁案子已經結束了，剩下的事我就不參與了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190119
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190119,
					"content": "#旅行者，{F#妳}{M#你}就去用{F#妳}{M#你}那無敵的氣勢震懾住犯人吧。免得他做出什麼…不明智的舉動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190120
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190120,
					"content": "不過，我想這種只會偷偷摸摸的盜賊，應該也沒有做出什麼激烈舉動的氣魄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190121
					],
					"speakerTitle": "珊瑚"
				},
				{
					"id": 220190109,
					"content": "是要結案了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						220190110
					]
				},
				{
					"id": 220190110,
					"content": "嗯，只要一切順利，今天就可以結案了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						220190111
					],
					"speakerTitle": "珊瑚"
				}
			]
		},
		{
