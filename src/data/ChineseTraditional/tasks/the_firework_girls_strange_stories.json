					"岩夫"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100101,
					"content": "#大{F#姐姐}{M#哥哥}，我們在找「大貉妖」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100102
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100102,
					"content": "#{F#妳}{M#你}知道「大貉妖」住在哪裡嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100103
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100103,
					"content": "「大貉妖」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100104
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100104,
					"content": "#欸，{F#妳}{M#你}們沒有聽過嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100105
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100105,
					"content": "就是一種很厲害又很狡猾的妖怪，能變成各種各樣的東西，神出鬼沒，喜歡騙人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100106
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100106,
					"content": "我們家的稻米就被「大貉妖」偷吃過，有一次我爸爸還被「大貉妖」踹進了河裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100107
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100107,
					"content": "好調皮的傢伙啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100108,
					"content": "你們為什麼要找牠呢？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100109
					]
				},
				{
					"id": 120100109,
					"content": "因為我們終於有能打跑牠的辦法了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100110
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100110,
					"content": "我爸爸說，「大貉妖」最喜歡捉弄那些老是不回家的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100111
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100111,
					"content": "只要打跑了「大貉妖」，我們就隨時都可以出門玩啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100112
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100112,
					"content": "但如果是厲害的妖怪，你們不會害怕嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100113
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100113,
					"content": "你們的爸爸媽媽也會擔心你們的安全吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100114,
					"content": "不會啊？今天我告訴爸爸，說我們幾個人要去找「大貉妖」，他什麼都沒說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100115
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100115,
					"content": "說不定是現在的「大貉妖」很弱，只能躲起來休息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100116
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100116,
					"content": "嗯！只要在「大貉妖」恢復妖力之前回家，就不會有危險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100117
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100117,
					"content": "唔，怎麼聽起來怪怪的？但好像又說不清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100118,
						120100119,
						120100120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100118,
					"content": "如果被盯上，躲在家也無濟於事吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				},
				{
					"id": 120100121,
					"content": "嗯，我感覺「大貉妖」像故事裡才有的妖怪，現實裡並不存在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100122,
						120100123
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100122,
					"content": "我也覺得是傳說。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100124
					]
				},
				{
					"id": 120100124,
					"content": "那就告訴他們吧，這樣就不用白費工夫到處找了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100125,
					"content": "聽我說喔，你們不用再找「大貉妖」了，因為牠是不存在的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100126,
					"content": "欸——？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100127
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100127,
					"content": "不會吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100128
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100128,
					"content": "不可能，我爸爸不會騙我的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100129
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100129,
					"content": "你們的家裡人只是擔心你們啦，到處亂跑的話是很危險的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100130
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100130,
					"content": "不對、不對，肯定有「大貉妖」！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100131
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100131,
					"content": "對啊，宵宮姐姐還幫我們準備了武器！要教我們怎麼炸妖怪呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100132
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100132,
					"content": "欸，宵宮…？宵宮姐姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100133
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100133,
					"content": "我們把「大貉妖」的故事告訴了宵宮姐姐。她就叫我們不要害怕，要學會怎麼把牠趕走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100134
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100134,
					"content": "我們等了好久，終於宵宮姐姐說，今天是個好機會，所以我們就出來找「大貉妖」了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100135
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100135,
					"content": "就是就是，宵宮姐姐經常陪我們玩，跟我們講故事，她絕對不會騙人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100136
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100136,
					"content": "但、但是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100137
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100137,
					"content": "哼，我們走！去找宵宮姐姐！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100138
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100138,
					"content": "等等，別走啊，別走！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100139
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100139,
					"content": "唉，惹他們生氣了。可是，我也是擔心他們才…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100140
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100140,
					"content": "不知道為什麼還聽到了宵宮的名字，我們還是追上去看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100123,
					"content": "只是不想讓孩子到處亂跑吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100124
					]
				},
				{
					"id": 120100119,
					"content": "我們從來沒有見過這種妖怪。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				},
				{
					"id": 120100120,
					"content": "爸爸的態度有點奇怪…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100121
					]
				}
			]
		},
		{
			"id": 1201002,
			"completionStepIds": [
				1201002
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201002",
							"2"
						],
						"stepId": 1201002,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"宵宮"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100201,
					"content": "#別傷心，別這麼傷心啦，{F#她}{M#他}和你們開玩笑的，「大貉妖」怎麼會不存在呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100202
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100202,
					"content": "可、可是，我們確實沒有見過「大貉妖」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100203
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100203,
					"content": "那是因為「大貉妖」很厲害啊，就是因為牠這麼厲害，才需要你們出手對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100204
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100204,
					"content": "嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100205
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100205,
					"content": "不用著急，也不用灰心，要成為很厲害的英雄，耐心和智慧也是不能少的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100206
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100206,
					"content": "就算現在沒找到牠，煙花會開始之前，牠一定會出現的。在那之前，記得來宵宮姐姐家領武器，知道了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100207
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100207,
					"content": "點燃我特製的煙花，無論「大貉妖」有多厲害，都能把牠嚇走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100208
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100208,
					"content": "家裡的東西，田裡的莊稼，還有爸爸媽媽，都輪到你們來保護了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100209
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100209,
					"content": "知道了！既然宵宮姐姐都這麼說了，我們就再耐心一點！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100210
					],
					"speakerTitle": "松坂"
				},
				{
					"id": 120100210,
					"content": "對了對了，別著急走。我這裡還有幾張紙條，你們一人一張，記得帶回去給爸爸媽媽，讓他們好好保管。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100211
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100211,
					"content": "只要說是宵宮姐姐給的，他們就明白是什麼意思啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100212
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100212,
					"content": "知道啦！謝謝宵宮姐姐！那我們就先回去了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100213
					],
					"speakerTitle": "岩夫"
				},
				{
					"id": 120100213,
					"content": "謝謝宵宮姐姐！妳也要早點回來陪我們玩喔！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100214
					],
					"speakerTitle": "彩香"
				},
				{
					"id": 120100214,
					"content": "好的好的，路上小心，待會我們再見啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100215
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100215,
					"content": "那、那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100216,
						120100217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100216,
					"content": "好久不見。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100218
					]
				},
				{
					"id": 120100218,
					"content": "#果然是{F#妳}{M#你}們，聽孩子們的描述我就猜到了。沒關係，不怪{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100219
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100219,
					"content": "「大貉妖」在孩子中的人氣很高，草率地否定牠的存在，當然會讓孩子傷心啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100220
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100220,
					"content": "那麼，「大貉妖」的確是不存在的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100221
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100221,
					"content": "嗯，第一次聽到牠的故事，我就覺得，多半只是孩子們的父母編出來的妖怪，為了讓孩子們不要亂跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100222
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100222,
					"content": "不過孩子們來問我的時候，我沒有拆穿，而是說，「大貉妖」外貌可愛，喜歡惡作劇，但不喜歡傷人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100223
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100223,
					"content": "他們現在相信的，大概都是我編出來的形象啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100224
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100224,
					"content": "原來都是妳的創意啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100225
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100225,
					"content": "像這樣延續謊言，是不對的吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100226
					]
				},
				{
					"id": 120100226,
					"content": "或許吧，但不管怎麼樣，也輪不到我去當這個拆穿謊言的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100227
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100227,
					"content": "他們的父母可能只是為了讓孩子不要亂跑，但也可能有其他的考慮。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100228
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100228,
					"content": "在我不瞭解的情況下，如果草率地說「『大貉妖』是不存在的喔」很可能會害了他們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100229
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100229,
					"content": "而且，對孩子來說，相信並且喜歡就好，真真假假什麼的，不是那麼重要的事啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100230
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100230,
					"content": "我心裡也有很多很多憧憬啊，點燃之後會旋轉噴出七彩虹光的「火鑽」，隱居深山為仙境指路的「霧靈」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100231
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100231,
					"content": "我知道都是不存在的，但是我還是願意相信。別人要是在我面前說，「別傻了，不存在的」——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100232
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100232,
					"content": "我就會朝他做鬼臉，扔石頭！因為很討人厭！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100233,
						120100235
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100233,
					"content": "我大概明白這種感覺了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100234
					]
				},
				{
					"id": 120100234,
					"content": "對吧！就算是假的，但是很帥氣、很浪漫啊，輪不到別人來否定吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100237
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100237,
					"content": "童年曾經相信過的東西，經歷過的事，慢慢都會變成無可替代的寶物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100238
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100238,
					"content": "#{F#妳}{M#你}們小時候也相信過戰勝惡龍的勇者，斬破黑暗的聖劍吧，我覺得其實是一樣的東西。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100239
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100239,
					"content": "拆穿了童話，又要告訴孩子們什麼呢？說稻妻現在鎖國了？或者，「眼狩令」的故事？都太早了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100240
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100240,
					"content": "唔…對！太早了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100241,
						120100242
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100241,
					"content": "妳只記得最後一句了吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100243
					]
				},
				{
					"id": 120100243,
					"content": "哈哈，不管有沒有聽懂，總之放心吧，我會注意孩子們的安全，好好保護他們的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100244
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100244,
					"content": "好了，我差不多也該回去了，「長野原煙花會」就快到了，還有好多事情要忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100245
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100245,
					"content": "「長野原煙花會」？是你們家舉辦的活動嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100246
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100246,
					"content": "對啊，畢竟掛了我們家的名字嘛，這個活動在稻妻很有名。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100247
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100247,
					"content": "#對了對了，{F#妳}{M#你}們接下來有什麼事嗎？沒事的話，就一起來參加吧，我來為{F#妳}{M#你}們準備一個超好看的煙花！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100248,
						120100249
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100248,
					"content": "早就想看了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100250
					]
				},
				{
					"id": 120100250,
					"content": "#嘿嘿，那我先帶{F#妳}{M#你}們去長野原，見見我的老爹吧！煙花會之前，還有幾個煙花沒做完呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100249,
					"content": "那我就不客氣了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100250
					]
				},
				{
					"id": 120100242,
					"content": "不用太勉強去捧場啦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100243
					]
				},
				{
					"id": 120100235,
					"content": "為什麼和孩子一樣…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100236
					]
				},
				{
					"id": 120100236,
					"content": "因為真假無所謂啊，很帥氣、很浪漫，就值得相信，輪不到別人來否定吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100237
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100217,
					"content": "又見面了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100218
					]
				}
			]
		},
		{
			"id": 1201003,
			"completionStepIds": [
				1201003
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201003",
							"2"
						],
						"stepId": 1201003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"長野原龍之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100301,
					"content": "老爹，我回來啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100302
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100302,
					"content": "馬上就到煙花會了吧，各家各戶的煙花，都張羅得差不多了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100303
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100303,
					"content": "這兩個人，沒見過呢。是新朋友？還是客人？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100304
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100304,
					"content": "#都算吧，{F#她}{M#他}們是前不久才到這裡來的，既然來了稻妻，不看煙花怎麼行呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100305
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100305,
					"content": "#哈哈哈，不管怎麼樣，找個地方歇歇腳吧。我長野原龍之介，跟{F#妳}{M#你}們講講長野原家的悠久歷史。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100306
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100306,
					"content": "這個先等會，老爹，我有事情問你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100307
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100307,
					"content": "很久很久以前…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100308
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100308,
					"content": "唉，老爹又自顧自地開始講故事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100309
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100309,
					"content": "不好意思啊，老爹以前受了傷，那之後耳朵就不太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100310
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100310,
					"content": "但剛剛的對話，好像微妙地成立了呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100311,
					"content": "然後呢，人們又花了好長時間才明白，有一種礦石，它的粉末，能燃出很漂亮很漂亮的顏色。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100312
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100312,
					"content": "老爹，老爹，先等等！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100313
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100313,
					"content": "嗄？怎麼了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100314
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100314,
					"content": "之前訂購的那些做煙花的材料，已經送過來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100315
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100315,
					"content": "昨天的煙花都發出去啦，前天的也是，大前天的也是。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100316
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100316,
					"content": "不是，老爹，我是說材料，之前訂購的材料。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100317
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100317,
					"content": "今天的也做得差不多啦，不用擔心，妳老爹的手藝還沒退步呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100318
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100318,
					"content": "不是，是材料！做煙花需要用到的材料，礦石！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100319
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100319,
					"content": "什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100320
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100320,
					"content": "礦石材料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100321
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100321,
					"content": "喔喔，礦石材料？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100322
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100322,
					"content": "對對對，礦石材料！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100323,
					"content": "啊，對不起…終於傳達到了，我有點激動，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100324
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100324,
					"content": "材料的話，還沒送過來呢，具體原因，好像過來說了一下，但我沒聽清楚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100325
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100325,
					"content": "沒關係，沒關係，知道這個就行了，那就晚點再做。等他們送過來，老爹記得要收一下。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100326
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100326,
					"content": "嗯嗯，放心吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100327
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100327,
					"content": "#不好意思，可能有點吵到{F#妳}{M#你}們了，如果有什麼事要問老爹，就會像現在這樣有點麻煩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100328,
						120100330
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100328,
					"content": "但感覺他很熱情好客。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100329
					]
				},
				{
					"id": 120100329,
					"content": "嘿嘿，對啊，老爹是很好的人，大家也都很尊重他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100332,
					"content": "老爹因為聽不清楚，所以從不和別人爭論，也不否認別人的話，總是樂呵呵地聽著。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100333
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100333,
					"content": "小的時候，我以為是老爹他特別理解我，覺得我說什麼都是對的，所以我什麼話都會和老爹說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100334
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100334,
					"content": "後來我知道了，老爹樂呵呵的，只是因為他聽不清楚，不過我還是每天都跟他講故事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100335
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100335,
					"content": "欸？這又是為什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100336
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100336,
					"content": "光是看到老爹笑，我就很開心啊。這樣他也不會寂寞吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100337
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100337,
					"content": "不過，話說回來，既然材料還沒送到，煙花會又近在眼前了，我們得想想別的辦法…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100338
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100338,
					"content": "那個，宵宮，是妳回來了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100339
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100339,
					"content": "嗚哇？！你別嚇唬人啊，不是叫你別隨便說話嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100340
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100340,
					"content": "對、對不起…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100341
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100341,
					"content": "你等我一下，我現在過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100330,
					"content": "但感覺他的性格和妳很像。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100331
					]
				},
				{
					"id": 120100331,
					"content": "嘿嘿，經常有人這麼說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100332
					],
					"speakerTitle": "宵宮"
				}
			]
		},
		{
			"id": 1201004,
			"completionStepIds": [
				1201004
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201004",
							"2"
						],
						"stepId": 1201004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100401,
					"content": "沒有人在看這邊，出來吧，到側面來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100402
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100402,
					"content": "幸好剛剛沒有驚動天領奉行的人，不然我們就都有危險了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100403
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100403,
					"content": "是我太心急了，但我聽到妳回來了，我就…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100404
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100404,
					"content": "放心吧，朔次郎，至少目前一切都在計畫之中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100405
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100405,
					"content": "我們等一下會去找做煙花的材料，順便也會搞定船的事，就是之前答應過你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100406
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100406,
					"content": "謝謝妳，幫我這麼多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100407,
						120100408
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100407,
					"content": "這位是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100409
					]
				},
				{
					"id": 120100409,
					"content": "他是我們家以前的顧客，前段時間剛剛從外面逃回稻妻，結果在偷渡的時候被發現了，現在正在被天領奉行通緝…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100410
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100410,
					"content": "通緝？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100411,
					"content": "妳也小點聲啦，別引起不必要的注意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100412
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100412,
					"content": "被抓到的話，朔次郎不知道會被判什麼罪，為了讓他避開這個風頭，只能想辦法找艘船，把他送出去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100413
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100413,
					"content": "可是外海不是有雷暴嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100414
					]
				},
				{
					"id": 120100414,
					"content": "是啊，這也是非常危險的辦法，但現在沒那麼多選擇可以挑了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100415
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100415,
					"content": "要是一不小心翻了船，那就…唔唔！溺水很可怕的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100416,
					"content": "這麼危險的話，當初不回來不就好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100417
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100417,
					"content": "因為，有不得不做的事…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100418
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100418,
					"content": "可是我一回來，就聽說了很多難以置信的變化。本來我下定了決心，但現在又不知道該怎麼辦了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100419
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100419,
					"content": "我也不想多給宵宮和龍之介先生添麻煩，他們能收留我，我就很感激了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100420
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100420,
					"content": "沒關係沒關係，不用客氣。還記得我說的話吧，「只要有我們家的紙條，就一直是長野原的客人。」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100421
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100421,
					"content": "紙條…？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100422,
						120100423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100422,
					"content": "有點印象。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100424
					]
				},
				{
					"id": 120100424,
					"content": "嗯，之前孩子們拿到的也是同樣的東西。只要是想要紀念某件事而來訂做煙花的客人，我們家就會附贈一張紙條。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100425
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100425,
					"content": "紙條的內容只有我們家的人能看懂，是製作這種煙花的具體配方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100426
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100426,
					"content": "只要看了這個紙條，無論是過了十年還是一百年，長野原都能保證做出和當年一模一樣的煙花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100427
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100427,
					"content": "哇，感覺很帥的樣子！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100428
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100428,
					"content": "這是家裡的老傳統了，只要是老顧客都知道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100429
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100429,
					"content": "嗯，那時候還是我的爸媽找龍之介先生做的煙花，現在想來，也有二十年了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100430
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100430,
					"content": "唉，實在想不到現在會變成這樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100431
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100431,
					"content": "沒關係啦。只有實在迫不得已，才需要乘船逃離稻妻。我還會幫你想其他辦法的，如果能留下來那當然更好啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100432
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100432,
					"content": "不管是什麼原因，只要是客人找上門來有事相求，就不能讓他失望而歸。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100433
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100433,
					"content": "謝謝妳，這樣我就還能有點時間，再考慮考慮…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100434
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100434,
					"content": "好啦，也不要在外面站太長時間，快進屋去吧。等我有了消息，再回來告訴你。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100435
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100435,
					"content": "嗯，太麻煩妳了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100436
					],
					"speakerTitle": "朔次郎"
				},
				{
					"id": 120100436,
					"content": "唉，明明是土生土長的稻妻人，卻得不到回來的許可。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100437
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100437,
					"content": "#對了，{F#妳}{M#你}們也是最近才來稻妻的吧，是怎麼獲得許可的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100438
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100438,
					"content": "我辦理了很麻煩的離島手續。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100439
					]
				},
				{
					"id": 120100439,
					"content": "再靠勘定奉行的大小姐柊千里的幫忙，才順利到了這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100440
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 120100440,
					"content": "原來如此，有大人物幫忙啊。那看來對朔次郎也沒什麼參考價值了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100441
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100441,
					"content": "唉，要是我們的奉行眾能通融一點就好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100442
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100442,
					"content": "#{F#妳}{M#你}們去過的地方，應該都不像稻妻這樣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100443,
						120100444
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100443,
					"content": "的確。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100445
					]
				},
				{
					"id": 120100445,
					"content": "唉，不管怎麼樣，還是要想辦法幫他的忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100446
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100446,
					"content": "#不好意思，本來是邀請{F#妳}{M#你}們來看煙花的，結果現在不得不東跑西跑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100447
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100447,
					"content": "#如果{F#妳}{M#你}們覺得麻煩，可以過一會再來我家找我，我一個人去搞定材料和船的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100448,
						120100449
					],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100448,
					"content": "我不介意陪妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100450
					]
				},
				{
					"id": 120100450,
					"content": "那太好了，我們先去幫朔次郎準備船！邊走邊聊吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "宵宮"
				},
				{
					"id": 120100449,
					"content": "我也想看看煙花會是怎麼準備的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100450
					]
				},
				{
					"id": 120100444,
					"content": "神也有神的想法。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100445
					]
				},
				{
					"id": 120100423,
					"content": "是不是就是交給孩子的那個？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100424
					]
				},
				{
					"id": 120100408,
					"content": "為什麼藏在宵宮的家裡？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						120100409
					]
				}
			]
		},
		{
			"id": 1201005,
			"completionStepIds": [],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1201004",
							"2"
						],
						"stepId": 1201004,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"長野原龍之介"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 120100501,
					"content": "#{F#妳}{M#你}們有事就先忙，忙完再回來聽故事也不遲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						120100502
					],
					"speakerTitle": "長野原龍之介"
				},
				{
					"id": 120100502,
					"content": "我的時間很多，故事嘛，也有很多很多。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "長野原龍之介"
				}
			]
		}
	]
