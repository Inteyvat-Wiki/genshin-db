				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"一成"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000101,
					"content": "#{F#妳}{M#你}好，有什麼咕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000102
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000102,
					"content": "#唔，肚子又發出聲音了。我是說，有什麼可以幫{F#妳}{M#你}的咕嚕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000103
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000103,
					"content": "呃，你說什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000104
					]
				},
				{
					"id": 222000104,
					"content": "唉，每次我肚子餓的時候都會這樣，咕嚕咕嚕的，聲音特別大，連我說話的聲音都蓋過去了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000105
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000105,
					"content": "雖然…咕嚕…也去「不卜廬」看過了，但醫生說我只是單純肚子餓了，不是病，所以沒法治咕嚕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000106
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000106,
					"content": "醫生說只要我吃飽了就好，但是我…我食量比人家都大啊咕嚕，要是一直吃到吃飽的話，我的錢包也撐不住。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000107
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000107,
					"content": "嘉毅和我說，如果正餐沒吃飽，那就飯後再吃點東西墊一墊，至少別影響到工作。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000108
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000108,
					"content": "但是這「墊一墊」…我有很多想吃的菜，但也不知道哪個最容易填飽肚子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000109
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000109,
					"content": "#旅行者，{F#妳}{M#你}經常在野外跑，肯定知道吃什麼最容易填飽肚子，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000110
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000110,
					"content": "#不如{F#妳}{M#你}來幫我，在我想吃的菜裡面選出好吃又能填飽肚子的菜吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000111
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000111,
					"content": "你這次想吃什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						222000112
					]
				},
				{
					"id": 222000112,
					"content": "我想吃的東西可多了…我想想…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一成"
				}
			]
		},
		{
			"id": 2220002,
			"completionStepIds": [
				2220002
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
