	"talks": [
		{
			"id": 2220001,
			"completionStepIds": [
				2220001
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"2220001",
							"2"
						],
