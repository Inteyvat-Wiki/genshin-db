			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"一成"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 222000201,
					"content": "唔，我聽說，有些蒙德菜味道不錯，比方說甜甜花釀雞、蒙德烤魚、漁人吐司還有嘟嘟蓮海鮮羹咕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000202
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000202,
					"content": "#拜託{F#妳}{M#你}了，把{F#妳}{M#你}覺得最容易填飽肚子的菜帶給我吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						222000203
					],
					"speakerTitle": "一成"
				},
				{
					"id": 222000203,
					"content": "吃完的話，至少今天肚子就不會叫了吧咕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "一成"
				}
			]
		},
		{
