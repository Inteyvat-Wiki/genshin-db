			"dialogs": [
				{
					"id": 200700501,
					"content": "這邊這邊，來這邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700502
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200700502,
					"content": "#{F#妳}{M#你}還記得上次我拜託你放進雪山的那些花嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700503
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200700503,
					"content": "現在已經過了一天了，我想要看看冷藏的效果。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700504
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200700504,
					"content": "#{F#妳}{M#你}願意幫我去雪山上，把那些花拿回來嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700505,
						200700507
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200700505,
					"content": "交給我吧",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700506
					]
				},
				{
					"id": 200700506,
					"content": "#那就拜託{F#妳}{M#你}啦，我就在這裡等{F#妳}{M#你}，請快去快回吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200700507,
					"content": "我放哪裡來著…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700508
					]
				},
				{
					"id": 200700508,
					"content": "#{F#妳}{M#你}不記得了嗎？是<color=#00E1FFFF>七天神像旁邊</color>，<color=#00E1FFFF>山裡的水邊</color>，還有一個<color=#00E1FFFF>洞窟附近</color>哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700509
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200700509,
					"content": "#我再幫{F#妳}{M#你}在地圖上標記一次吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				}
			]
		}
