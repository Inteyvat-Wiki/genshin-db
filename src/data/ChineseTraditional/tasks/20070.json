				{
					"id": 200700301,
					"content": "之前存在雪山上的花怎麼樣啦？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700302
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200700302,
					"content": "加上這次的都在這裡了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						200700303
					]
				},
				{
					"id": 200700303,
					"content": "都拿到了嗎？太好了，快給我看看。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700304
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200700304,
					"content": "呼呼，看起來不錯呀，嗯…看來這個方法確實可行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700305
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200700305,
					"content": "#不過，雪山距離蒙德城有些太遠了，總不能每次都麻煩{F#妳}{M#你}，以後得想個方便的辦法才行…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						200700306
					],
					"speakerTitle": "芙蘿拉"
				},
				{
					"id": 200700306,
					"content": "#總之，謝謝{F#妳}{M#你}來幫忙呀，這些是給{F#妳}{M#你}的謝禮，請拿著吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "芙蘿拉"
				}
			]
