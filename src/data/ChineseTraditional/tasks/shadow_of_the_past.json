	"talks": [
		{
			"id": 1012001,
			"completionStepIds": [
				1012001
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
