						101200702
					]
				},
				{
					"id": 101200702,
					"content": "#{F#妳}{M#你}說的是那個古怪的舊貴族吧，不好意思，我沒有見到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
