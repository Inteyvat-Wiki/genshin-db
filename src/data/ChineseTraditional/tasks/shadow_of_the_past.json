					"speakerTitle": "赫塔"
				},
				{
					"id": 101200705,
					"content": "#{F#妳}{M#你}們去上面看看吧，說不定能找到他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
