			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"琴",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200101,
					"content": "#榮譽騎士，感謝{F#妳}{M#你}在百忙中抽空過來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200102
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200102,
					"content": "#長話短說吧，騎士團現在有一件比較特殊的事想要拜託{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200103,
						101200105
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200103,
					"content": "騎士團還是這麼忙啊。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200104
					]
				},
				{
					"id": 101200104,
					"content": "嗯，近日風波不斷，無論是我，還是所有留駐蒙德的騎士團成員，都不敢有片刻懈怠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200107,
					"content": "最近我收到了很多騎士團成員的匯報，說勞倫斯家族的人和愚人眾往來密切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200108
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200108,
					"content": "愚人眾，又是他們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200109,
					"content": "不過這個勞倫斯家族，又是什麼人啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200110
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200110,
					"content": "過去的蒙德，曾有一段被舊貴族統治的昏暗時期。從高塔孤王那裡奪回的自由又被套上枷鎖，奴隸制大行其道。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200111
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200111,
					"content": "初代「蒲公英騎士」溫妮莎引領了革命，推翻了舊貴族的統治，建立了西風騎士團，蒙德這才擁有了現在這番景象。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200112
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200112,
					"content": "而當年為蒙德帶來苦難的舊貴族，就是勞倫斯家族了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200113
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200113,
					"content": "喔，我好像聽懂了。所以現在這群壞人的後代，又想和愚人眾一起做壞事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200114
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200114,
					"content": "#目前只是懷疑，還沒有什麼確切的證據。我請{F#妳}{M#你}們來，就是為了調查這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200115,
						101200116
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200115,
					"content": "為什麼是我？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200117,
					"content": "唉，因為在過去，舊貴族和騎士團，一直相互敵對。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200118
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200118,
					"content": "騎士團花了很長時間，想方設法化解雙方的矛盾。但貴族的那些後代，依然很敵視騎士團…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200119
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200119,
					"content": "不管我們以什麼樣的態度和他們接觸，都不會有好結果，還經常會引起他們的過度反應。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200120
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200120,
					"content": "雖然可以直接用調查的名義上門，但最後如果是冤枉了他們，一定會大大增加他們的不信任感。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200121
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200121,
					"content": "以前的諸多努力就功虧一簣了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200122
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200122,
					"content": "但我也是「榮譽騎士」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200123
					]
				},
				{
					"id": 101200123,
					"content": "#{F#妳}{M#你}已經是騎士團當中最適合出面的人選了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200124
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200124,
					"content": "#而且{F#妳}{M#你}大可不必強調自己這層身分。{F#妳}{M#你}從遠方旅行到此，不算是這座城市的「大多數」，所以可以從這個角度與那位貴族找到共同的話題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200125
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200125,
					"content": "和他建立起友善的關係之後，應該就能了解到一些關於愚人眾的事了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200126
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200126,
					"content": "不愧是琴團長！考慮得還真周到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200127,
					"content": "過獎了，這只是在處理外交問題的時候累積下來的一些經驗而已。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200128
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200128,
					"content": "那位勞倫斯家族的成員名叫舒伯特，最近他一直在蒙德北邊的城牆附近閒逛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200129
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200129,
					"content": "據說這個人的性格不太好相處，但是如果平心靜氣和他交流，應該不會有什麼問題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200130,
						101200131
					],
					"speakerTitle": "琴"
				},
				{
					"id": 101200130,
					"content": "交給我吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200132,
					"content": "#謝謝{F#妳}{M#你}們的協助。如果遇到什麼困難，我也會盡力提供幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "琴"
				},
				{
					"id": 101200131,
					"content": "但願一切順利。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200132
					]
				},
				{
					"id": 101200116,
					"content": "這是騎士團的分內工作吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200117
					]
				},
				{
					"id": 101200105,
					"content": "真有琴團長的風格。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200106
					]
				},
				{
					"id": 101200106,
					"content": "如果狀況允許，我也想多寒暄兩句。但蒙德城的安全，還是要放在首位。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200107
					],
					"speakerTitle": "琴"
				}
			]
		},
		{
			"id": 1012002,
			"completionStepIds": [
				1012003
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012003",
							"2"
						],
						"stepId": 1012003,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"？？？",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200201,
					"content": "嗯？誰啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200202
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200202,
					"content": "你好，我們是來…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200203,
					"content": "「你好」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200204,
						101200206
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200204,
					"content": "你…你好…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200205
					]
				},
				{
					"id": 101200205,
					"content": "「你好」？我沒聽錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200208,
					"content": "哼，粗魯又輕浮，竟然隨隨便便就走上來打招呼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200209
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200209,
					"content": "果然是無知的外來者，連我都不認識。我可是舒伯特·勞倫斯，貨真價實的貴族後裔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200210
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200210,
					"content": "#想跟我打招呼，要好好注意{F#妳}{M#你}的遣辭用句，這樣隨意又懶散的言語簡直不堪入耳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200211
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200211,
					"content": "#若是聽懂了我的話，{F#妳}{M#你}現在就該單膝跪地，謙卑地呈上自我介紹與歉意，這才是符合標準的禮儀！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200212
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200212,
					"content": "欸？這麼複雜的禮儀，完全沒有聽說過？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200213,
					"content": "哼，在那個大家都尊禮重道的時代，這種基礎禮儀，可是面見貴族的常識！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200214
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200214,
					"content": "若在禮儀上怠慢了貴族，至少都是一頓鞭刑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200215
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200215,
					"content": "再看看如今的世道，規矩廢了，禮儀也忘了，腐壞到不堪入目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200216,
						101200217
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200216,
					"content": "太麻煩了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200218,
					"content": "#{F#妳}{M#你}說什麼？{F#妳}{M#你}這是在質疑舊貴族的尊嚴嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200219
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200219,
					"content": "#我告訴{F#妳}{M#你}，雖然勞倫斯家族現在落沒了，但我等後裔一直都在尋找重獲榮光的機會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200220
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200220,
					"content": "周圍的人越是散漫，我就越要堅持貴族的優雅與禮貌。畢竟，我們從生下來開始就是全然不同的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200221
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200221,
					"content": "我還什麼都沒說呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200222
					]
				},
				{
					"id": 101200222,
					"content": "#那就別說了，{F#妳}{M#你}的言行舉止讓我厭煩。我與{F#妳}{M#你}這樣的平民子弟無話可說。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200223
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200223,
					"content": "#而且，我也沒有義務指點{F#妳}{M#你}應該怎麼講禮貌。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200224
					],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200224,
					"content": "我還有很重要的事，先走了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "舒伯特"
				},
				{
					"id": 101200217,
					"content": "難怪舊貴族落沒了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200218
					]
				},
				{
					"id": 101200206,
					"content": "怎麼了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200207
					]
				},
				{
					"id": 101200207,
					"content": "「怎麼了嗎」？我沒聽錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200208
					],
					"speakerTitle": "舒伯特"
				}
			]
		},
		{
			"id": 1012003,
			"completionStepIds": [
				1012005
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012005",
							"2"
						],
						"stepId": 1012005,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"安柏",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200301,
					"content": "#這不是「榮譽騎士」嗎！我剛剛打算去偵察，沒想到會在這裡碰到{F#妳}{M#你}！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200302
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200302,
					"content": "#欸？看{F#妳}{M#你}的表情，遇上什麼不開心的事了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200303
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200303,
					"content": "琴團長委託我們去辦事，結果…好像有點搞砸了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200304,
						101200305
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200304,
					"content": "說來話長。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				},
				{
					"id": 101200306,
					"content": "不要灰心啦，失敗是常有的事。我也不能保證每次都找到有用的情報。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200307
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200307,
					"content": "所以，打起精神來嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200308,
						101200309
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200308,
					"content": "謝謝妳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200310,
					"content": "#嘿嘿。對了，這樣吧，我來幫{F#妳}{M#你}想想辦法，{F#妳}{M#你}們到底遇到什麼事了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200311
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200311,
					"content": "琴團長要我們去和一個人打好關係，他名叫「舒伯特·勞倫斯」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200312
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200312,
					"content": "但我們見到他才發現，他的性格很古怪，根本不好好聽人說話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200313,
					"content": "#喔喔，我知道這個人！他一定說{F#妳}{M#你}們不懂禮貌吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200314,
						101200315
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200314,
					"content": "看來妳也有所耳聞。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200316,
					"content": "哈哈，我也被指點過好幾次，勞倫斯家裡的人都有些奇奇怪怪的講究。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200317
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200317,
					"content": "欸？所有人都是這樣嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200318,
					"content": "他們覺得貴族就要有貴族的矜持嘛，在我看來…雖然能夠理解，但總覺得他們不像是這個時代的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200319
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200319,
					"content": "不過，在他們家裡有個很特殊的例子，就是我的好夥伴優菈！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200320
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200320,
					"content": "夥…夥伴？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200321
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200321,
					"content": "是的，她是勞倫斯家族的人，但同時也是騎士團第四小隊的隊長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200322,
						101200323
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200322,
					"content": "可是琴團長說，勞倫斯家把騎士團視為敵人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200324,
					"content": "因為優菈是個特別的人嘛，她和家族的其他人都不一樣，有自己的想法和作風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200325
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200325,
					"content": "換句話說，就是她沒怎麼把家裡的規矩放在心上。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200326
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200326,
					"content": "#啊，不過如何跟勞倫斯家的人打交道，她還是很清楚的。{F#妳}{M#你}們只要見她一面，就明白我的意思啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200327
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200327,
					"content": "我有點好奇，既然優菈是勞倫斯家的人，為什麼琴團長會找我們，而不是直接找這個優菈？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200328,
					"content": "這個嘛，就有點一言難盡了。簡單來說，因為優菈加入了騎士團，所以她家裡的其他人都不太喜歡她…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200329
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200329,
					"content": "在他們的眼裡，優菈就像是投敵的叛徒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200330,
						101200331
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200330,
					"content": "確實挺有個性的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200332,
					"content": "#嘿嘿，但她其實很容易相處，{F#妳}{M#你}們只要能把困擾告訴她，她肯定能教會{F#妳}{M#你}們怎麼和舒伯特打交道的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200333
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200333,
					"content": "#她早上好像去野外巡邏了，{F#妳}{M#你}們應該能在望風山地附近找到她。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200334
					],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200334,
					"content": "嗯嗯，謝謝妳，安柏，那我們就去找她了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200335
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200335,
					"content": "#祝{F#妳}{M#你}們一切順利！我也要出發去偵察了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "安柏"
				},
				{
					"id": 101200331,
					"content": "也不是不能理解…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200332
					]
				},
				{
					"id": 101200323,
					"content": "勞倫斯家的人可以加入騎士團嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200324
					]
				},
				{
					"id": 101200315,
					"content": "看來妳也深受其害。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200316
					]
				},
				{
					"id": 101200309,
					"content": "很有安柏的作風。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200310
					]
				},
				{
					"id": 101200305,
					"content": "不是我們的錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200306
					]
				}
			]
		},
		{
			"id": 1012004,
			"completionStepIds": [
				1012009
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"1012009",
							"2"
						],
						"stepId": 1012009,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"優菈",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 101200401,
					"content": "#{F#妳}{M#你}們下手可真快，他們都是我追踪了很長時間的目標。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200402
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200402,
					"content": "#這下子功勞都歸{F#妳}{M#你}們了，這就是「先下手為強」嗎？…可惡，這個仇，我記下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200403
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200403,
					"content": "…嗯？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200404,
					"content": "等等，記仇？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200405
					]
				},
				{
					"id": 101200405,
					"content": "#是啊，我聽到這邊有很大的動靜，所以連忙趕過來，發現{F#妳}{M#你}正在和愚人眾戰鬥，還佔了上風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200406
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200406,
					"content": "如果我還不出手，別說是功勞，就連光都沾不上了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200407
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200407,
					"content": "#不過，幸好{F#妳}{M#你}沒有受傷，和這麼多愚人眾交戰，可是很危險的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200408,
						101200409
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200408,
					"content": "我習慣和愚人眾戰鬥了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200410
					]
				},
				{
					"id": 101200410,
					"content": "雖然聽不太懂，但妳是在關心我們的安危吧。謝謝妳。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200411
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200411,
					"content": "啊？為什麼我要關心仇人的安危啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200412
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200412,
					"content": "#可是妳剛剛說「幸好{F#妳}{M#你}沒有受傷」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200413
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200413,
					"content": "#喔，我的意思是，如果{F#妳}{M#你}們有人受傷了，我不但是被搶了功勞，還要負責把{F#妳}{M#你}們帶回蒙德城——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200414
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200414,
					"content": "#那{F#妳}{M#你}們就又給我添了一筆麻煩！這個仇就更是結下了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200415
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200415,
					"content": "居然是這樣解讀的嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200416
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200416,
					"content": "妳該不會就是優菈吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200417
					]
				},
				{
					"id": 101200417,
					"content": "對啊，沒錯。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200418
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200418,
					"content": "果然，我就覺得她怪怪的！雖然，也沒有怪到無法交流的程度…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200419
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200419,
					"content": "第一次見面就說陌生人「怪怪的」，就算不講貴族禮儀，在普通人之間也是很不禮貌的吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200420
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200420,
					"content": "#說起來，為什麼{F#妳}{M#你}們知道我的名字？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200421
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200421,
					"content": "#就是妳說的禮儀問題啦。{F#她}{M#他}是西風騎士團的榮譽騎士，我們正想調查一位名叫舒伯特·勞倫斯的貴族。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200422
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200422,
					"content": "可是他非常講究禮儀，完全不願意和我們說話。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200423
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200423,
					"content": "哈哈哈，我明白了。他是我的叔父，就是這樣的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200424
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200424,
					"content": "不過，為什麼要調查他呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200425
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200425,
					"content": "他好像和愚人眾有些密謀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200426
					]
				},
				{
					"id": 101200426,
					"content": "原來如此，哈哈，真是好膽量，當著我的面說我家人的壞話。這個仇又要記下一筆了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200427
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200427,
					"content": "不是啦，這個是琴團長的委託！而且只是懷疑而已！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200428,
						101200429
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200428,
					"content": "妳不好奇嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200430
					]
				},
				{
					"id": 101200430,
					"content": "在蒙德城的市民眼裡，勞倫斯家族都是壞人嘛，所以因為流言蜚語招致懷疑這種事情，一點都不奇怪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200431
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200431,
					"content": "嗯，有道理，畢竟以前是殘暴的統治者，名聲很不好嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200432
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200432,
					"content": "原來妳也是這麼想的…那我們這個仇，是徹底結下了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200433
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200433,
					"content": "明明是妳自己先說的耶？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200434
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200434,
					"content": "哈哈哈，有意思，有意思，第一次見面就能讓我記三次仇，我好久都沒有遇到這麼有意思的人了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200435,
						101200436
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200435,
					"content": "原來這是「有意思」的事嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200437
					]
				},
				{
					"id": 101200437,
					"content": "#{F#妳}{M#你}們來找我，是為了學習勞倫斯家的禮儀，這樣才能和我的叔父搭話對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200438
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200438,
					"content": "嗯，是安柏介紹我們來找妳的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200439
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 101200439,
					"content": "#沒問題，現在我就可以教{F#妳}{M#你}們。總之先回蒙德城吧，有人的地方比較方便訓練。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						101200440,
						101200441
					],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200440,
					"content": "但妳不是很會記仇嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200442,
					"content": "兩碼事、兩碼事。既是代理團長的委託，又是安柏的推薦，我不能不給面子啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "優菈"
				},
				{
					"id": 101200441,
					"content": "妳不會是想趁機報復吧？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200442
					]
				},
				{
					"id": 101200436,
					"content": "為什麼妳看起來很開心…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200437
					]
				},
				{
					"id": 101200429,
					"content": "妳不擔心嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200430
					]
				},
				{
					"id": 101200409,
					"content": "我可是很能打的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						101200410
					]
				}
			]
		},
