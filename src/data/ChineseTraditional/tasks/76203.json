					}
				]
			},
			"dialogs": [
				{
					"id": 762030301,
					"content": "銀白古樹？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030302
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030302,
					"content": "#哦，是這幅畫——{F#妳}{M#你}們對白樹已經不算陌生了，不過{F#妳}{M#你}們是否知道最初天使的背叛就是在白樹下？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030303,
						762030304
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030303,
					"content": "不太瞭解。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762030305
					]
				},
				{
					"id": 762030305,
					"content": "我有點好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030306,
					"content": "嗯，那就久違地講一個恐怖愛情故事好了。讓我保留一下當事人隱私…有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030307
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030307,
					"content": "#很久很久以前，有一位漫行於星間的旅者——和{NICKNAME}很不一樣，說來話長。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030308
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030308,
					"content": "一天，他前往銀樹之下拜訪晨星的公主，不出片刻就向她詢問起了王國最為禁忌的機密。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030309
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030309,
					"content": "他的言語令公主疑惑——他怎麼會知道那些不被神明許可之事呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030310
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030310,
					"content": "少年袒露了他的來歷，同時展現的還有公主從未見過的自由意志與崇高的精神之愛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030311
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030311,
					"content": "他的話語點醒了公主被神明禁錮的自我，她的心飛揚起來，越過了從未跨越的藩籬…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030312
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030312,
					"content": "晨星公主向少年傾吐了王國的秘密，兩人之間不僅萌生愛意，更萌生了反抗神明的決心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030313
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030313,
					"content": "到這裡為止，還算是個標準的愛情故事吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030314,
					"content": "恐怖的部分馬上就到。他們渴望幫助民眾獲得不被束縛的自由生命，但這種背叛不被神明容赦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030315
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030315,
					"content": "神明降下雷霆與怒火，毀滅了他們的居所。而當大戰平息後，公主永遠地失去了她的力量與智慧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030316
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030316,
					"content": "甚至就連那些曾與她親近的朋友，也被一併烙下了詛咒…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030317
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030317,
					"content": "呃…結尾的部分好嚇人啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030318
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030318,
					"content": "但我們先前是從最初的天使聊到這個故事的？妳說的該不會是真事吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030319,
					"content": "嗯哼，沒錯，那才是最嚇人的部分。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030320
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030320,
					"content": "嗯，那就久違地講一個恐怖愛情故事好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030321
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030321,
					"content": "讓我保留一下當事人隱私…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030322
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030322,
					"content": "有了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030304,
					"content": "好像聽說過…",
