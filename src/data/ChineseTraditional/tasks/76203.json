					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"尼可"
				],
				"points": [
					{
						"sceneId": 20360,
						"position": [
							589.654,
							904.556,
							494.111
						],
						"pointId": 5
					},
					{
						"sceneId": 20360,
						"position": [
							588.836,
							904.613,
							494.721
						],
						"pointId": 6
					},
					{
						"sceneId": 20360,
						"position": [
							589.08,
							904.586,
							495.725
						],
						"pointId": 7
					}
				]
			},
			"dialogs": [
				{
					"id": 762030201,
					"content": "呃啊，嚇我一跳！突然就被吸進畫裡了。等等，這場景好眼熟…是魔女們聚會的長桌！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030202
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030202,
					"content": "具體就要從我第一次被艾莉絲邀請參加茶會的時候說起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030203
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030203,
					"content": "不過，當天我並沒有親自出席，因為那時的我都沒有想好要不要正式加入魔女會。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030204
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030204,
					"content": "在場眾人只有艾莉絲知道我的真實身分，她事先提醒我不要說話、不要暴露馬腳，默默觀察大家就行。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030205
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030205,
					"content": "後來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030206,
					"content": "…後來我認定那是對我的猶豫的報復。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030207
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030207,
					"content": "大家的聊天內容那麼有趣，怎麼能忍住不插話呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030208
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030208,
					"content": "聊著聊著有人拋出了一個你明確知道答案的問題，又怎麼能忍住不分享呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030209
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030209,
					"content": "這就要說起艾莉絲和芭比洛斯的賭局、萊茵多特禁忌的創造、伊萬諾夫娜的政治手腕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030210
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030210,
					"content": "簡直是一幕幕濃縮在茶杯之中的美妙戲劇，光憑言語就觸動了我想要揭示真相的本能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030211
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030211,
					"content": "那妳在大家腦袋裡說話了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030212,
					"content": "怎麼會呢？就算憋到呼吸困難，我也仍然是一名負責任的天使，知道「想說」和「能說」之間的分別。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030213
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030213,
					"content": "所以到了最後，我也只是私底下找艾莉絲一口氣說了個痛快，順便答應了加入魔女會的事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030214
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030214,
					"content": "她對後者接受得很快，但前者嘛…她說她那幾天腦袋痛到去璃月找大夫了，可是這也不能全怪我啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				}
			]
		},
		{
