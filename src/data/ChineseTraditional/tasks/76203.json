					"尼可"
				],
				"points": [
					{
						"sceneId": 1156,
						"position": [
							19.232,
							0.278,
							-26.859
						],
						"pointId": 31
					},
					{
						"sceneId": 1156,
						"position": [
							19.488,
							0.278,
							-25.627
						],
						"pointId": 32
					},
					{
						"sceneId": 1156,
						"position": [
							21.366,
							0.278,
							-24.957
						],
						"pointId": 33
					}
				]
			},
			"dialogs": [
				{
					"id": 762030101,
					"content": "#哦，{F#妳}{M#你}們來了！我還想需不需要給{F#妳}{M#你}們什麼更明顯的指引呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030102
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030102,
					"content": "#但又想到提示太顯眼，反而容易打斷{F#妳}{M#你}們的旅行計畫…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030103
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030103,
					"content": "#就在我這麼猶豫的時候，{F#妳}{M#你}們像及時雨般出現了，可以說是皆大歡喜！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030104
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762030104,
					"content": "妳好啊，尼可，妳看起來精神真好！而且…今天也很健談呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762030105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762030105,
					"content": "那我就當作讚美收下了。好了，來下一個房間看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				}
			]
		},
		{
			"id": 7620302,
			"completionStepIds": [
				7620302
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
