			"dialogs": [
				{
					"id": 30230401,
					"content": "最近這些差事，難度可不小。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230402
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30230402,
					"content": "而且，這麼高難度的工作竟然不會帶來經濟收益，真不敢相信。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230403
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30230403,
					"content": "往好處想，說不定事成就發財了呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230404
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30230404,
					"content": "說得也是，唔，如果妳一夜之間變成富翁，想做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230405
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30230405,
					"content": "我想買很多很多好吃的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230406
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30230406,
					"content": "就這樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230407
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30230407,
					"content": "唔…再買點好喝的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230408
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30230408,
					"content": "哈哈哈，好可愛啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230409
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30230409,
					"content": "那麼，為了這些美好的幻想…我也會幫忙的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230410
					],
					"speakerTitle": "迪希雅"
				},
				{
					"id": 30230410,
					"content": "希望接下去我們要做的一切都能讓這個世界變好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "迪希雅"
