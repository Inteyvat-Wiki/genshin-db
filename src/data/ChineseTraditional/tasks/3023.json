				},
				{
					"id": 30230202,
					"content": "慢慢想，保證計畫的合理性。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230203
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30230203,
					"content": "說著又開始看書了，喂！你這個人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230204
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30230204,
					"content": "要我借本書給妳嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230205
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30230205,
					"content": "不要啦，你的書都不適合我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 30230206,
					"content": "騙妳的。我的書確實不適合妳，恕不外借。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230207
					],
					"speakerTitle": "艾爾海森"
				},
				{
					"id": 30230207,
					"content": "啊——！氣死我了…",
