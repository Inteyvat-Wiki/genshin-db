			},
			"dialogs": [
				{
					"id": 30230301,
					"content": "如果有什麼我能為你們做的，一定要告訴我。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230302
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 30230302,
					"content": "雖然無法離開阿如村，但看到你們的樣子，不知為什麼…我心跳加速了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230303
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 30230303,
					"content": "過去獨自一人面對戰鬥，我都沒有像今天這樣沸騰…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						30230304
					],
					"speakerTitle": "坎蒂絲"
				},
				{
					"id": 30230304,
					"content": "我想，這就是同伴的力量吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "坎蒂絲"
				}
			]
		},
