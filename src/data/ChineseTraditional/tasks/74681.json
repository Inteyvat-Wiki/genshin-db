	"talks": [
		{
			"id": 7468101,
			"completionStepIds": [
				7468101
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7468101",
							"2"
						],
						"stepId": 7468101,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"梅里愛"
				],
				"points": [
					{
						"sceneId": 3,
						"position": [
							3417.103,
							449.586,
							4461.122
						],
						"pointId": 340100475
					}
				]
			},
			"dialogs": [
				{
					"id": 746810101,
					"content": "#啊哈！啊哈哈哈哈哈哈哈哈哈…散發著耀眼光芒的兩位客人，{F#妳}{M#你}們終於來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810102
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810102,
					"content": "#{F#妳}{M#你}們想必就是提瓦特今日的傳說冒險家，明日的超級巨星——{NICKNAME}和派蒙吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810103,
						746810105
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810103,
					"content": "正是我們！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810104
					]
				},
				{
					"id": 746810104,
					"content": "我們的確在冒險家協會很有名氣，但要說是全提瓦特的超級巨星…好像太過火了？畢竟也有很多人不認識我們…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810107
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810107,
					"content": "印象中一見面就大肆誇我們的人…基本上都是要找我們幫忙的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810108,
					"content": "那妳就直說吧，妳的需求是什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810109,
					"content": "#不不不，我並非有求於兩位，而是要為{F#妳}{M#你}們提供一個雙贏的機會——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810110
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810110,
					"content": "與我——楓丹才華最為洋溢的「實驗映影」導演梅里愛合作，成為映幕上最為閃亮的存在！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810111
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810111,
					"content": "#到時{F#妳}{M#你}們要錢有錢，要人脈有人脈。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810112
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810112,
					"content": "#無論身處在提瓦特何方，橫著走都沒有人敢攔，甚至會有人為{F#妳}{M#你}們鋪紅地毯！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810113,
						746810114
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810113,
					"content": "想要橫著走偶爾還需要拳頭…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810115
					]
				},
				{
					"id": 746810115,
					"content": "可是我們也沒有多少出演映影的經驗，如果我們隨便跟妳合作一下就有辦法成名的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810116
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810116,
					"content": "那妳為什麼還沒成為超級厲害的導演呢？以前跟妳合作的大明星又在哪裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810117,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810118
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810118,
					"content": "嘖，被看穿了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810119
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810119,
					"content": "要是有人專門辦一所培養演員的學校就好了！我實在需要又能打、又能好好管理表情，會用充沛的情感演繹臺詞的萬能演員。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810120
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810120,
					"content": "但這種天才是不存在的！我的實驗映影只完成了文戲的規劃，打戲根本連個影子都還沒有…第一部作品也都還沒完成…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810121
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810121,
					"content": "#所以我迫不得已只好使用「打鬥替身」方案，顯然{F#妳}{M#你}們兩位就是最佳的人選！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810122,
						746810123
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810122,
					"content": "「打鬥替身」是字面上的意思？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810124
					]
				},
				{
					"id": 746810124,
					"content": "哦，好聰明！這樣的確可以解決演員不會戰鬥的問題呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810125
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810125,
					"content": "戰鬥的話我們倒是很熟練，但不會出現…我們的臉和其他演員對不起來的問題嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810126
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810126,
					"content": "理論上的確會這樣，但現在看來我的實驗映影裡，打鬥的部分更重要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810127
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810127,
					"content": "#如果{F#妳}{M#你}們的表現出色，我就把文戲的部分都改成剪影好了，臺詞本來也不多——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810128
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810128,
					"content": "#再好好幫其他演員化妝，把側影的輪廓扮成{F#妳}{M#你}們的樣子，最後經過燈光處理之後觀眾也看不出差異。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810129
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810129,
					"content": "#當然，這樣一來反而就是文戲演員變成{F#妳}{M#你}們的替身了，他們本來也沒有{F#妳}{M#你}們出名，我還會付{F#妳}{M#你}們冠名費哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810130
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810130,
					"content": "所以說…如果我們跟妳合作，就可以直接賺到…那個叫什麼…主角的位置？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810131
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810131,
					"content": "還有可觀的酬勞，和不可估量的名分！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810132
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810132,
					"content": "#那我們好像真的滿賺的？{F#妳}{M#你}覺得呢，{NICKNAME}？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810133,
						746810134
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 746810133,
					"content": "不賺白不賺！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810135
					]
				},
				{
					"id": 746810135,
					"content": "#由衷感謝{F#妳}{M#你}們的支持！太完美了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810136
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810136,
					"content": "#那事不宜遲，就請{F#妳}{M#你}們直接前往我的實驗映影棚吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810137
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810137,
					"content": "在我的這部實驗映影中，共有氣氛完全不同的四個打鬥橋段，每個橋段也都會用到不同的「特技光效」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810138
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810138,
					"content": "在「特技光效」期間，打戲的表現會按照對應的劇本，變得更加誇張…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810139
					],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810139,
					"content": "#以{F#妳}{M#你}們的經驗絕對可以一下就理解重點，迅速地拍完所有鏡頭，然後順利殺青！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "梅里愛"
				},
				{
					"id": 746810134,
					"content": "演演試試看！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810135
					]
				},
				{
					"id": 746810123,
					"content": "要我們代替演員拍打鬥的橋段？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810124
					]
				},
				{
					"id": 746810114,
					"content": "橫著走不舒服…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810115
					]
				},
				{
					"id": 746810105,
					"content": "妳有何事？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						746810106
					]
				},
				{
					"id": 746810106,
					"content": "好誇張的語氣，還用了奇奇怪怪的形容詞…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						746810107
					],
					"speakerTitle": "派蒙"
				}
			]
		}
	]
}