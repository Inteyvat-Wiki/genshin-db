				"points": []
			},
			"dialogs": [
				{
					"id": 718020201,
					"content": "不錯，確實是我造「雲中仙居」時所著的圖紙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020202
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 718020202,
					"content": "您到底拿這圖紙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020203
					]
				},
				{
					"id": 718020203,
					"content": "#{F#妳}{M#你}怎麼還在問？算了，看在{F#妳}{M#你}供奉於我的份上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020204
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 718020204,
					"content": "我聽說，這璃月港裡的凡人也造了一座能浮於空中的樓閣「群玉閣」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020205
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 718020205,
					"content": "我還聽人說，凡人只憑大小，就斷定這「群玉閣」舉世無雙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020206
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 718020206,
					"content": "哼，真是凡人眼界，不識得仙家巧妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020207
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 718020207,
					"content": "區區「群玉閣」…本仙略展機巧，就讓它黯然失色！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020208
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 718020208,
					"content": "您是…不服氣？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020209
					]
				},
				{
					"id": 718020209,
					"content": "#不服氣？{F#妳}{M#你}說什麼怪話，本仙只是可憐凡人不識得仙家巧妙，被一些凡間拙技蒙了眼目。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020210
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 718020210,
					"content": "長此以往，只怕凡間機關之術要走上歧途，本仙是準備親自點撥他們一番罷了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020211
					],
					"speakerTitle": "留雲借風真君"
				},
				{
					"id": 718020211,
					"content": "#好了，此事已了，{F#妳}{M#你}們趕緊離開吧，莫再擾本仙的清淨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "留雲借風真君"
				}
			]
		},
		{
			"id": 7180203,
			"completionStepIds": [
				7180207
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7180207",
							"2"
						],
						"stepId": 7180207,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718020301,
					"content": "有什麼事，快點說，還有諸多事宜等著本仙去籌備，莫要再耽誤時間了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020302
					],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020302,
					"content": "只是向您問好。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020303
					]
				},
				{
					"id": 718020303,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020304
					],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020304,
					"content": "#{F#妳}{M#你}們倒是新奇…不為許願，只是想問個好？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020305
					],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020305,
					"content": "#罷了，隨{F#妳}{M#你}們的願吧，凡人的心思，我向來是懶得揣測的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020306
					],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020306,
					"content": "#如果{F#妳}{M#你}們真的如此之閒，不如就來幫本仙個忙怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020307
					],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020307,
					"content": "昔日，我研習機關術略有小成時，曾造了一座「雲中仙居」浮於空中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020308
					],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020308,
					"content": "#這「雲中仙居」以浮生石為材，輔以萬般機巧，最妙的是其中…算了，和{F#妳}{M#你}們說了{F#妳}{M#你}們也不懂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020309
					],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020309,
					"content": "我在造好「雲中仙居」之後，也把圖紙留在了上面。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020310
					],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020310,
					"content": "本仙在上面略施封印，本來想的是有緣者得之，但這麼久了，封印也沒被觸動過。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020311
					],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020311,
					"content": "#本仙也懶得將這圖紙放在那了，{F#妳}{M#你}們就幫我去「雲中仙居」把這圖紙拿回來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020312,
						718020314
					],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020312,
					"content": "我知道了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020313
					]
				},
				{
					"id": 718020313,
					"content": "#{F#妳}{M#你}倒是爽快，那就快去吧。拿到了就送進洞府來，本仙就在洞府裡等著{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020314,
					"content": "您拿這圖紙做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718020315
					]
				},
				{
					"id": 718020315,
					"content": "#我自有用意，和{F#妳}{M#你}說了{F#妳}{M#你}也不明白。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020316
					],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020316,
					"content": "#快去吧。拿到了就送進洞府來，本仙就在洞府裡等著{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叩訪仙府"
				}
			]
		},
		{
