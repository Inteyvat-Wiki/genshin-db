			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 718021001,
					"content": "絕雲訪仙，絕非易事。汝等來此叩訪…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021002
					],
					"speakerTitle": "叩訪仙府",
					"speakerSubtitle": "…聲音似乎不太對？"
				},
				{
					"id": 718021002,
					"content": "嗚哇！她、她不是已經去璃月港了嗎？難道是又悄悄回來了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021003
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021003,
					"content": "感覺…聲音不太對？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021004
					]
				},
				{
					"id": 718021004,
					"content": "那個…仙君，我們是擔心有人去妳家偷東西，沒有打擾妳的意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021005
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021005,
					"content": "…本仙有善務一件，如能妥善處之，便可入得仙府。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021006,
						718021007
					],
					"speakerTitle": "叩訪仙府",
					"speakerSubtitle": "…聲音似乎不太對？"
				},
				{
					"id": 718021006,
					"content": "自顧自地說下去了…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021008
					]
				},
				{
					"id": 718021008,
					"content": "#欸？{F#妳}{M#你}是說，現在和我們說話的不是留雲真君，而是她留下的機關？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021009
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021009,
					"content": "昔日，我研習機關術略有小成時，曾造了一座「雲中仙居」浮於空中。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021010
					],
					"speakerTitle": "叩訪仙府",
					"speakerSubtitle": "…聲音似乎不太對？"
				},
				{
					"id": 718021010,
					"content": "「雲中仙居」善成後，本仙念在仙緣難得，便將圖紙留於其上，有緣者自取之。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021011
					],
					"speakerTitle": "叩訪仙府",
					"speakerSubtitle": "…聲音似乎不太對？"
				},
				{
					"id": 718021011,
					"content": "#{F#妳}{M#你}且去取來圖紙，再入仙府詳述。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021012
					],
					"speakerTitle": "叩訪仙府",
					"speakerSubtitle": "…聲音似乎不太對？"
				},
				{
					"id": 718021012,
					"content": "仙君？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021013
					]
				},
				{
					"id": 718021013,
					"content": "留雲真君？閒…閒雲小姐？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021014
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021014,
					"content": "#{F#妳}{M#你}且去取來圖紙，了此善務，再入仙府詳述。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021015
					],
					"speakerTitle": "叩訪仙府",
					"speakerSubtitle": "…聲音似乎不太對？"
				},
				{
					"id": 718021015,
					"content": "完全不理我們嘛…還是自顧自地說個沒完…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021016,
						718021017
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021016,
					"content": "絕對是機關。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021018
					]
				},
				{
					"id": 718021018,
					"content": "可是，通常守衛洞府的不應該是那種…會砰砰砰打人的機關嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021019,
						718021020
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021019,
					"content": "也許她有自己的考量吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021021
					]
				},
				{
					"id": 718021021,
					"content": "不然我們去把那個圖紙拿到手，然後再進洞府看看吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021022
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021022,
					"content": "嘿嘿，我也有點好奇她到底在洞府裡放了什麼機關。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021020,
					"content": "有點在意那個圖紙…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021021
					]
				},
				{
					"id": 718021017,
					"content": "開始複述最後一句了呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021018
					]
				},
				{
					"id": 718021007,
					"content": "難道這聲音是什麼機關…",
					"roleType": "TALK_ROLE_PLAYER",
