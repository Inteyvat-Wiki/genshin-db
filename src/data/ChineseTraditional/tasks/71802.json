			},
			"dialogs": [
				{
					"id": 718020401,
					"content": "#{F#妳}{M#你}們還沒拿到圖紙嗎？就在「雲中仙居」上…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020402
					],
					"speakerTitle": "叩訪仙府"
				},
				{
					"id": 718020402,
					"content": "咦，她怎麼知道我們還沒拿到圖紙的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718020403
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718020403,
					"content": "那圖紙是本仙親著，在不在近前本仙難道不知道嗎？快點去拿圖紙吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "叩訪仙府"
				}
			]
		},
		{
