						718021303
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021302,
					"content": "是仙人桌子。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021304
					]
				},
				{
					"id": 718021304,
					"content": "#能到達此地，本仙已知{F#妳}{M#你}本心…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021305
					],
					"speakerTitle": "留雲借風真君…？"
				},
				{
					"id": 718021305,
					"content": "又說話了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021306
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021306,
					"content": "記述所願，納入匣內。本仙自會定奪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021307
					],
					"speakerTitle": "留雲借風真君…？"
				},
				{
					"id": 718021307,
					"content": "…履難歷險，矢志不移，心志堅韌實為難得。這些寶貨可自取走。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021308
					],
					"speakerTitle": "留雲借風真君…？"
				},
				{
					"id": 718021308,
					"content": "好欸！嘿嘿，我就知道仙君不會讓我們白跑嘛。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021309,
					"content": "不過，這個聲音說「記述所願，納入匣內」…是要我們把願望寫下來放進匣子裡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021310,
						718021311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021310,
					"content": "還是不要隨便向仙人許願啦…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021312
					]
				},
				{
					"id": 718021312,
					"content": "好吧…也對，要是我們有什麼事，直接去找留…閒雲小姐商量就好了，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021313
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021313,
					"content": "那我們就把圖紙放進匣子裡，然後離開這裡吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021314
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021314,
					"content": "但周圍空蕩蕩的，什麼也沒有。應該是真君把東西都拿走了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021315
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021315,
					"content": "這些機關是為了應對什麼情況呢…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021316
					]
				},
				{
					"id": 718021316,
					"content": "我也不明白…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						718021317
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021317,
					"content": "總之，等我們下次見到真君的時候，再向她問問洞府的事吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 718021311,
					"content": "向熟人許願，總覺得…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						718021312
					]
				},
