			"dialogs": [
				{
					"id": 762020201,
					"content": "歡迎光臨。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020202,
						762020203
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020202,
					"content": "妳好啊，尼可。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				},
				{
					"id": 762020204,
					"content": "哇，好華麗氣派的屋子，妳裝潢得很漂亮嘛！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020205,
					"content": "哼哼，真有眼光，不枉費我這些日子裡雖然是抽空但也很用心做的設計。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020206
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020206,
					"content": "具體就要從這座秘密小屋建成之日說起了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020207
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020207,
					"content": "我本來想趁手感不錯多去修建幾座魔女小屋，但沒人幫忙提供新的靈感，久了又覺得沒動力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020208
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020208,
					"content": "「就沒有既有趣又好玩，還能得到成就感的做法嗎？」我的腦海中咻地閃過了答案。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020209
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020209,
					"content": "等下，直接到答案了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020210,
					"content": "#話不等人啊。喏，它就在{F#妳}{M#你}們的眼前。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020211
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020211,
					"content": "這扇門後？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020212
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020212,
					"content": "其實不只這扇門，但也不算錯，總要有個先後順序，那就從它開始吧——準備好了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020213
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020213,
					"content": "等…等一下，妳語速太快了，我有點跟不上…妳要我們準備什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020214
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020214,
					"content": "#噢，別緊張，什麼都不用{F#妳}{M#你}們準備。我就象徵性地問一聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020215
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020215,
					"content": "#憑我的觀察和對{F#妳}{M#你}們的瞭解…比起複雜的事先說明和解釋，{F#妳}{M#你}們更喜歡在探索過程中挖掘樂趣吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020216,
						762020217
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020216,
					"content": "是沒說錯…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020218,
					"content": "哈哈，這話我愛聽，那我就真的真的不客氣囉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020219
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020219,
					"content": "#{NICKNAME}，{F#妳}{M#你}是瞭解我們天使的，引導人尋找寶藏的那份滿足感向來叫我們無法自拔。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020220
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020220,
					"content": "既然一樣要與人為善、助人為樂，怎麼能不先想想自己的朋友呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020221
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020221,
					"content": "#於是我靈機一動，把小屋打造成了可供{F#妳}{M#你}們休閒玩耍的遊樂屋，還把寶物分別藏進了每個房間裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020222
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020222,
					"content": "實不相瞞，即使是在眾多天使之中，我也是藏東西的好手哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020223
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020223,
					"content": "#真的要我去外面認認真真埋一個寶箱，還不為{F#妳}{M#你}們帶路的話，只恐怕{F#妳}{M#你}們花上幾個月都找不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020224
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020224,
					"content": "咳咳，說遠了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020225
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020225,
					"content": "#總之，我不會故意為難{F#妳}{M#你}們，也不需要{F#妳}{M#你}們為了我的小小愛好在荒郊野嶺東奔西跑…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020226
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020226,
					"content": "只要在房間裡找到三片象徵寶物的羽毛就可以過關了！到了那個時候，嘿嘿，請務必在我面前打開寶箱！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020227
					],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020227,
					"content": "這下我全聽懂了！寶藏，我等不及了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						762020228
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 762020228,
					"content": "寶藏，我也等不及了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "尼可"
				},
				{
					"id": 762020217,
					"content": "但還是想聽一下尼可的說明。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020218
					]
				},
				{
					"id": 762020203,
					"content": "很榮幸來這裡做客。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						762020204
					]
				}
			]
		},
