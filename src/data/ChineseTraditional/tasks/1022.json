			"dialogs": [
				{
					"id": 10220401,
					"content": "是時候一展歌喉了，加油！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220402
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220402,
					"content": "咳咳。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220403
					]
				},
				{
					"id": 10220403,
					"content": "♪…♪♪♪♪…♪♪♪♪…♪♪",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
			]
		},
		{
			"id": 102206,
			"completionStepIds": [
				102206
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102206",
							"2"
						],
						"stepId": 102206,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220601,
					"content": "它們根本不是琉璃百合，琉璃百合怎麼會打人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220602
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220602,
					"content": "超乎想像的敵人…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220603
					]
				},
				{
					"id": 10220603,
					"content": "這是一種叫做「騙騙花」的魔物。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220604
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220604,
					"content": "嗯？這些花瓣…？有點意思。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220605
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220605,
					"content": "用於偽裝的琉璃百合，與「騙騙花」一起埋了太久，反倒成了極好的藥材。因禍得福…把這些花瓣收起來吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220606
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220606,
					"content": "還有這種好事？那這些花瓣可以用在送仙典儀上嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220607
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220607,
					"content": "很遺憾，不能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220608
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220608,
					"content": "啊，怎麼這樣——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220609
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220609,
					"content": "請問…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220610
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220610,
					"content": "你們是在找琉璃百合嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220611
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220611,
					"content": "啊！是妳！呃、呃…糟糕，想不起名字…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220612,
						10220614
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220612,
					"content": "妳好啊，甘雨。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220613
					]
				},
				{
					"id": 10220613,
					"content": "#{F#妳}{M#你}好，旅行者，沒想到{F#妳}{M#你}還記得我的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220617,
					"content": "說起來，二位的「群玉閣」之行，感受如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220618
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220618,
					"content": "因為妳沒告訴我們怎麼上去，所以我們費了好大力氣才找到路呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220619
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220619,
					"content": "哎哎哎？我、我沒說嗎？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220620
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220620,
					"content": "我們靠自己打聽來的！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220621,
						10220622
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220621,
					"content": "因為並不是秘密，所以沒提吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220623,
					"content": "是…是的呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220624
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220624,
					"content": "（完了，我竟然忘記說了…）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220625
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220625,
					"content": "嗯？感覺甘雨臉色不太對勁的樣子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220626
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220626,
					"content": "而且比起第一次見面的時候，連氣質也不太一樣…好像沒有當時的那種嚴肅感了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220627
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220627,
					"content": "啊…因為那時是「天權星使者」的身分，但現在只是在看花。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220628
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220628,
					"content": "看花？為什麼不在城裡看，要跑到這種地方來呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220629
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220629,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220630
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220630,
					"content": "玉京臺是帝君逝去之地，在那裡看花，是很令人寂寞的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220631
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220631,
					"content": "最近這幾天，我在玉京臺附近辦公時，都會把窗戶關上，以免望見窗外的風景…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220632
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220632,
					"content": "唔…對不起，我不該提起這個話題。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220633
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220633,
					"content": "不…是我自己沒能整理好自己的心情。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220634
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220634,
					"content": "兩千年前魔神戰爭結束，最初的七神曾在璃月相聚，與帝君對飲…而今神位更迭，酒會上的七神已逝五神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220635
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220635,
					"content": "也就是說…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220636
					]
				},
				{
					"id": 10220636,
					"content": "是的，既然帝君魂歸高天，那最初的七神，就只剩蒙德的巴巴托斯大人尚在塵世了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220666
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220666,
					"content": "其餘五位，包括稻妻的那位雷電將軍，都已不是兩千年前的故人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220637
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220637,
					"content": "現今的「塵世七執政」，須彌的草之神最年輕，只有五百歲。而岩王帝君在世最久，已有六千餘年。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220638
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220638,
					"content": "所以，三千七百年歷史的璃月，從建立之初就已是帝君統治，從未經歷過與神靈的「辭行」…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220639
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220639,
					"content": "那麼，妳對這場「辭行」，有何看法？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220640
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220640,
					"content": "哎？突然這麼問，我也…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220641
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220641,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220642
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220642,
					"content": "作為「人」，我至今也無法想像，失去了帝君的璃月會變成什麼樣…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220643
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220643,
					"content": "但作為「仙」…我想，我遲早還是會接受事實的。既然帝君逝去，那麼仙神與璃月立下「契約」的時代，在事實上就已走向終結了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220644
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220644,
					"content": "嗯？妳說…作為「仙」？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220645
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220645,
					"content": "我…我是人類與麒麟的混血，有一半仙人的血統，在魔神戰爭時也為帝君、為璃月出過一份力。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220646
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220646,
					"content": "戰爭終結以後，我與帝君簽下「契約」，開始擔任歷代七星的秘書，就這樣一直到了今天。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220647,
						10220648
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220647,
					"content": "怪不得妳腦袋上有角！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220649,
					"content": "咳…咳咳。還是聊些其他的吧。你們剛才說，是來找琉璃百合…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220650
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220650,
					"content": "我也知道野生琉璃百合所藏的位置，剛好摘了一株。不嫌棄的話，請收下它。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220651
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220651,
					"content": "那就恭敬不如從命了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220652
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220652,
					"content": "欸？那妳摘之前唱過歌了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220653
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220653,
					"content": "是的，這種傳統我自然也很清楚。請放心，我唱的是璃月本地的民謠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220654
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220654,
					"content": "哇，妳也很內行呢。謝謝妳，甘雨！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220655
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220655,
					"content": "不，是我該感謝你們。若不是這次偶遇，我也沒想到自己能為「辭行久遠之軀」的儀式，送上一份心意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220656
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220656,
					"content": "我該回去工作了，祝你們一切順利。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220657
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220657,
					"content": "這樣一來，「送仙典儀」所需的各種籌備，基本上都完成了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220658
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220658,
					"content": "摘花這件事，在各種意義上都很方便，做起來沒有困難，所以才把它留在了最後。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220659
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220659,
					"content": "鍾離的性格，是適合開荒的類型。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220660
					]
				},
				{
					"id": 10220660,
					"content": "嗯，他要是在璃月做生意的話，應該會很享受創業的生活吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220661
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220661,
					"content": "哈哈…我也確實有過那種日子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220662
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220662,
					"content": "創業、開荒…萬事開頭難，投注的情感也多。等到一切運轉如常，久而久之，情感就會逐漸「磨損」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220663
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220663,
					"content": "「磨損」得多了，就要重新審視自己。若不小心處理，靈魂就會留下裂紋，無法挽回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220664
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220664,
					"content": "看吧！這種語氣，一聽就是過來人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220665
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220665,
					"content": "好了，既然事情都搞定了，我們也該回璃月港啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220648,
					"content": "難怪妳會忘記說該說的事！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220649
					]
				},
				{
					"id": 10220622,
					"content": "我們不該走冤枉路，問一下就好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220623
					]
				},
				{
					"id": 10220614,
					"content": "妳好啊，王小美。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220615
					]
				},
				{
					"id": 10220615,
					"content": "王小美？那、那是誰啊？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220616
					],
					"speakerTitle": "甘雨"
				},
				{
					"id": 10220616,
					"content": "甘雨和王小美，根本一個字都沒記對吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220617
					],
					"speakerTitle": "甘雨"
				}
			]
		},
		{
			"id": 102208,
			"completionStepIds": [
				102208
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102208",
							"2"
						],
						"stepId": 102208,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲利克斯"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220801,
					"content": "喔，是「往生堂」的客卿，鍾離先生吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220802
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220802,
					"content": "千岩軍正在對我們嚴加監視，現在是非常時期，你可別輕舉妄動。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220803
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220803,
					"content": "非常時期？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220804
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220804,
					"content": "「絕雲間」的仙人終於動身了。他們此來，恐怕來意不善。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220805
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220805,
					"content": "是為興師問罪嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220806
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220806,
					"content": "多半是這樣。聽說七星中的幾位，早早地帶人前去迎接…嘿，說是迎接，不如說想要把仙人阻攔在城外吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220807
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220807,
					"content": "但雙方態度都很強硬，一時陷入了僵局。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220808
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220808,
					"content": "…事情走到這一步，也是必然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220809
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220809,
					"content": "仙人不認七星，只認與岩神的「契約」。如果他們決定強攻，這璃月港恐怕是擋不住的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220810
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220810,
					"content": "但「璃月七星」也不是坐以待斃的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220811
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220811,
					"content": "哼，誰不知道他們態度強硬？但就因為這樣，人和仙的矛盾才會一觸即發！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220812
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220812,
					"content": "然後呢？怎麼「愚人眾」反倒成了眾矢之的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220813
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220813,
					"content": "呼…還不是因為那個凝光…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220814
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220814,
					"content": "說什麼「在這山雨欲來的時刻，要千岩軍徹底控制愚人眾的動向」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220815
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220815,
					"content": "切！現在才想起來要限制我們的行動？七星也不過如此！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220816
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220816,
					"content": "總之，鍾離先生，你是「公子」大人的合作者，你的態度也有一半是我們的態度，可別讓人抓到把柄。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220817
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220817,
					"content": "看來，璃月港裡的各種矛盾，都已經徹底達到極限了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220818,
						10220819
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220818,
					"content": "我們能做些什麼嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				},
				{
					"id": 10220820,
					"content": "#{F#妳}{M#你}的意思是，想要憑特殊的中立身分出面調解？還是想要靠{F#妳}{M#你}個人的武力改變某些平衡？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220821
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220821,
					"content": "這兩條路，恐怕都不那麼容易吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220822
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220822,
					"content": "啊，對了！鍾離先生。我聽說你們「往生堂」，好像也被捲進了衝突裡，正在與找上門來的官軍對峙呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220823
					],
					"speakerTitle": "菲利克斯"
				},
				{
					"id": 10220823,
					"content": "…這可不妙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220824
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220824,
					"content": "我得先走一步，去往生堂看看了，希望胡堂主暫時應付得來…可別鬧出什麼大亂子。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220825
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220825,
					"content": "#旅者，{F#妳}{M#你}也再思考一下吧。在我看來，想要阻止一觸即發的爆炸，不如先想想「引信」在哪。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220827
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220827,
					"content": "呼…當「愚人眾」的「道上朋友」，看來既有好處，也有麻煩呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220828
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220828,
					"content": "所以，剛才鍾離說的「引信」，是指什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220829,
						10220830,
						10220831
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220829,
					"content": "「公子」。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220832,
					"content": "原來如此！我…我好像也明白了。嗯，要說誰最盼著這種滿城大亂的情況，我的第一反應也是他了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220833
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220833,
					"content": "這傢伙，一定是趁著所有人都沒空管他的時候，去做什麼壞事了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220834
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220834,
					"content": "可是，現在該到哪裡找他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220835
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220835,
					"content": "在所有混亂都變得…特別混亂的時候，他會去哪裡呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220836,
						10220837
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220836,
					"content": "跟我來。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220837,
					"content": "他會去的地方，只有一個。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 10220830,
					"content": "那個橙色頭髮的男人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220831,
					"content": "一路上幫我們買單的冤大頭。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220832
					]
				},
				{
					"id": 10220819,
					"content": "我不想袖手旁觀。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220820
					]
				}
			]
		}
	]
}