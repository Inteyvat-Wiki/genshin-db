			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220201,
					"content": "這裡有好多符咒，還有好幾疊空白的紙，會是做什麼用的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220202,
						10220203
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220202,
					"content": "看起來是在抄寫符咒上的圖案。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				},
				{
					"id": 10220204,
					"content": "這上面的圖案，似乎在哪見過…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220205
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220205,
					"content": "#我想起來了，「公子」給{F#妳}{M#你}的那張「百無禁忌籙」，確實也長這樣呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220206
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220206,
					"content": "嗯…這種和仙人有關的信物，為什麼會落到「公子」手裡，也確實相當可疑。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220207
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220207,
					"content": "而且，不止是「信物」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220208
					]
				},
				{
					"id": 10220208,
					"content": "對哦，留雲借風真君說過，岩王爺當年造「百無禁忌籙」的時候，不是當作信物來用的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220209
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220209,
					"content": "這種符咒最初的用途，是在魔神戰爭當中，用來發揮神力…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220210
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220210,
					"content": "愚人眾這樣抄寫「百無禁忌籙」，是想嘗試用什麼方法來引導出類似真品的效果嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220211
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220211,
					"content": "在戰爭中發揮神力的效果…唔，聽起來很兇險。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220212,
						10220213
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220212,
					"content": "看來愚人眾還有大計畫。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220214,
					"content": "真複雜…總之，以後要對「公子」更多防備一些了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220215
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220215,
					"content": "好了，在這裡耗了這麼久，和鍾離約好再見的時間也差不多快到了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220216
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220216,
					"content": "「送仙典儀籌辦之旅」的最後一站…記得是在荻花洲吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220217
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220217,
					"content": "快走吧，別遲到啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220213,
					"content": "給我的那張，只是大計畫的副產物吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220214
					]
				},
				{
					"id": 10220203,
					"content": "可能是想複製真品。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220204
					]
				}
			]
		},
		{
			"id": 102203,
			"completionStepIds": [
				102203
			],
			"beginWay": "TALK_BEGIN_AUTO",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"102203",
							"2"
						],
						"stepId": 102203,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"鍾離"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 10220301,
					"content": "#{F#妳}{M#你}們很準時嘛，我也剛到不久。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220302
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220302,
					"content": "群玉閣好玩嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220303
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220303,
					"content": "超——大！超華麗，超貴，是我見過最貴的建築！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220304
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220304,
					"content": "確實。群玉閣若稱第二，璃月便無人敢稱第一。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220305
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220305,
					"content": "#{F#妳}{M#你}們應該見過凝光了。聊得如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220306
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220306,
					"content": "她好有錢，好慷慨，是很親切的人！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220307
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220307,
					"content": "但「親切」也是商人的武器。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220308
					]
				},
				{
					"id": 10220308,
					"content": "#嗯…{F#她}{M#他}對凝光的看法和我不一樣。{F#她}{M#他}覺得，還是那位說話過於直白的「玉衡星」更加可信一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220309
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220309,
					"content": "#哦？{F#妳}{M#你}們還遇到刻晴了？她對{F#妳}{M#你}們說了什麼嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220310
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220310,
					"content": "她說，「『仙人』的時代已經過去了，如果連『璃月七星』都不敢正視這一點，那璃月的未來要怎麼辦啊？」",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220311
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220311,
					"content": "哈哈哈…不敬仙神。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220312
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220312,
					"content": "的確，比起什麼話都敢說的刻晴，同為七星，還是凝光更像一位典型的商人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220313
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220313,
					"content": "#雖然親切，但{F#妳}{M#你}無法確定她是百分之百的真誠。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220314,
						10220315
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220314,
					"content": "凝光是個有謀略的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				},
				{
					"id": 10220316,
					"content": "嗯，她能坐上今天的位置，全靠自己。這樣的人物，必定有其超凡之處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220317
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220317,
					"content": "我聽說，不斷擴建的「群玉閣」正是她志向的體現，是她人生中第二重要的東西。哪怕放棄天權之位，她也不會放棄群玉閣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220318
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220318,
					"content": "群玉閣是第二位？那排第一位的呢？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220319
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220319,
					"content": "當然是摩拉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220320,
						10220321
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220320,
					"content": "很有道理。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220322,
					"content": "對了，她找我們說的最多的事，是關於「愚人眾」的。她說帝君遇害以後，愚人眾一直在璃月攪混水，可壞了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220323
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220323,
					"content": "「愚人眾」歷來如此，我一點都不覺得意外。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220324
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220324,
					"content": "而且他們正在仿製百無禁忌籙。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220325
					]
				},
				{
					"id": 10220325,
					"content": "……",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220326
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220326,
					"content": "不論「愚人眾」在圖謀什麼，總之，與他們打交道時，凡事都多留個心眼吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220327
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220327,
					"content": "說起來，荻花洲也有送仙典儀要用的東西嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220328
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220328,
					"content": "對，我們今天要找的是野生的琉璃百合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220329
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220329,
					"content": "琉璃百合？為什麼要來這裡找啊？明明玉京臺的園林裡就有很多…我聽說輕策莊也有一些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220330
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220330,
					"content": "對了，我記得我們遇到萍姥姥的時候，她就在看花。不如直接去問萍姥姥要吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220331
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220331,
					"content": "不…那都是人工培育的，並不適合。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220332
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220332,
					"content": "琉璃百合曾經大量生長在荻花洲，是一種歡欣的花，會聆聽人們的歌聲。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220333
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220333,
					"content": "魔神戰爭前，荻花洲還是片陸地。是戰爭引來山崩，才讓這裡被大水淹沒，變為濕地，令琉璃百合幾乎絕種。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220334
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220334,
					"content": "現在，城裡還保留了一些人工培育的品類。但只有極少數人知道，其實野生琉璃百合還沒完全滅絕…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220335
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220335,
					"content": "這種琉璃百合香氣濃郁，碾成粉末以後放在永生香的香爐裡，才是完整的「送仙」傳統。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220336
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220336,
					"content": "#不過，想採這種花，還需要{F#妳}{M#你}的幫助。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220337,
						10220339
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220337,
					"content": "需要我勞動嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220338
					]
				},
				{
					"id": 10220338,
					"content": "#不，我要{F#妳}{M#你}對那些花唱歌，來提升它的香氣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220341,
					"content": "#呃…{NICKNAME}，{F#妳}{M#你}唱歌的水準怎麼樣？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220342,
						10220343
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220342,
					"content": "略懂略懂。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220344,
					"content": "是嗎？有點不信…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220345
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 10220345,
					"content": "效果如何，一試便知。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220346
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220343,
					"content": "我超會的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220344
					]
				},
				{
					"id": 10220339,
					"content": "需要我…唱歌嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220340
					]
				},
				{
					"id": 10220340,
					"content": "#沒錯，{F#妳}{M#你}的歌聲一定能讓花的香味提升到極致。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						10220341
					],
					"speakerTitle": "鍾離"
				},
				{
					"id": 10220321,
					"content": "我不意外。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220322
					]
				},
				{
					"id": 10220315,
					"content": "凝光是個有志向的人。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						10220316
					]
				}
			]
		},
		{
			"id": 102204,
