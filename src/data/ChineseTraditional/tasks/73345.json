			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"畢洛"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 733450101,
					"content": "#{F#妳}{M#你}們怎麼又來了，該不會是被我們的識主大人拒之門外了吧！與我不同，那位大人可不會對花靈隨意妥協。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450102
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450102,
					"content": "#我奉勸{F#妳}{M#你}們還是趕快離開這裡，不要想著再從我這裡套出什麼話來！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450103
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450103,
					"content": "明明每次都是你自己說的吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450104,
						733450105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733450104,
					"content": "關於那位「識主」…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733450106
					]
				},
				{
					"id": 733450106,
					"content": "將「靈光絕唱」與那先朱那背叛的事情告訴了畢洛。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733450107
					]
				},
				{
					"id": 733450107,
					"content": "真是胡說八道，識主大人是我看過最為淵博的學者，怎麼會與那些汙穢之人為伍？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450108
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450108,
					"content": "#我看{F#妳}{M#你}是沒辦法蒙混過關，就想要挑撥離間我等。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450109
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450109,
					"content": "#不過{F#妳}{M#你}實在編造得太離奇，我可不會上{F#妳}{M#你}們的當！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450110
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450110,
					"content": "唔…讓我想想，我們手上不是有那先朱那交給我們的筆記嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733450111,
					"content": "上面還有那先朱那留下的批註，把那個拿給畢洛看他應該就能相信我們了吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450112
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733450112,
					"content": "#什麼筆記？{F#妳}{M#你}們怎麼總喜歡耍這種小花招…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450113
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450113,
					"content": "將「雷內的調查筆記」交給了畢洛查看。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						733450114
					]
				},
				{
					"id": 733450114,
					"content": "不錯，這確實是識主大人的筆跡…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450115
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450115,
					"content": "好不容易矯論團才出了一位這樣淵博的識主，沒想到他竟然背棄了矯論團的使命，投靠了那些追隨黑淵的汙穢之人…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450116
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450116,
					"content": "#唉，{F#妳}{M#你}們或許有所不知，我們與這些追隨黑淵的傢伙已經纏鬥了幾百年了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450117
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450117,
					"content": "可以說，他們就如同矯論團的影子一般，一直在試圖玷汙我們的傳承。矯論團變成現在這副模樣，可以說與他們也脫不了關係。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450118
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450118,
					"content": "沒想到這次就連我們的首領也…實在是家門不幸！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450119
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450119,
					"content": "如今那先朱那那傢伙恐怕已經與那些汙穢之人同流合汙，潛藏進陰影之中了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450120
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450120,
					"content": "以前他曾跟隨阿亞德瓦前輩前往教令院學習，回來之後便沉迷於那些古代的文獻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450121
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450121,
					"content": "矯論團原本大多是重視篤行之人，已經很久沒有過像這樣的學者了。本以為他會帶領矯論團走向復興，結果卻…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450122,
						733450123
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450122,
					"content": "我們也沒想到。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733450124
					]
				},
				{
					"id": 733450124,
					"content": "不過既然事情已經變成了這樣，剩下的事情就交給我來處理吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450125
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450125,
					"content": "當務之急是要選出新的識主，不然若是被人乘虛而入那就糟糕了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450126
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450126,
					"content": "唔，雖然感覺你們也沒什麼虛可以入了啦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450127
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 733450127,
					"content": "實在慚愧…作為賠罪，這是那先朱那交給我所保管的，記錄了矯論團傳承之事的文獻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450128
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450128,
					"content": "#雖然我是看不懂，不過{F#妳}{M#你}們應該會感興趣吧，不如就交給{F#妳}{M#你}們好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						733450129
					],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450129,
					"content": "要是再遇到什麼事情的話，也可以來找我幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "畢洛"
				},
				{
					"id": 733450123,
					"content": "不是你的錯。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733450124
					]
				},
				{
					"id": 733450105,
					"content": "雖然和你說的不同…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						733450106
					]
				}
			]
		}
	]
}