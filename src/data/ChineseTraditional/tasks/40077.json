			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007707",
							"2"
						],
						"stepId": 4007707,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"莫娜",
					"楓原萬葉",
					"愚人眾士官",
					"愚人眾新兵",
					"菲謝爾",
					"辛焱",
					"奧茲"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400770701,
					"content": "都放進去了，莫娜，這樣就行了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770702
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770702,
					"content": "應該是吧，反正手稿是這麼寫的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770703
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770703,
					"content": "稍等片刻吧。希望它能恢復正常。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770704
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400770704,
					"content": "大家席地而坐，就著火堆烤了些食物邊吃邊聊。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400770705
					]
				},
				{
					"id": 400770705,
					"content": "裝置修復後，情況果真有所好轉。很快，遠處傳來了腳步聲…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400770706
					]
				},
				{
					"id": 400770706,
					"content": "啊！有人在我們的營地裡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770707
					],
					"speakerTitle": "愚人眾士官"
				},
				{
					"id": 400770707,
					"content": "喂，你們是什麼人？！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770708
					],
					"speakerTitle": "愚人眾新兵"
				},
				{
					"id": 400770708,
					"content": "等等，你看那台裝置，修、修好了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770709
					],
					"speakerTitle": "愚人眾士官"
				},
				{
					"id": 400770709,
					"content": "欸？欸？可是佩爾西科夫先生還躺在那邊的地上啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770710
					],
					"speakerTitle": "愚人眾新兵"
				},
				{
					"id": 400770710,
					"content": "這台裝置是我們修好的哦，你們應該謝謝我們！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770711
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770711,
					"content": "要不是被這些事打擾，我們本來可以度過一個完美無缺的假期。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770712
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770712,
					"content": "哼！還不快過來向本皇女和諸位家臣致歉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770713
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400770713,
					"content": "啊？！不不不，我、我先走了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770714
					],
					"speakerTitle": "愚人眾士官"
				},
				{
					"id": 400770714,
					"content": "喂，喂，別丟下我…佩爾西科夫先生還在那裡，快回來救他啊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770715
					],
					"speakerTitle": "愚人眾新兵"
				},
				{
					"id": 400770715,
					"content": "哈哈哈，那兩個人看起來很清醒。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770716
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400770716,
					"content": "看來，修復成功了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770717
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400770717,
					"content": "太好啦！那我們別待在這裡了，我想回自己的營地繼續度假。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770718
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770718,
					"content": "妳說的，是可莉的營地吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770719
					]
				},
				{
					"id": 400770719,
					"content": "嗯！但我現在覺得，那裡也是屬於我們幾個的營地了，就像臨時的家一樣，嘿嘿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770720
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770720,
					"content": "那裡或許該被稱為幽夜淨土暨嘟嘟王國大使館。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770721
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400770721,
					"content": "欸？不要啦，好難念。我還是喜歡用記得住的名字。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770722
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770722,
					"content": "走吧走吧，我們快點回家去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
		{
			"id": 4007708,
			"completionStepIds": [
				4007710
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007710",
							"2"
						],
						"stepId": 4007710,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"菲謝爾",
					"奧茲",
					"辛焱",
					"楓原萬葉",
					"莫娜",
					"嘟嘟通訊儀",
					"溫迪",
					"？？？"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400770801,
					"content": "呼啊——！回到家裡大吃一頓，又在躺椅上躺了半天，總算是放鬆下來啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770802
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770802,
					"content": "哦呵呵，幽夜淨土的招待，汝還滿意嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770803
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400770803,
					"content": "很喜歡！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770804
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770804,
					"content": "喜歡就好。小姐請諸位家臣過來，不僅想讓各位見證我等聖國的降臨，更是想讓各位放鬆身心，歡度夏日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770805
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400770805,
					"content": "真好啊，我好喜歡這裡，這次真是來對了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770806
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400770806,
					"content": "這裡應該成為永遠的樂土。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770807
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400770807,
					"content": "小姐的意思是，希望以後還能與你們一同外出遊玩。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770808
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400770808,
					"content": "一定！等你們有時間，也可以來璃月找我，我帶你們四處轉轉。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770809
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400770809,
					"content": "哦對，璃月最好吃的飯店是我朋友家經營的，你們肯定喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770810
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400770810,
					"content": "要是想聽戲，也可以去找雲堇，她人很好，又喜歡結交有趣的朋友，你們或許會在戲劇話題上很合得來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770811
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400770811,
					"content": "哦？辛焱卿極力推薦，我確實開始感興趣了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770812
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400770812,
					"content": "#{NICKNAME}，我有個想法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770813
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400770813,
					"content": "稻妻有種小吃叫做烤堇瓜，配著魚肉風味也不錯。今晚不如我們也試著把水果和海鮮一起烤，如何？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770814,
						400770816
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400770814,
					"content": "好啊好啊！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770815
					]
				},
				{
					"id": 400770815,
					"content": "那就說定了，我會盡量多找些水果，調味的話…嗯，就這麼辦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770823
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400770823,
					"content": "你們在這裡啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770824
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770824,
					"content": "我發現一個問題。雖然我們已經修復裝置，但你看，那些小島上的幻境並未消失。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770825
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770825,
					"content": "我也察覺到了。考慮到幻境誕生需要時間，消失可能也需要。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770826
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400770826,
					"content": "嗯，也是一種可能。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770827
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770827,
					"content": "說起來，我的水占盤倒是完全恢復正常，可以用了。剛才占卜的結果也沒有太大異常，只是…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770828
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770828,
					"content": "只是？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770829
					]
				},
				{
					"id": 400770829,
					"content": "只是，占卜結果中有些看不懂的東西…似乎有某種力量圍繞在我們身側，注視著我們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770830
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770830,
					"content": "是裝置造成的嗎？還是佩爾西科夫？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770831
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400770831,
					"content": "抱歉，我也不清楚。只能確定這股力量目前不具有攻擊性，應該是對我們沒什麼惡意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770832
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770832,
					"content": "（這麼說來，島上還有一個問題沒有解決，只是大家都不知道那件事。）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770833
					]
				},
				{
					"id": 400770833,
					"content": "我會留意的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770834
					]
				},
				{
					"id": 400770834,
					"content": "嗯。雖說接下來沒有干擾，可以盡情享受假日了，但離開海島之前，我們還是要多加小心。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770835
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770835,
					"content": "我也會每日占卜的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770836
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770836,
					"content": "我答應過菲謝爾會擔任守衛一職，我也可以幫忙。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770837
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400770837,
					"content": "好，拜託了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770838
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770838,
					"content": "…唉，誰讓她們那麼無憂無慮呀。這次的事，我多操心就是了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770839
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400770839,
					"content": "派蒙，跟我來！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770840
					]
				},
				{
					"id": 400770840,
					"content": "噢噢，來了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770841
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770841,
					"content": "到旁邊去。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770842
					]
				},
				{
					"id": 400770842,
					"content": "我明白了，是要聯絡賣唱的對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770843
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770843,
					"content": "嘟嘟可——嘟嘟可——",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770844
					],
					"speakerTitle": "嘟嘟通訊儀"
				},
				{
					"id": 400770844,
					"content": "#哎呀哎呀，{F#妳}{M#你}們終於聯繫我了？還以為{F#妳}{M#你}們玩得太高興，把我徹底忘掉了呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770845
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400770845,
					"content": "不是啦，賣唱的，我們遇到了很奇怪的事哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770846
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770846,
					"content": "將這幾天海島上發生的所有事件詳細告知溫迪…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400770847
					]
				},
				{
					"id": 400770847,
					"content": "奇怪的裝置？甚至能模仿神的能力？啊哈哈，愚人眾還有這種計畫嗎，真是異想天開啊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770848
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400770848,
					"content": "聽你的口氣，是不知道這事囉？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770849
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770849,
					"content": "我只是個酒館賣唱的吟遊詩人而已，怎麼可能知道這些。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770850
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400770850,
					"content": "這傢伙，又開始了…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770851
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770851,
					"content": "#不過，撇開這些，{NICKNAME}，派蒙，這次{F#妳}{M#你}們玩得開心嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770852
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400770852,
					"content": "開心！吃了好吃的東西，看了很多奇妙的景象，很不錯哦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770853,
						400770854
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770853,
					"content": "體驗很不錯哦。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770855
					]
				},
				{
					"id": 400770855,
					"content": "啊哈哈，那就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770856
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400770856,
					"content": "#旅行的意義在於記錄心情。只要能給{F#妳}{M#你}們留下難忘的體驗，這次旅程就有意義。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770857
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400770857,
					"content": "#至於那個神秘的聲音，雖然不知道是誰，但至少她沒有讓{M#你}{F#妳}們受到任何傷害，還讓{M#你}{F#妳}們瞭解了彼此，對吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770858
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400770858,
					"content": "#從這一點說，她或許帶著善意。否則她都能截斷艾莉絲女士發明的通訊工具了，一定也可以成功襲擊{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770859
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400770859,
					"content": "唔，賣唱的說得對…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770860
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770860,
					"content": "……",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770861
					]
				},
				{
					"id": 400770861,
					"content": "明白了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770862
					]
				},
				{
					"id": 400770862,
					"content": "#啊哈哈，能讓{F#妳}{M#你}放心些就好。{F#妳}{M#你}們就盡情地玩吧，等{F#妳}{M#你}回來，別忘了將海島上的美麗幻境仔細說給我聽。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770863
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400770863,
					"content": "我想把這一切美好回憶記錄下來，寫進詩歌裡。每個夏天，都會成為一段難忘的樂章。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770864
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400770864,
					"content": "嗯，說好了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770865
					]
				},
				{
					"id": 400770865,
					"content": "#那就等{F#妳}{M#你}回來囉。{NICKNAME}，假期愉快！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770866
					],
					"speakerTitle": "溫迪"
				},
				{
					"id": 400770866,
					"content": "既然賣唱的說不要緊，應該就沒事了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770867
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770867,
					"content": "畢竟，不管怎麼說賣唱的也是個神呢，我們應該相信他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770868,
						400770869
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770868,
					"content": "確實。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770870
					]
				},
				{
					"id": 400770870,
					"content": "那我們回去吧，別讓大家久等了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770871
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770871,
					"content": "剛才菲謝爾還說要去抓螃蟹，我也想去！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770872
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770872,
					"content": "#解決這次事件的{F#妳}{M#你}，是否感到滿足快樂？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770873
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770873,
					"content": "（這個聲音是…！）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770874
					]
				},
				{
					"id": 400770874,
					"content": "#別擔心，我不會傷害{F#妳}{M#你}。倒不如說，我只是一隻偶爾飛經這片海域的小鳥，正從遙遠的地方望著{F#妳}{M#你}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770875
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770875,
					"content": "只是偶然，這裡竟然有與我相關的力量。我感到好奇，便降落在海灘上，悄悄窺視島上的一切。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770876
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770876,
					"content": "…真有趣啊。儘管忙於公務，那些來到海島的人居然也會露出真心實意的笑容。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770877
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770877,
					"content": "#而後到的{F#妳}{M#你}們，更不用說，帶來了璀璨的夢境與美麗的意志。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770878
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770878,
					"content": "#{F#妳}{M#你}們的幻夢，猶如海面上的氣泡，剔透而脆弱。愈是動人的泡影，愈讓我好奇。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770879
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770879,
					"content": "#我不能出遠門，很羡慕{F#妳}{M#你}們這些自由自在的人，所以，也幫著做了一些小設計，希望{F#妳}{M#你}們喜歡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770880
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770880,
					"content": "你是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770881
					]
				},
				{
					"id": 400770881,
					"content": "#我說了，我沒有目的，只是一隻小鳥罷了。留在這裡，是為了欣賞{F#妳}{M#你}們的喜怒哀樂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770882
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770882,
					"content": "#{F#妳}{M#你}是個特別的人，散發著特別的色彩。我實在好奇，才以這種方式與{F#妳}{M#你}溝通。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770883
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770883,
					"content": "不必在意我的名字。或許未來某一天，我們會在別處相見。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770884
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770884,
					"content": "#到那時，{F#妳}{M#你}應該會認得我。呵呵。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770885
					],
					"speakerTitle": "？？？"
				},
				{
					"id": 400770885,
					"content": "（聲音消失了…她剛才是直接在我腦海中說話嗎？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770886
					]
				},
				{
					"id": 400770886,
					"content": "#喂，{F#妳}{M#你}在幹什麼啊！快跟上！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770887
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400770887,
					"content": "（…這是…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770888
					]
				},
				{
					"id": 400770888,
					"content": "（在別處相見嗎…會是什麼時候，在哪裡呢？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				},
				{
					"id": 400770869,
					"content": "馬馬虎虎吧。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770870
					]
				},
				{
					"id": 400770854,
					"content": "整體算是滿意。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770855
					]
				},
				{
					"id": 400770816,
					"content": "烤堇瓜不錯哦，我吃過！",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770817
					]
				},
				{
					"id": 400770817,
					"content": "是在稻妻吃的嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770818
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400770818,
					"content": "幾位稻妻朋友親手給我烤的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770819
					]
				},
				{
					"id": 400770819,
					"content": "哈哈，那太好了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770820
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400770820,
					"content": "#我也打算像{F#妳}{M#你}一樣，四處遊歷，廣交好友。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770821
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400770821,
					"content": "萬葉的話，一定沒問題。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770822
					]
				},
				{
					"id": 400770822,
					"content": "#承{F#妳}{M#你}吉言，{NICKNAME}。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400770823
					],
					"speakerTitle": "楓原萬葉"
				}
			]
		},
		{
			"id": 4007711,
			"completionStepIds": [
				4007711
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"4007711",
							"2"
						],
						"stepId": 4007711,
						"stateName": "QUEST_STATE_UNFINISHED"
					}
				]
			},
			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"佩爾西科夫",
					"辛焱",
					"莫娜",
					"菲謝爾",
					"奧茲",
					"楓原萬葉"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 400771101,
					"content": "喂！你們看那個人，是不是第一天我們見到的那個？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771102
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400771102,
					"content": "啊哈哈…嗝！都瘋了，都滾吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771103
					],
					"speakerTitle": "佩爾西科夫"
				},
				{
					"id": 400771103,
					"content": "我們…我們永遠不會醒來…但我是對的，我的寶貝，無敵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771104
					],
					"speakerTitle": "佩爾西科夫"
				},
				{
					"id": 400771104,
					"content": "寶貝？他的什麼寶貝？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771105
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400771105,
					"content": "創造奇蹟的機械…絕非…不可能…嗝！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771106
					],
					"speakerTitle": "佩爾西科夫"
				},
				{
					"id": 400771106,
					"content": "看來，寶貝就是指那台裝置了吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771107
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400771107,
					"content": "爛醉如泥，哼。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771108
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400771108,
					"content": "噢這撲面的酒氣…小姐，請容我用翅膀為您搧風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771109
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400771109,
					"content": "太好了，也幫我搧搧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771110
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400771110,
					"content": "那我也要。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400771111
					]
				},
				{
					"id": 400771111,
					"content": "當然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771112
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400771112,
					"content": "各位，我在附近看過了，沒有其他人在。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771113
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400771113,
					"content": "很奇怪不是嗎？愚人眾是一個組織，這裡卻只剩這位。而上一次來，我們甚至連這位也沒找到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771114
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400771114,
					"content": "甚至就連上一次那位胖胖的先生也不見了。我猜…他們躲在其他地方。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771115
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400771115,
					"content": "至於原因，恐怕就要問眼前這位了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771116
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400771116,
					"content": "可是他醉得像頭死豬一樣，我們是不是還要等他？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771117
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400771117,
					"content": "降下懲戒的聖泉！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771118
					],
					"speakerTitle": "菲謝爾"
				},
				{
					"id": 400771118,
					"content": "小姐的意思是拿水澆他。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771119
					],
					"speakerTitle": "奧茲"
				},
				{
					"id": 400771119,
					"content": "聽起來不錯，我們試試！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771120
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400771120,
					"content": "眾人找出背囊裡的水，毫不客氣地對準這位愚人眾研究員倒下…",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						400771121
					]
				},
				{
					"id": 400771121,
					"content": "呀，他睜眼了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400771122,
					"content": "唔…唔？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771123
					],
					"speakerTitle": "佩爾西科夫"
				},
				{
					"id": 400771123,
					"content": "喂，你是愚人眾吧？能不能告訴我們這裡到底發生了什麼事，那台裝置究竟有什麼用？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771124
					],
					"speakerTitle": "莫娜"
				},
				{
					"id": 400771124,
					"content": "…愚人…眾…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771125
					],
					"speakerTitle": "佩爾西科夫"
				},
				{
					"id": 400771125,
					"content": "…哈哈哈！愚人眾！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771126
					],
					"speakerTitle": "佩爾西科夫"
				},
				{
					"id": 400771126,
					"content": "噢，噢…愚昧無知的高層，你後悔了吧！哈哈，否定我的研究，逼我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771127
					],
					"speakerTitle": "佩爾西科夫"
				},
				{
					"id": 400771127,
					"content": "逼我…來到無人島，做實驗…寶貝！寶貝，嗚嗚嗚…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771128
					],
					"speakerTitle": "佩爾西科夫"
				},
				{
					"id": 400771128,
					"content": "怎麼還哭了，感覺他也受過很多委屈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771129
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 400771129,
					"content": "…蔑視我…和我的寶貝發明！你們、你們…不懂得未來的勝算。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771130
					],
					"speakerTitle": "佩爾西科夫"
				},
				{
					"id": 400771130,
					"content": "唯有我的發明…能讓大家征服世界…哈哈，哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771131
					],
					"speakerTitle": "佩爾西科夫"
				},
				{
					"id": 400771131,
					"content": "傻子，傻子，哈哈哈哈哈…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771132
					],
					"speakerTitle": "佩爾西科夫"
				},
				{
					"id": 400771132,
					"content": "呃啊…！不要打我，我不炸實驗室了…對不起！不是故意…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771133
					],
					"speakerTitle": "佩爾西科夫"
				},
				{
					"id": 400771133,
					"content": "不行啊，這個人瘋瘋癲癲的，根本沒辦法交流。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771134
					],
					"speakerTitle": "辛焱"
				},
				{
					"id": 400771134,
					"content": "第一天我們見到他的時候，他還不是這樣，看來是在後幾天受到了進一步影響，最終也陷入瘋狂。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						400771135
					],
					"speakerTitle": "楓原萬葉"
				},
				{
					"id": 400771135,
					"content": "嗚、嗚…我的手稿，手稿！只有這個…能救…救…嗚嗚…",
