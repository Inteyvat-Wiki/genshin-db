			"dialogs": [
				{
					"id": 400770201,
					"content": "（這位研究員遭到萬葉制裁後有過片刻清醒，但沒多久又暈了過去…）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						400770202
					]
				},
				{
					"id": 400770202,
					"content": "（到底是他本就神志不清，還是被摔暈了呢？）",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": []
				}
