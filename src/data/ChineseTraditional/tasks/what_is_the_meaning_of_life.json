			"mark": "TALK_MARK_NONE",
			"trigger": {
				"objectNames": [
					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190101,
					"content": "這樣就差不多餵好了。希望牠們都能吃飽…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190102
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190102,
					"content": "你在做什麼啊？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190103
					]
				},
				{
					"id": 240190103,
					"content": "#我正在餵這些紫金漁鷗。{F#妳}{M#你}看，牠們都差不多要吃飽了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190104
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190104,
					"content": "嗚哇…你和這些紫金漁鷗的關係怎麼一下子變這麼好了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190105
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240190105,
					"content": "牠們沒搶你薯條吃嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190106
					]
				},
				{
					"id": 240190106,
					"content": "沒有。這裡經常有人專門過來餵食，這群紫金漁鷗對我的薯條沒有興趣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190107
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190107,
					"content": "但你上次不是說，如果離太遠的話會錯過工作嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240190108,
					"content": "哈哈哈，沒關係，今天是我難得的休息日。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190109
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190109,
					"content": "這裡既沒有同事來拉著我聊工作，也沒有人或者動物試圖搶走我的薯條…真的非常適合休息。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190110
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190110,
					"content": "而且這裡的紫金漁鷗真的非常友好，不會搶走我的薯條，也不會衝到我的懷裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190111
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190111,
					"content": "自從我親手餵食了幾次之後，這群紫金漁鷗好像都認識我了。就算我去摸牠們的羽毛，牠們也不會太太會抗議。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190112
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190112,
					"content": "和沫芒宮旁邊的那群紫金漁鷗相比，牠們完全可以稱得上是一群紳士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190113
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190113,
					"content": "如果牠們學會用爪子在打字機上敲字，那幾乎都可以取代我們的工作了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190114,
						240190116
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190114,
					"content": "紫金漁鷗並不會幫人辦事。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190115
					]
				},
				{
					"id": 240190115,
					"content": "紫金漁鷗至少不會讓一件事更糟啊。而且每個人都知道，有些事對海鷗來說太過艱難，牠們就是辦不到。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190118,
					"content": "#先不說這些。{F#妳}{M#你}想試試和這些紳士們交朋友嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190119
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190119,
					"content": "已經把牠們稱為紳士們了啊…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190120,
						240190122
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 240190120,
					"content": "我直接過去會不會太冒犯了。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190121
					]
				},
				{
					"id": 240190121,
					"content": "#不，這群紳士們都很寬容，只要{F#妳}{M#你}不要直接去摸羽毛就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190124,
					"content": "#來吧，這是我特別處理過的魚肉，{F#妳}{M#你}直接拿過去放在盆子裡面就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190125
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190125,
					"content": "#放輕鬆。紫金漁鷗都十分寬容，只要{F#妳}{M#你}餵食，牠們就會對{F#妳}{M#你}有好感。絕對不會反問{F#妳}{M#你}這魚肉的來歷和製作方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190122,
					"content": "和紫金漁鷗交朋友需要注意什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190123
					]
				},
				{
					"id": 240190123,
					"content": "也沒有什麼特別的。只要別直接去摸牠們的羽毛就好。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190124
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190116,
					"content": "紫金漁鷗是聽不懂人說話的。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190117
					]
				},
				{
					"id": 240190117,
					"content": "那可不一定。也許牠們只是裝作聽不懂人說話，以此來讓自己的生活更安逸一點呢。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190118
					],
					"speakerTitle": "艾尤恩"
				}
			]
		},
