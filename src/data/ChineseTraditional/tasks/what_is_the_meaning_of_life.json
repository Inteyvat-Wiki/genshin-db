					"艾尤恩"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 240190801,
					"content": "#{F#妳}{M#你}…{F#妳}{M#你}怎麼可以這麼做，牠們又不是沫芒宮前那群討厭的傢伙！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190802
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190802,
					"content": "一不小心就…",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						240190803
					]
				},
				{
					"id": 240190803,
					"content": "#唉，我都來不及阻止{F#妳}{M#你}。我不知道{F#妳}{M#你}為什麼要這麼做…還是說是哪隻紫金漁鷗攻擊{F#妳}{M#你}了？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						240190804
					],
					"speakerTitle": "艾尤恩"
				},
				{
					"id": 240190804,
					"content": "無論如何，這群紫金漁鷗現在都已經被嚇走了。沒辦法，等過幾天我再帶點東西來，向牠們賠禮道歉吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "艾尤恩"
				}
			]
		},
