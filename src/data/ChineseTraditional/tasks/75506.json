				]
			},
			"dialogs": [
				{
					"id": 755060101,
					"content": "#嗨，{F#妳}{M#你}們來了啊。這裡就是最後一處深淵蜜蟲出沒的地方了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060102
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755060102,
					"content": "把這裡的蜜蟲抓住就算搞定了吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060103
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060103,
					"content": "嗯，就算還有一些漏網之魚，也不是大問題，我會抽空處理的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060104
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755060104,
					"content": "族裡也有傳來消息說病人的情況這幾天基本上都好轉了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060105
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755060105,
					"content": "真是不錯的消息！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060106
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060106,
					"content": "不過還有一件可惜的事，小派蒙警惕的陰謀並沒有發生。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060107
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755060107,
					"content": "那些漿果看來就是自然地生長在蜜蟲的聚集地。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060108
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755060108,
					"content": "唔…我才沒有預測是什麼愚人眾…盜寶團之類的…我只是展現了一個優秀的嚮導該有的警覺心啦！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060109
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060109,
					"content": "相信妳可以一直保持。",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						755060110
					]
				},
				{
					"id": 755060110,
					"content": "嘿嘿，那是當然。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060111
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 755060111,
					"content": "好了，那我們就快速解決最後的任務吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						755060112
					],
					"speakerTitle": "希諾寧"
				},
				{
					"id": 755060112,
					"content": "好耶！抓蟲小隊，最後出擊！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "派蒙"
				}
			]
		},
