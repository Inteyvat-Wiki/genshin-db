			},
			"mark": "TALK_MARK_COMMON",
			"trigger": {
				"objectNames": [
					"藤原俊子",
					"派蒙"
				],
				"points": []
			},
			"dialogs": [
				{
					"id": 721620101,
					"content": "#謝、謝謝{F#妳}{M#你}們，呼…這些傢伙居然趁我不注意偷襲我…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620102,
						721620103
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620102,
					"content": "妳是誰？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				},
				{
					"id": 721620104,
					"content": "我叫藤原俊子，正在這裡…嗯…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620105
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620105,
					"content": "#算了，{F#妳}{M#你}們救了我…我就告訴{F#妳}{M#你}們吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620106
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620106,
					"content": "其實，我正在這裡尋找我祖上留下來的寶藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620107
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620107,
					"content": "寶、寶藏！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620108
					],
					"speakerTitle": "派蒙"
				},
				{
					"id": 721620108,
					"content": "妳找到了嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620109
					]
				},
				{
					"id": 721620109,
					"content": "哈哈哈，那是當然，我順著線索找到了寶藏所在地，也確定了進入的方法。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620110
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620110,
					"content": "但是…在我準備啟動開關，進入藏寶地的時候，就被那群魔物偷襲了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620111
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620111,
					"content": "#多虧{F#妳}{M#你}們擊退了那群魔物，謝謝{F#妳}{M#你}們。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620112
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620112,
					"content": "然後…那個，雖然有點不好意思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620113
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620113,
					"content": "#但是，能不能請{F#妳}{M#你}們接著保護我一段時間？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620114
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620114,
					"content": "我還得繼續尋寶，這周圍又有那麼多魔物，我一個人肯定沒法對付…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620115
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620115,
					"content": "#如果{F#妳}{M#你}們願意幫忙的話，我可以把…把寶藏分給{F#妳}{M#你}們一些！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620116,
						721620117
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620116,
					"content": "真的有寶藏嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620118,
					"content": "#肯定能找到！{F#妳}{M#你}們就相信我吧！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620119
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620119,
					"content": "我連進入藏寶地的開關都找到了，就在那邊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620120
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620120,
					"content": "但那座機關似乎不能直接打開，得用一種特殊的方法才能啟動…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620121
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620121,
					"content": "雖然我手上有祖上留下的一張圖，裡面似乎有解開這座機關的線索…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620122
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620122,
					"content": "但是…哈哈哈…我還是不知道怎麼才能打開。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620123
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620123,
					"content": "#哦，{F#妳}{M#你}們也看看吧，說不定{F#妳}{M#你}們能從這張圖裡看出什麼來。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						721620124
					],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620124,
					"content": "唉，這個機關到底是怎麼解的呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "藤原俊子"
				},
				{
					"id": 721620117,
					"content": "真的找得到嗎？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620118
					]
				},
				{
					"id": 721620103,
					"content": "妳在這做什麼？",
					"roleType": "TALK_ROLE_PLAYER",
					"nextDialogs": [
						721620104
					]
				}
			]
		},
