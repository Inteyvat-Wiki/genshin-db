				]
			},
			"dialogs": [
				{
					"id": 760780401,
					"content": "根據以往的經驗來看，在消滅了附近的魔物後，這裡的裂隙本應自行消弭。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780402
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760780402,
					"content": "但是為何狂獵的氣息依舊在此揮之不去…這也太奇怪了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780403
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760780403,
					"content": "難道是有什麼我還沒有注意到的地方，也被狂獵的汙穢浸染了嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉洛亞"
				}
			]
		},
		{
