			},
			"dialogs": [
				{
					"id": 760780501,
					"content": "這裡也有誓言之燈，應該是某位前輩的遺物吧…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780502
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760780502,
					"content": "燈上還殘留著狂獵的汙穢，想想也知道這裡發生過什麼…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780503
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760780503,
					"content": "自提起誓言之燈那日起，我們的生命便與燈中的光焰相連，直至…應有的使命被達成的時刻。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780504
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760780504,
					"content": "向您致敬，為了挪德卡萊的和平與安寧而戰至最後一刻的勇士。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780505
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760780505,
					"content": "那麼您的燈就由我代為保管，請放心，將有英靈的冠冕為您留存。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780506
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760780506,
					"content": "我會將它帶回總部，重新點燃後，交給能夠繼承這份意志的人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780507
					],
					"speakerTitle": "葉洛亞"
				},
				{
					"id": 760780507,
					"content": "葉洛亞將燈清理乾淨，鄭重地收了起來。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780508
					]
				},
				{
					"id": 760780508,
					"content": "這樣一來，這裡的狂獵就算清除乾淨了，前輩的英靈也有了歸宿。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "葉洛亞"
				}
			]
		}
