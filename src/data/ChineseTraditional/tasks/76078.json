				]
			},
			"dialogs": [
				{
					"id": 760780101,
					"content": "通常來說，一旦消滅了所有伴隨狂獵而生的魔物，不淨的氣息就該散去。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780102
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780102,
					"content": "但這道裂隙依然存在，這種狀況不太尋常，但也並非沒有先例。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780103
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780103,
					"content": "找一找這附近吧，應該有什麼沾染了汙穢的東西還在這裡。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				}
			]
		},
		{
			"id": 7607802,
			"completionStepIds": [
				7607804
			],
			"beginWay": "TALK_BEGIN_MANUAL",
			"beginConditions": {
				"logic": "LOGIC_NONE",
				"conditions": [
					{
						"type": "QUEST_COND_STATE_EQUAL",
						"rawParams": [
							"7607804",
							"2"
						],
						"stepId": 7607804,
						"stateName": "QUEST_STATE_UNFINISHED"
