							9661.866
						],
						"pointId": 13639
					}
				]
			},
			"dialogs": [
				{
					"id": 760780201,
					"content": "哦，是燈。執燈人重要的隨身之物，用來驅散狂獵的關鍵…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780202
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780202,
					"content": "燈還在，甚至燈罩上還殘留著狂獵的氣息，提燈的人卻不在周圍。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780203
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780203,
					"content": "雖然有點令人扼腕，但這裡發生的事不難想像。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780204
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780204,
					"content": "執燈人的犧牲有時是悄無聲息的，每次以這樣意外的方式發現同僚的離去都令人遺憾。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780205
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780205,
					"content": "…無名的人，你留下的燈就由我來照管吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780206
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780206,
					"content": "它的軀體將被清理乾淨，它的燈火將被重新點燃，交給下一個立誓守護挪德卡萊的執燈人。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780207
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780207,
					"content": "菲林斯將燈清理乾淨，慎重地收了起來。",
					"roleType": "TALK_ROLE_BLACK_SCREEN",
					"nextDialogs": [
						760780208
					]
				},
				{
					"id": 760780208,
					"content": "這應該就是狂獵無法完全消失的緣由了，這盞燈就由我暫時保管，直至總部來人將它收回。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780209
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780209,
					"content": "…燈下還有東西？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						760780210
					],
					"speakerTitle": "菲林斯"
				},
				{
					"id": 760780210,
					"content": "是這位同僚的遺物吧，或許應該把它和燈放在一處。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "菲林斯"
				}
			]
		},
