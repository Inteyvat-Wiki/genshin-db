			},
			"dialogs": [
				{
					"id": 761260101,
					"content": "雅珂達？還有…祖潘科先生，請問您有什麼事嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260102
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260102,
					"content": "我…呃…那個…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260103
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260103,
					"content": "他想去「霜月之子」裡玩一玩，但又不好意思，所以想要拜託妳幫忙啦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260104
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260104,
					"content": "是！是，就是這樣。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260105
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260105,
					"content": "您好，莉莉希小姐！很高興見到您，呃…這是我從納塔帶來的…化石標本！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260106
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260106,
					"content": "謝謝您，可是…祖潘科先生，我早就認識您了啊，您真的不用這麼客氣的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260107
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260107,
					"content": "啊？您又是怎麼發現我的？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260108
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260108,
					"content": "我之前發放餐點的時候，您不是在旁邊看嗎？晃過來，晃過去，但就是不站進隊伍裡排隊。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260109
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260109,
					"content": "我還以為您也想拿，但又不好意思上前，所以還特意悄悄留了一份給您。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260110
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260110,
					"content": "但…您從來都沒有來拿過餐。要是您今天不來，我也要拜託人去問問您有沒有什麼需要幫助的了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260111
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260111,
					"content": "這…這…真是抱歉，我是在猶豫…到底要怎麼打招呼呢…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260112
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260112,
					"content": "所以，莉莉希小姐，我可以去「霜月之子」看看嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260113
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260113,
					"content": "可以啊，我們「霜月之子」裡本來也有幾位外來的客人。但您要去做什麼？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260114
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260114,
					"content": "留個影、查查資料，如果可以的話…再找人詢問一下傳說故事！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260115
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260115,
					"content": "我是納塔「龍遺物研究協會」的成員，如果能夠蒐集到一些和我的研究方向有關的資料，那就最好了！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260116
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260116,
					"content": "喔…那你就是要去看書囉？我想想哦…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260117
					],
					"speakerTitle": "莉莉希"
				},
				{
					"id": 761260117,
					"content": "你們聊得這麼開心，那這趟委託就算結束囉，我也要回去向老闆匯報了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260118
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260118,
					"content": "謝謝妳，雅珂達小姐！那個…費用我還是會付的，怎麼能讓您白跑一趟呢！",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260119
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260119,
					"content": "回去的時候，也請務必向奈芙爾老闆轉達我的謝意。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260120
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260120,
					"content": "好說好說，那我就先走了，兩位聊得開心哦。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "雅珂達"
				}
			]
		},
