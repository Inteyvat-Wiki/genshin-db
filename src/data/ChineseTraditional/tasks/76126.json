						],
						"pointId": 14110
					}
				]
			},
			"dialogs": [
				{
					"id": 761260201,
					"content": "啊…雅珂達？妳怎麼來了？呃…奈芙爾老闆現在有空嗎？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260202
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260202,
					"content": "（果然想去找奈姐…哼哼，這麼點小事，我自己就能搞定。）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260203
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260203,
					"content": "不用這麼麻煩啦，就是老闆派我來幫你的。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260204
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260204,
					"content": "欸？您、您說什麼難道奈芙爾老闆已經…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260205
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260205,
					"content": "你一直想要去「霜月之子」那邊拜訪，沒錯吧？",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260206
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260206,
					"content": "所以，你想先和莉莉希搞好關係，再拜託她把你帶去「霜月之子」。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260207
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260207,
					"content": "啊？！奈芙爾老闆都知道了？我明明都把這件事憋在心裡，沒怎麼和別人說…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260208
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260208,
					"content": "（這個時候就要說那句特別帥的話！奈姐是怎麼說的…嗯…噢！）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260209
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260209,
					"content": "哼哼，祖潘科先生，人在保守秘密時，也要學會隱瞞「正在保守秘密」這件事。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260210
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260210,
					"content": "不然的話，你在心裡豎起的那道牆，遲早會開始漏風。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260211
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260211,
					"content": "唉，我在家鄉的時候，就不怎麼會隱瞞心思…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260212
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260212,
					"content": "（說出來了！不虧我練了那麼久，嘿嘿嘿嘿嘿——）",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260213
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260213,
					"content": "算了，既然您都知道了，那您能幫我引見一下嗎？我是外鄉人，貿然去打擾莉莉希小姐…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260214
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260214,
					"content": "放心啦，莉莉希人很好的，別說來訪者是外鄉人，就算不是人，她都會溫柔地接待。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260215
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260215,
					"content": "啊？真的假的…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260216
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260216,
					"content": "但無論如何，貿然打攪總是不太禮貌…呃，您要是認識她的話…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260217
					],
					"speakerTitle": "祖潘科"
				},
				{
					"id": 761260217,
					"content": "當然認識囉，現在她們應該剛好發完餐了，我們現在就去吧。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260218
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260218,
					"content": "啊…老闆還說，這一次就不用收費了。",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [
						761260219
					],
					"speakerTitle": "雅珂達"
				},
				{
					"id": 761260219,
					"content": "謝謝您！我這就去收拾東西…",
					"roleType": "TALK_ROLE_NPC",
					"nextDialogs": [],
					"speakerTitle": "祖潘科"
				}
			]
		}
	]
}